                                "target_lang_word": "书写",
                                "target_lang_sense_clarification": "技能或过程"
                            },
                            {
                                "target_lang_word": "写作",
                                "target_lang_sense_clarification": "创作文字的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5c9d0a6-bae2-37fe-aa2f-a02d33bf06e9",
                    "sense_definition": "Характерная художественная манера, стиль (обычно в живописи).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этой старинной иконе свойственно очень тонкое и изящное <письмо>.",
                            "target_lang_translations": {
                                "en": "This ancient icon is characterized by very fine and elegant <brushwork>.",
                                "zh": "这幅古老的圣像画具有非常细腻优雅的<笔法>。"
                            }
                        },
                        {
                            "text": "Эксперты сразу узнали реалистичное <письмо> великого мастера.",
                            "target_lang_translations": {
                                "en": "Experts immediately recognized the realistic <style> of the great master.",
                                "zh": "专家们一眼就认出了那位大师写实的绘画<风格>。"
                            }
                        }
                    ],
