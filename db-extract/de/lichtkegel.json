                    {
                        "form_id": "9ff22d9e-d74e-4c0b-a426-2f8305728e66",
                        "entry_id": "aba5c109-92b1-349c-a761-784560dea0ab",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lichtkegel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe3cd7e2-2ee0-370b-8585-f30efc1fb3f3",
                        "entry_id": "aba5c109-92b1-349c-a761-784560dea0ab",
                        "glosses": [
                            "kegelförmiger Bereich, der von einer Lampe erhellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf790d5-8df8-4aff-8ab2-422b4e63c253",
                                "sense_id": "fe3cd7e2-2ee0-370b-8585-f30efc1fb3f3",
                                "text": "„Ich saß schweigend neben der Frau, die nur die Strecke der Straße zwischen den Lichtkegeln des Wagens in ihren scharfen und sicheren Blick nahm.“"
                            },
                            {
                                "example_id": "fe24fceb-4726-4717-99c2-6be93c39e3e4",
                                "sense_id": "fe3cd7e2-2ee0-370b-8585-f30efc1fb3f3",
                                "text": "„Magnusson stand im Lichtkegel und hob einen Gegenstand in die Höhe.“"
                            },
                            {
                                "example_id": "3e450345-0df5-4e36-a2ae-2b719a749ca4",
                                "sense_id": "fe3cd7e2-2ee0-370b-8585-f30efc1fb3f3",
                                "text": "„Ein frohes Gefühl überfiel ihn, als er auf die Bäume blickte, wie sie sich in den Lichtkegel über Motorblock und Kotflügel stürzten, die das futuristische Automobil kennzeichneten.“"
                            },
                            {
                                "example_id": "feedc9bd-9568-4615-89c0-bd9e9f48c3bd",
                                "sense_id": "fe3cd7e2-2ee0-370b-8585-f30efc1fb3f3",
                                "text": "„Ich trat wie ein Liebender in einer Mondnacht mit Sophie auf den Balkon und beobachtete mit ihr das Schwanken des Lichtkegels, den die Lampe auf den Schnee malte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d3b0b622-f919-3b50-a51e-de699318d12f",
                        "entry_id": "aba5c109-92b1-349c-a761-784560dea0ab",
                        "glosses": [
                            "Menge aller Ereignisse E’, die sich mit Lichtgeschwindigkeit auf ein Ereignis E auswirken oder vom Ereignis E mit Lichtgeschwindigkeit beeinflusst werden können"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "db7e2ab6-98e2-46ca-a28c-70369f8468bb",
                                "sense_id": "d3b0b622-f919-3b50-a51e-de699318d12f",
                                "text": "„Außerdem gibt es noch den raumartigen Außenbereich des Lichtkegels, der mit dem betrachteten Ereignis im Zentrum gar nicht »kausal zusammenhängt«, weil dazu Informationsübertragung mit Überlichtgeschwindigkeit nötig wäre.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
