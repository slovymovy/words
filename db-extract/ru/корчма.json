                        "form": "корчме́"
                    },
                    {
                        "form_id": "19bfa257-6dd8-4be8-bb18-92a2a9207635",
                        "entry_id": "bd890e0d-823f-3f12-81e9-20d5c8633aa1",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "корчма́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                        "entry_id": "bd890e0d-823f-3f12-81e9-20d5c8633aa1",
                        "glosses": [
                            "устар. в Польше, Белоруссии, Украине и южных областях России: трактир, постоялый двор с продажей вина, крепких напитков"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "757fafe8-130a-4cbb-a3ea-fdf90b168e44",
                                "sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                                "text": "В Польше корчмы очень низки; можно с зем[л]и достать рукой .."
                            },
                            {
                                "example_id": "6b4e7582-c3e8-42e7-9084-727648ab9641",
                                "sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                                "text": "Сидя под навесом корчмы, я забавлялся вишнёвкою, и мне пришло на мысль тут же и отобедать .."
                            },
                            {
                                "example_id": "8ecb7446-d9db-46c5-8456-6b635b13c46b",
                                "sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                                "text": "В целом селении не было ни одного дома, где бы они могли пристать, кроме простой корчмы, имевшей ещё то неудобство, что она вместе была и шинком."
                            },
                            {
                                "example_id": "c2b54c58-57d4-4b16-bd01-b251fae54be0",
                                "sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                                "text": "Как ни строго преследовалось содержание корчем, но оно было до того выгодно, что многие решались на него, говоря: барыши, полученные от этого, до того велики, что вознаграждают и за кнут, которого можно было всегда ожидать, коль скоро начальство узнает о существовании корчмы."
                            },
                            {
                                "example_id": "b75e9d22-cc8c-497a-85ff-82e042601b24",
                                "sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                                "text": "Эти торжки были и местом развлечения: тут заводились корчмы с пьяными напитками и весёлыми женщинами .."
                            },
                            {
                                "example_id": "13c62d43-577f-4f04-89ca-fb32762a1afa",
                                "sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                                "text": "Неподалёку от Ясс, у небольшой молдавской корчмы, меня догнал другой курьер."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "107953eb-2124-45bf-b379-1d4eab9afa1f",
                        "source_entry_id": "bd890e0d-823f-3f12-81e9-20d5c8633aa1",
                        "source_sense_id": "3d128e9b-6925-3971-ae40-f9f55958f170",
                        "target_lang_word": "inn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d124a016-d958-311d-a1d2-97a2cc8161d8",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "Any establishment where travellers can procure lodging, food, and drink."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b96b4f2-5f76-43df-be38-b18986df7c9c",
                                                "sense_id": "d124a016-d958-311d-a1d2-97a2cc8161d8",
                                                "text": "[H]ow much more agreeable to himself to get into snug quarters in a chateau, [...] rather than take up with the miserable lodgement, and miserable fare of a country inn."
                                            },
                                            {
                                                "example_id": "8545ad6f-dd7d-4ade-95fd-b337a469a6ec",
                                                "sense_id": "d124a016-d958-311d-a1d2-97a2cc8161d8",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de4379e6-cd85-3f03-ad7b-d6570b1a6c07",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "A tavern."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01b30690-7198-3eb2-abff-74e52ce9ad23",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "One of the colleges (societies or buildings) in London, for students of the law barristers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b23a729-6b07-41bd-985c-277a4095b131",
                                                "sense_id": "01b30690-7198-3eb2-abff-74e52ce9ad23",
                                                "text": "the Inns of Court    the Inns of Chancery    Serjeants’ Inns"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8c859c-87a6-3a8f-a183-5b1be811b3e4",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "The town residence of a nobleman or distinguished person."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d13f574-3188-4268-b4d5-6938f0e849ff",
                                                "sense_id": "1e8c859c-87a6-3a8f-a183-5b1be811b3e4",
                                                "text": "Leicester Inn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07beccfe-94c8-35c1-bd52-fdc6e050f546",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "A place of shelter; hence, dwelling, residence, abode."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d00d8e17-3ed5-456f-8453-1835d7d52cf3",
                                                "sense_id": "07beccfe-94c8-35c1-bd52-fdc6e050f546",
                                                "text": "But nowe ſadde Winter welked hath the day, / And Phœbus weary of his yerely taſ-ke: / Yſtabled hath his ſteedes in lowlye laye / And taken vp his ynne in Fiſhes haſ-ke."
                                            },
                                            {
                                                "example_id": "664a30bf-a948-4f75-918a-851d5049110b",
                                                "sense_id": "07beccfe-94c8-35c1-bd52-fdc6e050f546",
                                                "text": "Therefore with me ye may take vp your In / For this ſame night."
                                            }
                                        ]
                                    }
                                ]
                            },
