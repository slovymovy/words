                        "examples": [
                            {
                                "example_id": "e1031271-09f9-4d8f-bb21-8b6fe0c947dd",
                                "sense_id": "31c5764e-7560-382f-aace-13a78b8652c2",
                                "text": "On compte trois grands types de peinture à l’huile : les glycérophtaliques, les époxys et les polyuréthanes, ainsi nommées en fonction de leur liant."
                            },
                            {
                                "example_id": "81b2a16a-0fbd-4bda-b926-e92bb1765151",
                                "sense_id": "31c5764e-7560-382f-aace-13a78b8652c2",
                                "text": "Dans le sous-sol du grand magasin, il hésita longtemps entre le brillant, le mat, le satiné, l’huile et le glycérophtalique."
                            }
                        ]
                    }
