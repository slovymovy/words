                "senses": [
                    {
                        "sense_id": "c4606369-4296-3e16-8e76-bd3e69be4d54",
                        "entry_id": "95738668-1b91-353f-aeca-3ff1b123ab3b",
                        "glosses": [
                            "Kennzahl, welche die Entwicklung der Verbraucherpreise wiedergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff7a764-102d-4ba9-b5c2-6c4602a48568",
                                "sense_id": "c4606369-4296-3e16-8e76-bd3e69be4d54",
                                "text": "„Der studentische Konsum ist kaum erforscht, einen Anhaltspunkt liefert der Verbraucherpreisindex, den das Statistische Bundesamt mit Hilfe des Warenkorbes ermittelt: Rund 750 Produkte werden hier über einen längeren Zeitraum verglichen. Der Wert dieses Warenkorbs stieg von 1991 bis 2006 um rund 30 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
