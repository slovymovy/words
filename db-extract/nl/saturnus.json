                            },
                            {
                                "target_word": "Saturn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d55a09e-f0ea-380d-abed-6867bfd48c1c",
                                        "entry_id": "acf3c209-4d66-3878-8cad-7b70334169df",
                                        "glosses": [
                                            "Sable (black), in the postmedieval practice of blazoning the tinctures in the arms of certain sovereign people and places as planets."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce909fc3-c35c-449e-81ff-73a137261bd0",
                                                "sense_id": "0d55a09e-f0ea-380d-abed-6867bfd48c1c",
                                                "text": "12. Venus, a Staff in Pale Sol, and thereupon a Cross Pattee, Luna surmounted off a Pall of the last, charged with 4. like Crosses fitched Saturn, edged and stringed as the second. This Coat belongs to the Archiepiscopal See of Canterbury, to whose place it appertains to Crown and Inaugurate the Kings of England."
                                            },
                                            {
                                                "example_id": "780decf2-3280-41ef-a499-5853bc73e06e",
                                                "sense_id": "0d55a09e-f0ea-380d-abed-6867bfd48c1c",
                                                "text": "[…] The Field is Luna, a Chevron, Mars, between three Bull's Heads couped Saturn, armed Sol. This Coat-Armour pertained to the Right Noble Family of Thomas Bulleine Lord hoo and Hastings, Viscount Rochford, […] [pages 200-201:] I have omitted, in this Edition, that Escucheon Sol, charged with three Toads erected Saturn, which, according to some Authors, was the Coat-Armour of the ancient Kings of France; […]"
                                            },
                                            {
                                                "example_id": "af9a8867-0595-4f07-814c-fe1ddacd64c5",
                                                "sense_id": "0d55a09e-f0ea-380d-abed-6867bfd48c1c",
                                                "text": "The Archiepiscopal See of Armagh bears Jupiter, a Pastoral Staff in Pale Luna, ensigned with a Cross Pattee Sol, surmounded by a Pall of the second, edged and fringed of the third, charged with four like Crosses Pattee Fitched Saturn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25bb4822-ffa2-32ab-868d-a58e11e1df03",
                                        "entry_id": "acf3c209-4d66-3878-8cad-7b70334169df",
                                        "glosses": [
                                            "Lead (the metal)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "623c9c56-dd57-3a15-8c07-c5400d8976a7",
                                        "entry_id": "acf3c209-4d66-3878-8cad-7b70334169df",
                                        "glosses": [
                                            "A car of the former Saturn brand by GM."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7372562-b440-48f8-b3cb-318c7e5296c8",
                                                "sense_id": "623c9c56-dd57-3a15-8c07-c5400d8976a7",
                                                "text": "Remember that guy who worked in the warehouse who used to drive that blue Saturn? That guy was the best. I wonder where he is now?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a046f31d-e2cf-4116-a3ed-abf93c9a1adf",
