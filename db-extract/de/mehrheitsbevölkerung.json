                                "example_id": "1525ec18-cfc0-4eaf-9a76-07211bfb2b9d",
                                "sense_id": "95a50fdc-cd72-3b04-9616-cc12e7dc91ad",
                                "text": "„Überleben heißt einmal, sich den Angriffen der Mehrheitsbevölkerung und der staatlichen Institutionen zu entziehen.“"
                            },
                            {
                                "example_id": "d350cebc-864c-495e-87b0-5bc4812389bd",
                                "sense_id": "95a50fdc-cd72-3b04-9616-cc12e7dc91ad",
                                "text": "„Simbabwe war 90 Jahre lang unter dem Namen «Rhodesien» eine von weißen, hauptsächlich britischen Siedlern dominierte Kolonie, in der die afrikanische Mehrheitsbevölkerung ausgegrenzt und diskriminiert wurde.“"
                            }
