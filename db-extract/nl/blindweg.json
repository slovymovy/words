                                        "examples": [
                                            {
                                                "example_id": "11bb0bea-b58a-4f69-b6a6-daf1c5a3abc9",
                                                "sense_id": "2b0687c5-9745-31b2-ac42-1ea4421471f1",
                                                "text": "I stumbled blindly through the forest, branches whipping at my face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11eecf0a-35bc-32a3-88bd-f23e9163f09a",
                                        "entry_id": "1e0fc866-eb2c-3abe-8dc2-c818e06364d4",
                                        "glosses": [
                                            "Without consideration or question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78297e6a-af53-4e83-b6ed-13423ddc3775",
                                                "sense_id": "11eecf0a-35bc-32a3-88bd-f23e9163f09a",
                                                "text": "1940 March 19, Albert Einstein, letter to Morris Raphael Cohen\nThe mediocre mind is incapable of understanding the man who refuses to bow blindly to conventional prejudices and chooses instead to express his opinions courageously and honestly."
                                            },
                                            {
                                                "example_id": "d4aad606-c788-4e4b-85d1-c1f6a475bc05",
                                                "sense_id": "11eecf0a-35bc-32a3-88bd-f23e9163f09a",
                                                "text": "Human,\n\"To hate blindly is as dangerous as to trust blindly.\" An old angaran proverb, one of many I have forgotten somewhere along the way."
                                            }
                                        ]
                                    }
