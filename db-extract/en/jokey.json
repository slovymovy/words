                        "examples": [
                            {
                                "example_id": "b679d780-6fdd-4c7e-82b4-56c0e0d908d0",
                                "sense_id": "41f85c98-8a45-3dcf-8bf3-17bdf9b3f080",
                                "text": "They have successfully adopted internet culture and continue to appeal to the insecurity and anger of white kids in America, giving them a space to funnel their youthful anxieties into jokey anti-Semitism and a feeling of group belonging under the umbrella of white/Christian nationalism (whether they believe in it or not)."
                            },
                            {
                                "example_id": "9812b542-237d-4182-adbb-70c0bdcc5444",
                                "sense_id": "41f85c98-8a45-3dcf-8bf3-17bdf9b3f080",
                                "text": "In “Question,” Schneider bounces between bloggier, jokier chapters (“Why in God’s Name Did They Make ‘Cartoon All-Stars to the Rescue’?”) and more revealing, still jokey ones, about her gender transition and other formative experiences (“So if You’re Trans, Does That Mean You Like Guys?”)."
                            }
                        ]
                    }
