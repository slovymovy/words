                    {
                        "sense_id": "47c32c34-a38e-39ae-9b1a-465385268b2c",
                        "entry_id": "359a226c-3470-3b5e-bf77-36d2d4564654",
                        "glosses": [
                            "Person, die für sexuelle Zwecke missbraucht wird (entweder im Rollenspiel oder gegen ihren Willen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a01fde0-a691-4f49-8e1a-8badf6a38ae4",
                                "sense_id": "47c32c34-a38e-39ae-9b1a-465385268b2c",
                                "text": "„In Europa kostete ein Sexsklave ungefähr so viel wie ein billiger Gebrauchtwagen oder ein brandneues Smartphone.“"
                            },
                            {
                                "example_id": "a0270cc7-4561-411b-84c1-e4b5e1c123f1",
                                "sense_id": "47c32c34-a38e-39ae-9b1a-465385268b2c",
                                "text": "„Menschenhandel ist in Mexiko gang und gäbe. Frauen werden als Sexsklaven an den Meistbietenden verschachert.“"
                            },
                            {
                                "example_id": "82825489-cedf-4fab-b7a2-25741adea679",
                                "sense_id": "47c32c34-a38e-39ae-9b1a-465385268b2c",
                                "text": "„Du verdienst genauso viel Geld damit, Frauen und Kinder als Sexsklaven zu verkaufen, wie mit dem Verkauf von Kampfflugzeugen.“"
                            }
                        ],
