                {
                    "sense_id": "8c57ebb1-0f7a-3763-a040-2b6031955740",
                    "sense_definition": "Tending to excite wonder; surprising or extraordinary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>wonderful</w> how the man's popularity survives despite the scandals.",
                            "target_lang_translations": {
                                "ru": "<w>Удивительно</w>, как популярность этого человека сохраняется, несмотря на скандалы.",
                                "nl": "Het is <w>wonderlijk</w> hoe de populariteit van de man standhoudt ondanks de schandalen.",
                                "pl": "To <w>zdumiewające</w>, jak popularność tego człowieka utrzymuje się pomimo skandali.",
                                "de": "Es ist <w>erstaunlich</w>, wie die Beliebtheit des Mannes trotz der Skandale anhält.",
                                "fr": "Il est <w>étonnant</w> de voir comment la popularité de cet homme survit malgré les scandales.",
                                "it": "È <w>sorprendente</w> come la popolarità dell'uomo sopravviva nonostante gli scandali.",
                                "cs": "Je <w>s podivem</w>, jak si ten muž i přes skandály udržuje popularitu.",
                                "tr": "Skandallara rağmen adamın popülaritesinin sürmesi <w>şaşırtıcı</w>.",
                                "es": "Es <w>sorprendente</w> cómo sobrevive la popularidad del hombre a pesar de los escándalos."
                            }
                        },
                        {
                            "text": "The intricate mechanism of the ancient clock is <w>wonderful</w> to behold.",
                            "target_lang_translations": {
                                "ru": "Сложный механизм старинных часов <w>удивителен</w> на вид.",
                                "nl": "Het ingewikkelde mechanisme van de oude klok is <w>wonderbaarlijk</w> om te aanschouwen.",
                                "pl": "Skomplikowany mechanizm starożytnego zegara jest <w>zachwycający</w> do oglądania.",
                                "de": "Der komplizierte Mechanismus der alten Uhr ist <w>wundervoll</w> anzusehen.",
                                "fr": "Le mécanisme complexe de l'ancienne horloge est <w>merveilleux</w> à contempler.",
                                "it": "L'intricato meccanismo dell'antico orologio è <w>meraviglioso</w> da vedere.",
                                "cs": "Složitý mechanismus starobylých hodin je <w>podivuhodné</w> sledovat.",
                                "tr": "Antika saatin karmaşık mekanizmasını izlemek <w>olağanüstü</w>.",
                                "es": "El intrincado mecanismo del reloj antiguo es <w>maravilloso</w> de contemplar."
                            }
                        }
