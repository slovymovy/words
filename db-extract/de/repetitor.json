                "senses": [
                    {
                        "sense_id": "755dba8f-65ba-329b-b396-d98a38f4f94d",
                        "entry_id": "8cbc56e6-626c-3639-b986-d00b8ed39db0",
                        "glosses": [
                            "Person, der eine Lerngruppe intensiv auf eine Prüfung vorbereitet"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "fb78eaa1-f50f-49c2-9c1b-abd4a1b881cb",
                                "sense_id": "755dba8f-65ba-329b-b396-d98a38f4f94d",
                                "text": "„Er arrangierte sich loyal, aber widerwillig mit dem NS-Staat und zog sich zunächst in die unpolitische Nische eines Rechtsanwalts und Repetitors zurück.“"
                            },
                            {
                                "example_id": "2951b63a-e0d5-4195-af77-65f097c02885",
                                "sense_id": "755dba8f-65ba-329b-b396-d98a38f4f94d",
                                "text": "„Sie erbaten vom Rektor ihrer Lehranstalt einen dreimonatigen Urlaub und machten sich zusammen mit ihrem Repetitor auf die Heimreise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
