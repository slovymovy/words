                                        "entry_id": "28f5433b-9a94-3f95-bf36-0893166ba73e",
                                        "glosses": [
                                            "Remorque sans essieu avant dont l’avant est attelé au véhicule tracteur par l’intermédiaire d’une sellette de manière qu’une partie de la charge repose sur le tracteur et l’autre sur le train de roues de la remorque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b592f8f-9118-4890-b9fc-e3914916874d",
                                                "sense_id": "648b72f8-c922-3932-bfec-e3c7aa5850b1",
                                                "text": "Le 8 février 2021, Normand Chouinard, un camionneur à son compte, a conduit à l’aube son camion semi-remorque dans le chantier forestier afin d’y récupérer un chargement de grumes, ou billots à bois."
                                            },
                                            {
                                                "example_id": "25d0fefe-3504-46a9-b851-56006522a701",
                                                "sense_id": "648b72f8-c922-3932-bfec-e3c7aa5850b1",
                                                "text": "Une semi-remorque à deux essieux se nomme semi-remorque tandem."
                                            }
                                        ]
                                    }
                                ]
                            },
