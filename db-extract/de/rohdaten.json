                ],
                "senses": [
                    {
                        "sense_id": "97b4cb71-4423-383d-8ceb-e0984560778e",
                        "entry_id": "b4668c28-d6e5-3bfc-a51a-1a6eac91e698",
                        "glosses": [
                            "bereits vorhandene, aber noch nicht ausgewertete/weiterverarbeitete Informationen, Daten"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "6c134e86-189c-45b4-b07f-ede70e724596",
                                "sense_id": "97b4cb71-4423-383d-8ceb-e0984560778e",
                                "text": "„Dort werden die Rohdaten für die weitere Verarbeitung in einem Warenwirtschaftssystem (EnterpriseResource-Planning (ERP) System) aufbereitet.“"
                            },
                            {
                                "example_id": "31e94afe-5bfd-4fbc-b970-3ebc63b484f4",
                                "sense_id": "97b4cb71-4423-383d-8ceb-e0984560778e",
                                "text": "„Trotzdem hatte er sich die Rohdaten extra nochmals elektronisch zustellen lassen, um festzustellen, ob am Datensatz manipuliert worden war.“"
                            },
                            {
                                "example_id": "1ee97d7a-7dc2-447c-a1cc-861d5cfc6b79",
                                "sense_id": "97b4cb71-4423-383d-8ceb-e0984560778e",
                                "text": "„Die Rohdaten sind die digitalen Symbole zur Beschreibung der einfachsten logischen Einheiten, die ihrerseits keine logischen Untereinheiten mehr enthalten.“"
                            },
                            {
                                "example_id": "cad25943-3f67-48c7-a24c-5344705868ae",
                                "sense_id": "97b4cb71-4423-383d-8ceb-e0984560778e",
                                "text": "„Die aggregierten Rohdaten von Dear Professor Einstein sind auf Anfrage verfügbar.“"
                            },
                            {
                                "example_id": "bf8b072a-cde5-42c5-8488-16df072c5cf2",
                                "sense_id": "97b4cb71-4423-383d-8ceb-e0984560778e",
                                "text": "„Der Nachteil ist, dass die Rohdaten viel umfangreicher sind – manchmal sehr viel umfangreicher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
