                        "entry_id": "64eca8bc-85d0-3fa4-a6ee-2df185561485",
                        "glosses": [
                            "klassiek massamedium, gedrukt op papier en primair gericht op het verspreiden van nieuws"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "2bdf5b33-8533-4070-9844-0e98a4db5fd1",
                                "sense_id": "0bd5e0c3-809d-3ece-bbb8-eca9ba651b3c",
                                "text": "Is de gazet van vandaag er al?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be832875-ee46-45b9-9e4e-585daa31e1b5",
                        "source_entry_id": "64eca8bc-85d0-3fa4-a6ee-2df185561485",
                        "source_sense_id": "0bd5e0c3-809d-3ece-bbb8-eca9ba651b3c",
                        "source_sense_description": "klassiek massamedium, gedrukt op papier en primair gericht op het verspreiden van nieuws",
                        "target_lang_word": "Gazette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gazette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba348b4c-1e79-3cea-909c-b5b2758fce53",
                                        "entry_id": "9ba7cf67-150a-3b38-b8cd-002b76fe17e0",
                                        "glosses": [
                                            "periodisch erscheinendes Presseorgan"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be4c4a6-ef0b-408d-b47d-4f994cec5b5b",
                                                "sense_id": "ba348b4c-1e79-3cea-909c-b5b2758fce53",
                                                "text": "„Sein Name erschien und erscheint ohnedies oft in den Zeitungen, vor allem den Klatschspalten, die es damals schon gibt, und die oft den Hauptteil der Gazetten ausmachen.“"
                                            },
                                            {
                                                "example_id": "221d55e8-043a-4655-8423-83e6a8d0d52a",
                                                "sense_id": "ba348b4c-1e79-3cea-909c-b5b2758fce53",
                                                "text": "„Die Gazetten schrieben, ein Sturm habe den Sand der kurischen Dünen bis auf die Dächer der Stadt Tilsit getragen.“"
                                            },
                                            {
                                                "example_id": "91a44761-ecd3-4586-bb65-d7c6021c50fb",
                                                "sense_id": "ba348b4c-1e79-3cea-909c-b5b2758fce53",
                                                "text": "„Nach dem Diner bei der Fürstin Galitzin zog ich mir den Gehrock an und ging ins Café, um die Gazetten zu lesen.“"
                                            },
                                            {
                                                "example_id": "02a38dd7-35a6-4d15-8a54-495fac531f98",
                                                "sense_id": "ba348b4c-1e79-3cea-909c-b5b2758fce53",
                                                "text": "„Der Unfall kam in die Gazetten und sprach sich im literarischen Deutschland herum, und Wieland schüttelte den Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
