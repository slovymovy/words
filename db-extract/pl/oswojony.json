                    {
                        "sense_id": "351af2e2-fffc-3398-a2c0-4bbeac1ac605",
                        "entry_id": "acbf371f-9f64-34cf-b0b6-13bfd0a58a72",
                        "glosses": [
                            "o dzikim zwierzęciu: takie, które straciło dzikość"
                        ],
