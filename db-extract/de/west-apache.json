                "senses": [
                    {
                        "sense_id": "a4dd027d-5d2b-3a7f-8f3e-40355490b3aa",
                        "entry_id": "a847eebe-7353-39be-95db-1446605475ab",
                        "glosses": [
                            "eine Sprache, die von den westlichen Apachen im Südwesten der USA gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815e4cd9-269c-449d-af45-47755e62ff19",
                                "sense_id": "a4dd027d-5d2b-3a7f-8f3e-40355490b3aa",
                                "text": "„Ungleich dem Navajo steckt die Dokumentation des West-Apache noch in den Anfängen, obschon jetzt immerhin ein kurzes Wörterbuch des White-Mountain[…]“"
                            },
                            {
                                "example_id": "075e875b-42a7-4708-8478-c368272dc079",
                                "sense_id": "a4dd027d-5d2b-3a7f-8f3e-40355490b3aa",
                                "text": "„Wer Chiricahua,das etwas leichter als Navaho ist,kennengelernt hat,bringt gleichzeitig gute Voraussetzungen für die Beschäftigung mit den verwandten Sprachen mit,also Navaho,West-Apache usw.,sogar auch für die athapaskischen Sprachen des Nordens in Alaska und Kanada,denn alle diese Idiome sind relativ nahe verwandt,etwa wie Deutsch und Dänisch,Schwedisch oder Norwegisch.“"
                            },
                            {
                                "example_id": "71781873-58b3-44cc-9cd7-0fab415a3399",
                                "sense_id": "a4dd027d-5d2b-3a7f-8f3e-40355490b3aa",
                                "text": "„[…] im West-Apache bei dem Wort magashi oder bagashi um die Bezeichnung für Kuh nach de spanischen vaca.“"
                            },
                            {
                                "example_id": "5d0e1861-c402-49a1-9783-7f350ace96d0",
                                "sense_id": "a4dd027d-5d2b-3a7f-8f3e-40355490b3aa",
                                "text": "„Der Name g[?]hé, dem West-Apache gaan entspricht, zeigt eine uralte Wurzel, die Übernatürliches bezeichnet[…]“"
                            },
                            {
                                "example_id": "d63f1293-a486-4e75-b31b-cf91e8d878ef",
                                "sense_id": "a4dd027d-5d2b-3a7f-8f3e-40355490b3aa",
                                "text": "„[…]Babine-Witsuwit'en, West-Apache, Slave, Tuki und Zulu. Betrachten wir die relevanten Beispiele aus einer der erwähnten Athapaskanischen Sprachen.“"
                            },
                            {
                                "example_id": "51927cc2-2f8f-4c6a-87a0-6aeb9953c113",
                                "sense_id": "a4dd027d-5d2b-3a7f-8f3e-40355490b3aa",
                                "text": "„[…]generalisierte Pluralverbformen für mehrere Klassen (West-Apache) oder spezifische Pluralverbformen für die entsprechenden spezifischen Klassen (Acoma) geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
