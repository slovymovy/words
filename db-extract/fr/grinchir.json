                "senses": [
                    {
                        "sense_id": "a6475598-f2a9-36c7-82c1-b0d1b2f7fb4f",
                        "entry_id": "64104916-a1bc-31ca-8eff-920c379d5deb",
                        "glosses": [
                            "Voler, piquer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ea6c2fa7-f522-4f2a-9c77-12b862d1f650",
                                "sense_id": "a6475598-f2a9-36c7-82c1-b0d1b2f7fb4f",
                                "text": "Quoi ! tu voudrais que je grinchisse,\nSans tracquer de tomber au plan ?\nJ’doute qu’à grinchir on s’enrichisse ;\nJ’aime mieux gouêper, c’est du flan !"
                            },
                            {
                                "example_id": "69ba0c47-28e4-43b5-a598-8830d98e27a3",
                                "sense_id": "a6475598-f2a9-36c7-82c1-b0d1b2f7fb4f",
                                "text": "J’ai grinchi 4 plombes de rouget à bord de la Jeanne d'Arc."
                            }
                        ]
                    }
                ],
