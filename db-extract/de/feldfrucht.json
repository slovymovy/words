                                    },
                                    {
                                        "sense_id": "90c5a242-adbd-363d-9b9f-587925f7b190",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To beat with a crop, or riding-whip."
