                                        "glosses": [
                                            "To come into violent conflict."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "341d64db-c86d-4059-85c1-7c5f8d4a30dc",
                                                "sense_id": "1b77a44b-be8c-38f7-a86b-83d2a7e3a089",
                                                "text": "Fans from opposing teams clashed on the streets after the game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e13c54c-d3b2-3394-9061-7cf13270f5d6",
                                        "entry_id": "336d7edf-d12c-3486-a871-17a85814103a",
                                        "glosses": [
                                            "To argue angrily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e35786-7c11-4ca4-98cb-6e7e2e2b92c9",
                                                "sense_id": "0e13c54c-d3b2-3394-9061-7cf13270f5d6",
                                                "text": "My parents often clashed about minor things, such as the cleaning or shopping rota."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6794aca6-70c3-3efd-b937-1121e04ee897",
                                        "entry_id": "336d7edf-d12c-3486-a871-17a85814103a",
                                        "glosses": [
                                            "To face each other in an important game."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e0ce5a-e2ac-41e6-8c36-2fa031328219",
                                                "sense_id": "6794aca6-70c3-3efd-b937-1121e04ee897",
                                                "text": "The veteran American legend claims he and Welsh two-weight world champion Calzaghe will clash on 20 September, probably at The MGM Grand in Las Vegas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4950dd6c-4c40-33ec-be04-a8584b88c998",
                                        "entry_id": "336d7edf-d12c-3486-a871-17a85814103a",
                                        "glosses": [
                                            "To fail to look good together; to contrast unattractively; to fail to harmonize."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b271b5-493f-497b-906d-7d8e8590567e",
                                                "sense_id": "4950dd6c-4c40-33ec-be04-a8584b88c998",
                                                "text": "You can't wear that shirt! It clashes with your trousers."
                                            },
                                            {
                                                "example_id": "6f1c0171-6cde-4a40-90e2-224a92c2c362",
                                                "sense_id": "4950dd6c-4c40-33ec-be04-a8584b88c998",
                                                "text": "The hotel room was ugly, and the wallpaper clashed with the carpet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98842a52-ce89-35dc-80e2-8f738e942530",
                                        "entry_id": "336d7edf-d12c-3486-a871-17a85814103a",
                                        "glosses": [
                                            "To coincide, to happen at the same time, thereby rendering it impossible to attend all."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3037b26a-6b13-4c3f-a680-47d0e4a34e13",
                                                "sense_id": "98842a52-ce89-35dc-80e2-8f738e942530",
                                                "text": "I can't come to your wedding because it clashes with a friend's funeral."
                                            },
                                            {
                                                "example_id": "0ef25aa7-1c3e-4afc-b07b-11399caf9f08",
                                                "sense_id": "98842a52-ce89-35dc-80e2-8f738e942530",
                                                "text": "I wanted to take German, but it clashed with art on the timetable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7c8fcb-14ad-399a-b8d9-4f84e8585c40",
                                        "entry_id": "336d7edf-d12c-3486-a871-17a85814103a",
                                        "glosses": [
                                            "To chatter or gossip."
                                        ],
