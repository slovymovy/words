                                        "sense_id": "59814c54-0098-370b-8ab0-b8c884dde707",
                                        "entry_id": "1254e411-90b8-30d5-83ff-610c4ef51c96",
                                        "glosses": [
                                            "Substance qui peut provoquer un cancer."
