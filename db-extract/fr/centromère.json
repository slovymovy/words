                                                "example_id": "8b42a725-a37d-48eb-beef-7c311b685041",
                                                "sense_id": "1afa29ad-5030-3734-a6c7-4aee2db7e025",
                                                "text": "The aberrant bivalents with single terminal chiasmata are specially liable to this failure of orientation, presumably because their centromeres lie exceptionally far apart, as is the case in similar circumstances in a Lilium hybrid with reduced chiasma-frequency."
                                            },
                                            {
                                                "example_id": "66c4d596-76cd-4213-9593-9555994cf92d",
                                                "sense_id": "1afa29ad-5030-3734-a6c7-4aee2db7e025",
                                                "text": "Every chromosome has a long arm and a short arm separated by a pinch point known as a centromere."
                                            }
