        "nl-extract.jsonl": [
            {
                "entry_id": "4cdaaf45-13cb-32e0-bd63-bd904584bdbc",
                "word": "omverhalen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b55e09ed-ee5a-32d8-b746-bd50a2b80179",
                        "entry_id": "4cdaaf45-13cb-32e0-bd63-bd904584bdbc",
                        "glosses": [
                            "een staande structuur laten omvallen met als doel het te vernietigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b74d794-1044-4e67-8425-a0a09fef5e24",
                                "sense_id": "b55e09ed-ee5a-32d8-b746-bd50a2b80179",
                                "text": "Voorstanders vinden de standbeelden gewoon onderdeel van de geschiedenis, en het omverhalen een vorm van geschiedvervalsing. 'Dit waren goede mannen', zei een Vietnamveteraan tegen The Washington Post. 'Zij daar willen deze mannen onteren en begraven in schande, omdat ze zich concentreren op een klein onderdeel van hun leven en wat ze mensen zouden hebben aangedaan. Als ze hier beginnen is het Vietnam-monument de volgende.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "d3851503-4067-321f-8476-21391700330b",
                        "entry_id": "4cdaaf45-13cb-32e0-bd63-bd904584bdbc",
                        "glosses": [
                            "een persoon kleineren en kapot maken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "39901518-ee00-463c-b6b4-77bb64d6a24a",
                                "sense_id": "d3851503-4067-321f-8476-21391700330b",
                                "text": "‘Niets kan hem ooit omverhalen. Hij wordt altijd herboren. Zijn vitaliteit kan alleen fascineren.' En lukt het niet, dan kan Sarkozy gaan doen wat hij altijd gezworen heeft: het grote geld verdienen. Dat kan hij alleen, zonder die sukkels van ministers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b5c61ae-0a23-4c6d-a68b-9d317960467c",
                        "source_entry_id": "4cdaaf45-13cb-32e0-bd63-bd904584bdbc",
                        "source_sense_id": "b55e09ed-ee5a-32d8-b746-bd50a2b80179",
                        "source_sense_description": "een staande structuur laten omvallen met als doel het te vernietigen",
                        "target_lang_word": "break down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "break down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f77c8a1-419b-3ccf-8931-76c7e59669a3",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To stop functioning."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f5c810-f9cb-45f2-9d58-facc9e8674c7",
                                                "sense_id": "7f77c8a1-419b-3ccf-8931-76c7e59669a3",
                                                "text": "I am afraid my computer will break down if I try to run it at too high a speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4117d6fa-b63e-3198-b260-eb00c71a254b",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To unexpectedly collapse, physically or in structure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "560a811d-bf12-3657-9b0d-f21b8c4e14ff",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To intentionally demolish; to pull down."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f421e88-fbdc-30f1-8c49-d72eca081165",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To fail, especially socially or for political reasons."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84714f65-429f-46a2-bfc2-258bf4711367",
                                                "sense_id": "4f421e88-fbdc-30f1-8c49-d72eca081165",
                                                "text": "Talks broke down between Prime Minister John Doe and the opposition party."
                                            },
                                            {
                                                "example_id": "dee4431a-12ef-4afe-a878-17f4f670e139",
                                                "sense_id": "4f421e88-fbdc-30f1-8c49-d72eca081165",
                                                "text": "Relations broke down between Greece and Turkey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f9f981b-5cff-36e4-bfaa-c0e06bee2025",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To give in or give up: relent, concede, surrender."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bda5b7dc-6d8f-4085-9cf9-77fc4ae201d4",
                                                "sense_id": "5f9f981b-5cff-36e4-bfaa-c0e06bee2025",
                                                "text": "Is it worth taking it to a repair shop, or should I just break down and buy a new one?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e620a5f-5a6a-30b2-9178-87b083a392d4",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To render or to become unstable due to stress, to collapse physically or mentally."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdf44c70-2dd5-4b8d-a53c-e94815f99a03",
                                                "sense_id": "0e620a5f-5a6a-30b2-9178-87b083a392d4",
                                                "text": "Near-synonym: come undone"
                                            },
                                            {
                                                "example_id": "9bea26f3-eb3d-4055-93b6-54fc421e7533",
                                                "sense_id": "0e620a5f-5a6a-30b2-9178-87b083a392d4",
                                                "text": "She is back to work now, after she broke down the other day."
                                            },
                                            {
                                                "example_id": "fd14a8f7-2dab-40ab-b0aa-603b488bc6d9",
                                                "sense_id": "0e620a5f-5a6a-30b2-9178-87b083a392d4",
                                                "text": "Sophia broke down here. Even at this moment she was subconsciously comparing her rendering of the part of the forlorn bride with Miss Marie Lohr's."
                                            },
                                            {
                                                "example_id": "63abaed1-3d5f-40ba-ba9e-43dd52b1d055",
                                                "sense_id": "0e620a5f-5a6a-30b2-9178-87b083a392d4",
                                                "text": "As to Ernest... He is quite as nervously broken down as I am but it manifests itself in different ways. His inclination is towards megalomania and mine towards melancholy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3617cb8-b3a4-3132-af75-18f04932afa3",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To render or to become weak and ineffective."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5ace696-cdcd-4b8b-8055-3dc65d9f877f",
                                                "sense_id": "f3617cb8-b3a4-3132-af75-18f04932afa3",
                                                "text": "Hodgson's approach may not illuminate proceedings in Poland and Ukraine but early evidence suggests they will be tough to break down."
                                            },
                                            {
                                                "example_id": "b8991156-e7b3-4e85-b36f-86ca28755363",
                                                "sense_id": "f3617cb8-b3a4-3132-af75-18f04932afa3",
                                                "text": "His authority and influence over his coordinates broke down gradually."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49edeb69-1f09-3b13-902f-9cfe629d6ed5",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To (cause to) decay, to decompose."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38120b29-ec25-4fd8-8f2d-bd2f6ea037b7",
                                                "sense_id": "49edeb69-1f09-3b13-902f-9cfe629d6ed5",
                                                "text": "Leaves and grass will break down into compost faster if you keep them moist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a9e3bc1-bc82-328e-919c-e227f45aeaa3",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To separate into a number of parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f13fd2-5940-4731-881e-4dbeaae2e23a",
                                                "sense_id": "7a9e3bc1-bc82-328e-919c-e227f45aeaa3",
                                                "text": "Near-synonyms: break apart, break up, take apart, tear down, tear up"
                                            },
                                            {
                                                "example_id": "b296e33c-24ce-40f2-a2b9-7dfc620cd0e9",
                                                "sense_id": "7a9e3bc1-bc82-328e-919c-e227f45aeaa3",
                                                "text": "The goods station is a transhipment centre (centre de transbordement) at which loads made up at other centres are broken down and redespatched to destinations in the area."
                                            },
                                            {
                                                "example_id": "f8c22871-a333-457e-befe-6adfbead7be2",
                                                "sense_id": "7a9e3bc1-bc82-328e-919c-e227f45aeaa3",
                                                "text": "Meetings began in June and shortly after the group of twelve women decided to break-down into two sub groups in order to examine the subject more efficiently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c95625-be9c-36b7-93b5-b393a1066567",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To divide into parts to give more details, to provide a more indepth analysis of."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b37f54ea-3cf7-43c7-a94a-fb834ad3f9aa",
                                                "sense_id": "46c95625-be9c-36b7-93b5-b393a1066567",
                                                "text": "Near-synonym: analyze"
                                            },
                                            {
                                                "example_id": "63940c09-2207-4c5f-be35-4ca79a58b842",
                                                "sense_id": "46c95625-be9c-36b7-93b5-b393a1066567",
                                                "text": "If you don't understand, ask him to break down the numbers for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35920d2e-4b54-38ef-bf86-8184101b373c",
                                        "entry_id": "4a359f13-cfda-32bb-8165-394f31aa6a5b",
                                        "glosses": [
                                            "To digest."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51eaf65e-5af4-4aab-9f4a-77907513237a",
                                                "sense_id": "35920d2e-4b54-38ef-bf86-8184101b373c",
                                                "text": "Near-synonym: catabolize"
                                            },
                                            {
                                                "example_id": "78585e11-2d8d-4dd0-8f05-f8185ad6a188",
                                                "sense_id": "35920d2e-4b54-38ef-bf86-8184101b373c",
                                                "text": "His stomach took a while to break down his food."
                                            },
                                            {
                                                "example_id": "af75d0fb-9922-4b94-9bca-ced24e1f75ef",
                                                "sense_id": "35920d2e-4b54-38ef-bf86-8184101b373c",
                                                "text": "His food took a while to break down in his stomach."
                                            }
                                        ]
                                    }
                                ]
