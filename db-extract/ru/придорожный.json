                                "example_id": "32db79e8-b7f7-4b9a-be84-fe312d01ca41",
                                "sense_id": "fe60c43a-1d2a-3dbf-b27b-98b74aca3bc0",
                                "text": "Он присел на придорожный камень."
                            },
                            {
                                "example_id": "8f4afa06-a2b2-433c-896b-4683a075a6a2",
                                "sense_id": "fe60c43a-1d2a-3dbf-b27b-98b74aca3bc0",
                                "text": "Лишь ветер не даёт покою // Вершинам придорожных ив."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81b3a6d4-1848-494c-af88-8efcc7ef7d3b",
                        "source_entry_id": "7d377618-d9dc-3499-a7a5-c4dab8d8d2a2",
                        "source_sense_id": "fe60c43a-1d2a-3dbf-b27b-98b74aca3bc0",
                        "target_lang_word": "roadside",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roadside",
