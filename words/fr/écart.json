    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "049b7588-c301-3a08-a33c-89e0192d473f",
                    "sense_definition": "Différence, distance ou intervalle entre deux choses, deux personnes ou deux moments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coureur a réussi à creuser un <w>écart</w> important avec ses poursuivants."
                        },
                        {
                            "text": "Il existe un grand <w>écart</w> d'âge entre ces deux frères."
                        }
                    ],
                    "synonyms": [
                        "distance",
                        "intervalle",
                        "différence"
                    ],
                    "common_phrases": [
                        "creuser un écart",
                        "réduire l'écart",
                        "écart d'âge"
                    ]
                },
                {
                    "sense_id": "c5fec93c-4dce-398b-8bd7-50f30d61e0a2",
                    "sense_definition": "Différence quantitative ou numérique constatée entre deux grandeurs ou mesures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On observe un fort <w>écart</w> de température entre le jour et la nuit."
                        },
                        {
                            "text": "L'<w>écart</w> entre les résultats prévus et les chiffres réels reste minime."
                        }
                    ],
                    "synonyms": [
                        "disparité",
                        "différence"
                    ],
                    "common_phrases": [
                        "écart de température",
                        "écart de prix",
                        "écart de salaire"
                    ]
                },
                {
                    "sense_id": "58e5f145-a119-30f1-adac-3bf225e3ad29",
                    "sense_definition": "Mouvement brusque sur le côté pour éviter un obstacle ou quitter la trajectoire suivie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture a fait un <w>écart</w> soudain pour éviter le chien sur la route."
                        },
                        {
                            "text": "Le cheval a pris peur et a fait un violent <w>écart</w>."
                        }
                    ],
                    "synonyms": [
                        "embardée"
                    ],
                    "common_phrases": [
                        "faire un écart"
                    ]
                },
                {
                    "sense_id": "c1f8ca00-4e31-3d6d-8859-d428b2217ac6",
                    "sense_definition": "Manquement passager aux règles de la morale, de la convenance ou à une discipline de vie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a été vivement critiqué après cet impardonnable <w>écart</w> de langage."
                        },
                        {
                            "text": "Pendant son régime strict, il ne s'autorise aucun <w>écart</w> alimentaire."
                        }
                    ],
                    "synonyms": [
                        "dérapage",
                        "faute"
                    ],
                    "common_phrases": [
                        "écart de langage",
                        "écart de conduite"
                    ]
                },
                {
                    "sense_id": "749b1324-7141-33a9-8708-055923faf6f7",
                    "sense_definition": "Différence constatée entre deux cours, deux taux d'intérêt ou deux rendements sur un marché.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analystes surveillent l'<w>écart</w> de rendement entre les obligations des deux pays."
                        },
                        {
                            "text": "Cet <w>écart</w> de taux reflète une prime de risque accrue sur le marché."
                        }
                    ],
                    "synonyms": [
                        "spread"
                    ],
                    "common_phrases": [
                        "écart de rendement",
                        "écart de taux"
                    ]
                },
                {
                    "sense_id": "8bb3127a-cb22-348f-9dd9-e451d39fb0c5",
                    "sense_definition": "Groupe d'habitations ou hameau situé à l'écart du bourg principal d'une commune.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette commune rurale regroupe un bourg central et plusieurs <w>écarts</w> isolés."
                        },
                        {
                            "text": "La vieille ferme se trouve dans un petit <w>écart</w> au milieu des bois."
                        }
                    ],
                    "synonyms": [
                        "hameau",
                        "lieu-dit"
                    ]
                }
            ]
        }
    ]
