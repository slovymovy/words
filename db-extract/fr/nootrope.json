                                        "glosses": [
                                            "Any substance purported to increase or enhance cognitive abilities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4235232-3e03-4afc-a384-c4edc3fa8a73",
                                                "sense_id": "f0e898a6-ce08-3632-9295-aa400ca7fab5",
                                                "text": "Nootropics also include extracted and purified components of medicinal plants, as well as substances synthesized from chemical precursors, such as piracetam, the world's first official nootropic (piracetam was created in 1964 in Belgium by a team of scientists whose leader, Dr. Corneliu E. Giurgea, coined the term)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeb247da-2b18-3d1d-bd52-afc950137934",
                                        "entry_id": "29e402c3-3c5d-3209-8b60-9d396ec670d9",
                                        "glosses": [
                                            "A drug that enhances learning and memory and lacks the usual pharmacology of other psychotropic drugs (e.g. sedation, motor stimulation) and possesses very few side effects and extremely low toxicity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
