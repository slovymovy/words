                                            {
                                                "example_id": "1ab8b9f8-f0ec-413e-93a4-539ec8b36999",
                                                "sense_id": "dd3f9368-00f3-37c8-a1d6-686009bcdcc9",
                                                "text": "Die verspätete Rückgabe von Büchern an die Bibliothek hat eine Säumnisgebühr zur Folge."
                                            },
                                            {
                                                "example_id": "cab891cd-f2a0-4c8e-9889-1bda9b7173a5",
                                                "sense_id": "dd3f9368-00f3-37c8-a1d6-686009bcdcc9",
                                                "text": "\"Bei Rückgaben erhalten Sie eine Gutschrift über die Höhe des Kaufbetrages.\""
                                            },
                                            {
                                                "example_id": "05727837-e86a-4522-993e-86a6ad8cf155",
                                                "sense_id": "dd3f9368-00f3-37c8-a1d6-686009bcdcc9",
                                                "text": "Die Wohnung muss bei Rückgabe in ordnungsgemäßem Zustand übergeben werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1168bf75-2704-3838-9296-bf4e576bd7ca",
                                        "entry_id": "ab13f7e5-7cea-3ace-a7d9-5c45bc54a8e7",
                                        "glosses": [
                                            "Geldbetrag, Datensatz, Ware oder sonstige Sache die zurückgegeben wird"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00608f4b-0136-469b-b91c-05aafb6bfa49",
                                                "sense_id": "1168bf75-2704-3838-9296-bf4e576bd7ca",
                                                "text": "Die Rückgabe wird dann noch auf Rechtschreibung geprüft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b57e22e4-5df7-3306-beeb-54d5ef29b8ea",
                                        "entry_id": "ab13f7e5-7cea-3ace-a7d9-5c45bc54a8e7",
