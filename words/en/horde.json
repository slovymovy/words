                },
                {
                    "sense_id": "97b19d86-c6cd-337d-9a49-fe3aba0c0990",
                    "sense_definition": "A nomadic group or tribe that moves from place to place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>horde</w> traveled across the plains in search of fresh grazing land.",
                            "target_lang_translations": {
                                "fr": "L'ancienne <w>horde</w> a traversé les plaines à la recherche de nouveaux pâturages.",
                                "zh": "古代那个<w>游牧部族</w>穿过平原，寻找新的草场。"
                            }
                        },
                        {
                            "text": "Historians studied how the nomadic <w>horde</w> interacted with settled civilizations.",
                            "target_lang_translations": {
                                "fr": "Les historiens ont étudié comment la <w>horde</w> nomade interagissait avec les civilisations sédentaires.",
                                "zh": "历史学家研究了这支游牧<w>部落</w>是如何与定居文明进行互动的。"
                            }
                        }
                    ],
