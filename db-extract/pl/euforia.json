                                        "sense_id": "29edd8de-1f2b-3fc5-8771-09cd2e278f53",
                                        "entry_id": "d6fe332d-2e30-339d-adb2-ce40115bf2d7",
                                        "glosses": [
                                            "An excited state of joy; a feeling of intense happiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47f4d741-d8a9-4118-8f18-88b6e07073b4",
                                                "sense_id": "29edd8de-1f2b-3fc5-8771-09cd2e278f53",
                                                "text": "The runner was in (a state of) absolute euphoria after winning his first marathon."
                                            },
                                            {
                                                "example_id": "c94bc15b-0b76-41c4-ad0b-5006eb8579f9",
                                                "sense_id": "29edd8de-1f2b-3fc5-8771-09cd2e278f53",
                                                "text": "The effects caused by inhaling nitrous oxide gas, such as lightheadedness and euphoria, can be felt within seconds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b8f518b-3b53-3089-a0ba-8b6a7d53d7da",
                                        "entry_id": "d6fe332d-2e30-339d-adb2-ce40115bf2d7",
                                        "glosses": [
                                            "Ellipsis of gender euphoria."
                                        ],
