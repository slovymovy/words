                                        "entry_id": "e48a15f1-bd1f-3d01-9279-134d1fde9940",
                                        "glosses": [
                                            "posiadający urodę w wyższym stopniu, dorodny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
