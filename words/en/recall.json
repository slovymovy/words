{
    "word_family": [
        "recallable",
        "recollection"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3eea0c83-103d-3214-bafb-de984f460711",
                    "sense_definition": "To bring back a situation, event, or piece of information to one's mind; to remember.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can clearly <w>recall</w> the first time I saw the ocean as a child.",
                            "target_lang_translations": {
                                "ru": "Я отчетливо <w>вспоминаю</w> тот первый раз, когда увидел океан в детстве.",
                                "zh": "我能清晰地<w>回忆</w>起小时候第一次见到大海的情景。"
                            }
                        },
                        {
                            "text": "He struggled to <w>recall</w> the name of the person he met at the party.",
                            "target_lang_translations": {
                                "ru": "Он изо всех сил пытался <w>вспомнить</w> имя человека, которого встретил на вечеринке.",
                                "zh": "他努力想要<w>记起</w>在聚会上遇见的那个人叫什么名字。"
                            }
                        }
                    ],
                    "antonyms": [
                        "forget"
                    ],
                    "common_phrases": [
                        "clearly recall",
                        "vividly recall",
                        "struggle to recall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстанавливать в памяти ситуацию, событие или информацию; вспоминать.",
                        "zh": "在脑海中重现某种情况、事件或信息；记起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспоминать",
                                "target_lang_sense_clarification": "процесс восстановления в памяти"
                            },
                            {
                                "target_lang_word": "вспомнить",
                                "target_lang_sense_clarification": "результат восстановления в памяти"
                            },
                            {
                                "target_lang_word": "припоминать",
                                "target_lang_sense_clarification": "стараться вспомнить детали"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回忆",
                                "target_lang_sense_clarification": "对过去经历的思考"
                            },
                            {
                                "target_lang_word": "记起",
                                "target_lang_sense_clarification": "突然想起某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f72c7bf-482c-3c60-9ed8-10471dc4fbbc",
                    "sense_definition": "To officially order someone to return to a specific place, station, or duty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "summoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambassador was <w>recalled</w> to London for urgent consultations with the government.",
                            "target_lang_translations": {
                                "ru": "Посол был <w>отозван</w> в Лондон для срочных консультаций с правительством.",
                                "zh": "大使被<w>召回</w>伦敦，与政府进行紧急磋商。"
                            }
                        },
                        {
                            "text": "After the injury to the main goalkeeper, the young player was <w>recalled</w> to service from his loan.",
                            "target_lang_translations": {
                                "ru": "После травмы основного вратаря молодой игрок был <w>возвращен</w> из аренды.",
                                "zh": "主力门将受伤后，这名年轻球员被从租借地<w>召回</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "withdraw"
                    ],
                    "common_phrases": [
                        "recalled to service",
                        "recalled to duty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально приказать кому-либо вернуться в определенное место, на станцию или к исполнению обязанностей.",
                        "zh": "正式命令某人返回特定地点、岗位或履行职责。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзывать",
                                "target_lang_sense_clarification": "официально требовать возвращения"
                            },
                            {
                                "target_lang_word": "отозвать",
                                "target_lang_sense_clarification": "завершить процедуру возвращения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "召回",
                                "target_lang_sense_clarification": "正式要求人员返回"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2184e4ab-b6ff-3161-af4b-65d7b0b34a24",
                    "sense_definition": "To request or order the return of a faulty or dangerous product from customers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "product_return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car manufacturer decided to <w>recall</w> thousands of vehicles due to a brake defect.",
                            "target_lang_translations": {
                                "ru": "Автопроизводитель решил <w>отозвать</w> тысячи автомобилей из-за дефекта тормозов.",
                                "zh": "由于刹车缺陷，汽车制造商决定<w>召回</w>数千辆汽车。"
                            }
                        },
                        {
                            "text": "The company is <w>recalling</w> several eye ointments because of potential contamination.",
                            "target_lang_translations": {
                                "ru": "Компания <w>изымает</w> несколько глазных мазей из-за возможного загрязнения.",
                                "zh": "由于存在污染风险，该公司正在<w>召回</w>几款眼药膏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "withdraw"
                    ],
                    "common_phrases": [
                        "voluntary recall",
                        "product recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запрашивать или приказывать вернуть неисправный или опасный товар от покупателей.",
                        "zh": "要求或命令客户退回有缺陷或危险的产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзывать",
                                "target_lang_sense_clarification": "о продукции"
                            },
                            {
                                "target_lang_word": "изымать из продажи",
                                "target_lang_sense_clarification": "убирать товар с рынка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "召回",
                                "target_lang_sense_clarification": "针对缺陷产品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90388d1e-3d92-36a8-8fcb-a8a6bcbb342e",
                    "sense_definition": "To be reminiscent of something or to evoke a memory of a similar thing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "evocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architecture of the new museum <w>recalls</w> the style of ancient Greek temples.",
                            "target_lang_translations": {
                                "ru": "Архитектура нового музея <w>напоминает</w> стиль древнегреческих храмов.",
                                "zh": "新博物馆的建筑风格<w>使人想起</w>古希腊神庙。"
                            }
                        },
                        {
                            "text": "Her singing voice <w>recalls</w> the great jazz legends of the 1940s.",
                            "target_lang_translations": {
                                "ru": "Ее певческий голос <w>вызывает в памяти</w> великих джазовых легенд 1940-х годов.",
                                "zh": "她的歌声<w>唤起</w>了人们对20世纪40年代爵士乐传奇人物的记忆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recall an incident",
                        "recall a memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминать о чем-либо или вызывать воспоминания о похожей вещи.",
                        "zh": "使人想起某事，或唤起对类似事物的记忆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напоминать",
                                "target_lang_sense_clarification": "быть похожим на что-то"
                            },
                            {
                                "target_lang_word": "вызывать в памяти",
                                "target_lang_sense_clarification": "пробуждать ассоциации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使人想起",
                                "target_lang_sense_clarification": "引起联想"
                            },
                            {
                                "target_lang_word": "唤起",
                                "target_lang_sense_clarification": "引起记忆或情感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4403ec6f-e5b4-32d5-9912-8c132f825457",
                    "sense_definition": "To officially withdraw or retract a statement, order, or promise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was forced to <w>recall</w> the order after realizing it was based on false intelligence.",
                            "target_lang_translations": {
                                "ru": "Генерал был вынужден <w>отменить</w> приказ, осознав, что он основан на ложных разведданных.",
                                "zh": "将军意识到命令是基于虚假情报后，被迫<w>撤销</w>了该命令。"
                            }
                        },
                        {
                            "text": "He had to <w>recall</w> his words after they caused an international scandal.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>взять назад</w> свои слова после того, как они вызвали международный скандал.",
                                "zh": "他的话引发了国际丑闻，他不得不<w>收回</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retract",
                        "revoke",
                        "withdraw",
                        "take back"
                    ],
                    "common_phrases": [
                        "recall an order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально отозвать или аннулировать заявление, приказ или обещание.",
                        "zh": "正式撤回或取消声明、命令或承诺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "приказ или распоряжение"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "ранее принятое решение"
                            },
                            {
                                "target_lang_word": "взять назад",
                                "target_lang_sense_clarification": "свои слова или обещание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "取消命令或决定"
                            },
                            {
                                "target_lang_word": "收回",
                                "target_lang_sense_clarification": "撤回说过的话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5775d5c-c5ab-32ca-b0ca-230a324749bc",
                    "sense_definition": "To remove an elected official from office through a petition and a direct vote by the people.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voters launched a movement to <w>recall</w> the governor before his term ended.",
                            "target_lang_translations": {
                                "ru": "Избиратели начали движение за <w>отзыв</w> губернатора до окончания срока его полномочий.",
                                "zh": "选民们发起了一场运动，试图在州长任期结束前将其<w>罢免</w>。"
                            }
                        },
                        {
                            "text": "It is very difficult to successfully <w>recall</w> an official in this state.",
                            "target_lang_translations": {
                                "ru": "В этом штате очень трудно успешно <w>отправить в отставку</w> чиновника через процедуру отзыва.",
                                "zh": "在这个州，成功<w>罢免</w>一名官员非常困难。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recall from office"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сместить выборное должностное лицо с поста посредством петиции и прямого голосования граждан.",
                        "zh": "通过请愿和全民直接投票将民选官员免职。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзывать",
                                "target_lang_sense_clarification": "депутата или чиновника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罢免",
                                "target_lang_sense_clarification": "撤销官员职务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "740a7b8b-0895-3447-a039-45d5ddc4b2cc",
                    "sense_definition": "The ability to remember information or past events.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness had an amazing <w>recall</w> of the events that took place that night.",
                            "target_lang_translations": {
                                "ru": "У свидетеля была поразительная <w>память</w> на события, произошедшие той ночью.",
                                "zh": "目击者对当晚发生的事情有着惊人的<w>记忆力</w>。"
                            }
                        },
                        {
                            "text": "As we get older, our total <w>recall</w> of names and dates often declines.",
                            "target_lang_translations": {
                                "ru": "С возрастом наша способность к полному <w>вспоминанию</w> имен и дат часто ухудшается.",
                                "zh": "随着年龄增长，我们对姓名和日期的<w>记忆力</w>往往会下降。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "total recall",
                        "instant recall",
                        "worth recall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность запоминать информацию или прошлые события.",
                        "zh": "记忆信息或过去事件的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "память",
                                "target_lang_sense_clarification": "способность вспоминать"
                            },
                            {
                                "target_lang_word": "вспоминание",
                                "target_lang_sense_clarification": "процесс извлечения из памяти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "记忆力",
                                "target_lang_sense_clarification": "记事的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3884176-f982-3c27-976a-9b2acdb88eb5",
                    "sense_definition": "An official request for the return of a faulty or dangerous product.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "product_return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company issued a massive <w>recall</w> after discovering a safety issue with the batteries.",
                            "target_lang_translations": {
                                "ru": "Компания объявила о массовом <w>отзыве</w> продукции после обнаружения проблем с безопасностью батарей.",
                                "zh": "在发现电池存在安全问题后，该公司发布了大规模的<w>召回</w>通知。"
                            }
                        },
                        {
                            "text": "The <w>recall</w> campaign was successful in removing the dangerous toys from store shelves.",
                            "target_lang_translations": {
                                "ru": "Кампания по <w>отзыву</w> прошла успешно, и опасные игрушки были убраны с полок магазинов.",
                                "zh": "此次<w>召回</w>行动成功地将危险玩具从商店货架上清理了出去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recall campaign",
                        "voluntary recall",
                        "safety recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный запрос на возврат неисправного или опасного товара.",
                        "zh": "对有缺陷或危险产品的正式退货要求。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзыв",
                                "target_lang_sense_clarification": "продукции производителем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "召回",
                                "target_lang_sense_clarification": "产品召回行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05306186-7920-366a-ae6c-bea34d048237",
                    "sense_definition": "The procedure by which a public official may be removed from office by a vote of the people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens organized a <w>recall</w> petition to remove the mayor from his position.",
                            "target_lang_translations": {
                                "ru": "Граждане организовали петицию об <w>отзыве</w>, чтобы сместить мэра с его должности.",
                                "zh": "市民们组织了一份<w>罢免</w>请愿书，以撤销市长的职务。"
                            }
                        },
                        {
                            "text": "A representative <w>recall</w> is a rare but powerful tool in local democracy.",
                            "target_lang_translations": {
                                "ru": "<w>Отзыв</w> представителя — редкий, но мощный инструмент местной демократии.",
                                "zh": "<w>罢免</w>代表是地方民主中一种罕见但强有力的工具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recall petition",
                        "representative recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процедура, посредством которой государственное должностное лицо может быть отстранено от должности голосованием народа.",
                        "zh": "通过民众投票罢免公职人员的程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзыв",
                                "target_lang_sense_clarification": "выборного лица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罢免",
                                "target_lang_sense_clarification": "罢免程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6bd349f-7975-356a-af93-ebf5338a5751",
                    "sense_definition": "The proportion of relevant documents that are successfully retrieved in a search.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "data_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The search engine was optimized for high <w>recall</w> to ensure no relevant data was missed.",
                            "target_lang_translations": {
                                "ru": "Поисковая система была оптимизирована для высокой <w>полноты</w> поиска, чтобы не пропустить ни одного релевантного документа.",
                                "zh": "该搜索引擎针对高<w>查全率</w>进行了优化，以确保不会遗漏任何相关数据。"
                            }
                        },
                        {
                            "text": "In information retrieval, there is often a trade-off between precision and <w>recall</w>.",
                            "target_lang_translations": {
                                "ru": "В информационном поиске часто приходится искать компромисс между точностью и <w>полнотой</w>.",
                                "zh": "在信息检索中，精确率和<w>查全率</w>之间往往需要权衡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensitivity"
                    ],
                    "common_phrases": [
                        "precision and recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доля релевантных документов, которые были успешно найдены при поиске.",
                        "zh": "在搜索中成功检索到的相关文档的比例。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полнота",
                                "target_lang_sense_clarification": "в информационном поиске"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "查全率",
                                "target_lang_sense_clarification": "信息检索指标"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}