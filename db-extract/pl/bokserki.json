                                                "sense_id": "d4328947-c222-3719-8f1a-f0056f79a37d",
                                                "text": "Bosun grabbed the car key on the bookshelf in his bedroom and ran to the door, only to realize at the door that he should not go to the state police headquarters in boxer shorts, socks, and this white V-neck shirt."
                                            }
