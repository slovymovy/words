                        "examples": [
                            {
                                "example_id": "7728b366-adf1-4ed0-a7b5-79fb9a7511f2",
                                "sense_id": "aa849768-3177-3cb0-9219-c9fdd575508d",
                                "text": "„Zudem hatte Rudow, der Angst um seine Stellung hatte, weil er über den Mädchen mehr als einmal seinen Dienst verbummelte, sich bald nicht gut zu ihm gestellt und hie und da Witze über ihn gemacht, ihm auch den Ekelnamen Roter Hinnerk angehängt, und als er beim Erntebier einen Kleinen sitzen hatte und gegen Rothes Frau etwas zu freundlich war, gab es Krach, wobei Rothe, der nicht so behende wie er war, das meiste abkriegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
