                "senses": [
                    {
                        "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                        "entry_id": "c73a0cb9-d6f3-3dbc-83f8-3f6b8cc2058f",
                        "glosses": [
                            "durch einen Wald führender (meist unbefestigter) Weg, der für Maschinen und Fahrzeuge der Waldbewirtschaftung freigeschlagen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c1e3ca2-a996-47ef-92a3-fa7eae3b4b67",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "[Holzvollernter:] „An den Forstwegen entstehen bei Drehbewegungen Schäden an der Deckschicht.“"
                            },
                            {
                                "example_id": "b76643e6-cf68-41a0-a7d3-f24427d51f02",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Nach einem weiteren knackigen Anstieg geht es eine gefühlte Stunde über einen trostlos breiten Forstweg, mitten im Wald und ohne jede Aussicht.“"
                            },
                            {
                                "example_id": "a840d08b-a77b-4ba2-a110-613686d7d789",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Die Bergregion ist durch ein dichtes Netz aus Alm- und Forstwegen für Wanderer und Mountainbiker sehr gut erschlossen und auch vielbesucht.““"
                            },
                            {
                                "example_id": "457351ad-3cff-4fa8-9959-7a8d73bb71d1",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Im Reinhardswald geht der bisher asphaltierte Wirtschaftsweg dann in einen teilweise grob geschotterten Forstweg über; […].“"
                            },
                            {
                                "example_id": "650265b0-b6fd-448a-9535-44fbd32b0015",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Man folgt der Markierung des Grimmsteigs in den Wald hinein und bald nach rechts an einer kleinen BMX-Strecke vorbei zurück an den Waldrand, bevor man über geschotterte Forstwege den Rodebachteich erreicht.“"
                            },
                            {
                                "example_id": "ec03e154-7ea2-4797-80d8-00594f111d48",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Familieneignung: Ja, weil man überwiegend auf Forstwegen ohne größere Steigungen wandert.“"
                            },
                            {
                                "example_id": "f0c721ba-9eeb-4cec-b3f6-ca966cd826c5",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Drei Damen, drei Wege auf die Brunnenkopfhütte: Anja kommt per \"Bike and Hike\" , Clara wandert und Vicki nimmt als Trailrunnerin den Forstweg.“"
                            },
                            {
                                "example_id": "fb43fc89-d862-44c5-b078-101448572cd4",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Auf einem gerade mal 2,5 Kilometer langen Forstweg liegen 70 leuchtend schwarz-gelbe, aber tote Feuersalamander offen herum, übersät mit regelrechten Löchern in der Haut. Mitten im Wald.“"
                            },
                            {
                                "example_id": "70be8b04-ace4-4895-ac02-0e7152c8822b",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Im unteren Teil des Zustiegs blockieren umgestürzte Bäume den Forstweg, […].“"
                            },
                            {
                                "example_id": "d418354e-79db-45e7-88d7-1b0d097b6e7b",
                                "sense_id": "d9a7f484-3e73-3809-a86b-783b5abecc37",
                                "text": "„Nach einer Dreiviertelstunde auf einem schattigen Forstweg treten wir aus dem Wald heraus und setzen den Weg auf einem offenen Wiesensteig fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00027f7c-bd7e-3b2d-8b4b-41c00137173b",
                        "entry_id": "c73a0cb9-d6f3-3dbc-83f8-3f6b8cc2058f",
                        "glosses": [
                            "ein Straßenname"
                        ],
                        "tags": [
                            "Eigenname"
                        ],
                        "examples": [
                            {
                                "example_id": "5f4233a3-7112-47d4-9990-189e31f34145",
                                "sense_id": "00027f7c-bd7e-3b2d-8b4b-41c00137173b",
                                "text": "Das Normannenhaus in Jena, ein Kulturzentrum, liegt im Forstweg 12."
                            },
                            {
                                "example_id": "e5025cd5-e0eb-4d21-929f-f5804f42d62b",
                                "sense_id": "00027f7c-bd7e-3b2d-8b4b-41c00137173b",
                                "text": "[Olching/Bayern:] „Auch der Forstweg 5 bis 11 mit der Gröbenzeller Straße 110 sowie der Hochholzweg 14 bis 16a und die Hausnummer 17 würden unter eine Außenbereichssatzung fallen.“"
                            },
                            {
                                "example_id": "bb096a3a-35c3-4e27-8f92-a425d95f6ba0",
                                "sense_id": "00027f7c-bd7e-3b2d-8b4b-41c00137173b",
                                "text": "[Der Schauspieler Axel Milberg] „wächst im Forstweg im Kieler Stadtteil Düsternbrook auf und besucht als Knirps die Reventlow-Schule.“"
                            },
                            {
                                "example_id": "d495f63d-2427-4d40-a98b-bf224522164a",
                                "sense_id": "00027f7c-bd7e-3b2d-8b4b-41c00137173b",
                                "text": "[Abwassernetz:] „Zuletzt gab es Erneuerungsarbeiten am Forstweg und der Hubertusstraße, hier lagen ebenfalls noch Leitungen aus den Fünfzigerjahren.“"
                            },
                            {
                                "example_id": "8eeece77-c44a-434f-a132-3f2d7c40f77d",
                                "sense_id": "00027f7c-bd7e-3b2d-8b4b-41c00137173b",
                                "text": "[Haltestellen der Straßenbahnlinie 7 in Leipzig:] Böhlitz-Ehrenberg, Burghausener Straße – Forstweg – […]."
                            },
                            {
                                "example_id": "74260ba1-860f-4398-90fb-fd8c71cbf1de",
                                "sense_id": "00027f7c-bd7e-3b2d-8b4b-41c00137173b",
                                "text": "„Der Stadtteil Kiel-Blücherplatz hat folgenden Grenzverlauf: Die Grenze bildet im Norden der Düvelsbeker Weg, sie verläuft dann zwischen der Sankt-Heinrich-Kirche (Stadtteil Blücherplatz) und der Gaststätte Forstbaumschule (Stadtteil Düsternbrook) auf direktem Wege durch den Wald Forstbaumschule zum Forstweg. Im Osten bildet der Forstweg die Grenze, im Süden die Waitzstraße bis zum Knooper Weg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
