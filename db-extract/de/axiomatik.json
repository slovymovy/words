                                        "sense_id": "242a05fb-16dc-3194-aeb1-d2b8910978ed",
                                        "entry_id": "7ee8e9c0-6c28-39e0-a547-c7f25a585a13",
                                        "glosses": [
                                            "Fondé sur des axiomes, d’une logique de vérité indémontrable, mais faisant autorité en la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a0a801-0285-4b5f-a595-12ddb0dd3696",
                                                "sense_id": "242a05fb-16dc-3194-aeb1-d2b8910978ed",
                                                "text": "La faculté de comprendre ou l’impossibilité de comprendre, dit fort judicieusement M. Mill, ne peut, dans aucun cas, être considérée comme un critérium de Vérité axiomatique."
                                            },
                                            {
                                                "example_id": "9cdfa0d2-1e17-4a81-b087-d0381472cee7",
                                                "sense_id": "242a05fb-16dc-3194-aeb1-d2b8910978ed",
                                                "text": "Changer de système axiomatique de base est une décision difficile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "axiomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
