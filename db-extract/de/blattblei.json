                "senses": [
                    {
                        "sense_id": "c98ba735-8044-3e85-85ba-40e25c97d664",
                        "entry_id": "8be2e0dd-b7b0-33d8-821d-18f906fe7e48",
                        "glosses": [
                            "dünn gewalztes Bleiblech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec86966d-945a-43ff-9b32-ff4f5ad46963",
                                "sense_id": "c98ba735-8044-3e85-85ba-40e25c97d664",
                                "text": "„Nachdem der Kork passend durchbohrt worden ist, schneidet man aus nicht zu dünnem Blattblei eine kreisrunde Scheibe, deren Durchmesser 2 Linien grösser ist als der der zu schützenden unteren Korkfläche, legt diese auf die untere Fläche des Korkes und drückt die überstehenden Ränder an die Seiten des Korkes in kleinen Falten an.“"
                            },
                            {
                                "example_id": "28026b48-6181-4616-9f49-1f1e0f703434",
                                "sense_id": "c98ba735-8044-3e85-85ba-40e25c97d664",
                                "text": "„Bringt man reines Blattblei in eine Lösung von salpetersaurem Silberoxyd, die nicht mehr als 20 g Salz im Liter enthält, so werden auf 1 Aequivalent gelöstes Blei nur 3/4 eines Aequivalentes Silber gefällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
