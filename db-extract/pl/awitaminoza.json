                "senses": [
                    {
                        "sense_id": "cfab78c3-68ee-3fd7-8919-9804820a0c1a",
                        "entry_id": "d5b5c133-cd49-3613-99d7-f58ff7651b41",
                        "glosses": [
                            "stan chorobowy spowodowany niedoborem jednej lub więcej witamin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a10085-3041-46fa-818c-f5fd97888651",
                                "sense_id": "cfab78c3-68ee-3fd7-8919-9804820a0c1a",
                                "text": "Czasem na kolację była zupa — zacierka na wodzie lub kasza. Nie było prawie nigdy ziemniaków lub warzyw. Dzieci cały czas zagrożone były awitaminozą. W lecie starano się, by otrzymywały jakieś owoce — najczęściej nieduże jabłko […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "715df970-9c1c-42e8-9a06-52e95a5dfd85",
                        "source_entry_id": "d5b5c133-cd49-3613-99d7-f58ff7651b41",
                        "source_sense_id": "cfab78c3-68ee-3fd7-8919-9804820a0c1a",
                        "target_lang_word": "avitaminosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avitaminosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bf235f5-e13d-3547-bb52-852a7c525fab",
                                        "entry_id": "dec399e1-8662-3301-bb9d-4ac818c1d906",
                                        "glosses": [
                                            "Any disease which is caused by vitamin deficiency."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2779fd-945a-4d15-a012-17b9ef28c8f5",
                                                "sense_id": "0bf235f5-e13d-3547-bb52-852a7c525fab",
                                                "text": "Watching him, Dorrigo Evans wondered if it was avitaminosis or the combined damage of several maladies that had done this—whatever the cause, he was painfully aware that food would cure this and almost all of the afflictions he saw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48c26517-97e5-43a5-ba95-6ef1de3088b8",
                        "source_entry_id": "d5b5c133-cd49-3613-99d7-f58ff7651b41",
                        "source_sense_id": "cfab78c3-68ee-3fd7-8919-9804820a0c1a",
