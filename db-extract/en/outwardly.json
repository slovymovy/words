    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cc25afd4-eee8-35dd-a200-eec3d3f76aef",
                "word": "outwardly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "13f4e58f-6f31-31d8-a4ae-977dcc33e2f8",
                        "entry_id": "cc25afd4-eee8-35dd-a200-eec3d3f76aef",
                        "glosses": [
                            "Externally or on the outside, or on the surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da41cef5-c3f8-457c-9803-46134d7338e9",
                                "sense_id": "13f4e58f-6f31-31d8-a4ae-977dcc33e2f8",
                                "text": "The terrorist was outwardly a bank clerk."
                            },
                            {
                                "example_id": "ca718217-0a0c-440a-8649-a4b2fc64a431",
                                "sense_id": "13f4e58f-6f31-31d8-a4ae-977dcc33e2f8",
                                "text": "If only she would wake and close her mouth, mentally prayed the outwardly unflinching girl. Later the doctor came, and sheltered by his presence the sick woman's husband stood in the doorway."
                            }
                        ]
                    },
                    {
                        "sense_id": "17d02fc2-88fc-3508-87ff-deed5c6e6d10",
                        "entry_id": "cc25afd4-eee8-35dd-a200-eec3d3f76aef",
                        "glosses": [
                            "Toward the outside"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1de844e7-d9ec-481b-8adb-4934f04e11af",
                        "source_entry_id": "cc25afd4-eee8-35dd-a200-eec3d3f76aef",
                        "source_sense_description": "externally or on the outside",
                        "target_lang_word": "extérieurement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extérieurement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "037d4cbb-4c27-3fd4-a6a5-907a84a8d3fe",
                                        "entry_id": "2588ca82-72f6-3264-97e7-e88b1ed8cbcb",
                                        "glosses": [
                                            "À l’extérieur ; au-dehors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66941970-3aa0-4846-a520-68860055d5f5",
                                                "sense_id": "037d4cbb-4c27-3fd4-a6a5-907a84a8d3fe",
                                                "text": "Le problème des maisons transportables est chose résolue par ici. Huit solides gaillards indigènes nous ont apporté, l'une après l'autre, sur leurs épaules, trois grandes paillotes où nous allons nous loger extérieurement au village."
                                            },
                                            {
                                                "example_id": "2ab31ba5-a0d2-45ae-bca5-ba3ccdd18dbb",
                                                "sense_id": "037d4cbb-4c27-3fd4-a6a5-907a84a8d3fe",
                                                "text": "Sous l’influence de notre foi, l’Univers est susceptible, sans changer extérieurement de traits, de s’assouplir, de s’animer, de se sur-animer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "584bcb7f-6d02-31b4-a18d-11aeddc1a568",
                                        "entry_id": "2588ca82-72f6-3264-97e7-e88b1ed8cbcb",
                                        "glosses": [
                                            "De façon apparente, mais pas nécessairement en réalité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10a4acb3-3b66-4aa7-b4bb-4754bb340cf1",
                                                "sense_id": "584bcb7f-6d02-31b4-a18d-11aeddc1a568",
                                                "text": "Malheur si nous ne l’honorons qu’extérieurement !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66c6c9d2-7a1e-4d5e-bebf-a7c69ea3b6df",
                        "source_entry_id": "cc25afd4-eee8-35dd-a200-eec3d3f76aef",
                        "source_sense_description": "externally or on the outside",
                        "target_lang_word": "äußerlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "äußerlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c41a74d5-df2e-3516-a223-6c822fba9f09",
                                        "entry_id": "51cc3561-8807-3b37-bfbb-6d61ace62112",
                                        "glosses": [
                                            "außen liegend, sich außen befindend, nach außen, von außen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b57b5a-e8e0-4b77-8154-9ec9ffb81b46",
                                                "sense_id": "c41a74d5-df2e-3516-a223-6c822fba9f09",
                                                "text": "Die Salbe ist zur äußerlichen Anwendung."
                                            },
                                            {
                                                "example_id": "e7140bc1-2b4d-4ff8-a45e-4978512df592",
                                                "sense_id": "c41a74d5-df2e-3516-a223-6c822fba9f09",
                                                "text": "Äußerlich betrachtet, hätte ich das Auto zu den jungen Gebrauchten gezählt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7b83fe5-89d2-3f1a-9589-5347f4cc73b6",
                                        "entry_id": "51cc3561-8807-3b37-bfbb-6d61ace62112",
                                        "glosses": [
                                            "nur die Oberfläche betreffend, nicht das Wesen ausmachend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23754073-c039-4433-ad00-80ee2ba9a3d4",
                                                "sense_id": "a7b83fe5-89d2-3f1a-9589-5347f4cc73b6",
                                                "text": "Äußerlich betrachtet, hätte ich das Auto zu den jungen Gebrauchten gezählt."
                                            },
                                            {
                                                "example_id": "01361a5c-88ef-44e7-b20e-4180828ceab2",
                                                "sense_id": "a7b83fe5-89d2-3f1a-9589-5347f4cc73b6",
                                                "text": "Magdalena mag nur äußerlich bleibende Filme nicht."
                                            },
                                            {
                                                "example_id": "50c5302c-55cb-450b-b5af-9c67590f7389",
                                                "sense_id": "a7b83fe5-89d2-3f1a-9589-5347f4cc73b6",
                                                "text": "„Äußerlich anpassungsfähig und im Innern zählebig, haben die Stierspiele bisher alle Anfeindungen überlebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
