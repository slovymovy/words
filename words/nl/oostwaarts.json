                    "sense_definition": "in een oostelijke richting, naar het oosten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De reizigers trokken <w>oostwaarts</w> om de bergen te vermijden.",
                            "target_lang_translations": {
                                "en": "The travelers headed <w>eastward</w> to avoid the mountains.",
                                "ru": "Путешественники отправились <w>на восток</w>, чтобы избежать гор."
                            }
                        },
                        {
                            "text": "Vanaf dit punt moet je <w>oostwaarts</w> reizen om de kust te bereiken.",
                            "target_lang_translations": {
                                "en": "From this point, you must travel <w>eastwards</w> to reach the coast.",
                                "ru": "С этой точки вам нужно ехать <w>на восток</w>, чтобы добраться до побережья."
                            }
                        }
                    ],
                    "synonyms": [
                        "naar het oosten"
                    ],
                    "antonyms": [
                        "westwaarts"
                    ],
                    "common_phrases": [
                        "oostwaarts reizen",
                        "verder oostwaarts"
                    ],
                    "target_lang_definitions": {
                        "en": "in an easterly direction, towards the east",
                        "ru": "в восточном направлении, на восток"
                    },
                    "translations": {
