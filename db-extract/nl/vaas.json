                        "entry_id": "511478bd-3206-32e3-a5c6-dce5b4c98b9b",
                        "glosses": [
                            "een aardewerken of glazen kruik, vooral bedoeld voor het in het water zetten van bloemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95417920-b1b8-4dc0-95dd-c2d216526590",
                                "sense_id": "760aff41-0194-3e4b-8e87-2bd7132214fc",
                                "text": "Hij liet zomaar de vaas uit z'n handen vallen."
                            },
                            {
                                "example_id": "67e048e3-ff6b-47df-9b3c-3f1097e537b8",
                                "sense_id": "760aff41-0194-3e4b-8e87-2bd7132214fc",
                                "text": "Op de overloop boven aan de trap stond een grote vaas met plastic bloemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "072d9176-8f54-4517-9a52-4ab2ccd51973",
                        "source_entry_id": "511478bd-3206-32e3-a5c6-dce5b4c98b9b",
                        "source_sense_id": "760aff41-0194-3e4b-8e87-2bd7132214fc",
                        "source_sense_description": "een aardewerken of glazen kruik, vooral bedoeld voor het in het water zetten van bloemen",
                        "target_lang_word": "Vase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
