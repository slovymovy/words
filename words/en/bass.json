                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small town of <w>Bass</w> during their trip to Victoria.",
                            "target_lang_translations": {
                                "ru": "Они посетили маленький городок <w>Басс</w> во время поездки в Викторию.",
                                "zh": "他们在维多利亚州旅行期间参观了<w>巴斯</w>小镇。"
                            }
