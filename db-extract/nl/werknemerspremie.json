                        "glosses": [
                            "deel van de sociale verzekeringspremies die door de werkenden wordt betaald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b18631a-1311-420c-8a7b-a26dfe67016f",
                                "sense_id": "b20c2a44-69f7-32b5-8b7d-b53e661b1e31",
                                "text": "Maar in de ogen van Kamp is herinvoering van de werknemerspremie voor de WW 'heel onverstandig'. Zo is het slecht voor de koopkracht en maakt het werken minder lonend."
                            },
                            {
                                "example_id": "75642cbe-9faf-4a34-93ee-d18a4d3edf12",
                                "sense_id": "b20c2a44-69f7-32b5-8b7d-b53e661b1e31",
                                "text": "'Binnen die context de WW uitkleden en de bescherming tegen ontslag de nek omdraaien, zorgt voor zoveel boosheid dat het kabinet hier duidelijk over een grens gaat. Een grens die mensen bereid zijn te verdedigen' reageert vicevoorzitter Charley Ramdas van FNV Bouw. Een meerderheid van de aanwezige leden gaf aan best een werknemerspremie te willen betalen om de WW te behouden."
                            }
                        ]
                    }
