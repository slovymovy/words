                            {
                                "example_id": "4b9500c1-69f6-4347-8712-c3d6b299aeb3",
                                "sense_id": "ef169d5e-b633-3d1d-ace7-55da97a79d6e",
                                "text": "De jonge held is terechtgekomen in een bordeel. De inrichting waar sinds mensenheugenis jongemannen heengaan of naartoe worden gestuurd om er de vrouwenaard te leren kennen, zoals het in het Gilgamesj-epos heet."
                            },
                            {
                                "example_id": "cdf8a818-4773-428d-9f15-7fac857a4adf",
                                "sense_id": "ef169d5e-b633-3d1d-ace7-55da97a79d6e",
                                "text": "Hij heeft niet voorzien dat zij, naar vrouwenaard nieuwsgierig, hem is gevolgd en thans weet dat hij Dumouriez' gesprek heeft afgeluisterd."
                            }
                        ]
                    }
