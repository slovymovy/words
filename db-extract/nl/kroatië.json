                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                        "entry_id": "3b33ec8a-f274-3fa0-b8cd-66457c8cde00",
                                        "glosses": [
                                            "Staat in Südosteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c761ccf-a5d2-492a-b2b9-6d1eb8a4aeaf",
                                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                                "text": "Ich komme aus Kroatien."
                                            },
                                            {
                                                "example_id": "123d1935-f87d-4ff8-b16e-ba74d56b1598",
                                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                                "text": "Zagreb ist die Hauptstadt von Kroatien."
                                            },
                                            {
                                                "example_id": "0a603872-613a-4e4b-8dde-9b6a6dfb5b8e",
                                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                                "text": "Im Landesinneren Kroatiens herrscht kontinentales Klima vor."
                                            },
                                            {
                                                "example_id": "c328f3c9-60c4-49fe-ab8b-28b680dd2a6c",
                                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                                "text": "Seit Mitternacht ist Kroatien das 28. Mitglied der EU."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b36c818f-b17c-440c-a73e-6f6688d6dec1",
                        "source_entry_id": "c3ec7ae8-4cdc-3fc2-99f9-91fb8a4fdaa4",
                        "source_sense_id": "0ae5bbda-f533-32da-a313-782343facf09",
                        "source_sense_description": "een land in Oost-Europa ten zuiden van Hongarije",
                        "target_lang_word": "Croatia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Croatia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b51ba7ca-3975-3a2d-82f4-78a810c81683",
                                        "entry_id": "98897398-94bb-3a37-90cd-02f72ac556db",
                                        "glosses": [
                                            "A country on the Balkan Peninsula in Southeast Europe. Official name: Republic of Croatia. Capital and largest city: Zagreb. Part of Yugoslavia until 1991."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e74b84c-49df-4972-ac94-7b9d3bf10598",
                                                "sense_id": "b51ba7ca-3975-3a2d-82f4-78a810c81683",
                                                "text": "The violence began when Serbian troops went into Croatia ostensibly to aid armed ethnic Serbians trying to create their own autonomous states there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e65230c2-db17-4a3c-81c4-9f38b5fc17ba",
                        "source_entry_id": "c3ec7ae8-4cdc-3fc2-99f9-91fb8a4fdaa4",
                        "source_sense_id": "0ae5bbda-f533-32da-a313-782343facf09",
                        "source_sense_description": "een land in Oost-Europa ten zuiden van Hongarije",
                        "target_lang_word": "Croatie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Croatie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                                        "entry_id": "f0e686f4-a63a-379f-943b-225a420dbd29",
                                        "glosses": [
                                            "Pays d’Europe entouré par la Slovénie à l’ouest, la Hongrie au nord, la Serbie et la Bosnie-Herzégovine à l’est, et la mer Adriatique et le Monténégro au sud. Sa capitale est Zagreb."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "908aca57-5be0-4b16-9953-b8c1a39b9e90",
                                                "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                                                "text": "Sous cet aspect pourtant, la Croatie intéresse à bien des égards."
                                            },
                                            {
                                                "example_id": "4349b93f-6b59-4786-aa5f-b94dcac0044a",
                                                "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                                                "text": "Faute de nouvelle formule associative, il n’y avait que l’alternative : ou laisser les minorités serbes de Croatie à la merci d’une croatisation annoncée et menaçante ; ou s’emparer de la Slavonie et de la Krajina et les décroatiser."
                                            },
                                            {
                                                "example_id": "e5af9ecf-10b4-48bb-95b5-72a1001487a7",
                                                "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                                                "text": "De nouvelles secousses telluriques ont frappé mercredi la Croatie, après un séisme de magnitude 6,4 qui a fait au moins sept morts mardi, réduit des immeubles en poussière et privé des quartiers entiers d'électricité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d640862c-da15-49d1-91f1-1ffba424dda0",
                        "source_entry_id": "c3ec7ae8-4cdc-3fc2-99f9-91fb8a4fdaa4",
