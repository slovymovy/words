                            },
                            {
                                "target_lang_word": "encounter",
                                "target_lang_sense_clarification": "to meet with or be faced by something unexpectedly"
                            },
                            {
                                "target_lang_word": "run into",
                                "target_lang_sense_clarification": "to meet or find something by accident"
                            },
                            {
                                "target_lang_word": "stumble upon",
                                "target_lang_sense_clarification": "to discover something by chance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c86b1c7-b2a1-3dcc-ad4f-8f05c5438a11",
                    "sense_definition": "door een botsing met een oppervlak in een andere richting terugkeren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tennisbal <w>stuitte</w> hard tegen de muur en kwam direct terug.",
                            "target_lang_translations": {
                                "en": "The tennis ball <w>bounced</w> hard against the wall and came back immediately."
                            }
                        },
                        {
                            "text": "Je moet de bal laten <w>stuiten</w> voordat je hem met de knuppel raakt.",
                            "target_lang_translations": {
                                "en": "You have to let the ball <w>bounce</w> before you hit it with the bat."
                            }
                        }
                    ],
                    "synonyms": [
