                },
                {
                    "sense_id": "8f777178-b2bb-3e86-9425-1655340420e2",
                    "sense_definition": "Short for <w>discovery</w>, the pre-trial phase in a legal case where evidence is gathered.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyers hope to find important documents during <w>disco</w>.",
                            "target_lang_translations": {
                                "ru": "Юристы надеются найти важные документы в ходе <w>раскрытия доказательств</w>.",
                                "zh": "律师们希望在<w>证据开示</w>阶段找到重要文件。"
                            }
                        },
                        {
                            "text": "We need to finish the <w>disco</w> process before the trial starts.",
