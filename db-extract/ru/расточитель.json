                ],
                "senses": [
                    {
                        "sense_id": "3de6781e-1e2c-359d-a1a7-f55dfba31a69",
                        "entry_id": "9d75d058-8a49-389f-b7b2-1fbb8c2c759f",
                        "glosses": [
                            "тот, кто отличается излишним расточением, расточает, безрассудно тратит что-либо"
                        ],
                        "tags": [],
