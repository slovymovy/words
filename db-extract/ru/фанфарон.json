                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanfaron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2b84ee-158b-3496-b148-0cf8cb9f201a",
                                        "entry_id": "a6a35469-b3b4-3ed1-8def-59f25ce9db9e",
                                        "glosses": [
                                            "A boaster; a braggart."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5623f466-e6e5-43b2-9ce0-e23c361f3c40",
                                                "sense_id": "cc2b84ee-158b-3496-b148-0cf8cb9f201a",
                                                "text": "Peregrine glowing with resentment, called him a Fanfaron, and withdrew, in expectation of being followed into the street."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
