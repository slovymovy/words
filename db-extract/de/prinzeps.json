                        "examples": [
                            {
                                "example_id": "aabef3d4-d7d2-4baa-95b9-ee06b1532f04",
                                "sense_id": "0fa5dd43-bdd3-3273-b118-95ccce6db2f3",
                                "text": "Man darf dies nicht etwa in der Art auffassen, als wäre Ägypten mit dem übrigen Reich nur durch eine Personalunion verknüpft; der Prinzeps ist nach dem Sinn und Geist der Augustischen Ordnung ein integrierendes und dauernd funktionierendes Element des römischen Staatswesens ebenso wie der Senat, und seine Herrschaft über Ägypten geradeso ein Teil der Reichsherrschaft wie die Herrschaft des Prokonsuls von Afrika.",
                                "translation": "The History of Rome",
                                "english": "The History of Rome"
                            }
                        ]
                    }
