                                "target_senses": [
                                    {
                                        "sense_id": "5dbd30b8-64b0-3603-845a-bb2cb7c1ec66",
                                        "entry_id": "19875247-8ddb-31a2-978f-70ae82e61c34",
                                        "glosses": [
                                            "All-encompassing, all around."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe70c4a3-b976-412e-a739-0c8ca33e4314",
                                                "sense_id": "5dbd30b8-64b0-3603-845a-bb2cb7c1ec66",
                                                "text": "We believe also that a controlled economy cannot be understood without some overall view of the controlling institutions: hence our short studies — shorter by far than the original drafts — of the central administration."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4eec0409-e019-35b8-8ccc-206506564e73",
                                        "entry_id": "b1b3c8e4-4fa8-3bf3-8fb2-de93429f4d62",
                                        "glosses": [
                                            "Generally; with everything considered."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca0278d-3cde-4cca-9bbe-d58b51eaf511",
                                                "sense_id": "4eec0409-e019-35b8-8ccc-206506564e73",
                                                "text": "Overall, there is not enough evidence to form a clear conclusion."
                                            }
                                        ]
