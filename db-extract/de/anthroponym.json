                "senses": [
                    {
                        "sense_id": "0fe0439a-2f9d-3932-91ff-ff1be3389749",
                        "entry_id": "fd8a8610-52b9-3b1e-bdce-2749d7778b1e",
                        "glosses": [
                            "Name, der einer Person gegeben wurde oder wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3717a09f-8cdb-42f1-bd25-a8b240b39a97",
                                "sense_id": "0fe0439a-2f9d-3932-91ff-ff1be3389749",
                                "text": "Gute Lexika haben meist ein gesondertes Kapitel „Anthroponyme und Toponyme“."
                            },
                            {
                                "example_id": "c13076ce-9d1e-404c-9a81-54f4b5a72248",
                                "sense_id": "0fe0439a-2f9d-3932-91ff-ff1be3389749",
                                "text": "„Krista“ ist ein finnisches Anthroponym."
                            },
                            {
                                "example_id": "f7b35d7c-12a1-4610-b39d-0add34df924a",
                                "sense_id": "0fe0439a-2f9d-3932-91ff-ff1be3389749",
                                "text": "„Auf dem Gebiet der Anthroponyme dominieren mit großem Abstand die Untersuchungen zu den Personennamen und den Familiennamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d54fbe8-57c3-473b-bd45-97e89f938f93",
                        "source_entry_id": "fd8a8610-52b9-3b1e-bdce-2749d7778b1e",
                        "source_sense_id": "0fe0439a-2f9d-3932-91ff-ff1be3389749",
                        "source_sense_description": "Name, der einer Person gegeben wurde oder wird",
                        "target_lang_word": "anthroponym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthroponym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9920acf-e69a-330e-b3c9-8e018f72570f",
                                        "entry_id": "a08bc0c4-49f5-33d5-8b0c-71371f5f704b",
                                        "glosses": [
                                            "The name of a person, especially a surname."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85749a4a-4503-4546-8f8f-615c1e62e1d9",
                                                "sense_id": "d9920acf-e69a-330e-b3c9-8e018f72570f",
                                                "text": "If an anthroponym associated with a denotatum contains all the information about it, the goal of the author of a street name who uses this anthroponym to create an urbanonym consists in foregrounding a certain layer of information about the primary denotatum, from which this name was taken for secondary use. […] Therefore, concepts in commemorative urbanonymy form a ‘bundle’ of associations, ideas, and memories (comp. Stepanov, 2004), that appear in speakers as a reaction to these names, but at the same time speakers react primarily to the anthroponyms that form the basis of urbanonym units, and the street names themselves act only as ‘carriers’ of specific meaning, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44de30ed-f9e6-4f39-8fec-613baf551f53",
                        "source_entry_id": "fd8a8610-52b9-3b1e-bdce-2749d7778b1e",
                        "source_sense_id": "0fe0439a-2f9d-3932-91ff-ff1be3389749",
                        "source_sense_description": "Name, der einer Person gegeben wurde oder wird",
                        "target_lang_word": "anthroponyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthroponyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce7b373-9e53-30c9-b60b-a7255b05a2bc",
                                        "entry_id": "e9282aa9-fc0c-3c53-9838-fa9127f283f3",
                                        "glosses": [
                                            "Nom de personne désignant un être humain ou un ensemble d’êtres humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68fe4603-eaae-4ceb-a762-84ab8e4273a1",
                                                "sense_id": "0ce7b373-9e53-30c9-b60b-a7255b05a2bc",
                                                "text": "À première vue les anthroponymes ou noms de personnes de Normandie ne présentent rien de particulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "870fa99f-4153-369a-bcb4-2964771e6b59",
                                        "entry_id": "e9282aa9-fc0c-3c53-9838-fa9127f283f3",
                                        "glosses": [
                                            "Anthropotoponyme, c’est-à-dire un toponyme portant le nom d’une personne."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fedd61c2-84a7-4492-8618-5afb0ba78ee2",
                                                "sense_id": "870fa99f-4153-369a-bcb4-2964771e6b59",
                                                "text": "Les particularités de traitement de Washington sont probablement liées au fait qu’il est issu d’un anthroponyme, comme Israël, seul nom de pays à ne pas prendre l’article, et du reste aussi comme Vancouver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
