                    "frequency": "High",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you brought all your <w>things</w> with you?",
                            "target_lang_translations": {
                                "ru": "Ты взял с собой все свои <w>вещи</w>?",
                                "zh": "你把所有的<w>东西</w>都带上了吗？",
                                "de": "Hast du all deine <w>Sachen</w> mitgebracht?"
                            }
                        },
                        {
                            "text": "Please get your <w>things</w> off the table.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убери свои <w>вещи</w> со стола.",
                                "zh": "请把桌子上的<w>东西</w>拿走。",
                                "de": "Bitte nimm deine <w>Sachen</w> vom Tisch."
                            }
                        }
