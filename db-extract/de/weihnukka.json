                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chrismukkah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cceb637-ea5b-3e4d-81f5-727acebf2bc2",
                                        "entry_id": "dab8223c-158e-3347-9f0e-451bbe97fc43",
                                        "glosses": [
                                            "The merged holiday of Christmas and Hanukkah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0434dff-e626-46df-be7a-c86d22798a31",
                                                "sense_id": "0cceb637-ea5b-3e4d-81f5-727acebf2bc2",
                                                "text": "Kimberly Duran of DallasNews.com, for example, referenced restaurants that served Chrismukkah foods in 2005 when Hanukkah and Christmas coincided."
                                            },
                                            {
                                                "example_id": "cafee187-bc73-46f3-bae4-26cb33af9e7b",
                                                "sense_id": "0cceb637-ea5b-3e4d-81f5-727acebf2bc2",
                                                "text": "“For me, Chrismukkah represents our relationship at its best,” Pham said in a CNN iReport."
                                            },
                                            {
                                                "example_id": "cfc76a5d-2c8f-4054-8439-d8e5fb7d3b1f",
                                                "sense_id": "0cceb637-ea5b-3e4d-81f5-727acebf2bc2",
                                                "text": "Celebrating both holidays is nothing new. But the TV show “The O.C.” helped popularize a term for it when the character Seth Cohen (played by Adam Brody) celebrated “Chrismukkah” in an episode in 2003."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
