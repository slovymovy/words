            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9e708c3-bfcf-3784-91c7-3ef8885e3b47",
                    "sense_definition": "iemand begroeten of afscheid nemen door de hand heen en weer te bewegen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "handbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen stonden al enthousiast te <w>zwaaien</w> toen we eindelijk met de auto aankwamen.",
                            "target_lang_translations": {
                                "en": "The children were already <w>waving</w> enthusiastically when we finally arrived by car."
                            }
                        },
                        {
                            "text": "Vergeet niet even naar je oma te <w>zwaaien</w> voordat we wegrijden.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>wave</w> to your grandmother before we drive away."
                            }
                        }
                    ],
                    "synonyms": [
                        "wuiven"
                    ],
                    "common_phrases": [
                        "even zwaaien",
                        "naar iemand zwaaien",
                        "vrolijk zwaaien"
                    ],
                    "target_lang_definitions": {
                        "en": "to greet someone or say goodbye by moving the hand back and forth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wave",
                                "target_lang_sense_clarification": "to move the hand in greeting or departure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "598bef0e-8ac7-30cf-b13e-67686579ad8b",
                    "sense_definition": "de aandacht trekken door met de armen of een voorwerp heen en weer te bewegen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "handbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man stond wild te <w>zwaaien</w> om ons aan te geven dat we daar niet mochten rijden.",
                            "target_lang_translations": {
                                "en": "The man was <w>waving</w> wildly to indicate to us that we weren't allowed to drive there."
                            }
                        },
                        {
                            "text": "Toen hij de bus zag aankomen, begon hij met zijn armen te <w>zwaaien</w>.",
                            "target_lang_translations": {
                                "en": "When he saw the bus arriving, he started <w>waving</w> his arms."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met de armen zwaaien",
                        "om aandacht zwaaien"
                    ],
                    "target_lang_definitions": {
                        "en": "to attract attention by moving the arms or an object back and forth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wave",
                                "target_lang_sense_clarification": "to signal or call attention by moving the arms"
                            },
                            {
                                "target_lang_word": "flail",
                                "target_lang_sense_clarification": "to wave arms wildly or uncontrollably"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1adcb57e-89e4-3e4a-9333-b1e00bfbd257",
                    "sense_definition": "op een losse manier heen en weer bewegen of slingeren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De takken van de bomen <w>zwaaien</w> heen en weer door de harde wind.",
                            "target_lang_translations": {
                                "en": "The branches of the trees are <w>swaying</w> back and forth due to the strong wind."
                            }
                        },
                        {
                            "text": "Zijn lange jas bleef maar <w>zwaaien</w> terwijl hij gehaast door de straat liep.",
                            "target_lang_translations": {
                                "en": "His long coat kept <w>swinging</w> as he walked hurriedly through the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "slingeren",
                        "zwiepen",
                        "schommelen"
                    ],
                    "common_phrases": [
                        "heen en weer zwaaien"
                    ],
                    "target_lang_definitions": {
                        "en": "to move back and forth or swing in a loose manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sway",
                                "target_lang_sense_clarification": "to move slowly or rhythmically back and forth"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "to move back and forth from a fixed point"
                            },
                            {
                                "target_lang_word": "wave",
                                "target_lang_sense_clarification": "to move back and forth in the wind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65a940e7-2860-38cd-83b8-e1005c2538c8",
                    "sense_definition": "op een dreigende of krachtige manier met een voorwerp in de lucht bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boze man begon gevaarlijk met een stok te <w>zwaaien</w> tijdens de ruzie.",
                            "target_lang_translations": {
                                "en": "The angry man began <w>brandishing</w> a stick dangerously during the argument."
                            }
                        },
                        {
                            "text": "De ridder bleef met zijn zwaard <w>zwaaien</w> om de vijanden op afstand te houden.",
                            "target_lang_translations": {
                                "en": "The knight kept <w>swinging</w> his sword to keep the enemies at a distance."
                            }
                        }
                    ],
                    "synonyms": [
                        "brandshatten"
                    ],
                    "common_phrases": [
                        "met een wapen zwaaien",
                        "dreigend zwaaien"
                    ],
                    "target_lang_definitions": {
                        "en": "to move an object in the air in a threatening or powerful way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brandish",
                                "target_lang_sense_clarification": "to wave a weapon or object threateningly"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "to move an object with force or a wide motion"
                            },
                            {
                                "target_lang_word": "wield",
                                "target_lang_sense_clarification": "to hold and use a weapon or tool"
                            }
                        ]
                    }
                }
            ]
        },
        {
