                    },
                    {
                        "translation_id": "8a1471e7-1208-463e-a87e-98ca9a37c9c5",
                        "source_entry_id": "ad797726-dc04-3865-8ac0-cf9401fbbc5e",
                        "source_sense_id": "4f179064-6d7f-32a1-90d7-02d0f3b0d306",
                        "source_sense_description": "tot dienst bereid",
                        "target_lang_word": "ready",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ready",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91d23a5d-bdd5-3530-9147-e1777744cc27",
                                        "entry_id": "138e0ef9-9f0e-30de-921c-6c2b63ddc791",
                                        "glosses": [
                                            "Prepared for immediate action or use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f4bbdc-d96b-470f-ba53-714b2b3f4747",
                                                "sense_id": "91d23a5d-bdd5-3530-9147-e1777744cc27",
                                                "text": "The troops are ready for battle."
                                            },
                                            {
                                                "example_id": "f903531c-93e9-4427-a274-f7395ccac339",
                                                "sense_id": "91d23a5d-bdd5-3530-9147-e1777744cc27",
                                                "text": "The porridge is ready to serve."
                                            },
                                            {
                                                "example_id": "282cba51-5cb1-40c8-a8c6-da16b91f7d78",
                                                "sense_id": "91d23a5d-bdd5-3530-9147-e1777744cc27",
                                                "text": "If need be, I am ready to forego / And quit:"
                                            },
                                            {
                                                "example_id": "14407411-50c1-43bc-8e60-c1d8ef79ebb7",
                                                "sense_id": "91d23a5d-bdd5-3530-9147-e1777744cc27",
                                                "text": "she was told dinner was ready"
                                            },
                                            {
                                                "example_id": "4bb9e69e-3436-4d7b-aad3-8260b7a9cf7f",
                                                "sense_id": "91d23a5d-bdd5-3530-9147-e1777744cc27",
                                                "text": "Miranda: I'll admit it, Shepard. I'm impressed. You got us here. Are you ready?\nShepard: We're going in blind, and we don't even know if we'll survive the trip. No way in hell we're ready... but we don't have a choice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca667cb-2b19-30ce-a72c-731052915125",
                                        "entry_id": "138e0ef9-9f0e-30de-921c-6c2b63ddc791",
                                        "glosses": [
                                            "Inclined; apt to happen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aa3ad53-aad2-38a4-8747-c50058cd2111",
                                        "entry_id": "138e0ef9-9f0e-30de-921c-6c2b63ddc791",
                                        "glosses": [
                                            "Liable at any moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e54a27c-1ec1-4bc3-b40e-9ea2dd00929b",
                                                "sense_id": "9aa3ad53-aad2-38a4-8747-c50058cd2111",
                                                "text": "The seed is ready to sprout."
                                            },
                                            {
                                                "example_id": "105f0ed3-e693-42e5-8feb-2e2d079caba3",
                                                "sense_id": "9aa3ad53-aad2-38a4-8747-c50058cd2111",
                                                "text": "My heart is ready to crack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                        "entry_id": "138e0ef9-9f0e-30de-921c-6c2b63ddc791",
                                        "glosses": [
                                            "Not slow or hesitating; quick in action or perception of any kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c64a2190-5bd8-47f3-9d23-a5f2dcc6e938",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "a ready apprehension"
                                            },
                                            {
                                                "example_id": "421712db-5f94-4791-ad85-be69a4a80b48",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "ready wit"
                                            },
                                            {
                                                "example_id": "dab9570e-3d0d-44f0-9cce-a8fa2956fce4",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "a ready writer or workman"
                                            },
                                            {
                                                "example_id": "1792df02-fbd5-47e4-b1bb-ec9ec8c50923",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "whose temper was ready, though surly"
                                            },
                                            {
                                                "example_id": "0be37707-011b-4ad7-b531-68143f3d6430",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "ready in devising expedients"
                                            },
                                            {
                                                "example_id": "1def2011-2d39-48c6-9e28-1e68daea3b85",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "Molly the dairymaid came a little way from the rickyard, and said she would pluck the pigeon that very night after work. She was always ready to do anything for us boys; and we could never quite make out why they scolded her so for an idle hussy indoors. It seemed so unjust. Looking back, I recollect she had very beautiful brown eyes."
                                            },
                                            {
                                                "example_id": "fc051794-a0aa-4df7-93d0-bbdaa91f772a",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "\"Apple of Death\" is what the Jungle call thorn-apple or dhatura, the readiest poison in all India."
                                            },
                                            {
                                                "example_id": "70de93e4-f8fe-421a-88d2-f9277cfa8c2b",
                                                "sense_id": "72dad2a5-d6f9-36a9-b7d0-f39e678d114f",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25a7fd8-efe9-3cce-abca-63cec2432550",
                                        "entry_id": "138e0ef9-9f0e-30de-921c-6c2b63ddc791",
                                        "glosses": [
                                            "Offering itself at once; at hand; opportune; convenient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bf453a6-bf7f-47ca-a1bf-a9778bedf9a5",
                                                "sense_id": "a25a7fd8-efe9-3cce-abca-63cec2432550",
                                                "text": "Through the wilde Deſert, not the readieſt way,"
                                            },
                                            {
                                                "example_id": "73a5451f-06e1-443a-83e8-93ccefa5aaf6",
                                                "sense_id": "a25a7fd8-efe9-3cce-abca-63cec2432550",
                                                "text": "A sapling pine he wrenched from out the ground, / The readiest weapon that his fury found."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ready",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba51035b-7bfc-30bc-9432-21572543f382",
                                        "entry_id": "269c60ea-f23a-3ef8-8881-f77d5b3a1d3d",
                                        "glosses": [
                                            "To prepare; to make ready for action."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f68156-83cd-455b-8455-1be0ca660b93",
                                                "sense_id": "ba51035b-7bfc-30bc-9432-21572543f382",
                                                "text": "Immigration agents in military green surrounded MacArthur Park as the convoy readied for a show of force akin to a Hollywood movie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ready",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c41bbfb-da4b-3a0b-a3a8-b25fe6718ef8",
                                        "entry_id": "c626637d-a0ed-3d50-bc40-0d606cd89185",
                                        "glosses": [
                                            "Ready money; cash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46b670f7-31fb-4579-aa7a-ae0d8eacae97",
                                                "sense_id": "2c41bbfb-da4b-3a0b-a3a8-b25fe6718ef8",
                                                "text": "[H]e vvas not fluſh in Ready, either to go to Lavv or clear old Debts, neither could he find good Bail: […]"
                                            },
                                            {
                                                "example_id": "7deee1b4-7a16-41e1-8f0b-dfe715a410a3",
                                                "sense_id": "2c41bbfb-da4b-3a0b-a3a8-b25fe6718ef8",
                                                "text": "[…] he was generous when he had the cash. Many a time he kept me going in drink through the week when I was stuck for the ready […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ready",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83fd02ad-cb28-3365-a5a5-ba2556339734",
                                        "entry_id": "376961ad-06a8-34ce-b88b-7414d0c8e639",
                                        "glosses": [
                                            "Already, in advance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a71e9d9-e422-4fc6-bbcf-55891ce3caf6",
                                                "sense_id": "83fd02ad-cb28-3365-a5a5-ba2556339734",
                                                "text": "a loaf of ready-sliced bread"
                                            },
                                            {
                                                "example_id": "455cb07f-d187-4fdf-8173-f5ac14087c70",
                                                "sense_id": "83fd02ad-cb28-3365-a5a5-ba2556339734",
                                                "text": "The cave was like a ready-made home for us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2c23d10-12cc-410e-9468-9b6f8ba66296",
                        "source_entry_id": "ad797726-dc04-3865-8ac0-cf9401fbbc5e",
                        "source_sense_id": "4f179064-6d7f-32a1-90d7-02d0f3b0d306",
                        "source_sense_description": "tot dienst bereid",
                        "target_lang_word": "willing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "willing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                        "entry_id": "182c6136-0a62-3bc8-a083-d11be99c66f0",
                                        "glosses": [
                                            "Ready to do something, particularly something that requires change or effort; not objecting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca4ee22-d39d-4411-86b1-d934e9e200fe",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "If my boyfriend isn't willing to change his drinking habits, I will split up with him."
                                            },
                                            {
                                                "example_id": "b2ac2137-2408-477d-9530-376c7176c10c",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "In the eyes of Mr. Farquhar Fenelon Cooke the apotheosis of the Celebrity was complete. The people of Asquith were not only willing to attend the house-warming, but had been worked up to the pitch of eagerness. The Celebrity as a matter of course was master of ceremonies."
                                            },
                                            {
                                                "example_id": "87a62fb7-fed8-4b30-8e22-b10823fc1fb2",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "\"Of course, the ventilation is awful. We pump the air down, but two-hour shifts are the most the men can do - and they are willing lads too.\""
                                            },
                                            {
                                                "example_id": "012c04c8-b222-4f94-8f57-3ed2a4bea7ca",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Coal-eaters they may have been, but a more willing or harder working Atlantic engine was never designed."
                                            },
                                            {
                                                "example_id": "4498e350-caff-4c1c-a04c-c8b230c97daa",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            },
                                            {
                                                "example_id": "42929a8c-4878-488e-8fb8-398feea99fe2",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            }
                                        ]
                                    }
                                ]
                            },
