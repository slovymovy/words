                                "target_senses": [
                                    {
                                        "sense_id": "a2fc4f25-4678-3837-990b-2904be4f0693",
                                        "entry_id": "17d69599-2b92-32ed-b389-7dc45eaa35da",
                                        "glosses": [
                                            "zur Diffusion fähig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89761818-4378-42aa-acf0-1fc25c652c9e",
                                                "sense_id": "a2fc4f25-4678-3837-990b-2904be4f0693",
                                                "text": "„Das Radiopharmakon kann – wenn es wenig diffusibel ist – lokal in einen vorbestehenden Hohlraum (zum Beispiel Gelenke, Pleura (Rippenfell), Peritoneum (Bauchfell) oder Zysten) eingebracht werden (intrakavitäre Therapie).“"
                                            },
                                            {
                                                "example_id": "80fd010d-bb25-4059-9456-3fdc1aa90fbf",
                                                "sense_id": "a2fc4f25-4678-3837-990b-2904be4f0693",
                                                "text": "„Der anorganische Phosphor war ganz diffusibel, der Gehalt war im Mittel 4,10 mg-%.“"
                                            },
                                            {
                                                "example_id": "8d9669c1-d10b-402b-8ebd-af9404ac5427",
                                                "sense_id": "a2fc4f25-4678-3837-990b-2904be4f0693",
                                                "text": "„Ein Gleichgewichtspotential, das durch einen einzigen diffusiblen Ionentyp verursacht wird, kann mit der Nernst-Gleichung beschrieben werden.“"
                                            },
                                            {
                                                "example_id": "4b070e1c-8f1f-441a-a4dd-699a2ff342d4",
                                                "sense_id": "a2fc4f25-4678-3837-990b-2904be4f0693",
                                                "text": "„Die Summe der Konzentrationen der diffusiblen Ionen ist in der proteinhaltigen Lösung größer als in der proteinfreien.“"
                                            },
                                            {
                                                "example_id": "d8aff087-9ffb-4f44-a959-931fdb996427",
                                                "sense_id": "a2fc4f25-4678-3837-990b-2904be4f0693",
                                                "text": "„Das Endothel bildet neben NO und PGI_2 auch andere diffusible Moleküle, die eine Hyperpolarisation der glatten Gefäßmuskulatur induzieren und somit als Teil des EDHF-Systems in Betracht kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
