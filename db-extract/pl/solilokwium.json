                                "target_senses": [
                                    {
                                        "sense_id": "1b0a0487-c0da-3378-9b1e-ab9c13eb29b6",
                                        "entry_id": "8c6994fa-e47c-3431-b403-97b3c9af6141",
                                        "glosses": [
                                            "Representación teatral en la que un actor habla para sí mismo. Se diferencia del monólogo en que en éste el actor habla dirigiéndose al público."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ba0b35d-09ef-3152-bcbb-1813e8ebd865",
                                        "entry_id": "8c6994fa-e47c-3431-b403-97b3c9af6141",
                                        "glosses": [
                                            "Reflexiones que se realizan en voz alta y a solas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8dcc183-8a8f-4ea1-97a8-dd61221dd441",
                                                "sense_id": "5ba0b35d-09ef-3152-bcbb-1813e8ebd865",
                                                "text": "«En ese soliloquio, acuciante, me decía: Si la Academia tuvo la bondad de designarme entre los marinos para que los profesionales de la mar tuvieran representante en la sede del buen decir, indicado es, entonces, la elección de un tema acerca de algo que se relacione con el mar …»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "60e24f20-a3cf-317a-820d-85ce4876b8e4",
                                        "entry_id": "8c6994fa-e47c-3431-b403-97b3c9af6141",
                                        "glosses": [
                                            "Reflexiones que realizan los psicóticos esquizofrénicos en voz alta y a solas, es un diálogo con sigo mismo, sin la presencia de un otro."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
