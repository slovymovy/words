                "senses": [
                    {
                        "sense_id": "1086bdbd-a683-3e07-8633-1b39892c3689",
                        "entry_id": "0d8f9df6-193b-3a0c-ad99-c98c022fa20c",
                        "glosses": [
                            "das britische Kolonialreich auf dem Indischen Subkontinent von der 2. Hälfte des 18. Jahrhunderts (im engeren Sinne von 1858) bis 1947/48"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96420ba1-7a4d-494f-87cc-eab110a1f8c4",
                                "sense_id": "1086bdbd-a683-3e07-8633-1b39892c3689",
                                "text": "„In dieses Britisch-Indien waren die Fürstenstaaten als Enklaven eingesprengt, die 1939 auf zwei Fünfteln des Territoriums ein knappes Viertel der Bevölkerung, 90 von 380 Millionen, umfassten.“"
                            },
                            {
                                "example_id": "d4665a47-fcbb-4745-a599-e47ea8e777c5",
                                "sense_id": "1086bdbd-a683-3e07-8633-1b39892c3689",
                                "text": "„Zwar standen zum damaligen Zeitpunkt noch keine relevanten politischen Entscheidungen an. Jedoch bereiteten die Briten mit dieser Separierung von Hindus und Muslimen das Fundament für die Teilung Britisch-Indiens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
