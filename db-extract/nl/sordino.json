                "senses": [
                    {
                        "sense_id": "2ad74a55-5497-33eb-b6e0-b7f64bf5da7d",
                        "entry_id": "07b4f2fe-5e98-374d-8c24-df29bbfa7ec1",
                        "glosses": [
                            "geluiddemper op muziekinstrumenten, zoals in de beker van een blaasinstrument of op de kam van een strijkinstrument"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccf96e1-744a-46b9-93c5-a47e0b50daf5",
                                "sense_id": "2ad74a55-5497-33eb-b6e0-b7f64bf5da7d",
                                "text": "In ‘...à l’âme de marcher sur ses pieds de soie...’ (2004), op tekst van Darwish, kwamen ook prachtige momenten voorbij, bijvoorbeeld een sensuele dialoog tussen een met sordino gedempte cello en een baryton, een oud strijkinstrument met een zeer fragiele klank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c428a623-e717-4676-bd0d-d47b774d526f",
                        "source_entry_id": "07b4f2fe-5e98-374d-8c24-df29bbfa7ec1",
                        "source_sense_id": "2ad74a55-5497-33eb-b6e0-b7f64bf5da7d",
                        "target_lang_word": "sourdine",
