                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "24a036af-cda2-4ef5-9ca9-20a423ca19b5",
                                "sense_id": "73c59519-5e85-3a12-a5bd-719d8d546ec3",
                                "text": "Sur le pavé, le train de Busard redescendit à quarante à l’heure. Toute la ville était massée sur les trottoirs. Le tintinabulement : « Il saigne… il saigne… il saigne… » nous accompagna de nouveau. La cuisse saignait de plus en plus."
                            }
                        ]
                    }
                ],
