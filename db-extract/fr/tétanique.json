                            {
                                "example_id": "252768d7-2357-499a-8104-36dd9c9da356",
                                "sense_id": "c4e07cbb-da8c-3839-9b6c-701dc1b93077",
                                "text": "Convulsion tétanique."
                            },
                            {
                                "example_id": "e28a98f8-d107-42e5-b171-9b5a2358ce92",
                                "sense_id": "c4e07cbb-da8c-3839-9b6c-701dc1b93077",
                                "text": "Outre la menace tétanique pour une paille de fer sous la peau, on risquait de périr écrasé sous les lourds panneaux ou transpercé par une lame dessoudée."
                            }
                        ]
                    }
                ],
                "translations": [
