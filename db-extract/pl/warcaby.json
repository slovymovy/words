                        "entry_id": "036b3022-4872-3659-a7db-53fb7c8a5b33",
                        "glosses": [
                            "gra dwuosobowa, w której gracze wykonują na przemian ruchy identycznymi bierkami na planszy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772c7ad3-c71a-4444-aa5f-62ef969c7677",
                                "sense_id": "108caf93-1a81-331a-a344-47163ec35182",
                                "text": "Cały czas lało, dzieci grały w warcaby, a my oglądaliśmy jakiś stary kryminał."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "158b947e-c91c-3758-9aee-6fead4a94ef3",
                        "entry_id": "036b3022-4872-3659-a7db-53fb7c8a5b33",
                        "glosses": [
                            "plansza i pionki do warcabów (1.1)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c409796b-6227-4c1a-8194-445e3a991b70",
                                "sense_id": "158b947e-c91c-3758-9aee-6fead4a94ef3",
                                "text": "Pod telewizorem leżało kilka kaset, warcaby i szklana popielniczka z herbem Rzymu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
