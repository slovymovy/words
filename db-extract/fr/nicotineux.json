                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052cd499-94df-4b68-9d50-ba9b8e1e9921",
                                "sense_id": "df135848-cf77-3d7a-97f0-ce0c1829a2c1",
                                "text": "Pinaud lisse de ses doigts secs et nicotineux les quatre poils grisâtres qui lui tiennent lieu de favoris."
                            },
                            {
                                "example_id": "824c4f0c-113d-4f77-b971-5781497592df",
                                "sense_id": "df135848-cf77-3d7a-97f0-ce0c1829a2c1",
                                "text": "Des voix nicotineuses montaient des Meanwhile Gardens qu'elle longeait, souvent fréquentés le soir par des poivrots. Lucas avait terriblement honte de son imposture."
                            }
                        ]
