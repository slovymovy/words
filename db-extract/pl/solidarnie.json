                                    {
                                        "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                                        "entry_id": "0d493cd2-feb1-332f-9265-a6fcf560c20b",
                                        "glosses": [
                                            "Together, acting as one; collectively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a9ceb8b-7ed9-4361-800d-a45e0d07873a",
                                                "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                                                "text": "They jointly raised the child, even though they were no longer married."
                                            },
                                            {
                                                "example_id": "7a2d3a1d-da45-4f62-a966-7bd4657cf752",
                                                "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                                                "text": "Interlaken East station is jointly owned with the standard gauge Bern-Lötschberg-Simplon Railway from Bern and Thun and the Swiss Federal Railways metre-gauge Brünig line from Lucerne, but is managed and staffed by the Bernese Oberland group."
                                            },
                                            {
                                                "example_id": "cdf3dd80-aa3c-4835-80e5-c557db873863",
                                                "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                                                "text": "As a result of that Ministerial, the four Attorneys General – of the United States, El Salvador, Guatemala and Honduras – have jointly pledged to target MS-13."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb2bceb9-98eb-42b6-a439-9b823f9d2623",
                        "source_entry_id": "0eede052-06a8-3481-a1e4-4dd01aa06a53",
                        "source_sense_id": "750478c8-773a-33ee-8aa9-0d38ffc3e2f7",
                        "target_lang_word": "solidairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solidairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                        "entry_id": "77a49afe-0486-31a2-9c20-93b8ba8c1c60",
                                        "glosses": [
                                            "D’une façon solidaire, d’une manière où chacun répond pour le tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1f70a5-c94c-45d9-9915-c64d75198a60",
                                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                                "text": "Une bonne amende de mille écus, à quoi vous êtes solidairement condamnée avec votre M. le baron,"
                                            },
                                            {
                                                "example_id": "1230fa78-a995-4dd3-8525-ea17d60b613f",
                                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                                "text": "Dès lors [depuis que Henri IV prit un jésuite pour confesseur] chaque frère jésuite se crut solidairement confesseur du roi,"
                                            },
                                            {
                                                "example_id": "7d2484b4-ae63-4666-b8c1-063b41092638",
                                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                                "text": "Dans les sociétés autres que celles de commerce, les associés ne sont pas tenus solidairement des dettes sociales,"
                                            },
                                            {
                                                "example_id": "7edc5efe-46c1-408b-b9f4-291e6dcb84d1",
                                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                                "text": "Si plusieurs ont conjointement emprunté la même chose, ils en sont solidairement responsables envers le prêteur,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
