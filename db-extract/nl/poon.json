                        ]
                    },
                    {
                        "translation_id": "c0f867bb-331b-4422-af00-a8ed844c8b23",
                        "source_entry_id": "154baa22-a0c2-328e-bfef-ffb67f4202f2",
                        "source_sense_id": "2a150c7e-6ea7-376b-91fc-a99fda9c2b37",
                        "source_sense_description": "benaming voor zeevissen uit familie Triglidae",
                        "target_lang_word": "grondin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
