    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5db9bb54-0f01-376e-aba3-3402d1b89735",
                    "sense_definition": "Cavité souterraine naturelle très profonde et abrupte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spéléologues se préparent à descendre dans ce gigantesque <w>gouffre</w> calcaire."
                        },
                        {
                            "text": "Le randonneur imprudent s'est arrêté juste au bord du <w>gouffre</w>."
                        }
                    ],
                    "synonyms": [
                        "abîme",
                        "aven"
                    ],
                    "common_phrases": [
                        "au bord du gouffre",
                        "profond gouffre"
                    ]
                },
                {
                    "sense_id": "af7fe95b-2231-3733-9fec-31cbbc4b503b",
                    "sense_definition": "Activité, projet ou objet qui consomme excessivement d'argent ou d'autres ressources.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La rénovation de cette vieille bâtisse est devenue un véritable <w>gouffre</w> financier."
                        },
                        {
                            "text": "Cette voiture d'occasion consomme tellement d'essence qu'elle est un vrai <w>gouffre</w>."
                        }
                    ],
                    "common_phrases": [
                        "gouffre financier",
                        "véritable gouffre financier"
                    ]
                },
                {
                    "sense_id": "eebbb915-8b41-31a7-aea2-c89c758bfd93",
                    "sense_definition": "Différence ou distance considérable qui sépare des personnes, des opinions ou des réalités.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il existe un <w>gouffre</w> entre leurs visions politiques respectives."
                        },
                        {
                            "text": "Ce malentendu a fini par creuser un <w>gouffre</w> entre les deux collègues."
                        }
                    ],
                    "common_phrases": [
                        "creuser un gouffre"
                    ]
                },
                {
                    "sense_id": "ec363236-70c1-3332-b8f5-e1fec831279d",
                    "sense_definition": "Entité abstraite qui semble tout absorber ou engloutir dans un vide sans fin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces promesses électorales ont fini par disparaître dans le <w>gouffre</w> de l'oubli."
                        },
                        {
                            "text": "Après le décès de sa femme, il s'est senti happé par le <w>gouffre</w> du désespoir."
                        }
                    ],
                    "synonyms": [
                        "abîme"
                    ]
                },
                {
                    "sense_id": "07856801-f603-3f09-8c75-a927cb029511",
                    "sense_definition": "Meuble héraldique figurant une spirale ou un tourbillon d'eau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces anciennes armoiries portent un <w>gouffre</w> d'azur sur fond d'argent."
                        },
                        {
                            "text": "L'écu familial est orné d'un <w>gouffre</w> en son centre."
                        }
                    ]
                }
            ]
        }
    ]
