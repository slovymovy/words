                ],
                "senses": [
                    {
                        "sense_id": "df906e43-3a1a-3699-94c2-bd1694c14926",
                        "entry_id": "5f6370ad-1c01-3ca9-bbef-5d9f1f26af12",
                        "glosses": [
                            "having a fringe (decorative border) or resembling a fringe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c71333f0-a6e5-4463-974a-d65d63ff8876",
                                "sense_id": "df906e43-3a1a-3699-94c2-bd1694c14926",
                                "text": "Дорого́й бахро́мчатый ве́ер трещи́т в её су́дорожно сжа́той руке́, pince-nez то и де́ло спада́ет с её хоро́шенького но́сика, бро́шка на груди́ то поднима́ется, то опуска́ется, то́чно ладья́ среди́ волн. Она́ взволно́вана…",
                                "translation": "An expensive fluffy fan trembles in her tightly closed fingers, a pince-nez keeps dropping off her pretty little nose, the brooch heaves and falls on her bosom, like a boat on the ocean. She is greatly agitated.",
                                "english": "An expensive fluffy fan trembles in her tightly closed fingers, a pince-nez keeps dropping off her pretty little nose, the brooch heaves and falls on her bosom, like a boat on the ocean. She is greatly agitated."
                            }
                        ]
                    }
