                "senses": [
                    {
                        "sense_id": "07e9f39a-39a9-3085-8a54-35343c41086b",
                        "entry_id": "5ff0d38b-1362-30a6-8b2e-78a8d3616a7f",
                        "glosses": [
                            "Zweig einer Kiefer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d03ec3f4-20a8-4c55-8205-2964f0968831",
                                "sense_id": "07e9f39a-39a9-3085-8a54-35343c41086b",
                                "text": "Ein oder zwei Kiefernzweige, mit ein paar Zapfen und einer roten Schleife dekoriert, sind ein schöner weihnachtlicher Blickfang in der Eingangshalle."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
