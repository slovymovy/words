                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osobny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "13ab3e0a-bbb4-3546-bcf0-022b142e0463",
                                        "entry_id": "aabb6edc-f7f3-3020-bbbc-975bf2d051c2",
                                        "glosses": [
                                            "oddzielony, oddalony od innych, mający specjalne przeznaczenie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f4286a-4d74-44cd-8f7f-20f4a59561e1",
                                                "sense_id": "13ab3e0a-bbb4-3546-bcf0-022b142e0463",
                                                "text": "Każde z nas ma już teraz świat osobny, zupełnie inny."
                                            },
                                            {
                                                "example_id": "8b34edba-822a-4a23-8577-814deee9324c",
                                                "sense_id": "13ab3e0a-bbb4-3546-bcf0-022b142e0463",
                                                "text": "Odnajmuje małą izdebkę z alkierzem, z osobnym wejściem od tyłu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "be664d8f-f08e-3a81-9fcb-07f4e80672ca",
                                        "entry_id": "aabb6edc-f7f3-3020-bbbc-975bf2d051c2",
                                        "glosses": [
                                            "szczególny, wyjątkowy, osobliwy"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0c8c5d-4e74-4d2b-b7ae-2cdeb7bff9af",
                                                "sense_id": "be664d8f-f08e-3a81-9fcb-07f4e80672ca",
                                                "text": "Wspominana powieściopisarka przejawia osobną predylekcję do opisów piękna przyrody."
                                            },
                                            {
                                                "example_id": "37c9dc66-6e7d-47a7-9a00-ff9e8d498563",
                                                "sense_id": "be664d8f-f08e-3a81-9fcb-07f4e80672ca",
                                                "text": "Dostrzegam u Ciebie talent osobny do czytania mej poezji."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a63b70e3-b77d-4507-accd-0920da52e6ad",
                        "source_entry_id": "a8450e08-512d-3362-aed4-42709aba5157",
