            "senses": [
                {
                    "sense_id": "349213f0-ef61-32bf-a128-46979ea350dd",
                    "sense_definition": "Partie d'une chanson ou d'un poème qui revient périodiquement après chaque couplet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le public s'est mis à chanter le <w>refrain</w> avec le groupe."
                        },
                        {
                            "text": "Cette chanson entraînante possède un <w>refrain</w> facile à mémoriser."
                        }
                    ],
                    "synonyms": [
                        "ritournelle"
                    ],
                    "common_phrases": [
                        "chanter le refrain",
                        "entonner un refrain",
                        "reprendre en refrain"
                    ]
                },
                {
                    "sense_id": "ff139e1d-f8b4-35fc-93ad-1b82faec39d2",
                    "sense_definition": "Propos, sujet ou plainte qu'une personne répète continuellement de manière lassante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il nous sert toujours le même <w>refrain</w> dès que nous parlons de budget."
                        },
                        {
                            "text": "Nous connaissons tous ce vieux <w>refrain</w> et nous n'y croyons plus du tout."
                        }
                    ],
                    "synonyms": [
                        "antienne",
                        "leitmotiv",
                        "rengaine"
                    ],
                    "common_phrases": [
                        "toujours le même refrain",
                        "connaître le refrain",
                        "vieux refrain"
                    ]
                },
                {
                    "sense_id": "2859452c-6705-3e11-89a0-ed8e2d9dba08",
                    "sense_definition": "Mouvement de reflux d'une vague ou d'une houle après s'être brisée contre un obstacle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pêcheurs surveillaient le <w>refrain</w> menaçant des lames contre la falaise."
                        },
                        {
                            "text": "Le <w>refrain</w> violent des vagues secouait la petite embarcation près du rivage."
                        }
                    ],
                    "synonyms": [
