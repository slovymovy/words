                            {
                                "target_lang_word": "причитающееся",
                                "target_lang_sense_clarification": "выплата за работу или услуги"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Anspruch",
                                "target_lang_sense_clarification": "rechtmäßiger Anspruch auf etwas"
                            },
                            {
                                "target_lang_word": "Forderung",
                                "target_lang_sense_clarification": "Zahlung, die eingefordert wird"
                            },
                            {
                                "target_lang_word": "Geschuldete",
                                "target_lang_sense_clarification": "Fachsprache, was jemand schuldet"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "derecho",
                                "target_lang_sense_clarification": "lo que corresponde por ley"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "应得的",
                                "target_lang_sense_clarification": "本应得到的东西"
                            },
                            {
                                "target_lang_word": "报酬",
                                "target_lang_sense_clarification": "劳动或服务的酬劳"
