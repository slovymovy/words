                                        "glosses": [
                                            "Describing a type of fermentation in which malic acid is converted into lactic acid"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812a5462-60f8-4aba-8798-dbd3f52917bc",
                                                "sense_id": "bbea65fc-21f6-36bc-ab0a-467b86719a96",
                                                "text": "The yeast seems to take up some of the malolactic bug by-products, especially diacetyl, and therefore reduces that butterscotchy aroma."
                                            }
