                "senses": [
                    {
                        "sense_id": "a3e641db-490b-38d7-a3b1-ee486f82f686",
                        "entry_id": "e3b6a413-36b4-33a0-96c9-86e381223bf1",
                        "glosses": [
                            "Erzählung, in der Geister eine Rolle spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33ea506-d4ba-4954-85e6-7ecd7fc705a9",
                                "sense_id": "a3e641db-490b-38d7-a3b1-ee486f82f686",
                                "text": "„Sie lasen sich Geistergeschichten vor, wobei sie sich das Licht der Taschenlampen unters Kinn hielten, so dass ihnen die Schatten ihrer Nasen auf die Stirn fielen.“"
                            },
                            {
                                "example_id": "357a6555-76dd-43b0-8e51-c58ba7aec0ff",
                                "sense_id": "a3e641db-490b-38d7-a3b1-ee486f82f686",
                                "text": "„Abgesehen davon, daß Busch als Sammler von Märchen und Sagen auch viele Geistergeschichten kennengelernt hatte, gibt es genügend Anzeichen, daß er sich gelegentlich für solche Phänomene interessierte, die man heute mit entwaffnender Schlichtheit als Parapsychologie bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75233bae-4848-41b5-b267-b99c9e4e9bb1",
                        "source_entry_id": "e3b6a413-36b4-33a0-96c9-86e381223bf1",
                        "source_sense_id": "a3e641db-490b-38d7-a3b1-ee486f82f686",
                        "source_sense_description": "Erzählung, in der Geister eine Rolle spielen",
                        "target_lang_word": "ghost story",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ghost story",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95348f74-b99e-35d2-957b-dfc72426971a",
                                        "entry_id": "e5b9f9be-aa7e-385a-a5e8-7464d38f1e90",
                                        "glosses": [
                                            "A story about ghosts or the supernatural, often meant to be frightening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5288703f-fdf3-4d7a-9359-719b1b5259d7",
                                                "sense_id": "95348f74-b99e-35d2-957b-dfc72426971a",
                                                "text": "In all smuggling places ghost stories abound. Can it be that they were invented to keep law-abiding folk behind closed doors at night, when the deeds were being done?"
                                            },
                                            {
                                                "example_id": "9d02bc30-6b7d-40b6-bf43-31e6668419ec",
                                                "sense_id": "95348f74-b99e-35d2-957b-dfc72426971a",
                                                "text": "There are the books full of Underground ghost stories. An invisible runner pounds along the platforms at Elephant & Castle; children scream in the basement of what used to be the surface building of Hyde Park Corner, [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
