                        "glosses": [
                            "Ball, der während eines Sprungs nach vorne im Flug mit den Kopf gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2837c8b4-5de5-4769-a9b6-78c3d056c991",
                                "sense_id": "dba8f32d-24e6-3a2c-9cea-12750c31cb76",
                                "text": "„Abgehoben, auf die schönste Art, die der Fußball bereit hält: Robin van Persie erzielt per Flugkopfball das 1:1 gegen Spanien – der Anfang vom Ende für den Titelverteidiger.“"
                            },
                            {
                                "example_id": "2c57f07e-ccee-4dca-b96c-3aba50acb4b6",
                                "sense_id": "dba8f32d-24e6-3a2c-9cea-12750c31cb76",
                                "text": "„Mit einem spektakulären Flugkopfball nach präziser Flanke von Gotoku Sakai schloss Ibisevic eine glänzende Kombination perfekt ab.“"
                            }
                        ],
