                "senses": [
                    {
                        "sense_id": "3eb6ed05-5aca-3073-8a28-949772a75f70",
                        "entry_id": "1f0e3ee1-6378-3fa8-b947-e679f4f55152",
                        "glosses": [
                            "zeer ingetogen, overdreven kuis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afcaa774-41ad-433f-bf11-bc0644616594",
                                "sense_id": "3eb6ed05-5aca-3073-8a28-949772a75f70",
                                "text": "Het Victoriaanse tijdperk is erom berucht dat het enorm preuts was."
                            },
                            {
                                "example_id": "1883a332-64e4-4c78-b7b5-a4c71c53ade5",
                                "sense_id": "3eb6ed05-5aca-3073-8a28-949772a75f70",
                                "text": "De preutsere Amerikanen, die in tegengestelde richting de John Muir Trail (een 350 kilometer lange trail door Ansel Adams Wilderness en de nationale parken van Yosemite, Sequoia en King’s Canyon) liepen, bleven stug naar de grond kijken terwijl ze in volle vaart doorbeenden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54dab68f-674a-4f13-b7a7-7fb0ea95aa4c",
                        "source_entry_id": "1f0e3ee1-6378-3fa8-b947-e679f4f55152",
                        "source_sense_id": "3eb6ed05-5aca-3073-8a28-949772a75f70",
                        "source_sense_description": "zeer ingetogen, overdreven kuis",
                        "target_lang_word": "prüde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prüde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48631b4e-8652-3257-a44b-e00b9ee68e4e",
                                        "entry_id": "dfb28af3-07c3-3c8f-9029-14febed3c62a",
                                        "glosses": [
                                            "in Bezug auf Sexualität übertrieben sittsam, besonders schamhaft, sexuell verklemmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf28adf-abb4-452c-8da2-17514ab4e9e4",
                                                "sense_id": "48631b4e-8652-3257-a44b-e00b9ee68e4e",
                                                "text": "„Die Offenbarungen der Sexualforschung revolutionierten damals das prüde Amerika und ließen Kinsey zu einem der umstrittensten Wissenschaftler des 20. Jahrhunderts werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1339ed4-0bd6-4437-934c-afc77bce7128",
                        "source_entry_id": "1f0e3ee1-6378-3fa8-b947-e679f4f55152",
                        "source_sense_id": "3eb6ed05-5aca-3073-8a28-949772a75f70",
                        "source_sense_description": "zeer ingetogen, overdreven kuis",
                        "target_lang_word": "prudish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prudish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19b5caa8-5c0b-34fa-80dc-527b41351b0e",
                                        "entry_id": "832e50ce-aed5-3f63-aada-a0d9ce1b9427",
                                        "glosses": [
                                            "Of excessive propriety; easily offended or shocked, especially by sexual matters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7141a592-b782-4719-8acb-8d0f0b98eb54",
                                                "sense_id": "19b5caa8-5c0b-34fa-80dc-527b41351b0e",
                                                "text": "Near-synonyms: prim, priggish, prissy; straight-laced; puritanical"
                                            },
                                            {
                                                "example_id": "f61dd82a-1367-4bf5-94bb-0a4bd250e476",
                                                "sense_id": "19b5caa8-5c0b-34fa-80dc-527b41351b0e",
                                                "text": "Young people who are close to writing off the Democratic Party as a dinosaur, as a gerontocracy of prudish abuelos who gave birth by immaculate conception, may be in for a pleasant surprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84edea5a-491b-4ea8-9cb9-eecc06173cbb",
                        "source_entry_id": "1f0e3ee1-6378-3fa8-b947-e679f4f55152",
                        "source_sense_id": "3eb6ed05-5aca-3073-8a28-949772a75f70",
                        "source_sense_description": "zeer ingetogen, overdreven kuis",
                        "target_lang_word": "prude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3b994ad-e0bf-3f62-a1c0-edf3663bfa99",
                                        "entry_id": "1ab8841a-3583-34e1-9b3c-1224c957e14c",
                                        "glosses": [
                                            "Désigne une personne sage, honnête, vertueuse."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "365375e8-00a3-4d3d-ba56-b0c7484fcfc7",
                                                "sense_id": "d3b994ad-e0bf-3f62-a1c0-edf3663bfa99",
                                                "text": "On n'a jamais très bien compris ce qu'on reprochait aux poses très prudes et un rien mélancolique de l'étudiante génépiste qui s'y était prêtée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                        "entry_id": "1ab8841a-3583-34e1-9b3c-1224c957e14c",
                                        "glosses": [
                                            "Qui a l’air et les manières de la pruderie."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe6bd06-b163-4a1c-8ba4-ccf1a0bfe1b4",
                                                "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                                "text": "Elle a toujours passé pour prude."
                                            },
                                            {
                                                "example_id": "a615b167-f5cf-443c-9598-3ace66f6b3ff",
                                                "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                                "text": "Une mine, un extérieur prude."
                                            },
                                            {
                                                "example_id": "9d9903f8-264a-4b2b-8f1c-303c2959fa1c",
                                                "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                                "text": "Ce jeune homme a un petit air prude dont on serait la dupe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                        "entry_id": "05fe0629-4c8f-3854-aaba-61724a36d7c3",
                                        "glosses": [
                                            "Personne pleine de pudeur, de retenue. — Note d’usage : Se dit surtout pour les femmes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1494c54d-db3a-46c5-b0cd-3c104815a417",
                                                "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                                "text": "Songeant qu'il serait ridicule de se conduire en prude, il serra vigoureusement la main du corsaire, […]."
                                            },
                                            {
                                                "example_id": "1c097892-edbc-4e4e-b4c0-634ed64f6b9e",
                                                "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                                "text": "Solange, Dieu merci! n'est ni une prude, ni une sotte, et elle vous saura gré de votre franchise."
                                            },
                                            {
                                                "example_id": "890cdaf1-9602-4de1-a3e6-2eb53f1d8a8b",
                                                "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                                "text": "Elmire : J’aime qu’avec douceur nous nous montrions sages ;\nEt ne suis point du tout pour ces prudes sauvages\nDont l’honneur est armé de griffes et de dents,\nEt veut au moindre mot dévisager les gens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
