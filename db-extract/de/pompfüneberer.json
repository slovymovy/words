                        ],
                        "examples": [
                            {
                                "example_id": "4093f0c5-b5c2-4d81-80c3-8a9a69d57f60",
                                "sense_id": "bd84c302-e30a-3114-8b8f-c10094155655",
                                "text": "„Der Trauerrosenkäfer hingegen ist kohlrabenschwarz und fein weiß getüpfelt wie ein Pompfüneberer im Schneetreiben.“"
                            },
                            {
                                "example_id": "9f4cd159-4795-43db-93db-075ac9be9308",
                                "sense_id": "bd84c302-e30a-3114-8b8f-c10094155655",
                                "text": "„Ein Goldbetresster in rotem Wams, er ist Angehöriger der Trabantengarde, also ein k.u.k. Leibgardist, betont mit leiser Verachtung: »Wir sind ja nicht alle Pompfüneberer«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
