    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f945367-29cf-3835-b8d9-21730feee545",
                    "sense_definition": "To listen attentively; often used as an exclamation to call attention to a sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "listen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hark</w>! I hear the sound of footsteps approaching in the dark hallway.",
                            "target_lang_translations": {
                                "ru": "<w>Внемли</w>! Я слышу звук приближающихся шагов в темном коридоре."
                            }
                        },
                        {
                            "text": "The old man told the children to <w>hark</w> closely to the rustling leaves.",
                            "target_lang_translations": {
                                "ru": "Старик велел детям внимательно <w>прислушаться</w> к шелесту листьев."
                            }
                        }
                    ],
                    "synonyms": [
                        "listen",
                        "hearken",
                        "hear"
                    ],
                    "antonyms": [
                        "ignore"
                    ],
                    "common_phrases": [
                        "hark the herald"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly used in literary, poetic, or archaic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внимательно слушать; часто используется как восклицание для привлечения внимания к звуку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внимать",
                                "target_lang_sense_clarification": "устаревшее, книжное или поэтическое значение: прислушиваться, обращать внимание"
                            },
                            {
                                "target_lang_word": "слушать",
                                "target_lang_sense_clarification": "внимательно воспринимать звуки"
                            },
                            {
                                "target_lang_word": "прислушиваться",
                                "target_lang_sense_clarification": "напрягать слух, чтобы услышать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ae16a3c-4f3f-35b6-8958-13d9922109ef",
                    "sense_definition": "A whisper or soft, quiet sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "whisper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke in a quiet <w>hark</w>, ensuring that no one else in the room could hear her secret.",
                            "target_lang_translations": {
                                "ru": "Она говорила тихим <w>шепотом</w>, чтобы никто другой в комнате не услышал ее секрет."
                            }
                        },
                        {
                            "text": "The faint <w>hark</w> of the wind through the keyhole kept him awake all night.",
                            "target_lang_translations": {
                                "ru": "Слабый <w>шелест</w> ветра в замочной скважине не давал ему спать всю ночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "whisper",
                        "murmur"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Extremely rare and archaic noun usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шепот или тихий, мягкий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шепот",
                                "target_lang_sense_clarification": "тихая речь"
                            },
                            {
                                "target_lang_word": "шорох",
                                "target_lang_sense_clarification": "тихий глухой звук"
                            },
                            {
                                "target_lang_word": "шелест",
                                "target_lang_sense_clarification": "тихий звук от трения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
