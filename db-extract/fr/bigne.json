                        ],
                        "examples": [
                            {
                                "example_id": "f6809813-6ede-4b7f-974f-4bbe2b79628f",
                                "sense_id": "cefdcdaa-a1d7-3544-8046-14bc6b2c372f",
                                "text": "Ce fantôme était un berger — un « bigne », comme on dit en patois. … Alors, le « bigne » revenait tout le temps pour se plaindre, et il cherchait son trésor sans jamais le retrouver."
                            }
                        ]
                    }
