                                        "examples": [
                                            {
                                                "example_id": "717905e9-0d8d-4398-9ece-be9d75ed0571",
                                                "sense_id": "906304e7-69ad-3bd1-97a1-7152f73cce91",
                                                "text": "„Sowohl 'vierteilen' als auch 'zerreißen' werden umgangssprachlich reflexiv und figürlich benutzt.“"
