                "senses": [
                    {
                        "sense_id": "3a988b88-cdf9-353e-a80e-5bb0b8b6c566",
                        "entry_id": "d8d9abde-2bec-3386-b781-c0a66a0c95a3",
                        "glosses": [
                            "Vorschlag zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b5c415-4d41-43bd-8a9d-5065425ef7a0",
                                "sense_id": "3a988b88-cdf9-353e-a80e-5bb0b8b6c566",
                                "text": "„Über Spielanregungen alleinerziehender Eltern liegen leider keine Untersuchungen vor.“"
                            },
                            {
                                "example_id": "64120690-fb3b-4ace-9cd9-3ff05c82328b",
                                "sense_id": "3a988b88-cdf9-353e-a80e-5bb0b8b6c566",
                                "text": "„Sind diese Spielgelegenheiten und Spielanregungen in der Umwelt reichlich vorhanden, braucht es wenig Hilfen.“"
                            },
                            {
                                "example_id": "159ef2b1-40ba-4c33-b171-da709fe0180b",
                                "sense_id": "3a988b88-cdf9-353e-a80e-5bb0b8b6c566",
                                "text": "„Das Buch bringt eine Fülle von Spielanregungen, Comics und Kurzgeschichten, auf jeder Seite durch einen kurzen, etwas missionarischen Kommentar erläutert und so in die erzieherische Gesamtkonzeption eingebunden.“"
                            },
                            {
                                "example_id": "d1fd81aa-d6ee-4bb5-adc9-417a2daa9966",
                                "sense_id": "3a988b88-cdf9-353e-a80e-5bb0b8b6c566",
                                "text": "„Die Spielanregungen, die an einzelne Geschichten angeklebt sind, besitzen wenig Originalität und regen deshalb kaum zum (Nach-)Spielen an.“"
                            },
                            {
                                "example_id": "dc7414d4-f8c1-44db-9a8e-ebe06b70e399",
                                "sense_id": "3a988b88-cdf9-353e-a80e-5bb0b8b6c566",
                                "text": "„Spielanregungen und Erzählanreize sollen zur Beschäftigung mit den Stoffgebieten motivieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
