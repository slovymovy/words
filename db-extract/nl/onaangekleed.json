                    {
                        "sense_id": "5ee5822a-4269-3188-9a56-4d4ecab4e6fb",
                        "entry_id": "0cb76e16-c675-34c2-b002-0b7ffcf0252a",
                        "glosses": [
                            "nog geheel of deels in nacht- of badkleding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6fdfd3-7437-4fd9-a541-c17207ceda0a",
                                "sense_id": "5ee5822a-4269-3188-9a56-4d4ecab4e6fb",
                                "text": "’s Ochtends heeft hij dan thuis zitten schrijven, ongeschoren, ongewassen en onaangekleed."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1027609-67bf-3ed6-b906-3e5605a18383",
                        "entry_id": "0cb76e16-c675-34c2-b002-0b7ffcf0252a",
                        "glosses": [
                            "nog zonder de gebruikelijke versiering"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5913be93-856c-4f15-be72-a136f3d1b667",
                                "sense_id": "e1027609-67bf-3ed6-b906-3e5605a18383",
                                "text": "Mijn vriendin had een hond genomen. (…) Stuf liep omkijkend of ik wel volgde, voor me uit. Hij zag er kaal en onaangekleed uit zonder halsband."
                            },
                            {
                                "example_id": "fef4b227-808a-4a7c-a196-735ecaab5cf2",
                                "sense_id": "e1027609-67bf-3ed6-b906-3e5605a18383",
                                "text": "Ook het boek Ruth is een voorbeeld. Het bijbelse origineel bezit door zijn onaangeklede eenvoud een onmetelijke poëzie, die veel later nog prachtig naar de oppervlakte is gehaald door Victor Hugo in zijn gedicht Booz Endormi."
                            }
                        ]
                    }
