                                                "sense_id": "952a8431-a955-3074-b241-e5aec0d73af0",
                                                "text": "Herbert was able to novelize his experiences as a soldier into a compelling action drama."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb23083-81cf-3cb9-8d81-60d4b07d534a",
