                ],
                "senses": [
                    {
                        "sense_id": "10d1a3c6-4b5e-3109-87fc-ddf1401f636a",
                        "entry_id": "edd9aab4-48ac-3049-afae-e199adc22b56",
                        "glosses": [
                            "kleines, annähernd kreisförmiges Gebilde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f74a34-ddd2-4f86-af35-08a6600df601",
                                "sense_id": "10d1a3c6-4b5e-3109-87fc-ddf1401f636a",
                                "text": "„Es war das Fieber. Es hielt drei Tage an, und das Männchen saß an meinem Bett im Lazarett, den abgeschabten Samtkragen frierend hochgeschlagen, und lehrte mich, aus violetten Kringeln, die vor meinen Augen rasch rotierten, klingelnde Ringe und Ketten und schwebende Kugeln zu basteln.“"
                            },
                            {
                                "example_id": "71d128f7-8213-4451-b7d2-603efb7b1f5d",
                                "sense_id": "10d1a3c6-4b5e-3109-87fc-ddf1401f636a",
                                "text": "„Er produzierte kunstvolle Kringel mit seinem Zigarettenrauch.“"
                            },
                            {
                                "example_id": "7b4563eb-c2ab-445c-9474-35dd7cfee029",
                                "sense_id": "10d1a3c6-4b5e-3109-87fc-ddf1401f636a",
                                "text": "„Die Sonne schien in das kleine Dachzimmer und malte goldgelbe Kringel auf den Fußboden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc730751-5e1f-3c6f-bd64-9ed16c4950d7",
                        "entry_id": "edd9aab4-48ac-3049-afae-e199adc22b56",
                        "glosses": [
                            "Süßgebäck in Form eines Rings"
                        ],
                        "tags": [
                            "Gebäck"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "82ef493c-4619-369e-a4c7-7db273a39084",
                        "entry_id": "edd9aab4-48ac-3049-afae-e199adc22b56",
                        "glosses": [
                            "Brezel"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2b\""
                    },
                    {
                        "sense_id": "be2abe1d-6aa6-38bb-bc2b-a60e9f89e9e9",
                        "entry_id": "edd9aab4-48ac-3049-afae-e199adc22b56",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "7a6de997-2d9b-4181-a432-3f71899d50cd",
                                "sense_id": "be2abe1d-6aa6-38bb-bc2b-a60e9f89e9e9",
                                "text": "„Die Arithmetik des Plätzchens geht üblicherweise von acht Stammsubstanzen und sechs Grundformen aus (Hörnchen, Kringel, Kugel, Taler, Herz und Quader) und kommt damit auf eine Kernzahl von 48 Typplätzchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
