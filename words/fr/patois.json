                    "frequency": "Middle",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce petit village isolé, les anciens parlent encore le <w>patois</w> entre eux."
                        },
                        {
                            "text": "Mon grand-père connaît parfaitement le <w>patois</w> local et nous raconte souvent des histoires d'autrefois."
                        }
                    ],
