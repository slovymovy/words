                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d25c5c6c-d4a9-41a5-8049-d9c54ce07306",
                        "source_entry_id": "4cc0388b-4c52-3151-a136-f33be0b41f3e",
                        "source_sense_description": "linguistics: alteration of a word’s letters or sounds",
                        "target_lang_word": "μεταπλασμός",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "μεταπλασμός",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "bbdbf25d-824b-3b48-950a-f44ea4dbfbef",
                                        "entry_id": "71690b6f-2708-33f9-8776-478af7eaff12",
                                        "glosses": [
                                            "η μεταβολή της μορφολογίας μιας λέξης για την προσαρμογή της σε άλλη κλίση"
                                        ],
                                        "tags": [
                                            "γλωσσολογία",
                                            "γραμματική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c7e78ab-d1ae-4b12-a3f1-5ccb63f660f4",
                                                "sense_id": "bbdbf25d-824b-3b48-950a-f44ea4dbfbef",
                                                "text": "※ 2001 Γ. Παπαναστασίου, «Μορφολογία: Από την κλασική ελληνική στην κοινή.»",
                                                "translation": "Eκτός από την αιτιατική, ως βάση του μεταπλασμού των αθέματων ουσιαστικών χρησιμοποιήθηκε και η ονομαστική του ενικού. Eίναι η περίπτωση αρσενικών ουσιαστικών σε -ων που πέρασαν στην κλίση σε -ος. O μεταπλασμός αυτός θα γίνει κατά βάση στη μεσαιωνική ελληνική: ὁ γέρων > ο γέρος, ὁ χάρων > ο χάρος."
                                            },
                                            {
                                                "example_id": "998ff090-59f7-4df7-863c-97cde937ec9d",
                                                "sense_id": "bbdbf25d-824b-3b48-950a-f44ea4dbfbef",
                                                "text": "※ 2011 Κωστής Ηλ. Παπαδάκης, «Τοπωνυμικό της Επαρχίας Αγίου Βασιλείου Ρεθύμνου, Τόμος Ε΄, σελ. 142», Ρέθυμνο 2011",
                                                "translation": "Εδώ, πρόκειται για υποκορ. από µεταπλασµό. Έτσι, στο συγκεκριµένο τοπων. από αρσενικό σπάρτος, ο- κατόπιν µεταπλασµού έχουµε ουδ. σπαρτί, το (βλ. και σηµ. 20 παρόντος τοπωνυµικού καταλόγου)."
                                            },
                                            {
                                                "example_id": "4b0f8dee-c9ed-4e08-bc93-14e01791d533",
                                                "sense_id": "bbdbf25d-824b-3b48-950a-f44ea4dbfbef",
                                                "text": "※ 2024 «Το τοπωνύμιο Χανιά, Π78 - Πολιτισμός- Κρητικά Χρονικά, Τόμος Β'», 16. 10. 2024, Πdata.apdkritis.gov.gr, πρόσβαση: 7. 9. 2025",
                                                "translation": "Αφετέρου, με τη βοηθητική εξέταση άλλων παραλλήλων στο κρητικό λεξιλόγιο (όπως τα νιότα και τα Σφακιά), αναλύεται η διαδικασία μεταπλασμού του αρχαίου θηλυκού ενικού Αλχανία στο σημερινό ουδέτερο πληθυντικό Χανιά με αφετηρία τον τύπο της δοτικής ΤΑ ΑΛΧΑΝΙΑ. Υποδεικνύεται έτσι ο τρόπος με τον οποίο αρχαία διαλεκτικά λείψανα χάνονται μέσα στα μορφολογικά σχήματα της αττικής - κοινής, κατά την εξέλιξη της ελληνικής γλώσσας."
                                            },
                                            {
                                                "example_id": "f3de73b9-3e4f-44c8-b6bd-dd6216d128ef",
                                                "sense_id": "bbdbf25d-824b-3b48-950a-f44ea4dbfbef",
                                                "text": "≤ συνυπώνυμα: αναλογία"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bb4b7a-5ed7-3a42-8a7a-5d07a26660ce",
                                        "entry_id": "71690b6f-2708-33f9-8776-478af7eaff12",
                                        "glosses": [
                                            "η αυθαίρετη μεταβολή της μορφολογίας μιας λέξης από έναν συγγραφέα για την προσαρμογή της σε κάποιο κείμενο"
                                        ],
                                        "tags": [
                                            "λογοτεχνία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd68428-89d8-4fe1-a69f-d423f523edfa",
                                                "sense_id": "e1bb4b7a-5ed7-3a42-8a7a-5d07a26660ce",
                                                "text": "※ 1893 ⌘ Ἐμμανουὴλ Ῥοΐδης, Τὰ εἴδωλα, Γλωσσικὴ Μελέτη, εκδ. Εστία, 1893, σελ. 224-225",
                                                "translation": "Ἡ μόνη μεταξὺ ἡμῶν καὶ τῶν ἄλλων ἐθνῶν κατὰ τοῦτο διαφορὰ εἶναι ὅτι οἱ μὲν Εὐρωπαῖοι ἐπιστήμονες παραλαμβάνοντες ἐκ τῆς ἑλληνικῆς ἢ τῆς λατινικῆς πᾶσαν ἀναγκαίαν λέξιν συνήρμοζον αὐτήν, κατὰ τὴν κατάληξιν τοὐλάχιστον, πρὸς τὰς δημοτικάς, ἐνῶ οἱ ἡμέτεροι λογιώτατοι παρελάμβανον τὰς παλαιὰς λέξεις ἀμεταβλήτους καὶ ἐκ τούτου ἀναγκάζεται ὁ μεταχειριζόμενος τὴν ζωντανὴν γλῶσσαν εἰς «σπουδαίας συγγραφὰς» νὰ μεταπλάσσῃ τὰς μὴ συμφωνούσας πρὸς τοὺς τύπους αὐτῆς. Ὁ τοιοῦτος ὅμως μεταπλασμὸς οὔτε εἶναι εἰς ὅλας τὰς λέξεις ἀναγκαῖος οὔτε ἔχει σχέσιν καμμίαν πρὸς τὴν ἀνελλιπῆ διατύπωσιν οἱασδήποτε ἐπιστημονικῆς ἐννοίας."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f945e20-dcd3-305b-9f34-04c8bba9903f",
                                        "entry_id": "71690b6f-2708-33f9-8776-478af7eaff12",
                                        "glosses": [
                                            "αυθαίρετη μεταβολή χαρακτήρα, αυθαιρεσία"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f134fa3c-863c-45d5-86dc-d88f45098c62",
                                                "sense_id": "9f945e20-dcd3-305b-9f34-04c8bba9903f",
                                                "text": "※ 1902 ⌘ Γιάννης Ψυχάρης, Ρόδα και μήλα, εκδ. Βιβλιοπωλείου της Εστίας, 1902",
                                                "translation": "Ο άθρωπος είναι πάντα άθρωπος· η φύση του δεν αλλάζει· ό,τι λαό κι αν πάρετε, ό,τι εποχή κι αν πιάσετε να μελετήσετε, - ας είναι κι ωγύγια εποχή -, πάντα θα βρείτε στον άθρωπο μέσα την ίδια απροσεξιά, τους ίδιους ανόητους μεταπλασμούς."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a5ab26-cfef-354f-8261-49e51a5e3cac",
                                        "entry_id": "71690b6f-2708-33f9-8776-478af7eaff12",
                                        "glosses": [
                                            "μετάπλαση"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db4e1f5d-b01a-4142-9455-c72d2879f38b",
                                                "sense_id": "18a5ab26-cfef-354f-8261-49e51a5e3cac",
                                                "text": "※ 1902 ⌘ Γιάννης Ψυχάρης, Ρόδα και μήλα, εκδ. Βιβλιοπωλείου της Εστίας, 1902",
                                                "translation": "Για τούτο σήμερα λέμε που η αττική άλλο δεν είναι παρά μεταπλασμός της ιωνικής. Το συνηρημένο το φιλώ έχει μέσα του και βαστά τ’ αρχαιότερο το φιλέω. Με το ίδιο σύστημα, μέσα στο νεότερο το μουσών κάθεται η παλιά γενική μουσάων. Η αττική έσωσε την ιωνική όταν πια δε μιλούσε κανείς ιωνικά. Την πήρε, την έκρυψε και τη φύλαξε μέσα της."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
