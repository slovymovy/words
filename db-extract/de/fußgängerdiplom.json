                "senses": [
                    {
                        "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                        "entry_id": "8b2fcaa3-b9c9-38e4-ba49-65c72dfd76a8",
                        "glosses": [
                            "Urkunde als Nachweis der Befähigung, sich verkehrsgerecht, partnerbezogen und sicher fußläufig im Straßenverkehr bewegen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d380faa3-91b1-490f-b5aa-118145d64b6c",
                                "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                                "text": "„Das Projekt ‚Fußgängerdiplom’, das der besonderen Situation des Schulanfängers angepaßt ist, liefert die notwendigen Hilfen für das Verhalten auf dem Schulweg.“"
                            },
                            {
                                "example_id": "1f82ecf2-56e2-48c2-ab08-a31c046250c6",
                                "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                                "text": "„Wenn du von dort bis hierher gekommen bist, dann musst du mindestens ein Fußgängerdiplom haben. Mindestens!“"
                            },
                            {
                                "example_id": "063741d2-06d6-4010-aeac-c46f201aea78",
                                "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                                "text": "„Das Fußgängerdiplom fördert die Eigeninitiative von Schülerinnen und Schülern und ermuntert sie, sich mit dem Schulweg aktiv auseinander zu setzen.“"
                            },
                            {
                                "example_id": "9c954a41-bad7-4372-b9e8-d4d0ad129cfc",
                                "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                                "text": "„Das Projekt ‚Fußgängerdiplom’ wird zeitlich am sinnvollsten unmittelbar vor oder nach dem Schuleintritt angesetzt.“"
                            },
                            {
                                "example_id": "90061645-8b39-41de-a25a-7e8f4bf5783a",
                                "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                                "text": "„Im Rahmen einer kleinen Feierstunde überreichte Oberbürgermeisterin Petra Becker den Vorschulkindern und Schutzengeln die Fußgängerdiplome.“"
                            },
                            {
                                "example_id": "7b9fd1e6-b7bc-4e58-9f8c-fd73a4347085",
                                "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                                "text": "„Die AG Verkehr wird die Durchführung des Fußgängerdiploms weiter vorantreiben.“"
                            },
                            {
                                "example_id": "68b6a4e0-0c88-4541-bff7-64ef91457661",
                                "sense_id": "3be526e0-3af8-31d1-9e3b-386198dd6fa2",
                                "text": "„Mit dem Erwerb eines ‚Fußgängerdiploms’ soll für Eltern und Kinder ein Anreiz geschaffen werden, sich mit dem Thema ‚Zu Fuß zur Schule’ zu beschäftigen.“"
                            }
                        ],
