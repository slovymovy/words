                        "entry_id": "da4bf372-4438-371c-b236-f74f27348777",
                        "glosses": [
                            "A person who lends money and charges interest, especially one who is not part of the official financial industry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adcd3be0-cef6-41bf-809d-0c9c23388b1f",
                                "sense_id": "b79db0d0-f06e-3c5a-995b-78d5e5628912",
                                "text": "Banchiere, a banker or Lombard, or a money lender."
                            }
                        ]
                    }
                ],
