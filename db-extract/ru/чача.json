                "senses": [
                    {
                        "sense_id": "5a10d6fc-5677-37b5-bb02-8334f6dd8d03",
                        "entry_id": "efb409de-0122-32dd-9a6c-026e56106be6",
                        "glosses": [
                            "chacha - traditionally a clear strong liquor, which is sometimes called \\\"vine vodka,\\\" \\\"grape vodka,\\\" or \\\"Georgian vodka.\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d89cb3f-e460-496a-9f97-7c7b0b13b5e0",
                                "sense_id": "5a10d6fc-5677-37b5-bb02-8334f6dd8d03",
                                "text": "В Я́лте, наприме́р, Ста́лин похваливал грузи́нские сухи́е вина, а потом спроси́л:\n—А вы зна́ете грузи́нскую виногра́дную во́дку — ча́чу?",
                                "translation": "In Yalta, for example, Stalin praised Georgian dry wines, and then he asked:\n— Do you know, by any chance, the Georgian grape vodka — chacha?",
                                "english": "In Yalta, for example, Stalin praised Georgian dry wines, and then he asked:\n— Do you know, by any chance, the Georgian grape vodka — chacha?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
