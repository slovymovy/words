                        "examples": [
                            {
                                "example_id": "fad27060-05d5-4679-8216-36c41dc2c284",
                                "sense_id": "dc30146d-77da-37f0-886f-433bca901761",
                                "text": "The Art Institute of Chicago in de VS bouwde de replica van de kamer en plaatste die in februari op kamerverhuurwebsite Airbnb. Aanleiding is de tentoonstelling Van Gogh’s Bedrooms die nog tot en met 10 mei te zien is in Chicago. De tentoonstelling is gewijd aan de verschillende versies die Van Gogh maakte van Slaapkamer te Arles. Alle elementen van het schilderij zijn tot in het kleinste detail nagebouwd. Naast twee scheve stoelen en een hellend nachtkastje staat ook het bed in de gastenkamer uit het lood, in navolging van het vervreemdende perspectief dat Van Gogh in het werk gebruikte. De kamer is compleet volgeboekt."
                            }
                        ]
                    }
