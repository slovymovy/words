                "senses": [
                    {
                        "sense_id": "2bb362a4-9f82-3f13-99ac-799604764733",
                        "entry_id": "04d07b0a-38c7-32d6-8813-70b5b2240cce",
                        "glosses": [
                            "Angriff, der mit Panzern durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a89d3c0-0e05-49a1-b059-0513e6c2081e",
                                "sense_id": "2bb362a4-9f82-3f13-99ac-799604764733",
                                "text": "„Die erwartete Invasion von Truppen des Warschauer Pakts in der sogenannten Fulda-Lücke, wo das Gelände für einen massiven Panzerangriff besonders geeignet ist, sollte aufgehalten werden.“"
                            },
                            {
                                "example_id": "44cf0974-077f-488f-b34b-5b2965fbab5c",
                                "sense_id": "2bb362a4-9f82-3f13-99ac-799604764733",
                                "text": "„Berühmt geworden ist McMaster durch einen spektakulären Panzerangriff im ersten Golfkrieg, als er stark in Unterzahl eine auf dem Papier hoch überlegene irakische Gegenwehr ohne eigene Verluste ausschaltete.“"
                            },
                            {
                                "example_id": "4577f286-f2f5-4923-b91f-29f686d2a6d6",
                                "sense_id": "2bb362a4-9f82-3f13-99ac-799604764733",
                                "text": "„Nach dem arabischen Frühling und den immer radikaleren Äußerungen aus Teheran betrachtet Israel mittlerweile einen Angriff mit Raketen aus Iran als wesentlich wahrscheinlicher als einen Panzerangriff aus Saudi-Arabien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
