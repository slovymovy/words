                "senses": [
                    {
                        "sense_id": "5c965cbb-b72f-371a-a38a-4039c3edf675",
                        "entry_id": "ec55228b-0b74-3884-bd82-8167d4452ef4",
                        "glosses": [
                            "немецкая фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed9351f-5fa2-4ee8-ac8b-9995c531838c",
                                "sense_id": "5c965cbb-b72f-371a-a38a-4039c3edf675",
                                "text": "9 мая ― день Победы! А 7 мая во Франции, в Реймсе, начальник штаба оперативного руководства верховного главнокомандования вермахта Йодль в присутствии Эйзенхауэра и других представителей союзников подписывает акт капитуляции германских вооруженных сил, который вступал в силу 8 мая (вот почему в других странах победу над Гитлером отмечают 8 мая)."
                            }
                        ]
                    }
                ],
