                                "target_lang_sense_clarification": "без задержки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa01bd91-0fa2-3efa-b1f5-3de942d45034",
                    "sense_definition": "Taki, który reaguje bardzo gwałtownie, szybko i bez głębszego zastanowienia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "porywczy-charakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To jest niezwykle <w>prędki</w> do gniewu człowiek, z którym trudno spokojnie porozmawiać.",
                            "target_lang_translations": {
                                "ru": "Это невероятно <w>скорый</w> на гнев человек, с которым трудно спокойно поговорить."
                            }
                        },
                        {
                            "text": "Jego <w>prędki</w> sąd o innych ludziach często bywał niesprawiedliwy.",
                            "target_lang_translations": {
                                "ru": "Его <w>поспешное</w> суждение о других людях часто бывало несправедливым."
                            }
                        }
                    ],
                    "synonyms": [
                        "w gorącej wodzie kąpany"
                    ],
                    "common_phrases": [
                        "prędki do gniewu",
                        "prędki sąd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Реагирующий очень бурно, быстро и без глубоких размышлений; вспыльчивый или поспешный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспыльчивый",
                                "target_lang_sense_clarification": "о характере, склонности к гневу"
                            },
                            {
                                "target_lang_word": "поспешный",
                                "target_lang_sense_clarification": "о суждениях, выводах"
                            },
                            {
                                "target_lang_word": "скорый",
                                "target_lang_sense_clarification": "на расправу, на гнев"
                            }
                        ]
                    }
                }
            ]
        },
