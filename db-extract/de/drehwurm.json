                        "entry_id": "a3920308-cb29-34de-85f0-a5c8f5f45d9c",
                        "glosses": [
                            "Larve du ténia (Taenia multiceps), parasite de l'intestin grêle des canidés, qui provoque le tournis du mouton."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "956f1d5e-84ee-36e3-b6fc-81171cd14f9d",
                        "entry_id": "a3920308-cb29-34de-85f0-a5c8f5f45d9c",
                        "glosses": [
                            "Avec haben, bekommen, kriegen Tête qui tourne, tournis."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ad4b2f42-b894-43c2-9655-e42a7a53d211",
                                "sense_id": "956f1d5e-84ee-36e3-b6fc-81171cd14f9d",
                                "text": "Wenn ich längere Zeit Walzer tanze, bekomme ich einen Drehwurm. - Quand je danse la valse un certain temps, j'attrape le tournis"
                            }
                        ]
                    }
