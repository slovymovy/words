                ],
                "senses": [
                    {
                        "sense_id": "694c48d0-f551-3826-a674-ae4cd0814ba0",
                        "entry_id": "fc239d98-5162-366b-8bf3-b9e60d7e824e",
                        "glosses": [
                            "Donner un caractère délicat à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc83107-ee4e-4979-be1a-a19dc4923f34",
                                "sense_id": "694c48d0-f551-3826-a674-ae4cd0814ba0",
                                "text": "J’entendis même l’autre jour une personne dire qu’il faut délicatiser ses expressions."
                            },
                            {
                                "example_id": "cff6fc22-dbe1-4657-b38a-d3af624b4f94",
                                "sense_id": "694c48d0-f551-3826-a674-ae4cd0814ba0",
                                "text": "Tant que vous vous porterez bien, gardez-vous de vous délicatiser et dorloter ;"
                            },
                            {
                                "example_id": "40bff320-7736-443b-863b-35c737cd2f2a",
                                "sense_id": "694c48d0-f551-3826-a674-ae4cd0814ba0",
                                "text": "Une grippe pernicieuse l’avait, durant plus de vingt jours, emprisonné dans sa chambre. Il en était revenu avec un visage amaigri, délicatisé par la pâleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "22b3f4b5-810d-3e94-84b2-7f9c7c5f38f4",
                        "entry_id": "fc239d98-5162-366b-8bf3-b9e60d7e824e",
                        "glosses": [
                            "Attendrir (de la viande) mécaniquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be38af6-790e-4f88-832e-e7bfcd341cfe",
                                "sense_id": "22b3f4b5-810d-3e94-84b2-7f9c7c5f38f4",
                                "text": "Le bœuf attendri mécaniquement, ou délicatisé, est une coupe, comme un bifteck ou un rôti, dont les fibres musculaires et les tissus conjonctifs ont été brisés au moyen de lames tranchantes ou d’aiguilles."
                            },
                            {
                                "example_id": "f8d0446e-5e99-409a-bb02-5457ecb3a894",
                                "sense_id": "22b3f4b5-810d-3e94-84b2-7f9c7c5f38f4",
                                "text": "Commander 2 livres de steak dans la ronde ou la surlonge. S’il s’agit de la ronde, le rendre plus tendre; ou le \"délicatiser\" comme on dit."
                            }
                        ]
                    }
                ],
