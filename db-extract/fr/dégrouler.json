                "senses": [
                    {
                        "sense_id": "b891022e-c854-31b7-bd4b-80cc4e34db97",
                        "entry_id": "c7665a15-ec69-3426-b9e5-095c0b61e509",
                        "glosses": [
                            "Dégringoler, descendre rapidement."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f735c054-eeb3-44b8-8292-dbff6e11cf4a",
                                "sense_id": "b891022e-c854-31b7-bd4b-80cc4e34db97",
                                "text": "Il me semblait que c’était là la vie, et j’persistais à me dire : - Vas-tu dégrouler ce maudit fleuve-là un beau jour, aller voir ailleurs ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0977c21f-6509-391e-9db4-4042aba2cc07",
                        "entry_id": "c7665a15-ec69-3426-b9e5-095c0b61e509",
                        "glosses": [
                            "Avoir des borborygmes, l’estomac qui fait du bruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e5c408-2525-47c6-8389-f8edb2dd26a3",
                                "sense_id": "0977c21f-6509-391e-9db4-4042aba2cc07",
                                "text": "« ça me dégroule dans le ventre après les repas » , dit l'un."
                            }
                        ]
