                "senses": [
                    {
                        "sense_id": "8ad13c49-8a5e-3d62-83b6-a1a3650c803b",
                        "entry_id": "7ed7e9b8-329b-3fcb-9005-0de6f539fed0",
                        "glosses": [
                            "der Fall der Berliner Mauer im Jahr 1989; die Grenzöffnung zwischen DDR und Bundesrepublik Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5b365b-fffd-4a70-963b-a15deb891d9e",
                                "sense_id": "8ad13c49-8a5e-3d62-83b6-a1a3650c803b",
                                "text": "Für die Deutschen war der Mauerfall eines der wichtigsten Ereignisse im 20. Jahrhundert."
                            },
                            {
                                "example_id": "92338261-d34c-4311-b532-5c068cd1905b",
                                "sense_id": "8ad13c49-8a5e-3d62-83b6-a1a3650c803b",
                                "text": "„Nicht verwunderlich aber, dass schon bald nach dem Mauerfall der verlorene Sohn wieder in sein Heimatdörfchen zurückfand und solche Zeichen im Ort setzte, derentwegen sich an den Wochenenden immer mehr Menschen auf Pilgerfahrt ins schöne Eichsfeld begeben.“"
                            },
                            {
                                "example_id": "e22fff61-49f5-4b21-a74f-28e9255bc318",
                                "sense_id": "8ad13c49-8a5e-3d62-83b6-a1a3650c803b",
                                "text": "„Meinen ersten Ostkontakt hatte ich nach dem Mauerfall, als ich einen Ostberliner in einer Duisburger Disco kennenlernte.“"
                            },
                            {
                                "example_id": "cf703f40-0064-4a84-8f03-64474dfd797d",
                                "sense_id": "8ad13c49-8a5e-3d62-83b6-a1a3650c803b",
                                "text": "„Ein gutes Jahr nach dem Mauerfall 1989 plante seine Clique einen Wochenend-Trip nach Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
