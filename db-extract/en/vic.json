                    {
                        "sense_id": "4ba62e4e-794c-32eb-87ae-7875a6408514",
                        "entry_id": "cf08fd40-1f5e-32c1-8fe9-b8a712079d34",
                        "glosses": [
                            "A victim of a homicide."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "efd0180d-e5ac-4a1b-acff-bc58f7261e31",
                                "sense_id": "4ba62e4e-794c-32eb-87ae-7875a6408514",
                                "text": "(Ryotaro Dojima): We haven't found the cause of death for the first vic, and now we've got a second one just like it […]"
                            },
                            {
                                "example_id": "3325a31d-000f-40e7-b808-1b64c84bf2d2",
                                "sense_id": "4ba62e4e-794c-32eb-87ae-7875a6408514",
                                "text": "We did find some black fibers stuck between the victim's teeth, presumably from a glove, and lastly, seeing as the vic was found completely naked, we can't process her clothes for any potential evidence."
                            },
                            {
                                "example_id": "de398634-298b-4cdb-b5d9-691ab6649955",
                                "sense_id": "4ba62e4e-794c-32eb-87ae-7875a6408514",
                                "text": "“The vic was found by some birdwatchers at the Theler Wetlands,” he began."
                            }
                        ]
                    }
                ],
