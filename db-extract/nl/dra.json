                            {
                                "target_word": "pronto",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "de24b4ac-d989-3ab6-bbc9-98f48ac8dfe6",
                                        "entry_id": "41fb9c68-7fcf-3505-9292-b15d2d7f12d1",
                                        "glosses": [
                                            "Lo antes posible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9cc2e4-9f9c-446b-b21c-76ab88a5ca7f",
                                                "sense_id": "de24b4ac-d989-3ab6-bbc9-98f48ac8dfe6",
                                                "text": "Chicos, apresúrense por favor; debemos acabar este trabajo pronto. Acuérdense de que esta es nuestra última oportunidad. Si no lo hacemos, reprobamos."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
