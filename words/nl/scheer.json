{
    "word_family": [
        "scheren",
        "scheermes",
        "scheerbeurt",
        "scheerapparaat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19ea7c60-a1c2-392b-8894-9c6667fe2815",
                    "sense_definition": "Een kleine, nauwelijks uit de zee oprijzende rots of klein eiland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kust van Zweden is bekend voor zijn vele <w>scheren</w>.",
                            "target_lang_translations": {
                                "fr": "La côte de la Suède est connue pour ses nombreux <w>écueils</w>.",
                                "en": "The coast of Sweden is known for its many <w>skerries</w>.",
                                "ru": "Побережье Швеции известно своими многочисленными <w>шхерами</w>."
                            }
                        },
                        {
                            "text": "Het schip voer voorzichtig tussen de gevaarlijke <w>scheren</w> door.",
                            "target_lang_translations": {
                                "fr": "Le navire a navigué prudemment entre les <w>écueils</w> dangereux.",
                                "en": "The ship sailed carefully through the dangerous <w>skerries</w>.",
                                "ru": "Корабль осторожно лавировал среди опасных <w>шхер</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un petit rocher ou îlot qui émerge à peine de la mer.",
                        "en": "A small, low rocky island or reef, especially along the Scandinavian coast.",
                        "ru": "Небольшая скала или каменистый островок, едва выступающий из моря (шхера)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "écueil",
                                "target_lang_sense_clarification": "Rocher dangereux à fleur d'eau"
                            },
                            {
                                "target_lang_word": "skär",
                                "target_lang_sense_clarification": "Terme géographique spécifique pour les îlots rocheux scandinaves"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "skerry",
                                "target_lang_sense_clarification": "small rocky island or reef"
                            },
                            {
                                "target_lang_word": "skär",
                                "target_lang_sense_clarification": "Scandinavian rocky islet"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шхера",
                                "target_lang_sense_clarification": "небольшой скалистый остров или риф"
                            },
                            {
                                "target_lang_word": "риф",
                                "target_lang_sense_clarification": "подводная или едва выступающая скала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b6513c4-a804-3848-a1bb-3d4c79111b91",
                    "sense_definition": "Een lichaamsdeel van een dier, zoals een schaar van een krab.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De krab zwaaide dreigend met zijn grote <w>scheer</w>.",
                            "target_lang_translations": {
                                "fr": "Le crabe agitait menaçamment sa grande <w>pince</w>.",
                                "en": "The crab waved its large <w>claw</w> menacingly.",
                                "ru": "Краб угрожающе размахивал своей большой <w>клешнёй</w>."
                            }
                        },
                        {
                            "text": "Pas op dat de kreeft je niet grijpt met zijn <w>scheer</w>.",
                            "target_lang_translations": {
                                "fr": "Fais attention à ce que le homard ne t'attrape pas avec sa <w>pince</w>.",
                                "en": "Watch out that the lobster doesn't grab you with its <w>pincer</w>.",
                                "ru": "Смотри, чтобы омар не схватил тебя своей <w>клешнёй</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaar"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une partie du corps d'un animal, comme la pince d'un crabe.",
                        "en": "A pincer or claw of a crustacean or other animal.",
                        "ru": "Часть тела животного, клешня рака или краба."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pince",
                                "target_lang_sense_clarification": "Organe préhensile des crustacés"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "claw",
                                "target_lang_sense_clarification": "pincer of a crab or lobster"
                            },
                            {
                                "target_lang_word": "pincer",
                                "target_lang_sense_clarification": "grasping claw of a crustacean"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "клешня",
                                "target_lang_sense_clarification": "хватательный орган ракообразных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a308bcd6-fdcb-380a-ae2f-dbfb9cb70d88",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>scheren</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>scheer</w> me elke ochtend voor het werk.",
                            "target_lang_translations": {
                                "fr": "Je <w>me rase</w> tous les matins avant le travail.",
                                "en": "I <w>shave</w> every morning before work.",
                                "ru": "Я <w>бреюсь</w> каждое утро перед работой."
                            }
                        },
                        {
                            "text": "Ik <w>scheer</w> mijn benen voordat ik naar het strand ga.",
                            "target_lang_translations": {
                                "fr": "Je <w>me rase</w> les jambes avant d'aller à la plage.",
                                "en": "I <w>shave</w> my legs before I go to the beach.",
                                "ru": "Я <w>брею</w> ноги перед тем, как пойти на пляж."
                            }
                        }
                    ],
                    "common_phrases": [
                        "me scheren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent du verbe raser.",
                        "en": "First-person singular present indicative of 'scheren' (to shave).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола scheren (брею, бреюсь)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "je me rase",
                                "target_lang_sense_clarification": "Action de se couper les poils ou la barbe"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "shave",
                                "target_lang_sense_clarification": "first-person singular form (I shave)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "бреюсь",
                                "target_lang_sense_clarification": "удалять волосы с лица или тела (о себе)"
                            },
                            {
                                "target_lang_word": "брею",
                                "target_lang_sense_clarification": "сбривать, брить кого-либо или часть тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44bd78d7-fd24-39d3-bf52-2291cfea1f16",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>scheren</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Scheer</w> jij je elke dag met een mesje?",
                            "target_lang_translations": {
                                "fr": "<w>Te rases-tu</w> tous les jours avec un rasoir ?",
                                "en": "Do you <w>shave</w> with a razor every day?",
                                "ru": "Ты каждый день <w>бреешься</w> станком?"
                            }
                        },
                        {
                            "text": "Waarom <w>scheer</w> jij je baard niet af?",
                            "target_lang_translations": {
                                "fr": "Pourquoi ne <w>te rases-tu</w> pas la barbe ?",
                                "en": "Why don't you <w>shave</w> off your beard?",
                                "ru": "Почему ты не <w>сбреешь</w> бороду?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "je scheren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent du verbe raser.",
                        "en": "Second-person singular present indicative of 'scheren' (in inversion).",
                        "ru": "Форма второго лица единственного числа настоящего времени глагола scheren (бреешь, бреешься)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tu te rases",
                                "target_lang_sense_clarification": "Action de se couper les poils ou la barbe"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "shave",
                                "target_lang_sense_clarification": "second-person singular form (you shave)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "бреешься",
                                "target_lang_sense_clarification": "форма для 'ты' (возвратная)"
                            },
                            {
                                "target_lang_word": "бреешь",
                                "target_lang_sense_clarification": "форма для 'ты' (переходная)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "532fc4d7-929d-3800-997b-7e8cf980c38e",
                    "sense_definition": "Gebiedende wijs van <w>scheren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Scheer</w> je nu eindelijk eens voor het feest begint.",
                            "target_lang_translations": {
                                "fr": "<w>Rase-toi</w> enfin avant que la fête ne commence.",
                                "en": "<w>Shave</w> already before the party starts.",
                                "ru": "<w>Побрейся</w> наконец, пока не начался праздник."
                            }
                        },
                        {
                            "text": "<w>Scheer</w> die lelijke snor eens af.",
                            "target_lang_translations": {
                                "fr": "<w>Rase-toi</w> cette vilaine moustache.",
                                "en": "<w>Shave</w> off that ugly mustache.",
                                "ru": "<w>Сбрей</w> эти дурацкие усы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe raser.",
                        "en": "Imperative of 'scheren' (to shave).",
                        "ru": "Повелительное наклонение глагола scheren (брей, брейся)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rase-toi",
                                "target_lang_sense_clarification": "Ordre ou conseil de se couper les poils ou la barbe"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "shave",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "брейся",
                                "target_lang_sense_clarification": "побуждение побриться"
                            },
                            {
                                "target_lang_word": "брей",
                                "target_lang_sense_clarification": "побуждение сбрить что-либо"
                            },
                            {
                                "target_lang_word": "сбей",
                                "target_lang_sense_clarification": "приказ или побуждение срезать/сбрить волосы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
