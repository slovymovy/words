                        "sense_id": "c6fc0be3-4c55-37ad-985b-0b89bae9a7fb",
                        "entry_id": "70ec51a9-75ec-3ebb-a684-e5327e4cca6a",
                        "glosses": [
                            "dział techniki, który łączy w sobie elementy mechaniki, budowy maszyn, elektroniki, automatyki, robotyki oraz informatyki"
                        ],
                        "tags": [],
                        "examples": [],
