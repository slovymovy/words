                        "examples": [
                            {
                                "example_id": "ab16b837-e04e-4e56-8fa5-1adbfcc585f3",
                                "sense_id": "e8ae71ff-3ad5-3562-b5c3-558fef37dbc5",
                                "text": "Nach dem Spiel tranken sie zwei Guinness im Pub."
                            },
                            {
                                "example_id": "4096f7cd-1b56-4643-abba-7c97e7880aed",
                                "sense_id": "e8ae71ff-3ad5-3562-b5c3-558fef37dbc5",
                                "text": "„Ich trank warmes Guinness aus der Dose und setzte mich an den einzigen Tisch.“"
                            },
                            {
                                "example_id": "2b9f4b82-e9a7-41d1-9651-ea0c37551343",
                                "sense_id": "e8ae71ff-3ad5-3562-b5c3-558fef37dbc5",
                                "text": "„In Dublin geht ein Ire in eine Bar, bestellt drei Gläser Guinness und setzt sich in eine ruhige Ecke, wo er nacheinander einen Schluck aus allen drei Gläsern zu sich nimmt.“"
                            }
                        ],
