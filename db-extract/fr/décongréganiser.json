                "senses": [
                    {
                        "sense_id": "59a7240b-083e-341c-9fe2-d8f6928b63ef",
                        "entry_id": "19a805a8-ca2c-34c6-8f06-59f7f24c37c3",
                        "glosses": [
                            "Faire perdre son caractère congréganiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c402801f-b879-456a-ae97-a72796ecaf3c",
                                "sense_id": "59a7240b-083e-341c-9fe2-d8f6928b63ef",
                                "text": "Elles se décongréganisent et se transforment en écoles libres catholiques."
                            },
                            {
                                "example_id": "9633236a-e07f-4c0c-bb24-2ba973192d22",
                                "sense_id": "59a7240b-083e-341c-9fe2-d8f6928b63ef",
                                "text": "Les congréganistes introduisaient au mieux la diversité, au pire la division, dans l’enseignement public ; désormais, ils renforcent les oppositions entre les deux écoles, car l’une se «congréganise» lorsque l’autre se «décongréganise»."
                            }
                        ]
                    }
