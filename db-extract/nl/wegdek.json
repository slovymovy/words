                                "target_senses": [
                                    {
                                        "sense_id": "323bdf59-9ba5-37e2-a1e8-e438f7d7fa27",
                                        "entry_id": "46ba8163-47b0-346b-8ee0-27cec2c0546e",
                                        "glosses": [
                                            "A paved surface; a hard covering on the ground."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee66193d-0b80-497a-8b90-2c7fdbc0612a",
                                                "sense_id": "323bdf59-9ba5-37e2-a1e8-e438f7d7fa27",
                                                "text": "The riches of heaven's pavement, trodden gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88211c57-23ba-3ab4-9d83-9fd581153ba7",
                                        "entry_id": "46ba8163-47b0-346b-8ee0-27cec2c0546e",
                                        "glosses": [
                                            "A paved path, for the use of pedestrians, located at the side of a road."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Ireland",
                                            "Mid-Atlantic",
                                            "South-Africa",
                                            "UK",
                                            "US",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "775f6500-79eb-438e-ae17-95c5679a1e5e",
                                                "sense_id": "88211c57-23ba-3ab4-9d83-9fd581153ba7",
                                                "text": "It was a cold and rainy afternoon as Ethel Churchill sat at the window of their new abode, a house in one of the streets leading from the Strand to the river. It was the day after their arrival, and nothing could well be more gloomy than the view: the pavement was wet, and a yellow mist obscured every object,..."
                                            },
                                            {
                                                "example_id": "68664851-6720-458b-b1b7-df56f5d14c6d",
                                                "sense_id": "88211c57-23ba-3ab4-9d83-9fd581153ba7",
                                                "text": "Nanny Broome was looking up at the outer wall. Just under the ceiling there were three lunette windows, heavily barred and blacked out in the normal way by centuries of grime. Their bases were on a level with the pavement outside, a narrow way which was several feet lower than the road behind the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e6b692-b545-3eb7-a4cb-dbc2b795e7a9",
                                        "entry_id": "46ba8163-47b0-346b-8ee0-27cec2c0546e",
                                        "glosses": [
                                            "A paving (paved part) of a road or other thoroughfare; the roadway or road surface."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e249cf-3525-4453-8516-9bd2f5897073",
                                                "sense_id": "14e6b692-b545-3eb7-a4cb-dbc2b795e7a9",
                                                "text": "[H]e attempted to recover his importance, by haranguing upon the Roman highways, when Mr. Jolter desired the company to take notice of the fine pavement upon which they travelled from Paris into Flanders […]."
                                            },
                                            {
                                                "example_id": "920a6383-5682-48f3-b083-78596acaf793",
                                                "sense_id": "14e6b692-b545-3eb7-a4cb-dbc2b795e7a9",
                                                "text": "The antirunway munitions are specifically designed to cause maximum destruction to airfield pavements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c8bbf3d-2b61-3ad8-acc5-0619f0f0ee64",
                                        "entry_id": "46ba8163-47b0-346b-8ee0-27cec2c0546e",
                                        "glosses": [
                                            "The paved part of an area other than a road or sidewalk, such as a cobblestone plaza, asphalt schoolyard or playground, or parking lot."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c867f53e-c57e-3410-ab0f-653a96e11f64",
                                        "entry_id": "46ba8163-47b0-346b-8ee0-27cec2c0546e",
                                        "glosses": [
                                            "Interior flooring, especially when of stone, of large buildings."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58288182-d09a-44fb-b0ec-cc598fa2dc26",
                                                "sense_id": "c867f53e-c57e-3410-ab0f-653a96e11f64",
                                                "text": "...that took them to a brief rise of marble stairs that should've put them on the third-and-a-halfth floor if it'd been anywhere but Hogwarts, and then it was back to tiled stone pavement again, and..."
                                            }
                                        ]
                                    },
