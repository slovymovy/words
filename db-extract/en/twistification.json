                        "glosses": [
                            "The act of twisting or its result; convolution or distortion."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "nonstandard",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "71eb1458-18c3-4168-a7ac-04fdde0d0301",
                                "sense_id": "7516cdb4-fe25-360f-aaa9-40feb6030f9e",
                                "text": "\"Why, plain language is best, when one knows the body one is speaking to; and I verily believe there is not a man on art that has less twistification in thought, word or deed than you, Mr. Spiffard.\""
                            },
                            {
                                "example_id": "abcc7ff6-5713-4829-98f6-119ac556944a",
                                "sense_id": "7516cdb4-fe25-360f-aaa9-40feb6030f9e",
                                "text": "He is the quaintest and queerest personage you ever saw, -- full of dry jokes, the humor of which is so incorporated with the strange twistifications of his physiognomy, that his sayings ought to be written down, accompanied with illustrations by Cruikshank."
                            },
                            {
                                "example_id": "e5685a9c-231d-4e3c-a704-71026ae9f347",
                                "sense_id": "7516cdb4-fe25-360f-aaa9-40feb6030f9e",
                                "text": "Truth is so easily told, that the veriest fool can give a straight story, where no twistification is necessary."
                            }
                        ]
                    },
