                    {
                        "sense_id": "f0057539-80da-3660-a6ef-838a95589dd3",
                        "entry_id": "a9e47d2a-96c8-31f1-8164-ddf60d21d37e",
                        "glosses": [
                            "Synonym of fomite: a substance able to communicate infection between people."
