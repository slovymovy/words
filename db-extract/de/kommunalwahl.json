                "senses": [
                    {
                        "sense_id": "199d305f-1e91-3c66-aa8d-c20afc0fc399",
                        "entry_id": "19476afb-418a-3da3-90d3-948acd8e02de",
                        "glosses": [
                            "die Wahl der Gemeinde- beziehungsweise Stadträte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e348dd-5be0-450b-9a78-8a1caa82c71f",
                                "sense_id": "199d305f-1e91-3c66-aa8d-c20afc0fc399",
                                "text": "Wegen der anstehenden Kommunalwahl quillt unser Briefkasten über vor lauter Wahlwerbung."
                            },
                            {
                                "example_id": "c191e9c2-ea20-47fa-90ef-77dd6021dc37",
                                "sense_id": "199d305f-1e91-3c66-aa8d-c20afc0fc399",
                                "text": "„Aus den Kommunalwahlen 1987 in Karatschi ging sie als klarer Sieger hervor und konnte auch den islamistischen Parteien, allen voran der Jamaat-e-Islami, Wähler abspenstig machen, die während der ethnischen Ausschreitungen in Karatschi unauffällig geblieben waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
