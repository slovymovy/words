                        "entry_id": "1fc370e5-fd59-3aad-84ca-3b4e08ed317d",
                        "glosses": [
                            "een conflict tussen gebruikers op een wiki dat zich kenmerkt doordat zij herhaaldelijk elkaars bewerkingen ongedaan maken."
                        ],
                        "tags": [
                            "wikitaal"
                        ],
                        "examples": [
                            {
                                "example_id": "5f7d896f-34ee-4e6d-9e86-91c1bedf7267",
                                "sense_id": "0fb083ad-cef9-3ab7-9114-e11b884fef83",
                                "text": "De gebruiker werd geblokkeerd nadat hij weer een bewerkingsoorlog had gevoerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19ed288c-8e0e-4fb9-bc84-51fe304e01a1",
                        "source_entry_id": "1fc370e5-fd59-3aad-84ca-3b4e08ed317d",
                        "source_sense_id": "0fb083ad-cef9-3ab7-9114-e11b884fef83",
                        "source_sense_description": "een bepaald conflict op een wiki",
                        "target_lang_word": "edit war",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edit war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "094fa469-06a4-3bfa-afe5-aa4f477a29e6",
                                        "entry_id": "68575f2d-9c47-3306-9e4b-7cd263c9ec82",
                                        "glosses": [
                                            "A dispute over the content of a page on a wiki or other editable work where opposing editors continually change the page without discussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f1b94c-03f0-4f65-80cc-d957afb9793d",
                                                "sense_id": "094fa469-06a4-3bfa-afe5-aa4f477a29e6",
                                                "text": "As with dinner-table discussions, it is best to avoid editing articles about politics or religion unless one wishes to become entrenched in a perpetual edit war."
                                            },
                                            {
                                                "example_id": "0e9de5b0-6d0d-4823-9259-a5c3eff288d6",
                                                "sense_id": "094fa469-06a4-3bfa-afe5-aa4f477a29e6",
                                                "text": "An unproductive edit war results as editors change the page back and forth between two incompatible versions, without troubling to engage in discussions."
                                            },
                                            {
                                                "example_id": "acecdbe8-b31d-4f19-b873-06e47a760635",
                                                "sense_id": "094fa469-06a4-3bfa-afe5-aa4f477a29e6",
                                                "text": "In 2008, doubters of the official account of the attacks — sometimes called truthers — were told by the arbitration committee not to edit the main page on the attacks after so-called edit wars over what should be included there."
                                            },
                                            {
                                                "example_id": "333476ac-4e8f-4d1d-9e27-6b8cd4811222",
                                                "sense_id": "094fa469-06a4-3bfa-afe5-aa4f477a29e6",
                                                "text": "Edit wars—about everything from Roseanne Barr to the Minneapolis suburb of Edina to the Death Star’s size to whether tigers are in fact “the most powerful living cat”—have been part of Wikipedia since its beginning."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "edit war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb8c9c3-2a15-3d0a-a1c3-65de9508ee11",
                                        "entry_id": "dfc8966e-0155-33b0-b4e6-471676893e4d",
                                        "glosses": [
                                            "To engage in an edit war."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233f7f04-135a-45be-aaa3-bf6b0a2c3535",
                                                "sense_id": "bdb8c9c3-2a15-3d0a-a1c3-65de9508ee11",
                                                "text": "When a dispute arises, it is common to see a page protected to avoid edit warring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
