                ],
                "senses": [
                    {
                        "sense_id": "3950685a-0309-3c45-b0a7-84d3c841e8b8",
                        "entry_id": "268f5e35-8940-381a-93f4-e8ce9bda5858",
                        "glosses": [
                            "Art zu leben, die sich auf dem Dorf einstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4239355-0e32-4c8f-874d-5f16bfc039cc",
                                "sense_id": "3950685a-0309-3c45-b0a7-84d3c841e8b8",
                                "text": "„Das Dorfleben in Lifta konzentrierte sich in dem kleinen Geschäftszentrum, wo es auch einen Club und zwei Kaffeehäuser gab.“"
                            },
                            {
                                "example_id": "4d3b3add-ba69-4639-b080-f3ff2d243638",
                                "sense_id": "3950685a-0309-3c45-b0a7-84d3c841e8b8",
                                "text": "„Zudem konnte für junge Männer der Dienst am Hofe auch als Ausbrechen aus dem Dorfleben attraktiv erscheinen, als Befreiung von der harten landwirtschaftlichen Arbeit und der Autorität der Älteren.“"
                            },
                            {
                                "example_id": "e29a3a23-539f-4c92-b60d-50bbc9ed314c",
                                "sense_id": "3950685a-0309-3c45-b0a7-84d3c841e8b8",
                                "text": "„Das Dorfleben war nie ihr Ding gewesen.“"
                            },
                            {
                                "example_id": "29258fd9-75fc-4cb3-b019-b3c69f8054b9",
                                "sense_id": "3950685a-0309-3c45-b0a7-84d3c841e8b8",
                                "text": "„Sie neigten eher dazu, das traditionelle Dorfleben zu bewahren - eine Einstellung, die bezeichnend für das Vorgehen im gesamten Britischen Empire war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
