                                "target_senses": [
                                    {
                                        "sense_id": "736b8385-83ae-38fa-9eee-5406b0ac1cfa",
                                        "entry_id": "48f9c409-2213-3c3d-9210-e34a6fc50ab4",
                                        "glosses": [
                                            "To support or secure using a wedge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605e893a-6f68-4dad-94f7-072c578b3d0d",
                                                "sense_id": "736b8385-83ae-38fa-9eee-5406b0ac1cfa",
                                                "text": "I wedged open the window with a screwdriver."
                                            },
                                            {
                                                "example_id": "2627e4eb-2e8f-4fff-a276-2456ed149330",
                                                "sense_id": "736b8385-83ae-38fa-9eee-5406b0ac1cfa",
                                                "text": "\"Did he take his bottle well?\" Mrs. Flanders whispered, and Rebecca nodded and went to the cot and turned down the quilt, and Mrs. Flanders bent over and looked anxiously at the baby, asleep, but frowning. The window shook, and Rebecca stole like a cat and wedged it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db999c6c-1a13-37be-ad74-af7b0157bea8",
                                        "entry_id": "48f9c409-2213-3c3d-9210-e34a6fc50ab4",
                                        "glosses": [
                                            "To force into a narrow gap."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f62f267-85f1-4ea2-b986-dcf0d2f56f07",
                                                "sense_id": "db999c6c-1a13-37be-ad74-af7b0157bea8",
                                                "text": "He had wedged the package between the wall and the back of the sofa."
                                            },
                                            {
                                                "example_id": "aac9a089-8fca-4875-85cb-2e971cc5b354",
                                                "sense_id": "db999c6c-1a13-37be-ad74-af7b0157bea8",
                                                "text": "I wedged into the alcove and listened carefully."
                                            },
                                            {
                                                "example_id": "238f49c8-3372-460f-8fda-bf8b7a3ec92a",
                                                "sense_id": "db999c6c-1a13-37be-ad74-af7b0157bea8",
                                                "text": "During [Tucker] Carlson’s keynote, he wedged sneers at his critics for crying “racist!” in between racist remarks about [Ilhan] Omar, jeremiads against the media (“I know there’s a bunch of reporters here, so . . . screw you”), and an attack on Elizabeth Warren and her donors (“She’s a tragedy, because she’s now obsessed with racism, which is why the finance world supports her”)—all to gleeful applause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56d4bd4c-44ba-37f5-b276-3018e7433060",
                                        "entry_id": "48f9c409-2213-3c3d-9210-e34a6fc50ab4",
                                        "glosses": [
                                            "To pack (people or animals) together tightly into a mass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
