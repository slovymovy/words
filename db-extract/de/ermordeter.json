                                "sense_id": "7ef4a005-5d52-347d-bbb4-281cbf46ff6c",
                                "text": "„Am nächsten Tag wurden wieder zwei Ermordete gefunden, Männer, von denen man wusste, dass sie Geschäftspartner Pablos waren.“"
                            },
                            {
                                "example_id": "e2f40bfb-4a57-4502-b727-925915ce9c1a",
                                "sense_id": "7ef4a005-5d52-347d-bbb4-281cbf46ff6c",
                                "text": "„Normalerweise werden die Gräber von Ermordeten in der Nacht nach der Beerdigung bewacht.“"
                            },
                            {
                                "example_id": "7e042bd0-2ef0-4a85-97e4-5c2bfa69a884",
                                "sense_id": "7ef4a005-5d52-347d-bbb4-281cbf46ff6c",
                                "text": "„Als Erste umarmen ihn die Ermordeten.“"
                            }
