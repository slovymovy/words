{
    "word_family": [
        "хроника",
        "хроник",
        "хронически"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06308491-539e-3c28-8293-147ce207a054",
                    "sense_definition": "Длительный, медленно развивающийся (о болезни).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У пациента диагностировали <w>хронический</w> бронхит.",
                            "target_lang_translations": {
                                "en": "The patient was diagnosed with <w>chronic</w> bronchitis."
                            }
                        },
                        {
                            "text": "Это <w>хроническое</w> заболевание требует постоянного наблюдения врача.",
                            "target_lang_translations": {
                                "en": "This <w>chronic</w> disease requires constant medical supervision."
                            }
                        }
                    ],
                    "synonyms": [
                        "затяжной"
                    ],
                    "antonyms": [
                        "острый"
                    ],
                    "common_phrases": [
                        "хронический бронхит",
                        "хроническое заболевание"
                    ],
                    "target_lang_definitions": {
                        "en": "Long-lasting, slowly developing (referring to a disease or medical condition)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chronic",
                                "target_lang_sense_clarification": "Used to describe a medical condition that is prolonged or slow to heal."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e156451-6f51-3f9f-b692-d4ab11834fbe",
                    "sense_definition": "Страдающий затяжной или периодически возобновляющейся болезнью.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот <w>хронический</w> больной нуждается в особом уходе.",
                            "target_lang_translations": {
                                "en": "This <w>chronic</w> patient requires special care."
                            }
                        },
                        {
                            "text": "Он стал <w>хроническим</w> пациентом нашей клиники.",
                            "target_lang_translations": {
                                "en": "He has become a <w>chronic</w> patient at our clinic."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Suffering from a long-term or periodically recurring illness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chronic patient",
                                "target_lang_sense_clarification": "A person suffering from a long-term or recurring medical condition."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0a12efd-1fa2-37cc-95c1-0783a0ff619f",
                    "sense_definition": "Носящий затяжной, длительный характер (о чём-либо нежелательном).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом отделе наблюдается <w>хроническая</w> нехватка кадров.",
                            "target_lang_translations": {
                                "en": "There is a <w>chronic</w> shortage of staff in this department."
                            }
                        },
                        {
                            "text": "Он страдает от <w>хронического</w> безденежья уже много лет.",
                            "target_lang_translations": {
                                "en": "He has been suffering from <w>chronic</w> lack of money for many years."
                            }
                        }
                    ],
                    "synonyms": [
                        "постоянный",
                        "затяжной"
                    ],
                    "common_phrases": [
                        "хроническая нехватка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в переносном значении"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Having a long-term, persistent nature (referring to something undesirable)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chronic",
                                "target_lang_sense_clarification": "Used to describe a problem that continues over an extended period of time."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}