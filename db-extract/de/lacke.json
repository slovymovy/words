                    }
                ],
                "senses": [
                    {
                        "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                        "entry_id": "8a0fad82-0c07-357e-8bde-7ac708cefcc5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c3e5d3-1112-4442-9a94-eaf85d41fda0",
                                "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                                "text": "Frau Lacke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3325d2a2-cd72-4064-86ef-7cc5a21a5137",
                                "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                                "text": "Herr Lacke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ba6d82c2-1e52-411b-9f37-fd7c1ff07a46",
                                "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                                "text": "Die Lackes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7dffa2b3-883b-4482-8b54-c0e138dea042",
                                "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                                "text": "Der Lacke trägt nie die Schals, die die Lacke ihm strickt."
                            },
                            {
                                "example_id": "42617260-0191-40ce-ac3a-47c195f1ecec",
                                "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lacke kommt, geht der Herr Lacke.“"
                            },
                            {
                                "example_id": "febf4b51-6b7a-48b8-9278-1bcd6683d02b",
                                "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                                "text": "Lacke kommt und geht."
                            },
                            {
                                "example_id": "3f773c58-4da0-41b0-b249-205db7e335da",
                                "sense_id": "29caee4b-b1c2-3ed9-957b-c33fde5544bd",
                                "text": "Lackes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
