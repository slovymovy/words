{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af13240e-15bf-33d1-9c98-55ec78778a46",
                    "sense_definition": "A machine tool used to shape wood, metal, or other materials by rotating the workpiece against a stationary cutting tool.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "machine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter shaped the wooden table leg carefully using a <w>lathe</w>.",
                            "target_lang_translations": {
                                "ru": "Плотник аккуратно выточил деревянную ножку стола на <w>токарном станке</w>."
                            }
                        },
                        {
                            "text": "You must always wear safety goggles when operating a <w>lathe</w> in the workshop.",
                            "target_lang_translations": {
                                "ru": "При работе на <w>токарном станке</w> в мастерской всегда необходимо надевать защитные очки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wood lathe",
                        "metal lathe",
                        "turn on a lathe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Станок, используемый для обработки дерева, металла или других материалов путем вращения заготовки относительно неподвижного резца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "токарный станок",
                                "target_lang_sense_clarification": "станок для токарной обработки материалов"
                            },
                            {
                                "target_lang_word": "станок",
                                "target_lang_sense_clarification": "сокращенное обозначение токарного станка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15727be2-a252-3ea0-b962-8407a1b3efc6",
                    "sense_definition": "The movable swinging frame of a loom that carries the reed to beat the weft into place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weaver pulled the <w>lathe</w> forward firmly to push each newly laid thread into place.",
                            "target_lang_translations": {
                                "ru": "Ткач уверенно потянул <w>батан</w> на себя, чтобы прибить каждую новую нить на место."
                            }
                        },
                        {
                            "text": "Proper alignment of the loom's <w>lathe</w> is essential to ensure an even fabric weave.",
                            "target_lang_translations": {
                                "ru": "Правильное выравнивание <w>набилки</w> ткацкого станка крайне важно для получения ровного плетения ткани."
                            }
                        }
                    ],
                    "synonyms": [
                        "batten",
                        "beater",
                        "lay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижная качающаяся рама ткацкого станка (батан), несущая бердо для прибивания уточной нити к ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "батан",
                                "target_lang_sense_clarification": "деталь ткацкого станка"
                            },
                            {
                                "target_lang_word": "набилка",
                                "target_lang_sense_clarification": "качающаяся рама в ткачестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b417242-0e32-3e83-bf90-bf5a4102032b",
                    "sense_definition": "A barn or granary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmer stored his fresh bundles of hay inside the wooden <w>lathe</w>.",
                            "target_lang_translations": {
                                "ru": "Старый фермер сложил свежие тюки сена в деревянный <w>амбар</w>."
                            }
                        },
                        {
                            "text": "Heavy autumn rains caused damage to the weathered roof of the stone <w>lathe</w>.",
                            "target_lang_translations": {
                                "ru": "Сильные осенние дожди повредили обветшалую крышу каменного <w>сарая</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional Northern English"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "rare and mostly archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Амбар или зернохранилище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбар",
                                "target_lang_sense_clarification": "диалектное или устаревшее строение"
                            },
                            {
                                "target_lang_word": "сарай",
                                "target_lang_sense_clarification": "хозяйственная постройка"
                            },
                            {
                                "target_lang_word": "житница",
                                "target_lang_sense_clarification": "хранилище для зерна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a81d00a-e6c3-37e2-b146-eda4d4a87de1",
                    "sense_definition": "A historical administrative subdivision of the English county of Kent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, each <w>lathe</w> in Kent comprised several hundreds under the control of a reeve.",
                            "target_lang_translations": {
                                "ru": "В средневековые времена каждый <w>лейс</w> в Кенте состоял из нескольких сотен под управлением рива."
                            }
                        },
                        {
                            "text": "Old county records show that tax collection was formerly organized by the boundaries of each <w>lathe</w>.",
                            "target_lang_translations": {
                                "ru": "Старые записи графства показывают, что сбор налогов раньше организовывался по границам каждого <w>лейса</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical administrative unit"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Kent, England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Историческая административно-территориальная единица английского графства Кент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лейс",
                                "target_lang_sense_clarification": "исторический округ в Кенте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ea4707a-48ed-3878-bfb7-43a1a75d68a7",
                    "sense_definition": "To shape or cut a workpiece using a lathe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman will <w>lathe</w> the cylinder of wood until it is smooth and perfectly round.",
                            "target_lang_translations": {
                                "ru": "Мастер будет <w>обтачивать</w> деревянный цилиндр до тех пор, пока он не станет гладким и идеально круглым."
                            }
                        },
                        {
                            "text": "He meticulously <w>lathed</w> each spindle to match the restoration plan for the antique chair.",
                            "target_lang_translations": {
                                "ru": "Он тщательно <w>выточил</w> каждую балясину в соответствии с планом реставрации старинного стула."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать заготовку на токарном станке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точить",
                                "target_lang_sense_clarification": "обрабатывать на токарном станке"
                            },
                            {
                                "target_lang_word": "обтачивать",
                                "target_lang_sense_clarification": "придавать форму вращающейся детали"
                            },
                            {
                                "target_lang_word": "вытачивать",
                                "target_lang_sense_clarification": "изготавливать резанием на станке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c3c1c31-5bb3-3272-8c9a-264b5d045cdc",
                    "sense_definition": "In computer graphics, to generate a 3D surface or model by revolving a 2D profile curve around an axis.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "graphics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can quickly <w>lathe</w> a flat outline to create a realistic three-dimensional vase.",
                            "target_lang_translations": {
                                "ru": "Вы можете быстро <w>построить тело вращения</w> из плоского контура, чтобы создать реалистичную трехмерную вазу."
                            }
                        },
                        {
                            "text": "The 3D software makes it easy to <w>lathe</w> symmetrical shapes around the vertical axis.",
                            "target_lang_translations": {
                                "ru": "Программа для 3D-моделирования позволяет легко <w>создавать</w> симметричные формы <w>вращением</w> вокруг вертикальной оси."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В компьютерной графике — создавать трехмерную модель вращением плоского профиля вокруг оси."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "создавать тело вращения",
                                "target_lang_sense_clarification": "в 3D-моделировании"
                            },
                            {
                                "target_lang_word": "вращать профиль",
                                "target_lang_sense_clarification": "в компьютерной графике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d344939-77e9-3225-9267-056fce058a2a",
                    "sense_definition": "To invite, ask, or bid someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "invite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villager went from house to house to <w>lathe</w> his neighbors to the wedding feast.",
                            "target_lang_translations": {
                                "ru": "Селянин ходил от дома к дому, чтобы <w>созвать</w> соседей на свадебный пир."
                            }
                        },
                        {
                            "text": "They were kindly <w>lathed</w> to the annual harvest supper by the elders of the parish.",
                            "target_lang_translations": {
                                "ru": "Старейшины прихода любезно <w>пригласили</w> их на ежегодный праздничный ужин в честь сбора урожая."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in common use"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приглашать, звать или просить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглашать",
                                "target_lang_sense_clarification": "устаревшее диалектное значение"
                            },
                            {
                                "target_lang_word": "звать",
                                "target_lang_sense_clarification": "приглашать в гости или на праздник"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}