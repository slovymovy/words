                ],
                "senses": [
                    {
                        "sense_id": "c9273326-50d2-333d-9946-8b790bb85696",
                        "entry_id": "ca7f9b2b-07ec-3612-96ec-5a68ad0874f4",
                        "glosses": [
                            "Wortart, welche die Beschaffenheit, den Zustand oder eine Beziehung einer Person, eines Dinges oder einer Sache beschreibt"
                        ],
                        "tags": [
                            "Wortarten"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ac935a-ff7a-4810-a701-cdaba58fdcf9",
                                "sense_id": "c9273326-50d2-333d-9946-8b790bb85696",
                                "text": "Gerade bei der Mode findet man Geschmacksadjektive, die reine Geschmackssache ist und weniger die Sinneszellen im Mund reizen."
                            },
                            {
                                "example_id": "babd23f5-85b1-4e3c-97ea-045ee420b4f5",
                                "sense_id": "c9273326-50d2-333d-9946-8b790bb85696",
                                "text": "„Da das Ziel hier die Feststellung der für die semantische Interpretation notwendigen Merkmale ist, werden wir nicht alle Bedeutungen der Geschmacksadjektive suchen; außer Betracht bleibt auch ihr übertragener Gebrauch, weil sie dann eigentlich keine echten Geschmacksadjektive mehr sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3d1fdda9-14cd-31e0-a090-f4083bbae41c",
                        "entry_id": "ca7f9b2b-07ec-3612-96ec-5a68ad0874f4",
                        "glosses": [
                            "Wortart, welche die Empfindung von Mensch und höheren Tieren bei der Nahrungsaufnahme über den Mund beschreibt"
                        ],
                        "tags": [
                            "Wortarten"
                        ],
                        "examples": [
                            {
                                "example_id": "1002405d-189c-45c3-b83b-d510dc4299f0",
                                "sense_id": "3d1fdda9-14cd-31e0-a090-f4083bbae41c",
                                "text": "„Da das Ziel hier die Feststellung der für die semantische Interpretation notwendigen Merkmale ist, werden wir nicht alle Bedeutungen der Geschmacksadjektive suchen; außer Betracht bleibt auch ihr übertragener Gebrauch, weil sie dann eigentlich keine echten Geschmacksadjektive mehr sind.“"
                            },
                            {
                                "example_id": "2db891a4-ebd0-4707-846f-8e97dcfe7e82",
                                "sense_id": "3d1fdda9-14cd-31e0-a090-f4083bbae41c",
                                "text": "„Rund 1000 dieser Geschmacksadjektive hat das Team um Maren Runte im Rahmen ihres interdisziplinären Projektes bereits zusammengetragen.“"
                            },
                            {
                                "example_id": "2c3b86ca-0bd6-4f66-abe7-67427281f5cb",
                                "sense_id": "3d1fdda9-14cd-31e0-a090-f4083bbae41c",
                                "text": "„So werden Geschmackseindrücke physiologisch durch die Reizung von Sinneszellen verursacht, doch lassen sie sich sprachlich mit Hilfe von Geschmacksadjektiven erfassen und kommunizieren“"
                            },
                            {
                                "example_id": "07de2729-8147-46c7-ba9e-e8af6b2c0276",
                                "sense_id": "3d1fdda9-14cd-31e0-a090-f4083bbae41c",
                                "text": "„Schüler ergänzen die Liste der Geschmacksadjektive mit Begriffen aus dem eigenen Wortschatz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
