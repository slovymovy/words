                        "glosses": [
                            "weibliche Person, die mit Hunden besonders gut auskommt; weibliche Person, die Hunde sehr mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a7a3b81-a343-4ed3-bbb6-481ded6515d9",
                                "sense_id": "8203eea2-7540-3031-b491-9cddd079f2f4",
                                "text": "„Federführend war dabei Anni Rabinig. Sie betreut die SB-Lanzenwaschanlage an der Tankstelle und ist eine große Hundeliebhaberin.“"
                            },
                            {
                                "example_id": "167d0598-b7ee-4fc8-b96e-12e80d275f31",
                                "sense_id": "8203eea2-7540-3031-b491-9cddd079f2f4",
                                "text": "„Treibende Kraft im Verfahren gegen die Hundeliebhaberin war die malaysische Regierungsbehörde Jakim, die über die Einhaltung muslimischer Werte wacht.“"
                            }
                        ],
