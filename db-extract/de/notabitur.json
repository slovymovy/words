                "senses": [
                    {
                        "sense_id": "306bd949-ec44-3cd7-88e0-1e7cfe0d9fcc",
                        "entry_id": "3f43806a-91a2-3367-a9b5-9f56d5a86f04",
                        "glosses": [
                            "vorzeitiges Abitur (in Kriegszeiten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11bad70-c791-4072-b203-c51dd8f9cc11",
                                "sense_id": "306bd949-ec44-3cd7-88e0-1e7cfe0d9fcc",
                                "text": "„Trotzdem beantragte er, zum Notabitur zugelassen zu werden, der Voraussetzung für einen Einsatz als Fahnenjunker.“"
                            },
                            {
                                "example_id": "7cd1d542-88c5-4c46-837f-a582373d2d46",
                                "sense_id": "306bd949-ec44-3cd7-88e0-1e7cfe0d9fcc",
                                "text": "„Mein Vater war 1941 ins sogenannte Generalgouvernement Polen versetzt worden, und mein Bruder Konstantin war seit dem Sommer 1943 – nach einem sogenannte Notabitur nach verkürzter Schulzeit – bei der Wehrmacht.“"
                            },
                            {
                                "example_id": "42470688-3b83-49bf-8c3a-2eed70f1ff67",
                                "sense_id": "306bd949-ec44-3cd7-88e0-1e7cfe0d9fcc",
                                "text": "„Noch einmal fanden wir uns in jenem Schulsaal zusammen, aus dem ich einige Wochen früher so unrühmlich ausgewiesen worden war, um das Notabitur zu absolvieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
