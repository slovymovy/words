    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf0950fc-e718-3084-b91c-dad40956c163",
                    "sense_definition": "Louer excessivement quelqu'un dans le but de lui plaire, de le séduire ou d'en tirer un avantage personnel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "louange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet employé passe ses journées à <w>flatter</w> sans retenue la direction."
                        },
                        {
                            "text": "Elle n'aime pas qu'on la <w>flatte</w> avec des compliments exagérés."
                        }
                    ],
                    "synonyms": [
                        "complimenter",
                        "courtiser",
                        "amadouer"
                    ],
                    "antonyms": [
                        "critiquer",
                        "dénigrer",
                        "blâmer"
                    ],
                    "common_phrases": [
                        "flatter bassement"
                    ]
                },
                {
                    "sense_id": "5d583104-9f21-3179-8d0f-72cdd18185de",
                    "sense_definition": "Procurer une vive satisfaction à l'amour-propre, ou être agréable aux sens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces applaudissements chaleureux ont beaucoup <w>flatté</w> son orgueil d'artiste."
                        },
                        {
                            "text": "Ce vin délicat sait <w>flatter</w> le palais des amateurs de bonne chère."
                        }
                    ],
                    "synonyms": [
                        "satisfaire",
                        "gratifier",
                        "charmer"
                    ],
                    "antonyms": [
                        "blesser",
                        "déplaire",
                        "froisser"
                    ],
                    "common_phrases": [
                        "flatter les sens",
                        "flatter le palais"
                    ]
                },
                {
                    "sense_id": "ff2e9820-1438-3b98-9281-2df7342709b9",
                    "sense_definition": "Représenter une personne ou un objet sous un jour plus avantageux et séduisant que la réalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette robe ajustée permet de bien <w>flatter</w> la silhouette féminine."
                        },
                        {
                            "text": "Le peintre a un peu <w>flatté</w> son modèle pour masquer certaines rides."
                        }
                    ],
                    "synonyms": [
                        "embellir",
                        "avantager"
                    ],
                    "antonyms": [
                        "enlaidir",
                        "désavantager"
                    ],
                    "common_phrases": [
                        "flatter la silhouette",
                        "flatter les traits"
                    ]
                },
                {
                    "sense_id": "3c4c49a5-5404-3eca-a0a8-b9469788110d",
                    "sense_definition": "Caresser doucement un animal de la main pour l'apaiser ou lui témoigner de l'affection.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "toucher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier prend le temps de <w>flatter</w> un cheval avant de commencer l'entraînement."
                        },
                        {
                            "text": "L'enfant s'approcha lentement pour <w>flatter</w> un animal très craintif."
                        }
                    ],
                    "synonyms": [
                        "caresser"
                    ],
                    "antonyms": [
                        "frapper"
                    ],
                    "common_phrases": [
                        "flatter un cheval"
                    ]
                },
                {
                    "sense_id": "4522dfcb-a5fe-30f5-8d69-74dcf8d65c4f",
                    "sense_definition": "Se flatter de : concevoir une vive confiance ou s'illusionner avec fierté dans l'espérance d'une réussite.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "esperance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme espère pouvoir se <w>flatter</w> de réussir cet examen difficile."
                        },
                        {
                            "text": "L'avocat se <w>flatte</w> d'avoir trouvé une preuve décisive pour innocenter son client."
                        }
                    ],
                    "synonyms": [
                        "s'enorgueillir",
                        "se vanter",
                        "espérer"
                    ],
                    "antonyms": [
                        "douter",
                        "désespérer"
                    ],
                    "common_phrases": [
                        "se flatter de réussir"
                    ]
                }
            ]
        }
    ]
}