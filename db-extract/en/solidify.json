                "translations": [
                    {
                        "translation_id": "f4485a81-7943-49ed-bd84-b9a24a8d8dbc",
                        "source_entry_id": "b8236c50-5657-3d7e-a975-26e675d27e86",
                        "source_sense_description": "transitive: to make solid; convert into a solid body",
                        "target_lang_word": "solidifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solidifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf1d3dd6-08fd-35d9-9b6d-a71e29bec2d7",
                                        "entry_id": "8e2a2445-1352-3dae-86bf-9e22f5c121f8",
                                        "glosses": [
                                            "Rendre solide, ou plus solide, un objet ; étayer une construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "974581bd-8537-470b-a750-1ac2bf6b995b",
                                                "sense_id": "bf1d3dd6-08fd-35d9-9b6d-a71e29bec2d7",
                                                "text": "Ces froids vifs, mais peu durables, qui marquent ordinairement certains jours du mois de mai, - […] - suffirent à solidifier l'épaisse couche de neige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58c5e9b-37a6-3563-b930-262d9bd7c860",
                                        "entry_id": "8e2a2445-1352-3dae-86bf-9e22f5c121f8",
                                        "glosses": [
                                            "Rendre solide ce qui était liquide."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d532ffda-cbcd-43e0-87d8-7de01454213b",
                                                "sense_id": "f58c5e9b-37a6-3563-b930-262d9bd7c860",
                                                "text": "L'eau de mer, solidifiée par la congélation, se libère du chlorure de sodium, mais conserve les sulfates ; […]."
                                            },
                                            {
                                                "example_id": "adc66cda-e683-4d9e-895b-d0e219fe2e27",
                                                "sense_id": "f58c5e9b-37a6-3563-b930-262d9bd7c860",
                                                "text": "Le mercure ne se solidifie qu’à une basse température."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bb7dada-3ad4-3da1-ab87-fe90b52f3bf5",
                                        "entry_id": "8e2a2445-1352-3dae-86bf-9e22f5c121f8",
                                        "glosses": [
                                            "Rendre plus consistant, plus ferme, plus sûr, consolider."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30258125-baf9-415b-9ddd-964db123164a",
                                                "sense_id": "3bb7dada-3ad4-3da1-ab87-fe90b52f3bf5",
                                                "text": "La découverte a une portée fantastique puisque, en plus de solidifier les acquis décrits par Einstein, elle permet d’ouvrir un nouveau champ d’exploration quasi fantasmagorique lui, celui de l’étude des trous noirs, de tous les objets cosmiques invisibles jusque-là, du cœur des étoiles, et de traquer jusqu’aux premiers soubresauts du Big-Bang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75dbafb5-eb77-4501-a95a-b9af768f394f",
