                                        "sense_id": "b00a720d-bd1b-35e6-81ae-7c5479457efd",
                                        "entry_id": "10406250-13ea-3bf0-bb52-ee0399163979",
                                        "glosses": [
                                            "A pentahydric alcohol, C₅H₁₂O₅, penta-hydroxy pentane; derived from xylose; used as a sweetener."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b49589f-e331-4156-9953-d17642394a59",
                                                "sense_id": "b00a720d-bd1b-35e6-81ae-7c5479457efd",
                                                "text": "A note of caution to readers with pets: Xylitol is toxic to dogs and can have potentially life-threatening effects. As owners of two doggos ourselves, we encourage anyone with a dog to use extreme caution when bringing xylitol into your home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f7a8485-5bee-4c48-813d-5f265eba51d8",
                        "source_entry_id": "c481934b-4a57-3916-9da7-cc3053b00ddc",
                        "source_sense_id": "bb3090e7-24f4-317d-9806-99da5eb23403",
                        "source_sense_description": "een zoetstof die bereid is door hydrogenatie van xylose",
                        "target_lang_word": "xylitol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xylitol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98811152-e05d-3775-ba31-9aec8ed7a81a",
                                        "entry_id": "6074c2c6-b345-35dd-88c4-164afa3e616f",
                                        "glosses": [
                                            "Polyol extrait de l’écorce de bouleau, pouvant être utilisé comme substitut du sucre classique (saccharose)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af8473c-b755-4411-b870-a3d393d31baa",
                                                "sense_id": "98811152-e05d-3775-ba31-9aec8ed7a81a",
                                                "text": "Remplacez les sucres raffinés par les édulcorants naturels : stévia, sucre de bouleau, xylitol, sirop d’agave."
                                            },
                                            {
                                                "example_id": "a82c049b-bec8-4b07-97c4-4355d491717f",
                                                "sense_id": "98811152-e05d-3775-ba31-9aec8ed7a81a",
                                                "text": "Les bactéries responsables des caries, ne pouvant « digérer » le xylitol, en meurent intoxiquées. Le xylitol diminue aussi les sécrétions d'insuline, c'est donc une bonne alternative au sucre pour les diabétiques."
                                            },
                                            {
                                                "example_id": "5ba9f47b-97c0-4327-b4e7-cea6adcad809",
                                                "sense_id": "98811152-e05d-3775-ba31-9aec8ed7a81a",
                                                "text": "Des études ont même montré que le xylitol inhiberait la prolifération de certaines bactéries."
                                            },
                                            {
                                                "example_id": "2d869a24-a6c4-4642-a248-171f84c87375",
                                                "sense_id": "98811152-e05d-3775-ba31-9aec8ed7a81a",
                                                "text": "Je fais l’emplette des produits de première nécessité – une brosse à dents antibactérienne à poils ultra-fins, du dentifrice blanchissant liquide et du chewing-gum dentaire au xylitol – que je n’ai pas mis dans ma valise, sachant pouvoir tout trouver en arrivant ici, à Tokyo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
