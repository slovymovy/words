                {
                    "sense_id": "b858c09a-7a07-313a-9ace-33a3c3667aa0",
                    "sense_definition": "One who prays.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The devout <w>prayer</w> remained on his knees in the chapel for hours.",
                            "target_lang_translations": {
                                "ru": "Набожный <w>молящийся</w> часами стоял на коленях в часовне.",
                                "zh": "那位虔诚的<w>祈祷者</w>在礼拜堂里跪了几个小时。",
                                "nl": "De vrome <w>bidder</w> bleef urenlang op zijn knieën in de kapel.",
                                "pl": "Pobożny <w>wierny</w> trwał na kolanach w kaplicy przez wiele godzin.",
                                "de": "Der fromme <w>Beter</w> blieb stundenlang auf den Knien in der Kapelle.",
                                "fr": "Le <w>fidèle</w> est resté à genoux dans la chapelle pendant des heures.",
                                "it": "Il devoto <w>orante</w> è rimasto in ginocchio nella cappella per ore.",
                                "cs": "Zbožný <w>modlitel</w> zůstal v kapli hodiny klečet na kolenou.",
                                "tr": "Dindar <w>duacı</w> saatlerce şapelde diz çökmüş halde kaldı.",
                                "es": "El devoto <w>orante</w> permaneció de rodillas en la capilla durante horas."
                            }
                        },
                        {
                            "text": "As a faithful <w>prayer</w>, she visited the shrine every morning.",
                            "target_lang_translations": {
                                "ru": "Будучи верной <w>молящейся</w>, она посещала святыню каждое утро.",
                                "zh": "作为一名忠实的<w>祈祷者</w>，她每天早上都会去参拜神龛。",
                                "nl": "Als trouwe <w>bidster</w> bezocht ze elke ochtend het heiligdom.",
                                "pl": "Jako osoba <w>modląca się</w> z wiarą, odwiedzała sanktuarium każdego ranka.",
                                "de": "Als gläubige <w>Beterin</w> besuchte sie jeden Morgen den Schrein.",
                                "fr": "En tant que <w>fidèle</w>, elle visitait le sanctuaire chaque matin.",
                                "it": "Come fedele <w>orante</w>, visitava il santuario ogni mattina.",
                                "cs": "Jako věrná <w>modlitelka</w> navštěvovala svatyni každé ráno.",
                                "tr": "İnançlı bir <w>duacı</w> olarak her sabah türbeyi ziyaret ederdi.",
                                "es": "Como fiel <w>orante</w>, ella visitaba el santuario cada mañana."
                            }
                        }
