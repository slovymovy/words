                                    {
                                        "sense_id": "983f8705-d976-35f3-8086-992564627029",
                                        "entry_id": "8dfc8410-0785-3395-ab05-8a7063457277",
                                        "glosses": [
                                            "Kind (meist männlich), das Streiche spielt; übertragen auch Erwachsener"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4966d4e-877b-4fe2-84ed-bc86ede5041f",
                                                "sense_id": "983f8705-d976-35f3-8086-992564627029",
                                                "text": "Er hat die Fernbedienung versteckt, dieser Schlingel!"
                                            },
                                            {
                                                "example_id": "cc7b8536-259a-43f5-be00-91b27d2ee3f0",
                                                "sense_id": "983f8705-d976-35f3-8086-992564627029",
                                                "text": "„Da hatte sie nun den Schlingel von Eindringling so schön in der Klemme, nur noch ein kurzes Weilchen, und sie würde ihn abwürgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab78b1da-ce81-41f7-88dd-36713799a334",
                        "source_entry_id": "8f920280-40d7-3c09-b626-db5929130361",
