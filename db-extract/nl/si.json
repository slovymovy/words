                    {
                        "translation_id": "0f339bac-2bb2-4d4b-b4bf-640187ff153a",
                        "source_entry_id": "c64db197-c026-3ae3-81fe-c1b745758609",
                        "source_sense_id": "48c7c7ec-1663-360f-a2d3-3b320c9b4fdc",
                        "source_sense_description": "zevende muzieknoot in de toonladder",
                        "target_lang_word": "si",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "si",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                        "entry_id": "9432e432-e887-3f1c-b72d-a99f8ffbfa77",
                                        "glosses": [
                                            "Dans le cas où, à condition que, supposé que. Note d’usage : Conjonction qui introduit une condition (suivie d’une conséquence) ou une supposition qui peut être supprimée en utilisant un conditionnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b510f76-3110-4e44-b24d-c25e5a3fc6c8",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Si j’étais riche, je m’achèterais une maison."
                                            },
                                            {
                                                "example_id": "acaac0c7-470c-4ab5-b2bf-c8b4670a840c",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Je vous donnerai tant, si vous faites ce que vous m’avez promis."
                                            },
                                            {
                                                "example_id": "808ca4f6-360e-400d-aa4d-e12ac4537fd2",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Je vous récompenserai, si je suis content de vous."
                                            },
                                            {
                                                "example_id": "55db0a32-9d65-4a51-adda-6451a9c14bd6",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Si vous venez me voir, vous serez bien reçu."
                                            },
                                            {
                                                "example_id": "d71c9e37-f6cc-4888-86cc-cde6f7c027b7",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Il dit que si vous partez, il vous suivra."
                                            },
                                            {
                                                "example_id": "080d294d-34fc-4c3a-a538-ff32b31e4fb0",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Si les choses en sont là, on ne peut plus y porter remède."
                                            },
                                            {
                                                "example_id": "9a29205d-2d25-40f0-9aee-c861f0d6ef2b",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Il viendra s'il peut, s’il fait beau."
                                            },
                                            {
                                                "example_id": "93d33c31-304e-4115-903d-f7e4b9d0aa82",
                                                "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                                                "text": "Ils auront tort, s'ils se fâchent de cela."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2deb406f-b6be-3611-b7bd-96744d30d472",
                                        "entry_id": "9432e432-e887-3f1c-b72d-a99f8ffbfa77",
                                        "glosses": [
                                            "Dans le cas où, à condition que, supposé que. Note d’usage : Conjonction qui introduit une condition (suivie d’une conséquence) ou une supposition qui peut être supprimée en utilisant un conditionnel.",
                                            "Pour introduire plusieurs conditions, au lieu de répéter si, on peut se servir de que, généralement suivi du mode subjonctif (mais le mode indicatif est possible)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d982b48-2748-4fdf-8164-181f98ee2156",
                                                "sense_id": "2deb406f-b6be-3611-b7bd-96744d30d472",
                                                "text": "S’il fait froid et s’il pleut, nous risquons de tomber malades."
                                            },
                                            {
                                                "example_id": "303e3128-1d0e-48f8-8a9b-6b235a83bf11",
                                                "sense_id": "2deb406f-b6be-3611-b7bd-96744d30d472",
                                                "text": "S’il fait froid et qu’il pleut, nous risquons de tomber malades."
                                            },
                                            {
                                                "example_id": "5add1471-8234-4756-bb9b-22791b3dfdfa",
                                                "sense_id": "2deb406f-b6be-3611-b7bd-96744d30d472",
                                                "text": "S’il fait froid et qu’il pleuve, nous risquons de tomber malades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e089b8-ebba-3ec8-9b67-f543ba0a26e2",
                                        "entry_id": "9432e432-e887-3f1c-b72d-a99f8ffbfa77",
                                        "glosses": [
                                            "Dans le cas où, à condition que, supposé que. Note d’usage : Conjonction qui introduit une condition (suivie d’une conséquence) ou une supposition qui peut être supprimée en utilisant un conditionnel.",
                                            "Elliptiquement,"
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ff99d7-37a3-4acd-bbbe-33dad1b87a2f",
                                                "sense_id": "c2e089b8-ebba-3ec8-9b67-f543ba0a26e2",
                                                "text": "Il parle comme s'il était le maître, Comme il parlerait s'il était le maître."
                                            },
                                            {
                                                "example_id": "f66f3865-05d4-4d3e-a9ae-8ab59bc4d207",
                                                "sense_id": "c2e089b8-ebba-3ec8-9b67-f543ba0a26e2",
                                                "text": "Il est plus content que si on l’avait couvert d’or, Qu’il ne le serait si on l’avait couvert d’or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d8f359-fe5c-3f4d-8b12-b7548191f631",
                                        "entry_id": "9432e432-e887-3f1c-b72d-a99f8ffbfa77",
                                        "glosses": [
                                            "S’emploie encore elliptiquement pour exprimer un souhait, un regret."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b81770-7c81-46f2-87b2-ff557d8a02a4",
                                                "sense_id": "85d8f359-fe5c-3f4d-8b12-b7548191f631",
                                                "text": "Si seulement il était venu !"
                                            },
                                            {
                                                "example_id": "2ea61380-923d-443f-a726-7e220f98a7c5",
                                                "sense_id": "85d8f359-fe5c-3f4d-8b12-b7548191f631",
                                                "text": "Encore s'il avait témoigné quelque regret de sa conduite !"
                                            },
                                            {
                                                "example_id": "ab62f2d4-93bb-49e1-b5d0-30d1785553ca",
                                                "sense_id": "85d8f359-fe5c-3f4d-8b12-b7548191f631",
                                                "text": "— Si tu ne t’étais pas cogné le genou, dit-il au bout d’un moment, tu aurais eu le temps d’y aller avant que l’obus éclate.\n— Si ! dit Maillat, et si je n’avais pas été en retard pour manger, et si j’y étais allé la première fois ! Si ! si ! si ! Je n’en ai pas fini avec ces \"si !\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd41d53a-9490-3a9d-b4b2-430f600e52eb",
                                        "entry_id": "9432e432-e887-3f1c-b72d-a99f8ffbfa77",
                                        "glosses": [
                                            "Dans diverses phrases où il s’agit, non d’une condition, d’une pure supposition, mais d’une chose certaine, il marque un rapport ou une opposition entre la proposition subordonnée et la proposition principale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072fd479-001b-4f18-a9d8-6a979191333c",
                                                "sense_id": "cd41d53a-9490-3a9d-b4b2-430f600e52eb",
                                                "text": "Si je suis gai, si je suis triste, c’est que j’en ai sujet."
                                            },
                                            {
                                                "example_id": "4c4469b8-eb44-4d36-bfa4-5930fedb8007",
                                                "sense_id": "cd41d53a-9490-3a9d-b4b2-430f600e52eb",
                                                "text": "Si cet homme est pauvre, est-ce une raison pour le mépriser ?"
                                            },
                                            {
                                                "example_id": "c24bfe9d-2f4d-4ee8-bd60-2dfb12bb885e",
                                                "sense_id": "cd41d53a-9490-3a9d-b4b2-430f600e52eb",
                                                "text": "Si l’un est vieux et faible, l’autre est jeune et fort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5285b025-d116-32b4-ba7d-089f92a9812c",
                                        "entry_id": "9432e432-e887-3f1c-b72d-a99f8ffbfa77",
                                        "glosses": [
                                            "Si oui ou non. Note d’usage : Conjonction utilisée pour former une question indirecte après certains verbes comme demander, dire, savoir, ignorer, etc., marquant le doute, l’interrogation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f60f026-480c-430b-a953-1dc57f78941e",
                                                "sense_id": "5285b025-d116-32b4-ba7d-089f92a9812c",
                                                "text": "Vous demandez si je suis satisfait."
                                            },
                                            {
                                                "example_id": "1ac3e8bc-5d32-4b99-9bb9-aa6134bc0d4e",
                                                "sense_id": "5285b025-d116-32b4-ba7d-089f92a9812c",
                                                "text": "Je ne sais pas si je viendrai."
                                            },
                                            {
                                                "example_id": "547ffaa9-ce50-4b79-9d6a-f3db5b314c8c",
                                                "sense_id": "5285b025-d116-32b4-ba7d-089f92a9812c",
                                                "text": "Dites-moi si vous irez là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8660e372-8d74-30e2-a30c-10316c15baaf",
                                        "entry_id": "9432e432-e887-3f1c-b72d-a99f8ffbfa77",
                                        "glosses": [
                                            "Si oui ou non. Note d’usage : Conjonction utilisée pour former une question indirecte après certains verbes comme demander, dire, savoir, ignorer, etc., marquant le doute, l’interrogation.",
                                            "Elliptiquement,"
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39e727c8-eea5-43be-8c3f-bf738fb4270e",
                                                "sense_id": "8660e372-8d74-30e2-a30c-10316c15baaf",
                                                "text": "Est-ce que vous viendrez, ou si c’est lui ?"
                                            },
                                            {
                                                "example_id": "59cf4cd1-fb15-4975-b26d-63a774106b40",
                                                "sense_id": "8660e372-8d74-30e2-a30c-10316c15baaf",
                                                "text": "— Ça se boit-il ? Ou bien si ça se bâfre ?"
                                            },
                                            {
                                                "example_id": "c3d5461e-56d2-4937-a26f-5f578d82007d",
                                                "sense_id": "8660e372-8d74-30e2-a30c-10316c15baaf",
                                                "text": "— Est-ce que tu préfères que je te fasse manger avant de partir, ou si tu aimes mieux que je te prépare tout pour que tu manges à midi ?"
                                            },
                                            {
                                                "example_id": "9c92e835-0a69-4f9d-bb11-f833936da6ad",
                                                "sense_id": "8660e372-8d74-30e2-a30c-10316c15baaf",
                                                "text": "Le regrettez-vous ? Si je le regrette !"
                                            },
                                            {
                                                "example_id": "8a61ec56-7309-4c55-b811-e0c771278923",
                                                "sense_id": "8660e372-8d74-30e2-a30c-10316c15baaf",
                                                "text": "Vous savez si je vous aime, Vous savez combien je vous aime."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "si",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae1c1b45-a201-3b1f-81fd-520a577f5512",
                                        "entry_id": "921cc6fa-708d-39b0-8d3e-66ee197babbf",
                                        "glosses": [
                                            "Au contraire. — Note d’usage : Dans ce sens il est utilisé pour infirmer une prédication négative ou interro-négative"
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf35dabb-6e30-4834-9e7e-f27178a16ff1",
                                                "sense_id": "ae1c1b45-a201-3b1f-81fd-520a577f5512",
                                                "text": "La beauté n’est pas un critère, mais le caractère unique d’un appareil, si."
                                            },
                                            {
                                                "example_id": "8a69fa15-76dd-4eca-a73d-d428ee806645",
                                                "sense_id": "ae1c1b45-a201-3b1f-81fd-520a577f5512",
                                                "text": "Vous n’allez pas voir ce spectacle ? — Si, nous y allons."
                                            },
                                            {
                                                "example_id": "6e1c2769-699d-4459-b55d-b83ebd44e6c5",
                                                "sense_id": "ae1c1b45-a201-3b1f-81fd-520a577f5512",
                                                "text": "Ce spectacle n’est pas agréable. — Si ! (sous-entendu « oui, il l’est »)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                                        "entry_id": "921cc6fa-708d-39b0-8d3e-66ee197babbf",
                                        "glosses": [
                                            "Tellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc173f6-c714-4999-9df2-002c67ad55ce",
                                                "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                                                "text": "Mais le passage était si étroit, et le vertugadin de la reine de Navarre si large, que sa robe de soie effleura l’habit du jeune homme, […]."
                                            },
                                            {
                                                "example_id": "ab7f7305-8062-406f-9780-82d02ef7ad82",
                                                "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                                                "text": "Nous atteignons bientôt la région des nuages, et la température tombe si bas, que le froid nous mord horriblement les mains et les pieds."
                                            },
                                            {
                                                "example_id": "0727fd4f-2012-40b1-abc6-174d5e985398",
                                                "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                                                "text": "Seulement, remarquez bien ceci, l’Académie, même à cette époque où elle était si franchement réformiste, ne devançait pas l’usage ; elle le suivait."
                                            },
                                            {
                                                "example_id": "50c231c6-6d34-4fc8-8044-1461bf86d015",
                                                "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                                                "text": "Pendant la longue durée de son administration il avait amassé une fortune considérable, si considérable, en effet, qu’un jour le gouvernement chérifien jugea le moment venu de s’en emparer. ."
                                            },
                                            {
                                                "example_id": "e1676826-3352-43d1-bc98-94c9855bd703",
                                                "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                                                "text": "Il poussa la porte si fort que le fer à cheval suspendu au linteau de chêne tinta faiblement."
                                            },
                                            {
                                                "example_id": "5ff7a645-6519-4ca3-ae06-28295d1f5e06",
                                                "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                                                "text": "Pour intercepter le gaz carbonique, puis relarguer l’oxygène si nécessaire à nos poumons, les plantes sont constellées de petits trous par lesquels elles transpirent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e078cc22-7038-3940-8d64-8a3e33e9459c",
                                        "entry_id": "921cc6fa-708d-39b0-8d3e-66ee197babbf",
                                        "glosses": [
                                            "Aussi."
                                        ],
                                        "tags": [
                                            "Avec une négation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb73d7f-1965-44a2-823e-d4f55a215f35",
                                                "sense_id": "e078cc22-7038-3940-8d64-8a3e33e9459c",
                                                "text": "Je ne suis pas si grand que lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bb51d3a-133d-3ff4-b012-b1886f85ea12",
                                        "entry_id": "921cc6fa-708d-39b0-8d3e-66ee197babbf",
                                        "glosses": [
                                            "N’est-ce pas ?"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d994f73-1d5e-46fb-921a-853694705df0",
                                                "sense_id": "3bb51d3a-133d-3ff4-b012-b1886f85ea12",
                                                "text": "Elle n’est pas méchante, si ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "162e67a7-9a44-30ac-935b-caddc4c45ab1",
                                        "entry_id": "921cc6fa-708d-39b0-8d3e-66ee197babbf",
                                        "glosses": [
                                            "À quel point, combien."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94892f7-d54b-43dc-aa82-b7e198997c78",
                                                "sense_id": "162e67a7-9a44-30ac-935b-caddc4c45ab1",
                                                "text": "— Ah dis donc ! Si elle est jolie, cette môme ! Ah ma mère ! Si elle est jolie !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "si",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fbfcd8e-515f-3d11-b32e-fda3509086f0",
                                        "entry_id": "411bd052-b74a-363a-be8c-9ce230ad3357",
                                        "glosses": [
                                            "Septième note de la gamme de do."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63da530e-109c-48ed-bac7-94a7a006e07a",
                                                "sense_id": "1fbfcd8e-515f-3d11-b32e-fda3509086f0",
                                                "text": "La messe en si mineur de Jean-Sébastien Bach."
                                            },
                                            {
                                                "example_id": "e97289db-8791-4d1b-b1e8-27d1bca41f0a",
