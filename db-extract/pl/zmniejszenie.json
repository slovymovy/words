                        "glosses": [
                            "утоление, сбавка, снижение, сокращение, уменьшение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda42731-670f-491d-b1d6-8d257025f8be",
                                "sense_id": "043b77a7-a45d-3654-90ef-dd2622c60456",
                                "text": "Widzę tylko nieznaczne zmniejszenie ich kolosalnych dochodów, co zresztą mnie nie obchodzi.",
                                "translation": "Она только несколько снизит их колоссальные прибыли, что меня, впрочем, нисколько не трогает."
                            }
                        ]
                    },
                    {
                        "sense_id": "62d60d53-06ac-3e03-aff4-e1e7fdf53041",
                        "entry_id": "f1f24e12-a3e0-305c-aced-aad996590a7b",
                        "glosses": [
                            "(~ się) уменьшение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7f8b28-e52e-405c-849e-f26618e5728c",
                                "sense_id": "62d60d53-06ac-3e03-aff4-e1e7fdf53041",
                                "text": "Te strzały nie wywarły zbyt wielkiego wpływu na zmniejszenie się fauny tamtych okolic.",
                                "translation": "Эти выстрелы не оказали сколько-нибудь значительного влнияия на уменьшение окрестной фауны."
                            }
                        ]
                    }
