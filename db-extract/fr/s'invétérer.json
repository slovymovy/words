                ],
                "senses": [
                    {
                        "sense_id": "b148abc7-c393-391d-8b76-a03d98770c2d",
                        "entry_id": "a9834628-b34d-3c5a-b926-d28e79927e3a",
                        "glosses": [
                            "Persister en empirant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300ab19a-83ec-41e7-8e8b-60cb8b5c48c8",
                                "sense_id": "b148abc7-c393-391d-8b76-a03d98770c2d",
                                "text": "Cette passion dont on n'est presque plus le maître, depuis qu'elle s'est invétérée et comme changée dans une seconde nature."
                            },
                            {
                                "example_id": "9097eb3b-69f7-4026-8db7-cb11ef728473",
                                "sense_id": "b148abc7-c393-391d-8b76-a03d98770c2d",
                                "text": "Songes-y bien, cependant, révérend père, dit Montfichet, cette flétrissure s’est invétérée par le temps et l’habitude. Que ta réforme soit prudente comme elle est sage et juste."
                            },
                            {
                                "example_id": "0347086f-225d-42d1-96d2-f4bee77f6bcf",
                                "sense_id": "b148abc7-c393-391d-8b76-a03d98770c2d",
                                "text": "Les instants s’invétèrent si l’on ne prend garde à chaque instant de rénover l’instant."
                            }
                        ]
                    }
                ],
