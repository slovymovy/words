                ],
                "senses": [
                    {
                        "sense_id": "88ed101e-9f35-394f-87c5-2ef69e51a3bd",
                        "entry_id": "98bc46e6-7273-3cda-808a-528ada783f25",
                        "glosses": [
                            "Verfahren, um etwas ganzheitlich und systematisch zu untersuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db60065c-350b-4410-8596-ce67d3d5101d",
                                "sense_id": "88ed101e-9f35-394f-87c5-2ef69e51a3bd",
                                "text": "„Bertin und ihre Kollegen nutzten spektroskopische und mikroskopische Analysemethoden, um die verwendeten Materialien zu identifizieren, und untersuchten mithilfe der Radiokarbondatierung, wie alt diese steinzeitlichen Waffen sind.“"
                            },
                            {
                                "example_id": "c7ba024c-a04a-42eb-a798-b0c3cbac6e26",
                                "sense_id": "88ed101e-9f35-394f-87c5-2ef69e51a3bd",
                                "text": "„Dem Stoff habe man erst durch in jüngster Zeit entwickelte Analysemethoden auf die Spur kommen können.“"
                            },
                            {
                                "example_id": "e1831d20-2ed6-42b2-9eed-ac75f16499a1",
                                "sense_id": "88ed101e-9f35-394f-87c5-2ef69e51a3bd",
                                "text": "„Sechs Jahre später kennt die Kriminaltechnik bessere Analysemethoden: Heute kann man feststellen, welche spezifischen chemischen Bestandteile so eine Schmauchspur enthält, von welchem Zündsatz und Patronenfabrikat sie stammt.“"
                            },
                            {
                                "example_id": "009dbc5a-cfa0-4264-8814-4699577a5f4b",
                                "sense_id": "88ed101e-9f35-394f-87c5-2ef69e51a3bd",
                                "text": "„So konnten die verschiedenen Blutspuren (von Opfer und Täter) an der Schere nicht noch einmal neusten Analysemethoden unterzogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
