{
    "word_family": [
        "renouveau",
        "renouvelable",
        "renouvellement",
        "nouveau",
        "nouveauté"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2afa2b77-3e6e-39d7-b6e3-bcc2307b1aa0",
                    "sense_definition": "Prolonger la validité d'un document, d'un contrat ou d'un accord pour une nouvelle période.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prolongation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de <w>renouveler</w> votre passeport avant de partir en vacances."
                        },
                        {
                            "text": "Elle doit absolument <w>renouveler</w> son abonnement de train ce matin."
                        }
                    ],
                    "common_phrases": [
                        "renouveler son abonnement",
                        "renouveler un passeport",
                        "renouveler un contrat"
                    ]
                },
                {
                    "sense_id": "20a87a92-c97a-3da0-b2d1-3494a8c95fc6",
                    "sense_definition": "Remplacer des éléments anciens ou usés par des éléments neufs de même nature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "remplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut ouvrir les fenêtres pour <w>renouveler</w> l'air de la chambre."
                        },
                        {
                            "text": "Le musée a décidé de <w>renouveler</w> une partie de sa collection permanente."
                        }
                    ],
                    "common_phrases": [
                        "renouveler l'air",
                        "renouveler le mobilier",
                        "renouveler sa garde-robe"
                    ]
                },
                {
                    "sense_id": "dd5fba87-3e00-3525-9a23-a399b7a5d15d",
                    "sense_definition": "Faire de nouveau une action déjà accomplie ; répéter ou réitérer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat compte <w>renouveler</w> sa demande auprès du directeur."
                        },
                        {
                            "text": "Après ce premier succès, le groupe va <w>renouveler</w> l'expérience l'an prochain."
                        }
                    ],
                    "synonyms": [
                        "recommencer"
                    ],
                    "common_phrases": [
                        "renouveler une demande",
                        "renouveler un exploit",
                        "renouveler ses vœux"
                    ]
                },
                {
                    "sense_id": "9fc1cf11-c27c-3b06-b7c2-dcfcd102199b",
                    "sense_definition": "Modifier ses manières, son style ou ses idées pour éviter la routine et rester créatif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artiste peintre parvient à se <w>renouveler</w> à chaque exposition."
                        },
                        {
                            "text": "Une grande entreprise doit toujours se <w>renouveler</w> pour séduire les clients."
                        }
                    ],
                    "synonyms": [
                        "se réinventer"
                    ],
                    "common_phrases": [
                        "se renouveler"
                    ]
                },
                {
                    "sense_id": "927089b5-1a1e-3400-9fdc-20d0833b7d8e",
                    "sense_definition": "Réveiller ou faire renaître avec intensité une émotion, une sensation ou un souvenir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ravivement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parler de cet accident risquait seulement de <w>renouveler</w> sa douleur."
                        },
                        {
                            "text": "Cette bonne nouvelle a permis de <w>renouveler</w> leur espoir en l'avenir."
                        }
                    ],
                    "synonyms": [
                        "ranimer"
                    ],
                    "common_phrases": [
                        "renouveler la douleur"
                    ]
                }
            ]
        }
    ]
}