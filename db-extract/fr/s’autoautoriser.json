                        "examples": [
                            {
                                "example_id": "2a0adcb3-aa62-4f23-b0f5-52d102cb826b",
                                "sense_id": "b3f1213c-e7d3-39c8-9f8c-08a4bee093fe",
                                "text": "Avec ce genre d'arguments, on peut s'autoautoriser tout et n'importe quoi."
                            },
                            {
                                "example_id": "e9dd59a6-faf7-46fe-a227-d415389b2e9c",
                                "sense_id": "b3f1213c-e7d3-39c8-9f8c-08a4bee093fe",
                                "text": "Le soir de mon anniversaire on est allées manger en ville, c'est plutôt cool de s'autoautoriser à rentrer tard aha."
                            },
                            {
                                "example_id": "76c89eb6-25d1-4024-9cc9-30ec3ae49d7d",
                                "sense_id": "b3f1213c-e7d3-39c8-9f8c-08a4bee093fe",
                                "text": "Le patron, lui peut amener ses enfants, il ne peut pas s'autolicencier et il peut s'autoautoriser."
                            }
                        ]
