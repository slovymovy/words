                "senses": [
                    {
                        "sense_id": "e6a21485-b838-30da-9916-d78cf84d71a3",
                        "entry_id": "8b5a1370-9edc-3706-8611-cd67d59b0ee7",
                        "glosses": [
                            "Hierarchie innerhalb einer Befehlskette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32668051-8374-45db-a642-59b89f51a155",
                                "sense_id": "e6a21485-b838-30da-9916-d78cf84d71a3",
                                "text": "„Hier sah Garrison eine Chance, die offizielle Genehmigung zu erhalten, Delta-Spezialisten auf Stoßtruppenunternehmen zu entsenden (was sie inoffiziell schon seit etlichen Monaten getan hatten, wobei man auf allen Stufen der Befehlshierarchie beide Augen zudrückte).“"
                            },
                            {
                                "example_id": "337c492d-c736-4d4b-8b00-59f65fb1a451",
                                "sense_id": "e6a21485-b838-30da-9916-d78cf84d71a3",
                                "text": "„Mein Glück war, dass die Polizei ähnlich strukturiert ist wie das Militär und eine klare Befehlshierarchie hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
