                        "sense_id": "abf1cc4e-6d5a-3d37-9388-0d257c576c11",
                        "entry_id": "c69025b7-0a2d-3885-91cd-2c1cd94cd842",
                        "glosses": [
                            "Überbewertung psychologischer Positionen, die alles Denken, das nach den Gesetzen der psychischen Ursachen normal verläuft, als richtig bewerteten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4337e6-b2ed-43aa-8b2e-d16f19456119",
                                "sense_id": "abf1cc4e-6d5a-3d37-9388-0d257c576c11",
                                "text": "„Husserl hat in seinen „Logischen Untersuchungen“ den Psychologismus widerlegt.“"
                            },
                            {
                                "example_id": "e1e68b52-ccb8-4c12-9270-deb071ba4d7a",
                                "sense_id": "abf1cc4e-6d5a-3d37-9388-0d257c576c11",
                                "text": "„Diese Stelle verdeutlicht sehr schön die äußerste Allgemeinheit des Willensbegriffs bei Schopenhauer und zeigt, wie wichtig es ist, sich frei von allem Psychologismus mit ihm auseinanderzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
