    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7178a1f7-8535-31cf-82e0-a492e5e8bf2c",
                    "sense_definition": "Continuer d'exister, durer dans le temps sans disparaître.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si les symptômes <w>persistent</w> après quelques jours, vous devriez consulter un médecin."
                        },
                        {
                            "text": "Un épais brouillard <w>persiste</w> sur toute la région depuis le début de la matinée."
                        }
                    ],
                    "synonyms": [
                        "continuer",
                        "durer",
                        "se maintenir",
                        "subsister"
                    ],
                    "antonyms": [
                        "cesser",
                        "disparaître"
                    ],
                    "common_phrases": [
                        "le doute persiste",
                        "les symptômes persistent"
                    ]
                },
                {
                    "sense_id": "82ca6376-9978-3d6a-b42d-867b20dff810",
                    "sense_definition": "Demeurer ferme dans une opinion, une décision ou une attitude malgré les obstacles ou les conseils contraires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les nombreuses mises en garde, il <w>persiste</w> à croire en la réussite de son projet."
                        },
                        {
                            "text": "Elle <w>persiste</w> dans sa décision de quitter l'entreprise à la fin du mois."
                        }
                    ],
                    "synonyms": [
                        "persévérer",
                        "s'entêter",
                        "s'obstiner"
                    ],
                    "antonyms": [
                        "abandonner",
                        "céder",
                        "renoncer"
                    ],
                    "common_phrases": [
                        "persister dans son erreur",
                        "persister et signer"
                    ]
                },
                {
                    "sense_id": "cc178bd0-a080-3e27-994d-bea635952e73",
                    "sense_definition": "Enregistrer de manière durable les données d'un objet informatique dans une base de données ou un support de stockage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette méthode permet de <w>persister</w> l'état des utilisateurs directement dans la base de données relationnelle."
                        },
                        {
                            "text": "L'application doit absolument <w>persister</w> ces informations critiques avant la fermeture de la session."
                        }
                    ],
                    "synonyms": [
                        "enregistrer",
                        "sauvegarder"
                    ],
                    "common_phrases": [
                        "persister les données",
                        "persister un objet"
                    ]
                }
            ]
        }
    ]
