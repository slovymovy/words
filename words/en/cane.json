{
    "word_family": [
        "caning",
        "canework"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c790c497-b71a-3471-b80f-7475d0ea7ca1",
                    "sense_definition": "The slender, flexible main stem of a plant such as bamboo or grass.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener used a thin <w>cane</w> to support the growing tomato plant.",
                            "target_lang_translations": {
                                "ru": "Садовник использовал тонкий <w>тростник</w> для поддержки растущего томата."
                            }
                        },
                        {
                            "text": "Bamboo is a type of <w>cane</w> that grows very quickly in tropical climates.",
                            "target_lang_translations": {
                                "ru": "Бамбук — это вид <w>тростника</w>, который очень быстро растет в тропическом климате."
                            }
                        }
                    ],
                    "synonyms": [
                        "stem",
                        "stalk",
                        "reed"
                    ],
                    "common_phrases": [
                        "bamboo cane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий, гибкий стебель растения, например бамбука или тростника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тростник",
                                "target_lang_sense_clarification": "растение с полым стеблем"
                            },
                            {
                                "target_lang_word": "стебель",
                                "target_lang_sense_clarification": "общий термин для части растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e10da0a-0e72-3c90-8ee9-802a5f580f31",
                    "sense_definition": "A short staff used for support while walking.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "walking_aid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After his surgery, the elderly man needed a <w>cane</w> to walk safely.",
                            "target_lang_translations": {
                                "ru": "После операции пожилому человеку понадобилась <w>трость</w>, чтобы безопасно ходить."
                            }
                        },
                        {
                            "text": "He leaned heavily on his <w>cane</w> while climbing the stairs.",
                            "target_lang_translations": {
                                "ru": "Он тяжело опирался на свою <w>трость</w>, поднимаясь по лестнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "walking stick"
                    ],
                    "common_phrases": [
                        "walking cane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая палка, используемая для опоры при ходьбе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трость",
                                "target_lang_sense_clarification": "палка для опоры при ходьбе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4683440d-f5cf-3575-8130-2ec73724a6d8",
                    "sense_definition": "A long rod used by vision-impaired persons for guidance and obstacle detection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking_aid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woman used a white <w>cane</w> to navigate the busy city sidewalk.",
                            "target_lang_translations": {
                                "ru": "Женщина использовала белую <w>трость</w>, чтобы ориентироваться на оживленном городском тротуаре."
                            }
                        },
                        {
                            "text": "He tapped his <w>cane</w> on the ground to find the edge of the curb.",
                            "target_lang_translations": {
                                "ru": "Он постучал своей <w>тростью</w> по земле, чтобы найти край бордюра."
                            }
                        }
                    ],
                    "synonyms": [
                        "white cane",
                        "blind man's cane"
                    ],
                    "common_phrases": [
                        "white cane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная палка, используемая незрячими людьми для ориентации и обнаружения препятствий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "белая трость",
                                "target_lang_sense_clarification": "специальная трость для незрячих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71970351-403f-3af9-bc49-46ce2e75d797",
                    "sense_definition": "Corporal punishment by beating with a stick.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some older school systems, students were punished with the <w>cane</w> for misbehavior.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых школьных системах учеников наказывали <w>поркой</w> за плохое поведение."
                            }
                        },
                        {
                            "text": "The strict teacher threatened the class with the <w>cane</w> if they did not remain silent.",
                            "target_lang_translations": {
                                "ru": "Строгий учитель пригрозил классу <w>поркой</w>, если они не будут соблюдать тишину."
                            }
                        }
                    ],
                    "synonyms": [
                        "a caning",
                        "whipping"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical or outdated form of school discipline."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Телесное наказание путем ударов палкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порка",
                                "target_lang_sense_clarification": "процесс телесного наказания"
                            },
                            {
                                "target_lang_word": "удары палкой",
                                "target_lang_sense_clarification": "конкретный вид наказания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9832fb16-27ec-3366-bc13-7f2ca910ffc9",
                    "sense_definition": "To strike or beat someone with a cane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was <w>caned</w> as part of his judicial sentence.",
                            "target_lang_translations": {
                                "ru": "Заключенного <w>выпороли</w> в рамках судебного приговора."
                            }
                        },
                        {
                            "text": "It was common in the past for teachers to <w>cane</w> students who broke the rules.",
                            "target_lang_translations": {
                                "ru": "В прошлом учителя часто <w>пороли</w> учеников, которые нарушали правила."
                            }
                        }
                    ],
                    "synonyms": [
                        "whipping"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical or outdated form of corporal punishment."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить или наказывать кого-либо палкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пороть",
                                "target_lang_sense_clarification": "наказывать ударами"
                            },
                            {
                                "target_lang_word": "бить палкой",
                                "target_lang_sense_clarification": "физическое действие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4534eea7-d14b-3639-be8f-87249ac864c2",
                    "sense_definition": "An abbreviation for Canadian English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Linguists often study the unique vocabulary found in <w>CanE</w>.",
                            "target_lang_translations": {
                                "ru": "Лингвисты часто изучают уникальную лексику, встречающуюся в <w>канадском английском</w>."
                            }
                        },
                        {
                            "text": "The research paper focuses on the historical development of <w>CanE</w>.",
                            "target_lang_translations": {
                                "ru": "Исследовательская работа посвящена историческому развитию <w>канадского английского</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "CE"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для канадского варианта английского языка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канадский английский",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}