                                    {
                                        "sense_id": "c7b96d6f-e774-38ca-bebf-e19af0429f35",
                                        "entry_id": "0de77db9-c3af-3ff3-b79b-d427909fbdd3",
                                        "glosses": [
                                            "In a patient manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9472ccc2-5c68-42f9-98af-26c798c5e0ce",
                                                "sense_id": "c7b96d6f-e774-38ca-bebf-e19af0429f35",
                                                "text": "\"I feel that there is reason lurking in you somewhere, so we will patiently grope round for it.\""
                                            },
                                            {
                                                "example_id": "ee5ab59f-bbfa-4a69-97de-81eab54428d7",
                                                "sense_id": "c7b96d6f-e774-38ca-bebf-e19af0429f35",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec705eda-4f90-4cc3-adca-8771c0eaf40a",
