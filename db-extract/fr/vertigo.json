                                "sense_id": "206536d4-0d5d-3c4e-a518-f5422afc5b05",
                                "text": "Quand son vertigo lui prend."
                            },
                            {
                                "example_id": "3b8d1664-ab50-425f-8ef7-d8ffd0417ca8",
                                "sense_id": "206536d4-0d5d-3c4e-a518-f5422afc5b05",
                                "text": "Elle a de singuliers vertigos."
