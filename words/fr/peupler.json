                    "sense_definition": "Occuper l'esprit, l'imaginaire ou la mémoire de manière vive et continue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
