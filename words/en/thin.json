                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence against the suspect was <w>thin</w> and unlikely to lead to a conviction.",
                            "target_lang_translations": {
                                "ru": "Улики против подозреваемого были <w>слабыми</w> и вряд ли привели бы к обвинительному приговору.",
                                "nl": "Het bewijs tegen de verdachte was <w>dun</w> en zou waarschijnlijk niet tot een veroordeling leiden."
                            }
                        },
                        {
                            "text": "He offered a <w>thin</w> excuse for being late to the important meeting.",
                            "target_lang_translations": {
                                "ru": "Он привел <w>неубедительное</w> оправдание своего опоздания на важную встречу.",
                                "nl": "Hij kwam met een <w>zwak</w> excuus voor het te laat komen op de belangrijke vergadering."
                            }
