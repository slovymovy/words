                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a man named Mr. <w>Tulip</w>.",
                            "target_lang_translations": {
                                "ru": "В исторических записях упоминается человек по фамилии <w>Тюлип</w>.",
                                "nl": "De historische documenten vermelden een man genaamd meneer <w>Tulip</w>."
                            }
                        },
                        {
                            "text": "The family name <w>Tulip</w> is quite rare in this region.",
                            "target_lang_translations": {
                                "ru": "Фамилия <w>Тюлип</w> довольно редкая в этом регионе.",
                                "nl": "De familienaam <w>Tulip</w> is vrij zeldzaam in deze regio."
                            }
                        }
                    ],
                    "traits": [
                        {
