                        {
                            "text": "Słuchanie tych samych opowieści po raz kolejny stało się niezwykle <w>namolne</w>.",
                            "target_lang_translations": {
                                "ru": "Слушать одни и те же рассказы в очередной раз стало невыносимо <w>утомительно</w>."
                            }
                        }
                    ],
                    "synonyms": [
