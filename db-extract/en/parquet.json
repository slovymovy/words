                                            {
                                                "example_id": "92628010-c065-4807-9fa0-681df4fb5053",
                                                "sense_id": "9080ae56-c0bb-3dea-847f-087544698289",
                                                "text": "Im neuen Haus möchten wir im Wohnbereich Parkett verlegen."
                                            },
                                            {
                                                "example_id": "e85277d8-828c-48ae-b8af-ac22671765ca",
                                                "sense_id": "9080ae56-c0bb-3dea-847f-087544698289",
                                                "text": "„Meine Mutter hat sogar ihre schweren Teppiche gegen Parkett ausgetauscht.“"
                                            },
                                            {
                                                "example_id": "779de7a9-4c71-490c-af98-9e740c688712",
                                                "sense_id": "9080ae56-c0bb-3dea-847f-087544698289",
                                                "text": "„Die Fußspuren der Krankenwagenbesatzung waren auf dem Parkett noch immer zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40c6357e-bb52-3428-bbaa-bff20aa4345d",
                                        "entry_id": "b4f883c8-c1d8-3868-859c-068ab9fe41ba",
                                        "glosses": [
                                            "Fläche zum Tanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39d022f-43e2-4d2e-90ab-cdba85ef675e",
                                                "sense_id": "40c6357e-bb52-3428-bbaa-bff20aa4345d",
                                                "text": "Sieh an, was Opa und Oma noch für eine flotte Sohle aufs Parkett legen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bfbcc89e-8843-3c74-a9f3-8322fca77a84",
                                        "entry_id": "b4f883c8-c1d8-3868-859c-068ab9fe41ba",
                                        "glosses": [
                                            "vorderer, ebener Bereich des Zuschauerraumes im Theater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "139ecece-8f6a-46c8-9b73-f369aea38b96",
                                                "sense_id": "bfbcc89e-8843-3c74-a9f3-8322fca77a84",
                                                "text": "Sie haben Opernkarten geschenkt bekommen und werden heute zum ersten Mal im Parkett sitzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "61c2a78d-6074-32a0-882a-75bddbc63fcf",
                                        "entry_id": "b4f883c8-c1d8-3868-859c-068ab9fe41ba",
                                        "glosses": [
                                            "Raum, Treffpunkt für den Börsenhandel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf83710-885f-4e14-8bd8-ff81799b356f",
                                                "sense_id": "61c2a78d-6074-32a0-882a-75bddbc63fcf",
                                                "text": "Auf dem Parkett ging es heute ruhig zu."
                                            }
                                        ],
