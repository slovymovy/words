                "senses": [
                    {
                        "sense_id": "a3f43b10-4ad6-360b-ab4d-8c7c0a64f98e",
                        "entry_id": "4a36d2fa-017f-36fe-b70e-450f98770d30",
                        "glosses": [
                            "bei einer Mehrlingsschwangerschaft die Tötung eines oder mehrerer ungeborener Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef03dc4a-f715-4be6-a92e-b36fea19c708",
                                "sense_id": "a3f43b10-4ad6-360b-ab4d-8c7c0a64f98e",
                                "text": "„Insbesondere der Fetozid zur Mehrlingsreduktion ist ethisch höchst umstritten. Er wird als dunkelstes Kapitel der Reproduktionsmedizin bezeichnet.“"
                            },
                            {
                                "example_id": "ef01af95-d1c5-4a44-bbd9-d54e5316e3b9",
                                "sense_id": "a3f43b10-4ad6-360b-ab4d-8c7c0a64f98e",
                                "text": "„Geistliche und Politiker kritisieren vielfachen Tod gesunder Kinder bei Mehrlingsschwangerschaften in Deutschland – Bei der sogenannten Mehrlingsreduktion wird Kindern im Mutterleib Kaliumchlorid ins Herz gespritzt, sie sterben kurz darauf.“"
                            },
                            {
                                "example_id": "6bc4db68-fefa-43ae-8ed8-cedcd0cf1cbb",
                                "sense_id": "a3f43b10-4ad6-360b-ab4d-8c7c0a64f98e",
                                "text": "„Mehrlingsreduktion nennen die Reproduktionsmediziner das Verfahren, das sie Eltern nahe legen, um unliebsame Folgen ihrer Behandlungskunst zu vermeiden. Feige spricht von Fetozid – Tötung von Föten.“"
                            },
                            {
                                "example_id": "3c3608bb-95c4-446e-9318-4a6152be1a95",
                                "sense_id": "a3f43b10-4ad6-360b-ab4d-8c7c0a64f98e",
                                "text": "Nach der In-vitro-Fertilisation erfolgte eine Mehrlingsreduktion durch die Injektion von Kaliumchlorid in das Herz eines der beiden Kinder."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
