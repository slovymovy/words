                            {
                                "target_word": "und so weiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38190147-7c6a-3437-81c3-9aaed69e9ec2",
                                        "entry_id": "9ba7d116-f6b8-3b17-8f58-b59124219446",
                                        "glosses": [
                                            "sich in der angedeuteten Art und Weise, zum Beispiel einer Aufzählung oder einem bekannten Ablauf nach, fortsetzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223ab7cf-b25d-4f60-b9f2-86748ec25e31",
                                                "sense_id": "38190147-7c6a-3437-81c3-9aaed69e9ec2",
                                                "text": "Es sind demnach alle Winkel um den MittelpunctH, AHE, EHB, BHF und so fort, einander gleich, weil ein jeder derselben eine Hälfte ist eines der gleichen Winkel AHB, BHC, und so weiter."
                                            },
                                            {
                                                "example_id": "62462fee-f896-4455-b7f8-868e02ea0d85",
                                                "sense_id": "38190147-7c6a-3437-81c3-9aaed69e9ec2",
                                                "text": "Das hat mich gewaltige Mühe gekostet, immer wieder habe ich die zuständige Dame vom Studentenwerk belabert – sie möge an mich denken, wenn dort jemand auszieht und so weiter."
                                            },
                                            {
                                                "example_id": "2586ab70-e1fa-4079-9b74-1c7382088bbf",
                                                "sense_id": "38190147-7c6a-3437-81c3-9aaed69e9ec2",
                                                "text": "Ich meine, das ist doch ganz normal oder sollte es wenigstens sein, dass Sie da nicht zu dritt, also mit Kleinkind, wie im Karnickelstall und so weiter, nicht wahr."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23f42b0a-0bbf-45bc-82e8-4a802df4f4e5",
                        "source_entry_id": "c91522ea-cab2-312c-b6ff-1ef034a14c51",
                        "source_sense_id": "83746f68-fc32-386f-891c-cc1e9beb764a",
