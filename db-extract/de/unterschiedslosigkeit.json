                "senses": [
                    {
                        "sense_id": "23f832c8-a6b0-3d5f-a750-6103e6813a42",
                        "entry_id": "15237d1a-f503-38b8-9b9f-0436cf24a6ea",
                        "glosses": [
                            "Zustand, in dem sich Dinge oder Personen sehr ähnlich sind, keine Unterschiede aufweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb53388-401b-453d-a858-360e2be71dd2",
                                "sense_id": "23f832c8-a6b0-3d5f-a750-6103e6813a42",
                                "text": "„Ein extremes Phänomen der Unterschiedslosigkeit des Subjekts ist die Klonung, die die endlose menschliche Vermehrung ohne geschlechtliche Fortpflanzung ermöglicht.“"
                            },
                            {
                                "example_id": "03620e25-8fda-41ba-bdb8-9f544bb95131",
                                "sense_id": "23f832c8-a6b0-3d5f-a750-6103e6813a42",
                                "text": "„Das Theorem der Unterschiedslosigkeit der Preise besagt, dass die Waren zum selben Zeitpunkt an verschiedenen Orten zu einheitlichen Preisen gehandelt werden sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
