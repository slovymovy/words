                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c612adf-b3ed-3930-8026-697cd7898722",
                        "entry_id": "9cc6fedb-a3e8-3471-ba32-1c45d234781d",
                        "glosses": [
                            "Étude des outils informatiques et numériques comme instrument d’influence et de persuasion des individus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ddb5bfd-f58f-47b2-a10b-b65f644351a3",
                                "sense_id": "1c612adf-b3ed-3930-8026-697cd7898722",
                                "text": "Certains citent encore les messages des auteurs de sharewares, ceux affichés à chaque lancement afin d’inciter l’usager à payer sa licence. Ils sont, paraît-il, fruit d'une technologie persuasive et donc aptes à être objet de captologie."
                            },
                            {
                                "example_id": "711e825d-c622-4ec7-8d53-1116175e520d",
                                "sense_id": "1c612adf-b3ed-3930-8026-697cd7898722",
                                "text": "Il y a d’ailleurs un modèle pour cela, un modèle basé sur la science de la « captologie » ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbfd1370-6f07-4f28-ba7a-eb2f814b0bb5",
                        "source_entry_id": "9cc6fedb-a3e8-3471-ba32-1c45d234781d",
                        "source_sense_id": "1c612adf-b3ed-3930-8026-697cd7898722",
                        "target_lang_word": "captology",
