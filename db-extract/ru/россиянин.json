                    },
                    {
                        "form_id": "ef31d6a6-8590-4e87-93f8-9847f598a328",
                        "entry_id": "e06cab24-e815-3f14-b64e-5443f25d021a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "россиянка"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddd68861-dc4c-33e7-809f-926932666fca",
                        "entry_id": "e06cab24-e815-3f14-b64e-5443f25d021a",
                        "glosses": [
                            "Einwohner beziehungsweise Staatsbürger Russlands, Russländer; Russe"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ea73da3-bdb2-4be9-855f-71cd5253900e",
                        "source_entry_id": "e06cab24-e815-3f14-b64e-5443f25d021a",
                        "source_sense_id": "ddd68861-dc4c-33e7-809f-926932666fca",
                        "source_sense_description": "Einwohner beziehungsweise Staatsbürger Russlands",
                        "target_lang_word": "Russe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Russe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f98608a-bae6-3295-9645-c2999f6402ea",
                                        "entry_id": "2d7d2efb-300e-38ad-9be1-1e19e9d5bf6e",
                                        "glosses": [
                                            "Staatsbürger Russlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c45c1a-0434-4e85-bd6c-60fb083306bd",
                                                "sense_id": "0f98608a-bae6-3295-9645-c2999f6402ea",
                                                "text": "Viele Russen stammen aus den ehemaligen Sowjetrepubliken."
                                            },
                                            {
                                                "example_id": "fefc00c5-7d3a-4f03-9b91-6e2b7874174b",
                                                "sense_id": "0f98608a-bae6-3295-9645-c2999f6402ea",
                                                "text": "„Zwei Moldauer, zwei Transnistrier und drei Russen leben hier in einer Baracke zusammen, Soldaten dreier Armeen.“"
                                            },
                                            {
                                                "example_id": "0be43bf6-15f6-4745-8f00-31a5fd9b8c75",
                                                "sense_id": "0f98608a-bae6-3295-9645-c2999f6402ea",
                                                "text": "„Als ich neulich in Moskau war, konnte ich mich vor grüßenden Russen kaum retten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04a93b41-be0e-3c5c-993f-64a33dd5d50d",
                                        "entry_id": "2d7d2efb-300e-38ad-9be1-1e19e9d5bf6e",
                                        "glosses": [
                                            "Person russischer Herkunft oder Angehöriger des russischen Kulturkreises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1307e91f-4850-449a-8b6e-033ed23a257d",
                                                "sense_id": "04a93b41-be0e-3c5c-993f-64a33dd5d50d",
                                                "text": "„Die an der Küste des Weißen Meeres lebenden Russen heißen seit je her Pomoren, sie sind die Nachfahren der alten Nowgoroder und besitzen eigene kulturelle Züge in Tracht, Folklore und Aussprache.“"
                                            },
                                            {
                                                "example_id": "f362ef6b-73a1-4ed3-8d64-5feab89e304c",
                                                "sense_id": "04a93b41-be0e-3c5c-993f-64a33dd5d50d",
                                                "text": "„Der Russe fährt ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a252b784-ac9c-3d40-b944-dc56b26c4197",
                                        "entry_id": "2d7d2efb-300e-38ad-9be1-1e19e9d5bf6e",
                                        "glosses": [
                                            "Bürger der Sowjetunion"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c506655-71d2-4c36-b99b-ec37bd43f187",
                                                "sense_id": "a252b784-ac9c-3d40-b944-dc56b26c4197",
                                                "text": "Wir erwarten eine Delegation von Russen aus der Turkmenischen Sozialistischen Sowjetrepublik."
                                            },
                                            {
                                                "example_id": "ab007adb-64d3-4b29-a853-f02a04e07fc1",
                                                "sense_id": "a252b784-ac9c-3d40-b944-dc56b26c4197",
                                                "text": "„Kann ich keine Suppe kochen ohne LCD-Display, und wenn ich meine Socken wasche, brauche ich ein Interface? Woll'n die Russen uns vernichten, oder sind die Amis schuld? Crazy Shoot Out, Space Invaders, Snack Attack und Roach Hotel.“"
                                            },
                                            {
                                                "example_id": "1b5a9ad3-4ee7-460a-8114-161f91e12504",
                                                "sense_id": "a252b784-ac9c-3d40-b944-dc56b26c4197",
                                                "text": "„Und kein Cherubim mit dem bloßen, hauenden Schwert, kein Russe mit seiner Maschinenpistole verwehrt den Zutritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6c12f39e-0dfe-3a8c-a0cf-ae977132114c",
                                        "entry_id": "2d7d2efb-300e-38ad-9be1-1e19e9d5bf6e",
                                        "glosses": [
                                            "Einwohner des Russischen Reiches und dessen Vorläufer bis 1917"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bd3615d-0a96-48ba-9d91-1a14f9944107",
                                                "sense_id": "6c12f39e-0dfe-3a8c-a0cf-ae977132114c",
                                                "text": "Mit dem Verbot des Ausschanks und Verkaufs von Wodka 1914 durch den Zaren blieb den Russen nur noch der Ausweg in die Schwarzbrennerei."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "efa0d047-b4e9-3120-8296-6d90caff804d",
                                        "entry_id": "2d7d2efb-300e-38ad-9be1-1e19e9d5bf6e",
                                        "glosses": [
                                            "ausgenommene, marinierte, kleine Heringe mit Schwanz ohne Kopf"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfe6adc7-5e1e-43a6-8eb7-4e9bae51e19f",
                                                "sense_id": "efa0d047-b4e9-3120-8296-6d90caff804d",
                                                "text": "„Es gab Zeiten, da haben wir unglaublich gern Russen gegessen, Hering.“"
                                            },
                                            {
                                                "example_id": "5271a40e-e389-48e4-80bf-e6325566d885",
