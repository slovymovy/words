                                    {
                                        "sense_id": "c2db404d-caa5-315f-817e-cc5b146b9f9e",
                                        "entry_id": "aa591eff-990c-3425-b8de-99c2db3aaf56",
                                        "glosses": [
                                            "A card printed with various letters or symbols, used in testing vision."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e409e94a-b6cc-3ee8-9b09-7841b8ab6c25",
                                        "entry_id": "aa591eff-990c-3425-b8de-99c2db3aaf56",
                                        "glosses": [
                                            "A test signal, typically broadcast at times when the transmitter is active but no programme is being broadcast (often at startup and closedown)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7624db1e-57d0-4270-957c-fb8fc6bbafd9",
                                                "sense_id": "e409e94a-b6cc-3ee8-9b09-7841b8ab6c25",
                                                "text": "In 1967, the BBC needed a ‘test card’ for its new colour broadcasts, to be put on the screen when programmes were not being transmitted so engineers could adjust the quality of the picture."
                                            }
                                        ]
                                    }
                                ]
                            }
