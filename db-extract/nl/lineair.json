                                "target_senses": [
                                    {
                                        "sense_id": "3426ff7e-5374-35cf-9ba3-36e29c797c2f",
                                        "entry_id": "707ed6aa-14d2-3ea1-a53f-3dc3fda6065b",
                                        "glosses": [
                                            "Qui a rapport aux lignes, qui se fait par des lignes."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a5918e1-bba5-43c9-913a-72cf112d61e5",
                                                "sense_id": "3426ff7e-5374-35cf-9ba3-36e29c797c2f",
                                                "text": "Dessin linéaire, : Représentation des objets par un simple trait."
                                            },
                                            {
                                                "example_id": "6dc08c4d-c90b-4aa7-a9b6-06bad0f3fa5d",
                                                "sense_id": "3426ff7e-5374-35cf-9ba3-36e29c797c2f",
                                                "text": "Mesures linéaires, : Mesures de longueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c86b2899-c4d9-3c3c-b81b-3a42ca1ff74c",
                                        "entry_id": "707ed6aa-14d2-3ea1-a53f-3dc3fda6065b",
                                        "glosses": [
                                            "Caractérise une fonction de type y = ax où a ∈ ℝ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ec128f-222f-46e0-a3ac-ec347e07d8e5",
                                                "sense_id": "c86b2899-c4d9-3c3c-b81b-3a42ca1ff74c",
                                                "text": "Équation linéaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a0a853-26d6-38e1-806d-cda67087c22e",
                                        "entry_id": "707ed6aa-14d2-3ea1-a53f-3dc3fda6065b",
                                        "glosses": [
                                            "Se dit d’une feuille étroite et allongée, à bords parallèles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b825b78-e5b1-4422-ba74-508bbd29d407",
                                                "sense_id": "b5a0a853-26d6-38e1-806d-cda67087c22e",
                                                "text": "Les feuilles de la plupart des graminées sont linéaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5c13128-6fdd-3e9e-a290-2b187a89e4ed",
                                        "entry_id": "707ed6aa-14d2-3ea1-a53f-3dc3fda6065b",
                                        "glosses": [
                                            "Qualifie un phénomène ou un dispositif où l’effet est strictement proportionnel à la cause."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fff7180-57fe-4f95-9342-94b793442618",
                                                "sense_id": "e5c13128-6fdd-3e9e-a290-2b187a89e4ed",
                                                "text": "Un amplificateur non linéaire déforme le son."
                                            },
                                            {
                                                "example_id": "31db8121-b443-47e6-bdce-8df0a7486e5b",
                                                "sense_id": "e5c13128-6fdd-3e9e-a290-2b187a89e4ed",
                                                "text": "Une décharge électrique dans un gaz n’est pas linéaire : dans certaines plages d’intensité, la chute de tension décroît quand l’intensité augmente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20818035-18a4-3c55-ae7e-62fdd033bcc9",
                                        "entry_id": "707ed6aa-14d2-3ea1-a53f-3dc3fda6065b",
                                        "glosses": [
                                            "Qui évolue en ligne droite, sans changement de direction, sans retour en arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51e3ff9-159d-452b-bd38-441a25fd55f3",
                                                "sense_id": "20818035-18a4-3c55-ae7e-62fdd033bcc9",
                                                "text": "Mis au point dans les années 1980, le montage virtuel est non linéaire et permet de placer n’importe quel plan dans n’importe quel ordre sans que le monteur soit obligé de revoir chronologiquement toutes les séquences montées."
                                            },
                                            {
                                                "example_id": "d3440edc-2559-4509-98b2-a3ba35e39167",
                                                "sense_id": "20818035-18a4-3c55-ae7e-62fdd033bcc9",
                                                "text": "Faisant écho à la volonté de l’ensemble des parties prenantes, la feuille de route gouvernementale a affirmé l’objectif pour la France de dépasser le modèle linéaire « produire, consommer, jeter » et d’assurer la transition vers un modèle d’économie circulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d4db83-06cb-3641-af8e-2aa76b69101a",
                                        "entry_id": "707ed6aa-14d2-3ea1-a53f-3dc3fda6065b",
                                        "glosses": [
                                            "Se dit d’une macromolécule ou d’un polymère résultant d’une répétition multiple en séquence linéaire d’unités qui dérivent de molécules de faible masse moléculaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45bfbec9-af53-3815-96da-e34cf3d1ecde",
                                        "entry_id": "707ed6aa-14d2-3ea1-a53f-3dc3fda6065b",
                                        "glosses": [
                                            "Qui s'écrit sur une ou plusieurs lignes d'écriture, horizontales ou plus rarement (mongol, mandchou, …) verticales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9534d84d-8875-4a5c-a43d-8b19e68585a6",
                                                "sense_id": "45bfbec9-af53-3815-96da-e34cf3d1ecde",
                                                "text": "L'écriture linéaire B, c'est du grec archaïque, mais le linéaire A n'a pas encore été déchiffré."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "linéaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d5458f8-a67e-3f55-83ef-5209b50a90ee",
                                        "entry_id": "5f54c8bf-c580-3af8-b940-a2dbc804adb8",
                                        "glosses": [
                                            "Zone en forme de ligne, comme les présentoirs en longueur des magasins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81448004-d2fd-41df-b9f5-7f2091333b11",
                                                "sense_id": "7d5458f8-a67e-3f55-83ef-5209b50a90ee",
                                                "text": "L’accroissement de la longueur des linéaires s'est accompagné d'une plus grande diversité des références: progression de 11% dans les hypers et de 9% dans les supers."
                                            },
                                            {
                                                "example_id": "041c8ee3-8d9f-479f-befd-425013536a43",
                                                "sense_id": "7d5458f8-a67e-3f55-83ef-5209b50a90ee",
                                                "text": "Alors que les espèces animales les plus insignifiantes mettent des milliers, parfois des millions d’années à disparaître, les produits manufacturés sont rayés de la surface du globe en quelques jours, il ne leur est jamais accordé de seconde chance, ils ne peuvent que subir, impuissants, le diktat irresponsable et fasciste des responsables des lignes de produit qui savent naturellement mieux que tout autre ce que veut le consommateur, qui prétendent capter une attente de nouveauté chez le consommateur, qui ne font en réalité que transformer sa vie en une quête épuisante et désespérée, une errance sans fin entre des linéaires éternellement modifiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade43553-3732-39c0-ae0b-37edd1c1a53f",
                                        "entry_id": "5f54c8bf-c580-3af8-b940-a2dbc804adb8",
                                        "glosses": [
                                            "Famille d'anciennes écritures grecques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01a0ca50-7cad-3b6d-a5e3-748ce36afa65",
                                        "entry_id": "5f54c8bf-c580-3af8-b940-a2dbc804adb8",
                                        "glosses": [
                                            "Quantité de fourniture, évaluée en longueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06f8bbc-9ed3-4ee9-a592-137e693e904e",
                                                "sense_id": "01a0ca50-7cad-3b6d-a5e3-748ce36afa65",
                                                "text": "Un linéaire de garde-corps, de clôture."
                                            }
                                        ]
                                    }
                                ]
                            }
