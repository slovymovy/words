{
    "word_family": [
        "growler",
        "growlingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51198ae5-4991-36c7-839a-4fda021c8d4f",
                    "sense_definition": "to utter a deep guttural sound, as an angry animal; to give forth an angry, grumbling sound",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray dog began to <w>growl</w> at me as I walked past the gate.",
                            "target_lang_translations": {
                                "ru": "Бродячая собака начала <w>рычать</w> на меня, когда я проходил мимо ворот."
                            }
                        },
                        {
                            "text": "I could hear the bears <w>growl</w> and fight in the distance during the night.",
                            "target_lang_translations": {
                                "ru": "Ночью я слышал, как вдалеке <w>рычат</w> и дерутся медведи."
                            }
                        }
                    ],
                    "synonyms": [
                        "snarl"
                    ],
                    "common_phrases": [
                        "growl at someone",
                        "low savage growl"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать глубокий гортанный звук, подобно сердитому животному; издавать сердитый, ворчащий звук"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычать",
                                "target_lang_sense_clarification": "издавать угрожающие звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8218bc8-37b8-36ef-8503-04f1f77bf703",
                    "sense_definition": "to express something by speaking in a low, angry, or surly voice",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "human_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man <w>growled</w> his displeasure when he saw the mess in the garden.",
                            "target_lang_translations": {
                                "ru": "Старик <w>проворчал</w> свое недовольство, когда увидел беспорядок в саду."
                            }
                        },
                        {
                            "text": "He would <w>growl</w> an answer whenever someone asked him a personal question.",
                            "target_lang_translations": {
                                "ru": "Он <w>бурчал</w> ответ каждый раз, когда кто-то задавал ему личный вопрос."
                            }
                        }
                    ],
                    "synonyms": [
                        "snarl",
                        "grunt",
                        "snap"
                    ],
                    "common_phrases": [
                        "growl an answer",
                        "growl with displeasure"
                    ],
                    "target_lang_definitions": {
                        "ru": "выражать что-либо, говоря низким, сердитым или угрюмым голосом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорычать",
                                "target_lang_sense_clarification": "сказать что-то грубо или сердито"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "выражать раздражение негромким голосом"
                            },
                            {
                                "target_lang_word": "бурчать",
                                "target_lang_sense_clarification": "бормотать с недовольством"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e17ce46-b0c8-3fbc-a6db-70dd80924d44",
                    "sense_definition": "to play a wind instrument in a way that produces a low-pitched rumbling sound",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saxophonist began to <w>growl</w> a keening march during his solo performance.",
                            "target_lang_translations": {
                                "ru": "Саксофонист начал <w>извлекать рычащие звуки</w>, исполняя заунывный марш во время своего сольного выступления."
                            }
                        },
                        {
                            "text": "Jazz musicians often <w>growl</w> on their horns to create a more raw sound.",
                            "target_lang_translations": {
                                "ru": "Джазовые музыканты часто <w>используют рычание</w> на своих трубах, чтобы создать более сырое звучание."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical musical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "играть на духовом инструменте таким образом, чтобы извлекать низкий рокочущий звук"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать рычащий звук",
                                "target_lang_sense_clarification": "музыкальный прием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d48a9f2b-329f-32da-aaeb-2114820471be",
                    "sense_definition": "to send a user a message via the Growl software library",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "software",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The script is configured to <w>growl</w> a notification whenever the server goes down.",
                            "target_lang_translations": {
                                "ru": "Скрипт настроен на <w>отправку</w> уведомления через Growl всякий раз, когда сервер падает."
                            }
                        },
                        {
                            "text": "You can set the application to <w>growl</w> the status updates to your desktop.",
                            "target_lang_translations": {
                                "ru": "Вы можете настроить приложение так, чтобы оно <w>выводило</w> обновления статуса на ваш рабочий стол через Growl."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "отправлять пользователю сообщение через библиотеку программного обеспечения Growl"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отправлять уведомление",
                                "target_lang_sense_clarification": "через Growl"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "053f790d-70a0-3678-bc7b-2b7b6461a0c7",
                    "sense_definition": "a deep, rumbling, threatening sound made in the throat by an animal",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The low savage <w>growl</w> of the dog made the intruder stop immediately.",
                            "target_lang_translations": {
                                "ru": "Низкое свирепое <w>рычание</w> собаки заставило незваного гостя немедленно остановиться."
                            }
                        },
                        {
                            "text": "A deep <w>growl</w> was the only answer I received from the dark cave.",
                            "target_lang_translations": {
                                "ru": "Глубокий <w>рык</w> был единственным ответом, который я получил из темной пещеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "snarl"
                    ],
                    "common_phrases": [
                        "low savage growl",
                        "deep rumbling growl"
                    ],
                    "target_lang_definitions": {
                        "ru": "глубокий, рокочущий, угрожающий звук, издаваемый животным в горле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычание",
                                "target_lang_sense_clarification": "звук животного"
                            },
                            {
                                "target_lang_word": "рык",
                                "target_lang_sense_clarification": "короткий угрожающий звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d15913b8-77a7-3bb0-aab5-3bd94005e912",
                    "sense_definition": "the rumbling sound made by a human's hungry stomach",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bodily_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>growl</w> of his stomach was embarrassing during the quiet meeting.",
                            "target_lang_translations": {
                                "ru": "Громкое <w>урчание</w> в его животе было неловким моментом во время тихого собрания."
                            }
                        },
                        {
                            "text": "I haven't eaten all day and can feel a constant <w>growl</w> in my belly.",
                            "target_lang_translations": {
                                "ru": "Я не ел весь день и чувствую постоянное <w>бурчание</w> в животе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "growl of his stomach"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "урчащий звук, издаваемый голодным желудком человека"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урчание",
                                "target_lang_sense_clarification": "в животе"
                            },
                            {
                                "target_lang_word": "бурчание",
                                "target_lang_sense_clarification": "звуки в желудке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "844dbd3e-7519-3049-8b83-51d41bab688b",
                    "sense_definition": "an aggressive grumbling or a harsh, low-pitched vocal quality",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer was famous for his Delta-blues <w>growl</w> and unique stage presence.",
                            "target_lang_translations": {
                                "ru": "Певец был знаменит своим дельта-блюзовым <w>хрипом</w> и уникальным поведением на сцене."
                            }
                        },
                        {
                            "text": "He walked out of the office with a <w>growl</w> after his request was denied.",
                            "target_lang_translations": {
                                "ru": "Он вышел из офиса с <w>рычанием</w> после того, как его просьба была отклонена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unintelligible growl"
                    ],
                    "target_lang_definitions": {
                        "ru": "агрессивное ворчание или резкий, низкий тембр голоса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычание",
                                "target_lang_sense_clarification": "о голосе человека"
                            },
                            {
                                "target_lang_word": "хрип",
                                "target_lang_sense_clarification": "низкий вокальный тембр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2444a197-0556-3049-b335-bccf4b1f84c4",
                    "sense_definition": "a low-pitched rumbling sound produced with a wind instrument",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trumpet player used a plunger mute to create a distinctive <w>growl</w> effect.",
                            "target_lang_translations": {
                                "ru": "Трубач использовал сурдину-планжер, чтобы создать характерный эффект <w>рычания</w>."
                            }
                        },
                        {
                            "text": "The composer incorporated several instrumental <w>growls</w> into the jazz arrangement.",
                            "target_lang_translations": {
                                "ru": "Композитор включил несколько инструментальных <w>рычащих звуков</w> в джазовую аранжировку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "growl effect"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "musical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "низкий рокочущий звук, издаваемый духовым инструментом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гроул",
                                "target_lang_sense_clarification": "музыкальный эффект"
                            },
                            {
                                "target_lang_word": "рычание",
                                "target_lang_sense_clarification": "инструментальный звук"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
