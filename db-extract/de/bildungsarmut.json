                "senses": [
                    {
                        "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                        "entry_id": "9b64ed9e-e9aa-3a6c-8891-ac73f591f4dd",
                        "glosses": [
                            "nicht ausreichendes Wissen und Kompetenzen; Mangel an Schulbildung"
                        ],
                        "tags": [
                            "Soziologie",
                            "Gesellschaft",
                            "von einer Person"
                        ],
                        "examples": [
                            {
                                "example_id": "89c78fc3-9ddb-471e-bae9-bebc99096d7e",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Das Wort ist beängstigend: Bildungsarmut.“"
                            },
                            {
                                "example_id": "ec98adae-b2f5-4c40-ac10-372a5d25cf98",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Um Bildungsarmut zu bekämpfen, müssen die Schüler besser gefördert werden.“"
                            },
                            {
                                "example_id": "7cdcb01b-1e16-425d-8a0f-725aa44ae65f",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Bildungsarmut lässt sich folglich anhand von fehlenden Zertifikaten (als Sammelbegriff für Bescheinigungen formaler Bildungsabschlüsse) oder anhand von geringen Kompetenzen messen.“"
                            },
                            {
                                "example_id": "98af8136-d7b5-4041-9846-74a2b7207366",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Aussagen über den Umfang der Bildungsarmut in Deutschland lassen sich damit aus Ergebnissen von Kompetenztests wie etwa dem PISA-Test entnehmen.“"
                            },
                            {
                                "example_id": "1b5c70ac-4da9-499a-b1bb-c8918258837a",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Ein Abbau der Bildungsarmut erfolgt im Gegensatz zu vielen anderen Staaten in Deutschland demnach nicht.“"
                            },
                            {
                                "example_id": "c2bba381-58c1-4f57-9edd-909b6e1a97ac",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Zwischen Armut, Bildungsarmut und Bildungsbenachteiligung besteht eine Wechselwirkung.“"
                            },
                            {
                                "example_id": "b5904aea-079a-46c0-9144-4ffcb4ff6cb6",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Daher ist Bildungsarmut häufig mit Einkommensarmut verbunden, die den Bezug von Transferleistungen des Staates notwendig macht.“"
                            },
                            {
                                "example_id": "6bf709df-f51e-4ea6-9f75-03aaac5a4f63",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Fehlende Impulse zu Hause führen dazu, dass Armut oft zu Bildungsarmut wird.“"
                            },
                            {
                                "example_id": "78bcbc60-c5c4-47f3-b4d7-23f2bead5fab",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Von der damit ausgelösten Bildungsarmut sind viele Kinder der Roma-Minderheit (etwa 500.000 Angehörige) betroffen.“"
                            },
                            {
                                "example_id": "02f3f079-36fb-4427-a198-ae6ca01919b8",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Armut wirkt am zerstörerischsten, wo sie lange dauert und mit Bildungsarmut der Eltern, Arbeitslosigkeit und dem Leben in benachteiligten Stadtteilen einhergeht.“"
                            },
                            {
                                "example_id": "a509b428-53cb-4ca8-8c9f-6fa7557d62a0",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Insgesamt legen die Ergebnisse der Ursachenanalyse nahe, bei der Bekämpfung der Bildungsarmut vor allem auf eine bessere Förderung von Kindern mit einem ungünstigen sozioökonomischen Hintergrund zu setzen.“"
                            },
                            {
                                "example_id": "6d6d3b01-3e48-4585-b4ae-224b3ed708d2",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Reformmaßnahmen, deren Ziel es ist, die Entstehung von Bildungsarmut zu verhindern, sollten vor allem darauf zielen, die frühkindliche Bildung zu verbessern und damit die Startchancengerechtigkeit für die Kinder zu erhöhen.“"
                            },
                            {
                                "example_id": "64553188-e767-4032-99a8-dac0c5c3d396",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Das Ziel der Initiative ist es deshalb, Bildungsarmut zu bekämpfen und mehr Chancengleichheit herzustellen.“"
                            },
                            {
                                "example_id": "054f567c-11d4-434c-8e51-a15fcda873f4",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Doch das reicht nicht, um in ausreichendem Maß Bildungsarmut zu reduzieren, zum Wachstum beizutragen und den Nachschub an Fachkräften für die Wirtschaft zu sichern“ […]."
                            },
                            {
                                "example_id": "a99dd264-87e8-4ee5-aa0f-50fba1910172",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "[Coronapandemie 2021:] „Ihre Prognose: Homeschooling und Wechselunterricht werden die Schulqualität hemmen und die Bildungsarmut verstärken.“"
                            },
                            {
                                "example_id": "e0c9474a-03b7-46ae-9e56-7186ea5398b9",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Die Studie beschäftigt sich unter anderem mit der Schulqualität, der Integration und der Frage, inwiefern Bildungsarmut verringert wird.“"
                            },
                            {
                                "example_id": "a5341337-7155-4c98-bad9-3988c9ae7da5",
                                "sense_id": "dc03b97c-9014-3187-9c9a-1443202119ab",
                                "text": "„Ungewollt verleitet der Begriff \"Bildungsarmut\" zu dem Irrglauben, eine gute Schulbildung biete die Gewähr für einen Ausbildungs- oder Arbeitsplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
