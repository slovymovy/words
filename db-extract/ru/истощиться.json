                                ]
                            },
                            {
                                "target_word": "run out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "853bfe10-3be6-3b1b-93a5-f80f1e907f25",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To use up or consume all"
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b141e17-b422-4737-90ed-fbcd185223e9",
                                                "sense_id": "853bfe10-3be6-3b1b-93a5-f80f1e907f25",
                                                "text": "Get some more beer out of the fridge before we run out."
                                            },
                                            {
                                                "example_id": "7d568003-312a-45aa-81ca-f2aa9ca0b8d8",
                                                "sense_id": "853bfe10-3be6-3b1b-93a5-f80f1e907f25",
                                                "text": "If this hot weather continues, we will run out of ice cream."
                                            },
                                            {
                                                "example_id": "07ba74c2-bdc8-4025-afa4-e64d4edfde3e",
                                                "sense_id": "853bfe10-3be6-3b1b-93a5-f80f1e907f25",
                                                "text": "England keeper Joe Hart had to save smartly from the dangerous Andriy Yarmolenko, who also raised the hopes of the Donetsk crowd as he evaded several challenges in the area before running out of space."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e56edc-49ab-3c78-8f1a-b51e0db94ec8",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To expire; to come to an end."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08a44ad3-8320-4be8-ba04-d32ecb1b6929",
                                                "sense_id": "14e56edc-49ab-3c78-8f1a-b51e0db94ec8",
                                                "text": "My driving licence runs out next week, so I had better renew it now."
                                            },
                                            {
                                                "example_id": "eaf85a51-1dcc-4682-acda-698220253350",
                                                "sense_id": "14e56edc-49ab-3c78-8f1a-b51e0db94ec8",
                                                "text": "The option will run out next week and I can't get it extended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e9595d-4829-3592-8ac5-83a814a6bc70",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To expire; to come to an end.",
                                            "To be completely used up or consumed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd3c9fc-84dd-437d-83e8-3ce57b5e995e",
                                                "sense_id": "85e9595d-4829-3592-8ac5-83a814a6bc70",
                                                "text": "Time is running out, so I renounce a spin on a Class 387 for a fast run to Paddington on another Class 800 - a shame as the weather was perfect for pictures. Even so, it's enjoyable - boy, can those trains shift under the wires."
                                            },
                                            {
                                                "example_id": "34c5228d-eb7f-43cd-ac7b-014586a7628a",
                                                "sense_id": "85e9595d-4829-3592-8ac5-83a814a6bc70",
                                                "text": "Time is running out."
                                            },
                                            {
                                                "example_id": "2266ccdc-05c9-4dad-a895-d93d39b6a98e",
                                                "sense_id": "85e9595d-4829-3592-8ac5-83a814a6bc70",
                                                "text": "Oh no! The wine has run out!"
                                            },
                                            {
                                                "example_id": "c3f82d28-8d8c-447b-a0a6-7b147eb7ffbd",
                                                "sense_id": "85e9595d-4829-3592-8ac5-83a814a6bc70",
                                                "text": "Mario Balotelli replaced Tevez but his contribution was so negligible that he suffered the indignity of being substituted himself as time ran out, a development that encapsulated a wretched 90 minutes for City and boss Roberto Mancini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dcc4bf3-a0a3-31a3-b582-0697e9054621",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To get a batsman out (dismissed from play) via a runout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a13c048-0382-425f-85b8-4f39260ce383",
                                                "sense_id": "4dcc4bf3-a0a3-31a3-b582-0697e9054621",
                                                "text": "Jackson was run out for a duck in the first over."
                                            },
                                            {
                                                "example_id": "25801a98-cb65-4c22-9aa8-8ab0eaf2f9f4",
                                                "sense_id": "4dcc4bf3-a0a3-31a3-b582-0697e9054621",
                                                "text": "With three runs needed from two balls, Adil Rashid was run out coming back for a second. When Wood suffered the same fate from the final ball, the match was tied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b211f7a-85cb-3d18-a830-276cf0a91675",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To extend a piece of material, or clothing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7b0820c-5b9d-4cf8-82bd-5043e9d76327",
                                                "sense_id": "6b211f7a-85cb-3d18-a830-276cf0a91675",
                                                "text": "If I run out these curtains, they will fit the windows in the drawing room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70e4c5b8-03a0-355e-9940-d89c29ecb7c5",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To conclude in, to end up."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b310c879-076b-4c01-b78f-d02819add6eb",
                                                "sense_id": "70e4c5b8-03a0-355e-9940-d89c29ecb7c5",
                                                "text": "Tottenham survived a scare as they fought back from 1-0 down to run out comfortable winners against Shamrock Rovers in the Europa League."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90786337-4fad-3fd4-ad92-003bc3d08459",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To force (someone or something) out of a location or state of being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2c9ef2-62fa-41f6-bc4b-84223e12c360",
                                                "sense_id": "90786337-4fad-3fd4-ad92-003bc3d08459",
                                                "text": "If the mob thinks you did it, they'll run you out of town."
                                            },
                                            {
                                                "example_id": "4ed947ed-b4c3-4238-837b-5e454cf84143",
                                                "sense_id": "90786337-4fad-3fd4-ad92-003bc3d08459",
                                                "text": "They'll run us out of business doing that!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5df6669-6207-3907-bbb7-007a452e6bc7",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To grow poor over time by spending all of one's money."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2d25ce6-6db9-3b1e-bbd8-920455dccdfc",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "To fill a line with quadrats or full points."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77f42173-f154-3c25-af6a-13becbe79fca",
                                        "entry_id": "975cdd26-eccc-308e-9af8-a83590e8d256",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see run, out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c7fac6d-694a-4cd8-90b5-085472c7303e",
                                                "sense_id": "77f42173-f154-3c25-af6a-13becbe79fca",
                                                "text": "Near-synonyms: see Thesaurus:leave"
                                            },
                                            {
                                                "example_id": "c4e2fbdb-9054-427b-8e61-b6eca5c1864c",
                                                "sense_id": "77f42173-f154-3c25-af6a-13becbe79fca",
                                                "text": "She ran out of the room in tears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
