                "senses": [
                    {
                        "sense_id": "34ff1dfb-ef31-31c8-9393-66e458a730d0",
                        "entry_id": "83581020-8621-3058-87d9-458bac21203d",
                        "glosses": [
                            "grafische Darstellung zur Planung und Untersuchung von Arbeitsabläufen, besonders wenn die verwendeten Verfahrenstechniken in wechselseitiger Abhängigkeit zueinander stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef68028-85a3-408e-9c7b-0e9e7734bd24",
                                "sense_id": "34ff1dfb-ef31-31c8-9393-66e458a730d0",
                                "text": "Ziel des Einsatzes der Netzplantechnik ist ein gutes Zeitmanagement, eine verlässliche Terminplanung und das Abfedern von drohenden Engpässen."
                            },
                            {
                                "example_id": "df94b1f2-9000-47cb-a950-0452fc1c2944",
                                "sense_id": "34ff1dfb-ef31-31c8-9393-66e458a730d0",
                                "text": "In der neueren betriebswirtschaftlichen Literatur werden verschiedentlich die Einsatzmöglichkeiten von Verfahren der Netzplantechnik als Hilfsmittel der Finanzplanung diskutiert."
                            },
                            {
                                "example_id": "b277134e-285c-4f6a-860e-6195256eb6c4",
                                "sense_id": "34ff1dfb-ef31-31c8-9393-66e458a730d0",
                                "text": "Zu den bekanntesten Netzplantechniken gehören PERT (Programm Evaluation and Review Technique), CPM (Critical Path Method), MPM (Metra-Potential-Methode) sowie GERT (Graphic Evaluation and Review Technique)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
