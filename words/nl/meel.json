    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f02cda9-e06d-300e-9b92-f87c63a75061",
                    "sense_definition": "Fijn gemalen graan dat wordt gebruikt als basis voor het bakken van brood en andere producten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Meel</w> is de basis van vele producten die men in de westerse wereld eet.",
                            "target_lang_translations": {
                                "en": "<w>Flour</w> is the basis of many products eaten in the Western world.",
                                "ru": "<w>Мука</w> является основой многих продуктов, которые едят в западном мире."
                            }
                        },
                        {
                            "text": "Om dit brood te bakken heb je vers <w>meel</w> en een beetje gist nodig.",
                            "target_lang_translations": {
                                "en": "To bake this bread, you need fresh <w>flour</w> and a little yeast.",
                                "ru": "Чтобы испечь этот хлеб, вам понадобится свежая <w>мука</w> и немного дрожжей."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloem",
                        "stuifmeel"
                    ],
                    "common_phrases": [
                        "zak meel",
                        "fijn meel",
                        "volkoren meel"
                    ],
                    "target_lang_definitions": {
                        "en": "Finely ground grain used as a base for baking bread and other products.",
                        "ru": "Мелко измельченное зерно, используемое в качестве основы для выпечки хлеба и других продуктов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flour",
                                "target_lang_sense_clarification": "powder from ground grain"
                            },
                            {
                                "target_lang_word": "meal",
                                "target_lang_sense_clarification": "coarsely ground grain"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "порошкообразный продукт из зерна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5fa34996-dc81-38a1-aa4b-af1ae8afa7df",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>melen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>meel</w> het graan tot het een fijn poeder wordt.",
                            "target_lang_translations": {
                                "en": "I <w>mill</w> the grain until it becomes a fine powder.",
                                "ru": "Я <w>мелю</w> зерно, пока оно не превратится в мелкий порошок."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>meel</w> ik een kleine hoeveelheid voor het ontbijt.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>grind</w> a small amount for breakfast.",
                                "ru": "Каждое утро я <w>мелю</w> небольшое количество для завтрака."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'to mill' or 'to grind'.",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола melen (молоть)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mill",
                                "target_lang_sense_clarification": "to grind into powder"
                            },
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "to reduce to small particles"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мелю",
                                "target_lang_sense_clarification": "я мелю (зерно)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f52b17e-7c4d-32fd-98a0-d7fbabeaf85b",
                    "sense_definition": "De gebiedende wijs van <w>melen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Meel</w> nu die granen voordat de molen stopt met draaien!",
                            "target_lang_translations": {
                                "en": "<w>Mill</w> those grains now before the mill stops turning!",
                                "ru": "<w>Мели</w> зерно сейчас, пока мельница не перестала вращаться!"
                            }
                        },
                        {
                            "text": "Als je klaar bent met oogsten, <w>meel</w> dan de rest van de voorraad.",
                            "target_lang_translations": {
                                "en": "When you are finished harvesting, <w>grind</w> the rest of the stock.",
                                "ru": "Когда закончишь с урожаем, <w>мели</w> остальную часть запасов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'to mill' or 'to grind'.",
                        "ru": "Повелительное наклонение глагола melen (молоть)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mill",
                                "target_lang_sense_clarification": "command to grind grain"
                            },
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "command to reduce to powder"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мели",
                                "target_lang_sense_clarification": "приказ молоть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
