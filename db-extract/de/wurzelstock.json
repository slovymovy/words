                ],
                "senses": [
                    {
                        "sense_id": "53e4011b-e483-355d-8d4b-f4d3f5438e89",
                        "entry_id": "e660910b-61d3-39f1-bd0f-0c574c169253",
                        "glosses": [
                            "ein meist unterirdisches oder dicht über dem Boden wachsendes Sprossachsensystem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67372a7-ed34-4e79-ba74-fc87ef3e2e7a",
                                "sense_id": "53e4011b-e483-355d-8d4b-f4d3f5438e89",
                                "text": "„Das Rhizom – oft auch als Wurzelstock benannt - ist ein Organ mit kurzen, verdickten Internodien. Eine Wurzel besitzt hingegen weder Nodien (Sprossknoten) noch Internodien.“"
                            },
                            {
                                "example_id": "40f9b8ab-7408-448b-af6a-5930dd4d9c6e",
                                "sense_id": "53e4011b-e483-355d-8d4b-f4d3f5438e89",
                                "text": "„Beschreibung: Ausdauernde Kräuter aus der Familie der Doldengewächse (Apiaceae) mit spindelförmigen, unangenehm riechendem Wurzelstock.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "253ed9f2-2979-3097-bd62-43d2ba1aaee7",
                        "entry_id": "e660910b-61d3-39f1-bd0f-0c574c169253",
                        "glosses": [
                            "der Übergangsbereich zwischen Wurzelwerk und Stamm eines Baumes"
                        ],
                        "tags": [
                            "Forstsprache"
                        ],
                        "examples": [
                            {
                                "example_id": "87159706-19a1-4b1f-a5a5-91f80f0502c2",
                                "sense_id": "253ed9f2-2979-3097-bd62-43d2ba1aaee7",
                                "text": "Die gelassenen Hauptwurzeln bilden sehr bald ihre neuen Nebenwurzeln, später Hauptwurzeln, und es erfolgt in kurzer Zeit ein ganz neuer Wurzelstock."
                            },
                            {
                                "example_id": "ab7fe020-4d81-4c57-9611-c6d4a89557a2",
                                "sense_id": "253ed9f2-2979-3097-bd62-43d2ba1aaee7",
                                "text": "Voraussetzung war, dass die beteiligten Baumarten die Fähigkeit besitzen, aus dem Wurzelstock wieder auszuschlagen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c40e23e6-839a-349e-b2fd-17651c2e2528",
                        "entry_id": "e660910b-61d3-39f1-bd0f-0c574c169253",
                        "glosses": [
                            "der nach dem Fällen eines Baumes verbleibende Baumstumpf"
                        ],
                        "tags": [
                            "Forstsprache"
                        ],
                        "examples": [
                            {
                                "example_id": "b013e42e-25ea-4969-80f1-35f8e9c39d05",
                                "sense_id": "c40e23e6-839a-349e-b2fd-17651c2e2528",
                                "text": "Voraussetzung war, dass die beteiligten Baumarten die Fähigkeit besitzen, aus dem Wurzelstock wieder auszuschlagen."
                            },
                            {
                                "example_id": "f7a283e9-bf97-4085-9f0e-39448e0d3cba",
                                "sense_id": "c40e23e6-839a-349e-b2fd-17651c2e2528",
                                "text": "Durch den zu tief angelegten Fällschnitt und die teilweise durchtrennte Bruchleiste platzte ein 1,50 m langes Teilstück des Stammes unten auf und blieb senkrecht auf dem Wurzelstock stehen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
