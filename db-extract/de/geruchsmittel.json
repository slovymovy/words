                "senses": [
                    {
                        "sense_id": "8a8c9947-e977-372f-be97-08612091d29e",
                        "entry_id": "b650242f-4150-3b35-a7ef-f4093bd41886",
                        "glosses": [
                            "chemische Substanz, die als Geruch wahrgenommen wird"
