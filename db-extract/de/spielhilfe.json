                "senses": [
                    {
                        "sense_id": "445b099a-0497-3de7-b9d2-15425caf4331",
                        "entry_id": "b49f25f1-de0a-3637-8484-c56d553704af",
                        "glosses": [
                            "personelle oder technische Unterstützung im Spielgeschehen bei Schwierigkeiten der Beherrschung der Spielanforderungen, etwa von Regelverständnis oder zur Erleichterung einer Spieltechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b71e7ae-94f9-47c9-aa6f-371033721712",
                                "sense_id": "445b099a-0497-3de7-b9d2-15425caf4331",
                                "text": "„Da die meisten Instrumente des 18. Jh. undatiert sind, ist eine genaue zeitliche Bestimmung der Hinzunahme einzelner Spielhilfen nicht möglich.“"
                            },
                            {
                                "example_id": "f5855576-e23f-461b-a48c-f652c3967802",
                                "sense_id": "445b099a-0497-3de7-b9d2-15425caf4331",
                                "text": "„Diese Erweiterungen nehmen Anregungen von Wagners Disposition der Orgel in der Alten Garnisonskirche auf; inwieweit sich diese Übernahmen jedoch in der etwas kleineren Orgel der Marienkirche sinnvoll ausnehmen, sei dahingestellt, ebenso, ob durch sie die stilistischen Verwendungsmöglichkeiten nennenswert erweitert wurden, zumal durch das Fehlen von Spielhilfen der schnelle Registerwechsel, wie ihn jüngere Orgelmusik verlangt, nicht möglich ist.“"
                            },
                            {
                                "example_id": "7fad4dd4-c8f9-4571-b081-7d1ab55ccb73",
                                "sense_id": "445b099a-0497-3de7-b9d2-15425caf4331",
                                "text": "„Immer wieder wird Spielhilfe ein der Situation und den Bedürfnissen der einzelnen Mitspieler angepasstes Ausbalancieren sein müssen zwischen Tolerieren und Eingreifen.“"
                            },
                            {
                                "example_id": "01178c21-be93-48ab-b426-6e417070a158",
                                "sense_id": "445b099a-0497-3de7-b9d2-15425caf4331",
                                "text": "„Man hat Sicherheitsinstrumente gebaut, die Rohrlängen verkürzt und Spielhilfen eingefügt.“"
                            },
                            {
                                "example_id": "e41f8026-4d8b-4f93-ba5b-efb69143ffb9",
                                "sense_id": "445b099a-0497-3de7-b9d2-15425caf4331",
                                "text": "„Civilization 4 ist bei aller Komplexität für Einsteiger wie Profis gleichermaßen geeignet - dank der sehr guten Einführung und vielen Spielhilfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
