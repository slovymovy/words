                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "94eb3088-94e1-48ba-b425-4c293f7e3799",
                        "source_entry_id": "414fcce8-9c9b-347c-9285-4048a582385d",
                        "source_sense_id": "498455d9-82eb-38fe-a194-5af315f66416",
                        "source_sense_description": "eine Person oder Gegenstand, der Teil eines Zwillings ist",
                        "target_lang_word": "Zwilling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwilling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15115794-1bb2-3ea3-9b45-aeb515ecd6c8",
                                        "entry_id": "71b2e730-df18-3215-ab73-3d0af56e1776",
                                        "glosses": [
                                            "einer von zwei gleichzeitig im Mutterleib des Menschen oder des Tieres entwickelten Embryos und geborenen Kindern, Jungen"
                                        ],
                                        "tags": [
                                            "wird auch übertragen benutzt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5cfb550-722c-4001-866d-6543e7ada3ed",
                                                "sense_id": "15115794-1bb2-3ea3-9b45-aeb515ecd6c8",
                                                "text": "Peter und Paul sind Zwillinge."
                                            },
                                            {
                                                "example_id": "b73945dd-5261-4e3a-b6b0-33e65c3501c8",
                                                "sense_id": "15115794-1bb2-3ea3-9b45-aeb515ecd6c8",
                                                "text": "„Erst trieb mich Rach’, ihr Zwilling ist der Mord;",
                                                "translation": "Sei eine Sünde denn der Andern Hort!“"
                                            },
                                            {
                                                "example_id": "f3a5eef0-4646-4d12-adad-bfad6d9cd88c",
                                                "sense_id": "15115794-1bb2-3ea3-9b45-aeb515ecd6c8",
                                                "text": "„Eben so eine andere Erzählung, daß eine Frau mit Zwillingen schwanger gegangen, und im vierten Monat noch einmal geschwängert worden sei.“"
                                            },
                                            {
                                                "example_id": "ed5c4b00-1674-497b-b83d-530f20bd15e7",
                                                "sense_id": "15115794-1bb2-3ea3-9b45-aeb515ecd6c8",
                                                "text": "„Eine andre wichtige Ursache ist […] die Erschlaffung des Fruchthälters nach Abgang eines Zwillings.“"
                                            },
                                            {
                                                "example_id": "57660de9-33b1-4aed-b463-13cedf18e13f",
                                                "sense_id": "15115794-1bb2-3ea3-9b45-aeb515ecd6c8",
                                                "text": "„Sie fand, daß Zwillinge im Vergleich mit anderen Kindern erheblich zurückgeblieben waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2db8fe4-b946-3619-a6ff-84bc3c396d2c",
                                        "entry_id": "71b2e730-df18-3215-ab73-3d0af56e1776",
                                        "glosses": [
                                            "ein Sternbild am nördlichen Sternenhimmel"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ccd13f-4674-4575-97f2-a5cf11ce91a9",
                                                "sense_id": "d2db8fe4-b946-3619-a6ff-84bc3c396d2c",
                                                "text": "Durch den östlichen Teil der Zwillinge zieht sich das Band der Milchstraße, daher findet man in diesem Bereich mehrere offene Sternhaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "017615c7-0617-309b-872d-a9341c80f052",
                                        "entry_id": "71b2e730-df18-3215-ab73-3d0af56e1776",
                                        "glosses": [
                                            "eines der zwölf Tierkreiszeichen (Sternzeichen)"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "651579ba-a7a6-33a6-a06a-89b659c06a03",
                                        "entry_id": "71b2e730-df18-3215-ab73-3d0af56e1776",
                                        "glosses": [
                                            "jemand, der im Tierkreiszeichen der Zwillinge geboren ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "053850e7-d2dc-494b-9ef3-25cf6bdc6270",
                                                "sense_id": "651579ba-a7a6-33a6-a06a-89b659c06a03",
                                                "text": "Bist du noch Stier oder schon Zwilling?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "36398448-1913-3542-87c8-376dbaaddda1",
                                        "entry_id": "71b2e730-df18-3215-ab73-3d0af56e1776",
                                        "glosses": [
                                            "kurz für Kristallzwilling oder Zwillingskristall"
                                        ],
                                        "tags": [
                                            "Kristallkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d489f75d-a495-4fa3-befb-bd5a8245fa15",
                                                "sense_id": "36398448-1913-3542-87c8-376dbaaddda1",
                                                "text": "Falls es sich bei Zwillingsebene um Symmetrieebenen der Kristalle handelt, spricht man nicht von einem Zwilling, sondern nur von einer einfachen Parallelverwachsung."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e41502f9-6ab4-39a6-8f1f-caeef2559175",
                                        "entry_id": "71b2e730-df18-3215-ab73-3d0af56e1776",
                                        "glosses": [
                                            "zwei Spielkarten gleichen Werts in einem Kartenspiel"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "f2e0ff4b-c006-332b-ac5d-4e6a6ef3994e",
                                        "entry_id": "71b2e730-df18-3215-ab73-3d0af56e1776",
                                        "glosses": [
                                            "ein Gewehr mit Doppellauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f854d8a-db15-4293-ac49-8556ca1e9a40",
                                                "sense_id": "f2e0ff4b-c006-332b-ac5d-4e6a6ef3994e",
                                                "text": "„Gewehre mit nebeneinander montierten Läufen bezeichnete man als Zwilling, unabhängig davon, ob es sich um gezogene oder glatte Läufe bzw. die Kombination beider handelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zwilling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcc22fbc-6b24-330d-9ba4-7ecd736c59cc",
                                        "entry_id": "b7076e8f-4b37-31c8-91b7-4d5a88d56c1c",
