                "senses": [
                    {
                        "sense_id": "118175cd-ab30-373e-a1dd-9154fbbbc70b",
                        "entry_id": "25c2c487-6ab8-3af7-bc03-c7361898d44b",
                        "glosses": [
                            "künstliche Sprache, die vor allen Dingen der internationalen Verständigung dienen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e48717-65d1-43e9-b5d2-39fa543a03e9",
                                "sense_id": "118175cd-ab30-373e-a1dd-9154fbbbc70b",
                                "text": "Welthilfssprachen sind einfach gebaut, weisen fast ausschließlich regelmäßige Formen auf und sind leicht zu erlernen."
                            },
                            {
                                "example_id": "efca5610-e4a1-4a5d-8507-7e359d8a466f",
                                "sense_id": "118175cd-ab30-373e-a1dd-9154fbbbc70b",
                                "text": "Die bekanntesten Welthilfssprachen sind Esperanto, Ido, Interlingue (Occidental) und Interlingua"
                            },
                            {
                                "example_id": "b20f24ea-ba5f-44f3-9678-8db2735e875f",
                                "sense_id": "118175cd-ab30-373e-a1dd-9154fbbbc70b",
                                "text": "„Die Welthilfssprachen sind der Versuch, auf künstlichem Wege eine allgemeingültige \"Weltsprache\" zu schaffen.“"
                            },
                            {
                                "example_id": "dc14bb06-eab3-4cc8-9a00-875d2aadf4fa",
                                "sense_id": "118175cd-ab30-373e-a1dd-9154fbbbc70b",
                                "text": "„In absehbarer Zeit besteht kaum die Aussicht, daß eine der natürlichen Sprachen oder eine der künstlich geschaffenen, sogenannten Welthilfssprachen zur Universalsprache der ganzen Menschheit wird.“"
                            },
                            {
                                "example_id": "12adde7e-2550-49ec-800e-add10c1fa79a",
                                "sense_id": "118175cd-ab30-373e-a1dd-9154fbbbc70b",
                                "text": "Naturalistisch konzipierte Welthilfssprachen, wie zum Beispiel Interlingua oder Interlingue, werden von sehr viel mehr Mensch auf den ersten Blick sinngemäß erfasst und leichter verstanden als die schematisch oder streng logisch konzipierten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
