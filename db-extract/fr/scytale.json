                    {
                        "translation_id": "2cbe0188-d146-4738-90d3-7b788ce92188",
                        "source_entry_id": "b0e4a54f-bb1a-3e8b-9cd1-e4f223b688af",
                        "source_sense_id": "54d52185-6b6a-30a0-9b4c-1a0267c0ba34",
