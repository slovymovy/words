                        "glosses": [
                            "Disziplin, bei der zwei Mannschaften, bestehend aus jeweils vier Personen, im Bahnradfahren gegeneinander antreten"
                        ],
                        "tags": [
                            "Bahnradsport"
                        ],
                        "examples": [
