                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f11c414c-d04f-436a-aaf0-993765223ffd",
                        "entry_id": "bf2e1b82-e797-3889-8a7e-d1d32c583fd1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more calculated"
                    },
                    {
                        "form_id": "6b660af7-113e-497d-a7b9-21b0e9178244",
                        "entry_id": "bf2e1b82-e797-3889-8a7e-d1d32c583fd1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most calculated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "646aa44d-8ec2-354b-a284-3b1b14260a5e",
                        "entry_id": "bf2e1b82-e797-3889-8a7e-d1d32c583fd1",
                        "glosses": [
                            "Arrived at or determined by mathematical calculation; ascertained mathematically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d502580-37cd-4327-8834-ab73d47bd0ac",
                                "sense_id": "646aa44d-8ec2-354b-a284-3b1b14260a5e",
                                "text": "The calculated total appeared to be wrong."
                            }
                        ]
                    },
                    {
                        "sense_id": "0aca68fd-72e1-37d2-b9f9-438f4484a452",
                        "entry_id": "bf2e1b82-e797-3889-8a7e-d1d32c583fd1",
                        "glosses": [
                            "Carefully thought out or planned."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea2575d-db73-4b8a-80ff-6a0818b9b0db",
                                "sense_id": "0aca68fd-72e1-37d2-b9f9-438f4484a452",
                                "text": "a calculated campaign of disinformation"
                            },
                            {
                                "example_id": "d487a136-8ff2-42d3-9f3a-091f94d7c399",
                                "sense_id": "0aca68fd-72e1-37d2-b9f9-438f4484a452",
                                "text": "We made a calculated decision not to visit them on the first day, in case we seemed too eager."
                            },
                            {
                                "example_id": "396b452a-dee4-4307-b3bf-d0aa820b5397",
                                "sense_id": "0aca68fd-72e1-37d2-b9f9-438f4484a452",
                                "text": "Tobacco companies develop carefully calculated media campaigns."
                            },
                            {
                                "example_id": "5601e63f-0554-4638-99c3-261376e3579b",
                                "sense_id": "0aca68fd-72e1-37d2-b9f9-438f4484a452",
                                "text": "Zivin’s (1982) findings bear this out, that as actors grow to adulthood they become increasingly calculated and less spontaneous about displaying nonverbals, and their displays correspondingly tend to be understood as more calculated and less spontaneous."
                            },
                            {
                                "example_id": "ef37cb1b-3d37-4f80-80d8-b9ce63512204",
                                "sense_id": "0aca68fd-72e1-37d2-b9f9-438f4484a452",
                                "text": "Her myriad “crimes reflected a stunning degree of calculated cruelty,” the judge wrote, and he called her “a coldly calculated criminal recidivist and serial killer who denied culpability, and possessed a high potential for future violence.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "0fc6bf53-a3dd-3845-94bd-2c813ca80fa6",
                        "entry_id": "bf2e1b82-e797-3889-8a7e-d1d32c583fd1",
                        "glosses": [
                            "Calculating; unemotional and analytical."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "e41610f9-2b9a-4c01-8eed-292b68752b46",
                                "sense_id": "0fc6bf53-a3dd-3845-94bd-2c813ca80fa6",
                                "text": "Zivin's (1982) findings bear this out, that as actors grow to adulthood they become increasingly calculated and less spontaneous about displaying nonverbals, and their displays correspondingly tend to be understood as more calculated and less spontaneous."
                            },
                            {
                                "example_id": "9ca4fc1f-f22e-4cda-a221-9c709024a33e",
                                "sense_id": "0fc6bf53-a3dd-3845-94bd-2c813ca80fa6",
                                "text": "Being very calculated, he knew very well the arrival and departure hours, and respected them."
                            },
                            {
                                "example_id": "6b92b2ac-74b3-48c0-a2f9-4784cff8f05b",
                                "sense_id": "0fc6bf53-a3dd-3845-94bd-2c813ca80fa6",
                                "text": "Her myriad “crimes reflected a stunning degree of calculated cruelty,” the judge wrote, and he called her “a coldly calculated criminal recidivist and serial killer who denied culpability, and possessed a high potential for future violence.”"
                            }
                        ]
                    }
                ],
