                        "examples": [
                            {
                                "example_id": "d8e97afd-e899-42b8-a288-b472fcb62bc4",
                                "sense_id": "9aaffc85-b0e4-3d74-be5f-65868aa74b46",
                                "text": "Ilona hat sich eine Uschanka gekauft.",
                                "translation": "Илона купила ушанку."
                            },
                            {
                                "example_id": "959a24b0-545d-492e-93f6-a5071883e331",
                                "sense_id": "9aaffc85-b0e4-3d74-be5f-65868aa74b46",
                                "text": "Der Designer präsentiert seine neue Kollektion von Uschankas.",
                                "translation": "Дизайнер представил свою новую коллекцию ушанок."
                            },
                            {
                                "example_id": "538ed10d-c409-4813-8802-9ec9674b9b05",
                                "sense_id": "9aaffc85-b0e4-3d74-be5f-65868aa74b46",
                                "text": "Im Museum sahen wir originale Uschankas der Roten Armee.",
                                "translation": "В музее мы увидели оригинальный ушанки Красной Армии."
                            }
                        ]
