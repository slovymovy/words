                    "sense_definition": "Een cilindrische binnenwand heel nauwkeurig glad- en op maat slijpen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monteur moet de cilinders van de motor eerst <w>honen</w> voor de reparatie.",
                            "target_lang_translations": {
