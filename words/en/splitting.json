                            {
                                "target_lang_word": "rozłupywanie",
                                "target_lang_sense_clarification": "np. drewna"
                            },
                            {
                                "target_lang_word": "dzielący",
                                "target_lang_sense_clarification": "imiesłów przymiotnikowy"
                            }
