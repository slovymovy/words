                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The home team kept <w>possession</w> for most of the second half.",
                            "target_lang_translations": {
                                "ru": "Хозяева поля сохраняли <w>владение</w> мячом большую часть второго тайма.",
                                "zh": "主队在下半场大部分时间里都保持着<w>控球</w>。"
                            }
                        },
                        {
                            "text": "They lost <w>possession</w> near the goal line due to a bad pass.",
                            "target_lang_translations": {
                                "ru": "Они потеряли <w>владение</w> мячом у линии ворот из-за плохой передачи.",
                                "zh": "由于传球失误，他们在球门线附近失去了<w>控球</w>权。"
                            }
