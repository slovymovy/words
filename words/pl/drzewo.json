            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24f2d9e6-6ae7-395a-9b52-2632b102c400",
                    "sense_definition": "Duża, wieloletnia roślina o zdrewniałym pniu głównym, od którego odchodzą gałęzie i liście",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W naszym ogrodzie rośnie stare <w>drzewo</w>, które daje dużo cienia w upalne dni.",
                            "target_lang_translations": {
                                "ru": "В нашем саду растёт старое <w>дерево</w>, которое даёт много тени в жаркие дни.",
                                "en": "In our garden grows an old <w>tree</w> that provides plenty of shade on hot days."
                            }
                        },
                        {
                            "text": "To <w>drzewo</w> owocowe rodzi pyszne jabłka każdego roku.",
                            "target_lang_translations": {
                                "ru": "Это фруктовое <w>дерево</w> каждый год приносит вкусные яблоки.",
                                "en": "This fruit <w>tree</w> yields delicious apples every year."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drzewo owocowe",
                        "drzewo liściaste",
                        "drzewo iglaste",
                        "sadzić drzewo",
                        "korona drzewa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное многолетнее растение с одревесневшим главным стволом, от которого отходят ветви и листья",
                        "en": "A large perennial woody plant with a single main stem or trunk, supporting branches and leaves"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерево",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "tree",
                                "target_lang_sense_clarification": "woody plant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ef6c32d-8a63-3f42-8ae5-2189ceec9d60",
                    "sense_definition": "Ścięte pnie i gałęzie używane jako materiał opałowy lub budulec",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy zamówić <w>drzewo</w> na zimę, żeby ogrzać cały dom.",
                            "target_lang_translations": {
                                "ru": "Нам нужно заказать <w>дрова</w> на зиму, чтобы отопить весь дом.",
                                "en": "We need to order <w>firewood</w> for the winter to heat the whole house."
                            }
                        },
                        {
                            "text": "Mój dziadek codziennie rąbie <w>drzewo</w> do kominka.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка каждый день рубит <w>дрова</w> для камина.",
                                "en": "My grandfather chops <w>wood</w> for the fireplace every day."
                            }
                        }
                    ],
                    "synonyms": [
