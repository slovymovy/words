                    {
                        "translation_id": "c2855b7f-f996-4682-a183-f8844eef6c34",
                        "source_entry_id": "c6a55c82-db27-3870-bd26-11940c7bf253",
                        "source_sense_id": "93237870-f187-3269-9bd6-b0123088c970",
                        "target_lang_word": "панегирик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "панегирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3ffa19-29ec-37c8-9981-d4b34f8c2516",
                                        "entry_id": "674d86ea-ffed-3d20-baee-232d65b4aa46",
                                        "glosses": [
                                            "устар. ораторская хвалебная речь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d46be1f-fa57-4507-99f5-51208b1e23a4",
                                                "sense_id": "5a3ffa19-29ec-37c8-9981-d4b34f8c2516",
                                                "text": "В народе раздавались восторженные крики, слышались мольбы за Хмельницкого; духовенство, академия вышли к нему навстречу, профессора говорили панегирики, называли Хмельницкого Моисеем веры русской, защитником свободы русского народа, новым Маккавеем."
                                            },
                                            {
                                                "example_id": "dbe8245b-6a28-460a-ac4e-bd2d9acbda93",
                                                "sense_id": "5a3ffa19-29ec-37c8-9981-d4b34f8c2516",
                                                "text": "Наш редактор только покачивал молча головой и хладнокровно вымарывал его панегирики."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21f6a7ac-ac61-3b1d-97a8-51e6942c5f7b",
                                        "entry_id": "674d86ea-ffed-3d20-baee-232d65b4aa46",
                                        "glosses": [
                                            "перен., книжн., неодобр. восторженная, неумеренная похвала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "015e4092-bad4-42a4-8182-20d76e1f049e",
                                                "sense_id": "21f6a7ac-ac61-3b1d-97a8-51e6942c5f7b",
                                                "text": "Однако всё чаще защита друзей сбивается на панегирик, на обвинения тем, кто осмелился о Карамзине толковать без должного почтения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
