                                        "glosses": [
                                            "разг. уменьш.-ласк. к собака"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50cb24e-d7c1-4a14-8957-042a44c4ac75",
                                                "sense_id": "fcc78ee6-695a-32c0-b623-9cc6a4d150d3",
                                                "text": "К её ногам тут же подбежала пушистая беленькая собачка и, встав на задние лапы, суетливо крест-накрест задвигала передними."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "соба́чка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a05ffe-33a7-323e-9cfe-831c61cfd07d",
                                        "entry_id": "55409db3-4a5c-3ed8-a22a-adf47b8be553",
                                        "glosses": [
                                            "техн. деталь храпового механизма или иных аналогичных устройств, предотвращающая движение другой части механизма в каком-либо направлении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41bcfdc4-ecb7-44a8-b537-cb8c17486d38",
                                                "sense_id": "f3a05ffe-33a7-323e-9cfe-831c61cfd07d",
                                                "text": "Потом поняла, вскочила и мы, шёпотом переговариваясь по обе стороны двери, пытались столовым ножом отжать заклинившуюся «собачку» замка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30808aff-70db-35b4-897e-d561be2283f3",
                                        "entry_id": "55409db3-4a5c-3ed8-a22a-adf47b8be553",
                                        "glosses": [
                                            "то же, что спусковой крючок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c8323ef-98eb-4066-9eab-fa5d0f1169f5",
                                                "sense_id": "30808aff-70db-35b4-897e-d561be2283f3",
                                                "text": "Повернув лошадь, Андрей вынул револьвер и выжидал, держа палец на собачке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6ff6a0-33c4-3fab-bc4f-804c97082bc4",
