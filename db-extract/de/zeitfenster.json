                ],
                "senses": [
                    {
                        "sense_id": "ba957246-275f-38de-9ad6-65a42fc720e4",
                        "entry_id": "16fe8101-20ee-3a56-bfd6-13f3597723de",
                        "glosses": [
                            "zeitlich begrenzter Rahmen, begrenzter Zeitraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d2d2c39-bd3a-4ddd-a02f-46e9cef3fed7",
                                "sense_id": "ba957246-275f-38de-9ad6-65a42fc720e4",
                                "text": "„Studenten kennen das: Scheint das Zeitfenster der Examensarbeit bei der Anmeldung noch komfortabel, sind die letzten Wochen vor der Abgabe oft stressig, wenn man nicht strukturiert arbeitet.“"
                            },
                            {
                                "example_id": "95433f78-853f-448e-9de5-c5d456356419",
                                "sense_id": "ba957246-275f-38de-9ad6-65a42fc720e4",
                                "text": "„Wieder gibt es keine Chance auf einen Platz im Gemeindekindergarten, wieder haben wir das Zeitfenster verpasst.“"
                            },
                            {
                                "example_id": "9f594231-95be-470b-b91c-b749481b4253",
                                "sense_id": "ba957246-275f-38de-9ad6-65a42fc720e4",
                                "text": "„Das gab ihm ein Zeitfenster von ungefähr vierzig Sekunden, gesetzt den Fall, er lief relativ zügig.“"
                            },
                            {
                                "example_id": "1dba49c2-be27-42b4-b71d-33ee5a4aab97",
                                "sense_id": "ba957246-275f-38de-9ad6-65a42fc720e4",
                                "text": "„Das Zeitfenster für die Begrenzung der Erderwärmung auf 1,5 Grad Celsius schließt sich schnell. Nur ein drastischer Wandel könnte die Katastrophe noch abwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
