                                    {
                                        "sense_id": "381b131d-3204-3f9d-b3c4-00ff783016d0",
                                        "entry_id": "63857513-d490-3850-aa26-ba49937af9e8",
                                        "glosses": [
                                            "que merece ser execrado"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af678baa-7a5a-4e4d-99a3-34f7e83d710e",
                                                "sense_id": "381b131d-3204-3f9d-b3c4-00ff783016d0",
                                                "text": "Isso em nada reduz a execrável sordidez da chantagem, mas, sem dúvida, diminui bastante a autoridade moral do chantageado."
                                            }
                                        ]
