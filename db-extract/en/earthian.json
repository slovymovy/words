                "senses": [
                    {
                        "sense_id": "92545811-461d-3a78-b6bc-9875fb93129d",
                        "entry_id": "31527c34-8f34-3dda-aab8-448b9436dc27",
                        "glosses": [
                            "A universal language spoken on Earth."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "df803f9f-b550-4683-b24c-8e4f4a107594",
                                "sense_id": "92545811-461d-3a78-b6bc-9875fb93129d",
                                "text": "I thought the females spoke Earthian to you. Improving their Earthian was why they asked for a couple."
                            },
                            {
                                "example_id": "c0645815-b7fa-43d9-9973-ecab62cf33fb",
                                "sense_id": "92545811-461d-3a78-b6bc-9875fb93129d",
                                "text": "According to Fodor's definition, it follows that 'water' in Twin Earthian means XYZ and not H2O."
                            }
                        ]
                    }
                ],
