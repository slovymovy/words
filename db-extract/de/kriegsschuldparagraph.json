                "senses": [
                    {
                        "sense_id": "7ff9a76d-ea31-3095-817b-b258d854c3da",
                        "entry_id": "6fb87dfb-f1f4-379a-93da-08d6f80eaebb",
                        "glosses": [
                            "Artikel 231 des Versailler Vertrages, der besagt, dass Deutschland und seine Verbündeten die Verantwortung für den Ersten Weltkrieg tragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b1a1ea-cf9b-4cae-8685-c8f35d94a4ad",
                                "sense_id": "7ff9a76d-ea31-3095-817b-b258d854c3da",
                                "text": "„Die heiße Erörterung der Kriegsschuldfrage, die Belastung des deutschen Volkes durch den Kriegsschuldparagraphen veranlaßte die deutsche Regierung zu einer umfassenden Dokumentation der deutschen Politik des Kaiserreiches.“"
                            },
                            {
                                "example_id": "99c429ee-de0b-4672-b1ff-e86db5aa57c0",
                                "sense_id": "7ff9a76d-ea31-3095-817b-b258d854c3da",
                                "text": "„Barnes besuchte Deutschland 1926 für eine Vortragsreise und fand dort für sein Bestreiten der deutschen Kriegsschuld und seine Forderung, die „Schande“ des Kriegsschuldparagraphen im Versailler Vertrag aufzuheben, begeisterte Zustimmung.“"
                            },
                            {
                                "example_id": "1bcf2df4-be85-4a63-9774-dd4d0a8b18c8",
                                "sense_id": "7ff9a76d-ea31-3095-817b-b258d854c3da",
                                "text": "„Der Kriegsschuldparagraph bewirkte, daß der Erste Weltkrieg in Deutschland vorzugsweise unter dem Gesichtspunkt seiner Vorgeschichte betrachtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
