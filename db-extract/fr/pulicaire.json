                "senses": [
                    {
                        "sense_id": "4afafadb-9832-363c-b9a0-fc4ed871b372",
                        "entry_id": "93123859-0b13-37b5-9d81-4b951f98bc33",
                        "glosses": [
                            "Genre de plantes de la famille des Astéracées, à fleurs jaunes, dont une espèce avait la réputation d’éloigner les puces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0384043-33fc-416c-88e3-6172f9ccf10d",
                                "sense_id": "4afafadb-9832-363c-b9a0-fc4ed871b372",
                                "text": "Vlooienkruid, n. [H n.] Herbe aux puces f., plantain pucier ou pulicaire, psyllion m. (Plantago psyllium) ; aunée ou inule pulicaire (Inula pulicaria) ; — pulicaire f. (Pulicaria) ; persicaire f., curage, piment ou poivre d’eau m. (Polygonum hydropiper), herbe au cancer, dentelaire f. (Plumbago europæa), conise ou conyze f. (Conyza). — Chasse-puce, pouliot sauvage m. (Mentha puligium ^([sic]))."
                            },
                            {
                                "example_id": "eb3b7705-d851-4ee1-9d0b-d98bd3190484",
                                "sense_id": "4afafadb-9832-363c-b9a0-fc4ed871b372",
                                "text": "Ce petit hyménoptère butinait sur pulicaire."
                            },
                            {
                                "example_id": "fc197d0b-33da-442a-bb28-820743062381",
                                "sense_id": "4afafadb-9832-363c-b9a0-fc4ed871b372",
                                "text": "Les pulicaires (genre Pulicaria) sont des plantes de la famille des astéracées (ou composées) assez proches des inules."
                            },
                            {
                                "example_id": "48852143-139b-49b8-8cad-7614c8630bd0",
                                "sense_id": "4afafadb-9832-363c-b9a0-fc4ed871b372",
                                "text": "Vlooienkruid, n. [H n.] Herbe aux puces f., plantain pucier ou pulicaire, psyllion m. (Plantago psyllium) ; aunée ou inule pulicaire (Inula pulicaria) ; — pulicaire f. (Pulicaria) ; persicaire f., curage, piment ou poivre d’eau m. (Polygonum hydropiper), herbe au cancer, dentelaire f. (Plumbago europœa), conise ou conyze f. (Conyza). — Chasse-puce, pouliot sauvage m. (Mentha puligium ^([sic]))."
                            },
                            {
                                "example_id": "264ef893-7dcd-4ea9-a828-e2c50858a315",
                                "sense_id": "4afafadb-9832-363c-b9a0-fc4ed871b372",
                                "text": "La pulicaire est une plante vivace qui pousse dans les prairies humides, les marais, les berges et les fossés. Elle fleurit en août et offre aux abeilles du nectar et du pollen."
                            }
                        ]
                    }
