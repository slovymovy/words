                "entry_id": "bb365b44-9cf3-307f-a0b9-85e84e0913d2",
                "word": "cyclohexanol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1ec4049b-1c51-47f6-9597-6719b393c5d4",
                        "entry_id": "bb365b44-9cf3-307f-a0b9-85e84e0913d2",
                        "tags": [
                            "plural"
                        ],
                        "form": "cyclohexanols"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6512b289-31a9-3903-9181-4f15a7b9c33a",
                        "entry_id": "bb365b44-9cf3-307f-a0b9-85e84e0913d2",
                        "glosses": [
                            "Composé organique alcoolique (formule C₆H₁₂O), obtenu par oxydation du cyclohexane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b2cce7-2f9b-4b3e-82cb-a74b08e88721",
                                "sense_id": "6512b289-31a9-3903-9181-4f15a7b9c33a",
                                "text": "Le fonctionnement du réacteur est semi-continu, l’acide nitrique s’alimentant en charge, tandis que le cyclohexanol est alimenté continuellement, sous agitation."
                            },
                            {
                                "example_id": "7e352068-b905-4ec1-be9f-a7dfe989aaff",
                                "sense_id": "6512b289-31a9-3903-9181-4f15a7b9c33a",
                                "text": "La fraction lourde, après élimination des dernières traces de benzène, est soumise à une rectification qui donne en tête la cyclohexylamine pure et en fond de colonne le cyclohexanol et des traces de sous-produits."
                            },
                            {
                                "example_id": "ee55b5e1-ad72-4ea6-833b-aae2e4183cef",
                                "sense_id": "6512b289-31a9-3903-9181-4f15a7b9c33a",
                                "text": "Des céphalées et une irritation des conjonctives peuvent résulter de l’exposition prolongée aux vapeurs de cyclohexanol, mais aucun risque professionnel grave ne s’attache à son utilisation dans l’industrie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7b2408e-455c-4d60-bec8-fc72393fe0e4",
                        "source_entry_id": "bb365b44-9cf3-307f-a0b9-85e84e0913d2",
                        "source_sense_id": "6512b289-31a9-3903-9181-4f15a7b9c33a",
                        "target_lang_word": "Cyclohexanol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cyclohexanol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                                        "entry_id": "adaed540-caad-3f94-bc4c-f6d1f2b08088",
                                        "glosses": [
                                            "brennbare, farblose und kristalline Substanz, die ein einwertiger, zyklischer und sekundärer Alkohol ist – Derivat des Cyclohexans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd4bb2b-0321-4728-a384-a1c60fc70b76",
                                                "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                                                "text": "Cyclohexanol bildet mit Luft ein explosionsfähiges Gemisch."
                                            },
                                            {
                                                "example_id": "7df6976d-a760-44b0-8836-000e39aa3590",
                                                "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                                                "text": "Zur Herstellung von Lacken, Bohnermassen, Schuhcremes und Kunststoffen wird Cyclohexanol verwendet."
                                            },
                                            {
                                                "example_id": "74377bd1-601b-4973-ae66-0bfee1deffd0",
                                                "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                                                "text": "Cyclohexanol ist eine Standardbezugssubstanz in der Gaschromatografie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
