        "fr-extract.jsonl": [
            {
                "entry_id": "eba5af27-d69f-3b43-828a-fd920e36524f",
                "word": "cinquantaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a29db190-e022-4a69-9dec-464999ac785e",
                        "entry_id": "eba5af27-d69f-3b43-828a-fd920e36524f",
                        "tags": [
                            "plural"
                        ],
                        "form": "cinquantaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "917735f3-e9dc-3256-a643-84f56dcc2a2d",
                        "entry_id": "eba5af27-d69f-3b43-828a-fd920e36524f",
                        "glosses": [
                            "Assemblage de choses de même nature au nombre de cinquante environ."
                        ],
                        "tags": [
                            "Terme collectif"
                        ],
                        "examples": [
                            {
                                "example_id": "a9ccf2b7-f3f5-406c-9170-4e0c4ac50b8c",
                                "sense_id": "917735f3-e9dc-3256-a643-84f56dcc2a2d",
                                "text": "Et à deux lieues, dans les hangars de la douane de Mazagan, les matériaux d'un pont en fer, dont la construction avait été décidée il y a une cinquantaine d'années par Sidi Mohammed, s’oxydent et s’écaillent."
                            },
                            {
                                "example_id": "80a899b4-3419-47e8-b785-bdac16d12b4c",
                                "sense_id": "917735f3-e9dc-3256-a643-84f56dcc2a2d",
                                "text": "J’avais pu constater, parmi cette cinquantaine de squales presque noirs, la présence d’un énorme requin blanc sale."
                            },
                            {
                                "example_id": "753f9962-152d-4571-a9f0-d908c27551b1",
                                "sense_id": "917735f3-e9dc-3256-a643-84f56dcc2a2d",
                                "text": "Débarquez ! Y’a une bande de Shiners irlandais qui nous achalent. Venez nous aider, on n’est qu'une cinquantaine et ils sont plus de cent !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e949e0db-02cd-3ec5-b9af-b220985a20a8",
                        "entry_id": "eba5af27-d69f-3b43-828a-fd920e36524f",
                        "glosses": [
                            "Âge de cinquante ans environ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7338b7b-2f92-446f-8d97-55952e6149c2",
                                "sense_id": "e949e0db-02cd-3ec5-b9af-b220985a20a8",
                                "text": "Il venait d'atteindre la cinquantaine et ses cheveux commençaient à peine à s’argenter."
                            },
                            {
                                "example_id": "dd89d0b5-dd68-417b-904b-b083b8664849",
                                "sense_id": "e949e0db-02cd-3ec5-b9af-b220985a20a8",
                                "text": "Elle, les yeux en trou de bite, le cheveu filasse et gras, la face violette, a peut être la cinquantaine, mais les années de bibine comptant double on a vite fait le compte."
                            },
                            {
                                "example_id": "0938710a-f63c-4723-9fe8-d831a4a1ffca",
                                "sense_id": "e949e0db-02cd-3ec5-b9af-b220985a20a8",
                                "text": "En ouvrant la porte du sauna, je tombe sur deux vestons-cravates frisant la cinquantaine qui se frenchkissent sans retenue."
                            }
                        ]
                    },
                    {
                        "sense_id": "608f120d-ccee-3a0f-adda-3d6c9e633ecc",
                        "entry_id": "eba5af27-d69f-3b43-828a-fd920e36524f",
                        "glosses": [
                            "Période de la vie entre 50 et 59 ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c64f0f-cfba-4754-bc48-a8edde5d7d77",
                                "sense_id": "608f120d-ccee-3a0f-adda-3d6c9e633ecc",
                                "text": "Au point où il était parvenu, il n’éprouvait plus qu’un immense dégoût pour le pays plat, décoloré et amer des approches de la cinquantaine."
                            },
                            {
                                "example_id": "994db6b1-baee-4476-ad20-098671a8ff8c",
                                "sense_id": "608f120d-ccee-3a0f-adda-3d6c9e633ecc",
                                "text": "Le barman lui ayant annoncé qu’il ne servait rien avant que le Queen Mary levât l’ancre, il allait retourner dans sa cabine pour échapper au hourvari des coursives, quand un grand Américain dans la cinquantaine, le visage couperosé, les cheveux blancs, les sourcils très fournis d’un noir d’encre, en costume de tussor beige froissé, vint s’asseoir sur le tabouret voisin et commanda un dry Martini."
                            }
                        ]
                    },
                    {
                        "sense_id": "09f7db9b-01d4-3af1-a9ca-6b1e52a3f5bb",
                        "entry_id": "eba5af27-d69f-3b43-828a-fd920e36524f",
                        "glosses": [
                            "Sorte de fête à l’occasion de cinquante années écoulée dans l’état de mariage, dans l’exercice d’une place, etc."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fdd7bd98-811f-4ff3-bbc5-3bd4bd18b1a2",
                                "sense_id": "09f7db9b-01d4-3af1-a9ca-6b1e52a3f5bb",
                                "text": "On a célébré sa cinquantaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6619fdbe-34d1-473a-98c8-d9ca7abc45a7",
