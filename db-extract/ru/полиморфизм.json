                    {
                        "translation_id": "104e59d9-7cf0-4bf5-b32b-93fc51bfe24c",
                        "source_entry_id": "51e9a4e7-5e8e-3bdb-bf09-d0ca8446604f",
                        "target_lang_word": "Polymorphie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polymorphie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b56a1c69-04a2-36cc-8410-0baaf93e4187",
                                        "entry_id": "da39a9fb-0567-3637-9207-a77dff696bf4",
                                        "glosses": [
                                            "Vielgestaltigkeit"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c351e637-c4dd-4d3f-bdfc-9b5bb64a214d",
                                                "sense_id": "b56a1c69-04a2-36cc-8410-0baaf93e4187",
                                                "text": "Polymorphie bezeichnet ja nur verschiedene äußere Formen für das gleiche Ding an sich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11383488-2521-32ab-9510-1058f1ed9b27",
                                        "entry_id": "da39a9fb-0567-3637-9207-a77dff696bf4",
                                        "glosses": [
                                            "das normale Vorkommen prinzipiell unterschiedlich gestalteter Individuen innerhalb einer Art wie beispielsweise die Polymorphie der verschiedenen Kasten bei staatenbildenden Insekten (Arbeiterinnen, Soldaten, Königin)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6399b2-7602-4608-a628-f7382e25671e",
                                                "sense_id": "11383488-2521-32ab-9510-1058f1ed9b27",
                                                "text": "Bei den staatenbildenden Insekten spricht die Biologie von einem \"sozialen Polymorphismus.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b6e1c0c-0960-33f0-946a-6e133a8f930a",
                                        "entry_id": "da39a9fb-0567-3637-9207-a77dff696bf4",
                                        "glosses": [
                                            "das Auftreten einer Genvariation (eines Allels) in einer Population"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a4e8420-f88c-4843-a132-6fd302bddaad",
                                                "sense_id": "4b6e1c0c-0960-33f0-946a-6e133a8f930a",
                                                "text": "Die Vorteile hoher Polymorphie liegen auf der Hand - je höher der Polymorphiegrad eines Systems, desto eher lässt sich die Herkunft eines chromosomalen Segments innerhalb einer Familie eindeutig nachweisen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5cb8b449-ec49-3ea8-9a96-e7a5f25fbec8",
                                        "entry_id": "da39a9fb-0567-3637-9207-a77dff696bf4",
                                        "glosses": [
                                            "die Eigenschaften einiger chemischer Verbindungen in zwei oder mehreren Modifikationen zu kristallisieren"
                                        ],
                                        "tags": [
                                            "Materialwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6f7bea5-33c9-4c15-b0e9-ec1933f57fd3",
                                                "sense_id": "5cb8b449-ec49-3ea8-9a96-e7a5f25fbec8",
                                                "text": "Grund für die Polymorphie der Kristalle ist die Anpassung des Energiezustandes an die herrschende Temperatur."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2a895c1c-0d8c-38e2-87e7-9502229e09ef",
                                        "entry_id": "da39a9fb-0567-3637-9207-a77dff696bf4",
                                        "glosses": [
                                            "der Umstand, dass verschiedene Klassen über Methoden mit demselben Namen verfügen können"
                                        ],
                                        "tags": [
                                            "objektorientierte Programmierung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9919867e-1bab-490f-85e6-10d9d9a6551c",
                                                "sense_id": "2a895c1c-0d8c-38e2-87e7-9502229e09ef",
                                                "text": "Die Polymorphie ist eines der mächtigsten Konzepte der objektorientierten Softwareentwicklung."
                                            },
                                            {
                                                "example_id": "387937ee-2f87-4be4-a34d-6b49470cd9c1",
                                                "sense_id": "2a895c1c-0d8c-38e2-87e7-9502229e09ef",
                                                "text": "Bei Polymorphie der Art „ad-hoc“ kann ein Wert nur endlich viele verschiedene Datentypen besitzen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "06364e14-1394-3c3f-8f8c-576103ba1c14",
                                        "entry_id": "da39a9fb-0567-3637-9207-a77dff696bf4",
                                        "glosses": [
                                            "Vorhandensein von unterschiedlichen sprachlichen Ausdrucksformen für gleiche Bedeutungen oder grammatische Funktionen"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86bd164f-1cec-405c-8452-100f5052d8ea",
                                                "sense_id": "06364e14-1394-3c3f-8f8c-576103ba1c14",
                                                "text": "Die beiden Plurale \"Generale\" - \"Generäle\" kann man als einen Fall von sprachlicher Polymorphie ansehen."
                                            },
                                            {
                                                "example_id": "f0308459-2789-4616-9cec-a04723641254",
                                                "sense_id": "06364e14-1394-3c3f-8f8c-576103ba1c14",
                                                "text": "„Mit Hilfe des vorliegenden Wortmodells lassen sich alle paradigmatischen Relationen des Lexikons beschreiben: unter anderem Monosemie, Polysemie, Homonymie, Multisemie, Synonymie, Polymorphie, partielle Synonymie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1fad32c-94de-4f22-b1a3-aa4cd3fb5f66",
                        "source_entry_id": "51e9a4e7-5e8e-3bdb-bf09-d0ca8446604f",
                        "target_lang_word": "Polymorphismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polymorphismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96e26049-e46d-3c5a-afa7-f1399982b964",
                                        "entry_id": "4e1ee8c1-db31-3dff-bf21-b88cd6a1b457",
                                        "glosses": [
                                            "Auftreten mehrerer Genvarianten innerhalb einer Population"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c50b6053-b88e-490f-a468-e7f7e8e17fa0",
                                                "sense_id": "96e26049-e46d-3c5a-afa7-f1399982b964",
                                                "text": "Wenn solch eine Veränderung häufiger bei mehr als 1 Prozent der Bevölkerung vorkommt, sprechen Experten nicht mehr von einer Mutation, sondern von einem Polymorphismus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f91fe80a-34e4-4c4a-bff6-d4fe88d85e4a",
                        "source_entry_id": "51e9a4e7-5e8e-3bdb-bf09-d0ca8446604f",
                        "target_lang_word": "Vielgestaltigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "24727460-dc77-4464-8950-099b1e54f14f",
                        "source_entry_id": "51e9a4e7-5e8e-3bdb-bf09-d0ca8446604f",
                        "target_lang_word": "polymorphisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymorphisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "256abfc9-6458-3f31-939d-ad78be68a05c",
                                        "entry_id": "33b7ff04-3f80-3fe4-881f-fa03b1239991",
                                        "glosses": [
                                            "Propriété qu’ont certains corps d’affecter des formes très différentes sans changer de nature."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac220752-af36-46ee-8f34-8a85b1ef4fb7",
                                                "sense_id": "256abfc9-6458-3f31-939d-ad78be68a05c",
                                                "text": "Contre les assureurs, les escrocs ont multiplié les attaques avec un polymorphisme remarquable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e687a99d-8390-3242-9656-cd20e6a2676b",
                                        "entry_id": "33b7ff04-3f80-3fe4-881f-fa03b1239991",
                                        "glosses": [
                                            "Présence de différentes formes ou variantes d’un même gène, allèle ou trait au sein d’une population, pouvant être génétique (polymorphisme génétique) ou phénotypique (polymorphisme phénotypique). Ce phénomène est essentiel à la diversité biologique et à l’adaptation des populations."
                                        ],
                                        "tags": [
                                            "Génétique des populations"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a3bdc94-5a26-46f2-9ca6-b49fe9e8768a",
                                                "sense_id": "e687a99d-8390-3242-9656-cd20e6a2676b",
                                                "text": "Les Agaves sont représentés par de très nombreuses espèces; bon nombre, quoique utilisés par les indigènes, sont encore mal connus des botanistes ; cela est dû en général au polymorphisme de ce genre de plante qui a fait, soit confondre nombre de variétés, soit les faire admettre comme espèces distinctes."
                                            },
                                            {
                                                "example_id": "72391fc4-23fa-4ce9-9828-25fd85f8fa71",
                                                "sense_id": "e687a99d-8390-3242-9656-cd20e6a2676b",
                                                "text": "Des erreurs lors de la réplication de l’ADN (mutations) ou des transferts de gènes s'accumulent à fréquence faible mais constante au cours du temps, ce qui augmente progressivement le polymorphisme au sein de chaque écotype."
                                            },
                                            {
                                                "example_id": "93582f26-6323-4174-a8c9-269503b9bbd0",
                                                "sense_id": "e687a99d-8390-3242-9656-cd20e6a2676b",
                                                "text": "Ainsi, les variations environnementales se sont accompagnées d’un polymorphisme du piquant dans les populations naturelles de piment sauvage Capsicum chacoense, parce que les particularités physiologiques relatives à l’utilisation de l’eau sont mêlées à celles qui commandent le piquant, à savoir la production de capsinoïdes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f17ab7-7325-3da9-9c93-bd06c8efa7b6",
                                        "entry_id": "33b7ff04-3f80-3fe4-881f-fa03b1239991",
                                        "glosses": [
                                            "Fait qu’un même corps pur peut cristalliser sous différentes structures cristallines en fonction des conditions de pression et de température. Bien que la composition chimique reste inchangée, l’arrangement des atomes dans le cristal varie, entraînant des différences dans les propriétés physiques, telles que la dureté, la densité ou l’apparence du minéral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bf0740-e757-4f2b-8602-542c1ac8c22b",
                                                "sense_id": "76f17ab7-7325-3da9-9c93-bd06c8efa7b6",
                                                "text": "Concernant le carbone, d’une part, [ Alfred Naquet ] souligne, son polymorphisme - les formes multiples que présente le charbon, le noir de fumée, le noir animal, etc. ; d’autre part, il rapporte les multiples « formes allotropiques » du carbone à des différences d’état : amorphe dans le charbon ordinaire, cristallin octaédrique dans le cas du diamant et rhomboédrique dans le cas du graphite."
                                            },
                                            {
                                                "example_id": "bb4a364c-4bd5-4a0c-baa0-fd6b0f120e91",
                                                "sense_id": "76f17ab7-7325-3da9-9c93-bd06c8efa7b6",
                                                "text": "Il existe deux variétés allotropiques du sulfure de zinc : ZnS blende et ZnS wurtzite. C’est l’exemple pédagogique habituel de l’introduction du polymorphisme, c’est-à-dire de la cristallisation d'une même espèce chimique dans deux systèmes cristallins différents."
                                            },
                                            {
                                                "example_id": "0ae92789-d183-4e4a-9f87-2b00992a8d09",
                                                "sense_id": "76f17ab7-7325-3da9-9c93-bd06c8efa7b6",
                                                "text": "Le terme allotropie se réfère exclusivement aux éléments, pas aux composés. Le polymorphisme est un terme plus large pour tout composé, bien qu’il soit généralement appliqué à des matériaux solides tels que les cristaux. L’allotropie ne fait référence qu’aux formes multiples d’un élément qui existent dans la même phase physique (l’état de la matière, comme un solide, un liquide ou un gaz)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38060fde-d6dc-3021-abca-76b609415354",
                                        "entry_id": "33b7ff04-3f80-3fe4-881f-fa03b1239991",
                                        "glosses": [
                                            "Système de variables et méthodes pouvant être appelés par des classes de différents types."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607df531-bc2c-48a3-a612-8b899c5bcd71",
                                                "sense_id": "38060fde-d6dc-3021-abca-76b609415354",
                                                "text": "En C++, deux ingrédients sont nécessaires au polymorphisme : des méthodes virtuelles, et un appel indirect, par pointeur ou par référence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2275ee46-44d8-321a-aa8e-5d3c4356d90f",
                                        "entry_id": "33b7ff04-3f80-3fe4-881f-fa03b1239991",
                                        "glosses": [
                                            "Qualité des virus qui changent leur méthode de chiffrement à chaque cycle de reproduction."
                                        ],
                                        "tags": [
                                            "Sécurité informatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e222b96-51a5-4f10-9e6a-d1ed519bc85a",
                                                "sense_id": "2275ee46-44d8-321a-aa8e-5d3c4356d90f",
                                                "text": "A la différence du polymorphisme local où le malware modifie son code à chaque fois qu'il est exécuté, le polymorphisme serveur transforme certaines parties du cheval de Troie à chaque téléchargement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
