                        "entry_id": "41365494-67b6-35b9-b473-6b3bf54f8f25",
                        "glosses": [
                            "The central part of the hyoid bone, which is found at the base of the tongue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0738c984-05be-435b-a57b-91a78ae2948a",
                                "sense_id": "d5f04d0d-cc9e-39db-8d4e-5036cfc95318",
                                "text": "Both sutures are passed dorsal to the basihyoid bone, with the most dorsal suture exiting on the ipsilateral side of the lingual process (asterisk) and the most ventral suture on the contralateral side of the lingual process."
                            },
                            {
                                "example_id": "5ccfd121-04f6-4986-ac39-ee9999146ea1",
                                "sense_id": "d5f04d0d-cc9e-39db-8d4e-5036cfc95318",
                                "text": "From the basihyoid, however, it extends dorsally to wrap around the M. sternothyroideus before returning ventrally and curving under the M. episternocleidomastoideus toward the scapula (Herrel et al., 2001b; Meyers et al., 2002)"
                            }
                        ]
                    }
