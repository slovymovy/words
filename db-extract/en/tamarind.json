                                                "example_id": "dcf9746c-52f1-415b-9dd6-74103893b734",
                                                "sense_id": "657aa17f-371d-37fa-84fe-8c3a648d8003",
                                                "text": "Après avoir traversé Sambarala, village situé sur la rivière, nous continuâmes notre trajet sur un terrain sablonneux, couvert d’une végétation vigoureuse, et entre autres arbres, de tamariniers."
                                            },
                                            {
                                                "example_id": "e97e8c01-9422-4957-806e-d8e281249f11",
                                                "sense_id": "657aa17f-371d-37fa-84fe-8c3a648d8003",
                                                "text": "Hadé officie sous le tamarinier, assise sur un tabouret en bois de néré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
