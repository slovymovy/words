                ],
                "senses": [
                    {
                        "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                        "entry_id": "572869a8-c9fb-3d69-b895-0652f382846c",
                        "glosses": [
                            "Person, die beruflich eine Gondel – ein spezielles venezianisches Boot für Lasten und Personen – lenkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73000a66-1e32-4211-b4e1-def8b7b05e5e",
                                "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                                "text": "„Dann stellt sich der Gondoliere auf seinen Platz, stößt ab und leitet mit lautlosen Ruderschlägen das Boot durch den schmalen Kanal; kleine runde Wellen schlagen gluckernd gegen die Planken.“"
                            },
                            {
                                "example_id": "d54d6be5-29f6-4baf-86b1-280b8eeaeaa1",
                                "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                                "text": "„Unter mehreren Gondolieri, die Proviant heranführten, fiel mir einer auf, der sich Biagio nannte.“"
                            },
                            {
                                "example_id": "40e27761-c7e8-44be-898f-7d67f7a853a8",
                                "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                                "text": "„Sie schlief und dämmerte durch die Tage, sie hörte die rauen Rufe der Gondolieri bis spät in die Nacht und das Klatschen der festgemachten Gondeln an der Riva degli Schiavoni.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b861cf5-021c-4ecd-ae19-02334cdf8f1e",
                        "source_entry_id": "572869a8-c9fb-3d69-b895-0652f382846c",
