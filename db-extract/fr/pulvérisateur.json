                "senses": [
                    {
                        "sense_id": "b91bbbc3-70b2-35e9-a4de-81e2daa2f708",
                        "entry_id": "655d57a4-671f-3600-9428-658285e988ff",
                        "glosses": [
                            "Qui pulvérise, qui réduit en morceaux, en particules, en gouttelettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b19837-4aa0-4fff-8d8a-d481034da468",
                                "sense_id": "b91bbbc3-70b2-35e9-a4de-81e2daa2f708",
                                "text": "Médicament dosé dans un flacon pulvérisateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "c086b57a-8151-3534-bd97-1b75d619181c",
                        "entry_id": "655d57a4-671f-3600-9428-658285e988ff",
                        "glosses": [
                            "Qui permet la pulvérisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a926ce1a-f365-44e5-a0bd-58cb749e82e8",
                                "sense_id": "c086b57a-8151-3534-bd97-1b75d619181c",
                                "text": "Les foyers des machines sont alimentés, à l’aide d’un appareil pulvérisateur, par les résidus qui proviennent de la distillation de ce naphte que Bakou et Derbent fournissent d’une façon inépuisable."
                            }
                        ]
                    }
                ],
