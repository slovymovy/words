                "senses": [
                    {
                        "sense_id": "28cd8db2-4ce7-3c56-b41a-ab4fb290f948",
                        "entry_id": "3c3db3fc-5444-3702-9c91-0302225ff85f",
                        "glosses": [
                            "Person, die den Vorsitz im Rat innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5acacec-fecb-40ee-884f-8b37c417fc4e",
                                "sense_id": "28cd8db2-4ce7-3c56-b41a-ab4fb290f948",
                                "text": "Der Ratsvorsitzende eröffnete die Sitzung."
                            },
                            {
                                "example_id": "4ab0078a-b288-4be4-b4de-dbeb3043d9e5",
                                "sense_id": "28cd8db2-4ce7-3c56-b41a-ab4fb290f948",
                                "text": "„Bischof Huber, auch Ratsvorsitzender der Evangelischen Kirche in Deutschland (EKD), sagte, Ostern sei als Fest der Versöhnung und des Lebens ein wichtiges Hoffnungszeichen für Menschen in Krisengebieten wie Irak, Nahost und Kosovo.“"
                            }
                        ],
