                        "sense_id": "a8021a90-ab2e-3231-92fc-4d3876ad174c",
                        "entry_id": "b918608f-20d1-3a33-b329-bd55a3948d0b",
                        "glosses": [
                            "Unité de longueur utilisée en astronomie, correspondant à la distance parcourue par la lumière dans le vide en une minute. Une minute-lumière vaut environ 18 gigamètres."
                        ],
                        "tags": [
                            "Moins courant"
                        ],
                        "examples": [
                            {
                                "example_id": "356b5b9d-3053-46be-91b1-f1433709ca5e",
                                "sense_id": "a8021a90-ab2e-3231-92fc-4d3876ad174c",
                                "text": "Puisque Mars est à environ trois minutes-lumière de la Terre et Jupiter quarante minutes-lumière (selon la position exacte des planètes), la communication entre des vaisseaux spatiaux se dirigeant dans sa direction et des contrôleurs situés sur Terre est retardée de façon significative."
                            },
                            {
                                "example_id": "3432338f-8a9a-472e-a146-8df3e92f2512",
                                "sense_id": "a8021a90-ab2e-3231-92fc-4d3876ad174c",
                                "text": "Le Soleil est à un peu plus de huit minutes-lumière de la Terre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dddbbf4-d4b2-45f7-ad27-de98161bfa3d",
