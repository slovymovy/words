                        "sense_id": "118fd4b4-e6a8-3e05-a813-002693cea53f",
                        "entry_id": "123c2ffe-5299-335d-84b1-c1943d2bf285",
                        "glosses": [
                            "An operator which modifies its operand, and which therefore is not the identity."
                        ],
                        "tags": [],
                        "examples": [
                            {
