                                "target_senses": [
                                    {
                                        "sense_id": "75664729-7890-3108-8a6d-8faf86138fa1",
                                        "entry_id": "fe83216b-c609-3d58-8a79-12aed2ff959f",
                                        "glosses": [
                                            "действие по значению гл. владеть; обладание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d34ff1e-516d-41c9-a09c-e3561739e528",
                                                "sense_id": "75664729-7890-3108-8a6d-8faf86138fa1",
                                                "text": "Я снова вступил во владение часами, но удовольствия оно мне не доставило никакого."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9ae0ce-c1fe-35ab-ab18-ec02b6c9fa87",
                                        "entry_id": "fe83216b-c609-3d58-8a79-12aed2ff959f",
