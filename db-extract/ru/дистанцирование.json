                    {
                        "translation_id": "38c25996-5f3a-4208-80a4-fda03262a2f3",
                        "source_entry_id": "2b9e0009-b104-3d03-881b-79e50e7ab5eb",
                        "target_lang_word": "Distanzierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Distanzierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56106af2-665f-3072-9a10-19e73cfafbc2",
                                        "entry_id": "dc355f68-d6f9-34dc-9c65-1b89b2664b67",
                                        "glosses": [
                                            "Erklärung, dass man etwas nicht akzeptiert oder mit etwas nicht übereinstimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0c51f7f-d0f6-4d52-b3fd-8ea2d8460d60",
                                                "sense_id": "56106af2-665f-3072-9a10-19e73cfafbc2",
                                                "text": "Seine Distanzierung von den Gerüchten klang nicht überzeugend."
                                            },
                                            {
                                                "example_id": "ef7e3372-8ae6-4fe5-aec5-b94dc95f7f5f",
                                                "sense_id": "56106af2-665f-3072-9a10-19e73cfafbc2",
                                                "text": "„Diese diplomatisch verklausulierte Formulierung war eine deutliche Distanzierung.“"
                                            },
                                            {
                                                "example_id": "cdd634f1-9434-421e-a0a4-a73ad93f2c7f",
                                                "sense_id": "56106af2-665f-3072-9a10-19e73cfafbc2",
                                                "text": "[Elias Studer:] „»Es wäre Zeit, dass von der SVP eine Distanzierung von rechtsextremen Kreisen kommt.«“"
                                            },
                                            {
                                                "example_id": "70663c40-dba3-416e-b07f-1c4ce8f086e3",
                                                "sense_id": "56106af2-665f-3072-9a10-19e73cfafbc2",
                                                "text": "[Werner Schneider:] „»Der Islam gibt mir partout keine Auskunft darüber, was er von Selbstmordattentätern hält. Mir fehlt die Distanzierung islamischer Geistlicher zu den Motiven der Anschläge«, sagte er der Deutschen Presse-Agentur.“"
                                            },
                                            {
                                                "example_id": "6249fa1b-0696-4880-9afc-b2e577bc4370",
                                                "sense_id": "56106af2-665f-3072-9a10-19e73cfafbc2",
                                                "text": "„Martin Walser hatte zuletzt mit der Distanzierung von seiner umstrittenen Rede zur Verleihung des «Friedenspreis des deutschen Buchhandels» 1998 von sich reden gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                        "entry_id": "dc355f68-d6f9-34dc-9c65-1b89b2664b67",
                                        "glosses": [
                                            "(räumlicher oder sozialer) Abstand (beispielsweise zwischen zwei Personen oder Personengruppen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4004596-d8f7-4a29-8818-403efda56e0c",
                                                "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                                "text": "Wir sollen uns in der Coronakrise nicht sozial distanzieren, angeordnet ist von der Regierung nur eine physische Distanzierung. Im Gegenteil: Ruft Eure Liebsten an, skypt mit Euren Freunden, trinkt zusammen über zwei Balkone hinweg ein Bier, ein Glas Wein oder singt zusammen."
                                            },
                                            {
                                                "example_id": "51d5894a-b864-4d3f-b807-af039045255d",
                                                "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                                "text": "Distanzierung ist auf Kriegsschiffen und U-Booten kaum möglich."
                                            },
                                            {
                                                "example_id": "367cd448-e5bf-4cf3-aaff-9109fe85d175",
                                                "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                                "text": "„Kontaktverbote führen zu Isolierung und Distanzierung.“"
                                            },
                                            {
                                                "example_id": "6b129d85-1d5a-4bbb-8b40-778a9076eeb4",
                                                "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                                "text": "„Um es mal plakativ zu sagen: Wer seinen Nächsten liebt, der bleibt ihm jetzt fern. Jedenfalls körperlich. Das meinen ja die Virologen mit Distanzierung. Ganz wörtlich: Keine überflüssige Nähe, keine Berührungen. Keine großen Menschenansammlungen.“"
                                            },
                                            {
                                                "example_id": "3c98b707-34ac-4711-9b62-0aea290f7133",
                                                "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                                "text": "[Schlagzeile:] „COVID-19: Wie stark wirkt sich die Distanzierung auf das Erkrankungsrisiko aus?“"
                                            },
                                            {
                                                "example_id": "b8e3a124-9077-42d1-bfef-f593d533435e",
                                                "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                                "text": "„Distanzierung ist das zentrale Gebot in der Coronakrise.“"
                                            },
                                            {
                                                "example_id": "a43d60f4-93c9-41d5-8311-fbba1fdb872f",
                                                "sense_id": "dd333a61-ad70-304e-a98a-cbb927e39312",
                                                "text": "„Räumliche Distanzierung ist das Gebot der Stunde. Um einen Kollaps des Gesundheitswesens zu vermeiden, können wir alle derzeit nicht viel mehr tun, als direkte menschliche Kontakte so stark wie möglich einzuschränken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bd34f77-42df-4d9a-9fac-a9f78ff69af9",
                        "source_entry_id": "2b9e0009-b104-3d03-881b-79e50e7ab5eb",
                        "target_lang_word": "dystansowanie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4201c236-a489-427c-9e6f-40fc832e19a0",
                        "source_entry_id": "2b9e0009-b104-3d03-881b-79e50e7ab5eb",
                        "target_lang_word": "distanciation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distanciation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                        "entry_id": "1940a663-e09f-309f-b910-af6bf7ce6341",
                                        "glosses": [
                                            "Fait de mettre de la distance entre soi et une action effectuée ou une parole prononcée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08bafbf1-58ad-494f-8670-4833a5503a4f",
                                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                                "text": "L’énonciation est un processus de médiation qui engage une logique de distanciation, que l’on peut appeler la distance sémiotique."
                                            },
                                            {
                                                "example_id": "136d156f-bfb8-44b6-a5c1-37f6bd3466f3",
                                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                                "text": "Ainsi, dans le champ théâtral contemporain, la distanciation est « un procédé de mise à distance de la réalité représentée : celle-ci apparaît alors sous une perspective nouvelle qui en révèle le côté caché ou devenu trop familier »."
                                            },
                                            {
                                                "example_id": "3f391f4c-0739-4e2c-aff6-a06344cbee51",
                                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                                "text": "La distanciation constitue-t-elle une forme de réflexivité spécifique à la lecture littéraire ? Ou, à l'inverse, la réflexivité du lecteur n'est-elle qu'une dimension de la distanciation du sujet par rapport à soi, aux autres et au monde ?"
                                            },
                                            {
                                                "example_id": "fb696380-85b2-4cd5-a2e2-9241adff7888",
                                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                                "text": "Au-delà de ce risque politique, les distanciations géographiques, économiques, cognitives et politiques, génèrent une crise de confiance des mangeurs vis-à-vis de leur système alimentaire, accentuée par les asymétries de pouvoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10459ebd-c0c2-3198-9b02-2df17221dba5",
                                        "entry_id": "1940a663-e09f-309f-b910-af6bf7ce6341",
                                        "glosses": [
                                            "(2020, par apocope de distanciation sociale ou distanciation physique.) Action de garder un espace (généralement deux mètres) entre soi et les autres pour éviter la contamination par virus."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91353ce9-db46-47e9-a287-8f2d00e36236",
                                                "sense_id": "10459ebd-c0c2-3198-9b02-2df17221dba5",
                                                "text": "Voilà ce qui arrive à l’homme qui ridiculisait la distanciation et le port du masque."
                                            },
                                            {
                                                "example_id": "fcfeb11d-c6a5-442d-94ae-847a5383d11d",
                                                "sense_id": "10459ebd-c0c2-3198-9b02-2df17221dba5",
                                                "text": "À bien des égards, le confinement, et les mesures de distanciation physique, ont contribué à une reconnaissance accrue de l’importance de l’espace public comme lieu de rassemblement et d’équipement essentiel à la satisfaction des besoins primaires de la population."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
