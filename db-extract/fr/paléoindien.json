                "word": "Paléoindien",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98f3192e-6d72-3f76-9688-7486832ea4e9",
                        "entry_id": "e822b9c1-6b76-3182-a540-35e6624946d0",
                        "glosses": [
                            "Période de la préhistoire du continent américain, correspondant aux premiers peuplements humains avérés."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "93bffbd0-3b91-4cbd-a601-1228c704d6f4",
                                "sense_id": "98f3192e-6d72-3f76-9688-7486832ea4e9",
                                "text": "Une attention particulière sera accordée aux occupations du Paléoindien ancien (associées aux pointes à cannelures) puisque celles-ci, contrairement aux occupations du Paléoindien récent (associées à des pointes sans cannelures), ont été largement privilégiées par la recherche."
                            },
                            {
                                "example_id": "46f361f1-0e46-4ec0-ab09-f6abe3e4cbdf",
                                "sense_id": "98f3192e-6d72-3f76-9688-7486832ea4e9",
                                "text": "Le Paléoindien ancien est une longue période qui s’échelonne entre 13 000 et 11 600 ans avant aujourd’hui."
                            }
                        ]
                    }
