        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01af8af5-f99e-3704-9b4e-02b96478d153",
                    "sense_definition": "Meervoud van <w>wiek</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grote <w>wieken</w> van de molen draaien langzaam in de wind.",
                            "target_lang_translations": {
                                "en": "The large <w>sails</w> of the mill turn slowly in the wind."
                            }
                        },
                        {
                            "text": "De vogel spreidde zijn <w>wieken</w> en vloog hoog boven de bomen.",
                            "target_lang_translations": {
                                "en": "The bird spread its <w>wings</w> and flew high above the trees."
                            }
                        }
                    ],
                    "synonyms": [
                        "vleugels"
                    ],
                    "common_phrases": [
                        "draaiende wieken",
                        "wieken van de molen"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'wiek'; refers to the sails or blades of a windmill, or poetically to the wings of a bird."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sails",
                                "target_lang_sense_clarification": "of a windmill"
                            },
                            {
                                "target_lang_word": "blades",
                                "target_lang_sense_clarification": "of a windmill"
                            },
                            {
                                "target_lang_word": "wings",
                                "target_lang_sense_clarification": "poetic or literary use for birds"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f6a0aa6-b17f-30b7-b256-93bebdb5cb58",
                    "sense_definition": "Het aanpassen van de zeilvoering op de wieken van een windmolen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "molentechniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De molenaar moet de molen zorgvuldig <w>wieken</w> om de juiste snelheid te behouden.",
                            "target_lang_translations": {
                                "en": "The miller must carefully <w>adjust the sails</w> of the mill to maintain the correct speed."
                            }
                        },
                        {
                            "text": "Bij een sterke storm is het essentieel om correct te <w>wieken</w> voor de veiligheid.",
                            "target_lang_translations": {
                                "en": "During a strong storm, it is essential to <w>reef the sails</w> correctly for safety."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de molenbouw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The technical process of adjusting the sails or cloths on a windmill's blades to manage wind intake."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to set the sails",
                                "target_lang_sense_clarification": "adjusting windmill sails"
                            },
                            {
                                "target_lang_word": "to reef",
                                "target_lang_sense_clarification": "reducing sail area on a windmill"
                            }
                        ]
                    }
                }
            ]
        },
        {
