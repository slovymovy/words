                    {
                        "sense_id": "0b72e221-c57a-3a56-b701-1db6fba36383",
                        "entry_id": "58770c6a-e5b0-35e6-a25f-14d28727d208",
                        "glosses": [
                            "Se dit de tout élément dont le nombre atomique est supérieur à celui de l’uranium (92)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cfeec61-4279-4a39-90ac-e905ad2bbf7a",
                                "sense_id": "0b72e221-c57a-3a56-b701-1db6fba36383",
                                "text": "La plupart des éléments transuraniens n’existent que brièvement dans la nature."
                            }
                        ]
                    },
                    {
                        "sense_id": "06704ea5-6283-3433-9fff-42fc5a3277f0",
                        "entry_id": "58770c6a-e5b0-35e6-a25f-14d28727d208",
                        "glosses": [
                            "Se dit de tout objet céleste se trouvant au-delà de l’orbite d’Uranus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8492ee65-3b7b-49fe-af9e-63fafe4c0d0d",
                                "sense_id": "06704ea5-6283-3433-9fff-42fc5a3277f0",
                                "text": "À partir de ces estimés, il recalcula l’orbite d’Uranus en tenant compte des caractéristiques imaginaires de l’astre transuranien, et constata que cette fois, positions observées et positions calculées coïncidaient presque parfaitement : Neptune était née dans le cerveau de Le Verrier."
                            }
                        ]
                    }
