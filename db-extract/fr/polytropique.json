                                        "sense_id": "244a3e66-f47e-380b-b2b7-da3fcf7af67f",
                                        "entry_id": "690623ca-8d7e-3df1-be20-1571dd221490",
                                        "glosses": [
                                            "Focusing one’s attention on multiple sets of things at one time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "099c10ba-9b28-4e53-8ac2-9943a5227b6a",
                                                "sense_id": "244a3e66-f47e-380b-b2b7-da3fcf7af67f",
                                                "text": "Our hypothesis is that the difference between autistic and non-autistic is a difference in the strategies employed in the distribution of scarce attention. That is to say, it is the difference between having few interests highly aroused, the monotropic tendency, and having many interests less highly aroused, the polytropic tendency. An aroused interest is an interest charged with feeling."
                                            },
                                            {
                                                "example_id": "45333557-2868-4556-bbb2-a5050d312619",
                                                "sense_id": "244a3e66-f47e-380b-b2b7-da3fcf7af67f",
                                                "text": "Where polytropic minds comfortably entertain many simultaneous interests, each moderately aroused, the monotropic mind will maintain only very few simultaneous interests, with each one highly aroused and intensely focused upon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b19bf5f-6680-366c-ab32-dfa40915c697",
                                        "entry_id": "690623ca-8d7e-3df1-be20-1571dd221490",
                                        "glosses": [
                                            "Of bees: visiting a wide circle of flowers."
                                        ],
