                "senses": [
                    {
                        "sense_id": "ed94b3b0-450b-3cfd-96f8-3d273f5605d2",
                        "entry_id": "a2cbf212-76ed-3e69-a20a-0f4b6762e1ec",
                        "glosses": [
                            "Prendre le maquis."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f1d1db87-6d98-4c21-97e8-0ecbc5ef5e54",
                                "sense_id": "ed94b3b0-450b-3cfd-96f8-3d273f5605d2",
                                "text": "Contraint finalement à maquiser, le commandant Huet, ayant pris conscience des possibilités du terrain, écrivait dans un message à Goderville : « Changez fréquemment de place. La forêt domaniale est un abri à toute épreuve. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "64d0b592-c87a-3d97-a818-6ebe8fcba193",
                        "entry_id": "a2cbf212-76ed-3e69-a20a-0f4b6762e1ec",
                        "glosses": [
                            "Aller le soir dans des maquis (établissements où on peut danser)."
                        ],
                        "tags": [
                            "Burkina-Faso"
                        ],
                        "examples": [
                            {
                                "example_id": "657b5543-9f63-4d74-a318-6345673f5e45",
                                "sense_id": "64d0b592-c87a-3d97-a818-6ebe8fcba193",
                                "text": "Les jeunes commencent à « maquiser », c’est-à-dire à aller dans les boites de nuit, les bars dancing, faire la fête, en fait s’éclater dans les lieux de distractions."
                            },
                            {
                                "example_id": "c78248d7-0feb-462f-9a91-dab7cdcc5591",
                                "sense_id": "64d0b592-c87a-3d97-a818-6ebe8fcba193",
                                "text": "On va pouvoir maquiser à mort."
                            }
                        ]
                    }
                ],
