{
    "word_family": [
        "protocolaire",
        "protocolarité",
        "protocoliser",
        "protocolisation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d98c4aec-4b83-3a9e-98fe-1a52ae6c013a",
                    "sense_definition": "Ensemble de règles, de consignes ou d'étapes prédéfinies à suivre scrupuleusement dans une procédure médicale, scientifique ou de sécurité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hôpital a mis en place un nouveau <w>protocole</w> de soins pour traiter les urgences."
                        },
                        {
                            "text": "En cas d'incendie, tout le personnel doit impérativement suivre le <w>protocole</w> de sécurité."
                        }
                    ],
                    "synonyms": [
                        "procédure",
                        "méthode"
                    ],
                    "common_phrases": [
                        "suivre le protocole",
                        "protocole de sécurité",
                        "protocole de soins",
                        "protocole expérimental"
                    ]
                },
                {
                    "sense_id": "9c2622aa-9a47-3df4-b079-58d1f69d4aaa",
                    "sense_definition": "Ensemble des règles de bienséance, d'étiquette et de préséance observées lors des cérémonies officielles ou des réceptions diplomatiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etiquette",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lors de la visite du président étranger, chacun devait respecter le <w>protocole</w> avec minutie."
                        },
                        {
                            "text": "Selon le <w>protocole</w>, les invités sont placés à table selon leur rang hiérarchique."
                        }
                    ],
                    "synonyms": [
                        "étiquette",
                        "cérémonial"
                    ],
                    "common_phrases": [
                        "respecter le protocole",
                        "selon le protocole",
                        "chef du protocole"
                    ]
                },
                {
                    "sense_id": "06f6a8ab-754f-3cd8-8896-ef9a7b892ee4",
                    "sense_definition": "Ensemble de normes et de règles informatiques définissant les échanges d'informations entre différents appareils connectés en réseau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce logiciel utilise un <w>protocole</w> de communication sécurisé pour chiffrer les données sensibles."
                        },
                        {
                            "text": "Le technicien vérifie que le <w>protocole</w> réseau permet le transfert fluide des fichiers vers le serveur."
                        }
                    ],
                    "synonyms": [
                        "norme"
                    ],
                    "common_phrases": [
                        "protocole de communication",
                        "protocole réseau"
                    ]
                },
                {
                    "sense_id": "36a046ce-2351-3d31-8e97-4111098be3df",
                    "sense_definition": "Document officiel ou accord international complétant, précisant ou modifiant un traité préalable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les représentants des deux pays ont finalement signé un <w>protocole</w> d'accord commercial."
                        },
                        {
                            "text": "Ce nouveau texte constitue un <w>protocole</w> additionnel rattaché à la convention internationale."
                        }
                    ],
                    "synonyms": [
                        "accord",
                        "convention",
                        "avenant"
                    ],
                    "common_phrases": [
                        "protocole d'accord",
                        "signer un protocole"
                    ]
                }
            ]
        }
    ]
}