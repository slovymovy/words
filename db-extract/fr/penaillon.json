                        "examples": [
                            {
                                "example_id": "062a139d-c72c-4373-93f0-a97c05529c69",
                                "sense_id": "c9ae0d74-36e8-34fd-acac-af68c8d235c8",
                                "text": "Nostre Seigneur veult, entendez vous bien? que nous mangeons nostre pain en la sueur de nos corps: non par rien ne faisans, comme ce penaillon de moine que voyez, frère Ian qui boyt, & meurt de paour."
                            },
                            {
                                "example_id": "60086437-befe-49f4-9c97-ffb8f4485f07",
                                "sense_id": "c9ae0d74-36e8-34fd-acac-af68c8d235c8",
                                "text": "Tout penaillon y vante sa besace,\n Son institut, ses miracles, sa crasse;\n Mais, en secret l'un de l'autre jaloux,\nModestement ils se détestent tous."
                            }
                        ]
                    }
