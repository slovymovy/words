                    ]
                },
                {
                    "sense_id": "c0054680-6e1f-399a-a326-17a3b0c4e2e1",
                    "sense_definition": "Mode de gouvernement autoritaire qui recourt à la violence extrême, aux menaces et aux sanctions impitoyables pour soumettre une population.",
