                ],
                "senses": [
                    {
                        "sense_id": "195c728a-1a9b-31d3-8ed7-7607a3678673",
                        "entry_id": "2c3b8a05-2155-3ca7-9ceb-d07c8e156563",
                        "glosses": [
                            "Untersuchung eines Textes unter bestimmten Gesichtspunkten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6bb2905-017e-4fcc-b2fc-6dc149df1dd9",
                                "sense_id": "195c728a-1a9b-31d3-8ed7-7607a3678673",
                                "text": "Textanalysen können sehr verschiedenen Interessen dienen; in der Kriminologie kann es z.B. darum gehen, herauszufinden, wer der Autor eines anonymen Textes sein könnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb9d9014-438d-3e11-bd48-62fcd908e4a2",
                        "entry_id": "2c3b8a05-2155-3ca7-9ceb-d07c8e156563",
                        "glosses": [
                            "Untersuchung eines bestimmten Textes daraufhin, was gerade diesen Text zu einem Text macht, also auf seine Textualität hin."
                        ],
                        "tags": [
                            "speziell Textlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "af80681f-3fc1-47ce-9bb0-a738d64b1512",
                                "sense_id": "eb9d9014-438d-3e11-bd48-62fcd908e4a2",
                                "text": "In der Linguistik kann es bei der Textanalyse darum gehen, welche Kohärenzen und Kohäsionen dazu beitragen, dass ein bestimmtes Schriftstück tatsächlich ein \"Text\" ist."
                            },
                            {
                                "example_id": "3e42daab-bb3e-46a6-b287-87fcae0fba52",
                                "sense_id": "eb9d9014-438d-3e11-bd48-62fcd908e4a2",
                                "text": "„Die Aufgabe der Textanalyse besteht gerade darin, auch latente Bewegungen und Strukturierungen im Text zu erfassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
