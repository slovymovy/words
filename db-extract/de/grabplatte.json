                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05845555-9704-4add-b9ac-2a96ee17000a",
                                "sense_id": "e5c4c4a0-9bbc-3987-b3ca-9a9d31580e28",
                                "text": "„In dieser Ecke des Kreuzganges neben der Krypta über den Grabplatten wurden damals die verstorbenen Mönche vor dem Begräbnis aufgebahrt.“"
                            },
                            {
                                "example_id": "adf9b2a1-d485-421e-b643-9d580a5d2477",
                                "sense_id": "e5c4c4a0-9bbc-3987-b3ca-9a9d31580e28",
                                "text": "„Die siebzehn Grabplatten weckten meine Aufmerksamkeit.“"
                            },
                            {
                                "example_id": "ef333902-db59-4fda-b6a5-189aae57a70d",
                                "sense_id": "e5c4c4a0-9bbc-3987-b3ca-9a9d31580e28",
                                "text": "„Im Aufblitzen des Wetterleuchtens sehe ich die Grabplatte für den Selbstmörder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
