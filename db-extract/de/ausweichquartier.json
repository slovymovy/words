                        "examples": [
                            {
                                "example_id": "6080f22d-1482-4684-9ce0-1f0635f72cbe",
                                "sense_id": "42993e7d-8e7c-3871-984b-c9f2ef58f7eb",
                                "text": "„1990/1991 diente das Grand Hotel nach Adaptierung des Erdgeschosses durch Walter Micheller vorübergehend der Casinos Austria AG als Ausweichquartier, als der Spielbetrieb im Esterházypalais während dessen Umbaus unterbrochen werden musste (Eröffnung 1. Juli 1990).“"
                            },
                            {
                                "example_id": "1b8a6dd2-e5b9-4118-a7d6-b06dd637788f",
                                "sense_id": "42993e7d-8e7c-3871-984b-c9f2ef58f7eb",
                                "text": "„Sie beschlossen, ins Gasthaus im George-Washington-Hof zu gehen, um dort über ein Ausweichquartier zu beraten.“"
                            }
                        ],
