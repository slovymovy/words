                ],
                "senses": [
                    {
                        "sense_id": "5c651a43-5a96-308f-bad0-8b60d993b7c8",
                        "entry_id": "34ad05b0-5a34-3062-8393-91f301aa0a99",
                        "glosses": [
                            "gouverneur van een land of een provincie die als vervanger van de monarch optreedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fafa6c0-3812-47a4-93c6-3875c6fabb4b",
                                "sense_id": "5c651a43-5a96-308f-bad0-8b60d993b7c8",
                                "text": "Omdat de koning uitgesloten is van de formatie, heeft Nederland zijn ‘onderkoning’ van stal gehaald. Herman Tjeenk Willink wacht de zware taak het politieke catenaccio te overstijgen."
                            },
                            {
                                "example_id": "bf1c084d-731c-4f72-b026-2333fc0139cc",
                                "sense_id": "5c651a43-5a96-308f-bad0-8b60d993b7c8",
                                "text": "Het is ook moeilijk voor te stellen om Anderson te accepteren in een dociele rol. Neem haar recente vertolking van Lady Mountbatten. Aan de zijde van haar man, die erop uit isgestuurd om de splitsing van India in twee staten in goede banen te leiden, staat de echtgenote van de onderkoning veel steviger in haar schoenen dan hij. ,,Lord Mountbatten was in politiek opzicht niet erg sterk’’, constateert Anderson. ,,Hij was niet opgewassen tegen Churchill die alles al van tevoren had uitgedokterd. Zijn vrouw was niet zo naïef. Zij doorgrondde alles veel eerder.’’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc1cd02a-7d8c-4219-9f03-2cfd0c3dd2d8",
                        "source_entry_id": "34ad05b0-5a34-3062-8393-91f301aa0a99",
                        "source_sense_id": "5c651a43-5a96-308f-bad0-8b60d993b7c8",
                        "source_sense_description": "gouverneur van een land of een provincie die als vervanger van de monarch optreedt",
                        "target_lang_word": "Vizekönig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vizekönig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                        "entry_id": "15c03e77-f615-3c66-9c2c-05524a16f47e",
                                        "glosses": [
                                            "Person, die einen Monarchen vertritt, Stellvertreter eines Monarchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447387f1-6649-4a63-928e-a4df0462aefd",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Der berühmte indische Poet Mohammed Eqbal beschrieb Afghanistan als das ‹Herz Asiens›, während Lord Curzon, der britische Vizekönig Indiens im frühen 20. Jahrhundert, Afghanistan den ‹Hahnenkampfplatz Asiens› nannte.“"
                                            },
                                            {
                                                "example_id": "d1432b87-9ddb-4914-8a2a-e760ce978988",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Und der Taiko persönlich hatte unseren Vizekönig in Manila gebeten, Franziskanermönche sowie einen Gesandten nach Japan zu schicken.“"
                                            },
                                            {
                                                "example_id": "bbc76af3-0620-4392-8aa6-4c82bbf4f797",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Cortés befand sich zu der Zeit in Spanien, und es war noch offen, wer zum Vizekönig, zum Repräsentanten des Königs, ernannt werden würde.“"
                                            },
                                            {
                                                "example_id": "d1644b15-97ec-40a4-b869-3fcbf508a9e0",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Sie haben sich schnell an die neuen Verhältnisse der spanischen Kolonialgesellschaft angepasst und diese bald schon ihrerseits mitgeprägt, wenn auch nur als Untertanen der Vizekönige in Mexiko und des spanischen Königs im fernen Europa.“"
                                            },
                                            {
                                                "example_id": "6536f1de-cce3-4939-8f79-c0a63eb9915d",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Der Codex Mendoza entstand um 1541 im Auftrag des spanischen Vizekönigs und enthielt eine aztekische Darstellung der eigenen Geschichte sowie wichtige Informationen zur Verwaltung und Organisation des Reichs der Mexica.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83522e48-ee0b-4b1d-bf6c-14e90fc78d3a",
                        "source_entry_id": "34ad05b0-5a34-3062-8393-91f301aa0a99",
