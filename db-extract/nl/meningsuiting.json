                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbdfe564-fa96-4612-8f7d-599784ba8ba9",
                                "sense_id": "6ebaa09d-5d6c-351a-8fde-1a29acc7b66a",
                                "text": "Het recht op vrije meningsuiting, zonder angst voor vervolging, staat expliciet vermeld in de Universele verklaring van de rechten van de mens"
                            },
                            {
                                "example_id": "078a817e-fcc6-4b4b-97ff-8985dc23a663",
                                "sense_id": "6ebaa09d-5d6c-351a-8fde-1a29acc7b66a",
                                "text": "het grootste gevaar dat uitgaat van regressieve linksen is, dat zij bereid zijn de vrijheid van meningsuiting op te offeren uit angst minderheden te kwetsen"
                            },
                            {
                                "example_id": "d30f423f-1295-4ec4-adb2-00eb8af885b2",
                                "sense_id": "6ebaa09d-5d6c-351a-8fde-1a29acc7b66a",
                                "text": "Volgens de Algemene Nederlandse Vereniging van Reisondernemingen (ANVR) en reisorganisatie TUI heeft de luchtvaart nauwelijks invloed op de luchtkwaliteit in Den Haag en is een lokaal verbod op fossiele reclames daarom niet zinvol. Ook vonden ze het verbod in strijd met de vrijheid van meningsuiting en de vrijheid van ondernemerschap."
                            }
                        ]
                    }
