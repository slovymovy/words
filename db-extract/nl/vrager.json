                                            {
                                                "example_id": "0493d4a1-d498-4a9e-970f-2ea3032dca9e",
                                                "sense_id": "787863f0-2b82-3083-b01b-61891523b8df",
                                                "text": "„Und der Frager verstand, daß Helena den Sederabend mit ihrer Familie feiern würde.“"
                                            },
                                            {
                                                "example_id": "fecb3c32-177e-40c4-9c8f-491e668a8475",
                                                "sense_id": "787863f0-2b82-3083-b01b-61891523b8df",
                                                "text": "„Die Antwort klingt unbefangen, aber der Frager hat doch einen verstohlenen Blick bemerkt, den seine Gastfreunde wechselten, einen ganz kurzen nur, aber der hat sein Mißtrauen anwachsen lassen.“"
                                            },
                                            {
                                                "example_id": "da9d53e3-edde-4ef3-95e2-c8e58cd8478a",
                                                "sense_id": "787863f0-2b82-3083-b01b-61891523b8df",
                                                "text": "„Er richtet seine Augen ernst, mit mildem Vorwurf auf den Frager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
