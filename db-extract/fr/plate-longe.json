                "forms": [
                    {
                        "form_id": "1480c1d8-a4d2-46ce-8812-d579b71468c9",
                        "entry_id": "404c1377-80b7-3301-b992-4e2401b25eee",
                        "tags": [
                            "plural"
                        ],
                        "form": "plates-longes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75c81532-ac58-3005-acfe-67323855952c",
                        "entry_id": "404c1377-80b7-3301-b992-4e2401b25eee",
                        "glosses": [
                            "Longe plate et longue qui sert à maintenir les chevaux difficiles, quand on les ferre ou quand on leur fait subir quelque opération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "945a616a-9e24-48c9-8f75-afad03c4256c",
                                "sense_id": "75c81532-ac58-3005-acfe-67323855952c",
                                "text": "Outre la contention des membres postérieurs par des plates-longes et l'application d'un tord-nez, deux aides se placent de chaque côté de la croupe de La jument, face à elle."
                            }
                        ]
                    },
                    {
                        "sense_id": "e655d09d-5f0d-3a3b-9bd9-4216bfb2bd29",
                        "entry_id": "404c1377-80b7-3301-b992-4e2401b25eee",
                        "glosses": [
                            "Longe faite d’un cuir très large et d’une seule pièce, ou refendu en deux, que l’on ajoute au harnais sur la croupe des chevaux attelés pour les empêcher de ruer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ea57c240-4d42-3f55-a1c6-625af086e127",
                        "entry_id": "404c1377-80b7-3301-b992-4e2401b25eee",
                        "glosses": [
                            "Corde ou courroie avec laquelle un écuyer qui est à pied fait trotter un cheval en rond."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2218af07-3c0b-4760-881f-e580afc05150",
                                "sense_id": "ea57c240-4d42-3f55-a1c6-625af086e127",
                                "text": "Trotter, faire trotter un cheval à la plate-longe."
                            },
                            {
                                "example_id": "14a4cf29-8d77-4c7a-855d-116f7349ecf9",
                                "sense_id": "ea57c240-4d42-3f55-a1c6-625af086e127",
                                "text": "Moi, sans quitter la plate-longe,\nSans le lâcher, je lui montrais\nLe pré charmant, couleur de songe,\nOù le vers rit sous l’antre frais."
                            }
                        ]
                    }
