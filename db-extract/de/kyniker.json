                "senses": [
                    {
                        "sense_id": "199d9897-9cf4-3684-81a3-f38ae1548efb",
                        "entry_id": "4b087292-7304-3503-a660-f15903babcaf",
                        "glosses": [
                            "Anhänger des Kynismus; Person, die einer antiken Philosophenschule angehört, die Bedürfnislosigkeit von ihren Schülern forderte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abde08db-8d8a-44d9-a0c4-dfdb1df88260",
                                "sense_id": "199d9897-9cf4-3684-81a3-f38ae1548efb",
                                "text": "„Die Kyniker betonten, daß wirkliches Glück nicht von Äußerlichkeiten wie materiellem Luxus, politischer Macht oder guter Gesundheit abhänge.“"
                            },
                            {
                                "example_id": "bfbfd0bf-ac6a-43d3-a1ad-6374c99542b9",
                                "sense_id": "199d9897-9cf4-3684-81a3-f38ae1548efb",
                                "text": "„Peregrin hatte allerlei in dieser Hinsicht durchprobiert und durchgemacht, und das Ende seines Lebens war eine öffentliche Selbstverbrennung bei den Olympischen Spielen des Jahres 165, angeblich um zu demonstrieren, dass ein Kyniker keinen Schmerz fürchte und, wer an ein glückliches Jenseits glaube, den Tod nicht zu fürchten habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "745dee6a-1499-4be9-9a18-aeaaebbbc729",
