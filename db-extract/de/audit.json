                "senses": [
                    {
                        "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                        "entry_id": "9f279317-5f22-33df-bee7-d4cec4d5137c",
                        "glosses": [
                            "unabhängige und genaue Überprüfung von Aufzeichnungen, Aktivitäten oder Ähnlichem, um festzustellen, ob bestehende Richtlinien und vorgegebene Verfahrensweisen eingehalten werden, und um notwendige Veränderungen zu empfehlen"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f8967976-6804-4eab-96d2-9dd46aa10058",
                                "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                                "text": "„Heute werden in fast allen Bereichen von Unternehmen oder Organisationen von Zeit zu Zeit Audits durchgeführt […]“"
                            },
                            {
                                "example_id": "fe00363b-8231-4a73-9180-755f2f7be99f",
                                "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                                "text": "„Zwar gilt innerhalb eines Konzerns weltweit der gleiche Audit. Aber im länderübergreifenden Qualitätsvergleich wenden die Konzerne einen Umrechnungsfaktor an, der Gewichtungsunterschiede amerikanischer und europäischer Käuferpräferenzen ausgleicht.“"
                            },
                            {
                                "example_id": "c6dd80a3-4f7c-44fa-80c7-2120dec51ac6",
                                "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                                "text": "„Ratschläge oder Aussagen ‚Bei uns wird das ganz anders gemacht…!‘ sind tödlich für einen Audit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b9e429f-2e5c-3967-80a7-bf436485201d",
                        "entry_id": "9f279317-5f22-33df-bee7-d4cec4d5137c",
                        "glosses": [
                            "für bestimmte Leistungen in einem Bereich verliehene Auszeichnung an Unternehmen, Organisationen, Kommunen oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
