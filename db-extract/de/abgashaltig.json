                ],
                "senses": [
                    {
                        "sense_id": "036e5734-7c72-3320-81a2-530fe2904c81",
                        "entry_id": "c569bced-d9cd-3ef7-b7d5-1e10f78a3d3b",
                        "glosses": [
                            "(schädliche) Abgase aufweisend, enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7811d400-aed0-4bff-9165-9fb94659b718",
                                "sense_id": "036e5734-7c72-3320-81a2-530fe2904c81",
                                "text": "„Sehr gewöhnungsbedürftig, immerhin machte mir die abgashaltige Luft keine Beschwerden, hoffentlich blieb das auch so.“"
                            },
                            {
                                "example_id": "0c638b3f-9285-45fd-9e82-1654cc47505f",
                                "sense_id": "036e5734-7c72-3320-81a2-530fe2904c81",
                                "text": "„Auch einen Garten oder eine Terrasse hätte ich ganz nett gefunden, obwohl Freilufthochzeiten wegen der abgashaltigen Außenluft eher nicht die Regel sind.“"
                            },
                            {
