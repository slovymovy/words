                "senses": [
                    {
                        "sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                        "entry_id": "a28fe55b-45e3-3e9f-b37c-18bfe090cc6e",
                        "glosses": [
                            "Person, die ihre Nachtruhe regelmäßig schon zu früher Stunde beendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711ef829-da25-4a25-a614-476893a3da9f",
                                "sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                                "text": "Egon ist ein Frühaufsteher. Spätestens um 6 Uhr ist er fit wie ein Turnschuh."
                            },
                            {
                                "example_id": "b55d4073-3f12-4891-9450-c47c39188b23",
                                "sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                                "text": "„Frühaufsteher reden nicht nur sehr wenig mit Fremden, sie sprechen auch kaum miteinander.“"
                            },
                            {
                                "example_id": "c3115231-a647-4628-ba42-b7a1acaf9600",
                                "sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                                "text": "„Er war ein Frühaufsteher und Tausendsassa, ein funkensprühender Feuerkopf.“"
                            },
                            {
                                "example_id": "fb8b7d60-7a88-4691-b7b0-ff57fdc9f04a",
                                "sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                                "text": "„Und ich bin zum Frühaufsteher geworden.“"
                            },
                            {
                                "example_id": "6bd3dd4f-70be-4571-ad9e-f1b6f4894978",
                                "sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                                "text": "„Ich sehe einige Frühaufsteher.“"
                            },
                            {
                                "example_id": "412c0cfd-1de8-48da-8cba-009e81d52bc6",
                                "sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                                "text": "„Einige Neandertaler-Gene, die bei heutigen Menschen erhalten sind, machen uns zu Frühaufstehern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80392a01-49f0-4bc7-bc16-ae00cd6b195c",
                        "source_entry_id": "a28fe55b-45e3-3e9f-b37c-18bfe090cc6e",
                        "source_sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                        "source_sense_description": "Person, die ihre Nachtruhe regelmäßig schon zu früher Stunde beendet",
                        "target_lang_word": "early bird",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "early bird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da038255-dd47-307f-9acd-bdac40568074",
                                        "entry_id": "a3e810ca-05d4-3010-859d-075f28b667b6",
                                        "glosses": [
                                            "A person who wakes early or arrives early, typically before most others."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aa9032b-7ce2-4602-995a-3918cc3c698e",
                                                "sense_id": "da038255-dd47-307f-9acd-bdac40568074",
                                                "text": "If you’re a bird, be an early bird— But if you’re a worm, sleep late."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1f1bb2d-9f52-486e-8bf3-266ebb494b18",
                        "source_entry_id": "a28fe55b-45e3-3e9f-b37c-18bfe090cc6e",
                        "source_sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
                        "source_sense_description": "Person, die ihre Nachtruhe regelmäßig schon zu früher Stunde beendet",
                        "target_lang_word": "early riser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "early riser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e45f18-52f6-3f04-a8d9-3e59f587f5f6",
                                        "entry_id": "a9e79bfd-bd0e-3a23-bccb-56069caaf347",
                                        "glosses": [
                                            "Someone who rises (gets up) early in the morning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b596498f-167a-4f6d-a994-03e76e714386",
                                                "sense_id": "c1e45f18-52f6-3f04-a8d9-3e59f587f5f6",
                                                "text": "I was surprised to see him asleep at 10:00, as he's normally such an early riser."
                                            },
                                            {
                                                "example_id": "aa63603c-b431-4e96-8f2c-90f2b27b1312",
                                                "sense_id": "c1e45f18-52f6-3f04-a8d9-3e59f587f5f6",
                                                "text": "As we strolled along admiring the many-masted vessels, an old man, an early riser and doubtless a poor sleeper (as so many old people are) stopped us."
                                            },
                                            {
                                                "example_id": "5277561e-67ed-422b-95f2-ecb0c8874f5b",
                                                "sense_id": "c1e45f18-52f6-3f04-a8d9-3e59f587f5f6",
                                                "text": "An hour's pause in the journey, wherein early Risers may practise, each day, upon a diff'rent set of Travelers. Flirting? Cards? Coffee and Chatter? the Hope is for a productive, when not amusing, Hour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6c8a507-2afe-4019-8add-df07c07830ed",
                        "source_entry_id": "a28fe55b-45e3-3e9f-b37c-18bfe090cc6e",
                        "source_sense_id": "01743a19-b0c3-3727-98c0-3acaf97258b2",
