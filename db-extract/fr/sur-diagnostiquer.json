                ],
                "senses": [
                    {
                        "sense_id": "0075bb17-f184-3238-9bb6-e90e857a0a0a",
                        "entry_id": "20df509c-65da-3d7f-b96d-73bee5f7abb2",
                        "glosses": [
                            "Diagnostiquer plus souvent que ce qu’il faudrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27c967ed-27cc-41b0-9b56-6351b7ac5dc3",
                                "sense_id": "0075bb17-f184-3238-9bb6-e90e857a0a0a",
                                "text": "Tel est notre état d'esprit actuel, ce qui ne nous interdit pas de penser et de dire que l'asthme ne doit pas être « sur-diagnostiqué » et, par là, « sur-traité »."
                            },
                            {
                                "example_id": "24889dbc-b427-4338-9569-045c1ff591ea",
                                "sense_id": "0075bb17-f184-3238-9bb6-e90e857a0a0a",
                                "text": "Le fait qu'il n'existe aucun groupe de référence normatif pour illustrer les variations du fonctionnement normal chez les personnes âgées encourage la tendance à sur-diagnostiquer la pathologie chez celles-ci."
                            }
                        ]
                    }
                ],
