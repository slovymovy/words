                            },
                            {
                                "target_lang_word": "атрофия",
                                "target_lang_sense_clarification": "уменьшение органа или ткани в объеме"
                            },
                            {
                                "target_lang_word": "увядание",
                                "target_lang_sense_clarification": "постепенная потеря жизненных сил"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                    "sense_definition": "To use money, time, or resources in a way that is not useful or sensible.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inefficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't <w>waste</w> your breath trying to explain it to him; he won't listen.",
                            "target_lang_translations": {
                                "ru": "Не <w>трать</w> слова попусту, пытаясь объяснить ему это; он не станет слушать."
                            }
                        },
                        {
                            "text": "We <w>wasted</w> a lot of money on a car that keeps breaking down.",
                            "target_lang_translations": {
                                "ru": "Мы <w>выбросили</w> много денег на машину, которая постоянно ломается."
                            }
