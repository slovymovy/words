                    {
                        "sense_id": "0739079b-186f-3927-8b5e-073054cdc417",
                        "entry_id": "c88c06a2-6f58-3b8a-a1ba-cb54feefcd7c",
                        "glosses": [
                            "een Angelsaksische lengtemaat: 1 Engelse mijl is circa 1,6 kilometer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8354271b-4f36-41eb-bf6c-b07e978f9ba6",
                                "sense_id": "0739079b-186f-3927-8b5e-073054cdc417",
                                "text": "Ik had het idee al uren te hebben gelopen, maar ik bleek pas 1 mijl, oftewel 1,6 kilometer, in de benen te hebben."
                            },
                            {
                                "example_id": "b189bc56-4180-4b1b-8a05-426a8f1c3234",
                                "sense_id": "0739079b-186f-3927-8b5e-073054cdc417",
                                "text": "Mentaal was het nogal omschakelen van kilometers naar mijlen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6b99ef3-fab4-315b-b858-3ee8e3323f66",
                        "entry_id": "c88c06a2-6f58-3b8a-a1ba-cb54feefcd7c",
                        "glosses": [
                            "een verouderde lengtemaat die in verschillende landen gebruikt werd"
                        ],
                        "tags": [
