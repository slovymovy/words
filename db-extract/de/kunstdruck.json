                        "examples": [
                            {
                                "example_id": "18f0a5d2-ac44-4130-b336-15d6b046d1d6",
                                "sense_id": "e9fa9ab5-6040-388c-926f-59183f3ad973",
                                "text": "„Geld für Originale hatte ja kaum jemand, und so kaufte man sich in den Fünfzigerjahren Kunstdrucke, rahmte sie und hängte sie sich an die Wand.“"
                            }
                        ],
