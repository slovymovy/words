                ],
                "senses": [
                    {
                        "sense_id": "3ee75151-59c3-364f-9f29-b3153ec7d0b0",
                        "entry_id": "a181a199-5078-3d81-a1ef-a14c59ee66c3",
                        "glosses": [
                            "iemand die met onbeperkte oppermacht regeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd06b94-6af2-4ec5-b489-45df48683529",
                                "sense_id": "3ee75151-59c3-364f-9f29-b3153ec7d0b0",
                                "text": "De alleenheerser werd gehaat door zijn volk."
                            },
                            {
                                "example_id": "daf60252-c4a4-40eb-b2c7-c66e8bef8280",
                                "sense_id": "3ee75151-59c3-364f-9f29-b3153ec7d0b0",
                                "text": "Vance wordt gezien als degene die logica achter Trumps impulsieve buitenlandbeleid heeft weten te formuleren. Daarin zijn alleen Amerikaanse belangen relevant, is voor rechtvaardigheid geen plek, hoeven democratieën niet verdedigd te worden en is het beste zaken te doen met alleenheersers"
                            },
                            {
                                "example_id": "f93de57a-1fb6-4f85-8715-fe646ee7c5c6",
                                "sense_id": "3ee75151-59c3-364f-9f29-b3153ec7d0b0",
                                "text": "'En als er nu een alleenheerser de baas is over de staat en aan de burgers voorschrijft wat zij moeten doen, is dat dan ook een wet?' Ook dat wat een alleenheerser schriftelijk vastlegt, wordt een wet genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f93d2e1-027f-4e1a-b980-23198de30ae5",
                        "source_entry_id": "a181a199-5078-3d81-a1ef-a14c59ee66c3",
                        "source_sense_id": "3ee75151-59c3-364f-9f29-b3153ec7d0b0",
                        "source_sense_description": "iemand die met onbeperkte oppermacht regeert",
                        "target_lang_word": "Alleinherrscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alleinherrscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "215c1da4-8a43-3359-b297-fea485cdcb9b",
                                        "entry_id": "579897f5-f03c-3441-b910-cea96d6f3f0f",
                                        "glosses": [
                                            "Person, die uneingeschränkt herrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339bc746-4df4-4abc-8952-6916aa7904de",
                                                "sense_id": "215c1da4-8a43-3359-b297-fea485cdcb9b",
                                                "text": "„Er hat sich zum unumschränkten Alleinherrscher entwickelt und ein ehedem blühendes Land in den Ruin gewirtschaftet.“"
                                            },
                                            {
                                                "example_id": "c1e70c3f-4348-491a-a23b-8ca42ba3ec0d",
                                                "sense_id": "215c1da4-8a43-3359-b297-fea485cdcb9b",
                                                "text": "„Plötzlich ist es stockdunkel, mitten in der Nacht. Und es träumt mir, ich sei Alleinherrscher, ein wunderbarer, sympathischer, liebevoller Alleinherrscher, wie ihn die Weltgeschichte bisher noch nicht gekannt hat und der für sein Volk nur das Beste will.“"
                                            },
                                            {
                                                "example_id": "da5241da-f97f-4aef-bfcb-45dd980143c9",
                                                "sense_id": "215c1da4-8a43-3359-b297-fea485cdcb9b",
                                                "text": "„Die Nachfolge-Frage ist die große Sorge jeder Diktatur; sie wird aber dort ganz besonders problematisch, wo der Diktator nicht so sehr als unumschränkter Alleinherrscher, sondern vielmehr als der allseits anerkannte Vermittler zwischen divergierenden Teilhabern an der führenden Elite fungiert, die er allein dank seiner Persönlichkeit zusammenzuhalten vermag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
