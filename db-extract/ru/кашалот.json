                    {
                        "translation_id": "bdcbb2c4-37eb-4883-a801-d2dcd4b0ff61",
                        "source_entry_id": "b2c49f4f-ab22-3553-a256-5764035570d9",
                        "source_sense_id": "7bc194c7-32c7-3a37-845e-2495c1b77867",
                        "target_lang_word": "cachalot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cachalot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                        "entry_id": "aaf686f8-fb16-3bda-b169-1d44bb0b2970",
                                        "glosses": [
                                            "Espèce de mammifère marin, cétacé à dents à grosse tête carrée, de la famille des physétéridés."
                                        ],
                                        "tags": [
                                            "Cétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e87a48c4-c1ef-42a8-8b66-11bda427d537",
                                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                                "text": "Pendant que sous la mer profonde\nLes cachalots et les requins\nCes écumeurs géants de l’onde\nLibres dévorent le fretin\nNous autres cloués à la rive\nOù la bourrasque a rejeté\nNotre barque un instant rétive\nNous pleurons notre liberté."
                                            },
                                            {
                                                "example_id": "120bfb33-389d-4fcf-b4db-23b4c28a8814",
                                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                                "text": "Lorsque la marée se retire, on voit des écueils à perte de vue sortant des flots leurs dos de monstres, tout reluisants et blanchis d’écume, comme des cachalots gigantesques échoués."
                                            },
                                            {
                                                "example_id": "1a4766fe-e1d2-44f7-9c32-1f3908b0d82b",
                                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                                "text": "Vers le soir, j’aperçois un cachalot qui disparaît vers l’Ouest."
                                            },
                                            {
                                                "example_id": "3963a8cf-edf9-49a5-b073-d5749e75e9b7",
                                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                                "text": "Il était grand et gros, lent dans ses paroles et ses mouvements ; les étudiants l'avaient surnommé le Cachalot (« féroce et vorace »), car il était cruel, ambitieux et avide d'honneurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
