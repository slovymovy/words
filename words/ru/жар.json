                },
                {
                    "sense_id": "ceb94bde-2de1-347d-8275-06fddd3f6549",
                    "sense_definition": "Сильное внутреннее возбуждение, душевный подъём, страстность.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты с <w>жаром</w> обсуждали новую идею профессора.",
                            "target_lang_translations": {
