                        "glosses": [
                            "Flug, bei dem über längere Zeit die Orientierung verloren geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a308e9-5061-43d8-9dde-d833b1ec63c5",
                                "sense_id": "0776feed-dee8-3bbc-9354-57ecc747133d",
                                "text": "„Nach einem längeren Irrflug musste die später als „Lost Squadron“ benannte Gruppe nach Grönland zurückkehren, konnte jedoch wegen Treibstoffmangels keinen Flugplatz erreichen.“"
                            },
                            {
                                "example_id": "bf759c78-d254-43b1-966d-c3cfe0795465",
                                "sense_id": "0776feed-dee8-3bbc-9354-57ecc747133d",
                                "text": "„Die Boeing 737-200 mit 54 Menschen an Bord krachte nach einem stundenlangen Irrflug über Amazonien in den Urwald.“"
                            }
                        ],
