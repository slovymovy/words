                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51ea1678-1076-41c0-93d3-0b39f4209cf4",
                        "source_entry_id": "34e49f05-5e92-34e6-bed6-586c5726019a",
                        "source_sense_id": "9653a90e-c554-3897-9bd8-e4bbe76026e2",
                        "source_sense_description": "Einrichtung zum Wohnen (und Lernen) auf dem Land",
                        "target_lang_word": "foyer rural",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foyer rural",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c53ca8ea-e88b-35a5-964f-90cb6fd3d4da",
                                        "entry_id": "56617561-af5a-3174-86d6-4dd60bacbd23",
                                        "glosses": [
                                            "Organisation de culture et de loisirs dans les villages ruraux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "947677b2-0c29-4a04-9cfe-346649c3b1d9",
                                                "sense_id": "c53ca8ea-e88b-35a5-964f-90cb6fd3d4da",
                                                "text": "En 1956, 1 044 Foyers ruraux étaient agréés, 1 300 en 1965 ; en 1968, la Fédération nationale des Foyers ruraux (FNFR) comptait 900 Foyers, 100 000 adhérents et environ 500 000 sympathisants."
                                            },
                                            {
                                                "example_id": "95c0e0ea-d998-4514-9d20-4969132ea143",
                                                "sense_id": "c53ca8ea-e88b-35a5-964f-90cb6fd3d4da",
                                                "text": "Le président du foyer rural secondé par un responsable tennis se porte candidat, mais il demande des volontaires pour s'en occuper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ccbf59-46b7-306c-8e4b-6fd8ff4299d9",
                                        "entry_id": "56617561-af5a-3174-86d6-4dd60bacbd23",
                                        "glosses": [
                                            "Bâtiment communal qui accueille les activités culturelles ou de loisir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2510b47-02fa-49cf-bfb1-55e6a3f0c46b",
                                                "sense_id": "72ccbf59-46b7-306c-8e4b-6fd8ff4299d9",
                                                "text": "Le principal lieu culturel de la ville est le foyer rural, toute l'année des activités s'y déroulent: cours d'arts plastiques, de calligraphie chinoise ou de sculpture, expositions, rencontres et animations."
                                            },
                                            {
                                                "example_id": "5efdec1a-c664-4302-bdbf-0bf46f97ba39",
                                                "sense_id": "72ccbf59-46b7-306c-8e4b-6fd8ff4299d9",
                                                "text": "Lors des manifestations au foyer rural, il traînait toujours dans les environs de la salle, les effluves festives l'ayant averti qu'il se tramait quelque chose d'intéressant et, aussitôt les gens ou les invités partis, il entrait prêter ses mains noires pour aider à débarrasser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
