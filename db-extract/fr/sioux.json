                                    {
                                        "sense_id": "d820e6f3-f0b0-33c3-b8d4-7c5168079863",
                                        "entry_id": "5745ee4b-9486-3a7a-aadd-be79f56fb8b6",
                                        "glosses": [
                                            "Angehöriger/Angehörige eines nordamerikanischen Indianervolkes ohne Aussage über das natürliche Geschlecht; im Plural auch kollektiv: Volk/Stamm der Sioux"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3653b4c-27d1-4dae-a55b-5e99aeea211f",
                                                "sense_id": "d820e6f3-f0b0-33c3-b8d4-7c5168079863",
                                                "text": "Kein Sioux ist hier vorbeigekommen."
                                            },
                                            {
                                                "example_id": "54a37d7a-00ec-424b-9eb9-42465fd14419",
                                                "sense_id": "d820e6f3-f0b0-33c3-b8d4-7c5168079863",
                                                "text": "Ich kann die Person in der Ferne nicht genau erkennen, ist es ein Sioux?"
                                            },
                                            {
                                                "example_id": "b05af723-d5f5-45c7-83c3-69ece9db5c1f",
                                                "sense_id": "d820e6f3-f0b0-33c3-b8d4-7c5168079863",
                                                "text": "Die Sioux bestanden ursprünglich aus 7 Stämmen, die die Allianz \"Oceti Sakowin\" bildeten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11ddd663-b77d-3b1d-aff2-3b0e5f207752",
                                        "entry_id": "5745ee4b-9486-3a7a-aadd-be79f56fb8b6",
                                        "glosses": [
                                            "männlicher Angehöriger des nordamerikanischen Indianervolkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a760f79d-12bd-48e0-ae94-8bd43eeddd0d",
                                                "sense_id": "11ddd663-b77d-3b1d-aff2-3b0e5f207752",
                                                "text": "Der alte Sioux kannte seine Frau schon als Mädchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sioux",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
