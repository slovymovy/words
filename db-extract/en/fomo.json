                        "entry_id": "1971104c-b220-35ea-b9be-cc13ca7706a7",
                        "glosses": [
                            "To experience FOMO (“fear of missing out”); to act on one's FOMO, often impulsively [(often) with into]."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e0c87c7d-2956-4684-b606-a94ea3bd7104",
                                "sense_id": "2afb62e3-eaa3-31dd-9f32-a9603cbe2d89",
                                "text": "Within hours of selling out, AfroDroids NFTs started getting flipped on OpenSea for thousands of dollars, with new investors FOMO-ing into the project in case it became the newest PFP project to go to the moon."
                            }
                        ]
