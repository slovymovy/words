                                "target_senses": [
                                    {
                                        "sense_id": "ef1ee91b-4638-33f3-9cc0-0ca7dc82e68c",
                                        "entry_id": "bc2714ba-ee13-3bf2-ae08-f0d8f75efbad",
                                        "glosses": [
                                            "Île des Petites Antilles située en mer des Caraïbes non loin de sa limite avec l’océan Atlantique, un peu à l’est du reste des îles du Vent."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19c14826-e6d3-4d89-9f65-fb391ca19a7f",
                                                "sense_id": "ef1ee91b-4638-33f3-9cc0-0ca7dc82e68c",
                                                "text": "À cette époque, aucun établissement ne fut fondé sur la Barbade, aucun colon ne s’y installa, même à titre provisoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0753a843-6ace-36cd-876f-f08f28fd5293",
                                        "entry_id": "bc2714ba-ee13-3bf2-ae08-f0d8f75efbad",
                                        "glosses": [
                                            "Pays occupant cette île, et dont la capitale est Bridgetown. Micro-Etat de 300 000 habitants en 2024."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b9116d6-e227-492e-9ef6-7a926271a5f4",
                                                "sense_id": "0753a843-6ace-36cd-876f-f08f28fd5293",
                                                "text": "Le gouvernement de la Barbade a annoncé l'an dernier qu'il remplacerait la monarchie par un gouvernement de style républicain ce novembre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
