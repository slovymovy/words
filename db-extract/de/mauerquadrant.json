                ],
                "senses": [
                    {
                        "sense_id": "7d2f3c7c-1a34-34c5-9d91-dc22bbf01d95",
                        "entry_id": "cce395f3-1f9f-3f26-9cc9-f3d44629991c",
                        "glosses": [
                            "astronomisches Instrument zum Messen von Höhenwinkeln und Positionen von Gestirnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8ce30a0-e027-4acb-8059-54f10c4a8d74",
                                "sense_id": "7d2f3c7c-1a34-34c5-9d91-dc22bbf01d95",
                                "text": "„Ein Mauerquadrant, der Vorläufer des Meridiankreises, ist ein Viertelkreis mit einem beweglichen Fernrohr, der an einer nord-süd ausgerichteten Mauer montiert ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "595ed2c0-3f11-3eb7-a7f3-fcc31cbbd216",
                        "entry_id": "cce395f3-1f9f-3f26-9cc9-f3d44629991c",
                        "glosses": [
                            "historisches Sternbild, das im Sternbild des Bärenhüters aufging"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ead72e14-c758-4da3-b601-fec8e7cc1fa9",
                                "sense_id": "595ed2c0-3f11-3eb7-a7f3-fcc31cbbd216",
                                "text": "„Dieses Sternbild ist, so wie der Mauerquadrant, erst in neuerer Zeit von dem Astronomen de la Lande eingeführt.“"
                            },
                            {
                                "example_id": "fc2e54bb-c4c5-4fe9-a479-c728fbb56bf1",
                                "sense_id": "595ed2c0-3f11-3eb7-a7f3-fcc31cbbd216",
                                "text": "„Die Eidechse, von Hevel, die Friedrichsehre, von Bode im Jahr 1787, die Jagdhunde, von Hevel, und der Mauerquadrant, von Lalande aufgestellt, enthalten sämmtlich nur kleinere Sterne.“"
                            },
                            {
                                "example_id": "f3709ed1-251f-45c4-a87f-c4551c844cf9",
                                "sense_id": "595ed2c0-3f11-3eb7-a7f3-fcc31cbbd216",
                                "text": "„Der Bootes oder Bärenhüter und der Berg Mänalus hat nördlich den Mauerquadranten und Drachen, östlich den Herkules, nördliche Krone, Schlange und Wage, südlich die Jungfrau und westlich die Haarlocke der Berenice und den großen Bären um sich.“"
                            },
                            {
                                "example_id": "afecdbd8-b51e-47b2-9f7d-ae6302692960",
                                "sense_id": "595ed2c0-3f11-3eb7-a7f3-fcc31cbbd216",
                                "text": "„Lalande hat 1775 den Erntehüter, Messier, als neues Sternbild eingeführt, um Messier’s Verdienste zu ehren, ebenso 1795 den Mauerquadranten, um das Andenken an das Instrument zu erhalten, mit dem sein Neffe den Grund zum ersten grossen Fixsterncataloge legte.“"
                            },
                            {
                                "example_id": "8b12f03d-b3f2-4d95-b239-3201c616b1f0",
                                "sense_id": "595ed2c0-3f11-3eb7-a7f3-fcc31cbbd216",
                                "text": "„Nach und nach kamen durch andere Astronomen hinzu: […], der Mauerquadrant, […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
