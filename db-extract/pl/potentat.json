                "senses": [
                    {
                        "sense_id": "e30f0c4d-49c7-3dc8-8cd6-e4372e806fda",
                        "entry_id": "925f2f84-5e5e-3b5a-8f12-eae48645fac3",
                        "glosses": [
                            "osoba lub instytucja o wysokiej pozycji i znaczeniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76478f97-7cde-41f0-bfbc-9f8545a6c8bb",
                                "sense_id": "e30f0c4d-49c7-3dc8-8cd6-e4372e806fda",
                                "text": "Fabryczkę kupił austriacki potentat stalowy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0f78da73-432a-3dc5-8950-b31fb8e38406",
                        "entry_id": "925f2f84-5e5e-3b5a-8f12-eae48645fac3",
                        "glosses": [
