                        "entry_id": "521f75d4-ccb6-399c-919f-d93cab9f6a47",
                        "glosses": [
                            "abwertend: Teil der Presse, der mit unsachlichen und verleumderischen Meldungen an niedrige Instinkte der Leser appelliert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9067eff2-5dbf-4586-af69-613a2266acce",
                                "sense_id": "bb233c23-6ed6-3432-ae2e-19151078bf7d",
                                "text": "\"Verstümmelte Frauenleiche nach Feuer auf Müllkippe gefunden\", titelt die Sensationspresse nach dem Fund."
                            },
                            {
                                "example_id": "8e3431b7-b3a4-40f6-a8a1-3f46d8c37bf4",
                                "sense_id": "bb233c23-6ed6-3432-ae2e-19151078bf7d",
                                "text": "„Mein altes Mißtrauen gegen das Urteil der Sensationspresse über den türkischen Sultan ward dadurch zwar nicht besonders verstärkt, aber auch nicht ausgerottet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
