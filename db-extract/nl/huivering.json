                    },
                    {
                        "translation_id": "4c240982-9e64-41c7-8514-2d9362c9cfb2",
                        "source_entry_id": "a9e7d266-eb10-3e81-8297-17e0a5870371",
                        "source_sense_id": "a7935897-51dd-3ff9-8b83-aab4ddfdcae6",
                        "source_sense_description": "een rilling als gevolg van afschuw of koude",
                        "target_lang_word": "shudder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shudder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "417ebe92-35fd-3c5a-9e7f-3f6e57ea4c85",
                                        "entry_id": "045cc880-ce8a-380a-a485-8a17d16d7849",
                                        "glosses": [
                                            "To shake nervously, often from fear or horror."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c130c08d-2c32-45b8-bfc8-5efd958a21c9",
                                                "sense_id": "417ebe92-35fd-3c5a-9e7f-3f6e57ea4c85",
                                                "text": "On seeing the spider under his pillow, John shuddered."
                                            },
                                            {
                                                "example_id": "c574815e-4d40-4de3-b9b1-70cd992fb66b",
                                                "sense_id": "417ebe92-35fd-3c5a-9e7f-3f6e57ea4c85",
                                                "text": "VVreath'd vp in fatall folds iuſt in his way, / The feare where of doth make him ſhake, & ſhudder, […]"
                                            },
                                            {
                                                "example_id": "5ec3596b-f334-4ca2-b010-fcae9999221e",
                                                "sense_id": "417ebe92-35fd-3c5a-9e7f-3f6e57ea4c85",
                                                "text": "What makes me shudder so? / I shudder and I sigh to think / That even Cicero / And many-minded Homer were / Mad as the mist and snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94d0569c-d99a-37dd-81ff-0add382b1742",
                                        "entry_id": "045cc880-ce8a-380a-a485-8a17d16d7849",
                                        "glosses": [
                                            "To vibrate jerkily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shudder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14d02b34-1e68-3613-9ab7-a195e13f3ad8",
                                        "entry_id": "1b4520be-6546-3f1c-8752-5c371dbafe0d",
                                        "glosses": [
                                            "A shivering tremor, often from fear or horror."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee57d52-2c7f-4995-8fbb-59c501c74fce",
                                                "sense_id": "14d02b34-1e68-3613-9ab7-a195e13f3ad8",
                                                "text": "Seeing the spider under his pillow gave John a shudder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe747e36-a0b7-3140-a43c-cba978087e42",
                                        "entry_id": "1b4520be-6546-3f1c-8752-5c371dbafe0d",
                                        "glosses": [
                                            "A moment of almost pleasurable fear; a frisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d43294-56a0-458d-a09b-ad99cc864778",
                                                "sense_id": "fe747e36-a0b7-3140-a43c-cba978087e42",
                                                "text": "They name thee before me, / ⁠A knell to mine ear; / A shudder comes o'er me— / ⁠Why wert thou so dear?"
                                            },
                                            {
                                                "example_id": "2ac68df1-fb60-446d-8d1f-c3b8abfdd8aa",
                                                "sense_id": "fe747e36-a0b7-3140-a43c-cba978087e42",
                                                "text": "… and was not that slight tremble, a shudder which went through her young body, when his kiss, glowing and scorching with his wild passion, had dared to touch her tiny ice-cold hand?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9865e4e-42f3-4522-96cb-047ca4e00f68",
                        "source_entry_id": "a9e7d266-eb10-3e81-8297-17e0a5870371",
                        "source_sense_id": "a7935897-51dd-3ff9-8b83-aab4ddfdcae6",
                        "source_sense_description": "een rilling als gevolg van afschuw of koude",
                        "target_lang_word": "shiver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d7d160d-43a6-3774-93f3-c8c522c03573",
                                        "entry_id": "0a0a2286-0447-3bd3-bbce-c3d6349e1034",
                                        "glosses": [
                                            "To tremble or shake, especially when cold or frightened."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d1c6bc-49b3-4c15-9e0c-a897a85c331e",
                                                "sense_id": "7d7d160d-43a6-3774-93f3-c8c522c03573",
                                                "text": "They stood outside for hours, shivering in the frosty air."
                                            },
                                            {
                                                "example_id": "cf3cbc20-a726-49d9-82b7-9eb483268a2c",
                                                "sense_id": "7d7d160d-43a6-3774-93f3-c8c522c03573",
                                                "text": "The man that shivered on the brink of sin, / Thus steeled and hardened, ventures boldly in."
                                            },
                                            {
                                                "example_id": "142f81d5-bd8f-4449-bf38-e7aac7e098f5",
                                                "sense_id": "7d7d160d-43a6-3774-93f3-c8c522c03573",
                                                "text": "Mr. Mason, shivering as some one chanced to open the door, asked for more coal to be put on the fire, which had burnt out its flame, though its mass of cinder still shone hot and red. The footman who brought the coal, in going out, stopped near Mr. Eshton's chair, and said something to him in a low voice, of which I heard only the words, \"old woman,\"—\"quite troublesome.\""
                                            },
                                            {
                                                "example_id": "dce2cb5e-16a5-4bff-9ce8-e2d1c78be703",
                                                "sense_id": "7d7d160d-43a6-3774-93f3-c8c522c03573",
                                                "text": "He was shivering a little, for he had always been used to sleeping in a proper bed, and by this time his coat had worn so thin and threadbare from hugging that it was no longer any protection to him."
                                            },
                                            {
                                                "example_id": "ff5a3253-5fe1-4da3-90d3-790d16bca6f9",
                                                "sense_id": "7d7d160d-43a6-3774-93f3-c8c522c03573",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aecee2f7-f4e1-32bf-b837-41b6fab4a641",
                                        "entry_id": "0a0a2286-0447-3bd3-bbce-c3d6349e1034",
                                        "glosses": [
                                            "To cause to shake or tremble, as a sail, by steering close to the wind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79046191-346b-3e83-82cf-9f90bb09f361",
                                        "entry_id": "a54ecb17-ab84-364b-97f6-12d48fd5d46f",
                                        "glosses": [
                                            "The act of shivering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5262bf8-4d34-4c25-aea8-2fbb504b0cf3",
                                                "sense_id": "79046191-346b-3e83-82cf-9f90bb09f361",
                                                "text": "A shiver went up my spine."
                                            },
                                            {
                                                "example_id": "2e82a7b8-9885-4ebf-9d6e-64e1170f327b",
                                                "sense_id": "79046191-346b-3e83-82cf-9f90bb09f361",
                                                "text": "But they had already discovered that he could be bullied, and they had it their own way; and presently Selwyn lay prone upon the nursery floor, impersonating a ladrone while pleasant shivers chased themselves over Drina, whom he was stalking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce3cf05-b48c-332c-8e61-c54954141e4e",
                                        "entry_id": "a54ecb17-ab84-364b-97f6-12d48fd5d46f",
                                        "glosses": [
                                            "A bodily response to early hypothermia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
