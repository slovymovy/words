                "senses": [
                    {
                        "sense_id": "bfb248aa-7a0f-30b4-9cbf-26350973bef5",
                        "entry_id": "bff8416f-16c5-3249-94db-47ecf3bd9748",
                        "glosses": [
                            "Künstlerin, die plastische Figuren herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20f7c266-debe-446c-a976-e2affd828014",
                                "sense_id": "bfb248aa-7a0f-30b4-9cbf-26350973bef5",
                                "text": "„Sie wird zurecht als unkonventionelle Skulpteurin bezeichnet, die visuelle Erlebnisse zwischen Natur und Kultur schafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ddba00d-6a97-42c4-9f64-03d0357879aa",
                        "source_entry_id": "bff8416f-16c5-3249-94db-47ecf3bd9748",
                        "source_sense_id": "bfb248aa-7a0f-30b4-9cbf-26350973bef5",
                        "source_sense_description": "Künstlerin, die plastische Figuren herstellt",
                        "target_lang_word": "sculptor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculptor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc4fe6c7-832c-351c-bb07-bc4270f392b0",
                                        "entry_id": "b7dcc270-1bd7-30ab-8089-30fdfadcf77e",
                                        "glosses": [
                                            "A person who sculpts; an artist who produces sculpture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00f46a1-0fa2-4389-8e7d-7ed6183de142",
                                                "sense_id": "fc4fe6c7-832c-351c-bb07-bc4270f392b0",
                                                "text": "The feisty wife of a world-renowned Russian sculptor emasculated an armed thug outside her Soho home — saying he “didn’t have the cojones to shoot her,” police sources said yesterday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "510499b2-79b0-4c7d-a9f3-a0eeca9b3d02",
                        "source_entry_id": "bff8416f-16c5-3249-94db-47ecf3bd9748",
                        "source_sense_id": "bfb248aa-7a0f-30b4-9cbf-26350973bef5",
                        "source_sense_description": "Künstlerin, die plastische Figuren herstellt",
                        "target_lang_word": "sculpteure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculpteure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f98fe0db-03aa-35b5-a7fc-b8ffe21bab5d",
                                        "entry_id": "16f69ce5-3529-3e57-a86e-7544ffc5f787",
                                        "glosses": [
                                            "Femme qui sculpte."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa43e1e8-ea43-4dd6-a9fa-732d812eb9a8",
                                                "sense_id": "f98fe0db-03aa-35b5-a7fc-b8ffe21bab5d",
                                                "text": "Archie en a vu, tout au long de sa vie, des nénettes comme ci et des nénettes comme ça, des artistes, des intellos, des philosophes, des politiques, des syndicalistes, des sculpteures, des actrices, des écrivaines […]."
                                            },
                                            {
                                                "example_id": "b9e1cbd4-5c7f-4e5e-b8be-e049ad960a93",
                                                "sense_id": "f98fe0db-03aa-35b5-a7fc-b8ffe21bab5d",
                                                "text": "Après quelques créations collectives, elle collabore avec Marleau […], participe à Ligne blanche, ligne brisée […], puis s’investit dans le projet Camille C. de Jocelyne Beaulieu et René Richard Cyr, où elle incarne avec intensité la sculpteure au destin tragique, Camille Claudel […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d64e39d5-6181-41da-b39e-66c52cd7f04c",
                        "source_entry_id": "bff8416f-16c5-3249-94db-47ecf3bd9748",
                        "source_sense_id": "bfb248aa-7a0f-30b4-9cbf-26350973bef5",
                        "source_sense_description": "Künstlerin, die plastische Figuren herstellt",
                        "target_lang_word": "sculpteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculpteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb7404b-7427-31a0-968a-665de0782e02",
                                        "entry_id": "66fb358f-9eb0-3b87-a9f2-070962eed856",
                                        "glosses": [
                                            "Femme qui sculpte."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ac7db30-5b5b-4f30-9a98-2851067f6bfc",
                                                "sense_id": "fdb7404b-7427-31a0-968a-665de0782e02",
                                                "text": "Elles se trompaient quand, s’étonnant qu’il ne fût pas marié, elles avançaient qu’il « méritait mieux qu’elles », une femme pleine de belle conversation, cultivée et tout, une avocate, une professeure, une sculpteuse…"
                                            },
                                            {
                                                "example_id": "a315e248-cc58-4811-b99c-ff0b3d0d8b65",
                                                "sense_id": "fdb7404b-7427-31a0-968a-665de0782e02",
                                                "text": "Ma pensée déserta définitivement la musicienne pour rejoindre la sculpteuse. J’ai toujours eu pour Camille Claudel une immense sympathie, devinant en elle ce sentiment angoissé de tristesse et de douleur que j’aurais souhaité avoir pu partager en son temps avec elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90bef6a9-9617-40f9-8d38-095ff5ee2ea4",
                        "source_entry_id": "bff8416f-16c5-3249-94db-47ecf3bd9748",
                        "source_sense_id": "bfb248aa-7a0f-30b4-9cbf-26350973bef5",
                        "source_sense_description": "Künstlerin, die plastische Figuren herstellt",
                        "target_lang_word": "sculptrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculptrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28af90a7-c2f1-3ace-83fa-bb1578916c40",
                                        "entry_id": "89597711-27c0-3c8d-8b36-8d7bfa01ebbb",
                                        "glosses": [
                                            "Artiste qui sculpte."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c382eff1-1288-4a20-ad5e-3c51321666af",
                                                "sense_id": "28af90a7-c2f1-3ace-83fa-bb1578916c40",
                                                "text": "On me dit qu’elle rapporte de très jolies études peintes, car elle n’est pas seulement sculptrice, mais peintre encore."
                                            },
                                            {
                                                "example_id": "ff265f95-18b4-477b-a7ca-c59847affc1e",
                                                "sense_id": "28af90a7-c2f1-3ace-83fa-bb1578916c40",
                                                "text": "Pour une sculptrice comme toi, c’était un beau modèle !"
                                            },
                                            {
                                                "example_id": "973f2426-8200-49e3-9937-f6455077dcd8",
                                                "sense_id": "28af90a7-c2f1-3ace-83fa-bb1578916c40",
                                                "text": "Corentin Hérubel est le digne héritier de sa mère, la créatrice de bijoux Marie-Laure Hérubel et de sa grand-mère, la sculptrice Florence Enders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac4974d-5f40-3c8f-b1bb-91522f474c14",
                                        "entry_id": "89597711-27c0-3c8d-8b36-8d7bfa01ebbb",
                                        "glosses": [
                                            "Métier de celle qui sculpte."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33eb1cd0-ef99-4261-8759-5b0f5bb6a263",
                                                "sense_id": "6ac4974d-5f40-3c8f-b1bb-91522f474c14",
                                                "text": "Sculptrice en marbre, en bois."
                                            },
                                            {
                                                "example_id": "5f124399-33ee-44ff-b70e-491e760c4200",
                                                "sense_id": "6ac4974d-5f40-3c8f-b1bb-91522f474c14",
                                                "text": "Ainsi, Dominique Sanchez, sculptrice en bois flotté, et Maryline Le Gouill, sculptrice en terre cuite, entre autres, ouvriront lors de ce week-end les portes de leurs locaux situés à Treffléan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
