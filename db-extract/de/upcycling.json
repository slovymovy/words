                "senses": [
                    {
                        "sense_id": "45b848b9-a3c2-3df9-bfde-5f384f1dbaa4",
                        "entry_id": "9846dfc2-cdb1-3b4b-80c4-6f7d34b7c770",
                        "glosses": [
                            "Umwandlung von Abfallprodukten oder nutzlosen Stoffen in hochwertige Produkte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc76297c-6ed0-432a-b7b7-378ca35f1877",
                                "sense_id": "45b848b9-a3c2-3df9-bfde-5f384f1dbaa4",
                                "text": "\"Im Gegensatz zu Recycling werden beim Upcycling vorhandenes, ausrangiertes Material oder gar ganze Gegenstände durch eine Bearbeitung oder eben einen kreativen Prozess aufgewertet und gelangen damit zu neuem Glanz.\""
                            },
                            {
                                "example_id": "2c2b62c5-e8d0-44a7-9e16-ec673ba0590c",
                                "sense_id": "45b848b9-a3c2-3df9-bfde-5f384f1dbaa4",
                                "text": "\"In manchen Bereichen wie dem Möbelbau ist die Methode inzwischen sehr beliebt, in der Modebranche ist Upcycling jedoch noch neu.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
