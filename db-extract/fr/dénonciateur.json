                ],
                "senses": [
                    {
                        "sense_id": "7a0b60da-e9b4-3186-8720-88caa467c726",
                        "entry_id": "e1cdc02b-ddc1-3d4c-93cc-a316a3f05d0b",
                        "glosses": [
                            "Celui qui dénonce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd997286-b0af-421e-8e76-2b0f9ae697da",
                                "sense_id": "7a0b60da-e9b4-3186-8720-88caa467c726",
                                "text": "Le dénonciateur de Galilée auprès du Saint-Office, le P. Lorini, avait déclaré : « Quel danger l’Église ne courrait-elle point, si on laissait ainsi le premier venu expliquer l’Écriture à sa façon, […] »."
                            },
                            {
                                "example_id": "3eabdba0-c5a3-4eda-92f1-f2adbeb09e20",
                                "sense_id": "7a0b60da-e9b4-3186-8720-88caa467c726",
                                "text": "Vous m’avez affirmé, sévères dénonciateurs, que les usines clermontoises étaient le centre d’un système d’aspiration qui attirait à lui toutes les forces humaines, […]."
                            },
                            {
                                "example_id": "fb119f9f-8efd-4dfd-b717-7fb8a2803750",
                                "sense_id": "7a0b60da-e9b4-3186-8720-88caa467c726",
                                "text": "La plupart du temps, les chasseurs faisaient buisson creux, les dénonciateurs ayant été mal informés ou le gibier ayant éventé les chiens et pris le large.Ceux que l'on capturait, on les ramenait en grand arroi à Toulouse, enchaînés comme des criminels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2405d26a-c1b0-4a55-8a37-ca868645c66c",
                        "source_entry_id": "e1cdc02b-ddc1-3d4c-93cc-a316a3f05d0b",
                        "source_sense_id": "7a0b60da-e9b4-3186-8720-88caa467c726",
                        "target_lang_word": "kapuś",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kapuś",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "c12accc0-7bf9-38a8-b937-e6f0a5db46d0",
                                        "entry_id": "c27bd3b6-e578-3d3e-8b06-839fa5612e1f",
                                        "glosses": [
                                            "donosiciel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "615248b0-9a29-436e-b78f-35951c9bf0e9",
                                                "sense_id": "c12accc0-7bf9-38a8-b937-e6f0a5db46d0",
                                                "text": "Marian od razu poleciał na komisariat. Nie sądziłem, że taki z niego kapuś."
                                            }
