{
    "word_family": [
        "пока"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ad418be7-5f82-3613-98db-18af32af9dfc",
                    "sense_definition": "В настоящее время, на данный момент.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time_adverb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Покамест</w> мы ждем ответа, можно заняться другими делами.",
                            "target_lang_translations": {
                                "en": "<w>For the time being</w>, while we wait for an answer, we can attend to other matters."
                            }
                        },
                        {
                            "text": "Работа <w>покамест</w> приостановлена из-за отсутствия нужных материалов.",
                            "target_lang_translations": {
                                "en": "Work is <w>for the present</w> suspended due to the lack of necessary materials."
                            }
                        }
                    ],
                    "synonyms": [
                        "пока",
                        "пока что"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "At the present time, for now."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for the time being",
                                "target_lang_sense_clarification": "Used to indicate a temporary state or situation."
                            },
                            {
                                "target_lang_word": "for the present",
                                "target_lang_sense_clarification": "A formal way to say for now."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f61196f1-be6e-3524-8dee-d68cca8804d1",
                    "sense_definition": "До какого-то момента в будущем.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_adverb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Покамест</w> не придет начальник, мы не имеем права открывать сейф.",
                            "target_lang_translations": {
                                "en": "<w>Until</w> the boss arrives, we do not have the right to open the safe."
                            }
                        },
                        {
                            "text": "Оставайся здесь, <w>покамест</w> я не вернусь с новостями.",
                            "target_lang_translations": {
                                "en": "Stay here <w>until</w> I return with news."
                            }
                        }
                    ],
                    "synonyms": [
                        "пока"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Until a certain moment in the future."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "until",
                                "target_lang_sense_clarification": "Used to indicate the point in time when an action stops or starts."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "d3b85fad-4d22-3df4-9dbe-64e95cc2876c",
                    "sense_definition": "В то время как, в течение того времени как.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conjunction_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Друзья беседовали, <w>покамест</w> за окном шел сильный дождь.",
                            "target_lang_translations": {
                                "en": "The friends chatted <w>while</w> a heavy rain fell outside the window."
                            }
                        },
                        {
                            "text": "Мать готовила ужин, <w>покамест</w> дети играли в соседней комнате.",
                            "target_lang_translations": {
                                "en": "Mother was preparing dinner <w>while</w> the children played in the next room."
                            }
                        }
                    ],
                    "synonyms": [
                        "пока",
                        "в то время как"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "While, during the time that."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "while",
                                "target_lang_sense_clarification": "Used to describe two actions happening simultaneously."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}