                "senses": [
                    {
                        "sense_id": "b8aa93ff-58b8-3ffa-983c-e7479baf6ed5",
                        "entry_id": "f8579a81-2abc-3a9e-8502-251d8d9cc3da",
                        "glosses": [
                            "Eigenschaft, gewesen zu sein, eine Vergangenheit zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e26731bf-969f-4b80-8794-90b0e5a0dab2",
                                "sense_id": "b8aa93ff-58b8-3ffa-983c-e7479baf6ed5",
                                "text": "„Ihre Gewesenheit ist sehr lebendig. Sie sind noch immer, und dieses Noch-immer-Sein und seine Fülle verfolgen Sie ebenso wie die Gewesenheit, die Vergangenheit.“"
                            },
                            {
                                "example_id": "599830fc-ec66-43d8-a85c-bf5a53c334f0",
                                "sense_id": "b8aa93ff-58b8-3ffa-983c-e7479baf6ed5",
                                "text": "„Die Zeitlichkeit nämlich als der Sinn von Sein des Daseins zeitigt sich in der Einheit von drei Ekstasen: Zukunft, Gewesenheit und Gegenwart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
