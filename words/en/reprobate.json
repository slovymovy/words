{
    "word_family": [
        "reprobation",
        "reprobatory"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6bec01d0-ab32-3310-a268-c565b9856bea",
                    "sense_definition": "Lacking moral principles or religious values.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "immoral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reprobate</w> criminal showed no remorse for his actions during the trial.",
                            "target_lang_translations": {
                                "nl": "De <w>immorele</w> crimineel toonde tijdens het proces geen berouw voor zijn daden."
                            }
                        },
                        {
                            "text": "He lived a <w>reprobate</w> life, ignoring all social and ethical standards.",
                            "target_lang_translations": {
                                "nl": "Hij leidde een <w>verwerpelijk</w> leven en negeerde alle sociale en ethische normen."
                            }
                        }
                    ],
                    "synonyms": [
                        "immoral",
                        "corrupt",
                        "depraved",
                        "wicked"
                    ],
                    "antonyms": [
                        "virtuous",
                        "principled"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die morele principes of religieuze waarden mist."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "immoreel",
                                "target_lang_sense_clarification": "Beschrijft gedrag dat ingaat tegen normen en waarden."
                            },
                            {
                                "target_lang_word": "verwerpelijk",
                                "target_lang_sense_clarification": "Beschrijft iets dat vanuit moreel oogpunt afgekeurd moet worden."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b91c72ea-4d28-3d40-827b-09a25c34e571",
                    "sense_definition": "A person who behaves in an immoral or dishonest way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "immoral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>reprobate</w> spent all his money on gambling and drinking.",
                            "target_lang_translations": {
                                "nl": "De oude <w>schurk</w> gaf al zijn geld uit aan gokken en drinken."
                            }
                        },
                        {
                            "text": "Everyone in the village knew he was a <w>reprobate</w> who could not be trusted.",
                            "target_lang_translations": {
                                "nl": "Iedereen in het dorp wist dat hij een <w>onverlaat</w> was die niet te vertrouwen was."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoundrel",
                        "villain",
                        "rogue"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een persoon die zich op een immorele of oneerlijke manier gedraagt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schurk",
                                "target_lang_sense_clarification": "Iemand die kwaad in de zin heeft of bedrijft."
                            },
                            {
                                "target_lang_word": "onverlaat",
                                "target_lang_sense_clarification": "Iemand met een verdorven karakter (pejoratief)."
                            },
                            {
                                "target_lang_word": "zondaar",
                                "target_lang_sense_clarification": "Iemand die ongehoorzaam is aan morele of religieuze geboden."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfa654ca-337f-397c-843e-058e449da667",
                    "sense_definition": "To express strong disapproval or condemnation of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disapprove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee members <w>reprobated</w> the violent behavior displayed at the protest.",
                            "target_lang_translations": {
                                "nl": "De commissieleden <w>veroordeelden</w> het gewelddadige gedrag dat tijdens het protest werd vertoond."
                            }
                        },
                        {
                            "text": "She publicly <w>reprobated</w> the company's decision to cut employee benefits.",
                            "target_lang_translations": {
                                "nl": "Zij <w>verwierp</w> publiekelijk het besluit van het bedrijf om de secundaire arbeidsvoorwaarden te schrappen."
                            }
                        }
                    ],
                    "synonyms": [
                        "condemn",
                        "denounce",
                        "censure"
                    ],
                    "antonyms": [
                        "approve",
                        "endorse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This verb usage is formal and increasingly rare."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Sterke afkeuring of veroordeling uitspreken over iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "veroordelen",
                                "target_lang_sense_clarification": "Zeggen dat je iets verkeerd vindt."
                            },
                            {
                                "target_lang_word": "verwerpen",
                                "target_lang_sense_clarification": "Iets afkeuren of afwijzen."
                            },
                            {
                                "target_lang_word": "weigeren",
                                "target_lang_sense_clarification": "Niet akkoord gaan met of niet voldoen aan een verzoek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}