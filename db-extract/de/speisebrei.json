                    {
                        "sense_id": "b90a3992-778f-3839-9b93-723554689218",
                        "entry_id": "a45861f8-4187-3a7a-a827-55586fec8e6b",
                        "glosses": [
                            "Brei aus Nahrungsmitteln, die im Magen mit Verdauungssäften versetzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6acf8a2-5865-431a-be83-1f41ac6847c4",
                                "sense_id": "b90a3992-778f-3839-9b93-723554689218",
                                "text": "„In Zweifelsfällen könnte man das nämlich weder an der Farbe noch am Geschmack des fertigen Speisebreis feststellen.“"
                            },
                            {
                                "example_id": "35a419ec-85ea-4ce1-8099-768fdb3e6de0",
                                "sense_id": "b90a3992-778f-3839-9b93-723554689218",
                                "text": "„Nein, es war nicht der Speisebrei, es war diese gewaltige Energie, die Wut, die in ihm bebte, die er aufzuhalten versuchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
