                ],
                "senses": [
                    {
                        "sense_id": "02a8c95c-5952-350f-88c5-000f993535d8",
                        "entry_id": "52e50274-1acc-3cb9-ab12-43c5e8b546d8",
                        "glosses": [
                            "рег. дивиться, смотреть на что-нибудь, дивясь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc31a67-a2d1-449e-ab22-63f75b8179d2",
                                "sense_id": "02a8c95c-5952-350f-88c5-000f993535d8",
                                "text": "Весь народ чудился этому диву."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5208b82-2860-3701-89cb-6eebdbe223ff",
                        "entry_id": "52e50274-1acc-3cb9-ab12-43c5e8b546d8",
                        "glosses": [
                            "казаться, мерещиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa1007e7-01bc-4aec-85bc-318b06a541f5",
                                "sense_id": "e5208b82-2860-3701-89cb-6eebdbe223ff",
                                "text": "Чудилось мне, что я нахожусь где-то в России, в глуши, в простом деревенском доме."
                            },
                            {
                                "example_id": "6dfeb08f-88e4-449b-bc69-a02ef73763cc",
                                "sense_id": "e5208b82-2860-3701-89cb-6eebdbe223ff",
                                "text": "То чей-то шорох, то шептанье, то крики чудятся ему."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02c6b5f9-576b-4295-a310-7ea2b7090eed",
                        "source_entry_id": "52e50274-1acc-3cb9-ab12-43c5e8b546d8",
                        "source_sense_description": "казаться, мерещиться",
                        "target_lang_word": "sembler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sembler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                                        "entry_id": "f8cb335c-a211-3c63-80fa-472d7bcc79b5",
                                        "glosses": [
                                            "Paraître avoir une certaine qualité ou une certaine manière d’être ; avoir l’air, l’apparence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ce0f8f-e845-4e89-b1f6-3e88659e8c69",
                                                "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                                                "text": "— Mais, demanda Scaër, vous sembliez craindre tout à l’heure qu'on espionnât ce brave garçon... Pourquoi ?"
                                            },
                                            {
                                                "example_id": "edb9a309-d429-4b19-ab6f-9cc3626f5337",
                                                "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                                                "text": "L’administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique."
                                            },
                                            {
                                                "example_id": "4d414329-7194-436e-8b88-7edba73bffd0",
                                                "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                                                "text": "La mort fauche. Elle fauche à tort et à travers. Peu lui importe. Ceux qu’elle a visés, elle va les chercher là où ils semblent le plus en sécurité."
                                            },
                                            {
                                                "example_id": "772bd6b7-0e30-42ac-a998-77c66463be79",
                                                "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                                                "text": "Il est vrai que les hannetons et les chauves-souris, par exemple, ont une façon de voler qui nous semble déraisonnable ; mais elle ne le semble ainsi qu’à nous autres dont ce n’est pas la fonction de voler."
                                            },
                                            {
                                                "example_id": "4213ea3b-65f3-4567-a4dc-55d832a896b0",
                                                "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                                                "text": "La vitesse de circulation de la monnaie croissait ainsi de jour en jour et sa répudiation définitive semblait devoir être prochaine."
                                            },
                                            {
                                                "example_id": "0aef1eea-2e66-4234-ae92-f9cec0e080c6",
                                                "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                                                "text": "Pour lui, faire des achats représentait toujours une corvée, et même plus que cela, mais Emma et Lucy, elles, semblaient heureuses comme des poissons dans l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3746fb-24e8-3408-b6ff-ba2ae6f4c8f5",
                                        "entry_id": "f8cb335c-a211-3c63-80fa-472d7bcc79b5",
                                        "glosses": [
                                            "Être apparemment, du point de vue de quelqu’un."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ddc80b3-59bc-4eab-84a6-55afc8f88d12",
                                                "sense_id": "4e3746fb-24e8-3408-b6ff-ba2ae6f4c8f5",
                                                "text": "Il semblerait donc que le plus grand désordre doive régner dans le tapis végétal. Il en est bien ainsi dans les régions de végétation luxuriante."
                                            },
                                            {
                                                "example_id": "c77d03d5-4a34-4093-b60a-ff47f0468766",
                                                "sense_id": "4e3746fb-24e8-3408-b6ff-ba2ae6f4c8f5",
                                                "text": "Que vous semble-t-il de ce tableau ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfdb1693-5705-45b1-9cfb-e0625dbec27e",
                        "source_entry_id": "52e50274-1acc-3cb9-ab12-43c5e8b546d8",
                        "source_sense_description": "казаться, мерещиться",
                        "target_lang_word": "paraître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paraître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce89169e-55f2-35d8-92bb-01ed27593ee0",
                                        "entry_id": "112879a8-cdfe-3c02-9e7b-d0ec2fd8c259",
                                        "glosses": [
                                            "Être exposé à la vue ; se faire ou se laisser voir ; se manifester."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b48ef0c4-d1f7-4f6c-9267-3adbecc034af",
                                                "sense_id": "ce89169e-55f2-35d8-92bb-01ed27593ee0",
                                                "text": "Tirez les cordes de votre arc jusqu’à vos oreilles, et abattez de vos traits tous ceux qui paraîtront sur le rempart."
                                            },
                                            {
                                                "example_id": "f5e77b9b-eb5e-4a6a-a857-1dc8b49653fd",
                                                "sense_id": "ce89169e-55f2-35d8-92bb-01ed27593ee0",
                                                "text": "Le jour commençait à paraître; la générale retentissait, battue dans toutes les sections de Paris; ce mouvement et ce bruit se répercutaient jusque dans la tour, et glaçaient le sang dans les veines de l'abbé de Firmont et de Cléry."
                                            },
                                            {
                                                "example_id": "b439824d-f16a-44f7-af5e-d2b3d27996db",
                                                "sense_id": "ce89169e-55f2-35d8-92bb-01ed27593ee0",
                                                "text": "De temps en temps, un requin paraissait à la surface avec son cortège habituel de rémoras parasites et de poissons-pilotes."
                                            },
                                            {
                                                "example_id": "63fac24c-186b-47a5-a724-51038cb736cc",
                                                "sense_id": "ce89169e-55f2-35d8-92bb-01ed27593ee0",
                                                "text": "Notre hôte, absent au moment de notre arrivée, ne tarde pas à paraître et me fait l'accueil auquel je m'attendais de sa part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6cf7484-a2ba-36aa-912d-db05eb8dde9e",
                                        "entry_id": "112879a8-cdfe-3c02-9e7b-d0ec2fd8c259",
                                        "glosses": [
                                            "Être mis en vente ou en circulation, en parlant d’un livre ou d’une publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26735958-e87d-4c33-af94-c1b34fbafd03",
                                                "sense_id": "b6cf7484-a2ba-36aa-912d-db05eb8dde9e",
                                                "text": "Die Gleichheit parait sur quatre grandes pages : son tirage est faible : 4000 exemplaires en 1900."
                                            },
                                            {
                                                "example_id": "ad36b570-5444-42e7-ac67-93bc0f2f77ae",
                                                "sense_id": "b6cf7484-a2ba-36aa-912d-db05eb8dde9e",
                                                "text": "« Un autre livre paraîtra en 2023, il aura pour cadre le Brésil, l’Inde ou la France », dévoile la Saintongeaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d18d8276-ff74-3c00-ad25-7c484b3ad7af",
                                        "entry_id": "112879a8-cdfe-3c02-9e7b-d0ec2fd8c259",
                                        "glosses": [
                                            "Briller ; se distinguer ; se faire remarquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83da4e77-516e-4728-a8b9-915e44166c0f",
                                                "sense_id": "d18d8276-ff74-3c00-ad25-7c484b3ad7af",
                                                "text": "Il partait dans la vie les mains vides, et méprisait les biens qui s’acquièrent. Pour pallier cette indigence, il ne lui restait qu’une issue : paraître."
                                            },
                                            {
                                                "example_id": "9d4b3632-791c-450a-90a0-bccd390ae417",
                                                "sense_id": "d18d8276-ff74-3c00-ad25-7c484b3ad7af",
                                                "text": "Il ne s'était pas diverti à paraître dans les salons, hauts lieux du papillonnage, où paonnaient des sots éventés et des sirènes plâtrées, et où cancanaient des caillettes d'alcôve et des potiches au ventre rembourré."
                                            },
                                            {
                                                "example_id": "bd4b2d55-cda0-4e52-a55e-c6745d7705ee",
                                                "sense_id": "d18d8276-ff74-3c00-ad25-7c484b3ad7af",
                                                "text": "Elle n'était pas amoureuse, mais elle aimait paraître avec le bel Italien qui exhibait sa fortune de manière un peu ostentatoire et démontrait un dilettantisme ajoutant à son charme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                        "entry_id": "112879a8-cdfe-3c02-9e7b-d0ec2fd8c259",
                                        "glosses": [
                                            "Sembler ; avoir l’apparence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a65c02e5-533a-4081-ab74-150a8e5e4c6a",
                                                "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                                "text": "Quelque peu disposé que vous parussiez à accepter la place d’académicien, il a cru vraisemblablement entrevoir dans vos yeux une envie d'y être forcé, et s'est persuadé qu'au moment que vous seriez élu vous ne vous feriez plus prier pour occuper une place qu'on ne pourrait plus vous soupçonner d'avoir recherchée : il s'est trompé et vous l'avez refusée."
                                            },
                                            {
                                                "example_id": "9b7b8933-e3a9-42f2-aeda-f95528aa0494",
                                                "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                                "text": "La courte nuit d’été lui parut cependant interminablement longue. Il éprouvait une sensation désagréable d’insécurité et il s’imaginait, sans la moindre raison, que le jour la dissiperait."
                                            },
                                            {
                                                "example_id": "aa889f32-d2bd-4ecb-b2ff-eac77fba0a56",
                                                "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                                "text": "[…], la discussion ne paraissant point épuisée, ils continuèrent, dans le crépuscule qui tombait, à marcher en devisant, l’un le pot à la main, l’autre son parapluie sous le bras… — (Louis Pergaud, La Disparition mystérieuse, dans Les Rustiques, nouvelles villageoises, 1921)"
                                            },
                                            {
                                                "example_id": "d42556dc-6d8f-4231-b58f-92d79145659f",
                                                "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                                "text": "Dans l'intérieur, qui paraissait impraticable, des routes se sont miraculeusement ouvertes, parcourues aussitôt par des automobiles."
                                            },
                                            {
                                                "example_id": "5bb9ed42-9c80-4591-97e6-246fa01a5c90",
                                                "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                                "text": "Le Sapin (Abies pectinata) se rencontre aussi en Normandie ; sa spontanéité paraît certaine."
                                            },
                                            {
                                                "example_id": "338d48df-8b17-449c-9d75-2be6627d2ebd",
                                                "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                                "text": "Céline Thiébault était alors une jeune fille « bienfaisante », une de ces grandes filles brunes qui paraissent vingt ans au lieu de quinze, de celles qu’à la campagne on compare volontiers à une pouliche et que les hommes, vieux et jeunes, détaillent avec une basse envie, un violent désir."
                                            },
                                            {
                                                "example_id": "c11a36f8-1fdd-4246-87bc-d08acc444d71",
                                                "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                                                "text": "Tout cela était très important et pas éloigné de l’école, quoiqu’il en parût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e8ecb7d-7f11-309d-9e4f-9ba23c420338",
                                        "entry_id": "112879a8-cdfe-3c02-9e7b-d0ec2fd8c259",
                                        "glosses": [
                                            "Se montrer dans un lieu ou dans certaines circonstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a14a575-48fa-4d2b-9c8e-192de15613e7",
                                                "sense_id": "8e8ecb7d-7f11-309d-9e4f-9ba23c420338",
                                                "text": "Tout à coup la porte opposée à celle par laquelle il était entré s’ouvrit, et deux pages parurent, portant des flambeaux […]."
                                            },
                                            {
                                                "example_id": "a75644f4-3493-40a1-8b0d-eb33b05f94bf",
                                                "sense_id": "8e8ecb7d-7f11-309d-9e4f-9ba23c420338",
                                                "text": "Il appuya sur le bouton d’une sonnette. Un domestique en livrée parut aussitôt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paraître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56ac2015-b2e7-30ba-b309-7aa31abbbf61",
                                        "entry_id": "2574c329-c956-3ec2-bd70-324470bf335e",
                                        "glosses": [
                                            "Apparence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef89525-7b95-43d3-8f79-8b9c22abf0a8",
                                                "sense_id": "56ac2015-b2e7-30ba-b309-7aa31abbbf61",
                                                "text": "Ni le choix de ses amis ni celui des mets n'étaient faits par la vanité : car en tout il préférait l'être au paraître."
                                            },
                                            {
                                                "example_id": "fe605d01-0a13-4440-8fa3-60e1dcc47fb9",
                                                "sense_id": "56ac2015-b2e7-30ba-b309-7aa31abbbf61",
                                                "text": "— Que sommes-nous ? Des artistes, n’est-ce pas ? des comédiens qui par leur seul aspect doivent provoquer la curiosité. Crois-tu que si nous allions tantôt sur la place publique habillés comme des bourgeois ou des paysans, nous forcerions les gens à nous regarder et à s’arrêter autour de nous ? Non, n’est-ce pas ? Apprends donc que dans la vie le paraître est quelquefois indispensable ; cela est fâcheux, mais nous n’y pouvons rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d45d0fe2-020d-4cf9-8bf4-cf6807c38287",
                        "source_entry_id": "52e50274-1acc-3cb9-ab12-43c5e8b546d8",
                        "source_sense_description": "казаться, мерещиться",
                        "target_lang_word": "apparaître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparaître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "739a0d64-4600-3fd5-b5c4-978a6c992dae",
                                        "entry_id": "1930dc31-bdc3-3ca5-8935-dd74ed7cf8d9",
                                        "glosses": [
                                            "Devenir visible ; se manifester."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8463eb09-c6a5-4e13-a322-82307679cc96",
                                                "sense_id": "739a0d64-4600-3fd5-b5c4-978a6c992dae",
                                                "text": "La brise fraîchissante du soir avait séché et soulevé ses cheveux, donnait à son visage un désordre à travers lequel apparaissait de la brutalité."
                                            },
                                            {
                                                "example_id": "a1c32035-a3e1-4964-92be-6637a7e22385",
                                                "sense_id": "739a0d64-4600-3fd5-b5c4-978a6c992dae",
                                                "text": "Il importe donc fort peu de savoir ce que les mythes renferment de détails desti­nés à apparaître réellement sur le plan de l’histoire future […] il peut même arriver que rien de ce qu’ils renferment ne se produise […]"
                                            },
                                            {
                                                "example_id": "1aaaed00-bf6e-4317-ab49-c191d56db15b",
                                                "sense_id": "739a0d64-4600-3fd5-b5c4-978a6c992dae",
                                                "text": "De nombreux arcs-en-ciel apparaissent, mais le ciel entre les nuages est d’un bleu trop pâle et je sais que ce n’est pas encore la fin du mauvais temps."
                                            },
                                            {
                                                "example_id": "59d8cbe6-9585-4616-8798-0532b7023518",
                                                "sense_id": "739a0d64-4600-3fd5-b5c4-978a6c992dae",
                                                "text": "En mars 1978 apparaissait chez les libraires le premier reprint qui, s'il livrait enfin à de nombreux chercheurs le texte intégral, n'en respectait ni la pagination, ni le format."
                                            },
                                            {
                                                "example_id": "53afaa0f-958f-4c10-9a0a-d27c3564b716",
                                                "sense_id": "739a0d64-4600-3fd5-b5c4-978a6c992dae",
                                                "text": "La lune apparaît gibbeuse, pour un observateur terrestre, entre le premier quartier et la pleine lune et entre la pleine lune et le dernier quartier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25bd72bd-0509-395f-b021-1b96db67701a",
                                        "entry_id": "1930dc31-bdc3-3ca5-8935-dd74ed7cf8d9",
                                        "glosses": [
                                            "Se montrer inopinément ou soudainement ; avoir un aspect qui fasse naître la surprise ou qui excite l’intérêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13564da-6b8d-4380-83c4-4e808f6c1518",
                                                "sense_id": "25bd72bd-0509-395f-b021-1b96db67701a",
                                                "text": "Une flamme tremblotante orangea le hall d'entrée. La porte s'ouvrit. Lola apparut."
                                            },
                                            {
                                                "example_id": "0effdce6-cd8c-4bf7-80b0-f9137d30fc49",
                                                "sense_id": "25bd72bd-0509-395f-b021-1b96db67701a",
                                                "text": "Lino est apparu par la porte d’entrée, en se frottant les mains l’une contre l’autre pour les réchauffer. De la buée sortait de sa bouche à chacune de ses respirations."
                                            },
                                            {
                                                "example_id": "0d586588-d390-46ea-be0a-67794c1e1dde",
                                                "sense_id": "25bd72bd-0509-395f-b021-1b96db67701a",
                                                "text": "Une voile apparut à l’horizon et rendit l’espoir aux naufragés. — Ces génies extraordinaires qui apparaissent à de longs intervalles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ffc7e37-22f1-3512-aaee-cff12be5a710",
                                        "entry_id": "1930dc31-bdc3-3ca5-8935-dd74ed7cf8d9",
                                        "glosses": [
                                            "Être certain ; être évident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10d213b-a934-4ff6-8c3f-99abd84165ad",
                                                "sense_id": "3ffc7e37-22f1-3512-aaee-cff12be5a710",
                                                "text": "La justesse de ce raisonnement m’apparaît clairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01a3c9ab-79c5-3eb2-bea9-4b687a5ef7a4",
                                        "entry_id": "1930dc31-bdc3-3ca5-8935-dd74ed7cf8d9",
                                        "glosses": [
                                            "Être déduit de l'enquête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb190226-7b1c-4d3c-ba51-d9bc943e828b",
                                                "sense_id": "01a3c9ab-79c5-3eb2-bea9-4b687a5ef7a4",
                                                "text": "S’il vous apparaît que cela soit : Si, après avoir fait les enquêtes nécessaires, vous trouvez que cela soit ainsi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b050bce-1702-3449-bf73-16d966d2228b",
                                        "entry_id": "1930dc31-bdc3-3ca5-8935-dd74ed7cf8d9",
                                        "glosses": [
                                            "Donner communication dans les formes, en parlant des pouvoirs ; les notifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38df436-8aee-46f0-b072-8ec22b4d48bd",
                                                "sense_id": "7b050bce-1702-3449-bf73-16d966d2228b",
                                                "text": "Faire apparaître de ses pouvoirs :"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
