                                        "entry_id": "9bb1ae4e-344e-3557-8f8e-94133c63b836",
                                        "glosses": [
                                            "A property describing which terms can be rewritten with other, equivalent terms."
                                        ],
                                        "tags": [
                                            "in rewriting systems"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
