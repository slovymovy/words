                                "example_id": "b0b967a5-bbae-462c-a3b0-021ba5d4f3e1",
                                "sense_id": "2ca2291a-5725-398e-8a30-914127a502aa",
                                "text": "„Doch im November 1936 kann Canetti Broch bereits einen Freundschaftsdienst erweisen.“"
                            },
                            {
