{
    "word_family": [
        "mercenariat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "efe7e45d-eb38-379c-9b22-902f11ee30ab",
                    "sense_definition": "Combattant étranger recruté contre rémunération pour participer à un conflit armé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "combattant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a fait appel à un <w>mercenaire</w> pour former les troupes locales."
                        },
                        {
                            "text": "Ce seigneur de guerre a payé des <w>mercenaires</w> pour défendre sa forteresse isolée."
                        }
                    ],
                    "synonyms": [
                        "condottiere",
                        "épée-louée",
                        "reître"
                    ],
                    "common_phrases": [
                        "groupe de mercenaires",
                        "recruter des mercenaires"
                    ]
                },
                {
                    "sense_id": "445445b8-3f04-36fe-a778-7e0848d190e5",
                    "sense_definition": "Personne prête à accomplir n'importe quelle tâche ou mission uniquement par cupidité ou intérêt financier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "interet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce consultant se comporte comme un vrai <w>mercenaire</w> sans loyauté envers son entreprise."
                        },
                        {
                            "text": "On le considère comme un <w>mercenaire</w> qui change de camp au gré des offres."
                        }
                    ],
                    "synonyms": [
                        "sbire"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f34f08a0-3ca6-3f30-918e-8a9c515d6d1f",
                    "sense_definition": "Qui sert militairement un pouvoir étranger pour une solde.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "combattant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'empereur s'appuyait sur des troupes <w>mercenaires</w> pour maintenir l'ordre dans la capitale."
                        },
                        {
                            "text": "Une armée <w>mercenaire</w> a envahi les territoires voisins dès le début de l'hiver."
                        }
                    ],
                    "synonyms": [
                        "stipendié"
                    ],
                    "common_phrases": [
                        "troupes mercenaires",
                        "armée mercenaire"
                    ]
                },
                {
                    "sense_id": "2c2279c4-5588-3d6a-bf3e-e3d242f76524",
                    "sense_definition": "Qui est dicté uniquement par la recherche du profit ou facilement corruptible par l'argent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa plume <w>mercenaire</w> écrit pour n'importe quel journal qui lui propose un bon salaire."
                        },
                        {
                            "text": "Les juges ont dénoncé ses motifs purement <w>mercenaires</w> au cours du procès."
                        }
                    ],
                    "synonyms": [
                        "avide",
                        "cupide",
                        "vénal"
                    ],
                    "common_phrases": [
                        "esprit mercenaire"
                    ]
                }
            ]
        }
    ]
}