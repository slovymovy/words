                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdcf465e-d464-3633-b192-723fdcfdccae",
                                        "entry_id": "b6f2565a-3929-39c7-b323-ae1a964bea14",
                                        "glosses": [
                                            "Supporting by giving encouragement: positively."
                                        ],
