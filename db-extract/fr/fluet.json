                ],
                "senses": [
                    {
                        "sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
                        "entry_id": "25d4b2d4-a7ed-372e-951d-a86c1f762912",
                        "glosses": [
                            "Se dit du corps mince et d’apparence délicate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "477aae44-7c43-4b46-b1d9-9b8d91a4ab83",
                                "sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
                                "text": "Damoiselle belette au corps long et fluet."
                            },
                            {
                                "example_id": "4e06f498-82ed-49ef-b62e-81b403462e3f",
                                "sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
                                "text": "Ce petit babouin crut faire un bon marché avec moi [en prenant un bien à fonds perdu], parce que j’étais fluet et maigre."
                            },
                            {
                                "example_id": "521f8b48-13e4-4b59-9f9d-cc5c4e366c7a",
                                "sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
                                "text": "C’était une grande fille fluette dont les robes, toujours trop larges, flottaient comme vides."
                            },
                            {
                                "example_id": "627f8d64-5cd6-45b1-b10d-56b7c007b1b5",
                                "sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
                                "text": "Et comme il y en avait des parents ! des gros et des fluets agglomérés en grappes somnolentes sous les lumières des « suspensions »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bb890e6-7170-4ec3-afc9-a4fb44263344",
                        "source_entry_id": "25d4b2d4-a7ed-372e-951d-a86c1f762912",
                        "source_sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
