                "translations": [
                    {
                        "translation_id": "cbd547d7-ad41-4231-80bb-c180aa458515",
                        "source_entry_id": "7db9bfac-f5d0-33d5-9904-57d574f9f889",
                        "source_sense_id": "7123cb6d-52c9-3f56-a84c-6fcc375c1000",
                        "target_lang_word": "riddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ced745-01cb-3c61-964f-af728ccf209a",
                                        "entry_id": "23540ca0-29d6-3ea6-9143-92c905cf2d90",
                                        "glosses": [
                                            "A verbal puzzle, mystery, or other problem of an intellectual nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc62718-ee84-4024-99a2-fa465f15e703",
                                                "sense_id": "22ced745-01cb-3c61-964f-af728ccf209a",
                                                "text": "Here's a riddle: It's black, and white, and red all over. What is it?"
                                            },
                                            {
                                                "example_id": "807a612b-2239-4b79-850d-5ca7d780426d",
                                                "sense_id": "22ced745-01cb-3c61-964f-af728ccf209a",
                                                "text": "12 ¶ And Samson said vnto them, I will now put foorth a riddle vnto you: if you can certeinly declare it me, within the seuen dayes of the feast, and finde it out, then I will giue you thirtie sheetes, and thirtie change of garments:\n13 But if ye cannot declare it me, then shall yee giue me thirtie sheetes, and thirtie change of garments. And they said vnto him, Put foorth thy riddle, that we may heare it.\n14 And hee said vnto them, Out of the eater came foorth meate, aud out of the strong came foorth sweetnesse. And they could not in three dayes expound the riddle."
                                            },
                                            {
                                                "example_id": "a3969f1b-b845-4113-97e0-e1bf45b83641",
                                                "sense_id": "22ced745-01cb-3c61-964f-af728ccf209a",
                                                "text": "To wring from me and tell to them my ſecret, / That ſolv'd the riddle which I had propos'd."
                                            },
                                            {
                                                "example_id": "485c67dd-7c23-4889-91a3-59af06b0f65f",
                                                "sense_id": "22ced745-01cb-3c61-964f-af728ccf209a",
                                                "text": "Elbows almost touching they leaned at ease, idly reading the almost obliterated lines engraved there. ¶ \"I never understood it,\" she observed, lightly scornful. \"What occult meaning has a sun-dial for the spooney? I'm sure I don't want to read riddles in a strange gentleman's optics.\""
                                            },
                                            {
                                                "example_id": "4d90083d-44c9-4e70-b3e4-2843ddcface6",
                                                "sense_id": "22ced745-01cb-3c61-964f-af728ccf209a",
                                                "text": "I'm a riddle so strong, you can't break me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41e77d3f-4bc3-319e-982d-db5cc070153d",
                                        "entry_id": "23540ca0-29d6-3ea6-9143-92c905cf2d90",
                                        "glosses": [
                                            "An ancient verbal, poetic, or literary form, in which, rather than a rhyme scheme, there are parallel opposing expressions with a hidden meaning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "riddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "102e1da5-4d2b-3186-8bdd-859a864f3c3e",
                                        "entry_id": "56e6ed37-3af6-3bf3-852e-4d85bee89f41",
                                        "glosses": [
                                            "To speak ambiguously or enigmatically."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48720748-6000-3f76-baa7-bdabbf25d8ea",
                                        "entry_id": "56e6ed37-3af6-3bf3-852e-4d85bee89f41",
                                        "glosses": [
                                            "To solve, answer, or explicate a riddle or question."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d81f5396-05a4-4ff6-8aa3-7d5ae057416b",
                                                "sense_id": "48720748-6000-3f76-baa7-bdabbf25d8ea",
                                                "text": "Riddle me this."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "riddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89dadcf9-2f50-3e01-85c4-8006d1d7c2a1",
                                        "entry_id": "63d9ea08-7ab4-3a29-ab2e-bbba6b8f8f1a",
                                        "glosses": [
                                            "A sieve with coarse meshes, usually of wire, for separating coarser materials from finer, as chaff from grain, cinders from ashes, or gravel from sand."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f7cf6be-0a25-3fee-b535-3a79384a6ac8",
                                        "entry_id": "63d9ea08-7ab4-3a29-ab2e-bbba6b8f8f1a",
                                        "glosses": [
                                            "A board with a row of pins, set zigzag, between which wire is drawn to straighten it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "riddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0301f95b-91f5-34c9-9383-2116979c8856",
                                        "entry_id": "7ce51bd5-34e8-3ec0-8e8c-4d05b7cb80c0",
                                        "glosses": [
                                            "To put something through a riddle or sieve; to sieve; to sift."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90706856-0b29-4168-a206-3de74f50ae56",
                                                "sense_id": "0301f95b-91f5-34c9-9383-2116979c8856",
                                                "text": "You have to riddle the gravel before you lay it on the road."
                                            },
                                            {
                                                "example_id": "fdf04d8c-a669-49c7-a1f4-176708fd639e",
                                                "sense_id": "0301f95b-91f5-34c9-9383-2116979c8856",
                                                "text": "In its finest form – two years old or more – leaf mould can be riddled (sieved) and used, mixed 50/50 with sand, to make fine potting compost for seeds and cuttings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59805da0-e93d-3b4c-992b-3f0a3b99451d",
                                        "entry_id": "7ce51bd5-34e8-3ec0-8e8c-4d05b7cb80c0",
                                        "glosses": [
                                            "To fill with holes like a riddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4e6abf-d98e-4fd6-8518-f1504f5f15a2",
                                                "sense_id": "59805da0-e93d-3b4c-992b-3f0a3b99451d",
                                                "text": "The shots from his gun began to riddle the targets."
                                            },
                                            {
                                                "example_id": "bd874f50-3147-4ed2-ab01-5ac23b4aa3e9",
                                                "sense_id": "59805da0-e93d-3b4c-992b-3f0a3b99451d",
                                                "text": "New Alresford is constantly mispronounced, T-shaped, honeycombed with cellars, packed with antique shops, riddled with woodworm, surrounded by watercress. The name - which means 'ford by the alders' - is pronounced 'Allsford'; and no one ever uses 'New', though they do call the adjoining village Old Alresford."
                                            },
                                            {
                                                "example_id": "ca912922-67c8-4651-882a-9e1544780364",
                                                "sense_id": "59805da0-e93d-3b4c-992b-3f0a3b99451d",
                                                "text": "Kalinin Bay is also in trouble, trading fire with Japanese destroyers and taking hits from both them and cruisers at the same time. Unlike the Gambier Bay, however, it does not appear that these ships have realized they need to switch to high explosive from armor-piercing, and, despite being riddled with shellfire, the ship stays afloat, despite this rather-unequal battering going on for another twenty to thirty minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f826346-6b5e-3347-90da-2617c5abc09e",
                                        "entry_id": "7ce51bd5-34e8-3ec0-8e8c-4d05b7cb80c0",
                                        "glosses": [
                                            "To fill or spread throughout; to pervade (with something destructive or weakening)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813b25af-43eb-4ef8-a631-7d52feb2034b",
                                                "sense_id": "4f826346-6b5e-3347-90da-2617c5abc09e",
                                                "text": "Your argument is riddled with errors."
                                            },
                                            {
                                                "example_id": "e0753a0f-79aa-4f48-bcbe-135a60b723b8",
                                                "sense_id": "4f826346-6b5e-3347-90da-2617c5abc09e",
                                                "text": "O perplex'd diſcompoſition, O ridling diſtemper, O miſerable condition of Man."
                                            }
                                        ]
                                    }
                                ]
                            },
