    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e1a969f-d33e-3bc3-9a17-9bdddad62282",
                    "sense_definition": "A common skin condition, especially among teenagers, characterized by red pimples and inflammation of the oil glands.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "skin_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many teenagers feel self-conscious when they develop <w>acne</w> on their faces.",
                            "target_lang_translations": {
                                "ru": "Многие подростки чувствуют себя неловко, когда у них на лице появляется <w>акне</w>."
                            }
                        },
                        {
                            "text": "The doctor recommended a special face wash to help treat her <w>acne</w> breakouts.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал специальное средство для умывания, чтобы помочь вылечить ее <w>угревую сыпь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pimples",
                        "zits",
                        "blemishes"
                    ],
                    "common_phrases": [
                        "severe acne",
                        "acne treatment",
                        "clear up acne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное заболевание кожи, особенно среди подростков, характеризующееся появлением прыщей и воспалением сальных желез."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акне",
                                "target_lang_sense_clarification": "медицинский термин для угревой болезни"
                            },
                            {
                                "target_lang_word": "угри",
                                "target_lang_sense_clarification": "воспаленные высыпания на коже"
                            },
                            {
                                "target_lang_word": "угревая сыпь",
                                "target_lang_sense_clarification": "множественные высыпания на коже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "485b7fee-cecc-3847-92e9-8002bf9a29b5",
                    "sense_definition": "A specific pattern or collection of spots and blemishes on the skin caused by the medical condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skin_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She noticed a small patch of <w>acne</w> appearing on her chin after a stressful week.",
                            "target_lang_translations": {
                                "ru": "После стрессовой недели она заметила небольшое скопление <w>прыщей</w> на подбородке."
                            }
                        },
                        {
                            "text": "The cream was designed to reduce the visible <w>acne</w> scars left behind after the breakout.",
                            "target_lang_translations": {
                                "ru": "Крем был разработан для уменьшения видимых шрамов от <w>акне</w>, оставшихся после высыпаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "breakout",
                        "rash"
                    ],
                    "common_phrases": [
                        "acne scars",
                        "acne prone skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическое проявление или скопление пятен и дефектов на коже, вызванных данным заболеванием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высыпания",
                                "target_lang_sense_clarification": "видимые проявления на коже"
                            },
                            {
                                "target_lang_word": "прыщи",
                                "target_lang_sense_clarification": "отдельные элементы сыпи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
