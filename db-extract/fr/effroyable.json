                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f44ac5ae-1655-419e-af5d-23fa8651caae",
                                                "sense_id": "6edb4660-acf2-3dc1-a7e9-e810fe5dd440",
                                                "text": "You had a lot of frightful good quotes. You must know half the books that there are."
                                            },
                                            {
                                                "example_id": "37c49342-69a4-4c62-90ef-f5c873c2df40",
                                                "sense_id": "6edb4660-acf2-3dc1-a7e9-e810fe5dd440",
                                                "text": "It's a frightful long time, and I don't get many letters from him."
