                ],
                "senses": [
                    {
                        "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                        "entry_id": "bc5bae87-36bd-3bad-9fcc-54b7f422e017",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17059623-b787-4f72-ace5-da7ad536e43d",
                                "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                                "text": "Zähnles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "12f26ad5-c7e7-4958-9f2f-32a9fcdf264d",
                                "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                                "text": "Zähnle kommt und geht."
                            },
                            {
                                "example_id": "81a229e2-78fb-44b8-8266-650bbb18c605",
                                "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                                "text": "Frau Zähnle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3854c896-7fd3-453a-80de-5bb8a13a216f",
                                "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                                "text": "Herr Zähnle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4c836a10-485f-45d3-a5bd-43a80a51d043",
                                "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                                "text": "Die Zähnles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "afb39f5f-d5a3-481a-8372-fcb166e601d5",
                                "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                                "text": "Der Zähnle trägt nie die Schals, die die Zähnle ihm strickt."
                            },
                            {
                                "example_id": "cf1f36ff-69b3-4e46-83c8-fb1ade71a0c6",
                                "sense_id": "51aa61c8-c8c8-3da5-8a34-dd65b41dde05",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zähnle kommt, geht der Herr Zähnle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
