                "senses": [
                    {
                        "sense_id": "a56f9d84-cfd3-38c6-82ea-82fc21b972b6",
                        "entry_id": "a99a3aca-9df2-3521-a019-7d2cca5c933a",
                        "glosses": [
                            "рег. или устар. сооружение для усопшего; гроб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06f8290-43eb-415b-be3d-2d5264813254",
                                "sense_id": "a56f9d84-cfd3-38c6-82ea-82fc21b972b6",
                                "text": "На дворе долбили дубовую колоду, чтобы приготовить для умершей княгини достойную домовину."
                            },
                            {
                                "example_id": "fee43467-f83d-4a6d-b85b-6f99a701aaff",
                                "sense_id": "a56f9d84-cfd3-38c6-82ea-82fc21b972b6",
                                "text": "Четыре мужика, с белыми новинами через плечо, через весь город несли к кладбищу сосновую домовину, в которой лежала жертва фантастического пошехонского отрезвления."
                            }
                        ]
                    }
                ],
