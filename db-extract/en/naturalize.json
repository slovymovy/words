                                        "glosses": [
                                            "sich in einem neuen Gebiet etablieren"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5721807-d160-4bdd-9fba-521e060e4c47",
                                                "sense_id": "27720054-929b-38f0-86eb-02b8b74d5401",
                                                "text": "Das Kleinblütige Springkraut hat sich längst bei und eingebürgert und ist fester Bestandteil der mitteleuropäischen Flora."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9bf99735-6d17-3f53-a0a0-6426b7e8d29e",
                                        "entry_id": "34e98d0b-0992-35a4-b9fe-a65b5402fe7e",
                                        "glosses": [
                                            "sich nach und nach zum Usus, zur Gewohnheit entwickeln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cdb3d33-9054-48d9-a1b5-855e62fc8f23",
                                                "sense_id": "9bf99735-6d17-3f53-a0a0-6426b7e8d29e",
                                                "text": "Der Gebrauch von Anglizismen hat sich bei uns immer mehr eingebürgert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
