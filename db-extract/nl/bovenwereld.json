                        "examples": [
                            {
                                "example_id": "bddd3830-ed6b-4519-99fe-48b169a29282",
                                "sense_id": "0a7ad2f6-1e4e-3bbd-a53f-f723d7cb2af3",
                                "text": "De politie gaat intensiever jacht maken op criminelen die hun zwarte geld witwassen in bijvoorbeeld de horeca en de vastgoedsector. Hiermee wil justitie misdadigers die infiltreren in de bovenwereld de pas afsnijden."
                            },
                            {
                                "example_id": "7f358fcf-fc6f-4462-8a23-e03da5298412",
                                "sense_id": "0a7ad2f6-1e4e-3bbd-a53f-f723d7cb2af3",
                                "text": "Minister Kajsa Ollongren van Binnenlandse Zaken (D66) kondigde onlangs aan een speciaal team op te gaan richten met ervaringsdeskundigen die bedreigingen hebben meegemaakt. Ook wil het kabinet 100 miljoen euro uittrekken om de verweving van onder- en bovenwereld aan te pakken."
                            },
                            {
                                "example_id": "a28ccde5-0380-4a9a-8695-a9bd50d98625",
                                "sense_id": "0a7ad2f6-1e4e-3bbd-a53f-f723d7cb2af3",
                                "text": "Bitcoin lijkt een beetje in limbo te zitten tussen onder- en bovenwereld: tussen de anarchistische wortels en de kapitalistische instituten die er ook wel in willen stappen. Door inbraken bij bitcoin-portemonnees en -beurzen is beleggen in cryptovaluta’s nog altijd een vrij riskant spel – nog los van de koersschommelingen."
                            }
                        ]
                    }
