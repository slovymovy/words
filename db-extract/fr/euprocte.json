                        "glosses": [
                            "Une des deux espèces (ou individu) du genre Euproctus, urodèles de la famille des Salamandridae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ceee892-9aae-4c77-a127-7ac336e4dc90",
                                "sense_id": "b5b91bec-5581-32ce-b73a-1bd508360866",
                                "text": "L’euprocte des Pyrénées est un montagnard qui vit dans les lacs, les torrents et parfois les rivières souterraines. ll ne fréquente les systèmes lacustres que si la température de l’eau ne dépasse pas 15 °C."
                            },
                            {
                                "example_id": "cad7df40-50e1-4a51-947e-9e9afc7ab01a",
                                "sense_id": "b5b91bec-5581-32ce-b73a-1bd508360866",
                                "text": "Toujours ce même regard craintif, d’une vitre à l’autre, comme un euprocte coincé dans un vivarium, entre mare et monti, comme s’il ignorait de quel côté les fantômes allaient surgir pour l’emporter."
                            }
                        ]
                    }
