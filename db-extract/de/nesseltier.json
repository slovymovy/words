                                        "glosses": [
                                            "benaming voor holtedieren uit de stam Cnidaria, die netelcellen hebben die gif afscheiden om een prooi te verlammen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf082db2-8393-4e0f-8019-2939e9eda340",
                                                "sense_id": "c9330d55-9a53-3bb8-9f60-02af6cb361ab",
                                                "text": "Buddenbrockia heeft nu een plaatsje in de stamboom gekregen tussen zoetwaterpoliepen en kwallen, en is dus echt een neteldier."
                                            }
