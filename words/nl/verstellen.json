{
    "word_family": [
        "verstelbaar",
        "verstelling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "579de4dc-27a0-332a-a918-cd3e7f084922",
                    "sense_definition": "de stand of positie van iets veranderen om het passend of geschikt te maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aanpassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze horlogeband kunt u op uw gewenste maat <w>verstellen</w>.",
                            "target_lang_translations": {
                                "en": "You can <w>adjust</w> this watch strap to your desired size."
                            }
                        },
                        {
                            "text": "Je moet de <w>stoel</w> <w>verstellen</w> voordat je begint met autorijden.",
                            "target_lang_translations": {
                                "en": "You must <w>adjust</w> the seat before you start driving."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de stoel verstellen",
                        "de hoogte verstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to change the position or setting of something to make it fit or suitable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adjust",
                                "target_lang_sense_clarification": "to change a setting or position"
                            },
                            {
                                "target_lang_word": "alter",
                                "target_lang_sense_clarification": "to change the size or fit of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "891abfce-93d7-39f0-b3ac-cacc8054ef07",
                    "sense_definition": "beschadigde kleding of textiel repareren door gaten te dichten of naden te herstellen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repareren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verstel</w> en herstel al uw kleding en gordijnen.",
                            "target_lang_translations": {
                                "en": "I <w>mend</w> and repair all your clothing and curtains."
                            }
                        },
                        {
                            "text": "Zij kan heel netjes oude <w>kleding</w> <w>verstellen</w> zodat het er weer als nieuw uitziet.",
                            "target_lang_translations": {
                                "en": "She can <w>mend</w> old clothes very neatly so that they look like new again."
                            }
                        }
                    ],
                    "synonyms": [
                        "herstellen",
                        "lappen",
                        "oplappen",
                        "repareren",
                        "stoppen"
                    ],
                    "antonyms": [
                        "beschadigen"
                    ],
                    "common_phrases": [
                        "kleding verstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to repair damaged clothing or textiles by closing holes or fixing seams"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mend",
                                "target_lang_sense_clarification": "to repair holes or tears in fabric"
                            },
                            {
                                "target_lang_word": "patch",
                                "target_lang_sense_clarification": "to repair by adding a piece of material"
                            },
                            {
                                "target_lang_word": "alter",
                                "target_lang_sense_clarification": "to change clothing for a better fit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}