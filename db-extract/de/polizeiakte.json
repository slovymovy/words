                                "example_id": "ce3ee41b-0847-4685-9de7-0f45dd9ac5db",
                                "sense_id": "6a6b9f46-b7b7-345c-94cd-0d635d992502",
                                "text": "„Es handelte sich um die Polizeiakte Germáns: Jugendgericht, öffentlicher Skandal.“"
                            },
                            {
                                "example_id": "18339c12-6df9-4e8d-8399-436af55e5432",
                                "sense_id": "6a6b9f46-b7b7-345c-94cd-0d635d992502",
                                "text": "„Niemand ahnte, dass Capones neue Gesichtsnarben in seine Polizeiakte und in die Geschichte eingehen würden.“"
