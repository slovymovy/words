                "senses": [
                    {
                        "sense_id": "e5392172-8111-3897-8640-58981b5622c5",
                        "entry_id": "f1a8159e-c040-3c0b-b74c-61662f8566ff",
                        "glosses": [
                            "Effilocher."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "067cd505-3612-49b7-b3ef-6eb8a19b56d7",
                                "sense_id": "e5392172-8111-3897-8640-58981b5622c5",
                                "text": "Ce matin, épais brouillard sur le fleuve. On ne voit ni la côte, ni les navires dont on entend le battement de l'hélice, comme un coeur. Le brouillard s'échiffe à travers les branches des arbres devant la galerie."
                            },
                            {
                                "example_id": "a052f64a-c688-43fb-98af-65e243fb5948",
                                "sense_id": "e5392172-8111-3897-8640-58981b5622c5",
                                "text": "J'ai frappé à coups répétés et la porte grinçante s'est enfin ouverte sur la triste figure de ma mère en peignoir échiffé, les cheveux défaits et le teint d'une lividité olivâtre."
                            }
                        ]
                    }
