                "senses": [
                    {
                        "sense_id": "1508f2b4-b252-3457-bc28-f6a5dfd18662",
                        "entry_id": "79686004-bc22-3272-abe8-314b5a7d3e2f",
                        "glosses": [
                            "Frist, während der eine vereinbarte Zahlung erfolgen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3bc60c6-a994-4a2d-9b62-3b8f075300bd",
                                "sense_id": "1508f2b4-b252-3457-bc28-f6a5dfd18662",
                                "text": "Die Zahlungsfrist endet in einer Woche."
                            },
                            {
                                "example_id": "0e97d4a5-c8e5-4da3-bb4d-f7d912b52a6c",
                                "sense_id": "1508f2b4-b252-3457-bc28-f6a5dfd18662",
                                "text": "„Im Ringen um eine Restrukturierung der Staatsschulden hat Argentinien erneut eine Zahlungsfrist verstreichen lassen und ist damit weiter auf einen drohenden Zahlungsausfall zugesteuert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd1547cc-75cd-4655-a335-1e7f6836e0df",
                        "source_entry_id": "79686004-bc22-3272-abe8-314b5a7d3e2f",
                        "source_sense_id": "1508f2b4-b252-3457-bc28-f6a5dfd18662",
                        "source_sense_description": "Frist, während der eine vereinbarte Zahlung erfolgen soll",
                        "target_lang_word": "délai de paiement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délai de paiement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eecf42ba-a249-3f74-9267-182a56cfa224",
                                        "entry_id": "df7a2d20-ba58-30c6-a24d-05ce7dbee15a",
                                        "glosses": [
                                            "Période de temps, prévu dans un contrat de vente, entre la livraison ou la facturation, par le fournisseur ou le prestataire, et le paiement par le client."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac2129f-0470-461c-bd46-7e398ffa429f",
                                                "sense_id": "eecf42ba-a249-3f74-9267-182a56cfa224",
                                                "text": "Les professionnels d’un secteur, clients et fournisseurs, peuvent décider conjointement de réduire le délai maximum de paiement fixé à l’alinéa précédent. […] Nonobstant les dispositions précédentes, pour le transport routier de marchandises, pour la location de véhicules avec ou sans conducteur, […] les délais de paiement convenus ne peuvent en aucun cas dépasser trente jours à compter de la date d’émission de la facture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
