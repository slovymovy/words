        "fr-extract.jsonl": [
            {
                "entry_id": "1fa3e89e-bd3c-3731-903b-f91a7bf1f27b",
                "word": "forcément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38305240-db45-329c-ba94-1dd581822915",
                        "entry_id": "1fa3e89e-bd3c-3731-903b-f91a7bf1f27b",
                        "glosses": [
                            "Par force ; par obligation ; par une conséquence rigoureuse ou inévitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9c9a26-3be8-4c2c-a9ef-02c0c296ea93",
                                "sense_id": "38305240-db45-329c-ba94-1dd581822915",
                                "text": "Forcément, l’époque où nous vécûmes le plus près de Dieu, le Moyen Age, devait suivre la tradition révélée du Christ […]."
                            },
                            {
                                "example_id": "840641c1-0ceb-4aa7-9963-2b4d9b9edba7",
                                "sense_id": "38305240-db45-329c-ba94-1dd581822915",
                                "text": "Les groupes religieux minoritaires ne sont pas forcément rejetés : les adeptes de la religion monophysite, ou les quakers ou les amishs, ne sont l'objet d'aucune suspicion."
                            },
                            {
                                "example_id": "3fac936f-874c-430f-adcc-969c2882b620",
                                "sense_id": "38305240-db45-329c-ba94-1dd581822915",
                                "text": "Pour aller à tel endroit, vous passerez forcément par tel chemin."
                            }
                        ]
                    },
                    {
                        "sense_id": "420107bb-3176-3ae7-a340-a32db4b13ffd",
                        "entry_id": "1fa3e89e-bd3c-3731-903b-f91a7bf1f27b",
                        "glosses": [
                            "D’une manière forcée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "207c3c5b-744b-469f-b996-049ced81a73e",
                                "sense_id": "420107bb-3176-3ae7-a340-a32db4b13ffd",
                                "text": "Elle se mit à rire, mais forcément."
                            },
                            {
                                "example_id": "6ed53949-93f5-4377-82bd-50c6f9cad6ff",
                                "sense_id": "420107bb-3176-3ae7-a340-a32db4b13ffd",
                                "text": "Je paraissais peu sensible aux attentions de ma mère ; je repoussais ses caresses, que je recevais forcément et avec impatience."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0933a73-fb02-4c17-b8ac-e58b8f3064f3",
                        "source_entry_id": "1fa3e89e-bd3c-3731-903b-f91a7bf1f27b",
                        "source_sense_description": "Par force, par obligation, par une conséquence rigoureuse ou inévitable.",
                        "target_lang_word": "zwangsläufig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwangsläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                        "entry_id": "7723ef6d-932e-3787-a94b-1e983f10d1a1",
                                        "glosses": [
                                            "zwingend eintretend und unmöglich, vermieden zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca6e620c-15f2-458d-b399-e7aa6dd11533",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Wenn Du die Tasse vom Tisch stößt, muss sie zwangsläufig zu Boden fallen."
                                            },
                                            {
                                                "example_id": "be2cfae5-7e02-4342-a38c-9f9e2832573a",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Dieser Krieg wird uns zwangsläufig an den Rand des Untergangs treiben."
                                            },
                                            {
                                                "example_id": "36e936e3-3720-4dfb-8509-4bae4ab1d46d",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Drogenkarrieren enden fast zwangsläufig in Armut und Obdachlosigkeit."
                                            },
                                            {
                                                "example_id": "b50f4529-179c-4217-824e-e0f709e7eb91",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Er empfiehlt wegen des schlechten Wetters zwangsläufig zur Hütte umzukehren und erst beim Schönwetter wieder weiter zu Wandern."
                                            },
                                            {
                                                "example_id": "edbe81b5-0ce2-4083-a50d-9bf0426d9931",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "„Zu diesem Zeitpunkt wurde sie zwangsläufig zu einer nationalen und internationalen Figur.“"
                                            },
                                            {
                                                "example_id": "c5cc0ca2-5d1e-411b-8c51-e5ac24314b7a",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "„Eine Beförderung war daher zwangsläufig mit einer Versetzung verbunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91ecb4f6-3b25-4044-91f4-5970c202665e",
                        "source_entry_id": "1fa3e89e-bd3c-3731-903b-f91a7bf1f27b",
                        "source_sense_description": "Par force, par obligation, par une conséquence rigoureuse ou inévitable.",
                        "target_lang_word": "necessarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necessarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                        "entry_id": "a235f6aa-322a-3eb3-9b85-6bedeefe0837",
                                        "glosses": [
                                            "Inevitably; of necessity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc75b67-f1d2-4283-b953-7fb4a0795006",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "It is not necessarily true that children get their morals from their parents."
                                            },
                                            {
                                                "example_id": "cdce5b1d-007b-40d1-b345-97f2940540ab",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "But clever cities will not necessarily be better ones."
                                            },
                                            {
                                                "example_id": "05607629-a489-405f-a83c-d7200b806f09",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "Oregon’s uptick in marijuana sales along the Idaho border doesn’t necessarily mean that it’s all Idahoans who are lighting up, Lehner said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54749280-cb6a-47cc-b76f-aed6ad9602b0",
                        "source_entry_id": "1fa3e89e-bd3c-3731-903b-f91a7bf1f27b",
                        "source_sense_description": "Par force, par obligation, par une conséquence rigoureuse ou inévitable.",
                        "target_lang_word": "inevitably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inevitably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "In a manner that is impossible to avoid or prevent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08800aaa-6923-483d-aa77-7be4292fad13",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Inevitably, all creatures eventually die."
                                            },
                                            {
                                                "example_id": "5827a595-83c6-484b-9bc4-c0a5881c1a61",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The sun inevitably rises."
                                            },
                                            {
                                                "example_id": "06bf50fd-b154-4936-9eb2-e3fe5abba149",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Despite the town's best efforts, the dam inevitably gave way."
                                            },
                                            {
                                                "example_id": "db8f225d-9ab6-4e49-ba19-07d68df88c12",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The inevitably cold winter approaches."
                                            },
                                            {
                                                "example_id": "409248be-d951-46c3-b7e3-0eca0be61dc0",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "In a period of transition from steam to diesel, many of the schemes are inevitably of an interim nature and only on full dieselisation will the final pattern be determined and full benefit derived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "As usual; predictably; as expected."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94f48e5-d72a-4b55-8a4f-83af29ec993e",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Inevitably, the next-door neighbour began to mow his lawn just as she lays down her head after a long night shift."
                                            },
                                            {
                                                "example_id": "0ee46b52-0abd-4d75-a09e-3a3829bb3924",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The child inevitably began to cry when his mother went to work."
                                            },
                                            {
                                                "example_id": "28c305d3-4fc2-4be3-b7f6-117a34258d46",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The inevitably long line of customers queued for the latest 'Harry Potter'."
                                            },
                                            {
                                                "example_id": "4930ca80-51b7-41c5-8c1a-f41c6cec8d05",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Far from it: direct military intervention by a Western state – even if Prime Minister Nuri al-Maliki is requesting it – would dramatically worsen the situation, and ISIS, contrary to what pro-interventionists might say, would inevitably come out on top."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
