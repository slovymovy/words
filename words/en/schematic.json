{
    "word_family": [
        "schema",
        "schematize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19d0d49c-7a66-3321-a68b-89d3599566ef",
                    "sense_definition": "Relating to a schema or a structured plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schema_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the <w>schematic</w> structure of the language model during the lecture.",
                            "target_lang_translations": {
                                "zh": "教授在讲座中解释了该语言模型的<w>图式</w>结构。"
                            }
                        },
                        {
                            "text": "We need to follow the <w>schematic</w> design to ensure all components fit correctly.",
                            "target_lang_translations": {
                                "zh": "我们需要遵循<w>结构化</w>设计，以确保所有组件都能正确安装。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "schematic design",
                        "schematic form"
                    ],
                    "target_lang_definitions": {
                        "zh": "与图式或结构化计划相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "图式的",
                                "target_lang_sense_clarification": "指代与图式或结构化框架有关的属性。"
                            },
                            {
                                "target_lang_word": "结构化的",
                                "target_lang_sense_clarification": "指代按照某种既定结构或计划组织的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0e2fa53-1ec5-3c81-89b0-418c59f73878",
                    "sense_definition": "Represented in an overly simple or formulaic way, lacking depth or detail.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "simplistic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film's <w>schematic</w> portrayal of the conflict ignored the complex historical reality.",
                            "target_lang_translations": {
                                "zh": "这部电影对冲突的<w>公式化</w>描绘忽略了复杂的历史现实。"
                            }
                        },
                        {
                            "text": "His <w>schematic</w> view of human nature fails to account for individual differences.",
                            "target_lang_translations": {
                                "zh": "他那种<w>简单化</w>的人性观无法解释个体差异。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以过于简单或公式化的方式呈现，缺乏深度或细节。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "公式化的",
                                "target_lang_sense_clarification": "指代刻板、缺乏变化或深度的表达方式。"
                            },
                            {
                                "target_lang_word": "简单化的",
                                "target_lang_sense_clarification": "指代将复杂事物过度简化处理的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cc010f3-afb3-33bd-bc59-533e2f47bf92",
                    "sense_definition": "Being sketchy or incomplete in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "simplistic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The initial report was quite <w>schematic</w> and lacked the necessary data for a final decision.",
                            "target_lang_translations": {
                                "zh": "最初的报告相当<w>粗略</w>，缺乏做出最终决定所需的必要数据。"
                            }
                        },
                        {
                            "text": "He provided a <w>schematic</w> outline of the project that left many questions unanswered.",
                            "target_lang_translations": {
                                "zh": "他提供了一份项目的<w>概要</w>大纲，留下了许多未解的问题。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "本质上是粗略的或不完整的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "粗略的",
                                "target_lang_sense_clarification": "指代内容简略、缺乏细节的。"
                            },
                            {
                                "target_lang_word": "概要的",
                                "target_lang_sense_clarification": "指代仅提供大纲或概况的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da17cb23-f460-3449-9d4b-6720252fab8a",
                    "sense_definition": "A simplified line drawing illustrating a system at an abstract level.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schema_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer carefully reviewed the <w>schematic</w> to identify the faulty connection.",
                            "target_lang_translations": {
                                "zh": "工程师仔细检查了<w>原理图</w>以找出故障连接点。"
                            }
                        },
                        {
                            "text": "You should check the <w>schematic</w> before attempting to repair the electronic device.",
                            "target_lang_translations": {
                                "zh": "在尝试修理该电子设备之前，你应该先查看<w>示意图</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diagram"
                    ],
                    "common_phrases": [
                        "read a schematic",
                        "internal schematic"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种以抽象层面说明系统的简化线条图。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "原理图",
                                "target_lang_sense_clarification": "指代电子或机械系统的抽象结构图。"
                            },
                            {
                                "target_lang_word": "示意图",
                                "target_lang_sense_clarification": "指代用于说明系统运作方式的简化图表。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}