                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb90e62-3b0d-33ae-aaac-e9cc4de147a9",
                                        "entry_id": "a42ced02-479c-35b3-9cf4-289e125155f0",
                                        "glosses": [
                                            "Atome ou molécule ayant perdu ou gagné des électrons sur sa couche externe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b71e6bc-e88c-4f30-a13c-633e508bd44d",
                                                "sense_id": "6bb90e62-3b0d-33ae-aaac-e9cc4de147a9",
                                                "text": "Lorsqu’on soumet de l’eau salée à l’action d’un courant électrique, les ions positifs (sodium) se rendent au pôle négatif et les ions négatifs (chlorure) au pôle positif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad6bf260-e12a-4c9d-8e89-34b7aebef815",
                        "source_entry_id": "2824ae97-e6dd-3591-bfe3-515a979e1eb6",
                        "source_sense_id": "9270dab6-aadb-3ada-9b99-4dd5246f0248",
                        "target_lang_word": "ion",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ion",
