                "senses": [
                    {
                        "sense_id": "7fca309c-0fb2-3d38-9220-dd477f740764",
                        "entry_id": "fb0934db-e575-31bb-8170-71bb2fdadd73",
                        "glosses": [
                            "regulär berufener Schöffe (Laienrichter) für den Einsatz an etwa zwölf Sitzungstagen pro Jahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be9270e-46b3-4e23-8463-0c4a17de9b3c",
                                "sense_id": "7fca309c-0fb2-3d38-9220-dd477f740764",
                                "text": "„Nach Angaben des Justizministeriums in Wiesbaden sitzen in hessischen Gerichten allein mehr als 2500 Hauptschöffen neben ihren hauptberuflichen Kollegen auf den Richterbänken.“"
                            },
                            {
                                "example_id": "7a51eb1e-24ee-4c27-a5e1-636f837d7b20",
                                "sense_id": "7fca309c-0fb2-3d38-9220-dd477f740764",
                                "text": "„Ich war fünf Jahre lang Hauptschöffe am Amtsgericht Köln und habe einen Blick unter die Roben und Talare der deutschen Justiz werfen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
