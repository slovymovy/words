                        "cross_references": [
                            {
                                "target_word": "arthrologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aed9ce01-0d2a-3d6d-b46d-29e3e15a0c23",
                                        "entry_id": "d174f674-1f09-356a-b6d6-04bfb36e1c62",
                                        "glosses": [
                                            "La partie de l’anatomie et de la pathologie qui traite des articulations, des mouvements et de leurs dysfonctionnements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d43e862-3654-435a-9e2d-46c344e48f34",
                                                "sense_id": "aed9ce01-0d2a-3d6d-b46d-29e3e15a0c23",
                                                "text": "L’arthrologie (Arthrologia) ou \"syndesmologie\" est la partie de l’Anatomie qui étudie les articulations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
