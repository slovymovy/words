                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6271291-f492-3f05-972f-3f82985fa4a0",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "The continuing course of life; thread of life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "An ordered course, that which connects the successive points in a discourse.",
                                            "A line of reasoning, sequence of ideas, or train of thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a812f5-44a6-427c-8099-2b399126fed8",
                                                "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                                "text": "I’ve lost the thread of what you’re saying."
                                            },
                                            {
                                                "example_id": "9cedc89a-dea5-433a-b1f8-7f7c5b3cda74",
                                                "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                                "text": "I was pondering these things, when an incident, and a somewhat unexpected one, broke the thread of my musings."
                                            },
                                            {
                                                "example_id": "89414d5a-251a-4be1-b636-f8916ac77367",
                                                "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                                "text": "‘Let him go on. Do not interrupt him. He cannot go back, and maybe could not proceed at all if once he lost the thread of his thought.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6ed44d-ff91-3b69-a031-8fba53d82632",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "An ordered course, that which connects the successive points in a discourse.",
                                            "A continuing theme that modifies the whole discourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7f2a8e-f628-419e-9b4e-39a3840a737c",
                                                "sense_id": "0f6ed44d-ff91-3b69-a031-8fba53d82632",
                                                "text": "All of these essays have a common thread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62dec016-d81e-3a59-94e3-3e032667e0fc",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A unit of execution, lighter in weight than a process, usually sharing memory and other resources with other threads executing concurrently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9eaf22f3-3822-3f45-861a-dc840f6d62fb",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A series of posts or messages, consisting of an initial post and responses to it, generally relating to the same subject, on a newsgroup, Internet forum, or social media platform."
                                        ],
