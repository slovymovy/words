                ],
                "senses": [
                    {
                        "sense_id": "38491ed8-a4cf-3616-8a9b-374f569cffef",
                        "entry_id": "10167031-5872-3097-8251-50d5d83ce483",
                        "glosses": [
                            "to grow dark/dim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb08767-2492-4af3-a5c5-ae21d3d6b75d",
                                "sense_id": "38491ed8-a4cf-3616-8a9b-374f569cffef",
                                "text": "Плева́ть, что нет\nу Гоме́ров и Ови́диев\nлюде́й, как мы;\nот ко́поти в о́спе.\nЯ зна́ю —\nсо́лнце поме́ркло б, уви́дев\nна́ших душ золоты́е ро́ссыпи!",
                                "translation": "Who gives a damn that\nHomer or Ovid\nHave no characters like us,\nSpotted with soot.\nI know –\nThe Sun would grow dim, if it saw\nThe gold-mines in our souls!",
                                "english": "Who gives a damn that\nHomer or Ovid\nHave no characters like us,\nSpotted with soot.\nI know –\nThe Sun would grow dim, if it saw\nThe gold-mines in our souls!"
                            }
                        ]
                    },
                    {
                        "sense_id": "04c52f17-9717-350b-ac3f-4b0f5eac7aa4",
                        "entry_id": "10167031-5872-3097-8251-50d5d83ce483",
                        "glosses": [
                            "to fade, to wane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e3ae94-e464-4f75-b923-378501c93968",
                                "sense_id": "04c52f17-9717-350b-ac3f-4b0f5eac7aa4",
                                "text": "его́ сла́ва поме́ркла",
                                "translation": "his fame dwindled",
                                "english": "his fame dwindled"
                            }
                        ]
                    },
