                        "sense_id": "8b2e0507-9f0e-3bd0-9ab5-5b7853b318b3",
                        "entry_id": "bc4ff9a3-a98d-3fb2-aa81-3378c3c61d0b",
                        "glosses": [
                            "Person, die sexuellen Lustgewinn daraus zieht, sich vor Fremden zu entblößen"
                        ],
                        "tags": [],
