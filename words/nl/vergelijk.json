                },
                {
                    "sense_id": "13583cdf-b343-32ac-8a80-b1d15218faf0",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>vergelijken</w>.",
                    "learner_level": "A1",
