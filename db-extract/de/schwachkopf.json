                ],
                "senses": [
                    {
                        "sense_id": "8664c318-3923-36cb-a916-90c66d78e620",
                        "entry_id": "14419262-fa72-3ea5-a69f-88f0866b5147",
                        "glosses": [
                            "dimwit, idiot, jerk"
                        ],
                        "tags": [
                            "derogatory",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d0e7c164-f05b-4e0c-adbc-54da0e46f450",
                                "sense_id": "8664c318-3923-36cb-a916-90c66d78e620",
                                "text": "\"Aber soll denn jeder Schwachkopf, wenn er nur Geld hat, studiren dürfen?\" Nein! keinem Schwächlinge dieser Art soll die Schranke geöffnet werden.",
                                "translation": "\"But should every idiot who has money be allowed to study?\" No! For no weakling of this kind the barrier should be opened.",
                                "english": "\"But should every idiot who has money be allowed to study?\" No! For no weakling of this kind the barrier should be opened."
                            },
                            {
                                "example_id": "bb0dda99-c7fe-456f-9a31-005492efc1c3",
                                "sense_id": "8664c318-3923-36cb-a916-90c66d78e620",
                                "text": "\"Hiob? Dieser Schwachkopf, dem Gott jede Menge Unheil schickte, um ihn auf die Probe zu stellen?\"",
                                "translation": "\"Job? That idiot to whom God sent a lot of harm in order to test him?\"",
                                "english": "\"Job? That idiot to whom God sent a lot of harm in order to test him?\""
                            },
                            {
                                "example_id": "6e96d65a-3925-4a9d-8226-005d390b17c7",
                                "sense_id": "8664c318-3923-36cb-a916-90c66d78e620",
                                "text": "\"Und\", fuhr er fort, \"wenn du dann endlich wieder mehr Zeit für mich aufbringst, anstatt dich um diesen Schwachkopf hier zu kümmern, dann setzen wir unseren gemütlichen Abend von gestern fort.\"",
                                "translation": "\"And\", he went on, \"when you finally spend more time with me again instead of looking after this idiot here, we will continue last night's placid evening.\"",
                                "english": "\"And\", he went on, \"when you finally spend more time with me again instead of looking after this idiot here, we will continue last night's placid evening.\""
                            }
                        ]
                    }
                ],
