                    {
                        "form_id": "f8ca95de-9d3f-4a2a-b729-8df7c56f72cf",
                        "entry_id": "07add101-9892-35a2-9bb7-fb0b74182c5f",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "wheed"
                    },
                    {
                        "form_id": "27caa2d8-2529-418d-838e-a17dcca1019c",
                        "entry_id": "07add101-9892-35a2-9bb7-fb0b74182c5f",
                        "tags": [
                            "past"
                        ],
                        "form": "wheed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "186bb5fd-2f06-34f0-ab38-ed9723c2a773",
                        "entry_id": "07add101-9892-35a2-9bb7-fb0b74182c5f",
                        "glosses": [
                            "To make a high-pitched sound."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cc381a69-7f29-41bf-9986-887e8b4195c6",
                                "sense_id": "186bb5fd-2f06-34f0-ab38-ed9723c2a773",
                                "text": "What a wheeing dost thou keep, / Thou Minion of the Spring, / All the Winter long you sleep, / And all the Summer long you sing."
                            },
                            {
                                "example_id": "3362f70f-138a-4481-a8d4-2e95256e890d",
                                "sense_id": "186bb5fd-2f06-34f0-ab38-ed9723c2a773",
                                "text": "Bullets ricocheted off the walls and the ceiling, wheeing by him, and his face stung from chips of stone."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cb56d68-eabc-3209-986d-c346a258c324",
                        "entry_id": "07add101-9892-35a2-9bb7-fb0b74182c5f",
                        "glosses": [
                            "To cry whee."
                        ],
                        "tags": [
                            "informal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "33858bff-eba7-4b8f-9c2f-198539155a2d",
                                "sense_id": "2cb56d68-eabc-3209-986d-c346a258c324",
                                "text": "Sometimes, we whee together, at the same time, for the same reason, feeling the same thing. And sometimes – these are the best of times – we can’t really tell who started the whee, or who’s wheeing more."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e7f54ea-2d2e-3e09-a280-a0495b44c3b8",
                        "entry_id": "07add101-9892-35a2-9bb7-fb0b74182c5f",
                        "glosses": [
                            "To excite; to arouse; to energize."
                        ],
                        "tags": [
