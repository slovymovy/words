                        "glosses": [
                            "A deceiver, a beguiler."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "73deed02-e36c-41c3-a122-691ab1b15770",
                                "sense_id": "1960a6f1-3ef6-3fa0-aeb4-bc13e3d77630",
                                "text": "And þow hast gyuen hire to a gyloure · now god gyf þe sorwe."
                            },
                            {
                                "example_id": "c92a03b5-5e70-4191-a0c8-8b2741753f56",
                                "sense_id": "1960a6f1-3ef6-3fa0-aeb4-bc13e3d77630",
                                "text": "But he was wary wise in all his way,\nAnd well perceived his deceitful sleight,\nNe suffered Lust his Safety to betray;\nSo goodly did beguile the Guiler of the Prey"
                            },
                            {
                                "example_id": "a5458a6f-a422-4f25-ad89-407ae4e2ec9a",
                                "sense_id": "1960a6f1-3ef6-3fa0-aeb4-bc13e3d77630",
                                "text": "The devil is the arch-trickster — who tricked Man with the apple in Eden — and in the 'guiler beguiled' model God beats him at his own game with the ultimate 'trick', or paradox of the God–man Jesus."
                            }
                        ]
                    }
