                                "target_senses": [
                                    {
                                        "sense_id": "2e28c445-7f11-3ef9-ab95-fedc4acb5e3f",
                                        "entry_id": "e02f5754-628b-3bef-8b1c-4d8852a49912",
                                        "glosses": [
                                            "de triviale naam voor het 3:1-mengsel van geconcentreerd zoutzuur en geconcentreerd salpeterzuur waarin edele metalen zoals goud en platina oplossen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41eb766-c116-42de-a815-5582499d83fc",
                                                "sense_id": "2e28c445-7f11-3ef9-ab95-fedc4acb5e3f",
                                                "text": "In twee flinke klaslokalen wordt het goud herwonnen. In het ene lokaal lossen ze het oude goud op in koningswater: een mengsel van drie delen zoutzuur en een deel salpeterzuur, het enige mengsel waar goud in kan worden opgelost. Daar wordt het door middel van elektrolyse weer uitgehaald, maar dan zonder alle verontreiniging in het oude goud en de eventuele legering waar dat uit bestond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
