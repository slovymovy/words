            "senses": [
                {
                    "sense_id": "7c4fbb62-c3fd-30d1-a796-61b4bcba8eab",
                    "sense_definition": "Short for <w>polyamorous</w>; relating to the practice of having more than one open romantic relationship at a time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relationships",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She identifies as <w>poly</w> and is currently dating two different people.",
                            "target_lang_translations": {
                                "ru": "Она идентифицирует себя как <w>полиаморка</w> и в данный момент встречается с двумя разными людьми."
                            }
                        },
                        {
                            "text": "Whether the family is <w>poly</w> or another minority, coming out is a personal decision.",
                            "target_lang_translations": {
                                "ru": "Является ли семья <w>полиаморной</w> или относится к другому меньшинству, каминг-аут — это личное решение."
                            }
