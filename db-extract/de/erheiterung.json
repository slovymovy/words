                ],
                "senses": [
                    {
                        "sense_id": "c0ecefca-fb92-3582-85ae-6de327b17f40",
                        "entry_id": "e7ca394f-2206-3f16-9dae-360384cdc911",
                        "glosses": [
                            "Vorgang, jemanden heiter zu stimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a11e7bb4-1ffc-4221-b15e-27a2e98894d9",
                                "sense_id": "c0ecefca-fb92-3582-85ae-6de327b17f40",
                                "text": "„Jeder Fremde der kam, wenn er nicht zufällig ein Kenner war, nahm diese Dolden für richtige Aloeblüten, und der Schloßherr hütete sich wohl, diesen Glauben, der eine Quelle der Erheiterung für ihn war, zu zerstören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35b68000-39c6-3626-aa4b-72f9f201ac24",
                        "entry_id": "e7ca394f-2206-3f16-9dae-360384cdc911",
                        "glosses": [
                            "Ergebnis von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18386d5-8cee-4409-a80b-0cef60ffec49",
                                "sense_id": "35b68000-39c6-3626-aa4b-72f9f201ac24",
                                "text": "„Zu Sylvias stiller Erheiterung saß Joyce oft gut sichtbar auf dem grünen Sessel oder in einer Ecke des Bibliotheksbereichs.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3957b8fa-1847-40f2-aebb-5dcebedfc01e",
                        "source_entry_id": "e7ca394f-2206-3f16-9dae-360384cdc911",
                        "source_sense_id": "c0ecefca-fb92-3582-85ae-6de327b17f40",
                        "source_sense_description": "Vorgang, jemanden heiter zu stimmen",
                        "target_lang_word": "amusement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "Entertainment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247c70fa-286d-4bef-bebb-e0e7702ea5d2",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "To my great amusement, the dog kept on chasing its tail and yelped when it bit it."
                                            },
                                            {
                                                "example_id": "0e737311-22aa-422b-bf9b-65a918b4bb94",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "This is some form of amusement you're talking about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "An activity that is entertaining or amusing, such as dancing, gunning, or fishing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5d70d6-fdd6-425e-afd2-45ab4bad3bd4",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "\"What a charming amusement for young people this is, Mr. Darcy! There is nothing like dancing after all. I consider it as one of the first refinements of polished society.\""
                                            },
                                            {
                                                "example_id": "0bdd7367-bdd2-498d-9848-56ca96262f11",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "His chief amusements were gunning and fishing, or sauntering along the beach and through the myrtles, in quest of shells or entomological specimens--his collection of the latter might have been envied by a Swammerdamm."
                                            },
                                            {
                                                "example_id": "7013f761-b22d-467a-bb84-05d69a48f281",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "The Cat was sour-tempered and grumpy, at first, but before they had journeyed far, the crystal creature had discovered a fine amusement. The long tails of the monkeys were constantly sticking through the bars of their cage, and when they did, the Glass Cat would slyly seize the tails in her paws and pull them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d748a25d-88fb-410c-a7c3-77d39cd48b3f",
                        "source_entry_id": "e7ca394f-2206-3f16-9dae-360384cdc911",
                        "source_sense_id": "c0ecefca-fb92-3582-85ae-6de327b17f40",
                        "source_sense_description": "Vorgang, jemanden heiter zu stimmen",
                        "target_lang_word": "entretenimento",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entretenimento",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "fe0aa4ba-f89c-36f7-b336-fbea40b031a6",
                                        "entry_id": "1b436678-1304-3c5f-8218-11d2f5bad07c",
                                        "glosses": [
                                            "diversão"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "884b8cd5-d275-4ae7-a94f-75288d0de5c3",
                                                "sense_id": "fe0aa4ba-f89c-36f7-b336-fbea40b031a6",
                                                "text": "Não havia outro tipo de entretenimento, como piscina ou quadras esportivas. Seu formato não sobreviveu ao tempo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a4db4f6-b257-40fd-aeb3-084ab497512c",
