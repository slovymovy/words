                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "967acd88-ffe7-4f61-a5ed-f4cdd1d847be",
                        "entry_id": "91634cc7-e005-3d44-b3d8-82172ad9197e",
                        "tags": [
                            "plural"
                        ],
                        "form": "clochardes"
                    },
                    {
                        "form_id": "f2fc99f2-9875-4294-9b00-de3f237330e6",
                        "entry_id": "91634cc7-e005-3d44-b3d8-82172ad9197e",
                        "tags": [
                            "masculine"
                        ],
                        "form": "clochard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40985acb-79fa-35b5-8588-a0ac4edc0d52",
                        "entry_id": "91634cc7-e005-3d44-b3d8-82172ad9197e",
                        "glosses": [
                            "Femme qui n’a ni argent ni résidence et qui vit à la rue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e5f6590-e24f-41ad-b3c1-765421e00088",
                                "sense_id": "40985acb-79fa-35b5-8588-a0ac4edc0d52",
                                "text": "Je n’ai jamais pu que regarder par une fente entre les deux planches de la palissade ; d’effroyables clochardes vociféraient en gesticulant, d’autres étaient assises, immobiles, dans la neige ou le dos au mur. Un jour, mon œil appliqué à la fente rencontra un autre œil qui y était collé de l’autre côté : une de choses les plus horribles qui me soient jamais arrivées !"
                            },
                            {
                                "example_id": "3eb77075-2629-4084-958c-8af408f11ec8",
                                "sense_id": "40985acb-79fa-35b5-8588-a0ac4edc0d52",
                                "text": "L’histoire de Heisuké et sa clocharde se répandait, et cela faisait beaucoup rire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c28ff98-c569-4ec1-a931-3fb8fd217bfa",
                        "source_entry_id": "91634cc7-e005-3d44-b3d8-82172ad9197e",
                        "source_sense_id": "40985acb-79fa-35b5-8588-a0ac4edc0d52",
                        "target_lang_word": "Pennerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pennerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b36a38-a16f-3da4-ac69-e4c9b012e441",
                                        "entry_id": "5592d34a-de01-38b2-acd4-d1bbdb90f680",
                                        "glosses": [
                                            "weibliche Person mit ungepflegtem Äußeren, die sich auf der Straße aufhält und vermutlich kein Heim hat; Obdachloser"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76dea7f1-49ae-49c9-a9b6-3cb12500020e",
                                                "sense_id": "c3b36a38-a16f-3da4-ac69-e4c9b012e441",
                                                "text": "Guck dir mal die Pennerin da drüben an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "212ed885-3a0f-3abc-99bd-b7904449078e",
                                        "entry_id": "5592d34a-de01-38b2-acd4-d1bbdb90f680",
                                        "glosses": [
                                            "weibliche Person, die durch ihre Taten oder ihr Verhalten negativ aufgefallen ist (häufig auf mangelnder Konzentration oder Vergesslichkeit beruhend)"
                                        ],
                                        "tags": [
                                            "Beleidigung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dd9bf34-0f1d-4ce9-abd7-47b98d96d4d1",
                                                "sense_id": "212ed885-3a0f-3abc-99bd-b7904449078e",
                                                "text": "Hör auf mich zu nerven, du Pennerin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9aa1061-8596-4a26-be1c-e37defda24f7",
                        "source_entry_id": "91634cc7-e005-3d44-b3d8-82172ad9197e",
                        "source_sense_id": "40985acb-79fa-35b5-8588-a0ac4edc0d52",
                        "target_lang_word": "Stadtstreicherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stadtstreicherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b0092dd-cef1-31c4-b38d-dc2984f07c86",
                                        "entry_id": "8cbbb70e-defc-32cd-ac34-89b23cdb0f51",
                                        "glosses": [
                                            "weibliche Person, die ohne festen Wohnsitz – vorwiegend in der Stadt – umherstreicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2998e7eb-e177-4bf6-b0a0-8b5a95153feb",
                                                "sense_id": "7b0092dd-cef1-31c4-b38d-dc2984f07c86",
                                                "text": "Die Stadtstreicherin hatte einen Einkaufswagen dabei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36d9e2af-7510-46fa-b671-0eb4ad0f5743",
                        "source_entry_id": "91634cc7-e005-3d44-b3d8-82172ad9197e",
                        "source_sense_id": "40985acb-79fa-35b5-8588-a0ac4edc0d52",
                        "target_lang_word": "Landstreicherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landstreicherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae9a9a00-11ca-3efb-838a-695a0afda559",
                                        "entry_id": "176bbe7a-59dd-31b8-a7ff-2a269d9b1b70",
                                        "glosses": [
                                            "weibliche Person ohne festen Wohnsitz, die umherstreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a416810-758f-4840-bd5b-a633f29c6317",
                                                "sense_id": "ae9a9a00-11ca-3efb-838a-695a0afda559",
                                                "text": "„[…] Sie erriet auch verschwiegene Gedanken bei den übrigen Passagieren: Vor dieser diebischen Landstreicherin, die sich selten wäscht und gewiß Ungeziefer an sich trägt, muß man auf der Hut sein.“"
                                            },
                                            {
                                                "example_id": "bc971870-5f78-4b0b-a3fc-3ee52185824e",
                                                "sense_id": "ae9a9a00-11ca-3efb-838a-695a0afda559",
                                                "text": "„Aber die Männer, denen sie am Ufer begegnete, hatten zu schwere Gedanken, als daß sie bemerkten, ob der Rock einer Landstreicherin einen Zoll mehr oder minder lang war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "355337bc-9716-4e2c-b100-4b4b48812c70",
                        "source_entry_id": "91634cc7-e005-3d44-b3d8-82172ad9197e",
                        "source_sense_id": "40985acb-79fa-35b5-8588-a0ac4edc0d52",
                        "target_lang_word": "Clocharde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Clocharde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae8e5fa-5bd3-3250-ad59-39900d7944bd",
                                        "entry_id": "2d2c33b6-e47f-330d-a26f-6779b833dd81",
                                        "glosses": [
                                            "französische Bezeichnung für Stadtstreicherin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da2367af-d711-43d4-a098-d4474de4aa37",
                                                "sense_id": "0ae8e5fa-5bd3-3250-ad59-39900d7944bd",
                                                "text": "„Die Clochards und Clocharden hatten ihre persönliche Sichtweise, ihre eigenen Gesetzesmässigkeiten, mit denen sie die Nischen behausten und wenn sie auch laut sprachen, blieben sie friedlich untereinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
