                        "examples": [
                            {
                                "example_id": "dbe94cd8-6c9b-4666-983a-23408d9846e4",
                                "sense_id": "1a6880a3-f0bf-3fca-b0dc-3f56716f5884",
                                "text": "Начали обмуровку четырёх котлов Бабкока. Работа идёт хорошо, печники кладут очень аккуратно."
                            }
                        ]
                    },
