                {
                    "sense_id": "ef292043-bf60-3766-98ad-59485c76a81d",
                    "sense_definition": "Firmly fixed, supported, or balanced; not shaking or moving.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hold the ladder <w>steady</w> while I climb up to the roof.",
                            "target_lang_translations": {
                                "ru": "Держи лестницу <w>неподвижно</w>, пока я поднимаюсь на крышу.",
                                "zh": "在我爬上屋顶时，把梯子扶<w>稳</w>。",
                                "pl": "Trzymaj drabinę <w>stabilnie</w>, kiedy będę wchodził na dach."
                            }
                        },
                        {
                            "text": "You need a <w>steady</w> hand to paint such fine details.",
                            "target_lang_translations": {
                                "ru": "Нужна <w>твёрдая</w> рука, чтобы рисовать такие мелкие детали.",
                                "zh": "画这些精细的细节需要有一双<w>稳健</w>的手。",
                                "pl": "Potrzebujesz <w>pewnej</w> ręki, aby namalować tak drobne szczegóły."
                            }
