                                "target_senses": [
                                    {
                                        "sense_id": "8151fc8b-8065-3380-a5e3-8aae75d8f6b6",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "A lifelike image of something, either verbal or visual."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2fb9bf-e320-4c34-b122-53c7dd6a3f42",
                                                "sense_id": "8151fc8b-8065-3380-a5e3-8aae75d8f6b6",
                                                "text": "If Demandt's essay served as a strident example of the German desire for normalcy, a more subtle example was provided by a brief allohistorical depiction of a Nazi victory in World War II written by German historian Michael Salewski in 1999."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1020f3a9-5231-3ff8-8e03-db989ad80bbb",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "A drawing or painting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cefa492a-1f45-371f-b69c-1f74a66aec6a",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "A representation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "The act of depicting."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a84e025-6737-4e94-87f3-5a33e9deee1e",
                                                "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                                "text": "It is nevertheless true that, whereas the teaching of music and literature is established on a scientific basis, the art of depiction is still taught in a primitive and inefficient way."
                                            },
                                            {
                                                "example_id": "d1d3fb34-3b71-4a48-9cf3-f82cd53ec156",
                                                "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                                "text": "But since \"realism\" or representational depiction is itself a mode of art, it can never escape some degree of formal removal from the raw data of experience; […]"
                                            },
                                            {
                                                "example_id": "473694fa-2413-4ba2-a97a-ba0883543ee9",
                                                "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                                "text": "As previously described, depiction is a unique type of visual representation defined by both seeing the activities/marks that constitute the depiction whilst also seeing the object of the depiction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "889d3963-cc03-467c-99bf-13acc847ceed",
                        "source_entry_id": "71bdca76-6e0c-3970-8d9c-2b9a77bce989",
                        "source_sense_id": "41472ec9-dda0-3b31-8d5d-38f3fe2a3012",
                        "source_sense_description": "schweizerisch: (detaillierte schriftliche) Darstellung, Beschreibung",
                        "target_lang_word": "description",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "description",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f04926-e972-3d18-a5e2-311cc3f4989b",
                                        "entry_id": "8ddd5fb0-f7e1-3db4-bc32-6f6f746e1e38",
                                        "glosses": [
                                            "Action de décrire, développement par lequel on décrit, on dépeint ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5266bdbc-4555-4928-a7f4-477bf85ef1de",
                                                "sense_id": "c5f04926-e972-3d18-a5e2-311cc3f4989b",
                                                "text": "Quant aux installations coopératives de la maison Michelin, elles sont un État dans l’État; elles constituent un monde dont la description nécessiterait une brochure spéciale."
                                            },
                                            {
                                                "example_id": "6896a7cb-fb33-44df-be64-72d92bea9d28",
                                                "sense_id": "c5f04926-e972-3d18-a5e2-311cc3f4989b",
                                                "text": "Tu remarqueras d’abord que les descriptions y sont très brèves, et que l’on n’y insiste sur l’aspect général des nuages, arbres et verdures de toute sorte, sentiers, lieux boisés, cours d’eau, etc., que dans la mesure où ces détails paraissent indispensables à l’intelligence du récit."
                                            },
                                            {
                                                "example_id": "9b9acd9a-c47b-468e-873d-89de8cc7b773",
                                                "sense_id": "c5f04926-e972-3d18-a5e2-311cc3f4989b",
                                                "text": "Si seulement il pouvait se lever, ou appeler quelqu'un, il chercherait dans le Peterson la description exacte de la mésange charbonnière."
                                            },
                                            {
                                                "example_id": "77bf9254-dbca-45f1-8625-904d9126a353",
                                                "sense_id": "c5f04926-e972-3d18-a5e2-311cc3f4989b",
                                                "text": "— Il trouve les descriptions trop longues. Il faut le comprendre, nous sommes au siècle de l’audiovisuel, évidemment, les romanciers du xixe avaient tout à décrire..."
                                            },
                                            {
                                                "example_id": "f6e23c14-1e50-4bfa-917f-c6c4f42d35f8",
                                                "sense_id": "c5f04926-e972-3d18-a5e2-311cc3f4989b",
                                                "text": "Les Allemands, qui écrouent Marie de Croÿ le 6 septembre, distribuent à toutes les kommandanturs la description de son frère Reginald, qui s’est volatilisé."
                                            },
                                            {
                                                "example_id": "674b9ff4-c1fe-448e-901f-4232a4b59fce",
                                                "sense_id": "c5f04926-e972-3d18-a5e2-311cc3f4989b",
                                                "text": "Certains développeurs peu réfléchis affichent même directement les descriptions des exceptions Java. Ce type de message d'erreurs reste totalement obscur et inutile pour un utilisateur lambda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4707eb69-8f64-3e7d-9440-1965ba4672a9",
                                        "entry_id": "8ddd5fb0-f7e1-3db4-bc32-6f6f746e1e38",
                                        "glosses": [
                                            "Inventaire qui indique le nombre et la qualité des meubles, papiers, etc., qui se trouvent dans une maison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75778600-ce18-4707-8d2d-bbc5f437c886",
                                                "sense_id": "4707eb69-8f64-3e7d-9440-1965ba4672a9",
                                                "text": "Le procès-verbal de saisie contient la description des meubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b92141d-1837-381d-b9eb-173a2f445b96",
                                        "entry_id": "8ddd5fb0-f7e1-3db4-bc32-6f6f746e1e38",
                                        "glosses": [
                                            "Livre qui fait connaître l’état présent d’une région, d’un pays, d’une partie du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb846a14-9dd1-4148-a9fd-1cda722f3b38",
                                                "sense_id": "8b92141d-1837-381d-b9eb-173a2f445b96",
                                                "text": "La description de l’Égypte, de l’Afrique, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653e0e40-101b-3cba-b25d-1e916ceab20e",
                                        "entry_id": "8ddd5fb0-f7e1-3db4-bc32-6f6f746e1e38",
                                        "glosses": [
                                            "Définition imparfaite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b516fb3-aed2-3a13-aa84-9b2cc56516cb",
                                        "entry_id": "8ddd5fb0-f7e1-3db4-bc32-6f6f746e1e38",
                                        "glosses": [
                                            "Action de décrire, de tracer une ligne, une surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
