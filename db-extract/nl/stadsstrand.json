                    {
                        "sense_id": "d39b1457-c7da-3a5b-90d6-be7b92d54d1e",
                        "entry_id": "3fdd2588-8b17-3fc3-bd6a-64bd07fe1427",
                        "glosses": [
                            "een aangelegd strand in een stad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898041b3-6818-49c3-b64c-ad8911d44ad1",
                                "sense_id": "d39b1457-c7da-3a5b-90d6-be7b92d54d1e",
                                "text": "In verschillende Nederlandse gevangenissen word je niet langer opgesloten. Ze zijn omgetoverd tot woonhuizen, werkplekken en bieden plaats aan paintballfeestjes en zelfs een stadsstrand."
                            },
                            {
                                "example_id": "ac7fc3f9-4f00-4816-8b4a-beef8e24667e",
                                "sense_id": "d39b1457-c7da-3a5b-90d6-be7b92d54d1e",
                                "text": "Naast het aardbevingsbestendige bouwkarakter, komt er meer bij het project kijken. Zo wordt er bij Delfzijl een stadsstrand aangelegd en komen er mogelijk windmolens op de dijk. \"Het wordt hartstikke hip en zeker goed vertoeven hier op de dijk\", vertelt een woordvoerder van waterschap Noorderzijlvest."
                            }
                        ]
                    }
