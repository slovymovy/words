                "senses": [
                    {
                        "sense_id": "dce50fe2-a2f7-3aa7-8c2f-732b3cafe188",
                        "entry_id": "8b45400b-155d-3349-9a07-cb756bd30874",
                        "glosses": [
                            "Yellow, as butter or cheese."
                        ],
                        "tags": [
                            "Northern-England",
                            "UK",
                            "dialectal",
                            "poetic",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "e4466c32-3142-4295-8e38-34d6da6071b4",
                                "sense_id": "dce50fe2-a2f7-3aa7-8c2f-732b3cafe188",
                                "text": "White shows the rye, the big of big of blaker hue,[…]"
                            },
                            {
                                "example_id": "d99bf462-f867-48ba-913d-e29987228d0e",
                                "sense_id": "dce50fe2-a2f7-3aa7-8c2f-732b3cafe188",
                                "text": "[…] the E. blake (identical with AS. blac, G. bleich, pale) is provincially used in the sense of yellow. As blake as a paigle, as yellow as a cowslip."
                            },
                            {
                                "example_id": "98675a24-ef7d-419b-9eec-8c02694ca63f",
                                "sense_id": "dce50fe2-a2f7-3aa7-8c2f-732b3cafe188",
                                "text": "Miss Lizzie's ower dark for my fancy. I mind nowt aboot your dark lasses - as blake as marygowds an' as black as corbies."
                            },
                            {
                                "example_id": "f7f8ade3-abb0-4927-8ad5-5a8fa9063f6f",
                                "sense_id": "dce50fe2-a2f7-3aa7-8c2f-732b3cafe188",
                                "text": "Noo, that's a bit o' neyce blake butter. Thoo nobbut leeaks blakeish."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
