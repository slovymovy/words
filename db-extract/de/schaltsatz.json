                ],
                "senses": [
                    {
                        "sense_id": "a213e026-2474-3baf-a2ed-fe2fa88b055c",
                        "entry_id": "ae404410-b746-341a-9f5c-229d95c8283b",
                        "glosses": [
                            "deutsche Bezeichnung für Parenthese, einen in einen Satz eingeschobenen anderen Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626749ed-26ac-4e58-9f00-e7644a88e3f4",
                                "sense_id": "a213e026-2474-3baf-a2ed-fe2fa88b055c",
                                "text": "In dem Satz: „Morgen werden wir endlich – das will ich hier ausdrücklich ankündigen – die entscheidenden Beschlüsse fassen“ ist der Teilsatz „das will ich hier ausdrücklich ankündigen“ ein Schaltsatz."
                            },
                            {
                                "example_id": "8a9b2302-c555-4eb7-a940-945606b1ea8d",
                                "sense_id": "a213e026-2474-3baf-a2ed-fe2fa88b055c",
                                "text": "Schaltsätze sind in andere Sätze eingeschoben, ohne mit ihnen morphologisch oder syntaktisch verbunden zu sein: Man kann Schaltsätze daher auch einfach weglassen, ohne dass deshalb der übergeordnete Satz unvollständig wird."
                            },
                            {
                                "example_id": "7666326c-0b04-4f90-84ef-d546599520c0",
                                "sense_id": "a213e026-2474-3baf-a2ed-fe2fa88b055c",
                                "text": "„Eine besondere Art zusammengesetzter Satz liegt vor, wenn ein syntaktisch eigenständiger Satz in einen anderen Satz eingeschoben oder ‚eingeschaltet‘ wird (…). Der eingeschobene Satz wird dann als Parenthese oder Schaltsatz bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
