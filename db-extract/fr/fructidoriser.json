                        "sense_id": "cd07cd58-ab78-3c17-8e33-57ede2c560c5",
                        "entry_id": "99ce43bf-c786-37b2-ba40-da40bd856d80",
                        "glosses": [
                            "Épurer par la violence une assemblée législative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3464437-6f70-4877-821b-1db14a6c7337",
                                "sense_id": "cd07cd58-ab78-3c17-8e33-57ede2c560c5",
                                "text": "Que la réaction redouble d'emportement, que les listes de proscription se complètent, qu'on ne juge pas et qu'on fructidorise, que les arbres de liberté soient tous abattus et que de cette liberté maudite il ne reste plus même un symbole."
                            }
                        ]
                    }
