{
    "word_family": [
        "glitter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "80891c30-550e-3492-b07b-477bb117e31b",
                    "sense_definition": "Brightly sparkling or shining with flashes of light.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glittering</w> stars looked beautiful in the clear night sky.",
                            "target_lang_translations": {
                                "zh": "晴朗的夜空中，<w>闪烁的</w>星星看起来很美。"
                            }
                        },
                        {
                            "text": "She wore a <w>glittering</w> necklace that caught the light of the <w>glittering</w> chandelier.",
                            "target_lang_translations": {
                                "zh": "她戴着一条<w>闪闪发光的</w>项链，映衬着<w>闪烁的</w>吊灯光芒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aglitter"
                    ],
                    "common_phrases": [
                        "glittering chandelier",
                        "glittering stars"
                    ],
                    "target_lang_definitions": {
                        "zh": "闪烁着明亮光芒的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪烁的",
                                "target_lang_sense_clarification": "形容光线忽明忽暗或闪耀的样子。"
                            },
                            {
                                "target_lang_word": "闪闪发光的",
                                "target_lang_sense_clarification": "形容物体表面反射出耀眼的光芒。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48615604-2a0f-3bb5-83b1-3292d9d2faa7",
                    "sense_definition": "Highly impressive, successful, or desirable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>glittering</w> career as a famous concert pianist.",
                            "target_lang_translations": {
                                "zh": "作为一名著名的音乐会钢琴家，他拥有<w>辉煌的</w>职业生涯。"
                            }
                        },
                        {
                            "text": "The university graduate received many <w>glittering</w> job offers after finishing his degree.",
                            "target_lang_translations": {
                                "zh": "这位大学毕业生在完成学业后收到了许多<w>诱人的</w>工作邀请。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "glittering career",
                        "glittering success"
                    ],
                    "target_lang_definitions": {
                        "zh": "极其令人印象深刻、成功或令人向往的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辉煌的",
                                "target_lang_sense_clarification": "形容成就或事业非常卓越、引人注目。"
                            },
                            {
                                "target_lang_word": "灿烂的",
                                "target_lang_sense_clarification": "形容前途或职业生涯非常光明、成功。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "558078da-337e-3af5-ba61-1ff147185bb2",
                    "sense_definition": "The appearance or act of something that shines with flashes of light.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glitterings</w> on the surface of the lake were mesmerizing at sunset.",
                            "target_lang_translations": {
                                "zh": "日落时分，湖面上<w>闪烁的</w>光芒令人着迷。"
                            }
                        },
                        {
                            "text": "She looked past the <w>glitterings</w> of the jewelry to see its true value.",
                            "target_lang_translations": {
                                "zh": "她透过珠宝的<w>闪光</w>，看到了它真正的价值。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "闪烁的光芒或闪耀的样子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪光",
                                "target_lang_sense_clarification": "指物体表面发出的闪烁光亮。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7c23617-aba7-331c-b8bc-bf6e6cb8b8ce",
                    "sense_definition": "The present participle and gerund of <w>glitter</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun was <w>glittering</w> on the calm water of the bay.",
                            "target_lang_translations": {
                                "zh": "阳光在平静的海湾水面上<w>闪烁</w>。"
                            }
                        },
                        {
                            "text": "I love <w>glittering</w> in the sunlight like a diamond.",
                            "target_lang_translations": {
                                "zh": "我喜欢像钻石一样在阳光下<w>闪烁</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb glitter."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 glitter 的现在分词或动名词形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "指光线闪动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}