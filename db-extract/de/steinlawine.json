                "senses": [
                    {
                        "sense_id": "604e1791-e4f3-3a1f-99d7-35083a1fd8c0",
                        "entry_id": "9efc68d0-5afc-3d99-9a56-40b2102498ca",
                        "glosses": [
                            "Gestein, das von einem Berg herabstürzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a599e8d-e019-44b7-ba8c-9cc5d42efc02",
                                "sense_id": "604e1791-e4f3-3a1f-99d7-35083a1fd8c0",
                                "text": "„Hier verlief zwischen frostbenagten Felsflanken ein ehemaliger Verkehrsweg. Mittlerweile war er zerklüftet und schrundig und teilweise begraben unter dem Schutt von Steinlawinen und alten Wachtürmen.“"
                            },
                            {
                                "example_id": "ed045f65-e0d1-4f6b-b2b4-061edbffa43f",
                                "sense_id": "604e1791-e4f3-3a1f-99d7-35083a1fd8c0",
                                "text": "„Dennoch gestalteten sich die Kämpfe schwieriger als erwartet, weil die Anwohner der Orte, die sie passierten, von Anhöhen aus angriffen und ihre Feinde mit Steinlawinen empfingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
