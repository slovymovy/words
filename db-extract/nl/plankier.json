                "senses": [
                    {
                        "sense_id": "7b5b1662-c412-356c-8d34-b36aeed9be11",
                        "entry_id": "9370dd7c-7633-381d-ac8e-e486513588d5",
                        "glosses": [
                            "een houten vloer gemaakt van planken die een stukje boven de grond of het water zweeft"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e49b596d-4105-38ad-80e7-ebaf872e3989",
                        "entry_id": "9370dd7c-7633-381d-ac8e-e486513588d5",
                        "glosses": [
                            "een van planken gemaakte steiger of stellage ook als deze niet van hout gemaakt is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f330c23-6309-489d-8ed4-97cae0e0e49e",
                                "sense_id": "e49b596d-4105-38ad-80e7-ebaf872e3989",
                                "text": "Het Ampzing-genootschap uit Haarlem staat zeer zeker een beetje apart. Het stelt zich tot doel de taal te vrijwaren van ongewenste elementen die er enkel als ,interessantdoenerij' in kunnen komen. Zoals babysitter, of een catwalk. Woorden uit het Engels waar we toch net zo goed ,oppas' en ,plankier' voor kunnen gebruiken. Of als we het wat speelser willen, ook ,zuigelingzitter' of ,poesplank'."
                            },
                            {
                                "example_id": "c96d6964-9625-4b26-bea9-b5fab2d3ac13",
                                "sense_id": "e49b596d-4105-38ad-80e7-ebaf872e3989",
                                "text": "Het veer - kosten: 100.000 euro - 'veert mee' met de stand van de Berkel. Is zelfs zondvloedbestendig, zeg maar: ook als de rest van de omgeving onder water zou staan, ligt het veer nog op zijn plaats. Consequentie is wel dat je nu nogal omlaag moet op het plankier, om op het veer te komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "54d00a0e-2e80-3485-9e70-d23f724ceea8",
                        "entry_id": "9370dd7c-7633-381d-ac8e-e486513588d5",
                        "glosses": [
                            "iets wat oorspronkelijk gemaakt was als houten steiger, aanlegplaats of perron (zelfs als het nu van steen is)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3f81995-a194-4cdc-b70c-ed1f83662c27",
                        "source_entry_id": "9370dd7c-7633-381d-ac8e-e486513588d5",
                        "source_sense_id": "7b5b1662-c412-356c-8d34-b36aeed9be11",
                        "source_sense_description": "een houten vloer gemaakt van planken",
                        "target_lang_word": "platform",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "platform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f26d06-7599-3801-88fc-735eb482eced",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A raised stage from which speeches are made and on which musical and other performances are made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b914983-4c9b-401e-a4fe-79f18031c983",
                                                "sense_id": "25f26d06-7599-3801-88fc-735eb482eced",
                                                "text": "Always, whether in the pulpit or on the platform, as in private conversation, there is an absolute simplicity about the man and his words; a simplicity, an earnestness, a complete honesty."
                                            },
                                            {
                                                "example_id": "cab7629b-2e8a-4b63-acd4-0834aeab90d1",
                                                "sense_id": "25f26d06-7599-3801-88fc-735eb482eced",
                                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a09bb53-390e-30b5-aadb-ff32e3e9411d",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A raised floor for any purpose, e.g. for workmen during construction, or formerly for military cannon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "528422f3-fe8b-3b92-99db-18ed91660b03",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A place or an opportunity to express one's opinion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1111d21-31a8-48e2-9b28-2964603b119e",
                                                "sense_id": "528422f3-fe8b-3b92-99db-18ed91660b03",
                                                "text": "This new talk show will give a platform to everyday men and women."
                                            },
                                            {
                                                "example_id": "44e6296a-4ccb-4161-96b5-449e17bc924f",
                                                "sense_id": "528422f3-fe8b-3b92-99db-18ed91660b03",
                                                "text": "[LeBron] James did not say which vaccine he had taken or the number of doses he had received. He also said that he would not use his platform to publicly encourage others to be vaccinated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e75b35e-c88a-324c-abed-afc278897fd5",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "Something that allows an enterprise to advance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac8feea0-4f63-4c00-b0cc-a1458cd08e50",
                                                "sense_id": "1e75b35e-c88a-324c-abed-afc278897fd5",
                                                "text": "Hidgson may actually feel England could have scored even more but this was the perfect first step on the road to Rio in 2014 and the ideal platform for the second qualifier against Ukraine at Wembley on Tuesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4513b42b-d798-3979-8dab-baffe8eab068",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A political stance on a broad set of issues, which are called planks."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8965a285-65bc-432f-a359-bbd28b28faea",
                                                "sense_id": "4513b42b-d798-3979-8dab-baffe8eab068",
                                                "text": "Now if the earth could be enjoyed in such a manner as every one might have provision, as it may by this platform I have offered, then will the peace of the commonwealth be preserved, and men need not act so hypocritically as the clergy do, and others likewise, to get a living."
                                            },
                                            {
                                                "example_id": "9555e44a-c2b5-45f5-8a74-653eb9e7685b",
                                                "sense_id": "4513b42b-d798-3979-8dab-baffe8eab068",
                                                "text": "The Communist Party and its candidates stand on the following platform, which expresses the immediate interests of the majority of the population of our country."
                                            },
                                            {
                                                "example_id": "89346ed9-3dea-4856-b950-ae8c1bb3ab39",
                                                "sense_id": "4513b42b-d798-3979-8dab-baffe8eab068",
                                                "text": "Surely there is nothing strange or new or threatening about such a platform. It will distress only those who have the essentially un-American view that change itself is frightening and should be avoided at all costs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "840d4151-50fb-398e-8cbc-299795ca1d4f",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A raised structure or other area alongside rails or a driveway alongside which vehicles stop to take in and discharge passengers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95b1d455-4204-42f5-8925-c372e58e723b",
                                                "sense_id": "840d4151-50fb-398e-8cbc-299795ca1d4f",
                                                "text": "We expressed our readiness, and in ten minutes were in the station wagon, rolling rapidly down the long drive, for it was then after nine.[…]As we reached the lodge we heard the whistle, and we backed up against one side of the platform as the train pulled up at the other."
                                            },
                                            {
                                                "example_id": "36c6e737-26ef-4f27-8c5b-4ab4a0a8610d",
                                                "sense_id": "840d4151-50fb-398e-8cbc-299795ca1d4f",
                                                "text": "People on the platforms / Waiting for the trains / I can hear their hearts a-beatin’ / Like pendulums swinging on chains"
                                            },
                                            {
                                                "example_id": "a618a923-6309-4068-9e81-0eb16d666c9c",
                                                "sense_id": "840d4151-50fb-398e-8cbc-299795ca1d4f",
                                                "text": "“Well, there you are, boy. Platform nine — platform ten. Your platform should be somewhere in the middle, but they don’t seem to have built it yet, do they?”"
                                            },
                                            {
                                                "example_id": "138e773b-0698-472e-88be-d4cb2e083212",
                                                "sense_id": "840d4151-50fb-398e-8cbc-299795ca1d4f",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. […] Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d652d56-5848-3e95-a859-16af7da5b1ed",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "Ellipsis of platform shoe (“a kind of high shoe with an extra layer between the inner and outer soles”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae868092-c225-4e6b-829e-3b1a9fa8fee5",
                                                "sense_id": "8d652d56-5848-3e95-a859-16af7da5b1ed",
                                                "text": "Now open the album cover! How fabulous! The four of them [the Pointer Sisters] in platforms of death, tacky gowns, and \"reflections of.\""
                                            },
                                            {
                                                "example_id": "8129e32e-3790-4681-b1e4-a90d7dd21e34",
                                                "sense_id": "8d652d56-5848-3e95-a859-16af7da5b1ed",
                                                "text": "Walk to Shazzer's from polling station was hideous walk of shame. Also cannot wear platforms now as feet too crippled so will look short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2428eb4b-12a3-3bdc-abfb-49744a4bda71",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A software system used to provide online services to clients, such as social media, e-commerce, or cloud computing."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2982a15b-3026-477f-a249-fa1eac840966",
                                                "sense_id": "2428eb4b-12a3-3bdc-abfb-49744a4bda71",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            },
                                            {
                                                "example_id": "9a273df7-b007-4d41-a084-9ca9c7c87147",
                                                "sense_id": "2428eb4b-12a3-3bdc-abfb-49744a4bda71",
                                                "text": "In fact, wealth and power are shifting to those who control the platforms on which all of us create, consume, and connect."
                                            },
                                            {
                                                "example_id": "399eeb43-f7b3-4440-8a91-765a3cc8acb0",
                                                "sense_id": "2428eb4b-12a3-3bdc-abfb-49744a4bda71",
                                                "text": "The promise of the platform business model is its magical self-reinforcement: Once the platform is in place, money is supposed to flow through the system without much extra effort at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f530c2e-1820-3d7b-b8df-97b2ca4952e3",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A particular operating system or environment such as a database or other specific software; a particular type of computer or microprocessor, used for running other software."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57133e62-69e9-409b-ac5a-8553bb5ea072",
                                                "sense_id": "9f530c2e-1820-3d7b-b8df-97b2ca4952e3",
                                                "text": "That program runs on the X Window System platform."
                                            },
                                            {
                                                "example_id": "a57d6441-67ad-43db-9a8d-67b41080aaea",
                                                "sense_id": "9f530c2e-1820-3d7b-b8df-97b2ca4952e3",
                                                "text": "“We used to produce our publication on the Mac, but the Wintel platform is cheaper and there are just as many applications available. So it just seemed to make sense to give up the religious war and get on with the business of doing our job,” said the information systems manager at a New York-based magazine, who asked not to be named."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9901f599-5014-3f9e-bf48-f7e61fa055cc",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "Ellipsis of car platform (“a set of components shared by several vehicle models”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caf842d4-aead-41ab-8fc6-6f6e9c34e59e",
                                                "sense_id": "9901f599-5014-3f9e-bf48-f7e61fa055cc",
                                                "text": "A car platform consists of the underbody, suspension, and axles, plus components such as the steering mechanism, engine, and powertrain. Using such a platform, a car company can design several distinct car models to suit different customer groups[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af6abaa-5d3f-350d-b913-138bd9d094f7",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A flat expanse of rock, often the result of wave erosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7eccec1-bc48-40ed-bf9d-9ec74964d345",
                                                "sense_id": "5af6abaa-5d3f-350d-b913-138bd9d094f7",
                                                "text": "Wave erosion causes a sea cliff to migrate landward, leaving a gently sloping surface, called a wave-cut platform. A wave-built platform originates by deposition at the seaward margin of the wave-cut platform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd9472a0-f274-307c-8ec4-7ec64b15bb1a",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A light deck, usually placed in a section of the hold or over the floor of the magazine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afa41454-8db4-34f4-b171-b7f0c5c44c01",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A plan; a sketch; a model; a pattern."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c77e0b9-f9ac-4381-96f1-d6098e000091",
                                                "sense_id": "afa41454-8db4-34f4-b171-b7f0c5c44c01",
                                                "text": "His destruction intended by queene Quendred, hir platforme of the practise to kill him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c3e8f3-f1a9-3002-a58d-9ae81759d6e8",
                                        "entry_id": "cdb2114e-d2d7-3ff8-bcdc-5a7cd0346f42",
                                        "glosses": [
                                            "A sidewalk."
                                        ],
                                        "tags": [
                                            "Myanmar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "platform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77262c01-2c29-3c7c-a055-1038df113b88",
                                        "entry_id": "88b18ec3-9376-36ce-9083-e58566af0aa8",
                                        "glosses": [
                                            "To furnish with or shape into a platform"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ce60f9-e5ac-4c4d-9fd1-4062b4532bf6",
                                                "sense_id": "77262c01-2c29-3c7c-a055-1038df113b88",
                                                "text": "[…] upon a smiling knoll platformed by Nature […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372b4aa8-1e64-3e08-9ae2-6064dceed96a",
                                        "entry_id": "88b18ec3-9376-36ce-9083-e58566af0aa8",
                                        "glosses": [
                                            "To place on, or as if on, a platform."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8812f8ab-97ab-4823-8387-c617f4b9536f",
                                                "sense_id": "372b4aa8-1e64-3e08-9ae2-6064dceed96a",
                                                "text": "And this dog was satisfied / If a pale thin hand would glide / Down his dewlaps sloping / Which he pushed his nose within, / After—platforming his chin / On the palm left open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d74b382-124b-38a3-8512-edad3ac839ee",
                                        "entry_id": "88b18ec3-9376-36ce-9083-e58566af0aa8",
                                        "glosses": [
                                            "To place a train alongside a station platform."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47c672e-4b17-42fc-98f2-2cd7448b848b",
                                                "sense_id": "0d74b382-124b-38a3-8512-edad3ac839ee",
                                                "text": "There he was welcomed onboard Vivarail's new three-car battery-powered train and Porterbrook's HydroFLEX hydrogen-powered train, which had been platformed side-by-side to showcase the potential of these low-carbon alternative technologies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e08cc29-420e-33ff-89a5-4f545a824fa1",
                                        "entry_id": "88b18ec3-9376-36ce-9083-e58566af0aa8",
                                        "glosses": [
                                            "To include in a political platform"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93d67f30-3256-417d-843a-ef983384c467",
                                                "sense_id": "4e08cc29-420e-33ff-89a5-4f545a824fa1",
                                                "text": "Among them I scarcely can plot out one truth / Plain enough to be platformed by some voting sleuth / And paraded before the precinct polling-booth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c028674-63fd-3f0a-8736-d9a98cefdbdb",
                                        "entry_id": "88b18ec3-9376-36ce-9083-e58566af0aa8",
                                        "glosses": [
                                            "To publish or make visible; to provide a platform for (a topic etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e6f4ea7-069e-459e-a63f-2f681e11abbe",
                                                "sense_id": "7c028674-63fd-3f0a-8736-d9a98cefdbdb",
                                                "text": "We want to platform the larger, unspoken issue of menstrual health and hygiene of women at work, and how we as a society need to start taking cognizance of it and start adopting measures to help our women workforce navigate it with ease."
                                            },
                                            {
                                                "example_id": "a48c23d1-f57d-4418-a41c-76c69246b4f4",
                                                "sense_id": "7c028674-63fd-3f0a-8736-d9a98cefdbdb",
                                                "text": "If Buckley were still alive today, could a university get away with platforming him in a debate?"
                                            },
                                            {
                                                "example_id": "4a26e6a6-e97f-496a-ab65-89a8f9c00a27",
                                                "sense_id": "7c028674-63fd-3f0a-8736-d9a98cefdbdb",
                                                "text": "Half of the lawsuits against Pina also named Envy (real name: Raashaun Casey), blaming the DJ for platforming Pina on The Breakfast Club and social media."
                                            },
                                            {
                                                "example_id": "a42d6756-2b02-4e48-ae56-4c34a0534b28",
                                                "sense_id": "7c028674-63fd-3f0a-8736-d9a98cefdbdb",
                                                "text": "“The ‘how dare you platform someone you disagree with’ era is over. Fuck that.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caaed7df-8eba-37d7-bb17-fc86f1ac0ad9",
                                        "entry_id": "88b18ec3-9376-36ce-9083-e58566af0aa8",
                                        "glosses": [
                                            "To open (a film) in a small number of theaters before a broader release in order to generate enthusiasm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "972befc3-6bca-475e-adac-c3ffc4eda98f",
                                                "sense_id": "caaed7df-8eba-37d7-bb17-fc86f1ac0ad9",
                                                "text": "But serious movies are not necessarily good movies. A studio that decides to platform a film had better be sure the film will get the necessary good reviews and audience approval. Otherwise, like United Artists' \"A Small Circle of Friends,\" which was platformed around the same time as \"The Elephant Man,\" the film will fail calamitously."
                                            },
                                            {
                                                "example_id": "b06d3dc7-74ce-4e82-8eff-47b41e4f6e8c",
                                                "sense_id": "caaed7df-8eba-37d7-bb17-fc86f1ac0ad9",
                                                "text": "Each of these films will be \"platformed,\" the industry term to describe the strategy of opening a movie first in a limited number of theaters to give it an aura of exclusivity, then having its appeal build through word of mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f3fc598-19b6-32c3-b799-dde8e9b0558a",
                                        "entry_id": "88b18ec3-9376-36ce-9083-e58566af0aa8",
                                        "glosses": [
                                            "To form a plan of; to model; to lay out."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "941a0838-0596-4b7b-b6f2-3d65b0987847",
                                                "sense_id": "6f3fc598-19b6-32c3-b799-dde8e9b0558a",
                                                "text": "I have ſaid what is meet to ſome who do not think it for the eaſe of their inconſequent Opinions, to grant that Church-Diſcipline is platform'd in the Bible, but that it is left to the diſcretion of Men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
