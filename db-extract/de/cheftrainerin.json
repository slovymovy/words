                    {
                        "sense_id": "a9d8e331-1cc9-3343-8096-143638880716",
                        "entry_id": "de1bccc6-e37a-3c70-8de5-f0d4bbe32f83",
                        "glosses": [
                            "oberste Trainerin, die über nachgeordnetes Personal verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c06b818-dbf9-42af-abd3-ce0e957701ce",
                                "sense_id": "a9d8e331-1cc9-3343-8096-143638880716",
                                "text": "„Die von Cheftrainerin Eva Gerstl neu formierte Equipe unterlag zwar im Endspiel den mitfavorisierten Norwegerinnen mit 5:21, doch auch Platz zwei reichte zur Promotion in die zweithöchste kontinentale Leistungsklasse.“"
                            },
                            {
                                "example_id": "4b917f39-765b-4407-96a0-ab763ff90069",
                                "sense_id": "a9d8e331-1cc9-3343-8096-143638880716",
                                "text": "„Nach den Erfolgen von Sotschi kam es mit der Trennung von der Cheftrainerin Guri Hetland zu einer radikalen Veränderung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
