                    {
                        "translation_id": "e1504c60-7fec-489e-9117-c2362d5b32b4",
                        "source_entry_id": "4b7c8896-a449-316f-99c9-9818cb5cbe7a",
                        "source_sense_id": "671c1c1a-6e78-304b-a06f-20e29178d43c",
                        "target_lang_word": "stootblok",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stootblok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6efed2a6-6125-32a7-9fe3-cafeb24195de",
                                        "entry_id": "9ff0c622-16f3-3952-852e-9dace72e9306",
                                        "glosses": [
                                            "een zwaar hek of blok op het einde van een spoorweg dat in geval van nood een trein of ander transportmiddel kan stoppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b57ad2-aac1-4ea1-b58a-b76bad5a0acf",
                                                "sense_id": "6efed2a6-6125-32a7-9fe3-cafeb24195de",
                                                "text": "Ook werd er in 1970 een monument onthuld dat de gedachte aan het voormalige doorgangskamp levend moest houden. Het is ontworpen door Ralph Prins, een kunstenaar die in de oorlog in het kamp heeft gezeten, en bestaat uit een muur van Drentse zwerfkeien en een stuk rails dat aan de ene kant een stootblok heeft en aan de andere kant is verwrongen en naar boven wijst"
                                            },
                                            {
                                                "example_id": "4a85ee4c-e157-4757-9fb0-de9097f77514",
                                                "sense_id": "6efed2a6-6125-32a7-9fe3-cafeb24195de",
                                                "text": "Na zoveel aanslagen is veiligheid geen loos woord meer. Alleen wegen die hekken en stootblokken zo op ons gemoed. Met steeds elegantere oplossingen weten ontwerpers ons te verzoenen met die ingrepen."
                                            },
                                            {
                                                "example_id": "0f3f10c1-7a1d-4218-b038-c6e574b814f3",
                                                "sense_id": "6efed2a6-6125-32a7-9fe3-cafeb24195de",
                                                "text": "De forensentrein uit het plaatsje Sant Vicenç de Calders remde niet op tijd af en botste in het Estacin de Francia op een stootblok. Het is het op een na drukste station in de stad. De hulpdiensten doen onderzoek naar de oorzaak van het ongeluk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
