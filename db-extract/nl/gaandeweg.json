                "entry_id": "c4fae580-bc32-3a52-a015-d172bc4259ce",
                "word": "gaandeweg",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dec40025-8950-3bf0-9c11-ca494f994661",
                        "entry_id": "c4fae580-bc32-3a52-a015-d172bc4259ce",
                        "glosses": [
                            "geleidelijk aan, bijna ongemerkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82af9eae-9461-46d6-a9ac-85fb073b2c24",
                                "sense_id": "dec40025-8950-3bf0-9c11-ca494f994661",
                                "text": "Meteen na de start, meldde ze zich vooraan, pal achter Can, en pal voor Grøvdal en de Zwitserse Fabienne Schlumpf. Maar gaandeweg begon ze van vermoeidheid te trekkebekken en kort daarop groeide het gat met de koplopers, Can, Schlumpf en uiteindelijk ook de Noorse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98a57d08-6296-4cd8-94ea-4625c0cd7f3d",
                        "source_entry_id": "c4fae580-bc32-3a52-a015-d172bc4259ce",
                        "source_sense_id": "dec40025-8950-3bf0-9c11-ca494f994661",
                        "source_sense_description": "geleidelijk aan, bijna ongemerkt",
                        "target_lang_word": "nach und nach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nach und nach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5967956a-8658-3d91-9d88-3bc0b8efb31d",
                                        "entry_id": "c7ef439d-b135-3b3a-ab79-92adfeec378a",
                                        "glosses": [
                                            "in einer langsamen, aber stetig fortschreitenden Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25afacab-186b-40f5-a64d-020313e44eef",
                                                "sense_id": "5967956a-8658-3d91-9d88-3bc0b8efb31d",
                                                "text": "Es werden nach und nach die alten Strukturen durch neue ersetzt."
                                            },
                                            {
                                                "example_id": "1cf9f41d-9b95-4d45-8d84-c1127c98ef3c",
                                                "sense_id": "5967956a-8658-3d91-9d88-3bc0b8efb31d",
                                                "text": "Nach und nach kamen immer mehr Leute auf dem Marktplatz zusammen."
                                            },
                                            {
                                                "example_id": "8208eaa2-a0d3-4ace-9ddb-627d69373dce",
                                                "sense_id": "5967956a-8658-3d91-9d88-3bc0b8efb31d",
                                                "text": "„Die außen- und innenpolitischen Herausforderungen waren so groß, dass der Staat erst nach und nach Briefmarken mit neuen Motiven ausgab.“"
                                            },
                                            {
                                                "example_id": "1659077e-1a32-4286-9ae5-e778a1efb052",
                                                "sense_id": "5967956a-8658-3d91-9d88-3bc0b8efb31d",
                                                "text": "„Fündig wurden die Kollegen in Wentorf: In der Hauptstraße und in der Hamburger Landstraße nahmen ihre Suchgeräte einen leichten Gasgeruch wahr. Um die Lecks genau zu lokalisieren, legte man die Gasrohre nach und nach frei.“"
                                            },
                                            {
                                                "example_id": "fcedf468-e5f7-4ed1-a210-ba50d0e8fed2",
                                                "sense_id": "5967956a-8658-3d91-9d88-3bc0b8efb31d",
                                                "text": "„Nach und nach verstehen [die kleinen Kinder] immer besser, was die Wörter bedeuten und wie man sie richtig verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d90e3ebd-9e15-4b6d-b793-c7ad87938d16",
                        "source_entry_id": "c4fae580-bc32-3a52-a015-d172bc4259ce",
                        "source_sense_id": "dec40025-8950-3bf0-9c11-ca494f994661",
                        "source_sense_description": "geleidelijk aan, bijna ongemerkt",
                        "target_lang_word": "gradually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
