                "senses": [
                    {
                        "sense_id": "feb7ba4b-d7e8-32c0-85a5-49bf2e1ebba6",
                        "entry_id": "9eaff6e6-a84c-3e94-ab78-0c01966c1f67",
                        "glosses": [
                            "jemand, der ein Konzert besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2206f429-dfb5-4fc4-aa30-2c5229f98142",
                                "sense_id": "feb7ba4b-d7e8-32c0-85a5-49bf2e1ebba6",
                                "text": "„Dann strömten die Konzertbesucher in den Konzertsaal und verteilten sich überall, und der Saal füllte sich.“"
                            },
                            {
                                "example_id": "994da458-269d-4c7c-9487-bd5dbef17d25",
                                "sense_id": "feb7ba4b-d7e8-32c0-85a5-49bf2e1ebba6",
                                "text": "„Robert erinnerte sich, oft genug von Konzertbesuchern gehört zu haben, daß sich bei Musik so schön träumen lasse.“"
                            },
                            {
                                "example_id": "da5f9679-fa96-44e5-b167-24c04649eb91",
                                "sense_id": "feb7ba4b-d7e8-32c0-85a5-49bf2e1ebba6",
                                "text": "„Eigentlich hätte er am liebsten geschwiegen und einfach nur in der Stille den letzten gerade verklungenen Tönen nachgelauscht, wie ein Konzertbesucher nach einem unvergesslichen Kunstgenuss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
