                    "sense_id": "9b2347b0-2e62-32b9-8f93-3974d7f542d6",
                    "sense_definition": "Sentiment de gêne ou de honte éprouvé devant ce qui blesse la décence, la modestie corporelle ou la chasteté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decence_corporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par <w>pudeur</w>, elle refusa d'enlever son peignoir devant les autres personnes présentes."
                        },
                        {
                            "text": "Ce comportement provocateur choque les passants et blesse la <w>pudeur</w> du public."
                        }
                    ],
                    "synonyms": [
                        "décence",
                        "modestie",
                        "chasteté"
                    ],
                    "antonyms": [
                        "impudeur",
                        "indécence"
                    ],
                    "common_phrases": [
                        "blesser la pudeur",
                        "fausse pudeur"
                    ]
                },
                {
                    "sense_id": "34dc5dab-2ca3-3a19-bab2-670bd254e824",
                    "sense_definition": "Retenue, discrétion ou délicatesse morale qui empêche d'étaler ses émotions intimes ou d'agir de façon inconvenante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retenue_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a eu la <w>pudeur</w> de dissimuler son chagrin pour ne pas inquiéter sa famille."
                        },
                        {
                            "text": "Une certaine <w>pudeur</w> l'empêchait de parler ouvertement de ses sentiments les plus intimes."
                        }
                    ],
                    "synonyms": [
