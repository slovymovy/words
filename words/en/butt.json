                },
                {
                    "sense_id": "405f689e-e776-3392-b5bf-63fb238d1da6",
                    "sense_definition": "A friend or buddy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alright <w>butt</w>, how have you been doing lately?",
