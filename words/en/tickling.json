{
    "word_family": [
        "tickle",
        "tickler",
        "ticklish",
        "ticklishly",
        "ticklishness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e88f11c5-9ce9-3c41-8661-874a04033ba2",
                    "sense_definition": "Present participle of <w>tickle</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tickle_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The father was playfully <w>tickling</w> his daughter until she laughed uncontrollably.",
                            "target_lang_translations": {
                                "de": "Der Vater <w>kitzelte</w> seine Tochter spielerisch, bis sie unkontrolliert lachte."
                            }
                        },
                        {
                            "text": "Stop <w>tickling</w> my feet because I cannot stand it.",
                            "target_lang_translations": {
                                "de": "Hör auf, meine Füße zu <w>kitzeln</w>, weil ich es nicht ertragen kann."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens von tickle; kitzeln"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kitzelnd",
                                "target_lang_sense_clarification": "Partizip Präsens"
                            },
                            {
                                "target_lang_word": "kitzeln",
                                "target_lang_sense_clarification": "als Verbform"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "482bd9c3-e924-34d7-a484-4f7d81a58c85",
                    "sense_definition": "Causing or accompanied by a light, tingling sensation on the skin or in the throat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tickle_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a strange <w>tickling</w> sensation in her throat right before coughing.",
                            "target_lang_translations": {
                                "de": "Direkt vor dem Husten spürte sie ein seltsam <w>kitzelndes</w> Gefühl im Hals."
                            }
                        },
                        {
                            "text": "A <w>tickling</w> feather brushed against his cheek while he was half asleep.",
                            "target_lang_translations": {
                                "de": "Eine <w>kitzelnde</w> Feder strich über seine Wange, während er halb schlief."
                            }
                        }
                    ],
                    "synonyms": [
                        "tingling",
                        "prickling"
                    ],
                    "common_phrases": [
                        "tickling sensation"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein leichtes, kribbelndes Gefühl auf der Haut oder im Hals hervorrufend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kitzelnd",
                                "target_lang_sense_clarification": "Gefühl hervorrufend"
                            },
                            {
                                "target_lang_word": "kribbelnd",
                                "target_lang_sense_clarification": "im Hals oder auf der Haut"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95d2c04c-b224-338e-bad0-e2940a1e4f3e",
                    "sense_definition": "The act of lightly touching someone to provoke laughter or twitching.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tickle_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gentle <w>tickling</w> is a common way for parents to play with babies.",
                            "target_lang_translations": {
                                "de": "Sanftes <w>Kitzeln</w> ist eine beliebte Art für Eltern, mit Babys zu spielen."
                            }
                        },
                        {
                            "text": "The child begged for mercy during the relentless <w>tickling</w> by his brother.",
                            "target_lang_translations": {
                                "de": "Das Kind bettelte während des unerbittlichen <w>Kitzelns</w> durch seinen Bruder um Gnade."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das Kitzeln; die Handlung, jemanden sanft zu berühren, um Lachen oder Zuckungen hervorzurufen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Kitzeln",
                                "target_lang_sense_clarification": "Handlung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73db6f34-f8cd-3277-8d45-afb950b1e032",
                    "sense_definition": "A light, tingling or itching physical feeling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tickle_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to ignore the strange <w>tickling</w> at the back of his throat.",
                            "target_lang_translations": {
                                "de": "Er versuchte, das seltsame <w>Kitzeln</w> tief in seiner Kehle zu ignorieren."
                            }
                        },
                        {
                            "text": "Sudden <w>ticklings</w> across her arm made her think an insect was crawling there.",
                            "target_lang_translations": {
                                "de": "Ein plötzliches <w>Kribbeln</w> auf ihrem Arm ließ sie glauben, dass dort ein Insekt krabbelte."
                            }
                        }
                    ],
                    "synonyms": [
                        "tingle",
                        "itch"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein leichtes, kribbelndes oder juckendes Gefühl"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Kitzeln",
                                "target_lang_sense_clarification": "Gefühl im Hals oder auf der Haut"
                            },
                            {
                                "target_lang_word": "das Kribbeln",
                                "target_lang_sense_clarification": "Kitzeln oder Prickeln"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}