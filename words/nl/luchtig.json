                            },
                            {
                                "target_lang_word": "nonchalant",
                                "target_lang_sense_clarification": "casually calm and relaxed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4967c2cf-497e-3ce4-9525-2ad075bd55d9",
                    "sense_definition": "Dun of open geweven, waardoor er gemakkelijk lucht doorheen kan gaan.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer draag ik het liefst <w>luchtige</w> kleding van katoen.",
                            "target_lang_translations": {
                                "en": "In the summer, I prefer to wear <w>airy</w> cotton clothing."
                            }
                        },
                        {
                            "text": "Deze <w>luchtige</w> stof is perfect voor een warme dag op het strand.",
                            "target_lang_translations": {
                                "en": "This <w>breathable</w> fabric is perfect for a warm day at the beach."
