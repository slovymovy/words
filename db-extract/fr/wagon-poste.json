                                        "examples": [
                                            {
                                                "example_id": "5d37cff9-72bb-459d-8553-fc5b1a12b1fe",
                                                "sense_id": "54ac04ec-e8f9-38cc-9bc2-bc169e100a36",
                                                "text": "One of the important railway facilities which disappeared on the outbreak of war was the travelling post office. […] T.P.Os. have now been resumed, with the reinstatement on October 1 of those between Euston and Aberdeen, and between Paddington and Penzanze."
                                            },
                                            {
                                                "example_id": "a37ed4d5-4a09-4f00-adb8-faf9ac3f03ef",
                                                "sense_id": "54ac04ec-e8f9-38cc-9bc2-bc169e100a36",
                                                "text": "From its pre-Second World War boom of 130 Travelling Post Offices (TPOs) that sorted mail on the move, Royal Mail has slowly (but progressively) shifted its mail operations to other modes of transport."
                                            }
