                                        "entry_id": "3e30a575-947e-3881-b08a-75a7b2cdef20",
                                        "glosses": [
                                            "Ganzkörperschleier persischer Frauen, der nur das Gesicht ganz oder auch nur teilweise frei lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fcced4f-674b-4ecc-8e0c-89bd848da93e",
                                                "sense_id": "b02ca9ab-1ad8-3902-a3f6-b13056bca2d1",
                                                "text": "„Wenn sie etwas sagen, halten sie sich den Tschador vor den Mund und blicken aus den Augenwinkeln um sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
