                "senses": [
                    {
                        "sense_id": "ff860e1c-0011-37df-a378-cd8c287ef798",
                        "entry_id": "b6b9a32b-ba6f-3aa3-93dc-974b4526cb9e",
                        "glosses": [
                            "Donner un caractère zambien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cee0d9cf-62be-40b8-8424-b1373eded1f9",
                                "sense_id": "ff860e1c-0011-37df-a378-cd8c287ef798",
                                "text": "Les jésuites, moins nombreux, passent la main à un personnel zambianisé ; les élèves viennent de toutes les régions et ne sont plus exclusivement catholiques."
                            },
                            {
                                "example_id": "87ee5f9c-b036-4f74-b8f3-baa6941d504a",
                                "sense_id": "ff860e1c-0011-37df-a378-cd8c287ef798",
                                "text": "A l'époque, l'Eglise catholique pourvoyait à l'instruction, puis le gouvernement a tout pris en main et “zambianisé”, ce qui était une bonne chose mais ils ont été débordés et n’ont pas été capables de donner un service de qualité en matière d’éducation."
                            },
                            {
                                "example_id": "f445c56e-c758-4142-957d-6a7877a050fb",
                                "sense_id": "ff860e1c-0011-37df-a378-cd8c287ef798",
                                "text": "La profession enseignante était zambianisée en majorité."
                            }
                        ]
                    }
                ],
