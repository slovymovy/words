                                                "sense_id": "d5bd5ced-2854-34a8-80fe-d8159bc27b0d",
                                                "text": "La natation est bonne pour la santé."
                                            },
                                            {
                                                "example_id": "ed436042-43f3-49a0-b7d5-c39d94eebf68",
                                                "sense_id": "d5bd5ced-2854-34a8-80fe-d8159bc27b0d",
                                                "text": "École de natation."
                                            },
                                            {
                                                "example_id": "90427fcf-4a1a-4f01-b12d-64e173cfcc81",
                                                "sense_id": "d5bd5ced-2854-34a8-80fe-d8159bc27b0d",
                                                "text": "Leçons de natation."
                                            },
                                            {
                                                "example_id": "e1585c8c-4071-41dc-a682-ae50be56d44f",
                                                "sense_id": "d5bd5ced-2854-34a8-80fe-d8159bc27b0d",
                                                "text": "Nous vous proposons un guide pour l’enseignement de la natation, dans sa définition la plus large et pour une pratique non compétitive."
                                            }
                                        ]
