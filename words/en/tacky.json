                    "frequency": "Middle",
                    "semantic_group_id": "bad_taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Making jokes about someone's appearance at a formal event was considered very <w>tacky</w>."
                        },
                        {
                            "text": "She refused to wear that sweater because she thought the pattern looked incredibly <w>tacky</w>."
                        }
                    ],
                    "common_phrases": [
