                ],
                "translations": [
                    {
                        "translation_id": "46d3bf58-4c85-48d2-8ea7-057f63f735c5",
                        "source_entry_id": "5b3c1388-bba1-3804-9951-51ef5f52766c",
                        "source_sense_id": "2e494157-cf03-30e8-9a30-5a0e164494f8",
                        "target_lang_word": "singular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "singular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad477fd-07c6-36fb-989f-7c4b639ca780",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Being only one of a larger population; single, individual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "804969da-666a-4558-9cbb-53f24b351865",
                                                "sense_id": "cad477fd-07c6-36fb-989f-7c4b639ca780",
                                                "text": "A singular experiment cannot be regarded as scientific proof of the existence of a phenomenon."
                                            },
                                            {
                                                "example_id": "9de6a96c-d26a-46ea-accc-03f4ce0b4d6d",
                                                "sense_id": "cad477fd-07c6-36fb-989f-7c4b639ca780",
                                                "text": "And God forbid that all a company / Should rue a singular manne's folly.",
                                                "translation": "And may God forbid that a whole group should suffer for a single man's folly.",
                                                "english": "And may God forbid that a whole group should suffer for a single man's folly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7437423-22d3-3b03-9d5e-baf70a9d4ccb",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Being the only one of the kind; unique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca2c9c9-6007-4bbe-b359-8fe4c9dc44b7",
                                                "sense_id": "f7437423-22d3-3b03-9d5e-baf70a9d4ccb",
                                                "text": "She has a singular personality."
                                            },
                                            {
                                                "example_id": "5bdd6573-a9fd-4ea7-b510-09da1e219522",
                                                "sense_id": "f7437423-22d3-3b03-9d5e-baf70a9d4ccb",
                                                "text": "The busts[…] of the emperors and empresses are all very scarce, and some of them almost singular in their kind."
                                            },
                                            {
                                                "example_id": "1ccfcc8b-ab10-486a-9a57-7331caf242a5",
                                                "sense_id": "f7437423-22d3-3b03-9d5e-baf70a9d4ccb",
                                                "text": "singular instances"
                                            },
                                            {
                                                "example_id": "d3cbd40c-7e02-42e9-ba96-30d8ca9c3079",
                                                "sense_id": "f7437423-22d3-3b03-9d5e-baf70a9d4ccb",
                                                "text": "A group of finches, of which Mr. Gould considers there are thirteen species; and these he has distributed into for new sub-genera. These birds are the most singular of any in the archipelago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfed8220-df49-3e9a-9434-3a71a4de83b7",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Distinguished by superiority: peerless, unmatched, eminent, exceptional, extraordinary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ba5815-94c9-41fc-9fc3-d6dbc5b128b8",
                                                "sense_id": "cfed8220-df49-3e9a-9434-3a71a4de83b7",
                                                "text": "a man of singular gravity or attainments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e3c368-17f1-3fb9-a77d-3ec2d5e62649",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Out of the ordinary; curious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4788c66c-f3b0-4e5f-96c3-9fa5a438bd30",
                                                "sense_id": "d5e3c368-17f1-3fb9-a77d-3ec2d5e62649",
                                                "text": "It was very singular; I don't know why he did it."
                                            },
                                            {
                                                "example_id": "655fd84e-769a-429f-b29b-b9039e43b198",
                                                "sense_id": "d5e3c368-17f1-3fb9-a77d-3ec2d5e62649",
                                                "text": "So ſingular a ſadneſs / Muſt have a cauſe as ſtrange as the effect: […]"
                                            },
                                            {
                                                "example_id": "a1d4cc3a-ff0f-4dd3-aa01-108b303dfaef",
                                                "sense_id": "d5e3c368-17f1-3fb9-a77d-3ec2d5e62649",
                                                "text": "His zeal / None seconded, as out of season judged, / Or singular and rash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c143a1a6-66b3-398c-9c0d-360cf0b2fe9b",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Referring to only one thing or person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7aad946-d561-3a54-b3ed-41203a7f7b5b",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Having no inverse."
                                        ],
                                        "tags": [
                                            "of matrix"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0fe9e2d-8387-3c40-a967-c9e6d9304c46",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Having the property that the matrix of coefficients of the new variables has a determinant equal to zero."
                                        ],
                                        "tags": [
                                            "of transformation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76307854-5dc2-384d-83e5-1b83afedcc4a",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Not equal to its own cofinality."
                                        ],
                                        "tags": [
                                            "of a cardinal number"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0dd14d83-db00-3538-bdf8-3bbdd16615ed",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Each; individual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d801613-9941-4939-99c7-fdf7fbf848a0",
                                                "sense_id": "0dd14d83-db00-3538-bdf8-3bbdd16615ed",
                                                "text": "to convey several parcels of land, all and singular"
                                            },
                                            {
                                                "example_id": "9a59f491-db04-44d1-b646-57fa7828d6eb",
                                                "sense_id": "0dd14d83-db00-3538-bdf8-3bbdd16615ed",
                                                "text": "Cel[adon]. […] Hovv do Meliſſa’s tvvo fair Daughters? / Aſt[eria]. VVhen you tell me vvhich of ’em you are in love vvith, I’le anſvver you. / Cel. VVhich of ’em, naughty ſiſter, vvhat a question’s there? VVith both of ’em, vvith each and singular of ’em."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f654f455-bf83-3c74-849d-6eb6a44fde9a",
                                        "entry_id": "14f6ee73-d796-3c49-9c7d-9c8502007ae6",
                                        "glosses": [
                                            "Engaged in by only one on a side; single."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3926b5c-7c80-4e0c-8769-781856e12316",
                                                "sense_id": "f654f455-bf83-3c74-849d-6eb6a44fde9a",
                                                "text": "Thus made he an end, and the two princes allowed well of his last motion, and so order was taken, that they should fight togither in a singular combat"
                                            }
                                        ]
                                    }
                                ]
