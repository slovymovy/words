                "senses": [
                    {
                        "sense_id": "191f303b-5152-3e85-a7e0-3d8a76b94a19",
                        "entry_id": "edcf24dd-43c3-3af8-809c-137fa89a3889",
                        "glosses": [
                            "разг. порознь, беспорядочно, несогласованно, недружно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e82e31c-39b6-407e-89c1-2d082d909c9d",
                                "sense_id": "191f303b-5152-3e85-a7e0-3d8a76b94a19",
                                "text": "Впереди вразнобой ударили торопливые выстрелы, послышались крики, визг, намётный конский топот."
                            },
                            {
                                "example_id": "e16e197d-1290-4f61-882d-a894bcd6a614",
                                "sense_id": "191f303b-5152-3e85-a7e0-3d8a76b94a19",
                                "text": "Теперь орали все, вразнобой, не слушая друг друга."
                            }
                        ]
                    }
                ],
