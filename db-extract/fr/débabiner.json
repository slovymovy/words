                "senses": [
                    {
                        "sense_id": "76045cb8-684c-3009-b300-eee94e9ffbd4",
                        "entry_id": "49ff58e0-3bd9-39c8-a13b-a77142ca955a",
                        "glosses": [
                            "Frapper au visage."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7292394e-0bc7-3120-bb81-3978c1b0fff4",
                        "entry_id": "49ff58e0-3bd9-39c8-a13b-a77142ca955a",
                        "glosses": [
                            "Dégouliner des babines."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e9728668-c290-4c80-8763-08925e8a8a0a",
                                "sense_id": "7292394e-0bc7-3120-bb81-3978c1b0fff4",
                                "text": "Il respire du nez et un filet de bave débabine sur sa frime apoplectique."
                            },
                            {
                                "example_id": "cc4cd568-73d6-4877-b8df-fdc5500ac568",
                                "sense_id": "7292394e-0bc7-3120-bb81-3978c1b0fff4",
                                "text": "Il sort une menteuse longue comme le tapis d’apparat de l’Élysée et toujours ses stalactites qui débabinent !"
                            }
                        ]
                    },
                    {
                        "sense_id": "88dae483-3586-354e-abb7-5188105e913f",
                        "entry_id": "49ff58e0-3bd9-39c8-a13b-a77142ca955a",
                        "glosses": [
                            "Se disputer."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c9fcded1-313b-4a74-aaaf-67ffe9cbc7bb",
                                "sense_id": "88dae483-3586-354e-abb7-5188105e913f",
                                "text": "Le soir, le bruit ne cessait pas pour autant : prenaient alors le relais les « gagassages » (bavardages à la cantonade) des « gourgans » (noceurs), les « siclées » (rires bruyants ») des « courratières » (femmes de mauvaise vie), les « beurles » (cris, pleurs) des « jarlets » (enfants malades), la rumeur des « charippes » (les mauvais garçons) se « débabinant » (se disputant) ou se « bigornant » (se battant) dans les sombres « rouettes » (ruelles)."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfb09bdf-fb2c-3a64-9057-77e8d4ccd025",
                        "entry_id": "49ff58e0-3bd9-39c8-a13b-a77142ca955a",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "41620ce5-1d53-4bae-bee1-e202498f52f6",
                                "sense_id": "bfb09bdf-fb2c-3a64-9057-77e8d4ccd025",
                                "text": "Bon il a tendance à se débabiner ce jeune et vouloir faire des choses trop propres."
                            }
                        ]
                    },
                    {
                        "sense_id": "3933053d-946d-3620-822d-eddc5377927f",
                        "entry_id": "49ff58e0-3bd9-39c8-a13b-a77142ca955a",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "e4c4132b-514c-4743-973a-005ba06a8f05",
                                "sense_id": "3933053d-946d-3620-822d-eddc5377927f",
                                "text": "Monsieur se dégage Charles le Chauve, Madame se débabine la Spontex."
                            },
                            {
                                "example_id": "ae3e0118-1692-4b95-b513-7356d2db9ca5",
                                "sense_id": "3933053d-946d-3620-822d-eddc5377927f",
                                "text": "Tu veux dire qu’elle ne se fait pas prier pour se débabiner la spontex ?"
                            }
                        ]
                    }
                ],
