        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45fe422a-940b-3f42-800c-93c2cf4fdc17",
                "word": "beatnik",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cc15007b-2162-4e8d-bd81-8922fd01bac2",
