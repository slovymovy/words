                "senses": [
                    {
                        "sense_id": "23934ad7-9bbf-3aed-bf74-2e11be6df044",
                        "entry_id": "8d8dc4b3-d8fc-3df9-96c4-07c5834720a3",
                        "glosses": [
                            "Fatiguer fortement, épuiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4107e5d4-45d0-42c2-8a8b-7ebac6c8ac40",
                                "sense_id": "23934ad7-9bbf-3aed-bf74-2e11be6df044",
                                "text": "J’avais tout de suite remarqué qu’il était très digne de sa personne, avec des traits bien faits et forts, qui ne s’étaient pas laissé flapir."
                            },
                            {
                                "example_id": "5de740ec-04ff-4a7a-997c-daa86993bca7",
                                "sense_id": "23934ad7-9bbf-3aed-bf74-2e11be6df044",
                                "text": "Je vais partir de l’imaginer rouge, rouge bordeaux, la couleur d’une tranche de foie cru, et au milieu, le trou, qui pompe, qui suce, le sacré trou, la bouche sans dents qui va me le happer, me l’aspirer, me le retourner, me le flapir…"
                            }
                        ]
                    }
                ],
