                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7de14e6-ce64-4cd2-adca-ec07a17dad9f",
                                                "sense_id": "7c12ce75-57b0-3a11-a112-acb64bff4d09",
                                                "text": "El partido conservador mostró una vez más su oposición a las reformas."
                                            }
