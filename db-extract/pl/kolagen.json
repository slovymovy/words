                                "target_senses": [
                                    {
                                        "sense_id": "5c2bf4c3-5949-3b23-8142-a905e3701839",
                                        "entry_id": "ee223d76-20a7-385e-a496-2b349c7dbb2f",
                                        "glosses": [
                                            "Qui produit de la colle, de la gélatine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf89170-f783-4b90-ba00-c2248f067c54",
                                                "sense_id": "5c2bf4c3-5949-3b23-8142-a905e3701839",
                                                "text": "Recherches sur la constitution des substances collagènes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30bf75a2-b5db-35b7-9451-9cee4d4a2a2c",
                                        "entry_id": "ee223d76-20a7-385e-a496-2b349c7dbb2f",
                                        "glosses": [
                                            "Qui est de la nature de protéines fibreuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a836f1-d1f7-4100-83db-e197a0d29d72",
                                                "sense_id": "30bf75a2-b5db-35b7-9451-9cee4d4a2a2c",
                                                "text": "L'épithélium buccal repose sur un tissu collagène dense appelé chorion ou lamina propria."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "collagène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bec963e-5f1d-30fb-9ead-2b10f6c4b146",
                                        "entry_id": "6bdbeacb-738f-34a8-a9d9-ad5bd9bdfc43",
                                        "glosses": [
                                            "Famille de protéines fibreuses, la matrice des tissus conjonctifs dans le règne animal. Ces protéines ont pour fonction de conférer aux tissus une résistance mécanique à l'étirement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4d8f415-9061-4801-8144-97715b8240e4",
                                                "sense_id": "8bec963e-5f1d-30fb-9ead-2b10f6c4b146",
                                                "text": "La matrice interstitielle contient en particulier les fibronectines, la vitronectine, la thrombospondine, l’élastine et les collagènes I, III et V."
                                            },
                                            {
                                                "example_id": "d093edc9-60cb-47a5-b451-f206047771e8",
                                                "sense_id": "8bec963e-5f1d-30fb-9ead-2b10f6c4b146",
                                                "text": "Il y a toujours de l’affluence devant les amoncellements de boîtes d’une pharmacopée hétéroclite, orthosiphon, gelée royale, collagène marin (?)."
                                            },
                                            {
                                                "example_id": "52ad5355-6da2-43a8-a560-9339a60a59b1",
                                                "sense_id": "8bec963e-5f1d-30fb-9ead-2b10f6c4b146",
                                                "text": "Un dernier indice étaye ce scénario : l’analyse du collagène osseux des personnes enterrées dans les tombes à couloir indique qu’elles auraient eu un régime alimentaire bien plus riche en viande que celle retrouvées dans d'autres monuments funéraires."
                                            },
                                            {
                                                "example_id": "b20df20b-54e7-4995-99fb-1c034c3d40c3",
                                                "sense_id": "8bec963e-5f1d-30fb-9ead-2b10f6c4b146",
                                                "text": "Un matériau de construction biologique conçu à partir de collagène, qui pourrait éventuellement permettre de remplacer les vaisseaux sanguins abîmés, a été mis au point par des scientifiques français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d5e1c83-3970-4dbc-9599-fed1b4cfc3b2",
                        "source_entry_id": "b7e2f816-c0f8-3cff-8fc9-89b5f89838e6",
                        "source_sense_id": "02712973-58aa-3726-806c-e70163279ea9",
