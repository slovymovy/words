                "senses": [
                    {
                        "sense_id": "3b36f6b9-8818-3846-b0b1-e20a5d741b15",
                        "entry_id": "fb9c9ea5-e003-3729-a494-bd2dcda4d100",
                        "glosses": [
                            "Person, die eine neue Mode auslöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1138f7c9-498b-4cfa-9ed3-3ef0bd9b9eb7",
                                "sense_id": "3b36f6b9-8818-3846-b0b1-e20a5d741b15",
                                "text": "Superstars sind oft auch Trendsetter."
                            },
                            {
                                "example_id": "a2e1728f-c6e0-460d-91b5-57fc2fdf24fe",
                                "sense_id": "3b36f6b9-8818-3846-b0b1-e20a5d741b15",
                                "text": "„Die Gruppe junger Akademiker aber ist deshalb besonders interessant, weil sie Trendsetter sein könnte für die weitere Entwicklung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95d6d935-cb7d-41f4-b79a-cc74cf416328",
                        "source_entry_id": "fb9c9ea5-e003-3729-a494-bd2dcda4d100",
                        "source_sense_id": "3b36f6b9-8818-3846-b0b1-e20a5d741b15",
                        "source_sense_description": "Person, die eine neue Mode auslöst",
                        "target_lang_word": "hipster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hipster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                                        "glosses": [
                                            "A person who is keenly interested in the latest trends or fashions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec4d83f-daab-4aa5-90ec-fa66a3858bb1",
                                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                                "text": "c. 1954, Jack Kerouac, Untitled poem, in Book of Sketches, 1952-57, Penguin, 2006, p. 239,\nI, poor French Canadian Ti Jean become / a big sophisticated hipster esthete in / the homosexual arts […]"
                                            },
                                            {
                                                "example_id": "06bad4c6-72cb-4020-9205-d0b1ac8e10ed",
                                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                                "text": "Clare grapples with the idea that she, a well-dressed city hipster, will soon be in the boondocks raising a child with two men who are as much in love with each other as with her: \"I'm not this unusual,\" she stammers. \"It's just my hair.\""
                                            },
                                            {
                                                "example_id": "821ad1c4-9ba9-4bfc-8c56-0894fc3b8c7b",
                                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                                "text": "Donald Fagen and Walter Becker seem like the kind of late-1960s hypercerebral born-cynical East Coast hipsters who are often found valorizing authenticity in aesthetic expression."
                                            },
                                            {
                                                "example_id": "ff541343-9209-469e-ba27-f89861cbd473",
                                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                                "text": "And his conclusion is that in a vast range of scenarios, the hipster population always undergoes a kind of phase transition in which members become synchronized with each other in opposing the mainstream. In other words, the hipster effect is the inevitable outcome of the behavior of large numbers of people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5772dd82-4523-3574-8f7b-d59261a7bd33",
                                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                                        "glosses": [
                                            "A member of Bohemian counterculture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "439b1052-a2be-3220-8010-64d1ca7108cc",
                                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                                        "glosses": [
                                            "An aficionado of jazz who considers himself or herself to be hip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ec196eb-d92e-37b0-ae40-3a2b6a57451b",
                                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                                        "glosses": [
                                            "A person who wears a hip flask (of alcohol)."
                                        ],
                                        "tags": [
                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07e1fa32-ae53-3767-8650-e5cc5d414faf",
                                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                                        "glosses": [
                                            "A dancer, particularly a female one."
                                        ],
                                        "tags": [
                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36cbaedf-1ce9-391a-8424-e57a72c4de93",
                                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                                        "glosses": [
                                            "Underwear with an elastic waistband at hip level."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hipster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                                        "entry_id": "d95471d0-cec7-36b4-a9a5-9427012830eb",
                                        "glosses": [
                                            "To behave like a hipster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b320059-50e2-45d7-a096-304d13dd3e95",
                                                "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                                                "text": "But it was a white staff member of a reform school who gave Claude Brown the first notion he ever had that there might be something in the world besides dope and sex and hipstering."
                                            },
                                            {
                                                "example_id": "b7dd4f22-fdf9-44db-bf9c-231a417b9c83",
                                                "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                                                "text": "The hipsters are hipstering, the businessmen are businessing, the parents are parenting, the children are childrening, and the black teenagers are calling each other niggers."
                                            },
                                            {
                                                "example_id": "c8040874-eb28-4a48-ba84-042f4b00856c",
                                                "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                                                "text": "If you're up for a night of hipstering, this is a good spot to begin - a grungy joint that nevertheless hosts a solid varying roster of blues, funk, reggae, rock and indie bands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                                        "entry_id": "d95471d0-cec7-36b4-a9a5-9427012830eb",
                                        "glosses": [
                                            "To dress or decorate in a hip fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f52ab5e-da0d-482e-bd2d-a376c26ec6fa",
                                                "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                                                "text": "Claire's permission, to be going out with this fine, circumspect woman, all hipstered out and cowboy booted, without a chaperone."
                                            },
                                            {
                                                "example_id": "90620b43-c15c-4dbc-9b69-7b9495116c1c",
                                                "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                                                "text": "I nudged Theo. “I give him three hours before he's hipstered it back up again."
                                            },
                                            {
                                                "example_id": "6d33d44d-3a16-4f75-afd0-16829c5d3226",
                                                "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                                                "text": "Victorian frock coats and neckwear, with facial hair that would make any hipster contemplate giving up hipstering and taking up..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
