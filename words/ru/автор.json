                    "sense_definition": "Глава преступной группировки.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В криминальном мире его знали как влиятельного <w>автора</w>.",
                            "target_lang_translations": {
                                "en": "In the criminal world, he was known as an influential <w>crime boss</w>.",
                                "zh": "在犯罪世界里，他被视为一位有影响力的<w>大佬</w>。"
                            }
