                                "example_id": "d35273b9-2e49-49c4-9aee-00203a046111",
                                "sense_id": "407da1c9-621c-3778-afbe-0b60fee25cd9",
                                "text": "Or, ce n'est pas la péremptoirité qui manque à Marahon et aux freudistes en général pour développer avec une élégance filandreuse leurs « pourquoi »."
                            },
                            {
                                "example_id": "40c75023-c5f9-492f-a876-93f1524e200e",
                                "sense_id": "407da1c9-621c-3778-afbe-0b60fee25cd9",
                                "text": "Si je vais dans une assemblée générale du mouvement, je me sens heurtée par la péremptoirité du discours, je ne suis plus chez moi."
                            },
                            {
                                "example_id": "4067706b-f73e-4897-a6c7-dcefe9941042",
                                "sense_id": "407da1c9-621c-3778-afbe-0b60fee25cd9",
                                "text": "Dominée par la péremptoirité de l’homme moumouté, Marie-France se contente d’un acquiescement muet."
                            }
                        ]
                    }
