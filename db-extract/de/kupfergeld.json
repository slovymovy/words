                "senses": [
                    {
                        "sense_id": "c90592e8-2011-3480-9690-e07b53c70003",
                        "entry_id": "c818b3e8-857d-35c0-b8c9-3ec7ad05f4b7",
                        "glosses": [
                            "Zahlungsmittel aus dem Metall Kupfer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "337260fe-5e40-4561-a3b7-4b0a6909ae24",
                                "sense_id": "c90592e8-2011-3480-9690-e07b53c70003",
                                "text": "„In der Reform von 1680 zog man große Mengen Kupfergeldes aus dem Verkehr und beendete die Zeiten, in denen der einzelne Bürger für einfache Transaktionen gleich mehrere Fässer mit Kupfergeld benötigt hatten.“"
                            },
                            {
                                "example_id": "cfa43e3b-cf89-4e49-8548-5e62eacfca7e",
                                "sense_id": "c90592e8-2011-3480-9690-e07b53c70003",
                                "text": "„Als ich am nächsten Morgen den Wirt mit dem Kupfergeld bezahlen wollte, das ich in der Rocktasche hatte, fand ich meine Börse nicht, die eigentlich in meiner Hosentasche hätte stecken sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
