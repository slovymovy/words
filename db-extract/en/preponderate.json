                ],
                "senses": [
                    {
                        "sense_id": "90d0b192-e3ef-3f69-9a96-dbe88c9c2ce6",
                        "entry_id": "e9551a2f-df60-330a-bbba-e3c1ee1004d0",
                        "glosses": [
                            "To outweigh; to be heavier than; to exceed in weight."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bcfbde6e-338f-4462-9668-e7cef0985cb5",
                                "sense_id": "90d0b192-e3ef-3f69-9a96-dbe88c9c2ce6",
                                "text": "an inconsiderable weight by virtue of its distance from the Centre of the Ballance, will preponderate much greater magnitudes"
                            }
                        ]
                    },
                    {
                        "sense_id": "047e7b68-8ca8-3e78-887d-3516ffb5fcdd",
                        "entry_id": "e9551a2f-df60-330a-bbba-e3c1ee1004d0",
                        "glosses": [
                            "To overpower by stronger or moral power."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4cb997a7-9f52-4e3f-a7aa-88d005362cb7",
                                "sense_id": "047e7b68-8ca8-3e78-887d-3516ffb5fcdd",
                                "text": "That is the preponderating consideration to which everything else has to yield."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9d6f0ca-9678-3619-ae32-b85c76f4e719",
                        "entry_id": "e9551a2f-df60-330a-bbba-e3c1ee1004d0",
                        "glosses": [
                            "To cause to prefer; to incline; to decide."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9b3c7483-2d58-4585-979d-39a4ab89e2d8",
                                "sense_id": "d9d6f0ca-9678-3619-ae32-b85c76f4e719",
                                "text": "The desire to spare Christian blood preponderates him for peace."
                            }
                        ]
                    },
                    {
                        "sense_id": "aabd01cb-d84b-3c34-8c0e-615cf9d70229",
                        "entry_id": "e9551a2f-df60-330a-bbba-e3c1ee1004d0",
                        "glosses": [
                            "To exceed in weight or influence; hence, to predominate."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c6a7f870-d5f7-4667-bb75-a9f75d3e7d61",
                                "sense_id": "aabd01cb-d84b-3c34-8c0e-615cf9d70229",
                                "text": "Anxiety preponderated over hope; and it was scarcely possible for Evelyn to encounter a danger not previously conjured up by the alarmed fancy of his mistress."
                            },
                            {
                                "example_id": "bd06c3c5-f283-49a2-8535-49c1c0aae0fb",
                                "sense_id": "aabd01cb-d84b-3c34-8c0e-615cf9d70229",
                                "text": "[…] if the principle of utility is good for anything, it must be good for weighing these conflicting utilities against one another, and marking out the region within which one or the other preponderates."
                            },
                            {
                                "example_id": "f679cd36-b47e-4167-8374-a82fd196e8cc",
                                "sense_id": "aabd01cb-d84b-3c34-8c0e-615cf9d70229",
                                "text": "Train journeys were not long in terms of distance, and having regard to these factors, the tank engine inevitably preponderated."
                            }
                        ]
                    }
                ],
