                "senses": [
                    {
                        "sense_id": "c3020178-1f76-3f8e-af34-8195ca85cd7b",
                        "entry_id": "13a7329f-866a-3661-98ec-dfd453c2de4e",
                        "glosses": [
                            "Lebensjahr einer/eines Jugendlichen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "75695407-9b9c-416d-b125-08adf0a7b6b9",
                                "sense_id": "c3020178-1f76-3f8e-af34-8195ca85cd7b",
                                "text": "„Ein Bild aus ihren Jugendjahren zeigte sie als properes, wohlgeratenes Mädchen mit rundem Gesicht und offenen, neugierigen Augen; ihr wacher Blick ist selbstbewusst, die Lippen umspielt ein leicht belustigtes Lächeln, und man kann sich vorstellen, dass sie begierig war auf das Leben.“"
                            },
                            {
                                "example_id": "f4e958cc-fa8b-4dcb-9236-cd95c0972f7b",
                                "sense_id": "c3020178-1f76-3f8e-af34-8195ca85cd7b",
                                "text": "„Bis in meine Jugendjahre hinein reichte es uns, zusammen etwas anzuhören, das uns beiden gefiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "78123ba2-5a0f-3557-b7b1-70790bd6c8a1",
                        "entry_id": "13a7329f-866a-3661-98ec-dfd453c2de4e",
                        "glosses": [
                            "Jahr in einer Altersklasse im Sport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed7ce87-cd09-4d86-9816-b194629e4aae",
                                "sense_id": "78123ba2-5a0f-3557-b7b1-70790bd6c8a1",
                                "text": "Sie kam im ersten Jugendjahr (in der Altersklasse der B-Jugend) zu ihrem neuen Verein."
                            }
                        ],
