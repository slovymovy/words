                        "entry_id": "600018b3-12bc-36c1-a80a-ed352becb3d5",
                        "glosses": [
                            "Énoncé valable à toutes les époques et à caractère universel."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "3d9c59c7-8b1e-4e1f-822b-3309b45518d9",
                                "sense_id": "07c274d9-601e-3a8c-b247-46fde64cb896",
                                "text": "Il évolua vers un Parnasse oublieux de ses somptuosités, de ses recherches philosophiques, de son baroquisme, qui, mis à nu, montra ses faiblesses : le gnomisme bien pensant, le discours sage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26bd7546-2f85-4b64-9eba-f93d92b20915",
                        "source_entry_id": "600018b3-12bc-36c1-a80a-ed352becb3d5",
                        "source_sense_id": "07c274d9-601e-3a8c-b247-46fde64cb896",
                        "target_lang_word": "gnomic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnomic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96ebd4d7-512b-366f-9ae5-e7e0395034c6",
                                        "entry_id": "8e4b6655-74f4-3a1c-b168-5a59187f1ac9",
                                        "glosses": [
                                            "Of, or relating to gnomes (sententious sayings)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636987fb-a38f-4684-9bef-68dd93e51e73",
                                                "sense_id": "96ebd4d7-512b-366f-9ae5-e7e0395034c6",
                                                "text": "His birth-place was Colophon, an Ionian city of Asia-Minor; a city long famous as the seat of elegiac and gnomic poetry, and ranking the poet Minmermus amongst its celebrated men."
                                            },
                                            {
                                                "example_id": "88f1f3c3-0930-4632-b3bd-72c78f345413",
                                                "sense_id": "96ebd4d7-512b-366f-9ae5-e7e0395034c6",
                                                "text": "Old English culture was threaded through with riddles, cryptograms, gnomic verses, charms and riddling modes of speech such as litotes, just as Modern English culture is (if you will forgive me) riddled with jokes and catch-phrases, crosswords and quizzes, irony and sarcasm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                        "entry_id": "8e4b6655-74f4-3a1c-b168-5a59187f1ac9",
                                        "glosses": [
                                            "Mysterious and often incomprehensible yet seemingly wise."
                                        ],
                                        "tags": [
                                            "of a saying or aphorism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a66e0f7-c419-4ad5-a7a9-5725e40589ce",
                                                "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                                "text": "He always makes gnomic utterances."
                                            },
                                            {
                                                "example_id": "e5d28387-1f0b-4566-ba1f-9a80ecdc61ff",
                                                "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                                "text": "The gnomic belief that the world is conditioned by love is no idle apothegm."
                                            },
                                            {
                                                "example_id": "88d0ea70-62d3-459f-ae15-7de3c1e5680a",
                                                "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                                "text": "In his part gnomic, part mechanic’s style, Mr. Pirsig’s narrator declares that the real world is a seamless continuum of the material and metaphysical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a20595b-a5ae-3aaf-92f3-343346899d83",
                                        "entry_id": "8e4b6655-74f4-3a1c-b168-5a59187f1ac9",
                                        "glosses": [
                                            "Expressing general truths or aphorisms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a150d78-1e72-4910-a326-16957bff9ce9",
                                                "sense_id": "5a20595b-a5ae-3aaf-92f3-343346899d83",
                                                "text": "gnomic aspect"
                                            }
                                        ]
