                        "examples": [
                            {
                                "example_id": "3fa7077d-91ee-4b05-b971-c5a539072092",
                                "sense_id": "17e45652-0f50-367e-9ebc-4fbd7a700f91",
                                "text": "An E-Mails können beliebige Dateien wie elektronische Dokumente oder auch Programmdateien als Attachments angehängt werden."
                            },
                            {
                                "example_id": "a6406116-bca6-48b7-807d-ecfd2824b98c",
                                "sense_id": "17e45652-0f50-367e-9ebc-4fbd7a700f91",
                                "text": "Als Computer-Nutzer sollte man wegen der Virenübertragungsgefahr nur Attachments von vertrauenswürdigen Absendern öffnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
