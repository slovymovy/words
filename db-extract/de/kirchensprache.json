                "senses": [
                    {
                        "sense_id": "e77b8485-7c0f-3bdb-9a7c-84a96cf84735",
                        "entry_id": "e75b4a77-345b-3811-b2db-ebd6d1fe2205",
                        "glosses": [
                            "Sprachvarietät oder Sprache, die im kirchlichen Rahmen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568ad566-70f2-47f9-a3d3-8fe23b324309",
                                "sense_id": "e77b8485-7c0f-3bdb-9a7c-84a96cf84735",
                                "text": "„Denn innerhalb des Wortschatzes der christlichen Kirche im Deutschen findet sich eine Anzahl von Ausdrücken, die ihrer Lautform nach sehr früh aufgenommen sein müssen und die das Deutsche mit der gotischen Kirchensprache teilt.“"
                            },
                            {
                                "example_id": "b7effcc9-ae73-431f-9b91-d6a6dbfcec7e",
                                "sense_id": "e77b8485-7c0f-3bdb-9a7c-84a96cf84735",
                                "text": "„Aus der Kirchensprache wurden übernommen: Reliquie, Prozession, Tonsur, Brevier, Hostie, Monstranz, Requiem undsoweiter.“"
                            },
                            {
                                "example_id": "72e6d606-4d36-4b29-80e3-8244dd9d0071",
                                "sense_id": "e77b8485-7c0f-3bdb-9a7c-84a96cf84735",
                                "text": "„Er hielt uns Kinder zum Beten an, gab uns nachmittags zusätzliche Religionsstunden und brachte uns die Kirchensprache Ge'ez bei.“"
                            },
                            {
                                "example_id": "bc970739-e16f-40c9-a376-29dba00d3a3a",
                                "sense_id": "e77b8485-7c0f-3bdb-9a7c-84a96cf84735",
                                "text": "„Denn um die christliche Botschaft allen Reichsangehörigen in verständlicher Form nahezubringen, mußte die christliche Lehre aus der lateinischen Kirchensprache, die nur wenige Gebildete beherrschten, in eine umgangssprachliche Form übersetzt werden.“"
                            },
                            {
                                "example_id": "fcc0f5a0-79a1-4b7f-84ac-1b66657a07eb",
                                "sense_id": "e77b8485-7c0f-3bdb-9a7c-84a96cf84735",
                                "text": "„Für die Missionare war es oft sehr schwierig, die Begriffe der christlichen Religion aus der lateinischen Kirchensprache in die Sprache der Bevölkerung zu übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
