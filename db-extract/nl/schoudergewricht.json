                        "glosses": [
                            "het kogelgewricht dat schouderblad en bovenarm met elkaar verbindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13caad5-2d01-40e7-8136-dd32a0e6e185",
                                "sense_id": "554af68b-3420-3b61-addd-dcc429943133",
                                "text": "Schaatscoach Kosta Poltavets is deze week gewond geraakt na een aanrijding met een auto. Hij werd in het Friese Oldeberkoop aangereden tijdens een rondje op zijn racefiets. Poltavets, die momenteel in Russische dienst is, brak daarbij zijn sleutelbeen. Het is een breuk vlakbij het schoudergewricht."
                            },
                            {
                                "example_id": "feed76c6-e566-49dd-91be-5d6651f288d1",
                                "sense_id": "554af68b-3420-3b61-addd-dcc429943133",
                                "text": "\"Gelukkig is er niets met mijn schoudergewricht. Mijn spieren kregen wel een klap, maar de schade lijkt mee te vallen\", zei de Serviër na afloop."
                            }
                        ]
                    }
