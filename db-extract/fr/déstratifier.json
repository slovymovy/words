                ],
                "senses": [
                    {
                        "sense_id": "9adcd99b-0191-38d5-9542-fbbfea0b1b20",
                        "entry_id": "2a3d7503-2ee5-33f1-bd9b-01df15871e84",
                        "glosses": [
                            "Supprimer les strates de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45274ff0-5d8e-4151-b214-4a07467359d6",
                                "sense_id": "9adcd99b-0191-38d5-9542-fbbfea0b1b20",
                                "text": "En revanche, les diminutions de température ont lieu quand la partie sommitale de la colonne d’eau se refroidit et se déstratifie."
                            },
                            {
                                "example_id": "2b580df9-0ad1-4968-8c70-dfd12fbe5a65",
                                "sense_id": "9adcd99b-0191-38d5-9542-fbbfea0b1b20",
                                "text": "Maintenant les compétences nécessaires pour s’attaquer à la rétro-ingénierie de puces de silicium sont un frein pour descendre aussi bas, sans compter le problème du matériel (faut-il encore pouvoir décaper/déstratifier les puces avant de pouvoir commencer l’analyse)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffb68039-08f5-3bba-9294-6b36bf6e8eae",
                        "entry_id": "2a3d7503-2ee5-33f1-bd9b-01df15871e84",
                        "glosses": [
                            "Brasser l’air chaud situé en haut d’une pièce pour l’envoyer vers le bas à hauteur de l’ambiance à chauffer."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "007d8457-fbad-4a05-9b40-b59cb1926b1d",
                                "sense_id": "ffb68039-08f5-3bba-9294-6b36bf6e8eae",
                                "text": "Depuis le ventilateur simple dont les grandes pâles sont fixées au plafond, jusqu’aux systèmes plus complexes constitués d’un brasseur d’air et d’un réseau de gaines textiles accrochées au plafond pour homogénéiser la diffusion, il existe différents appareils pour déstratifier l’air dont le choix dépend de la configuration de la pièce concernée, de l’efficacité recherchée et du budget dont vous bénéficiez."
                            }
                        ]
                    }
                ],
