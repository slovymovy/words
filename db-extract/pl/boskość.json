                "translations": [
                    {
                        "translation_id": "d5d98144-2d05-4af6-8751-c51596a7d88c",
                        "source_entry_id": "7d39f7aa-e7b0-3672-bfea-dad57c2c2690",
                        "source_sense_id": "3ba038d6-e125-3555-8074-faa6acf88675",
                        "target_lang_word": "divinity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divinity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc0f58e-df09-3fe0-8d61-0186b4467271",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "The state, position, or fact of being a god or God."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85831736-9504-471c-b0cc-1f9e030ffbad",
                                                "sense_id": "6bc0f58e-df09-3fe0-8d61-0186b4467271",
                                                "text": "They say there is divinity in odd numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44efbe56-791d-3d42-8827-8df25e25380d",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "Synonym of deity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f6ff615-da44-47a1-a16a-643b9e382a2a",
                                                "sense_id": "44efbe56-791d-3d42-8827-8df25e25380d",
                                                "text": "You may leave out where you live and use either initials or an alias, since gods, buddhas and other divinities look only at our hearts."
                                            },
                                            {
                                                "example_id": "ed9faed9-2002-4122-8425-c70ddcea717b",
                                                "sense_id": "44efbe56-791d-3d42-8827-8df25e25380d",
                                                "text": "At the base of the whole process by which divinities and demons were created, and rites for their propitiation and placation established, lay Fear - fear stimulating the imagination to fantastic activity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9dbcce-92ae-37c1-9069-80d7bcacb59a",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "A celestial being inferior to a supreme God but superior to man."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf235d25-1b06-4f88-90e3-562518017330",
                                                "sense_id": "6e9dbcce-92ae-37c1-9069-80d7bcacb59a",
                                                "text": "These beings are derogatory from the wisdom and power of the author of nature, who doubtless can govern this machin he cou’d create, by more direct and easie methods, than employing these subservient divinities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "433468e6-9959-3ca5-9a41-8dd729e78d6a",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "The study of religion or religions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "379ad9c1-0214-409c-817d-5fe8cc548540",
                                                "sense_id": "433468e6-9959-3ca5-9a41-8dd729e78d6a",
                                                "text": "Harvard Divinity School has been teaching theology since 1636."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec416b33-4856-34d4-b16e-3e2e2f60e5a8",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "A type of confectionery made with egg whites, corn syrup, and white sugar."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1b7046-51f1-4c76-adde-6fdc651b4dab",
                                                "sense_id": "ec416b33-4856-34d4-b16e-3e2e2f60e5a8",
                                                "text": "A lot of it is food: Grits, fried green tomatoes, sweet potato pie, divinity, corn nuggets, hot tamales and crawfish are just some of the delicacies he has discussed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "482f895d-3ea3-49a6-b943-6f5bf2eff8f7",
                        "source_entry_id": "7d39f7aa-e7b0-3672-bfea-dad57c2c2690",
                        "source_sense_id": "3ba038d6-e125-3555-8074-faa6acf88675",
                        "target_lang_word": "godhood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9563b00b-860a-3448-a078-ca667e44181c",
                                        "entry_id": "e04eabca-413d-3505-aec2-39e02ab24105",
                                        "glosses": [
                                            "Synonym of divinity: the state of being a god or God."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43bce5d8-7a90-4329-9c09-664809895566",
                        "source_entry_id": "7d39f7aa-e7b0-3672-bfea-dad57c2c2690",
                        "source_sense_id": "3ba038d6-e125-3555-8074-faa6acf88675",
                        "target_lang_word": "divinité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divinité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Essence divine ; nature divine."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5875a6bf-a3c7-4518-9b4a-ba15afd8b804",
                                                "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                                "text": "Gardez-vous donc bien d’imiter le vulgaire, qui met la Fortune au nombre des dieux ; la bizarrerie de sa conduite l’éloigne entièrement du caractère de la divinité, […]."
                                            },
                                            {
                                                "example_id": "df9f767f-223f-4eff-b7c6-8c22facc85f4",
                                                "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                                "text": "Comme point de départ, adoptons donc la Divinité. Relativement à cette Divinité, considérée en elle-même, celui-là seul n’est pas un imbécile, celui-là seul n’est pas un impie, qui n’affirme absolument rien."
                                            },
                                            {
                                                "example_id": "0e6343b8-8c27-44f8-98a7-454a033a7184",
                                                "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                                "text": "L'attitude de la théologie chrétienne à l'égard des juifs a été fixée dans le début du IVᵉ siècle (concile de Nicée, 325) : le judaïsme ne doit pas disparaître, il doit vivre, mais dans un état d'avilissement et de misère tel qu'il fasse nettement apparaître aux yeux des croyants comme des incroyants le châtiment infligé par Dieu à ceux qui n'ont pas voulu reconnaître la divinité de Jésus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aba1988-1d03-3845-8be5-1c755bf125c5",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Dieu lui-même."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0245eb8-dada-4a21-932b-da89e9202765",
                                                "sense_id": "4aba1988-1d03-3845-8be5-1c755bf125c5",
                                                "text": "Je n’ai donc rien à vous demander pour moi, ô monseigneur Jésus ! maintenant, surtout, que de mes yeux mortels j’ai contemplé votre divinité."
                                            },
                                            {
                                                "example_id": "25f366cd-3f96-4198-bd2f-1be6214139ae",
                                                "sense_id": "4aba1988-1d03-3845-8be5-1c755bf125c5",
                                                "text": "Pourtant je tiens jalousement à l'avertissement lancé par Homère aux Grecs dans L'Iliade et par Tyrtée dans les Élégies : « C'est une faiblesse déraisonnable que de se décharger sur la divinité de la responsabilité d'une morale et d'un ordre public » — Dieu, Allah ou quel qu'il soit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b6fe00-e906-3fed-bf02-7942c08df0c3",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Dieu ou déesse du polythéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "745478ae-5530-48a3-8845-568681bee693",
                                                "sense_id": "37b6fe00-e906-3fed-bf02-7942c08df0c3",
                                                "text": "Si les divinités telluriques de Puisaye président à la naissance de Colette, il ne faut pas oublier que les dieux liés à l'eau bercent son destin."
                                            },
                                            {
                                                "example_id": "c54f3c5b-d0fd-458b-a126-c34a805e983c",
                                                "sense_id": "37b6fe00-e906-3fed-bf02-7942c08df0c3",
                                                "text": "Les sadhu ne sont pas des marginaux ou des fanatiques religieux, ce sont des hommes saints, vénérés par les hindous comme des représentants des divinités, entrés dans la voie de la libération et de l'élévation spirituelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bea3c15-d315-377e-a11f-e35573a638cc",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Représentation matérielle d'un dieu sous forme de sculpture, de statue, de statuette, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d91d3f7-df5a-40d1-9a70-0710a46f532d",
                                                "sense_id": "7bea3c15-d315-377e-a11f-e35573a638cc",
                                                "text": "Divinités en bronze, en argent, en or – de tous poids, de toutes dimensions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b88ebd46-825e-30b2-912e-ce4061e7ba83",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Être ou objet adoré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18f909ae-da59-4191-af52-db6425a79fe5",
                                                "sense_id": "b88ebd46-825e-30b2-912e-ce4061e7ba83",
                                                "text": "Le whist de l’abbé Duret faisait une utile diversion aux quasi-monologues de la divinité."
                                            },
                                            {
                                                "example_id": "a7a0350b-2d22-4640-a377-14128ab721e3",
                                                "sense_id": "b88ebd46-825e-30b2-912e-ce4061e7ba83",
                                                "text": "Quelle erreur! ces divinités renieront leurs adorateur et se retourneront même contre eux"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6f91426-66a2-434e-aa98-177a1407b672",
