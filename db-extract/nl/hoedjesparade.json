                        "glosses": [
                            "de traditie die sinds 1977 bestaat dat de meeste vrouwelijke genodigden op Prinsjesdag met een hoedje naar de Ridderzaal gaan waar de troonrede wordt voorgelezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07a9475-0462-4c91-969a-761e8d6e2b25",
                                "sense_id": "9427b96a-feee-320a-abcb-58dc0a685e90",
                                "text": "Hoedjesparade op Prinsjesdag: Geen Prinsjesdag zonder hoedjes op het Binnenhof. Net als andere jaren komen de meeste vrouwelijke genodigden vandaag met hoed naar de Ridderzaal."
                            },
                            {
                                "example_id": "96c739b2-b90b-43bd-b289-f9933c3c5622",
                                "sense_id": "9427b96a-feee-320a-abcb-58dc0a685e90",
                                "text": "Natuurlijk is er ook weer de 'hoedjesparade' op het Binnenhof, bij de Ridderzaal."
                            },
                            {
                                "example_id": "1839a16d-0155-4daa-9ece-557f2bb265b1",
                                "sense_id": "9427b96a-feee-320a-abcb-58dc0a685e90",
                                "text": "Uiterlijk wordt het echter een Prinsjesdag als alle andere: met een rijtoer door Den Haag, een ceremonie in de Ridderzaal met de jaarlijks hoedjesparade en een balkonscène op paleis Noordeinde."
                            }
                        ]
                    }
