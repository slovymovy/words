                "senses": [
                    {
                        "sense_id": "bf2fdb1a-8674-3e60-963e-e6b3449b4bc6",
                        "entry_id": "e1c5bd4e-9543-3925-8ebb-ee90974f9912",
                        "glosses": [
                            "die Richtung, in der gezählt wird: aufwärts oder abwärts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1fd38dc-964c-4b12-a9b2-43c329639a04",
                                "sense_id": "bf2fdb1a-8674-3e60-963e-e6b3449b4bc6",
                                "text": "„Es kommt hier also auf die Zählrichtung des Winkels an. Ist Uᵉ unsereBezugsgröße und wird in Richtung der linksdrehenden rotierenden Zeiger gezählt, so ist die Zählrichtung positiv. Mit dem Uhrzeigersinn ist die Zählrichtung negativ.“"
                            },
                            {
                                "example_id": "54e64208-1d16-4b2b-8fc0-0e7bc52fb43e",
                                "sense_id": "bf2fdb1a-8674-3e60-963e-e6b3449b4bc6",
                                "text": "„Die Zählrichtungen von φ und einem (möglichen) Strom im Drahtring werden einander rechtswendig zugeordnet. Die so eingeführten Zählrichtungen werden bei der mathematischen Beschreibung der Induktionswirkung genutzt.“"
                            },
                            {
                                "example_id": "174eee38-21d4-431d-88e1-09ca004095c1",
                                "sense_id": "bf2fdb1a-8674-3e60-963e-e6b3449b4bc6",
                                "text": "„Die Stromstärke ist positiv, wenn überwiegend negative Ladungen entgegen der Zählrichtung oder überwiegend positive Ladungen in Zählrichtung durch den Querschnitt fließen.“"
                            },
                            {
                                "example_id": "7540c8fe-8f2e-4b0b-bde4-910555a3b80e",
                                "sense_id": "bf2fdb1a-8674-3e60-963e-e6b3449b4bc6",
                                "text": "Man hat einfach die Zählrichtung umgekehrt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
