                                    {
                                        "sense_id": "72e7f5bb-998a-3dec-b7ad-1bb066f82eaf",
                                        "entry_id": "08a33c59-f333-3e12-8a12-40e0a5e9e211",
                                        "glosses": [
                                            "elektrisches Gerät, das Flächen durch Absaugen des darauf befindlichen Schmutzes reinigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a56f13-339b-4099-9366-6d82ec637058",
                                                "sense_id": "72e7f5bb-998a-3dec-b7ad-1bb066f82eaf",
                                                "text": "Unser Staubsauger ist defekt, er saugt nur noch mit halber Kraft."
                                            },
                                            {
                                                "example_id": "077898f4-b507-4e8f-8a41-67586b17a779",
                                                "sense_id": "72e7f5bb-998a-3dec-b7ad-1bb066f82eaf",
                                                "text": "„Er war allerdings nicht auf der Flucht, sondern kam als erfolgreicher Handelsvertreter für Nähmaschinen und neuerdings Staubsauger aus dem amerikanischen Singer-Konzern.“"
                                            },
                                            {
                                                "example_id": "5769cdb8-63af-4436-8286-4e40155925f5",
                                                "sense_id": "72e7f5bb-998a-3dec-b7ad-1bb066f82eaf",
                                                "text": "„Der Staubsauger hat aufgehört zu summen.“"
                                            },
                                            {
                                                "example_id": "e7bdd93a-7700-4fc7-8766-ae7c5c693d9a",
                                                "sense_id": "72e7f5bb-998a-3dec-b7ad-1bb066f82eaf",
                                                "text": "„Am Tage drauf stehe ich mitten im Zimmer, zusammen mit zwei von unseren Haustieren: einer elektrischen Bohnermaschine und einem Staubsauger, und betrachte mir einmal die Bilder des Hauses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba1fe443-f02d-49f1-8f98-9c740b6c725a",
                        "source_entry_id": "8c5ad1be-3532-3a19-b893-93fddce4410a",
