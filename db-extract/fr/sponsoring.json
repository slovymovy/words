                    {
                        "translation_id": "0b6d35ff-31ee-40e6-9792-0500990cd93e",
                        "source_entry_id": "101a8cd8-5810-360d-a9ed-391dad85462d",
                        "source_sense_id": "4c038f7e-078a-3ac2-9b75-730544f194ad",
                        "target_lang_word": "support",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "support",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8aa5be-841c-30b9-96b8-5422d3cf3557",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To help keep from falling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e541462-512e-4a57-a7e5-0ae65a9132d6",
                                                "sense_id": "1f8aa5be-841c-30b9-96b8-5422d3cf3557",
                                                "text": "Don’t move that beam! It supports the whole platform."
                                            },
                                            {
                                                "example_id": "5e855d34-00c8-4a42-a416-da4d3ef08b8f",
                                                "sense_id": "1f8aa5be-841c-30b9-96b8-5422d3cf3557",
                                                "text": "He staggered away from the accident site, supported by one friend on each side."
                                            },
                                            {
                                                "example_id": "a96d17ca-f718-4c52-9af2-7a6747fb52b0",
                                                "sense_id": "1f8aa5be-841c-30b9-96b8-5422d3cf3557",
                                                "text": "There is a soft-mat seat (which originally had a palm fiber underwebbing) supported by three curved transverse braces."
                                            },
                                            {
                                                "example_id": "06e3b001-abd4-4dd2-9552-53fbbf44b03f",
                                                "sense_id": "1f8aa5be-841c-30b9-96b8-5422d3cf3557",
                                                "text": "One of the keys to glassing effectively is supporting your binoculars. Advanced glassers who scan lots of country for long periods of time, or who use binoculars of 10X power or more, often use a lightweight camera tripod […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69f05047-a4bc-3836-8572-de5b4203f6b9",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To back or favor a cause, party, etc., mentally or with concrete aid"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87d4755f-51c6-441b-89f5-0066b9316b3b",
                                                "sense_id": "69f05047-a4bc-3836-8572-de5b4203f6b9",
                                                "text": "I support France in the World Cup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54142b7f-b1aa-3b26-94aa-131fbd6b7951",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To provide sustenance or maintenance for; to sustain in integrity or livelihood."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f0b8dd-0dbb-49fd-90c8-20ccf0c9be60",
                                                "sense_id": "54142b7f-b1aa-3b26-94aa-131fbd6b7951",
                                                "text": "Mars does not currently support human habitation."
                                            },
                                            {
                                                "example_id": "e68e8c1d-4225-486a-bd01-498bd468e1b3",
                                                "sense_id": "54142b7f-b1aa-3b26-94aa-131fbd6b7951",
                                                "text": "A grain, which in England is generally given to horſes, but which in Scotland ſupports the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7b6ab5f-188e-3ce8-899a-16679a545d99",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To help, particularly financially; to subsidize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2de0e38a-3fec-4d05-8229-74014b6e41c1",
                                                "sense_id": "c7b6ab5f-188e-3ce8-899a-16679a545d99",
                                                "text": "I said I shouldn’t support anything that deceives people."
                                            },
                                            {
                                                "example_id": "75e67e26-900c-4a29-81de-09c7ebd02276",
                                                "sense_id": "c7b6ab5f-188e-3ce8-899a-16679a545d99",
                                                "text": "The government supports the arts in several ways."
                                            },
                                            {
                                                "example_id": "5bddc23c-a08c-476c-bfc4-8fd3d3a89120",
                                                "sense_id": "c7b6ab5f-188e-3ce8-899a-16679a545d99",
                                                "text": "The NIAID supports projects at universities and research organizations around the United States as well as a network of 21 NIAID labs across the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b513cbc-848d-3f45-869d-48e1de5eeb05",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To provide evidence for; to lend credibility to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f35c22-5629-4e81-ada5-6ec57df6939f",
                                                "sense_id": "4b513cbc-848d-3f45-869d-48e1de5eeb05",
                                                "text": "The testimony is not sufficient to support the charges."
                                            },
                                            {
                                                "example_id": "a29dedec-542c-49ae-ac42-befe1ffaaca4",
                                                "sense_id": "4b513cbc-848d-3f45-869d-48e1de5eeb05",
                                                "text": "The evidence will not support the statements or allegations."
                                            },
                                            {
                                                "example_id": "d566f2ce-cd14-454e-9b28-1679d551511c",
                                                "sense_id": "4b513cbc-848d-3f45-869d-48e1de5eeb05",
                                                "text": "to urge such arguments, as though they were sufficient to support and demonstrate a whole scheme of moral philosophy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a91d6aab-4ad9-34da-b2a0-b9229c845dbd",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To serve, as in a customer-oriented position; to give support to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd6fd386-8795-4842-9b52-95f439b1e697",
                                                "sense_id": "a91d6aab-4ad9-34da-b2a0-b9229c845dbd",
                                                "text": "The IT Department supports the research organization, but not the sales force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09afb6c8-fe15-38ec-a86c-510945180e4c",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To assist or be involved with, but not be responsible for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d038c4-0d14-4615-949d-e87af2ebc475",
                                                "sense_id": "09afb6c8-fe15-38ec-a86c-510945180e4c",
                                                "text": "I support the administrative activities of the executive branch of the organization."
                                            },
                                            {
                                                "example_id": "7b7a8ed8-fccc-4a09-a90b-0c7fdbc87e90",
                                                "sense_id": "09afb6c8-fe15-38ec-a86c-510945180e4c",
                                                "text": "I don't make decisions, but I support those who do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccb168b2-dd2b-398c-9ae3-e4552dd689ae",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To answer questions and resolve problems regarding something sold."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5826bb-0bcf-4e77-94c0-4a0332820e8c",
                                                "sense_id": "ccb168b2-dd2b-398c-9ae3-e4552dd689ae",
                                                "text": "Sure they sell the product, but do they support it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4dfa9fc-f4a6-3641-ad0c-ae22f6e3e766",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To be designed to provide capacity for; to work or be compatible with (a part, accessory, file type, program, algorithm, etc.)."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc53c89c-d322-4a02-9f79-da2f344cb4b5",
                                                "sense_id": "e4dfa9fc-f4a6-3641-ad0c-ae22f6e3e766",
                                                "text": "Early personal computers did not support voice-recognition hardware or software."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fff7aea-3f36-3191-905a-f70f4313dfdd",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To endure without being overcome; bear; undergo; tolerate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ac0365-a729-497e-9133-340a5d7332d6",
                                                "sense_id": "7fff7aea-3f36-3191-905a-f70f4313dfdd",
                                                "text": "This fierce demeanour and his insolence / The patience of a god could not support."
                                            },
                                            {
                                                "example_id": "0fe21722-ed76-43b0-aa98-13beff7ecde9",
                                                "sense_id": "7fff7aea-3f36-3191-905a-f70f4313dfdd",
                                                "text": "For a strong affection such moments are worth supporting, and they will end well; for your advocate is in your lover's heart and speaks her own language[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aeb50d7-410c-3e21-9060-20c9a00a8685",
                                        "entry_id": "8dfb9761-f158-3633-8850-7413b4d54766",
                                        "glosses": [
                                            "To play a lesser part in the same production with (a star performer)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5669d1e9-1da4-4df5-91c4-687b1071dfe2",
                                                "sense_id": "2aeb50d7-410c-3e21-9060-20c9a00a8685",
                                                "text": "to support the character of King Lear"
                                            },
                                            {
                                                "example_id": "101f8615-f428-44a8-beb1-b7053e7ec10d",
                                                "sense_id": "2aeb50d7-410c-3e21-9060-20c9a00a8685",
                                                "text": "And the award for best supporting actress goes to..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "support",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0f17e75-f378-3db7-bf51-098fba7f23c2",
                                        "entry_id": "7abea934-d4c6-38a8-b713-eac1ce324cb8",
                                        "glosses": [
                                            "Something which supports."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ddb5ffe-96d9-4765-a396-d03ffab91fc4",
                                                "sense_id": "d0f17e75-f378-3db7-bf51-098fba7f23c2",
                                                "text": "Don't move that beam! It's a support for the whole platform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20127246-87b3-3540-bb5b-e0dec8545b70",
                                        "entry_id": "7abea934-d4c6-38a8-b713-eac1ce324cb8",
                                        "glosses": [
                                            "Financial or other help."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbab1be6-273e-429e-84c9-eb440dc73c3a",
                                                "sense_id": "20127246-87b3-3540-bb5b-e0dec8545b70",
                                                "text": "The government provides support to the arts in several ways."
                                            },
                                            {
                                                "example_id": "f43924d0-2181-49bd-92de-fb70db19c659",
                                                "sense_id": "20127246-87b3-3540-bb5b-e0dec8545b70",
                                                "text": "Kim was educated at the newly founded university in Pyongyang, named after his father, graduating in 1964. The 1960s and early 1970s were the golden years for the DPRK. It undertook rapid industrialisation, economically outstripped its southern competitor, and enjoyed the support of both the People's Republic of China, and the Soviet Union."
                                            },
                                            {
                                                "example_id": "6c57ffcc-26f2-44d3-8e55-5cef0678df3c",
                                                "sense_id": "20127246-87b3-3540-bb5b-e0dec8545b70",
                                                "text": "Admiral Hackett: Hell of a thing you just pulled off, Commander. Curing the genophage? I never thought I'd see the day.\nShepard: Wrex has agreed to help the turians, Admiral. We should get their full support."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1280d1-15e9-3683-bac6-910380eec284",
                                        "entry_id": "7abea934-d4c6-38a8-b713-eac1ce324cb8",
                                        "glosses": [
                                            "Answers to questions and resolution of problems regarding something sold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2efa1a2e-9316-4a54-baa1-6548681bf716",
                                                "sense_id": "0a1280d1-15e9-3683-bac6-910380eec284",
                                                "text": "Sure they sell the product, but do they provide support?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b391571f-f8b6-3700-94de-373ce368fdd0",
                                        "entry_id": "7abea934-d4c6-38a8-b713-eac1ce324cb8",
                                        "glosses": [
                                            "in relation to a function, the set of points where the function is not zero; the closure of that set."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b6fc33e-04ba-3d13-8908-e322fab4dce2",
                                        "entry_id": "7abea934-d4c6-38a8-b713-eac1ce324cb8",
                                        "glosses": [
                                            "A set whose elements are at least partially included in a given fuzzy set (i.e., whose grade of membership in that fuzzy set is strictly greater than zero)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54db8b01-7429-42c9-ae3e-0685293acf17",
                                                "sense_id": "5b6fc33e-04ba-3d13-8908-e322fab4dce2",
                                                "text": "If the membership function of a fuzzy set is continuous, then that fuzzy set's support is an open set."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a44ea221-3a30-36f5-9516-a17eba120664",
                                        "entry_id": "7abea934-d4c6-38a8-b713-eac1ce324cb8",
                                        "glosses": [
                                            "The set of all prime ideals of R such that the localization of M at the prime is nonzero, denoted operatorname SuppM"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b3408e2-a6d3-32af-b1a5-a0cfa065d868",
                                        "entry_id": "7abea934-d4c6-38a8-b713-eac1ce324cb8",
                                        "glosses": [
                                            "Evidence."
                                        ],
                                        "tags": [
                                            "countable",
