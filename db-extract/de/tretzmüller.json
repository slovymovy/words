                ],
                "senses": [
                    {
                        "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                        "entry_id": "66157516-769e-3766-a663-b9f762061dab",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91c0af2-726a-45e8-9324-9561307affa2",
                                "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                                "text": "Frau Tretzmüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "64b9a5a9-422d-4f7e-a0dd-10c8eb1bdadc",
                                "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                                "text": "Herr Tretzmüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "475fe395-4748-4c64-8aa2-f70249f114ed",
                                "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                                "text": "Die Tretzmüllers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "104a45fd-b0a7-4d68-a3c3-868e81f7e3e9",
                                "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                                "text": "Der Tretzmüller trägt nie die Schals, die die Tretzmüller ihm strickt."
                            },
                            {
                                "example_id": "7383ad9c-5756-499d-9852-55ac2d0e6aa7",
                                "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tretzmüller kommt, geht der Herr Tretzmüller.“"
                            },
                            {
                                "example_id": "96591a05-1e3f-479e-91b7-0b9915de7ba7",
                                "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                                "text": "Tretzmüller kommt und geht."
                            },
                            {
                                "example_id": "e6ee0b49-5089-4557-9aef-927873486a98",
                                "sense_id": "23d32482-9206-37a9-bd2b-dbad4bd2a8cd",
                                "text": "Tretzmüllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
