                        "examples": [
                            {
                                "example_id": "84d0e751-23b1-4017-8d5d-7b71ba6bd2a7",
                                "sense_id": "88d23b49-fce8-39b7-8700-12d7b636883c",
                                "text": "Дремлющи села петел будящий К утренним кличет трудам."
                            },
                            {
                                "example_id": "c961f22e-76e7-4f49-be2a-34c62853596c",
                                "sense_id": "88d23b49-fce8-39b7-8700-12d7b636883c",
                                "text": "А слушать, как поют петелы, скворцы, жайворонки и синицы?"
                            },
                            {
                                "example_id": "ca6765d3-0e26-4ff9-8a85-070588a2acbb",
                                "sense_id": "88d23b49-fce8-39b7-8700-12d7b636883c",
                                "text": "И скоро будет солнце ― скоро Безумный петел прокричит."
                            }
                        ]
                    }
                ],
