    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1a14793-0154-3bc9-a22d-ef708c852d74",
                    "sense_definition": "Provoquer une personne à une lutte, un combat ou une compétition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "provocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune joueur veut <w>défier</w> le champion lors du prochain tournoi."
                        },
                        {
                            "text": "Notre équipe va <w>défier</w> un adversaire redoutable dès le premier match."
                        }
                    ],
                    "synonyms": [
                        "provoquer",
                        "affronter"
                    ],
                    "common_phrases": [
                        "défier un adversaire",
                        "défier en duel"
                    ]
                },
                {
                    "sense_id": "d3bf9461-c26f-304a-8fc3-4f33caa3e076",
                    "sense_definition": "Inviter avec insistance quelqu'un à faire une chose jugée impossible ou très difficile.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "provocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te <w>défie</w> de résoudre ce problème de mathématiques sans calculatrice."
                        },
                        {
                            "text": "Le professeur a <w>défié</w> les étudiants de trouver la moindre erreur dans son texte."
                        }
                    ],
                    "common_phrases": [
                        "défier de deviner",
                        "défier quiconque"
                    ]
                },
                {
                    "sense_id": "d84203ca-705c-3752-98d9-3d04845ffef5",
                    "sense_definition": "Braver un danger, une autorité ou une loi naturelle avec courage ou insolence ; résister à l'épreuve.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux monument semble <w>défier</w> le temps depuis des siècles."
                        },
                        {
                            "text": "Les marins ont dû <w>défier</w> la tempête pour regagner la côte en toute sécurité."
                        }
                    ],
                    "synonyms": [
                        "braver"
                    ],
                    "antonyms": [
                        "craindre",
                        "redouter"
                    ],
                    "common_phrases": [
                        "défier l'autorité",
                        "défier le temps",
                        "défier les lois"
                    ]
                },
                {
                    "sense_id": "cf42fb22-17a6-3ee8-ae68-0d2594946a5f",
                    "sense_definition": "Éprouver de la méfiance, se mettre en garde contre quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mefiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyageur prudent apprend à se <w>défier</w> des apparences trompeuses."
                        },
                        {
                            "text": "Elle se <w>défiait</w> constamment des promesses faites par les inconnus."
                        }
                    ],
                    "common_phrases": [
                        "se défier des apparences"
                    ],
