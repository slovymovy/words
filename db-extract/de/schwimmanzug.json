                "senses": [
                    {
                        "sense_id": "24946649-c7ca-36a9-a848-14b5a03fd4f6",
                        "entry_id": "79433fb4-fcba-39fa-8fdd-cc45a1932ab4",
                        "glosses": [
                            "für den Schwimmwettkampf aus speziellen Materialien gefertigtes, besonders eng anliegendes Kleidungsstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af68e7d6-2084-42f8-a691-029a73930100",
                                "sense_id": "24946649-c7ca-36a9-a848-14b5a03fd4f6",
                                "text": "„‚Es war ein unglaubliches schönes Rennen, es hat so viel Spaß gemacht, ich habe mich so gut gefühlt‘, meinte Biedermann, der nicht wie bei seinem EM-Titel und Olympia nur mit einer Hose, sondern erstmals mit einem Schwimmanzug der neuen Generation sowie mit Badekappe schwamm.“"
                            },
                            {
                                "example_id": "f4c78031-8cfd-47c4-a57e-c612d688026f",
                                "sense_id": "24946649-c7ca-36a9-a848-14b5a03fd4f6",
                                "text": "„DSV-Schwimmer hatten bereits vor Olympia in Peking Kritik an den angeblich nicht konkurrenzfähigen Schwimmanzügen geübt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3dbdeb52-1e51-3872-a19f-d44b8b5328dc",
                        "entry_id": "79433fb4-fcba-39fa-8fdd-cc45a1932ab4",
                        "glosses": [
                            "spezielles Kleidungsstück für Kampfschwimmer zur Fortbewegung in und unter Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d43b539-c1a4-43db-ae61-0cb1dab17036",
                                "sense_id": "3dbdeb52-1e51-3872-a19f-d44b8b5328dc",
                                "text": "„Die Kampfschwimmer, die schon mit wasserdichten Schwimmanzügen, Atemgeräten und Flossen ausgestattet waren, befestigten Zeitbomben mit Spezialsaugnäpfen an der Stabilisierungsleiste der feindlichen Schiffe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2c7e7eca-6625-325f-a722-af4693d431f5",
                        "entry_id": "79433fb4-fcba-39fa-8fdd-cc45a1932ab4",
                        "glosses": [
                            "beim Schwimmen (vor allem von Frauen sowie – früher auch, heutzutage selten – von Männern) getragenes (für gewöhnlich einteiliges) Kleidungsstück, das zumindest die Vorderseite des Rumpfes bedeckt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a74cf1ff-cd2f-495c-ac14-e620bfdcf4ac",
                                "sense_id": "2c7e7eca-6625-325f-a722-af4693d431f5",
                                "text": "„Bei Strand- und Bademoden dominierten für die damalige Zeit knapp sitzende Bikinis, Schwimmanzüge und Badehosen in leuchtenden Farben.“"
                            },
                            {
                                "example_id": "8842f237-e95c-455f-af61-08c5a7e89a13",
                                "sense_id": "2c7e7eca-6625-325f-a722-af4693d431f5",
                                "text": "„Noch cooler ist es, auf einem Pferd zu stehen, das im Wasser schwimmt. An der Bucht der Insel Anna Maria Island kann man genau dies tun: Zunächst reitet man, bekleidet mit Badehose oder Schwimmanzug, am palmenbestandenen Strand entlang, dann hinein ins Wasser, bis die Pferde nicht mehr stehen können und zu schwimmen beginnen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
