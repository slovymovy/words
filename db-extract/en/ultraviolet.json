                                                "sense_id": "e6cc6775-2756-3d96-bd8d-b23084de070a",
                                                "text": "L’infrarouge et l’ultraviolet."
                                            },
                                            {
                                                "example_id": "851d0800-bcbb-4943-a254-3693c6687c5c",
                                                "sense_id": "e6cc6775-2756-3d96-bd8d-b23084de070a",
                                                "text": "Pour bronzer, je me suis fait une séance d’ultraviolets."
                                            }
                                        ]
