                        "examples": [
                            {
                                "example_id": "99e61bee-9393-416f-bb13-9e9072f101e7",
                                "sense_id": "d2f39e38-a0da-3f28-ba4a-ce2c8470ed89",
                                "text": "Ich bitt Euch, gnädger Fürst, mir zu verzeihn. / Ich weiß nicht, welche Macht mir Kühnheit gibt, / Noch wie es meiner Sittsamkeit geziemt, / In solcher Gegenwart das Wort zu führen;",
                                "translation": "I do entreat your grace to pardon me. / I know not by what power I am made bold, / Nor how it may concern my modesty, / In such a presence here to plead my thoughts;",
                                "english": "I do entreat your grace to pardon me. / I know not by what power I am made bold, / Nor how it may concern my modesty, / In such a presence here to plead my thoughts;"
                            }
                        ]
