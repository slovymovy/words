                        "sense_id": "9260da51-512b-3d10-aba9-94cdcaae8778",
                        "entry_id": "572adcbd-f6b6-31dc-8304-acb66d831328",
                        "glosses": [
                            "Satisfait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4919bb-73a9-40eb-ad44-5bb2b2025c5d",
                                "sense_id": "9260da51-512b-3d10-aba9-94cdcaae8778",
                                "text": "Un homme comblé, Un homme dont tous les vœux sont satisfaits."
                            }
                        ]
                    },
                    {
                        "sense_id": "f21c8484-5c20-3b18-9a7c-f2b61a1708fb",
                        "entry_id": "572adcbd-f6b6-31dc-8304-acb66d831328",
                        "glosses": [
                            "Rempli."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20181335-2595-4659-b3a8-78ebbdd19e73",
                                "sense_id": "f21c8484-5c20-3b18-9a7c-f2b61a1708fb",
                                "text": "A force de recherches, de minuties et d’art mal entendu, ils sont parvenus à faire même de leurs jardins, comblés de fleurs rares, des lieux désagréables et ennuyeux."
                            },
                            {
                                "example_id": "ef55718e-8d26-4683-9d9a-b7521b9c947f",
                                "sense_id": "f21c8484-5c20-3b18-9a7c-f2b61a1708fb",
                                "text": "On distingue vaguement des anciens restes de douves ; on entre quelques pas dans un souterrain comblé, on se promène là-dedans, on regarde et on s’en va."
                            }
                        ]
                    },
