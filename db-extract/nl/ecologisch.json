                    },
                    {
                        "sense_id": "1d5239fb-5253-3d2a-812a-019a9afd8890",
                        "entry_id": "b6294e47-2ea8-31d9-bb43-53db51d5cfb2",
                        "glosses": [
                            "milieuvriendelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b785a69d-df8b-43f8-85e6-13a388a8c4b1",
                                "sense_id": "1d5239fb-5253-3d2a-812a-019a9afd8890",
                                "text": "„Als je naar de ecologische kant kijkt, zien we dat zeven van de negen planetaire grenzen zijn overschreden. De redenen daarvoor zijn volstrekt helder: landgebruik, grondstoffengebruik, uitstoot. Ze hebben allemaal te maken met economische activiteit.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef86494f-d649-4857-91fa-102bf0184840",
                        "source_entry_id": "b6294e47-2ea8-31d9-bb43-53db51d5cfb2",
                        "target_lang_word": "ökologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ökologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acc265c9-389d-336e-9509-24e27b5589a9",
                                        "entry_id": "0411c0ab-5ab1-3b53-964c-7547b5ddd000",
                                        "glosses": [
                                            "die Ökologie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514d5e68-9518-4010-a5d1-5f90035614a2",
                                                "sense_id": "acc265c9-389d-336e-9509-24e27b5589a9",
                                                "text": "„Die 14 Hektar große Grünzone hat heute neben der städtebaulichen auch wichtige wasserwirtschaftliche und ökologische Funktionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d721ec3-3155-3a9f-abbe-86b8dd8540f4",
                                        "entry_id": "0411c0ab-5ab1-3b53-964c-7547b5ddd000",
                                        "glosses": [
                                            "in Einklang mit der Natur, der Umwelt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c103a961-f031-4866-baa0-ecec5d468681",
                                                "sense_id": "2d721ec3-3155-3a9f-abbe-86b8dd8540f4",
                                                "text": "Die ökologische Landwirtschaft ist wichtig für die Umwelt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a14b7b33-7973-4cd8-a81c-1192facd888f",
                        "source_entry_id": "b6294e47-2ea8-31d9-bb43-53db51d5cfb2",
