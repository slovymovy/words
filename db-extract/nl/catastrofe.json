                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b2f5b4-9adc-4641-84cd-7e96dcf43302",
                                "sense_id": "ad630d3f-d885-31f1-818a-1fa938939a20",
                                "text": "Wat een catastrofe!"
                            },
                            {
                                "example_id": "e69a5425-9fb6-472e-95b0-4bdbbbbcdb02",
                                "sense_id": "ad630d3f-d885-31f1-818a-1fa938939a20",
                                "text": "Het was Karl die de catastrofe veroorzaakte, maar het moet worden gezegd dat hij het onmogelijk had kunnen voorzien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d0c3cd0-85c1-44b5-862b-2ceb31365068",
                        "source_entry_id": "e6f575b5-4625-37ae-a990-106c6abb96d9",
                        "source_sense_id": "ad630d3f-d885-31f1-818a-1fa938939a20",
                        "source_sense_description": "een algemene ramp",
                        "target_lang_word": "Katastrophe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katastrophe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                        "entry_id": "c2649a2a-35b0-3477-8bcd-46a9639e0b94",
                                        "glosses": [
                                            "großes, schweres Unglück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98bb5cd-3911-4ea1-a7f8-da9b12208f4a",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "Die sich anbahnende Katastrophe war nicht mehr zu verhindern."
                                            },
                                            {
                                                "example_id": "1106ec3f-25cd-41e1-a32b-b82b241751c2",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Die Reaktorkatastrophe sei ein desaströser Anlass, »doch zugleich auch eine Chance, von einem Pfad abzukommen, der Kollaps, Katastrophen und Kriege heraufbeschwört«, sagt er.“"
                                            },
                                            {
                                                "example_id": "7d25ed39-52b6-4322-857b-3062d469c33a",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Die Folgen von kollektiven Katastrophen hatten in der Psychoanalyse kein Gewicht.“"
                                            },
                                            {
                                                "example_id": "c1237f95-3ee9-4180-8f59-4e5560e742e2",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Als wir fünf Jahre nach der Katastrophe durch New Orleans spazieren, ist das größte Chaos beseitigt.“"
                                            },
                                            {
                                                "example_id": "e1b8698d-4309-4f98-a449-6300009ed776",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Das Feuer auf dem Öltanker Annika ist gelöscht. Rettungskräfte verhinderten eine Katastrophe vor der Küste von Mecklenburg-Vorpommern.“"
                                            },
                                            {
                                                "example_id": "d2ba371e-8fa2-4ef1-b426-cc616116250f",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Niemand möchte Entscheidungen treffen und Befehle erteilen, die einem Eingeständnis der Katastrophe gleichkämen.“"
                                            },
                                            {
                                                "example_id": "7cf06397-fcf6-4694-8bf7-0d5941548d3a",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "[Russlands Krieg gegen die Ukraine 2022:] „Sie betrachtete den Krieg als eine Katastrophe und versuchte, nicht an ihn zu denken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a32913e-b499-37ad-8de5-0ec6b7eced8b",
                                        "entry_id": "c2649a2a-35b0-3477-8bcd-46a9639e0b94",
                                        "glosses": [
                                            "entscheidende Wende in einer Tragödie"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bbc13fc-5893-4388-afa0-1589ffa17385",
                                                "sense_id": "0a32913e-b499-37ad-8de5-0ec6b7eced8b",
                                                "text": "„Ein Hollywood-Film folgt der Dramaturgie des griechischen Theaters, weil dieses die effizientesten Wirkungsregeln entwickelt und benannt hat: Exposition, Peripetie und Anagnorisis, Katastrophe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b774e270-f181-4a99-93e8-d85601fe925d",
                        "source_entry_id": "e6f575b5-4625-37ae-a990-106c6abb96d9",
                        "source_sense_id": "ad630d3f-d885-31f1-818a-1fa938939a20",
                        "source_sense_description": "een algemene ramp",
                        "target_lang_word": "catastrophe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catastrophe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73d0fc81-136f-3a6f-892c-ea01609910fb",
                                        "entry_id": "dac20c84-2922-395c-887c-b50e0aaa5ba4",
                                        "glosses": [
                                            "Any large and disastrous event of great significance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd0b6d13-cac6-4681-81b6-ff21cba29859",
                                                "sense_id": "73d0fc81-136f-3a6f-892c-ea01609910fb",
                                                "text": "The Chernobyl disaster was a catastrophe."
                                            },
                                            {
                                                "example_id": "01b24382-1d82-40e6-9657-5c379011b1ac",
                                                "sense_id": "73d0fc81-136f-3a6f-892c-ea01609910fb",
                                                "text": "Last night, after the brief sitting of the House of Lords, and before catastrophe befell the Government in the Commons, I had a long chat with the Premier, in which he discussed the Home Rule question and his relations with it in perfectly frank manner."
                                            },
                                            {
                                                "example_id": "2e797f39-8d97-490b-8017-5bd3e961ddd8",
                                                "sense_id": "73d0fc81-136f-3a6f-892c-ea01609910fb",
                                                "text": "Between these high lights accumulated disaster, social catastrophe."
                                            },
                                            {
                                                "example_id": "045ba3ff-8190-406a-a657-15eada78cc2c",
                                                "sense_id": "73d0fc81-136f-3a6f-892c-ea01609910fb",
                                                "text": "Am I not a man? And is a man not stupid? I'm a man, so I married. Wife, children, house, everything. The full catastrophe."
                                            },
                                            {
                                                "example_id": "607df2c3-34b1-4400-a54d-b3d665e28f25",
                                                "sense_id": "73d0fc81-136f-3a6f-892c-ea01609910fb",
                                                "text": "For years, Mao Da, an environmental researcher, has studied the plastic industry in Wen’an County, near Beijing. Workers there used to sort through food and medical waste by hand, he said. Nonrecyclable material was buried in pits near farmland.\n“It was an environmental and public health catastrophe,” Mr. Mao said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a82850-a47e-3545-ad93-d24a5ceba9f9",
                                        "entry_id": "dac20c84-2922-395c-887c-b50e0aaa5ba4",
                                        "glosses": [
                                            "A disaster beyond expectations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d2a7098-bf78-3275-a1b7-89da47cb79ad",
                                        "entry_id": "dac20c84-2922-395c-887c-b50e0aaa5ba4",
                                        "glosses": [
                                            "The dramatic event that initiates the resolution of the plot; the dénouement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5028aee-ca91-47f7-afe2-576b6921d977",
                                                "sense_id": "5d2a7098-bf78-3275-a1b7-89da47cb79ad",
                                                "text": "Pat : he comes like the Cataſtrophe of the old Comedie : my Cue is villanous Melancholly, with a ſighe like Tom o’ Bedlam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaebc280-531f-3dae-9306-7a2c22522c15",
                                        "entry_id": "dac20c84-2922-395c-887c-b50e0aaa5ba4",
                                        "glosses": [
                                            "A type of bifurcation, where a system shifts between two stable states."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72609028-b072-4170-af80-7be8a20c917c",
                        "source_entry_id": "e6f575b5-4625-37ae-a990-106c6abb96d9",
                        "source_sense_id": "ad630d3f-d885-31f1-818a-1fa938939a20",
                        "source_sense_description": "een algemene ramp",
                        "target_lang_word": "catastrophe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catastrophe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3893662-b093-3edb-a9d7-4524257a8a85",
                                        "entry_id": "c20a5521-292b-395b-a2a3-589060a877aa",
                                        "glosses": [
                                            "Événement soudain, qui, bouleversant le cours des choses, amène la destruction, la ruine, la mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48426566-459f-4efa-b0a6-ad4644746b88",
                                                "sense_id": "f3893662-b093-3edb-a9d7-4524257a8a85",
                                                "text": "Après une semaine fertile en péripéties et en catastrophes, Hervé, depuis la résurrection d'Alain Kernoul, venait de passer bien des heures paisibles."
                                            },
                                            {
                                                "example_id": "0f23f1b0-a97e-467c-bd22-be6068eb8100",
                                                "sense_id": "f3893662-b093-3edb-a9d7-4524257a8a85",
                                                "text": "Bert avait suivi les péripéties de la catastrophe, depuis la séparation des eaux jusqu’à la culée du pont."
                                            },
                                            {
                                                "example_id": "c3c3dc66-09a8-4610-a3f4-ab605fb42505",
                                                "sense_id": "f3893662-b093-3edb-a9d7-4524257a8a85",
                                                "text": "S'ils se sont répandus, nombreux, à travers d'autres pays, c'est soit pour fuir des catastrophes (guerres, révolutions, massacres,) soit pour échapper aux inconvénients de la surpopulation."
                                            },
                                            {
                                                "example_id": "0a0c6763-fd8b-4a1b-98c8-59943a643ae8",
                                                "sense_id": "f3893662-b093-3edb-a9d7-4524257a8a85",
                                                "text": "Et puis, si aucun cataclysme soudain n'a décisivement transformé l'aspect naturel des choses, d'un seul coup, depuis un siècle, il est cependant vrai qu'au ralenti une catastrophe inéluctable impose à cette partie de la France, cette fatale loi d’impermanence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a9ac74-8e1f-3444-a296-84aea6f1f84a",
                                        "entry_id": "c20a5521-292b-395b-a2a3-589060a877aa",
                                        "glosses": [
                                            "Désastre ; calamité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d23a840-e6d1-451e-8dca-586f691bb50f",
                                                "sense_id": "54a9ac74-8e1f-3444-a296-84aea6f1f84a",
                                                "text": "Qui oserait blasphémer contre cette sublime épopée, qui commence à Valmy, et qui se déroule, en traits de feu, jusqu’à la sombre catastrophe de Waterloo ; épopée qui débute par un hymne de triomphe, et qui se ferme sous les plaintes d'une douloureuse élégie ?"
                                            },
                                            {
                                                "example_id": "13034ab8-e48a-4d7f-b626-3b8cb0845cb3",
                                                "sense_id": "54a9ac74-8e1f-3444-a296-84aea6f1f84a",
                                                "text": "Ce brouillard, dehors, c’est une vraie catastrophe !"
                                            },
                                            {
                                                "example_id": "105a3d62-e141-4fa1-825c-2ea9020e934f",
                                                "sense_id": "54a9ac74-8e1f-3444-a296-84aea6f1f84a",
                                                "text": "charmion. — Et cette heure dernière, parle-m’en … à cette époque nul ne pressentait la catastrophe qui vous a engloutis.\neiros. — Notre catastrophe était, comme tu le dis, absolument inattendue ;"
                                            },
                                            {
                                                "example_id": "97085fff-cf52-439b-9d77-54c3d7396e0f",
                                                "sense_id": "54a9ac74-8e1f-3444-a296-84aea6f1f84a",
                                                "text": "Chez les centristes, personne n’avait trouvé de réplique adéquate, le ton acerbe et populaire de Davenir étant souvent perçu comme le fruit d’une franchise clairvoyante, salutaire pour échapper aux réflexions modérées qui menaient à la catastrophe planétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ad172e-d1b3-3306-a2e3-4abc216a321d",
                                        "entry_id": "c20a5521-292b-395b-a2a3-589060a877aa",
                                        "glosses": [
                                            "Dénouement funeste d’une tragédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50da02d-e69f-4bca-a2d8-3903f526cadd",
                                                "sense_id": "82ad172e-d1b3-3306-a2e3-4abc216a321d",
                                                "text": "On doit préparer habilement la catastrophe."
                                            },
                                            {
                                                "example_id": "d62f06d1-dfb1-4d6e-8ba3-b9b444300a20",
                                                "sense_id": "82ad172e-d1b3-3306-a2e3-4abc216a321d",
                                                "text": "L’intérêt s’affaiblit, si la catastrophe est trop prévue."
                                            }
                                        ]
                                    }
                                ]
                            },
