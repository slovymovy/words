                ],
                "senses": [
                    {
                        "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                        "entry_id": "2ea372e0-9eb9-3430-b018-69848c99adca",
                        "glosses": [
                            "geplante, zeitlich begrenzte Maßnahme (Aktion), die darauf abzielt, den Absatz von Waren zu fördern, häufig durch Sonderangebote, Rabatte oder andere Verkaufsanreize"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3876ec-4372-4a68-a879-acdc1858fda4",
                                "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                                "text": "„Diese Verkaufsaktion ist einmalig und auf den Jubiläumstag begrenzt.“"
                            },
                            {
                                "example_id": "348f1a4c-0269-43d0-81f8-4213b0c1ffa2",
                                "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                                "text": "„Als Mitglied erhalten Sie täglich Zugang zu neuen attraktiven Verkaufsaktionen, bei denen Sie sich zusätzlich bis zu 70 % Rabatt sichern können.“"
                            },
                            {
                                "example_id": "04cbdd53-5c8a-4742-84a5-b2cd91c5cd08",
                                "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                                "text": "„Zwei Verkaufsaktionen hatten bereits 2023 einen Umsatz von 750 Millionen und einen operativen Gewinn von 300 Millionen Euro gebracht.“"
                            },
                            {
                                "example_id": "0edda7d9-9870-4ede-8d5d-d1f079377b7b",
                                "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                                "text": "„Während dieser speziellen Verkaufsaktion können Prime-Kunden auf attraktive Rabatte, Top-Angebote und mehr hoffen, um ihre Handys zu einem erschwinglicheren Preis zu ergattern.“"
                            },
                            {
                                "example_id": "66cf116a-a88f-4be5-b856-8655ecce3217",
                                "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                                "text": "„Die erste Verkaufsaktion für ‚Yeezy‚-Schuhe hat dem Konzern einen Umsatz von 400 Millionen Euro und einen operativen Gewinn von 150 Millionen Euro eingebracht.“"
                            },
                            {
                                "example_id": "b2c610c0-7806-4856-965a-be7d662317f8",
                                "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                                "text": "„Eine zweite Verkaufsaktion der Schuhe läuft gerade an und auch die dürfte dem Konzern erneut einiges einbringen.“"
                            },
                            {
                                "example_id": "d94f51a8-9740-43ec-8726-e7b0dcec0ed4",
                                "sense_id": "aef1e755-2da7-3bcb-8873-8edd0a72f1ce",
                                "text": "„Die Verkaufsaktionen sind gültig für Vertragsabschlüsse mit Inverkehrsetzung vom 1. Januar 2018 bis 28. Februar 2018 oder bis auf Widerruf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
