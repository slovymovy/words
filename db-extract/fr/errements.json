        "fr-extract.jsonl": [
            {
                "entry_id": "738109f8-1a41-3967-96db-7df4f8d3551a",
                "word": "errements",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5415c2ec-ba2a-385e-ae07-460013f8f98d",
                        "entry_id": "738109f8-1a41-3967-96db-7df4f8d3551a",
                        "glosses": [
                            "Manière dont une affaire est conduite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "962d1d36-6a6e-492b-b94f-70aacb3ab463",
                                "sense_id": "5415c2ec-ba2a-385e-ae07-460013f8f98d",
                                "text": "Pour faire des Tragédies qui puissent intéresser le public en 1823, faut-il suivre les errements de Racine ou ceux de Shakspeare ? ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e103e3d4-6250-4d45-95cf-b9c446f75af0",
                        "source_entry_id": "738109f8-1a41-3967-96db-7df4f8d3551a",
                        "source_sense_id": "5415c2ec-ba2a-385e-ae07-460013f8f98d",
                        "target_lang_word": "Handlungsweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handlungsweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd6db6b-428f-3754-a42b-8e5bdea63cbc",
                                        "entry_id": "c4f2bc90-62da-3d6c-bc81-330ed261ea61",
                                        "glosses": [
                                            "Art und Weise, wie man etwas tut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24295882-6425-4a68-b575-0876cbd9df6f",
                                                "sense_id": "ffd6db6b-428f-3754-a42b-8e5bdea63cbc",
                                                "text": "Er hatte seine persönliche Handlungsweise, in der er die Aktion durchführte."
                                            },
                                            {
                                                "example_id": "27e89254-5031-40f6-96bb-231269ab03e0",
                                                "sense_id": "ffd6db6b-428f-3754-a42b-8e5bdea63cbc",
                                                "text": "„Nataschas Krankheit war immerhin so ernst, dass zu ihrem und ihrer Angehörigen Glück angesichts der Krankheit selbst ihre Ursache – Nataschas eigene Handlungsweise und ihr Bruch mit ihrem Bräutigam – durchaus zurücktrat.“"
                                            },
                                            {
                                                "example_id": "7f47bd3c-6767-4540-a555-2257e272b415",
                                                "sense_id": "ffd6db6b-428f-3754-a42b-8e5bdea63cbc",
                                                "text": "„Ich verlangte vom Wirt die Rechnung, die nicht sehr hoch war, bezahlte den Betrag und ließ sie dann allein; sie konnte sich vor Überraschung über meine Handlungsweise und meine Worte kaum fassen.“"
                                            },
                                            {
                                                "example_id": "a144c3c5-d017-4369-9b73-ca04e9e3f50b",
                                                "sense_id": "ffd6db6b-428f-3754-a42b-8e5bdea63cbc",
                                                "text": "„Sabine Emonds' Stimme hatte mich etwas getröstet, sie hatte ein bißchen gereizt geklungen, auch gehetzt, aber ich wußte, daß sie Maries Handlungsweise wirklich gemein fand und das Töpfchen Suppe bei ihr immer für mich auf dem Herd stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfacfac8-974f-48e1-8e92-d2d0af2d42c3",
                        "source_entry_id": "738109f8-1a41-3967-96db-7df4f8d3551a",
                        "source_sense_id": "5415c2ec-ba2a-385e-ae07-460013f8f98d",
                        "target_lang_word": "Auftreten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auftreten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3659b5e-609b-3771-ad70-2cb20030afd9",
                                        "entry_id": "5deb737e-61bc-3c0c-b6ea-c0319d511a31",
                                        "glosses": [
                                            "Verhalten oder Benehmen einer Person in Gesellschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6203ef94-1131-488a-9c56-14b6b742f07b",
                                                "sense_id": "c3659b5e-609b-3771-ad70-2cb20030afd9",
                                                "text": "Die ersten Tage im neuen Job sind entscheidend. Souveränes Auftreten und Authentizität sind wichtiger als fachlich vorzupreschen."
                                            },
                                            {
                                                "example_id": "8769b456-681b-45ce-9aa3-ac022318c1bd",
                                                "sense_id": "c3659b5e-609b-3771-ad70-2cb20030afd9",
                                                "text": "In den Fragen ging es unter anderem um den Kontakt mit den Fans, um Authentizität und Auftreten."
                                            },
                                            {
                                                "example_id": "761a43c5-c3b1-4b62-a184-f607e1d10130",
                                                "sense_id": "c3659b5e-609b-3771-ad70-2cb20030afd9",
                                                "text": "„Natürlich wird Karnej trotz meines Kontraktes und meines bestimmten Auftretens doch erst um sechs Uhr kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f919d3f-42f2-3619-a1e3-79c13bb0c1a7",
                                        "entry_id": "5deb737e-61bc-3c0c-b6ea-c0319d511a31",
                                        "glosses": [
                                            "Vorkommen eines Umstandes oder eines Ereignisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1379b7-1725-4d61-b4bb-440687d8e31f",
                                                "sense_id": "0f919d3f-42f2-3619-a1e3-79c13bb0c1a7",
                                                "text": "Weitere Versuche an insgesamt 21 Patienten ergaben, daß durch laufende gleichmäßige Lidocain-Gaben das Auftreten von Anfällen überhaupt stark reduziert, oft sogar völlig unterdrückt werden konnte."
                                            },
                                            {
                                                "example_id": "ad0d5168-1177-41bb-bad7-c90f6b5ebda1",
                                                "sense_id": "0f919d3f-42f2-3619-a1e3-79c13bb0c1a7",
                                                "text": "»Sonnenlichtexposition oder das Rauchen beschleunigen die Hautalterung und führen zu typischen Alterungssymptomen wie Faltenbildung, Pigmentflecken, gegerbter Haut oder dem Auftreten von roten Äderchen«, erklärt Vierkötter."
                                            },
                                            {
                                                "example_id": "b1102c19-24ac-4022-b3c0-298267aa359e",
                                                "sense_id": "0f919d3f-42f2-3619-a1e3-79c13bb0c1a7",
                                                "text": "„Risiken beim Einsatz gentechnisch veränderter Pflanzen sind neben einer Bedrohung der Artenvielfalt auch Nebeneffekte wie das Auftreten neuer unerwünschter Eigenschaften bei den Pflanzen, aber auch allergische Reaktionen bei den Verbrauchern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "18605eaa-7b9c-341b-b00f-3e7ca7c606e5",
                                        "entry_id": "5deb737e-61bc-3c0c-b6ea-c0319d511a31",
                                        "glosses": [
                                            "Präsentation eines reproduzierenden Künstlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a79484-842a-4b26-9341-68be83551e23",
                                                "sense_id": "18605eaa-7b9c-341b-b00f-3e7ca7c606e5",
                                                "text": "Rousseau war gegen das Theater und erst recht gegen jedes öffentliche Auftreten von Frauen, schon gar auf der Bühne."
                                            },
                                            {
                                                "example_id": "bc6024d5-4d7d-4903-982f-a0f358681346",
                                                "sense_id": "18605eaa-7b9c-341b-b00f-3e7ca7c606e5",
                                                "text": "Wenn die Filmfuzzis Eure Bewerbung interessant finden, laden Sie Euch zu einem Casting ein. Da gucken eine Menge Leute wie Ihr Euch bewegen könnt, ob Ihr kleine Textzeilen schnell auswendig lernt und ob Ihr vom Charakter und Auftreten zu der Rolle passt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9675061b-fbb5-4505-b59e-237dbc4655ec",
                        "source_entry_id": "738109f8-1a41-3967-96db-7df4f8d3551a",
                        "source_sense_id": "5415c2ec-ba2a-385e-ae07-460013f8f98d",
                        "target_lang_word": "Vorgehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46e514cc-fcf6-3793-a796-22286e1e90cd",
                                        "entry_id": "236039c6-a28d-3319-b15a-55b472fdc3d3",
                                        "glosses": [
                                            "eine definierte Art und Weise zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6949b30-df80-4558-887b-fbe9bb488f54",
                                                "sense_id": "46e514cc-fcf6-3793-a796-22286e1e90cd",
                                                "text": "Die eigentliche Idee war gut, aber ein solches Vorgehen sorgte für Kritik."
                                            },
                                            {
                                                "example_id": "96912b0d-6fd1-49a1-922e-5e3142cd8dbb",
                                                "sense_id": "46e514cc-fcf6-3793-a796-22286e1e90cd",
                                                "text": "„Eine Vorentscheidung über das weitere Vorgehen wird auch von der Sitzung der Landes- und Bezirksvorsitzenden am Montagabend in Berlin erwartet.“"
                                            },
                                            {
                                                "example_id": "0cd1e1f2-81b7-4944-a186-4c802dd8499c",
                                                "sense_id": "46e514cc-fcf6-3793-a796-22286e1e90cd",
                                                "text": "„Vermutlich verließ meine Großmutter geschäftig das Haus, um mit Juttas Vater, dem Tierarzt von Götzlack, das weitere Vorgehen zu besprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
