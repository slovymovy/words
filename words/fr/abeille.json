    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "041a1d0f-4b30-354c-8fae-31173f8565b2",
                    "sense_definition": "Insecte social volant qui vit en colonie dans une ruche et produit du miel ainsi que de la cire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "insecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>abeille</w> butine les fleurs du jardin pour fabriquer du miel."
                        },
                        {
                            "text": "Il a reçu une piqûre d'<w>abeille</w> sur le bras pendant la promenade."
                        }
                    ],
                    "synonyms": [
                        "mouche à miel",
                        "avette"
                    ],
                    "common_phrases": [
                        "piqûre d'abeille",
                        "reine des abeilles"
                    ]
                },
                {
                    "sense_id": "42edeffa-597b-36e4-ac61-d8fa6ce83403",
                    "sense_definition": "Insecte hyménoptère de la super-famille des apoïdes, solitaire ou social, jouant un rôle majeur dans la pollinisation des plantes à fleurs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses espèces d'<w>abeilles</w> solitaires creusent leur nid directement dans le sol."
                        },
                        {
                            "text": "La disparition des <w>abeilles</w> menace l'équilibre des écosystèmes et la reproduction des plantes."
                        }
                    ],
                    "common_phrases": [
                        "abeilles solitaires",
                        "abeille sauvage"
                    ]
                },
                {
                    "sense_id": "290f7b97-5da9-3d59-af9a-a38d87dc7050",
                    "sense_definition": "Emblème impérial napoléonien, symbole d'immortalité et de travail acharné ornant les manteaux et décors officiels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manteaux impériaux de Napoléon étaient brodés de nombreuses <w>abeilles</w> dorées."
                        },
                        {
                            "text": "L'<w>abeille</w> est devenue le symbole officiel de la dynastie napoléonienne."
                        }
                    ]
                },
                {
                    "sense_id": "89ec7c5a-0026-3c17-b559-98bf5b868381",
                    "sense_definition": "Balle tirée par une arme à feu, dans l'argot des combattants de la Première Guerre mondiale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats terrés dans la tranchée écoutaient siffler les <w>abeilles</w> au-dessus de leurs têtes."
                        },
                        {
                            "text": "Une <w>abeille</w> ennemie a frôlé son casque sans parvenir à le blesser."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot des tranchées"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Première Guerre mondiale"
                        }
                    ]
                }
            ]
        },
