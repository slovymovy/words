                                    {
                                        "sense_id": "8321a532-b587-3e6e-8702-62875e8c1219",
                                        "entry_id": "1aab8ed4-8296-340d-b152-1c01769d5535",
                                        "glosses": [
                                            "The physical blocking or surrounding of a place, especially a port, in order to prevent commerce and traffic in or out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d38c47-215f-4fb0-b21a-189855256b64",
                                                "sense_id": "8321a532-b587-3e6e-8702-62875e8c1219",
                                                "text": "A six-day blockade from 28 May to 2 June saw NR [National Rail] straighten the track through the station, facilitating a linespeed increase from 60mph to 85mph over a 4km stretch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ddbaf77-1bcd-3b64-b006-73041446345e",
                                        "entry_id": "1aab8ed4-8296-340d-b152-1c01769d5535",
                                        "glosses": [
                                            "Any form of formal isolation or inhibition of something, especially with the force of law or arms."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33dadc51-8565-4769-8ccc-28493eeaa4e8",
                                                "sense_id": "2ddbaf77-1bcd-3b64-b006-73041446345e",
                                                "text": "In the mean time, Francesca, separated from Madame de Mercœur, was hidden by a group around the Queen of Sweden. With the wall on one side, and a human blockade on the other, she was left at full leisure to meditate on a vow made at the first announcement of the lottery, namely, that whatever might fall to her lot she would offer in a neighbouring chapel to the Virgin, at whose shrine she would kneel one hour for Guido's safe return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed23a096-8900-393f-bf20-b37b68316a9d",
                                        "entry_id": "1aab8ed4-8296-340d-b152-1c01769d5535",
                                        "glosses": [
                                            "The ships or other forces used to effect a naval blockade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06765996-0d20-3435-a5a6-2721a1521705",
                                        "entry_id": "1aab8ed4-8296-340d-b152-1c01769d5535",
                                        "glosses": [
                                            "Inhibition of the activity (function) of chemical messengers or their receptors, such as (often) receptor antagonism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9113239f-c112-4e0a-9121-10fdb07e9e5a",
