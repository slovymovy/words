                                        "sense_id": "ca8dbd6d-c475-3351-bcc4-f638c968403f",
                                        "entry_id": "82d66d55-4c10-382c-9227-f72a1108c56b",
                                        "glosses": [
                                            "D’une manière fine, adroite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
