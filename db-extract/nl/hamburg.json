                            {
                                "target_word": "Hambourg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c08bfe8-3629-3439-b11e-8f7b55d2bfda",
                                        "entry_id": "412b591f-6aff-3adc-8e26-c61153b74108",
                                        "glosses": [
                                            "Ville d’Allemagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9524955a-8c85-4f60-a721-735aaffa9a66",
                                                "sense_id": "0c08bfe8-3629-3439-b11e-8f7b55d2bfda",
                                                "text": "Oui certes, un fils de Johann-Christoph, le glorieux oncle de Jean-Sébastien, ira fabriquer des orgues en Suède ; un autre, d’Erfurt, émigrera à Hambourg, puis à Rotterdam et finalement en Angleterre."
                                            },
                                            {
                                                "example_id": "b43f7d37-999b-4931-92f9-5938090a62de",
                                                "sense_id": "0c08bfe8-3629-3439-b11e-8f7b55d2bfda",
                                                "text": "Ils boivent à la santé\n Des putains d’Amsterdam\n De Hambourg ou d’ailleurs."
                                            },
                                            {
                                                "example_id": "1e39d074-4cfe-40ec-a531-b465fef742d8",
                                                "sense_id": "0c08bfe8-3629-3439-b11e-8f7b55d2bfda",
                                                "text": "Remarquez que je suis attendu par des sociétés littéraires et scientifiques d’Emden, de Hambourg, et de Brême…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02aea49-6886-36f4-97ae-252835d12e3a",
                                        "entry_id": "412b591f-6aff-3adc-8e26-c61153b74108",
                                        "glosses": [
                                            "Un des seize Länder qui constituent la République fédérale d’Allemagne."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
