                        "sense_id": "e7c08c64-ff6c-3776-b029-9ff61cfaad01",
                        "entry_id": "9968e8bf-0d05-34cb-809f-fa67741756d1",
                        "glosses": [
                            "Relatif à George Bernard Shaw."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a747f2e6-b318-4cb8-98fd-e21f5a043d7a",
                                "sense_id": "e7c08c64-ff6c-3776-b029-9ff61cfaad01",
                                "text": "Le destin français des œuvres shaviennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "63ef3c90-d8a3-390c-856c-56ccc5446855",
                        "entry_id": "9968e8bf-0d05-34cb-809f-fa67741756d1",
                        "glosses": [
                            "Qualifie un alphabet phonétique de l’anglais financé à titre posthume par l’écrivain George Bernard Shaw."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb07ebb3-9a2d-4939-8218-dbbc1d28e783",
                                "sense_id": "63ef3c90-d8a3-390c-856c-56ccc5446855",
                                "text": "L’alphabet shavien ou l’alphabet de Shaw est une écriture construite, un alphabet créé en 1950 pour une écriture simple et phonétique de la langue anglaise sans les difficultés de l’orthographe conventionnelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f24b399c-b8cb-4f0f-bfd7-3bdc38b37731",
                        "source_entry_id": "9968e8bf-0d05-34cb-809f-fa67741756d1",
                        "target_lang_word": "Shavian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shavian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed2f839-badd-3e49-b1d9-01d4552b4d30",
                                        "entry_id": "d9b9bab4-1684-3919-8bb9-d5971d1b925f",
                                        "glosses": [
                                            "Of or relating to George Bernard Shaw or his works."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c65cd27-9c69-4765-8c43-6282cb6c5f07",
                                                "sense_id": "9ed2f839-badd-3e49-b1d9-01d4552b4d30",
                                                "text": "Possibly more than any other Shavian character, Undershaft engenders critical disagreement and discussion, even among the other characters in the play who call him “wicked” and “immoral” and refer to him in Devilish terms such as “Mephistoles” and “The Prince of Darkness”."
                                            },
                                            {
                                                "example_id": "0ce9b6c9-b801-4775-b8cb-fae0909f9bb4",
                                                "sense_id": "9ed2f839-badd-3e49-b1d9-01d4552b4d30",
                                                "text": "Speaking as someone who supports the Shavian argument that monarchy is a bulwark against dictatorship, I found it a dignified occasion and a reminder that, as a nation, we seem to be infinitely better at staging public spectacles than at governing the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3d1ca3-294c-3d1d-a94c-1148b8c1e286",
                                        "entry_id": "d9b9bab4-1684-3919-8bb9-d5971d1b925f",
                                        "glosses": [
                                            "Of or relating to the Shavian alphabet."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1462b36f-271f-428b-9ece-038789d328fb",
                                                "sense_id": "9d3d1ca3-294c-3d1d-a94c-1148b8c1e286",
                                                "text": "As late as the 1960s, Shaw's own Androcles and the Lion was published in his revised alphabet—but the fact that few people have even heard of the Shavian spelling reform shows how futile the effort has been."
                                            }
                                        ]
                                    }
                                ]
                            },
