                ],
                "senses": [
                    {
                        "sense_id": "7642ef41-37a0-3350-afb6-333afeb31bd6",
                        "entry_id": "45c656f3-cf7d-317a-9e51-c6bc8ab1473d",
                        "glosses": [
                            "Qui suit la doctrine d’Aristote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b6355d-5ada-4b6f-8a11-3cb2fb76af8d",
                                "sense_id": "7642ef41-37a0-3350-afb6-333afeb31bd6",
                                "text": "Mais enfin la faute a été faite, l'erreur a été commise. Par quelle cause ? parce que le système de Copernic, soutenu par Galilée avec beaucoup de chaleur, ayant choqué les idées péripatéticiennes alors toutes puissantes, il s'éleva contre l'illustre professeur une tempête terrible."
                            },
                            {
                                "example_id": "8458c87b-36b9-40da-9160-6c0619d5c1e5",
                                "sense_id": "7642ef41-37a0-3350-afb6-333afeb31bd6",
                                "text": "La seconde circonstance fut l’aristotélisation du monde méditerranéen, […] au cours des années 60 après J.C. On se mit à enseigner la philosophie péripatéticienne dans les grandes villes de l’Empire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2be0fe80-6f0b-4018-b9d0-daa5eabbe366",
                        "source_entry_id": "45c656f3-cf7d-317a-9e51-c6bc8ab1473d",
                        "source_sense_id": "7642ef41-37a0-3350-afb6-333afeb31bd6",
                        "target_lang_word": "peripatetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peripatetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "899d6718-ba67-3853-ba48-373126b16d99",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Tending to walk about."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23e54833-1042-32a7-af82-290d57261946",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Constantly travelling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3cf9a2-934d-4d25-aa1d-4b323b913e39",
                                                "sense_id": "23e54833-1042-32a7-af82-290d57261946",
                                                "text": "After peripatetic upbringing that took her from America to Portugal, Switzerland, Belgium and England, [Mary-Kay] Wilmers read French and Russian at Oxford."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Alternative letter-case form of Peripatetic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57cfe68d-d09a-442a-8f6a-ca151da5a18e",
                                                "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                                "text": "Demetreius of Phalerum, a peripatetic philosopher of the fourth century B.C., wrote an amatory treatise entitled Eroticus - no longer, however, extant."
                                            },
                                            {
                                                "example_id": "4fa707ef-e595-4c6c-9ac1-a577de52d464",
                                                "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                                "text": "The true peripatetic school."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peripatetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "313c0bf5-f430-376f-8512-0dd79d2a46cb",
