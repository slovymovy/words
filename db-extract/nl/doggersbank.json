                        "examples": [
                            {
                                "example_id": "36351664-660c-4a71-9fe2-8b8a6a16808a",
                                "sense_id": "5c4f2568-b0dd-3e94-9856-13484eeb4415",
                                "text": "Het Wereld Natuur Fonds (WNF) heeft samen met een aantal andere natuurorganisaties een klacht ingediend bij de Europese Commissie omdat de natuur in de Doggersbank niet goed beschermd wordt. Zegenvisserij, een techniek waarbij met een sleepnet over de bodem vissen worden gevangen, verstoort en beschadigt de Doggersbank. De Doggersbank is een ondiep deel in de Noordzee met een lengte van bijna 300 kilometer."
                            }
                        ]
