                "senses": [
                    {
                        "sense_id": "cda0b8b7-793f-3311-bc1d-6d1c38191e1f",
                        "entry_id": "81ed789a-552b-3940-92cf-5fcb8bdd1f8b",
                        "glosses": [
                            "mit Thunfisch belegtes Sandwich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086190bb-cf0e-4938-b89e-daa2932cfe68",
                                "sense_id": "cda0b8b7-793f-3311-bc1d-6d1c38191e1f",
                                "text": "„Im letzten Sommer hatte er es sich einmal nicht nehmen lassen, mit Rick James zum Mittagessen am Lexington Market zu gehen, wo die beiden sich an einem Straßenverkauf Thunfischsandwichs kauften.“"
                            },
                            {
                                "example_id": "1029722e-052e-4746-aeb5-b57d269c775e",
                                "sense_id": "cda0b8b7-793f-3311-bc1d-6d1c38191e1f",
                                "text": "„‹Ich war weg›, teilt er mir nunmehr mit, während ich in meinem Arbeitszimmer ein Thunfischsandwich verzehre und ein neuerliches Schneegestöber auf der Straße beobachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
