    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f0d8e8c-89cc-3f12-aa22-54f2662a181d",
                    "sense_definition": "Au Moyen Âge, jeune noble qui portait les armes d'un chevalier et l'assistait au combat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chevalerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme servait comme <w>écuyer</w> auprès d'un chevalier réputé pour sa bravoure."
                        },
                        {
                            "text": "Le fidèle <w>écuyer</w> préparait les armes et le cheval avant le début de la bataille."
                        }
                    ]
                },
                {
                    "sense_id": "95a07780-acb0-3f6f-875d-9d0710822ece",
                    "sense_definition": "Maître qui dresse les chevaux de manège et enseigne l'art de l'équitation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>écuyer</w> réputé entraîne quotidiennement les montures pour les concours de dressage."
                        },
                        {
                            "text": "Les cavaliers ont suivi avec attention les précieux conseils de l'<w>écuyer</w> en chef."
                        }
                    ],
                    "common_phrases": [
                        "écuyer en chef",
                        "grand écuyer"
                    ]
                },
                {
                    "sense_id": "f9319bde-4f59-3d9e-9869-7174e10843e2",
                    "sense_definition": "Artiste équestre réalisant des exercices acrobatiques ou de dressage lors d'un spectacle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le public a applaudi avec enthousiasme l'<w>écuyer</w> de cirque après son saut périlleux."
                        },
                        {
                            "text": "Chaque soir sous le chapiteau, l'<w>écuyer</w> réalise des figures spectaculaires sur sa monture."
                        }
                    ],
                    "common_phrases": [
                        "écuyer de cirque"
                    ]
                },
                {
                    "sense_id": "60f2df0c-6175-3be1-8913-66d3e7ac0b71",
                    "sense_definition": "Officier qui dirigeait les écuries d'un prince, d'un souverain ou d'une maison noble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "charge_historique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>écuyer</w> du prince était personnellement responsable de la garde et des soins de la cavalerie."
                        },
                        {
                            "text": "Le roi a accordé cette terre prestigieuse à son premier <w>écuyer</w> en récompense de ses services."
                        }
                    ],
                    "common_phrases": [
                        "premier écuyer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "charge sous l'Ancien Régime"
                        }
                    ]
                },
                {
                    "sense_id": "8568670d-5cf3-3fa5-a911-bf0a945c48ef",
