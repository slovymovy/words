                    {
                        "sense_id": "7541d930-0f07-3649-a388-167b10a6b6c1",
                        "entry_id": "ad444150-0ba5-31c6-a341-444addae5c20",
                        "glosses": [
                            "program do wyświetlania treści"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387655dd-c05f-4c8f-94b7-4be795ec6962",
                                "sense_id": "7541d930-0f07-3649-a388-167b10a6b6c1",
                                "text": "Strona otworzy się w nowej karcie tego samego okna przeglądarki."
                            },
                            {
                                "example_id": "486a08bd-dd37-4630-b2d1-29b4f1a394f9",
                                "sense_id": "7541d930-0f07-3649-a388-167b10a6b6c1",
                                "text": "Pliki te mają rozszerzenia *.swf […] i mogą być wyświetlane przez przeglądarki internetowe."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
