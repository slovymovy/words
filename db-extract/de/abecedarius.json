                        "sense_id": "88b84bfb-fcc0-32d1-a2c0-3ab48e776c0a",
                        "entry_id": "f4a04dab-d8d7-35d4-a4ae-5ab010610e2a",
                        "glosses": [
                            "ein Gedicht, bei dem der erste Buchstabe jedes Verses bzw. jeder Strophe gemäß der Reihenfolge des Alphabetes gewählt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ab9512-afd7-4802-904f-8dbf63a19f0b",
                                "sense_id": "88b84bfb-fcc0-32d1-a2c0-3ab48e776c0a",
                                "text": "„Alte, Bärtige Chinesen, Die Erstaunlich Fit Gewesen, Hörten Innig Jeden Klang, Liefen Munter Nächtelang Ohne Pause Querfeldein, Richtung Süden, Tugendrein, Um Vor Wonnemondvergehen Xerxes' Yogis Zuzusehen.“ ist ein Beispiel für einen Abecedarius. (aus Wikipedia nach Günter Nehm)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "907ff290-c874-36f2-b023-83d9be1d228b",
                        "entry_id": "f4a04dab-d8d7-35d4-a4ae-5ab010610e2a",
                        "glosses": [
                            "Schüler des ersten Schuljahres"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
