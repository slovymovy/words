                                "target_senses": [
                                    {
                                        "sense_id": "b06934cf-2981-307e-b946-01d2001b3e04",
                                        "entry_id": "152ecf48-670c-3980-a7ad-bf632e3dda94",
                                        "glosses": [
                                            "A large planet composed mostly of gaseous hydrogen and helium, along with methane and ammonia; possibly with a solid core."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7d8a1e-d85f-4044-b9ef-ee8b430280dd",
                                                "sense_id": "b06934cf-2981-307e-b946-01d2001b3e04",
                                                "text": "A quick glance over the boards revealed that there was a magnetic field of some strength near by, one that didn't belong to the invisible gas giant revolving half a million miles away."
                                            },
                                            {
                                                "example_id": "1b71530b-68e6-4a13-936b-da8384ca987a",
                                                "sense_id": "b06934cf-2981-307e-b946-01d2001b3e04",
                                                "text": "Altanorch is a small but typical hydrogen-helium gas giant with no outstanding features. Its combination of strong magnetic field and relatively shallow gravity well make it a popular \"stopover\" world for discharging FTL drive cores."
                                            },
                                            {
                                                "example_id": "67576f92-bfcf-4a33-9413-877b3f2972ea",
                                                "sense_id": "b06934cf-2981-307e-b946-01d2001b3e04",
                                                "text": "In the past two years, NASA’s Kepler Space Telescope has located nearly 3,000 exoplanet candidates ranging from sub-Earth-sized minions to gas giants that dwarf our own Jupiter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
