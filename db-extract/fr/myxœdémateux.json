                        "entry_id": "0efcc9e0-3516-3d8d-8a6d-547033a79cf0",
                        "glosses": [
                            "Qui a rapport au myxœdème, qui a pour cause le myxœdème."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d8054c-edea-437f-854a-b9083a72e65d",
                                "sense_id": "fb2f90d5-2500-3b69-a3d4-badf05c57ce2",
                                "text": "Un goitre myxœdémateux."
                            },
                            {
                                "example_id": "137ecb82-02cb-4ad0-a2a5-66df93e84dc8",
                                "sense_id": "fb2f90d5-2500-3b69-a3d4-badf05c57ce2",
                                "text": "Le coma myxœdémateux correspond à l’évolution ultime d’une hypothyroïdie et se caractérise par un déficit profond en hormones thyroïdiennes responsable d’un effondrement du métabolisme."
                            }
                        ]
                    }
                ],
