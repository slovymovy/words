                                        "glosses": [
                                            "Covered in or overgrown with moss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa853555-7405-442f-8ec2-dc29ca4e55e2",
                                                "sense_id": "c3981288-bc67-346d-bcdc-97eb038f74c6",
                                                "text": "The moſſy pales that ſkirt the orchard-green, / Here hid by ſhrub-vvood, there by glimpſes ſeen; […]"
                                            },
                                            {
                                                "example_id": "f31146ea-f094-4ca7-8be0-74c0f3f1dc0a",
                                                "sense_id": "c3981288-bc67-346d-bcdc-97eb038f74c6",
                                                "text": "A Violet by a mossy stone / Half-hidden from the Eye! / —Fair, as a star when only one / Is shining in the sky!"
                                            },
                                            {
                                                "example_id": "6e2cf604-b91a-4cb0-981d-6a529fab32a4",
                                                "sense_id": "c3981288-bc67-346d-bcdc-97eb038f74c6",
                                                "text": "Two particularly attractive cottages, roofed with mossy and lichened slates, stand at the churchyard's eastern gate, looking up a long avenue of yew trees."
                                            }
                                        ]
                                    }
                                ]
