                                        "examples": [
                                            {
                                                "example_id": "5c4693cf-41df-4642-8462-c06ede0b1b87",
                                                "sense_id": "9e9d4631-c42b-3e28-8875-042f29412bbe",
                                                "text": "He paused for emphasis before saying who had won."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb9b01f4-15f9-37c5-bfc4-cdb34af586f3",
                                        "entry_id": "e8973990-186b-38b4-ad04-39b0a5714b52",
                                        "glosses": [
                                            "Special attention or prominence given to something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cec3312-02be-4eed-8e6b-18b76ccd6019",
                                                "sense_id": "eb9b01f4-15f9-37c5-bfc4-cdb34af586f3",
                                                "text": "Anglia TV's emphasis is on Norwich and district."
                                            },
                                            {
                                                "example_id": "f61d9918-2b57-4344-ab3e-cea6ce6c2e92",
                                                "sense_id": "eb9b01f4-15f9-37c5-bfc4-cdb34af586f3",
                                                "text": "Put emphasis on the advantages rather than the drawbacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af4992c9-809d-33fa-82bb-4ce9f7889f68",
                                        "entry_id": "e8973990-186b-38b4-ad04-39b0a5714b52",
                                        "glosses": [
                                            "Prominence given to a syllable or words, by raising the voice or printing in italic or underlined type."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c19877-e4c2-4ff1-aa1c-2c34e9214bbc",
                                                "sense_id": "af4992c9-809d-33fa-82bb-4ce9f7889f68",
                                                "text": "He used a yellow highlighter to indicate where to give emphasis in his speech."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a565feb0-350e-3c19-a79c-051f0686f587",
                                        "entry_id": "e8973990-186b-38b4-ad04-39b0a5714b52",
                                        "glosses": [
                                            "The phonetic or phonological feature that distinguishes emphatic consonants from other consonants."
                                        ],
