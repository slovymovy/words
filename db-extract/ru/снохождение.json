                "senses": [
                    {
                        "sense_id": "a99e3b80-c526-35cd-9203-8600c1fb02ae",
                        "entry_id": "ff4b370d-3d20-3f78-af4b-05ab0515db32",
                        "glosses": [
                            "то же, что сомнамбулизм"
