                {
                    "sense_id": "79452993-a658-3a1b-ae3b-048fc234adf4",
                    "sense_definition": "Een natuurlijk verhoogd stuk land in het landschap, zoals een heuvel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanaf de <w>hoogte</w> hadden we een prachtig uitzicht over de vallei.",
                            "target_lang_translations": {
                                "en": "From the <w>height</w> we had a beautiful view over the valley.",
                                "ru": "С <w>возвышенности</w> открывался прекрасный вид на долину.",
                                "pl": "Ze <w>wzniesienia</w> mieliśmy piękny widok na dolinę.",
                                "de": "Von der <w>Anhöhe</w> aus hatten wir eine wunderschöne Aussicht über das Tal.",
                                "fr": "Depuis la <w>hauteur</w>, nous avions une vue magnifique sur la vallée.",
                                "it": "Dall'<w>altura</w> avevamo una vista meravigliosa sulla valle.",
                                "cs": "Z té <w>výšiny</w> jsme měli krásný výhled na údolí.",
                                "tr": "<w>Tepeden</w> vadinin harika bir manzarasına sahiptik.",
                                "es": "Desde la <w>altura</w> teníamos una vista hermosa del valle."
                            }
                        },
                        {
                            "text": "Het oude kasteel stond op een strategische <w>hoogte</w>.",
                            "target_lang_translations": {
                                "en": "The old castle stood on a strategic <w>height</w>.",
                                "ru": "Старый замок стоял на стратегической <w>высоте</w>.",
                                "pl": "Stary zamek stał na strategicznym <w>wzgórzu</w>.",
                                "de": "Die alte Burg stand auf einer strategischen <w>Anhöhe</w>.",
                                "fr": "Le vieux château se dressait sur une <w>hauteur</w> stratégique.",
                                "it": "L'antico castello sorgeva su un'altura <w>strategica</w>.",
                                "cs": "Starý hrad stál na strategické <w>výšině</w>.",
                                "tr": "Eski kale stratejik bir <w>yükseltide</w> bulunuyordu.",
                                "es": "El antiguo castillo estaba situado en una <w>colina</w> estratégica."
                            }
                        }
                    ],
