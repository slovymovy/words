                                    },
                                    {
                                        "sense_id": "20c7b3ce-db93-3e66-a332-faa79d2282e5",
                                        "entry_id": "7fec387b-3484-33c5-b410-e543053b1122",
                                        "glosses": [
                                            "A board serving as a step on a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b860dc-5b56-4077-9444-23bc5bf065a1",
                                                "sense_id": "20c7b3ce-db93-3e66-a332-faa79d2282e5",
                                                "text": "Continuous footboards ran along each side of the narrow body."
                                            },
                                            {
                                                "example_id": "7803344a-2bdc-4bba-a7fb-250e1670a3cd",
                                                "sense_id": "20c7b3ce-db93-3e66-a332-faa79d2282e5",
                                                "text": "Several parties of hop-pickers joined the train at the intermediate stations, and the guard performed the acrobatic feat of walking along the footboards of the coaches to examine tickets, while the train was in motion."
                                            }
                                        ]
                                    }
                                ]
