                        "entry_id": "d213335d-7eb0-3051-a2ea-f54b5e7fda03",
                        "glosses": [
                            "Ereignis, das als übernatürlich betrachtet wird, das man sich nicht erklären kann"
                        ],
                        "tags": [
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "0700f47c-4044-4d79-9a6b-9bb399ad15d8",
                                "sense_id": "c0ea2a60-1195-3329-a9c1-dcfaeffbbb49",
                                "text": "Bei deiner Einstellung zum Lernen kannst du nur noch auf ein Mirakel hoffen."
                            },
                            {
                                "example_id": "4fca4b78-f67b-4bd3-8f8e-47ef43ce857a",
                                "sense_id": "c0ea2a60-1195-3329-a9c1-dcfaeffbbb49",
                                "text": "Die spontane Heilung von der Schuppenflechte kam einem Mirakel gleich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d75901c7-45bf-48c0-906c-ac679d5ee872",
                        "source_entry_id": "d213335d-7eb0-3051-a2ea-f54b5e7fda03",
                        "source_sense_id": "c0ea2a60-1195-3329-a9c1-dcfaeffbbb49",
                        "source_sense_description": "veraltend, gehoben: Ereignis, das als übernatürlich betrachtet wird, das man sich nicht erklären kann",
                        "target_lang_word": "miracolo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miracolo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "0499ebb2-f560-370b-979b-4b440d903859",
                                        "entry_id": "f023237a-506c-3e81-9524-1abbab451c71",
                                        "glosses": [
                                            "avvenimento soprannaturale e provvidenziale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aee2cf8-62b7-4698-88b7-94d9b446f2ee",
                                                "sense_id": "0499ebb2-f560-370b-979b-4b440d903859",
                                                "text": "qualche volta alcuni miracoli restano segreti"
                                            },
                                            {
                                                "example_id": "def49f0f-af3f-4ae0-875c-8688e02e7768",
                                                "sense_id": "0499ebb2-f560-370b-979b-4b440d903859",
                                                "text": "uno dei fini della preghiera è proprio la ricerca dei miracoli"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3776bb38-f3bb-3006-bbeb-959849dd287d",
                                        "entry_id": "f023237a-506c-3e81-9524-1abbab451c71",
                                        "glosses": [
                                            "oltre e/o entro la natura: evento o cosa che accadono raramente e che non avvengono secondo le normali leggi scientifiche o del creato"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b6307a-fa40-4525-bac9-dd5b511d1b49",
                                                "sense_id": "3776bb38-f3bb-3006-bbeb-959849dd287d",
                                                "text": "Pensò tra sé e sé: \"Questo è proprio un miracolo\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49aa84a4-5584-34b5-b63c-076b77dd0d32",
                                        "entry_id": "f023237a-506c-3e81-9524-1abbab451c71",
                                        "glosses": [
                                            "esclamazione con entusiasmo quando comunque accade qualcosa di sorprendente e meraviglioso"
                                        ],
