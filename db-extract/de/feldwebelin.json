                        "examples": [
                            {
                                "example_id": "8ba47cc5-4239-4112-a9e4-6029d6dbaf48",
                                "sense_id": "e3a3c246-075d-3bb1-b94e-7ac4bf734cfc",
                                "text": "„Die etwas ältere Feldwebelin, die sie briefte, war spindeldürr, und ihre Stimme hatte etwas Dröhnendes.“"
                            },
                            {
                                "example_id": "51196070-ece0-4413-8f6f-e2ab602ce48e",
                                "sense_id": "e3a3c246-075d-3bb1-b94e-7ac4bf734cfc",
                                "text": "„Morgens hatte mich eine Feldwebelin von der Staatssicherheit abgeholt und gesagt: ‹Na, Kleiner, dann hole dir mal deine zwei Jahre ab.›“"
                            }
                        ],
