                "senses": [
                    {
                        "sense_id": "a2412d3f-5fd6-3cdb-a7bd-103281205505",
                        "entry_id": "1c2ba9ae-0af8-347f-8ca0-7c8c0a4f8158",
                        "glosses": [
                            "aus gemahlenen Tierknochen hergestelltes Pulver, das als Dünger und Tierfutter verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad4fd4c-a3b0-4b41-a470-cf42ff1785f5",
                                "sense_id": "a2412d3f-5fd6-3cdb-a7bd-103281205505",
                                "text": "„Haarbüschel kommen zwischen den Erdklumpen zum Vorschein. Haare und Scheiße, Knochenmehl und Blutmehl.“"
                            },
                            {
                                "example_id": "fb19d5dc-dffb-4f49-b413-cbf812e7f8eb",
                                "sense_id": "a2412d3f-5fd6-3cdb-a7bd-103281205505",
                                "text": "„Noch das allerfeinste Knochenmehl enthält Hinweise, und Zähne bewahren ihre ursprüngliche Form unter extremsten Bedingungen, auch im Feuer.“"
                            },
                            {
                                "example_id": "2c38d810-1709-45ad-b93a-5a05c4d521f9",
                                "sense_id": "a2412d3f-5fd6-3cdb-a7bd-103281205505",
                                "text": "„Sahen, wie man dich in die Gehirnchirurgie brachte, tief im Keller, unter der Straße. Wo Sägen in trepanierte Schädel sirren und feuchtes Knochenmehl durch einen Luftschacht in die Gasse spritzt.“"
                            },
                            {
                                "example_id": "b7bbe1fa-ed72-459d-8f53-e7801695de2f",
                                "sense_id": "a2412d3f-5fd6-3cdb-a7bd-103281205505",
                                "text": "„Denn die, die er nicht rechtzeitig erwischte, wanderten in die rotierende Mahlanlage und wurden zu Knochenmehl, Dünger und Tierfutter verarbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
