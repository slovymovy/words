        "fr-extract.jsonl": [
            {
                "entry_id": "a8cd4114-a12b-3543-9a98-2e6fbf014bef",
                "word": "clocheton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ef0b0e6-b642-410e-bf0e-f0d50c2e39e5",
                        "entry_id": "a8cd4114-a12b-3543-9a98-2e6fbf014bef",
                        "tags": [
                            "plural"
                        ],
                        "form": "clochetons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                        "entry_id": "a8cd4114-a12b-3543-9a98-2e6fbf014bef",
                        "glosses": [
                            "Petit bâtiment en forme de clocher, de tourelle, dont on orne les angles ou le sommet d’une construction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44507a77-db11-4f18-a7a5-dab20902a36c",
                                "sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                                "text": "Il voit les tarasques de pierre vomir l’eau des ardoises dans l’abîme confus des galeries, des fenêtres, des pendentifs, des clochetons, des tourelles, des toits et des charpentes, …."
                            },
                            {
                                "example_id": "e9696ac8-9645-4d34-970b-9fb35d6f9121",
                                "sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                                "text": "Qu’avez-vous donc ? demanda Coconnas à La Mole, qui, arrêté à la vue du vieux château, regardait avec un saint respect ces ponts-levis, ces fenêtres étroites et ces clochetons aigus qui se présentaient tout à coup à ses yeux."
                            },
                            {
                                "example_id": "3be193ec-c410-495b-89de-7c21e558c0c0",
                                "sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                                "text": "De style ogival flamboyant, à ornementation très fouillée, surtout dans la façade et les tours, ses arcs-boutants, ses clochetons, ses pinacles gothiques sont remarquables."
                            },
                            {
                                "example_id": "f52899e3-d4c4-4896-8f9e-92792016ac76",
                                "sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                                "text": "Les murailles étaient plus élevées encore. Cependant il discerna le toit du château qu’elles ceignaient, un vieux toit Louis XIII que surmontaient des clochetons très fins disposés en corbeille autour d’une flèche plus aiguë et plus haute."
                            },
                            {
                                "example_id": "3d633276-c9df-43d7-b795-5843f53a2f24",
                                "sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                                "text": "Puis, après avoir rayé en tous sens le velours violet de l’air du soir, brusquement calmés ils revenaient s’absorber dans la tour, de néfaste redevenue propice, quelques-uns posés çà et là, ne semblant pas bouger, mais happant peut-être quelque insecte, sur la pointe d’un clocheton, comme une mouette arrêtée avec l’immobilité d’un pêcheur à la crête d’une vague."
                            },
                            {
                                "example_id": "f7938237-9c69-4536-982f-eb536fa73a2c",
                                "sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                                "text": "Il se trouva bientôt dans la rue Sainte-Émilie, faiblement éclairée, avec ses petites boutiques à balcons ornés et à toits à clochetons qui se donnent une réplique à peu près identique à chaque coin de rue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d848c4c2-cc40-4f09-bb16-f4caa720e107",
                        "source_entry_id": "a8cd4114-a12b-3543-9a98-2e6fbf014bef",
                        "source_sense_id": "37a7ce58-089a-34ed-a92d-5c4e8ae45e21",
                        "target_lang_word": "pinnacle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinnacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50fdb9e3-18b6-326d-bd72-891cbddfb9a6",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "The highest point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4dd6237-ca19-3ebc-b3a3-da97e5b32058",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "A tall, sharp and craggy rock or mountain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4502b5cf-18bb-4756-942e-9784bb93024c",
                                                "sense_id": "c4dd6237-ca19-3ebc-b3a3-da97e5b32058",
                                                "text": "Kings, who remain in many respects the representatives of a vanished world, solitary pinnacles that topple over the rising waste of waters under which the past lies buried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787a0503-cdc3-30d5-b09f-7b508fc3189d",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "An all-time high; a point of greatest achievement or success."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27d7607-e4b2-4818-b5d8-417e674837d2",
                                                "sense_id": "787a0503-cdc3-30d5-b09f-7b508fc3189d",
                                                "text": "The pinnacle of the effort to fix restrictive meanings to a set of terminology can be found in two papers in American Speech by Feinsilver (1979, 1980)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9b11b7-8d64-3c92-9a52-6934753f1015",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "An upright member, generally ending in a small spire, used to finish a buttress, to constitute a part in a proportion, as where pinnacles flank a gable or spire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800b8ba9-a390-4ecb-bb6f-3c5072b5b0c5",
                                                "sense_id": "bb9b11b7-8d64-3c92-9a52-6934753f1015",
                                                "text": "Some renowned metropolis / With glistering spires and pinnacles around."
                                            },
                                            {
                                                "example_id": "f2483ff8-99ef-4686-b98e-8218deb35cbb",
                                                "sense_id": "bb9b11b7-8d64-3c92-9a52-6934753f1015",
                                                "text": "In the city’s midst the gleaming marble of a thousand steps climbed to the citadel where arose four pinnacles beckoning to heaven, and midmost between the pinnacles there stood the dome, vast, as the gods had dreamed it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinnacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38600548-0440-36f8-816a-fe583cdcbca5",
                                        "entry_id": "ba88c2c4-682b-35c8-b24d-cf64ac44098d",
                                        "glosses": [
                                            "To place on a pinnacle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a5cacb-1a41-43b6-8a20-1a1a32e12767",
                                                "sense_id": "38600548-0440-36f8-816a-fe583cdcbca5",
                                                "text": "And down this vast gulf upon which we were pinnacled the great draught dashed and roared, driving clouds and misty wreaths of vapour before it, till we were nearly blinded, and utterly confused."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5cb91ad-f65e-3c46-9f1c-012a90ee36c0",
                                        "entry_id": "ba88c2c4-682b-35c8-b24d-cf64ac44098d",
                                        "glosses": [
                                            "To build or furnish with a pinnacle or pinnacles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee3d67c-e613-4343-951b-53eddada68ca",
                                                "sense_id": "d5cb91ad-f65e-3c46-9f1c-012a90ee36c0",
                                                "text": "The pediment of the Southern Transept is pinnacled, not inelegantly, with a flourished cross"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
