                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef6cf01c-1b0d-3f20-a3cf-19d72c1eb197",
                        "entry_id": "bfc75da2-4cdd-3549-a6db-efd3ee12fe74",
                        "glosses": [
                            "liturgisches Waschen der Hände eines Priesters in der heiligen Messe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dea04e34-f94a-487c-be23-4ce285037ae6",
                                "sense_id": "ef6cf01c-1b0d-3f20-a3cf-19d72c1eb197",
                                "text": "„Es hat gewiss einen tiefen Sinn und geschieht nicht ohne Absicht, wenn unsere heilige Kirche ihren Priestern tagtäglich in der heiligen Messe beim Lavabo die Worte des föniglichen Sängers in den Mund legt: ‚Herr, ich liebe die Zierde deines Hauses und den Ort der Wohnung deiner Herrlichkeit.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a301536b-4a73-3d47-9065-bbf081c5ed83",
                        "entry_id": "bfc75da2-4cdd-3549-a6db-efd3ee12fe74",
                        "glosses": [
                            "zum unter [1] beschriebenen Händewaschen verwendetes Waschbecken mit Wasserkanne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcbfe975-0e68-425b-aa3b-b324bcbbfb75",
                                "sense_id": "a301536b-4a73-3d47-9065-bbf081c5ed83",
                                "text": "„An einer Seite stand ein Lavabo, in dem der Priester seine Hände wusch […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e0db6696-6d49-37ab-82da-71e6eaeb7a98",
                        "entry_id": "bfc75da2-4cdd-3549-a6db-efd3ee12fe74",
                        "glosses": [
                            "sanitäre Anlage zum Waschen; Waschbecken"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "8e5ee5ad-1790-4c7c-aad3-22c14a5e2c93",
                                "sense_id": "e0db6696-6d49-37ab-82da-71e6eaeb7a98",
                                "text": "„Als Teenager zerschnitt ich meine Jeans und wusch sie im Lavabo mit Steinen, damit sie abgewetzt aussahen.“"
                            },
                            {
                                "example_id": "b4116db5-f7f1-45ad-8b85-5aaf70e89a10",
                                "sense_id": "e0db6696-6d49-37ab-82da-71e6eaeb7a98",
                                "text": "„Herr Dolder sitzt im Rollstuhl am Lavabo, eine Pflegende hilft ihm bei der Körperpflege.“"
                            },
                            {
                                "example_id": "f69ed0fb-c6da-4081-a3b3-4fe88f316f17",
                                "sense_id": "e0db6696-6d49-37ab-82da-71e6eaeb7a98",
                                "text": "„Im Lavabo lagen Döschen, Crèmes und ausgedrückte Tuben, in der Katzenkiste Badetücher und der heruntergerissene Fenstervorhang.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
