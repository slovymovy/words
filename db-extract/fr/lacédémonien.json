                    }
                ]
            },
            {
                "entry_id": "3d96debe-3254-3af4-bfc1-8e06c203770e",
                "word": "Lacédémonien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ab8b0ea-78b3-44fc-b9d1-1f8461354b77",
                        "entry_id": "3d96debe-3254-3af4-bfc1-8e06c203770e",
                        "tags": [
