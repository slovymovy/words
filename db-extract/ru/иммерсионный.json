                        "cross_references": [
                            {
                                "target_word": "immergé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee37b58f-498d-3fa4-a23b-0b078762c71c",
                                        "entry_id": "f78979ac-5332-3673-9447-ff59df29c657",
                                        "glosses": [
                                            "Qui est sous l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0638791d-840c-4c8a-9638-7f76803c75d5",
                                                "sense_id": "ee37b58f-498d-3fa4-a23b-0b078762c71c",
                                                "text": "Son corps roué de coups avait été découvert à demi immergé dans un étang, non loin de l’autoroute qu’il venait d’emprunter, près du village de Noé."
                                            }
                                        ]
                                    },
