                ],
                "senses": [
                    {
                        "sense_id": "b68a99da-9afe-3bb3-b719-113384dc7ed6",
                        "entry_id": "db4480f2-8a0e-3ddb-9f72-491e17798b3e",
                        "glosses": [
                            "„die Bewertung einzelner Einflussgrößen eines mathematischen Modells beispielsweise hinsichtlich ihrer Wichtigkeit oder Zuverlässigkeit“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c459fe6-906f-47bf-893e-ae117bf33d4f",
                                "sense_id": "b68a99da-9afe-3bb3-b719-113384dc7ed6",
                                "text": "„Die Preisentwicklung der enthaltenen Güter wird dabei über eine bestimmte Zeit (z. B. vier Jahre) mit konstanter Gewichtung der einzelnen Positionen ermittelt.“"
                            },
                            {
                                "example_id": "0f6374f4-e8fa-411c-8c71-a96add1a6918",
                                "sense_id": "b68a99da-9afe-3bb3-b719-113384dc7ed6",
                                "text": "„Die Bildinterpretation stützt sich stattdessen auf den Gesamtkontrast, die jeweilige Gewichtung (synonym Wichtung) der Messsequenz, und die Signalunterschiede zwischen bekannten und unbekannten Geweben.“"
                            },
                            {
                                "example_id": "06df274c-191c-4543-af45-c7ab77c39322",
                                "sense_id": "b68a99da-9afe-3bb3-b719-113384dc7ed6",
                                "text": "„Die Gewichtung im Index ist proportional zur berechneten Marktkapitalisierung (Freefloat) eines Unternehmens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4cd18e8d-265a-3cdb-9cf5-5e05f6ff6c06",
                        "entry_id": "db4480f2-8a0e-3ddb-9f72-491e17798b3e",
                        "glosses": [
                            "„die Trägheit der einzelnen Tasten eines Musikinstruments“"
                        ],
                        "tags": [
                            "Klaviatur"
                        ],
                        "examples": [
                            {
                                "example_id": "c39b116f-072e-4da5-8975-fc41ac22ed84",
                                "sense_id": "4cd18e8d-265a-3cdb-9cf5-5e05f6ff6c06",
                                "text": "„Beim Klavier entstehen Anschlagsdynamik und Gewichtung durch den Aufbau der Mechanik.“"
                            },
                            {
                                "example_id": "2c8f4765-c68a-44db-86bc-6f0b6d2f3e9d",
                                "sense_id": "4cd18e8d-265a-3cdb-9cf5-5e05f6ff6c06",
                                "text": "„Bei einem elektronischen Musikinstrument wird die Stärke des Anschlags (als Geschwindigkeit der Tastenbewegung) elektronisch gemessen und ist von einer Gewichtung unabhängig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
