                                        "glosses": [
                                            "verwendet, um auszudrücken, dass man etwas für sehr wahrscheinlich oder sogar ganz sicher so hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8e445e5-ec1b-4ea0-be2c-1a6987192313",
                                                "sense_id": "3846fbf8-902e-3aa8-a1a3-30b29f0402f6",
                                                "text": "Ich werde bestimmt morgen abreisen."
                                            },
                                            {
                                                "example_id": "fb455902-f53c-474e-a7e3-82dc798b89b6",
                                                "sense_id": "3846fbf8-902e-3aa8-a1a3-30b29f0402f6",
                                                "text": "Dieser angebliche „Doktor“ hat bestimmt noch keine Uni von innen gesehen."
                                            },
                                            {
                                                "example_id": "09bd018c-164d-4ce1-a8a9-36078a6d41a8",
                                                "sense_id": "3846fbf8-902e-3aa8-a1a3-30b29f0402f6",
                                                "text": "Sie hat bestimmt nur vergessen anzurufen."
                                            },
                                            {
                                                "example_id": "9a38199c-1164-41c8-9375-7bae2633c4d9",
                                                "sense_id": "3846fbf8-902e-3aa8-a1a3-30b29f0402f6",
                                                "text": "Weißt du das bestimmt?"
                                            },
