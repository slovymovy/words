                "entry_id": "d88a39d1-3619-39bb-b4e0-5e904a920a1b",
                "word": "bibliophage",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b694cc80-ff6b-498e-912d-0f029e679575",
                        "entry_id": "d88a39d1-3619-39bb-b4e0-5e904a920a1b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "bibliophages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78509976-db3b-370a-bee9-f9ec9e3fbbd9",
                        "entry_id": "d88a39d1-3619-39bb-b4e0-5e904a920a1b",
                        "glosses": [
                            "Qui mange les livres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4673b51e-bab6-4f29-bcaf-13b7b2092863",
                                "sense_id": "78509976-db3b-370a-bee9-f9ec9e3fbbd9",
                                "text": "Il existe de nombreux insectes bibliophages, comme les blattes, les termites et des spécimens spécialisées dans les livres et les bibliothèques, comme le « poux des livres » ou la vrillette qui creuse de véritables galeries dans les livres."
                            }
                        ]
                    },
                    {
                        "sense_id": "305fb201-b33e-3bad-99fb-af2097de3d54",
                        "entry_id": "d88a39d1-3619-39bb-b4e0-5e904a920a1b",
                        "glosses": [
                            "Qui « dévore » un livre par une lecture avide et rapide."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c0dcfba2-29b1-4602-80da-ee3ee818ac46",
                                "sense_id": "305fb201-b33e-3bad-99fb-af2097de3d54",
                                "text": "Cher bibliolâtre, j'espère que vous n'êtes pas bibliophage au sens propre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5b08ebe-9582-433f-9091-4ceb3c65df5b",
                        "source_entry_id": "d88a39d1-3619-39bb-b4e0-5e904a920a1b",
                        "target_lang_word": "bibliophage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliophage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f3d462a-edf8-3ab5-9aab-4f7f4326b055",
                                        "entry_id": "55490b67-de88-352c-b355-9f8be552c68b",
                                        "glosses": [
                                            "A person who loves to read books; a bookworm."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa7e169-1dd1-4a3a-8420-dce6d9355b9a",
                                                "sense_id": "3f3d462a-edf8-3ab5-9aab-4f7f4326b055",
                                                "text": "Janet loved reading. She was a real bibliophage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa3a4dfa-ef21-37d3-b1e0-b86e2fe2f59b",
                                        "entry_id": "55490b67-de88-352c-b355-9f8be552c68b",
                                        "glosses": [
                                            "A creature that consumes books’ physical contents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148fda54-9408-4314-89f7-10008d7b5185",
                                                "sense_id": "aa3a4dfa-ef21-37d3-b1e0-b86e2fe2f59b",
                                                "text": "Once inside, they begin to mine; there may be apparently nothing wrong outside, but when you open the book you find a hollow filled with insects, which have eaten almost all the letterpress, up to the margins. By keeping the shelves away from the walls and giving a little attention to wormy volumes, the Library may be easily freed from this kind of Bibliophage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7e9acfc-b901-4488-8943-a775d4f76f20",
                        "source_entry_id": "d88a39d1-3619-39bb-b4e0-5e904a920a1b",
