                                "target_senses": [
                                    {
                                        "sense_id": "4cb1c469-5ed9-3d4f-af79-b9a87a4f1e3c",
                                        "entry_id": "4a1d4bdf-cdda-3444-9c23-4c8de8b2bfb0",
                                        "glosses": [
                                            "etwas in zwei Hälften gleicher Größe aufteilen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29331cc7-23ed-46d4-a588-bd76320d4003",
                                                "sense_id": "4cb1c469-5ed9-3d4f-af79-b9a87a4f1e3c",
                                                "text": "„Wenn man den Raum halbieren würde, könnte man die Seiten passgenau aufeinanderlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0dcf2477-147e-33a2-b45e-f78cedc99eba",
                                        "entry_id": "4a1d4bdf-cdda-3444-9c23-4c8de8b2bfb0",
                                        "glosses": [
                                            "etwas auf die Hälfte reduzieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "322d82f5-4ed8-4c3a-84bc-02287e605de4",
                                                "sense_id": "0dcf2477-147e-33a2-b45e-f78cedc99eba",
                                                "text": "Mit seiner Spielsucht hat er sein Vermögen in einem Jahr halbiert."
                                            },
                                            {
                                                "example_id": "9a5eb864-9527-4c29-bd32-577f3ee92d6b",
                                                "sense_id": "0dcf2477-147e-33a2-b45e-f78cedc99eba",
                                                "text": "2002 forderte der damalige Bundeskanzler Gerhard Schröder, dass die Arbeitslosenzahl um die Hälfte sinken muss. […] Die Arbeitslosenzahl hat sich […] nicht halbiert; viele Menschen hartzen immer noch."
                                            },
                                            {
                                                "example_id": "eed82ada-ac29-4724-80a1-2700129b2c75",
                                                "sense_id": "0dcf2477-147e-33a2-b45e-f78cedc99eba",
                                                "text": "[2023:] „Seit 2020 hat sich das CO2-Budget für die Einhaltung der 1,5-Grad-Grenze halbiert. Grund sind hohe Emissionen und ein aktualisiertes Klimamodell.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43c17a9d-ff53-3685-ac81-27fef723e9ba",
                                        "entry_id": "4a1d4bdf-cdda-3444-9c23-4c8de8b2bfb0",
                                        "glosses": [
                                            "sich auf/um die Hälfte verringern"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b63878-fc2a-4749-b164-7d464c814407",
                                                "sense_id": "43c17a9d-ff53-3685-ac81-27fef723e9ba",
                                                "text": "Lerche, Kiebitz, Rebhuhn - die Zahl der Feldvögel in Europa sinkt dramatisch. Seit 1980 hat sich der Bestand halbiert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
