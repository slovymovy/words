                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04852a5c-b8ca-46dd-8c86-adc184199a8e",
                                "sense_id": "7d3a5e37-bb17-3c91-935d-57fa2fade863",
                                "text": "„Für Niemeyer-Fans ist der Präsidentenpalast, ein Bau mit der Glasfassade und auskragendem Betondach, das Juwel von Brasília.“"
                            },
                            {
                                "example_id": "0e706e74-2ca0-43f9-bcd2-4f6b1a76963f",
                                "sense_id": "7d3a5e37-bb17-3c91-935d-57fa2fade863",
                                "text": "„Die verbliebenen Mitglieder des Nationalkomitees der DVPA mobilisierten einige Hundert Anhänger, die mit 40 bis 50 Panzern den Präsidentenpalast angriffen.“"
                            }
                        ],
