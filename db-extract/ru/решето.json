                ],
                "translations": [
                    {
                        "translation_id": "e1d6a1db-4bf9-41da-9070-716a57eba1e3",
                        "source_entry_id": "3f19570e-ea3c-3d45-a8d4-21dd34712b85",
                        "target_lang_word": "sieve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sieve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61bd576a-6d98-3c3a-a046-6cc63054ad96",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A device with a mesh, grate, or otherwise perforated bottom to separate, in a granular material, larger particles from smaller ones, or to separate solid objects from a liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb9cc06-c413-4a8d-a967-5d8bf0429b78",
                                                "sense_id": "61bd576a-6d98-3c3a-a046-6cc63054ad96",
                                                "text": "Near-synonyms: sifter, strainer, temse"
                                            },
                                            {
                                                "example_id": "c8f3aec2-2bd7-4352-832c-c50cd547dafd",
                                                "sense_id": "61bd576a-6d98-3c3a-a046-6cc63054ad96",
                                                "text": "Use the sieve to get the pasta from the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8117a8-6233-39cb-b791-2e0ec5a4579a",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A process, physical or abstract, that arrives at a final result by filtering out unwanted pieces of input from a larger starting set of input."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfb78d8-1475-4a43-82e5-1e732dca0a6d",
                                                "sense_id": "bb8117a8-6233-39cb-b791-2e0ec5a4579a",
                                                "text": "Given a list of consecutive numbers starting at 1, the Sieve of Eratosthenes algorithm will find all of the prime numbers."
                                            },
                                            {
                                                "example_id": "e9d545f4-2a16-417b-846b-4705cedab97f",
                                                "sense_id": "bb8117a8-6233-39cb-b791-2e0ec5a4579a",
                                                "text": "Among, ^([sic]) his other achievements, Matiyasevich and his colleague Boris Stechkin also developed an interesting “visual sieve” for prime numbers, which effectively “crosses out” all the composite numbers, leaving only the primes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d5b0c34-d573-3812-b28f-60ee2e91f203",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A kind of coarse basket."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a57da22-9470-3845-9699-a2b213e26a9e",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A person, or their mind, that cannot remember things or is unable to keep secrets."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ece21c58-4598-372f-88e8-a5985d5229d4",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "An intern who lets too many non-serious cases into the emergency room."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bdcb2d-6938-40e0-b859-ae36e74d76d7",
                                                "sense_id": "ece21c58-4598-372f-88e8-a5985d5229d4",
                                                "text": "To be a sieve was to lack clinical judgment, courage, and group loyalty all at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d037d86a-ab03-3315-96af-3131c159a849",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A collection of morphisms in a category whose codomain is a certain fixed object of that category, which collection is closed under precomposition by any morphism in the category."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sieve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75692ade-2e7d-3b7e-9ade-b251ff5403a1",
                                        "entry_id": "e5f3ab1d-91ed-3d74-be2b-e98093196f5f",
                                        "glosses": [
                                            "To strain, sift or sort using a sieve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4472a63-e036-3cf2-9cae-f9cea48c089c",
                                        "entry_id": "e5f3ab1d-91ed-3d74-be2b-e98093196f5f",
                                        "glosses": [
                                            "To concede; let in"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6519db4-f572-4726-84cd-b3cc9abf8721",
                                                "sense_id": "c4472a63-e036-3cf2-9cae-f9cea48c089c",
                                                "text": "This was their seventh defeat out of nine finals, including five in a row, and the second half was a chastening experience for the Serie A champions, culminating in them sieving more goals in one match than in the rest of the competition put together."
                                            }
                                        ]
                                    }
                                ]
                            }
