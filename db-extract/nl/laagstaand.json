                "senses": [
                    {
                        "sense_id": "71c4e8ea-4086-3280-a608-b8a701091eb2",
                        "entry_id": "2c60d171-b1b1-3328-a805-a8be4cc27818",
                        "glosses": [
                            "dichtbij de horizon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb939359-9361-42ef-b266-57ee9dafa6f1",
                                "sense_id": "71c4e8ea-4086-3280-a608-b8a701091eb2",
                                "text": "De toedracht van het fatale ongeluk wordt nog onderzocht. Mogelijk heeft de laagstaande zon een rol gespeeld."
                            },
                            {
                                "example_id": "265613f7-1be0-4cf4-a273-b4a38f9a3227",
                                "sense_id": "71c4e8ea-4086-3280-a608-b8a701091eb2",
                                "text": "Om de laagstaande zon te weren, is goede raambekleding een must. Jaloezieën zijn hier bijvoorbeeld de perfecte oplossing voor. Dankzij de lamellen bepaal je supermakkelijk de gewenste hoeveelheid lichtinval en privacy. Een extra warme look krijg je door jaloezieën te combineren met prachtige velours overgordijnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f99ea448-6771-32d9-b4f1-8d305fce2bae",
                        "entry_id": "2c60d171-b1b1-3328-a805-a8be4cc27818",
                        "glosses": [
                            "ondiep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "011d2bfb-a9a6-4fb9-b0f6-a14627817953",
                                "sense_id": "f99ea448-6771-32d9-b4f1-8d305fce2bae",
                                "text": "Het water in sloten, rivieren, plassen en meren stond op veel plekken al laag door de droogte. Nu het al een week zeer warm is, loopt de temperatuur van laagstaand water heel snel op."
                            }
