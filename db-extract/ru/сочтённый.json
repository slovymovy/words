                "senses": [
                    {
                        "sense_id": "3fbc3e22-4884-3c24-b81e-42780f84f515",
                        "entry_id": "f060ea1e-624d-32c0-8001-218f256f9693",
                        "glosses": [
                            "страд. прич. прош. вр. от счесть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "abb61278-c06f-4585-a2fc-0a36f45d75ad",
                                "sense_id": "3fbc3e22-4884-3c24-b81e-42780f84f515",
                                "text": "А у вас и волосы на голове все сочтены."
                            },
                            {
                                "example_id": "11eaa98a-00fa-4d40-a03c-254ab1d1c469",
                                "sense_id": "3fbc3e22-4884-3c24-b81e-42780f84f515",
                                "text": "Запомни слово моё отныне, ибо хотя и буду ещё беседовать с тобой, но не только дни, а и часы мои сочтены."
                            },
                            {
                                "example_id": "2c83c59a-d52f-41c1-b479-064e6d294912",
                                "sense_id": "3fbc3e22-4884-3c24-b81e-42780f84f515",
                                "text": "Но я ещё имею власть умереть, хотя отдаю уже сочтенное."
                            }
                        ]
                    }
                ],
