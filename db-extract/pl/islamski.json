                    {
                        "translation_id": "c581b241-2778-49be-b4a8-3c5066493bb4",
                        "source_entry_id": "53ba48bb-a6c1-3771-a561-87ef40d18507",
                        "source_sense_id": "5e2cde06-8366-391e-a453-9cb059595914",
