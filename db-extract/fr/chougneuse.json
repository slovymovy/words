                "translations": [
                    {
                        "translation_id": "faa27d04-0d9e-429f-add5-270eb9974991",
                        "source_entry_id": "e1f6d3d6-40d6-3edb-8f22-ac1406cc6852",
                        "source_sense_id": "d798d6d9-295d-343b-9227-13867fac40bd",
                        "target_lang_word": "Heulsuse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heulsuse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "185aefda-f5f2-3c60-a6ca-59fe3d9c4ac0",
                                        "entry_id": "229c3b52-0f98-3b09-835e-6cac984f9453",
                                        "glosses": [
                                            "ein Kind, das bei jeder Kleinigkeit weint/heult"
                                        ],
                                        "tags": [
                                            "Kindsprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcfb4bc6-3e8e-4a46-8ae8-f124b0f5eb96",
                                                "sense_id": "185aefda-f5f2-3c60-a6ca-59fe3d9c4ac0",
                                                "text": "Meine kleine Schwester ist vielleicht eine Heulsuse, ich brauch nur „HAA“ machen und schon fängt sie an zu heulen."
                                            },
                                            {
                                                "example_id": "11d4680c-aed9-4be4-9530-3a960f746da5",
                                                "sense_id": "185aefda-f5f2-3c60-a6ca-59fe3d9c4ac0",
                                                "text": "„Großmutter Bärbel würde die vierjährige Nura zum Beispiel in manchen Situationen öfter mal in den Arm nehmen: Die Große, wenn sie hinfällt, möchte gerne bedauert werden und meine Tochter sagt, sie möchte keine Heulsuse erziehen.“"
                                            },
                                            {
                                                "example_id": "2c135da6-77de-4ffa-9eef-0449245ba5d2",
                                                "sense_id": "185aefda-f5f2-3c60-a6ca-59fe3d9c4ac0",
                                                "text": "[Man] „freut sich direkt, wenn eine Heulsuse wie Alice Weidel dabei ist, die wie eine Zehnjährige, der etwas nicht passt, beleidigt aus dem Zimmer läuft.“"
                                            },
                                            {
                                                "example_id": "6fb18217-b9c1-41b7-b026-d518cfdbfbbb",
                                                "sense_id": "185aefda-f5f2-3c60-a6ca-59fe3d9c4ac0",
                                                "text": "„Neymar polarisiert die Fußballwelt: Mal ist er Matchwinner, mal nach vermeintlichen oder wirklichen Fouls theatralischer Simulant. Was ist er für Sie: Held oder Heulsuse?“"
                                            },
                                            {
                                                "example_id": "95ed1a37-26e5-4769-bd9c-afa60473cf4d",
                                                "sense_id": "185aefda-f5f2-3c60-a6ca-59fe3d9c4ac0",
                                                "text": "„Mit den Heulsusen komme ich nicht weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48219938-75d7-383f-92b7-8830ee1314e5",
                                        "entry_id": "229c3b52-0f98-3b09-835e-6cac984f9453",
                                        "glosses": [
                                            "Person, die an allem etwas zu kritisieren beziehungsweise meckern hat"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c6bc7aa-49e0-4d72-b930-4b0a2519193b",
                                                "sense_id": "48219938-75d7-383f-92b7-8830ee1314e5",
                                                "text": "Die olle Heulsuse, mit nichts ist sie zufrieden!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
