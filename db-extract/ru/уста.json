                "senses": [
                    {
                        "sense_id": "9fb934c2-b9e4-35f8-91aa-7dab0807d83c",
                        "entry_id": "0d4388fc-6ea3-3a69-995b-dfb0ce1e4ce4",
                        "glosses": [
                            "поэт., устар. рот, губы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa53b78f-bbd4-4d9d-8ec7-450df93449e6",
                                "sense_id": "9fb934c2-b9e4-35f8-91aa-7dab0807d83c",
                                "text": "И он к устам моим приник, // И вырвал грешный мой язык"
                            },
                            {
                                "example_id": "faea01db-28ee-4ad2-a063-330ec7c63f39",
                                "sense_id": "9fb934c2-b9e4-35f8-91aa-7dab0807d83c",
                                "text": "Сплетались горячие руки, // Уста прилипали к устам"
                            },
                            {
                                "example_id": "ad7414ab-37ad-4845-befa-775573e9d914",
                                "sense_id": "9fb934c2-b9e4-35f8-91aa-7dab0807d83c",
                                "text": "Улыбка на устах, а на уме коварность"
                            },
                            {
                                "example_id": "9a9e7e97-ce97-4544-8e08-d17dcf993520",
                                "sense_id": "9fb934c2-b9e4-35f8-91aa-7dab0807d83c",
                                "text": "я видел, как окаменели ее ноги, как невыразимый ужас разверз ее уста, расширил глаза, устремленные в даль…"
                            }
                        ]
                    }
                ],
