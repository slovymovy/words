                    }
                ],
                "translations": [
                    {
                        "translation_id": "6333efdc-f13b-412d-990f-a679314c0442",
                        "source_entry_id": "fc105e2a-fa03-3bd0-9c6b-28841a25381f",
                        "source_sense_id": "965610f9-8ebb-392a-9a7e-444544974581",
                        "target_lang_word": "kalkulatorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalkulatorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb80098-b6db-334b-b8a1-7422bd773bf5",
                                        "entry_id": "23185938-0a9d-3265-afbf-884792eaee91",
                                        "glosses": [
                                            "kalkulatorisch sind Wertströme, die sich auf Mengen (Verkäufe, Produktionen, …) beziehen; diese werden i. d. R. in der Kostenrechnung / im Controlling ermittelt. Im Gegensatz dazu werden in der Finanzbuchhaltung reale Wertströme verarbeitet."
                                        ],
                                        "tags": [
                                            "Rechnungswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0545b647-d518-48b5-8daa-7e2777183183",
                                                "sense_id": "ebb80098-b6db-334b-b8a1-7422bd773bf5",
                                                "text": "Die in der Finanzbuchhaltung erfaßten tatsächlichen (pagatorischen) Ausgaben, z.B. für Anlagegüter, sind kalkulatorisch wenig brauchbar. Sie werden deshalb im Controlling anders berücksichtigt."
                                            },
                                            {
                                                "example_id": "bf1bd302-d950-43ee-94cd-79018f0e7de9",
                                                "sense_id": "ebb80098-b6db-334b-b8a1-7422bd773bf5",
                                                "text": "Mit dem Risikoanteil (auch Risikobeitrag) wird der Teil des Versicherungsbeitrags bezeichnet, der kalkulatorisch für die Finanzierung der Versicherungsleistungen vorgesehen ist, die der Versicherer für vorzeitige Todesfälle oder Rentenzahlungen erbringen muss, […]"
                                            },
                                            {
                                                "example_id": "ebea0d50-e24f-47de-a45d-3c44d96c9989",
                                                "sense_id": "ebb80098-b6db-334b-b8a1-7422bd773bf5",
                                                "text": "Der Lohnsteuerpflichtige spart durch den Lohnsteuerfreibetrag kalkulatorisch Zinsen."
                                            },
                                            {
                                                "example_id": "7f307443-01c2-4fb0-8763-067df58a79cb",
                                                "sense_id": "ebb80098-b6db-334b-b8a1-7422bd773bf5",
                                                "text": "[Der] Wertverzehr der Fertigungsanlagen wird kalkulatorisch abgeschrieben und den Fertigungskostenstellen belastet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91eb0e4a-3b14-3c6e-a3ca-e3ed6e6f0522",
                                        "entry_id": "23185938-0a9d-3265-afbf-884792eaee91",
                                        "glosses": [
                                            "Zu den kalkulatorischen Kosten gehören Abschreibungen, Zinsen, Mieten, Unternehmerlohn und Wagnisse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3658274d-c09c-3198-a4c5-dc2174e5d77d",
                                        "entry_id": "23185938-0a9d-3265-afbf-884792eaee91",
                                        "glosses": [
                                            "eine Kalkulation betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1902ca-f7b2-4105-9a1e-b3d6aca292ff",
                                                "sense_id": "3658274d-c09c-3198-a4c5-dc2174e5d77d",
                                                "text": "Wenn eine Bank kalkulatorisch dauerhaft viel höhere Zinsen ansetzt, als die Wettbewerber, dann wird sie zunehmend weniger Kredite vergeben."
                                            },
                                            {
                                                "example_id": "00d6f766-c803-4cfa-b1e8-b68d38f2e3b9",
                                                "sense_id": "3658274d-c09c-3198-a4c5-dc2174e5d77d",
                                                "text": "Ein Textilbetrieb, der [international] wettbewerbsfähig bleiben will, muß vor allem auch die unterschiedlichen Belastungen [beispielsweise Steuern, Löhne] auf den internationalen Märkten kalkulatorisch ausgleichen können."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
