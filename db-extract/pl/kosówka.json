                "senses": [
                    {
                        "sense_id": "76a4c363-13b7-34fc-ad93-f8232d85b381",
                        "entry_id": "0a50c39b-577a-3fe4-bc86-ff63a9e6789d",
                        "glosses": [
                            "Pinus mugo Turra, gatunek drzewa lub krzewu iglastego należący do rodziny sosnowatych, rosnący w górach, powyżej górnej granicy lasu"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "66d3da5b-88e3-48e5-86b3-baedff50a2f9",
                                "sense_id": "76a4c363-13b7-34fc-ad93-f8232d85b381",
                                "text": "Pylenie kosówki następuje od maja do lipca."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "81fa8800-cdc8-370b-81c6-d30b6bfaeac9",
                        "entry_id": "0a50c39b-577a-3fe4-bc86-ff63a9e6789d",
                        "glosses": [
                            "krzew z gatunku kosówek (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71c6b94-eb3f-4caa-ae79-ee00f1973f51",
                                "sense_id": "81fa8800-cdc8-370b-81c6-d30b6bfaeac9",
                                "text": "Tę kosówkę posadził któryś z naszych ogrodników."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "75f6b027-bb9d-34df-b186-b695e5d511da",
