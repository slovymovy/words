                    {
                        "sense_id": "be5f00c0-bdf2-3dae-9c0c-b941f74d0c9a",
                        "entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "glosses": [
                            "minerał z grupy siarczanów, dwuwodny siarczan wapnia; także skała osadowa której głównym składnikiem jest dwuwodny siarczan wapnia, dodatkowo może ona zawierać anhydryt, iły, różne węglany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c6e089-1bc3-4f28-a17f-810e7a5d4760",
                                "sense_id": "be5f00c0-bdf2-3dae-9c0c-b941f74d0c9a",
                                "text": "Te gleby są bogate w gips."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2fbe9eb7-d084-3e47-a242-998bb7ecc356",
                        "entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "glosses": [
                            "materiał budowlany, półwodny siarczan wapnia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd18ec6-d4b3-4ccb-958f-2249f0945f31",
                                "sense_id": "2fbe9eb7-d084-3e47-a242-998bb7ecc356",
                                "text": "Idź do magazynu i przynieś worek gipsu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "363bfe21-5868-3fbf-89d5-53a265b351f5",
                        "entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "glosses": [
                            "opatrunek unieruchamiający wykonany z gipsu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "56008c09-9c76-4db9-8dab-c7827a02bfa1",
                                "sense_id": "363bfe21-5868-3fbf-89d5-53a265b351f5",
                                "text": "Adam przewrócił się i ma teraz rękę w gipsie."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "b85c54a7-f26a-39ab-afd8-431797a31310",
                        "entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "glosses": [
                            "figura, odlew gipsowy"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "a12ddef6-c75c-49f2-8d3a-09b69fffc14c",
                                "sense_id": "b85c54a7-f26a-39ab-afd8-431797a31310",
                                "text": "Ech, te wszystkie gipsy są do wyrzucenia."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "ee4879e2-cce8-3be5-9aab-fc67ad58c465",
                        "entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "glosses": [
                            "drobny, suchy śnieg utrudniający jazdę na nartach"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "01a49746-c7f2-4b1f-b669-883e26d0f700",
                                "sense_id": "ee4879e2-cce8-3be5-9aab-fc67ad58c465",
                                "text": "Po tym gipsie nie da się jeździć, wracamy do hotelu."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "5f67174d-476c-36d2-9709-18e185950ae5",
                        "entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "glosses": [
                            "kiepska sytuacja"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "c88eeb8c-d967-4b3d-9c1c-310aa76b8a27",
                                "sense_id": "5f67174d-476c-36d2-9709-18e185950ae5",
                                "text": "Z matematyki leżysz na obu łopatkach, język angielski zawaliłaś, chemia i fizyka stanowią dwie twoje achillesowe pięty, że tak powiem. Interesuje mnie, co zamierzasz przedsięwziąć, by wykaraskać się z tego gipsu"
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e5e4ecd-25b4-491c-ba3c-265bc7757976",
                        "source_entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "source_sense_id": "be5f00c0-bdf2-3dae-9c0c-b941f74d0c9a",
                        "target_lang_word": "gypsum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gypsum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be980f7c-7910-3317-bd89-927a19b64f4d",
                                        "entry_id": "34ab4543-71f9-3f32-9246-d18bc6906c5d",
                                        "glosses": [
                                            "A mineral consisting of hydrated calcium sulphate. When calcinated, it forms plaster of Paris."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9d4cada-2541-4229-b690-889d6736a159",
                                                "sense_id": "be980f7c-7910-3317-bd89-927a19b64f4d",
                                                "text": "Besides being abundant, gypsum is easily refined into a powder for plaster or formed into sheets of wallboard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0f949ff-daf4-444d-8609-5b58e46c9d83",
                        "source_entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "source_sense_id": "be5f00c0-bdf2-3dae-9c0c-b941f74d0c9a",
                        "target_lang_word": "yeso",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yeso",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "870f96ca-c385-3d01-8737-11252be52518",
                                        "entry_id": "1d3c5bce-4bc8-3806-9b84-1c3073f42eea",
                                        "glosses": [
                                            "Mineral muy blando, compuesto primariamente de dihidrato de sulfato de calcio (fórmula: CaSO₄·2H₂O), de hábito cristalino prismático, monoclínico, de color blanco, transparente a translúcido, usado desde la Antigüedad para construcción y como aditivo en diversos procesos culinarios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "589fd928-a179-4d4e-a5de-75205de8052d",
                                                "sense_id": "870f96ca-c385-3d01-8737-11252be52518",
                                                "text": "Pues tornando a nuestro propósito, digo: que hay en esta tierra sierras de yeso muy bueno, en especial en un pueblo que se dice Cozcotlán; en toda la tierra lo hay, pero es piedra blanca, de lo cual se ha hecho y sale bueno; mas estotro que digo es de lo de los espejos, y es mucho y muy bueno."
                                            },
                                            {
                                                "example_id": "d0bc12f3-50bd-40c7-a0a4-5600b28725f1",
                                                "sense_id": "870f96ca-c385-3d01-8737-11252be52518",
                                                "text": "A los diez y siete capitulos respondieron que la calidad de la tierra en que esta este pueblo situado es fría, porque esta en alto fundado en una serrecilla de yeso, y por algunas partes de el esta llano y por otras cuestas y valles, y toda rasa, sana mas que enferma."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e31a6b54-5be0-3c77-9614-33f1e9383a67",
                                        "entry_id": "1d3c5bce-4bc8-3806-9b84-1c3073f42eea",
                                        "glosses": [
                                            "Polvo de yeso₁ deshidratado, usado como material de construcción, especialmente en revestimientos y piezas decorativas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e92df8-7e45-4375-9ea3-39ded3bbbf81",
                                                "sense_id": "e31a6b54-5be0-3c77-9614-33f1e9383a67",
                                                "text": "Yten, que tengo de xabelgar y blanquear de yeso todas las bóvedas y paredes de toda la dha yglesia y capillas de cruzero hasta el suelo, muy bien lavadas y despieçadas, lavadas de trapo y pinzeladas de Cal blanca, asy predientes en las bóvedas como syllarería por las paredes, todo muy bien hecho al Arte de cantería, y a nyvel."
                                            },
                                            {
                                                "example_id": "037a8c2d-d463-469c-9855-284a62c216f7",
                                                "sense_id": "e31a6b54-5be0-3c77-9614-33f1e9383a67",
                                                "text": "Cierto, las ciudades de los reinos de Cíbola y de Tigués y de Quivira, de Tuzayán y de Uraba, que fueron los que nuestros españoles vieron, y la grandeza y asientos dellas y los edificios de las casas, como dije de seis y siete altos; la materia es de piedra y madera y con yeso, de que las hacen; su tamaño grande, el altura y hechura y hermosura y chapiteles de las torres y orden de las calles y plazas; los terrados, los corredores por los cuales cuasi toda la ciudad se puede andar por lo alto; las ventanas a la calle, las cercas dobladas que las cercaban y fortificaban, no es chico ni fácil argumento de ser aquellas gentes no sólo políticas, pero en policía muy esmeradas y muy bien y mejor gobernadas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ece24f3b-4f64-32c4-80a8-72314ddb5a31",
                                        "entry_id": "1d3c5bce-4bc8-3806-9b84-1c3073f42eea",
                                        "glosses": [
                                            "Obra escultórica vaciada en yeso₂."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73aed167-c22f-4e68-b6d5-5f73822f6680",
                                                "sense_id": "ece24f3b-4f64-32c4-80a8-72314ddb5a31",
                                                "text": "La obra terminada era un yeso, vaciado en el molde que se había hecho de la versión en arcilla, la cual, a su vez, quedaba destruida en el proceso."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "39f208e7-9fff-3c63-bcaa-033cc4a8d89c",
                                        "entry_id": "1d3c5bce-4bc8-3806-9b84-1c3073f42eea",
                                        "glosses": [
                                            "Vendaje impregnado de yeso₂ que se emplea para inmovilizar un miembro en caso de fracturas o fisuras de los huesos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a2132c7-378c-4887-a318-063764081410",
                                                "sense_id": "39f208e7-9fff-3c63-bcaa-033cc4a8d89c",
                                                "text": "Manejar un automóvil es ser sensible a las capacidades de ubicación, posiciones y cambios en el espacio del mismo, tal como se es sensible a las capacidades del propio cuerpo y cuando un yeso o vendaje envuelve una parte del cuerpo eso supone también una transformación del esquema corporal, dentro del cual quedan integrados."
                                            },
                                            {
                                                "example_id": "4ff9fd49-a809-415c-b39d-fe82a08213e9",
                                                "sense_id": "39f208e7-9fff-3c63-bcaa-033cc4a8d89c",
                                                "text": "Se debería propiciar el cambio de trabajo en el operario de las fábricas; por ejemplo, cuando tiene un yeso en la extremidad inferior pasaría a realizar su labor estando sentado."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3feb2e9b-d335-4c3b-88e5-9fdc03ace6ba",
                        "source_entry_id": "19877989-a852-3226-956d-69a2e79c976e",
                        "source_sense_id": "be5f00c0-bdf2-3dae-9c0c-b941f74d0c9a",
                        "target_lang_word": "Gips",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gips",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a3bbbdf-edc2-3e15-a4dc-ac8500c6cafb",
                                        "entry_id": "9759b39f-6e5f-3888-8aef-fc40d52f5aea",
                                        "glosses": [
                                            "zu den Sulfaten gehörendes häufiges Mineral (CaSO₄), sowie auch Gestein das vollständig oder zum größten Teil aus diesem Mineral besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9c676f-1074-474b-b093-185189007ab7",
                                                "sense_id": "6a3bbbdf-edc2-3e15-a4dc-ac8500c6cafb",
                                                "text": "Als Mineral kommt Gips in verschiedenen Varietäten vor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d7b4798-7869-3299-9849-2ea76429a631",
                                        "entry_id": "9759b39f-6e5f-3888-8aef-fc40d52f5aea",
                                        "glosses": [
                                            "ein unter Verwendung von [1] hergestellter fester, und zeitlich begrenzter steifer Verband"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937338cc-b365-4a9f-86d7-0e73ba87e4a6",
                                                "sense_id": "7d7b4798-7869-3299-9849-2ea76429a631",
                                                "text": "Im Krankenhaus bekam ich einen Gips, damit der Bruch heilen konnte."
                                            },
                                            {
                                                "example_id": "c92dd7ec-86a5-445b-9f62-3e48afd20843",
                                                "sense_id": "7d7b4798-7869-3299-9849-2ea76429a631",
                                                "text": "Ein Zinkleimverband ist ebenso eine Möglichkeit Körperelemente ruhig zu stellen, wie ein Gipsverband aus Gips."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3aedb797-0846-3d5f-ab1c-cdad0b0bc45f",
                                        "entry_id": "9759b39f-6e5f-3888-8aef-fc40d52f5aea",
                                        "glosses": [
                                            "Pulver aus gemahlenem und gebranntem [1], das mit Wasser angerührt zum Spachteln von zum Beispiel Wänden dient oder auch zum Gießen von zum Beispiel Dekorteilen, Masken oder Büsten; Gipsmasken"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fccefbaf-7da8-4e27-a313-ab5058be68d1",
                                                "sense_id": "3aedb797-0846-3d5f-ab1c-cdad0b0bc45f",
                                                "text": "Sie sollten die Wand erst mit Gips spachteln."
                                            },
                                            {
                                                "example_id": "83878cdc-d5bd-4883-b14e-0f27d328c761",
                                                "sense_id": "3aedb797-0846-3d5f-ab1c-cdad0b0bc45f",
                                                "text": "„Die übrigen Notabeln seien: der Graf de Faverges, ehemals Abgeordneter, dessen Kuhställe musterhaft waren; der Bürgermeister, Monsieur Foureau, der mit Holz, Gips und allen möglichen Sachen handelte; ferner Monsieur Marescot, der Notar; der Abbé Jeufroy und die Witwe Bordin, die von ihren Zinsen lebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "68a2bb66-3550-391f-b2da-a262c0828a80",
                                        "entry_id": "9759b39f-6e5f-3888-8aef-fc40d52f5aea",
                                        "glosses": [
                                            "Baumaterial aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c50b5fe0-1c00-4e8a-82cf-908961021477",
                                                "sense_id": "68a2bb66-3550-391f-b2da-a262c0828a80",
                                                "text": "Bei der Renovierung schlugen sie allen Putz und Gips herunter."
                                            },
                                            {
                                                "example_id": "c8401b20-0186-4f86-aa86-f58b4336b056",
                                                "sense_id": "68a2bb66-3550-391f-b2da-a262c0828a80",
                                                "text": "Bei der Montage der neuen Küchenschränke stellte sich die Frage, ob die Gipsdielenwand tragfähig ist, da Gips eine relativ geringe Festigkeit hat."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gips",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4bb4751-90a4-3699-9e8f-423376f94287",
                                        "entry_id": "08009831-de99-3b23-97ac-009ed379955d",
                                        "glosses": [
                                            "deutscher Familienname"
