                        "sense_id": "66d47c25-5323-3496-9f46-2e9f9e5ec9e5",
                        "entry_id": "70eedee5-dc36-31b5-a4d0-4341dff32950",
                        "glosses": [
                            "iemand die veel pech heeft"
                        ],
                        "tags": [
