                "senses": [
                    {
                        "sense_id": "94850bd0-d799-37a9-a9f7-df927f5ae104",
                        "entry_id": "35613231-c110-31b6-acd9-da88a9c628ba",
                        "glosses": [
                            "Schrift, bei der die einzelnen Zeichen (Schriftzeichen) für Begriffe/Bedeutungen (und nicht für einzelne Laute, Silben oder Wörter) stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba1b1d5-9d4e-4e34-9e44-be334301759e",
                                "sense_id": "94850bd0-d799-37a9-a9f7-df927f5ae104",
                                "text": "„Humboldt sah nur die Alternative zwischen Lautschrift und Begriffsschrift. Da er die Auffassung von der Sprachabhängigkeit des Denkens vertrat, schloß er die Möglichkeit einer reinen, d. h. sprachunabhängigen Begriffsschrift jedoch aus.“"
                            },
                            {
                                "example_id": "99e8ea90-1bb8-431f-b0ee-cf8e3a57b31f",
                                "sense_id": "94850bd0-d799-37a9-a9f7-df927f5ae104",
                                "text": "„Es handelte sich überall aber ursprünglich um Symbole, um eine Begriffsschrift.“"
                            },
                            {
                                "example_id": "778d6246-c0e5-4000-8161-a9f7acd81985",
                                "sense_id": "94850bd0-d799-37a9-a9f7-df927f5ae104",
                                "text": "„Die zweite Art Schrift ist die so genannte „Ideographie“, die Begriffsschrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "359c56e9-c239-3916-b08d-dac379049d21",
