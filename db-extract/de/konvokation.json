                                        "sense_id": "00480407-cd73-3d27-b93d-062021e024ca",
                                        "entry_id": "b892ff53-5546-3661-8f46-6e966f8c7832",
                                        "glosses": [
                                            "Action de convoquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcb7cbcf-9434-4ac8-8c1c-224b6eae81ae",
                                                "sense_id": "00480407-cd73-3d27-b93d-062021e024ca",
                                                "text": "Il en rêvait tellement, l’imbécile, que profitant d'une convocation chez le juge, nous concernant l'un et l'autre, il prévint ses potes photographes que je serai piégeable dans les couloirs du palais."
                                            },
                                            {
                                                "example_id": "64aa4d9c-9644-4613-ad9f-0e896d66add0",
                                                "sense_id": "00480407-cd73-3d27-b93d-062021e024ca",
                                                "text": "Aussi, les quelques jours avant de regagner Nîmes, j’étais un peu anxieux par rapport au résultat de cette convocation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd76b309-6a71-37f5-9ee5-6a18fe4fa883",
                                        "entry_id": "b892ff53-5546-3661-8f46-6e966f8c7832",
                                        "glosses": [
                                            "Le billet ou la lettre de convocation."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b25c3c32-5bc5-460a-b9c4-852a364b0599",
                                                "sense_id": "bd76b309-6a71-37f5-9ee5-6a18fe4fa883",
                                                "text": "Après la publication des résultats de l’écrit sur le site de publinet, les candidats admissibles reçoivent une convocation pour assister à une réunion au lycée Saint-Louis en fin d'après-midi."
                                            }
                                        ]
