                        "glosses": [
                            "Personne qui gémit, se plaint tout le temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cfc167c-4dae-4bb5-b87b-6a550f159f25",
                                "sense_id": "9666bfdb-b624-3032-a785-db4627c77410",
                                "text": "Si ce penchant nʼest pas brimé de bonne heure, on se plaindra de tout, on sera un gémisseur, on aura lʼœil mal fait."
                            },
                            {
                                "example_id": "2dcd9f24-9cd8-4c61-9ef9-dea6075fa192",
                                "sense_id": "9666bfdb-b624-3032-a785-db4627c77410",
                                "text": "Mais ils rapportent aussi lʼhistoire beaucoup plus curieuse et plus rare dʼune malade qui après avoir été une gémisseuse pendant plus de dix mois a guéri."
                            }
                        ]
                    }
