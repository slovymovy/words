                "senses": [
                    {
                        "sense_id": "6eae2786-6f28-3cdb-9633-37289b298b4b",
                        "entry_id": "c1033f02-2823-3869-a0ad-8874861ad73e",
                        "glosses": [
                            "erdgeschichtlich meist ältere Tiefengesteine und Gesteine, die unter hohem Druck und hoher Temperatur entstanden (Metamorphit)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "53445c1c-3e08-4255-b79d-8f55a5c97a7c",
                                "sense_id": "6eae2786-6f28-3cdb-9633-37289b298b4b",
                                "text": "Die Behaarte Alpenrose wächst auf Kalk, die Rostrote Alpenrose auf Urgestein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "057d8369-dfc4-32ef-8fd7-5997598b3a4e",
                        "entry_id": "c1033f02-2823-3869-a0ad-8874861ad73e",
                        "glosses": [
                            "bedeutender Vertreter einer politischen oder künstlerischen Richtung; jemand, der schon sehr lange in einem Unternehmen tätig ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "17422143-ae2a-423c-a30b-9d6a4ec3fec9",
                                "sense_id": "057d8369-dfc4-32ef-8fd7-5997598b3a4e",
                                "text": "„Da sehe ich plötzlich Hans-Joachim Wolfram, ein Urgestein der Fernsehunterhaltung.“"
                            },
                            {
                                "example_id": "e51c17ee-3ce5-40aa-8499-aeb0bad32ed6",
                                "sense_id": "057d8369-dfc4-32ef-8fd7-5997598b3a4e",
                                "text": "„Er ist Urgestein der palästinensischen Politik und gilt als erfahren und schlau, wenn auch nicht als mitreißend.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
