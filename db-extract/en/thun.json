                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60703a0f-97f2-4731-bb55-ffa3fe5af489",
                                                "sense_id": "d820ea94-0cfb-36e2-8caa-6e8ae4052e1f",
                                                "text": "Er lebt seit mehreren Jahren in Thun."
                                            },
                                            {
                                                "example_id": "1eece118-3929-450c-899b-0b141530a613",
                                                "sense_id": "d820ea94-0cfb-36e2-8caa-6e8ae4052e1f",
                                                "text": "Das Bälliz (eine Insel in der Aare) ist die Einkaufsmeile in Thun."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Thun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1462cf3e-b649-3a46-b2d4-ad0975c784d6",
                                        "entry_id": "e1e7f934-ff06-3a34-8556-18e8b6d17dd1",
                                        "glosses": [
                                            "großer und schneller, als Speisefisch beliebter Meeresfisch; Thunnus"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48b9258a-d6b8-4386-9d5b-65380bb215c4",
                                                "sense_id": "1462cf3e-b649-3a46-b2d4-ad0975c784d6",
                                                "text": "„Der Thun zieht in der Tiefe fort; der Schwertfisch hingegen nimmt seinen Weg durch die oberen Schichten des Meeres […].“"
                                            },
                                            {
                                                "example_id": "3cc43944-57c0-4eac-82c2-3c389b7eabd1",
                                                "sense_id": "1462cf3e-b649-3a46-b2d4-ad0975c784d6",
                                                "text": "„In Sardinien erscheint der Thun plötzlich im April in ungeheurer Menge und verschwindet dann acht Monate wieder, indem man ihn im Winter in den tiefsten Theilen des Golfes findet, daher heißen dann die Fische Golfitani.“"
                                            },
                                            {
                                                "example_id": "b8b0551d-cbf9-4cf6-a0e7-59b73eaa11cf",
                                                "sense_id": "1462cf3e-b649-3a46-b2d4-ad0975c784d6",
                                                "text": "„Es waren Schwertfische, noch schnellere Schwimmer als die Thune, deren Zügen sie sich anschließen.“"
                                            },
                                            {
                                                "example_id": "03285abd-5138-4226-be5c-b9173d1dbca9",
                                                "sense_id": "1462cf3e-b649-3a46-b2d4-ad0975c784d6",
                                                "text": "„Die Thune lieben unter den Fischen am meisten die Wärme und schwimmen der Wärme wegen auf der Ufersand; […]“"
                                            },
                                            {
                                                "example_id": "7826f40a-e56d-4361-8249-441dcbd23e90",
                                                "sense_id": "1462cf3e-b649-3a46-b2d4-ad0975c784d6",
                                                "text": "„Ungeachtet seiner Größe ist der Thun ein furchtsamer Fisch, welcher das süsse Wasser liebt; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
