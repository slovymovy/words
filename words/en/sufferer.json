                    "sense_id": "f8ee1de2-59ed-3e0e-909d-822cd6d4ea55",
                    "sense_definition": "A person or entity that experiences pain, illness, or hardship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_experiencing_hardship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sufferer</w> was given medication to help manage the chronic pain.",
                            "target_lang_translations": {
                                "ru": "<w>Страдальцу</w> дали лекарство, чтобы помочь справиться с хронической болью."
                            }
                        },
                        {
                            "text": "Many <w>sufferers</w> of the disease reported feeling much better after the new treatment.",
                            "target_lang_translations": {
                                "ru": "Многие <w>страдающие</w> от этого заболевания сообщили, что почувствовали себя намного лучше после нового лечения."
                            }
                        }
                    ],
                    "synonyms": [
                        "victim",
                        "patient"
                    ],
                    "common_phrases": [
