                "senses": [
                    {
                        "sense_id": "a668596f-df43-3d9d-af7e-36a917e45ecf",
                        "entry_id": "7c3ca3c0-da28-346f-aaa5-a98d01261791",
                        "glosses": [
                            "Très traditionnel en matière de religion, dévot, bigot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ad914c-54e7-4755-9756-ceb57ee7b4c0",
                                "sense_id": "a668596f-df43-3d9d-af7e-36a917e45ecf",
                                "text": "Toujours est-il que, gêné par le côté bondieusard et par la pleutrerie de la langue d'Hello, d'Aurevilly se crispe un peu devant ce livre."
                            },
                            {
                                "example_id": "cece8c2e-6da2-4a73-8c90-91377b552304",
                                "sense_id": "a668596f-df43-3d9d-af7e-36a917e45ecf",
                                "text": "L’article fut refusé par Le Monde, Pépita Bourguignon, la chef de rubrique, ayant menacé de démissionner si on publiait cette « cuculterie bondieusarde » ; mais il devait paraître dans Art Press le mois suivant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89d54730-b3f6-437b-be0c-3b5f634558c2",
                        "source_entry_id": "7c3ca3c0-da28-346f-aaa5-a98d01261791",
                        "source_sense_id": "a668596f-df43-3d9d-af7e-36a917e45ecf",
                        "target_lang_word": "bigott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f08a5137-1c7d-3a25-822b-ace6208cd86e",
                                        "entry_id": "8446d73b-e8de-3330-823a-f026f4c7c42f",
                                        "glosses": [
                                            "übertrieben glaubenseifrig, frömmelnd, seine Frömmigkeit überzogen präsentierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0e5af9-839c-4cb8-81b3-f21f38dfc812",
                                                "sense_id": "f08a5137-1c7d-3a25-822b-ace6208cd86e",
                                                "text": "Manche Menschen neigen dazu, mit höherem Alter bigott zu werden."
                                            },
                                            {
                                                "example_id": "db2cfe0f-9c20-4c91-a558-f229e1a10256",
                                                "sense_id": "f08a5137-1c7d-3a25-822b-ace6208cd86e",
                                                "text": "„Auch zwang er sie, gemeinsam mit ihm eine bigotte Frömmigkeit an den Tag zu legen.“"
                                            },
                                            {
                                                "example_id": "b40d0192-d6a9-4ee9-bbc5-a8bd3b080b63",
                                                "sense_id": "f08a5137-1c7d-3a25-822b-ace6208cd86e",
                                                "text": "„Da er nicht bigott sein wollte, war er anstößig; um seine Zuhörer zum Lachen zu bringen, erzählte er die unflätigsten Zoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "984cb743-9a6b-3bac-8c72-cb60a8831dc7",
                                        "entry_id": "8446d73b-e8de-3330-823a-f026f4c7c42f",
                                        "glosses": [
                                            "scheinheilig, heuchlerisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f3331d-8631-4c31-b1c7-170349ee4d1d",
                                                "sense_id": "984cb743-9a6b-3bac-8c72-cb60a8831dc7",
                                                "text": "Sie sind eine bigotte Familie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
