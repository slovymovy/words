                ],
                "senses": [
                    {
                        "sense_id": "e823f5ce-ec71-387b-997f-6a5d6f0488bc",
                        "entry_id": "e0123def-a442-35cb-8f5a-b4d0c80cb613",
                        "glosses": [
                            "Résistant à l'occupation allemande entre 1940 et 1945, membre d'un maquis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c324b9-4dca-4188-b5ff-f315d99307a6",
                                "sense_id": "e823f5ce-ec71-387b-997f-6a5d6f0488bc",
                                "text": "Tout le village où j'étais instituteur était au courant, jamais un maquisard n'a été victime d'une dénonciation."
                            }
                        ]
                    },
                    {
                        "sense_id": "6525d7a7-08ac-37a4-8a30-9fe051c4ead1",
                        "entry_id": "e0123def-a442-35cb-8f5a-b4d0c80cb613",
                        "glosses": [
                            "Combattant d'un groupe de résistance armée, soldat d'une guérilla."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2d2c16ec-0ee9-42f5-bb45-3e731d812324",
                                "sense_id": "6525d7a7-08ac-37a4-8a30-9fe051c4ead1",
                                "text": "Moi qui avais été dans la Résistance dès 1940, je ne pouvais pas supporter qu'on traite les maquisards algériens de salopards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f53bc89-b153-4d7d-a2ae-cfd8567b0de3",
                        "source_entry_id": "e0123def-a442-35cb-8f5a-b4d0c80cb613",
                        "target_lang_word": "Maquisard",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4769c4cf-ce21-4452-8761-c0c10e75724d",
                        "source_entry_id": "e0123def-a442-35cb-8f5a-b4d0c80cb613",
                        "target_lang_word": "französische(r) Partisan(in)",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d44dc4e6-64e3-468c-8007-83663bc489a7",
                        "source_entry_id": "e0123def-a442-35cb-8f5a-b4d0c80cb613",
                        "target_lang_word": "Widerstandskämpfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerstandskämpfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f447844-56e7-3f57-acf5-6d2a7a9d6fd1",
                                        "entry_id": "fe1b4fed-f150-37ae-96c7-560ac4e99eca",
                                        "glosses": [
                                            "zu einer Widerstandsbewegung gehörende (männliche^☆) Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8e4df71-e725-4b34-a262-284f4b0fdabc",
                                                "sense_id": "5f447844-56e7-3f57-acf5-6d2a7a9d6fd1",
                                                "text": "„Dieser andere Nachfolgestaat des „Dritten Reiches\" wollte den Glauben an die fortwirkende Gegenwart all jener Widerstandskämpfer gegen den Nationalsozialismus monumentalisieren, die einen Steinwurf entfernt, im ehemaligen Konzentrationslager Buchenwald, unter den Schergen Hitlers, Himmlers oder Sauckels litten und starben, wie die früheren Parteiführer Ernst Thälmann (KPD) und Rudolf Breitscheid (SPD) oder 51000 andere Tote der Jahre 1937 bis 1945.“"
                                            },
                                            {
                                                "example_id": "1775ea7e-3f2e-4e68-892d-0cf6f5b00b98",
                                                "sense_id": "5f447844-56e7-3f57-acf5-6d2a7a9d6fd1",
                                                "text": "„Kölns Regierungspräsident Jürgen Roters (SPD) jedenfalls ist der Erste in diesem Amt, der die „Edelweißpiraten“ als Widerstandskämpfer gewürdigt hat; lange galten die Jugendlichen als kriminelle Rabauken.“"
                                            },
                                            {
                                                "example_id": "7c8f0f7c-3ed5-433a-ab22-56410871d503",
                                                "sense_id": "5f447844-56e7-3f57-acf5-6d2a7a9d6fd1",
                                                "text": "„Eine militärische Auseinandersetzung wie die im Gazastreifen verwischt die Trennlinie zwischen Krieg und Verbrechen - wenn sie sich in einer so dicht bevölkerten Region abspielt, sind Widerstandskämpfer und Zivilbevölkerung nicht mehr zu unterscheiden.“"
                                            },
                                            {
                                                "example_id": "6ed7750e-9725-407c-8bd5-66d5889592a8",
                                                "sense_id": "5f447844-56e7-3f57-acf5-6d2a7a9d6fd1",
                                                "text": "„Der französische Widerstandskämpfer Stéphane Hessel überlebte drei Konzentrationslager und erarbeitete die Uno-Menschenrechtscharta.“"
                                            },
                                            {
                                                "example_id": "332f7fde-9d9c-46c1-a8fe-d7d3245c56fa",
                                                "sense_id": "5f447844-56e7-3f57-acf5-6d2a7a9d6fd1",
                                                "text": "„Unter den Getöteten waren neben den bekannten Terroristen auch viele Zivilisten und pakistanische Widerstandskämpfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
