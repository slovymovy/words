                                "sense_id": "195d7f10-2efd-3452-a48c-7b533f0d9d27",
                                "text": "Hij is immer beleefd tegen iedereen.",
                                "translation": "He is always polite to everyone.",
                                "english": "He is always polite to everyone."
                            },
                            {
                                "example_id": "dd437401-8df8-4d8a-9a91-4c43b72afd02",
                                "sense_id": "195d7f10-2efd-3452-a48c-7b533f0d9d27",
                                "text": "Het museum is immer geopend, zelfs op feestdagen.",
                                "translation": "The museum is open always, even on holidays.",
                                "english": "The museum is open always, even on holidays."
                            }
                        ]
