                        "form": "die Biogasproduktion"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                        "entry_id": "d2692fe5-6c8e-31b1-89a5-64fdbf781bad",
                        "glosses": [
                            "Herstellung/Produktion von Methan durch Vergärung von Pflanzen, pflanzlichen und tierischen Abfällen oder Faulschlamm"
                        ],
                        "tags": [
                            "Energie"
                        ],
                        "examples": [
                            {
                                "example_id": "caf4c9c3-3e3d-464b-aa8d-d68c5bae4f53",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Die Biogasproduktion erfordert große Flächen für den Anbau von Mais“ […]."
                            },
                            {
                                "example_id": "1dfbb29f-b587-426a-a490-2b3b08f8c7e7",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Die Biogasproduktion nahm von 14 Petajoule im Jahr 1995 auf 66 Petajoule im Jahr 2006 zu. Zum Vergleich: Der gesamte Mineralölverbrauch in Deutschland betrug 5179 Petajoule im Jahr 2006.“"
                            },
                            {
                                "example_id": "af22e832-ae84-46a8-9321-7f9fbe8403c0",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Organische Abfälle können als Ausgangsstoff zur Biogasproduktion genutzt werden.“"
                            },
                            {
                                "example_id": "939ffc53-1f3c-427e-b40e-8ea3650c7443",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Im Jahr 2014 entsprach die Biogasproduktion in Deutschland etwa 20 % der damaligen Erdgasimporte aus Russland.“"
                            },
                            {
                                "example_id": "c01e6c8f-1934-4e1f-9e67-963c52cccc5f",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Die Biogasproduktion rechnet sich nicht mehr, die Zeiten garantierter Traumrenditen sind vorbei.“"
                            },
                            {
                                "example_id": "7dcee747-127c-44db-a8cd-7cb57842ed43",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„70 % der Wärmeenergie dieser Fernwärme stammt aus der Biogasproduktion.“"
                            },
                            {
                                "example_id": "e67969bb-aef8-4815-8968-81130329b8a8",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Das Ziel der Regierung ist es, die Biogasproduktion in Österreich deutlich auszubauen.“"
                            },
                            {
                                "example_id": "a03a20d3-c2ed-4e15-9256-e7357397936d",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Kritiker befürchten bei einer erhöhten Biogasproduktion, dass immer mehr Mais angebaut würde und somit die Gefahr von Maismonokulturen wachse – was schlecht für Insekten und andere Tiere ist.“"
                            },
                            {
                                "example_id": "9d225815-0581-4a83-aeaf-55a61d34a8b3",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "„Die Silphie ist eine gelb blühende Feldpflanze. Sie bietet nicht nur Nahrung für Insekten, sondern könnte sogar die Biogasproduktion revolutionieren.“"
                            },
                            {
                                "example_id": "6cc71234-3341-4bd3-8c35-774085eb4df6",
                                "sense_id": "195d7ede-9a6e-3adc-a9cf-91fdb22555b9",
                                "text": "[Schlagzeile:] „Biogasproduktion verbessern: Dresdner Forschende entdecken neue Bakterienordnung der Gärung“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
