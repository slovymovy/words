    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3aef128-1cef-3505-8663-960714761638",
                    "sense_definition": "Een verbasterde vorm van een woord of begrip die door verkeerd gebruik of vervorming is ontstaan.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "taalkundige-vervorming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord kermis is eigenlijk een <w>verbastering</w> van het oorspronkelijke woord kerkmis.",
                            "target_lang_translations": {
                                "en": "The word 'kermis' is actually a <w>corruption</w> of the original word 'kerkmis'.",
                                "ru": "Слово kermis (ярмарка) на самом деле является <w>искажением</w> исходного слова kerkmis (церковная месса)."
                            }
                        },
                        {
                            "text": "Veel moderne plaatsnamen zijn een vreemde <w>verbastering</w> van historische benamingen.",
                            "target_lang_translations": {
                                "en": "Many modern place names are a strange <w>distortion</w> of historical names.",
                                "ru": "Многие современные названия мест представляют собой странное <w>искажение</w> исторических наименований."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervorming",
                        "corruptie"
                    ],
                    "common_phrases": [
                        "een verbastering van"
                    ],
                    "target_lang_definitions": {
                        "en": "A corrupted or distorted form of a word or concept that has arisen through misuse or alteration over time.",
                        "ru": "Искаженная форма слова или понятия, возникшая в результате неправильного использования или изменения."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "corruption",
                                "target_lang_sense_clarification": "of a word or language"
                            },
                            {
                                "target_lang_word": "bastardization",
                                "target_lang_sense_clarification": "of a word or term"
                            },
                            {
                                "target_lang_word": "distortion",
                                "target_lang_sense_clarification": "linguistic alteration"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "искажение",
                                "target_lang_sense_clarification": "о слове или понятии"
                            },
                            {
                                "target_lang_word": "видоизменение",
                                "target_lang_sense_clarification": "языковая форма"
                            },
                            {
                                "target_lang_word": "испорченная форма",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96959357-500f-30c5-a449-0ee3faf8d278",
                    "sense_definition": "Het proces of resultaat waarbij iets zijn oorspronkelijke, wezenlijke kenmerken of kwaliteit verliest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kwaliteitsverlies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De commercialisering van deze traditionele feestdag leidde tot een betreurenswaardige <w>verbastering</w> van de cultuur.",
                            "target_lang_translations": {
                                "en": "The commercialization of this traditional holiday led to a regrettable <w>bastardization</w> of the culture.",
                                "ru": "Коммерциализация этого традиционного праздника привела к прискорбному <w>вырождению</w> культуры."
                            }
                        },
                        {
                            "text": "Zonder streng toezicht op de receptuur treedt er snel een <w>verbastering</w> van het klassieke gerecht op.",
                            "target_lang_translations": {
                                "en": "Without strict supervision of the recipe, a <w>dilution</w> of the classic dish quickly occurs.",
                                "ru": "Без строгого контроля за рецептурой быстро происходит <w>искажение</w> классического блюда."
                            }
                        }
                    ],
                    "synonyms": [
                        "degeneratie",
                        "verwatering",
                        "verval"
                    ],
                    "antonyms": [
                        "behoud",
                        "zuivering"
                    ],
                    "common_phrases": [
                        "verbastering van cultuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The process or result of something losing its original, essential characteristics, purity, or quality.",
                        "ru": "Процесс или результат утраты чем-либо своих первоначальных, существенных характеристик или качества."
                    },
                    "translations": {
