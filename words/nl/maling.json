{
    "word_family": [
        "malen",
        "molen",
        "afmaling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c2533e2-bebf-3c01-914a-7f33450da79b",
                    "sense_definition": "grap of voor de gek houderij, vrijwel uitsluitend in de uitdrukking 'in de maling nemen'",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Neem je me nou in de <w>maling</w> of meen je dit echt?",
                            "target_lang_translations": {
                                "fr": "Tu <w>me fais marcher</w> ou tu es sérieux ?"
                            }
                        },
                        {
                            "text": "Hij had niet door dat zijn vrienden hem in de <w>maling</w> namen.",
                            "target_lang_translations": {
                                "fr": "Il ne se rendait pas compte que ses amis <w>se payaient sa tête</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "de maling",
                        "fopperij"
                    ],
                    "common_phrases": [
                        "in de maling nemen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "veelgebruikt in informele spreektaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Plaisanterie ou fait de se moquer de quelqu'un, presque exclusivement dans l'expression « in de maling nemen » (faire marcher, faire tourner en bourrique)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "faire marcher",
                                "target_lang_sense_clarification": "dans l'expression 'in de maling nemen'"
                            },
                            {
                                "target_lang_word": "se payer la tête de",
                                "target_lang_sense_clarification": "familier, dans l'expression 'in de maling nemen'"
                            },
                            {
                                "target_lang_word": "mener en bateau",
                                "target_lang_sense_clarification": "dans l'expression 'in de maling nemen'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7665fcf-5b2b-38ce-b2a2-b08a5087889a",
                    "sense_definition": "de wijze waarop of de fijnheid waarmee iets fijngemalen is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor deze filterkoffie heb je een fijne <w>maling</w> nodig.",
                            "target_lang_translations": {
                                "fr": "Pour ce café filtre, il vous faut une <w>mouture</w> fine."
                            }
                        },
                        {
                            "text": "Heeft u deze koffiebonen ook in een grove <w>maling</w> beschikbaar?",
                            "target_lang_translations": {
                                "fr": "Avez-vous aussi ces grains de café disponibles en <w>mouture</w> grossière ?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fijne maling",
                        "grove maling"
                    ],
                    "target_lang_definitions": {
                        "fr": "Degré ou finesse de broyage d'un produit (notamment le café)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "mouture",
                                "target_lang_sense_clarification": "finesse ou résultat du broyage, p. ex. café"
                            },
                            {
                                "target_lang_word": "broyage",
                                "target_lang_sense_clarification": "action ou degré de réduction en poudre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c63f522f-9a78-3da3-9149-4a5cefaf2839",
                    "sense_definition": "de richting of ruimte waarin een molen of werktuig maalt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "malen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De molenaar controleerde de juiste <w>maling</w> van het waterrad.",
                            "target_lang_translations": {
                                "fr": "Le meunier a vérifié la bonne <w>rotation</w> de la roue à aubes."
                            }
                        },
                        {
                            "text": "Door de verkeerde <w>maling</w> liep het raderwerk van de molen vast.",
                            "target_lang_translations": {
                                "fr": "En raison d'un mauvais <w>engrenage</w>, le mécanisme du moulin s'est bloqué."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Sens ou mécanisme de rotation et de fonctionnement d'un moulin ou d'une roue."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rotation",
                                "target_lang_sense_clarification": "mouvement de rotation d'un moulin"
                            },
                            {
                                "target_lang_word": "engrenage",
                                "target_lang_sense_clarification": "fonctionnement mécanique d'un moulin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}