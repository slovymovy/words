{
    "word_family": [
        "avenue",
        "revenue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e9046b2-e63f-3aec-a70f-b7529fd8d74d",
                    "sense_definition": "The specific place where an event, meeting, or activity happens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel was the perfect <w>venue</w> for our annual business conference.",
                            "target_lang_translations": {
                                "ru": "Отель был идеальным <w>местом проведения</w> нашей ежегодной бизнес-конференции.",
                                "zh": "这家酒店是我们年度商务会议的理想<w>举办地点</w>。"
                            }
                        },
                        {
                            "text": "They are still looking for a suitable wedding <w>venue</w> that fits their budget.",
                            "target_lang_translations": {
                                "ru": "Они все еще ищут подходящую свадебную <w>площадку</w>, которая вписывается в их бюджет.",
                                "zh": "他们仍在寻找一个符合预算的合适婚礼<w>场地</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedding venue",
                        "perfect venue",
                        "suitable venue",
                        "change of venue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное место, где происходит мероприятие, встреча или деятельность.",
                        "zh": "举办活动、会议或特定活动的具体地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место проведения",
                                "target_lang_sense_clarification": "мероприятия или встречи"
                            },
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "для проведения событий"
                            },
                            {
                                "target_lang_word": "место встречи",
                                "target_lang_sense_clarification": "где люди собираются"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "举办地点",
                                "target_lang_sense_clarification": "用于会议或活动"
                            },
                            {
                                "target_lang_word": "场地",
                                "target_lang_sense_clarification": "用于举办各类活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1198bfb8-e7c9-3621-bf43-d3b7381bb8b1",
                    "sense_definition": "A building or area such as a theater, stadium, or arena used for entertainment or sports.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new sports <w>venue</w> can hold over fifty thousand cheering fans.",
                            "target_lang_translations": {
                                "ru": "Новый спортивный <w>объект</w> может вместить более пятидесяти тысяч ликующих болельщиков.",
                                "zh": "这座新的体育<w>场馆</w>可以容纳超过五万名欢呼的球迷。"
                            }
                        },
                        {
                            "text": "This music <w>venue</w> is famous for hosting legendary rock bands in the seventies.",
                            "target_lang_translations": {
                                "ru": "Эта музыкальная <w>площадка</w> знаменита тем, что в семидесятых здесь выступали легендарные рок-группы.",
                                "zh": "这家音乐<w>演出场所</w>因在七十年代接待过传奇摇滚乐队而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "music venue",
                        "sports venue",
                        "entertainment venue",
                        "concert venue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание или территория, такая как театр, стадион или арена, используемая для развлечений или спорта.",
                        "zh": "用于娱乐或体育活动的建筑或区域，如剧院、体育场或竞技场。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "концертная или спортивная"
                            },
                            {
                                "target_lang_word": "заведение",
                                "target_lang_sense_clarification": "развлекательное место"
                            },
                            {
                                "target_lang_word": "объект",
                                "target_lang_sense_clarification": "спортивный или культурный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "场馆",
                                "target_lang_sense_clarification": "体育或文化设施"
                            },
                            {
                                "target_lang_word": "演出场所",
                                "target_lang_sense_clarification": "用于音乐或表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b27b4d13-50a1-3eb1-bac0-096fd6691604",
                    "sense_definition": "The jurisdiction or specific county where a legal trial or action takes place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer requested a change of <w>venue</w> to ensure a fair trial for his client.",
                            "target_lang_translations": {
                                "ru": "Адвокат запросил <w>перенос дела</w> в другой суд, чтобы обеспечить справедливое разбирательство для своего клиента.",
                                "zh": "律师申请变更<w>审判地</w>，以确保其当事人能得到公正的审判。"
                            }
                        },
                        {
                            "text": "The court must determine if this is the proper <w>venue</w> for the lawsuit.",
                            "target_lang_translations": {
                                "ru": "Суд должен определить, является ли это надлежащим <w>местом рассмотрения</w> данного иска.",
                                "zh": "法院必须确定这里是否为该诉讼的适当<w>审判地</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "change of venue",
                        "proper venue",
                        "legal venue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юрисдикция или конкретный округ, где проходит судебный процесс или действие.",
                        "zh": "法律诉讼或审判发生的管辖区或特定地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место рассмотрения дела",
                                "target_lang_sense_clarification": "в суде"
                            },
                            {
                                "target_lang_word": "территориальная подсудность",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "审判地",
                                "target_lang_sense_clarification": "法律管辖地点"
                            },
                            {
                                "target_lang_word": "管辖法院",
                                "target_lang_sense_clarification": "法律术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
