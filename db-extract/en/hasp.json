                                "target_senses": [
                                    {
                                        "sense_id": "7ed6d1a8-1a40-3b6b-af75-7840788dd639",
                                        "entry_id": "89e15d7b-419a-3518-8283-01b74a0ad056",
                                        "glosses": [
                                            "Sorte de fermeture très simple que l’on met aux portes qui n’ont pas de serrure et à celles dont le pêne est dormant. Il est constitué uniquement d'une clenche mobile autour d'un axe"
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "681dbded-b2db-4b38-aadc-326f084748fd",
                                                "sense_id": "7ed6d1a8-1a40-3b6b-af75-7840788dd639",
                                                "text": "L’aventurier tourna tout autour comme un loup affamé autour d’un parc, et, appliquant son œil à l’une des ouvertures, vit des choses qui le décidèrent apparemment, car, sans hésiter, il poussa la porte chancelante, que ne fermait pas même un faible loquet."
                                            },
                                            {
                                                "example_id": "91d78e59-8bca-4376-bcbd-22144176685c",
                                                "sense_id": "7ed6d1a8-1a40-3b6b-af75-7840788dd639",
                                                "text": "Sitôt qu’elle avait repassé, il se soulevait de son siège, se traînait vers la porte et, plein de hargne, les lèvres serrées, d’un coup d’index autoritaire, vlan ! poussait le loquet."
                                            },
                                            {
                                                "example_id": "927eb9a9-0d07-4dd9-9d25-31e457f6298e",
                                                "sense_id": "7ed6d1a8-1a40-3b6b-af75-7840788dd639",
                                                "text": "[…] il remarqua que la porte de dehors n’était fermée qu’au loquet alors que, la veille au soir, il était sûr d’avoir poussé le verrou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f332948-7701-3aed-b90a-075ee89dd369",
                                        "entry_id": "89e15d7b-419a-3518-8283-01b74a0ad056",
                                        "glosses": [
                                            "Barre de métal utilisée pour fermer une écoutille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2eb19944-9409-3a04-a5bf-19fca717c604",
                                        "entry_id": "89e15d7b-419a-3518-8283-01b74a0ad056",
                                        "glosses": [
                                            "Laine de basse qualité que l'on prélève sur les cuisses des moutons et qui servait à la confection de bourre pour les matelas."
                                        ],
