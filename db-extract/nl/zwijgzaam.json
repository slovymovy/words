                "senses": [
                    {
                        "sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
                        "entry_id": "cf8b00c0-fa02-349c-868e-997817934227",
                        "glosses": [
                            "weinig sprekend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab6bf238-813e-49f9-84ef-892db743de41",
                                "sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
                                "text": "Na de dood van haar vader is ze erg zwijgzaam geworden."
                            },
                            {
                                "example_id": "728da7f7-b5df-4131-9cc1-fc0d0373041c",
                                "sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
                                "text": "Niet dat hij een zwijgzaam publiek was, want hij viel haar regelmatig in de rede met vragen: Is dat de Amy bij wie je in Londen hebt gelogeerd? Waarom wilde je juist geschiedenis studeren? Rebecca vond het niet langer vervelend dat hij zo nieuwsgierig was."
                            },
                            {
                                "example_id": "a5541841-b41d-4e9a-b3d8-65b21c938254",
                                "sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
                                "text": "Terwijl ik de belevenissen van de dag in mijn schrift noteer, zit Bart zwijgzaam naast me."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5627e60b-e391-49e2-b6af-d07e5f1a43b8",
                        "source_entry_id": "cf8b00c0-fa02-349c-868e-997817934227",
                        "source_sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
                        "source_sense_description": "weinig sprekend",
                        "target_lang_word": "schweigsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schweigsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17b4bd70-f11f-308b-82e7-7ff2e47bc326",
                                        "entry_id": "c82734be-542f-3a39-ac2a-54f5d230f028",
                                        "glosses": [
                                            "wenig redend, nicht zum Sprechen aufgelegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072a3dd8-7042-44d8-b65a-dd498e279fec",
                                                "sense_id": "17b4bd70-f11f-308b-82e7-7ff2e47bc326",
                                                "text": "Er ist heute so schweigsam, es geht ihm wohl nicht so gut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "977be463-95df-4449-9211-7bd43e66e5d1",
                        "source_entry_id": "cf8b00c0-fa02-349c-868e-997817934227",
                        "source_sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
                        "source_sense_description": "weinig sprekend",
                        "target_lang_word": "taciturn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taciturn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abd80216-3c24-3771-a801-f3fd327669b3",
                                        "entry_id": "5a2ff70e-9b0d-3a33-ac5a-081c8e191013",
                                        "glosses": [
                                            "Silent; temperamentally untalkative; disinclined to speak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd5d41c-c3e0-481a-88ba-de9d20c19b0a",
                                                "sense_id": "abd80216-3c24-3771-a801-f3fd327669b3",
                                                "text": "The two sisters could hardly have been more different, one so boisterous and expressive, the other so taciturn and calm."
                                            },
                                            {
                                                "example_id": "79888a4d-34f5-47de-8133-c575f042ebe4",
                                                "sense_id": "abd80216-3c24-3771-a801-f3fd327669b3",
                                                "text": "We are each of an unsocial, taciturn disposition, unwilling to speak, unless we expect to say something that will amaze the whole room, and be handed down to posterity with all the eclat of a proverb."
                                            },
                                            {
                                                "example_id": "d1575b2d-59e5-4796-96b4-ea0bb39d510e",
                                                "sense_id": "abd80216-3c24-3771-a801-f3fd327669b3",
                                                "text": "We spent a lot of time up on the staging of the great furnaces, trying to pick up the tricks of the trade from the taciturn furnacemen who sat around placidly smoking, or chewing twist, and occasionally throwing in more pig iron to the molten white-hot metal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "899557a7-38c0-4e2e-8360-2572801b1ea6",
                        "source_entry_id": "cf8b00c0-fa02-349c-868e-997817934227",
                        "source_sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
