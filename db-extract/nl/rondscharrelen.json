                                "example_id": "72e8aa60-f7d0-4bc7-9588-552b24a372b5",
                                "sense_id": "6d21be3c-80a7-3d38-b34b-346bd6d76a58",
                                "text": "Er zaten ratten daar beneden. We konden ze horen rondscharrelen.",
