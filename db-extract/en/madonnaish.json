                        "examples": [
                            {
                                "example_id": "d87fa5b5-878e-44cc-a344-84290c3e15eb",
                                "sense_id": "ae22a0c5-31af-3e1f-9939-d4a9fee8da29",
                                "text": "She is too Madonnaish in one way, too languishing and sentimental in another: […]"
                            },
                            {
                                "example_id": "c69282fa-4711-481d-acae-a663bd6770f9",
                                "sense_id": "ae22a0c5-31af-3e1f-9939-d4a9fee8da29",
                                "text": "“Raise the hands, Miss Cherrell. No! Too Madonnaish. We must think of the devil in the hair. The eyes to me, full.”"
                            },
                            {
                                "example_id": "41c580a5-52d3-49a8-a24e-dc8493e094a5",
                                "sense_id": "ae22a0c5-31af-3e1f-9939-d4a9fee8da29",
                                "text": "The more Madonnaish the women, the more daddish and less caddish the men, and thus the more Madonnaish the women, and so on."
                            }
                        ]
                    }
