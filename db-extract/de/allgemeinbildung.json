                ],
                "senses": [
                    {
                        "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                        "entry_id": "8a742b6a-f639-35b1-9f24-af48c4841f43",
                        "glosses": [
                            "grundlegende Bildung, die nicht fachlich orientiert ist; erworbenes Allgemeinwissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61e00b8-480a-4775-87c3-580fb4ccb3ff",
                                "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                                "text": "Die Allgemeinbildung der Bevölkerung ist flächendeckend gut."
                            },
                            {
                                "example_id": "2c15c096-658a-4f35-8a04-f83474f4cd9a",
                                "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                                "text": "Mein Mathe-Professor hat eine so gute Allgemeinbildung, dass er glatt den Professor aus den Biologie-Lesungen ersetzen könnte, obwohl er dieses Fach nie studiert hat."
                            },
                            {
                                "example_id": "d6eb8507-b2c9-4942-8d84-7593da05bace",
                                "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                                "text": "Mein Telefonjoker hat eine sehr gute Allgemeinbildung."
                            },
                            {
                                "example_id": "738e654a-5231-4772-b8da-cfd3fce2ef41",
                                "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                                "text": "„Doch neben fundiertem Sprachwissen seien auch ein hohes Maß an Allgemeinbildung, Kreativität und kulturelle Kompetenz von ausdrücklicher Bedeutung.“"
                            },
                            {
                                "example_id": "0581366f-a5f5-4959-97aa-0f46b58722de",
                                "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                                "text": "„Kurzum, seine Allgemeinbildung war geeignet, ihn zu Recht zu einer bemerkenswerten Person an Bord eines Schiffs zu machen.“"
                            },
                            {
                                "example_id": "e917f9bc-11a6-4de2-9eab-80c133239092",
                                "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                                "text": "„Ihr dämmerte, der von ihr geangelte himmelhochjauchzende Liebhaber war nicht gerade eine Leuchte der Allgemeinbildung, nicht zu reden von Philosophie und Literatur.“"
                            },
                            {
                                "example_id": "fa9dfe3b-b5ac-436a-a3c9-be74427a30f1",
                                "sense_id": "c723ebcd-32e4-3a46-a816-ac61ca239f56",
                                "text": "„Vielmehr lernte er in dem Institut lediglich, was zur Allgemeinbildung der Zeit und zur Vorbereitung für die Universität nötig war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bab158a0-8b0f-4921-b385-8547b30b2327",
