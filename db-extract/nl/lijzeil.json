                        "target_lang_word": "bonnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b47bc2-c6db-399c-85be-0db9a689c242",
                                        "entry_id": "a0150928-62a8-33b5-9e76-7a3a3da1a6f1",
                                        "glosses": [
                                            "Petite voile supplémentaire utilisée pour augmenter la surface de la voilure par vent faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00bc6c5-6a97-4150-b80d-89584149e77b",
                                                "sense_id": "c2b47bc2-c6db-399c-85be-0db9a689c242",
                                                "text": "Le capitaine espagnol […] essaya de faire mettre promptement toutes ses bonnettes hautes et basses, tribord et bâbord, pour présenter au vent l’entière surface de toile qui garnissait ses vergues."
                                            },
                                            {
                                                "example_id": "ebda24fb-b0df-4a92-96e9-aefb82a38dc6",
                                                "sense_id": "c2b47bc2-c6db-399c-85be-0db9a689c242",
                                                "text": "On installa sur les haubans des sortes de bonnettes au moyen de vêtements, de fourrures, de tout ce qui pouvait donner prise au vent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed15c998-5a40-3d1d-9e9b-0b9b8276226e",
                                        "entry_id": "a0150928-62a8-33b5-9e76-7a3a3da1a6f1",
                                        "glosses": [
                                            "Lentille supplémentaire ajoutée à un objectif, vissée devant l’élément frontal, à la manière d’un filtre et ayant pour but de faire varier la distance focale."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d40452c-e1b1-4f81-be6d-25613a3e4d45",
                                                "sense_id": "ed15c998-5a40-3d1d-9e9b-0b9b8276226e",
                                                "text": "Les bonnettes les plus courantes sont les bonnettes macro, qui augmentent le rapport de reproduction d’un objectif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b019d3c-6c12-3955-b746-ea7ac30daffd",
                                        "entry_id": "a0150928-62a8-33b5-9e76-7a3a3da1a6f1",
                                        "glosses": [
                                            "Filtre coloré ajouté à l'oculaire d'une lunette ou d'un télescope pour permettre l'observation du soleil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d1c6508-c3b8-3ae7-97c2-598c02e109b6",
                                        "entry_id": "a0150928-62a8-33b5-9e76-7a3a3da1a6f1",
                                        "glosses": [
                                            "Protection placée sur un microphone pour limiter la captation des bruits de la pluie et du vent."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa7c43c-3701-4b19-b9d9-3338a4e69ce4",
                                                "sense_id": "8d1c6508-c3b8-3ae7-97c2-598c02e109b6",
                                                "text": "La paluche reposait dans l’une des poches, dont le cuir était découpé à la place de l’objectif. William avait ceint ce dernier d’une bonnette poilue pour faire croire qu’il s’agissait d’un micro."
                                            },
                                            {
                                                "example_id": "b40733f9-76b1-4647-b6ad-fed7bd442789",
                                                "sense_id": "8d1c6508-c3b8-3ae7-97c2-598c02e109b6",
                                                "text": "Deux micros (bonnette antivent fournie) gèrent la captation audio en stéréo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eaeb306-49c3-369c-82e7-f344114a3671",
                                        "entry_id": "a0150928-62a8-33b5-9e76-7a3a3da1a6f1",
                                        "glosses": [
                                            "Type de bastion sommaire de deux faces en forme de V, avec parapet et palissade au devant, construit lors d’un siège. La bonnette est un ouvrage très bas, construit à l’extrémité des angles saillants et rentrants d’un glacis dont elle défend les approches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
