                ],
                "senses": [
                    {
                        "sense_id": "d6c5522e-c88a-3692-a985-5490aef5a93d",
                        "entry_id": "bc9bcd1b-3051-394d-bdf9-86e70f48b723",
                        "glosses": [
                            "eine Ausbesserungshilfe für Autokarosserien und oberflächenbehandelte Bauteile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18fcc1c-817d-4b82-8448-6fc9fca2b98f",
                                "sense_id": "d6c5522e-c88a-3692-a985-5490aef5a93d",
                                "text": "„‚Dafür braucht man etwas Geduld und Geschick - und unter Umständen nicht einmal einen Lackstift‘, sagt Markus Herrmann, Präsident des Bundesverbands Fahrzeugaufbereitung (BFA).“"
                            },
                            {
                                "example_id": "053ed357-faa9-4903-bab4-ec57a41d2ee0",
                                "sense_id": "d6c5522e-c88a-3692-a985-5490aef5a93d",
                                "text": "„So einen Kratzer würde ich nicht einmal mit einem Lackstift ausbessern.“"
                            },
                            {
                                "example_id": "3c1b2cda-1761-496d-abb0-e8d44333771e",
                                "sense_id": "d6c5522e-c88a-3692-a985-5490aef5a93d",
                                "text": "„Ein paar Roststellen hatte er, die hab ich mit einem Lackstift überpinselt.“"
                            },
                            {
                                "example_id": "84daa562-2921-451a-8a1d-91393c38abd9",
                                "sense_id": "d6c5522e-c88a-3692-a985-5490aef5a93d",
                                "text": "„Ich nahm mir vor, Pünktchen nach Abschluss dieser Tour einen Lackstift zu schenken, falls es die Farbe überhaupt noch gab.“"
                            },
                            {
                                "example_id": "4d49e5a4-e1af-4751-b32f-7de6581254e8",
                                "sense_id": "d6c5522e-c88a-3692-a985-5490aef5a93d",
                                "text": "„Durch das offene Eingestehen einer Panne und das umgehende Nachbessern mit einem entsprechenden Lackstift entstehen dem Unternehmen sicherlich unwesentliche Kosten und Unannehmlichkeiten im Vergleich zu dem Risiko, den Kunden zu verärgern und in letzter Konsequenz gar zu verlieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48fad3fa-aad8-3c56-a1ca-aeabf752ba0a",
                        "entry_id": "bc9bcd1b-3051-394d-bdf9-86e70f48b723",
                        "glosses": [
                            "ein Markierschreibgerät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5087e3-11ef-4382-b4cf-5a853f97066a",
                                "sense_id": "48fad3fa-aad8-3c56-a1ca-aeabf752ba0a",
                                "text": "„Auch nicht, dass der damalige Sportstaatssekretär Karl Schweitzer die Förderung eigentlich gar nicht zusagen habe wollen und ein entsprechender Vertrag schließlich vom Sektionschef im Kanzleramt unterschrieben worden sein soll - nachdem das Papier mit Lackstift verändert worden war.“"
                            },
                            {
                                "example_id": "255b64d4-94ba-4474-8bf4-82bde792bb0c",
                                "sense_id": "48fad3fa-aad8-3c56-a1ca-aeabf752ba0a",
                                "text": "„Er gesteht Richterin Stephanie Öner unumwunden, dass ihn ein schwarzer Lackstift mit einer Anklage wegen schwerer Sachbeschädigung vor sie gebracht hat.“"
                            },
                            {
                                "example_id": "9f669a0c-368f-47b7-b628-a196d841a9a5",
                                "sense_id": "48fad3fa-aad8-3c56-a1ca-aeabf752ba0a",
                                "text": "„Wenn es irgendwie möglich ist, sollten Sie eine große Mülltüte und einen Lackstift dabei haben.“"
                            },
                            {
                                "example_id": "758281bb-95f1-4974-b9b5-0ccfb62176fc",
                                "sense_id": "48fad3fa-aad8-3c56-a1ca-aeabf752ba0a",
                                "text": "„Es hilft tatsächlich, kleine Kratzer mit einem schwarzen Lackstift vorsichtig zu füllen, um Lichtbrechungen am Kratzer zu reduzieren.“"
                            },
                            {
                                "example_id": "57ee27b9-0fba-424e-9992-5e80114e36ee",
                                "sense_id": "48fad3fa-aad8-3c56-a1ca-aeabf752ba0a",
                                "text": "„Mit einem weißen Lackstift das so entstandene Etikett beschriften.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
