{
    "word_family": [
        "crocodile",
        "crocodilian"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa246fd2-fbef-3bdb-aca8-f9c3eb356adf",
                    "sense_definition": "A lightweight foam clog-style shoe with ventilation holes and a heel strap.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to wear her pink <w>crocs</w> to the beach because they are easy to clean.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть свои розовые <w>кроксы</w> на пляж, потому что их легко мыть."
                            }
                        },
                        {
                            "text": "Many people prefer a foam <w>croc</w> for gardening because they are very comfortable.",
                            "target_lang_translations": {
                                "ru": "Многие предпочитают пенные <w>сабо</w> для работы в саду, потому что они очень удобные."
                            }
                        }
                    ],
                    "synonyms": [
                        "clog"
                    ],
                    "common_phrases": [
                        "foam croc",
                        "pair of crocs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used to refer to the brand or similar style shoes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая обувь типа сабо из вспененного материала с вентиляционными отверстиями и ремешком на пятке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроксы",
                                "target_lang_sense_clarification": "обувь бренда Crocs или аналогичного фасона"
                            },
                            {
                                "target_lang_word": "сабо",
                                "target_lang_sense_clarification": "тип обуви, к которому относятся кроксы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22c5deac-f1ba-3caf-8f71-bd8620252021",
                    "sense_definition": "A common informal shortening for a <w>crocodile</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tour guide warned us to stay away from the water's edge because of a large <w>croc</w> nearby.",
                            "target_lang_translations": {
                                "ru": "Гид предупредил нас держаться подальше от кромки воды, так как поблизости был большой <w>крокодил</w>."
                            }
                        },
                        {
                            "text": "We saw a saltwater <w>croc</w> basking in the sun during our boat trip through the mangroves.",
                            "target_lang_translations": {
                                "ru": "Во время прогулки на лодке по мангровым зарослям мы видели, как на солнце грелся гребнистый <w>крокодил</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "crocodile"
                    ],
                    "common_phrases": [
                        "saltwater croc",
                        "freshie croc"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Very common in Australian and African English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятое неформальное сокращение для слова «крокодил»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крокодил",
                                "target_lang_sense_clarification": "рептилия"
                            },
                            {
                                "target_lang_word": "крок",
                                "target_lang_sense_clarification": "сленговое сокращение названия животного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}