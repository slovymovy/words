                ],
                "senses": [
                    {
                        "sense_id": "4430dccd-e9f1-3260-ac93-0a4267950a81",
                        "entry_id": "4692e994-478b-3588-a167-3451a53f9c23",
                        "glosses": [
                            "młody człowiek zwykle pracujący w korporacji, zwykle wyborca liberalny, nieposiadający własnego zdania, lecz idący za tłumem, bezkrytycznie ufający popularnym mediom"
                        ],
                        "tags": [
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "47a3663e-3111-48fd-8f9b-c78ddc43695f",
                                "sense_id": "4430dccd-e9f1-3260-ac93-0a4267950a81",
                                "text": "Dla ludzi o liberalno-lewicowych poglądach konserwatywni prawicowcy będą zawsze „oszołomami”. Dla konserwatystów zaś liberałowie i lewacy – „lemingami”"
                            },
                            {
                                "example_id": "5fa02e9c-f940-4a07-a6b6-5d193df89f63",
                                "sense_id": "4430dccd-e9f1-3260-ac93-0a4267950a81",
                                "text": "Co do orientacji światopoglądowej lemingom zarzuca się ślepe poddaństwo Platformie Obywatelskiej"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2ab49ec-bb5f-4652-952f-81bff90de468",
                        "source_entry_id": "4692e994-478b-3588-a167-3451a53f9c23",
                        "source_sense_id": "4430dccd-e9f1-3260-ac93-0a4267950a81",
                        "target_lang_word": "sheeple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sheeple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0e26a24-da26-3587-a0b6-ce5d15b96340",
                                        "entry_id": "ccaf9100-a15a-33c6-9776-aa803da3ab4b",
                                        "glosses": [
                                            "People who unquestioningly accept as true whatever their political leaders say or who adopt popular opinion as their own without scrutiny."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "plural",
                                            "plural-only",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83da3bb2-e242-44b5-afb2-a738e719c4aa",
                                                "sense_id": "f0e26a24-da26-3587-a0b6-ce5d15b96340",
                                                "text": "War protesters . . . did appear along Mr. Rumsfeld's path carrying signs saying \"Bush is a Liar\" and \"Wake Up, Sheeple\"."
                                            },
                                            {
                                                "example_id": "3e5582a0-e869-4dd7-94fe-8ef66bdbc236",
                                                "sense_id": "f0e26a24-da26-3587-a0b6-ce5d15b96340",
                                                "text": "[F]ormer MP Garth Turner’s new book . . . is entitled Sheeple, a term apparently applied to people who often take on the characteristics—curly white hair covering most of the body, fondness for grazing, tendency to do as told—of sheep."
                                            },
                                            {
                                                "example_id": "5b6c9f2b-ec67-4daf-b6e8-35080aa96c05",
                                                "sense_id": "f0e26a24-da26-3587-a0b6-ce5d15b96340",
                                                "text": "Harmless vapour trails left by planes? That's what they want you to think, sheeple."
                                            },
                                            {
                                                "example_id": "730c3958-26a2-4174-a68b-911628c66e4d",
                                                "sense_id": "f0e26a24-da26-3587-a0b6-ce5d15b96340",
                                                "text": "He'll take himself down.\nYeah, history always proves that, right? Just wait for justice, you sheeple…"
                                            },
                                            {
                                                "example_id": "2a63d81d-f1cd-4dc4-86ea-8fc15d5511f1",
                                                "sense_id": "f0e26a24-da26-3587-a0b6-ce5d15b96340",
                                                "text": "Being a sheeple isn't always dangerous. A lot of the time it can just make a person look foolish, more than anything."
                                            },
                                            {
                                                "example_id": "632540b1-5e5a-44b5-b73e-ff3a4c8a1e69",
                                                "sense_id": "f0e26a24-da26-3587-a0b6-ce5d15b96340",
                                                "text": "I think it's the HYDRA, the group of whatevers that rule the world, those elitists that laugh at us, joke about their environmentalist sheeples doing their bidding while they sip the best wine on the planet, ride around in private jets, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
