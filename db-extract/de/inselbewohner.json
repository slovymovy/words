                        "form": "die Inselbewohner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e800c756-ec2c-3921-8290-4470f191c394",
                        "entry_id": "b4553db8-699c-3994-8475-00ce6590d7ea",
                        "glosses": [
                            "jemand, der auf einer Insel wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e238f42c-1f6f-4b82-80e6-f3dd78f40b2b",
                                "sense_id": "e800c756-ec2c-3921-8290-4470f191c394",
                                "text": "Vor der Durchführung des Atombombentests wurden die Inselbewohner in Sicherheit gebracht."
                            },
                            {
                                "example_id": "1282922e-4e25-44a1-ad87-749a8c30283d",
                                "sense_id": "e800c756-ec2c-3921-8290-4470f191c394",
                                "text": "„Es kam zu einer Prügelei, bei der sowohl Seeleute als auch Inselbewohner verletzt wurden.“"
                            },
                            {
                                "example_id": "b05dc24a-5dc2-4eb1-962a-198788244f9e",
                                "sense_id": "e800c756-ec2c-3921-8290-4470f191c394",
                                "text": "„In der Tat waren die Inselbewohner vor einigen Jahren mit einer neuen Fähre beschwichtigt worden.“"
                            },
                            {
                                "example_id": "3ee736b5-c8ec-40e8-abc2-8442c39d8534",
                                "sense_id": "e800c756-ec2c-3921-8290-4470f191c394",
                                "text": "„Wie so häufig bei Inselbewohnern hegen wir Isländer die größten Vorurteile gegenüber allen Neuerungen, nicht zuletzt, wenn es um Literatur geht.“"
                            },
                            {
                                "example_id": "68ca02dd-0811-499b-a5b3-d0f8f4539342",
                                "sense_id": "e800c756-ec2c-3921-8290-4470f191c394",
                                "text": "„So bekämpften sich die Inselbewohner häufig untereinander, Kannibalismus war, außer in Samoa, weit verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86cc4254-7887-40b2-9349-0ca230d1545a",
                        "source_entry_id": "b4553db8-699c-3994-8475-00ce6590d7ea",
                        "source_sense_id": "e800c756-ec2c-3921-8290-4470f191c394",
                        "source_sense_description": "jemand, der auf einer Insel wohnt",
                        "target_lang_word": "insulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6df3d8a3-6ad0-3a04-9155-5a64db841de4",
                                        "entry_id": "e2614a91-0c27-397f-b4fb-ff73df7b6419",
                                        "glosses": [
                                            "Habitant des îles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba539df-90d6-49ba-b4ce-dc3468008f37",
                                                "sense_id": "6df3d8a3-6ad0-3a04-9155-5a64db841de4",
                                                "text": "C’était un insulaire et un pêcheur hors pair, qui rapportait toujours plus de homards que les autres, et cela semblait une qualification suffisante."
                                            },
                                            {
                                                "example_id": "46f2bf62-8856-4e71-8227-f462d9cdf85c",
                                                "sense_id": "6df3d8a3-6ad0-3a04-9155-5a64db841de4",
                                                "text": "Les insulaires de la mer Pacifique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33df1f12-02b0-3fd4-8218-d205e493e948",
                                        "entry_id": "aa850ff0-76dc-3155-9d0e-b0efe621155c",
                                        "glosses": [
                                            "Relatif aux îles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ab6a39-f82b-43b5-bb2d-1f3def27ca9d",
                                                "sense_id": "33df1f12-02b0-3fd4-8218-d205e493e948",
                                                "text": "La sûreté du pays étant suffisamment garantie par sa position insulaire, l’action militaire n’y prit jamais une grande importance."
                                            },
                                            {
                                                "example_id": "096be736-852d-4f26-9c6c-b06fc28b5386",
                                                "sense_id": "33df1f12-02b0-3fd4-8218-d205e493e948",
                                                "text": "Bien qu'elle confine au cercle polaire, l’Islande est située presque entièrement dans la zone tempérée; on pourrait croire qu'elle jouit d'un climat insulaire et uniforme, grâce surtout à l'influence du Gulf-Stream qui adoucit la température de la Norwége ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e493144a-99c7-39c3-8902-c649b0cdc383",
                                        "entry_id": "aa850ff0-76dc-3155-9d0e-b0efe621155c",
                                        "glosses": [
                                            "Qui habite une île."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb2fe88-ce0d-4e4d-8b61-555b7189276b",
                                                "sense_id": "e493144a-99c7-39c3-8902-c649b0cdc383",
                                                "text": "L’endémisme est particulièrement développé dans trois sortes de flores : les flores isolées, les flores montagnardes, les flores insulaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
