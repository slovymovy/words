                        "sense_id": "2bfce7ee-fca8-367a-8c96-dbe7df6363f0",
                        "entry_id": "62818e95-3182-31dc-b3f2-60725e78ff97",
                        "glosses": [
                            "Se dit dʼune feuille palmée dont les lobes sont arrondis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68811901-d3bb-4d13-893d-620ecef0d857",
                                "sense_id": "2bfce7ee-fca8-367a-8c96-dbe7df6363f0",
                                "text": "Les feuilles sont isolées, simples, pétiolées, à limbe généralement palmilobé ou pennilobé; elles sont dépourvues de stipules."
                            },
                            {
                                "example_id": "654daec9-f87a-471a-9190-b605d161c45a",
                                "sense_id": "2bfce7ee-fca8-367a-8c96-dbe7df6363f0",
                                "text": "Elle est ordinairement lobée (feuilles palmilobée, palmifide, palmiparlite ou palmiséquée), ou composée (feuille composée-palmée), avec lobes ou folioles décroissant du sommet à la base."
                            }
                        ]
                    }
