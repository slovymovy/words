                "senses": [
                    {
                        "sense_id": "c62d7a5d-b87d-3b16-961f-75ecc6250224",
                        "entry_id": "ff064c67-e0cb-3750-9260-bb24e2cab232",
                        "glosses": [
                            "оптический прибор, очки без заушных дужек, держащиеся с помощью пружинки, защемляющей переносицу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7992d65d-1af2-4a48-aba3-98a27e82f826",
                                "sense_id": "c62d7a5d-b87d-3b16-961f-75ecc6250224",
                                "text": "Вошёл хирург, высокий, моложавый, рыжий, в белой шапочке, снял пенсне, молча наклонился над раной."
                            },
                            {
                                "example_id": "fd2e53c0-3873-415b-9c1c-bbc8968e6cf8",
                                "sense_id": "c62d7a5d-b87d-3b16-961f-75ecc6250224",
                                "text": "А то что же это? Пенсне треснуло… весь в рванине… Какой же он может быть переводчик у иностранца!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "565d5afb-397d-456d-a6dc-c1c83af9cae6",
                        "source_entry_id": "ff064c67-e0cb-3750-9260-bb24e2cab232",
                        "source_sense_id": "c62d7a5d-b87d-3b16-961f-75ecc6250224",
                        "target_lang_word": "pince-nez",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
