                ],
                "senses": [
                    {
                        "sense_id": "d9b7e326-f8e9-3afd-b064-8576d9bc4413",
                        "entry_id": "2d558b5d-b9a5-3d87-8c65-34635e3c78ff",
                        "glosses": [
                            "iemand die zich in een voor hem nieuw land vestigt of recentelijk heeft gevestigd, een inkomend landverhuizer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9651eaa6-b6bf-4e9c-a641-2f3695e4f5a3",
                                "sense_id": "d9b7e326-f8e9-3afd-b064-8576d9bc4413",
                                "text": "Vilhelm Moberg had het derde en laatste deel uitgebracht van zijn serie over emigranten die immigranten werden, De kolonisten."
                            },
                            {
                                "example_id": "1e455eb0-d681-4b8b-a6c1-35f3ff317430",
                                "sense_id": "d9b7e326-f8e9-3afd-b064-8576d9bc4413",
                                "text": "⧖ Neen, mijn Heer! ik ben geen Emigrant, maar een Immigrant, (dit is iemand die onder de menschen rond wandeld)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2d19e33-6b8c-4e75-857e-268c3f494b6c",
                        "source_entry_id": "2d558b5d-b9a5-3d87-8c65-34635e3c78ff",
                        "source_sense_id": "d9b7e326-f8e9-3afd-b064-8576d9bc4413",
                        "target_lang_word": "Immigrant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Immigrant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "000d349b-fe4f-3b42-a6a3-9dfd4ebe7565",
                                        "entry_id": "73b8d98c-a60d-3a7d-88fc-bd3b2fbc8035",
                                        "glosses": [
                                            "Einwanderer aus einem anderen Land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28856499-7599-4655-8c05-8ac236d25876",
                                                "sense_id": "000d349b-fe4f-3b42-a6a3-9dfd4ebe7565",
                                                "text": "In Deutschland leben viele Immigranten."
                                            },
                                            {
                                                "example_id": "2aca037e-b2f4-40da-9547-e887a758411c",
                                                "sense_id": "000d349b-fe4f-3b42-a6a3-9dfd4ebe7565",
                                                "text": "„So wird die American Wall Stück für Stück weiter gebaut mit dem Geld von Menschen, die alle Immigranten sind, abgesehen von ein paar findigen Indianern des Stammes Hũahũv.“"
                                            },
                                            {
                                                "example_id": "efce2303-0f85-49fa-8000-4bf5e307d2be",
                                                "sense_id": "000d349b-fe4f-3b42-a6a3-9dfd4ebe7565",
                                                "text": "„Donald Trump aber hält weiter an seinen Wahlversprechen fest, elf Millionen illegale Immigranten aus dem Land zu schaffen.“"
                                            },
                                            {
                                                "example_id": "7ad8e852-da3d-4570-aa60-e55a302d8d0d",
                                                "sense_id": "000d349b-fe4f-3b42-a6a3-9dfd4ebe7565",
                                                "text": "„Aber er formulierte in seinem Hieb auf die Immigranten und Kolonisten nur ein altes tschechisches Stereotyp.“"
                                            },
                                            {
                                                "example_id": "decdf233-02ed-4956-99a3-0685af63796a",
                                                "sense_id": "000d349b-fe4f-3b42-a6a3-9dfd4ebe7565",
                                                "text": "„Die Prohibition, Sumners Tugendwächtertrupp, die Feindseligkeit gegenüber den Immigranten, die Unterdrückung von anarchistischen und anderen »ausländischen« Ideen – all das waren aus Sylvias Sicht Aspekte ein und desselben grundsätzlichen Problems in Amerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bad6b30a-1d25-4133-9b65-65d9c5dab03b",
                        "source_entry_id": "2d558b5d-b9a5-3d87-8c65-34635e3c78ff",
                        "source_sense_id": "d9b7e326-f8e9-3afd-b064-8576d9bc4413",
                        "target_lang_word": "immigrant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immigrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d254ed1b-656a-34f6-8dee-ccf185bfdf85",
                                        "entry_id": "a6e78af1-abcb-3210-b916-2b0da37147a4",
                                        "glosses": [
                                            "A non-native person who comes to a country from another country to permanently settle there."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b689b6-51b4-4d0b-bbdf-e4d0deb1031f",
                                                "sense_id": "d254ed1b-656a-34f6-8dee-ccf185bfdf85",
                                                "text": "Approximately 1.5 million Mexicans are descendants of Irish immigrants."
                                            },
                                            {
                                                "example_id": "017f0c39-c906-42e7-84f4-4d3d67be3f5b",
                                                "sense_id": "d254ed1b-656a-34f6-8dee-ccf185bfdf85",
                                                "text": "What Alexis de Tocqueville saw in America was a society of immigrants, each of whom had begun life anew, on an equal footing. This was the secret of America: a nation of people with the fresh memory of old traditions who dared to explore new frontiers, people eager to build lives for themselves in a spacious society that did not restrict their freedom of choice and action."
                                            },
                                            {
                                                "example_id": "d7f61857-aa65-41d7-9d67-a5ac63df63ed",
                                                "sense_id": "d254ed1b-656a-34f6-8dee-ccf185bfdf85",
                                                "text": "The village was once well known for its paper-milling, founded by Huguenot immigrants in 1648, which produced high-quality hand-made paper until 1952."
                                            },
                                            {
                                                "example_id": "02ed0de9-0ab5-48b6-800b-7f1f26faf367",
                                                "sense_id": "d254ed1b-656a-34f6-8dee-ccf185bfdf85",
                                                "text": "However, an accompanied undocumented immigrant child should not be removed from his or her family , unless there are grounds for removal in terms of section 14(4) of the Child Care Act, 1983."
                                            },
                                            {
                                                "example_id": "c1a2ea07-9671-4254-8284-b92451db54df",
                                                "sense_id": "d254ed1b-656a-34f6-8dee-ccf185bfdf85",
                                                "text": "[Stephen] Miller’s uncle, a neuroscientist, has been welcomed onto the public stage for his denunciations of his nephew’s immigration policies, which the elder Miller has characterized as hypocritical: the Millers’ not-so-distant Jewish ancestors were, of course, immigrants themselves."
                                            },
                                            {
                                                "example_id": "52772fd5-f427-49f3-ab02-296d2b962f34",
                                                "sense_id": "d254ed1b-656a-34f6-8dee-ccf185bfdf85",
                                                "text": "Hamtramck is described in the resolution as “one of the most diverse cities in the United States.” The city has a large immigrant presence and all the city council members are of the Muslim faith, city manager Max Garbarino told CNN Thursday. Hamtramck was also the first known city in the US to inaugurate an all-Muslim government, CNN previously reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99be12f2-63cd-30b5-8d9c-114ffd5037ee",
                                        "entry_id": "a6e78af1-abcb-3210-b916-2b0da37147a4",
                                        "glosses": [
                                            "A plant or animal that establishes itself in an area where it previously did not exist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "immigrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf02601d-cee5-3e1f-8b3c-caee4e552854",
                                        "entry_id": "6a065326-facf-353a-a775-a0a0771b644c",
                                        "glosses": [
                                            "Of or relating to immigrants or the act of immigrating."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af562ef1-585c-4dda-84c3-2ec423b88787",
                        "source_entry_id": "2d558b5d-b9a5-3d87-8c65-34635e3c78ff",
                        "source_sense_id": "d9b7e326-f8e9-3afd-b064-8576d9bc4413",
                        "target_lang_word": "immigrant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immigrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3467e745-7ea0-3e18-be43-3816bfa345d3",
                                        "entry_id": "b931256a-2b96-3eab-ad8c-aebfd5aa7921",
                                        "glosses": [
                                            "Qui immigre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da81f0f2-41dd-4acc-a955-8e79ae938a5c",
                                                "sense_id": "3467e745-7ea0-3e18-be43-3816bfa345d3",
                                                "text": "Un Italien immigrant."
                                            },
                                            {
                                                "example_id": "6af0b31e-5228-4a05-bf67-890bdb8be994",
                                                "sense_id": "3467e745-7ea0-3e18-be43-3816bfa345d3",
                                                "text": "Les ordres professionnels souhaitent que chaque personne immigrante qui possède les compétences requises pour exercer une des 51 professions régies par les lois du Québec puisse le faire."
                                            },
                                            {
                                                "example_id": "fb44803c-a16e-4f0e-916d-eb68625e8b42",
                                                "sense_id": "3467e745-7ea0-3e18-be43-3816bfa345d3",
                                                "text": "Les personnes immigrantes représentent 21 % de la population active, mais près de 30 % des cas d’accidents indemnisés de longue durée (90 jours et plus). (...) Nous avons montré dans l’une de nos études réalisées à l’IRSST que les personnes immigrantes sont plus à risque d’accidents entraînant des absences prolongées en raison de la dangerosité des emplois, de l’instabilité du lien d’emploi, de la non-reconnaissance des diplômes et d’une méconnaissance des droits en SST."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immigrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe1c6ff-e0e4-3d5f-b2c5-dff4fd81c1f2",
                                        "entry_id": "25820468-ab22-37a4-835b-18914a8ae60f",
                                        "glosses": [
                                            "Immigré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b319774-6490-4ff9-81f5-253d041d022c",
                                                "sense_id": "1fe1c6ff-e0e4-3d5f-b2c5-dff4fd81c1f2",
                                                "text": "Un Immigrant clandestin."
                                            },
                                            {
                                                "example_id": "e3518b29-7bf3-482d-a911-acd0565d9b7b",
                                                "sense_id": "1fe1c6ff-e0e4-3d5f-b2c5-dff4fd81c1f2",
                                                "text": "Un immigrant polonais sur deux est un travailleur manuel, notamment dans l’agriculture, l’industrie alimentaire et la construction."
                                            },
                                            {
                                                "example_id": "8158e5bb-0edf-498f-9f31-5da36eed8208",
                                                "sense_id": "1fe1c6ff-e0e4-3d5f-b2c5-dff4fd81c1f2",
                                                "text": "Le Québec est une « nation accueillante et ouverte » qui recevra 20 % d’immigrants de plus en 2010, soit 55 000."
                                            },
                                            {
                                                "example_id": "461c59f9-bf82-466e-9544-8f7a644dc795",
                                                "sense_id": "1fe1c6ff-e0e4-3d5f-b2c5-dff4fd81c1f2",
                                                "text": "L’immigrant est celui qui vient de s’installer dans un pays étranger. L’immigré est celui qui s’est installé dans un pays étranger. Au Québec, on a tendance à employer le terme immigrant pour désigner la population d’origine étrangère, alors que le terme immigré conviendrait mieux. Sans doute est-ce parce que l’anglais n’utilise que le mot immigrant pour désigner à la fois les nouveaux et les anciens arrivés."
                                            }
                                        ]
                                    }
                                ]
                            },
