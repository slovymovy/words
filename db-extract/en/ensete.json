                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ec0f28a7-0dc8-488a-b758-7346b021015c",
                        "entry_id": "a2dd8dd4-6597-3dd1-9891-c3e9ec3a2774",
