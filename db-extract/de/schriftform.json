                ],
                "senses": [
                    {
                        "sense_id": "47b00d8b-5d6f-3f09-b39d-5b351e284d9b",
                        "entry_id": "ca6862c5-c988-369a-b278-a0a3e390336e",
                        "glosses": [
                            "Art der Gestaltung einer Schriftart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2f7b29-ee8c-4b18-9543-14a14f33138c",
                                "sense_id": "47b00d8b-5d6f-3f09-b39d-5b351e284d9b",
                                "text": "„Allerdings konnten die Schriftformen nicht »Spielball von Laune und Mode« werden, weil sonst auf Grund der damaligen politischen Zwiespältigkeiten die Gefahr bestanden hätte, daß der Süden nicht lesen könnte, was der Norden geschrieben hat.“"
                            },
                            {
                                "example_id": "b85f19cd-9813-4e33-836e-f2708bb586ef",
                                "sense_id": "47b00d8b-5d6f-3f09-b39d-5b351e284d9b",
                                "text": "„Das Ideal stellt eine rhythmisch wirkende Schrift dar, in der die Schriftform gut von der Bewegung getragen wird, ohne dass eine Formauflösung eintritt.“"
                            },
                            {
                                "example_id": "246f12a6-4a8d-47e6-b44c-6f8a1213c2bd",
                                "sense_id": "47b00d8b-5d6f-3f09-b39d-5b351e284d9b",
                                "text": "Bei alten Handschriften, die oft von mehreren, anonymen Schreibern hergestellt wurden, kann man unter anderem aufgrund der Schriftformen die Passagen der Schreiber unterscheiden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2143ef8a-36b7-314d-81a0-9ceeb5cd889b",
                        "entry_id": "ca6862c5-c988-369a-b278-a0a3e390336e",
                        "glosses": [
                            "Schriftart (im Unterschied zu einer anderen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3078b87-a28f-4ffe-a58e-f7257a881905",
                                "sense_id": "2143ef8a-36b7-314d-81a0-9ceeb5cd889b",
                                "text": "„Bekannte Vertreter dieser Schriftform sind die deutsche Kurrentschrift und die arabische Schrift.“"
                            },
                            {
                                "example_id": "c325b335-20af-4d30-a116-f01aadf3ba08",
                                "sense_id": "2143ef8a-36b7-314d-81a0-9ceeb5cd889b",
                                "text": "„Die meisten Kinder lernen heute das Lesen und Schreiben in Druckschrift. Es ist die Schrift, die die Kinder in der Umwelt überall antreffen und die ihnen das Lesen- und Schreibenlernen erleichtert. Sie ist auch die Schriftform, die am besten hilft, die Wörter zu gliedern.“"
                            },
                            {
                                "example_id": "f3f09649-fb8e-42c5-8fcb-7fa2563bf095",
                                "sense_id": "2143ef8a-36b7-314d-81a0-9ceeb5cd889b",
                                "text": "„Wenn Sprachforscher das Gesagte in eine Schriftform bringen, müssen sie sich entscheiden, welches Wort wie klingt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0cd5d130-6d68-3d67-90ce-b658e1a941c7",
                        "entry_id": "ca6862c5-c988-369a-b278-a0a3e390336e",
                        "glosses": [
                            "in schriftlicher Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a234a0-edf3-4a80-9405-6dab5086a88a",
                                "sense_id": "0cd5d130-6d68-3d67-90ce-b658e1a941c7",
                                "text": "Ein Testament muss unter Wahrung bestimmter Bedingungen in Schriftform vorliegen."
                            },
                            {
                                "example_id": "ca0222f5-1c56-4060-8ad3-287467fbec0b",
                                "sense_id": "0cd5d130-6d68-3d67-90ce-b658e1a941c7",
                                "text": "„Erstmals in der westafrikanischen Geschichtstradition werden hier bis dahin nur mündlich überlieferte Ereignisse in Schriftform gefasst, politisch interpretiert und aufbewahrt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
