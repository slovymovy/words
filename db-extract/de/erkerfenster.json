                "senses": [
                    {
                        "sense_id": "19634599-6f88-33f4-aa17-7cd6c9dcf036",
                        "entry_id": "02c968cf-aa51-33c5-8b28-fc220b7e21d5",
                        "glosses": [
                            "Fenster in einem Erker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97356eb8-fa8d-417e-bde3-4eb6687eaf7a",
                                "sense_id": "19634599-6f88-33f4-aa17-7cd6c9dcf036",
                                "text": "„Ich legte mich in dem neuen Zimmer schlafen, hörte die Stimmen Bellegardes und seiner Gefährten, mit denen er zechte, ging an das Erkerfenster und sah, daß die Vorhänge des andern Zimmers zugezogen waren, was mir eigentlich hätte beweisen müssen, daß keine Pläne geschmiedet worden waren; aber hinterher erfuhr ich, daß Merkur Jupiter von dem Umzug Amphitryons in ein anderes Zimmer verständigt hatte.“"
                            },
                            {
                                "example_id": "80bd66b1-961a-4997-b344-f0a5ec0a8b2d",
                                "sense_id": "19634599-6f88-33f4-aa17-7cd6c9dcf036",
                                "text": "„Im Wohnzimmer gibt es Erkerfenster mit Fensterbänken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
