                "senses": [
                    {
                        "sense_id": "902dee78-12f6-31e9-b291-3740c61f9646",
                        "entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
                        "glosses": [
                            "D’une manière injuste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9fd933e-642b-4e9e-890a-b65afe902f84",
                                "sense_id": "902dee78-12f6-31e9-b291-3740c61f9646",
                                "text": "Il fut injustement condamné."
                            }
                        ]
                    },
                    {
                        "sense_id": "56feec15-3d4e-38f2-9f06-d02c48a34a2c",
                        "entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
                        "glosses": [
                            "D’une manière mal fondée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38006640-b46f-4637-8eb3-b1aa51635bfd",
                                "sense_id": "56feec15-3d4e-38f2-9f06-d02c48a34a2c",
                                "text": "[…] « À quoi cela sert-il ? » répète-t-il le plus volontiers ; et on la lui reproche assez, sa manie bassement utilitaire, et pratique, on la lui reproche un peu trop, et injustement !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "252cd9b8-aa4c-40f2-8dcb-c2eed1a687c3",
                        "source_entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
                        "source_sense_id": "902dee78-12f6-31e9-b291-3740c61f9646",
                        "source_sense_description": "D’une manière injuste.",
                        "target_lang_word": "zu Unrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bec917f4-387e-4923-b2cb-b4f710b32d55",
                        "source_entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
                        "source_sense_id": "902dee78-12f6-31e9-b291-3740c61f9646",
                        "source_sense_description": "D’une manière injuste.",
                        "target_lang_word": "widerrechtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widerrechtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6b6e93f-eb75-3ec8-a066-2517b17e44f4",
                                        "entry_id": "8f4ae5cb-6759-340b-97b8-ce3e80f2ac97",
                                        "glosses": [
                                            "gegen das Gesetz verstoßend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80efe56-cfea-4781-a07d-e62940687195",
                                                "sense_id": "c6b6e93f-eb75-3ec8-a066-2517b17e44f4",
                                                "text": "Die widerrechtliche Entsorgung von Sperrmüll ist ein verbreiteter Tatbestand."
                                            },
                                            {
                                                "example_id": "f2694357-381a-4f07-839d-c523fba7ee89",
                                                "sense_id": "c6b6e93f-eb75-3ec8-a066-2517b17e44f4",
                                                "text": "„Zu Anfang November faßte ich ernstlich den Plan, mich gewaltsam aus einem Orte zu entfernen, wo man mich widerrechtlich festhielt, und dieser Plan wurde mein einziger Gedanke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "102a3a20-7c4d-4006-87e4-db6b15150a65",
                        "source_entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
                        "source_sense_id": "902dee78-12f6-31e9-b291-3740c61f9646",
                        "source_sense_description": "D’une manière injuste.",
                        "target_lang_word": "ungerechterweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungerechterweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c04ba8a-6a20-3cc3-aad7-0058b6560fac",
                                        "entry_id": "784652af-bc14-36a5-8b64-f9a7456b7639",
                                        "glosses": [
                                            "auf eine nicht der Gerechtigkeit entsprechende Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "632bf61c-fac2-4dab-afec-12ed7f57e61b",
                                                "sense_id": "4c04ba8a-6a20-3cc3-aad7-0058b6560fac",
                                                "text": "„Trauern Sie dem verpassten Halbfinale noch nach? Frings: Ja, ich konnte halt nicht spielen, ungerechterweise.“"
                                            },
                                            {
                                                "example_id": "a991393e-fe2a-4498-9952-60413decfcb1",
                                                "sense_id": "4c04ba8a-6a20-3cc3-aad7-0058b6560fac",
                                                "text": "„Zwar mag man dann ungerechterweise das ein oder andere Gelungene verpassen, aber Bücher gibt's eh genug, und notfalls kann man ja immer noch irgendeinen Klassiker lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64e8f240-ad90-4792-9190-353961114bec",
                        "source_entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
                        "source_sense_id": "902dee78-12f6-31e9-b291-3740c61f9646",
                        "source_sense_description": "D’une manière injuste.",
                        "target_lang_word": "unjustly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unjustly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22e41e80-4c28-325e-ae4d-daf44de898c4",
                                        "entry_id": "a8e6fce4-eda3-36ac-b873-0b842cc7fbb0",
                                        "glosses": [
                                            "In an unjust manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab8eb15-d7f9-4ecb-a6e2-fbde5f4ab02d",
                                                "sense_id": "22e41e80-4c28-325e-ae4d-daf44de898c4",
                                                "text": "unjustly punished"
                                            },
                                            {
                                                "example_id": "1799e7df-846a-4574-ae2b-8a3562b214ca",
                                                "sense_id": "22e41e80-4c28-325e-ae4d-daf44de898c4",
                                                "text": "Nowe is iuſte iuſtice, ſo iotted out of iointe, / That ye here vniuſtely, ſtande at deniall, / To do me iuſtice, and wolde by power ryall: / Directe mine acquitall or condemnacion, / Euen as wyll in both: weith your acceptacion."
                                            },
                                            {
                                                "example_id": "8f338d52-3c46-48bc-806d-023ea49035a7",
                                                "sense_id": "22e41e80-4c28-325e-ae4d-daf44de898c4",
                                                "text": "I am satisfied that there are many convicts in this prison unprovenly or unjustly confined, and that should have relief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "478957ba-f0fb-43f7-8d6f-91f3b9b691c9",
                        "source_entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
                        "source_sense_id": "902dee78-12f6-31e9-b291-3740c61f9646",
                        "source_sense_description": "D’une manière injuste.",
                        "target_lang_word": "unfairly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfairly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11bed2bb-876d-36b6-a794-d0710121369a",
                                        "entry_id": "bab84996-ac11-3be3-9975-68cacaf35a26",
                                        "glosses": [
                                            "In a manner that is unfair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a5aa81-bf05-4f81-bc9f-12ae9359327b",
                                                "sense_id": "11bed2bb-876d-36b6-a794-d0710121369a",
                                                "text": "The carnival games were unfairly difficult, and hardly anybody won a prize."
                                            },
                                            {
                                                "example_id": "cfe8bb76-a47f-4de5-9f2b-928851331794",
                                                "sense_id": "11bed2bb-876d-36b6-a794-d0710121369a",
                                                "text": "As a result, many Black people remained unfairly enslaved and indentured in the so-called free territory. This was not legal slavery (also known as de jure slavery), but slavery in practice (de facto slavery)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39eb8e57-f7bc-468f-b6ff-49816d16d5ea",
                        "source_entry_id": "b35a0a4b-a13d-3e3a-b1d0-d0bf287639ad",
