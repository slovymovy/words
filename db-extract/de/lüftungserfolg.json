                ],
                "senses": [
                    {
                        "sense_id": "91602275-415f-3a5b-af79-fcda34947092",
                        "entry_id": "7fa00f35-2d24-3ebb-a766-5e265e0689af",
                        "glosses": [
                            "das Gelingen einer Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "372397b8-f7ee-4578-977c-dc06531e123f",
                                "sense_id": "91602275-415f-3a5b-af79-fcda34947092",
                                "text": "„Das ständige Offenhalten von Fensterflügeln auch in Kippstellung ist für den Lüftungserfolg nicht ausreichend und erleichtert außerdem einen Einbruch, denn ein gekipptes Fenster ist ein offenes Fenster.“"
                            },
                            {
                                "example_id": "d4033ad4-cdb0-421a-8be9-2fa179fb0d4b",
                                "sense_id": "91602275-415f-3a5b-af79-fcda34947092",
                                "text": "„Das ständige Offenhalten von Fensterflügeln, auch gekippt oder geklemmt (in der Wohnung wie im Treppenhaus), ist für den Lüftungserfolg nicht ausreichend, da der Luftaustausch fehlt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0390b811-a271-3049-8cfa-1bac042e8fc6",
                        "entry_id": "7fa00f35-2d24-3ebb-a766-5e265e0689af",
                        "glosses": [
                            "das Erreichen selbst gesetzter Ziele bei der Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43cd069-4366-4136-91a3-e8b188ab96d3",
                                "sense_id": "0390b811-a271-3049-8cfa-1bac042e8fc6",
                                "text": "„Testen Sie den Lüftungserfolg selbst - mit nackten Füßen (weil die sehr sensibel auf Temperaturveränderung reagieren).“"
                            },
                            {
                                "example_id": "a518d759-f381-4896-bfb0-1d384c6083c4",
                                "sense_id": "0390b811-a271-3049-8cfa-1bac042e8fc6",
                                "text": "„Wir planen Ihren Lüftungserfolg und optimieren Ihre Energiekosten.“"
                            },
                            {
                                "example_id": "f39afcf8-1f57-4e15-80e2-60eb3fe306b1",
                                "sense_id": "0390b811-a271-3049-8cfa-1bac042e8fc6",
                                "text": "„Nur mit einem solchen Messgerät könne Sie die Raumluftfeuchte bestimmen, Ihren eigenen Lüftungsrhythmus finden und den Lüftungserfolg messen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
