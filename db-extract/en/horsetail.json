    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "495a5f5f-5bfd-3db7-893a-64d95b498949",
                "word": "horsetail",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "919a39bd-b1b1-44dd-882c-a7a676215ae9",
