                    {
                        "sense_id": "2801ac30-3402-31b1-a03c-3f9e0cd0e3ae",
                        "entry_id": "1d7822e7-1cbc-3cc1-aedd-814a46d3b406",
                        "glosses": [
                            "Made of wool."
                        ],
                        "tags": [
                            "US",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6f410ac6-ef26-4b4e-96e2-02ca2b051aab",
                                "sense_id": "2801ac30-3402-31b1-a03c-3f9e0cd0e3ae",
                                "text": "In a large bedroom upstairs, the window of which was thickly curtained with a great woollen shawl lately discarded by the landlady, Mrs. Rolliver, were gathered on this evening nearly a dozen persons, all seeking vinous bliss; all old inhabitants of the nearer end of Marlott, and frequenters of this retreat."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d70a161-aaf3-3ad7-b442-51b89c9d3d43",
                        "entry_id": "1d7822e7-1cbc-3cc1-aedd-814a46d3b406",
                        "glosses": [
                            "Of or relating to wool or woolen cloths."
                        ],
                        "tags": [
                            "US",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe643f38-c096-4ca6-b142-fa646f562ecd",
                                "sense_id": "7d70a161-aaf3-3ad7-b442-51b89c9d3d43",
                                "text": "woolen manufactures"
                            },
                            {
                                "example_id": "70bb0533-b951-4cf3-91b5-c64045ccf63e",
                                "sense_id": "7d70a161-aaf3-3ad7-b442-51b89c9d3d43",
                                "text": "a woolen mill"
                            },
                            {
                                "example_id": "75c29f52-982a-4058-84d4-41713e2938fc",
                                "sense_id": "7d70a161-aaf3-3ad7-b442-51b89c9d3d43",
                                "text": "a woolen draper"
                            },
                            {
                                "example_id": "fe755a84-250b-4c82-ab8d-9ef752ea8d34",
                                "sense_id": "7d70a161-aaf3-3ad7-b442-51b89c9d3d43",
                                "text": "Woolen threads were an occult means, according to the Roman poet Horace, of depriving a person of virility."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a2eaa27-7ce0-4237-a048-c75fb156d05d",
