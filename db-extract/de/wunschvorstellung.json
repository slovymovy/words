                "senses": [
                    {
                        "sense_id": "789af90d-9b63-3703-b3d8-4cd0f81d3b96",
                        "entry_id": "5eee1141-0da0-3598-a5cd-d3f86acef3e8",
                        "glosses": [
                            "Vorstellung von dem, was man sich wünscht/gerne hätte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dbe7f56-bf8d-465f-af64-d89d31f95a80",
                                "sense_id": "789af90d-9b63-3703-b3d8-4cd0f81d3b96",
                                "text": "„Die Wahnvorstellungen, die sie im Laufe ihrer Krankheit entwickelte, waren im Grunde ihre Wunschvorstellungen.“"
                            },
                            {
                                "example_id": "752a177d-bbe4-466e-a4f5-19250656f51b",
                                "sense_id": "789af90d-9b63-3703-b3d8-4cd0f81d3b96",
                                "text": "„Andererseits ist sie in der Wunschvorstellung schon ganz nah in vertrauter Zweisamkeit.“"
                            },
                            {
                                "example_id": "5e0dbf0c-cd38-46f5-9e50-4f032cc4b071",
                                "sense_id": "789af90d-9b63-3703-b3d8-4cd0f81d3b96",
                                "text": "„Es gibt wohl kein anderes Unternehmen in Deutschland, bei dem Wunschvorstellung und Realität so weit auseinanderklaffen wie bei der Deutschen Bahn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2adc7b33-9a26-40d4-9e8d-5a9d26011367",
                        "source_entry_id": "5eee1141-0da0-3598-a5cd-d3f86acef3e8",
                        "source_sense_id": "789af90d-9b63-3703-b3d8-4cd0f81d3b96",
                        "source_sense_description": "Vorstellung von dem, was man sich wünscht/gerne hätte",
                        "target_lang_word": "wishful thinking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wishful thinking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cac5770b-28c5-3112-b63c-e7d53cad4e5c",
                                        "entry_id": "2f9cd72e-07f1-3013-9424-5bb3767f9439",
                                        "glosses": [
                                            "The formation of beliefs based on an outcome that aligns with one's desires or hopes, while disregarding evidence, rationality, or reality."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e67c74-510f-4091-8c4a-8bbe5f0411d5",
                                                "sense_id": "cac5770b-28c5-3112-b63c-e7d53cad4e5c",
                                                "text": "When you first come out, you might have an overactive gaydar. When I realized I was gay, I wanted everyone to be gay too, which led to a lot of wishful thinking.\n\"Helen Hunt is gay!\" Dream on, girl!"
                                            },
                                            {
                                                "example_id": "00a480c7-7ab9-4367-b026-e3c7e1b73cc9",
                                                "sense_id": "cac5770b-28c5-3112-b63c-e7d53cad4e5c",
                                                "text": "Although no word has ever really emerged of what the Queen has really thought of her prime ministers, there has always been a sense that she did not get on terribly well with Thatcher. Some of this is doubtless wishful thinking, but there were sufficient straws in the wind to give it some credence, such as the story that the prime minister asked what the sovereign intended to wear to an event so as to avoid a clash, only to be told frostily that Her Majesty did not pay any attention to what other people wore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdca9100-3d54-3933-beb7-e9dc475f2025",
                                        "entry_id": "2f9cd72e-07f1-3013-9424-5bb3767f9439",
                                        "glosses": [
                                            "Decision making based on self-delusion."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93f2f1a6-df2e-488f-b928-8052f8ca874e",
                        "source_entry_id": "5eee1141-0da0-3598-a5cd-d3f86acef3e8",
                        "source_sense_id": "789af90d-9b63-3703-b3d8-4cd0f81d3b96",
                        "source_sense_description": "Vorstellung von dem, was man sich wünscht/gerne hätte",
                        "target_lang_word": "illusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "Anything that seems to be something that it is not."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f3a5635-8004-4b5a-b502-78f5e9c4b120",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "We saw what looked like a tiger among the trees, but it was an illusion caused by the shadows of the branches."
                                            },
                                            {
                                                "example_id": "eb910563-fcd8-4937-b977-c8a6ea0fe405",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "Using artificial additives, scientists can create the illusion of fruit flavours in food."
                                            },
                                            {
                                                "example_id": "26133d74-a744-4879-bfbd-642f05e55509",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "You realize the sun don't go down it's just an illusion caused by the world spinning round."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5153a0d3-f76d-3082-a3e2-0c8ece5c221a",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "A misapprehension; a belief in something that is in fact not true."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a97ead-2363-4097-a53a-659db02e1dc2",
                                                "sense_id": "5153a0d3-f76d-3082-a3e2-0c8ece5c221a",
                                                "text": "Jane has this illusion that John is in love with her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d66cfc-17aa-3876-976f-e9d1100c9e72",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "A magician’s trick."
                                        ],
