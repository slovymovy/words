                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heptathlon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "282e188c-24e4-34ce-b6fc-ccb51f552afa",
                                        "entry_id": "fbf1fee1-aba6-31c2-96fb-ff630db3861e",
                                        "glosses": [
                                            "An athletic contest comprising seven events; contested mostly by women, for whom this is an Olympic sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60faf51-b021-40d3-857c-3272eeea6a13",
                                                "sense_id": "282e188c-24e4-34ce-b6fc-ccb51f552afa",
                                                "text": "[Carolina Kluft] has won her last 19 heptathlons. Only the legendary Jackie Joyner-Kersee has scored higher."
                                            },
                                            {
                                                "example_id": "3eae6477-83ce-4c60-ba49-681cbbc8f7b8",
                                                "sense_id": "282e188c-24e4-34ce-b6fc-ccb51f552afa",
                                                "text": "For now, Gray and her peers are able to compete for Olympic berths only in the seven-event heptathlon, while the decathlon is restricted to men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "407b6e34-9a1f-45a1-b29f-5e1434570382",
                        "source_entry_id": "78dca850-9986-3725-a71e-2a5684e18c40",
                        "source_sense_id": "c55f371a-ee7a-3276-818c-6b0ab0102399",
                        "target_lang_word": "heptathlon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heptathlon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                                        "entry_id": "75a706fb-bce4-336e-aaf4-2f245fe329db",
                                        "glosses": [
                                            "Épreuve sportive constituée de sept disciplines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9da9b3-2b01-481b-8f72-daeed6cc8142",
                                                "sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                                                "text": "Enfin en l’absence de la double championne olympique belge Nafissatou Thiam, blessée, l’Américaine Anna Hall fait figure de favorite de l’heptathlon, qui débute ce matin."
                                            },
                                            {
                                                "example_id": "dadab21b-62c5-489d-8b33-d9c2fab117d3",
                                                "sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                                                "text": "Cette fois, c’est la Syrienne Ghada Shouaa qui décroche une médaille d’or et le championnat du monde dans l’heptathlon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
