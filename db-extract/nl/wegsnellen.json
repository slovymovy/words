                    {
                        "translation_id": "a416389e-f17a-4469-bbe1-7ae34048999e",
                        "source_entry_id": "f18a5868-ffaa-3491-86b7-9371f0eb48c6",
                        "source_sense_id": "9864ff04-35c7-3395-ba51-300d904e576b",
                        "target_lang_word": "run away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "run away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "400bafab-aaaa-3c08-a50d-62584364bad0",
                                        "entry_id": "aeb97328-ae8f-333c-87ba-994cc4b4c7ac",
                                        "glosses": [
                                            "To flee by running."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c577bd-4bd2-4d7b-ba57-981b19df3a7e",
                                                "sense_id": "400bafab-aaaa-3c08-a50d-62584364bad0",
                                                "text": "The crowd had to run away from the burning structure with only the clothes on their backs."
                                            },
                                            {
                                                "example_id": "410b4e35-a23d-46d4-adf3-40fd0952005f",
                                                "sense_id": "400bafab-aaaa-3c08-a50d-62584364bad0",
                                                "text": "Sometimes I feel I've got to / Run away / I've got to / Get away from the pain you drive into the heart of me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2b5102-b23d-3b79-97da-255178ece7ec",
                                        "entry_id": "aeb97328-ae8f-333c-87ba-994cc4b4c7ac",
                                        "glosses": [
                                            "To leave home, or other place of residence, usually unannounced, or to make good on a threat, with such action usually performed by a child or juvenile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c1df00-24b9-4518-82f2-22205b4ccb28",
                                                "sense_id": "6a2b5102-b23d-3b79-97da-255178ece7ec",
                                                "text": "My parents want me to take a bath every day? Fine, I'm running away."
                                            },
                                            {
                                                "example_id": "a28d59a0-fcec-40cc-8c79-fffd74d5de71",
                                                "sense_id": "6a2b5102-b23d-3b79-97da-255178ece7ec",
                                                "text": "\"I don't want to spoil any comparison you are going to make,\" said Jim, \"but I was at Winchester and New College.\" ¶ \"That will do,\" said Mackenzie. \"I was dragged up at the workhouse school till I was twelve. Then I ran away and sold papers in the streets, and anything else that I could pick up a few coppers by—except steal. I never did that.[…].\""
                                            },
                                            {
                                                "example_id": "b9a179f6-1ef7-4501-9cdf-0808c54e71ef",
                                                "sense_id": "6a2b5102-b23d-3b79-97da-255178ece7ec",
                                                "text": "I decided to move out of the house when I was 24; my mother still refers to this as the time I ran away from home."
                                            },
                                            {
                                                "example_id": "2926599e-5837-4d40-adc8-6886f167c87a",
                                                "sense_id": "6a2b5102-b23d-3b79-97da-255178ece7ec",
                                                "text": "Look, kid... it's getting kind of late. It'll be dark soon. Maybe running away today isn't such a good idea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5285e1ba-d09d-346c-b363-30167348ec01",
                                        "entry_id": "aeb97328-ae8f-333c-87ba-994cc4b4c7ac",
                                        "glosses": [
                                            "To become a runaway. (of a device or vehicle)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9c5eb4b-8363-4636-89cf-c0a42434d50b",
                                                "sense_id": "5285e1ba-d09d-346c-b363-30167348ec01",
                                                "text": "The complete 1892 rebuilding, indeed, followed an accident in 1890, when No. 6 ran away down the Buckley branch, and got badly smashed up in a collision at Connah's Quay."
                                            },
                                            {
                                                "example_id": "b91bcfc2-cf2a-4617-aa72-477d93721a42",
                                                "sense_id": "5285e1ba-d09d-346c-b363-30167348ec01",
                                                "text": "The train's brakes failed and it ran away."
                                            },
                                            {
                                                "example_id": "0c5ddc43-ba53-44c8-ae4c-58d12b9ee547",
                                                "sense_id": "5285e1ba-d09d-346c-b363-30167348ec01",
                                                "text": "An autotrim failure can cause stabiliser trim to rapidly run away in the nose-up or nose-down direction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
