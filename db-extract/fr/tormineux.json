                        "entry_id": "f3b866a7-74f0-3352-90ea-c803857f2dca",
                        "glosses": [
                            "Relatif à la dysenterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d024271a-5cb9-4527-a7d5-f5e1694e6222",
                                "sense_id": "d7378549-7cc6-33a0-ae5e-8cc6053abcd5",
                                "text": "Douleurs tormineuses, celles qui s'interrompent et se renouvellent en prenant le caractère de tranchées."
                            },
                            {
                                "example_id": "2e68fd1a-dd38-41a9-96ab-6bed76820b34",
                                "sense_id": "d7378549-7cc6-33a0-ae5e-8cc6053abcd5",
                                "text": "La douleur a lieu, en général, autour de lʼombilic, est dʼun caractère tormineux et brûlant, augmentée par le repas et soulagée par les évacuations diarrhéiques."
                            },
                            {
                                "example_id": "9594e3e1-c7f8-4592-9a4a-eb42b09377b7",
                                "sense_id": "d7378549-7cc6-33a0-ae5e-8cc6053abcd5",
                                "text": "Deux ou trois jours avant la manifestation de chaque hémorrhagie menstruelle, cette fille éprouvait dʼabord une douleur obtuse à lʼépigastre et une douleur tormineuse à lʼombilic et aux lombes."
                            }
                        ]
                    }
