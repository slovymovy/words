                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922a5b70-8db6-43a8-b52d-2c7dd7170fdd",
                                "sense_id": "ce48b0c9-2e38-3db8-bed2-fd42a7a4b273",
                                "text": "Znudziło mi się czekanie na ich telefon, więc sam do nich zadzwoniłem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7549faa8-8c50-3c8b-ae4a-38c703968765",
                        "entry_id": "f05db278-9713-386f-bd0a-532d090cba9f",
                        "glosses": [
                            "pozostawanie w jakimś miejscu, aż coś się wydarzy"
                        ],
                        "tags": [],
