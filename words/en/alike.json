                {
                    "sense_id": "90e15a5c-e588-3410-81ef-b284f39ce020",
                    "sense_definition": "A village in the Dakshina Kannada district of Karnataka, India.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The traveler visited the small village of <w>Alike</w> during his tour of southern India.",
                            "target_lang_translations": {
                                "ru": "Путешественник посетил небольшую деревню <w>Алайк</w> во время своего тура по южной Индии.",
                                "zh": "这位旅行者在印度南部游览期间参观了<w>阿莱克</w>小村庄。"
                            }
                        },
                        {
                            "text": "Local traditions in <w>Alike</w> have been preserved for many generations.",
                            "target_lang_translations": {
                                "ru": "Местные традиции в <w>Алайке</w> сохраняются на протяжении многих поколений.",
                                "zh": "<w>阿莱克</w>的当地传统已经传承了许多代。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в округе Дакшина-Каннада штата Карнатака, Индия.",
                        "zh": "印度卡纳塔克邦达克希纳卡纳达区的一个村庄。"
                    },
                    "translations": {
