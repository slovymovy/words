                {
                    "sense_id": "3fba2460-5718-3092-82cf-9244b42eae8b",
                    "sense_definition": "Le même traitement que celui qu'on a reçu de quelqu'un, en bien ou en mal, dans l'expression « rendre la pareille ».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "réciprocité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu m'invites, je te rendrai la <w>pareille</w> la semaine prochaine."
                        },
                        {
                            "text": "Il m'a insulté, mais je lui ai rendu la <w>pareille</w>."
                        }
                    ],
                    "common_phrases": [
