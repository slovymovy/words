                    }
                ],
                "senses": [
                    {
                        "sense_id": "2965d69b-0b77-36e7-9b59-410da4240389",
                        "entry_id": "79b77737-155d-3a2b-a34e-11d479cee96a",
                        "glosses": [
                            "Qui est flétri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddbee381-08e5-4231-adfa-b66a7d1be692",
                                "sense_id": "2965d69b-0b77-36e7-9b59-410da4240389",
                                "text": "Une pomme ratatinée — Une pomme ridée, flétrie."
                            },
                            {
                                "example_id": "0cee6cc2-cff6-42d5-a2f5-ef4789a5dfb8",
                                "sense_id": "2965d69b-0b77-36e7-9b59-410da4240389",
                                "text": "J'ai le bout des doigts ratatinés quand je reste trop longtemps dans mon bain."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd3c21a2-f332-358b-bb51-c187691e699b",
                        "entry_id": "79b77737-155d-3a2b-a34e-11d479cee96a",
                        "glosses": [
                            "Qui est rapetissé, resserré, réduit par l’âge ou par la maladie, en parlant de personnes."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "414791c2-0f82-494a-95d6-16f9b9dab43d",
                                "sense_id": "bd3c21a2-f332-358b-bb51-c187691e699b",
                                "text": "La vieille Carillon, desséchée, méfiante et saugrenue, avait eu un cœur autrefois ; il s’était concentré et ratatiné dans la soumission de son époux, dans une soumission aveugle."
                            },
                            {
                                "example_id": "c1f26d5e-598a-43fd-a806-cf9a8f52a52f",
                                "sense_id": "bd3c21a2-f332-358b-bb51-c187691e699b",
                                "text": "Je t’assure que, même si je voulais aller chez elles, elles ne me recevraient pas… À leur âge on a le cœur ratatiné…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b566266-687b-4139-bca9-b997730c94f7",
                        "source_entry_id": "79b77737-155d-3a2b-a34e-11d479cee96a",
                        "target_lang_word": "wizened",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wizened",
