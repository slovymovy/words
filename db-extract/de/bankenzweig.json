                "senses": [
                    {
                        "sense_id": "6a10920e-c084-3046-b9d3-4254b98f7bc6",
                        "entry_id": "305d1eed-4b69-388e-b1f4-9a76e72764fe",
                        "glosses": [
                            "Geschäftsbereich, der sich mit Finanzen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5852d47-947a-407c-9d00-f9b5267ac63f",
                                "sense_id": "6a10920e-c084-3046-b9d3-4254b98f7bc6",
                                "text": "„Dieser Bankenzweig wächst jährlich mit zweistelligen Prozentraten und wird derzeit auf ein Volumen zwischen 500 und 700 Mrd.“"
                            },
                            {
                                "example_id": "55628454-1afb-4bc6-98d2-c7b398c47b02",
                                "sense_id": "6a10920e-c084-3046-b9d3-4254b98f7bc6",
                                "text": "„Ein ganzer Bankenzweig, die Hypothekenbanken und Pfandbriefanstalten, betreibt die Ausgabe von Krediten gegen Grundpfandrechte als Geschäft, welches im Hypothekenbankgesetz (HypoBG) näher geregelt ist.“"
                            },
                            {
                                "example_id": "70b84fec-da56-4c8b-8896-0f408abecbdb",
                                "sense_id": "6a10920e-c084-3046-b9d3-4254b98f7bc6",
                                "text": "„Von Mitte Oktober bis Ende Februar seien die Spareinlagen in Tescos Bankenzweig Tesco Personal Finance von 2,5 Milliarden auf 4,5 Milliarden Pfund gestiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
