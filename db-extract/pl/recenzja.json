                        "cross_references": [
                            {
                                "target_word": "review",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0aeb29-9d86-3c7c-8667-fdfeecf1535e",
                                        "entry_id": "f1599b06-691f-3fe6-beb1-a95c00ce4208",
                                        "glosses": [
                                            "A second or subsequent reading of a text or artifact in an attempt to gain new insights."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4eb50da-528f-4f8e-9b1c-46e5c3cb2160",
                                                "sense_id": "9a0aeb29-9d86-3c7c-8667-fdfeecf1535e",
                                                "text": "I need to make a review of the book before I can understand it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "801032e7-47ff-3adf-8356-46a32e22520f",
                                        "entry_id": "f1599b06-691f-3fe6-beb1-a95c00ce4208",
                                        "glosses": [
                                            "An account intended as a critical evaluation of a text or a piece of work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cdb2d88-27c7-436d-b384-30f66e40d950",
                                                "sense_id": "801032e7-47ff-3adf-8356-46a32e22520f",
                                                "text": "The newspaper review was full of praise for the play."
                                            },
                                            {
                                                "example_id": "c841034c-064a-4c67-9d69-e9ba3e3a4d88",
                                                "sense_id": "801032e7-47ff-3adf-8356-46a32e22520f",
                                                "text": "The more strongly people felt about their ideas, the more potent the demons seemed to them: Christians believed that traditional paganism, far from being the work of men, was an 'opium of the masses', pumped into the human race by the non-human demons; and one scholar even ascribed bad reviews of his book to demonic inspiration!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37428c33-3683-37e4-b35d-f35f37738038",
                                        "entry_id": "f1599b06-691f-3fe6-beb1-a95c00ce4208",
                                        "glosses": [
                                            "A judicial reassessment of a case or an event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a463ae8-4a6c-48b9-bb08-0aff5c59d353",
                                                "sense_id": "37428c33-3683-37e4-b35d-f35f37738038",
                                                "text": "The victims demanded a full judicial review of the case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e12b2f5d-34c4-3bd4-ac81-bbfe92803280",
                                        "entry_id": "f1599b06-691f-3fe6-beb1-a95c00ce4208",
                                        "glosses": [
                                            "A stage show made up of topical sketches etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24eec8ef-3baf-4848-9a25-05de67dabec5",
                                                "sense_id": "e12b2f5d-34c4-3bd4-ac81-bbfe92803280",
                                                "text": "The Cambridge Footlights Review launched many Monty Python faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ca09a2-ef39-366b-b8ad-5b9b9f499473",
                                        "entry_id": "f1599b06-691f-3fe6-beb1-a95c00ce4208",
                                        "glosses": [
                                            "A survey of the available items or material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a2c4421-7601-46b3-944c-6b04b17dc9c0",
                                                "sense_id": "c4ca09a2-ef39-366b-b8ad-5b9b9f499473",
                                                "text": "The magazine contained a review of Paris restaurants."
                                            }
                                        ]
                                    },
                                    {
