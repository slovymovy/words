                ],
                "senses": [
                    {
                        "sense_id": "6427ec5f-2c5c-3aaa-93ac-819469ca82a7",
                        "entry_id": "b14e38d2-1630-3aca-9d5e-5f520195e0d0",
                        "glosses": [
                            "ein Bewohner der ehemaligen deutschen Sprachinsel Gottschee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "572e1433-5b16-4a4a-8068-bc78f0a9589e",
                                "sense_id": "6427ec5f-2c5c-3aaa-93ac-819469ca82a7",
                                "text": "„Da gab es die sogenannten „Gottscheeber\", die aus einer deutschsprachigen Enklave Krams im heutigen Slowenien stammten und mit „welschen Früchten\" und Süßwaren handelten.“"
                            },
                            {
                                "example_id": "12fa6426-5b37-4ba3-9480-561acf115773",
                                "sense_id": "6427ec5f-2c5c-3aaa-93ac-819469ca82a7",
                                "text": "„Wie aber sollte man da über primitive Methoden hinaus den Anschluss an den modernen Standard empirischer Forschung gewinnen, da man in stundenlangen Fußmärschen zur nächsten Bahnstation wanderte und von dort aus in überfüllten, ungeheizten, fensterlosen Zügen zwischen Kassel, Borken und Korbach pendelnd, den „pädagogischen Bauchladen\" zum jeweiligen Kundenkreis trug wie die Gottscheeber […]“"
                            },
                            {
                                "example_id": "86e76417-2ea0-4cda-a603-f02a46bdcb84",
                                "sense_id": "6427ec5f-2c5c-3aaa-93ac-819469ca82a7",
                                "text": "„Der Vater sei gebürtiger Gottscheeber, dort in Gottschee sei auch seine Mutter begraben.“"
                            },
                            {
                                "example_id": "9fe4a547-86eb-4003-9008-fa6b8af3180e",
                                "sense_id": "6427ec5f-2c5c-3aaa-93ac-819469ca82a7",
                                "text": "Die Gottscheeber pflegten lange Zeit deutsches Liedgut und Brauchtum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
