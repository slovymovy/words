                        "source_sense_id": "e32ee59a-c7d9-3242-9d5e-dfa9af186c65",
                        "source_sense_description": "Mann, der den Haushalt führt",
                        "target_lang_word": "stay-at-home dad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stay-at-home dad",
                                "target_lang_code": "en",
