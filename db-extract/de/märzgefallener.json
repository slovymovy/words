                "senses": [
                    {
                        "sense_id": "193ac1f7-54b4-39ad-84c0-78e618f3dc0c",
                        "entry_id": "995ab3d0-7490-3841-b0fe-174706668ea2",
                        "glosses": [
                            "Person, die im Zusammenhang mit der Märzrevolution von 1848 (oder einem anderen historischen Ereignis im März) ums Leben gekommen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2521f5e7-3601-4cd0-a4bd-5172fb84ed5a",
                                "sense_id": "193ac1f7-54b4-39ad-84c0-78e618f3dc0c",
                                "text": "„Die Politische Polizei warf ihr vor, eine Versammlung des »Vereins freiheitlicher Sozialisten« und die Gräber der Märzgefallenen, welche während der Revolution vom 16. bis 19. März 1848 in Berlin getötet wurden, aufgesucht zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84d12f98-73c6-386a-812c-a5b8fe6bf1cd",
                        "entry_id": "995ab3d0-7490-3841-b0fe-174706668ea2",
                        "glosses": [
                            "Person, die nach der Reichstagswahl im März 1933 die NSDAP-Mitgliedschaft beantragte"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "eb554220-e476-420f-a85d-73fae916324b",
                                "sense_id": "84d12f98-73c6-386a-812c-a5b8fe6bf1cd",
                                "text": "Märzgefallene oder auch ›Maiveilchen‹ nannte man den Personenkreises vermeintlicher politischer Opportunisten, die nach der Reichstagswahl am 5. März 1933 in die Partei eintraten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
