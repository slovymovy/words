                        "glosses": [
                            "Marchand qui tient une droguerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5214d6-6b04-414e-9162-635b15199437",
                                "sense_id": "e195ebfa-4387-3161-94aa-1371007c7a82",
                                "text": "Je laisse à la garde d'un lieutenant d’artillerie quatre droguistes à bicyclette, d’allure allemande, qui prétendent aller à Mulhouse, leurs communes manquant d’aspirine."
                            },
                            {
                                "example_id": "b42959fc-c078-4a89-a3c4-504aff3a2a2f",
                                "sense_id": "e195ebfa-4387-3161-94aa-1371007c7a82",
                                "text": "Le meilleur collage, solide et durable, se fait avec une colle à froid qu'on trouvera chez le droguiste ou le menuisier."
                            }
                        ]
                    }
                ],
