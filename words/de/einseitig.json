                },
                {
                    "sense_id": "1f64409f-fc12-33ef-94b0-d26613460427",
                    "sense_definition": "Nur eine Seite oder Partei betreffend bzw. nur auf einer Fläche vorhanden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte drucken Sie das wichtige Dokument nicht doppelseitig, sondern nur <w>einseitig</w> auf Papier aus."
                        },
                        {
                            "text": "Eine <w>einseitige</w> Änderung des bestehenden Vertrags ohne vorherige Absprache ist rechtlich unwirksam."
