                    },
                    {
                        "translation_id": "39a87e3b-d004-434a-a205-182907c07664",
                        "source_entry_id": "85171b35-93d9-370a-ad59-d0170814fd32",
                        "source_sense_id": "fbaa1a51-9de8-38e5-bdc6-ef80fa4951c5",
                        "source_sense_description": "Person, die in einer Familie die Entscheidungen fällt",
                        "target_lang_word": "maître de maison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maître de maison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "773384c0-5920-3be6-a1f9-24e7d2595615",
                                        "entry_id": "0b5d3f03-99ed-3f3d-bfbf-3af35c292fc9",
                                        "glosses": [
                                            "Maître des lieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fae3a1-3018-45ed-b669-8c1e9599e6b7",
                                                "sense_id": "773384c0-5920-3be6-a1f9-24e7d2595615",
                                                "text": "Il versa du vin au maître de maison et sur une brève indication de celui-ci, il remplit aussi la coupe de son hôte."
                                            },
                                            {
                                                "example_id": "97129102-9197-4621-842d-5c6d6ef1c642",
                                                "sense_id": "773384c0-5920-3be6-a1f9-24e7d2595615",
                                                "text": "Ce que le maître de maison attend de moi, c’est de faire rire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1383286-3026-3f5a-b341-34ff1da39837",
                                        "entry_id": "0b5d3f03-99ed-3f3d-bfbf-3af35c292fc9",
                                        "glosses": [
                                            "Celui qui dirige la maison, qui reçoit des visites ou des invités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d441a75b-517e-4e4e-a392-9437a8027138",
                                                "sense_id": "e1383286-3026-3f5a-b341-34ff1da39837",
                                                "text": "Le maître de maison supervise la bonne marche du foyer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24ab7a22-5337-4e77-b051-e72a2c6e67f3",
                        "source_entry_id": "85171b35-93d9-370a-ad59-d0170814fd32",
                        "source_sense_id": "3ceb2407-c5f7-32cb-a6ec-6f8ea07da0eb",
                        "source_sense_description": "Person, die ein Haus/mehrere Häuser besitzt",
                        "target_lang_word": "landlord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landlord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84194766-5e83-3bef-a439-2c4c119939ea",
                                        "entry_id": "4befbc28-013a-33db-9600-4240eb6b53d8",
                                        "glosses": [
                                            "A person that leases real property; a lessor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7530885a-636f-486d-933b-b895410316b5",
                                                "sense_id": "84194766-5e83-3bef-a439-2c4c119939ea",
                                                "text": "Brethren, brethren, it were better to haue this communitie,\nThen to haue this difference in degrees:\nThe landlord his rent, the lawyer his fees.\nSo quickly the poore mans ſubſtance is ſpent […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2eecb5-29f7-3b32-8059-ebd997da64bb",
                                        "entry_id": "4befbc28-013a-33db-9600-4240eb6b53d8",
                                        "glosses": [
                                            "The owner or manager of a public house."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ec27c3-fa85-4a70-b494-79ecec76c7e4",
                                                "sense_id": "9c2eecb5-29f7-3b32-8059-ebd997da64bb",
                                                "text": "When asked to explain why he became a landlord, he told the Archbishop of York it was so he could close the pub on Sundays, and suppress the profane language and singing that came through the bar windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "358caf9f-e361-349b-b1f7-a556599d9cb2",
                                        "entry_id": "4befbc28-013a-33db-9600-4240eb6b53d8",
                                        "glosses": [
                                            "A shark, imagined as the owner of the surf to be avoided."
                                        ],
                                        "tags": [
                                            "slang",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbddd8b3-8cf9-460d-a16a-43487d2101c9",
