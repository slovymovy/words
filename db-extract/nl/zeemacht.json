                ],
                "translations": [
                    {
                        "translation_id": "01618fd7-ebc4-4c31-91eb-1e723c271b04",
                        "source_entry_id": "9fdceb10-b1fa-35b9-b529-15800572dfc4",
                        "target_lang_word": "Kriegsmarine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriegsmarine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                        "entry_id": "3ec05241-3ef2-39e5-9172-03b63212403c",
                                        "glosses": [
                                            "Gesamtheit der bewaffneten Seestreitkräfte eines Staates; der Teil der Marine, der dem Krieg auf See dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f1bd80-c474-45c8-8263-0c834d82c182",
                                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                                "text": "Die russische Kriegsmarine hatte das unter maltesischer Flagge fahrende Schiff Mitte August im Atlantik aufgebracht und seither auf offener See dessen Ladung untersucht - angeblich sei keinerlei verbotene Fracht an Bord gewesen."
                                            },
                                            {
                                                "example_id": "1408fef4-ac91-40d8-a4db-b16ed1b02736",
                                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                                "text": "Ein Kolonialreich entstand (Philippinen, Guam) und der rasch forcierte Ausbau einer großen Kriegsmarine ermöglichte es, Druck in der eigenen Hemisphäre und bald auch darüber hinaus auszuüben."
                                            },
                                            {
                                                "example_id": "0ce013e2-6be9-480f-a548-a3e5f4e64562",
                                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                                "text": "Das Atom-U-Boot „San Francisco“ der US-Navy, der amerikanischen Kriegsmarine, ist 560 Kilometer von der Pazifikinsel Guam entfernt auf Grund gelaufen."
                                            },
                                            {
                                                "example_id": "f36e9b60-5272-4910-a1bc-b7f08a62f7c9",
                                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                                "text": "\"EnerSys und seine Vorgängerunternehmen liefern bereits seit mehr als 100 Jahren Batterien für den Einsatz in Unterseebooten\", sagte John Craig, Chairman, Präsident und Chief Executive Officer von EnerSys. \"Unsere U-Boot-Batterien sind für ihre Qualität und Betriebsleistung anerkannt und werden von Kriegsmarinen auf der ganzen Welt sowohl in dieselelektrisch als auch nuklear angetriebenen Unterseebooten eingesetzt. […]\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                        "entry_id": "3ec05241-3ef2-39e5-9172-03b63212403c",
                                        "glosses": [
                                            "im engeren Sinne die Marine der Wehrmacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a38ee8-8494-4267-8cf6-60f8aa5cac94",
                                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                                "text": "Die Tradition des Unterganges mit wehender Flagge überlebte in der deutschen Kriegsmarine und kostete auch im Zweiten Weltkrieg, etwa beim Untergang der Bismarck, sinnlose Opfer."
                                            },
                                            {
                                                "example_id": "664e6ede-a07d-4098-bf67-9d0365596b14",
                                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                                "text": "„Hier kannte der brave Major Brenner einen Kapitänleutnant der Kriegsmarine.“"
                                            },
                                            {
                                                "example_id": "5cc3377d-a055-4b32-b107-999a0cac3f13",
                                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                                "text": "„So sahen auch ihre Vorstellungen von der Kriegsmarine aus.“"
                                            },
                                            {
                                                "example_id": "e9a8da78-7634-4a81-87cc-1b71069070f1",
                                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                                "text": "„Den Dienstgrad Maschinist (Feldwebel) gab es bei der Kriegsmarine äußerst selten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5916d09-0ba4-4569-b152-53f41c5a8ec4",
                        "source_entry_id": "9fdceb10-b1fa-35b9-b529-15800572dfc4",
                        "target_lang_word": "Marine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                        "entry_id": "a25450cb-7595-3426-822d-385095f2586c",
                                        "glosses": [
                                            "die zur Seekriegsführung bestimmten Streitkräfte eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "757bca54-c1ef-4c52-8363-696eb962b738",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "Die US-amerikanische Marine (US-Navy) gehört zu den stärksten der Welt."
                                            },
                                            {
                                                "example_id": "b59ef2c8-1929-49b1-920f-c4bac2a37a8e",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„In einer Sammlung mit Augenzeugenberichten fand ich ein Dokument aus dem Jahr 1829, in dem es um ein amerikanisches Sklavenschiff ging, das von der britischen Marine im südlichen Atlantik aufgebracht worden war.“"
                                            },
                                            {
                                                "example_id": "205c8a84-5ac6-42d6-9c6b-f2ff8634e851",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„Der Deutsche und der Österreichische Flotten-Verein beklagten zu jener Zeit das Ende der beiden Kaiserlichen Marinen.“"
                                            },
                                            {
                                                "example_id": "a4c4fe51-303e-4bf5-b428-324d8178e644",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„Dort hatte sich ein Expeditionskorps der Marine eingeschifft.“"
                                            },
                                            {
                                                "example_id": "4e0c06cc-bcb0-4dbc-a459-e4ca9811bda9",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„Unter dem flottenbegeisterten Kaiser Wilhelm II. (1888-1918) gewann die Marine an Bedeutung, und eine große maritime Rüstungsindustrie entstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e574625c-d65d-346d-b894-eaf45f9cccc6",
                                        "entry_id": "a25450cb-7595-3426-822d-385095f2586c",
                                        "glosses": [
                                            "Handelsmarine, das zivile Seewesen eines Staates"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5aacb5a-1faf-4afd-8128-1b6200a9eaf9",
                                                "sense_id": "e574625c-d65d-346d-b894-eaf45f9cccc6",
                                                "text": "„Angestellte der Marine, die zu / von einer Schwimmbohrinsel reisen, welche selbständig manövrierbar ist, müssen in Besitz eines Schreibens sein, der vom Arbeitgeber oder dem Schwimmplattform-Inhaber ausgestellt wurde.“"
                                            },
                                            {
                                                "example_id": "2ba078dc-aeb6-4f79-922f-411546949195",
                                                "sense_id": "e574625c-d65d-346d-b894-eaf45f9cccc6",
                                                "text": "„Der Fluß bildet da eine kleine Bucht, in welcher die Marine des Stammes, fünf Palmrinde-Kanus, an Strängen von Wattap ruhig vor Anker lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45d1a796-64e8-409b-a4c7-1f1c43102221",
                        "source_entry_id": "9fdceb10-b1fa-35b9-b529-15800572dfc4",
                        "target_lang_word": "navy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84e2ee4c-083a-3141-8854-9bd41255090f",
                                        "entry_id": "cc231742-7dd9-3a00-ad0c-e6341db5ea8c",
                                        "glosses": [
                                            "A country's entire maritime military force, including ships and personnel."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd72cac6-c48a-4232-8785-87fff52b9a11",
                                                "sense_id": "84e2ee4c-083a-3141-8854-9bd41255090f",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            },
                                            {
                                                "example_id": "e783b46c-6776-4386-a746-2af3019a22de",
                                                "sense_id": "84e2ee4c-083a-3141-8854-9bd41255090f",
                                                "text": "People who get seasick easily shouldn't join the navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b974645-1480-3eb0-b111-7d372cfd6c96",
                                        "entry_id": "cc231742-7dd9-3a00-ad0c-e6341db5ea8c",
                                        "glosses": [
                                            "A governmental department in charge of a country's maritime military force."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e46f8a4f-b1a6-319f-8abe-2c98cb827810",
                                        "entry_id": "cc231742-7dd9-3a00-ad0c-e6341db5ea8c",
                                        "glosses": [
                                            "Any fleet of maritime vessels, and especially the entire fleet of any particular nationality, including vessels that are commercial, military, or both."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8efbf5a7-6df6-3298-bbe3-41d0e97ee697",
                                        "entry_id": "cc231742-7dd9-3a00-ad0c-e6341db5ea8c",
                                        "glosses": [
                                            "A dark blue colour, usually called navy blue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "navy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b45e06a-e3ce-3b99-81a0-45926a7b3a43",
                                        "entry_id": "a10d2a30-86ae-3905-af88-c4f83d1f0aa3",
                                        "glosses": [
                                            "Having the dark blue colour of navy blue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6e3b90-0d60-4373-a082-096bb08ae369",
                                                "sense_id": "3b45e06a-e3ce-3b99-81a0-45926a7b3a43",
                                                "text": "The cover is as navy as a bruise."
                                            },
                                            {
                                                "example_id": "6cff2b44-91b6-4b49-b27b-4beed0133670",
                                                "sense_id": "3b45e06a-e3ce-3b99-81a0-45926a7b3a43",
                                                "text": "The morning shadow on his chin was almost as navy as his heavy-lidded eyes, his cheekbones exquisitely sculptured in his haughty face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73446063-eabc-3e45-aee4-fa978160731f",
                                        "entry_id": "a10d2a30-86ae-3905-af88-c4f83d1f0aa3",
                                        "glosses": [
                                            "Belonging to the navy; typical of the navy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b17adac-3e9a-43c4-b050-95564d8b4b6e",
                                                "sense_id": "73446063-eabc-3e45-aee4-fa978160731f",
                                                "text": "[…] there are chess ships and checker ships and those where acey-deucey is almost the only game, the sailors' own improved version of backgammon. Fliers from the seacoast of Iowa, anxious to be as navy as the rest, are usually the first to pick it up."
                                            },
                                            {
                                                "example_id": "d7bb6a67-e8de-4448-bb67-2f8f0584d432",
                                                "sense_id": "73446063-eabc-3e45-aee4-fa978160731f",
                                                "text": "Lieutenant Lindquist is navy through and through. I know she doesn't want to get out. Now, I know there's no way you can assign her to a navy ship, but there has to be something the navy can give her to keep her in space."
                                            },
                                            {
                                                "example_id": "697fb71c-c43a-4aa8-bc1a-7ac1a176fa41",
                                                "sense_id": "73446063-eabc-3e45-aee4-fa978160731f",
                                                "text": "It was not what you would picture as a typical meeting with a naval officer. In fact, it was about as navy as an Abbott and Costello movie."
                                            },
                                            {
                                                "example_id": "6599a8b9-6c4c-416c-80c9-9bb665167b35",
                                                "sense_id": "73446063-eabc-3e45-aee4-fa978160731f",
                                                "text": "He was navy through and through; no-nonsense, humorless, and all spit and polish—every hair in its place, every thought gleaned from the manual compiled by brilliant sea dogs of long ago."
                                            },
                                            {
                                                "example_id": "90f390a6-3d71-42b5-9fa9-24e66c3d2e15",
                                                "sense_id": "73446063-eabc-3e45-aee4-fa978160731f",
                                                "text": "Goodwin was navy through and through."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
