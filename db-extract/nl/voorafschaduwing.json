                        "entry_id": "e52071e2-ed55-3abe-8d86-13ed995d7edf",
                        "glosses": [
                            "een voorbeeld van iets dat nog komen gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a873351e-f028-4ab5-93d8-b8bbf7c73a0a",
                                "sense_id": "796a9930-22a9-3b29-965e-37b92642849b",
                                "text": "Ondanks het vertrouwen waarmee ze in de camera blikten, meende ik de voorafschaduwing van wat onvermijdelijk komen ging in hun lachende ogen te zien."
                            },
                            {
                                "example_id": "5bc247a9-c7ae-4146-8adb-eaa3827c433c",
                                "sense_id": "796a9930-22a9-3b29-965e-37b92642849b",
                                "text": "Als schoolkind moet hij een keurig gekleed, ietwat bekakt sprekend ventje (‘Chapeau’ en ‘Ik sta perplex!’) zijn geweest, in zekere zin de perfecte voorafschaduwing van het potsierlijke heerschap dat hij later zal worden."
                            }
                        ]
                    }
