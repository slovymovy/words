                        "examples": [
                            {
                                "example_id": "44255471-83d1-41a4-9850-1c531dc6a3ba",
                                "sense_id": "31904992-fb05-30cf-a0aa-0d35580e8879",
                                "text": "„Wenn es nach mir gegangen wäre, hätte man mich in einem hermetisch versiegelten, mit Rubinen besetzten Bronzesarg begraben – nicht einfach begraben, sondern in einer weißen Marmorgruft zur Ruhe gebettet.“"
                            },
                            {
                                "example_id": "f630a99c-cc97-4188-8e00-6055599f1a9d",
                                "sense_id": "31904992-fb05-30cf-a0aa-0d35580e8879",
                                "text": "„Unaufhörlich prasselte der Regen auf den Regenschirm und die Marmorgrüfte ringsum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
