                                "example_id": "062f50da-5847-40eb-b553-10871ddd09d0",
                                "sense_id": "79b1cc22-7f7b-3655-afd4-95857ff234fc",
                                "text": "The Rail Accident Investigation Branch's preliminary examination of the site of a cement train derailment at Sheffield station on November 11 found that a series of rail fastenings had broken, some before the accident, causing the tracks to spread under the train."
                            }
                        ]
                    }
