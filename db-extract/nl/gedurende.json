                                            {
                                                "example_id": "95b89601-a3be-4386-abd0-25a0539be9c3",
                                                "sense_id": "0f20d9e3-0322-3812-92a5-4cf91feef71d",
                                                "text": "Durant l’hiver."
                                            },
                                            {
                                                "example_id": "9bbdbe43-ee35-432f-a1a7-3944d3dbe484",
                                                "sense_id": "0f20d9e3-0322-3812-92a5-4cf91feef71d",
                                                "text": "Durant toute sa vie."
                                            },
                                            {
                                                "example_id": "cf1aa19d-c6fe-4b0b-a532-4635b5824bee",
                                                "sense_id": "0f20d9e3-0322-3812-92a5-4cf91feef71d",
                                                "text": "Il a dû nager durant des heures."
                                            },
                                            {
                                                "example_id": "1a1bf38f-ddfc-4bd1-8766-2d2871f0b7e2",
                                                "sense_id": "0f20d9e3-0322-3812-92a5-4cf91feef71d",
                                                "text": "— En 1797, Philippot était de cette armée de Rhin-et-Moselle que Hoche mena d’Andernach à Wetzlar et il nous raconte qu'elle suivit l'ennemi sans relâche durant vingt lieues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd41820c-5d90-3118-b2ed-7e06b0e63073",
                                        "entry_id": "bbc0c5bf-6054-3df7-93f0-5d0b88ed3af6",
                                        "glosses": [
                                            "Au cours de."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "durant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0759ea3-e83b-3269-9eb1-e2fea0b5a6b6",
                                        "entry_id": "0951e784-2795-3385-82b9-1b2597f8fe77",
                                        "glosses": [
