                    {
                        "translation_id": "4b5e5ef9-fbf4-4eea-a59a-3d6388d624d7",
                        "source_entry_id": "29387927-0e6e-3d1a-9786-4c1dfbf2e0dc",
                        "source_sense_id": "12493c2c-cedf-3a90-824e-fb782505fff6",
                        "target_lang_word": "Jurist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jurist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                        "entry_id": "c1c9374c-f0ca-399f-a87d-6e5f41fd99f2",
                                        "glosses": [
                                            "jemand, der Rechtswissenschaft studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9fca6f-83bf-4b35-aa69-1b269fda5f57",
                                                "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                                "text": "Unter den Studenten bilden die Juristen eine besondere Spezies."
                                            },
                                            {
                                                "example_id": "cb0f161e-4a66-4d50-af4d-5a21b1f7831d",
                                                "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                                "text": "„Trotz der Einsicht der Juristen in die Verbesserungswürdigkeit von Gesetzestexten sei noch viel zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                        "entry_id": "c1c9374c-f0ca-399f-a87d-6e5f41fd99f2",
                                        "glosses": [
                                            "Deutschland: jemand, der das Jurastudium mit dem zweiten Staatsexamen abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9cbf30-57c7-4f60-b814-ca7b5538ea25",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "Ein Jurist weiß, wie ein Gerichtsurteil zu lesen ist."
                                            },
                                            {
                                                "example_id": "4eb67c8c-10f2-4485-93d7-cb948b7a48b3",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Sie hatte in Berlin Schauspielerin werden wollen und war in Jerusalem die Frau eines langweiligen Juristen geworden.“"
                                            },
                                            {
                                                "example_id": "d40b4a2b-b269-4ec6-b928-33f401dbe0f4",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Nachdem Juristen, Software-Experten und Plagiatsforscher eine Woche lang das Werk des Ministers gefilzt haben, steht fest: Guttenberg hat in seiner Doktorarbeit nicht nur vereinzelt Fremdautoren zitiert, ohne dies nach üblichem Verfahren in einer Fußnote auszuweisen.“"
                                            },
                                            {
                                                "example_id": "3353bac5-ebd6-4c9b-9635-d1de6d82b1c3",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Leider hatten die Stadtväter die Rechnung ohne die Juristen gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6ac1ded-37f3-4efe-9ec4-c861fc523cfe",
                        "source_entry_id": "29387927-0e6e-3d1a-9786-4c1dfbf2e0dc",
                        "source_sense_id": "12493c2c-cedf-3a90-824e-fb782505fff6",
                        "target_lang_word": "jurist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jurist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                        "entry_id": "c6bc8627-fc4f-3528-adad-798d87a39a8e",
                                        "glosses": [
                                            "An expert of law or someone who researches jurisprudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b7826d-f79c-44ac-87ba-2b3058ee35d4",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "The young lawyer hoped to become a renowned jurist one day."
                                            },
                                            {
                                                "example_id": "11de9cfa-c7ce-457b-8a3c-7bafac7d09d4",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "The distinguished jurist wrote extensively on constitutional law."
                                            },
                                            {
                                                "example_id": "bce982a4-903a-4fa8-b059-a7a6aad59008",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "As a jurist, she was respected for her impartiality."
                                            },
                                            {
                                                "example_id": "998325b4-bdae-40b1-9848-a4769f1a3f1a",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "distinguished jurist"
                                            },
                                            {
                                                "example_id": "e67a7b0a-2941-4e78-8803-593b663e788d",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "eminent jurist"
                                            },
                                            {
                                                "example_id": "0ae57b60-b08c-449b-8e89-064b8e1144b5",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "constitutional jurist"
                                            },
                                            {
                                                "example_id": "438c91ec-e926-4cdb-ace0-95036692d678",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "comparative-law jurist"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a1fb06-2c82-30b0-94d7-11927fe1494f",
                                        "entry_id": "c6bc8627-fc4f-3528-adad-798d87a39a8e",
                                        "glosses": [
                                            "A judge."
                                        ],
                                        "tags": [
                                            "Canada",
