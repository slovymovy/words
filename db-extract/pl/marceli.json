                        "examples": [
                            {
                                "example_id": "a628fa80-7bfb-4e64-86fe-3b7dafc3506b",
                                "sense_id": "f2f04c80-2df4-36f1-87b1-32b114c598c2",
                                "text": "Mam na imię Marceli i jestem nauczycielem z Jeleniej Góry."
                            },
                            {
                                "example_id": "6ed1c3e3-1aee-4c01-91c7-a7328ecf071b",
                                "sense_id": "f2f04c80-2df4-36f1-87b1-32b114c598c2",
                                "text": "16 stycznia, 19 lutego i 17 lipca przypadają imieniny Marcelego i Marcela."
                            },
                            {
                                "example_id": "d933a28a-1ffe-4999-a4d5-f6f326e5e7f2",
                                "sense_id": "f2f04c80-2df4-36f1-87b1-32b114c598c2",
                                "text": "Panie Marceli, proszę nas jutro odwiedzić."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
