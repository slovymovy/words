                        "glosses": [
                            "различающийся по значению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64484189-7f38-412c-b06e-64d3758e26ee",
                                "sense_id": "e0edadc3-7fbb-3526-8361-14a029c5ddec",
                                "text": "Однако не обязательно она должна быть фактической, разнозначными последствиями обладает и объявление гражданина судом в установленном порядке умершим (при этом предварительное признание его безвестно отсутствующим не требуется)."
                            }
                        ]
                    }
