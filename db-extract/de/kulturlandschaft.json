                ],
                "senses": [
                    {
                        "sense_id": "1b19190b-9627-3eee-ad70-ecc3e14397fa",
                        "entry_id": "be117107-bf71-3b64-8b72-0f17aaaf00a3",
                        "glosses": [
                            "eine durch die Wirtschaftsweise des Menschen stark geprägte Landschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d71fecb-05d5-468a-87ba-6f19374d7a0a",
                                "sense_id": "1b19190b-9627-3eee-ad70-ecc3e14397fa",
                                "text": "Der Grad der Umwandlung von Naturlandschaften in Kulturlandschaften - in Kultursteppen mit Getreidefeldern anstelle der Wiesen und Wälder oder in Kulturwüsten wie Großstädten - hängt vom kulturellen und technischen Stand der Völker ab."
                            },
                            {
                                "example_id": "1ce8def9-24e6-4541-8ea2-f840e98d4619",
                                "sense_id": "1b19190b-9627-3eee-ad70-ecc3e14397fa",
                                "text": "„Die Kulturlandschaft ist eindeutig vom Ackerland dominiert und unterscheidet sich damit deutlich von den stark bewaldeten Mittelgebirgsregionen.“"
                            },
                            {
                                "example_id": "00254d6c-401a-4066-bd2d-e0cb730c3464",
                                "sense_id": "1b19190b-9627-3eee-ad70-ecc3e14397fa",
                                "text": "„Wir haben uns vom Hochrhein auf den Weg gemacht, die bedeutende Kulturlandschaft des Schwarzwalds zu erkunden.“"
                            },
                            {
                                "example_id": "d01009a5-551f-4af6-b2d2-0f7237415e29",
                                "sense_id": "1b19190b-9627-3eee-ad70-ecc3e14397fa",
                                "text": "„Ostpreußen ist eine unwiederbringlich versunkene Kulturlandschaft, und doch konnte ich als politischer Journalist das Thema nicht im historischen Raum stehen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
