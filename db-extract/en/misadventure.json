                                                "sense_id": "46701ea6-9e93-3c2b-b639-78b6a17825a8",
                                                "text": "Moja trzecia próba rzucenia palenia zakończyła się niepowodzeniem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
