                "forms": [
                    {
                        "form_id": "004a76f3-6f6b-44b0-99c8-8bd844d0e03a",
                        "entry_id": "a89f85e9-389a-34c9-9297-6ce2b0e430d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "berbérophones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05a33d67-d722-3dfa-b259-565d8453b1ad",
                        "entry_id": "a89f85e9-389a-34c9-9297-6ce2b0e430d0",
                        "glosses": [
                            "Qui parle le berbère"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c45488-8d33-44b6-a564-e44cc84f2e83",
                                "sense_id": "05a33d67-d722-3dfa-b259-565d8453b1ad",
                                "text": "Hors du Maroc, on trouvait des Juifs en milieu berbérophone, en Kabylie, au Mzab (parlers zénètes ou zenatiyya), dans le djebel Nefûssa au sud de Tripoli (parlers zénètes)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3d06477-05a1-4fe8-acd7-f82ce0014d7c",
                        "source_entry_id": "a89f85e9-389a-34c9-9297-6ce2b0e430d0",
                        "source_sense_id": "05a33d67-d722-3dfa-b259-565d8453b1ad",
                        "target_lang_word": "Berberophone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berberophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22616cb8-f013-31c4-98c2-d568b3aba574",
                                        "entry_id": "e7a0eb71-28bd-3145-ac89-2064506b80cc",
                                        "glosses": [
                                            "Speaking the Berber language"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e742ef-efad-4377-967d-28b53a1e3d83",
                                                "sense_id": "22616cb8-f013-31c4-98c2-d568b3aba574",
                                                "text": "Algeria's Berberophone population"
                                            },
                                            {
                                                "example_id": "a508cbb0-9d08-4123-a65a-39ececff04ad",
                                                "sense_id": "22616cb8-f013-31c4-98c2-d568b3aba574",
                                                "text": "There are Berberophone pockets of some size in the more rugged regions, and a heavy infiltration of Berber in most rural speech, having to do particularly with the names of flora and fauna, tools and utensils, toponymy, and a special vocabulary fitted to the settled agriculture of the area."
                                            },
                                            {
                                                "example_id": "52e88f65-64a8-46ca-8051-c8970795556d",
                                                "sense_id": "22616cb8-f013-31c4-98c2-d568b3aba574",
                                                "text": "Nearly half of the Moroccan population is Berberophone; i.e. they are monolingual Berbers, and the majority of them are bilingual because they also speak Dialectal Arabic."
                                            },
                                            {
                                                "example_id": "212182d5-8173-4ac9-b991-df97e0028984",
                                                "sense_id": "22616cb8-f013-31c4-98c2-d568b3aba574",
                                                "text": "Morocco is a special country because of the importance of the presence of → Berber. Over 40 percent of the population is Berberophone; this is an estimate because there are no official figures."
                                            },
                                            {
                                                "example_id": "dd7b5ea9-8887-4b41-9b92-5661b49200bd",
                                                "sense_id": "22616cb8-f013-31c4-98c2-d568b3aba574",
                                                "text": "In the capital city Algiers, around half of the population is Berberophone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Berberophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65fec54c-01cc-3b37-8de0-a7956799e080",
                                        "entry_id": "0fc28f1a-b5d6-36d6-ba6c-52c9e102c76b",
                                        "glosses": [
                                            "One who speaks the Berber language"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
