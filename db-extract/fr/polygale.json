                    },
                    {
                        "form_id": "8a8a1d71-53d0-47be-8903-646bff454c9a",
                        "entry_id": "100135f3-23ff-3722-a99f-7b0121de78d6",
                        "tags": [],
                        "form": "polygala"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                        "entry_id": "100135f3-23ff-3722-a99f-7b0121de78d6",
                        "glosses": [
                            "Plante annuelle ou vivace, dicotylédone, herbacée, parfois ligneuse selon les espèces, et dont les fleurs ont trois pétales inégaux soudés entre eux par leur base."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2588b1fa-154e-47c8-9d56-efb4ebb6cce1",
                                "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                                "text": "Comme il fait beau, comme rien ne presse, (...) nous revenons à pied, flânant le long de la route entre les haies hautes où fleurissent les polygalas, bleus et rose vineux."
                            },
                            {
                                "example_id": "be7944da-9384-4815-9285-af11856237d7",
                                "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                                "text": "Le polygale du calcaire (Polygala calcarea) est une petite plante herbacée vivace de la famille des Polygalacées."
                            },
                            {
                                "example_id": "8f392b09-ffdb-4d43-b297-2c2d1b810274",
                                "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                                "text": "La plus curieuse est le polygale faux-buis, Polygala chamaebuxus (du grec chamaï, nain, et de buxus, buis), sous-arbrisseau aux fleurs ailées, blanches, jaunes et rouges, dont les petites feuilles coriaces rappellent celles du buis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "290d571d-8322-4928-952d-3416f523b017",
                        "source_entry_id": "100135f3-23ff-3722-a99f-7b0121de78d6",
                        "source_sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                        "target_lang_word": "Kreuzblume",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreuzblume",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2918d4-3c54-344a-80d6-9bab21c11375",
                                        "entry_id": "57fa13f7-6936-32e7-87db-430ae14bcfb6",
                                        "glosses": [
                                            "blumenartiges Ornament an gotischen Bauwerken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1716853-040e-4794-b639-7e4308a57fbf",
                                                "sense_id": "cb2918d4-3c54-344a-80d6-9bab21c11375",
                                                "text": "„Jeder der vergoldeten Gitterstäbe des Käfigs war mit einer stilisierten Kreuzblume verziert.“"
                                            },
                                            {
                                                "example_id": "c3eb2926-5807-4191-9e88-77ff9a5e7892",
                                                "sense_id": "cb2918d4-3c54-344a-80d6-9bab21c11375",
                                                "text": "„Sie werden von drei grossen Kreuzblumen bekrönt, zwischen denen sich zwei Fialen befinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba74205b-b195-3cdb-9088-46d764f698e4",
                                        "entry_id": "57fa13f7-6936-32e7-87db-430ae14bcfb6",
                                        "glosses": [
                                            "Pflanze, die in verschiedensten Arten vorkommt und weiße bis rote Blüten aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c7f8362-afe6-48ef-aa75-dd46c8c7b2d6",
                                                "sense_id": "ba74205b-b195-3cdb-9088-46d764f698e4",
                                                "text": "„In den Schweizer Bergen treibt es die Kreuzblume besonders bunt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
