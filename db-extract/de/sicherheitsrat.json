                "senses": [
                    {
                        "sense_id": "5bf8be29-37b6-348b-ba0f-db6ed40d906a",
                        "entry_id": "fe007855-9cab-3ab3-8a69-426be9eb481a",
                        "glosses": [
                            "Einrichtung/Organisation, die die Sicherheit gewährleisten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4988fd7f-8a85-4df5-bc32-6f85ddcefcad",
                                "sense_id": "5bf8be29-37b6-348b-ba0f-db6ed40d906a",
                                "text": "„Im Januar 1947 kündigte der Sicherheitsrat der Vereinten Nationen in der Resolution 16, Artikel 24 die Bildung des Freien Territoriums Triest an.“"
                            },
                            {
                                "example_id": "eebf0fb8-2a0b-47aa-9f5c-e9c8c33a589b",
                                "sense_id": "5bf8be29-37b6-348b-ba0f-db6ed40d906a",
                                "text": "„Der UN-Sicherheitsrat hat für eine einmonatige Waffenrufe in Syrien gestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
