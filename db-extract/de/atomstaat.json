                        "entry_id": "2a2d0591-db9c-37d2-a351-e9a2ddb34341",
                        "glosses": [
                            "Staat, der Atomkraftwerke/Kernkraftwerke betreibt, plant oder Komponenten dafür herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f84b2fe-1961-4f34-8948-0e37864460ac",
                                "sense_id": "f858e27b-6f57-3d4a-ae4a-c92eb75bbd27",
                                "text": "„Kein Zweifel, die Nuklearkatastrophe von Fukushima hat das gesellschaftliche Denken und Fühlen im fernöstlichen Atomstaat stärker verändert, als es den Regierenden lieb ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
