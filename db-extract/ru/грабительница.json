                        ]
                    },
                    {
                        "translation_id": "39907f46-21fb-4546-b091-bc1ff72ab1d9",
                        "source_entry_id": "1dfb8494-9072-3680-835f-20a3f4dc4b4c",
                        "source_sense_id": "e257a31b-e16c-3951-9a40-d9c2468939e3",
                        "target_lang_word": "brigande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brigande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d16e9693-12b8-3666-a6d6-5319780ad1f2",
                                        "entry_id": "875ba25d-9d69-37e2-9173-bf678014e58f",
                                        "glosses": [
                                            "Celle qui exerce habituellement le brigandage."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3043b997-0dd2-4196-bf70-b0ac371eb8c7",
                                                "sense_id": "d16e9693-12b8-3666-a6d6-5319780ad1f2",
                                                "text": "Il n’attendra jamais qu’on lui rappelle qu’il a été, à dix-sept ans, stuartiste, jacobite et cavalier ; qu’il a presque aimé la Vendée avant la France ; que si son père a été un des premiers volontaires de la grande république, sa mère, pauvre fille de quinze ans, en fuite à travers le Bocage, a été une brigande, comme madame de Bonchamp et madame de Larochejaquelein."
                                            },
                                            {
                                                "example_id": "c692cb02-8891-4b03-bd4e-145816aa6670",
                                                "sense_id": "d16e9693-12b8-3666-a6d6-5319780ad1f2",
                                                "text": "La petite brigande n’était pas plus grande que Gerda, mais elle était plus forte, elle était trapue ; son teint était brun, ses yeux noirs : ils étaient inquiets, presque tristes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brigande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c62cf3d-3d7c-384d-aa78-0ca018c4d8bf",
                                        "entry_id": "ad5c9ee3-9b1d-32ac-822c-61e81ccefe11",
                                        "glosses": [
                                            "Féminin singulier de brigand."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97f79924-72ce-4d8a-b562-ba4d8248e6b4",
                                                "sense_id": "3c62cf3d-3d7c-384d-aa78-0ca018c4d8bf",
                                                "text": "percevant, avec une précision terrible, du fond des ondes où il s’abîmait, la brigande clameur du dehors, et tenté, combien de fois ! de s’élancer en exterminateur sur cette racaille."
                                            }
