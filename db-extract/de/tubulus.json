                "senses": [
                    {
                        "sense_id": "581248de-ece5-370e-9ba2-37537a93ec26",
                        "entry_id": "793dc866-5500-31df-9921-a5768e74e3cd",
                        "glosses": [
                            "röhrenförmige Feinstruktur sowohl von Organen, zum Beispiel der Niere, als auch von Organellen der Zelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "788039ed-aedd-4a54-9f47-521bbb023045",
                                "sense_id": "581248de-ece5-370e-9ba2-37537a93ec26",
                                "text": "Die Henlesche Schleife gliedert sich in einen proximalen und einen distalen Tubulus."
                            },
                            {
                                "example_id": "e77d74d5-e94b-4b62-9275-0ee6d44f22f0",
                                "sense_id": "581248de-ece5-370e-9ba2-37537a93ec26",
                                "text": "Die Tubuli gehören nicht zu den Nierenkörperchen in der Nierenrinde, aber sie sind ihre Fortsetzung bis ins Innere der Niere und sind dort ein Teil des Nierenmarks, sie enden in den Nierenpyramiden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
