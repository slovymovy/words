                "senses": [
                    {
                        "sense_id": "27f5f827-d2ab-37c7-bebc-ce7f3996a398",
                        "entry_id": "aa46265d-b913-3259-9c35-079c4d2b9ba7",
                        "glosses": [
                            "Relating to surgery; by means of surgery."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e14ffd9a-dfef-4086-a859-24ed5fdfcf3f",
                                "sense_id": "27f5f827-d2ab-37c7-bebc-ce7f3996a398",
                                "text": "His cancer was treated surgically instead of with drugs or radiation."
                            },
                            {
                                "example_id": "5d598ce8-ae3f-494a-967c-cd723696510b",
                                "sense_id": "27f5f827-d2ab-37c7-bebc-ce7f3996a398",
                                "text": "When HBO airs “Behind the Candelabra” on May 26, the world will get to see Matt Damon play Liberace’s drug-addled, surgically enhanced lover – a role about as far from Jason Bourne as it gets."
                            },
                            {
                                "example_id": "c25746f7-56fb-4f4a-a5c8-0b909e5843f3",
                                "sense_id": "27f5f827-d2ab-37c7-bebc-ce7f3996a398",
                                "text": "The cause of uroperitoneum often can be determined and the condition corrected surgically."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d88a0199-d3da-4093-9083-26f8e503d5b2",
