                        "glosses": [
                            "het belangrijkste centrale deel van een land zonder de randgebieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3fe82d9-2f05-45ae-89e1-795fc8ffbd08",
                                "sense_id": "4bce920b-9734-3db4-aea7-73fb850fd2d0",
                                "text": "De Syrische rompstaat die aldus zou ontstaan geeft Iran bovendien strategisch diepte omdat het gebied direct grenst aan de Libanese Bekavallei, waar Hezbollah actief is."
                            },
                            {
                                "example_id": "2e94874b-17fa-4a3e-b4b7-48f5caaffbd9",
                                "sense_id": "4bce920b-9734-3db4-aea7-73fb850fd2d0",
                                "text": "In Hongarije is deze taalwet ook niet onopgemerkt gebleven. Dit land lijdt nog steeds aan het trauma van Trianon, het verdrag uit 1920 dat het land tot rompstaat verkleinde."
                            }
                        ]
                    }
