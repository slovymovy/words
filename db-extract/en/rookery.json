                    {
                        "translation_id": "0f63db85-716e-443d-9c66-3b9b4b8332cb",
                        "source_entry_id": "98c87644-2834-37f9-b09e-e056b15b8db3",
                        "source_sense_description": "a colony of breeding birds or other animals",
                        "target_lang_word": "zona di nidificazione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "296e6f8f-0c9d-4e9a-ad8f-0982964fc9d9",
                        "source_entry_id": "98c87644-2834-37f9-b09e-e056b15b8db3",
                        "source_sense_description": "a colony of breeding birds or other animals",
                        "target_lang_word": "ле́жбище",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ле́жбище",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d40c30d9-e7cc-3111-8e97-70e5819e12cc",
                                        "entry_id": "30af80a5-cbf9-3243-9e42-c22be64e0318",
                                        "glosses": [
                                            "зоол. место на суше, где лежат стадами некоторые морские животные"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9e8fb59-fbd8-4383-bee0-8cc785017a90",
                                                "sense_id": "d40c30d9-e7cc-3111-8e97-70e5819e12cc",
                                                "text": "Командорские острова известны как лучшее, если не единственное в мире, лежбище ценного морского котика, количество которого вследствие беспощадного истребления стало быстро уменьшаться."
                                            },
                                            {
                                                "example_id": "2c6cc660-9c0f-422a-b4b0-417f3879c687",
                                                "sense_id": "d40c30d9-e7cc-3111-8e97-70e5819e12cc",
                                                "text": "А когда стали различимы отдельные камни и скалы на берегу, пошли обходом вокруг острова, пристально вглядываясь в прибрежные места с тем, чтобы обнаружить лежбище нерпы."
                                            },
                                            {
                                                "example_id": "2e8e2167-5558-4968-b1b7-c703dd58baf5",
                                                "sense_id": "d40c30d9-e7cc-3111-8e97-70e5819e12cc",
                                                "text": "При появлении человека на лежбище котики часто покидают берег и пережидают опасность в океане."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8409fbc6-2ab8-37ed-ae7d-bc86ff187983",
                                        "entry_id": "30af80a5-cbf9-3243-9e42-c22be64e0318",
                                        "glosses": [
                                            "охотн. место, где лежит, скрывается зверь; след лежавшего на земле зверя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed252535-c66b-4394-a990-fcc293a0d67b",
                                                "sense_id": "8409fbc6-2ab8-37ed-ae7d-bc86ff187983",
                                                "text": "Охотники вышли ночью, чтобы перекрыть путь кабанам, возвращавшимся к лежбищам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e12dcc06-17b3-3e82-91c6-d097f624eaaa",
                                        "entry_id": "30af80a5-cbf9-3243-9e42-c22be64e0318",
                                        "glosses": [
                                            "перен., разг. место для лежания; лежанка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41693ba8-88e2-40a2-8249-be6f3b84a283",
                                                "sense_id": "e12dcc06-17b3-3e82-91c6-d097f624eaaa",
                                                "text": "Бросили ломкого, но приятно пахнущего камыша в углу под навесом и на нём устроили лежбище."
                                            },
                                            {
                                                "example_id": "ab76596b-cb33-4065-b18a-1e50baea4571",
                                                "sense_id": "e12dcc06-17b3-3e82-91c6-d097f624eaaa",
                                                "text": "Он увидел отражение своего дивана в стекле и поразился — обрыдлое лежбище, которое ему столько раз хотелось вынести на помойку и сжечь, в зеркальном развороте показалось лучшей частью незнакомого и удивительно красивого интерьера."
                                            },
                                            {
                                                "example_id": "95e626b5-fb56-4f15-8fc2-2da5eb76c37f",
                                                "sense_id": "e12dcc06-17b3-3e82-91c6-d097f624eaaa",
                                                "text": "У выхода на крышу натыкаемся на лежбище бомжа."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
