                "senses": [
                    {
                        "sense_id": "e7ac7f0d-6c95-386a-ab69-e2721a3e9248",
                        "entry_id": "109f9b34-4463-300a-b396-1db625af0136",
                        "glosses": [
                            "voldoende geldmiddelen hebbend om ruim te kunnen leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79cbf4a1-2ec2-4e09-b4ae-b90730b7200e",
                                "sense_id": "e7ac7f0d-6c95-386a-ab69-e2721a3e9248",
                                "text": "Hij is een oude doch bemiddelde man."
                            },
                            {
                                "example_id": "98470cca-7592-44b8-a40e-39ce8dc82dff",
                                "sense_id": "e7ac7f0d-6c95-386a-ab69-e2721a3e9248",
                                "text": "De Eygenaar der gemelde Moolen, die een wel bemiddeld Man geweest is, en eene Vrouw met drie Kinderen had, wierd terwyl zyn Knegt met den Moolenwagen zig in 't na by gelegen Dorp begeven had, om derwaards Meel te brengen, van een sterke Bende Rovers overvallen, welke hem, benevens zyne Vrouw en Kinderen, in stukken kapten, alle de Hoofden afsneden, en die vervolgens op een rye van de in de Kamer zig bevindende tafel plaatsten, dog de Lyken lieten zy op den grond leggen."
                            }
                        ]
                    }
                ],
