                "senses": [
                    {
                        "sense_id": "c17a06cb-53c6-37c7-b762-3089c4fbaf33",
                        "entry_id": "22039b01-5307-3253-b75d-c52850809301",
                        "glosses": [
                            "Jeune homme qui a terminé son temps de formation professionnelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f79b530a-9485-47b7-8f7d-18c31ace75c7",
                                "sense_id": "c17a06cb-53c6-37c7-b762-3089c4fbaf33",
                                "text": "Eh quoi, se dit le jeune émoulu, vais-je devoir passer mes jours derrière ces bureaux vitrés au lieu de m’aller promener dans les prés fleuris, vais-je me surprendre plein d’espoir les veilles de promotions, vais-je supputer, vais-je intriguer, vais-je mordre mon frein, moi qui rêvais de poésie, de trains de nuit, de sables chauds ?"
                            }
                        ]
                    }
                ],
