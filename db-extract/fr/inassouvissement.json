                        "glosses": [
                            "État de ce qui ne peut être assouvi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0148771f-d9af-4762-8e71-e5fce9a59c99",
                                "sense_id": "b2e5668d-26eb-36eb-a12f-857d6c78d9dc",
                                "text": "Une vie de honte l’aurait laissée peut-être moins lasse, moins hébétée, que cet inassouvissement achevant de se satisfaire par des ravages lents et secrets, qui modifiaient son organisme."
                            },
                            {
                                "example_id": "e1d27046-fc4c-4755-b333-587fb57bb642",
                                "sense_id": "b2e5668d-26eb-36eb-a12f-857d6c78d9dc",
                                "text": "L'Église s'effraye parfois de ces ardeurs de l'imagination et de ces désirs du combat ; elle y devine moins le renoncement que l'inassouvissement de l'âme."
                            }
                        ]
                    }
