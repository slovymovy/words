                                "de": "Dies war ein <w>bedauerlicher</w> Fehler, den wir nicht mehr rückgängig machen können."
                            }
                        },
                        {
                            "text": "Het is een <w>betreurenswaardige</w> zaak dat er zoveel fouten zijn gemaakt.",
                            "target_lang_translations": {
                                "en": "It is a <w>regrettable</w> matter that so many mistakes were made.",
                                "de": "Es ist eine <w>bedauerliche</w> Angelegenheit, dass so viele Fehler gemacht wurden."
                            }
                        }
                    ],
                    "synonyms": [
                        "jammerlijk",
                        "betreurenswaard",
                        "spijtig",
                        "beklagenswaardig"
                    ],
                    "antonyms": [
