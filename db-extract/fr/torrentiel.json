                    },
                    {
                        "form_id": "87dc5ef1-336f-430b-97ce-bd158d9ef84b",
                        "entry_id": "fdea3235-5fca-3450-8dca-dc348f22a541",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "torrentielles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3870ca4-1a92-3128-948b-02490a3b6ab1",
                        "entry_id": "fdea3235-5fca-3450-8dca-dc348f22a541",
                        "glosses": [
                            "Qui est produit par les torrents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7025038e-7de1-4841-a9d2-8c63cbf6fa86",
                                "sense_id": "c3870ca4-1a92-3128-948b-02490a3b6ab1",
                                "text": "Ajoutons que la formation de ces grès a été et reste encore très discutée : d'aucuns leur attribuent une origine torrentielle ; d'autres y voyaient un dépôt d'eau profonde."
                            }
                        ]
                    },
                    {
                        "sense_id": "bedca877-02bf-3abe-8c87-3f93194ab955",
                        "entry_id": "fdea3235-5fca-3450-8dca-dc348f22a541",
                        "glosses": [
                            "Qui a le caractère d’un torrent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b4d041-18af-4b63-bdf5-62bb56270d77",
                                "sense_id": "bedca877-02bf-3abe-8c87-3f93194ab955",
                                "text": "Des pluies torrentielles ont fait monter le Rhône de 4 mètres. L’île de la Barthelasse à Avignon et la promenade de l’Oulle sont inondées. Le rhonomètre marquait 4m,75. On s’attendait à une crue plus considérable."
                            },
                            {
                                "example_id": "e267c057-3015-48c3-8f1b-89ca65074bf3",
                                "sense_id": "bedca877-02bf-3abe-8c87-3f93194ab955",
                                "text": "Le temps, cependant, ne tarda pas à devenir pluvieux ; mais les passagers, confortablement installés dans la chambre de la chaloupe, n’eurent aucunement à souffrir des pluies torrentielles, très-communes pendant cette saison."
                            },
                            {
                                "example_id": "42ebdcdf-ec8b-419b-b594-7e4a78858f8f",
                                "sense_id": "bedca877-02bf-3abe-8c87-3f93194ab955",
                                "text": "L’atmosphère avait été lourde pendant toute la journée, et le soir un orage terrible se déclara. Les coups de tonnerre se succédaient sans interruption ; la pluie tombait, torrentielle."
                            },
                            {
                                "example_id": "d06ad79e-5f41-4c27-9159-78ad904d4929",
                                "sense_id": "bedca877-02bf-3abe-8c87-3f93194ab955",
                                "text": "J’ai à peine terminé que l’obscurité arrive avec une pluie torrentielle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "722df3f5-52e3-41a0-bb5d-8708c6366d8e",
                        "source_entry_id": "fdea3235-5fca-3450-8dca-dc348f22a541",
                        "target_lang_word": "torrential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torrential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f49e96c-bfa8-3f25-8dc5-916bb561c01a",
                                        "entry_id": "af380e61-c3cd-3da0-955d-c6f0fe5d251d",
                                        "glosses": [
                                            "Coming or characterized by torrents; flowing heavily or in large quantities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a6cfc9f-73a5-4b52-b8eb-277d0de33add",
                                                "sense_id": "0f49e96c-bfa8-3f25-8dc5-916bb561c01a",
                                                "text": "There was a torrential downpour and we were all soaked."
                                            },
                                            {
                                                "example_id": "fd8066a5-6df4-4f71-b5e1-f03fb9d9c888",
                                                "sense_id": "0f49e96c-bfa8-3f25-8dc5-916bb561c01a",
                                                "text": "torrential rain"
                                            },
                                            {
                                                "example_id": "ef696cda-50c3-4340-a64d-f2b001622017",
                                                "sense_id": "0f49e96c-bfa8-3f25-8dc5-916bb561c01a",
                                                "text": "On the Saturday, October 1, the torrential rains began to wreak damage east of Exeter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
