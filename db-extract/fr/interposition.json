                        "form": "interpositions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8b7bde9-5c5b-38fe-9a2f-7c132877836b",
                        "entry_id": "6b50a962-f8ba-33ff-8b52-70bcec96a3ef",
                        "glosses": [
                            "État ou situation d’un corps interposé entre deux autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ac0a109-5337-4147-81ce-e5ac3702297f",
                                "sense_id": "e8b7bde9-5c5b-38fe-9a2f-7c132877836b",
                                "text": "Une éclipse de soleil et de lune peut résulter aussi bien d’une extinction - comme auprès de nous l’on voit cela arriver - qu’également d’une interposition d’autres corps, soit la terre, soit le ciel, ou un autre du même type ; […]."
                            },
                            {
                                "example_id": "dff69842-3179-4108-809c-cb1c81daeb20",
                                "sense_id": "e8b7bde9-5c5b-38fe-9a2f-7c132877836b",
                                "text": "L’interposition d’un nuage empêche que les rayons du soleil ne viennent jusqu’à nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "413ddf96-8f1f-32be-b797-e0cbf3453aab",
                        "entry_id": "6b50a962-f8ba-33ff-8b52-70bcec96a3ef",
                        "glosses": [
                            "Intervention, surtout en parlant d’une autorité supérieure."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a0ac139a-3e30-4c5b-9ba0-212db6ac53ef",
                                "sense_id": "413ddf96-8f1f-32be-b797-e0cbf3453aab",
                                "text": "L’interposition de l’autorité du souverain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a709a55d-a3f1-4fa6-8fda-4c5ea601fe56",
                        "source_entry_id": "6b50a962-f8ba-33ff-8b52-70bcec96a3ef",
                        "target_lang_word": "interposition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interposition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff41b3e-6520-368f-adaf-2ba578493b5a",
                                        "entry_id": "56f18336-39b7-3398-9122-b7702582aadc",
                                        "glosses": [
                                            "The act of interposing, or the state of being interposed; a being, placing, or coming between; mediation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e96206-d6c2-4e70-8f5b-66083d50464b",
                                                "sense_id": "3ff41b3e-6520-368f-adaf-2ba578493b5a",
                                                "text": "As he spoke, he tried to catch the remnant of the paper, but was too late—Lady Anne's eye had been more accurate than to admit such an interposition;..."
                                            },
                                            {
                                                "example_id": "5a2a7252-68df-4079-84d3-4d4b9327337d",
                                                "sense_id": "3ff41b3e-6520-368f-adaf-2ba578493b5a",
                                                "text": "[…] a Scuffle immediately ensued, which might have produced Mischief, had it not been prevented by the Interposition of Thwackum and the Physician […]"
                                            },
                                            {
                                                "example_id": "77da10b6-d404-4b64-97c0-7396cefe4653",
                                                "sense_id": "3ff41b3e-6520-368f-adaf-2ba578493b5a",
                                                "text": "“True, true,” cried Mr. Knightley, with most ready interposition—“very true […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ad170a-895f-3c4c-87de-62597d872322",
