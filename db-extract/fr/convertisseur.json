                    {
                        "translation_id": "fdb9e339-f2a4-4031-8ba6-142fa9178507",
                        "source_entry_id": "d53691b9-ce94-3a6a-879e-726640f5b1bb",
                        "source_sense_id": "f0ffb69c-ffcf-31a0-8712-0ad32e9e0bd6",
                        "source_sense_description": "En électricité",
                        "target_lang_word": "omvormer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omvormer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4b5c4764-995a-37e6-87d9-e49ecae7c548",
                                        "entry_id": "1401bad6-a36f-3fb5-98fd-7be9f3d32775",
                                        "glosses": [
                                            "apparaat dat de gelijkspanning van zonnepanelen omzet in 220 volt wisselspanning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "742b2846-cef9-482b-acbd-a5ffbf93c45d",
                                                "sense_id": "4b5c4764-995a-37e6-87d9-e49ecae7c548",
                                                "text": "Alwine de Raad kent het geluid van de omvormer van de zonnepanelen. \"Ben je aan het werk, hoor je opeens geluidjes uit de kast komen, als het systeem inschakelt. Dat was een kwestie van wennen. Dat we de zonnepanelen op de werkplaats hebben laten leggen, maakt de terugverdientijd van het systeem nog korter. Maar het past ook goed bij het duurzame imago van mijn glas in lood. Dus los van hoe je zelf over de wereld denkt, is ook puur bedrijfsmatig investeren in dit soort systemen een aanrader.\""
                                            },
                                            {
                                                "example_id": "473e353b-6f29-4d49-9770-0a44cee2786d",
                                                "sense_id": "4b5c4764-995a-37e6-87d9-e49ecae7c548",
                                                "text": "Om ze te verduurzamen krijgen de woningen dak-, gevel- en vloerisolatie en per woning acht zonnepanelen op het dak aan de achterzijde. Op de zolder wordt hiervoor een omvormer geplaatst. \"Elk paneel levert per jaar zo'n 300 kilowattuur (kWh) stroom op en maal acht is dat jaarlijks 2.400 kWh of meer\", zegt de manager vastgoed. Volgens Kemkes betekent dit voor de huurders een aanzienlijk besparing op de energielasten, ervan uitgaande dat een gezin met twee kinderen gemiddeld 4.600 kWh per jaar verbruikt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "755af3de-caa8-32a4-80da-4c1b2574e677",
                                        "entry_id": "1401bad6-a36f-3fb5-98fd-7be9f3d32775",
                                        "glosses": [
                                            "apparaat dat wisselstroom omzet in gelijkstroom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba57863d-ed83-4e0d-a3f7-49157a96afa8",
                                                "sense_id": "755af3de-caa8-32a4-80da-4c1b2574e677",
                                                "text": "Deze auto kan zowel gelijkstroom als wisselstroom aan. Volledig opladen van de batterijen neemt minimaal 9,5 uur in beslag als je met wisselstroom laadt, bij een wallbox thuis of een gewoon laadpunt onderweg. In dat geval komt namelijk de bijgeleverde 7,2 kW omvormer in actie, die wisselstroom in gelijkstroom omzet. Bij een 100 kW snellader met gelijkstroom (en daar zijn er nog niet heel veel in Nederland) is het mogelijk het batterijenpakket in 55 minuten voor 80 procent op te laden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
