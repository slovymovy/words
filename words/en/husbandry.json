{
    "word_family": [
        "husband"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d15e1d47-affc-342f-9b28-274fad543d08",
                    "sense_definition": "The practice or science of cultivating crops and breeding and raising livestock; agriculture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern <w>husbandry</w> techniques help farmers increase their yield while using fewer resources.",
                            "target_lang_translations": {
                                "tr": "Modern <w>tarım</w> teknikleri, çiftçilerin daha az kaynak kullanarak verimlerini artırmalarına yardımcı olur."
                            }
                        },
                        {
                            "text": "He decided to study agricultural science to better understand sustainable <w>husbandry</w>.",
                            "target_lang_translations": {
                                "tr": "Sürdürülebilir <w>çiftçiliği</w> daha iyi anlamak için ziraat bilimi okumaya karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "agronomy"
                    ],
                    "common_phrases": [
                        "animal husbandry",
                        "agricultural husbandry",
                        "sustainable husbandry"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ürün yetiştirme ve hayvancılık yapma bilimi veya uygulaması; tarım."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tarım",
                                "target_lang_sense_clarification": "genel ürün yetiştiriciliği ve çiftçilik"
                            },
                            {
                                "target_lang_word": "çiftçilik",
                                "target_lang_sense_clarification": "tarımsal üretim ve toprağı işleme"
                            },
                            {
                                "target_lang_word": "ziraat",
                                "target_lang_sense_clarification": "tarım bilimi ve uygulaması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b108302-9b19-3fe9-b2cf-a4cdc605437d",
                    "sense_definition": "The care, management, and breeding of animals, especially livestock or captive animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proper animal <w>husbandry</w> is essential for maintaining the health of livestock on the farm.",
                            "target_lang_translations": {
                                "tr": "Doğru <w>hayvancılık</w>, çiftlikteki çiftlik hayvanlarının sağlığını korumak için elzemdir."
                            }
                        },
                        {
                            "text": "The zoo keeper was commended for her exceptional standards of animal <w>husbandry</w>.",
                            "target_lang_translations": {
                                "tr": "Hayvanat bahçesi bakıcısı, gösterdiği olağanüstü <w>hayvan bakımı</w> standartları nedeniyle takdir edildi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "animal husbandry",
                        "captive husbandry",
                        "good husbandry"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hayvanların, özellikle çiftlik veya kümes/bakım altındaki hayvanların bakımı, yönetimi ve yetiştirilmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hayvancılık",
                                "target_lang_sense_clarification": "hayvan yetiştirme ve bakımı"
                            },
                            {
                                "target_lang_word": "hayvan bakımı",
                                "target_lang_sense_clarification": "hayvanların günlük bakımı ve idaresi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96899ddd-14a0-3da7-8ae2-c4b940d67d94",
                    "sense_definition": "Careful, prudent management or conservation of resources; thrift.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With careful <w>husbandry</w> of their limited funds, the family managed to save enough money for a home.",
                            "target_lang_translations": {
                                "tr": "Sınırlı fonlarını dikkatli bir <w>idare</w> ile kullanan aile, bir ev için yeterli parayı biriktirmeyi başardı."
                            }
                        },
                        {
                            "text": "The country's economic recovery relies on good <w>husbandry</w> of its natural resources.",
                            "target_lang_translations": {
                                "tr": "Ülkenin ekonomik olarak toparlanması, doğal kaynaklarının iyi bir şekilde <w>yönetilmesine</w> bağlıdır."
                            }
                        }
                    ],
                    "synonyms": [
                        "economy",
                        "frugality",
                        "thrift"
                    ],
                    "common_phrases": [
                        "good husbandry",
                        "careful husbandry",
                        "prudent husbandry"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kaynakların dikkatli, tedbirli idaresi veya korunması; idareli kullanım, tutumluluk."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tutum",
                                "target_lang_sense_clarification": "kaynakları idareli ve dikkatli kullanma"
                            },
                            {
                                "target_lang_word": "idare",
                                "target_lang_sense_clarification": "kaynak yönetimi ve tasarruf"
                            },
                            {
                                "target_lang_word": "tasarruf",
                                "target_lang_sense_clarification": "kaynakları verimli ve ihtiyatlı harcama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55bbeb3f-f17d-398b-aa12-2a07dddf08ce",
                    "sense_definition": "The routine administration, maintenance, or management of operational matters.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company oversees ship <w>husbandry</w> to ensure all vessels are properly maintained in port.",
                            "target_lang_translations": {
                                "tr": "Şirket, tüm gemilerin limanda düzgün bir şekilde bakım görmesini sağlamak için <w>gemi bakımı ve acenteliğini</w> denetler."
                            }
                        },
                        {
                            "text": "Effective vessel <w>husbandry</w> includes regular hull cleaning, repairs, and inspections.",
                            "target_lang_translations": {
                                "tr": "Etkili <w>gemi işletmeciliği</w>, düzenli tekne temizliği, onarımlar ve denetimleri içerir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ship husbandry",
                        "vessel husbandry"
                    ],
                    "target_lang_definitions": {
                        "tr": "Operasyonel konuların rutin idaresi, bakımı veya yönetimi (özellikle gemi/denizcilik alanında)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gemi acenteliği ve bakımı",
                                "target_lang_sense_clarification": "gemilerin liman operasyonları ve teknik idaresi"
                            },
                            {
                                "target_lang_word": "işletmecilik",
                                "target_lang_sense_clarification": "rutin teknik ve operasyonel bakım"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbfec856-778e-3edd-a4da-db802de8b91c",
                    "sense_definition": "Cultivated or agricultural land.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old records show how the ancient <w>husbandries</w> were divided among the local villagers.",
                            "target_lang_translations": {
                                "tr": "Eski kayıtlar, antik <w>tarım arazilerinin</w> yerel köylüler arasında nasıl bölündüğünü göstermektedir."
                            }
                        },
                        {
                            "text": "Generations of farmers worked these rich <w>husbandries</w> to feed the surrounding towns.",
                            "target_lang_translations": {
                                "tr": "Çiftçi nesilleri, çevre kasabaları doyurmak için bu zengin <w>toprakları</w> işledi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to refer to farmed land"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İşlenen veya ekilip biçilen tarım arazisi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tarım arazisi",
                                "target_lang_sense_clarification": "ekilen toprak ve çiftlik arazileri"
                            },
                            {
                                "target_lang_word": "otlak",
                                "target_lang_sense_clarification": "çiftçilik ve hayvancılık yapılan alan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}