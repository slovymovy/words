                    {
                        "sense_id": "ae63dfb2-56f2-3b93-862b-1a68b3e818cf",
                        "entry_id": "da3a7486-10f7-3ab8-bf74-00c4e8b8e706",
                        "glosses": [
                            "Loyal, honest."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "da21c852-80ae-4c4a-aa42-e85e4610312f",
                                "sense_id": "ae63dfb2-56f2-3b93-862b-1a68b3e818cf",
                                "text": "Mr Toots, like the leal and trusty soul he was, stopped the cabriolet in a twinkling, and told Susan Nipper of his commission, at which she cried more than before."
                            },
                            {
                                "example_id": "4e68ec1d-64ed-4d04-80af-89ea476c80ea",
                                "sense_id": "ae63dfb2-56f2-3b93-862b-1a68b3e818cf",
                                "text": "We thank you for the pure white fire of his goodness, for the red sword of justice in his hand, for the love he bears his leal people."
                            }
                        ]
                    },
                    {
                        "sense_id": "60e0c8ac-c474-3d37-a70b-a566559e38f4",
                        "entry_id": "da3a7486-10f7-3ab8-bf74-00c4e8b8e706",
                        "glosses": [
                            "True, genuine."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "c6f87b46-1b41-4dc6-ac77-d359b2b725cd",
                                "sense_id": "60e0c8ac-c474-3d37-a70b-a566559e38f4",
                                "text": "The lealest lover time can show, / Doomed for a lady-love to languish, / Among these solitudes doth go, / A prey to every kind of anguish."
                            }
                        ]
                    }
