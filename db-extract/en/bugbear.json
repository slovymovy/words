                                "target_senses": [
                                    {
                                        "sense_id": "5d442673-89e5-39a8-9653-dc7fe408c2fd",
                                        "entry_id": "9b94ca8f-85bb-3f91-9cdf-61b451e53a62",
                                        "glosses": [
                                            "een fysiek beeld dat dient om mensen bang te maken"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c05a8463-4b75-3a0b-b91b-1b91a4d34c2b",
                                        "entry_id": "9b94ca8f-85bb-3f91-9cdf-61b451e53a62",
                                        "glosses": [
                                            "een voorstelling of denkbeeld dat iemand bang maakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a7d2fa6-d2a5-4531-b28f-8fceab4931b0",
                                                "sense_id": "c05a8463-4b75-3a0b-b91b-1b91a4d34c2b",
                                                "text": "De undercoverreportage over commerciële rusthuizen is het schrikbeeld van wie bejaarde ouders heeft. Kunnen kinderen niet beter de zorg voor hun oude ouders zelf in handen nemen?"
                                            },
                                            {
                                                "example_id": "a348d81f-6bd3-409d-b0cd-86dfde5497da",
                                                "sense_id": "c05a8463-4b75-3a0b-b91b-1b91a4d34c2b",
                                                "text": "Het alarm ging letterlijk af. De Japanse tegenhanger van NL-Alert adviseerde bewoners hun toevlucht te zoeken in ‘stevige gebouwen en kelders’. Radio- en televisieprogramma's werden onderbroken. Het grote schrikbeeld doemde op: zou Japan nu heus voor de derde keer een atoomexplosie ondergaan? Nee, dus. Ja, er was wel grote schrik, maar nooit sprake van paniek, melden lokale media."
                                            },
                                            {
                                                "example_id": "54122cf2-a141-45f7-87d1-9e01002286f6",
                                                "sense_id": "c05a8463-4b75-3a0b-b91b-1b91a4d34c2b",
                                                "text": "Zo sprak Baudet in een interview met HP/de Tijd in juli het schrikbeeld uit van een jaarlijkse vluchtelingenstroom van 200 duizend asielzoekers naar Nederland. Allemaal migranten die 'onze banen en huizen inpikken', 'onze gezondheidszorg gebruiken, sociale voorzieningen leegplunderen' en 'tot slot ook de Nederlandse cultuur verloochenen' en '1,2 miljoen euro per huishouden' kosten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae0c9624-83cb-45b0-b680-cfa17fb22fc8",
