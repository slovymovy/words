                "senses": [
                    {
                        "sense_id": "d94a287f-7cd0-31af-9d8a-ca4c072a7edb",
                        "entry_id": "012e22ce-ac00-3ea1-8edd-9784f4fb6e75",
                        "glosses": [
                            "Gericht, dessen Sitzungen und Beschlüsse der Geheimhaltung unterliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f27f37-ee8e-45e9-88b6-b9765902846d",
                                "sense_id": "d94a287f-7cd0-31af-9d8a-ca4c072a7edb",
                                "text": "„Womöglich ordnete dieses Geheimgericht an, dass der Dienst die Zugangsdaten seiner Kunden zu den verschlüsselten E-Mail-Archiven herausgeben muss.“"
                            },
                            {
                                "example_id": "e91785b8-8dfb-43fd-8b6e-6b2c1132c9c1",
                                "sense_id": "d94a287f-7cd0-31af-9d8a-ca4c072a7edb",
                                "text": "„Bevor die National Security Agency (NSA) massenhaft Daten sammeln darf und die Geheimdienste abhören dürfen, müssen sie nicht nur den Justizminister um Erlaubnis bitten, sondern auch ein Geheimgericht, den Foreign Intelligence Surveillance Court (FISA-Gericht).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
