            "senses": [
                {
                    "sense_id": "0d3c0460-c794-3e0a-872f-645b2e66588c",
                    "sense_definition": "Een populaire tropische aquariumvis met een plat, schijfvormig lichaam en lange vinnen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>maanvis</w> zwemt rustig tussen de waterplanten in het grote aquarium.",
                            "target_lang_translations": {
                                "en": "The <w>angelfish</w> swims calmly among the water plants in the large aquarium."
                            }
                        },
                        {
                            "text": "In de dierenwinkel kocht hij een jonge <w>maanvis</w> voor zijn verzameling tropische vissen.",
                            "target_lang_translations": {
                                "en": "At the pet store, he bought a young <w>angelfish</w> for his collection of tropical fish."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tropische maanvis",
                        "maanvis in aquarium"
                    ],
                    "target_lang_definitions": {
                        "en": "A popular tropical aquarium fish with a flat, disc-shaped body and long fins."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "angelfish",
                                "target_lang_sense_clarification": "tropical freshwater aquarium fish"
                            },
                            {
                                "target_lang_word": "freshwater angelfish",
                                "target_lang_sense_clarification": "specifically the Pterophyllum genus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27a059df-dc65-3413-b6ac-67160410f84c",
                    "sense_definition": "Een zeer grote, zware zeevis met een rond lichaam die in oceanen leeft.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>maanvis</w> is de zwaarst bekende beenvis ter wereld en kan wel duizend kilo wegen.",
                            "target_lang_translations": {
                                "en": "The <w>ocean sunfish</w> is the heaviest known bony fish in the world and can weigh as much as a thousand kilos."
                            }
                        },
                        {
                            "text": "Duikers zagen een enorme <w>maanvis</w> vlak onder het wateroppervlak drijven.",
                            "target_lang_translations": {
                                "en": "Divers saw a huge <w>sunfish</w> floating just below the water's surface."
                            }
                        }
                    ],
                    "synonyms": [
                        "klompvis"
                    ],
                    "common_phrases": [
                        "zware maanvis",
                        "maanvis in zee"
                    ],
                    "target_lang_definitions": {
                        "en": "A very large, heavy marine fish with a round body that lives in oceans."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ocean sunfish",
                                "target_lang_sense_clarification": "the species Mola mola"
                            },
                            {
                                "target_lang_word": "sunfish",
                                "target_lang_sense_clarification": "large marine fish of the family Molidae"
                            },
                            {
                                "target_lang_word": "moonfish",
                                "target_lang_sense_clarification": "less common name for the ocean sunfish"
                            }
                        ]
                    }
                }
            ]
        }
    ]
