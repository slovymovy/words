                "senses": [
                    {
                        "sense_id": "b964306f-b49d-3bd2-8db4-8b1b4fbd6654",
                        "entry_id": "b84b9bda-a3de-3237-8f5e-f38a3b5e6d7b",
                        "glosses": [
                            "прост. треснуть, лопнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1578c0-6b58-4fa5-baf4-feb5902b077d",
                                "sense_id": "b964306f-b49d-3bd2-8db4-8b1b4fbd6654",
                                "text": "Но сейчас он совершенно отчетливо расслышал, как под ногой занятого только своей злобой Артура что-то хрястнуло. Не хрустнуло, а именно — хрястнуло."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce5e12dd-1b7d-3675-abcc-2b409662e2ea",
                        "entry_id": "b84b9bda-a3de-3237-8f5e-f38a3b5e6d7b",
                        "glosses": [
                            "прост. сильно ударить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85ac88f-e7b0-4adc-a24d-e9e5ba1dcefa",
                                "sense_id": "ce5e12dd-1b7d-3675-abcc-2b409662e2ea",
                                "text": "За что ты его бутылкой по башке-то хрястнул? — Да я гляжу, когда ты пошел, он сзади тебя и уже ножом снизу делает замах, ну я и хрястнул."
                            }
                        ]
                    }
