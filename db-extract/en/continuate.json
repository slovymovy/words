                                "example_id": "ea0ca72c-9e6d-469f-b1df-97bbf6ba81fb",
                                "sense_id": "97ebda62-37c7-30f2-b538-79a430d3328e",
                                "text": "An untirable and continuate goodness.",
                                "translation": "一种不知疲倦、持续不断的善良。"
                            }
                        ]
