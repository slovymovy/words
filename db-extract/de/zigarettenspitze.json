                "senses": [
                    {
                        "sense_id": "224acf10-35ba-3bdd-9908-0c06b9afca76",
                        "entry_id": "d7a7acf1-e8df-3a84-9838-eaa5fdf60863",
                        "glosses": [
                            "Raucherutensil: Mundstück, in das eine Zigarette eingesteckt werden kann, um sie zu rauchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698f409e-791d-4b24-aab0-4fad26f3d8ce",
                                "sense_id": "224acf10-35ba-3bdd-9908-0c06b9afca76",
                                "text": "„Er rauchte nur noch durch eine silberne Zigarettenspitze, und seine Schwiegermutter verehrte ihn dafür.“"
                            },
                            {
                                "example_id": "ec8b7bb3-7ca6-4329-85e3-d13ce7f22b83",
                                "sense_id": "224acf10-35ba-3bdd-9908-0c06b9afca76",
                                "text": "„Seine Zigaretten raucht der Zweitlehrer aus einer rotblonden Zigarettenspitze.“"
                            },
                            {
                                "example_id": "9855ed81-32e1-4a4d-9661-42b9eec8ba88",
                                "sense_id": "224acf10-35ba-3bdd-9908-0c06b9afca76",
                                "text": "„Außerdem gab es eine feine Dame mit Muff, riesigem Pelzkragen und langer Zigarettenspitze.“"
                            },
                            {
                                "example_id": "a3e18ec7-c3f0-4f44-af5e-ba87f29bdf12",
                                "sense_id": "224acf10-35ba-3bdd-9908-0c06b9afca76",
                                "text": "„Er hatte eine getönte Brille auf der Nase und paffte mit einer Zigarettenspitze einen Glimmstengel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "845e7ff1-b58f-4b29-af74-31ef9f0e356d",
                        "source_entry_id": "d7a7acf1-e8df-3a84-9838-eaa5fdf60863",
                        "source_sense_id": "224acf10-35ba-3bdd-9908-0c06b9afca76",
                        "source_sense_description": "Mundstück, in das eine Zigarette eingesteckt werden kann, um sie zu rauchen",
                        "target_lang_word": "cigarette holder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigarette holder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb4cd157-d19d-35ff-87e0-865e2e48aeeb",
                                        "entry_id": "c80816b1-fc61-37e0-89d6-2370efab4c94",
                                        "glosses": [
                                            "A tube-like device that holds a cigarette and through which the cigarette is smoked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4834b0eb-1c6d-4b02-ba2d-d38e6f3e73c1",
                                                "sense_id": "eb4cd157-d19d-35ff-87e0-865e2e48aeeb",
                                                "text": "The cigarette holder that uses a plastic cylinder filled with granules of silica reduced the nicotine content by 14 percent and the tar content by 21 percent."
                                            },
                                            {
                                                "example_id": "989cdaac-d5ea-4d90-bed4-54977955778c",
                                                "sense_id": "eb4cd157-d19d-35ff-87e0-865e2e48aeeb",
                                                "text": "He displayed the cigarette holder grandly on every occasion and had learned to manipulate it adroitly. Unwittingly, he had discovered deep within himself a fertile aptitude for smoking with a cigarette holder."
                                            },
                                            {
                                                "example_id": "e3cd966c-8fc8-4c91-8672-9defe452a200",
                                                "sense_id": "eb4cd157-d19d-35ff-87e0-865e2e48aeeb",
                                                "text": "Cigarette holders were considered an essential part of women's fashion from the early to the mid-twentieth century and are sometimes of quite simple design; or they may be incredibly ornate, with gemstone or mother-of-pearl inlays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a03bd2ef-0784-45d2-807e-f44f51ffa90b",
                        "source_entry_id": "d7a7acf1-e8df-3a84-9838-eaa5fdf60863",
                        "source_sense_id": "224acf10-35ba-3bdd-9908-0c06b9afca76",
                        "source_sense_description": "Mundstück, in das eine Zigarette eingesteckt werden kann, um sie zu rauchen",
                        "target_lang_word": "fume-cigarette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fume-cigarette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34991888-2bd6-308a-b4e6-dcb862734083",
                                        "entry_id": "d838d6e1-4d6c-3d39-94cf-192b7405f2a2",
                                        "glosses": [
                                            "Petit tube légèrement évasé, de matière diverse, à l’extrémité duquel on adapte la cigarette de manière à la fumer sans qu’elle touche aux lèvres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa9e0e7-bfe1-45c8-b513-1a5ad32b394c",
                                                "sense_id": "34991888-2bd6-308a-b4e6-dcb862734083",
                                                "text": "Elle plantait, par saccades, un fume-cigarette entre ses dents."
                                            },
                                            {
                                                "example_id": "fb361b64-33ab-4a44-a82a-591b6979aad3",
                                                "sense_id": "34991888-2bd6-308a-b4e6-dcb862734083",
                                                "text": "César était particulièrement distingué ce jour-là — au cou, un foulard de soie bordeaux, entre les doigts un long fume-cigarette d’ivoire — […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
