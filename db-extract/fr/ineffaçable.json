        "fr-extract.jsonl": [
            {
                "entry_id": "e94705e6-986c-31e3-8c9f-e71ebc22c4a3",
                "word": "ineffaçable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b350a183-6b75-4998-bed1-b58a36c0da8b",
                        "entry_id": "e94705e6-986c-31e3-8c9f-e71ebc22c4a3",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "ineffaçables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65a49476-84ee-3533-8d78-17ff30d655b8",
                        "entry_id": "e94705e6-986c-31e3-8c9f-e71ebc22c4a3",
                        "glosses": [
                            "Qui ne peut être effacé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1df7878-ae50-4741-8079-f491861cfb76",
                                "sense_id": "65a49476-84ee-3533-8d78-17ff30d655b8",
                                "text": "Quelques incisions à la cuisse, rendues ineffaçables, indiquaient le nombre d’ennemis tués par Moulibahan."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f6b442d-3090-34d6-8944-c1e799b34446",
                        "entry_id": "e94705e6-986c-31e3-8c9f-e71ebc22c4a3",
                        "glosses": [
                            "Qu’on ne peut faire disparaître."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "30301238-2c25-46ff-b135-50bd2804733c",
                                "sense_id": "0f6b442d-3090-34d6-8944-c1e799b34446",
                                "text": "J’ai le don, souvent douloureux, d’une mémoire que le temps n’altère jamais ; ma vie entière, avec toutes ses journées, m’est présente comme un tableau ineffaçable."
                            },
                            {
                                "example_id": "c41bc7b7-3791-44f6-aa16-2523553143f8",
                                "sense_id": "0f6b442d-3090-34d6-8944-c1e799b34446",
                                "text": "— Je pourrais les déchirer, les brûler mes diplômes ? hasardai-je.\nUn haussement d’épaules rebuté :\n— Ça n’avancerait pas ; il en reste quelque chose sur toi, dans ta façon de parler… c’est ineffaçable.\nJe baissai la tête sous le poids de mon indignité."
                            },
                            {
                                "example_id": "63551fc1-c891-4f69-a329-0842a63104ea",
                                "sense_id": "0f6b442d-3090-34d6-8944-c1e799b34446",
                                "text": "Le tragique est que là, devant moi, le passé reste mort en sa permanence et permanent en son dessèchement, tache ineffaçable ou parfum irretrouvable."
                            },
                            {
                                "example_id": "66d84d1d-4343-4e85-843a-a50f0d128646",
                                "sense_id": "0f6b442d-3090-34d6-8944-c1e799b34446",
                                "text": "Un souvenir ineffaçable. Il a fait à son honneur une tache ineffaçable. Cet événement m’a laissé une impression ineffaçable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c15a4e79-49a8-4ef5-920e-e7cbf94cd3dc",
                        "source_entry_id": "e94705e6-986c-31e3-8c9f-e71ebc22c4a3",
                        "target_lang_word": "unauslöschlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1f48ab78-0cae-4806-a73e-74b2a2ff48dd",
                        "source_entry_id": "e94705e6-986c-31e3-8c9f-e71ebc22c4a3",
                        "target_lang_word": "ineffaceable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ineffaceable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                        "entry_id": "68f7b9a7-6196-3328-8050-5e3861eb1388",
                                        "glosses": [
                                            "Incapable of being effaced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb47968-7902-4c6f-8744-7a438ede915e",
                                                "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                                "text": "Mr. Disbrowe was reclining on a well-worn horsehair-covered sofa, his frequent reclinings on which piece of furniture had stamped a deep and quite ineffaceable impression of his weighty form upon the cushion."
                                            },
                                            {
                                                "example_id": "a268682a-999f-446b-b3cc-b50db94ed010",
                                                "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                                "text": "[…] I am sure of one thing,—scars are plenty enough in Germany, among the young men; and very grim ones they are, too. They criss-cross the face in angry red welts, and are permanent and ineffaceable."
                                            },
                                            {
                                                "example_id": "032fb158-5192-4b2a-869a-97fe345fee4c",
                                                "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                                "text": "Although the country branch lines may pass, they leave with those who have known them so well an ineffaceable memory[,] and for those who will follow after[,] a memorial in the form of embankment, cutting and tunnel with here and there a station building or railway cottage that time does not destroy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f08c218d-acd4-41ed-aa73-afb8cf6407a3",
