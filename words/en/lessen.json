{
    "word_family": [
        "less"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81a1130f-d17b-355e-b3d5-db2965c878b5",
                    "sense_definition": "To make something smaller in size, amount, degree, or importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a new medication to <w>lessen</w> the pain.",
                            "target_lang_translations": {
                                "tr": "Doktor, ağrıyı <w>hafifletmek</w> için yeni bir ilaç yazdı."
                            }
                        },
                        {
                            "text": "Taking regular breaks can help to <w>lessen</w> the risk of burnout.",
                            "target_lang_translations": {
                                "tr": "Düzenli molalar vermek, tükenmişlik riskini <w>azaltmaya</w> yardımcı olabilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminish",
                        "reduce",
                        "decrease"
                    ],
                    "antonyms": [
                        "increase",
                        "intensify"
                    ],
                    "common_phrases": [
                        "lessen the impact",
                        "lessen the risk",
                        "lessen the pain"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin boyutunu, miktarını, derecesini veya önemini daha küçük hale getirmek, azaltmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "azaltmak",
                                "target_lang_sense_clarification": "miktar, şiddet veya etkiyi düşürmek"
                            },
                            {
                                "target_lang_word": "hafifletmek",
                                "target_lang_sense_clarification": "ağrı, acı veya yükü daha az hissedilir kılmak"
                            },
                            {
                                "target_lang_word": "düşürmek",
                                "target_lang_sense_clarification": "risk veya oran gibi şeyleri azaltmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c22b103-a208-36bd-bc00-dd049a48cc7d",
                    "sense_definition": "To become smaller, fewer, or less intense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the storm moved inland, the heavy rains began to <w>lessen</w>.",
                            "target_lang_translations": {
                                "tr": "Fırtına iç kesimlere doğru ilerledikçe şiddetli yağmurlar <w>azalmaya</w> başladı."
                            }
                        },
                        {
                            "text": "Her anxiety will gradually <w>lessen</w> as she gets used to the job.",
                            "target_lang_translations": {
                                "tr": "İşe alıştıkça endişesi yavaş yavaş <w>hafifleyecektir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminish",
                        "subside",
                        "decrease"
                    ],
                    "antonyms": [
                        "increase",
                        "grow"
                    ],
                    "target_lang_definitions": {
                        "tr": "Daha küçük, daha az veya daha az yoğun hale gelmek, azalmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "azalmak",
                                "target_lang_sense_clarification": "yoğunluğu veya miktarı kendiliğinden eksilmek"
                            },
                            {
                                "target_lang_word": "hafiflemek",
                                "target_lang_sense_clarification": "şiddeti, etkisi veya baskısı azalmak"
                            },
                            {
                                "target_lang_word": "dinmek",
                                "target_lang_sense_clarification": "yağmur, fırtına veya acı gibi şeyler için yatışmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "d6fa197c-d5b2-364f-acf0-dfec7270c522",
                    "sense_definition": "Except if; unless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They won't do any work <w>lessen</w> they are paid in advance.",
                            "target_lang_translations": {
                                "tr": "Ödemeleri peşin <w>yapılmadıkça</w> hiçbir iş yapmayacaklar."
                            }
                        },
                        {
                            "text": "You shouldn't disturb him <w>lessen</w> it is an absolute emergency.",
                            "target_lang_translations": {
                                "tr": "Kesin bir acil durum <w>olmadıkça</w> onu rahatsız etmemelisin."
                            }
                        }
                    ],
                    "synonyms": [
                        "unless"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "nonstandard variant of 'unless'"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Olmadıkça, -medikçe, meğerki (standart dışı/diyalekt kullanımı)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "-medikçe",
                                "target_lang_sense_clarification": "olmadığı takdirde"
                            },
                            {
                                "target_lang_word": "meğerki",
                                "target_lang_sense_clarification": "ancak o şartla"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}