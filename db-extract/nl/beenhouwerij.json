                    {
                        "translation_id": "d4ec5148-a329-4297-9074-b80b1dd0730b",
                        "source_entry_id": "801ae83e-a9ac-3cc6-a098-0f8ceadfd737",
                        "source_sense_id": "b614e136-66f8-3674-b6a7-0c299cdf39a5",
                        "source_sense_description": "Het bedrijf van een beenhouwer",
                        "target_lang_word": "boucherie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boucherie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "971af5e1-b83f-32d0-8a54-6f15da198a6b",
                                        "entry_id": "f6c75806-c148-3c80-9acc-4aad4d8aa3f6",
                                        "glosses": [
                                            "Endroit pour abattre les bêtes dont la chair doit être vendue."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39aae057-effc-446d-8fd7-7d1ac98488bf",
                                                "sense_id": "971af5e1-b83f-32d0-8a54-6f15da198a6b",
                                                "text": "Quand on fait couvrir les vaches dans le but d’avoir des veaux très-jeunes à envoyer à la boucherie et du lait à vendre en nature, on les fait saillir par de très-jeunes taureaux ; mais les veaux provenant de cet accouplement ont un tempérament lymphatique et sont plus maladifs que s’ils étaient issus d’un père plus robuste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b40e3018-3477-3014-88c1-cf146233a224",
                                        "entry_id": "f6c75806-c148-3c80-9acc-4aad4d8aa3f6",
                                        "glosses": [
                                            "Activité commerciale que pratiquent les bouchers, qui consiste à faire rassir, découper et vendre au détail de la viande crue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af5367f0-c739-40d8-a633-c56f16f9bea0",
                                                "sense_id": "b40e3018-3477-3014-88c1-cf146233a224",
                                                "text": "Remugle de la boucherie qui tient le « bouillon et bœuf », fade et terrible parfum des bêtes sacrifiées ; note résineuse, forestière de la sciure de sapin répandue sur le dallage."
                                            },
                                            {
                                                "example_id": "abaad9ca-e709-4680-a127-bf533be8bd47",
                                                "sense_id": "b40e3018-3477-3014-88c1-cf146233a224",
                                                "text": "Si vous me parlez que ça se mange alors c'est sans doute l'histoire des baby-bœufs dont on a beaucoup parlé récemment, ces pauvres bêtes que l'on engraissait artificiellement rien que pour la boucherie."
                                            },
                                            {
                                                "example_id": "6fdcc6ca-2afc-4eb1-9f92-f3b932a06343",
                                                "sense_id": "b40e3018-3477-3014-88c1-cf146233a224",
                                                "text": "La boucherie a haussé ses prix. — La boucherie est soumise à certains règlements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee5e220f-979a-38fd-bb0a-9a35b359d1b6",
                                        "entry_id": "f6c75806-c148-3c80-9acc-4aad4d8aa3f6",
                                        "glosses": [
                                            "Établissement commercial où œuvre le boucher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7745ddff-2e01-41cd-ad82-6ba01adf54f0",
                                                "sense_id": "ee5e220f-979a-38fd-bb0a-9a35b359d1b6",
                                                "text": "On y peint les maisons en rouge foncé, ce qui rappelle fâcheusement certaines boucheries de village ; les rares passants de ses rues silencieuses regardent les étrangers de l’air étonné et inquiet des gens qui n’en voient pas souvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "301b4ecf-a8ed-3bbd-86f0-30b08567d6b6",
                                        "entry_id": "f6c75806-c148-3c80-9acc-4aad4d8aa3f6",
                                        "glosses": [
                                            "Tuerie, massacre, carnage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f019ce3a-00e5-4ddb-97cf-909e7309dbc5",
                                                "sense_id": "301b4ecf-a8ed-3bbd-86f0-30b08567d6b6",
                                                "text": "— Mais cette boucherie est horrible ! Ces gens étaient âgés, prisonniers, sans armes ! On criera que c’est une lâcheté !\n— Une lâcheté !… Dites donc, le lettré, et les massacres de septembre ? C’était donc une blague quand vous nous disiez de faire comme en 93 !"
                                            },
                                            {
                                                "example_id": "3c02a07c-5e21-43c6-9d87-ceede890ab00",
                                                "sense_id": "301b4ecf-a8ed-3bbd-86f0-30b08567d6b6",
                                                "text": "La guerre du Piémont semble à distance une fringante promenade militaire ; à Solférino, cette boucherie, le rouge des culottes de zouave fait plus d’effet que celui du sang versé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df486b62-3e2f-3673-a515-125c19f97378",
                                        "entry_id": "f6c75806-c148-3c80-9acc-4aad4d8aa3f6",
                                        "glosses": [
                                            "Réunion pour tuer le cochon ensemble et se partager la viande."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baa9de42-56e7-4d0c-91d6-85f31beaf9a6",
                                                "sense_id": "df486b62-3e2f-3673-a515-125c19f97378",
                                                "text": "Au point que les natives = Indiens d’Amérique ne parlaient plus que français… et à quelques miles à la ronde, cousins et ascendants se côtoyaient et se fréquentaient régulièrement pour les boucheries (tuer le cochon ensemble et se partager la viande), les fais dodo (soirées dansantes chaque week-end) et les mariages et enterrements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
