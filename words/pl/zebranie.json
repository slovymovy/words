                    "frequency": "VeryLow",
                    "semantic_group_id": "totality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To naukowe opracowanie stanowi harmonijne <w>zebranie</w> dotychczasowych teorii badawczych.",
                            "target_lang_translations": {
