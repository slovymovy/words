                ],
                "senses": [
                    {
                        "sense_id": "758f2af0-918d-3b28-bb78-1d8632857d38",
                        "entry_id": "9838ef5c-e68f-3017-83ce-3b27c654b226",
                        "glosses": [
                            "Kritik am Verhalten gegenüber anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c304b9e-c354-4c2a-8066-4b58a96cebc1",
                                "sense_id": "758f2af0-918d-3b28-bb78-1d8632857d38",
                                "text": "„Alle Vorhaltungen, Überzeugungsversuche und Bitten halfen nichts, der Doktor blieb unbeirrbar und lernte in seiner Freizeit seelenruhig Arabisch, Kisuaheli und Mandingo-Dialekte.“"
                            },
                            {
                                "example_id": "d4d89134-ba15-4fb8-bd65-486cf601ebbf",
                                "sense_id": "758f2af0-918d-3b28-bb78-1d8632857d38",
                                "text": "„Er und ich, wir tun nichts anderes, als uns gegenseitig Vorhaltungen zu machen, wenn auch die Rollen nicht nach traditionellem Muster verteilt sind.“"
                            },
                            {
                                "example_id": "de12a7c6-9a3a-4819-a2a1-df378753e45a",
                                "sense_id": "758f2af0-918d-3b28-bb78-1d8632857d38",
                                "text": "„Ich sah, daß meine Vorhaltungen den ehrenwerten Jussuf bewegten.“"
                            },
                            {
                                "example_id": "7dc651b5-9fa7-4bf1-b173-d7cb5241270e",
                                "sense_id": "758f2af0-918d-3b28-bb78-1d8632857d38",
                                "text": "„In diesem Augenblick wurde heftig geklingelt, und ich konnte Mrs. Hudson, unsere Wirtin, hören, wie sie ihre Stimme erhob und in lautem Klageton entsetzte Vorhaltungen machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ede50e7-3bae-3c5e-8d24-5d870433788a",
                        "entry_id": "9838ef5c-e68f-3017-83ce-3b27c654b226",
                        "glosses": [
                            "Bereithaltung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef572177-08c3-4110-a7bc-59f660ce0f46",
                                "sense_id": "6ede50e7-3bae-3c5e-8d24-5d870433788a",
                                "text": "Die „Vorhaltung der Eisenbahninfrastruktur“ ist gesetzlich geregelt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
