                    {
                        "translation_id": "f5908193-4ab1-408f-93f1-9287499b4058",
                        "source_entry_id": "7116bfe7-3b31-3dc0-8680-4bcdead566c1",
                        "source_sense_id": "b777aca3-8e6f-3ee6-b2b0-8dba6d719937",
                        "target_lang_word": "Lethargie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lethargie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7583dbb-31fe-30c4-9440-279d5f8e2ccd",
                                        "entry_id": "06def2e7-0e65-388b-af1c-927804d588c0",
                                        "glosses": [
                                            "krankhafte Schlafsucht, Narkolepsie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891588c2-c070-43c7-a85b-be5da9647f04",
                                                "sense_id": "c7583dbb-31fe-30c4-9440-279d5f8e2ccd",
                                                "text": "Er leidet an Lethargie."
                                            },
                                            {
                                                "example_id": "00ea0eca-7130-408c-9500-cf06319abf58",
                                                "sense_id": "c7583dbb-31fe-30c4-9440-279d5f8e2ccd",
                                                "text": "Als ich ihn fragte, woher er so müde ist, meinte er: \"Auf den Winterschlaf folgt die Frühjahrsmüdigkeit gefolgt von der Sommerlethargie\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b476d54-0122-3128-a052-47ea55bf7680",
                                        "entry_id": "06def2e7-0e65-388b-af1c-927804d588c0",
                                        "glosses": [
                                            "Zustand der Trägheit, Teilnahms- und Interesselosigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396b54bf-8da2-4abc-966d-bd6f5141f87d",
                                                "sense_id": "5b476d54-0122-3128-a052-47ea55bf7680",
                                                "text": "„Micha saß von nun an wie betäubt auf seinem Stuhl, bis plötzlich etwas geschah — eine Unruhe griff um sich. Mario stieß Micha an, um ihn aus seiner Lethargie zu holen.“"
                                            },
                                            {
                                                "example_id": "39ea4eb7-3708-41b4-9ae8-fd9cf9fe34c3",
                                                "sense_id": "5b476d54-0122-3128-a052-47ea55bf7680",
                                                "text": "„Nach Lessings Tod 1781 schien die Bibliothek in eine erneute Phase der Lethargie zu verfallen, aus der sie erst wieder in der Nachkriegszeit unter der Leitung des Schriftstellers Erhard Kästner erwachte.“"
                                            },
                                            {
                                                "example_id": "3a14a6ad-b5d3-41c9-a7c6-d3317a93df58",
                                                "sense_id": "5b476d54-0122-3128-a052-47ea55bf7680",
                                                "text": "„Der gesundheitliche Einbruch hatte eine Lethargie zur Folge, die sich auch als Gedankenfaulheit über die Sprache legte.“"
                                            },
                                            {
                                                "example_id": "91b7871a-1a04-40f3-92fc-6e05f2f2fde0",
                                                "sense_id": "5b476d54-0122-3128-a052-47ea55bf7680",
                                                "text": "„Der augenblickliche Hoffnungstrahl hatte ihn jedoch wenigstens aus seiner träumenden Lethargie aufgerüttelt; er strich sich die langen, wild und unordentlich seine Schläfe umflatternden Haare aus der Stirn, schaute, fast wie ungläubig, einige Sekunden in dem engen Raum umher und bebte erst dann schaudernd wieder zusammen, als er dem starren Geisterblick der Geliebten begegnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
