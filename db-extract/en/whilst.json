                "senses": [
                    {
                        "sense_id": "7cb8021e-c08e-3187-8789-aa895bb2ccb0",
                        "entry_id": "4c68c107-dc65-3ebb-8d50-e405219f93dc",
                        "glosses": [
                            "在這期間；與此同時"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b027895f-3369-4f69-a5dc-6e542477c8c5",
                                "sense_id": "7cb8021e-c08e-3187-8789-aa895bb2ccb0",
                                "text": "Nay, I prethee put on this gown, & this beard, make him beleeue thou art ſir Topas the Curate, doe it quickly. Ile call ſir Toby the whilſt.",
                                "translation": "哦，我请你把这件袍子穿上，这把胡须套上，让他相信你是副牧师托巴斯师傅。快些，我就去叫托比老爷来。"
                            },
                            {
                                "example_id": "786d02f8-f67a-4902-87ab-6cb88602deb4",
                                "sense_id": "7cb8021e-c08e-3187-8789-aa895bb2ccb0",
                                "text": "What money have I bought with me? […] even but a small sum; something in hand the whilst.",
                                "translation": "我带来多少钱？不多不多，就是手头这一点。"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "53c4211b-604f-3cc9-9bad-a6cd60bdd5fc",
