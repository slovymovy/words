                        "entry_id": "6a1d33d1-f0c1-389f-b487-42846ebf85f2",
                        "glosses": [
                            "een persoon van jeugdige leeftijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c303b0b6-9c3e-4b9c-8e53-775d0f1f1c3a",
                                "sense_id": "552100d7-4000-3259-8e7b-06bf7135641e",
                                "text": "De jongeren wisten, ondanks de grondige controle, alcohol te kopen."
                            },
                            {
                                "example_id": "4c414a59-8832-4111-93c1-c5ada27c10f1",
                                "sense_id": "552100d7-4000-3259-8e7b-06bf7135641e",
                                "text": "'In Griekenland drinken jongeren anders een stuk minder dan in ons land."
                            }
                        ]
                    }
                ],
