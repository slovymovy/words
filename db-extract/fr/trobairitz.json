                        "sense_id": "dccad246-85b7-3011-a7cd-0d60219844d6",
                        "entry_id": "64a97534-07e9-3787-9d7f-32d629f3bc77",
                        "glosses": [
                            "Poétesse et compositrice d’expression occitane ayant vécu dans le sud de la France aux XIIᵉ et XIIIᵉ siècles."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "82d83135-154e-41cf-86d9-3416b24aac82",
                                "sense_id": "dccad246-85b7-3011-a7cd-0d60219844d6",
                                "text": "Ce projet articulé autour d’un conte musical et théâtral, met en scène deux personnages, Alaïs, jeune femme musicienne inspirée par les trobairitz, femmes troubadours, poétesses et compositrices des XIIᵉ et XIIIᵉ siècles au Moyen Âge et Lubulus, un extraterrestre grand explorateur cosmique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7a4f06e-8b25-4257-a43b-489ef50eb96d",
                        "source_entry_id": "64a97534-07e9-3787-9d7f-32d629f3bc77",
                        "source_sense_id": "dccad246-85b7-3011-a7cd-0d60219844d6",
                        "target_lang_word": "trobairitz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trobairitz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12d799a6-dbee-378b-9ff0-dddbdca715fb",
                                        "entry_id": "13450fbc-1b69-3c10-a08d-5c5dec202e22",
                                        "glosses": [
                                            "A female composer of Old Occitan lyric poetry; a female troubadour."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfee4050-a777-41d3-84a8-c41e68b0d067",
                                                "sense_id": "12d799a6-dbee-378b-9ff0-dddbdca715fb",
                                                "text": "This single melody, which is also the only one by a trobairitz to have been identified, is preserved in only one thirteenth-century manuscript, and it includes only the first cobla, or stanza ."
                                            },
                                            {
                                                "example_id": "7174a690-83b9-4657-80a2-133214838b59",
                                                "sense_id": "12d799a6-dbee-378b-9ff0-dddbdca715fb",
                                                "text": "Studies have tentatively identified some common themes in the trobairitz corpus as well as variety among women's voices."
                                            },
                                            {
                                                "example_id": "918c8810-54f3-4068-8150-1df3eddfea0c",
                                                "sense_id": "12d799a6-dbee-378b-9ff0-dddbdca715fb",
                                                "text": "We know about twenty trobairitz by name, and their corpus includes some thirty-two songs."
                                            },
                                            {
                                                "example_id": "a9e04ab5-5d19-4bb2-84a6-6b936bfbd6e5",
                                                "sense_id": "12d799a6-dbee-378b-9ff0-dddbdca715fb",
                                                "text": "While trobairitz often played lutes, they might also sing while playing a harp, an instrument that women were often encouraged to master."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
