                        {
                            "text": "She <w>danged</w> the heavy sack onto the floor in frustration.",
                            "target_lang_translations": {
                                "ru": "Она в разочаровании <w>бросила</w> тяжелый мешок на пол.",
                                "zh": "她懊恼地把沉重的袋子猛地<w>摔</w>到地板上。"
                            }
                        }
