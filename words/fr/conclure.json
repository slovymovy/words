                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il espérait bien <w>conclure</w> dès leur premier rendez-vous au restaurant."
                        },
                        {
                            "text": "Ses amis lui demandaient en riant s'il avait réussi à <w>conclure</w> hier soir."
