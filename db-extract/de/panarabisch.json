                ],
                "senses": [
                    {
                        "sense_id": "4b1a5906-3d7f-3bab-92a8-e745facb8f20",
                        "entry_id": "f15bcbff-65a7-31f3-864a-b31d6b21c3b0",
                        "glosses": [
                            "den Panarabismus betreffend, ihn vertretend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08613585-92f8-4706-b042-5e6f15c08e96",
                                "sense_id": "4b1a5906-3d7f-3bab-92a8-e745facb8f20",
                                "text": "„Seit Ende des 19. Jahrhunderts hatten die Palästinenser das Recht auf Selbstbestimmung angestrebt, zunächst im Rahmen einer panarabischen Identität, aber schon bald nach dem Ersten Weltkrieg durch das Mandatssystem, das die von ihm geschaffenen neuen Nationalstaaten im Nahen und Mittleren Osten zur Unabhängigkeit und zu einer Zukunft auf der Basis demokratischer Prinzipien zu führen versprach.“"
                            },
                            {
                                "example_id": "4cc8e786-18bc-42c3-b09b-fa22701acfb7",
                                "sense_id": "4b1a5906-3d7f-3bab-92a8-e745facb8f20",
                                "text": "„Nasser wurde zu einem panarabischen Helden, aber die palästinensischen Bewohner des Gazastreifens, die meisten von ihnen Flüchtlinge, hatten sehr gelitten.“"
                            },
                            {
                                "example_id": "b0ed69d9-6734-418a-a04a-81904e6f09ee",
                                "sense_id": "4b1a5906-3d7f-3bab-92a8-e745facb8f20",
                                "text": "„Doch auch nach Ende des Mandats blieben externe Faktoren bei der spezifischen Ausformung der palästinensischen Identität und Nationalbewegung dominant: die Zerstreuung der arabischen Bevölkerung im Zuge der Nakba, die soziale, rechtliche und politische Ausgrenzung in Israel und in der Diaspora sowie eine panarabische Bewegung, die sich zwar die Befreiung Palästinas auf die Fahne schrieb, die Herausbildung einer eigenständigen palästinensischen Nationalbewegung aber zu unterdrücken suchte.“"
                            },
                            {
                                "example_id": "d1f6bc47-09ee-471f-8a96-f035b3876695",
                                "sense_id": "4b1a5906-3d7f-3bab-92a8-e745facb8f20",
                                "text": "„Man förderte auch die panarabische Ideologie und pflegte die eigene religiöse Tradition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
