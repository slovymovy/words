                        "entry_id": "b71bb14a-be57-3afb-b8f3-8e6a4a7c437b",
                        "glosses": [
                            "Transformer en duramen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f09df6-1000-40a9-8608-9e76d499cb72",
                                "sense_id": "0a6d7b7e-9218-39e3-8bc7-cbd02822bfe7",
                                "text": "Les anneaux d'aubier deviennent moins nombreux, jusqu'à ce qu'il s'en forme qui n'aient pas plus de largeur que ceux à duraminiser."
                            },
                            {
                                "example_id": "f68c5aae-a55b-44fd-bebe-2e98966de488",
                                "sense_id": "0a6d7b7e-9218-39e3-8bc7-cbd02822bfe7",
                                "text": "La légèreté et la faible dureté de leur bois relèvent de leur rapidité de croissance et de leur faible longévité car leur bois n'a pas le temps de se duraminiser."
                            }
                        ]
                    }
