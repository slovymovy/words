                    },
                    {
                        "form_id": "b4932a81-ba56-4d7f-a195-04d0fe7a4aa4",
                        "entry_id": "cd5b3a82-a0e9-370a-bc36-5e7a646e9ff0",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отры́в"
                    },
                    {
                        "form_id": "152dfda7-16ae-4ecc-93e4-0cbedcfb5b03",
                        "entry_id": "cd5b3a82-a0e9-370a-bc36-5e7a646e9ff0",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отры́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61d5169e-d609-36fc-97d6-f742edfd1c46",
                        "entry_id": "cd5b3a82-a0e9-370a-bc36-5e7a646e9ff0",
                        "glosses": [
                            "то же, что выкопать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfabbaa-68df-475f-93a9-768348d6ee85",
                                "sense_id": "61d5169e-d609-36fc-97d6-f742edfd1c46",
                                "text": "За пару часов экскаватор отрыл глубокую траншею."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdfa1db3-66c2-3083-a116-f1e7646e974a",
                        "entry_id": "cd5b3a82-a0e9-370a-bc36-5e7a646e9ff0",
                        "glosses": [
                            "то же, что откопать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5c8bba6-0a74-48ef-9170-6c62ec05baa7",
                                "sense_id": "cdfa1db3-66c2-3083-a116-f1e7646e974a",
                                "text": "По их мнению, трудно представить, что активисты КПРФ пойдут на такое кощунство, что отроют тело Ленина и попытаются использовать его в своей предвыборной кампании."
                            }
                        ]
                    },
                    {
                        "sense_id": "6247eac5-0576-3792-a984-0d02be3ad5fb",
                        "entry_id": "cd5b3a82-a0e9-370a-bc36-5e7a646e9ff0",
                        "glosses": [
                            "перен. найти, отыскать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7df57df-b993-4ed0-80b8-dd3fc50dcac4",
                                "sense_id": "6247eac5-0576-3792-a984-0d02be3ad5fb",
                                "text": "Она была настолько креативна, что отрыв на какой-то барахолке перламутровую коробочку на ножках без крышки, она вначале обтягивала её изнутри голубым шёлком, затем находила в своих запасах (у неё было множество запасов ― накладочек, пуговиц, вышивок) накладочку, расчихвостив перламутровый кошелёчек, делала из него крышку, которую мастера в Эрмитаже обрамляли бронзой с тем же рисунком, какой был на ножках, из какой-то запонки делала замок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54544064-ca79-48f5-90c7-9bb8f17d09c0",
                        "source_entry_id": "cd5b3a82-a0e9-370a-bc36-5e7a646e9ff0",
                        "target_lang_word": "unearth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unearth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf9715c-6527-3819-b616-db89a258ac59",
                                        "entry_id": "6d6c542d-bf2d-3098-aa12-76caf8d8b7d7",
                                        "glosses": [
                                            "To drive or draw from the earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6d17817-82a4-4649-b91f-a820ffb3b1ac",
                                                "sense_id": "6cf9715c-6527-3819-b616-db89a258ac59",
                                                "text": "to unearth a fox or a badger"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f13e12-aa87-32fa-a158-164629262599",
                                        "entry_id": "6d6c542d-bf2d-3098-aa12-76caf8d8b7d7",
                                        "glosses": [
                                            "To uncover or find; to bring out from concealment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42c6c0ae-b6e2-45a5-ac43-d2e34bf3a3af",
                                                "sense_id": "23f13e12-aa87-32fa-a158-164629262599",
                                                "text": "to unearth a secret"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2222661b-45f6-32db-bbab-764165977a70",
                                        "entry_id": "6d6c542d-bf2d-3098-aa12-76caf8d8b7d7",
                                        "glosses": [
                                            "To dig up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f0552c-8838-433a-be5e-9193cfd62ef3",
                                                "sense_id": "2222661b-45f6-32db-bbab-764165977a70",
                                                "text": "Modern archaeological excavations have unearthed the remains of a large number of ancient cities that lay buried deep under the sands for more than a thousand years, along the trade route from Bactria to China passing between the Tien Shan mountains in the north and the desert of Taklamakan in the south."
                                            },
                                            {
                                                "example_id": "b7613dab-2c7b-40de-8899-a03bc920f19b",
                                                "sense_id": "2222661b-45f6-32db-bbab-764165977a70",
                                                "text": "Despite all the evidence confirming the existence of the Protheans, little is known about their culture and society. From time to time, dig sites will yield new clues, but after 50,000 years of decay, little of value is unearthed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d73b668-f647-4385-87c2-796aa0219073",
                        "source_entry_id": "cd5b3a82-a0e9-370a-bc36-5e7a646e9ff0",
                        "target_lang_word": "dig out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dig out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7e3a3d3-68ca-338c-8aa9-60aed507e3c8",
                                        "entry_id": "49a42cbc-a79b-3862-ae9a-e053d974f79d",
                                        "glosses": [
                                            "To remove something by digging."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "926b3d07-8048-4819-9bc4-36dbf7ecbd06",
                                                "sense_id": "e7e3a3d3-68ca-338c-8aa9-60aed507e3c8",
                                                "text": "The archaeologist dug out a Saxon dagger."
                                            },
                                            {
                                                "example_id": "b72d1ea0-d65a-417d-b86b-f9de6ed67d12",
                                                "sense_id": "e7e3a3d3-68ca-338c-8aa9-60aed507e3c8",
                                                "text": "Houdini not only got out of the ropes: he also dug himself out of the hole he had been buried in."
                                            },
                                            {
                                                "example_id": "0c46345b-64cb-47cc-82c9-70c2a2b1530c",
                                                "sense_id": "e7e3a3d3-68ca-338c-8aa9-60aed507e3c8",
                                                "text": "Midway between these stations a plough with two engines, which had been keeping the line open throughout the Sunday, became completely snowed up, and another engine sent from the Arrochar direction with men to assist in digging out the plough itself was caught in a drift south of Glen Douglas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "761d4993-0faa-3cf2-a356-6c5d2afcb4e1",
                                        "entry_id": "49a42cbc-a79b-3862-ae9a-e053d974f79d",
                                        "glosses": [
                                            "To find or retrieve something buried."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03bc78d3-db35-4a6f-83f9-33facf1afa37",
                                                "sense_id": "761d4993-0faa-3cf2-a356-6c5d2afcb4e1",
                                                "text": "I shall try to dig out my old textbooks."
                                            },
                                            {
                                                "example_id": "c1a8695e-b544-4404-9a01-5141d38d628a",
                                                "sense_id": "761d4993-0faa-3cf2-a356-6c5d2afcb4e1",
                                                "text": "But Ireland dug out a gutsy response and applied pressure which resulted in number eight Heaslip diving over in the corner to revive home hopes."
                                            },
                                            {
                                                "example_id": "309ae545-b043-4b6b-84eb-31dc3b4ddb48",
                                                "sense_id": "761d4993-0faa-3cf2-a356-6c5d2afcb4e1",
                                                "text": "While you see some of our exploration on camera, I also spent many happy hours between shoots with Chris Nix, digging out dozens of wonderful plans, maps and drawings of projects that I never knew existed, and some that never did exist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d04b045-203c-3bc1-b02c-ba04e9e56093",
                                        "entry_id": "49a42cbc-a79b-3862-ae9a-e053d974f79d",
                                        "glosses": [
                                            "To make something by digging."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0789b87e-3ef5-4a3a-8a8f-3761105238f5",
                                                "sense_id": "6d04b045-203c-3bc1-b02c-ba04e9e56093",
                                                "text": "We had to dig out our foxhole while under fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "135797ad-1024-304d-8337-b7e93b9a769e",
                                        "entry_id": "49a42cbc-a79b-3862-ae9a-e053d974f79d",
                                        "glosses": [
                                            "To decamp; to leave a place hastily."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f71ed0b-404b-3169-8f84-fa964fa9bd8c",
                                        "entry_id": "49a42cbc-a79b-3862-ae9a-e053d974f79d",
                                        "glosses": [
                                            "To have penetrative sexual intercourse with someone."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2efb9e39-6491-4881-8e7a-d6fe37876e95",
                                                "sense_id": "5f71ed0b-404b-3169-8f84-fa964fa9bd8c",
                                                "text": "I'd like to dig her out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e36bc5-8d7c-35a6-8ce5-9452922337dc",
                                        "entry_id": "49a42cbc-a79b-3862-ae9a-e053d974f79d",
                                        "glosses": [
                                            "To block a yorker with the bottom of the bat, at the last second."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
