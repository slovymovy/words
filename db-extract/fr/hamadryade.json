        "fr-extract.jsonl": [
            {
                "entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                "word": "hamadryade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "498ae87b-7ebd-46c9-897e-6c17a3991242",
                        "entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                        "tags": [
                            "plural"
                        ],
                        "form": "hamadryades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5dda1a38-880b-319f-ae07-3899ee3f1256",
                        "entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                        "glosses": [
                            "Nymphe des bois qui naissait et mourait avec l’arbre dont la garde lui était confiée, et qui ne pouvait jamais le quitter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33281521-4a1f-48e2-81e7-f48bfb447b98",
                                "sense_id": "5dda1a38-880b-319f-ae07-3899ee3f1256",
                                "text": "Je suis un petit faune ivre de sève verte.\nÉvohé ! Évohé ! Les chênes sont humains !\nPour découvrir en eux l’hamadryade offerte,\nÀ tous j’écarterai l’écorce avec mes mains."
                            },
                            {
                                "example_id": "af11e5b1-5cf6-411d-b6cd-6e8d98ba56a6",
                                "sense_id": "5dda1a38-880b-319f-ae07-3899ee3f1256",
                                "text": "Mais, — si ce n’est pas proposer un problème trop ardu à ta science arithmétique, — compte, ô hamadryade des bois sacrés du Moulin de la Galette, ce qu’a pu thésauriser d’or et de pierreries un faiseur de ballades qui emprunta un louis, la semaine dernière, à un amateur des belles-lettres, et qui, sur cette somme, préleva (sans parler de la nécessité du luxe quotidien, déjeuners à vingt sous, dîners à deux francs et bouquets de violettes à dix centimes), de quoi assoupir la rage acharnée de mille et un créanciers, pareils à Kerberos, c’est-à-dire de plus de trois mille gueules jappantes et dévorantes ?"
                            },
                            {
                                "example_id": "8d23c5e3-5a25-4b54-8323-351a095f06a9",
                                "sense_id": "5dda1a38-880b-319f-ae07-3899ee3f1256",
                                "text": "Quand il eut empoché son salaire journalier, il entraîna le Roi ; sur quoi les deux hommes nous saluèrent d’un doigt et allèrent retrouver leurs hamadryades."
                            }
                        ]
                    },
                    {
                        "sense_id": "56e97922-06ab-3b72-b97d-b67734749145",
                        "entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                        "glosses": [
                            "Variante de hamadryas."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4982fe05-4014-31da-9eae-71bc8be2e154",
                        "entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                        "glosses": [
                            "Genre de lépidoptère d’Inde et de Malaisie."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d42b176c-d4d8-3ccf-a180-53e112b125d6",
                        "entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                        "glosses": [
                            "Plante ressemblant à une renoncule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb9f9ac-4812-4cf3-b7b8-dd499c4e6882",
                                "sense_id": "d42b176c-d4d8-3ccf-a180-53e112b125d6",
                                "text": "HAMADRYADE DE MAGELLAN : Hamadryas magellanica, Lamk., Encycl. : Commers., Herb. Cette plante a l’aspect d’une renoncule ; elle est fort petite, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c11a7e22-1030-3871-858c-39bd2c91a1dc",
                        "entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                        "glosses": [
                            "Nom commun du cobra royal (Ophiophagus hannah)."
                        ],
                        "tags": [
                            "Ophiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "456b1d90-dce5-4df5-adb6-8468a18d2bb3",
                                "sense_id": "c11a7e22-1030-3871-858c-39bd2c91a1dc",
                                "text": "D’où un double escalier, ou pour mieux dire deux escaliers qui s’élèvent côte à côte avec une souplesse et une dignité de naja, cobra royal, somptueuse hamadryade."
                            },
                            {
                                "example_id": "6a5cf6ac-0a46-476f-9624-e92b44785aeb",
                                "sense_id": "c11a7e22-1030-3871-858c-39bd2c91a1dc",
                                "text": "Le cobra royal (Ophiophagus hannah), ou hamadryade, vit en Asie du Sud-Est et en Inde. Il mesure entre 3,50 et 4,50 mètres de long."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd743559-73f0-4cbf-a610-dfbc4b881b36",
                        "source_entry_id": "17f4c2b9-0394-33d7-8f22-57e99d375878",
                        "source_sense_id": "5dda1a38-880b-319f-ae07-3899ee3f1256",
                        "source_sense_description": "Nymphe",
                        "target_lang_word": "hamadryad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hamadryad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c52504c7-3ad0-3273-8c9f-9c988d891b54",
                                        "entry_id": "2d37f2d8-97b7-3d03-a9e2-d7e70440ed7e",
                                        "glosses": [
                                            "A wood-nymph who was physically a part of her tree; she would die if her tree were felled."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d308bf3e-7fb5-44d3-bd15-c7c77a5b413a",
                                                "sense_id": "c52504c7-3ad0-3273-8c9f-9c988d891b54",
                                                "text": "The hamadryades have gone, like the golden fancies of which they were engendered—morning dreams of a young world scarce awake, but full of freshness and beauty. Yet often will the thought, or rather the fancy, come across me, that this wailing but most musical noise—heard in the dim evening, when every tree has a separate sound like a separate instrument, and every leaf a differing tone like the differing notes—is the piteous lament of some nymph pent within the gray and mossy trunk whence she may never more emerge in visible loveliness."
                                            },
                                            {
                                                "example_id": "01a3378b-4753-42ea-a5ed-1dcc8c7e99a2",
                                                "sense_id": "c52504c7-3ad0-3273-8c9f-9c988d891b54",
                                                "text": "The various supports, rafters, braces and plates are of pandanus logs of a rich oily brown, and make one think of a sylvan cathedral where hamadryads might very well dance, where Syrinx might be chased by Pan, Daphne by Apollo, and various other heathen rites take place in the dark hours before the dawn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01589cbe-d901-302f-8ace-60b60646cba3",
                                        "entry_id": "2d37f2d8-97b7-3d03-a9e2-d7e70440ed7e",
                                        "glosses": [
                                            "A king cobra."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0560d531-864d-37eb-be56-aeb41fedb485",
                                        "entry_id": "2d37f2d8-97b7-3d03-a9e2-d7e70440ed7e",
                                        "glosses": [
                                            "A baboon of species Papio hamadryas, venerated by the ancient Egyptians."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "919bdb5f-2bd6-319d-858f-6db0d95cb338",
                                        "entry_id": "2d37f2d8-97b7-3d03-a9e2-d7e70440ed7e",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the genera Hamadryas and Tellervo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
