                "senses": [
                    {
                        "sense_id": "7b7bac6c-d981-31e7-8427-a66ffef2149a",
                        "entry_id": "dce0448c-0a03-37f4-bf05-499add830019",
                        "glosses": [
                            "musicus die een piano bespeelt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "76f6c9c7-5d36-4dcf-924f-ff51206ab671",
                                "sense_id": "7b7bac6c-d981-31e7-8427-a66ffef2149a",
                                "text": "` Mooi zo. Er is een grote balletschool in de Salie Pleyel, er zijn er meerdere, maar deze hier', ze wees op het papiertje, `zoekt pianisten. Ze weten dat je eraan komt. Ik heb ze al gebeld. Je kunt vrijdag beginnen.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de99be65-afdf-4f4f-8633-928f6a14e319",
                        "source_entry_id": "dce0448c-0a03-37f4-bf05-499add830019",
                        "source_sense_id": "7b7bac6c-d981-31e7-8427-a66ffef2149a",
                        "source_sense_description": "musicus die een piano bespeelt",
                        "target_lang_word": "Pianist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pianist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33bdce15-f375-38db-b06b-18f3811e358c",
                                        "entry_id": "34e1b04f-94e2-3527-90f1-4b2858288fc1",
                                        "glosses": [
                                            "Person, die (beruflich) Klavier spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14542261-ae42-490a-a82d-de96949582b5",
                                                "sense_id": "33bdce15-f375-38db-b06b-18f3811e358c",
                                                "text": "Władysław Szpilman war ein polnischer Pianist."
                                            },
                                            {
                                                "example_id": "c4a009e2-3f22-4f76-84db-38098f03d630",
                                                "sense_id": "33bdce15-f375-38db-b06b-18f3811e358c",
                                                "text": "„Alf Bertini hatte nach dem mißglückten nautischen Intermezzo verbittert zur Musik zurückgefunden, wenn auch nur als Pianist in Kaffeehaus-Ensembles, meist am Steindamm.“"
                                            },
                                            {
                                                "example_id": "5b23febf-42f6-4c3c-b714-b520d27f9eaf",
                                                "sense_id": "33bdce15-f375-38db-b06b-18f3811e358c",
                                                "text": "„Ich habe nämlich in ihren Augen wie ein Pianist ausgesehen, ja, genau, ich habe auf sie den Eindruck eines Pianisten gemacht.“"
                                            },
                                            {
                                                "example_id": "4387fa92-e1b6-405c-9894-650282cd92dd",
                                                "sense_id": "33bdce15-f375-38db-b06b-18f3811e358c",
                                                "text": "„Gershwin hatte als junger Pianist in der Tin Pan Alley, der 28th Street zwischen der Fifth und Sixth Avenue, seinen ersten festen Job bestritten.“"
                                            },
                                            {
                                                "example_id": "7e47e6c0-ab83-494f-86c6-680286b7718e",
                                                "sense_id": "33bdce15-f375-38db-b06b-18f3811e358c",
                                                "text": "„Der Präsident hatte ein paar Abende zuvor eingeladen und zur Unterhaltung seiner Gäste einen Pianisten und eine Geigerin auftreten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20eedb14-2c3a-4c7e-b0d3-3a57acfa891c",
                        "source_entry_id": "dce0448c-0a03-37f4-bf05-499add830019",
                        "source_sense_id": "7b7bac6c-d981-31e7-8427-a66ffef2149a",
                        "source_sense_description": "musicus die een piano bespeelt",
                        "target_lang_word": "pianist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pianist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                        "entry_id": "a76cd033-c191-388c-8c93-bedd969c207b",
                                        "glosses": [
                                            "A person who plays the piano, particularly with skill or as part of an orchestra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc4df5c-b31d-4fc0-be89-4401c335d124",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "By the time she became the world's greatest pianist, she had already practised for thousands of hours on her prized piano."
                                            },
                                            {
                                                "example_id": "dd939a5c-e068-4009-a6c7-756028df8914",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "Table IV shows that the pianists were significantly better on both motor and perceptual timing than the nonpianists."
                                            },
                                            {
                                                "example_id": "9cfeebfc-cfdc-4c7d-84f4-bcc351db338f",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "The pianist was Jason Moran, another Houstonian, for whom the past converges with the present: he sometimes likes to find an unobtrusive sequence inside an old standard and turn it into fresh headlines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6a82f5-1234-33a8-9fe7-a5664c3535d5",
                                        "entry_id": "a76cd033-c191-388c-8c93-bedd969c207b",
                                        "glosses": [
                                            "A spy using radio or wireless telegraphy to keep in touch with headquarters during the Second World War."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d11405-3645-4325-bb44-32877b1ed758",
                        "source_entry_id": "dce0448c-0a03-37f4-bf05-499add830019",
                        "source_sense_id": "7b7bac6c-d981-31e7-8427-a66ffef2149a",
