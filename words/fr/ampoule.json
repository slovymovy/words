                        "ampoule injectable"
                    ]
                },
                {
                    "sense_id": "d2990036-3a55-35ee-89a8-6df7a260401d",
                    "sense_definition": "Emphase prétentieuse ou enflure excessive dans le ton ou le style d'un discours.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "litteraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son discours manquait de sincérité à cause d'une pénible <w>ampoule</w> oratoire."
                        },
                        {
                            "text": "Le critique a dénoncé l'<w>ampoule</w> de ce poème surchargé de métaphores grandiloquentes."
