                                        "examples": [
                                            {
                                                "example_id": "68d07971-e2e4-44fe-bbd8-cd07f04c0277",
                                                "sense_id": "824cc8ad-89c6-387b-9939-c3e25aa6b4fd",
                                                "text": "Bei der spontanen Immunantwort im Körper produzieren die B-Lymphozyten polyklonale Antikörper, in Zellkulturen kann man hingegen monoklonale Antikörper züchten, die zum Beispiel genau auf ein bestimmtes Antigen reagieren."
                                            },
                                            {
                                                "example_id": "fbbc92d8-b1c3-449e-ba45-57f6858aa6e5",
                                                "sense_id": "824cc8ad-89c6-387b-9939-c3e25aa6b4fd",
                                                "text": "Ein Paraprotein ist ein monoklonales Protein, das normalerweise nicht im Körper vorhanden ist."
                                            }
