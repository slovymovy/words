                                    {
                                        "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                        "entry_id": "11744f40-fdc0-311a-a508-d64d04d14b8e",
                                        "glosses": [
                                            "extremes, Schaden verursachendes Wetter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47de293-2a10-4762-9a0a-cecf106eda87",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "Das Unwetter setzte unseren Keller unter Wasser."
                                            },
                                            {
                                                "example_id": "1b24fe28-519d-4376-a9a8-d5fc1867b232",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Dort wurden gerade zwei Boote heraufgehievt, die vor zwei Wochen bei einem Unwetter gesunken waren.“"
                                            },
                                            {
                                                "example_id": "7cc4ffec-4066-42d0-ae10-39f3ca681de6",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Das erwartete Unwetter brach drei Stunden nach Sonnenaufgang über uns herein.“"
                                            },
                                            {
                                                "example_id": "15673d89-5811-40a6-a516-5009b5a9687f",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Bald brach ein furchtbares Unwetter los.“"
                                            },
                                            {
                                                "example_id": "0d60eac0-a073-45f8-8bf4-6da33c3293e1",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Ein schweres Unwetter führt am 8. Juli 1926 zum Hochwasser im Steintorbereich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
