                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspects <w>premeditated</w> the burglary for several months before breaking in.",
                            "target_lang_translations": {
