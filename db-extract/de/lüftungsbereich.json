                "senses": [
                    {
                        "sense_id": "7bdfffc7-b281-3265-b2af-718386ce0b29",
                        "entry_id": "86152a3a-f680-364a-beee-eac64641692a",
                        "glosses": [
                            "Marktwirtschaftliches Fach- und Aufgabengebiet der Lüftung; Planung, Produkte und Anlagenbau derer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0072b0e1-bd3c-43d7-b813-4f4a7b28f844",
                                "sense_id": "7bdfffc7-b281-3265-b2af-718386ce0b29",
                                "text": "„Dank jahrzehntelanger Erfahrung und der ständigen Berücksichtigung individueller Kundenwünsche haben wir im Lüftungsbereich eine umfassende Produktpalette entwickelt, die keinen Anwendungsfall unberücksichtigt lässt.“"
                            },
                            {
                                "example_id": "9f18e5c8-1251-42c4-9511-b7e0b5f5bd9f",
                                "sense_id": "7bdfffc7-b281-3265-b2af-718386ce0b29",
                                "text": "„Die in den Sparten Heizkörper und Komfortlüftungen aktive Zehnder baut den Lüftungsbereich aus und erwirbt rückwirkend auf Jahresbeginn die schweizerische Cesovent.“"
                            },
                            {
                                "example_id": "6aba76a6-38c4-43ec-ad0d-b965f8a0553d",
                                "sense_id": "7bdfffc7-b281-3265-b2af-718386ce0b29",
                                "text": "„Die KAPAG baut ihr Lieferprogramm im Lüftungsbereich weiter aus und sichert sich als Generalimporteur die alleinigen Vertriebsrechte der innovativen Produkte der LUNOS Lüftungstechnik GmbH, Deutschland, für die Schweiz und Lichtenstein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83f392df-ba80-30f9-a758-bfa92799dbf3",
                        "entry_id": "86152a3a-f680-364a-beee-eac64641692a",
                        "glosses": [
                            "Einwirkbereich einer Lüftungsanlage in einem Gebäude oder einem Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0206339a-9dab-4475-ab43-e956b64b1847",
                                "sense_id": "83f392df-ba80-30f9-a758-bfa92799dbf3",
                                "text": "„Sie umfasst zwei getrennte Lüftungsbereiche (Vortragssaal und Bürobereich), die entweder parallel oder alternativ betrieben werden können.“"
                            },
                            {
                                "example_id": "bba347b1-47c9-4d08-9440-905713f78a5e",
                                "sense_id": "83f392df-ba80-30f9-a758-bfa92799dbf3",
                                "text": "„Die Balkenschuhe im offenen Lüftungsbereich des Wintergartens sind aus statischen Gründen notwendig.“"
                            },
                            {
                                "example_id": "38286851-919c-43ec-a4c1-2dbaf95e0086",
                                "sense_id": "83f392df-ba80-30f9-a758-bfa92799dbf3",
                                "text": "„Lüftungsbereiche auf beiden Seiten sichern eine sehr gute Hinterlüftung des Regenschutzes.“"
                            },
                            {
                                "example_id": "611d9b83-fcfd-4ecd-b171-5ce3b1645ebb",
                                "sense_id": "83f392df-ba80-30f9-a758-bfa92799dbf3",
                                "text": "„Jedes Haus besteht aus drei Lüftungsbereichen: Einem Zuluftbereich, in den die frische Luft leise und zugfrei einströmt. Einem Überströmbereich, der Zuluft- und Abluftbereiche miteinander verbindet. Und schließlich einem Abluftbereich, der einen hohen Luftaustausch benötigt, denn hier werden Feuchtigkeit und Kochdämpfe abgeleitet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
