                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9c62395-69b4-360d-9601-34eb64b11c0a",
                        "entry_id": "e01af786-77da-3d10-b4a8-132ace234a36",
                        "glosses": [
                            "A province of Emilia-Romagna, Italy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "66e2d2c4-ef2a-380a-ad77-7fec8cae57aa",
                        "entry_id": "e01af786-77da-3d10-b4a8-132ace234a36",
                        "glosses": [
                            "City, archbishopric and capital of Ferrara."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dabfa4a4-ed17-3d6b-bdcb-4b68ecc0f254",
                        "entry_id": "e01af786-77da-3d10-b4a8-132ace234a36",
                        "glosses": [
                            "A surname from Italian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e1b012-be57-416e-ba20-abdb3c0477cc",
                                "sense_id": "dabfa4a4-ed17-3d6b-bdcb-4b68ecc0f254",
                                "text": "As a result, men turn to the women in their lives to fulfill their emotional needs. Ferrara and her coauthor are not the first to suggest that women bear the burden of mankeeping (although they did coin the term)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b40c875b-12be-4260-8fd5-c2de2be66d4d",
                        "source_entry_id": "e01af786-77da-3d10-b4a8-132ace234a36",
                        "source_sense_description": "province",
                        "target_lang_word": "Ferrare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ferrare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7155634b-0e87-3a6e-9d87-432f5f70abd9",
                                        "entry_id": "4f505439-6800-3516-b961-f0d6e674d63b",
                                        "glosses": [
                                            "Commune et ville de la région d’Émilie-Romagne en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d5edba-4d12-4020-95da-7ee1525ddb25",
                                                "sense_id": "7155634b-0e87-3a6e-9d87-432f5f70abd9",
                                                "text": "Dans un somptueux palais de Ferrare, par une soirée d’hiver, don Juan Belvidéro régalait un prince de la maison d’Este."
                                            },
                                            {
                                                "example_id": "f8b1b9fa-04a0-4e26-a5ed-27f268fc44ed",
                                                "sense_id": "7155634b-0e87-3a6e-9d87-432f5f70abd9",
                                                "text": "Pendant les luttes entre l’empire et la papauté, Ferrare, Modène, Reggio comme toutes les villes de l’Italie recouvrèrent leur liberté et se gouvernèrent elles-mêmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f82267fb-65c6-3ba7-83ed-abada1be6262",
                                        "entry_id": "4f505439-6800-3516-b961-f0d6e674d63b",
                                        "glosses": [
                                            "Province autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8dd75e-0ef3-4338-8fb5-271b6efda162",
                                                "sense_id": "f82267fb-65c6-3ba7-83ed-abada1be6262",
                                                "text": "Avant l’Unité, elle se partageait entre le duché de Parme (incluant Plaisance), le duché de Modène (incluant Reggio) et les États de l’Église, dont faisaient partie Bologne, Ferrare et la Romagne (où se situe Ravenne, Forli et Rimini)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
