                ],
                "senses": [
                    {
                        "sense_id": "a0724c0d-4f8f-379f-8779-e4d5dd94a1ef",
                        "entry_id": "2807e639-9a2a-3123-8372-bdcfe4752e4c",
                        "glosses": [
                            "Erklärung oder Vorgabe, wer etwas wie tun sollte; Gebrauchshinweis, Anleitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "365b3654-658d-420a-9dab-de1ac6947b21",
                                "sense_id": "a0724c0d-4f8f-379f-8779-e4d5dd94a1ef",
                                "text": "„In Analogie dazu soll nach DIN EN ISO 16000-1 auch in Räumen verfahren werden, für die Lüftungsanweisungen vorliegen (zum Beispiel in Schulen und Kindergärten).“"
                            },
                            {
                                "example_id": "2db1a70b-d531-4bd7-a536-3ea3936edbc3",
                                "sense_id": "a0724c0d-4f8f-379f-8779-e4d5dd94a1ef",
                                "text": "„Seit dieser Zeit habe ich im Schlafzimmer Schimmelbefall, obwohl ich die Lüftungsanweisungen akribisch befolge.“"
                            },
                            {
                                "example_id": "b89eb452-ced9-493d-a5c8-93d406e1cc8e",
                                "sense_id": "a0724c0d-4f8f-379f-8779-e4d5dd94a1ef",
                                "text": "„Demnach ist es in Räumen, für die Lüftungsanweisungen vorliegen (z. B. in Schulen und Kindergärten), vor der Messung ein vollständiger und typischer Nutzungszyklus abzuwarten.“"
                            },
                            {
                                "example_id": "d50b63ba-a9ed-49fc-b946-b7de08184f16",
                                "sense_id": "a0724c0d-4f8f-379f-8779-e4d5dd94a1ef",
                                "text": "„Diese Gesichtspunkte werden bisher bei den meisten Lüftungsanweisungen überhaupt nicht berücksichtigt, wenn pauschal zwei, drei oder mehr Stoßlüftungen vorgeschlagen oder gefordert werden.“"
                            },
                            {
                                "example_id": "5699b813-ad55-4578-ba00-9aaca242473e",
                                "sense_id": "a0724c0d-4f8f-379f-8779-e4d5dd94a1ef",
                                "text": "„Es ist dringend anzuraten, nicht nur Empfehlungen wie „… bitte besser lüften…“ auszusprechen, sondern Lüftungsanweisungen mit definierten Zielsetzungen zu erstellen und in geeignete Schul-Lüftungspläne umzusetzen.“"
                            },
                            {
                                "example_id": "beee90be-782f-42c2-8ba2-e92d30e1f367",
                                "sense_id": "a0724c0d-4f8f-379f-8779-e4d5dd94a1ef",
                                "text": "„Vermietern wird empfohlen, eine Art „Lüftungsanweisung“ zum Bestandteil es Mietvertrages zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
