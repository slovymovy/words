    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c58e7751-89ce-3dcb-9c52-a2b9aaff3b85",
                    "sense_definition": "met metalen klemmetjes (nietjes) vellen papier aan elkaar vastmaken",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vastmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet deze documenten even <w>nieten</w> voordat je ze in de map doet.",
                            "target_lang_translations": {
                                "en": "You need to <w>staple</w> these documents before you put them in the folder."
                            }
                        },
                        {
                            "text": "Een naaimachine naait en een nietmachine <w>niet</w>.",
                            "target_lang_translations": {
                                "en": "A sewing machine sews and a stapler <w>staples</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "papier aan elkaar nieten"
                    ],
                    "target_lang_definitions": {
                        "en": "to fasten sheets of paper together using small metal clips (staples)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "staple",
                                "target_lang_sense_clarification": "to fasten paper together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2087ec5d-bb7a-3687-8f1a-415597829067",
                    "sense_definition": "een archaïsche of dialectale variant van <w>genieten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plezier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten kom je het werkwoord <w>nieten</w> soms nog tegen in de betekenis van plezier hebben.",
                            "target_lang_translations": {
                                "en": "In old texts, you sometimes still encounter the verb <w>to enjoy</w> in the sense of having pleasure."
                            }
                        },
                        {
                            "text": "Hij kon volop <w>nieten</w> van de rust in de natuur.",
                            "target_lang_translations": {
                                "en": "He could fully <w>enjoy</w> the peace of nature."
                            }
                        }
                    ],
                    "synonyms": [
                        "genieten"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderde vorm van genieten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an archaic or dialectal variant of 'genieten' (to enjoy)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enjoy",
                                "target_lang_sense_clarification": "archaic form of enjoying something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a4e882f-0949-3f1f-bdad-66beb844ef4d",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>niet</w>; een lot in een loterij waar geen prijs op valt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "loterij",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb tien loten gekocht, maar het waren helaas allemaal <w>nieten</w>.",
                            "target_lang_translations": {
                                "en": "I bought ten tickets, but unfortunately they were all <w>blanks</w>."
                            }
                        },
                        {
                            "text": "Tussen de vele <w>nieten</w> zat gelukkig één winnend lot.",
                            "target_lang_translations": {
                                "en": "Among the many <w>losing tickets</w>, there was fortunately one winning ticket."
                            }
                        }
                    ],
                    "common_phrases": [
                        "allemaal nieten trekken"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'niet'; lottery tickets that do not win a prize"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blanks",
                                "target_lang_sense_clarification": "non-winning lottery tickets"
                            },
                            {
                                "target_lang_word": "losing tickets",
                                "target_lang_sense_clarification": "tickets with no prize"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}