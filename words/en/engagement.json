{
    "word_family": [
        "engage",
        "disengage",
        "re-engage",
        "engaging",
        "engaged"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce9f773d-aab6-3c77-ae38-c49864878112",
                    "sense_definition": "The period of time when two people have agreed to marry each other.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They announced their <w>engagement</w> to the whole family during the holiday dinner.",
                            "target_lang_translations": {
                                "ru": "Они объявили о своей <w>помолвке</w> всей семье во время праздничного ужина."
                            }
                        },
                        {
                            "text": "We are enjoying a long <w>engagement</w> but haven't yet set a specific wedding date.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждаемся долгой <w>помолвкой</w>, но еще не назначили конкретную дату свадьбы."
                            }
                        }
                    ],
                    "synonyms": [
                        "commitment"
                    ],
                    "common_phrases": [
                        "long engagement",
                        "announce an engagement",
                        "engagement ring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, когда два человека договорились пожениться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помолвка",
                                "target_lang_sense_clarification": "обряд объявления женихом и невестой"
                            },
                            {
                                "target_lang_word": "обручение",
                                "target_lang_sense_clarification": "церковный обряд с обменом кольцами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f58ad0d-b1bc-34f8-8b28-1f119262ae6d",
                    "sense_definition": "A formal arrangement or appointment to do something, such as a performance or a meeting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous lecturer has three speaking <w>engagements</w> scheduled for this week.",
                            "target_lang_translations": {
                                "ru": "У знаменитого лектора на эту неделю запланировано три <w>выступления</w>."
                            }
                        },
                        {
                            "text": "I am afraid I cannot attend the party because of a prior <w>engagement</w>.",
                            "target_lang_translations": {
                                "ru": "Боюсь, я не смогу прийти на вечеринку из-за ранее назначенного <w>обязательства</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prior engagement",
                        "speaking engagement",
                        "social engagement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная договоренность или встреча для выполнения чего-либо, например, выступления или собрания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязательство",
                                "target_lang_sense_clarification": "деловая или социальная договоренность"
                            },
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "назначенное мероприятие"
                            },
                            {
                                "target_lang_word": "ангажемент",
                                "target_lang_sense_clarification": "приглашение артиста на работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76da4b33-bcc0-3f74-891a-a39aa0d8af50",
                    "sense_definition": "The state of being involved, interested, and emotionally or mentally connected to an activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher noticed a high level of student <w>engagement</w> during the science experiment.",
                            "target_lang_translations": {
                                "ru": "Учитель заметил высокий уровень <w>вовлечённости</w> учеников во время научного эксперимента."
                            }
                        },
                        {
                            "text": "The company aims for better <w>engagement</w> with its customers through social media.",
                            "target_lang_translations": {
                                "ru": "Компания стремится к лучшему <w>взаимодействию</w> со своими клиентами через социальные сети."
                            }
                        }
                    ],
                    "synonyms": [
                        "commitment"
                    ],
                    "antonyms": [
                        "apathy",
                        "disengagement"
                    ],
                    "common_phrases": [
                        "customer engagement",
                        "student engagement",
                        "level of engagement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние вовлеченности, заинтересованности и эмоциональной или ментальной связи с деятельностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вовлечённость",
                                "target_lang_sense_clarification": "активное участие и интерес"
                            },
                            {
                                "target_lang_word": "участие",
                                "target_lang_sense_clarification": "включенность в процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8271978f-a16b-3972-add1-b5b5eadfac67",
                    "sense_definition": "A metric in digital media representing how much users interact with content through likes, shares, or comments.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "digital_metrics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team was pleased to see high <w>engagement</w> on their latest video post.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая команда была рада видеть высокую <w>вовлечённость</w> под их последним видеопостом."
                            }
                        },
                        {
                            "text": "Posts with controversial topics often receive more social media <w>engagement</w> than neutral ones.",
                            "target_lang_translations": {
                                "ru": "Посты на спорные темы часто получают больше <w>отклика</w> в социальных сетях, чем нейтральные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "social media engagement",
                        "user engagement",
                        "engagement rate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in marketing and social media"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Показатель в цифровых медиа, отражающий степень взаимодействия пользователей с контентом через лайки, репосты или комментарии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вовлечённость",
                                "target_lang_sense_clarification": "метрика взаимодействия в соцсетях"
                            },
                            {
                                "target_lang_word": "активность",
                                "target_lang_sense_clarification": "действия аудитории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49d27b08-99f9-3c93-897f-7e7a3696f7f5",
                    "sense_definition": "A battle or a period of active fighting between armed forces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brief naval <w>engagement</w> resulted in several damaged ships but no casualties.",
                            "target_lang_translations": {
                                "ru": "Короткое морское <w>сражение</w> привело к повреждению нескольких кораблей, но обошлось без жертв."
                            }
                        },
                        {
                            "text": "The rules of <w>engagement</w> dictate how soldiers should respond when they encounter the enemy.",
                            "target_lang_translations": {
                                "ru": "Правила ведения <w>боя</w> диктуют, как солдаты должны реагировать при встрече с противником."
                            }
                        }
                    ],
                    "synonyms": [
                        "action"
                    ],
                    "common_phrases": [
                        "rules of engagement",
                        "military engagement",
                        "naval engagement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Битва или период активных боевых действий между вооруженными силами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сражение",
                                "target_lang_sense_clarification": "крупное боевое столкновение"
                            },
                            {
                                "target_lang_word": "бой",
                                "target_lang_sense_clarification": "вооруженное столкновение"
                            },
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "небольшой бой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7dcbbd9-15ae-3fbd-a3ff-5b3ed55865b2",
                    "sense_definition": "The state of being physically connected or locked together, especially in machinery.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Check the gears for full <w>engagement</w> before you attempt to turn the heavy handle.",
                            "target_lang_translations": {
                                "ru": "Проверьте полное <w>зацепление</w> шестерен, прежде чем пытаться повернуть тяжелую рукоятку."
                            }
                        },
                        {
                            "text": "The clutch <w>engagement</w> felt smooth as the driver shifted into second gear.",
                            "target_lang_translations": {
                                "ru": "Включение <w>сцепления</w> было плавным, когда водитель переключился на вторую передачу."
                            }
                        }
                    ],
                    "antonyms": [
                        "disengagement"
                    ],
                    "common_phrases": [
                        "gear engagement",
                        "clutch engagement",
                        "full engagement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние физического соединения или сцепления деталей, особенно в технике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцепление",
                                "target_lang_sense_clarification": "соединение механизмов или валов"
                            },
                            {
                                "target_lang_word": "зацепление",
                                "target_lang_sense_clarification": "контакт зубчатых колес"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}