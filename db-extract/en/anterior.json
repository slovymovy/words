                                                "sense_id": "57de7c86-571e-3a96-81de-e921d921bded",
                                                "text": "Le a antérieur se prononce \\a\\ comme dans « rate » \\ʁat\\."
                                            }
                                        ]
                                    }
                                ]
                            }
