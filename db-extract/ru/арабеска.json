                "senses": [
                    {
                        "sense_id": "d54221ce-a453-3f7b-bbb6-7d0186b7e26f",
                        "entry_id": "63e82669-405b-3f88-b8bf-e75ae5e5efce",
                        "glosses": [
                            "инструментальная пьеса изящного характера с причудливым мелодическим рисунком"
                        ],
                        "tags": [],
