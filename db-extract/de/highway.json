                                "target_senses": [
                                    {
                                        "sense_id": "89cc84cb-3a91-364d-9dbe-b1df765e8171",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A road that is higher than the surrounding land and has drainage ditches at the sides."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c3a3063-75a0-3686-9b97-d2cbd5ecf5d5",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A main public road, especially a multi-lane, high-speed thoroughfare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6a6b89-8150-4357-8cdf-189adb8e47cf",
                                                "sense_id": "3c3a3063-75a0-3686-9b97-d2cbd5ecf5d5",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A way; a path that leads to a certain destiny"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f985562-8887-420a-a01b-a7b0d500ba6e",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "You're on a highway to greatness."
                                            },
                                            {
                                                "example_id": "e8be166e-cbcf-403d-89f1-74ebaf6b0563",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "I'm on the highway to hell"
                                            },
                                            {
                                                "example_id": "2ce8c4ac-dda4-472a-91c2-d36de9264e4e",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "So how do the scientists cope with their work being ignored for decades, and living in a world their findings indicate is on a “highway to hell”?."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf40a018-b88d-3f26-a62a-625f5e80c0ed",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "Any public road for vehicular traffic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a9c39a5-a840-3202-9ae2-4f1b18a7a308",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "Synonym of bus (“common connection for two or more circuits or components”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
