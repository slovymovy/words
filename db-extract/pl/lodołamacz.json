                        "entry_id": "80f60ba2-e6c4-3232-b3cb-6f350312fc5a",
                        "glosses": [
                            "statek o wzmocnionym kadłubie, przystosowany do rozbijania pokrywy lodu na morzu lub rzece celem utworzenia drogi dla innych statków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c898266-a7ed-4d92-8d1a-b1bff6298bf2",
                                "sense_id": "503b4216-0724-3ffa-8097-fa69ffa39f7e",
                                "text": "Tegoroczna styczniowa interwencja lodołamaczy była potrzebna ze względu na zagrożenie tymczasowej przeprawy w Kiezmarku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cca15917-a9bd-4150-a895-9b58f855d55c",
                        "source_entry_id": "80f60ba2-e6c4-3232-b3cb-6f350312fc5a",
                        "source_sense_id": "503b4216-0724-3ffa-8097-fa69ffa39f7e",
                        "target_lang_word": "icebreaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icebreaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43812009-9eb7-38e3-96d6-737ccf9c1b2e",
                                        "entry_id": "4cfd83c3-1399-3973-9ef4-d51be9b3a94c",
                                        "glosses": [
                                            "A ship designed to break through ice so that it, or other ships coming behind, can navigate on frozen seas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb3956a-73dc-4f28-82a4-83306db228b6",
                                                "sense_id": "43812009-9eb7-38e3-96d6-737ccf9c1b2e",
                                                "text": "The steel hulls of ice-breakers are much thicker than those of standard vessels."
                                            },
                                            {
                                                "example_id": "314934c1-27a4-48ff-92f4-e2a2469c5681",
                                                "sense_id": "43812009-9eb7-38e3-96d6-737ccf9c1b2e",
                                                "text": "My father's Bonneville was cutting its way toward us like an icebreaker moving through my whole state of consciousness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52031f2e-34c1-3d9e-94c6-f83dd07291e2",
                                        "entry_id": "4cfd83c3-1399-3973-9ef4-d51be9b3a94c",
                                        "glosses": [
                                            "A game, activity, humorous anecdote, etc., designed to ease tension and encourage interaction among individuals in a situation where they do not know each other well."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75b09dd-e6df-42cb-9889-d6fe159279b6",
                                                "sense_id": "52031f2e-34c1-3d9e-94c6-f83dd07291e2",
                                                "text": "The new college hallmates were awkward with each other at first, but after a game of charades as an icebreaker, they were laughing like old friends."
                                            },
                                            {
                                                "example_id": "d0356ce3-bb84-4771-9a46-f36e9bc6621f",
                                                "sense_id": "52031f2e-34c1-3d9e-94c6-f83dd07291e2",
                                                "text": "The key purpose of an icebreaker is to introduce your group members to each other and to introduce your training session topic. A well-planned icebreaker ensures that a training session will start with more involvement and focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae6cf6e-cc7d-363c-9df9-75a9d8ab99a0",
                                        "entry_id": "4cfd83c3-1399-3973-9ef4-d51be9b3a94c",
                                        "glosses": [
                                            "A lively song and dance routine at the start of a musical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae6834c-fb28-4fe4-910a-d6ba8bf8de9e",
                                                "sense_id": "cae6cf6e-cc7d-363c-9df9-75a9d8ab99a0",
                                                "text": "At the moment the curtain went up there had to be a lively ensemble number of principals and chorus singing and dancing, the traditional “icebreaker” that also covered up the noise of late-arriving ticket holders getting to their seats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "242d7a15-9d42-4f3d-948d-9c92ae549cc5",
                        "source_entry_id": "80f60ba2-e6c4-3232-b3cb-6f350312fc5a",
                        "source_sense_id": "503b4216-0724-3ffa-8097-fa69ffa39f7e",
