                        "sense_id": "ad2c3baf-5710-360d-93c6-90a95c5d09fc",
                        "entry_id": "460e4925-32fe-3065-b005-b0fc4333fb6d",
                        "glosses": [
                            "Qualité de ce qui est friable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4314d13f-6438-4de5-a9ba-aec510cd2167",
                                "sense_id": "ad2c3baf-5710-360d-93c6-90a95c5d09fc",
                                "text": "La friabilité est déterminée sur une motte ou un agrégat, à un état d’humidité situé à mi-chemin entre la capacité au champ et l’état sec à l’air (donc à l’état frais)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31282d61-a5f8-4b49-a8f5-29b1b668e72b",
                        "source_entry_id": "460e4925-32fe-3065-b005-b0fc4333fb6d",
                        "source_sense_id": "ad2c3baf-5710-360d-93c6-90a95c5d09fc",
                        "target_lang_word": "brittleness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brittleness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                        "entry_id": "02e30e1f-91b4-3a1c-a690-c56cd2c0da2f",
                                        "glosses": [
                                            "The state of being brittle (in various senses)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aac126a-f441-4257-8f9c-4a2581d441bf",
                                                "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                                "text": "[David] Riesman did his best, in prefaces to two subsequent editions of the book (at great length in 1961, and, with some brittleness about having to do it once more, in 1969), to correct this reading—to insist that he never meant to suggest that Americans now were any more conformist than they ever had been, or that there's even such a thing as social structure without conformist consensus."
                                            },
                                            {
                                                "example_id": "9f72871b-2ed2-4450-9ccd-4c6392e9cb1d",
                                                "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                                "text": "These vignettes often have the flavor of case studies, with interlocking themes related to the brittleness of the body and the complicated work of mourning."
                                            },
                                            {
                                                "example_id": "2413edf9-9c54-4e8e-9c2c-4ee685cb81a0",
                                                "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                                "text": "In Scotland, the Tay [bridge] fell (in part) as textbook testament to the brittleness of cast iron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
