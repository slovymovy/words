                        "sense_id": "add9c386-ffa3-302c-b9b0-31271d6d09f0",
                        "entry_id": "493b7af2-425e-376f-8b5f-af3522e711f6",
                        "glosses": [
                            "наливая, заполнять что-либо какой-либо жидкостью"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dedb9c0b-608a-3fcd-84f7-cc64ab6b5cfd",
                        "entry_id": "493b7af2-425e-376f-8b5f-af3522e711f6",
                        "glosses": [
                            "перен., разг. сильно пить; пьянствовать"
                        ],
                        "tags": [
                            ", часто неперех."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0f13f3dd-1657-3311-84b5-1750880978fe",
                        "entry_id": "493b7af2-425e-376f-8b5f-af3522e711f6",
                        "glosses": [
                            "перен., жарг. преувеличивать, лгать, говорить небылицы; загибать"
                        ],
                        "tags": [
                            ", неперех."
                        ],
                        "examples": [
                            {
                                "example_id": "bfd121a5-f11c-48c7-9df6-d2af91bbce92",
                                "sense_id": "0f13f3dd-1657-3311-84b5-1750880978fe",
                                "text": "Так, Лазарев Павел вспомнил рассказ овечьего пастуха Карпа Плеханова о том, как тот якобы чуть-чуть не сбил кнутом «ироплан», который распугал ему пасущихся овец. Уже нет в живых Карпа, а любому человеку, который врет не в меру, обычно говорят: «Давай лей, Карпуша, заливай…»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cce312a7-7655-461e-b569-185edce99de1",
                        "source_entry_id": "493b7af2-425e-376f-8b5f-af3522e711f6",
                        "source_sense_description": "разливаясь, покрывать собою сплошь; затоплять",
                        "target_lang_word": "drown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a18b74fb-59a3-3110-86bd-c15d17dc8762",
                                        "entry_id": "4054b04a-3a29-332a-8007-4ab421b8a8dc",
                                        "glosses": [
                                            "To die from suffocation while immersed in water or other fluid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89db701f-105c-4a81-ab84-a08af2fe41fb",
                                                "sense_id": "a18b74fb-59a3-3110-86bd-c15d17dc8762",
                                                "text": "When I was a baby, I nearly drowned in the bathtub."
                                            },
                                            {
                                                "example_id": "4400dc05-f0d1-4e00-bb5a-966070fda769",
                                                "sense_id": "a18b74fb-59a3-3110-86bd-c15d17dc8762",
                                                "text": "Old woes, not infant sorrows, bear them mild / Continuance tames the one; the other wild, / Like an unpractised swimmer plunging still, / With too much labour drowns for want of skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61b3ba3c-470d-3fc9-b7c2-39685a61bc07",
                                        "entry_id": "4054b04a-3a29-332a-8007-4ab421b8a8dc",
                                        "glosses": [
                                            "To kill by suffocating in water or another liquid."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f883ffd1-4e48-4641-9146-44cb01d189b4",
                                                "sense_id": "61b3ba3c-470d-3fc9-b7c2-39685a61bc07",
                                                "text": "The car thief fought with an officer and tried to drown a police dog before being shot while escaping."
                                            },
                                            {
                                                "example_id": "77d28106-f920-4bc6-a014-3a44ad294bdf",
                                                "sense_id": "61b3ba3c-470d-3fc9-b7c2-39685a61bc07",
                                                "text": "The pretty-vaulting sea refused to drown me, / Knowing that thou wouldst have me drown’d on shore, / With tears as salt as sea, through thy unkindness:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed663f8-0cbf-3d6a-a84d-ac639bb1a8f2",
                                        "entry_id": "4054b04a-3a29-332a-8007-4ab421b8a8dc",
                                        "glosses": [
                                            "To be flooded: to be inundated with or submerged in (literally) water or (figuratively) other things; to be overwhelmed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23b82d6-c8c6-4eb2-b067-63ad7438a17f",
                                                "sense_id": "3ed663f8-0cbf-3d6a-a84d-ac639bb1a8f2",
                                                "text": "We are drowning in information but starving for wisdom."
                                            },
                                            {
                                                "example_id": "add83f04-a618-4c61-abb9-b6755c4233fa",
                                                "sense_id": "3ed663f8-0cbf-3d6a-a84d-ac639bb1a8f2",
                                                "text": "Penny Guy: Bloody hell, Rog, whadda you want? / Roger O'Neill: To drown in your arms and hide in yer eyes, darlin'."
                                            },
                                            {
                                                "example_id": "7bd60a22-86ca-4927-9143-7272c397bf20",
                                                "sense_id": "3ed663f8-0cbf-3d6a-a84d-ac639bb1a8f2",
                                                "text": "The first-century Jewish woman Miriam of Nazareth, also held in faith to be Theotokos, the God-bearer, is arguably the most celebrated woman in the Christian tradition. One could almost drown surveying the ways different eras have honored her in painting, sculpture, icons, architecture, music and poetry; venerated her with titles, liturgies, prayers and feasts; and taught about her in spiritual writings, theology and official doctrine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab410ca6-036e-3bdf-b111-453ff76c0181",
                                        "entry_id": "4054b04a-3a29-332a-8007-4ab421b8a8dc",
                                        "glosses": [
                                            "To inundate, submerge, overwhelm."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ca9d169-a9f5-4e3c-801a-165be9d47a87",
                                                "sense_id": "ab410ca6-036e-3bdf-b111-453ff76c0181",
                                                "text": "He drowns his sorrows in buckets of chocolate ice cream."
                                            },
                                            {
                                                "example_id": "99a0f38a-fa99-4287-aac5-1685671ce4ed",
                                                "sense_id": "ab410ca6-036e-3bdf-b111-453ff76c0181",
                                                "text": "Though most men being in sensuall pleasures drownd, / It seemes their Soules but in the Senses are."
                                            },
                                            {
                                                "example_id": "3d40d356-53f2-47a3-9fae-b9adcd9a3d0f",
                                                "sense_id": "ab410ca6-036e-3bdf-b111-453ff76c0181",
                                                "text": "Come, thou monarch of the vine, / Plumpy Bacchus with pink eyne! / In thy fats our cares be drown’d, / With thy grapes our hairs be crown’d:"
                                            },
                                            {
                                                "example_id": "060cee61-6e69-4d9a-aae3-30725579d2a2",
                                                "sense_id": "ab410ca6-036e-3bdf-b111-453ff76c0181",
                                                "text": "My private Voice is drown’d amid the Senate’s."
                                            },
                                            {
                                                "example_id": "e74329ea-df13-461d-b81f-039c21727612",
                                                "sense_id": "ab410ca6-036e-3bdf-b111-453ff76c0181",
                                                "text": "Unluckily that worthy Officer having, in a literal Sense, taken his Fill of Liquor, had been some Time retired to his Bolster, where he was snoaring so loud, that it was not easy to convey a Noise in at his Ears capable of drowning that which issued from his Nostrils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e14b43-e934-3285-a86a-69d7001725cf",
                                        "entry_id": "4054b04a-3a29-332a-8007-4ab421b8a8dc",
                                        "glosses": [
                                            "To obscure, particularly amid an overwhelming volume of other items."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f570f13-0302-4e9e-b542-61d39eaa3dbf",
                                                "sense_id": "79e14b43-e934-3285-a86a-69d7001725cf",
                                                "text": "The answers intelligence services seek are often drowned in the flood of information they can now gather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
