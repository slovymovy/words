                        "examples": [
                            {
                                "example_id": "cb762d4d-af55-4d7b-b2bb-eedd15f6ddc7",
                                "sense_id": "43a7e724-7d64-3205-b30e-a11dc958eb01",
                                "text": "Der basale Teil des Ichthyopterygiums besteht aus den drei meist stabförmigen Elementen, dem Proto-, Meso- und Metapterygium."
                            },
                            {
                                "example_id": "06f6878e-f151-4794-ab0b-a1bd11e84d10",
                                "sense_id": "43a7e724-7d64-3205-b30e-a11dc958eb01",
                                "text": "„Das Brachiopterygium der Flösselhechte ähnelt dem Ichthyopterygium stark, nur die Flossenbasis ist etwas anders gebaut.“"
                            }
                        ],
