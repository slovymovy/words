                                "target_senses": [
                                    {
                                        "sense_id": "cac7febe-5873-3f40-aa34-b0cc1b62905f",
                                        "entry_id": "0d220b24-1fd5-3b51-b504-917aed4056d9",
                                        "glosses": [
                                            "Having been accused; being the target of accusations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa38ab57-99fe-48e1-94bc-ca4fdfdf1c5c",
                                                "sense_id": "cac7febe-5873-3f40-aa34-b0cc1b62905f",
                                                "text": "This power chiefly fell to the queen, and she was more accused than ever of too much leaning towards her own country; […]"
                                            },
                                            {
                                                "example_id": "3c80513e-1fcc-41da-82d4-b3fa2e4b975f",
                                                "sense_id": "cac7febe-5873-3f40-aa34-b0cc1b62905f",
                                                "text": "Naples had an almost stronger preference for the interposition of Spain, while the great republic of Venice in the eyes of Italy stood accused of aspiring to bring the whole peninsula under its sway, […]"
                                            },
                                            {
                                                "example_id": "0c47454f-c5a3-4010-914b-7b477c861cf5",
                                                "sense_id": "cac7febe-5873-3f40-aa34-b0cc1b62905f",
                                                "text": "If she felt unimportant, you showed her that she was important to you. If she felt accused, you reassured her. If she felt guilty, you helped her feel better."
                                            }
                                        ]
                                    }
                                ]
                            }
