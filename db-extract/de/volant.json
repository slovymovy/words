                "senses": [
                    {
                        "sense_id": "e06426fc-5953-3b28-8ad6-fd8387ecc7bd",
                        "entry_id": "4a4943a5-a4fc-3af0-9807-1d4fe6ab019e",
                        "glosses": [
                            "angenähter, textiler Besatz (zum Beispiel an Kleidungsstücken)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c311403e-9402-470c-a6ff-384d9b509e1b",
                                "sense_id": "e06426fc-5953-3b28-8ad6-fd8387ecc7bd",
                                "text": "„Blasse Schultern leuchteten aus tiefausgeschnittenen Roben, Seide knisterte, Jupons und Volants rauschten, Pelze glänzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2e133165-9b03-3425-ab6c-722053f916b9",
                        "entry_id": "4a4943a5-a4fc-3af0-9807-1d4fe6ab019e",
                        "glosses": [
                            "Stoffdach eines Sonnenschirms/einer Hollywoodschaukel/einer Markise"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fa00a267-1005-3dab-be8f-da0ac0a21250",
                        "entry_id": "4a4943a5-a4fc-3af0-9807-1d4fe6ab019e",
                        "glosses": [
                            "veraltet: Steuer eines Kraftfahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab0a9b9-23cc-4da2-8c25-25b50f8275cd",
                                "sense_id": "fa00a267-1005-3dab-be8f-da0ac0a21250",
                                "text": "„Alle drei grinsten sich an, und auch am Volant der Chauffeur des Fabrikbesitzers und Kommerzienrates Deertz grinste sachte vor sich hin.“"
                            },
                            {
                                "example_id": "3c25d8fc-fa7e-42a6-8ada-74fad9ac539c",
                                "sense_id": "fa00a267-1005-3dab-be8f-da0ac0a21250",
                                "text": "„Aber mir gefiel das alles, der Lärm auf den Straßen, das Gedränge an den Haltestellen, der Anblick der in ihren Ledermänteln übern Volant gelümmelten Taxichauffeure, wie sie an ihrer Thermosflasche nippten und die Tagesereignisse mit ihrem trockenen Witz glossierten – es war die Großstadt, und sie wirkte sensationell und erfrischend.“"
                            },
                            {
                                "example_id": "ea722040-61cb-44e6-8e6c-d7f90577f7ff",
                                "sense_id": "fa00a267-1005-3dab-be8f-da0ac0a21250",
                                "text": "„Da Archie zu schläfrig zum Chauffieren war, übernahm Adam den Volant, verfehlte aber den Weg und fuhr meilenweit in der falschen Richtung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
