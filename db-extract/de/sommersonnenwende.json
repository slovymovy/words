                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "przesilenie letnie",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9cfe465f-38c7-33d8-8dbf-311bb3d21f2f",
                                        "entry_id": "3a6b736e-2d1b-3d37-9024-dc9464539672",
                                        "glosses": [
                                            "przesilenie przypadające na koniec czerwca (około 24.), gdy Słońce znajduje się najbliżej bieguna północnego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3db407-5d01-444b-bb22-bf308ecad397",
                                                "sense_id": "9cfe465f-38c7-33d8-8dbf-311bb3d21f2f",
                                                "text": "W momencie przesilenia letniego cała strefa podbiegunowa półkuli północnej jest oświetlona Słońcem i panuje dzień polarny"
                                            }
                                        ],
