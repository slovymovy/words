                "senses": [
                    {
                        "sense_id": "1e7ea2bd-8512-3ffc-8ca9-eb9ab3d7c0ed",
                        "entry_id": "6842ac87-97e1-3fc5-bdaf-f3ee2ae25890",
                        "glosses": [
                            "politisch einflussreicher Staat, dessen Streitkräfte weltweit operieren können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5375fac-253f-4eb3-adea-413ca241b37e",
                                "sense_id": "1e7ea2bd-8512-3ffc-8ca9-eb9ab3d7c0ed",
                                "text": "Die Vereinigten Staaten von Amerika sind eine Weltmacht."
                            },
                            {
                                "example_id": "56671908-bc6b-451a-a23c-61d8bf5e84d9",
                                "sense_id": "1e7ea2bd-8512-3ffc-8ca9-eb9ab3d7c0ed",
                                "text": "„Die USA waren zu allen Zeiten Weltmacht und Geldmacht.“"
                            },
                            {
                                "example_id": "9861ae1c-85ba-480e-8d9e-6bbb82336e00",
                                "sense_id": "1e7ea2bd-8512-3ffc-8ca9-eb9ab3d7c0ed",
                                "text": "„Niebuhr untersucht in seinem Buch die Dilemmata, mit denen die amerikanische Gesellschaft konfrontiert wurde, nachdem das Land als Weltmacht aus dem Zweiten Weltkrieg hervorgegangen war.“"
                            },
                            {
                                "example_id": "3426438c-a2c8-484c-b68e-d7219ad87e59",
                                "sense_id": "1e7ea2bd-8512-3ffc-8ca9-eb9ab3d7c0ed",
                                "text": "„Das kleine Land an der Nordsee mit nicht einmal zwei Millionen Einwohnern gebärdete sich als Weltmacht.“"
                            },
                            {
                                "example_id": "3d7e26c5-f8ec-4e94-8936-f9dd17ad8f22",
                                "sense_id": "1e7ea2bd-8512-3ffc-8ca9-eb9ab3d7c0ed",
                                "text": "„Afrikas Gold soll Portugals Rang und Ruf als Weltmacht sichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
