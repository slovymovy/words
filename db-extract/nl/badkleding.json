                    {
                        "sense_id": "cd24b5d4-13d1-3a07-8e87-88b63ced866d",
                        "entry_id": "000a7a83-db44-3fc4-899b-227f2f8ab328",
                        "glosses": [
                            "kledij bedoeld voor het baden en zwemmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b7ed19-7d2f-4dba-9de8-2298689855d2",
                                "sense_id": "cd24b5d4-13d1-3a07-8e87-88b63ced866d",
                                "text": "De badkleding zit in de andere koffer."
                            },
                            {
                                "example_id": "2dc1206c-159f-484a-ad1f-2e28e750f56e",
                                "sense_id": "cd24b5d4-13d1-3a07-8e87-88b63ced866d",
                                "text": "Gavdos heeft prachtige, rustige stranden, die zich goed lenen voor recreatie. Badkleding is niet nodig, het eiland is een paradijs voor naturisten."
                            },
                            {
                                "example_id": "b7ea2d03-8e3f-4d4b-bc05-63c823eeef9c",
                                "sense_id": "cd24b5d4-13d1-3a07-8e87-88b63ced866d",
                                "text": "'Mam?' 'Hmhm,' mompel ik, terwijl ik in mijn kast op zoek ga naar mijn badkleding."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "555d05ba-c21e-4452-b972-d9f11370899f",
