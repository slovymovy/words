                            {
                                "example_id": "4a71b28e-4b40-4603-bf41-372222c55396",
                                "sense_id": "928cc3a3-004a-364c-a122-21533b37f472",
                                "text": "a, e, i, o, u et y sont des monophtongues."
                            },
                            {
                                "example_id": "6fd68971-4f1d-4b4d-9ec1-442b2026dada",
                                "sense_id": "928cc3a3-004a-364c-a122-21533b37f472",
                                "text": "Deux voyelles séparées par l’occlusive glottale faible sont erronément perçues comme constituant une diphtongue, elle même susceptible d’être réduite à une monophtongue."
                            }
                        ]
                    }
                ],
