    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c534486d-8d78-3c14-92ac-959ba984aed3",
                    "sense_definition": "Qui manque de prudence, qui agit sans précaution ni discernement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_prudence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune cycliste est très <w>imprudent</w> lorsqu'il traverse le carrefour sans regarder."
                        },
                        {
                            "text": "Elle a été bien <w>imprudente</w> de confier ses économies à un inconnu."
                        }
                    ],
                    "synonyms": [
                        "inconsidéré",
                        "téméraire",
                        "insouciant"
                    ],
                    "antonyms": [
                        "prudent"
                    ],
                    "common_phrases": [
                        "conducteur imprudent"
                    ]
                },
                {
                    "sense_id": "aa6a38fa-db8e-3d7d-b2ff-babb0effea2d",
                    "sense_definition": "Qui dénote un manque de prudence ou comporte des risques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_prudence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est particulièrement <w>imprudent</w> de s'aventurer sur ce sentier escarpé en pleine nuit."
                        },
                        {
                            "text": "Investir toutes ses économies dans un projet incertain est une décision <w>imprudente</w>."
                        }
                    ],
                    "synonyms": [
                        "hasardeux",
                        "risqué",
                        "dangereux"
                    ],
                    "antonyms": [
                        "prudent"
                    ],
                    "common_phrases": [
                        "décision imprudente",
                        "geste imprudent",
                        "parole imprudente"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d9ceeed-7e28-369a-84bf-7f46cd57fa0b",
                    "sense_definition": "Personne qui fait preuve d'imprudence ou qui prend des risques inconsidérés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manque_de_prudence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les maîtres-nageurs surveillent attentivement le littoral pour secourir les <w>imprudents</w> emportés par le courant."
                        },
                        {
                            "text": "L'<w>imprudent</w> qui s'était trop approché de la falaise a failli basculer dans le vide."
                        }
                    ],
                    "synonyms": [
                        "téméraire",
                        "casse-cou"
                    ]
                }
            ]
        }
    ]
