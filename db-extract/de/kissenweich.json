                "senses": [
                    {
                        "sense_id": "29706583-a5ef-344a-b0aa-7d03dc9bdd5d",
                        "entry_id": "0d1e6a8e-fab9-38ba-8b10-6e261fe00bc5",
                        "glosses": [
                            "sehr weich, weich wie ein Kissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bffc93b5-7595-4486-9dbd-6ee05e6d8d58",
                                "sense_id": "29706583-a5ef-344a-b0aa-7d03dc9bdd5d",
                                "text": "„Er trat näher, zog mich in seine kissenweiche Umarmung und klopfte mir auf den Rücken.“"
                            },
                            {
                                "example_id": "e7118fec-8b08-442b-95d2-68e2a09ed6ea",
                                "sense_id": "29706583-a5ef-344a-b0aa-7d03dc9bdd5d",
                                "text": "„Cora nahm das Mädchen in die Arme, kissenweich und schmiegsam, und griff nach einem Stück Packpapier, um den kleinen Körper zu bedecken.“"
                            }
                        ],
