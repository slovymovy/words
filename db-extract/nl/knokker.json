                ],
                "senses": [
                    {
                        "sense_id": "60144b26-a91b-3483-a43c-f54834f39ab9",
                        "entry_id": "9605ebd5-e7e6-3442-a118-040e7eb8cee3",
                        "glosses": [
                            "iemand die vecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d50f5979-c1ec-47c6-9f4f-083e4ed8e701",
                                "sense_id": "60144b26-a91b-3483-a43c-f54834f39ab9",
                                "text": "Rutte noemt Roemer een man met overtuigingen, een knokker en hij heeft humor „en dat is een mooie combinatie.” Hij wenst hem alle goeds toe voor de toekomst en zijn opvolger, Lilian Marijnissen, heel veel succes."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f6e5f45-7923-338b-b245-f61463368006",
                        "entry_id": "9605ebd5-e7e6-3442-a118-040e7eb8cee3",
                        "glosses": [
                            "iemand die heel erg zijn best doen en niet snel opgeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77087a6c-e317-4295-9664-7ab74ebbb144",
                                "sense_id": "6f6e5f45-7923-338b-b245-f61463368006",
                                "text": "\"Vincent is een beloftevolle spits, die erg doelgericht is. Zijn mentaliteit is uitstekend. Het is een knokker die alles uit zijn carrière wil halen. Bij AZ bieden we hem de mogelijkheden om zijn potentie waar te maken\", aldus directeur voetbalzaken Earnest Stewart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a9ed31a-95cd-4364-8e28-dec1ad504aba",
                        "source_entry_id": "9605ebd5-e7e6-3442-a118-040e7eb8cee3",
                        "source_sense_id": "60144b26-a91b-3483-a43c-f54834f39ab9",
                        "source_sense_description": "vechter",
                        "target_lang_word": "hooligan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hooligan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d669b64-c14a-349a-b988-0127ce798e77",
                                        "entry_id": "d3dd53e3-9545-3516-8061-bbbb85473104",
                                        "glosses": [
                                            "A young person who causes trouble or violence, typically as a member of a gang or other group."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91b92200-d663-436a-ada6-6808b4908191",
                                                "sense_id": "9d669b64-c14a-349a-b988-0127ce798e77",
                                                "text": "She also heard boys from other classes behind her talking: “So, Teacher Tang is a female hooligan.”"
                                            },
                                            {
                                                "example_id": "8fa0a721-c3a5-4a38-a979-ce76699f9830",
                                                "sense_id": "9d669b64-c14a-349a-b988-0127ce798e77",
                                                "text": "And I was in danger of turning into a right little hooligan if left to my wayward ways."
                                            },
                                            {
                                                "example_id": "86acfce9-4783-4ab1-96de-abc6a14f61fa",
                                                "sense_id": "9d669b64-c14a-349a-b988-0127ce798e77",
                                                "text": "“You are hooligan, you try to make trouble.” Sam paused, then continued. “Ah ha ha ha, I am right, I see it in your eyes. A hooligan!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45fed399-ecfc-339f-828c-6e6bfeece0cf",
                                        "entry_id": "d3dd53e3-9545-3516-8061-bbbb85473104",
                                        "glosses": [
                                            "Ellipsis of football hooligan."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d91e2533-e4c9-4090-be88-64442d0daf3b",
                                                "sense_id": "45fed399-ecfc-339f-828c-6e6bfeece0cf",
                                                "text": "These excursions abroad confirm that displacement has actually been a feature of the development of hooligan conflicts for some time, but an important wider point is that domestic hooligan displacement also seems to be a much more central issue today, as policing and other control strategies (segregation, seating, stewarding and CCTV in and around the larger English football grounds) have become more comprehensive, and especially as sentences for hooliganism have become much more forbidding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb34a5ae-fe88-3734-8281-37dd35ccae69",
                                        "entry_id": "d3dd53e3-9545-3516-8061-bbbb85473104",
                                        "glosses": [
                                            "A member of the United States Coast Guard."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b954f8f9-7a64-40d8-a567-d7c7cc53cf4a",
                                                "sense_id": "cb34a5ae-fe88-3734-8281-37dd35ccae69",
                                                "text": "Many professional Navy and Coast Guard men were inclined to scoff. What kind of Navy was this, and what did they think they were up to, anyway? This bunch of hooligans wouldn't be any good to anyone; wouldn't be worth the powder to blow 'em to hell. Hooligan's Navy."
                                            },
                                            {
                                                "example_id": "60d0606d-b660-4194-b244-27fb0559f18d",
                                                "sense_id": "cb34a5ae-fe88-3734-8281-37dd35ccae69",
                                                "text": "It often seemed to Al that the entire Coast Guard was a little embarrassed about being Coast Guardsmen—except maybe the cocky bearded men off the convoy cutters, who needed to apologize to no man because of any lack of battle stars. But in general, Army and Navy guys looked down on Hooligans."
                                            },
                                            {
                                                "example_id": "cf7eef92-3c89-4e80-8431-26534b588d44",
                                                "sense_id": "cb34a5ae-fe88-3734-8281-37dd35ccae69",
                                                "text": "I frequently notice that the hooligans (a respectful reference to the U.S. Coast Guard) are a hard act to follow."
                                            },
                                            {
                                                "example_id": "89a57fe9-7315-47b8-92ce-4489878af48b",
                                                "sense_id": "cb34a5ae-fe88-3734-8281-37dd35ccae69",
                                                "text": "Navy crew along the rail shouted smart-ass remarks and jeered at the hooligan doing his job."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hooligan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "358851e7-28ea-36d2-864c-565ca07e31ea",
                                        "entry_id": "3e0bf163-bda9-399f-ac9e-a5c000e9725e",
                                        "glosses": [
                                            "To act as a hooligan (sense 1)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b5405d6-98f7-3046-9aa2-fabb53ea1b64",
                                        "entry_id": "3e0bf163-bda9-399f-ac9e-a5c000e9725e",
                                        "glosses": [
                                            "To treat (a person) roughly."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hooligan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7480f55f-56ec-3f1a-bc35-a38493ca60d2",
                                        "entry_id": "87422f91-3e69-33a6-8b3c-2a45794ee91d",
                                        "glosses": [
                                            "A type of fish, an anadromous smelt, Thaleichthys pacificus, found in the North Pacific."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "053fee64-8fc5-4b9e-ac41-1cdc13172e52",
                                                "sense_id": "7480f55f-56ec-3f1a-bc35-a38493ca60d2",
                                                "text": "One year there was a strong wind. We couldn’t catch herring, but they were there. We caught lots of hooligans (smelt) and got through the year on those."
                                            },
                                            {
                                                "example_id": "df8b63c2-6d9d-4831-adbd-29288a12bf32",
                                                "sense_id": "7480f55f-56ec-3f1a-bc35-a38493ca60d2",
                                                "text": "Haines and Klukwan hooligan harvesters reported that they exchanged hooligan products primarily for other food items, especially those unavailable in the Chilkat and Chilkoot area or those which were inaccessible to the harvester for various reasons. Respondents reported that virtually any wild food might be obtained for hooligan oil."
                                            },
                                            {
                                                "example_id": "abb0d09c-f7d1-42e7-b9dc-2ffbcc8dc79a",
                                                "sense_id": "7480f55f-56ec-3f1a-bc35-a38493ca60d2",
                                                "text": "Low-gradient, clear water streams on the western side of Portage Pass provide spawning and rearing habitat for red salmon, silver salmon, pink salmon, chum salmon, hooligan (smelt), and Dolly Varden (U.S. Bureau of Land Management 1977b)."
                                            },
                                            {
                                                "example_id": "c1bcc5d5-41d2-46fd-8b89-594376c3d608",
                                                "sense_id": "7480f55f-56ec-3f1a-bc35-a38493ca60d2",
                                                "text": "Hooligan (smelt) are often spotted from the point as they come in with the tide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f233387-0fc3-4dcf-9a8c-7fc146b8742d",
                        "source_entry_id": "9605ebd5-e7e6-3442-a118-040e7eb8cee3",
                        "source_sense_id": "60144b26-a91b-3483-a43c-f54834f39ab9",
                        "source_sense_description": "vechter",
                        "target_lang_word": "basher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b3f0c17-e974-333b-92f1-e6cd5cb2363c",
                                        "entry_id": "d4a8c09e-7691-3a5e-9fa7-a24b9040df4e",
                                        "glosses": [
                                            "One who bashes something, figuratively or literally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c74ad622-7255-4ad4-a12b-e80d0dd22709",
                                                "sense_id": "6b3f0c17-e974-333b-92f1-e6cd5cb2363c",
                                                "text": "Consider the cold-eyed thrush, that springy carnivore of lawns, worm stabber, basher to death of snails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91f3cae7-2bd7-3f76-90f0-9887838447c7",
                                        "entry_id": "d4a8c09e-7691-3a5e-9fa7-a24b9040df4e",
                                        "glosses": [
                                            "One who engages in gratuitous physical or verbal attacks on a group or type of people."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb1e9df-c5e3-46b6-a67a-97bf289dffd3",
                                                "sense_id": "91f3cae7-2bd7-3f76-90f0-9887838447c7",
                                                "text": "a Paki-basher"
                                            },
                                            {
                                                "example_id": "239b22e0-4947-4bf6-bc00-50f866b33d64",
                                                "sense_id": "91f3cae7-2bd7-3f76-90f0-9887838447c7",
                                                "text": "He was beaten up by a queer-basher."
                                            },
                                            {
                                                "example_id": "8c2388f6-a572-46cb-a228-b1ba0e062aa0",
                                                "sense_id": "91f3cae7-2bd7-3f76-90f0-9887838447c7",
                                                "text": "It's impossible to count how many harassers and bashers are growing discouraged at the sight of 12 or so queers in black and teal uniforms walking down the street in tight formation. The message is simple: queer folk are banding together and walking the streets in cities around the United States to protect their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fafef238-27a3-3228-b36d-73f5b8c0ff9c",
                                        "entry_id": "d4a8c09e-7691-3a5e-9fa7-a24b9040df4e",
                                        "glosses": [
                                            "A trainspotter, especially one who likes to travel on specific trains or trainlines."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78332608-3d0c-42d2-82f3-94060f57e61f",
                                                "sense_id": "fafef238-27a3-3228-b36d-73f5b8c0ff9c",
                                                "text": "There are bashers and bashers, of course. Most of them, like 'Bob', try to travel as far as possible behind a particular type of locomotive. 'Bob' likes Class 37 diesels."
                                            },
                                            {
                                                "example_id": "8315fb08-ffd6-4582-a704-e338c991c1ba",
                                                "sense_id": "fafef238-27a3-3228-b36d-73f5b8c0ff9c",
                                                "text": "Nose around any modest-sized station and the odds are you'll find that the chargeman's office doubles as a bashers' club, a place where shivering spotters can get warm and catch up on the gen."
                                            },
                                            {
                                                "example_id": "21e8ddd3-ec51-4dbe-b7de-05967a729104",
                                                "sense_id": "fafef238-27a3-3228-b36d-73f5b8c0ff9c",
                                                "text": "Determined 'bashers' do still ride trains, of course, seeking to cram the largest number of route-miles into 24 hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c97b4188-237b-35e7-af10-8e1efcc0e758",
                                        "entry_id": "d4a8c09e-7691-3a5e-9fa7-a24b9040df4e",
                                        "glosses": [
                                            "A rainproof sheet for sleeping under."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "918815fc-778c-4b06-9a7b-2dbbdf4438d4",
                                                "sense_id": "c97b4188-237b-35e7-af10-8e1efcc0e758",
                                                "text": "Suddenly awake she looked around, startled, it was light, hot, intensely hot and she was sleeping in a shell scrape under a basher."
                                            },
                                            {
                                                "example_id": "305beeee-91c0-40a0-8f9f-311fdca93403",
                                                "sense_id": "c97b4188-237b-35e7-af10-8e1efcc0e758",
                                                "text": "I was well used to sleeping out under the stars whatever the weather. I had a hammock and a basher, a rain sheet to go over where I was sleeping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2809157c-be17-3076-85f8-98393a368697",
                                        "entry_id": "d4a8c09e-7691-3a5e-9fa7-a24b9040df4e",
                                        "glosses": [
                                            "A shelter built from improvised materials by a homeless person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8ea231a-c6cc-3c7f-b4fa-7d4fb8c8d631",
                                        "entry_id": "d4a8c09e-7691-3a5e-9fa7-a24b9040df4e",
                                        "glosses": [
                                            "A kind of small floodlight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
