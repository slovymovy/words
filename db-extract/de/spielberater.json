                "senses": [
                    {
                        "sense_id": "a7498d1f-1b13-310e-bdc9-ac9af30d6829",
                        "entry_id": "7d1c82e0-8753-3525-bed5-43ada5044105",
                        "glosses": [
                            "sachkundiger Helfer bei der Bewertung und Anschaffung von Spielmaterialien, bei der psychologischen und pädagogischen Betreuung von Spielenden und der Entwicklung von Spielstrategien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bdf0735-909c-4c55-9005-f40db2f9f8ce",
                                "sense_id": "a7498d1f-1b13-310e-bdc9-ac9af30d6829",
                                "text": "„Das ist grundsätzlich falsch, aber man sollte sich doch der Tatsache bewusst sein, dass man so etwas wie der Spielberater seines Kindes ist.“"
                            },
                            {
                                "example_id": "e4fe7409-de80-41c3-b500-3a1a866a0da5",
                                "sense_id": "a7498d1f-1b13-310e-bdc9-ac9af30d6829",
                                "text": "„Es versteht sich als ein Handbuch und Nachschlagewerk, das die Rolle eines Spielbegleiters durch die verschiedenen Lebensabschnitte übernehmen und als Spielberater zu jeder Gelegenheit zur Verfügung stehen möchte.“"
                            },
                            {
                                "example_id": "c5bdeb39-cd30-4a39-bd01-77435f7d40d7",
                                "sense_id": "a7498d1f-1b13-310e-bdc9-ac9af30d6829",
                                "text": "„Bis dahin schlug er sich als Spielberater und Trainer von Amateurvereinen durch.“"
                            },
                            {
                                "example_id": "d2894166-a0b0-45d4-bdbc-3300e6d52524",
                                "sense_id": "a7498d1f-1b13-310e-bdc9-ac9af30d6829",
                                "text": "„Zur praktischen Arbeit gehören für den Spielberater jedoch auch der Besuch von Einrichtungen, die Fachberatung von Kollegen vor Ort, Supervivion, die Mitwirkung an der Ausbildung z.B. in Kursen […].“"
                            },
                            {
                                "example_id": "32b2242d-f066-4772-aafd-5093df2cc428",
                                "sense_id": "a7498d1f-1b13-310e-bdc9-ac9af30d6829",
                                "text": "„Der 37-jährige Spielberater hat einen guten Draht nach Spanien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
