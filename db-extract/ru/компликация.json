                                        "entry_id": "4a2f7c79-dfe9-3baa-8966-389431b4d4eb",
                                        "glosses": [
                                            "The state of being complicated; intricate or confused relation of parts; complexity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e31fad2-c2fb-325a-a491-0575448fcebd",
                                        "entry_id": "4a2f7c79-dfe9-3baa-8966-389431b4d4eb",
                                        "glosses": [
                                            "A person who doesn't fit in with the main scheme of things; an interloper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7d97809-7812-3abd-bd74-b66f654b10f5",
                                        "entry_id": "4a2f7c79-dfe9-3baa-8966-389431b4d4eb",
                                        "glosses": [
                                            "A disease or diseases, or adventitious circumstances or conditions, coexistent with and modifying a primary disease, but not necessarily connected with it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d5de5e2-034e-318b-95c0-932b40cf2d37",
                                        "entry_id": "4a2f7c79-dfe9-3baa-8966-389431b4d4eb",
                                        "glosses": [
                                            "A feature beyond basic time display in a timepiece."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc9e0e9-a9f9-4701-aa02-954a2ef70e35",
                                                "sense_id": "6d5de5e2-034e-318b-95c0-932b40cf2d37",
                                                "text": "Obsessed, he was after a watch that contained the greatest number of complications in the boldest combinations in the smallest space imaginable."
                                            },
                                            {
                                                "example_id": "661f05e4-2aed-48d6-bf9c-f8f57318008e",
                                                "sense_id": "6d5de5e2-034e-318b-95c0-932b40cf2d37",
                                                "text": "In their final year, each student must make their own watch with a complication—from a tourbillon to a chiming mode to having a date display."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebb04e99-f353-3e15-b5ab-3edebe36329d",
                                        "entry_id": "4a2f7c79-dfe9-3baa-8966-389431b4d4eb",
                                        "glosses": [
                                            "A twisting or intertwining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fef1359-a3ac-44cd-927c-7b2e595efd35",
                                                "sense_id": "ebb04e99-f353-3e15-b5ab-3edebe36329d",
                                                "text": "the snaky complication in the Caduceus or rod of Hermes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
