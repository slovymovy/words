                "forms": [
                    {
                        "form_id": "35df4a7f-c03f-4550-83f1-5ad645eaeb27",
                        "entry_id": "e632d5fd-875b-3d7b-b8c7-fc5ee0c20d11",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more inexpugnable"
                    },
                    {
                        "form_id": "e1329c79-eb13-4f9a-bb62-eecafe98c6e3",
                        "entry_id": "e632d5fd-875b-3d7b-b8c7-fc5ee0c20d11",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most inexpugnable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb3eab6e-0bee-3087-90a3-0a27b84d8c77",
                        "entry_id": "e632d5fd-875b-3d7b-b8c7-fc5ee0c20d11",
                        "glosses": [
                            "Impossible to eliminate or destroy; impregnable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c8375a-c54d-4d55-bdce-7296b72bda37",
                                "sense_id": "cb3eab6e-0bee-3087-90a3-0a27b84d8c77",
                                "text": "My one hope of the world, my inexpugnable consolation in looking at the miseries of the world, is that this is altering."
                            },
                            {
                                "example_id": "cd3f3a3a-2406-4a26-9309-b7e65c1c94ba",
                                "sense_id": "cb3eab6e-0bee-3087-90a3-0a27b84d8c77",
                                "text": "It crept into one's mind, a distress as vague and inexpugnable as a sea fog on a spring morning, and presently one shivered and wanted to go indoors..."
                            },
                            {
                                "example_id": "8cea5fe6-f081-4f7a-b947-277cf916bfdc",
                                "sense_id": "cb3eab6e-0bee-3087-90a3-0a27b84d8c77",
                                "text": "This seemed to be an inexpugnable refuge, where we could live untroubled and learn to know each other.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d69594e-c50b-4801-8422-8e1890ac1b35",
                        "source_entry_id": "e632d5fd-875b-3d7b-b8c7-fc5ee0c20d11",
