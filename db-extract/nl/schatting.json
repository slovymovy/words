                ],
                "senses": [
                    {
                        "sense_id": "f609b03f-6b30-33e0-be35-ea3ded7deb79",
                        "entry_id": "37925417-9de2-331e-9ea1-7df0e39b52ef",
                        "glosses": [
                            "onnauwkeurige meting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f859a277-67cc-44b4-a3e2-ee7614e6c3bf",
                                "sense_id": "f609b03f-6b30-33e0-be35-ea3ded7deb79",
                                "text": "Volgens schattingen zijn ongeveer 16.000 inwoners van Enschede zeventig jaar of ouder."
                            },
                            {
                                "example_id": "5f027116-2107-466f-a90f-1e7ea377d50f",
                                "sense_id": "f609b03f-6b30-33e0-be35-ea3ded7deb79",
                                "text": "Hij woont in de buurt, het is naar schatting de dertigste keer dat hij hier staat, met enerzijds het uitzicht op de beboste flanken van de Vogezen en aan de zuidwestkant het glooiende laagland van de Haute-Saône."
                            },
                            {
                                "example_id": "1ad471cb-4d44-4c97-b195-fb2c6c46bb5c",
                                "sense_id": "f609b03f-6b30-33e0-be35-ea3ded7deb79",
                                "text": "Foodtrucks zijn met name populair op festivals. Maar ze worden tegenwoordig ook regelmatig ingehuurd voor familiefeesten of bedrijfsevenementen. Onno van Gent, die een website runt om foodtrucks te boeken, zegt tegen de KvK dat naar schatting daarom nu 65 procent van uitbaters fulltime bezig is met hun foodtruckonderneming."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a4606e4-5135-3ba4-94f9-36f9b64f49e1",
                        "entry_id": "37925417-9de2-331e-9ea1-7df0e39b52ef",
                        "glosses": [
                            "heffing die aan onderworpenen wordt opgelegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af588e4-2d16-4661-a645-9988a754d97e",
                                "sense_id": "0a4606e4-5135-3ba4-94f9-36f9b64f49e1",
                                "text": "Het verhaal vertelt nu over de keizer van Rome, die zich ergerde omdat hij Artur zo vaak moest vragen om de schatting die deze hem nooit zond hoewel hij dat verplicht was."
                            }
                        ]
                    }
                ],
                "translations": [
