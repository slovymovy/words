                                "pl": "Możesz do mnie zadzwonić po pomoc w <w>każdej</w> chwili.",
                                "de": "Du kannst mich <w>jederzeit</w> um Hilfe rufen.",
                                "fr": "Tu peux m'appeler pour de l'aide à <w>tout</w> moment.",
                                "it": "Puoi chiamarmi per aiuto in <w>qualsiasi</w> momento.",
                                "cs": "Můžeš mi zavolat o pomoc v <w>jakoukoliv</w> dobu.",
                                "tr": "Beni yardım için <w>herhangi bir</w> zamanda arayabilirsin.",
                                "es": "Puedes llamarme para pedir ayuda en <w>cualquier</w> momento."
                            }
                        },
                        {
                            "text": "Pick a card, <w>any</w> card.",
                            "target_lang_translations": {
                                "ru": "Выбери карту, <w>любую</w> карту.",
                                "nl": "Kies een kaart, <w>welke dan ook</w>.",
                                "pl": "Wybierz kartę, <w>jakąkolwiek</w> kartę.",
                                "de": "Zieh eine Karte, <w>egal welche</w> Karte.",
                                "fr": "Choisis une carte, <w>n'importe quelle</w> carte.",
                                "it": "Scegli una carta, una carta <w>qualsiasi</w>.",
                                "cs": "Vyber si kartu, <w>jakoukoliv</w> kartu.",
                                "tr": "Bir kart seç, <w>herhangi bir</w> kart.",
                                "es": "Elige una carta, <w>cualquiera</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in any case",
                        "at any rate",
                        "any other",
                        "any way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для обозначения одного или нескольких предметов или людей, когда выбор не имеет значения.",
                        "nl": "Gebruikt om te verwijzen naar een of meer dingen of mensen, waarbij het niet uitmaakt welke gekozen wordt.",
                        "pl": "Używane w odniesieniu do jednej lub więcej rzeczy lub ludzi, gdy nie ma znaczenia, który z nich zostanie wybrany.",
                        "de": "Wird verwendet, um sich auf eine oder mehrere Personen oder Dinge zu beziehen, wenn es keine Rolle spielt, welche gewählt wird.",
                        "fr": "Utilisé pour désigner une ou plusieurs choses ou personnes, sans que le choix n'ait d'importance.",
                        "it": "Usato per riferirsi a una o più cose o persone, quando non importa quale venga scelta.",
                        "cs": "Používá se k označení jedné nebo více věcí či lidí, když nezáleží na tom, která možnost je zvolena.",
                        "tr": "Hangisinin seçildiğinin önemli olmadığı durumlarda, bir veya daha fazla şey ya da kişiyi belirtmek için kullanılır.",
                        "es": "Se usa para referirse a una o más cosas o personas, cuando no importa cuál se elija."
                    },
