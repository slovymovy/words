                        "entry_id": "aa183299-7a30-3e85-9ed0-70117ae7b97b",
                        "glosses": [
                            "benaming voor een bepaalde vorm om het beschikbaar stellen van organen na overlijden juridisch te regelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e267729e-7caf-4881-9b34-2a6f532282b1",
                                "sense_id": "0a642875-88c2-3960-af80-66de4b905bab",
                                "text": "Het ADR is een combinatie van het huidige donorstelsel en een ‘ja, tenzij’-systeem. Ieder die zich nog niet heeft geregistreerd, wordt nogmaals gevraagd een keuze te maken. Wie niet reageert, wordt als donor bijgeschreven in het register. Wijziging blijft altijd mogelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2c76c5d-79c6-3381-a6fa-859017bcbeff",
                        "entry_id": "aa183299-7a30-3e85-9ed0-70117ae7b97b",
                        "glosses": [
                            "verdrag met regels die van toepassing zijn bij het vervoer over de landsgrens van goederen die gevaar kunnen opleveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bddb8ea-5bd9-440d-b266-73a1e0f7505e",
                                "sense_id": "b2c76c5d-79c6-3381-a6fa-859017bcbeff",
                                "text": "Het vervoer van gevaarlijke stoffen moet voldoen aan de regels van het ADR. In bepaalde gevallen is een gedeeltelijke of een volledige vrijstelling van het ADR mogelijk."
                            }
                        ]
                    }
