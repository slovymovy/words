                "senses": [
                    {
                        "sense_id": "01cd3096-3a22-31a1-8f63-2e294218fdb0",
                        "entry_id": "27276f12-b4d7-371d-bbcc-5c6eb15b1c80",
                        "glosses": [
                            "eine Person, die mit einem Fluch belegt ist beziehungsweise der Verdammnis anheimgefallen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ffc0ba-40ca-411e-bad2-d8a275df8033",
                                "sense_id": "01cd3096-3a22-31a1-8f63-2e294218fdb0",
                                "text": "„Es war ein Schreien, zuerst erstickt und abgebrochen wie das Weinen eines Kindes, dann aber schwoll es an zu einem ununterbrochenen, durchdringenden und unheimlichen Gekreisch, das keiner menschlichen Stimme mehr zu vergleichen war – zu einem bald jammervoll klagenden, bald höhnisch johlenden Geheul, wie es nur aus der Hölle kommt, wenn das Wehklagen der zu ewiger Todespein Verdammten sich mit dem Frohlocken der Höllengeister zu einem Schall vereint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24281a89-3eeb-4d07-8723-2b4e25ab6546",
                        "source_entry_id": "27276f12-b4d7-371d-bbcc-5c6eb15b1c80",
                        "source_sense_id": "01cd3096-3a22-31a1-8f63-2e294218fdb0",
                        "source_sense_description": "Person, die mit einem Fluch belegt ist",
                        "target_lang_word": "damned",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damned",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5883e6f0-3392-37b8-b01c-fc305adb8de2",
                                        "entry_id": "d4df231d-361f-3e68-8ef3-72d179151359",
                                        "glosses": [
                                            "Godforsaken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6811c8ef-0c4c-4771-a85e-fb822ec9d4cc",
                                                "sense_id": "5883e6f0-3392-37b8-b01c-fc305adb8de2",
                                                "text": "You're children of the damned // like candles, watch them burn // burning in the light // you'll burn again tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                        "entry_id": "d4df231d-361f-3e68-8ef3-72d179151359",
                                        "glosses": [
                                            "Variant of profane damn, used to express contempt, exasperation, etc. towards someone or something."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e7faea6-5b0c-4f5d-9cfb-51afc0da0ac2",
                                                "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                                "text": "Their damned lawyers can go to hell."
                                            },
                                            {
                                                "example_id": "e3f40b3c-c157-4595-a7cb-d94babc632ae",
                                                "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                                "text": "I can't get this damned thing to work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "050540f7-b921-3d21-9580-4d22131e1c65",
                                        "entry_id": "d4df231d-361f-3e68-8ef3-72d179151359",
                                        "glosses": [
                                            "Ellipsis of I'll be damned."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1a9646f-d6de-41ee-b91a-946b97a470b6",
                                                "sense_id": "050540f7-b921-3d21-9580-4d22131e1c65",
                                                "text": "Damned if I know."
                                            }
                                        ]
                                    }
