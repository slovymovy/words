                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f727ab2-d07a-31d7-9251-3194a573ae6c",
                    "sense_definition": "A magic charm, amulet, or spell bag, especially in hoodoo tradition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carried a small flannel pouch known as a <w>mojo</w> for good luck.",
                            "target_lang_translations": {
