                "senses": [
                    {
                        "sense_id": "a62c9b44-7081-32ef-9d63-195224376879",
                        "entry_id": "5fde84e6-5f4f-3566-b18e-f11f56afbacf",
                        "glosses": [
                            "Donner un caractère guinéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee21b20e-0cdf-41bc-9822-2b3eabf0aeff",
                                "sense_id": "a62c9b44-7081-32ef-9d63-195224376879",
                                "text": "Les entreprises évoluant en Guinée ont une obligation de \"guinéaniser\" les postes d’encadrement dans le secteur minier."
                            },
                            {
                                "example_id": "68f3c65d-f9c9-4b98-b7a5-9ff5ce9736b3",
                                "sense_id": "a62c9b44-7081-32ef-9d63-195224376879",
                                "text": "Ensuite, elle a émis l’idée de guinéaniser le poste de directeur général."
                            },
                            {
                                "example_id": "2d0bf5d4-a3a2-48dc-a00f-d4056e742fff",
                                "sense_id": "a62c9b44-7081-32ef-9d63-195224376879",
                                "text": "Pas de puits, ni de poste de santé, encore moins d'école et le réseau se «guinéanise » (c'est celui de la Guinée qui s'affiche) pour couronner le tout."
                            }
                        ]
                    }
