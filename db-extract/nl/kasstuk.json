                    {
                        "translation_id": "cac75957-dbca-4544-bc67-4315ef0d4abe",
                        "source_entry_id": "df089703-ca73-37e6-a756-aa7f3537495a",
                        "source_sense_id": "ce1ecf77-1ead-3505-aee0-24346f8dfb2d",
                        "source_sense_description": "film of uitvoering die alle verwachtingen overtreft wat betreft de opkomst van publiek",
                        "target_lang_word": "winner",
