                        "examples": [
                            {
                                "example_id": "eb8bd570-99c5-498e-bee1-810e243e0feb",
                                "sense_id": "17daee05-1f16-303d-a98c-f9912a17c1b2",
                                "text": "De kapitein nam Pierre bij het lichtschijnsel op en werd kennelijk getroffen door het verslagen gezicht van zijn gespreksgenoot."
                            },
                            {
                                "example_id": "b4515e9a-21ab-47ea-b09f-6387b35a8190",
                                "sense_id": "17daee05-1f16-303d-a98c-f9912a17c1b2",
                                "text": "Volgens onderzoeksleider Christopher Conselice is het heel lastig om onderzoek te doen naar al die sterrenstelsels in het heelal. \"Van het geschatte aantal van 2 biljoen kunnen we maar 10 procent onderzoeken. De rest van de stelsels ligt zo ver weg van de aarde dat het lichtschijnsel ervan onze planeet nog niet heeft bereikt.\""
                            }
                        ]
                    }
