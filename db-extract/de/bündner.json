                "senses": [
                    {
                        "sense_id": "b57a45a3-de19-332b-999a-06f181e2db67",
                        "entry_id": "cfe30031-6513-3588-baef-ad1ba7df9455",
                        "glosses": [
                            "Mitglied eines Bundes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dfd74a5-c18b-47bf-94ab-4a6db94dd5bc",
                                "sense_id": "b57a45a3-de19-332b-999a-06f181e2db67",
                                "text": "„Die griechischen Städte Unteritaliens traten jetzt als römische Bündner ohne Ausnahme unter römische Herrschaft.“"
                            },
                            {
                                "example_id": "478fb57c-f471-49eb-8850-5ede6750cb35",
                                "sense_id": "b57a45a3-de19-332b-999a-06f181e2db67",
                                "text": "„Als nun die Fahnen der Liga aber überall siegreich herrschten, geschah an die Bündner der längst erwartete Ruf des Marquis von Coeuvres, zu kommen, und die wiedergewonnenen Länder in Besitz zu nehmen.“"
                            },
                            {
                                "example_id": "e17a9335-bcea-4a9d-8759-35fd042034eb",
                                "sense_id": "b57a45a3-de19-332b-999a-06f181e2db67",
                                "text": "„Beim ersten Mal im Jahre 506, kurz nach der kleisthenischen Phylenreform, gab ihr Urteil den Ausschlag dafür, daß die Bündner der Lakedaimonier einen schon begonnenen Feldzug Kleomenes' I. mit dem Ziel, Isagoras Teisandros' Sohn zum Tyrannen von Athen zu machen, boykottierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
