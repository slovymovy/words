                    }
                ],
                "translations": [
                    {
                        "translation_id": "7320c7b5-867a-47d8-854d-0b4aeab90aa2",
                        "source_entry_id": "d7585dba-2529-352a-92c5-95af81e487df",
                        "source_sense_description": "сумка",
                        "target_lang_word": "baluchon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baluchon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe7936ca-b98e-31ec-9538-54dde240b763",
                                        "entry_id": "4f0a65d7-fe0c-39f0-906a-b5fbfd6cc697",
                                        "glosses": [
                                            "Petit paquet de hardes que l’on porte le plus souvent à la main."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "203b58a8-bc0f-481f-adb0-8140b00d4487",
                                                "sense_id": "fe7936ca-b98e-31ec-9538-54dde240b763",
                                                "text": "Voyons, laisse là ton baluchon, tu ne vas pas l’emporter ce soir. Où irais-tu d’ailleurs ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "609aa398-4cdf-3669-a7de-dc50fc3203b2",
                                        "entry_id": "4f0a65d7-fe0c-39f0-906a-b5fbfd6cc697",
                                        "glosses": [
                                            "Équipement de voyage composé d'un sac, souvent en toile, attaché au bout d'un bâton ; ce bâton étant posé sur l’épaule et le sac pendant à l’arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65d324a3-41bb-4d51-a9a8-3c1cc6779181",
                                                "sense_id": "609aa398-4cdf-3669-a7de-dc50fc3203b2",
                                                "text": "[…]; puis le vingt-cinq au soir, son sac d’outils en bandoulière et son baluchon sur l’épaule, il fit au bistro et à ses clients des adieux ironiques et rien moins que polis : […]"
                                            },
                                            {
                                                "example_id": "abd270ea-3efe-48fa-94bb-3da3394f3093",
                                                "sense_id": "609aa398-4cdf-3669-a7de-dc50fc3203b2",
                                                "text": "Lorsque dans les frimas de ce 1ᵉʳ mars 1856, le jeune Zéphyrin Rémy Camélinat quitte son bourg natal de Mailly-la-Ville, il a, pour tout bagage, un petit baluchon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d0e7a0f-acab-3bee-bdf7-5e1d0ce465e0",
                                        "entry_id": "4f0a65d7-fe0c-39f0-906a-b5fbfd6cc697",
                                        "glosses": [
                                            "Bagage léger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2788dffa-5544-4821-9be6-71d700f7fb7e",
                                                "sense_id": "7d0e7a0f-acab-3bee-bdf7-5e1d0ce465e0",
                                                "text": "Le cameraman m'attend, un minuscule baluchon sous le bras. Son ami perchiste, en revanche, très fashion victim métrosexuel, porte une gigantesque valise laissant à penser qu'il part faire un tour du monde."
                                            },
                                            {
                                                "example_id": "3dcc2222-cc15-4423-aa5f-6d07d20503af",
                                                "sense_id": "7d0e7a0f-acab-3bee-bdf7-5e1d0ce465e0",
                                                "text": "Hommes, femmes, enfants ont fui les lieux à pied, emportant dans des sacs ou des baluchons quelques effets personnels."
                                            },
                                            {
                                                "example_id": "7ee945ff-eec4-42c6-8c9c-2ec4693e26d2",
                                                "sense_id": "7d0e7a0f-acab-3bee-bdf7-5e1d0ce465e0",
                                                "text": "Dans quelques heures, les compartiments et les couchettes se rempliront d’enfants et de vieillards, de baluchons rassemblés à la va-vite, de chats, de chiens, et de l’immense tristesse de l’exil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f61c342-2845-3440-a0c0-aced23a17620",
                                        "entry_id": "4f0a65d7-fe0c-39f0-906a-b5fbfd6cc697",
                                        "glosses": [
                                            "Connaissances que l’on possède."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e491dd67-ec16-454d-b876-d636e305bc2c",
                                                "sense_id": "4f61c342-2845-3440-a0c0-aced23a17620",
                                                "text": "En cherchant aujourd’hui à reconstituer son baluchon d’idées, d’émotions, d’aspirations et de croyances, j’ai conscience de poser le pied sur un terrain très mouvant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
