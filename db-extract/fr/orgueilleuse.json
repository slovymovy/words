                        "entry_id": "555c75ec-6d42-3023-9d48-88fb1a81f3fc",
                        "glosses": [
                            "Féminin singulier de orgueilleux."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "50eeabde-bc56-460b-999c-062afa8840b1",
                                "sense_id": "8cfccfc6-addf-3444-924b-738982f1aa3b",
                                "text": "Dites une femme orgueilleuse, avare, envieuse, gourmande, colère et paresseuse, sa réputation demeure. Dites-la amoureuse, elle est déshonorée."
                            },
                            {
                                "example_id": "4bec2273-c920-4d23-86bf-11bc4b3204b9",
                                "sense_id": "8cfccfc6-addf-3444-924b-738982f1aa3b",
                                "text": "« Et attends, t’as pas tout vu », lui disait Jean Mercier d’un ton un peu sentencieux, avec cette expression orgueilleuse des habitués, des surcuits, des rescapés de l’aventure solaire."
                            },
                            {
                                "example_id": "3c20a8da-34b7-4e7d-858b-b46b303c8480",
                                "sense_id": "8cfccfc6-addf-3444-924b-738982f1aa3b",
                                "text": "Elle était orgueilleuse et ambitieuse et Vera se retrouvait en elle."
                            }
                        ]
                    }
                ],
