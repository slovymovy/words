                    },
                    {
                        "translation_id": "09049919-3627-4a90-8fec-2a6f9b6e9172",
                        "source_entry_id": "b4e321ca-0577-3db8-af5d-8f9e00556fa0",
                        "source_sense_id": "32f31019-d6d7-3386-9d90-4882daae66b1",
                        "source_sense_description": "een grote verstembare keteltrommel zoals gebruikt in een orkest",
                        "target_lang_word": "timbale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timbale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f5be97e-e0ca-36b0-9776-8117d383ac8e",
                                        "entry_id": "34f97194-2ea4-3a51-8565-9fed25a23582",
                                        "glosses": [
                                            "Sorte de tambour composé d’un demi-globe de métal sur lequel est tendue une peau dont la tension est réglable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d212d767-27a4-49b0-9e61-f722b6937793",
                                                "sense_id": "3f5be97e-e0ca-36b0-9776-8117d383ac8e",
                                                "text": "Les timbales étoient autrefois plus en usage parmi les Alemans & les Espagnols que parmi les François qui ne s’en servoient que quand ils les avoient gagnées sur les ennemis, mais aujourd’hui le Roi en donne à qui il lui plaît & principalement aux compagnies d’ordonnance."
                                            },
                                            {
                                                "example_id": "067bbb39-caae-40d7-89e7-1730a9a6d985",
                                                "sense_id": "3f5be97e-e0ca-36b0-9776-8117d383ac8e",
                                                "text": "Le roulement de timbale produit un effet surprenant dans le crescendo et le forté d’un orchestre nombreux ; il a quelque chose de mystérieux et de sinistre s’il est fait pianissimo, ou si les timbales sont voilées …."
                                            },
                                            {
                                                "example_id": "dbb964b8-ebc3-41f7-a990-ef356350eba9",
                                                "sense_id": "3f5be97e-e0ca-36b0-9776-8117d383ac8e",
                                                "text": "– J'aime beaucoup ces sortes de symphonies, dit le docteur. Je viendrai. Et, si je trouvais des… timbales, pourrais-je vous les envoyer ?\n– Certes, dit mon père, je n'en ai pas la moitié de ce qu'il faut. Sibelius en a mis quatre-vingts sur quatre rangs, au-dessus de son orchestre, mais, Paul, vous verrez : c'était pour dire quelque chose."
                                            },
                                            {
                                                "example_id": "fbffc4dc-27e2-4d1b-a57a-8bf078a799d7",
                                                "sense_id": "3f5be97e-e0ca-36b0-9776-8117d383ac8e",
                                                "text": "Passionné de percussions depuis l’âge de 6 ans, Alexandre Turco, 16 ans, vient de se distinguer aux timbales, lors d’un prestigieux concours international en Italie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ce80300-164d-332a-b6a0-304e1768bb82",
                                        "entry_id": "34f97194-2ea4-3a51-8565-9fed25a23582",
                                        "glosses": [
                                            "Gobelet de métal, souvent de valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c442d1-edac-4ca9-8ee3-56ab787f2551",
                                                "sense_id": "5ce80300-164d-332a-b6a0-304e1768bb82",
                                                "text": "— N’y a-t-il pas un bon orfèvre à Bar-le-Duc ? — Oh ! oui, monsieur, celui qui a ressoudé la timbale d’argent de mademoiselle Andrée."
                                            },
                                            {
                                                "example_id": "cf6674c0-91ec-4454-889f-62aa4d7e71e7",
                                                "sense_id": "5ce80300-164d-332a-b6a0-304e1768bb82",
                                                "text": "Deux couverts, avec des timbales d’argent, y étaient mis sur une petite table."
                                            },
                                            {
                                                "example_id": "dd076ecc-99f1-4714-b1c1-1b8bb79d857b",
                                                "sense_id": "5ce80300-164d-332a-b6a0-304e1768bb82",
                                                "text": "Vaut-il mieux, pour cadeau de baptême du petit Landry, offrir un bavoir ou une timbale ?"
                                            },
                                            {
                                                "example_id": "9e14e543-a513-433f-8f78-b60a3ddce92f",
                                                "sense_id": "5ce80300-164d-332a-b6a0-304e1768bb82",
                                                "text": "Puis, quand il eut absorbé les premières bouchées et bu une demi-timbale, il admit que sa femme avait eu raison."
                                            },
                                            {
                                                "example_id": "626d8302-7f6b-4051-8774-7954ad44e969",
                                                "sense_id": "5ce80300-164d-332a-b6a0-304e1768bb82",
                                                "text": "Un embarras se produisit lorsqu'on eut débouché la première bouteille de bordeaux : il n'y avait qu'une timbale. On se la passa après l'avoir essuyée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "701047fe-b814-38f6-bcc7-56b16b989a08",
                                        "entry_id": "34f97194-2ea4-3a51-8565-9fed25a23582",
                                        "glosses": [
                                            "Prix remporté par un ou une candidate lors d'un concours."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3901852-6c9d-35f7-98b6-419e12b8f0a4",
                                        "entry_id": "34f97194-2ea4-3a51-8565-9fed25a23582",
                                        "glosses": [
                                            "Moule de forme circulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7a67a7-6cca-4d06-b14d-f26f9524611a",
                                                "sense_id": "f3901852-6c9d-35f7-98b6-419e12b8f0a4",
                                                "text": "La passer dans des timbales basses spéciales, en argent ou en porcelaine ; saupoudrer abondamment la surface de glace de sucre et quadriller avec une tige de fer rougie au feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "137ee234-dc00-352b-852b-dfcf2a119372",
                                        "entry_id": "34f97194-2ea4-3a51-8565-9fed25a23582",
                                        "glosses": [
                                            "Croûte de pâtisserie dans laquelle on sert certains mets accommodés avec une sauce."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c741b35-ff2e-4ee3-994b-66a2ea247f22",
                                                "sense_id": "137ee234-dc00-352b-852b-dfcf2a119372",
                                                "text": "Une timbale de macaroni."
                                            },
                                            {
                                                "example_id": "0d7d25bd-3992-4596-bce1-37e9b34deb77",
                                                "sense_id": "137ee234-dc00-352b-852b-dfcf2a119372",
                                                "text": "Une timbale de queues d’écrevisses."
                                            },
                                            {
                                                "example_id": "89a9fac2-3dfa-4234-a75f-ac6eb5781b6d",
                                                "sense_id": "137ee234-dc00-352b-852b-dfcf2a119372",
                                                "text": "— Je représente ici, dit-elle en enlevant d’un réchaud une timbale d’écrevisses, l’élite des femmes de notre époque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
