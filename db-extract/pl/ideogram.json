                "senses": [
                    {
                        "sense_id": "c5932df7-a1a8-376a-95ac-f91de811333e",
                        "entry_id": "a75463f8-9547-38b2-929b-ff727b203c0d",
                        "glosses": [
                            "znak graficzny, który pojedynczo może oznaczać określony przedmiot, ale też zależnie od kontekstu pewną ideę; nie informuje o wymowie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a541bdf7-b211-4bb0-947b-465b2499d6c0",
                                "sense_id": "c5932df7-a1a8-376a-95ac-f91de811333e",
                                "text": "Przykładami ideogramów są starożytne hieroglify, a współcześnie – pismo chińskie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "483e9eac-c8a3-4823-9c17-ace576b14cde",
                        "source_entry_id": "a75463f8-9547-38b2-929b-ff727b203c0d",
                        "source_sense_id": "c5932df7-a1a8-376a-95ac-f91de811333e",
                        "target_lang_word": "ideogram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ideogram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e7e00b7-3303-3af8-87dc-e35c75842371",
                                        "entry_id": "ddeb0f8b-b6e3-33af-b236-866106fd90f2",
                                        "glosses": [
                                            "A picture or symbol which represents the idea of something without indicating the sequence of sounds used to pronounce it. Examples include digits, traffic signs, and graphic symbols such as @."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90540e0d-d111-4d85-97f2-4a8c962ed2c9",
                                                "sense_id": "8e7e00b7-3303-3af8-87dc-e35c75842371",
                                                "text": "Pensé tatuarme un ideograma secreto en mi hombro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b114c14-fda1-49f4-8339-a2a075d133a2",
                        "source_entry_id": "a75463f8-9547-38b2-929b-ff727b203c0d",
                        "source_sense_id": "c5932df7-a1a8-376a-95ac-f91de811333e",
                        "target_lang_word": "idéogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idéogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00f90b83-241d-325e-9538-5352fc386b29",
                                        "entry_id": "3ba4e6df-3012-34f3-8aa4-e27ab2484bc8",
                                        "glosses": [
                                            "Caractère représentant un sens ou une idée, comme les chiffres arabes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5016328-ec1b-499b-9b68-80de796740ab",
                                                "sense_id": "00f90b83-241d-325e-9538-5352fc386b29",
                                                "text": "Mais c’est son \"Recueil de Poèmes en langue nationale\" (Bach Vân quôc ngu tho) qui mérite une place à part dans notre littérature en idéogrammes vietnamiens nôm…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b747a98b-12e1-37b3-a814-9de137e828c8",
                                        "entry_id": "3ba4e6df-3012-34f3-8aa4-e27ab2484bc8",
                                        "glosses": [
                                            "Logogramme. Se dit des caractères chinois ou japonais formant une idée en y composant plusieurs caractères pictographiques de base ou d’autres idéogrammes plus simples."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cf44a04-3cb5-4844-8e75-7b8bc58f596b",
                                                "sense_id": "b747a98b-12e1-37b3-a814-9de137e828c8",
                                                "text": "Les idéogrammes, kanji, furent introduits au Japon vers le Vᵉ siècle par les Chinois au cours d’échanges de missions entre les deux nations."
                                            },
                                            {
                                                "example_id": "a930edbf-85fe-443f-b8ae-d53c18eabaf5",
                                                "sense_id": "b747a98b-12e1-37b3-a814-9de137e828c8",
                                                "text": "Derrière se dressaient les sotoba, longues et fines planches de bois clair où le kaimyo, son nouveau nom dans l’au-delà, était inscrit en idéogrammes noirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca4cb49-3150-3a85-87e5-e01f4cc87728",
                                        "entry_id": "3ba4e6df-3012-34f3-8aa4-e27ab2484bc8",
                                        "glosses": [
                                            "Représentation symbolique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67b9be2e-1eed-403a-b6df-672aca636e9a",
                        "source_entry_id": "a75463f8-9547-38b2-929b-ff727b203c0d",
