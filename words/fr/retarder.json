                                "target_lang_word": "postpone",
                                "target_lang_sense_clarification": "moving an event to later"
                            },
                            {
                                "target_lang_word": "delay",
                                "target_lang_sense_clarification": "pushing a start time back"
                            },
                            {
                                "target_lang_word": "put off",
                                "target_lang_sense_clarification": "moving plans to later"
                            }
                        ],
                        "ru": [
