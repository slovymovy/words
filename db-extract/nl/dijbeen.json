                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stehno",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "9e0d01e5-6054-3ec7-baa3-464f4270000d",
                                        "entry_id": "6e16249b-1f2f-3ce8-80eb-d27065d964ea",
                                        "glosses": [
                                            "část nohy mezi kolenem a kyčlí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8d62d2-c3df-4025-bf39-578ebc27c8f6",
                                                "sense_id": "9e0d01e5-6054-3ec7-baa3-464f4270000d",
                                                "text": "Mě snad šlehne, ta se odsud nehne, ať zem se po ní slehne, už kuchařky nám stehnem hrachovou kaši zahřívaj"
                                            },
                                            {
                                                "example_id": "a6849c57-7291-424f-909f-d04c5f1a6ebb",
                                                "sense_id": "9e0d01e5-6054-3ec7-baa3-464f4270000d",
                                                "text": "„Hej,“ vykřikl kanovník, „hej, pane, počínáte pozdě svůj sabat, což nezní zvony dosti silně? Sesedněte se svého koštěte, vidím je zřetelně mezi vašimi stehny."
                                            },
                                            {
                                                "example_id": "c45c6c70-4fb3-4dac-b91d-b7bb75210a08",
                                                "sense_id": "9e0d01e5-6054-3ec7-baa3-464f4270000d",
                                                "text": "Dobrovolně já umřu v pasti. Tvoje stehna jsou dva vrazi, jenže mě to-ne! nerozhází. Jednu noc ať jsme tu nazí... A pak půjdu cestou zkázy rád."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
