                ],
                "senses": [
                    {
                        "sense_id": "e0862078-83e2-34e2-a485-a3e882ab100a",
                        "entry_id": "95fb88d9-97ea-3eda-9cab-277aed7fc40a",
                        "glosses": [
                            "Studium im Ausland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d72d89-8889-41a6-abd6-ad6d93dce2fd",
                                "sense_id": "e0862078-83e2-34e2-a485-a3e882ab100a",
                                "text": "„Die Mehrheit der Afrikaner, die Bildung über die Grundschule hinaus erwerben wollte, musste nach Südafrika gehen, weil es in Südrhodesien zu dieser Zeit noch keine Universität gab. Aber nur wenige konnten sich ein Auslandsstudium leisten.“"
                            },
                            {
                                "example_id": "2f17f3d7-ba0e-4bbf-b21e-5172dcbfda1e",
                                "sense_id": "e0862078-83e2-34e2-a485-a3e882ab100a",
                                "text": "„Issei Sagawa hatte 1981 während eines Auslandsstudiums ein niederländisches Mädchen erschossen und dann Teile ihrer Leiche gegessen.“"
                            },
                            {
                                "example_id": "3f7181e9-341b-4a1f-9ecd-dce90cea88df",
                                "sense_id": "e0862078-83e2-34e2-a485-a3e882ab100a",
                                "text": "„Sie mussten nicht befürchten, ihr Wohnrecht zu verlieren, wenn sie ein Auslandsstudium antraten oder mit einem Ehepartner in eine benachbarte Stadt wie Anata oder Bethlehem zogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
