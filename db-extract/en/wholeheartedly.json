                "senses": [
                    {
                        "sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                        "entry_id": "e66d1b40-ca07-3696-a32e-8c32b79c885d",
                        "glosses": [
                            "In a wholehearted (“showing enthusiastic and unconditional commitment”) manner; without reserve; enthusiastically, unreservedly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99224603-a8ff-4684-9644-2a49d86d2de4",
                                "sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                                "text": "He jumped in wholeheartedly and began to learn the language."
                            },
                            {
                                "example_id": "a414aa73-cf68-48fb-9e76-b924389a884b",
                                "sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                                "text": "[T]hough Augustus and Tiberius discouraged the desire to deify them in their lifetime, Caligula had no sooner expressed his designs on godhead than the Alexandrians wholeheartedly fell in with his wishes, and worshipped him."
                            },
                            {
                                "example_id": "4d4ce74f-ab1c-45c2-969a-f0c9aefcf062",
                                "sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                                "text": "Thus unreservedly, promptly, and wholeheartedly did the people of New Mexico, through their chosen representatives, throw themselves and all their resources into the Great War. The Sunshine State fears no storm."
                            },
                            {
                                "example_id": "19adb067-74cf-4366-98ae-48fb49e757f3",
                                "sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                                "text": "[H]e had a natural bias against all change, and he hated wholeheartedly what he regarded as the central doctrine of the French Revolution, […]"
                            },
                            {
                                "example_id": "7a039920-4a54-49b0-9cdf-d69014cfeac9",
                                "sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                                "text": "We are wroth with these go-betweens and meddlers—the drifting clouds: these half-and-halfs that have learned neither to bless nor to curse wholeheartedly."
                            },
                            {
                                "example_id": "9b872877-0224-4b55-a925-60e8611deabf",
                                "sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                                "text": "Fans relished the traditional FA Cup fanfare from the Coldstream Guards and the hymn Abide With Me before throwing themselves wholeheartedly into an experience they have been largely deprived of since the first coronavirus lockdown began in March 2020."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "557bdc0e-db70-492a-ae40-18c5449a2df8",
                        "source_entry_id": "e66d1b40-ca07-3696-a32e-8c32b79c885d",
                        "source_sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                        "source_sense_description": "in a wholehearted manner — see also enthusiastically",
                        "target_lang_word": "van ganser harte",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "van ganser harte",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "23ca2a44-dd7e-367f-a7db-9caf959cd7e4",
                                        "entry_id": "0fc779aa-a581-3beb-b4de-6618d78373b1",
                                        "glosses": [
                                            "oprecht en onvoorwaardelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa4ced5-e534-4cac-9827-829b4ee3d36e",
                                                "sense_id": "23ca2a44-dd7e-367f-a7db-9caf959cd7e4",
                                                "text": "Ik hoop van ganser harte dat wij dit tegen donderdag in orde kunnen brengen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77c8d015-204e-4ae0-8d85-aec588365913",
                        "source_entry_id": "e66d1b40-ca07-3696-a32e-8c32b79c885d",
                        "source_sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                        "source_sense_description": "in a wholehearted manner — see also enthusiastically",
                        "target_lang_word": "de tout cœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de tout cœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be7f9e97-4889-3664-b2e3-bba41d660bc5",
                                        "entry_id": "9c1c4458-0819-3689-a803-e00cf483cb1a",
                                        "glosses": [
                                            "pleinement, totalement ; avec son soutien bienveillant et complet."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87cc07fc-fd9e-4a32-a0c9-b582382a868a",
                                                "sense_id": "be7f9e97-4889-3664-b2e3-bba41d660bc5",
                                                "text": "Et si un jour l'un de vos enfants, pour suivre sa voie, devait aller vivre à l'autre bout du monde ?\nJ'en souffrirais, bien sûr, et j'espère de tout cœur que cela me sera épargné !"
                                            },
                                            {
                                                "example_id": "5e94f62d-b3f2-47ed-8292-de54c5cdeb92",
                                                "sense_id": "be7f9e97-4889-3664-b2e3-bba41d660bc5",
                                                "text": "Et il a ajouté que si, comme il le souhaitait de tout cœur, cet appareil réalisait pratiquement les espérances qu'il donne en théorie, il était prêt non seulement à vous acheter cinq cent mille francs votre brevet, mais encore à vous nommer directeur de l'usine […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ab92a2-eed2-475d-a82e-46320dbff2c3",
                        "source_entry_id": "e66d1b40-ca07-3696-a32e-8c32b79c885d",
                        "source_sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                        "source_sense_description": "in a wholehearted manner — see also enthusiastically",
                        "target_lang_word": "à corps perdu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à corps perdu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                        "entry_id": "15e4b05b-e608-30bd-9c12-fd6b8331104d",
                                        "glosses": [
                                            "Avec impétuosité, sans songer à se ménager."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02585d40-2002-4ceb-b347-96ab27ac0f82",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "Contraint mais pas forcé, l'ancien champion se lance à corps perdu dans le projet, joue de la sympathie dont il jouit partout, notamment au CIO, pour faire passer les messages parisiens, transforme la maire Anne Hidalgo, longtemps réticente, en passionaria du dossier."
                                            },
                                            {
                                                "example_id": "ce5d125c-3567-49e8-9995-955aaebb156f",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "On se lance à corps perdu dans l’aventure; on veut traverser l’épreuve et devenir enseignant."
                                            },
                                            {
                                                "example_id": "f47aad1b-bbf5-4d04-bc5b-1a408f41172a",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "Abraham se lança donc à corps perdu dans toutes les batailles, tous les coups de force qui se présentèrent. Le plus souvent, il s’agissait de prêter la main à des tribus amies, pour régler quelques conflits de voisinage ou ferrailler contre les Boers qui empiétaient sur leurs terres ou convoitaient leur bétail. De brèves escarmouches qui lui permettaient d’expulser cette boule de haine qui l’empêchait de respirer."
                                            },
                                            {
                                                "example_id": "774aa039-d6c3-49f9-add6-32eba9e07beb",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "Nos académiciens se donnent et se livrent à corps perdu pour vous révéler leurs Onze de légende. Aujourd’hui un tour dans le Pas-de-Calais avec Luisette, détaillant à volonté les grandes heures des Sang-et-Or. C’est beau mais chut, place à la plume et à l’encrier de Luisette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4d14e5b-bd41-4dc2-80f7-c1ff4f3b5ed8",
                        "source_entry_id": "e66d1b40-ca07-3696-a32e-8c32b79c885d",
                        "source_sense_id": "37c561da-4927-3df6-9960-7fc83a460dba",
                        "source_sense_description": "in a wholehearted manner — see also enthusiastically",
                        "target_lang_word": "sans réserve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans réserve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "042685f2-e39c-377e-8ebb-1f7a6045bfe1",
                                        "entry_id": "eb48c265-f2b1-35cc-82be-2d8b94548905",
                                        "glosses": [
                                            "Sans exception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e595586-2b37-432d-bc40-a7180439cdcd",
                                                "sense_id": "042685f2-e39c-377e-8ebb-1f7a6045bfe1",
                                                "text": "Il lui a laissé tous ses biens sans réserve."
                                            },
                                            {
                                                "example_id": "5993d1ec-7c66-4a00-93e9-3ff0631d6856",
                                                "sense_id": "042685f2-e39c-377e-8ebb-1f7a6045bfe1",
                                                "text": "J’ai en lui une confiance sans réserve."
                                            },
                                            {
                                                "example_id": "6783ec02-a445-427f-9ffa-b3765d2db5c8",
                                                "sense_id": "042685f2-e39c-377e-8ebb-1f7a6045bfe1",
                                                "text": "[…]; car il serait étonnant, ainsi pensait Socrate, là où est la science, qu'autre chose régnât en maître et l'entraînât en tous sens comme un esclave. Socrate en effet combattait sans réserve une telle manière de voir, persuadé qu'il n'y a pas d'incontinence ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sans réserve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "716b3db9-4e0d-3734-b609-14a16bee3dac",
                                        "entry_id": "6c1345f5-adee-326e-9a49-4681706d6935",
                                        "glosses": [
                                            "Personne qui ne peut pas faire des économies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e9ba6f-aa89-4676-b925-f3cb475ba1f7",
                                                "sense_id": "716b3db9-4e0d-3734-b609-14a16bee3dac",
                                                "text": "Demander l'éloignement de la police des quartiers pauvres, exiger le licenciement des policiers les plus violents, etc. n’est par ailleurs pas une solution pour les sans réserves qui vivent dans des zones d’habitats dégradés."
                                            },
                                            {
                                                "example_id": "e8c0d2ab-aaa2-4fd1-adb7-b00db317e5c3",
                                                "sense_id": "716b3db9-4e0d-3734-b609-14a16bee3dac",
                                                "text": "« Le Capital » établit deux lois principales, qui sont les seules lois véritables. C'est, dans le premier volume, la loi générale de l'accumulation capitaliste, ou de la paupérisation croissante. Elle établit comment la concentration du capital en masses toujours plus grandes entraîne l'accroissement du nombre des prolétaires et des « sans réserves » (ce qui, répétons-le une fois de plus. ne signifie pas que le niveau de vie réel de l'ouvrier et la quantité des biens qu'il consomme, diminuent)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
