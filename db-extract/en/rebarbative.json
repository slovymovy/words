                                            {
                                                "example_id": "3e4354ec-2804-4d88-b1a4-656bef85dd15",
                                                "sense_id": "8dd3c79b-6130-31b0-be98-de3204867db2",
                                                "text": "De beelden van de jacht op walvissen waren weerzinwekkend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a69e1ca-2a7e-3ce7-b73f-bdbc16c77e73",
