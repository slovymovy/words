                        "sense_id": "a7806de6-bd00-3f82-a66a-d3c3925d8de7",
                        "entry_id": "8321da1f-cb7f-3ab3-8b70-254c44d56502",
                        "glosses": [
                            "A positive declaration."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "12e67b47-2a71-4c09-92c3-7913ce1aee8d",
                                "sense_id": "a7806de6-bd00-3f82-a66a-d3c3925d8de7",
                                "text": "Under oath, at the Army-McCarthy hearings, he denied ever having said this. His denials were as meaningless as his avouchments, and reputable journalists heard him."
                            }
                        ]
                    }
