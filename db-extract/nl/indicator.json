                                "example_id": "e596703a-bf04-4600-8287-4cf4bfbcbc42",
                                "sense_id": "44b6699f-694b-3690-b66f-0c64df756abb",
                                "text": "Het aantal nieuwe kleine bedrijfjes is een goede indicator van de te verwachten groei in werkgelegenheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "487d6bca-caed-3cf9-84c2-56f9b802137e",
