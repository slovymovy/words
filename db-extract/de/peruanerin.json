                        "examples": [
                            {
                                "example_id": "9652c7e7-774a-481c-988c-a4fe19645fdd",
                                "sense_id": "ce0724b1-f4f5-39c5-9fbf-0afde5915db1",
                                "text": "„Mitfinanziert vom eigens gegründeten World Cinema Fund, gewinnen sie dann, wie zuletzt „Eine Perle Ewigkeit“ der Peruanerin Claudia Llosa, mit ein bisschen Glück und Liebe den Goldenen Bären.“"
