                        "form": "худо́жеством"
                    },
                    {
                        "form_id": "deb518fa-4e4d-4149-9ca1-74d4985d0bbe",
                        "entry_id": "41521ac5-ec53-3244-823d-de18a7610950",
                        "tags": [
