                ],
                "senses": [
                    {
                        "sense_id": "6dfbbd5b-5601-347e-8cdd-5ac836d731a2",
                        "entry_id": "8e29f821-2728-3ac8-b771-b859e4600d85",
                        "glosses": [
                            "eine bedeutende und qualitativ sehr hochwertige Rotwein-Rebsorte (in Deutschland vor allem unter dem Namen „Spätburgunder“ bekannt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbfdccc3-d040-45c2-987d-15bb79a6ac82",
                                "sense_id": "6dfbbd5b-5601-347e-8cdd-5ac836d731a2",
                                "text": "„Eine badische Kleinstadt, dachte Henry, während Bettina weitererzählte, kultiviert, manierlich umgeben von Weinbergen. Hügel, sanft abfallende Wiesen, Feldsalat und Schneckensuppe, Riesling und Schwarzburgunder. Obstbrände statt Fusel. Umgangsformen statt Berliner Schnauze, plus Geld.“"
                            },
                            {
                                "example_id": "4aa4047f-6b58-4f92-9fe2-b3223b30b22f",
                                "sense_id": "6dfbbd5b-5601-347e-8cdd-5ac836d731a2",
                                "text": "„Der Clüvener, Klebroth, Schwarzburgunder oder Spätburgunder … Ist eine der vorzüglichsten Weintrauben, welche zur Bereitung von rothen und in neuester Zeit auch weißen Weinen dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b2f1861-4842-3ca3-80a3-18d4049bc8d4",
                        "entry_id": "8e29f821-2728-3ac8-b771-b859e4600d85",
                        "glosses": [
                            "Wein, der aus Spätburgunder-Reben hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af919ab-3c2f-4b95-89e5-dbed643f70d9",
                                "sense_id": "7b2f1861-4842-3ca3-80a3-18d4049bc8d4",
                                "text": "„Der Clüvener, Klebroth, Schwarzburgunder oder Spätburgunder … Ist eine der vorzüglichsten Weintrauben, welche zur Bereitung von rothen und in neuester Zeit auch weißen Weinen dient.“"
                            },
                            {
                                "example_id": "bff6f682-3540-41e2-af20-9e7e107d51e1",
                                "sense_id": "7b2f1861-4842-3ca3-80a3-18d4049bc8d4",
                                "text": "„Magst was trinken?“, fragte er und ging zum Kühlschrank, „ich hab’ Wasser, ’n Rest italienischen Magenbitter und Schwarzburgunder da.“ „Schwarzburgunder??“ Ich mußte ihn ziemlich verdutzt angeguckt haben, bis mir wieder einfiel, daß ich das Wort bereits kannte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
