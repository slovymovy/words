                ],
                "senses": [
                    {
                        "sense_id": "f8420ba8-17e9-3680-af5a-e1e0de22b004",
                        "entry_id": "6267799f-dfe5-32a7-9202-1ec413e6c6b3",
                        "glosses": [
                            "dafür vorbereitet, wegbefördert zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1581ee33-3f4a-4ef4-96d8-08f7dfd211e7",
                                "sense_id": "f8420ba8-17e9-3680-af5a-e1e0de22b004",
                                "text": "Der ehrfurchtgebietende Greis wurde allseitig gegrüßt, auch von den Rollknechten, die eben dabei waren, schön gehobelte Brunnenkisten versandfertig auf Frachtwagen zu verstauen."
                            },
                            {
                                "example_id": "f6854766-a878-48c3-abde-972d69cb9c1c",
                                "sense_id": "f8420ba8-17e9-3680-af5a-e1e0de22b004",
                                "text": "„Die Hamburger finanzieren die Aktion, weil sie sich Hinweise auf den Verbleib des Bernsteinzimmers erhoffen, das hier im Schloss 1945 zum letzten Mal sicher gesehen wurde: versandfertig verpackt in 27 Holzkisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
