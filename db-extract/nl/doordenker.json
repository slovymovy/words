                    {
                        "sense_id": "885af4c0-1142-3f7f-95cf-cb61ac3bf45c",
                        "entry_id": "5c397e49-3954-35af-9c5f-3e319b5a3932",
                        "glosses": [
                            "iemand die zich verder in onderwerpen verdiept dan anderen"
