                        "glosses": [
                            "One who powwows."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de5c5e3a-17cf-4bee-af1a-7eeff279673e",
                                "sense_id": "47b23115-991e-363c-be5a-44fc121ad98f",
                                "text": "The inhabitants were struck with wonder at this event, and held a conference to discover the reason why the devils and the powwowers had obeyed the prayers of one minister, and had paid no regard to those of fifty."
                            },
                            {
                                "example_id": "3d34c193-885b-4961-9d4d-534b3fb40f6e",
                                "sense_id": "47b23115-991e-363c-be5a-44fc121ad98f",
                                "text": "The Powwowers or Priests were formerly in high estimation, as it is believed that they are the agents of the different powers, or great spirits that govern the universe, and that they have power to kill or cure as they think proper."
                            },
                            {
                                "example_id": "4ba17ee7-0d75-4a16-923e-8c260a4c9442",
                                "sense_id": "47b23115-991e-363c-be5a-44fc121ad98f",
                                "text": "All the while, the powwower is speaking subvocally so that the patient cannot hear what he or she is saying, even when the powwower’s lips are inches away from the patient’s ears."
                            }
                        ]
                    }
                ],
