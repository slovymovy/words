                "senses": [
                    {
                        "sense_id": "17e4d721-0827-30ca-b6b9-fe860db5ff38",
                        "entry_id": "0409ac94-5076-3542-9056-9335008c9481",
                        "glosses": [
                            "związany z lokalem, gdzie się kupuje, spożywa wyroby cukiernicze, gdzie można się napić kawy, herbaty itp. lub wytwórnią ciastek"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "841236d5-af85-4d90-8eb7-f4238eeebc11",
                                "sense_id": "17e4d721-0827-30ca-b6b9-fe860db5ff38",
                                "text": "Śród wykwintu kokociego cukiernianej atmosfery, gdzie nad mdławą białą kawą płyną kłęby z papierosów (…) gdzie się „smęci” nikłe grono literacin mędrkujących, wstanę, gwizdnę, rozszalały, nad pachnących mydłków zgrają"
                            }
                        ],
