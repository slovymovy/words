                "senses": [
                    {
                        "sense_id": "df9bc5b7-e974-3a2a-93b3-b827548d6db0",
                        "entry_id": "b773c227-d721-33bc-b13d-a672c30b899a",
                        "glosses": [
                            "Of or pertaining to the philosophical system of Georg Wilhelm Friedrich Hegel (1770–1831)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a92e3b65-a132-4d37-94ae-379d8d65b55c",
                                "sense_id": "df9bc5b7-e974-3a2a-93b3-b827548d6db0",
                                "text": "The Germanic Tribes had told the whole world in all possible tones carrying conviction, the gently persuasive, the coldly logical; in tones Hegelian, Nietzschean, warlike, pious, cynical, inspired, what they were going to do to the inferior races of the earth, so full of sin and all unworthiness."
                            },
                            {
                                "example_id": "acbb8c18-0bd2-4181-9911-f33d81b6ef18",
                                "sense_id": "df9bc5b7-e974-3a2a-93b3-b827548d6db0",
                                "text": "As events such as 9/11, the Afghan and Iraq wars and the 2008 financial crisis took their toll on liberalism’s self-confidence, Fukuyama’s work was denounced as the height of Hegelian hubris."
                            }
                        ]
                    }
                ],
