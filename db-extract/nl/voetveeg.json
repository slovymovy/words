                                "example_id": "87052b18-36c4-42ae-a382-a4564e533448",
                                "sense_id": "6ff1ab13-1a54-3180-a150-ed3fe3c39811",
                                "text": "Voor de hotelingang lag een 'voetveeg', een enorme dikke deurmat van kokos-velours waarin het woord 'WELKOM' was geweven."
                            }
                        ]
                    },
                    {
                        "sense_id": "0739ea7f-3a0a-3e5e-888c-cb4f1b8871dc",
                        "entry_id": "935ea477-f02a-3cc5-b325-daa9aed3c81e",
                        "glosses": [
                            "flunky, doormat, minion"
                        ],
                        "tags": [
                            "broadly",
                            "masculine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f533f7c4-24e1-319d-b862-b39f6f358924",
                        "entry_id": "935ea477-f02a-3cc5-b325-daa9aed3c81e",
                        "glosses": [
                            "leg sweep (kick or tackle where the leg sweeps over the ground)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "c6751a53-9d0d-405f-a53e-697649ccf1d6",
                                "sense_id": "f533f7c4-24e1-319d-b862-b39f6f358924",
                                "text": "Met een voetveeg, zonder het zelf echt goed te beseffen, vloer ik mijn zus. Daar zie! Een smerige voetveeg vanuit een duister, vaag, zwaar, onbestemd gevoel. Het is iets dat gebeurt als in een flits, als in een opwelling, ongecontroleerd."
                            }
                        ]
                    }
                ],
