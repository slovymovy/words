                                        "sense_id": "c02912c6-ab16-3e43-bb88-2926016b14be",
                                        "entry_id": "142021b3-926a-3faf-99b1-271af72112ff",
                                        "glosses": [
                                            "Grand singe anthropoïde aux longs bras et au pelage roux ou brun, du genre Pongo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6dd8f3b-0170-4b5b-b5f1-fa29672aabb7",
                                                "sense_id": "c02912c6-ab16-3e43-bb88-2926016b14be",
                                                "text": "Pourtant à leur grand étonnement, plus de dix jours après son arrivée l’orang-outan ne laissait rien transparaître."
                                            },
                                            {
                                                "example_id": "3f19c9c5-4bba-4908-9514-03ff6ed209e4",
                                                "sense_id": "c02912c6-ab16-3e43-bb88-2926016b14be",
                                                "text": "Les orangs-outans sont les plus arboricoles des grands singes. Ils passent la majeure partie de leur temps dans les arbres, et s’y fabriquent chaque nuit un nouveau nid."
                                            }
                                        ]
                                    }
