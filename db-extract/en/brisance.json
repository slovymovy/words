                        "entry_id": "f0febc56-6ba7-32c0-93ae-73463cb0ac52",
                        "glosses": [
                            "The shattering effect of the energy released in an explosion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e88f7ea3-0301-4606-827b-d572044ce619",
                                "sense_id": "34377be1-fa2b-3d6f-b06c-76e054aab33d",
                                "text": "He thought he knew being aflame. But this was sustained explosion, reaching now and then a quite unendurable brisance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b6cb273-bd6d-4160-9798-700da36da72e",
                        "source_entry_id": "f0febc56-6ba7-32c0-93ae-73463cb0ac52",
                        "source_sense_id": "34377be1-fa2b-3d6f-b06c-76e054aab33d",
                        "source_sense_description": "shattering effect of the energy released in an explosion",
                        "target_lang_word": "brisance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brisance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5c6b459-aca4-39a4-9290-1ca4b455fcbf",
                                        "entry_id": "f25fe14a-4172-36db-93f7-343c21f47c05",
                                        "glosses": [
                                            "Aptitude d’un explosif à briser, sans bourrage préalable, tout corps solide mis à son contact."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9991c9-9401-4d76-bd44-e0d5864611be",
                                                "sense_id": "a5c6b459-aca4-39a4-9290-1ca4b455fcbf",
                                                "text": "La notion de brisance est essentiellement qualitative, à masses égales certains explosifs sont capables d’effectuer des dégâts plus importants que d’autres sur les matériaux qu’ils sont chargés de détruire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa6b0661-b23f-4c58-aeb0-cd275c95ccc9",
                        "source_entry_id": "f0febc56-6ba7-32c0-93ae-73463cb0ac52",
                        "source_sense_id": "34377be1-fa2b-3d6f-b06c-76e054aab33d",
                        "source_sense_description": "shattering effect of the energy released in an explosion",
                        "target_lang_word": "Brisanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brisanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49d4e9b4-5b5e-3f95-99fa-029de4f53229",
                                        "entry_id": "184ff72b-65f9-3f02-9492-eecb93e8774b",
                                        "glosses": [
                                            "ein Merkmal großer Bedeutsamkeit oder Gefährlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8a72b6-4622-4774-812d-76107d3aaa01",
                                                "sense_id": "49d4e9b4-5b5e-3f95-99fa-029de4f53229",
                                                "text": "Der NSU-Untersuchungsausschuss widmet sich einem Thema mit erheblicher Brisanz."
                                            },
                                            {
                                                "example_id": "9c28afca-0028-464c-9828-41eb634154b0",
                                                "sense_id": "49d4e9b4-5b5e-3f95-99fa-029de4f53229",
                                                "text": "„Aufgrund dieser Brisanz veröffentlichte Diderot den Dialog des Abbé Galiani erst im Dezember 1769 als Étienne Maynon d’Invault seines Amtes enthoben worden war und durch Joseph Marie Terray ersetzt wurde, der den Gedanken des Abbé Galiani positiv gewogen war.“"
                                            },
                                            {
                                                "example_id": "d93b44bc-f838-4dae-bd15-8e9f897dfd2c",
                                                "sense_id": "49d4e9b4-5b5e-3f95-99fa-029de4f53229",
                                                "text": "„Der Witz erhält seine Brisanz gar nicht so sehr aufgrund des Umstandes, dass der Parteigenosse schließlich doch die Gesellschaftsordnung der DDR verleugnet, denn auch ihm ist ja das Hemd näher als die Jacke.“"
                                            },
                                            {
                                                "example_id": "19e269f5-83f3-4b3e-8936-d29acc018899",
                                                "sense_id": "49d4e9b4-5b5e-3f95-99fa-029de4f53229",
                                                "text": "„Die erhebliche politische Brisanz der Kriegsbücher in der Weimarer Republik rührt daher, dass die von Jünger unentwegt erwähnte Tapferkeit der Soldaten die sogenannte Dolchstoßlegende ausdrücklich bestätigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd920fcd-bc18-3cdf-931b-a9f7a1bfc77f",
                                        "entry_id": "184ff72b-65f9-3f02-9492-eecb93e8774b",
                                        "glosses": [
                                            "das Zertrümmerungsvermögen eines explosiven Stoffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e4b2e1-646f-496c-a2d3-516546eca824",
                                                "sense_id": "bd920fcd-bc18-3cdf-931b-a9f7a1bfc77f",
                                                "text": "„Die Brisanz oder das Zertrümmerungsvermögen einer Gasexplosion ist nicht mal annähernd so groß wie bei C4 oder Hexogen, was aber noch lange nicht heißt, dass man es ohne geeigneten Schutz überleben kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
