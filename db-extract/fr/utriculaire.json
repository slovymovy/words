                        "tags": [
                            "plural"
                        ],
                        "form": "utriculaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a4dd1d3-b780-3873-87bb-b5a1d8c9fac5",
                        "entry_id": "172f4f87-ebb0-3696-964b-f3e7c4043025",
                        "glosses": [
                            "Plante aquatique qui porte des utricules qui peuvent s’ouvrir pour capturer des petits animaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dfec0fd-a627-447d-a619-f8537183ceb1",
                                "sense_id": "4a4dd1d3-b780-3873-87bb-b5a1d8c9fac5",
                                "text": "Les Utriculaires, plantes qui vivent sous l’eau, sont munies de petites vessies habituellement submergées. Au moment de la floraison, ces outres se remplissent d’air, se font légères, viennent flotter à la surface où elles soutiennent les fleurs, puis de nouveau s’enfoncent et nagent entre deux eaux."
                            },
                            {
                                "example_id": "bdb2ad36-8ec9-4b54-b15f-9c159fa8a18b",
                                "sense_id": "4a4dd1d3-b780-3873-87bb-b5a1d8c9fac5",
                                "text": "Des plantes rares comme l’utriculaire, fleur carnivore, se sont acclimatées à ce milieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fcd8215-adc7-4910-994c-6a1774b5b275",
                        "source_entry_id": "172f4f87-ebb0-3696-964b-f3e7c4043025",
                        "source_sense_id": "4a4dd1d3-b780-3873-87bb-b5a1d8c9fac5",
                        "target_lang_word": "Wasserschlauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserschlauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af3b2b53-bf26-368b-8cb1-0f6dba145103",
                                        "entry_id": "a988b5af-515e-3dfd-914a-c752294f9523",
                                        "glosses": [
                                            "Schlauch, in dem Wasser fließt und der einem hohen Druck standhalten muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f408faf-760b-49c7-b2e9-aacc5cdbbd0a",
                                                "sense_id": "af3b2b53-bf26-368b-8cb1-0f6dba145103",
                                                "text": "„Vor dem großen Hotel spritzen zwei Livrierte den Gehsteig mit einem Wasserschlauch ab.“"
                                            },
                                            {
                                                "example_id": "63740180-0e68-452c-a171-2c770bbf85ea",
                                                "sense_id": "af3b2b53-bf26-368b-8cb1-0f6dba145103",
                                                "text": "„Für die Ägypter war Lesen eine köstliche Erfrischung gleich dem kühlen, wohltuenden Nass aus dem Wasserschlauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
