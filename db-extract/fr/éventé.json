                "senses": [
                    {
                        "sense_id": "480bc9d5-a56a-3552-bfba-d93aa414d51c",
                        "entry_id": "9f1711b0-2064-3d06-a852-a3a4df734dcf",
                        "glosses": [
                            "Altéré par le contact de l’air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb23f0a-2ac0-4f15-a477-2b2155d42a9c",
                                "sense_id": "480bc9d5-a56a-3552-bfba-d93aa414d51c",
                                "text": "Ce vin est éventé."
                            }
                        ]
                    },
                    {
                        "sense_id": "16aa6c6c-4265-3f3f-af05-a74f933a481b",
                        "entry_id": "9f1711b0-2064-3d06-a852-a3a4df734dcf",
                        "glosses": [
                            "Retroussé, comme s’il prenait le vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e3a62a-73b2-44c0-b276-3364f0f11953",
                                "sense_id": "16aa6c6c-4265-3f3f-af05-a74f933a481b",
                                "text": "C’est un joli petit garçon de dix ans. Il est seul ; il lève la tête pour me voir. Ses joues rougissent, mais son petit nez éventé vous a un air fripon."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cd2ca8c-c02c-3857-b3f2-6656ec9a65e0",
                        "entry_id": "9f1711b0-2064-3d06-a852-a3a4df734dcf",
                        "glosses": [
                            "Irréfléchi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb2bc87-0889-40a2-b604-da4e213f1a9c",
                                "sense_id": "0cd2ca8c-c02c-3857-b3f2-6656ec9a65e0",
                                "text": "CAPRINI - Oui, mais questo figlio existe ; il sert même dans les gardes. - LA LÉZARDIÈRE. - C’est une jeune tête éventée…. (Mystérieusement) Il vient de déserter."
                            }
                        ]
                    },
                    {
                        "sense_id": "40bbf481-f01d-341a-9c6a-b833cd15b583",
                        "entry_id": "9f1711b0-2064-3d06-a852-a3a4df734dcf",
                        "glosses": [
                            "Révélé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae2dc917-e8c7-44ec-992e-0271fc81dde6",
                                "sense_id": "40bbf481-f01d-341a-9c6a-b833cd15b583",
                                "text": "Les tortures infligées dans les prisons secrètes de la CIA après les attentats du 11 septembre seront au cœur d’une audience mercredi à la Cour suprême des États-Unis, à qui le gouvernement américain demande de protéger un « secret d’État » pourtant largement éventé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5935ed43-9692-41ad-8908-c58ed2e74cc2",
                        "source_entry_id": "9f1711b0-2064-3d06-a852-a3a4df734dcf",
                        "target_lang_word": "windswept",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windswept",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b761e8aa-7d18-3159-b349-3568da3acf0f",
                                        "entry_id": "fde4f033-79ac-30ce-8d9a-1bde532b0534",
                                        "glosses": [
                                            "Exposed to the winds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60afb421-5739-42e2-9a03-9e2770f4ed26",
                                                "sense_id": "b761e8aa-7d18-3159-b349-3568da3acf0f",
                                                "text": "We struggled over the windswept moorland."
                                            },
                                            {
                                                "example_id": "ea9c9a42-2780-4fdc-a0a0-96f632e128b0",
                                                "sense_id": "b761e8aa-7d18-3159-b349-3568da3acf0f",
                                                "text": "A noteworthy engineering feature on this line was the Owencarrow Viaduct, situated in one of the most windswept portions of the line. On January 30, 1925, a train was blown off the viaduct during a gale, and thereafter trains were prohibited from crossing when the wind exceeded a certain velocity."
                                            },
                                            {
                                                "example_id": "fffc9a10-37f9-40f7-ab4b-efc78a45eaca",
                                                "sense_id": "b761e8aa-7d18-3159-b349-3568da3acf0f",
                                                "text": "20 January 2017, Donald Trump, Inauguration Speech\nAnd whether a child is born in the urban sprawl of Detroit or the windswept plains of Nebraska, they look up at the same night sky, they fill their heart with the same dreams, and they are infused with the breath of life by the same almighty Creator."
                                            },
                                            {
                                                "example_id": "f2347fd1-a022-40a0-ae1c-985b55547e4a",
                                                "sense_id": "b761e8aa-7d18-3159-b349-3568da3acf0f",
                                                "text": "No trees have grown on the windswept Falkland Islands in the South Atlantic Ocean for tens of thousands of years — just shrubs and other low-lying vegetation. That’s why a recent arboreal discovery nearly 20 feet (6 meters) beneath the ground caught researchers’ attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab44bcaf-be82-4879-ad58-748900a586b7",
                        "source_entry_id": "9f1711b0-2064-3d06-a852-a3a4df734dcf",
                        "target_lang_word": "zvětralý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zvětralý",
