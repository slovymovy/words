                    {
                        "sense_id": "43981d93-4715-30d8-98c5-aa6280104509",
                        "entry_id": "457abee3-7d55-3071-ae79-29e7343a1d44",
                        "glosses": [
                            "An instance of sharing or divulging too much."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e7cd1da-ed52-4f49-ae59-68d04189554b",
                                "sense_id": "43981d93-4715-30d8-98c5-aa6280104509",
                                "text": "In light-hearted cases, the response to an overshare may be the collective online “Ewwww!” and some online needling."
                            },
                            {
                                "example_id": "7e69b294-a2fd-457f-b6f9-a302a0a93344",
                                "sense_id": "43981d93-4715-30d8-98c5-aa6280104509",
                                "text": "The sore throat was because of his late night and deep connection with another woman, which he confessed to Zerrin in an honest but unsolicited overshare."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
