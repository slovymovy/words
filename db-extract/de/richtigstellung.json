                "senses": [
                    {
                        "sense_id": "616e5c98-56c9-3ced-ab2f-e35e4eeb515b",
                        "entry_id": "8f230468-65f9-39f2-a2c4-0dfbb82b37e9",
                        "glosses": [
                            "Handlung, Vorgang, etwas Falsches klarlegen, die Fehler in etwas zu entfernen oder zu klären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480d9e0c-b83d-4878-8946-3e68686db263",
                                "sense_id": "616e5c98-56c9-3ced-ab2f-e35e4eeb515b",
                                "text": "„Das wollte die Familie nicht akzeptieren, sie kämpften für die Richtigstellung des Falls.“"
                            },
                            {
                                "example_id": "1a08afd8-3465-4576-9fc9-eaceafbef45a",
                                "sense_id": "616e5c98-56c9-3ced-ab2f-e35e4eeb515b",
                                "text": "„Die Stadt sah sich am Montag zu einer Richtigstellung des «irreführenden Flugblattes» veranlasst.“"
                            },
                            {
                                "example_id": "19780067-b504-481a-bfb8-8dc32a548199",
                                "sense_id": "616e5c98-56c9-3ced-ab2f-e35e4eeb515b",
                                "text": "„Die Richtigstellungen, Korrekturen und Interpretationen, die infolge der Außerkraftsetzung dieses Kontrollmechanismus nötig waren, haben den Schaden für das Amt nicht mehr gutmachen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
