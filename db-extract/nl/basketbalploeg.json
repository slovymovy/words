                        "glosses": [
                            "groep basketballers die samen in basketbalwedstrijd spelen tegen een ander basketbalteam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74d81eb-041c-4d8a-935b-028510aee527",
                                "sense_id": "6560b596-b620-39ef-9f07-8e52f73dc1ba",
                                "text": "De Heat kon slechts beroep doen op acht spelers, het minimum aantal voor een basketbalploeg in de Amerikaanse basketbalcompetitie. Van het team was de helft geblesseerd en de andere helft was ziek (van voedselvergiftiging tot migraine)."
                            },
                            {
                                "example_id": "b82e9188-700f-47d6-a358-585b61d4dbc8",
                                "sense_id": "6560b596-b620-39ef-9f07-8e52f73dc1ba",
                                "text": "Landstede gaat wel door als naamgever van de basketbalploeg. Een reden daarvoor is de belangstelling voor volleybal bij de sportopleiding van de instelling. Op dit moment zijn maar negen volleybal-leerlingen actief en dat is te weinig voor deze sportopleiding. Bij basketbal zijn dat er nu meer, namelijk 45."
                            }
                        ]
