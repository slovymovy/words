                "senses": [
                    {
                        "sense_id": "7e59b405-c9ed-3fac-985b-726ed850dac7",
                        "entry_id": "1f719e4f-0823-3601-90b0-ec7c6928b648",
                        "glosses": [
                            "Person, die einen Tennisspieler betreut, ausbildet und auf einen Wettkampf vorbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ddad76-ef24-41df-bf9d-3ac11d0af09e",
                                "sense_id": "7e59b405-c9ed-3fac-985b-726ed850dac7",
                                "text": "Mein Cousin ist Tennistrainer."
                            },
                            {
                                "example_id": "63960ad0-b5f9-45f7-a763-0aae5f5f1ccf",
                                "sense_id": "7e59b405-c9ed-3fac-985b-726ed850dac7",
                                "text": "„Toni ist mein Tennistrainer und auch mein Coach. Sein Medium ist die Sprache, sind die Worte: Er treibt mich an, beschimpft mich, gibt mir Ratschläge, belehrt mich.“"
                            },
                            {
                                "example_id": "0426bc59-1b72-4d88-82fd-aaffe1e69d8e",
                                "sense_id": "7e59b405-c9ed-3fac-985b-726ed850dac7",
                                "text": "„Olaf Bohn, mein Tennistrainer, half mir nicht nur beim Aufschlag, sondern durch seine interessierten Fragen nach dem Stand der Dinge auch bei der Motivation zum Schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
