                        "sense_id": "4d87a1bd-71de-313e-8124-075112100eba",
                        "entry_id": "55375303-ba7a-3899-9bee-c6e63f918862",
                        "glosses": [
                            "Mitgliedsstaat der GUS (Gemeinschaft Unabhängiger Staaten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd71c51d-e5c9-4328-8b4b-63ed45306774",
                                "sense_id": "4d87a1bd-71de-313e-8124-075112100eba",
                                "text": "„Die zentralasiatischen GUS-Staaten beteiligen sich seit ihrer Unabhängigkeit an verschiedenen Regionalorganisationen.“"
                            },
                            {
                                "example_id": "47ff3f08-c8b8-4f35-a5ef-aeb97fb88d25",
                                "sense_id": "4d87a1bd-71de-313e-8124-075112100eba",
                                "text": "„Für die mittelasiatischen GUS-Staaten, in denen sich die ehemaligen kommunistischen Kader an der Macht halten konnten, war die innenpolitische Stabilität im eigenen Land oberste Prämisse; diese sahen sie durch das Einsickern militanter Islamisten aus Afghanistan gefährdet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
