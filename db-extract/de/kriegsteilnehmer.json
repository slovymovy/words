                    {
                        "sense_id": "21ab4dfb-939b-3c32-8212-2b47321673cc",
                        "entry_id": "b35a15d4-1d71-35cc-b97b-ecc9d0b0ec5b",
                        "glosses": [
                            "jemand, der als Soldat an einem Krieg teilnimmt oder teilgenommen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d73101-85bb-4563-9dca-e8de4939bcb4",
                                "sense_id": "21ab4dfb-939b-3c32-8212-2b47321673cc",
                                "text": "„Die Kriegsteilnehmer des Gymnasiums haben es besser gehabt.“"
                            },
                            {
                                "example_id": "61df6c87-afa0-4af4-849b-5902c10c4ed0",
                                "sense_id": "21ab4dfb-939b-3c32-8212-2b47321673cc",
                                "text": "„Als Soldat – und in vielen Berichten ehemaliger Kriegsteilnehmer tauchen ähnliche Empfindungen auf – findet Remarque ebenfalls Halt in der Kameradschaft mit Menschen, die wie er in einer extremen Lebenssituation stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
