                                "target_senses": [
                                    {
                                        "sense_id": "fec3edb8-926c-33ee-a4a0-59b40019a81d",
                                        "entry_id": "54dcf84d-2a45-3405-97f6-51377667814e",
                                        "glosses": [
                                            "A drooping, tapering shape of ice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dd41b8d-f5b1-4b3f-b29b-de8cf08ba282",
                                                "sense_id": "fec3edb8-926c-33ee-a4a0-59b40019a81d",
                                                "text": "Mor. Miſlike me not for my complexion, / The ſhadowed liuerie of the burniſht ſunne, / To whom I am a neighbour,and neere bred. / Bring me the faireſt creature North-ward borne, / Where Phœbus fire ſcarce thawes the yſicles, / And let vs make inciſion for your loue, / To proue whoſe blood is reddeſt,his or mine."
                                            },
                                            {
                                                "example_id": "27448f2a-9dd6-4b39-8b22-c03fefc96153",
                                                "sense_id": "fec3edb8-926c-33ee-a4a0-59b40019a81d",
                                                "text": "Several days of sub-zero temperatures caused icicles up to 1.5 metres long to form in tunnels across Greater Manchester, Lancashire and Cumbria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
