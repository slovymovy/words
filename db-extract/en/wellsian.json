                "senses": [
                    {
                        "sense_id": "161457d8-7e4b-3132-8132-4d2384e20c55",
                        "entry_id": "ac5e2d7a-20df-358f-b36c-853246e1b9ae",
                        "glosses": [
                            "An admirer of H. G. Wells (1866–1946), English writer regarded as a progenitor of science fiction, or his writings or politics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca0d5a5f-aac3-4c96-8406-e7b3b4fa297c",
                                "sense_id": "161457d8-7e4b-3132-8132-4d2384e20c55",
                                "text": "X. is one of those incorrigible Wellsians who reads all the works of the great H. G. as fast as they appear and converts himself with the most protean readiness from one thing to another—student of modern married love—devotee of war-torn England—observer of the invisible king-god—revolutionist in education—friend of Bolshevist Russia—philosophic internationalist—world historian."
                            },
                            {
                                "example_id": "32452c9d-106a-4cb2-8786-12fe9ff1ab87",
                                "sense_id": "161457d8-7e4b-3132-8132-4d2384e20c55",
                                "text": "Most Wellsians of course will be familiar with the majority of these stories."
                            },
                            {
                                "example_id": "5d2a63b5-ebe2-4a2d-885c-a49d48574d2a",
                                "sense_id": "161457d8-7e4b-3132-8132-4d2384e20c55",
                                "text": "Even though Leon Stover’s views were shared by few Wellsians and were not expressed in a way conducing to their wider acceptance, he did make a considerable contribution to Wells studies."
                            },
                            {
                                "example_id": "02f364cf-834f-44d8-8ed6-fa3ee3220f5e",
                                "sense_id": "161457d8-7e4b-3132-8132-4d2384e20c55",
                                "text": "I would also like to mention Wellsians who have particularly inspired me over the years whose memories are treasured: […]"
                            }
                        ]
                    }
                ],
