{
    "word_family": [
        "guidance",
        "guidebook",
        "guideline",
        "guider",
        "misguide",
        "unguided"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc86df04-0fe0-3344-b7a5-973dd77136a1",
                    "sense_definition": "To show the way to others by going with them or in front of them.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "directing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local villagers will <w>guide</w> us through the dense forest to the hidden waterfall.",
                            "target_lang_translations": {
                                "ru": "Местные жители <w>проведут</w> нас через густой лес к скрытому водопаду."
                            }
                        },
                        {
                            "text": "She will <w>guide</w> the <w>tour</w> through the historic castle while explaining its long history.",
                            "target_lang_translations": {
                                "ru": "Она <w>проведет</w> <w>экскурсию</w> по историческому замку, рассказывая о его многовековой истории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guide the tour",
                        "guide the way",
                        "guide through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать путь другим, идя вместе с ними или впереди них."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "указывать дорогу, идя впереди"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "сопровождать, указывая путь"
                            },
                            {
                                "target_lang_word": "сопровождать",
                                "target_lang_sense_clarification": "идти вместе для указания пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4ba5a65-c52a-36c3-abdb-2eb05ac9ae60",
                    "sense_definition": "To influence or control the behavior or development of someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents often try to <w>guide</w> their children toward making healthy and safe life choices.",
                            "target_lang_translations": {
                                "ru": "Родители часто стараются <w>направлять</w> своих детей к принятию здоровых и безопасных жизненных решений."
                            }
                        },
                        {
                            "text": "The mentor's role is to <w>guide</w> the <w>process</w> of professional growth for the new employees.",
                            "target_lang_translations": {
                                "ru": "Роль наставника заключается в том, чтобы <w>направлять</w> <w>процесс</w> профессионального роста новых сотрудников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guide the process",
                        "guide a decision",
                        "guide the development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влиять на поведение или развитие кого-либо или чего-либо или контролировать их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "давать направление развитию или поведению"
                            },
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "управлять процессом или действиями"
                            },
                            {
                                "target_lang_word": "ориентировать",
                                "target_lang_sense_clarification": "помогать выбрать правильный путь или решение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d4dadf-78a3-3351-8427-512963a1fd3a",
                    "sense_definition": "To steer or navigate a vehicle, especially a ship or aircraft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot had to <w>guide</w> the <w>ship</w> carefully through the narrow and rocky canal.",
                            "target_lang_translations": {
                                "ru": "Пилоту пришлось осторожно <w>вести</w> <w>судно</w> через узкий и скалистый канал."
                            }
                        },
                        {
                            "text": "Advanced radar systems help <w>guide</w> the aircraft safely during heavy fog or storms.",
                            "target_lang_translations": {
                                "ru": " Современные радарные системы помогают безопасно <w>вести</w> самолет во время сильного тумана или шторма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guide the ship",
                        "guide the plane",
                        "guide into port"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять движением транспортного средства, особенно корабля или самолета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "управлять судном или самолетом"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "безопасно проводить судно через сложный участок"
                            },
                            {
                                "target_lang_word": "пилотировать",
                                "target_lang_sense_clarification": "управлять летательным аппаратом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46a1e7ab-770d-3ee0-b00f-764450688f5b",
                    "sense_definition": "A person who shows the way to others, especially one employed to show tourists around.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our <w>tour</w> <w>guide</w> was very knowledgeable about the ancient ruins we visited today.",
                            "target_lang_translations": {
                                "ru": "Наш <w>экскурсовод</w> очень много знал о древних руинах, которые мы посетили сегодня."
                            }
                        },
                        {
                            "text": "The mountain <w>guide</w> ensured that everyone in the group reached the summit safely.",
                            "target_lang_translations": {
                                "ru": "Горный <w>проводник</w> позаботился о том, чтобы все участники группы благополучно добрались до вершины."
                            }
                        }
                    ],
                    "synonyms": [
                        "guider",
                        "interpreter"
                    ],
                    "common_phrases": [
                        "tour guide",
                        "mountain guide",
                        "local guide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который показывает дорогу другим, особенно тот, кто нанят для проведения экскурсий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гид",
                                "target_lang_sense_clarification": "экскурсовод для туристов"
                            },
                            {
                                "target_lang_word": "экскурсовод",
                                "target_lang_sense_clarification": "специалист по проведению экскурсий"
                            },
                            {
                                "target_lang_word": "проводник",
                                "target_lang_sense_clarification": "человек, сопровождающий в пути (например, в горах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dec958bf-2777-37fa-b735-15cd5539a01d",
                    "sense_definition": "A book, document, or app that provides information or instructions on a subject.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a <w>travel</w> <w>guide</w> to help me find the best restaurants in Paris.",
                            "target_lang_translations": {
                                "ru": "Я купил <w>путеводитель</w>, чтобы найти лучшие рестораны в Париже."
                            }
                        },
                        {
                            "text": "The instruction <w>guide</w> explains how to assemble the new furniture step by step.",
                            "target_lang_translations": {
                                "ru": "В <w>руководстве</w> по эксплуатации пошагово объясняется, как собрать новую мебель."
                            }
                        }
                    ],
                    "common_phrases": [
                        "travel guide",
                        "study guide",
                        "user guide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга, документ или приложение, содержащее информацию или инструкции по какой-либо теме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путеводитель",
                                "target_lang_sense_clarification": "книга с описанием достопримечательностей"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "инструкция или учебное пособие"
                            },
                            {
                                "target_lang_word": "справочник",
                                "target_lang_sense_clarification": "издание с полезной информацией"
                            },
                            {
                                "target_lang_word": "гайд",
                                "target_lang_sense_clarification": "современное руководство или инструкция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e213c58d-424d-3573-9602-f15732295e8a",
                    "sense_definition": "An explanatory list of symbols or terms used on a map or chart.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Check the <w>map</w> <w>guide</w> at the bottom to see what the different colors represent.",
                            "target_lang_translations": {
                                "ru": "Посмотрите на <w>легенду</w> <w>карты</w> внизу, чтобы узнать, что означают разные цвета."
                            }
                        },
                        {
                            "text": "Without a proper <w>guide</w> to the symbols, the technical chart was difficult to read.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего <w>указателя</w> символов техническую схему было трудно прочитать."
                            }
                        }
                    ],
                    "synonyms": [
                        "legend"
                    ],
                    "common_phrases": [
                        "map guide",
                        "symbol guide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пояснительный список символов или терминов, используемых на карте или схеме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "список условных обозначений на карте"
                            },
                            {
                                "target_lang_word": "указатель",
                                "target_lang_sense_clarification": "пояснение к символам или знакам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85011234-a5cf-33d0-985e-ffb2a1ff6e4c",
                    "sense_definition": "A mechanical part or device that directs the motion of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>drill</w> <w>guide</w> helps ensure that every hole is perfectly straight and centered.",
                            "target_lang_translations": {
                                "ru": "<w>Направляющая</w> для <w>сверла</w> помогает сделать каждое отверстие идеально ровным и центрированным."
                            }
                        },
                        {
                            "text": "The technician replaced the worn <w>guide</w> rail to keep the machine running smoothly.",
                            "target_lang_translations": {
                                "ru": "Техник заменил изношенную <w>направляющую</w> рейку, чтобы станок работал плавно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drill guide",
                        "guide rail",
                        "cutting guide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическая деталь или устройство, направляющее движение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направляющая",
                                "target_lang_sense_clarification": "деталь, задающая траекторию движения"
                            },
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "вспомогательное приспособление для точности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6aa47c8a-5f01-335e-a7f6-d43b74da404c",
                    "sense_definition": "A county located in the Hainan Tibetan Autonomous Prefecture, Qinghai, China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The Yellow River flows through <w>Guide</w> County, which is known for its clear water.",
                            "target_lang_translations": {
                                "ru": "Хуанхэ протекает через уезд <w>Гуйдэ</w>, который известен своей чистой водой."
                            }
                        },
                        {
                            "text": "Many tourists visit <w>Guide</w> to see the unique geological formations and local culture.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Гуйдэ</w>, чтобы увидеть уникальные геологические образования и местную культуру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Guide County"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specific to Qinghai, China"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уезд в Хайнань-Тибетском автономном округе, провинция Цинхай, Китай."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гуйдэ",
                                "target_lang_sense_clarification": "географическое название в Китае"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beaa4b22-0859-385a-adbd-03238920ffa7",
                    "sense_definition": "A village in the Blackburn with Darwen borough of Lancashire, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small village of <w>Guide</w> is situated just outside the town of Blackburn.",
                            "target_lang_translations": {
                                "ru": "Небольшая деревня <w>Гайд</w> расположена недалеко от города Блэкберн."
                            }
                        },
                        {
                            "text": "Commuters often pass through <w>Guide</w> when traveling toward the M65 motorway.",
                            "target_lang_translations": {
                                "ru": "Люди, едущие на работу, часто проезжают через <w>Гайд</w> по пути к автомагистрали M65."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specific to Lancashire, England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в районе Блэкберн-уит-Даруэн, Ланкашир, Англия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гайд",
                                "target_lang_sense_clarification": "название населенного пункта в Англии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}