                        "examples": [
                            {
                                "example_id": "031296c5-2a12-41e6-80ae-ed7989386caf",
                                "sense_id": "ed3372fc-07fc-3f8d-be4e-fd05af086214",
                                "text": "Ze praat zacht en is lief."
                            },
                            {
                                "example_id": "6a5077ce-2316-459c-960b-9d3d5b134ea2",
                                "sense_id": "ed3372fc-07fc-3f8d-be4e-fd05af086214",
                                "text": "En natuurlijk, ik weet dat wanneer ik zo op de vrolijke babbeltoer ben, mensen me snel voor leeghoofdig verslijten, maar ik praat juist veel omdat mijn hoofd vol is."
                            },
                            {
                                "example_id": "27f28580-10f6-432f-9920-cfc92b7c8266",
                                "sense_id": "ed3372fc-07fc-3f8d-be4e-fd05af086214",
                                "text": "Ik voel Hannahs zwaarte, Joy's stuurse zwijgen, Bibi's verweesdheid. En dus praat ik. Ik babbel. Ik kabbel. Ik zorg ervoor dat er een zacht stroompje tussen ons in loopt. Ik probeer het léúk te houden. Dat deed ik dus ook toen we in het hotel waren aangekomen en ik Joy op een naaistreek betrapte."
                            }
                        ]
                    }
