                            {
                                "example_id": "02c5c3fc-fa4b-420b-a04b-142dc04567cd",
                                "sense_id": "c2a5e642-0ca3-3199-b574-68911f6d520c",
                                "text": "„Es war Sorge getragen worden, ihm einen so glänzenden Empfang zu bereiten, wie er vor Zeiten gekrönten Häuptern anzugedeihen pflegte, wenn sie zu Fürsten gleichen Ranges zu Besuche kamen.“ (1812)"
                            },
                            {
                                "example_id": "71dddea6-d64e-4bad-8f22-141d8d6cb84f",
                                "sense_id": "c2a5e642-0ca3-3199-b574-68911f6d520c",
                                "text": "„Das Particip angediehen, welches einige gebrauchen, das gesuchte Privilegium ist ihm angediehen, ist in den Kanzelleyen am üblichsten.“ (1793)"
                            },
                            {
                                "example_id": "17e78673-6377-4a4b-9a96-f7a103f1f8d4",
                                "sense_id": "c2a5e642-0ca3-3199-b574-68911f6d520c",
                                "text": "Du solltest ihr jede mögliche Unterstützung angedeihen lassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
