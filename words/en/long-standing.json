                            },
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "ставший традицией"
                            },
                            {
                                "target_lang_word": "укоренившийся",
                                "target_lang_sense_clarification": "прочно вошедший в обычай"
                            }
                        ]
                    }
                }
            ]
        }
    ]
