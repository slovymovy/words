                "senses": [
                    {
                        "sense_id": "7a8f2b09-cc84-3b08-bf6f-e7471d1fe8b1",
                        "entry_id": "682928cb-f96a-30c6-b999-6b7ba8f23e52",
                        "glosses": [
                            "to eat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d3f0082-7450-4664-873f-ef02bdc49831",
                                "sense_id": "7a8f2b09-cc84-3b08-bf6f-e7471d1fe8b1",
                                "text": "Ты сожра́л весь торт?!",
                                "translation": "Have you eaten all the cake?!",
                                "english": "Have you eaten all the cake?!"
                            }
                        ]
                    },
                    {
                        "sense_id": "34051ead-cafb-336d-a580-591fac0abe46",
                        "entry_id": "682928cb-f96a-30c6-b999-6b7ba8f23e52",
                        "glosses": [
                            "to gorge, to scarf down (overeat or eat greedily, immodestly)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7274554a-07a9-466b-88f4-e0b27b31160d",
                                "sense_id": "34051ead-cafb-336d-a580-591fac0abe46",
                                "text": "Он не съел, а сожра́л.",
                                "translation": "He didn't eat—he made a pig of himself.",
                                "english": "He didn't eat—he made a pig of himself."
                            }
                        ]
                    },
                    {
                        "sense_id": "07299354-aa3f-3a8c-9553-c972e28de001",
                        "entry_id": "682928cb-f96a-30c6-b999-6b7ba8f23e52",
                        "glosses": [
                            "to sting, to bite"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "392e1b16-6423-49a2-9667-1203fb5d7919",
                                "sense_id": "07299354-aa3f-3a8c-9553-c972e28de001",
                                "text": "Комары́ сожра́ли.",
                                "translation": "Mosquitos have stung me.",
                                "english": "Mosquitos have stung me."
                            }
                        ]
                    }
                ],
