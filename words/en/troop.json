{
    "word_family": [
        "trooper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e89279a-8259-36e1-b68a-23a281346128",
                    "sense_definition": "Soldiers or armed forces, especially when considered as a large group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to withdraw <w>troops</w> from the conflict zone.",
                            "target_lang_translations": {
                                "ru": "Правительство решило вывести <w>войска</w> из зоны конфликта.",
                                "tr": "Hükümet çatışma bölgesinden <w>birlikleri</w> çekmeye karar verdi."
                            }
                        },
                        {
                            "text": "Thousands of foreign <w>troops</w> are stationed in the region to maintain peace.",
                            "target_lang_translations": {
                                "ru": "Тысячи иностранных <w>солдат</w> размещены в регионе для поддержания мира.",
                                "tr": "Barışı korumak için bölgede binlerce yabancı <w>asker</w> konuşlandırıldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "soldiers",
                        "forces",
                        "military"
                    ],
                    "antonyms": [
                        "civilians"
                    ],
                    "common_phrases": [
                        "ground troops",
                        "send in troops",
                        "withdraw troops",
                        "troop movement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдаты или вооруженные силы, особенно когда они рассматриваются как большая группа.",
                        "tr": "Askerler veya silahlı kuvvetler (özellikle büyük bir grup olarak)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "войска",
                                "target_lang_sense_clarification": "вооруженные силы (обычно во мн. ч.)"
                            },
                            {
                                "target_lang_word": "солдаты",
                                "target_lang_sense_clarification": "группа военнослужащих"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "birlikler",
                                "target_lang_sense_clarification": "askeri güçler, asker grupları"
                            },
                            {
                                "target_lang_word": "askerler",
                                "target_lang_sense_clarification": "askeri personel topluluğu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7afd9d30-6d34-3cdb-a1b8-4f0a86d171e7",
                    "sense_definition": "An individual soldier or member of a military force.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One <w>troop</w> was injured during the training exercise yesterday.",
                            "target_lang_translations": {
                                "ru": "Один <w>солдат</w> был ранен вчера во время учений.",
                                "tr": "Dünkü eğitim tatbikatı sırasında bir <w>asker</w> yaralandı."
                            }
                        },
                        {
                            "text": "The report confirmed that every <w>troop</w> on the mission returned safely.",
                            "target_lang_translations": {
                                "ru": "Отчет подтвердил, что каждый <w>боец</w> вернулся с задания целым и невредимым.",
                                "tr": "Rapor, görevdeki her <w>askerin</w> güvenli bir şekilde geri döndüğünü doğruladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "soldier",
                        "trooper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный солдат или член военного подразделения.",
                        "tr": "Bireysel bir asker veya bir askeri gücün üyesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солдат",
                                "target_lang_sense_clarification": "рядовой военнослужащий"
                            },
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "член военного отряда"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "asker",
                                "target_lang_sense_clarification": "tekil askeri personel"
                            },
                            {
                                "target_lang_word": "savaşçı",
                                "target_lang_sense_clarification": "askeri birlik üyesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1474411e-5f5e-3a5c-96cd-38d56919e67d",
                    "sense_definition": "A local unit or chapter of Boy Scouts or Girl Scouts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our scout <w>troop</w> meets every Tuesday evening at the community center.",
                            "target_lang_translations": {
                                "ru": "Наш скаутский <w>отряд</w> собирается каждый вторник вечером в общественном центре.",
                                "tr": "İzci <w>oymağımız</w> her salı akşamı toplum merkezinde toplanıyor."
                            }
                        },
                        {
                            "text": "She has been the leader of a local Girl Scout <w>troop</w> for over five years.",
                            "target_lang_translations": {
                                "ru": "Она является лидером местного <w>отряда</w> гёрлскаутов уже более пяти лет.",
                                "tr": "Beş yılı aşkın süredir yerel bir kız izci <w>birliğinin</w> liderliğini yapıyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scout troop",
                        "troop leader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Местное подразделение или отделение бойскаутов или гёрлскаутов.",
                        "tr": "İzcilerin (Boy Scouts/Girl Scouts) yerel bir birimi veya kolu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отряд",
                                "target_lang_sense_clarification": "скаутское подразделение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oymak",
                                "target_lang_sense_clarification": "izci birimi"
                            },
                            {
                                "target_lang_word": "birlik",
                                "target_lang_sense_clarification": "izci grubu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f78be254-2c69-3706-a48f-3b60a8f1213a",
                    "sense_definition": "A group of certain animals, such as monkeys or apes, living together.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>troop</w> of baboons was seen foraging near the riverbank.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> павианов была замечена кормящейся у берега реки.",
                                "tr": "Nehir kıyısının yakınında yiyecek arayan bir şebek <w>sürüsü</w> görüldü."
                            }
                        },
                        {
                            "text": "The dominant male leads the <w>troop</w> to new feeding grounds each morning.",
                            "target_lang_translations": {
                                "ru": "Доминантный самец каждое утро ведет <w>стаю</w> к новым местам кормежки.",
                                "tr": "Baskın erkek her sabah <w>sürüyü</w> yeni beslenme alanlarına götürür."
                            }
                        }
                    ],
                    "common_phrases": [
                        "troop of monkeys",
                        "baboon troop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа определенных животных, таких как обезьяны, живущих вместе.",
                        "tr": "Maymunlar gibi bir arada yaşayan belirli hayvanların oluşturduğu grup."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа животных (обезьян)"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürü",
                                "target_lang_sense_clarification": "hayvan grubu (ör. maymunlar)"
                            },
                            {
                                "target_lang_word": "grup",
                                "target_lang_sense_clarification": "bir arada yaşayan hayvan topluluğu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52d19a85-970a-3f8a-be5d-0ab59c799a18",
                    "sense_definition": "A specific subdivision of a cavalry or armoured unit, commanded by a captain.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered his <w>troop</w> to advance towards the ridge.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал своему <w>взводу</w> выдвигаться к хребту.",
                                "tr": "Kaptan, <w>bölüğüne</w> sırta doğru ilerleme emri verdi."
                            }
                        },
                        {
                            "text": "Each <w>troop</w> in the regiment is responsible for maintaining its own vehicles.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>взвод</w> в полку несет ответственность за обслуживание своей техники.",
                                "tr": "Alaydaki her <w>bölük</w> kendi araçlarının bakımından sorumludur."
                            }
                        }
                    ],
                    "synonyms": [
                        "unit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическое подразделение кавалерийской или танковой части под командованием капитана.",
                        "tr": "Süvari veya zırhlı birliklerin bir yüzbaşı tarafından komuta edilen alt birimi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взвод",
                                "target_lang_sense_clarification": "танковый или кавалерийский"
                            },
                            {
                                "target_lang_word": "отряд",
                                "target_lang_sense_clarification": "военное подразделение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölük",
                                "target_lang_sense_clarification": "süvari veya zırhlı birlik"
                            },
                            {
                                "target_lang_word": "müfreze",
                                "target_lang_sense_clarification": "küçük askeri birim"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8084416e-f5b0-3399-aa2d-0a05d745d8fc",
                    "sense_definition": "To move or walk together as a group, often in a casual or somewhat organized way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired students <w>trooped</w> out of the lecture hall after the long exam.",
                            "target_lang_translations": {
                                "ru": "Уставшие студенты <w>вышли толпой</w> из лекционного зала после долгого экзамена.",
                                "tr": "Yorgun öğrenciler uzun sınavın ardından amfiden <w>grup halinde çıktılar</w>."
                            }
                        },
                        {
                            "text": "We all <w>trooped</w> into the kitchen to see what was cooking for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы все <w>пошли гурьбой</w> на кухню, чтобы посмотреть, что готовится на ужин.",
                                "tr": "Akşam yemeğinde ne piştiğini görmek için hep birlikte mutfağa <w>doluştuk</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "march",
                        "flock",
                        "stream"
                    ],
                    "common_phrases": [
                        "troop in",
                        "troop out",
                        "troop off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или идти вместе группой, часто в непринужденной или организованной манере.",
                        "tr": "Bir grup halinde topluca veya belirli bir düzen içinde yürümek veya hareket etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти толпой",
                                "target_lang_sense_clarification": "двигаться группой"
                            },
                            {
                                "target_lang_word": "валить",
                                "target_lang_sense_clarification": "разг. идти массой"
                            },
                            {
                                "target_lang_word": "шествовать",
                                "target_lang_sense_clarification": "идти торжественно или организованно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "grup halinde yürümek",
                                "target_lang_sense_clarification": "topluca hareket etmek"
                            },
                            {
                                "target_lang_word": "akın etmek",
                                "target_lang_sense_clarification": "kalabalık halde gitmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "de51f048-bf05-3073-bf0b-181674b4b846",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Troop</w> was known in the town for his bakery.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Труп</w> был известен в городе своей пекарней.",
                                "tr": "Bay <w>Troop</w> kasabada fırınıyla tanınırdı."
                            }
                        },
                        {
                            "text": "We are looking for the records of a family named <w>Troop</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье по фамилии <w>Труп</w>.",
                                "tr": "<w>Troop</w> adında bir ailenin kayıtlarını arıyoruz."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Труп",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Troop",
                                "target_lang_sense_clarification": "soyadı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}