                                "target_senses": [
                                    {
                                        "sense_id": "c05230f4-7ba4-35b6-9074-be0528885739",
                                        "entry_id": "1ff38ea1-3c64-3e43-b039-0897586783b5",
                                        "glosses": [
                                            "Given freely; unearned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e2afb9-7853-4988-902d-84fc3c89dc1b",
                                                "sense_id": "c05230f4-7ba4-35b6-9074-be0528885739",
                                                "text": "Also mentioned is the Rev. T. Stock, who has a tablet in St John's church [Gloucester] and \"who with Raikes established the four original Sunday schools in this parish ... in 1780. From this small beginning sprung that gratuitous system of Christian instruction which has covered the face of England and Wales with schools.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bdf26e9-93ac-3864-bb95-7df4e619ed9e",
                                        "entry_id": "1ff38ea1-3c64-3e43-b039-0897586783b5",
                                        "glosses": [
                                            "Unjustified or unnecessary; not called for by the circumstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e29aaec-9fa2-4cd9-8aa0-3d8e851a3711",
                                                "sense_id": "2bdf26e9-93ac-3864-bb95-7df4e619ed9e",
                                                "text": "gratuitous violence"
                                            },
                                            {
                                                "example_id": "7e0ba770-406f-4e9f-acfc-a35d9c7f8d7d",
                                                "sense_id": "2bdf26e9-93ac-3864-bb95-7df4e619ed9e",
                                                "text": "Good to see you Mr. Bond. Things've been awfully dull 'round here. […] Now you're on this. I hope we're going to have some gratuitous sex and violence!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
