                        "cross_references": [
                            {
                                "target_word": "nitrieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1644dacb-3b61-30e7-85a2-b3afaa4133f2",
                                        "entry_id": "4b7b4cbe-5da8-39f7-994b-1e06296f473f",
                                        "glosses": [
                                            "organische Substanzen zur Produktion mit Salpetersäure behandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7491282d-18ba-4ede-a632-f33606dd53a0",
                                                "sense_id": "1644dacb-3b61-30e7-85a2-b3afaa4133f2",
                                                "text": "„Natürlich kann man aus dem Kondensationsprodukt auch das reine Diglyzerin isolieren und nitrieren; […]“"
                                            },
                                            {
                                                "example_id": "ea909305-a134-4a4e-b4b5-ab918040e4f9",
                                                "sense_id": "1644dacb-3b61-30e7-85a2-b3afaa4133f2",
                                                "text": "„Mit fortschreitender Nitrierung nimmt nämlich die Salpetersäure beständig ab, bis sie zuletzt in so geringer Menge vorhanden ist, daß sie einen Teil des Glyzerins gar nicht zu nitrieren vermag; letzterer löst sich in der Schwefelsäure auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7b352bb-2efd-33ac-ad4b-97ef7a05c137",
                                        "entry_id": "4b7b4cbe-5da8-39f7-994b-1e06296f473f",
                                        "glosses": [
                                            "Oberfläche von Stahl mit Stickstoff härten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46985de-6873-4d8c-b784-71cc85a827ad",
                                                "sense_id": "d7b352bb-2efd-33ac-ad4b-97ef7a05c137",
                                                "text": "„Es können auch gehärtete oder vergütete Werkstoffe nitriert werden.“"
                                            },
                                            {
                                                "example_id": "93c7e84a-f873-4d5a-b65d-67663a258e27",
                                                "sense_id": "d7b352bb-2efd-33ac-ad4b-97ef7a05c137",
                                                "text": "„Auch solche Werkstücke werden im Ammoniakgasstrom nitriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
