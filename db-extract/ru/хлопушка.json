                        "glosses": [
                            "кино приспособление, используемое во время киносъёмок для синхронизации изображения и звука при последующем монтаже фильма; кинохлопушка"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ea31eae6-0c97-38d6-84d3-7465a96b2141",
