                        "entry_id": "0d1ff762-2e77-34d8-8a55-0606e48fe9ab",
                        "glosses": [
                            "Not retrievable; irrecoverable; irreparable"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "774937da-489e-4615-85eb-ba801a86d3a7",
                                "sense_id": "27756349-8708-3e71-8de2-4496dc1170be",
                                "text": "an irretrievable loss"
                            },
                            {
                                "example_id": "ffb6e403-4043-43b6-bf64-a38f149e4bff",
                                "sense_id": "27756349-8708-3e71-8de2-4496dc1170be",
                                "text": "But, having hung him, you cannot unhang him. With all your liability to err, you dare to take a step, which, if wrong at all, is infinitely so, because irretrievable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
