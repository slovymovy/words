                "senses": [
                    {
                        "sense_id": "03305922-632f-3a05-9f69-a159ea75e3d3",
                        "entry_id": "fa3b7fc0-efca-3b0c-94eb-22036d8ac10b",
                        "glosses": [
                            "Relatif à Auguste Blanqui, à ses combats, à ses doctrines."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "3017feb0-ff8a-424e-a5c6-23c0d482e939",
                                "sense_id": "03305922-632f-3a05-9f69-a159ea75e3d3",
                                "text": "La méthode blanquiste."
                            },
                            {
                                "example_id": "ddbcb014-7664-44ad-8ba8-0151e9c64c36",
                                "sense_id": "03305922-632f-3a05-9f69-a159ea75e3d3",
                                "text": "Je ne suis pas venu pour larmoyer mon histoire. Depuis trois ans, j’appartiens à une section blanquiste. Les sections vont marcher !"
                            },
                            {
                                "example_id": "93f8b6a1-ef8e-488b-8827-a08836a4d8a3",
                                "sense_id": "03305922-632f-3a05-9f69-a159ea75e3d3",
                                "text": "Blanquiste et boulangiste, révolutionnaire de gauche et de droite, idéaliste et démagogue, il s’était fait le porte-voix de cent causes contradictoires."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5a8d2698-808c-36ba-8f4e-8f9e09840713",
                "word": "blanquiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7129da2f-9b80-487a-8cb0-f198332dbe52",
                        "entry_id": "5a8d2698-808c-36ba-8f4e-8f9e09840713",
