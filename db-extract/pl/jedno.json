                                "sense_id": "6d383c09-12ae-335a-94cb-07679afea9ac",
                                "text": "stanowić jedno",
                                "translation": "to comprise an entirety",
                                "english": "to comprise an entirety"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d8f1a73-640d-3fd9-a6d8-6a9c2cb2f612",
                        "entry_id": "00e18187-c0d6-3e0b-9e93-55e14e48c186",
                        "glosses": [
                            "one thing (the same thing; something that is being discussed and is being considered in relation to another object of a similar type)"
                        ],
                        "tags": [
                            "neuter",
                            "noun-from-verb"
                        ],
                        "examples": [
                            {
