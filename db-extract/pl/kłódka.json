                    {
                        "translation_id": "ec12e55f-421c-494e-8945-dac8433136eb",
                        "source_entry_id": "40bfef5f-9b7b-386a-9884-3e34eb7c201e",
                        "source_sense_id": "30bfccb5-95e9-3e19-82d5-17d036bdb971",
                        "target_lang_word": "Vorhängeschloss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorhängeschloss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b67f640-a8fa-3930-8dcb-cc07f2b41cd3",
                                        "entry_id": "c1ca45b0-95db-33c0-a8b5-137e04b8071a",
                                        "glosses": [
                                            "nicht integriertes Schloss, das einfache Verschlüsse mit einem festgestellten Bügel verschließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1843522c-d6c8-4828-93a3-59c5ae5bc79d",
                                                "sense_id": "7b67f640-a8fa-3930-8dcb-cc07f2b41cd3",
                                                "text": "Das Scheunentor war nur mit einem alten Vorhängeschloss gesichert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b85f411-fc23-441a-bd7c-472467018824",
                        "source_entry_id": "40bfef5f-9b7b-386a-9884-3e34eb7c201e",
                        "source_sense_id": "30bfccb5-95e9-3e19-82d5-17d036bdb971",
                        "target_lang_word": "Schloss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schloss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a910ce3-cd24-3e90-8631-6988d982e227",
                                        "entry_id": "1591226a-c95f-3285-b08e-a442f9bc4038",
                                        "glosses": [
                                            "an einen Zugang montierte Schließvorrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5453d08c-ba1d-4561-96ae-227c2694a777",
                                                "sense_id": "6a910ce3-cd24-3e90-8631-6988d982e227",
                                                "text": "Er hat versehentlich den Schlüssel im Schloss von außen stecken lassen."
                                            },
                                            {
                                                "example_id": "4efffcb8-2837-4d7b-b221-6a09312ce1de",
                                                "sense_id": "6a910ce3-cd24-3e90-8631-6988d982e227",
                                                "text": "„Eines der drei Schlösser an der Wohnungstür ließ sich wie immer nur öffnen, wenn Ramin die Tür mit ganzer Kraft an- und gleichzeitig hochzog.“"
                                            },
                                            {
                                                "example_id": "741fabf5-4f36-4e48-b56a-67ab21e51925",
                                                "sense_id": "6a910ce3-cd24-3e90-8631-6988d982e227",
                                                "text": "„Eine Stunde, nachdem die Terza geschlagen hatte, hörte ich das Kreischen der Schlösser.“"
                                            },
                                            {
                                                "example_id": "cbfe3dc7-dfde-44e8-add1-b59b7fbe0406",
                                                "sense_id": "6a910ce3-cd24-3e90-8631-6988d982e227",
                                                "text": "„Um den Deckel von der Truhe heben zu können, mussten alle vier Schlösser geöffnet, mithin alle vier Schlüsselverwahrer hinzugezogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "239009c1-be55-33af-ad0a-1cd4cf56b69c",
                                        "entry_id": "1591226a-c95f-3285-b08e-a442f9bc4038",
                                        "glosses": [
                                            "prunkvolles und repräsentatives Wohngebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945a8ee6-9aa6-4e15-b93e-a1ab6be92ec8",
                                                "sense_id": "239009c1-be55-33af-ad0a-1cd4cf56b69c",
                                                "text": "„Überall an den großen und kleinen Höfen, auf Schlössern, Landsitzen, Gutshöfen wird - meist in eigens dafür eingerichteten Spielsalons - tage- und nächtelang gejeut, selbst auf Muskau.“"
                                            },
                                            {
                                                "example_id": "eccb23ba-d91e-4fa0-a1fa-439ee4be9ebb",
                                                "sense_id": "239009c1-be55-33af-ad0a-1cd4cf56b69c",
                                                "text": "„Schon tauchte das Schloss vor uns auf.“"
                                            },
                                            {
                                                "example_id": "be0b5960-608b-43aa-9c63-49d44adc1342",
                                                "sense_id": "239009c1-be55-33af-ad0a-1cd4cf56b69c",
                                                "text": "„Es ist ein uns nicht mehr gewohntes Zusammenspiel von Ernst und Spaß, Maskenspiel, Schäferspiel und am Schluss ein Feuerwerk außerhalb des Schlosses.“"
                                            },
                                            {
                                                "example_id": "249ebe37-b957-4c1c-9dc0-3bba0c34da8e",
                                                "sense_id": "239009c1-be55-33af-ad0a-1cd4cf56b69c",
                                                "text": "„In Schutt und Asche lagen die Wahrzeichen der Stadt, der Dom, das Schloss, die Universität, das Opernhaus, das Kneiphöfische Rathaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d80ff705-abdb-3674-aecd-4bd693389f0a",
                                        "entry_id": "1591226a-c95f-3285-b08e-a442f9bc4038",
                                        "glosses": [
                                            "Schnappverschluss"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "adf75d8e-9530-3607-9aa8-6ab25b4cd25c",
                                        "entry_id": "1591226a-c95f-3285-b08e-a442f9bc4038",
                                        "glosses": [
                                            "Teil einer Feuerwaffe, welcher die Ladung zündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ecaa295-ac2d-42ec-9140-b8c08da6e29d",
                                                "sense_id": "adf75d8e-9530-3607-9aa8-6ab25b4cd25c",
                                                "text": "Im Schloss sitzt die Schlagfeder."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e96732e7-f3c2-3229-975b-8391def7c264",
                                        "entry_id": "1591226a-c95f-3285-b08e-a442f9bc4038",
                                        "glosses": [
                                            "zahnartige Vorsprünge an beiden Seiten der Schale einer Muschel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5bd138-2f37-46a9-940a-f23c60098296",
                                                "sense_id": "e96732e7-f3c2-3229-975b-8391def7c264",
                                                "text": "Bei dieser Muschel ist die Schale breiter als lang und am Schloss schmal."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
