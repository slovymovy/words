                "senses": [
                    {
                        "sense_id": "66fc6130-89bc-308e-95ed-1cc539d606c8",
                        "entry_id": "e77d4ebe-093b-37fa-bfdb-6686374e38b9",
                        "glosses": [
                            "Compiler du code qui sera exécutable sur une autre architecture ou un autre système d’exploitation que la machine sur laquelle est effectuée la compilation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7322cc13-43d9-483f-b903-3dbb8b195bfe",
                                "sense_id": "66fc6130-89bc-308e-95ed-1cc539d606c8",
                                "text": "En une commande, nous venons de cross-compiler mainline avec GCC version 10 pour arm64."
                            },
                            {
                                "example_id": "bb859125-627f-4140-9259-e54c0960acdb",
                                "sense_id": "66fc6130-89bc-308e-95ed-1cc539d606c8",
                                "text": "OK c’est bon j’ai trouvé l’option pour cross-compiler le module declarative."
                            },
                            {
                                "example_id": "a4621267-7edb-4be9-8aa1-67a4f2744d67",
                                "sense_id": "66fc6130-89bc-308e-95ed-1cc539d606c8",
                                "text": "Que le code soit écrit et cross-compilé sur un PC ou un MAC, on s’en fout."
                            }
                        ]
                    }
