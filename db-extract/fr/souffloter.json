                "senses": [
                    {
                        "sense_id": "a99625c1-349b-34d0-bdc7-f191d9f8c4c8",
                        "entry_id": "220cff40-abcf-328c-88db-168e1306f679",
                        "glosses": [
                            "Souffler tant bien que mal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04087c0a-6443-43c3-946c-e3ce22f9a24a",
                                "sense_id": "a99625c1-349b-34d0-bdc7-f191d9f8c4c8",
                                "text": "Victor Hugo, ce gigantesque Trompette-major fait pour sonner toutes les espèces de charges, a voulu être un Tircis littéraire et souffloter, et trembloter et chevroter dans la flûte en sureau de l'idylle, avec ces lèvres et cette poitrine qui sont de force, vous le savez ! à fendre les spirales d'airain des plus durs ophicléïdes."
                            },
                            {
                                "example_id": "4a964597-8340-4dfc-a7bf-6af4f115b81f",
                                "sense_id": "a99625c1-349b-34d0-bdc7-f191d9f8c4c8",
                                "text": "Esquivant la douche, l’étrange musicien était reparti, soufflotant cette fois l’Ave Maria."
                            }
                        ]
                    }
