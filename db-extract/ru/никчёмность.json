                "senses": [
                    {
                        "sense_id": "468982f9-4613-3ca8-a83c-a5927e378cdd",
                        "entry_id": "dafd7db5-91f8-3a64-ab14-292fe857b4d8",
                        "glosses": [
                            "свойство по значению прилагательного никчёмный"
                        ],
                        "tags": [],
