                "senses": [
                    {
                        "sense_id": "9e01bc34-fd7c-376c-bf46-b3c1dfeebe9e",
                        "entry_id": "1578957a-55aa-3b7b-bd14-c8293ff7a99a",
                        "glosses": [
                            "eine Gruppe Männer, die Männerballett tanzt"
                        ],
                        "tags": [
                            "Karneval",
                            "Fasching",
                            "Fastnacht"
                        ],
                        "examples": [
                            {
                                "example_id": "4833762b-e5e2-4258-87a1-8ad4baba3ec4",
                                "sense_id": "9e01bc34-fd7c-376c-bf46-b3c1dfeebe9e",
                                "text": "„Im März hat die Männerballettgruppe der Narrenzunft Oberkochen mit ihrem Tanz „Highschool“ an einem Contest-Wettbewerb in Dewangen teilgenommen.“"
                            },
                            {
                                "example_id": "e2c8641b-8156-404a-b60d-7f7da1f35302",
                                "sense_id": "9e01bc34-fd7c-376c-bf46-b3c1dfeebe9e",
                                "text": "„Rurichs eigene Männerballettgruppe, die „Dreemdänzer“, hatte das Turnier angeregt.“"
                            },
                            {
                                "example_id": "40ebe85c-b9ed-4427-981a-29cb7a4c628e",
                                "sense_id": "9e01bc34-fd7c-376c-bf46-b3c1dfeebe9e",
                                "text": "„Die Männerballettgruppe der Eschenbacher Faschingsgesellschaft hat heuer schon sieben Auftritte absolviert, für das 11. Oberpfälzer Männerballettturnier haben sie sich trotzdem nochmal besonders intensiv vorbereitet.“"
                            },
                            {
                                "example_id": "9deee5f8-ca14-45bb-ab68-d27b6620f1e0",
                                "sense_id": "9e01bc34-fd7c-376c-bf46-b3c1dfeebe9e",
                                "text": "„Dabei stand nicht nur die Männerballettgruppe im Mittelpunkt, sondern auch die Organisation des Vereins und der Veranstaltungen sowie die Betreuung der Mitglieder und Tänzer.“"
                            },
                            {
                                "example_id": "204e7061-550f-45dc-ba86-80537682d726",
                                "sense_id": "9e01bc34-fd7c-376c-bf46-b3c1dfeebe9e",
                                "text": "„Ihr Ehemann hat erst vor drei Jahren die \"weiße Jacke\" des Elferrates gegen die bunten Kostümierungen der Männerballettgruppe \"Die Traumtänzer\" eingetauscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
