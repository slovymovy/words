{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "19c41160-b19c-3b8e-8b78-017369fae865",
                    "sense_definition": "A negative response or refusal; a colloquial form of \"no\".",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Did you finish your homework yet? <w>Nope</w>, not yet.",
                            "target_lang_translations": {
                                "ru": "Ты уже закончил домашнюю работу? <w>Не-а</w>, еще нет.",
                                "zh": "你作业写完了吗？<w>不</w>，还没写完。"
                            }
                        },
                        {
                            "text": "<w>Nope</w>, I have never been to that restaurant before.",
                            "target_lang_translations": {
                                "ru": "<w>Не-а</w>, я никогда раньше не был в этом ресторане.",
                                "zh": "<w>不行</w>，我以前从没去过那家餐厅。"
                            }
                        }
                    ],
                    "antonyms": [
                        "yup",
                        "yep",
                        "yeah"
                    ],
                    "common_phrases": [
                        "nope sorry",
                        "just nope"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрицательный ответ или отказ; разговорная форма слова \"нет\".",
                        "zh": "一种非正式的否定回答或拒绝，相当于“不”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не-а",
                                "target_lang_sense_clarification": "разговорное, неформальное отрицание"
                            },
                            {
                                "target_lang_word": "нет",
                                "target_lang_sense_clarification": "стандартное отрицание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不",
                                "target_lang_sense_clarification": "标准否定词"
                            },
                            {
                                "target_lang_word": "不行",
                                "target_lang_sense_clarification": "表示拒绝的口语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cfd9a9f-f703-3bef-95d5-249385e7bbdc",
                    "sense_definition": "A statement of refusal or denial; an instance of saying no.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negation_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I asked him if he wanted to join us, but I got a <w>nope</w>.",
                            "target_lang_translations": {
                                "ru": "Я спросил его, хочет ли он пойти с нами, но получил <w>отказ</w>.",
                                "zh": "我问他要不要加入我们，但他<w>拒绝</w>了。"
                            }
                        },
                        {
                            "text": "Her answer was a definite <w>nope</w> to the proposal.",
                            "target_lang_translations": {
                                "ru": "Ее ответом на предложение было категорическое <w>нет</w>.",
                                "zh": "她对这个提议的回答是坚决的<w>否定</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hard nope",
                        "definite nope"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление об отказе или отрицании; случай, когда говорят \"нет\".",
                        "zh": "拒绝或否定的表示；说“不”的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказ",
                                "target_lang_sense_clarification": "действие отказа"
                            },
                            {
                                "target_lang_word": "нет",
                                "target_lang_sense_clarification": "слово \"нет\", используемое как существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拒绝",
                                "target_lang_sense_clarification": "表示不接受"
                            },
                            {
                                "target_lang_word": "否定",
                                "target_lang_sense_clarification": "表示不赞同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9026ad4e-f42b-3831-9894-6746d4d89fa9",
                    "sense_definition": "Something that causes intense repulsion, fear, or refusal, such as a scary animal or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That giant spider on the wall is a big <w>nope</w> for me.",
                            "target_lang_translations": {
                                "ru": "Этот гигантский паук на стене для меня — однозначное <w>нет</w>.",
                                "zh": "墙上那只大蜘蛛让我<w>敬谢不敏</w>。"
                            }
                        },
                        {
                            "text": "Walking into that dark, abandoned house is a total <w>nope</w>.",
                            "target_lang_translations": {
                                "ru": "Идти в этот темный заброшенный дом — <w>ни за что</w>.",
                                "zh": "走进那栋黑暗的废弃房子简直是<w>太可怕了</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "big nope",
                        "total nope"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, вызывающее сильное отвращение, страх или желание отказаться (интернет-сленг).",
                        "zh": "指代令人极度反感、恐惧或想要避开的事物（网络俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "категорическое «нет»",
                                "target_lang_sense_clarification": "выражение полного неприятия"
                            },
                            {
                                "target_lang_word": "жуть",
                                "target_lang_sense_clarification": "что-то пугающее или неприятное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敬谢不敏",
                                "target_lang_sense_clarification": "表示坚决拒绝或避开"
                            },
                            {
                                "target_lang_word": "太可怕了",
                                "target_lang_sense_clarification": "形容令人恐惧的事物"
                            }
                        ]
                    }
                },
                {
