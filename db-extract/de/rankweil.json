                "senses": [
                    {
                        "sense_id": "3b8591c1-006f-3878-b545-238fabd00b83",
                        "entry_id": "2051490a-8459-3774-8451-c6ce51c12f2d",
                        "glosses": [
                            "Marktgemeinde im österreichischen Bundesland Vorarlberg im Bezirk Feldkirch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d90375-44cc-4da7-a600-2e15fdffb3f6",
                                "sense_id": "3b8591c1-006f-3878-b545-238fabd00b83",
                                "text": "„Erklärbar ist dies teilweise dadurch, dass sich zu jener Zeit noch der Bodensee als fischreicher Süßwassersee bis nach Rankweil erstreckte und der Kummenberg dadurch tatsächlich eine Insel im See oder zumindest Küstengebiet war.“"
                            },
                            {
                                "example_id": "c6a5ff7b-41b7-4aa0-b93e-090f10220a63",
                                "sense_id": "3b8591c1-006f-3878-b545-238fabd00b83",
                                "text": "„Kriegerische Bischöfe, geharnischte Aebte und zahllose tapfere Rittergestalten entstammten diesem mächtigen Geschlechte. Sein Stammsitz war die hochgelegene Burg Alt-Montfort unweit Rankweil im heutigen Vorarlberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
