                ],
                "senses": [
                    {
                        "sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                        "entry_id": "df8b23ab-f117-32c8-bc58-82143552688a",
                        "glosses": [
                            "eine Persönlichkeit, die umfangreiche Erfahrung im Umgang mit anderen Menschen aller Nationalitäten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ee7383-f484-4a07-a0d1-74e6b352bc88",
                                "sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                                "text": "Der vollkommene Weltmann wäre der, welcher nie in Unschlüssigkeit stockte und nie in Übereilung geriete. (Arthur Schopenhauer)"
                            },
                            {
                                "example_id": "c49b176b-425d-4624-84b3-e92424cf4fd1",
                                "sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                                "text": "„Er war nur ein Weltmann, der in der Welt Erfolg gehabt hatte und dem dieser Erfolg zur Gewohnheit geworden war.“"
                            },
                            {
                                "example_id": "7402b11f-b14d-4314-91a8-a37f8fa72178",
                                "sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                                "text": "„Katell kleidete sich, wie Robert feststellte, noch immer mit der lässigen Eleganz eines Weltmannes, obwohl er stets in Geldverlegenheiten gesteckt hatte.“"
                            },
                            {
                                "example_id": "8a7eb63d-eb4d-4138-856e-4d1604d1c10d",
                                "sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                                "text": "„Er war nicht mehr der gepflegte Weltmann mit den lässigen Manieren.“"
                            },
                            {
                                "example_id": "c4557cf3-5266-46e2-a105-39f4fc354ba6",
                                "sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                                "text": "„Wielands Hippias ist ein Weltmann, wie man ihn sich nur ausmalen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cf31324-312a-4232-8a2d-084b69a4301f",
                        "source_entry_id": "df8b23ab-f117-32c8-bc58-82143552688a",
                        "source_sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                        "source_sense_description": "eine Persönlichkeit, die umfangreiche Erfahrung im Umgang mit anderen Menschen aller Nationalitäten hat",
                        "target_lang_word": "gentleman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gentleman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "Any well-bred, well-mannered, or charming man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fe4155-0455-4bb0-a364-970bdad8d815",
                                                "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed."
                                            },
                                            {
                                                "example_id": "ba7af072-f77b-4039-a3d3-80f7f6bc92f2",
                                                "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                                "text": "As a political system democracy seems to me extraordinarily foolish,[…]. My servant is, so far as I am concerned, welcome to as many votes as he can get.[…]I do not suppose that it matters much in reality whether laws are made by dukes or cornerboys, but I like, as far as possible, to associate with gentlemen in private life."
                                            },
                                            {
                                                "example_id": "be204bcc-e4dc-4b91-9841-f10c7fbd25a2",
                                                "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                                "text": "She wanted to go see a movie called Gigi, which I was not too thrilled about. But being a gentleman, I bit my tongue and said, “Okay.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d77ac7e-240c-3dec-ba00-bbd89f213451",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "Any man."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "polite",
                                            "term-of-address"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d746b18-0fb0-4422-a4e3-127eb0b7446c",
                                                "sense_id": "7d77ac7e-240c-3dec-ba00-bbd89f213451",
                                                "text": "Please escort this gentleman to the gentlemen's room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "A man of gentle but not noble birth, particularly a man of means (originally ownership of property) who does not work for a living but has no official status in a peerage; (UK law) an armigerous man ranking below a knight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187426b7-5eb6-420c-a427-5d4d8bd966d0",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "Being a gentleman, Robert was entitled to shove other commoners into the gongpit but he still had to jump out of the way of the knights to avoid the same fate himself."
                                            },
                                            {
                                                "example_id": "bd3e0582-49da-4f8f-98a0-28b91dc75a85",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "And when their ſcattered armie is ſubdu’d:\nAnd you march on their ſlaughtered carkaſſes,\nShare equally the gold that bought their liues,\nAnd liue like Gentlmen in Perſea, […]"
                                            },
                                            {
                                                "example_id": "ef3f7daa-1f14-4326-9e5b-c9703b502c43",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "But when Adam delued, and Eue ſpan,\nVVho was then a Gentleman?"
                                            },
                                            {
                                                "example_id": "e0db961e-a5b7-4647-b73c-0ae57e87c04a",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "“[…] This is Mr. Churchill, who, as you are aware, is good enough to come to us for his diaconate, and, as we hope, for much longer; and being a gentleman of independent means, he declines to take any payment.” Saying this Walden rubbed his hands together and smiled contentedly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "703d393c-f0fb-3c0a-a137-170652f82a0c",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "An effeminate or oversophisticated man."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bbf278c-d96f-451c-8d3b-ccbc58cfc646",
                                                "sense_id": "703d393c-f0fb-3c0a-a137-170652f82a0c",
                                                "text": "Well, la-di-da, aren't you just a proper gentleman?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8981621-578c-33c8-8788-2b68c3932fcb",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "An amateur or dabbler in any field, particularly those of independent means."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "historical",
                                            "sometimes",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58239d0e-27b5-4a1a-a85b-2db9085a2afa",
                                                "sense_id": "c8981621-578c-33c8-8788-2b68c3932fcb",
                                                "text": "Latrobe had extensive dealings with Jefferson, the most prominent gentleman-architect in the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f10bbf-0541-30e4-b70c-6f99476f7c69",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "An amateur player, particularly one whose wealth permits him to forego payment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "170d27eb-2c78-4664-808d-1334b91a9cff",
                        "source_entry_id": "df8b23ab-f117-32c8-bc58-82143552688a",
                        "source_sense_id": "8db268ff-5f17-352f-97f2-2d61a53b7e9e",
                        "source_sense_description": "eine Persönlichkeit, die umfangreiche Erfahrung im Umgang mit anderen Menschen aller Nationalitäten hat",
                        "target_lang_word": "man of the world",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "man of the world",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34c08e5b-6ead-37d1-8339-12c18854a486",
                                        "entry_id": "ce08f01b-22e0-3255-911a-2f2263bd92e0",
                                        "glosses": [
                                            "A worldly or sophisticated man, one well versed in the ways and dealings of humankind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f895d1ca-6876-4d42-8a71-60d1dfc596a6",
                                                "sense_id": "34c08e5b-6ead-37d1-8339-12c18854a486",
                                                "text": "I presume that there is no gentleman in Europe that has not heard of the house of Barry of Barryogue, of the kingdom of Ireland, than which a more famous name is not to be found in Gwillim or D’Hozier; and though, as a man of the world, I have learned to despise heartily the claims of some pretenders to high birth who have no more genealogy than the lacquey who cleans my boots, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
