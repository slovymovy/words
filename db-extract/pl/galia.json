                                        "entry_id": "bcd4a7a6-87ca-3dea-9a7f-608c87dee59b",
                                        "glosses": [
                                            "vernederlandste naam van de Latijnse benaming (Gallia) voor het westelijke gebied van Europa, dat overeenkomt met het moderne Frankrijk, België, het westen van Zwitserland, en delen van Nederland en Duitsland ten westen van de Rijn. Gallia is nog altijd de Griekse naam voor Frankrijk"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "833e5957-6818-49a9-bee2-0c44b976e4a0",
                        "source_entry_id": "a66253f3-5e18-318b-8628-e665976ee588",
                        "source_sense_id": "4d281d83-cd37-3f75-b808-0f924ac3fcea",
                        "target_lang_word": "Gallien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gallien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43248b57-b420-3c35-80e3-412740f22e4a",
                                        "entry_id": "c9e18b9f-66c3-393b-bc00-3bd0b7ea5b59",
                                        "glosses": [
                                            "Gebiet Westeuropas, das von jenen keltischen Volksgruppen bewohnt wurde, die die Römer als „Gallier“ bezeichneten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e509d09e-1b7a-42f2-b15b-6455566d57f9",
                                                "sense_id": "43248b57-b420-3c35-80e3-412740f22e4a",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage.“"
                                            },
                                            {
                                                "example_id": "cd891f45-d014-42ab-93f6-56b0eba39614",
                                                "sense_id": "43248b57-b420-3c35-80e3-412740f22e4a",
                                                "text": "„Hispanien und Gallien befanden sich in den Händen der Sueben, Westgoten und Franken; Nordafrika war an die Vandalen verloren gegangen.“"
                                            },
                                            {
                                                "example_id": "7601704a-67c5-4769-aba5-109bf8f8a20e",
                                                "sense_id": "43248b57-b420-3c35-80e3-412740f22e4a",
                                                "text": "„Die keltischen Stämme, die Gallien bewohnten, sind als Gallier bekannt.“"
                                            },
                                            {
                                                "example_id": "b25d8667-6627-4ed6-9f5b-b965e30acd68",
                                                "sense_id": "43248b57-b420-3c35-80e3-412740f22e4a",
                                                "text": "„Cäsar rechtfertigt sein Vorgehen in Gallien denn auch so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
