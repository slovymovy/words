    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04d589a8-7e62-3ba7-8574-115980c9f6ee",
                    "sense_definition": "het gezicht tot een grijns vertrekken, vaak als uiting van spot, plezier of boosaardigheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezichtsuitdrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat de hele tijd breed te <w>grijnzen</w> toen hij het goede nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "He was <w>grinning</w> broadly the whole time when he heard the good news."
                            }
                        },
                        {
                            "text": "De gemene schurk begon te <w>grijnzen</w> terwijl hij zijn plan uitlegde.",
                            "target_lang_translations": {
                                "en": "The mean villain started to <w>smirk</w> while he explained his plan."
                            }
                        }
                    ],
                    "synonyms": [
                        "grinniken",
                        "lachen"
                    ],
                    "antonyms": [
                        "huilen",
                        "pruilen"
                    ],
                    "common_phrases": [
                        "breed grijnzen",
                        "gemeen grijnzen",
                        "staan te grijnzen"
                    ],
                    "target_lang_definitions": {
                        "en": "to pull one's face into a grin, often as an expression of mockery, pleasure, or malice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to grin",
                                "target_lang_sense_clarification": "to smile broadly"
                            },
                            {
                                "target_lang_word": "to smirk",
                                "target_lang_sense_clarification": "to smile in a smug or conceited way"
                            },
                            {
                                "target_lang_word": "to sneer",
                                "target_lang_sense_clarification": "to smile mockingly or with contempt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13a39560-7354-3587-8c7a-b974474389d6",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>grijns</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meervoudsvormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zag verschillende <w>grijnzen</w> op de gezichten van de toeschouwers.",
                            "target_lang_translations": {
                                "en": "I saw several <w>grins</w> on the faces of the spectators."
                            }
                        },
                        {
                            "text": "Hun brede <w>grijnzen</w> verraadden dat ze een grapje hadden uitgehaald.",
                            "target_lang_translations": {
                                "en": "Their broad <w>grins</w> revealed that they had played a joke."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of grijns"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the noun 'grijns' (grin)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grins",
                                "target_lang_sense_clarification": "plural of a broad smile"
                            },
                            {
                                "target_lang_word": "smirks",
                                "target_lang_sense_clarification": "plural of smug smiles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
