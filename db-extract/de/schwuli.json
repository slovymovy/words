                            {
                                "example_id": "67838de9-04ff-4aa9-88d9-74c0cfb87031",
                                "sense_id": "2a185163-3898-3399-a07b-6d3f138b29a3",
                                "text": "Während meines Spaziergangs habe ich ein paar Schwulis gesehen."
                            },
                            {
                                "example_id": "d266962f-ab7b-4394-8c99-fb4495ac7232",
                                "sense_id": "2a185163-3898-3399-a07b-6d3f138b29a3",
                                "text": "„Meist lag sie allein in ihrem Bett und stellte sich das Gesicht von dem oder dem andern vor, nun war es immer nur das Gesicht des Schwulis Leon Brack, sie war sofort so voll im Schwung, daß Überschwang daraus wurde.“"
                            },
                            {
                                "example_id": "ba20044a-93b7-469c-8d94-51d619a6ffef",
                                "sense_id": "2a185163-3898-3399-a07b-6d3f138b29a3",
                                "text": "„Francesco erhält den Spitznamen ›Joe Pesci‹ oder ›Il Finocchietto‹ (der Schwuli).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
