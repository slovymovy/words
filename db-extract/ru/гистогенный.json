                                        "examples": [
                                            {
                                                "example_id": "3e8c2c54-9412-4c8e-b577-9bd0d65fa1d2",
                                                "sense_id": "983ac5e6-508d-355d-a1fb-cb11e4a82fd2",
                                                "text": "Die Theorie vom hämatogenen Urobilin steht sehr nahe die histogene Theorie, welche in BRULÉ noch ihren Hauptvertreter hat."
                                            },
                                            {
                                                "example_id": "015de19e-0f9a-436f-b3f6-b0e5cd6ff070",
                                                "sense_id": "983ac5e6-508d-355d-a1fb-cb11e4a82fd2",
                                                "text": "Von SALÉN und ENOCKSON wurde die histogene Theorie eingehend kritisiert und abgelehnt."
                                            },
                                            {
                                                "example_id": "18a1e50a-28e1-4704-847b-3970cdead3f3",
                                                "sense_id": "983ac5e6-508d-355d-a1fb-cb11e4a82fd2",
                                                "text": "Die histogenen Lymphocyten (lymphocytoiden Elemente) sind den hämatogenen reep. lymphatogenen eigentlichen Lymphocyten nur morphologisch und tinktoriell homolog, aber wohl nicht funktionell biologisch in ihren Schicksalen und Aufgaben äquivalent."
                                            }
