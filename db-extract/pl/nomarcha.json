                                    },
                                    {
                                        "sense_id": "cdadd4bb-225f-35ce-abb5-8803b68a0a1e",
                                        "entry_id": "5aa2e99b-6a89-3be8-8aba-f66c909a52c8",
                                        "glosses": [
                                            "The chief administrator of a modern Greek nomarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70cdd20a-7206-4aa4-ab53-2240c8801c22",
                                                "sense_id": "cdadd4bb-225f-35ce-abb5-8803b68a0a1e",
                                                "text": "The boys had made kokoretsi out of the intestines and offal of the goat they had taken from the resentful nomarch of the village, and were watching it sizzle in the cinders of the fire."
                                            }
                                        ]
                                    }
                                ]
