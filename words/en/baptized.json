            "senses": [
                {
                    "sense_id": "4aa8fde8-e452-3f8a-82b0-a459dcf200c0",
                    "sense_definition": "Having received the religious rite of baptism.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "baptism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only <w>baptized</w> members of the community were allowed to receive the sacrament.",
                            "target_lang_translations": {
                                "zh": "只有社团中<w>受过洗的</w>成员才可以领圣餐。"
                            }
                        },
                        {
                            "text": "He remained a devout <w>baptized</w> Christian throughout his entire life.",
                            "target_lang_translations": {
                                "zh": "他终其一生都是一名虔诚的、<w>已受洗的</w>基督徒。"
                            }
                        }
                    ],
