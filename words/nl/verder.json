                            }
                        },
                        {
                            "text": "Als je zo <w>verder</w> gaat, kom je er nooit op tijd.",
                            "target_lang_translations": {
                                "en": "If you go <w>on</w> like this, you will never get there on time.",
                                "ru": "Если ты так будешь продолжать <w>дальше</w>, то никогда не прибудешь вовремя.",
