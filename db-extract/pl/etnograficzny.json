                                        "sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                                        "entry_id": "45bcc21d-cbeb-385a-bbd0-fe36f8e8457c",
                                        "glosses": [
                                            "Relating to ethnography."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beb720fa-25d9-427a-aab9-b205c4fca6f2",
                                                "sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                                                "text": "Among anthropologists old ethnographic descriptions and travelbooks have a bad reputation. With the exception of ethnohistorians, anthropologists make little use of these sources for ethnographic research because of their reputed lack of reliability."
                                            }
                                        ]
                                    }
                                ]
                            }
