            {
                "entry_id": "8856ded2-29f3-356e-a7c2-538cf699269e",
                "word": "munition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51b9ef84-7f84-4c5a-bc6f-e1365c7ae611",
                        "entry_id": "8856ded2-29f3-356e-a7c2-538cf699269e",
                        "tags": [
