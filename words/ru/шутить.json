{
    "word_family": [
        "шутка",
        "шутник",
        "шутливый",
        "шуточный",
        "пошутить",
        "подшутить",
        "дошутиться",
        "отшутиться",
        "шут"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ec3a22b-522f-3494-8cdf-7f8e453b9435",
                    "sense_definition": "Говорить или делать что-либо не всерьёз, ради развлечения или чтобы ввести в заблуждение.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "humor_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я просто <w>шучу</w>, не обижайся на мои слова.",
                            "target_lang_translations": {
                                "en": "I'm just <w>kidding</w>, don't be offended by my words.",
                                "de": "Ich <w>scherze</w> nur, nimm meine Worte nicht übel."
                            }
                        },
                        {
                            "text": "Ты говоришь это серьёзно или <w>шутишь</w>?",
                            "target_lang_translations": {
                                "en": "Are you saying this seriously or <w>joking</w>?",
                                "de": "Meinst du das ernst oder <w>machst du Witze</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "дурачиться",
                        "разыгрывать"
                    ],
                    "common_phrases": [
                        "я просто шучу",
                        "ты шутишь",
                        "хватит шутить"
                    ],
                    "target_lang_definitions": {
                        "en": "To speak or act not seriously, for amusement or to mislead.",
                        "de": "Etwas nicht ernst meinen, zur Unterhaltung oder zum Spaß reden bzw. handeln."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "joke",
                                "target_lang_sense_clarification": "general sense"
                            },
                            {
                                "target_lang_word": "kid",
                                "target_lang_sense_clarification": "informal, often used in 'just kidding'"
                            },
                            {
                                "target_lang_word": "jest",
                                "target_lang_sense_clarification": "formal or archaic"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "scherzen",
                                "target_lang_sense_clarification": "etwas nicht ernst meinen"
                            },
                            {
                                "target_lang_word": "spaßen",
                                "target_lang_sense_clarification": "Spaß machen, nicht ernst reden"
                            },
                            {
                                "target_lang_word": "Witze machen",
                                "target_lang_sense_clarification": "salopp oder umgangssprachlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cde86029-1d09-3181-92c8-c9bb831d465f",
                    "sense_definition": "Весело разговаривать, произносить остроты, стараться рассмешить окружающих.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "humor_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За праздничным столом гости много смеялись и <w>шутили</w>.",
                            "target_lang_translations": {
                                "en": "At the holiday table, the guests laughed and <w>joked</w> a lot.",
                                "de": "Am Festtisch lachten und <w>scherzten</w> die Gäste viel."
                            }
                        },
                        {
                            "text": "Мой друг умеет тонко и остроумно <w>шутить</w>.",
                            "target_lang_translations": {
                                "en": "My friend knows how to <w>joke</w> subtly and wittily.",
                                "de": "Mein Freund versteht es, feinsinnig und geistreich zu <w>scherzen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "острить",
                        "острословить"
                    ],
                    "common_phrases": [
                        "любить шутить",
                        "уметь шутить",
                        "весело шутить"
                    ],
                    "target_lang_definitions": {
                        "en": "To talk cheerfully, make witty remarks, or try to make people laugh.",
                        "de": "Heiter reden, Witze erzählen und andere zum Lachen bringen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "joke",
                                "target_lang_sense_clarification": "to tell jokes"
                            },
                            {
                                "target_lang_word": "crack jokes",
                                "target_lang_sense_clarification": "idiomatic, to tell jokes frequently"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Witze reißen",
                                "target_lang_sense_clarification": "humorvolle Bemerkungen machen"
                            },
                            {
                                "target_lang_word": "scherzen",
                                "target_lang_sense_clarification": "in fröhlicher Runde witzeln"
                            },
                            {
                                "target_lang_word": "Spaß machen",
                                "target_lang_sense_clarification": "zur Belustigung beitragen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc88627-1cc8-3eaa-b89e-4237612b47e3",
                    "sense_definition": "Насмехаться, иронизировать над кем-либо или чем-либо, выставлять в смешном виде.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humor_mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит зло <w>шутить</w> над чужими ошибками.",
                            "target_lang_translations": {
                                "en": "One shouldn't maliciously <w>make fun of</w> others' mistakes.",
                                "de": "Man sollte sich nicht böse über die Fehler anderer <w>lustig machen</w>."
                            }
                        },
                        {
                            "text": "Она часто <w>шутила</w> над его странной привычкой опаздывать.",
                            "target_lang_translations": {
                                "en": "She often <w>joked</w> about his strange habit of being late.",
                                "de": "Sie <w>scherzte</w> oft über seine seltsame Angewohnheit, zu spät zu kommen."
                            }
                        }
                    ],
                    "synonyms": [
                        "подшучивать",
                        "подтрунивать",
                        "вышучивать"
                    ],
                    "common_phrases": [
                        "шутить над другом",
                        "зло шутить",
                        "шутить над собой"
                    ],
                    "target_lang_definitions": {
                        "en": "To mock or be ironic about someone or something.",
                        "de": "Sich über jemanden oder etwas lustig machen, necken oder verspotten."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make fun of",
                                "target_lang_sense_clarification": "to mock or ridicule"
                            },
                            {
                                "target_lang_word": "joke about",
                                "target_lang_sense_clarification": "to treat as a subject of humor"
                            },
                            {
                                "target_lang_word": "tease",
                                "target_lang_sense_clarification": "to provoke playfully or annoyingly"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "scherzen über",
                                "target_lang_sense_clarification": "einen Scherz auf jemandes Kosten machen"
                            },
                            {
                                "target_lang_word": "sich lustig machen über",
                                "target_lang_sense_clarification": "jemanden verspotten oder aufziehen"
                            },
                            {
                                "target_lang_word": "aufziehen",
                                "target_lang_sense_clarification": "liebevoll oder neckend verspotten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efeba16a-b8ea-31fd-b446-5d3308f8fcda",
                    "sense_definition": "Относиться к чему-либо важному или опасному легкомысленно, без должной осторожности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risk_taking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач строго сказал пациенту, что с сердцем <w>шутить</w> нельзя.",
                            "target_lang_translations": {
                                "en": "The doctor strictly told the patient that one must not <w>trifle</w> with the heart.",
                                "de": "Der Arzt sagte dem Patienten streng, dass man mit dem Herzen nicht <w>spaßen</w> darf."
                            }
                        },
                        {
                            "text": "Ты <w>шутишь</w> с огнём, когда нарушаешь эти правила безопасности.",
                            "target_lang_translations": {
                                "en": "You are <w>playing</w> with fire when you violate these safety rules.",
                                "de": "Du <w>spielst</w> mit dem Feuer, wenn du diese Sicherheitsregeln brichst."
                            }
                        }
                    ],
                    "common_phrases": [
                        "шутить с огнём",
                        "шутить со здоровьем",
                        "с этим не шутят"
                    ],
                    "target_lang_definitions": {
                        "en": "To treat something important or dangerous frivolously or without due caution.",
                        "de": "Eine ernste oder gefährliche Sache leichtfertig und unvorsichtig behandeln."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trifle with",
                                "target_lang_sense_clarification": "to treat without seriousness"
                            },
                            {
                                "target_lang_word": "play with",
                                "target_lang_sense_clarification": "used in idioms like 'play with fire'"
                            },
                            {
                                "target_lang_word": "mess with",
                                "target_lang_sense_clarification": "informal, to handle something dangerous"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "spaßen mit",
                                "target_lang_sense_clarification": "meist verneint, etwas auf die leichte Schulter nehmen"
                            },
                            {
                                "target_lang_word": "spielen mit",
                                "target_lang_sense_clarification": "ein Risiko leichtfertig eingehen (z. B. mit dem Feuer spielen)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}