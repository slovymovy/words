                                        "sense_id": "b2a9c863-cac2-3acb-8017-47434f23116b",
                                        "entry_id": "b5e23697-b33f-300b-bdf8-ba83e2541baf",
                                        "glosses": [
                                            "To stop moving, to remain motionless."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09fb6851-a830-4122-b257-227d92974ead",
                                                "sense_id": "b2a9c863-cac2-3acb-8017-47434f23116b",
                                                "text": "My legs were stiff because I'd been standing still for a long time."
                                            },
                                            {
                                                "example_id": "ec7fc78c-3da5-4e18-aa9a-ba8233f65df8",
                                                "sense_id": "b2a9c863-cac2-3acb-8017-47434f23116b",
                                                "text": "12 ¶ Then spake Ioshua to the Lord in the day when the Lord deliuered vp the Amorites before the children of Israel, and hee said in the sight of Israel, Sunne, stand thou still vpon Gibeon, and thou Moone in the valley of Aialon.\n13 And the Sunne stood still, and the Moone stayed, vntill the people had auenged themselues vpō their enemies. Is not this written in the booke of Iasher? So the Sunne stood still in the midst of heauen, and hasted not to goe downe, about a whole day."
                                            },
                                            {
                                                "example_id": "ea9c9443-c5b7-47ed-9d29-3e7ddad479cc",
                                                "sense_id": "b2a9c863-cac2-3acb-8017-47434f23116b",
                                                "text": "Time seemed to stand still as an idea came to him. He could not outrun the car behind him, but he could outdrive his opponent. And the Fiat was more nimble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c157397d-4092-3caa-9513-abec37b00a9c",
                                        "entry_id": "b5e23697-b33f-300b-bdf8-ba83e2541baf",
                                        "glosses": [
                                            "to tolerate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de1b184-b2f8-4be7-8c44-365342c84cfd",
                                                "sense_id": "c157397d-4092-3caa-9513-abec37b00a9c",
                                                "text": "Will you accept your second class status\nA nation of waitresses and waiters\nWill you mix their martinis\nWill you stand still for it\nOr will you take to the hills"
                                            }
                                        ]
