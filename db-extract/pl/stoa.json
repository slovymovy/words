                "translations": [
                    {
                        "translation_id": "16ce25bf-2946-4db7-821e-6109c1ce6a60",
                        "source_entry_id": "b8f75f3b-6366-384b-8a44-6beeb4039519",
                        "source_sense_id": "910537c0-ec41-3673-a149-e60648143f26",
                        "target_lang_word": "stoa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59ec0aeb-043f-352d-9b02-9c307ea38965",
                                        "entry_id": "7bd94a21-3f62-3467-a3fe-47e7ff2a0209",
                                        "glosses": [
                                            "In Ancient Greece, a walkway with a roof supported by colonnades, often with a wall on one side; specifically, the Great Hall in Athens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9757686-add9-47fa-93ef-e6d120a73717",
                                                "sense_id": "59ec0aeb-043f-352d-9b02-9c307ea38965",
                                                "text": "They could not vote, attend the theater, or walk in the stoa talking philosophy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12fc2a61-6efb-4053-b903-21afff780fd8",
                        "source_entry_id": "b8f75f3b-6366-384b-8a44-6beeb4039519",
                        "source_sense_id": "910537c0-ec41-3673-a149-e60648143f26",
                        "target_lang_word": "Stoa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24126dd3-1b00-360c-bff2-539f6daa1d37",
                                        "entry_id": "59cd7178-dda1-3082-9d20-6dbcdcb5a9cd",
                                        "glosses": [
                                            "die griechische Bezeichnung für eine lange, schmale Säulenhalle"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f14afe03-df41-44c8-9c5d-4d04cf2f8a17",
                                                "sense_id": "24126dd3-1b00-360c-bff2-539f6daa1d37",
                                                "text": "„In Heiligtümern wie dem Heraion von Samos diente eine Stoa zur Aufbewahrung und Ausstellung von Weihgeschenken, an der Agora als Wandelhalle und städtisches Kommunikationszentrum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b43a185-42b8-3f95-9b96-7592e94d43b0",
                                        "entry_id": "59cd7178-dda1-3082-9d20-6dbcdcb5a9cd",
                                        "glosses": [
                                            "eine weit verbreitete Strömung der altgriechischen Philosophie, die um 300 vor Christus von Zenon von Kition gegründet wurde"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feded7b1-d01d-4775-b1bc-d0bb2a22d979",
                                                "sense_id": "8b43a185-42b8-3f95-9b96-7592e94d43b0",
                                                "text": "Von Kleanthes, einem berühmten Vertreter der Älteren Stoa, stammt der Ausspruch: „In ihm leben, weben und sind wir.“, den der Apostel Paulus in Athen zitiert."
                                            },
                                            {
                                                "example_id": "070fd4c6-c067-40da-b976-bcaa7a9e8025",
                                                "sense_id": "8b43a185-42b8-3f95-9b96-7592e94d43b0",
                                                "text": "„In der Kaiserzeit war die Stoa eine Art ethischer Religion des römischen Volkes geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
