        "nl-extract.jsonl": [
            {
                "entry_id": "12ab3196-8f02-39a9-961c-dd48b5583531",
                "word": "heroïne",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8ad23c9-f757-3e28-ad32-0b8c3fcf3ec9",
                        "entry_id": "12ab3196-8f02-39a9-961c-dd48b5583531",
                        "glosses": [
                            "een zeer verslavend verdovend middel gewonnen uit gezuiverde morfine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53065d73-712e-4b88-931a-55ae9a479c38",
                                "sense_id": "c8ad23c9-f757-3e28-ad32-0b8c3fcf3ec9",
                                "text": "Hij was aan de heroïne verslaafd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0387767b-f956-4311-a246-651a012d10aa",
                        "source_entry_id": "12ab3196-8f02-39a9-961c-dd48b5583531",
                        "source_sense_id": "c8ad23c9-f757-3e28-ad32-0b8c3fcf3ec9",
                        "source_sense_description": "een verdovend middel",
                        "target_lang_word": "Heroin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heroin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13edffc2-8e7c-3683-bed3-a317b91acd78",
                                        "entry_id": "9b92098c-19e7-3507-8d95-e013b5072895",
                                        "glosses": [
                                            "Rauschgift; ein als Arzneimittel entwickeltes Morphinderivat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d64bb4fa-a3f8-4db4-a74d-25cf27543362",
                                                "sense_id": "13edffc2-8e7c-3683-bed3-a317b91acd78",
                                                "text": "Nicht nur Heroin und Cannabis sagt die Drogenbeauftragte den Kampf an, sondern auch legalen Rauschmitteln wie Zigaretten."
                                            },
                                            {
                                                "example_id": "b41143b9-be77-4940-87d4-560f2c309dc4",
                                                "sense_id": "13edffc2-8e7c-3683-bed3-a317b91acd78",
                                                "text": "„Welchen Zoll fordern weltweit alle die anderen bewußtseinsverändernden Drogen wie Kokain, Heroin, Opium und so weiter?“"
                                            },
                                            {
                                                "example_id": "423c8c5c-dd00-45c4-a4e6-86080a05f2b0",
                                                "sense_id": "13edffc2-8e7c-3683-bed3-a317b91acd78",
                                                "text": "„Wenn Drogensüchtige Heroin nehmen, besetzt das Rauschgift die Rezeptoren, die eigentlich für die körpereigenen Substanzen vorgesehen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Heroin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab9c8df-0a7d-30c7-86ab-d0ccbf6bcba7",
                                        "entry_id": "a13c69a1-2544-3160-9cde-b64aee9fd8a3",
                                        "glosses": [
                                            "Heldin"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee89a4b-8160-4afb-8aeb-1e34083a4ac7",
                                                "sense_id": "1ab9c8df-0a7d-30c7-86ab-d0ccbf6bcba7",
                                                "text": "Denn dort ist das Land des römischen Troja, dort ist die Szene der Heldenkämpfe der Äneide, und wir sehen über den Wiesenplan oder durch die Wälder die schöne Amazone Camilla jagen, die Heroin des Volskerlandes."
                                            },
                                            {
                                                "example_id": "49262912-ba1e-4fa1-8531-094992bb4b56",
                                                "sense_id": "1ab9c8df-0a7d-30c7-86ab-d0ccbf6bcba7",
                                                "text": "„Warum sollte sie, Aroma, es jenen Heroinnen nicht gleich tun?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0dd87947-2323-30c0-9b68-812943347de0",
                                        "entry_id": "a13c69a1-2544-3160-9cde-b64aee9fd8a3",
                                        "glosses": [
                                            "Heroine"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ab93da4-d3db-4c59-9420-b9ab58b1f5c2",
                        "source_entry_id": "12ab3196-8f02-39a9-961c-dd48b5583531",
                        "source_sense_id": "c8ad23c9-f757-3e28-ad32-0b8c3fcf3ec9",
                        "source_sense_description": "een verdovend middel",
                        "target_lang_word": "heroin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heroin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                        "entry_id": "c0d0b1d1-5945-356a-b253-f1fd7d87b447",
                                        "glosses": [
                                            "A powerful and addictive drug derived from opium producing intense euphoria, classed as an illegal narcotic in most of the world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "262722bc-50c8-48a6-88d2-9bca872058db",
                                                "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                                "text": "Wow, that heroin is in my blood / And the blood is in my head / Yeah, thank God that I'm good as dead / Ooohhh, thank your God that I'm not aware / And thank God that I just don't care / And I guess I just don't know"
                                            },
                                            {
                                                "example_id": "a3bb5a2f-a25b-4a70-b310-222dd61e1c69",
                                                "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                                "text": "I saw a real strange, weird object / Standing up talking to the people / And I found out it was heroin / That deadly drug that go in your veins"
                                            },
                                            {
                                                "example_id": "b6cc426d-2c6c-4cdf-813f-9f1ec2d4f49a",
                                                "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                                "text": "The reason why Jon & Kate Plus 8 is such a hot topic is because it might all be a sham. It’s been claimed that Jon has a string of mistresses, that Kate had an affair with her bodyguard and that Baby Number Six is actually a shaved Ewok with a catastrophic heroin addiction. Or something."
                                            },
                                            {
                                                "example_id": "8101a1a3-cb53-4e28-8292-abe0307a328e",
                                                "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                                "text": "Fentanyl, which looks like heroin, is a powerful synthetic painkiller that has been laced into heroin but is increasingly being sold by itself — often without the user’s knowledge."
                                            },
                                            {
                                                "example_id": "7e75ef9f-ab42-4412-adb2-c65bee3fb3fb",
                                                "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                                "text": "Yeah, it does, though, it does. Heroin works basically everywhere because it’s heroin. It’s not a cellphone. Heroin has full coverage."
                                            },
                                            {
                                                "example_id": "616e4298-0225-4241-bac9-284479d7912f",
                                                "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                                "text": "Okay, wel-, I’ll tell you where it stops: somewhere! Anytime someone asks, “Where does it stop?”, the answer is always fucking somewhere! You might let your kid have Twizzlers, but not inject black tar heroin! You d-You don’t just go, “Well, after the Twizzlers, where does it stop?”!"
                                            },
                                            {
                                                "example_id": "2bb9b0af-1ef6-4f62-ad16-de718f6fca62",
                                                "sense_id": "ff93c43c-303c-39a6-b101-c7d67203661f",
                                                "text": "That’s because the second thing to know about Games Workshop is, as Gillen says, that Warhammer was what middle-class nerds did instead of heroin. It was just as expensive, and probably no better for your social life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "heroin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84d451f8-1284-3970-990f-b2f1f12868e2",
                                        "entry_id": "c782957a-c885-3cfa-b9d6-ee1ab8ca31a5",
                                        "glosses": [
                                            "Obsolete form of heroine."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87a49ec1-9bc2-41d5-940a-4e8a050f0c9c",
                                                "sense_id": "84d451f8-1284-3970-990f-b2f1f12868e2",
                                                "text": "Strictly Orthodox, Porcia has bent her Fortune and Applications to the Advantage of the true Religion. In a word, no Perfection is feeble, or ſhines dim in Porcia; all is ſtrenuous, bright, confirm’d, and unexceptionable. She only is worthy to ſupply the Loſs of Ximena, in ſo great a Breaſt as Horatio’s, were Fortune to do what Merit has done, wou’d ſhe not make the Union? Where more juſtly cou’d we beſtow the Charms of a Heroin, who has done all things for Vertue and Honour, than in the Arms of a Hero, who has left nothing undone for Fame and Glory?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "237c01a6-b838-4cc2-a09e-43775815135a",
                        "source_entry_id": "12ab3196-8f02-39a9-961c-dd48b5583531",
                        "source_sense_id": "c8ad23c9-f757-3e28-ad32-0b8c3fcf3ec9",
                        "source_sense_description": "een verdovend middel",
                        "target_lang_word": "héroïne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "héroïne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b3316b-7b54-309e-bddf-babfc0b3a690",
                                        "entry_id": "c932b239-8a54-32fd-88d2-c285278e595c",
                                        "glosses": [
                                            "Femme courageuse qui a de l’élévation et de la noblesse dans les sentiments, dans la conduite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be12c5d-feee-4b50-9347-901b8181e166",
                                                "sense_id": "a3b3316b-7b54-309e-bddf-babfc0b3a690",
                                                "text": "C’était au lendemain du prix Goncourt. La gauche germanopratine frissonnait d’aise. Elle avait trouvé un nouveau héros. Une nouvelle héroïne, plutôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd4255b-5498-3617-b035-30b88eea3685",
                                        "entry_id": "c932b239-8a54-32fd-88d2-c285278e595c",
                                        "glosses": [
                                            "Celle dont on raconte ou dont on représente la vie, les aventures, les actions, dans un conte, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf31551-cc06-48df-a150-43ee10e24aa2",
                                                "sense_id": "dbd4255b-5498-3617-b035-30b88eea3685",
                                                "text": "Devenue en idée l’héroïne d’un roman pareil, plus d’une fois elle étudia le rôle sublime d’Eliza."
                                            },
                                            {
                                                "example_id": "59872052-8ada-4809-a592-a91a53c950bb",
                                                "sense_id": "dbd4255b-5498-3617-b035-30b88eea3685",
                                                "text": "Une heure auparavant, j’avais cru que Mauricette serait l’héroïne de mon aventure… Sa mère m’enflammait dix fois davantage."
                                            },
                                            {
                                                "example_id": "021a8fc4-f9c7-4c61-80f9-30941156b248",
                                                "sense_id": "dbd4255b-5498-3617-b035-30b88eea3685",
                                                "text": "Tout incitait donc un auteur de romans, à l’époque où Jane Austen commençait à écrire les siens, à dépeindre une héroïne à la santé fragile et à la beauté délicate."
                                            },
                                            {
                                                "example_id": "4caf3f83-ab46-4943-8571-7e9b309171bd",
                                                "sense_id": "dbd4255b-5498-3617-b035-30b88eea3685",
                                                "text": "Elle aurait pu être une héroïne durassienne déambulant, l’air mélancolique, dans la touffeur d’un penthouse tropical."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "héroïne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a744c63a-96ce-3aa1-9061-a371ff1457e0",
                                        "entry_id": "974993d2-6d9d-3384-b467-be70217caab8",
                                        "glosses": [
                                            "Drogue dure dérivée de la morphine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84bb563f-4478-4169-9c82-f1dd9ff17b4f",
                                                "sense_id": "a744c63a-96ce-3aa1-9061-a371ff1457e0",
                                                "text": "Il avait découvert l’héroïne dont il avait été surpris et séduit. Au fond, il avait cru pendant quelque temps au paradis sur la terre. Maintenant cette illusion éphémère lui faisait hausser les épaules."
                                            },
                                            {
                                                "example_id": "8ea17140-8219-408c-9ea1-454dc79f933e",
                                                "sense_id": "a744c63a-96ce-3aa1-9061-a371ff1457e0",
                                                "text": "Le second de ces personnages est un médecin marron, qui s’était fait pincer deux fois dans un trafic d’héroïne."
                                            },
                                            {
                                                "example_id": "0775fd05-0727-4a21-aafd-556cfa29c95f",
                                                "sense_id": "a744c63a-96ce-3aa1-9061-a371ff1457e0",
                                                "text": "Et Monk agit comme un déclic : le saxophoniste décroche de l’héroïne, cold turkey, comme disent les Américains, c’est-à-dire du jour au lendemain. Dinde froide."
                                            },
                                            {
                                                "example_id": "6ce3a33a-99aa-49cf-a383-b7193cbcfacb",
                                                "sense_id": "a744c63a-96ce-3aa1-9061-a371ff1457e0",
                                                "text": "Très vite, le lien entre ce que voulait dire Motörhead, ou speedfreak, c'est-à-dire quelqu'un qui carbure aux amphétamines et surtout pas aux drogues dures de type héroïne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
