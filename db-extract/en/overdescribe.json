                        "entry_id": "8995b7fd-8dc1-37dc-9398-05639c27bd60",
                        "glosses": [
                            "To provide an overly detailed description."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6bd1eb-8752-4ca2-8390-72e43dbb0614",
                                "sense_id": "05f935ec-60e8-31b1-99d0-bbe9950849bc",
                                "text": "Never overdescribe your setting. Why run the risk of boring readers?"
                            },
                            {
                                "example_id": "8eb61bdd-1bc2-47ae-83ea-3b324a5793b5",
                                "sense_id": "05f935ec-60e8-31b1-99d0-bbe9950849bc",
                                "text": "There is a third reason for misdescription: the drafter's irrepressible impulse to overdescribe."
                            },
                            {
                                "example_id": "619367b1-3981-427f-8ae8-47a593b1cdf2",
                                "sense_id": "05f935ec-60e8-31b1-99d0-bbe9950849bc",
                                "text": "We need to go through and edit our action lines; there's no need to overwrite them or overdescribe things."
                            }
                        ]
                    }
