                    {
                        "translation_id": "fbd4fec3-d6e3-4bb7-b5a3-915f31229871",
                        "source_entry_id": "863f1bf5-0c05-3ecf-9053-a3b74b2a0f59",
                        "source_sense_id": "969c3366-984c-3629-b7c2-bc39e276caed",
