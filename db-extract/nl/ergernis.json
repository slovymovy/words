                                    {
                                        "sense_id": "819e886c-5d5f-3c95-a816-a27ff78e8259",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Réaction inflammatoire locale, souvent douloureuse, affectant un tissu ou un organe exposé à un agent irritant (chimique, physique ou infectieux)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a71c8cc-9b16-44b6-9c0a-13e36b9980fe",
                                                "sense_id": "819e886c-5d5f-3c95-a816-a27ff78e8259",
                                                "text": "L’application de ce médicament sur la peau y détermine une irritation très vive. Ses nerfs sont dans une grande irritation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fe19f9c-25e1-3958-8e52-3a748c1a2058",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Action exercée par un stimulus irritant sur un tissu vivant, notamment les nerfs ou les muqueuses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66b9c0b6-69a6-31e8-b5db-a331d4392065",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Effet local, non corrosif, provoqué par un agent chimique sur un tissu vivant, se traduisant par une inflammation réversible."
                                        ],
                                        "tags": [
                                            "Toxicologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6351b78-94ba-3341-8126-99aec6f5e25f",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "État émotionnel de tension ou d’agacement, mêlé d’impatience, pouvant évoluer vers la colère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7983acf3-9aa8-45c6-b3ce-ac3f122b44c7",
                                                "sense_id": "a6351b78-94ba-3341-8126-99aec6f5e25f",
                                                "text": "Son irritation fut très vive. J’ai tâché d’adoucir son irritation. Calmer l’irritation des esprits."
                                            },
                                            {
                                                "example_id": "eaaf087a-1f17-4fe1-9fd7-92886d5527f1",
                                                "sense_id": "a6351b78-94ba-3341-8126-99aec6f5e25f",
                                                "text": "Et, peu à peu, de la douceur primordiale, un peu timide et avide de tendresse de son caractère, montaient une sourde irritation, une rancœur et une révolte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc00266-abf2-3e47-a327-0b97203fe549",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Agitation ou exaspération collective dans un contexte social ou politique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b890859-b0de-4dbc-aff6-97cba24665ed",
                                                "sense_id": "5fc00266-abf2-3e47-a327-0b97203fe549",
                                                "text": "[…]; l'assassinat de la duchesse de Praslin, par son mari, pair de France, accrurent l'irritation publique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
