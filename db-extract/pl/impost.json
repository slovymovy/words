                "senses": [
                    {
                        "sense_id": "02e435b3-4d3c-3a6d-a865-261f7c5708a3",
                        "entry_id": "2a4774df-6418-342c-a189-4bcd2ad3ed51",
                        "glosses": [
                            "kamienna płyta lub blok stanowiące podporę dla łuku, arkady lub żebra sklepienia"
                        ],
                        "tags": [],
