                                ]
                            },
                            {
                                "target_word": "homozygote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7189bb7-1785-3f0d-89db-6d00cbe8b557",
                                        "entry_id": "c7c5ebef-c81a-3512-8008-964e4af9b610",
                                        "glosses": [
                                            "Organisme ou individu dont les allèles sont identiques pour un même gène."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04691ef3-a0b8-46e4-967f-2534efa5ced3",
                                                "sense_id": "b7189bb7-1785-3f0d-89db-6d00cbe8b557",
                                                "text": "Évidemment, lorsque deux hétérozygotes se marient et donnent naissance à un homozygote (comportant deux copies anormales du gène), l'enfant est très malade."
                                            },
                                            {
                                                "example_id": "46c90970-3eea-4934-8682-f493528424eb",
                                                "sense_id": "b7189bb7-1785-3f0d-89db-6d00cbe8b557",
                                                "text": "Seuls sont malades les homozygotes dont les deux copies de HFE sont mutées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7eca696-e7d1-445c-8f08-f4d430327e04",
                        "source_entry_id": "b9551aef-5709-36bc-bbfd-d5f7020b3772",
                        "source_sense_id": "43e8f892-a13c-3d04-b71c-28b5fa6f836d",
