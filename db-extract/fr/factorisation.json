                        "entry_id": "918531f0-6326-36a8-aaa6-74c787024fd4",
                        "glosses": [
                            "Action de factoriser ou résultat de cette action. Elle consiste à écrire une expression mathématique sous la forme d'un produit de facteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13fc99dc-6299-4ee8-9df7-7dab45d3d868",
                                "sense_id": "0e19cbfc-4b18-3a87-bd07-3dc714b37bf7",
                                "text": "Une des méthodes de calcul les plus fondamentales est un algorithme de factorisation : il consiste à décomposer les nombres en produits de facteurs appartenant aux tables standard, permettant ainsi d’effectuer des extractions d’inverses et de racines carrées ou cubiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "9099f828-1b66-3e0f-b6b2-2e466481ecd7",
                        "entry_id": "918531f0-6326-36a8-aaa6-74c787024fd4",
                        "glosses": [
                            "Action de factoriser ou résultat de cette action. Rassemblement des instructions identiques dispersées dans un programme."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
