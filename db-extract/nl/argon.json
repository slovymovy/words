                    {
                        "translation_id": "b4353bd0-adfd-4e62-8809-2b75dc472a0c",
                        "source_entry_id": "4dbebea1-469d-387c-bc18-236db719a387",
                        "source_sense_id": "cf333674-83d5-3bfe-a172-429ddcc03937",
