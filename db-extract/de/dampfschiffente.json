                "senses": [
                    {
                        "sense_id": "8fa33033-21fc-391e-9679-91d93d01c7a3",
                        "entry_id": "d8482ce4-707f-3d24-8d31-66bec1890fef",
                        "glosses": [
                            "weitgehend flugunfähige oder zumindest flugunlustige Gattung der Halbgänse (Tadorninae), einer Unterfamilie der Enten, die im Süden Südamerikas vorkommen"
                        ],
                        "tags": [
                            "meistens im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3c50d2fe-8526-4f8c-8b1a-a4b418584220",
                                "sense_id": "8fa33033-21fc-391e-9679-91d93d01c7a3",
                                "text": "„Bei Gefahr versuchen sich die Dampfschiffenten tauchend zu bergen oder laufen wassertretend und flügelschlagend davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ebd1c60-b995-34c8-9d63-4c823488d49b",
                        "entry_id": "d8482ce4-707f-3d24-8d31-66bec1890fef",
                        "glosses": [
                            "speziell die Art Tachyeres pteneres, die die Küsten Südamerikas von Südchile bis Feuerland bewohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb6283e-4e09-4995-9397-0f29c81b6385",
                                "sense_id": "7ebd1c60-b995-34c8-9d63-4c823488d49b",
                                "text": "Beide Geschlechter der Dampfschiffente sind ungewöhnlich plump, dickköpfig, großfüßig und flugunfähig."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
