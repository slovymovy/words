                "senses": [
                    {
                        "sense_id": "eef093b4-d486-397c-bce3-c190653734f1",
                        "entry_id": "d21de064-cf1a-3c3d-aa39-eeee478c1dba",
                        "glosses": [
                            "Flachdruckverfahren, bei dem das Motiv von Bild oder Text auf einer entsprechend bearbeiteten Steinplatte als Druckform gestaltet ist"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "403b1675-71c3-4130-b734-0b0d98738c8e",
                                "sense_id": "eef093b4-d486-397c-bce3-c190653734f1",
                                "text": "„Knapp 50 Jahre später war die Technologie des Steindrucks so weit fortgeschritten, dass sie auch zum Druck von Briefmarken eingesetzt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
