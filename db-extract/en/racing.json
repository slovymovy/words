                                        "glosses": [
                                            "Wettkampf um die Schnelligkeit der Fortbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72536d86-5302-48f9-a17c-370bc62dbced",
                                                "sense_id": "19115d9b-ab41-3fb1-b945-5f8f468efe75",
                                                "text": "Wer wird das Rennen wohl gewinnen?"
                                            },
                                            {
                                                "example_id": "4baf6fd1-25cc-4d22-9325-fe20f279cfd1",
                                                "sense_id": "19115d9b-ab41-3fb1-b945-5f8f468efe75",
                                                "text": "„Am Morgen nach dem Rennen in Flachau sitzt Mikaela Shiffrin im Frühstücksraum des Hotels »Unterberghof«.“"
                                            },
                                            {
                                                "example_id": "bbb3bdd5-7ff4-4224-ae8b-d0b79e413aef",
                                                "sense_id": "19115d9b-ab41-3fb1-b945-5f8f468efe75",
                                                "text": "„Die Rennen wurden auf Monitoren übertragen, und man konnte wetten wie sonst auch.“"
                                            },
                                            {
                                                "example_id": "a0732933-467f-43cb-b18e-edb1491ac065",
                                                "sense_id": "19115d9b-ab41-3fb1-b945-5f8f468efe75",
                                                "text": "„Die Rennen traten nie zwischen uns, das konnten nur Menschen; doch die Rennen wichen uns lange Zeit nicht von der Seite wie eine anspruchsvolle Freundin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56f113e1-7914-3e93-ba01-f4b8adf4d1e5",
                                        "entry_id": "9ca51c88-e1b9-36ff-96fd-e4ab92ffe767",
                                        "glosses": [
                                            "schnelle Fortbewegung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ece2b75-1ecd-4a53-b359-f6fd502d2aa4",
                                                "sense_id": "56f113e1-7914-3e93-ba01-f4b8adf4d1e5",
                                                "text": "Das Rennen strengt mich noch zu sehr an."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
