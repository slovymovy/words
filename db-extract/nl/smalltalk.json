        "nl-extract.jsonl": [
            {
                "entry_id": "1c204e87-7d81-36ce-8118-092c6731866a",
                "word": "smalltalk",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7e95b57-c6e0-3721-9063-53a6f48e913d",
                        "entry_id": "1c204e87-7d81-36ce-8118-092c6731866a",
                        "glosses": [
                            "verzamelnaam voor informele gesprekken die niet gevoerd worden omwille van de inhoud, maar omwille van het gesprek zelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837b0eee-e383-4e91-aa11-9af941814958",
                                "sense_id": "c7e95b57-c6e0-3721-9063-53a6f48e913d",
                                "text": "\"Ik vind je dapper en sterk. Knap hoe je dit allemaal voor elkaar hebt gebokst.\" Ze pakt mijn hand vast, ze meent het. We zitten tegenover elkaar aan de keukentafel met een kopje koffie. Het is allesbehalve smalltalk."
                            },
                            {
                                "example_id": "5bdd5736-376b-4b66-94b5-b7c421ca7bae",
                                "sense_id": "c7e95b57-c6e0-3721-9063-53a6f48e913d",
                                "text": "We stellen haar gerust en ontvluchten haar gewiekste smalltalk met een wedervraag. Wetend dat Melody Gardot een zeer gelovige vrouw is, confronteren we haar met een duivels dilemma. Stel dat op je achttiende een engel aan je was verschenen die had gezegd: God is bereid om een grote jazz-ster van je te maken, maar eerst zul je een lijdensweg af moeten leggen, een beproeving waarvan je nooit meer helemaal zult herstellen. Hoe zou je, wetend wat je nu weet, op dat voorstel hebben gereageerd?"
                            },
                            {
                                "example_id": "11b54349-5bec-4a5c-9065-38240d5173d0",
                                "sense_id": "c7e95b57-c6e0-3721-9063-53a6f48e913d",
                                "text": "„Zijn zeker hard gegaan he, met dit weer?” Voor de beginneling op het gebied van smalltalk is het bespreken van atmosferische omstandigheden niets om je voor te schamen, las ik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "228b7f53-974b-4a29-96f0-2495dbcb88bf",
                        "source_entry_id": "1c204e87-7d81-36ce-8118-092c6731866a",
                        "source_sense_id": "c7e95b57-c6e0-3721-9063-53a6f48e913d",
                        "source_sense_description": "smalltalk",
                        "target_lang_word": "smalltalk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smalltalk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7132c85e-8d39-3710-a741-85d9c736d893",
                                        "entry_id": "f918e52f-59c0-363b-b4a4-34784347d859",
                                        "glosses": [
                                            "Alternative form of small talk."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9866df-2638-42be-9f9a-270482050cef",
                                                "sense_id": "7132c85e-8d39-3710-a741-85d9c736d893",
                                                "text": "It’s a bit difficult making smalltalk with a teacher, especially when they have to crane their neck to look up at you."
                                            },
                                            {
                                                "example_id": "cd3ebb2d-31a3-4002-9148-3b263c9679a8",
                                                "sense_id": "7132c85e-8d39-3710-a741-85d9c736d893",
                                                "text": "Hannah pictured Mark and herself sitting smiling over a stiff white tablecloth and single, interview-appropriate glasses of wine, making smalltalk and pretending everything was fine, that they were an ordinary happy couple, no stolen savings or hidden killer brothers to muddy the crystalline marital waters."
                                            },
                                            {
                                                "example_id": "54da2bf5-5064-4454-85fa-ee012fb17314",
                                                "sense_id": "7132c85e-8d39-3710-a741-85d9c736d893",
                                                "text": "“Don,” she said, and pushed the hair back from her eyes with an irritated sweep of her hand, “if the health of my toads is your idea of smalltalk while we work then I think I’d rather you just kept quiet, if it’s all the same to you.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
