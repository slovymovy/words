                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2f9dc6a1-f726-31b1-8b26-0ee172ecbe76",
                        "entry_id": "052c7d70-53bc-38bd-85e5-d62b97e9c0cc",
                        "glosses": [
                            "Visite préalable de sites pour préparer un tournage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b4a1415-38b9-4412-b1ac-08f62c360d2f",
                                "sense_id": "2f9dc6a1-f726-31b1-8b26-0ee172ecbe76",
                                "text": "Avec un bon repérage, Serris et les bâtiments Nestlé de Noisiel (Seine-et-Marne) deviennent respectivement Washington et le siège du FBI."
                            }
                        ]
                    },
