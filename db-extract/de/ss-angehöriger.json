                    {
                        "sense_id": "8f34bb22-5ab1-3860-8873-ea8949c92a62",
                        "entry_id": "d5217f74-3a68-3948-b0bb-f3f1fd021223",
                        "glosses": [
                            "Membre de la SS (organisation de l'Allemagne nazie), celui qui fait partie de la SS."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89f0cb77-b68f-4d1a-8a8e-9be6890f7e4b",
                                "sense_id": "8f34bb22-5ab1-3860-8873-ea8949c92a62",
                                "text": "Der 23jährige Hauptangeklagte Siegfried Kabus hat mit zwei 17jährigen, drei 18jährigen, drei 19jährigen und einem 57jährigen zusammen eine Organisation ehemaliger SS-Angehöriger gegründet, die den Decknamen »Odessa« führte."
                            }
                        ]
                    }
