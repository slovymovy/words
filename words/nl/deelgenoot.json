            "senses": [
                {
                    "sense_id": "49ecd8e9-b366-31a2-8630-b40a3321991d",
                    "sense_definition": "Iemand die samen met anderen deelneemt aan een onderneming, activiteit of bezit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "partner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is sinds vorig jaar een actieve <w>deelgenoot</w> in deze firma.",
                            "target_lang_translations": {
                                "en": "He has been an active <w>partner</w> in this firm since last year."
                            }
                        },
                        {
                            "text": "Als <w>deelgenoot</w> in het project deelt zij in zowel de winst als de risico's.",
                            "target_lang_translations": {
                                "en": "As a <w>participant</w> in the project, she shares in both the profits and the risks."
                            }
                        }
                    ],
                    "synonyms": [
                        "deelhebber"
                    ],
                    "common_phrases": [
                        "deelgenoot in de firma"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who participates with others in an enterprise, activity, or property."
                    },
                    "translations": {
