                        "glosses": [
                            "Personne qui a l’habitude de manger gloutonnement ou beaucoup ; goinfre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5d3e2d47-f7ba-4bcc-a591-0b46b3fb825f",
                                "sense_id": "9b0fb928-cc17-3813-b61b-7936b0c0bf61",
                                "text": "Veillant toutefois à en laisser un peu : honte à moi si je finissais totalement mon assiette, je ne veux pas qu’on pense que je suis une morfale (ah ah)."
                            },
                            {
                                "example_id": "3dc38b1e-f7bb-4028-8ace-6bacb1e2fd19",
                                "sense_id": "9b0fb928-cc17-3813-b61b-7936b0c0bf61",
                                "text": "Les morfales respectueux ont mis au point une technique infaillible : s’adapter au film."
                            }
                        ]
