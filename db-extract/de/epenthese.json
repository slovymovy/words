                        "entry_id": "637eb0d3-19e7-366a-9f1f-59eff753a4a4",
                        "glosses": [
                            "Einfügung eines Lautes im Innern eines Wortes, die etymologisch nicht begründet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1332127-0d9f-44a7-b67f-8e75105e1c49",
                                "sense_id": "0c2aab49-98a0-3fbd-b620-e52b04d9a03b",
                                "text": "Ein Beispiel für Epenthese im Deutschen ist der Einschub von [t] in Wörtern wie „eigentlich“, „flehentlich“, „wesentlich“."
                            },
                            {
                                "example_id": "607e42ec-9d94-45f5-abaa-abb4ab02bfcc",
                                "sense_id": "0c2aab49-98a0-3fbd-b620-e52b04d9a03b",
                                "text": "„In §2.3 wurde beispielsweise gezeigt, daß die Regeln für Epenthese und Assimilation genau in dieser Reihenfolge angewendet werden müssen, um die Distribution der drei regulären Pluralallomorphe des Englischen [s], [z] und [ɪz] zu erfassen.“"
                            }
                        ],
