                ],
                "senses": [
                    {
                        "sense_id": "0c6eac02-30d3-346e-b4ad-406036f51101",
                        "entry_id": "07e6211f-2e3d-3ef8-a0e1-7e47fb010c02",
                        "glosses": [
                            "существующий, происходящий между районами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34f317f-b651-49dc-9518-e90cdc0e07df",
                                "sense_id": "0c6eac02-30d3-346e-b4ad-406036f51101",
                                "text": "Связь внутривойсковой системы ВНОС осуществляется по линиям связи межрайонной и внутрирайонной сети."
                            },
                            {
                                "example_id": "013cae57-a6d5-4e5a-84fe-aed27defbd24",
                                "sense_id": "0c6eac02-30d3-346e-b4ad-406036f51101",
                                "text": "Готовились к межрайонному смотру художественной самодеятельности."
                            }
                        ]
                    },
                    {
                        "sense_id": "40609359-79e2-3203-a60d-a5e8dce2b445",
                        "entry_id": "07e6211f-2e3d-3ef8-a0e1-7e47fb010c02",
                        "glosses": [
                            "общий для нескольких районов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3abd27f-ac25-4970-946a-bd938036c25c",
                                "sense_id": "40609359-79e2-3203-a60d-a5e8dce2b445",
                                "text": "Не желая вникать в обстоятельства той загадочной истории, Поля безоговорочно принимала сторону матери, фельдшерицы в межрайонной больничке, незаметной и всеми уважаемой труженицы."
                            }
                        ]
                    }
