                "senses": [
                    {
                        "sense_id": "b13df9b6-1cb1-3e60-95a7-c542cec6ad2f",
                        "entry_id": "b60966a4-cc03-3f92-9e27-229f747f6ac5",
                        "glosses": [
                            "Gefahr eines Vulkanausbruchs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09482bba-0dd7-4021-85e8-36ecb760da87",
                                "sense_id": "b13df9b6-1cb1-3e60-95a7-c542cec6ad2f",
                                "text": "„Die Behörden hatten deshalb am Dienstag für das Vulkanrisiko die Alarmstufe Gelb ausgerufen.“"
                            },
                            {
                                "example_id": "72f408ad-fbab-4ec2-9ffc-adeeef1c71c1",
                                "sense_id": "b13df9b6-1cb1-3e60-95a7-c542cec6ad2f",
                                "text": "„Das Vulkanrisiko ist eng mit der Bewegung der tektonischen Erdplatten verbunden.“"
                            },
                            {
                                "example_id": "30d52385-24bb-4be2-b77e-1feea30aac9b",
                                "sense_id": "b13df9b6-1cb1-3e60-95a7-c542cec6ad2f",
                                "text": "„Sie gelten als Region mit dem höchsten Vulkanrisiko der Welt - die Phlegräischen Felder bei Neapel.“"
                            },
                            {
                                "example_id": "14b9d0a8-64e4-41b1-9a09-e9c7ae243550",
                                "sense_id": "b13df9b6-1cb1-3e60-95a7-c542cec6ad2f",
                                "text": "„Gäbe es z.B. in einem bestimmten Gebiet der BRD ein relevantes Vulkanrisiko, so könnte dieses nicht deshalb ignoriert werden, weil es nicht in den Störfall-Leitlinien enthalten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
