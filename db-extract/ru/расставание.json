                ],
                "senses": [
                    {
                        "sense_id": "4c156d07-6f5d-3e4e-9d8f-78f3833db98c",
                        "entry_id": "e37dafdf-2d4d-379e-9539-d61efe863308",
                        "glosses": [
                            "действие по значению гл. расставаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6accc7c-d7b9-4420-a969-3dff82a886e6",
                                "sense_id": "4c156d07-6f5d-3e4e-9d8f-78f3833db98c",
                                "text": "Словом, целая цепь причин и обстоятельств, делавших для отца расставание с Россией невозможным."
                            },
                            {
                                "example_id": "2d815754-cb5e-43ec-89e3-992c3faac317",
                                "sense_id": "4c156d07-6f5d-3e4e-9d8f-78f3833db98c",
                                "text": "Потом, при расставании, мы слышим замечательные слова в наш адрес."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a0c79dd-8623-3f24-a286-92c7d9c51779",
                        "entry_id": "e37dafdf-2d4d-379e-9539-d61efe863308",
                        "glosses": [
                            "результат такого действия; временное пребывание в разлуке, вдали друг от друга или от кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebbe6442-69d3-4145-ba13-b96b134d40e2",
                                "sense_id": "3a0c79dd-8623-3f24-a286-92c7d9c51779",
                                "text": "И расставание на пару недель, да ещё такое экстравагантное расставание, было бы весьма кстати."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cfdc86b-459f-4875-8ce6-41395334f5e0",
                        "source_entry_id": "e37dafdf-2d4d-379e-9539-d61efe863308",
                        "source_sense_description": "действие, связанное с прощанием",
                        "target_lang_word": "parting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "938bef03-f1b9-3c2f-83d8-f0d90f884ab2",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
                                        "glosses": [
                                            "The act of parting or dividing; division; separation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09c0941b-ec27-329a-97fd-e771053d4489",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
                                        "glosses": [
                                            "The state of being parted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb39de90-b1e7-4433-97cc-3981c41ba377",
                                                "sense_id": "09c0941b-ec27-329a-97fd-e771053d4489",
                                                "text": "The parting of the way."
                                            },
                                            {
                                                "example_id": "70ba9077-832d-49a7-9bad-4f9aef42dec2",
                                                "sense_id": "09c0941b-ec27-329a-97fd-e771053d4489",
                                                "text": "Bridge End is the border station and the scene of many a sad parting between enterprising shoppers and their purchases—for it is a stronghold of the Customs !—and half an hour is allowed in the timetable for examination and shunting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "789d0046-293e-37e9-9d36-8986d0db23a6",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
                                        "glosses": [
                                            "A farewell, the act of departing politely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "830f9ee9-24ad-4f18-94f2-fba78b0d97a4",
                                                "sense_id": "789d0046-293e-37e9-9d36-8986d0db23a6",
                                                "text": "And there were sudden partings,such as press / The life from out young hearts."
                                            },
                                            {
                                                "example_id": "2dac68f1-e2c6-40d8-843b-ce3cb005656e",
                                                "sense_id": "789d0046-293e-37e9-9d36-8986d0db23a6",
                                                "text": "But she hugged the soft, stuffed body of the Scarecrow in her arms instead of kissing his painted face, and found she was crying herself at this sorrowful parting from her loving comrades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ca215c-64fd-36ca-99a4-ed9fb042cac6",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
                                        "glosses": [
                                            "The dividing line formed by combing the hair in different directions."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "153dd07a-3c21-4e73-8384-26205c0fd033",
                                                "sense_id": "26ca215c-64fd-36ca-99a4-ed9fb042cac6",
                                                "text": "Margaret Thatcher’s 80s power suits were scrutinised; David Cameron’s switching of his parting was national news (Cameron later nominated his barber for an MBE); and eyebrows were raised at Theresa May’s favourite and incongruous Frida Kahlo bracelet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a171dba5-d3c2-3221-a7b4-3f777ba18f78",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
                                        "glosses": [
                                            "The surface of the sand of one section of a mould where it meets that of another section."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2061cdc-f32f-3027-8456-ae3e1f980cc9",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
                                        "glosses": [
                                            "The separation and determination of alloys; especially, the separation, as by acids, of gold from silver in the assay button."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79ae920e-3929-3daa-a501-fda02afc7776",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
                                        "glosses": [
                                            "A joint or fissure, as in a coal seam."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "794da8d8-f63c-344f-a153-c780a318f5b5",
                                        "entry_id": "ec28a250-64d9-3964-827d-8f3c0d4e0113",
