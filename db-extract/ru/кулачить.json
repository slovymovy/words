                "senses": [
                    {
                        "sense_id": "15ead872-aaca-358a-af8e-ea215236e2b9",
                        "entry_id": "5662455b-93f4-3fd9-9b41-299096286a88",
                        "glosses": [
                            "разг. раскулачивать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2bab9cc-cb9f-4aa6-ac16-de596df8b776",
                                "sense_id": "15ead872-aaca-358a-af8e-ea215236e2b9",
                                "text": "До революции они имели мельницу, семья была крепкая, работящая, «там кулачить начали», так их перетак, добрые люди вовремя подсказали продать всё и бежать из родных мест…"
                            },
                            {
                                "example_id": "a7479473-a6f4-44c7-bde4-8864029b8fa0",
                                "sense_id": "15ead872-aaca-358a-af8e-ea215236e2b9",
                                "text": "Она была из бедной семьи, и когда их раскулачивали, муж сказал своим мучителям, что она ведь из бедной семьи, её не имеют права кулачить…"
                            },
                            {
                                "example_id": "a56322ed-bbb9-46f7-bffe-02bca0694d31",
                                "sense_id": "15ead872-aaca-358a-af8e-ea215236e2b9",
                                "text": "С того дня вести отовсюду стали приходить страшные: снова начали людей кулачить да высылать целыми семьями…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b41a7b82-8175-34a1-84b2-e48d06ca1ddd",
                        "entry_id": "5662455b-93f4-3fd9-9b41-299096286a88",
                        "glosses": [
                            "разг. перен. заниматься стяжательством, накопительством"
                        ],
