                                        "glosses": [
                                            "Partie de la Gaule sous domination des Wisigoths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bf2dc8-fedb-4038-a7f2-b78c55e7442d",
                                                "sense_id": "34597a3d-4c06-3a8c-bf12-a5152e8d0185",
                                                "text": "Tant qu’il n’était pas appelé au loin par la guerre contre les Saxons, les Bretons, ou les Goths de la Septimanie, Chlother employait son temps à se promener d’un domaine à l’autre."
                                            },
                                            {
                                                "example_id": "d52f5ff3-8a2d-438c-8d50-51894e82072e",
                                                "sense_id": "34597a3d-4c06-3a8c-bf12-a5152e8d0185",
                                                "text": "Ce fut en 713 que finit ce royaume ; les Maures d’Espagne devinrent alors possesseurs de la Septimanie."
                                            }
