                            "target_lang_translations": {
                                "en": "The minimum <w>contribution</w> for this new investment fund is one thousand euros per person."
                            }
                        },
                        {
                            "text": "Bij het pokerspel was de <w>inleg</w> slechts vijf euro per ronde.",
                            "target_lang_translations": {
                                "en": "In the poker game, the <w>stake</w> was only five euros per round."
                            }
