                        "source_entry_id": "e87d5fe5-a0aa-303b-aed8-61d2aabc3e5e",
                        "target_lang_word": "ache",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ache",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ace75484-7702-3608-8619-3629f06a75ec",
                                        "entry_id": "22ae16b9-d4f9-3ada-bdf6-ca2b794b8a51",
                                        "glosses": [
                                            "To suffer pain; to be the source of, or be in, pain, especially continued dull pain; to be distressed."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52f1f960-2259-4ec2-8242-195bd01146c5",
                                                "sense_id": "ace75484-7702-3608-8619-3629f06a75ec",
                                                "text": "My feet were aching for days after the marathon."
                                            },
                                            {
                                                "example_id": "20bf1d46-9492-4fe1-a712-3ab0fc959dc5",
                                                "sense_id": "ace75484-7702-3608-8619-3629f06a75ec",
                                                "text": "Every muscle in his body ached."
                                            },
                                            {
                                                "example_id": "a03d4870-0750-43d5-a22e-1f873798d1b6",
                                                "sense_id": "ace75484-7702-3608-8619-3629f06a75ec",
                                                "text": "By'r lakin, I can goe no further, Sir, / My old bones akes:^([sic]) here's a maze trod indeede / Through fourth rights, & Meanders: / by your patience, I needes muſt reſt me."
                                            },
                                            {
                                                "example_id": "85bef654-6982-4a61-a577-c62d4a4991a3",
                                                "sense_id": "ace75484-7702-3608-8619-3629f06a75ec",
                                                "text": "And that thing made of ſound and ſhovv / VVhich mortals have miſnamed A Beau, / (But in the language of the ſky / Is call'd a tvvolegg'd butterfly) / VVill make your very heartſtrings ake / VVith loud and everlaſting clack, […]"
                                            },
                                            {
                                                "example_id": "c595442f-4e52-40e2-9a7d-832cb83ef8c8",
                                                "sense_id": "ace75484-7702-3608-8619-3629f06a75ec",
                                                "text": "The turmoil went on—no rest, no peace. […] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ab4959-db26-322c-aabb-288ef9948212",
                                        "entry_id": "22ae16b9-d4f9-3ada-bdf6-ca2b794b8a51",
                                        "glosses": [
                                            "To cause someone or something to suffer pain."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ache",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b252629d-5e8c-3682-b1f6-a832a04a0655",
                                        "entry_id": "79ef36ce-0bba-3789-b6da-d69b2d221726",
                                        "glosses": [
                                            "Continued dull pain, as distinguished from sudden twinges, or spasmodic pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "597fde27-5bed-49a4-842b-4f3c46e9d922",
                                                "sense_id": "b252629d-5e8c-3682-b1f6-a832a04a0655",
                                                "text": "You may suffer a minor ache in your side."
                                            },
                                            {
                                                "example_id": "3e336df1-507a-4e1f-a895-23d06f51c2a2",
                                                "sense_id": "b252629d-5e8c-3682-b1f6-a832a04a0655",
                                                "text": "The aches and pains died down after taking an analgesic."
                                            },
                                            {
                                                "example_id": "44dae52a-6728-46a0-81c9-718a087334bc",
                                                "sense_id": "b252629d-5e8c-3682-b1f6-a832a04a0655",
                                                "text": "Fill all thy bones with aches."
                                            }
                                        ]
                                    }
