                        "entry_id": "8dcde5fa-f512-37c2-886a-164a68bcbf9a",
                        "glosses": [
                            "für Postsendungen fällig werdende Kosten, bei denen Sender und Adressat in verschiedenen Ländern leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2035019b-4ba3-4d9e-b96a-9108ad44847f",
                                "sense_id": "8edd892f-d01a-3520-b745-1a41b88001e2",
                                "text": "„Das Auslandsporto für einen Brief sollte im Ausland an das Schicksal der Kriegsgefangenen erinnern.“"
                            },
                            {
                                "example_id": "f6621e74-d8e5-43b8-b8b7-69ef442af722",
                                "sense_id": "8edd892f-d01a-3520-b745-1a41b88001e2",
                                "text": "„Das Auslandsporto war verhältnismäßig hoch und ich brauchte sowieso viel zuviel Geld.“"
                            },
                            {
                                "example_id": "2bef0747-2719-4cd4-a46b-a8a6fd10aa13",
                                "sense_id": "8edd892f-d01a-3520-b745-1a41b88001e2",
                                "text": "„Für Briefe und Postkarten in die Bundesrepublik und nach West-Berlin berechnet die DDR fortan Auslandsporto.“"
                            },
                            {
                                "example_id": "90a68b7d-4933-4c8a-8dbd-f01b9b09b44c",
                                "sense_id": "8edd892f-d01a-3520-b745-1a41b88001e2",
                                "text": "„Bitte zu beachten, dass Briefe nach Frankreich mit dem Auslandsporto frankiert werden müssen.“"
                            }
                        ],
