        "fr-extract.jsonl": [
            {
                "entry_id": "156669b4-82e4-3ef3-ad68-44e33299c456",
                "word": "philatélie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ca0749a-89f8-40d4-aecb-39719794959d",
                        "entry_id": "156669b4-82e4-3ef3-ad68-44e33299c456",
                        "tags": [
