                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6e1f345-6635-4a85-bc2b-39165deac3ab",
                        "source_entry_id": "c121b2ee-c47f-3605-a3b7-1bc5695a107b",
                        "source_sense_id": "8386e4a8-5eef-39f7-a4a3-a265eaa098a5",
                        "target_lang_word": "Glossar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glossar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                        "entry_id": "853700da-4a1a-3efc-83d8-8fbe6b1cdb2a",
                                        "glosses": [
                                            "Liste von Fach- oder anderen nicht geläufigen Wörtern mit Erklärung (traditionell als Anhang in einem Buch, heute auch im Internet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a71261-8e01-4494-abe3-3f00bc82a4ce",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "Das Nützlichste an diesem Buch ist sein umfangreiches Glossar."
                                            },
                                            {
                                                "example_id": "f748b3a3-41b3-42cf-a4f0-99958ce03d56",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Der Abrogans, das älteste lateinisch-deutsche Glossar (…), bietet zu jedem Element eines lateinischen Synonymenpaars je ein althochdeutsches Äquivalent.“"
                                            },
                                            {
                                                "example_id": "f4281d8b-8f23-4421-a4ca-f020874173cc",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Abgerundet wird dieses Werk durch ein Glossar, in dem die Wurzeln der geografischen Namen (aus zahlreichen Sprachen) in kurzer Zusammenschau erklärt werden.“"
                                            },
                                            {
                                                "example_id": "ed4c7ca5-7c0f-45c5-8f11-646674c6c989",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Aber ich habe etliche dieser Begriffe separat im Anschluß an das Glossar aufgezählt.“"
                                            },
                                            {
                                                "example_id": "9d7e6326-a975-4eeb-86db-e3d394d2f27e",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Diese Arbeitsweise trägt der Tatsache Rechnung, dass das Glossar Teil eines sich ständig verändernden Diskurses ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "493d200b-9907-4880-a253-ec80b07a3c19",
                        "source_entry_id": "c121b2ee-c47f-3605-a3b7-1bc5695a107b",
                        "source_sense_id": "8386e4a8-5eef-39f7-a4a3-a265eaa098a5",
                        "target_lang_word": "глоссарий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глоссарий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "35165491-a72d-3137-8b73-0833b74b47f8",
                                        "entry_id": "ae563c20-b8b6-39db-ac44-09a412c7ab44",
                                        "glosses": [
                                            "лингв. словарь с толкованием, иногда переводом на другой язык устарелых и малопонятных слов и выражений (обычно — составленный к тексту какого-либо произведения или к целому циклу произведений)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca137189-e434-4349-b55e-0ece66d6ea20",
                                                "sense_id": "35165491-a72d-3137-8b73-0833b74b47f8",
                                                "text": "Малопонятные или редкие слова снабжались глоссами (переводом или пояснениями), которые либо вносились прямо в текст книги (межстрочные и маргинальные глоссы), либо объединялись в отдельные словари, глоссарии. Первые латинско-древнеанглийские глоссы датируются 730 г. (Эпинальские глоссы); этот глоссарий содержит более тысячи латинских слов с переводом."
                                            },
                                            {
                                                "example_id": "fa2c3795-b622-40d6-9cc3-5819b632b493",
                                                "sense_id": "35165491-a72d-3137-8b73-0833b74b47f8",
                                                "text": "Древнейшие глоссарии к Гомеру относятся к V в. до н.э., т.е. к самому началу древнегреческой комментаторской традиции."
                                            },
                                            {
                                                "example_id": "79878604-16ca-4a00-985c-aac2d9d454db",
                                                "sense_id": "35165491-a72d-3137-8b73-0833b74b47f8",
                                                "text": "Труднейший, многослойный информативный и аналитический текст умело изложен в энциклопедическом жанре, предназначенном для самого широкого круга читателей. С этой целью составлен глоссарий древнееврейских и талмудических терминов, в ходе повествования даются подробные пояснительные комментарии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "073157f3-f382-3236-947a-3cd5ba3ffaf1",
                                        "entry_id": "ae563c20-b8b6-39db-ac44-09a412c7ab44",
                                        "glosses": [
                                            "юр. собрание, свод толкований законов и юридических актов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ebf194d-8bef-42b1-84d8-94dec43f2e48",
                                                "sense_id": "073157f3-f382-3236-947a-3cd5ba3ffaf1",
                                                "text": "Наряду с «варварскими Правдами» и церковным судом с XIII в. начинается обращение к традициям римского права. Его идеи входят в правовую культуру средневековой Европы, главным образом, из византийского Свода законов Юстиниана. Европейские ученые-юристы пишут обширные комментарии к нему (самый известный из них — глоссарий Аккурция — насчитывает почти 100 тысяч пояснений и примечаний)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
