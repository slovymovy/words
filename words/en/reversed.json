    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6f2c1dd-f528-3244-860f-161e5e3cea1d",
                    "sense_definition": "Simple past and past participle of <w>reverse</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>reversed</w> the car carefully into the narrow parking spot.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>сдал назад</w> на машине на узкое парковочное место.",
                                "zh": "他小心地把车<w>倒</w>进了狭窄的停车位。"
                            }
                        },
                        {
                            "text": "The court <w>reversed</w> the decision after reviewing the new evidence presented by the defense.",
                            "target_lang_translations": {
                                "ru": "Суд <w>отменил</w> решение после рассмотрения новых доказательств, представленных защитой.",
                                "zh": "法院在审查了辩方提交的新证据后，<w>撤销</w>了原判。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reversed the decision",
                        "reversed the car",
                        "reversed course"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>reverse</w>.",
                        "zh": "动词 reverse 的过去式和过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдать назад",
                                "target_lang_sense_clarification": "о транспортном средстве"
                            },
                            {
                                "target_lang_word": "отменить",
                                "target_lang_sense_clarification": "о решении или постановлении"
                            },
                            {
                                "target_lang_word": "развернуть",
                                "target_lang_sense_clarification": "изменить направление на противоположное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒车",
                                "target_lang_sense_clarification": "指车辆向后行驶"
                            },
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "指取消或推翻之前的决定"
                            },
                            {
                                "target_lang_word": "反转",
                                "target_lang_sense_clarification": "指改变方向或状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "602fa3b6-17f9-3a8d-a257-a8ebc2982622",
                    "sense_definition": "Turned the other way round, inside out, or to an opposite position or state.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reversed</w> image in the mirror made the text impossible to read.",
                            "target_lang_translations": {
                                "ru": "<w>Перевёрнутое</w> изображение в зеркале делало текст невозможным для чтения.",
                                "zh": "镜子里<w>颠倒的</w>影像让文字变得无法辨认。"
                            }
                        },
                        {
                            "text": "They found themselves in <w>reversed</w> roles, with the student now teaching the master.",
                            "target_lang_translations": {
                                "ru": "Они оказались в <w>обратных</w> ролях: ученик теперь учил мастера.",
                                "zh": "他们发现自己的角色<w>互换</w>了，现在由学生教老师。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inverted",
                        "backward",
                        "opposite"
                    ],
                    "antonyms": [
                        "forward",
                        "upright"
                    ],
                    "common_phrases": [
                        "reversed roles",
                        "reversed image",
                        "reversed order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повёрнутый в другую сторону, вывернутый наизнанку или находящийся в противоположном положении.",
                        "zh": "指方向、位置或状态被颠倒或处于相反的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевёрнутый",
                                "target_lang_sense_clarification": "физически или метафорически"
                            },
                            {
                                "target_lang_word": "обратный",
                                "target_lang_sense_clarification": "противоположный по порядку или направлению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颠倒的",
                                "target_lang_sense_clarification": "指物理位置或顺序的翻转"
                            },
                            {
                                "target_lang_word": "相反的",
                                "target_lang_sense_clarification": "指性质或方向的对立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "109eb017-e5a1-36bf-a0ac-db0f8b54ad3f",
                    "sense_definition": "Inverted or appearing upside down, particularly regarding the position of leaves or flowers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist identified the species by its <w>reversed</w> flowers, which twist during development.",
                            "target_lang_translations": {
                                "ru": "Ботаник определил вид по его <w>перевёрнутым</w> цветкам, которые скручиваются во время развития.",
                                "zh": "植物学家通过其<w>倒生</w>的花朵辨认出了该物种，这些花在发育过程中会发生扭转。"
                            }
                        },
                        {
                            "text": "This plant is unique because of the <w>reversed</w> orientation of its leaves on the stem.",
                            "target_lang_translations": {
                                "ru": "Это растение уникально из-за <w>обратного</w> расположения листьев на стебле.",
                                "zh": "这种植物的独特之处在于其茎上叶片的<w>倒生</w>排列。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resupinate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инвертированный или перевёрнутый (особенно касательно положения листьев или цветов).",
                        "zh": "指植物器官（如叶片或花朵）呈现出倒置或反转的生长状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевёрнутый",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒生的",
                                "target_lang_sense_clarification": "植物学中指叶片或花朵位置反转"
                            }
                        ]
                    }
                }
            ]
        }
    ]
