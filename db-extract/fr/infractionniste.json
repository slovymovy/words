                        "glosses": [
                            "Qui commet une infraction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac5656f-46c0-4cdc-873c-18bd1cf1035c",
                                "sense_id": "78eea08f-1f63-3db1-b0dc-c88038335c7d",
                                "text": "Le permis à points responsabilise les conducteurs et sanctionne le comportement des conducteurs infractionnistes qui ne respectent pas les règles du Code de la Route."
                            },
                            {
                                "example_id": "300d2497-34df-4988-93fc-db2bae58727c",
                                "sense_id": "78eea08f-1f63-3db1-b0dc-c88038335c7d",
                                "text": "Les auteurs présumés d’accident mortel ont des comportements plus infractionnistes que la moyenne des conducteurs français. Ainsi, près de la moitié des auteurs présumés d’accident mortel (47 %) n’ont plus leurs 12 points sur leur permis de conduire contre 21 % de l’ensemble des titulaires du permis de conduire."
                            }
                        ]
                    }
