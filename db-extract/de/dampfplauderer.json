                "senses": [
                    {
                        "sense_id": "6fc937d0-50f7-39cd-9911-93fcbc3c964f",
                        "entry_id": "828017b0-6433-3ce1-a460-614d7c6e5feb",
                        "glosses": [
                            "jemand, der etwas nicht Spruchreifes, Unausdiskutiertes, Geheimes von sich gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70a47162-a4f5-4b10-a705-a95f12ec8912",
                                "sense_id": "6fc937d0-50f7-39cd-9911-93fcbc3c964f",
                                "text": "Bei dem Hick-Hack um die Regierungsbildung bezeichnete jemand Klaus Wowereit als Dampfplauderer, weil er voreilig etwas kundtat, was umgehend dementiert wurde."
                            },
                            {
                                "example_id": "cffe8be2-d6a5-45d8-9ab1-2d6a6daa5898",
                                "sense_id": "6fc937d0-50f7-39cd-9911-93fcbc3c964f",
                                "text": "Auch Betriebswirte werden häufig als Dampfplauderer bezeichnet, da sie nach landsläufiger Meinung nur heiße Luft gegenüber Ingenieuren plaudern und nicht substanziell am Produkt der Firma mitarbeiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
