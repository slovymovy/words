                ],
                "senses": [
                    {
                        "sense_id": "0e83c7e2-7c5a-3081-a454-dbf21627faad",
                        "entry_id": "e99ac4f6-8796-389a-b5a2-a7df88609f12",
                        "glosses": [
                            "Maugréer ; grogner en parlant d'une personne ; se plaindre à propos de tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1859b1e5-5482-4fc8-8af5-6604aac4e46a",
                                "sense_id": "0e83c7e2-7c5a-3081-a454-dbf21627faad",
                                "text": "Mais Marcel il grognasse pas pire ?"
                            },
                            {
                                "example_id": "2142c61b-e242-4bea-b59e-5f5b6fc46758",
                                "sense_id": "0e83c7e2-7c5a-3081-a454-dbf21627faad",
                                "text": "Le diable, en ma personne, passa devant cette fille, rêche, sèche, rétrécie au cou et aux poignets. Puis la femme du diable, qui grognassait : « Ce n'est pas tout ça, mais j'ai faim. »"
                            },
                            {
                                "example_id": "af4c2426-8439-4aa1-b8d1-67c1f14615ad",
                                "sense_id": "0e83c7e2-7c5a-3081-a454-dbf21627faad",
                                "text": "J'écoute encore un peu, politesse et hiérarchie obligent, je m'ennuie, je grognasse quelques onomatopées, je raccroche."
                            },
                            {
                                "example_id": "fad28d88-644b-4e77-8c91-66f597bd688f",
                                "sense_id": "0e83c7e2-7c5a-3081-a454-dbf21627faad",
                                "text": "J'ai désespérément besoin d'une douche. Je suis à deux doigts de faire couler l'eau quand j'entends frapper à la porte d'entrée. Je grognasse en regardant la pendule :\n– Putain mais c'est qui ?"
                            }
                        ]
                    }
                ],
