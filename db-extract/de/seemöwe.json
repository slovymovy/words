                    },
                    {
                        "translation_id": "54ba7711-47c9-4b76-8dca-1e6a4922f3ae",
                        "source_entry_id": "fb56c65b-cee6-3c58-a4ab-9674e9f71d47",
                        "source_sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                        "source_sense_description": "für Sprachen, die keine spezielle Entsprechung für „an der See lebende Möwe“ haben, siehe Übersetzungen im Eintrag Möwe",
                        "target_lang_word": "goéland",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goéland",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0e1ba3-9a9f-358a-8c21-461fd09912b5",
                                        "entry_id": "ad0da96e-b833-3c88-969b-afc3b5440145",
                                        "glosses": [
                                            "Grand oiseau palmipède marin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c079b9-6b66-43e5-8d4b-c66d0a02591b",
                                                "sense_id": "1c0e1ba3-9a9f-358a-8c21-461fd09912b5",
                                                "text": "Les goélands à l’aile grise\nLes hirondelles de la mer\nÀ leurs petits les jours de brise\nApprennent le chemin de l’air […]"
                                            },
                                            {
                                                "example_id": "c6357828-2c25-492c-b593-1e9adf6f4912",
                                                "sense_id": "1c0e1ba3-9a9f-358a-8c21-461fd09912b5",
                                                "text": "[…] et l’on voyait déjà quelques embarcations filer doucement sur l’eau que battaient les grands avirons, pareils à des vols de goélands lents et bas."
                                            },
                                            {
                                                "example_id": "53486088-5722-458d-ab25-efe4a37a1338",
                                                "sense_id": "1c0e1ba3-9a9f-358a-8c21-461fd09912b5",
                                                "text": "On n’entend que des cris d’oiseaux de mer, goélands et macreuses, qui s’abandonnent aux caprices du vent."
                                            },
                                            {
                                                "example_id": "de0dbb88-1053-4a19-bf38-69ec9971872c",
                                                "sense_id": "1c0e1ba3-9a9f-358a-8c21-461fd09912b5",
                                                "text": "Il vente très fort, des goélands passent, emportés par la tempête, et essaient vainement de remonter le vent."
                                            },
                                            {
                                                "example_id": "dd68e6e7-f28a-422a-b8c6-eff5214fc513",
                                                "sense_id": "1c0e1ba3-9a9f-358a-8c21-461fd09912b5",
                                                "text": "Comme tenus au bateau par des ficelles, quatre goélands, ailes ouvertes, ont fait le voyage au-dessus de nous."
                                            },
                                            {
                                                "example_id": "52d9627b-0197-42f2-9a03-309e32aaed14",
                                                "sense_id": "1c0e1ba3-9a9f-358a-8c21-461fd09912b5",
                                                "text": "Alors que le groupe s'éloignait résolument de la côte, Nekho entendit le pleur d'un goéland dans leur dos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
