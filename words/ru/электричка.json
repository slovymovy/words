    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c644e6ac-921e-3893-9304-e58c8813d562",
                    "sense_definition": "Пригородный или внутригородской электропоезд.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы поехали на дачу на утренней <w>электричке</w>.",
                            "target_lang_translations": {
                                "de": "Wir sind mit der <w>S-Bahn</w> am Morgen zur Datscha gefahren."
                            }
                        },
                        {
                            "text": "Последняя <w>электричка</w> уходит со станции ровно в полночь.",
                            "target_lang_translations": {
                                "de": "Die letzte <w>S-Bahn</w> verlässt den Bahnhof genau um Mitternacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "электропоезд"
                    ],
                    "common_phrases": [
                        "утренняя электричка",
                        "последняя электричка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "общеупотребительное разговорное название"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein elektrisch betriebener Vorort- oder Nahverkehrszug."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "S-Bahn",
                                "target_lang_sense_clarification": "Stadtschnellbahn im Nahverkehr"
                            },
                            {
                                "target_lang_word": "Regionalzug",
                                "target_lang_sense_clarification": "Zug, der Städte und Vororte verbindet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2f7cdce-56f5-361c-87bb-efe0dfac7aea",
                    "sense_definition": "Автомобиль, работающий на электрической тяге.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Современная <w>электричка</w> заряжается от специальной станции за несколько часов.",
                            "target_lang_translations": {
                                "de": "Ein modernes <w>Elektroauto</w> lädt an einer speziellen Station in wenigen Stunden auf."
                            }
                        },
                        {
                            "text": "Владелец <w>электрички</w> экономит на топливе и обслуживании двигателя.",
                            "target_lang_translations": {
                                "de": "Der Besitzer eines <w>Elektroautos</w> spart bei Kraftstoff und Motorwartung."
                            }
                        }
                    ],
                    "synonyms": [
                        "электромобиль"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "ироничное или разговорное название электромобиля"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Auto, das mit einem Elektromotor betrieben wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Elektroauto",
                                "target_lang_sense_clarification": "Standardbegriff für ein E-Auto"
                            },
                            {
                                "target_lang_word": "E-Auto",
                                "target_lang_sense_clarification": "Gebräuchliche Kurzform"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24569d4a-8642-34ef-9e9d-6fb4b8496f18",
                    "sense_definition": "Электрифицированная железная дорога.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом районе проложили новую <w>электричку</w> для связи с пригородом.",
                            "target_lang_translations": {
                                "de": "In diesem Gebiet wurde eine neue <w>elektrifizierte Bahnstrecke</w> zur Anbindung an den Vorort gebaut."
                            }
                        },
                        {
                            "text": "Строительство <w>электрички</w> заняло почти три года.",
                            "target_lang_translations": {
                                "de": "Der Bau der <w>elektrifizierten Bahnstrecke</w> dauerte fast drei Jahre."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление в значении инфраструктуры"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine elektrifizierte Eisenbahnstrecke."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Elektrifizierte Bahnstrecke",
                                "target_lang_sense_clarification": "Infrastruktur für elektrischen Zugverkehr"
                            }
                        ]
                    }
                }
            ]
        }
    ]
