                                            {
                                                "example_id": "a6cb0e3f-c44c-47e4-98e7-4f5f25408fb4",
                                                "sense_id": "9d155a6c-9060-3b58-b9bc-f5ab4258ba50",
                                                "text": "The bride was elegance personified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d66505-3818-38f9-b67d-c3c880b67972",
                                        "entry_id": "0857d64e-6a59-3d61-be38-2f2923f95f6a",
                                        "glosses": [
                                            "Restraint and grace of style."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812a74f3-69b3-44d6-9727-70be14ab6877",
                                                "sense_id": "d7d66505-3818-38f9-b67d-c3c880b67972",
                                                "text": "The simple dress had a quiet elegance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c41d8e-9dec-349d-9396-7b87b3b46752",
                                        "entry_id": "0857d64e-6a59-3d61-be38-2f2923f95f6a",
                                        "glosses": [
                                            "The beauty of an idea characterized by minimalism and intuitiveness while preserving exactness and precision."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3945df7e-7eae-4405-8cca-5a67d39edeaf",
                                                "sense_id": "a8c41d8e-9dec-349d-9396-7b87b3b46752",
                                                "text": "The proof of the theorem had a pleasing elegance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e521f8fd-ad1c-32f8-858b-24f78507892c",
                                        "entry_id": "0857d64e-6a59-3d61-be38-2f2923f95f6a",
                                        "glosses": [
                                            "A refinement or luxury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e302674b-2741-45d2-b8a0-a579f90a6cf5",
                                                "sense_id": "e521f8fd-ad1c-32f8-858b-24f78507892c",
                                                "text": "As to the comforts and elegances of life, we have enough of them for our good."
                                            },
                                            {
                                                "example_id": "373e737e-9991-4fc9-aee5-bd4fd3c91dbd",
                                                "sense_id": "e521f8fd-ad1c-32f8-858b-24f78507892c",
                                                "text": "At Rome, when Sallust was the fashionable writer, short sentences, uncommon words, and an obscure brevity, were affected as so many elegances."
                                            },
                                            {
                                                "example_id": "27dfe6f7-72d0-4896-969c-1eb4d4dc9829",
                                                "sense_id": "e521f8fd-ad1c-32f8-858b-24f78507892c",
                                                "text": "Phineas Duge[…] was, for a man of affairs and an American, singularly fond of the small elegances of life. Although he sat alone at dinner, the table was heaped with choice flowers and carefully selected hothouse fruit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c8d2a4b-c5cb-4d73-9005-c876aa13f1bf",
                        "source_entry_id": "31c194d1-c0c9-3c94-8c1b-d118b22968c4",
                        "source_sense_id": "64421b55-8b92-3005-89fb-fdcb5227c5e6",
                        "source_sense_description": "geschmackvolle und modische Ausstattung",
                        "target_lang_word": "snazziness",
