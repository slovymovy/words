                        "glosses": [
                            "A writer of fables; a fabulist; a dealer in untruths or falsehoods."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f96f130-897f-4747-a03e-1743d5655dbd",
                                "sense_id": "ce0e12e2-42ad-32c5-a5f4-319736d1b18b",
                                "text": "[…] certain fine fablers and lowd lyers, such as were the Authors of King Arthure the great and such like, who tell many an vnlawfull leasing of the Ladyes of the Lake, that is, the Nymphes."
                            },
                            {
                                "example_id": "73dccd60-39a1-41d4-94a4-1515d8e35139",
                                "sense_id": "ce0e12e2-42ad-32c5-a5f4-319736d1b18b",
                                "text": "No wonder that the Mythology, and Arabian Nights, and Shakespeare, and Scott’s novels, entertain us,—we are poets and fablers and dramatists and novelists ourselves."
                            },
                            {
                                "example_id": "e7d1919a-e3bc-406c-bd2b-0a5877504a4f",
                                "sense_id": "ce0e12e2-42ad-32c5-a5f4-319736d1b18b",
                                "text": "Clark insisted that Juan Diego was “on the imagination’s side”; Juan Diego was a “fabler, not a memoirist,” Clark said."
                            }
                        ]
                    }
