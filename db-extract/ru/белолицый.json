                    {
                        "translation_id": "a38ac29a-6515-40ac-a1bf-b6e4973c34cb",
                        "source_entry_id": "51e8a242-d3fe-3c3b-91ab-5b12356e2409",
                        "source_sense_id": "81aa32f7-239a-332c-9082-e8bc7049b25b",
                        "target_lang_word": "white-faced",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "white-faced",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "378b67c0-9c47-3787-b2d7-631abfe265cd",
                                        "entry_id": "a5cec9db-d995-3ec1-9020-1dc35ecdf2cc",
                                        "glosses": [
                                            "Alternative form of whitefaced."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec5041a-077e-4488-9c43-608a451a228d",
                                                "sense_id": "378b67c0-9c47-3787-b2d7-631abfe265cd",
                                                "text": "I never see a shivering, white-faced wretch in the prisoners’ dock that I do not hark back with shuddering horror to the strange events on the Pullman car Ontario, between Washington and Pittsburg, on the night of September ninth, last."
                                            },
                                            {
                                                "example_id": "263636b1-2a9a-4669-a027-0eee0ef5d272",
                                                "sense_id": "378b67c0-9c47-3787-b2d7-631abfe265cd",
                                                "text": "Angela, who had been sleeping in the alcove with the infant Rodrigo, looked white-faced at the bleeding man, whose lips were already turning blue."
                                            },
                                            {
                                                "example_id": "b3e97f4a-726e-409c-8d75-757aacb39321",
                                                "sense_id": "378b67c0-9c47-3787-b2d7-631abfe265cd",
                                                "text": "As Sara watched, disbelieving, a slow moan escaped his lips and he thudded to the ground. Silhouetted against the hard blue sky stood Selena, swaying as she looked white-faced at the man at her feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
