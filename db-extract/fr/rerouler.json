                "senses": [
                    {
                        "sense_id": "07ceb393-cf08-3b2a-b54c-67b41ae9fddb",
                        "entry_id": "fcc6711c-bee1-3a15-b0ad-1d2e4252a9ee",
                        "glosses": [
                            "Rouler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4433d96-b37a-4d66-857e-40c36f80ae81",
                                "sense_id": "07ceb393-cf08-3b2a-b54c-67b41ae9fddb",
                                "text": "Aussi, ne suis-je point touché de ces violences de gestes et de paroles; elle a beau se retordre les bras, se rerouler par terre, je n'en ai cure."
                            },
                            {
                                "example_id": "292e99b8-9e2c-435d-a7d6-1b7b00700fea",
                                "sense_id": "07ceb393-cf08-3b2a-b54c-67b41ae9fddb",
                                "text": "Guillaume, tu ne veux pas rerouler pour lui ???"
                            },
                            {
                                "example_id": "2bb84f5e-05f3-43c8-98c9-e4196bbdcd18",
                                "sense_id": "07ceb393-cf08-3b2a-b54c-67b41ae9fddb",
                                "text": "Rerouler le gâteau sur lui-même et laisser en attente sous un torchon propre."
                            }
                        ]
                    }
