                    "sense_id": "0fd27372-d202-3dc8-8314-060a334807f8",
                    "sense_definition": "ein Fahrzeug, Tier oder die eigene Bewegung in eine bestimmte Richtung steuern",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lenken_richtung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie <w>lenkte</w> das Auto vorsichtig durch die engen Straßen der Altstadt."
                        },
                        {
                            "text": "Mit beiden Händen am Steuer <w>lenkt</w> er den Wagen sicher um die gefährliche Kurve."
                        }
                    ],
                    "synonyms": [
                        "steuern",
                        "manövrieren"
                    ],
                    "common_phrases": [
                        "ein Fahrzeug lenken",
                        "das Auto lenken",
                        "seine Schritte lenken"
                    ]
                },
                {
                    "sense_id": "b0fd600c-dce7-310e-bbed-d2ecea8a18df",
                    "sense_definition": "die Aufmerksamkeit, ein Gespräch oder eine Entwicklung gezielt in eine bestimmte Richtung leiten",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "lenken_beeinflussen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Sprecherin versuchte geschickt, das Gespräch auf ein anderes Thema zu <w>lenken</w>."
                        },
                        {
                            "text": "Durch bunte Plakate <w>lenkt</w> die Werbung die Aufmerksamkeit der Kunden auf das neue Produkt."
                        }
                    ],
                    "synonyms": [
                        "leiten",
                        "steuern",
                        "beeinflussen"
                    ],
                    "common_phrases": [
                        "die Aufmerksamkeit lenken",
                        "das Gespräch lenken",
                        "den Blick auf etwas lenken"
                    ]
                },
                {
                    "sense_id": "68f1aacf-5f32-349d-a382-16563ab924ac",
                    "sense_definition": "an einen bestimmten Ort führen oder über einen Verlauf beziehungsweise das Schicksal bestimmen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lenken_fuehren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Zufall <w>lenkte</w> seine Schritte an diesem Abend in eine kleine Buchhandlung."
                        },
                        {
                            "text": "Ein altes Sprichwort besagt, dass der Mensch denkt, aber Gott am Ende das Schicksal <w>lenkt</w>."
