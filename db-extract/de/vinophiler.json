                        ],
                        "examples": [
                            {
                                "example_id": "f9376df6-8c00-4e74-bba3-45794d4755c7",
                                "sense_id": "07871440-344e-3783-a979-14ed99d5745c",
                                "text": "Je'elsaj ist für uns, yaj ist für die Raucher. Sie lieben unseren Schmerz, wie Vinophile einen 1947er Haut Brion lieben, ein Schmetterling Zuckerwasser und NASCAR-Fans eine Karambolage."
                            },
                            {
                                "example_id": "c4bdc83d-b19a-4106-bc0c-ffe4b1c2636a",
                                "sense_id": "07871440-344e-3783-a979-14ed99d5745c",
                                "text": "Vinophile aufgepasst: Der Gastgeber ist ausgewiesener Weinfreund, also nicht nach der Karte, gleich le chef fragen!"
                            },
                            {
                                "example_id": "71fdb66b-e61a-4f0e-bd23-3222eea4b5b8",
                                "sense_id": "07871440-344e-3783-a979-14ed99d5745c",
                                "text": "Hotel Rathaus Wein & Design (S. 199) Ein Highlight für Önologen: minimalistischer Schick für Vinophile."
                            }
                        ]
                    }
                ],
