                        "form": "das Modalverb"
                    },
                    {
                        "form_id": "87f42833-024d-4b06-b57b-8a2cdd730d83",
                        "entry_id": "278cb8c5-7c81-366b-a1d1-587991ea5cbf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Modalverben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5264f994-4ec9-31bf-a308-95fa22d0bfbb",
                        "entry_id": "278cb8c5-7c81-366b-a1d1-587991ea5cbf",
                        "glosses": [
                            "ein Verb, das ein Vollverb dahingehend ergänzt, dass es ausdrückt, ob die Handlung zum Beispiel möglich, gewollt oder notwendig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d8c2e6-42d2-42ef-bda6-4f6745afe1b5",
                                "sense_id": "5264f994-4ec9-31bf-a308-95fa22d0bfbb",
                                "text": "Modalverben im Deutschen sind: können, dürfen, müssen, sollen, wollen, mögen."
                            },
                            {
                                "example_id": "b3f2a591-6566-40fd-aff0-8992a47f17d4",
                                "sense_id": "5264f994-4ec9-31bf-a308-95fa22d0bfbb",
                                "text": "Mit dem Modalverb \"dürfen\" kann man ausdrücken, dass etwas erlaubt ist."
                            },
                            {
                                "example_id": "a355a94e-cce7-4f27-a67a-218ea5a10d1c",
                                "sense_id": "5264f994-4ec9-31bf-a308-95fa22d0bfbb",
                                "text": "„Die Untersuchungen zu Modalverben, Modaladverbien und Modalausdrücken anderer Art sind Legion.“"
                            },
                            {
                                "example_id": "4dce4ea3-c8f6-46af-934c-0bf4333b9aba",
                                "sense_id": "5264f994-4ec9-31bf-a308-95fa22d0bfbb",
                                "text": "„Unnötig zu betonen, daß sich im Färöischen dieselbe Mischung von regelmäßigen und unregelmäßigen Verben sowie Hilfs- und Modalverben wiederfindet, wie man sie von den anderen skandinavischen Sprachen her kennt.“"
                            },
                            {
                                "example_id": "29092940-cfd4-4a1e-a8b5-0bbfa0a08dcb",
                                "sense_id": "5264f994-4ec9-31bf-a308-95fa22d0bfbb",
                                "text": "„Weitgehend unbemerkt werden Modalverben redundant gebraucht.“"
                            },
                            {
                                "example_id": "ce02097a-2633-46d8-9368-67853b6ab07a",
                                "sense_id": "5264f994-4ec9-31bf-a308-95fa22d0bfbb",
                                "text": "„Die Entwicklung der Modalverben wird in einem eigenen Kapitel dargestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
