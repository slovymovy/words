                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acc56d11-de4a-3d25-b64c-07ab8782261e",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "The indentation or depression made by the pressure of one object on or into another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7ea81f-e085-493c-8b2d-bedf66b3f7fd",
                                                "sense_id": "acc56d11-de4a-3d25-b64c-07ab8782261e",
                                                "text": "His head made an impression on the pillow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5132ce0d-212b-324c-8b76-bcad9145c106",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "The overall effect of something, e.g., on a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07a58fa-65d9-499b-8be2-13174e37b24c",
                                                "sense_id": "5132ce0d-212b-324c-8b76-bcad9145c106",
                                                "text": "He tried to make a good impression on his parents."
                                            },
                                            {
                                                "example_id": "f29579c9-0530-4d79-a954-ead917ad0e34",
                                                "sense_id": "5132ce0d-212b-324c-8b76-bcad9145c106",
                                                "text": "Their empires, triumphs, conquests, and projects, have left little impression behind them, notwithstanding the attention they once attracted, and the violent convulsions which they caused in the state of the world."
                                            },
                                            {
                                                "example_id": "1d4a9ca7-a347-4cae-854e-1afce2faffec",
                                                "sense_id": "5132ce0d-212b-324c-8b76-bcad9145c106",
                                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            },
                                            {
                                                "example_id": "2428cea3-e427-4f0d-95f1-c26db5b429b0",
                                                "sense_id": "5132ce0d-212b-324c-8b76-bcad9145c106",
                                                "text": "Though most of the cases here cover European encounters with non-Europeans, it is not the intention of the book to give the impression that genocide is a function of European colonialism and imperialism alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b0da53-bb52-3e8a-b13e-012c43c4b419",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "A vague recalling of an event, a belief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75800c7-89d1-4c4e-84d2-982ac6d3cd97",
                                                "sense_id": "d2b0da53-bb52-3e8a-b13e-012c43c4b419",
                                                "text": "I have the impression that he's already left for Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e094993-c3ec-3816-83b2-37df0fb302d4",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "An impersonation, an imitation of the mannerisms of another individual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05cf1d11-5b41-3bd1-982d-cb00095cc7c3",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "An outward appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7f33b27-cb22-32a5-8875-1bd240e87e6f",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "A performance metric representing an instance where a post or ad is shown once."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa9bc0b-1604-41b0-a5dc-1c71f2e1320a",
                                                "sense_id": "c7f33b27-cb22-32a5-8875-1bd240e87e6f",
                                                "text": "Publishers are paid for each ad impression their site generates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22c20ea0-6be7-31f6-b9c8-631d42f1472f",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "The first coat of colour, such as the priming in house-painting etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f7fda15-27f9-3dcc-afdf-ee900659fdb2",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "A print on paper from a wood block, metal plate, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "396e7f7a-e662-3ddc-b910-13b217166961",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "The vivid perception of something as it is experienced, in contrast to ideas or thoughts drawn from memory or the imagination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b7338b-af2c-4197-99be-cdfde79e3b73",
                                                "sense_id": "396e7f7a-e662-3ddc-b910-13b217166961",
                                                "text": "Let us, therefore, use a little freedom, and call them Impressions; employing that word in a sense somewhat different from the usual. By the term impression, then, I mean all our more lively perceptions, when we hear, or see, or feel, or love, or hate, or desire, or will. And impressions are distinguished from ideas, which are the less lively perceptions, of which we are conscious, when we reflect on any of those sensations or movements above mentioned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bccf3dd-51d2-3011-a55a-c23a207f8f65",
                                        "entry_id": "2be76262-c856-3d0b-a760-687a0a347a13",
                                        "glosses": [
                                            "set of copies of a publication printed at one time having the same content, layout, pagination, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "impression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17fe3e58-e228-3d0b-a848-df9a1eade39f",
                                        "entry_id": "f2ff3097-6e4d-3897-a3f9-95af5b78a2f7",
                                        "glosses": [
                                            "To manipulate a blank key within a lock so as to mark it with impressions of the shape of the lock, which facilitates creation of a duplicate key."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f374e42f-cf51-4099-9bf4-38f76dcd3007",
                                                "sense_id": "17fe3e58-e228-3d0b-a848-df9a1eade39f",
                                                "text": "The trick in impressioning a key is to remove only a small amount of the blank, by filing or cutting, from the pin positions where impressions have been left."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95876c04-0561-4bfd-9ec1-3c554595eb01",
                        "source_entry_id": "9423f318-6593-36d1-a8d3-64bc7ed22d1a",
                        "source_sense_id": "7e74929e-69ab-3f32-92e3-62471d8f3105",
                        "target_lang_word": "impression",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impression",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96f4c656-cbe2-3c74-ac5e-a21f0f751c50",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Action d’imprimer par laquelle une chose appliquée sur une autre y laisse une empreinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ea712c-56a1-402b-b751-f2151138acae",
                                                "sense_id": "96f4c656-cbe2-3c74-ac5e-a21f0f751c50",
                                                "text": "L’impression d’un corps sur un autre corps."
                                            },
                                            {
                                                "example_id": "100c7cc5-d28b-48bc-b6b0-339066622760",
                                                "sense_id": "96f4c656-cbe2-3c74-ac5e-a21f0f751c50",
                                                "text": "L’impression d’un cachet sur de la cire."
                                            },
                                            {
                                                "example_id": "1d254478-87ea-4457-b670-95513d9ab078",
                                                "sense_id": "96f4c656-cbe2-3c74-ac5e-a21f0f751c50",
                                                "text": "Ses pas étaient si légers que le sable en recevait à peine l’impression."
                                            },
                                            {
                                                "example_id": "777ceec4-5c4c-4e2e-9710-4d494f36d191",
                                                "sense_id": "96f4c656-cbe2-3c74-ac5e-a21f0f751c50",
                                                "text": "Il sourit en apprenant que nous venons de Roanne. Roanne est justement la ville concurrente de Thann pour les tissages et les impressions d’étoffe. Roanne a fait baisser ici les salaires ; mais il ne nous en veut pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "227b39d0-ea46-36ff-a9a1-e5d07d141e51",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Action d’imprimer un livre, un journal, etc."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb6a33d8-bf12-4277-a51d-ed746d84bbe4",
                                                "sense_id": "227b39d0-ea46-36ff-a9a1-e5d07d141e51",
                                                "text": "Diriger, surveiller l’impression d’un ouvrage."
                                            },
                                            {
                                                "example_id": "1340fc09-5cf7-4051-ba05-7ae27deda872",
                                                "sense_id": "227b39d0-ea46-36ff-a9a1-e5d07d141e51",
                                                "text": "Livrer, envoyer un mémoire à l’impression."
                                            },
                                            {
                                                "example_id": "4c1bf753-1094-4df8-a7bc-b36c67251c23",
                                                "sense_id": "227b39d0-ea46-36ff-a9a1-e5d07d141e51",
                                                "text": "Demander l’impression d’un rapport."
                                            },
                                            {
                                                "example_id": "9f3ffd36-d744-4cef-98e2-b17ba3b722b8",
                                                "sense_id": "227b39d0-ea46-36ff-a9a1-e5d07d141e51",
                                                "text": "Je n’oserais point publier le manuscrit intégralement, ni même en donner des fragments de quelque étendue, bien que beaucoup de personnes pensent aujourd’hui, avec M. Taine, qu’il convient surtout d’imprimer ce qui n’a pas été fait pour l’impression. Pour dire des choses intéressantes, il ne suffit pas, quoi qu’on dise, de n’être pas un écrivain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3869ea5c-36d4-3be3-8cd0-fb3e76858ac4",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Édition."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9962c8-20f1-45e9-995d-3f36ae9eb431",
                                                "sense_id": "3869ea5c-36d4-3be3-8cd0-fb3e76858ac4",
                                                "text": "Les anciennes impressions sont aujourd’hui fort recherchées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2904a51a-e112-3f9a-8535-91726be44cc3",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Document imprimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70093d5d-0f3d-4784-b749-6b2b16c37da3",
                                                "sense_id": "2904a51a-e112-3f9a-8535-91726be44cc3",
                                                "text": "Oublient-ils leurs impressions dans l’imprimante et leurs fax dans la télécopieuse ? Leurs mots de passe ressemblent-ils à « lucie » ou « vincent73 » ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a935788f-f0eb-3bdf-84db-b88f2992beee",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Effet que l’action d’une chose produit sur un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ce37d64-f096-4b92-907d-4f95a9e556dd",
                                                "sense_id": "a935788f-f0eb-3bdf-84db-b88f2992beee",
                                                "text": "Il est sensible aux moindres impressions de l’air, aux moindres impressions du changement de temps. - L’impression que les objets font sur nos sens, que les couleurs font sur la vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d37ff205-12ee-3167-bbae-2b550fab1a1f",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Ce qui reste de l’action qu’une chose a exercée sur un corps."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af14a64e-fbf6-4bb7-9f9a-f48d902bdcf5",
                                                "sense_id": "d37ff205-12ee-3167-bbae-2b550fab1a1f",
                                                "text": "Il n’a plus de fièvre, mais il lui reste encore une légère impression de chaleur."
                                            },
                                            {
                                                "example_id": "471a8548-bcf7-4f5c-b05e-253234a28612",
                                                "sense_id": "d37ff205-12ee-3167-bbae-2b550fab1a1f",
                                                "text": "Cette névralgie m’a laissé quelque impression de douleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eee18a3-85f2-31b1-829e-3e5de333161f",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Effet qu’une cause quelconque produit dans le cœur ou dans l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ddf0191-9cbe-4559-89f7-987fdfff9040",
                                                "sense_id": "1eee18a3-85f2-31b1-829e-3e5de333161f",
                                                "text": "Quand, par hasard, il songeait à mettre un peu d'ordre dans ces impressions nouvelles, ses idées se pressaient, touffues, rapides jusqu’à l’incohérence."
                                            },
                                            {
                                                "example_id": "78a4f5d4-99d9-4522-a6c4-398fcb0c375e",
                                                "sense_id": "1eee18a3-85f2-31b1-829e-3e5de333161f",
                                                "text": "D’ailleurs, il entre bien plus dans le plan de ces impressions, si tant est que ces impressions aient un plan, de parler des hommes que des localités."
                                            },
                                            {
                                                "example_id": "eb2d981c-5f80-4507-a536-6c6b9bc80e5c",
                                                "sense_id": "1eee18a3-85f2-31b1-829e-3e5de333161f",
                                                "text": "Nous passons sous le pont suspendu de Brooklyn et devant Manhattan et ses gratte-ciel, et ma dernière vision de New-York me laisse une impression de ville monstrueuse et titanesque."
                                            },
                                            {
                                                "example_id": "8ff36e2f-5c26-4483-b8bd-21d3a14763a5",
                                                "sense_id": "1eee18a3-85f2-31b1-829e-3e5de333161f",
                                                "text": "Si un vol facile, même de longue durée, peut enchanter, donner au pilote l’impression qu’il est un être supraterrestre, la difficulté aiguise l’énergie, accroît la volonté et accorde dans la lutte des satisfactions innombrables et dans la victoire un enivrement qui pousse à croire que l’homme est tout-puissant devant les éléments déchaînés."
                                            },
                                            {
                                                "example_id": "7afb8dc1-e484-44d6-abe4-56c1f3e32e2c",
                                                "sense_id": "1eee18a3-85f2-31b1-829e-3e5de333161f",
                                                "text": "Un campement à la bordure d’une forêt, et éclairé par quelques bougies, donne d’étranges apparences ; je crus voir une falaise et des cavernes ; je revis ce lieu plus d’une fois ; jamais je n’y pus reconnaître ma première impression."
                                            },
                                            {
                                                "example_id": "cba9f48b-96dc-499e-970f-6fd31be86d77",
                                                "sense_id": "1eee18a3-85f2-31b1-829e-3e5de333161f",
                                                "text": "Ma myopie renforçait encore l’impression d’irréel, de cauchemar que je ressentais et contre laquelle je m’efforçais de lutter, dans la crainte de voir se briser ma volonté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f743db-6829-355d-ab0f-895dadbd6b14",
                                        "entry_id": "e837f0d9-6e2a-340a-b957-76153762e92f",
                                        "glosses": [
                                            "Ensemble des actions physiologiques d’où résulte la sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccbea4d3-fbf3-497f-a3d0-d9c0125484fa",
                                                "sense_id": "39f743db-6829-355d-ab0f-895dadbd6b14",
                                                "text": "Mais dans le même temps qu'elle admirait les robes, Francie éprouvait un étrange malaise. Ses yeux voyaient bien les couleurs, le cerise, l'orange, le bleu vif, le rouge et le jaune, mais elle avait l’impression qu'une chose sournoise se cachait derrière les costumes : […]."
                                            },
                                            {
                                                "example_id": "116202ca-f59b-48bf-97f3-6d886511f404",
                                                "sense_id": "39f743db-6829-355d-ab0f-895dadbd6b14",
                                                "text": "[…] ; puis deux hommes me saisirent par les bras pour m'entraîner sur une trentaine de mètres. J’eus l’impression de gravir deux marches avant qu'ils me jetassent à même le sol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
