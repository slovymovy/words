            "senses": [
                {
                    "sense_id": "83d96aa2-3eab-34da-ae5b-b620508a30af",
                    "sense_definition": "Quitter un lieu de nouveau ou retourner d'où l'on vient.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir passé deux jours chez ses parents, elle <w>repart</w> demain matin."
                        },
                        {
                            "text": "Le train s'arrête quelques minutes en gare avant de <w>repartir</w> vers Paris."
                        }
                    ],
                    "synonyms": [
                        "s'en retourner"
                    ],
                    "common_phrases": [
                        "repartir chez soi",
                        "repartir en train"
                    ]
                },
                {
                    "sense_id": "28335a65-d6d4-3926-8049-faa4581ad11d",
                    "sense_definition": "Recommencer, reprendre son cours ou son activité après une interruption.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recommencement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue pause estivale, l'économie du pays <w>repart</w> enfin à la hausse."
                        },
                        {
                            "text": "Nous avons décidé d'oublier nos erreurs passées et de <w>repartir</w> à zéro."
                        }
                    ],
                    "common_phrases": [
                        "repartir à zéro",
                        "repartir de plus belle",
                        "repartir du bon pied"
                    ]
                },
                {
                    "sense_id": "a39a84f5-cdef-328c-9df1-6e2a9597f893",
                    "sense_definition": "Répliquer vivement ou répondre sur-le-champ avec vivacité.",
