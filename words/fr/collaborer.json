                    "frequency": "High",
                    "semantic_group_id": "travail_partage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux scientifiques ont décidé de <w>collaborer</w> sur un projet de recherche médicale."
                        },
