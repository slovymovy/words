                "senses": [
                    {
                        "sense_id": "d012c758-e3c5-3fac-9480-6e35333e38ca",
                        "entry_id": "1d7ccb8c-f52b-35bf-9919-22add21e7c1e",
                        "glosses": [
                            "текстильное изделие, предназначенное для украшения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba83662f-8624-49f0-9e81-9aea622cc13e",
                                "sense_id": "d012c758-e3c5-3fac-9480-6e35333e38ca",
                                "text": "Побеседовал даже с Перфишкой, которому обещал новый казакин с желтыми по всем швам басонами, и лег спать в блаженнейшем настроении духа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a40a9f0-d60a-4ad4-8f99-0dcb3ae244a1",
                        "source_entry_id": "1d7ccb8c-f52b-35bf-9919-22add21e7c1e",
                        "source_sense_id": "d012c758-e3c5-3fac-9480-6e35333e38ca",
                        "target_lang_word": "passement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6469190a-718c-3ba4-9519-d7802fdfc1ab",
                                        "entry_id": "ef5cefae-d63f-3977-bfa6-1e059b0ba52c",
                                        "glosses": [
                                            "Action de passer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dc94da9-06b7-3796-a8ce-9eecdae9e279",
                                        "entry_id": "ef5cefae-d63f-3977-bfa6-1e059b0ba52c",
                                        "glosses": [
                                            "Tissu plat et un peu large, de fil d’or, de soie, de laine, etc., qu’on met pour ornement sur des vêtements, sur des meubles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a7cf99-cb4a-4a79-8feb-5d5f6bd659e1",
                                                "sense_id": "4dc94da9-06b7-3796-a8ce-9eecdae9e279",
                                                "text": "Passement d’or, d’argent, de soie, etc."
                                            },
                                            {
                                                "example_id": "4b23edbf-4e4d-48c9-8231-fca0ac310c4a",
                                                "sense_id": "4dc94da9-06b7-3796-a8ce-9eecdae9e279",
                                                "text": "C’est du passement français, du huit-brins… Mais si vous voulez, nous en avons de l’ordinaire, du gros… Celui-là est à quarante-cinq kopecks l’archine mais, excusez du peu, ce n’est pas la même qualité !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4eb7363-2366-4549-8223-a892c652d0fd",
                        "source_entry_id": "1d7ccb8c-f52b-35bf-9919-22add21e7c1e",
                        "source_sense_id": "d012c758-e3c5-3fac-9480-6e35333e38ca",
                        "target_lang_word": "passementerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passementerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d0b8957-4614-39fd-83b3-6406d4d84215",
                                        "entry_id": "06f871dc-992f-37c4-9e43-155a94d7362e",
                                        "glosses": [
                                            "Toutes les sortes de passements et autres ornements que l’on emploie pour les vêtements ou l’ameublement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cf115e-dc6e-4395-b948-8ec96d832fb4",
                                                "sense_id": "2d0b8957-4614-39fd-83b3-6406d4d84215",
                                                "text": "Cette partie, appelée passementerie d’or et d’argent, comprenait les épaulettes, les dragonnes, les aiguillettes, enfin cette immense quantité de choses brillantes qui scintillaient sur les riches uniformes de l’armée française et sur les habits civils."
                                            },
                                            {
                                                "example_id": "cc3a76b6-5f20-4657-963d-4299cbe1a8c0",
                                                "sense_id": "2d0b8957-4614-39fd-83b3-6406d4d84215",
                                                "text": "La soie artificielle. […]. Pour certains articles, notamment la passementerie, la rubannerie, les broderies brillantes, on la préfère à la soie naturelle ; […]."
                                            },
                                            {
                                                "example_id": "fe6d70d6-5f2a-44e3-be23-2cc6cb9878b7",
                                                "sense_id": "2d0b8957-4614-39fd-83b3-6406d4d84215",
                                                "text": "Le soir tombait, assombrissant le petit magasin de papeterie-mercerie. On distinguait encore les rangées de cartons blancs qui portaient sur leur flanc un bouton de corozo ou une boule de passementerie."
                                            },
                                            {
                                                "example_id": "9ade0cbf-c4c0-4635-9f32-23725d67d970",
                                                "sense_id": "2d0b8957-4614-39fd-83b3-6406d4d84215",
                                                "text": "— Il me faut également une longueur de jais, avec des boutons en passementerie, poursuit Polinka en se penchant sur la marchandise […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faccf0a3-ec43-3486-8603-466d178953c2",
                                        "entry_id": "06f871dc-992f-37c4-9e43-155a94d7362e",
                                        "glosses": [
                                            "Industrie et commerce de ce genre d’ornements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7577c0e-e6b8-4fde-88cf-488df93145b0",
                                                "sense_id": "faccf0a3-ec43-3486-8603-466d178953c2",
                                                "text": "Il y avait plusieurs centres de passementerie en France."
                                            },
                                            {
                                                "example_id": "42547b20-c446-43ef-9828-be9ac9d1096b",
                                                "sense_id": "faccf0a3-ec43-3486-8603-466d178953c2",
                                                "text": "Elle tient une petite boutique de passementerie où elle vend ce qu’elle fabrique."
                                            },
                                            {
                                                "example_id": "03a8f16a-1764-44a6-8312-64361a7fb753",
                                                "sense_id": "faccf0a3-ec43-3486-8603-466d178953c2",
                                                "text": "C’est si loin. J’avais peur du voyage, du climat pour les enfants. Puis il aurait fallu vendre notre fonds de passementerie, ce petit avoir si péniblement gagné, monté pièce à pièce en dix ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
