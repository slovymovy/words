            {
                "entry_id": "b84f5d43-7fed-3433-8091-2fa5222977f6",
                "word": "verkeersongeval",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "19e5f70f-a7da-46e4-8bcd-b8a5232c8d25",
