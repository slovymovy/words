                        "form": "ninja'd"
                    },
                    {
                        "form_id": "1e0523ce-d580-4261-8ea8-f6c5823de19d",
                        "entry_id": "97f0dfbe-a347-3613-a453-030cb6a70e05",
                        "tags": [
                            "past"
                        ],
                        "form": "ninja'd"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                        "entry_id": "97f0dfbe-a347-3613-a453-030cb6a70e05",
                        "glosses": [
                            "To act or move like a ninja, particularly with regard to a combination of speed, power, and stealth."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8fb42dd6-8753-45ec-a5a8-3d10571b0912",
                                "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                                "text": "I leapt up, ninja'd over to Gav's bed and wheeched the duvet off."
                            },
                            {
                                "example_id": "45e3a45f-4ddc-401d-bbc9-ba9ae57a177d",
                                "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                                "text": "In our dark house we were ninja-ing around with water guns."
                            },
                            {
                                "example_id": "9dcbfe08-03e6-4a21-a1ba-48b6ad4801cb",
                                "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                                "text": "I ninja'd my way into Kung Fu Records to hang out with those merry pranksters the Vandals."
                            }
                        ]
                    },
                    {
                        "sense_id": "47bd8099-100f-3945-930b-afa3cde95bce",
                        "entry_id": "97f0dfbe-a347-3613-a453-030cb6a70e05",
                        "glosses": [
                            "Synonym of preempt: to supersede and invalidate a response to a thread or message by posting immediately before it, typically shortly before the other party finishes writing or posting their reply."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "ae7ba30c-f59a-43f3-b9a2-fe3c91fc99d3",
                                "sense_id": "47bd8099-100f-3945-930b-afa3cde95bce",
                                "text": "When I hit post, I saw that Blue Emu had ninja'd me, so I just deleted my reply."
                            }
                        ]
                    },
                    {
                        "sense_id": "045f6a33-4c35-3832-b180-59407ca8b1a7",
                        "entry_id": "97f0dfbe-a347-3613-a453-030cb6a70e05",
                        "glosses": [
                            "To claim an item through abuse of game mechanics."
                        ],
                        "tags": [
                            "Internet",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "340c14d7-ec3c-4d07-a0b5-d94c5439b6d0",
                                "sense_id": "045f6a33-4c35-3832-b180-59407ca8b1a7",
                                "text": "That damn warrior ninja'd an epic-quality wand even though he can't even use it!"
                            }
                        ]
                    }
                ],
