                ],
                "senses": [
                    {
                        "sense_id": "38736141-bde0-3d32-949b-39f9eed6fc34",
                        "entry_id": "3e8f5932-f405-397a-a6e9-b6a72d5ee12a",
                        "glosses": [
                            "mit Wurzelballen gelieferte Pflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298af486-df25-40ea-b37a-ac734a9e11dd",
                                "sense_id": "38736141-bde0-3d32-949b-39f9eed6fc34",
                                "text": "„Ballenware hat logistische Vorteile hinsichtlich der Sauberkeit im Lager und des Umschlages.“"
                            },
                            {
                                "example_id": "d29046e0-a27f-43dc-91e7-0aab3acea29f",
                                "sense_id": "38736141-bde0-3d32-949b-39f9eed6fc34",
                                "text": "„Wurzelnackte Gehölze sind deutlich preiswerter als Container oder Ballenware.“"
                            },
                            {
                                "example_id": "87acfcd0-42cd-4b42-9117-806876fe9dd0",
                                "sense_id": "38736141-bde0-3d32-949b-39f9eed6fc34",
                                "text": "„Schlagen Sie Ballenware bis zur Pflanzung locker in feuchte Erde oder nasse Säcke ein und stellen Sie Topfbäume so lange an einen halbschattigen Ort.“"
                            },
                            {
                                "example_id": "2ed2de93-237e-45e5-9c02-0992f0dbaeb3",
                                "sense_id": "38736141-bde0-3d32-949b-39f9eed6fc34",
                                "text": "„Im Container kann es ganzjährig gepflanzt werden, als Ballenware empfiehlt sich die Pflanzung im Herbst oder Frühjahr.“"
                            },
                            {
                                "example_id": "cc31f4db-fe43-4c72-997d-1b3085ed46d7",
                                "sense_id": "38736141-bde0-3d32-949b-39f9eed6fc34",
                                "text": "„Ballenware wird frisch ausgegraben und daher in der Regel nur von Oktober bis Anfang Mai angeboten, sie hat aber besonders ausgeprägte Wurzelballen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
