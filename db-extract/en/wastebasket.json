                                        "entry_id": "e84478b5-a43c-3269-8cd0-4b9b399ef9ad",
                                        "glosses": [
                                            "öffentlich aufgestellte (beispielsweise in Parks, am Straßenrand), die durch die Stadtreinigung geleert werden"
                                        ],
