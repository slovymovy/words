    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08df5c8b-fa89-3e19-b017-d96b5c33ac2c",
                    "sense_definition": "A written message, such as a letter or note.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "message",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She received a formal <w>missive</w> from the director regarding the upcoming changes.",
                            "target_lang_translations": {
                                "es": "Recibió una <w>misiva</w> formal del director con respecto a los próximos cambios."
                            }
                        },
                        {
                            "text": "He spent the entire morning drafting a long <w>missive</w> to his business partner.",
                            "target_lang_translations": {
                                "es": "Pasó toda la mañana redactando una larga <w>misiva</w> para su socio comercial."
                            }
                        }
                    ],
                    "synonyms": [
                        "letter",
                        "note",
                        "message",
                        "dispatch"
                    ],
                    "common_phrases": [
                        "formal missive",
                        "lengthy missive"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in a formal or literary context."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Mensaje escrito, especialmente una carta o nota formal."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "misiva",
                                "target_lang_sense_clarification": "carta o comunicación formal o literaria"
                            },
                            {
                                "target_lang_word": "carta",
                                "target_lang_sense_clarification": "escrito enviado a una persona"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8e7b0e0-3849-337d-a563-13edf55e65d7",
                    "sense_definition": "A person who is sent to deliver a message; a messenger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "messenger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sent a <w>missive</w> to the neighboring kingdom to demand peace.",
                            "target_lang_translations": {
                                "es": "El rey envió un <w>emisario</w> al reino vecino para exigir la paz."
                            }
                        },
                        {
                            "text": "The <w>missive</w> arrived at dawn with urgent news from the front lines.",
                            "target_lang_translations": {
                                "es": "El <w>mensajero</w> llegó al amanecer con noticias urgentes del frente."
                            }
                        }
                    ],
                    "synonyms": [
                        "messenger",
                        "courier",
                        "envoy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Persona enviada para entregar un mensaje; mensajero o emisario."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "emisario",
                                "target_lang_sense_clarification": "persona enviada con un encargo o mensaje"
                            },
                            {
                                "target_lang_word": "mensajero",
                                "target_lang_sense_clarification": "persona que lleva un mensaje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "801e9870-1967-3f72-88cd-3fd952d43651",
                    "sense_definition": "Letters exchanged between parties to finalize an agreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "message",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract was finalized through a series of legal <w>missives</w>.",
                            "target_lang_translations": {
                                "es": "El contrato se formalizó mediante una serie de <w>misivas contractuales</w> legales."
                            }
                        },
                        {
                            "text": "Both parties signed the <w>missives</w> to confirm the terms of the deal.",
                            "target_lang_translations": {
                                "es": "Ambas partes firmaron las <w>cartas de compromiso</w> para confirmar los términos del acuerdo."
                            }
                        }
                    ],
                    "synonyms": [
                        "correspondence"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in formal or legal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Cartas o documentos intercambiados formalmente entre partes para formalizar un acuerdo contractual."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cartas de intención",
                                "target_lang_sense_clarification": "documentos intercambiados en acuerdos contractuales"
                            },
                            {
                                "target_lang_word": "misivas contractuales",
                                "target_lang_sense_clarification": "cartas con valor contractual"
                            }
                        ]
                    }
                }
            ]
        },
        {
