                        "glosses": [
                            "Ophtalmie endémique de l’Égypte."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "cf85cb0d-b5d7-4773-97b9-326d767e5815",
                                "sense_id": "59de5b46-503b-3cb1-ac12-7014fc5d8e67",
                                "text": "Le ramdam est une ophthalmie endémique dans toute l’Égypte, mais plus fréquente dans le nord que près de l’équateur, plus commune dans les villes que dans les campagnes."
