                                "ru": "Она взяла очень высокую <w>ноту</w> в конце песни.",
                                "zh": "她在歌曲结尾处唱出了一个极高的<w>音</w>。"
                            }
                        },
                        {
                            "text": "He played the first few <w>notes</w> on the piano.",
                            "target_lang_translations": {
                                "ru": "Он сыграл первые несколько <w>нот</w> на пианино.",
                                "zh": "他在钢琴上弹奏了最初的几个<w>音符</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high note",
                        "hit a note",
                        "wrong note"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный звук в музыке или символ, обозначающий высоту и длительность звука.",
                        "zh": "音乐中的单个音，或表示音高和时值的符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нота",
                                "target_lang_sense_clarification": "музыкальный знак или звук"
