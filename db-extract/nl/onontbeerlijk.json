                        "sense_id": "ad531127-d81a-36c4-87bf-2165460ecd5e",
                        "entry_id": "08bdf933-d478-34e0-be1c-f1d80f0037cf",
                        "glosses": [
                            "volstrekt noodzakelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a5e86c-e21c-4286-960a-14f88eb1bc24",
                                "sense_id": "ad531127-d81a-36c4-87bf-2165460ecd5e",
                                "text": "In het noorden van Siberië is kleding van bont vervaardigd onontbeerlijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "170cc4db-31d2-48ea-ab08-482c61d72235",
                        "source_entry_id": "08bdf933-d478-34e0-be1c-f1d80f0037cf",
                        "source_sense_id": "ad531127-d81a-36c4-87bf-2165460ecd5e",
                        "target_lang_word": "indispensable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indispensable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5200be6d-2846-3516-af51-2865f7380dc5",
                                        "entry_id": "6cd201d6-c5d7-345b-bed4-6616f95ccf3b",
                                        "glosses": [
                                            "Not admitting ecclesiastical dispensation; not subject to release or exemption; that cannot be allowed by bending the canonical rules."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0af05ba5-52c8-3aea-a58b-aec5ce7701cf",
                                        "entry_id": "6cd201d6-c5d7-345b-bed4-6616f95ccf3b",
                                        "glosses": [
                                            "Unbendable, that cannot be set aside or ignored."
                                        ],
                                        "tags": [
                                            "of duties"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48235387-845e-44bb-a613-31ef0ddf7dec",
                                                "sense_id": "0af05ba5-52c8-3aea-a58b-aec5ce7701cf",
                                                "text": "The law was moral and indispensable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49a7488c-3228-3f04-b313-236dc1f0f99a",
                                        "entry_id": "6cd201d6-c5d7-345b-bed4-6616f95ccf3b",
                                        "glosses": [
                                            "Absolutely necessary or requisite; that one cannot do without."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ca28ef-f56a-4f2f-b2e9-8ebb4e532ec7",
                                                "sense_id": "49a7488c-3228-3f04-b313-236dc1f0f99a",
                                                "text": "An indispensable component of a heart-healthy diet."
                                            },
                                            {
                                                "example_id": "be906a1d-603a-4e62-8482-db9d63e1f789",
                                                "sense_id": "49a7488c-3228-3f04-b313-236dc1f0f99a",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal. This only magnified the indispensable nature of the oligopolists."
                                            },
                                            {
                                                "example_id": "13ac168b-f4af-46d9-a9cf-836d2e251ea4",
                                                "sense_id": "49a7488c-3228-3f04-b313-236dc1f0f99a",
                                                "text": "And my friends in politics, no-one is remotely indispensable and our brilliant and Darwinian system will produce another leader, equally committed to taking this country forward through tough times."
                                            },
                                            {
                                                "example_id": "1605d9a0-b1a4-42fb-addd-c0f69754085c",
                                                "sense_id": "49a7488c-3228-3f04-b313-236dc1f0f99a",
                                                "text": "Behind this carefully crafted strategy of wooing Trump is a desire from Gulf states to solidify and formalize their positions as the US’ indispensable security and economic partners, and extract as much benefit for themselves as they can."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indispensable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27997b5c-6ca2-394b-8bee-83fa3b0877ef",
                                        "entry_id": "0d304be8-adea-3d9e-aca3-d3eb743aca9b",
                                        "glosses": [
                                            "A thing that is not dispensable; a necessity."
                                        ],
