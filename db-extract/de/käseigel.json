                                "example_id": "30cdd941-79fc-492b-ab6b-b245945a1a5f",
                                "sense_id": "9a2657dd-d62f-3005-9b1b-51ff8f71f476",
                                "text": "„Sie trug ein gewaltiges Tablett voller Gläser und einem imposanten Käseigel an den Tisch.“"
                            },
