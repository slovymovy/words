        "nl-extract.jsonl": [
            {
                "entry_id": "732b172f-17c1-3a0f-b873-e5ea04dd207c",
                "word": "fructose",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "57263bf5-1204-3e9c-92d2-f175e00d0b28",
                        "entry_id": "732b172f-17c1-3a0f-b873-e5ea04dd207c",
                        "glosses": [
                            "bepaalde suiker die veel in zoete vruchten voorkomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f2b1d3-63d6-406e-b5c8-1354232fba1c",
                                "sense_id": "57263bf5-1204-3e9c-92d2-f175e00d0b28",
                                "text": "Fructose leidt niet tot een toename van insuline en en evenmin tot een verhoging van het leptinehormoon (eetlustremmend hormoon) wat weer kan leiden tot overgewicht wat de kans op diabetes verhoogt."
                            }
                        ]
                    },
                    {
                        "sense_id": "50775c59-35a0-37c8-8ad8-7c06479a1b34",
                        "entry_id": "732b172f-17c1-3a0f-b873-e5ea04dd207c",
                        "glosses": [
                            "een monosacharide (een enkelvoudige suiker) met als brutoformule C₆H₁₂O₆"
                        ],
                        "tags": [
                            "wikidata: fructose"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1921eaf3-cf45-4dcb-8d32-359adc8520c6",
                        "source_entry_id": "732b172f-17c1-3a0f-b873-e5ea04dd207c",
                        "source_sense_description": "bepaalde suiker die veel in zoete vruchten voorkomt",
                        "target_lang_word": "Fructose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fructose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                        "entry_id": "36e60c58-929c-3021-9287-57c6b66db0f8",
                                        "glosses": [
                                            "Zucker mit der Summenformel C₆H₁₂O₆"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a56b520-2680-4202-9330-461440448a5f",
                                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                                "text": "Fructose hat eine höhere Süßkraft als alle anderen Zucker."
                                            },
                                            {
                                                "example_id": "b2fbedf4-df08-4b68-8acb-6fa5581c4c51",
                                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                                "text": "In den meisten Früchten ist Fructose."
                                            },
                                            {
                                                "example_id": "62aa1535-c65d-4243-a8a6-a75e64439383",
                                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                                "text": "Fructose ist gut wasserlöslich."
                                            },
                                            {
                                                "example_id": "5a6f8c28-d921-42dc-80d7-e5539ef023ee",
                                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                                "text": "„Die Molekülformel von Fructose stimmt mit der von Glucose überein.“"
                                            },
                                            {
                                                "example_id": "cda84eeb-22b3-4dd3-a77f-62688b1d1a99",
                                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                                "text": "„Die auch als Fruchtzucker bezeichnete Fructose ist ein weiteres, in süßen Früchten und im Honig vorkommendes Monosaccharid.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c84250a-05d9-415d-bf03-36fe4dd48b39",
                        "source_entry_id": "732b172f-17c1-3a0f-b873-e5ea04dd207c",
                        "source_sense_description": "bepaalde suiker die veel in zoete vruchten voorkomt",
                        "target_lang_word": "fructose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fructose",
