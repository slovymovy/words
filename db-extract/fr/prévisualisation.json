                                        "entry_id": "310db56a-6a36-3a86-9844-f2ef1c453c99",
                                        "glosses": [
                                            "An experience of something in advance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b5c825-0a5b-4fda-bcb6-36ff7bc51e40",
                                                "sense_id": "dee4b4a4-de19-3c57-b0cc-1b6be1506c53",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d99e118f-0182-3af6-bb28-fd8cf79dfb95",
                                        "entry_id": "310db56a-6a36-3a86-9844-f2ef1c453c99",
                                        "glosses": [
                                            "An advance showing of a film, exhibition etc."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e8a62a4-c6c6-3e56-8c01-d9ddf82c5676",
                                        "entry_id": "310db56a-6a36-3a86-9844-f2ef1c453c99",
                                        "glosses": [
                                            "A short collection of clips edited together to advertise a film, television show, etc.; a trailer."
