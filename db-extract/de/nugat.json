                        "glosses": [
                            "aus zerkleinerten Nüssen, Zucker und Kakao bestehende schokoladenartige Masse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b455ee25-cc5a-42bd-a4aa-f5eac589a8b3",
                                "sense_id": "5a44189f-8996-39c5-9436-5094912be33d",
                                "text": "Unter diese Warengruppe fallen Erzeugnisse, die auch als Türkischer Honig, orientalischer Honig, holländischer Nugat, Nugat Montelimar oder Torronc bezeichnet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60575dfa-8c40-4efc-bd19-07a7439f2bdd",
                        "source_entry_id": "7e628e55-7cad-3be8-80bc-8e3fe77babd1",
                        "source_sense_id": "5a44189f-8996-39c5-9436-5094912be33d",
                        "source_sense_description": "aus zerkleinerten Nüssen, Zucker und Kakao bestehende schokoladenartige Masse",
                        "target_lang_word": "nougat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nougat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94d2dbaa-9adf-326c-8f12-170cdff339f2",
                                        "entry_id": "d643dc4e-6c77-349e-b323-3c2f45e4dc09",
                                        "glosses": [
                                            "A mixture consisting of egg white and a sweetener, variously mixed with (in western Europe) almonds or (in eastern Europe) hazelnuts or (in US) used without nuts as a filler in candy bars."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0df0826-66dd-4964-9794-9fae3920cd8c",
                                                "sense_id": "94d2dbaa-9adf-326c-8f12-170cdff339f2",
                                                "text": "Cake Nogat: This nogat may be made in moulds, or square pieces."
                                            },
                                            {
                                                "example_id": "c6648a68-6ae6-4a71-9c00-2b3a9a083060",
                                                "sense_id": "94d2dbaa-9adf-326c-8f12-170cdff339f2",
                                                "text": "[…](being twenty four and\nnever screwed but in her\nsoft nougat thighs)[…]"
                                            },
                                            {
                                                "example_id": "e934ae1a-282d-4a5a-9d6a-62e77727dbb6",
                                                "sense_id": "94d2dbaa-9adf-326c-8f12-170cdff339f2",
                                                "text": "[…]it helps that Snickers offers the holy trinity of confection: nougat, caramel and peanuts[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b90812cb-93ef-3e29-9c2f-2aa759437eca",
                                        "entry_id": "d643dc4e-6c77-349e-b323-3c2f45e4dc09",
                                        "glosses": [
                                            "A piece of this mixture, typically eaten as a confection."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64162040-5e83-4253-bcc6-44f8a00445bc",
                                                "sense_id": "b90812cb-93ef-3e29-9c2f-2aa759437eca",
                                                "text": "When you make a nougat of large dimensions, put in the almonds a few at a time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1076a976-099b-4ca5-86fc-6f6672bbe4b4",
                        "source_entry_id": "7e628e55-7cad-3be8-80bc-8e3fe77babd1",
                        "source_sense_id": "5a44189f-8996-39c5-9436-5094912be33d",
                        "source_sense_description": "aus zerkleinerten Nüssen, Zucker und Kakao bestehende schokoladenartige Masse",
                        "target_lang_word": "nougat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nougat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccd446b8-1620-3bd9-8580-1dce8ef577cd",
                                        "entry_id": "1e4ea07e-ea37-3a09-964e-ac0152418c61",
                                        "glosses": [
                                            "Confiserie à base de sucre, miel, blanc d’œufs et vanille, garnie d’amandes et de pistaches."
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f34affc3-93f5-4683-b096-6b6b1e44c0b1",
                                                "sense_id": "ccd446b8-1620-3bd9-8580-1dce8ef577cd",
                                                "text": "Louise adorait les nougats aux pistaches, dont une assiette pleine était restée sur le haut du buffet."
                                            },
                                            {
                                                "example_id": "766179e9-d1b5-4892-ac92-b42848ad565d",
                                                "sense_id": "ccd446b8-1620-3bd9-8580-1dce8ef577cd",
                                                "text": "Les dragées étaient connues depuis 1200 à Verdun ; le nougat était apparu en Espagne depuis l’occupation arabe avant de conquérir au XVIIᵉ siècle Montélimar."
                                            },
                                            {
                                                "example_id": "f69a54a9-64a8-442a-95e1-3ebd7caa29d2",
                                                "sense_id": "ccd446b8-1620-3bd9-8580-1dce8ef577cd",
                                                "text": "On a beau être ennemis, c’est tellement bête de se quitter dans ce décor de self-service, parmi les plaques de nougat et les tubes d’Ambre solaire !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "462fd4a0-2ef8-3d30-b66c-fe18e7211249",
                                        "entry_id": "1e4ea07e-ea37-3a09-964e-ac0152418c61",
                                        "glosses": [
                                            "Affaire ou travail facile."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdaf39b1-12f0-4895-af0c-6d2552c37d6e",
                                                "sense_id": "462fd4a0-2ef8-3d30-b66c-fe18e7211249",
                                                "text": "Cette affaire, c’est du nougat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0f21dac-914a-3774-a260-a408b0d4afe3",
                                        "entry_id": "1e4ea07e-ea37-3a09-964e-ac0152418c61",
                                        "glosses": [
                                            "Pieds."
                                        ],
                                        "tags": [
                                            "plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ef7cd52-0165-4e9b-8984-8058a2ddbddb",
                                                "sense_id": "e0f21dac-914a-3774-a260-a408b0d4afe3",
                                                "text": "« Quel tour de taille !… Ah ! dis donc, celui-là, quand il vous marchait sur les nougats ?…"
                                            },
                                            {
                                                "example_id": "4d885084-0854-429d-9f2e-3d7987e82217",
                                                "sense_id": "e0f21dac-914a-3774-a260-a408b0d4afe3",
                                                "text": "Je veux vérifier quelque chose, car j’aime m’assurer de la fermeté du sol sur lequel je pose mes nougats quand j’avance en terrain inconnu."
                                            },
                                            {
                                                "example_id": "86a171cb-009f-462e-963d-a0fcfdc8bb99",
                                                "sense_id": "e0f21dac-914a-3774-a260-a408b0d4afe3",
                                                "text": "Son œil se dérobe, plissé, clignant, fixé sur mes nougats... Sans chaussures et sales mes pieds, je le sais, zut !"
                                            },
                                            {
                                                "example_id": "cd8526b4-81ad-46b2-9467-8787691d0268",
                                                "sense_id": "e0f21dac-914a-3774-a260-a408b0d4afe3",
                                                "text": "Je présente mes nougats au toubib, ils sont dans un drôle d’état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "460fdbd2-5f74-31ff-9999-bbc2b01d7537",
                                        "entry_id": "1e4ea07e-ea37-3a09-964e-ac0152418c61",
                                        "glosses": [
                                            "Fusil."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6859ccc-e120-4f3f-9447-ab9bbbc70aca",
                                                "sense_id": "460fdbd2-5f74-31ff-9999-bbc2b01d7537",
                                                "text": "Le fusil, à l’heure actuelle, s’appelle plaisamment, dans la tranchée, arbalète, lance-pierres, nougat, seringue."
                                            },
                                            {
                                                "example_id": "ffcd0b1a-faed-4353-85e5-a80cbef819a6",
                                                "sense_id": "460fdbd2-5f74-31ff-9999-bbc2b01d7537",
                                                "text": "Le nougat n’a rien de commun avec celui de Montélimar, c’est le fusil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
