                                            {
                                                "example_id": "ad3db616-4b0a-4dc4-b420-726b5476e097",
                                                "sense_id": "b44c8032-1f7a-3e1d-8d40-848276893a8b",
                                                "text": "The critic reviews every new play in London."
                                            },
                                            {
