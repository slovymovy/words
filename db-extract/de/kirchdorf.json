                        "glosses": [
                            "Dorf, in dem sich eine Kirche befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712273b2-3a6d-4efc-9045-cfbc97e5b720",
                                "sense_id": "a7d0539e-84da-3153-bd7a-b5f1b2ce0d0f",
                                "text": "„Kuusamo ist ein Kirchdorf mit 21 000 Einwohnern. Im Ort selbst wohnen vielleicht 7000 Menschen, die anderen leben auf einzelnen Höfen im Umkreis von 40 Kilometern.“"
                            },
                            {
                                "example_id": "a86f3f8f-326e-42bc-98f3-49058ef012b9",
                                "sense_id": "a7d0539e-84da-3153-bd7a-b5f1b2ce0d0f",
                                "text": "„Für viele Flüchtlinge, die an diesem Tag im Kirchdorf ankamen, sollte es zur grausamen Endstation werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
