                                            "A boat that can go underwater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c03c4e4-ae4f-4659-8a5c-4a934d2291bf",
                                                "sense_id": "733a7e84-c1ad-377f-862d-2f1d3beb7cf1",
