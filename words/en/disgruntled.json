{
    "word_family": [
        "disgruntle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03c7b99a-7bd2-3d24-9e8f-5218ef520a4c",
                    "sense_definition": "Unhappy and dissatisfied, often because of unfair treatment or unmet expectations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissatisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>disgruntled</w> employees went on strike to demand better working conditions.",
                            "target_lang_translations": {
                                "zh": "<w>不满的</w>员工们举行了罢工，要求改善工作条件。"
                            }
                        },
                        {
                            "text": "Many <w>disgruntled</w> customers complained about the poor service at the restaurant.",
                            "target_lang_translations": {
                                "zh": "许多<w>不满的</w>顾客投诉了这家餐厅糟糕的服务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dissatisfied",
                        "unhappy",
                        "resentful"
                    ],
                    "antonyms": [
                        "satisfied"
                    ],
                    "common_phrases": [
                        "disgruntled employee",
                        "disgruntled customer"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因受到不公平对待或期望未得到满足而感到不高兴和不满的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不满的",
                                "target_lang_sense_clarification": "形容对现状或待遇感到不满意。"
                            },
                            {
                                "target_lang_word": "不高兴的",
                                "target_lang_sense_clarification": "形容情绪低落或因某事感到不悦。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce735909-6cf1-36a7-b324-f766041ab37f",
                    "sense_definition": "Simple past and past participle of <w>disgruntle</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dissatisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in policy <w>disgruntled</w> the entire staff.",
                            "target_lang_translations": {
                                "zh": "政策的突然改变<w>使</w>全体员工感到<w>不满</w>。"
                            }
                        },
                        {
                            "text": "He felt <w>disgruntled</w> by the lack of communication from management.",
                            "target_lang_translations": {
                                "zh": "由于管理层缺乏沟通，他感到很<w>不满</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb disgruntle."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使……不满，使……不高兴（disgruntle 的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使不满",
                                "target_lang_sense_clarification": "指导致某人产生不满情绪。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}