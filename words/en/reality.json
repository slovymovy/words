                                "target_lang_word": "верность",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "преданность",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忠诚",
                                "target_lang_sense_clarification": "古语用法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e71e25-70ae-3442-9b9b-57821bf9c3fe",
                    "sense_definition": "Realty; real estate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old contract used the word <w>reality</w> to describe the land and buildings.",
                            "target_lang_translations": {
                                "ru": "В старом контракте слово <w>недвижимость</w> использовалось для описания земли и строений.",
                                "zh": "旧合同用“<w>房地产</w>”一词来描述土地和建筑物。"
                            }
                        },
                        {
                            "text": "He invested heavily in <w>reality</w> before the market crashed.",
                            "target_lang_translations": {
                                "ru": "Он вложил значительные средства в <w>недвижимость</w> до обвала рынка.",
                                "zh": "在市场崩盘前，他在<w>房地产</w>上投入了巨资。"
                            }
                        }
