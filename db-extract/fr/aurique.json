            {
                "entry_id": "1991dc5e-0660-34ab-92c6-3f2b4846273c",
                "word": "aurique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "89827e24-aefd-4612-a330-a2f65135167e",
                        "entry_id": "1991dc5e-0660-34ab-92c6-3f2b4846273c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "auriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d41cbcaa-6c20-30bb-98b5-06d1f3f418d0",
                        "entry_id": "1991dc5e-0660-34ab-92c6-3f2b4846273c",
                        "glosses": [
                            "Qualifie une voile qui a quatre côtés ou ralingues, de forme quadrangulaire non symétrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d910788-9a4a-46e0-a735-64daa8de7296",
                                "sense_id": "d41cbcaa-6c20-30bb-98b5-06d1f3f418d0",
                                "text": "La catégorie des voiles auriques comprend les voiles au tiers, les voiles à corne, les voiles houari et les voiles à livarde. Un usage actuel réducteur qualifie à tort de voiles auriques uniquement les voiles à corne."
                            },
                            {
                                "example_id": "da263fc9-ab22-4e03-b8ff-03cbcc65ab5a",
                                "sense_id": "d41cbcaa-6c20-30bb-98b5-06d1f3f418d0",
                                "text": "C'était un bateau déjà ancien, avec la silhouette fine et élancée des goélettes, deux mâts légèrement inclinés en arrière, et deux belles voiles auriques qui claquaient dans le vent."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a79dd917-d172-326b-b0d5-eb7ef078512c",
                "word": "aurique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cff85ffa-bb54-4fdd-920b-26911c98e22e",
                        "entry_id": "a79dd917-d172-326b-b0d5-eb7ef078512c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "auriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff464fd2-3bec-34ea-993b-1b29e078a4dc",
                        "entry_id": "a79dd917-d172-326b-b0d5-eb7ef078512c",
                        "glosses": [
                            "Qui se rapporte à l’or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ec02b8-c32c-4c32-a87f-61cf219b0e09",
                                "sense_id": "ff464fd2-3bec-34ea-993b-1b29e078a4dc",
                                "text": "La néphrite aurique est occasionnée par l’or."
                            },
                            {
                                "example_id": "2e568680-0407-4e6c-8541-dd2f2ed32e3c",
                                "sense_id": "ff464fd2-3bec-34ea-993b-1b29e078a4dc",
                                "text": "Un traitement aurique utilise l’or."
                            }
                        ]
                    },
                    {
                        "sense_id": "7971a893-0281-34b4-8e6c-9492d806c88f",
                        "entry_id": "a79dd917-d172-326b-b0d5-eb7ef078512c",
                        "glosses": [
                            "Se dit des composés où l’or est trivalent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "179c159b-3d04-49c1-b04f-ba39309737f1",
                                "sense_id": "7971a893-0281-34b4-8e6c-9492d806c88f",
                                "text": "Le chlorure ou sel aurique contient de l’or."
                            },
                            {
                                "example_id": "ea4baa31-cfa9-4cf3-bc9c-6f1b61537996",
                                "sense_id": "7971a893-0281-34b4-8e6c-9492d806c88f",
                                "text": "Lorsque celle-ci détecte des ions or (aureux ou auriques), \"Delftia acidovorans\" sécrète tout autour d’elle une protéine, nommée \"delftibactine A\" par les scientifiques."
                            },
                            {
                                "example_id": "c93e0483-7d11-4649-8adc-7100ae72a7d4",
                                "sense_id": "7971a893-0281-34b4-8e6c-9492d806c88f",
                                "text": "L'oxydation de l'or par l'eau est ainsi effective, rendu^([sic]) possible par la diminution du potentiel standard des couples Au(I)/Au et Au(III)/Au par complexation des ions aureux -Au(I)- et aurique -Au(III)- par le cyanure (figure 2)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c42ce62f-9937-3034-8ad5-95d10dfc7266",
                        "entry_id": "a79dd917-d172-326b-b0d5-eb7ef078512c",
                        "glosses": [
                            "Qui se rapporte à l'aura."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027e84c2-9d39-4d2e-8420-803fd080dd95",
                                "sense_id": "c42ce62f-9937-3034-8ad5-95d10dfc7266",
                                "text": "couleur aurique"
                            }
                        ]
                    }
                ],
