                "senses": [
                    {
                        "sense_id": "216bd9c7-fed9-3034-b125-567a7877cb21",
                        "entry_id": "8576dd89-618a-3982-98a3-698509e21680",
                        "glosses": [
                            "(traditionell kalt servierte) Suppe aus pürierten/passierten Lauch- und Kartoffelstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c947bd7-4e36-4c3b-aa1b-094d514145a7",
                                "sense_id": "216bd9c7-fed9-3034-b125-567a7877cb21",
                                "text": "„Dann zählte sie drei namhafte Weine auf und fragte Dean, welchen er zu Ente à l'Orange, Vichyssoise und Lendenbraten servieren würde; […].“"
                            },
                            {
                                "example_id": "93d5faf7-f4a0-4aca-8969-be6dc69928de",
                                "sense_id": "216bd9c7-fed9-3034-b125-567a7877cb21",
                                "text": "„Er vermeidet souverän den üblichen Blödsinn, mit dem sich die Kochmützen-Oberliga den kreativen Anstrich gibt. Das leistet sich der Chef des Wullenwever nur einmal, indem er die geeiste Kartoffelsuppe Vichyssoise als eine Art kühlen Müslibecher serviert.“"
                            },
                            {
                                "example_id": "40b27aec-1e67-4631-a545-eb66874564dc",
                                "sense_id": "216bd9c7-fed9-3034-b125-567a7877cb21",
                                "text": "„Er saß im Schneidersitz auf einem Damastkissen und musterte die bleichen, bebenden Backen mit der Miene eines Feinschmeckers, der in seiner Vichyssoise eine Fliege entdeckt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
