                            {
                                "example_id": "c9399920-0848-40a9-9095-a715b86e79ee",
                                "sense_id": "2803012b-3926-333d-b1b9-bc4db5148576",
                                "text": "Vor allem korinthische Kapitelle wurden mit Akanthus verziert."
