                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb48d6bf-bcf3-4132-8ac3-c98c018c6941",
                                "sense_id": "c6f290f7-b17e-361c-8140-7018e4b335fe",
                                "text": "Il serait possible, par hydrolyse enzymatique, de désacyler sélectivement les colistines A et B, qui conduiraient au même oligodécapeptide [36]."
                            },
                            {
                                "example_id": "da2f15e0-a3a8-4278-b4a3-49ff5384fd07",
                                "sense_id": "c6f290f7-b17e-361c-8140-7018e4b335fe",
                                "text": "Le lysophospholipide est complètement désacylé sous l’action de la phospholipase B qui hydrolyse la fonction ester subsistant dans la molécule."
                            }
                        ]
