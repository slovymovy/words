                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rené",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f905921f-0e00-3211-8dd8-e9bc2140c7f4",
                                        "entry_id": "eda92609-3f91-32b8-bfdc-2bafb9b85942",
                                        "glosses": [
                                            "Participe passé du verbe renaître."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be1db54-6bf0-4b7f-8d06-b4b465547aa1",
                                                "sense_id": "f905921f-0e00-3211-8dd8-e9bc2140c7f4",
                                                "text": "Quand l’un d’eux est mort, sa place reste nécessairement vacante jusqu’à ce qu’on ait appris qu’il est rené dans une famille quelconque."
                                            },
                                            {
                                                "example_id": "0d09a97a-b6c3-48a4-a925-b5af45062a6f",
                                                "sense_id": "f905921f-0e00-3211-8dd8-e9bc2140c7f4",
                                                "text": "Quand un de ces personnages est mort, on attend qu’il renaisse ; sa place reste vacante. Au bout d’un certain temps, on apprend qu’il est rené en tel endroit"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b2aaf8e-d37a-4f20-9a31-eab573c26412",
                        "source_entry_id": "f2075fd1-77e3-3210-996c-19a9ca0a5c0a",
                        "source_sense_description": "revived or regenerated, especially emotionally or spiritually",
                        "target_lang_word": "wiedergeboren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wiedergeboren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2f802ac-a422-300b-8ed8-b60af23d2667",
                                        "entry_id": "ac99d268-0ffa-3139-9c29-3c903e149cdd",
                                        "glosses": [
                                            "ein weiteres Mal geboren werdend"
                                        ],
                                        "tags": [
                                            "Weltanschauung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71267879-10ab-4b85-b16c-0d8201ac6d61",
                                                "sense_id": "a2f802ac-a422-300b-8ed8-b60af23d2667",
                                                "text": "„ ›Um wiedergeboren zu werden‹, sang Gibril Farishta, während er vom Himmel stürzte, ›mußt du erst sterben. Ho ji! Ho ji! Um weich zu landen am Busen der Erde, mußt du erst zum Vogel werden. Tat-Taa! Taka-tan! Um heiter zu genießen, müssen erst Tränen fließen. Wie willst du die Liebe wagen, mein Herr, ohne zu klagen? Baba, willst du wiedergeboren werden …‹ “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c76ff97d-fcc2-33b3-8441-c462eeea2ed4",
                                        "entry_id": "ac99d268-0ffa-3139-9c29-3c903e149cdd",
                                        "glosses": [
                                            "erneut ins Dasein/in Erscheinung getreten"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fabbcdb-cb62-458c-a162-b4de6537b56c",
                                                "sense_id": "c76ff97d-fcc2-33b3-8441-c462eeea2ed4",
                                                "text": "„Schon bald zeigten weitere Beobachtungen, dass das nach seinem Entdecker \"Sakurais Objekt\" getaufte Gestirn […] keine Nova war - sondern ein wiedergeborener Stern.“"
                                            },
                                            {
                                                "example_id": "7143d57f-ebf2-4688-8c8b-607e20e44562",
                                                "sense_id": "c76ff97d-fcc2-33b3-8441-c462eeea2ed4",
                                                "text": "„Diese aus dem Studium der antiken Baudenkmäler wiedergeborene B[aukunst] ist der Renaissancestil […]“"
                                            },
                                            {
                                                "example_id": "8be55a9b-9811-457e-be59-4b32eb573659",
                                                "sense_id": "c76ff97d-fcc2-33b3-8441-c462eeea2ed4",
                                                "text": "„Wer das in Italien in schöner Sinnenlust wiedergeborene, hellenische Heidenthum verstehen lernen will, der lese Ariosto und Aretino!“"
                                            },
                                            {
                                                "example_id": "bde39089-24e0-4578-930a-aa24cae0381f",
                                                "sense_id": "c76ff97d-fcc2-33b3-8441-c462eeea2ed4",
                                                "text": "„Darum argumentierte der amerikanische Botschafter […], daß es in britischen Kreisen eine starke Richtung gäbe, ‚die wünschte, Deutschland als ein Bollwerk gegen Rußland wieder aufzubauen, da sie überzeugt sei, daß der Kommunismus ein größeres Übel bedeute als ein wiedergeborenes Deutschland‘.“"
                                            },
                                            {
                                                "example_id": "797d0530-161a-4f4a-ae88-6cbafa28b22e",
                                                "sense_id": "c76ff97d-fcc2-33b3-8441-c462eeea2ed4",
                                                "text": "„Die ›absolute Philosophie‹ ist die wiedergeborene alexandrinische Philosophie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c41de9ba-6bbf-38cd-929e-6a2927bf0759",
                                        "entry_id": "ac99d268-0ffa-3139-9c29-3c903e149cdd",
                                        "glosses": [
                                            "in neuen spirituellen/religiösen Zustand des Daseins durch einen Akt göttlicher Gnade/Berufung eingetreten"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3adc63-9945-42be-830b-4d2e4e252519",
                                                "sense_id": "c41de9ba-6bbf-38cd-929e-6a2927bf0759",
                                                "text": "„Butcher […], Schwärmerin in England im 16. Jahrh., […] behauptete, daß ein wiedergeborener Mensch zwar äußerlich, aber nicht innerlich sündigen könne; […]“"
                                            },
                                            {
                                                "example_id": "8eaed1d9-7570-4097-8f3a-ac70b90cd7d4",
                                                "sense_id": "c41de9ba-6bbf-38cd-929e-6a2927bf0759",
                                                "text": "„Es kommt nach St[iefel] alles wahre Christenthum nur aus dem lebendigen Worte Gottes oder dem Geiste; aber der aus dem Geiste wiedergeborene Christ erfüllt nun auch das Gesetz Gottes vollkommen; […]“"
                                            },
                                            {
                                                "example_id": "9404c82b-6e2a-4fe2-a0a8-978133bb3735",
                                                "sense_id": "c41de9ba-6bbf-38cd-929e-6a2927bf0759",
                                                "text": "„Der gefallene und nicht wiedergeborene Mensch ist unter der Herrschaft der Sünde und des Satans, […]“"
                                            },
                                            {
                                                "example_id": "d6fe0e95-3b9f-43b6-89b4-549f19c38a8b",
                                                "sense_id": "c41de9ba-6bbf-38cd-929e-6a2927bf0759",
                                                "text": "„[Die Seligkeit] konnte nicht verdient werden, sondern war Gnadengeschenk Gottes, aber nur der nach seinem Gewissen Lebende durfte sich als wiedergeboren ansehen.“"
                                            },
                                            {
                                                "example_id": "483d1cf2-6912-47c4-a862-1d58bb8117c9",
                                                "sense_id": "c41de9ba-6bbf-38cd-929e-6a2927bf0759",
                                                "text": "„Wer an einer Tramstation Leute verprügelt, ist kein wiedergeborener Christ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
