                "senses": [
                    {
                        "sense_id": "82439589-eae1-3688-b7d8-3b7a04a90f62",
                        "entry_id": "164930d0-5db1-3ef9-bf63-c4c93e99a170",
                        "glosses": [
                            "To wallow again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af42a976-13ec-4784-890f-eab867033692",
                                "sense_id": "82439589-eae1-3688-b7d8-3b7a04a90f62",
                                "text": "By the Dog returning to eat what he vomited, and the Sow wash'd rewallowing in the Mire."
                            },
                            {
                                "example_id": "50800296-9e76-48f3-b468-1f07b71ad87d",
                                "sense_id": "82439589-eae1-3688-b7d8-3b7a04a90f62",
                                "text": "That fine flash of sarcasm, rewallowing in a glaze tub, etc., etc., would lead one to suppose that he never did any preliminary work, but that he was predestinated to all those subsequent events which he has set out in his ticket of admission."
                            },
                            {
                                "example_id": "0fb440ad-cdb8-45b2-bb75-8adf6696fbf1",
                                "sense_id": "82439589-eae1-3688-b7d8-3b7a04a90f62",
                                "text": "But he is here . . .taking up again what he had before rejected, and defiling himself in that from which he had been cleansed. . .entangled with their old sins, swallowed down their formerly rejected lusts, and rewallowed in the mire of corruption."
                            }
                        ]
                    }
