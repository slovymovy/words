                        "glosses": [
                            "een deur die bestaat uit een of meerdere houten vlakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de7a8bf2-4657-496c-a4a1-67b06d876bf2",
                                "sense_id": "9485ea2d-208e-3e35-ac2e-534b4510abed",
                                "text": "Een huis dat haar grootvader gebouwd heeft en waarin elke ruimte zijn handtekening draagt in gladgepolijste paneeldeuren, ronde lambrisering, gestucte wanden en bewerkte plafonds."
                            },
                            {
                                "example_id": "e5fdb5ad-995c-456d-bb21-7fba81dc706a",
                                "sense_id": "9485ea2d-208e-3e35-ac2e-534b4510abed",
                                "text": "Het is een huiskamer. Hoge plafonds, ornamenten en een houten paneeldeur. In de hoek is een opstelling gemaakt van decorplaten, twee lichte camera's op statief en twee fauteuils; eentje voor de interviewer en eentje voor de gast. Webcasting vanuit de binnenstad van Istanbul."
                            }
                        ]
                    }
