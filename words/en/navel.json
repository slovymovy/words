                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small village is <w>naveled</w> deep in the green valley.",
                            "target_lang_translations": {
                                "tr": "Küçük köy, yeşil vadinin derinliklerinde <w>yer almaktadır</w>.",
                                "ru": "Небольшая деревня <w>укрылась в самом сердце</w> зелёной долины."
                            }
                        },
                        {
                            "text": "A ancient monastery stood quietly, <w>naveled</w> among the pine trees.",
