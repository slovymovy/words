                            {
                                "example_id": "58927bfb-449d-4371-b80d-c2eeb53c31fe",
                                "sense_id": "4095f1f2-a9c3-3d38-9267-b458d11cf579",
                                "text": "„2012, als Xi Jinping zum Parteichef aufstieg und später auch den Titel des Präsidenten übernahm, stand der Maotai schon einmal kurz vor dem Aus.“"
                            },
                            {
                                "example_id": "822cac06-0415-48ed-a5ff-9738843de601",
                                "sense_id": "4095f1f2-a9c3-3d38-9267-b458d11cf579",
                                "text": "„Maotai steht in China für hochwertigen Baijiu – «weisser Alkohol», der wegen seiner Reinheit selbst bei Konsum in grösseren Mengen keine Kopfschmerzen verursachen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
