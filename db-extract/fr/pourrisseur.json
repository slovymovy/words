                        "entry_id": "a615a419-358c-34a8-8c03-7471ee2c08f3",
                        "glosses": [
                            "Qui provoque le pourrissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208830db-8e37-4737-a8b5-1b8f89dcbf6b",
                                "sense_id": "5b1da3dd-ee86-325c-8751-20aa471391fc",
                                "text": "Mège avait très bien parlé, avec une fureur d’indignation extraordinaire contre la bourgeoisie pourrie et pourrisseuse ; mais, comme toujours, il avait dépassé le but, effrayant la Chambre par sa violence même."
                            }
                        ]
