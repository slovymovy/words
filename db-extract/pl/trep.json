                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b4f68f0-a50b-4457-9041-d467826d3bf8",
                        "source_entry_id": "191e578e-2072-3ba9-ab36-76ec839b73ac",
                        "source_sense_id": "b03f389a-841e-3809-a3de-5980796959fa",
                        "target_lang_word": "Holzschuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holzschuh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cab9ea6e-a14f-3b22-bdce-445e637fdd9b",
                                        "entry_id": "cb27dfe6-58d0-37b1-9622-70d747eb31a7",
                                        "glosses": [
                                            "Schuh, hergestellt aus Holz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e75d430-18b1-4a1f-906e-5530d1e66e11",
                                                "sense_id": "cab9ea6e-a14f-3b22-bdce-445e637fdd9b",
                                                "text": "„Das wenig einschmeichelnde Wort \"Sabotage\" kommt nämlich vom französischen \"sabot\" (Holzschuh des kleinen Bauern) und nach der Überlieferung setzten die in Revolutionszeiten von den \"Seigneurs\" gebeutelten Bauern ihre Holzschuhe - sie heißen auch heute noch sabots - als Protestwerkzeug ein, um mit ihrem ärmlichen Schuhwerk wegen zu hoher Steuern und Abgaben die Ernte der Mächtigen zu zertrampeln.“"
                                            },
                                            {
                                                "example_id": "d3cef72b-d0e5-4b03-a608-a32d07e7c17a",
                                                "sense_id": "cab9ea6e-a14f-3b22-bdce-445e637fdd9b",
                                                "text": "„Elisabeth zog ihre Holzschuhe aus, und der Sand unter ihren Füßen fühlte sich warm an.“"
                                            },
                                            {
                                                "example_id": "1947c61c-9192-4c45-94c0-62abdc080453",
                                                "sense_id": "cab9ea6e-a14f-3b22-bdce-445e637fdd9b",
                                                "text": "„Ein Tuch um den Kopf gewickelt, eine Decke unter dem Arm, Holzschuhe an den Füßen, so hielt sie Einzug in Westerfede.“"
                                            },
                                            {
                                                "example_id": "a5cf6a93-1822-4de6-ba2d-eb2e98ac7e9e",
                                                "sense_id": "cab9ea6e-a14f-3b22-bdce-445e637fdd9b",
                                                "text": "„Die Holzschuhe schurren auf dem Boden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "792ec1e4-a68c-3f94-8018-7ac95eb1339c",
