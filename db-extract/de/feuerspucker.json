                                        "glosses": [
                                            "artiest die vuur uit zijn mond laat komen, vaak ook iemand die brandende toortsen kan doven in zijn mond"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b162059f-a2bc-40d9-98a0-aff5322deaad",
                                                "sense_id": "573f8779-ada8-34d5-9354-ccd504418326",
                                                "text": "De vuurspuwer geeft een zeer spectaculaire voorstelling met grote vlammen, maar het lijkt mij vooral een heel gevaarlijk vak vooral als je het nog moet leren."
                                            },
                                            {
                                                "example_id": "4102548a-2f92-4505-a5b1-38597a92a292",
                                                "sense_id": "573f8779-ada8-34d5-9354-ccd504418326",
                                                "text": "Armin, gekleed in een zilveren trainingsjasje staat als zonnekoning in wisselende decors van wervelende dansers, vuurspuwers en muzikanten, onder wie hiphopproducer en zanger Mr Probz en trompettist Eric Vloeimans."
                                            }
                                        ]
