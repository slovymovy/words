                "senses": [
                    {
                        "sense_id": "376550b4-0972-3dc5-b58a-62d067cb4045",
                        "entry_id": "4392057a-8651-3484-b625-9b4246a45846",
                        "glosses": [
                            "een stof die de elektriciteit slecht of alleen in bepaalde omstandigheden geleidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01bd2d18-329b-4dfd-8aed-e107f23805fe",
                                "sense_id": "376550b4-0972-3dc5-b58a-62d067cb4045",
                                "text": "Voor het proefwerk van woensdag moeten jullie ook enkele toepassingen van halfgeleiders kennen."
                            }
                        ]
                    },
                    {
                        "sense_id": "48efe2d5-9669-387f-b7ec-277ba9311dca",
                        "entry_id": "4392057a-8651-3484-b625-9b4246a45846",
                        "glosses": [
                            "een elektronisch onderdeel dat is opgebouwd uit halfgeleidende materialen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2cef794-5d0a-402f-981d-3581f45b82db",
                                "sense_id": "48efe2d5-9669-387f-b7ec-277ba9311dca",
                                "text": "Om dit toestel weer aan de praat te krijgen, moet u de halfgeleider vervangen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cb13ace-84fe-4cef-8a98-fc52d3caa1d3",
