                    },
                    {
                        "translation_id": "4abc3910-6a6f-4313-8569-bc40e666c97a",
                        "source_entry_id": "eec1da93-c543-3a87-8830-dc4447192457",
                        "source_sense_id": "e65cc526-be00-39a3-ac95-ffb3b39ddc9d",
                        "source_sense_description": "Richtung der Psychologie, die nur das beobachtbare Verhalten untersucht",
                        "target_lang_word": "behaviorism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "behaviorism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9dc61d1-ad65-3d3c-a9c4-c1f554e0ce14",
                                        "entry_id": "bfb164df-8217-3f69-ae0e-0e5e1a039b5c",
                                        "glosses": [
                                            "An approach to psychology focusing on observable behavior which, generally assuming that behavior is determined by the environment and denying any independent significance for mind, largely ignores any pathophysiological processes which may, or may not, underlie subjective, behavioral phenomena."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24db92d4-ae47-4b05-a3ef-ec5237f86e04",
                                                "sense_id": "f9dc61d1-ad65-3d3c-a9c4-c1f554e0ce14",
                                                "text": "Behaviorism is considered by most philosophers of medicine, to be an expression of the weaker, minimalist interpretation of the 'medical model' of clinical psychology because it focuses the study and classification of mental disorders upon a phenomenological, rather than a pathophysiological, approach to the subject."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a2c9c2d-bd0d-4e95-995c-72a370a3e750",
                        "source_entry_id": "eec1da93-c543-3a87-8830-dc4447192457",
                        "source_sense_id": "e65cc526-be00-39a3-ac95-ffb3b39ddc9d",
                        "source_sense_description": "Richtung der Psychologie, die nur das beobachtbare Verhalten untersucht",
                        "target_lang_word": "béhaviorisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béhaviorisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0ab7ac-827a-3bed-87e5-eb900a420707",
                                        "entry_id": "1f43caf6-a829-3695-a36e-e60f5a849d8b",
                                        "glosses": [
                                            "Étude du comportement, rejetant l’introspection, ramenant les conduites à une chaîne de stimulus et de réponses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f529033c-96c8-4a0b-bfea-1c127291b7b8",
                                                "sense_id": "1c0ab7ac-827a-3bed-87e5-eb900a420707",
                                                "text": "Le béhaviorisme s’est développé en réaction aux approches dites « mentalistes »."
                                            },
                                            {
                                                "example_id": "aeb33c5c-4260-4819-9beb-fffa27bfcd93",
                                                "sense_id": "1c0ab7ac-827a-3bed-87e5-eb900a420707",
                                                "text": "L’opposition entre le béhaviorisme et le cognitivisme fera l’objet de notre première sous-section."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
