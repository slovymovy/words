                                "example_id": "f0090d96-8154-492f-bd1b-4eb85a944a53",
                                "sense_id": "e8d26d50-4bc7-3518-805e-0ed5b359d8fa",
                                "text": "Het woord 'huis' is een onzijdig woord."
                            }
                        ]
                    },
                    {
                        "sense_id": "51b2b5fc-7190-3ac9-b0f3-cfa8e8c6ae08",
                        "entry_id": "378954e6-c993-30d5-9114-9832f269d191",
