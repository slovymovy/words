                {
                    "sense_id": "525d3ea8-716c-35f4-b272-f447798df784",
                    "sense_definition": "Dérégler le fonctionnement normal d'un mécanisme, d'un organisme ou d'un système.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dereglement_systeme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'exposition aux écrans tard le soir peut gravement <w>perturber</w> le sommeil.",
                            "target_lang_translations": {
                                "en": "Exposure to screens late at night can seriously <w>disrupt</w> sleep.",
                                "ru": "Пользование экранами поздно вечером может серьёзно <w>нарушить</w> сон.",
                                "de": "Die Nutzung von Bildschirmen spät am Abend kann den Schlaf ernsthaft <w>stören</w>.",
                                "es": "La exposición a pantallas hasta tarde por la noche puede <w>alterar</w> gravemente el sueño.",
                                "zh": "晚上很晚还盯着屏幕看，可能会严重<w>扰乱</w>睡眠。"
                            }
                        },
                        {
                            "text": "Une panne soudaine a commencé à <w>perturber</w> le réseau informatique de l'hôpital.",
                            "target_lang_translations": {
                                "en": "A sudden breakdown has begun to <w>disrupt</w> the hospital's computer network.",
                                "ru": "Внезапная поломка начала <w>нарушать</w> работу компьютерной сети больницы.",
                                "de": "Ein plötzlicher Ausfall hat begonnen, das Computernetzwerk des Krankenhauses zu <w>stören</w>.",
                                "es": "Una avería repentina ha empezado a <w>perturbar</w> la red informática del hospital.",
                                "zh": "一次突发故障开始<w>扰乱</w>医院的计算机网络。"
                            }
                        }
                    ],
                    "synonyms": [
