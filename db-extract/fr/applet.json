                        "sense_id": "6e1d258d-810f-37a6-9b33-2e0109582fb6",
                        "entry_id": "234ddb52-96d0-309b-b77b-df95210c08c0",
                        "glosses": [
                            "Petit programme destiné à effectuer une tâche très précise, généralement conçu pour s’exécuter à l’intérieur d’une autre application ou en interaction avec d’autres applications."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "24154de5-a8ba-4d01-bcf9-8b9de8ae2326",
                                "sense_id": "6e1d258d-810f-37a6-9b33-2e0109582fb6",
                                "text": "Ce banc d'essai compare les performances des environnements d'exécution des applets Java, principalement au niveau des stations clientes. C'est une mesure de l'efficacité de l’implémentation de la JVM (Java Virtual Machine) sur une plate-forme."
                            }
                        ]
                    }
                ],
                "translations": [
