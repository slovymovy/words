                {
                    "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                    "sense_definition": "During the period of time just before the present.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I haven't been sleeping very well <recently>.",
                            "target_lang_translations": {
                                "ru": "Я не очень хорошо сплю <в последнее время>.",
                                "nl": "Ik slaap <de laatste tijd> niet zo best.",
                                "pl": "Nie sypiam zbyt dobrze <w>ostatnio</w>.",
                                "de": "Ich habe <w>in letzter Zeit</w> nicht sehr gut geschlafen.",
                                "fr": "Je ne dors pas très bien <ces derniers temps>.",
                                "it": "Non sto dormendo molto bene <w>ultimamente</w>.",
                                "cs": "<w>V poslední době</w> moc dobře nespím.",
                                "tr": "<w>Son zamanlarda</w> pek iyi uyuyamıyorum.",
                                "es": "No he estado durmiendo muy bien <últimamente>.",
                                "zh": "我<w>近来</w>睡得不太好。"
                            }
                        },
                        {
                            "text": "Until <recently>, they had little interest in buying a new car.",
                            "target_lang_translations": {
                                "ru": "До <недавнего времени> они мало интересовались покупкой новой машины.",
                                "nl": "Tot <kort geleden> hadden ze weinig interesse in het kopen van een nieuwe auto.",
                                "pl": "Do <w>niedawna</w> niewiele interesowali się kupnem nowego samochodu.",
                                "de": "Bis <w>vor kurzem</w> hatten sie wenig Interesse daran, ein neues Auto zu kaufen.",
                                "fr": "Jusqu'à <récemment>, ils s'intéressaient peu à l'achat d'une nouvelle voiture.",
                                "it": "Fino a <w>poco tempo fa</w>, avevano poco interesse ad acquistare una nuova auto.",
                                "cs": "Až do <w>nedávné doby</w> měli malý zájem o koupi nového auta.",
                                "tr": "<w>Yakın zamana</w> kadar yeni bir araba satın almaya pek ilgileri yoktu.",
                                "es": "Hasta <hace poco>, tenían poco interés en comprar un coche nuevo.",
                                "zh": "直到<w>最近</w>，他们对买新车都没什么兴趣。"
                            }
                        }
