                "senses": [
                    {
                        "sense_id": "96e8aad6-2bbf-35d6-94f3-cd0e7e5df557",
                        "entry_id": "def27045-7476-348d-a23e-5c937c0d5f1b",
                        "glosses": [
                            "past participle of be."
                        ],
                        "tags": [
                            "form-of",
