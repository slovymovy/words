                "senses": [
                    {
                        "sense_id": "e9fa8898-b35b-3ff5-b36f-cc84efe1d1ad",
                        "entry_id": "1d396c60-2463-34d4-9a55-954b905ca88b",
                        "glosses": [
                            "Lieu de diffusion, de conservation, de documentation, de préservation, de restauration et de mise en valeur du patrimoine sur support vidéo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20840cff-a6ff-41ac-80fd-f2a94e04e6cf",
                                "sense_id": "e9fa8898-b35b-3ff5-b36f-cc84efe1d1ad",
                                "text": "Divers projets de vidéothèque illustrent l’importance actuelle de cette question, notamment ceux, en voie de réalisation, de la vidéothèque de Paris (association loi de 1901, depuis janvier 1980), de la vidéothèque de Chaillot …"
                            },
                            {
                                "example_id": "e2c7cf33-6b4e-49f9-be50-87559684ac30",
                                "sense_id": "e9fa8898-b35b-3ff5-b36f-cc84efe1d1ad",
                                "text": "Le service de documentation se tient également au courant de l’existence de films susceptibles d’intéresser la vidéothèque et entretient un contact avec les professionnels de l’audiovisuel, à la faveur par exemple du festival de films d’entreprises de Biarritz."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e6f6bec-a178-3c74-8803-a87eb3f61a28",
                        "entry_id": "1d396c60-2463-34d4-9a55-954b905ca88b",
                        "glosses": [
                            "Collection de documents vidéo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3d41b7-1629-4866-8d51-c89bc58821b4",
                                "sense_id": "8e6f6bec-a178-3c74-8803-a87eb3f61a28",
                                "text": "Haj Garne approvisionnait en prostituées quatre bordels de luxe, avait des abonnés parmi les autorités et entretenait une véritable vidéothèque porno pour les faire chanter."
                            },
                            {
                                "example_id": "2c5a3ef0-5f8d-4ac5-ab08-ebd6576ee49b",
                                "sense_id": "8e6f6bec-a178-3c74-8803-a87eb3f61a28",
                                "text": "Entre ces deux extrêmes on trouve tous les cas de figure : ainsi, un quart de ceux qui ont une vidéothèque d’au moins 30 cassettes vidéo ne s’en servent pratiquement pas pour revoir un film …"
                            }
                        ]
                    }
