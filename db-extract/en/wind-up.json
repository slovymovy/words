                        "target_lang_word": "Streich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7fce809-e7e1-313c-8b50-3dfc35f20870",
                                        "entry_id": "7251f30d-c663-30b4-b1d6-ec98f11b6d9f",
                                        "glosses": [
                                            "das Hereinlegen einer Person zum Zwecke der Belustigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559ae88a-a05c-43f4-9e94-9444aee25ff8",
                                                "sense_id": "c7fce809-e7e1-313c-8b50-3dfc35f20870",
                                                "text": "Die Schüler spielten dem Lehrer einen Streich, als sie ihm Zahnpaste unter die Türklinke schmierten."
                                            },
                                            {
                                                "example_id": "5cfbadb0-669e-4296-b99a-5b61505eea9d",
                                                "sense_id": "c7fce809-e7e1-313c-8b50-3dfc35f20870",
                                                "text": "Jemandem Reißzwecken auf den Stuhl zu legen ist ein übler Streich, über den bestimmt niemand lachen kann."
                                            },
                                            {
                                                "example_id": "97c718d6-3d11-408b-8251-bcb5f6d69ec5",
                                                "sense_id": "c7fce809-e7e1-313c-8b50-3dfc35f20870",
                                                "text": "Wilhelm Busch erdachte die Streiche von Max und Moritz."
                                            },
                                            {
                                                "example_id": "589b391b-7ad0-4620-b7a2-500b31f6cafe",
                                                "sense_id": "c7fce809-e7e1-313c-8b50-3dfc35f20870",
                                                "text": "„Dieser Veyras war der beste Freund, den ich im Kolleg hatte, das heißt, er half mir bei allen Streichen, die oft auf seine Erfindung zurückgingen.“"
                                            },
                                            {
                                                "example_id": "6194f93b-c385-45d3-af01-eacd7ce7a185",
                                                "sense_id": "c7fce809-e7e1-313c-8b50-3dfc35f20870",
                                                "text": "„Wir haben uns gegenseitig Streiche gespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "96ca0d9a-a03e-301f-97e7-b5e2e5337132",
                                        "entry_id": "7251f30d-c663-30b4-b1d6-ec98f11b6d9f",
                                        "glosses": [
                                            "Schlag, Treffer"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "051bd3d2-c722-4a0a-b39f-5773734979d8",
                                                "sense_id": "96ca0d9a-a03e-301f-97e7-b5e2e5337132",
                                                "text": "Bist du so ein Kerl? sprach er und mußte selbst seine Tapferkeit bewundern[…] Sieben auf einen Streich! (Gebrüder Grimm, Das tapfere Schneiderlein)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c636ef3-7cad-41c0-91e1-8c956c8537b2",
                        "source_entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "source_sense_description": "humorous attempt to fool somebody",
                        "target_lang_word": "Schabernack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schabernack",
