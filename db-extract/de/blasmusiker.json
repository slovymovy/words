                "senses": [
                    {
                        "sense_id": "37dd8fa2-94e3-327a-a303-70017b5efffb",
                        "entry_id": "1529e5fd-25e7-38fe-9f2f-d39214827bcc",
                        "glosses": [
                            "Person, die ein Blasinstrument spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "242e3b75-7ad8-4e04-bd00-da5e73ef2c1a",
                                "sense_id": "37dd8fa2-94e3-327a-a303-70017b5efffb",
                                "text": "„Das Werk für 120 Blasmusiker und das Roma-Ensemble Harri Stojka ist eine in dieser Form einmalige musikalische Auseinandersetzung mit dem Nazi-Terror und den Kriegsgräueln.“"
                            },
                            {
                                "example_id": "cae1eb91-556e-40a3-8adf-ba2bbe18b0bd",
                                "sense_id": "37dd8fa2-94e3-327a-a303-70017b5efffb",
                                "text": "„Der Auftritt der Blasmusiker mit Walzer, Polka, Marsch, Opernstücken und symphonischer Musik ist ein Besuchermagnet.“"
                            },
                            {
                                "example_id": "1f9b6cea-8e4b-43bd-a26b-bc7d8b4b5ccc",
                                "sense_id": "37dd8fa2-94e3-327a-a303-70017b5efffb",
                                "text": "„Um die Gruppe finanzieren zu können, gründete man im gleichen Jahr den Förderverein, der hauptsächlich aus Eltern der jungen Blasmusiker bestand.“"
                            },
                            {
                                "example_id": "6e54384a-89b2-4ac5-9a42-29681a7e0fbf",
                                "sense_id": "37dd8fa2-94e3-327a-a303-70017b5efffb",
                                "text": "„Rund 400 Blasmusiker haben sich am Samstag vor dem Festspielhaus versammelt, um für den Erhalt der Militärmusik zu demonstrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
