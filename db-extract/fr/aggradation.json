                        "glosses": [
                            "Accumulation de sédiments au fond d’un cours d’eau, d’un sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05ced819-61e0-4103-a38d-8cf8c79cf58a",
                                "sense_id": "779f103d-9ac8-3db5-bb00-cdb4e60dd28d",
                                "text": "Le passage de la convexité à la concavité dénote « un renversement des processus » : la dégradation dans le haut fait place à l’aggradation (accumulation) dans le bas [c’est-à-dire que la portion basse du versant serait couverte par une épaisseur croissante de débris et ainsi préservée de toute dégradation ultérieure."
                            }
                        ]
                    },
