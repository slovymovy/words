                        "sense_id": "9dca31e3-cf6c-3492-80b2-6a2ef35ba4cc",
                        "entry_id": "5eed05b3-d9a1-30a8-9ce6-8755d33f6073",
                        "glosses": [
                            "enganliegendes, strumpfartiges Beinkleid, das eine Einheit aus Hose und beiden Strümpfen (ohne Fußteil) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6dab88-d4f9-4e1e-b53b-7d14042b52e6",
                                "sense_id": "9dca31e3-cf6c-3492-80b2-6a2ef35ba4cc",
                                "text": "„Mädchen in knallengen Leggins und silbrigen Plateauschuhen flanierten vorüber und zogen die Blicke der Männer auf sich.“"
                            },
                            {
                                "example_id": "6bd643e9-18b0-4577-891e-09f9e4f4e728",
                                "sense_id": "9dca31e3-cf6c-3492-80b2-6a2ef35ba4cc",
                                "text": "„Nach Sitte der Hinterwäldler war er in ein baumwollenes Jagdhemd mit Fransen, Ledergamaschen, sogenannte Leggins, und grobe Schuhe gekleidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
