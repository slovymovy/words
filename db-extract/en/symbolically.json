                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "215295a5-0c0c-4d32-8451-c16dad8eba73",
                                "sense_id": "b65cbd09-7d2e-3cac-90d8-f30fc1f9c32e",
                                "text": "Haha, memes are funny! Until they totally become racist. Pepe the Frog lived a very normal meme life right up until online trolls turned him into a green thing of hate in 2016. It got so bad his creator symbolically killed him off in 2017."
                            }
                        ]
                    },
                    {
                        "sense_id": "abb58797-927a-30b0-b8a5-39193225ee5c",
                        "entry_id": "0d576970-3b7d-3a2a-9b5a-4ab89645f206",
                        "glosses": [
                            "By means of symbols or a symbol."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aafa24b0-0f5c-3c0a-b23e-2b127a344878",
                        "entry_id": "0d576970-3b7d-3a2a-9b5a-4ab89645f206",
                        "glosses": [
                            "As symbols or a symbol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16134501-1186-4128-8bf2-362e1968358e",
                                "sense_id": "aafa24b0-0f5c-3c0a-b23e-2b127a344878",
                                "text": "In the end, the deadlock was resolved by a minor -- but for the National Party symbolically important -- addition to one of the other subsections of the language clause."
                            }
                        ]
                    }
