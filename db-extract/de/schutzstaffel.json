                        "examples": [
                            {
                                "example_id": "365d541d-d616-484e-b0f2-42fff1be4167",
                                "sense_id": "95b60e20-df00-346f-9053-63a26d6f290e",
                                "text": "„Am 22. Februar werden SA (Sturmabteilung), SS (Schutzstaffel) und die Stahlhelmverbände zur Hilfspolizei erklärt.“"
                            },
                            {
                                "example_id": "423667e5-d0d4-4e81-9a5a-819b6a9cede1",
                                "sense_id": "95b60e20-df00-346f-9053-63a26d6f290e",
                                "text": "„In der Zeit des Nationalsozialismus war die Schutzstaffel maßgeblich am Holocaust beteiligt und wurde nach 1945 als verbrecherische Organisation verboten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
