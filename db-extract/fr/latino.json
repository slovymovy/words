                "senses": [
                    {
                        "sense_id": "f30ce07f-3363-309d-bc3c-10de4b747a6c",
                        "entry_id": "7a376b92-2fb5-3eea-bd11-675e9aff10a3",
                        "glosses": [
                            "Latino-Américain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "941dab0b-8a96-44e5-b980-5432e2d79082",
                                "sense_id": "f30ce07f-3363-309d-bc3c-10de4b747a6c",
                                "text": "Aux États-Unis, les Latinos sont tous des Mexicains (Honduriens, Salvadoriens, Nicaraguayens compris, etc.), comme tous les Blancs sont des gringos au Mexique."
                            },
                            {
                                "example_id": "9b37301d-875c-4811-8d0e-dd5674a9e239",
                                "sense_id": "f30ce07f-3363-309d-bc3c-10de4b747a6c",
                                "text": "Vanessa Faura, une Péruvienne naturalisée qui s’est également exprimée à la convention républicaine, affirme que les Latino-Américains ne se sentent parfois pas mieux lotis que dans les pays qu’ils ont quittés. Par ailleurs, de nombreux Latinos, souvent catholiques, se sentent davantage en phase avec les valeurs du Parti républicain."
                            }
                        ]
                    }
