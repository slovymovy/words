                                        "sense_id": "13aec452-2ce7-3021-92d4-06bb05371650",
                                        "entry_id": "1a8f8684-e9ab-368e-8f7f-94bc2f638bb9",
                                        "glosses": [
                                            "Ausdruck zur Erzielung kurzer Sprechpausen, Ausruf des Nachdenkens"
                                        ],
                                        "tags": [
                                            "mündliches Füllwort",
                                            "Gesprächspartikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "875f06ed-b079-41f2-b88d-ed8a25561ded",
                                                "sense_id": "13aec452-2ce7-3021-92d4-06bb05371650",
                                                "text": "Äh, das weiß ich jetzt gar nicht. Moment, ich schau nach."
                                            },
                                            {
                                                "example_id": "1443a3e1-738e-416b-9c1e-d0943b7d273f",
                                                "sense_id": "13aec452-2ce7-3021-92d4-06bb05371650",
                                                "text": "Das – äh – wollte ich noch sagen."
                                            },
                                            {
                                                "example_id": "38dc46c9-ea63-4877-87d7-91d4d365bd5f",
                                                "sense_id": "13aec452-2ce7-3021-92d4-06bb05371650",
                                                "text": "Ein unmotiviertes äh wird auch heute noch als rhetorisch negativ und unhöflich empfunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89fdd103-eeb2-31bc-abbf-e43f8349715b",
                                        "entry_id": "1a8f8684-e9ab-368e-8f7f-94bc2f638bb9",
                                        "glosses": [
                                            "Ausdruck, Ausruf des Ekels, des Angewidertseins, der Abscheu, der Ablehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726e8708-7b17-4dcf-b5a3-821838714738",
                                                "sense_id": "89fdd103-eeb2-31bc-abbf-e43f8349715b",
                                                "text": "„Äh, du Schwein! Kommst mit dreckigen Schuhen in meine saubere Wohnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
