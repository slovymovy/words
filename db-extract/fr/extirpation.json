                "senses": [
                    {
                        "sense_id": "3bc9ef28-f212-389d-a621-2d17e95b73d4",
                        "entry_id": "c41e45ef-ee15-356a-87b5-3d3a28f858c7",
                        "glosses": [
                            "Action d’extirper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d16764-b421-4229-94d3-b2d822467b75",
                                "sense_id": "3bc9ef28-f212-389d-a621-2d17e95b73d4",
                                "text": "L’extirpation d’une souche, d’une racine."
                            },
                            {
                                "example_id": "75184784-fee2-45be-ad52-6f9f050284c5",
                                "sense_id": "3bc9ef28-f212-389d-a621-2d17e95b73d4",
                                "text": "L’extirpation d’un cancer, d’une loupe, d’un polype."
                            },
                            {
                                "example_id": "d54d5a25-b407-4165-a60f-d415de8df518",
                                "sense_id": "3bc9ef28-f212-389d-a621-2d17e95b73d4",
                                "text": "L’anus iliaque pratiqué chez son malade fut complété ensuite par une extirpation périnéo-coccygienne avec une amélioration telle (néorectum souple, muqueuse de coloration normale au rectoscope) que Toupet put refermer l’anus iliaque."
                            }
                        ]
                    },
                    {
                        "sense_id": "70c4d4d7-5110-34fe-bf9e-c3ee5510ac5b",
                        "entry_id": "c41e45ef-ee15-356a-87b5-3d3a28f858c7",
                        "glosses": [
                            "Éradication."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "189709d9-ef31-4ad0-ba6d-7e335cf9e16b",
                                "sense_id": "70c4d4d7-5110-34fe-bf9e-c3ee5510ac5b",
                                "text": "L’extirpation des abus, des hérésies."
                            },
                            {
                                "example_id": "1ca4865d-4003-43d5-8c07-692fe6ac5236",
                                "sense_id": "70c4d4d7-5110-34fe-bf9e-c3ee5510ac5b",
                                "text": "L’extirpation en écologie évolutive, paléoécologie, il s'agit d'une extinction locale dans une métapopulation, disparition d'un dème."
                            }
                        ]
                    }
