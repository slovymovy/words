                    "frequency": "Low",
                    "semantic_group_id": "campagne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier a fabriqué un banc <w>rustique</w> à partir de branches de bouleau non écorcées."
