                        "entry_id": "c270f53f-5e4f-3452-bc4c-9f45876705c9",
                        "glosses": [
                            "Relatif aux francophones de la province canadienne de la Saskatchewan, aux habitants à la langue ou à la culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1390880c-a609-44ba-80ef-e2324dc2f9c1",
                                "sense_id": "9106a5bc-9877-32a7-a205-6d5faa22287e",
                                "text": "Afin d’assurer l’inclusion des communautés ethniques au sein même de la communauté, la province a mis sur pied en 2006 une commission sur l’inclusion de la communauté fransaskoise."
                            }
                        ]
                    }
