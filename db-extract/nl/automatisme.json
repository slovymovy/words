                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bb19635-dcc2-36e5-9b27-fdce835e6f50",
                        "entry_id": "514568bc-ced0-3c6b-883d-4e3035999482",
                        "glosses": [
                            "onwillekeurig plaatshebbende handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f154aa4f-b5c3-43b1-8e66-4e6688f40a82",
                                "sense_id": "5bb19635-dcc2-36e5-9b27-fdce835e6f50",
                                "text": "Wat voorheen als een automatisme gold, was nu een hele onderneming op zich."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cfb17f0-c16e-471e-8bb9-b4e8d9fdd60d",
                        "source_entry_id": "514568bc-ced0-3c6b-883d-4e3035999482",
                        "source_sense_id": "5bb19635-dcc2-36e5-9b27-fdce835e6f50",
                        "target_lang_word": "Automatismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Automatismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39034533-b1d5-3003-8f7e-11b3c87206c4",
                                        "entry_id": "072a51e6-7529-32ef-9045-40350d1a3b33",
                                        "glosses": [
                                            "Tätigkeit ohne Beeinflussung durch das zentrale Nervensystem (ZNS)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95d2082d-1f60-4838-9b8f-23fbae36701e",
                                                "sense_id": "39034533-b1d5-3003-8f7e-11b3c87206c4",
                                                "text": "„Unser Gehirn verfügt über einen Automatismus, der alles, was er wahrnimmt, zuerst in \"gut\" oder \"schlecht\" einteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38399091-61e0-397c-9446-dfa28676c27e",
                                        "entry_id": "072a51e6-7529-32ef-9045-40350d1a3b33",
                                        "glosses": [
                                            "Vorgang oder Handlung, der oder die spontan und ohne Beeinflussung durch das Bewusstsein oder den Willen abläuft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ace199-dfc5-4466-8746-6b7335fd73d6",
                                                "sense_id": "38399091-61e0-397c-9446-dfa28676c27e",
                                                "text": "„In der Biologie unterscheidet man angeborene Automatismen, wie Herzschlag (Herz), Atmung, Instinkthandlungen (Instinkt), die nicht vom Bewußtsein oder Willen beeinflußt werden, und erlernte Automatismen, Handlungsweisen wie Gehen, Laufen (Bewegung, Bewegungslernen).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "971c6e62-5558-3f5d-94bd-b1bec4c27783",
                                        "entry_id": "072a51e6-7529-32ef-9045-40350d1a3b33",
                                        "glosses": [
                                            "Tätigkeit, die nicht vom Bewusstsein gesteuert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa08151-1722-4fcb-a7d0-4c0ac9fb2674",
                                                "sense_id": "971c6e62-5558-3f5d-94bd-b1bec4c27783",
                                                "text": "„Häufig imitieren wir unbewusst die Sprache, Mimik oder Gestik anderer Menschen. Dieses Verhalten ist ein nützlicher Automatismus im sozialen Miteinander, denn es lässt uns sympathischer erscheinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "93539a90-e42f-3689-bca5-289cd8c4eeb6",
                                        "entry_id": "072a51e6-7529-32ef-9045-40350d1a3b33",
                                        "glosses": [
                                            "Mechanismus, der von einem Programm oder selbst gesteuert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbd7cd2-0cdb-47ef-bec8-e86ddb7a278f",
                                                "sense_id": "93539a90-e42f-3689-bca5-289cd8c4eeb6",
                                                "text": "„Neben den von Spielern gehosteten Spielen gibt es einen Automatismus, der dem Spieler hilft, entsprechend seinem Niveau passende Mitspieler zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf67e4ad-94c1-4845-9fd0-f1923593190a",
                        "source_entry_id": "514568bc-ced0-3c6b-883d-4e3035999482",
                        "source_sense_id": "5bb19635-dcc2-36e5-9b27-fdce835e6f50",
                        "target_lang_word": "automatisme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "21dc0c87-7e0b-4f23-8b72-d89e52cee613",
                        "source_entry_id": "514568bc-ced0-3c6b-883d-4e3035999482",
                        "source_sense_id": "5bb19635-dcc2-36e5-9b27-fdce835e6f50",
                        "target_lang_word": "automatisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automatisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dabf8187-b349-3eac-9a82-9bb389604405",
                                        "entry_id": "96f58066-53bd-3a79-8f03-7fca70f5f200",
                                        "glosses": [
                                            "Ce qui se fait automatiquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee6279a-7930-4814-b22a-7802af9ba966",
                                                "sense_id": "dabf8187-b349-3eac-9a82-9bb389604405",
                                                "text": "Toutes les idées ne peuvent éviter l’automatisme et l’inconscience finale que par leur renouvellement continuel, par les modifications qui les rajeunissent, par les emplois nouveaux qu’elles s’essaient à remplir, enfin par le défaut d’équilibre général de l’esprit."
                                            },
                                            {
                                                "example_id": "ce802c30-2509-4e95-964a-a513221dd739",
                                                "sense_id": "dabf8187-b349-3eac-9a82-9bb389604405",
                                                "text": "Donner des démentis est à la portée du premier imbécile venu. C'est une forme de l’idémisme, de l’automatisme mental. Mais réfuter une objection ! Voilà qui n'est pas votre fait."
                                            },
                                            {
                                                "example_id": "4875f747-fcfa-4e0f-8482-b47884d12772",
                                                "sense_id": "dabf8187-b349-3eac-9a82-9bb389604405",
                                                "text": "La bêtise, elle, est une question d’automatisme. « Le sot est automate. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ef16cd-6e48-30ed-ac4c-760ce41b9fee",
                                        "entry_id": "96f58066-53bd-3a79-8f03-7fca70f5f200",
                                        "glosses": [
                                            "Processus automatisé, ou précisément son système de contrôle automatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc960ff-1308-4479-a1f2-c77cc04f1053",
                                                "sense_id": "14ef16cd-6e48-30ed-ac4c-760ce41b9fee",
                                                "text": "L’automatisme poussé de la chaîne d'assemblage nous empêchait de réagir à tout imprévu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8bfbcb0-a6a1-30a8-bdbe-c5c9b4d526b2",
                                        "entry_id": "96f58066-53bd-3a79-8f03-7fca70f5f200",
                                        "glosses": [
                                            "(aussi au pluriel) La technologie de l’automatisation, des processus automatisés en général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed2417de-7f9a-47ec-9c2d-35d916a1a3e2",
                                                "sense_id": "d8bfbcb0-a6a1-30a8-bdbe-c5c9b4d526b2",
                                                "text": "Une formation en automatisme industriel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4db3e098-02c3-3aac-bcc6-ae2d94add8c8",
                                        "entry_id": "96f58066-53bd-3a79-8f03-7fca70f5f200",
                                        "glosses": [
                                            "Accès de névropathies qui, pendant un certain temps, obéissent à une impulsion irrésistible de voyager."
                                        ],
                                        "tags": [],
                                        "note": "On l’appelle ordinairement automatisme ambulatoire",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "247b333c-fa48-323b-9080-999f9626f982",
                                        "entry_id": "96f58066-53bd-3a79-8f03-7fca70f5f200",
                                        "glosses": [
                                            "Partie d’une machine, destinée à remplacer l’être humain dans des tâches simples et répétitives."
                                        ],
                                        "tags": [],
                                        "note": "On préfère le terme automate",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c40795f-8996-3942-abce-88d79d99f3bc",
                                        "entry_id": "96f58066-53bd-3a79-8f03-7fca70f5f200",
                                        "glosses": [
                                            "Mouvement artistique québécois fondé en 1942 par Paul-Émile Borduas préconisant une approche intuitive expérimentale non représentative conduisant à un renouvellement en profondeur du langage artistique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a413f97-abbb-4565-96b2-7f9d04399fd5",
                                                "sense_id": "6c40795f-8996-3942-abce-88d79d99f3bc",
                                                "text": "Pratiquer l'automatisme, c'est laisser les mots jaillir spontanément de la pensée hors de toute préméditation, et se livrer totalement à leur pouvoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50a3d502-504b-3665-8720-6fe3d6718c33",
                                        "entry_id": "96f58066-53bd-3a79-8f03-7fca70f5f200",
                                        "glosses": [
                                            "Action sans conscience rationnelle."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "898b581b-2959-4ced-afcc-8bae3b7b2991",
                                                "sense_id": "50a3d502-504b-3665-8720-6fe3d6718c33",
                                                "text": "Au Canada, on définit en droit criminel l'automatisme comme un état d'esprit dans lequel la personne est dans un état psychotique, qui l'empêche de discerner le bien du mal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
