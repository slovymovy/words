                        ],
                        "examples": [
                            {
                                "example_id": "6af35f48-61f2-4570-bae5-e179bf87ec9b",
                                "sense_id": "a5140aac-cdcb-3e7b-93ec-213dba6dea58",
                                "text": "Dans leurs cadres, Kosciuszko et Bonaparte voient avec soulagement les danseurs s’alanguir, les zingarelles lisser d’une main leurs jupes et leurs longues chevelures : quoi, déjà l’aube ?"
                            },
                            {
                                "example_id": "4be808ad-e84f-4743-9266-79ebdb14ef92",
                                "sense_id": "a5140aac-cdcb-3e7b-93ec-213dba6dea58",
                                "text": "La Zingarelle, usée par la vie errante et la fièvre des marais, sans passer par la jeunesse ni la beauté, était arrivée d’un pas rapide à la vieillesse."
                            }
                        ]
                    }
