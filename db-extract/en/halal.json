                                "target_senses": [
                                    {
                                        "sense_id": "9cefdc3c-c233-3114-b980-061780579b8d",
                                        "entry_id": "c1710a6b-ae12-3b22-9fb0-abb5d806e415",
                                        "glosses": [
                                            "nach islamischem Glauben erlaubt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b860421f-b473-4245-a982-1318e4ba1055",
                                                "sense_id": "9cefdc3c-c233-3114-b980-061780579b8d",
                                                "text": "Woraufhin die Medien aufklärten: Ja, in vielen Schlachtereien wird Fleisch verkauft, das halal ist, ohne dass die Kunden davon wissen."
                                            },
                                            {
                                                "example_id": "d20dc829-0e07-4eb0-a902-7424d1710e21",
                                                "sense_id": "9cefdc3c-c233-3114-b980-061780579b8d",
                                                "text": "Hier kann man angeben, ob man sehr religiös, durchschnittlich oder \"nicht so religiös\" ist. Ob man Kopftuch beziehungsweise Bart trägt, ob die Essgewohnheiten halal sind und wie man zum Thema Polygamie steht."
                                            },
                                            {
                                                "example_id": "4a5954d0-c7d1-403a-ab85-aac964cce337",
                                                "sense_id": "9cefdc3c-c233-3114-b980-061780579b8d",
                                                "text": "„Der afghanische Koch versicherte jedermann, dass er die Lämmer eigenhändig geschlachtet habe und alles in seinem Zelt halal sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
