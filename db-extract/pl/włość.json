                    },
                    {
                        "sense_id": "bf92edc3-be1c-3cde-a4a2-86e2618bf245",
                        "entry_id": "7c122dba-d9af-3da8-9b1f-cb4c88afb6e0",
                        "glosses": [
                            "jednostka administracyjna w Wielkim Księstwie Litewskim, Rosji i do r. 1929 w ZSRR"
                        ],
                        "tags": [],
