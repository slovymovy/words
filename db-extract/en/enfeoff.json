                                            {
                                                "example_id": "52496503-2211-4b5e-9da5-25684b5ec073",
                                                "sense_id": "fc730f4f-ec1c-3ae7-9e36-b8e75ea63502",
                                                "text": "… 1,2 Prozent des Bruttoinlandsprodukts (BIP) investiert der französische Staat jährlich in die Betreuung von Kindern bis sechs Jahren, die Hälfte der Ausgaben für unter Zweijährige. Deutschland läßt sich die Kinderbetreuung gerade einmal 0,5 Prozent des BIP kosten."
                                            },
                                            {
                                                "example_id": "9ec40906-d604-44f1-98d9-3e0bbdca2b28",
                                                "sense_id": "fc730f4f-ec1c-3ae7-9e36-b8e75ea63502",
                                                "text": "Deutschland gibt 4,2 Prozent seines Bruttoinlandsproduktes für Bildungsinvestitionen aus, die OECD-Staaten investieren im Durchschnitt mit 4,8 Prozent klar mehr."
                                            },
                                            {
                                                "example_id": "4adf2f3e-3e90-47fa-851e-ab739adc95e0",
                                                "sense_id": "fc730f4f-ec1c-3ae7-9e36-b8e75ea63502",
                                                "text": "Nach dem Immobilienboom vor einigen Jahren gibt es in Spanien noch immer leer stehenden Wohnraum. Damals war es regelrecht Mode, in Immobilien zu investieren."
                                            },
                                            {
                                                "example_id": "55e6bb29-522c-4715-8e5b-67c3d430f5fc",
                                                "sense_id": "fc730f4f-ec1c-3ae7-9e36-b8e75ea63502",
                                                "text": "Vor der Finanz- und Wirtschaftskrise hatte das Land [Portugal] in den massiven Ausbau seines Autobahnnetzes investiert. Doch andere Infrastrukturprojekte, wie ein neuer Großflughafen oder schnellere Zugverbindungen nach Spanien, wurden nicht umgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20ef0db2-3484-3ec2-99ca-bed6f6486384",
                                        "entry_id": "2b5481dd-cff1-3f26-9460-85acc4e8f115",
                                        "glosses": [
                                            "einen bestimmten Aufwand treiben, um etwas zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6474409e-55cd-4ea9-a10e-a5030c11d5b4",
                                                "sense_id": "20ef0db2-3484-3ec2-99ca-bed6f6486384",
                                                "text": "„Die internationale Energieagentur (IEA) sagt, dass bis 2030 weltweit doppelt so viel in erneuerbare Energien investiert werden müsste, um die Ziele des Pariser Klimaabkommens zu erreichen.“"
                                            },
                                            {
                                                "example_id": "338efba0-d487-48b9-94c6-baccd31fff7b",
                                                "sense_id": "20ef0db2-3484-3ec2-99ca-bed6f6486384",
                                                "text": "„Es ist beeindruckend, dass Frauen mehr Zeit investieren als Männer, um für sich den richtigen Rechner zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "351eed6f-6148-3613-9909-dae65edebea9",
                                        "entry_id": "2b5481dd-cff1-3f26-9460-85acc4e8f115",
                                        "glosses": [
                                            "jemanden in ein (meist geistliches) Amt einsetzen, jemanden mit der Amtswürde belehnen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c082b8-7b3e-4988-b404-e091acbe6d03",
                                                "sense_id": "351eed6f-6148-3613-9909-dae65edebea9",
                                                "text": "„Als Heinrich schließlich noch zwei weitere Bischöfe in Spoleto und Fermo, welche mitten im Kirchenstaat lagen, investierte, eskalierte die Situation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
