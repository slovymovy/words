                        "sense_id": "cb15bb23-2561-3e47-b012-2498382d12cc",
                        "entry_id": "ab2d6851-0884-3888-ad82-d22ad9f240a6",
                        "glosses": [
                            "A male given name from the Germanic languages; in modern use partly transferred back from the surname."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "3685c614-f1c2-4c9c-b7ec-38deb3be1f5d",
                                "sense_id": "cb15bb23-2561-3e47-b012-2498382d12cc",
                                "text": "At Coventry, upon Saint Lambert's day:\nThere shall your swords and lances arbitrate\nThe swelling difference of your settled hate"
                            }
                        ]
                    },
                    {
                        "sense_id": "df214af6-a04d-32ab-b9c1-58b448aed87f",
                        "entry_id": "ab2d6851-0884-3888-ad82-d22ad9f240a6",
                        "glosses": [
                            "A surname originating as a patronymic."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f7138db-1f48-41a5-8a61-c123023f8f0e",
                                "sense_id": "df214af6-a04d-32ab-b9c1-58b448aed87f",
                                "text": "Life on Martha’s Vineyard has been mostly ideal for 11-year-old Mary Elizabeth Lambert, the protagonist of Ann Clare LeZotte’s historical novel SHOW ME A SIGN (Scholastic, 288 pp., $18.99; ages 8 to 12)."
                            }
                        ]
                    },
