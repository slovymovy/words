                        "form": "krnąbrne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b6ef281-096d-3054-8f12-2196ed77d279",
                        "entry_id": "ce3b2966-7cda-3cd8-a27f-78e93fda8d0b",
                        "glosses": [
                            "nieposłuszny, bezczelny, o trudnym charakterze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3072629-8467-4b1c-bace-8fe54225d95a",
                                "sense_id": "5b6ef281-096d-3054-8f12-2196ed77d279",
                                "text": "Sama \"ciocia\" stwierdziła, że dziewczynka jest krnąbrna, dominuje nad swoją matką i potrzebuje silnej ręki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "494b8032-4586-479f-a1b2-dd71fc04a9cd",
                        "source_entry_id": "ce3b2966-7cda-3cd8-a27f-78e93fda8d0b",
                        "source_sense_id": "5b6ef281-096d-3054-8f12-2196ed77d279",
                        "target_lang_word": "wayward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wayward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                        "entry_id": "d39cc7e4-b1a6-322b-8c1f-1693137f84d9",
                                        "glosses": [
                                            "Given to wilful, perverse deviation from the expected norm; tending to stray."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771c0f2f-ae04-4636-9372-2d927af9d247",
                                                "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                                "text": "He is a brilliant fellow when he chooses to work—one of the brightest intellects of the University, but he is wayward, dissipated, and unprincipled."
                                            },
                                            {
                                                "example_id": "d1e9d59c-e778-4a71-93bf-feeaddc3efe2",
                                                "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                                "text": "Fancies are like shadows . . . you can’t cage them, they’re such wayward, dancing things."
                                            },
                                            {
                                                "example_id": "3302595a-6244-4bd4-bcd7-dac6e9e23cd1",
                                                "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                                "text": "The Ig Nobel awards are arguably the highlight of the scientific calendar. The prizes, which are the wayward son of the more righteous Nobels, are supposed to reward research that makes people laugh, then think."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c51c9663-ebf6-348a-90b9-06b3a43ed441",
                                        "entry_id": "d39cc7e4-b1a6-322b-8c1f-1693137f84d9",
                                        "glosses": [
                                            "Obstinate, contrary and unpredictable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3048ebba-34e8-3c36-a57e-d041bc13c101",
                                        "entry_id": "d39cc7e4-b1a6-322b-8c1f-1693137f84d9",
                                        "glosses": [
                                            "Not on target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc2c4831-2550-4f65-b45a-42ece80c2084",
                                                "sense_id": "3048ebba-34e8-3c36-a57e-d041bc13c101",
                                                "text": "Bulgaria's only attacking weapon was the wayward shooting of Martin Petrov, whereas England's attacking options were awash with movement in the shape of Rooney, Young and Walcott."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc544ac2-7de1-4055-9234-e4f322537e4c",
                        "source_entry_id": "ce3b2966-7cda-3cd8-a27f-78e93fda8d0b",
                        "source_sense_id": "5b6ef281-096d-3054-8f12-2196ed77d279",
                        "target_lang_word": "своенравный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "своенравный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5383702c-b23a-34e9-beea-2a71dbbefa47",
                                        "entry_id": "c896310d-1943-3be4-a851-c76064bc64d7",
                                        "glosses": [
                                            "поступающий по-своему, капризный и упрямый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc76e415-c70b-41b8-88d3-e173ed603151",
                                                "sense_id": "5383702c-b23a-34e9-beea-2a71dbbefa47",
                                                "text": "Эта девушка из народа была непосредственна, своенравна, не терпела никакого насилия над своим сердцем, поэтому была честной в своих чувствах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f77a05f6-7eab-3ef9-9796-0bebb36e7494",
                                        "entry_id": "c896310d-1943-3be4-a851-c76064bc64d7",
                                        "glosses": [
                                            "выражающий такое свойство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c93b378c-b8b7-45da-80c7-8c477cd2d082",
                                                "sense_id": "f77a05f6-7eab-3ef9-9796-0bebb36e7494",
                                                "text": "Так и на Saab 9-3 ― к своенравному поведению этого автомобиля можно привыкнуть уже на второй день «плотного» вождения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
