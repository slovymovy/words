                "senses": [
                    {
                        "sense_id": "67f574f4-3a9a-33f8-8b62-2316df32afb2",
                        "entry_id": "30868b9e-217a-354d-a8e2-cf58f39e3492",
                        "glosses": [
                            "rzemieślnik wykonujący przedmioty z drutu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbe4e677-3bb5-41ee-8897-f97629210a8f",
                                "sense_id": "67f574f4-3a9a-33f8-8b62-2316df32afb2",
                                "text": "Kiedyś zakład zatrudniał dwudziestu druciarzy z ponad piętnastoletnim stażem zawodowym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9888ca33-691a-31bd-a846-c723dbd9c122",
                        "entry_id": "30868b9e-217a-354d-a8e2-cf58f39e3492",
                        "glosses": [
                            "wędrowny rzemieślnik łatający garnki drutem"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "71e14390-a98b-4c04-8992-f35b5227c04a",
                                "sense_id": "9888ca33-691a-31bd-a846-c723dbd9c122",
                                "text": "Babka kazała druciarzowi połatać ten stary gar, w którym jej najlepiej kluski wychodziły."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52d10528-1e1b-4b00-b86a-8f93054a133e",
                        "source_entry_id": "30868b9e-217a-354d-a8e2-cf58f39e3492",
                        "source_sense_id": "9888ca33-691a-31bd-a846-c723dbd9c122",
                        "target_lang_word": "tinker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tinker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4296966f-e89a-303b-9600-02ac9f88b4a8",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "An itinerant tinsmith and mender of household utensils made of metal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "971c5be0-6463-4807-a313-597536634cca",
                                                "sense_id": "4296966f-e89a-303b-9600-02ac9f88b4a8",
                                                "text": "The blacksmith chased us all to ground\nThey searched all night we were never found\nThe tinker boys and the sheriff's men\nShaking the tallest tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fba8445-a097-308d-bb68-4fd35a8fc72b",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "A member of the Irish Traveller community or of other itinerant groups; a gypsy."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "dated",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ed0f792-7431-3bfd-9e02-00420c789c85",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "A mischievous person, especially a playful, impish youngster."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a521e8e4-2ecf-35ab-b934-7c46708257ea",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "Someone who repairs, or attempts repair, on anything mechanical, or who invents such devices; one who tinkers; a tinkerer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9270f5-f327-356a-b3ae-b9c08beab647",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "An act of repair or invention."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c807d0-490c-4149-b884-89cdaaac5ee9",
                                                "sense_id": "cb9270f5-f327-356a-b3ae-b9c08beab647",
                                                "text": "I'll have a tinker and see what I can do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6437564f-8bb9-3436-a861-144a6089b0f9",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "A hand mortar."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9947976a-b597-3651-a0f2-42d906324c68",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "Any of various fish: chub mackerel, silverside, skate, or young mackerel about two years old."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f7c4e38-5bce-3c69-9312-ed7b6cfd711a",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "A bird, the razor-billed auk."
                                        ],
                                        "tags": [],
                                        "examples": []
