                                    {
                                        "sense_id": "95546009-c893-3e6b-b93b-2b4a754a4d45",
                                        "entry_id": "e6befda5-a342-3224-8322-4d25bc482d0d",
                                        "glosses": [
                                            "A case used to indicate movement onto, or to the adjacency of something. In English, this is usually expressed by the prepositions to or onto, as in \\\"to the house,\\\" \\\"onto the house.\\\" Languages that use the allative case include Basque, Dyirbal, Estonian, Finnish, Hungarian, and Lithuanian."
                                        ],
