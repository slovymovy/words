                    {
                        "translation_id": "34890fd3-d04d-4cbe-afdf-c62d2112529f",
                        "source_entry_id": "167b00a0-3aa6-36f2-a138-48f365d3d246",
                        "source_sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                        "source_sense_description": "condition of having foul-smelling breath",
                        "target_lang_word": "halitose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halitose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4ba73de-7191-35d9-95b2-96b8689eb7fe",
                                        "entry_id": "91e4f10b-379d-3f71-83a0-960781c9936b",
                                        "glosses": [
                                            "Mauvaise haleine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61642614-9e85-43d6-8ab1-194eda0d53b0",
                                                "sense_id": "c4ba73de-7191-35d9-95b2-96b8689eb7fe",
                                                "text": "Voilà donc pourquoi les chercheurs ont avancé que les jeunes Manduca sexta possédaient une « halitose défensive », sachant qu’halitose n’est autre que le mot scientifique qui désigne une mauvaise haleine."
                                            },
                                            {
                                                "example_id": "e93902d8-94bb-4f6f-90d0-0ad5a9a1a215",
                                                "sense_id": "c4ba73de-7191-35d9-95b2-96b8689eb7fe",
                                                "text": "Sans oublier que ces produits ne constituent pas la panacée : combattre une halitose (mauvaise haleine) persistante à coups de bains de bouche peut par exemple s’avérer inefficace si ce problème est dû à une affection bucco-dentaire plus grave ou à des troubles gastriques, par exemple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5b2f5a0-3270-4106-8165-741be23e1efb",
                        "source_entry_id": "167b00a0-3aa6-36f2-a138-48f365d3d246",
                        "source_sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                        "source_sense_description": "condition of having foul-smelling breath",
                        "target_lang_word": "Mundgeruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mundgeruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                                        "entry_id": "c848eec4-84e8-30ca-ab95-7650f66c2f2d",
                                        "glosses": [
                                            "unangenehmer Geruch des Atems bzw. der Ausatemluft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d774b9a1-7b06-44f3-afb8-c1d44e43b45e",
                                                "sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                                                "text": "Obwohl Mundgeruch nicht gefährlich ist, wird er für die Mitmenschen als störend empfunden."
                                            },
                                            {
                                                "example_id": "32df17ca-85f8-4673-96eb-ad441bdc290f",
                                                "sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                                                "text": "Hinter Mundgeruch können ernsthafte Erkrankungen, wie ein akutes Nierenversagen oder Diabetes mellitus, stecken."
                                            },
                                            {
                                                "example_id": "a6d7edee-50e7-4353-ad24-85a3ec5b0f78",
                                                "sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                                                "text": "„Ivos Mundgeruch mischte sich mit dem stechenden Aroma von altem Schweiß.“"
                                            },
                                            {
                                                "example_id": "7e87d6a2-f15a-4aa2-958b-dc9b5e2bfaeb",
                                                "sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                                                "text": "„Merkwürdigerweise erzählen Leute mit Mundgeruch (zu Zeiten, als es den noch gab, sei hier beschwichtigend ergänzt) mit Vorliebe Witze von Leuten mit Mundgeruch.“"
                                            },
                                            {
                                                "example_id": "0ffb197b-9fef-414e-833d-78d641803d89",
                                                "sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                                                "text": "„Viel Reden fördert Mundgeruch.“"
                                            },
                                            {
                                                "example_id": "b025496f-3826-47ea-8acb-e8d74d0d5951",
                                                "sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                                                "text": "„Im obersten Knopfloch seines Rockes trug er einen großen Strauß aus Tuberosen und Narzissen; ein starker Duft von Ambra entströmte der Pomade, mit der er Perücke und Brauen am Kopf festgeklebt hatte, und sein durchdringender Mundgeruch mißfiel zwar nicht Madame D'Urfé, war mir aber unerträglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
