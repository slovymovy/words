                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d87bfe27-8b03-4f0a-9035-57ef371f3ba0",
                                "sense_id": "33c9e3ad-a33a-3d77-8759-1e42ba97ac37",
                                "text": "„Das Ringen um eine gemeinsame Linie in Sachen Einreiseerlaubnis hat vor allem das Ziel, dass die Grenzen innerhalb der Europäischen Union wieder geöffnet werden.“"
                            },
                            {
                                "example_id": "e068d790-f004-41ba-a140-44451ac4377f",
                                "sense_id": "33c9e3ad-a33a-3d77-8759-1e42ba97ac37",
                                "text": "„Dann kommt, völlig überraschend, am 5. Dezember 1942 die Nachricht: Renate hat die Einreiseerlaubnis nach Schweden erhalten!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
