                "translations": [
                    {
                        "translation_id": "ae7581ec-cb15-45aa-b1f3-1504723e931a",
                        "source_entry_id": "c3ae6dca-6cf6-3dbb-b944-c93cccd02001",
                        "source_sense_id": "53ab3a9f-0754-349c-9955-061f5b861208",
                        "source_sense_description": "Diakonin, Diakonisse, Diakonissin",
                        "target_lang_word": "Diakonin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diakonin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4822e11-dd29-3a0c-bbc6-f95adb49f519",
                                        "entry_id": "3c3f453a-d4af-32cc-8603-4066209cddfd",
                                        "glosses": [
                                            "Frau, die ein geistliches Amt (unterhalb des Priesters) innerhalb der (anglikanischen, alt-katholischen) Kirche ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "645cc1f3-3e04-4316-a98c-fd80b5bd4d9d",
                                                "sense_id": "f4822e11-dd29-3a0c-bbc6-f95adb49f519",
                                                "text": "„1987 wird in der Christkatholischen Kirche der Schweiz erstmals eine Frau zur Diakonin geweiht, es folgen die alt-katholischen Kirchen in Deutschland (1988), Österreich (1991), den Niederlanden (1996) und in Tschechien (2003).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fe2ff6f-2a18-3822-975c-b5455d98ca46",
                                        "entry_id": "3c3f453a-d4af-32cc-8603-4066209cddfd",
                                        "glosses": [
                                            "Helferin in einer (evangelischen) Gemeinde, die zum Beispiel karitative Aufgaben wahrnimmt oder in schulischen und gesellschaftlichen Arbeitsfeldern aktiv ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "472a4e6b-944c-4d35-892a-73b3b8a0d61d",
                                                "sense_id": "4fe2ff6f-2a18-3822-975c-b5455d98ca46",
                                                "text": "„Die evangelischen Diakoninnen und Diakone fühlen sich im Unterschied zu ihren elf katholischen Kollegen in der Regel weniger wertgeschätzt, zu wenig selbstständig und nicht wirklich an Leitungsaufgaben beteiligt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "553dd987-954a-4bd0-9b10-a6e93d078b13",
                        "source_entry_id": "c3ae6dca-6cf6-3dbb-b944-c93cccd02001",
                        "source_sense_id": "53ab3a9f-0754-349c-9955-061f5b861208",
                        "source_sense_description": "Diakonin, Diakonisse, Diakonissin",
                        "target_lang_word": "Diakonisse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diakonisse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33afbc28-5449-3317-834f-2557d529ace1",
                                        "entry_id": "29510acc-0ca8-3aa1-82e8-7d302000d26d",
                                        "glosses": [
                                            "Frau, die Mitglied in einer evangelischen Glaubens- und Lebensgemeinschaft ist und vornehmlich anderen Menschen hilft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a44abc-3e78-4973-8ba5-dc1c60b7e783",
                                                "sense_id": "33afbc28-5449-3317-834f-2557d529ace1",
                                                "text": "„Von Ordensleuten zu unterscheiden sind Eremiten, die zwar auch Mönche oder Nonnen sein können, aber als Einzelne ein Leben in Abgeschiedenheit führen, und andere Formen geweihten Lebens (etwa gottgeweihte Jungfrauen, Mitglieder von Säkularinstituten, evangelische Diakonissen und Diakonengemeinschaften).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "474104df-f1a5-48c2-876f-97f4aa387b95",
                        "source_entry_id": "c3ae6dca-6cf6-3dbb-b944-c93cccd02001",
                        "source_sense_id": "53ab3a9f-0754-349c-9955-061f5b861208",
