                        "glosses": [
                            "organizmy wchodzące w skład planktonu tylko w stanie młodocianym lub larwalnym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1369c509-5d7c-46e5-9bf6-e9316235117e",
                                "sense_id": "a82865a7-a9e1-3fc6-9cfd-4719619b6106",
                                "text": "Organizmy odbywające cały cykl życia jako planktony to holoplankton, podczas gdy organizmy, które w planktonie występują tylko przez niektóre stadia rozwojowe to meroplankton"
                            }
                        ],
