                        "examples": [
                            {
                                "example_id": "0bcbea85-299b-46f4-ae72-a50251ca5b16",
                                "sense_id": "2539a9d4-19fe-33e3-ad32-982a3f17cf0d",
                                "text": "De groei zit de afgelopen twee jaar in Oost-Europa, Azië en Noord-Amerika. Ook de verouderde walserijen en hoogovens in Latijns-amerikaanse landen hebben het moeilijk."
                            },
                            {
                                "example_id": "7b019150-220f-4c0d-85f0-082802f7b4ac",
                                "sense_id": "2539a9d4-19fe-33e3-ad32-982a3f17cf0d",
                                "text": "De fabrieken van LaPlace in Louisiana en de walserij in Tennessee zijn gespecialiseerd in onder meer de productie van balken, hoeken en platen. De Vintonfabriek in Texas maakt betonstaal en slijpbenodigdheden."
                            }
                        ]
                    }
