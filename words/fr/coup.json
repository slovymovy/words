                    "frequency": "High",
                    "semantic_group_id": "action_breve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai jeté un rapide <w>coup</w> d'œil à ma montre avant de partir."
                        },
                        {
                            "text": "Peux-tu me donner un petit <w>coup</w> de main pour porter cette valise ?"
