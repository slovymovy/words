                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4fe0af2-f890-3c2f-9d3c-298a63388529",
                        "entry_id": "8af127ce-f2fe-3468-8b06-2baec7c40ab2",
                        "glosses": [
                            "Unfermented grape juice; must."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "743cac48-7741-465f-8c7f-1083fdaa38d6",
                                "sense_id": "b4fe0af2-f890-3c2f-9d3c-298a63388529",
                                "text": "1620s, Ben Jonson, Leges Convivales\nLet our wines, without mixture of stum, be all fine."
                            },
                            {
                                "example_id": "bc1f6351-875c-400f-9e54-7d8be93073ae",
                                "sense_id": "b4fe0af2-f890-3c2f-9d3c-298a63388529",
                                "text": "And with thy stum ferment their fainting cause."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e7b333-f403-3ff5-95a2-4f59d19a3341",
                        "entry_id": "8af127ce-f2fe-3468-8b06-2baec7c40ab2",
                        "glosses": [
                            "Wine revived by new fermentation, resulting from the admixture of must."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "760fbae0-800d-47ad-9303-1421dd7537e9",
                                "sense_id": "83e7b333-f403-3ff5-95a2-4f59d19a3341",
                                "text": "Drink ev'ry letter on't in stum,\nAnd make it brisk champaign become."
                            },
                            {
                                "example_id": "1ca22cec-e492-43a9-b953-e4a238fda041",
                                "sense_id": "83e7b333-f403-3ff5-95a2-4f59d19a3341",
                                "text": "To each hogshead of genuine Bordeaux wine, there are four gallons of Benicarlo, half a gallon of stum wine, and a small quantity of Hermitage added, which mixture undergoes a slight fermentation, and is then exported under the name of claret."
                            },
                            {
                                "example_id": "3e96f228-94cf-4cc2-b978-6d3a31f03e2f",
                                "sense_id": "83e7b333-f403-3ff5-95a2-4f59d19a3341",
                                "text": "But stum wine was not intended for drinking."
                            }
                        ]
                    }
                ],
