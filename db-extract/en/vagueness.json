    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                "word": "vagueness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a5e90a68-4822-4d1e-8942-439bebce2810",
                        "entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                        "tags": [
                            "plural"
                        ],
                        "form": "vaguenesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e12554a5-4071-3ebd-89e1-c320ea67b0f6",
                        "entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                        "glosses": [
                            "The condition of being imprecise or unclear in meaning: vague."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2306596c-c1ff-4cdf-b7bb-2ab489593b35",
                                "sense_id": "e12554a5-4071-3ebd-89e1-c320ea67b0f6",
                                "text": "Near-synonyms: ambiguousness, ambiguity"
                            },
                            {
                                "example_id": "f7f309ca-8299-46a4-ad8b-360b4a1fbe80",
                                "sense_id": "e12554a5-4071-3ebd-89e1-c320ea67b0f6",
                                "text": "On Wednesday night, a federal judge issued a preliminary injunction against a new California law that makes physicians subject to professional discipline for sharing COVID-19 \"misinformation\" with their patients. U.S. District Judge William B. Shubb concluded that California's definition of misinformation is unconstitutionally vague, failing to give doctors fair notice of which conduct the statute covers, which is a basic requirement of due process. That vagueness is especially problematic in this context, Shubb said, because it is apt to have a chilling effect on speech protected by the First Amendment."
                            }
                        ]
                    },
                    {
                        "sense_id": "077555c1-2c08-386b-a353-e07908c6618a",
                        "entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                        "glosses": [
                            "Something which is vague, or an instance or example of vagueness."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c22c6b4-f5a4-4fd4-b99b-1d0098207232",
                                "sense_id": "077555c1-2c08-386b-a353-e07908c6618a",
                                "text": "If a man's deep and conscientious regard for the truth be such that he cannot, consistently with the requisitions of his moral nature, repeat to others mere vaguenesses and uncertainties, he will naturally give such strict and serious attention to the present objects of inquiry and knowledge, that they will remain in his memory afterward with remarkable distinctness and permanency."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df9c549a-c7fb-4325-83c1-1a23f04d4b23",
                        "source_entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                        "source_sense_description": "condition of being unclear",
                        "target_lang_word": "vágnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d87c193a-db67-4948-91ea-d8410ec37d83",
                        "source_entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                        "source_sense_description": "condition of being unclear",
                        "target_lang_word": "Unklarheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unklarheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce169872-ade2-39ba-8fab-784adb4b4e8e",
                                        "entry_id": "451962dc-48e8-3756-b7eb-4e15a53176cd",
                                        "glosses": [
                                            "Eigenschaft/Zustand von etwas, nicht klar zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4144e013-0645-48a6-af77-018e8002f617",
                                                "sense_id": "ce169872-ade2-39ba-8fab-784adb4b4e8e",
                                                "text": "„Jetzt entdeckte er zu seinem eigenen Erstaunen, dass es in allen diesen Fragen gar keine Unklarheit und Ratlosigkeit mehr gab.“"
                                            },
                                            {
                                                "example_id": "1a881864-c21c-4dae-ad02-ee71866789f3",
                                                "sense_id": "ce169872-ade2-39ba-8fab-784adb4b4e8e",
                                                "text": "„Und nun trat er wieder an Cécile heran, um sich wegen einiger ihm vorgeworfenen Unklarheiten in seinem gestrigen Morgenbillet, so gut es ging, zu verantworten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb1b17d2-5995-3d20-b932-cfd928ffc06b",
                                        "entry_id": "451962dc-48e8-3756-b7eb-4e15a53176cd",
                                        "glosses": [
                                            "jemand oder etwas mit Bedingung [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "950fac6f-9316-4a62-b1e3-43b56a7dce60",
                                                "sense_id": "bb1b17d2-5995-3d20-b932-cfd928ffc06b",
                                                "text": "Es ist nötig, auch die letzten Unklarheiten zu beseitigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01d6aeb3-aec5-439e-870d-0d472c7ce41c",
                        "source_entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
