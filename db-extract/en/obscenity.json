        "ja-extract.jsonl": [
            {
                "entry_id": "b1cc74ec-6302-3d90-b438-afed695b04f4",
                "word": "obscenity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d224bc7c-a656-40fe-a9a6-796768466a31",
                        "entry_id": "b1cc74ec-6302-3d90-b438-afed695b04f4",
                        "tags": [
                            "canonical"
                        ],
                        "form": "obscenities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b82bf609-c2e4-3944-a819-59dadcf48271",
                        "entry_id": "b1cc74ec-6302-3d90-b438-afed695b04f4",
                        "glosses": [
                            "猥褻なもの、猥褻物。"
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "81f637e2-3f96-4687-9113-70d2c3bc31d1",
                                "sense_id": "b82bf609-c2e4-3944-a819-59dadcf48271",
                                "text": "Martha wouldn't go into the art museum because, as she put it, \"They have obscenities just sitting out, on display!\"",
                                "translation": "マーサは美術館の中に入ろうとしなかった、彼女が言うには、「むき出しの猥褻物が展示されている」とのこと。"
                            }
                        ]
                    },
                    {
                        "sense_id": "c9623beb-7948-3c85-b81f-97d55464c295",
                        "entry_id": "b1cc74ec-6302-3d90-b438-afed695b04f4",
                        "glosses": [
                            "猥褻行為。"
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "49267be1-921c-459e-8639-b5a9e29d37b1",
                                "sense_id": "c9623beb-7948-3c85-b81f-97d55464c295",
                                "text": "Bestiality was outlawed as an obscenity in the strongly conservative community.",
                                "translation": "獣姦は、その保守性の強い社会においては猥褻行為として禁じられた。"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d6f4ad8-b89e-32bd-bb91-7732b621845d",
                        "entry_id": "b1cc74ec-6302-3d90-b438-afed695b04f4",
                        "glosses": [
                            "冒涜的な言葉。"
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "1d613bd3-5324-44ff-9b00-652b0b29f134",
                                "sense_id": "7d6f4ad8-b89e-32bd-bb91-7732b621845d",
                                "text": "Eliza couldn't stand her daughter's music; as she saw it, it was just shouted obscenities and a heavy drum beat.",
                                "translation": "イライザは、娘の音楽が我慢できなかった。イライザにとっては、ただ汚い言葉をわめき激しくドラムビートを鳴らしているだけにしか思えなかった。"
                            }
                        ]
                    },
                    {
                        "sense_id": "0ffe746d-0036-3fa5-aab0-ac1db862fb24",
                        "entry_id": "b1cc74ec-6302-3d90-b438-afed695b04f4",
                        "glosses": [
                            "猥褻。"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f25c6cac-fb4f-4aa2-b0bd-58bedbaa7abc",
                                "sense_id": "0ffe746d-0036-3fa5-aab0-ac1db862fb24",
                                "text": "The coalition of religious conservatives was campaigning against, in their view, rampant obscenity in the entertainment industry.",
                                "translation": "宗教保守派が連合し、彼らのいう、芸能界にはびこる猥褻の氾濫に対し、排斥運動をしていた。"
                            }
                        ]
                    }
                ],
