                    "frequency": "Low",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee landen hopen met dit verdrag hun vriendschap te <w>verzegelen</w>.",
                            "target_lang_translations": {
