                                    },
                                    {
                                        "sense_id": "c1f5a025-1ecb-3779-bd97-8db2d1b32925",
                                        "entry_id": "40cfb910-1130-3208-8de3-db1d6ec94d11",
                                        "glosses": [
                                            "die Unfähigkeit zu funktionieren"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf7ef37-e4fb-44dd-bd57-329982fda6ed",
                                                "sense_id": "c1f5a025-1ecb-3779-bd97-8db2d1b32925",
                                                "text": "„Der Zustand allgemeiner Erschöpfung und Paralyse einer Organisation kann auch bei „gesunden“ Organisationen und Institutionen vorkommen, als Folge ganz bes. Herausforderungen. Tiefe, anhaltende Erschöpfung ist eine notwendige, aber keine hinreichende Voraussetzung für ein Organizational-Burnout-Syndrom.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87693fb1-2028-4fdf-82f6-f8ba74ad5ca6",
                        "source_entry_id": "a8606d40-0c2e-3277-88ae-e1bfa859d0dc",
                        "source_sense_id": "2111cf46-7a53-3406-9d93-4874d314b871",
                        "target_lang_word": "Lähmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lähmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5077154-d27c-367e-ace9-e8ba87244067",
                                        "entry_id": "5bd8156c-1f71-3f75-a14a-d5a748d6a73b",
                                        "glosses": [
                                            "anteiliger oder kompletter Funktionsverlust eines Körperteils oder Organsystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c94eaf-f665-4871-92d9-70c081607990",
                                                "sense_id": "b5077154-d27c-367e-ace9-e8ba87244067",
                                                "text": "Eine Tetanusinfektion kann zu Lähmungen führen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62614792-67cd-396c-9a41-e6da96dcb164",
                                        "entry_id": "5bd8156c-1f71-3f75-a14a-d5a748d6a73b",
                                        "glosses": [
                                            "verringerte Funktion der Nerven, mit Ausfällen des Empfindens und der Bewegungsfähigkeit"
                                        ],
                                        "tags": [
                                            "Neurologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92bd1a31-3abf-4d0a-8de1-dbb5b4bdd79f",
                                                "sense_id": "62614792-67cd-396c-9a41-e6da96dcb164",
                                                "text": "„Der Schmerz wächst, ich bekomme heftiges Fieber bis zum Schüttelfrost, eine Lähmung tritt hinzu, die die linke Körperseite erfaßt; ich kann meinen Arm nicht mehr bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5ba52a28-14fc-31bf-a16f-6691d963df8c",
                                        "entry_id": "5bd8156c-1f71-3f75-a14a-d5a748d6a73b",
                                        "glosses": [
                                            "Zustand, in dem sich in einem System nichts verändert, es nicht mehr funktioniert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3632bddc-d4b8-4b8b-a382-be7226f25a84",
                                                "sense_id": "5ba52a28-14fc-31bf-a16f-6691d963df8c",
                                                "text": "„Tatsächlich markieren die beiden Personalien das nahe Ende einer fast zweijährigen Lähmung der polnischen Innenpolitik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
