                ],
                "senses": [
                    {
                        "sense_id": "a9b5314c-648f-34f1-a5f9-bb4533227e35",
                        "entry_id": "5fbcc0b7-95d1-3246-8e9c-7693fa1dbb1a",
                        "glosses": [
                            "прост. то же, что требуха; внутренности убитого животного (желудок, кишки и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ab46e8-f535-49fa-bcc7-c056b49e651f",
                                "sense_id": "a9b5314c-648f-34f1-a5f9-bb4533227e35",
                                "text": "Наш хозяин забил окна железом для того, чтоб мы не могли дать кусок его хлеба нищим и тем из наших товарищей, которые, живя без работы, голодали, ― наш хозяин называл нас жуликами и давал нам на обед вместо мяса ― тухлую требушину…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30b880b7-7187-4a56-8867-1a172189a892",
                        "source_entry_id": "5fbcc0b7-95d1-3246-8e9c-7693fa1dbb1a",
                        "source_sense_id": "a9b5314c-648f-34f1-a5f9-bb4533227e35",
                        "target_lang_word": "entrails",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrails",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c95ce9-1d89-32d6-a3eb-ba63606a4342",
                                        "entry_id": "3b013d14-5ad6-3224-aef5-91ebef4e4edc",
                                        "glosses": [
                                            "plural of entrail",
                                            "The internal organs of an animal, especially the intestines."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4440d1fc-431e-4193-aa36-e1d09b2479c2",
                                                "sense_id": "f7c95ce9-1d89-32d6-a3eb-ba63606a4342",
                                                "text": "Elizabethan audiences relished shocks and surprises as much as they did trumpets, thunder and savage realism in bloody scenes of torture and death which were made all the more horrible by the use of animals’ entrails."
                                            }
                                        ]
                                    },
                                    {
