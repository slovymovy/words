                ],
                "senses": [
                    {
                        "sense_id": "11fd7673-a8b0-3f30-af0a-afd698d2bd42",
                        "entry_id": "353fe6f0-9e12-3d30-9cec-beafb260dd2d",
                        "glosses": [
                            "met rotsen en daardoor heel hard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd027c87-6861-492e-8d7e-db380b8b0b11",
                                "sense_id": "11fd7673-a8b0-3f30-af0a-afd698d2bd42",
                                "text": "Het landschap van de Masai Mara wordt gedomineerd door grasland savanne met hier en daar bosjes acacia bomen, oevers en rotsige heuvels."
                            },
                            {
                                "example_id": "9c10e243-9a7a-47c4-af6c-6698cfb29899",
                                "sense_id": "11fd7673-a8b0-3f30-af0a-afd698d2bd42",
                                "text": "Het jochie kwam te dicht bij de rand van een rots en viel er vanaf. Zijn ouders waren hun peutertje een moment uit het oog verloren en schakelden de hulpdiensten in toen zij hem niet vonden. Die vonden de 4-jarige op het rotsige strand, 60 meter lager."
                            },
                            {
                                "example_id": "6e396cc0-08bf-4927-8666-6f1f371f2128",
                                "sense_id": "11fd7673-a8b0-3f30-af0a-afd698d2bd42",
                                "text": "Het DHC-3 watervliegtuigje van het lokale luchttaxibedrijf Promech Air raakte bij Lake Ella door nog onbekende oorzaak een rotsige klif. Het zicht was slecht door wolken. Het regende en waaide hard."
                            }
                        ]
                    }
