                        ],
                        "form": "стреля́вшись"
                    },
                    {
                        "form_id": "2f3ef20c-d7b5-4dde-9dbb-c87c263bd55e",
                        "entry_id": "9d99a09a-174d-3e5b-9751-f4d0ec688be4",
