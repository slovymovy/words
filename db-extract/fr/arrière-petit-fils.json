                "forms": [
                    {
                        "form_id": "81e06d95-feb1-4f2a-a7f4-be26ead351b4",
                        "entry_id": "7b58d145-dfd7-37b7-9f06-76161942442a",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrière-petits-fils"
                    },
                    {
                        "form_id": "d1ce425a-ee25-46e1-aa05-5a3b403c5bfe",
                        "entry_id": "7b58d145-dfd7-37b7-9f06-76161942442a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "arrière-petite-fille"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                        "entry_id": "7b58d145-dfd7-37b7-9f06-76161942442a",
                        "glosses": [
                            "Fils du petit-fils (ou de la petite-fille) par rapport au bisaïeul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9314bd9c-bf7a-4abc-bcf6-54eb3167c38f",
                                "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                                "text": "Louis XV était arrière-petit-fils de Louis XIV."
                            },
                            {
                                "example_id": "36d137c0-51f3-4673-a450-aea27446a162",
                                "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                                "text": "Ce vieillard a vu ses arrière-petits-fils."
                            },
                            {
                                "example_id": "a34db6bd-dae6-4400-9b42-ca4f07f1f00d",
                                "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                                "text": "De prince en prince, le trône vint au petit-fils du roi Tarsi Berderâs, c’est-à-dire à Radja Zemzoua, petit-fils de Chah Tarsi, arrière-petit-fils de Radja Dermanous, arrière-arrière-petit-fils de Radja Ardéchir Babégan, fils lui-même de Radja Koudar Zakouhon, petit-fils de Radja Amtabous, arrière-petit-fils de Radja Sabour, arrière-arrière-petit-fils de Radja Aftas, fils de Radja Arstoun-Chac, fils du roi Iskender Dhou(l-Qarneïn.",
                                "translation": "Bibliothèque orientale Elzévirienne, 1875"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2221e3f7-3088-4f7d-a688-b96e49c67659",
                        "source_entry_id": "7b58d145-dfd7-37b7-9f06-76161942442a",
                        "source_sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                        "target_lang_word": "Urenkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urenkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                        "entry_id": "5b75b056-ba9a-380b-a668-3efe399c07ee",
                                        "glosses": [
                                            "(männliches^☆) Kind von Enkel/Enkelin oder (männlicher^☆) Nachfahre der dritten Generation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa5cf57e-b708-46ad-884e-2a3957d2b48f",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "Ich lebe weiter in den Genen meiner Enkel und Urenkel."
                                            },
                                            {
                                                "example_id": "7641b7ed-9430-487b-b556-58587d9573b4",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Jetzt lebten sechs von seinen sieben Kindern, Enkelkindern und Urenkeln ebenfalls hier.“"
                                            },
                                            {
                                                "example_id": "aee4eddf-5365-40de-ba10-cbcaa9048bf4",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Nik Wallenda, Urenkel eines deutschen Zirkusakrobaten, hat als erster Mensch die Niagarafälle an ihrer schönsten und gefährlichsten Stelle überquert.“"
                                            },
                                            {
                                                "example_id": "9f768183-0c7f-45ee-b549-fa957a19701f",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Dann und wann schliefen die Urenkel bei den Alten.“"
                                            },
                                            {
                                                "example_id": "7a87a4a7-36de-44ca-8d1a-c0d92b62c374",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Möglicherweise werden unsere Urenkel ähnlich belustigt reagieren, wenn sie erfahren, dass wir uns Anfang des 21. Jahrhunderts Sorgen über unsere Erdölvorräte gemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                        "entry_id": "5b75b056-ba9a-380b-a668-3efe399c07ee",
                                        "glosses": [
                                            "später Nachkomme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac078915-1717-4b0f-a96f-c7e4ad693dd8",
                                                "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                                "text": "„Möglicherweise werden unsere Urenkel ähnlich belustigt reagieren, wenn sie erfahren, dass wir uns Anfang des 21. Jahrhunderts Sorgen über unsere Erdölvorräte gemacht haben.“"
                                            },
                                            {
                                                "example_id": "e329dbd4-fbf9-4a80-9340-c5697d9695d1",
                                                "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                                "text": "„Wie sollten sie sich auch begeistern für Ereignisse, die erst zu Lebzeiten der Urenkel ihrer Urenkel eintreten würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
