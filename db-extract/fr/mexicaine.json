                "word": "mexicaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c86d44e9-630e-4aeb-9f20-9ed29bbfd61e",
                        "entry_id": "24c1fbb1-2a05-33e1-b629-a29c0e2de1db",
