                                "target_lang_sense_clarification": "a very thin, small piece of material"
                            },
                            {
                                "target_lang_word": "shard",
                                "target_lang_sense_clarification": "a sharp piece of glass or ceramic"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1cc5e0f-353b-37f7-9de1-d0d3a7afe2c7",
                    "sense_definition": "een kleine groep mensen die zich heeft afgesplitst van een grotere vereniging of politieke partij",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "groep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe politieke partij is eigenlijk een kleine <w>splinter</w> van de grootste fractie.",
                            "target_lang_translations": {
                                "en": "The new political party is actually a small <w>splinter group</w> of the largest faction."
                            }
                        },
                        {
                            "text": "Na het conflict vormde een <w>splinter</w> van de vakbond een eigen beweging.",
                            "target_lang_translations": {
