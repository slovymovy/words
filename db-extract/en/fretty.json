                                    {
                                        "sense_id": "d4f7f096-4737-381c-a1a1-bf413ce5b5ff",
                                        "entry_id": "11e8b13a-fd1a-35c6-8695-6ee6d3ea9b9e",
                                        "glosses": [
                                            "smart zn, verdriet"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca3b722-e9e9-492d-a669-614762b1ef59",
                                                "sense_id": "d4f7f096-4737-381c-a1a1-bf413ce5b5ff",
                                                "text": "Daar lag ik dan met dubbel geluk Mijn gewillige borsten vol melk Een kop vol zorgen die ik verdruk Over hoe wat waarom en wie welk Te moeten kiezen, elke keer Zonder hem, haar te beroven Van aandacht, liefde, wat zo meer Dreef de zwakkere al naar boven Verblind voor 't toekomstige zeer Waar we massaal op af stoven."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b970eb4e-f1ff-3f59-815e-60de4203e35b",
                                        "entry_id": "c38e4204-743f-381a-9570-359cbcf15d50",
                                        "glosses": [
                                            "pijnlijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57d7a78b-96c4-40ca-b477-b4f32d22aa71",
                                                "sense_id": "b970eb4e-f1ff-3f59-815e-60de4203e35b",
                                                "text": "Hij had een zere teen."
                                            },
                                            {
                                                "example_id": "c457a387-f1d9-487b-8dde-c5345cfe208d",
                                                "sense_id": "b970eb4e-f1ff-3f59-815e-60de4203e35b",
                                                "text": "Bibi gaf geen krimp, maar het moet haar flink zeer hebben gedaan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8fda2686-d3f1-336e-90f5-50cd06575d70",
                                        "entry_id": "df67e286-a4fe-3807-91f3-342c3d69cd16",
                                        "glosses": [
                                            "in hoge mate, heel erg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98f3cf03-b69e-4c3f-9b33-98f3f0b893bd",
                                                "sense_id": "8fda2686-d3f1-336e-90f5-50cd06575d70",
                                                "text": "Zeer goed."
                                            },
                                            {
                                                "example_id": "3001c082-edbc-4a66-91f6-282281cba4ee",
                                                "sense_id": "8fda2686-d3f1-336e-90f5-50cd06575d70",
                                                "text": "Wij verwelkomen graag een leerling zoals u, om de strenge doch progressieve traditie van de academiem 'Odelle ' Quicks toon was nu zeer scherp."
                                            },
                                            {
                                                "example_id": "9340cef4-d6da-412f-8cd3-f3926e6dd9d4",
                                                "sense_id": "8fda2686-d3f1-336e-90f5-50cd06575d70",
                                                "text": "Een onbekende stem vertelde een eindeloos lange mop met een zeer matige clou, maar ik was allang blij afgeleid te worden."
                                            },
                                            {
                                                "example_id": "316b9333-7f10-4ce6-b840-193fef813157",
                                                "sense_id": "8fda2686-d3f1-336e-90f5-50cd06575d70",
                                                "text": "Het was dus maar zeer de vraag of het iets had uitgemaakt als hijzelf aanwezig had kunnen zijn bij de laatste fase van het storten, toen het ongeluk plaatsvond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
