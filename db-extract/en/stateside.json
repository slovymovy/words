                                "sense_id": "62296ef7-7055-3cea-babc-6e789601c15d",
                                "text": "I'll be stateside for the next month."
                            },
                            {
                                "example_id": "511e7419-c53a-4535-b035-13687a97c756",
                                "sense_id": "62296ef7-7055-3cea-babc-6e789601c15d",
                                "text": "You'll need a valid stateside motorcycle license."
