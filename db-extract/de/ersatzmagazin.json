                    {
                        "sense_id": "08c41ad7-a7f0-3a0c-865e-0a75d8e2424b",
                        "entry_id": "82d7c76a-a2b5-3ba9-8b67-e87b4e21adb5",
                        "glosses": [
                            "vorrätig gehaltenes, mitgeführtes Munitionsmagazin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879e2160-78f4-48d1-8aba-440c99ddc5aa",
                                "sense_id": "08c41ad7-a7f0-3a0c-865e-0a75d8e2424b",
                                "text": "„Er stopfte sich sechs Ersatzmagazine in die Tasche, anschließend holte er aus der obersten Schublade die lederne Knöchelscheide für sein Kampfmesser.“"
                            },
                            {
                                "example_id": "0b179aac-ef36-4362-90b9-30e9f2283fd8",
                                "sense_id": "08c41ad7-a7f0-3a0c-865e-0a75d8e2424b",
                                "text": "„Er wusste nicht, über wie viele Ersatzmagazine sein Gegner verfügte, aber er ging nicht davon aus, dass er mit seinem 72er-Vorrat mithalten konnte.“"
                            },
                            {
                                "example_id": "ad61afcb-6a1e-4e96-bb8a-df9d43541a8e",
                                "sense_id": "08c41ad7-a7f0-3a0c-865e-0a75d8e2424b",
                                "text": "„Da blieb nur seine Waffe. Und das Ersatzmagazin, das er beiseite gelegt hatte.“"
                            },
                            {
                                "example_id": "4428b60d-3feb-46c2-8c62-0aceb86c835c",
                                "sense_id": "08c41ad7-a7f0-3a0c-865e-0a75d8e2424b",
                                "text": "„Er lud die Maschinenpistole und warf sie zusammen mit den Ersatzmagazinen auf den Beifahrersitz.“"
                            },
                            {
                                "example_id": "4112ba3d-db31-41c6-ae46-197643f4108f",
                                "sense_id": "08c41ad7-a7f0-3a0c-865e-0a75d8e2424b",
                                "text": "„Ich zog die oberste Schublade der Kommode auf, fand darin drei deutsche Parabellum, Ersatzmagazine und einzelne Patronen - und musste über Johnnys ausgefallenen Geschmack lachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
