                        "glosses": [
                            "Variante de foutre (dans son sens sexuel)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5735f82-e0e9-45e9-b47c-e6ee14179873",
                                "sense_id": "baf4bc15-9d9d-3086-bd45-ac3be4394d13",
                                "text": "Faisons quelques nouvelles folies, mon ange... passe dans la chambre de ton mari, je l'entends foutimacer encore ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "8b6de67e-37f3-3cbf-b881-e3122b28a12c",
                        "entry_id": "4faab638-53ce-361c-ad54-a1d71795b0ea",
                        "glosses": [
                            "Causer des désagréments à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d82e9bd8-5264-4194-86fe-9c5539f69c6f",
                                "sense_id": "8b6de67e-37f3-3cbf-b881-e3122b28a12c",
                                "text": "L'on applaudit à cette motion, sur-tout, lorsqu'elle dit, on nous a tant foutimacé, on a pris si souvent le Royaume à contrepoil, qu'il nous faut un Dauphin de notre façon."
                            }
                        ]
