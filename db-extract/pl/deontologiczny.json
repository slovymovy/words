                    },
                    {
                        "translation_id": "f4fac0ed-f16a-467e-b6e2-4b984fc051a3",
                        "source_entry_id": "e3f1997d-4580-3f0d-9fcd-6e385dd46cd7",
                        "source_sense_id": "d834cfa9-f409-3d64-bc32-5d976a762315",
                        "target_lang_word": "deontologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deontologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d682b621-81ce-3e54-8919-6f914a02762a",
                                        "entry_id": "b8c590a3-7456-3f42-b676-d412f934fe38",
                                        "glosses": [
                                            "die Deontologie betreffend"
                                        ],
                                        "tags": [
                                            "Ethik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a677cb54-123f-4a32-886b-779285fcbe21",
                                                "sense_id": "d682b621-81ce-3e54-8919-6f914a02762a",
                                                "text": "„Ein deontologisches Quadrat auf der Basis einer Exklusion zwischen einer Verpflichtungsnorm und einer Erlaubnisnorm ergibt sich nur, wenn einer Verpflichtungsnorm und eine Erlaubnisnorm nicht zugleich gelten können […].“"
                                            },
                                            {
                                                "example_id": "2d14b337-537c-4b34-b5bf-014235c8d23b",
                                                "sense_id": "d682b621-81ce-3e54-8919-6f914a02762a",
                                                "text": "„Grundrechtliche Gewährleistungen begrenzen die Teleologie im Recht als deontologisches Korrektiv.“"
                                            },
                                            {
                                                "example_id": "d879e6a7-af41-47e1-bbcb-775149209091",
                                                "sense_id": "d682b621-81ce-3e54-8919-6f914a02762a",
                                                "text": "„Andererseits enthält auch der Utilitarismus ein deontologisches Moment. Er behauptet nämlich, [..] der Grundsatz, das Wohlergehen der Betroffenen zu befördern, sei in sich gut […].“"
                                            },
                                            {
                                                "example_id": "a3b2a620-220f-4079-8a52-a274d8f5e557",
                                                "sense_id": "d682b621-81ce-3e54-8919-6f914a02762a",
                                                "text": "„Deontologische Ethiken werden ganz allgemein dadurch charakterisiert, dass sie auf die kategorische Geltung von Rechten und Pflichten rekurrieren und es im Unterschied zum utlitaristischen Ansätzen für unzulässig ansehen, die Begründung von Normen auf Erwägungen zu stützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae38491-4b86-44ae-a480-d2e86cdcca79",
                        "source_entry_id": "e3f1997d-4580-3f0d-9fcd-6e385dd46cd7",
