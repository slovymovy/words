                "senses": [
                    {
                        "sense_id": "48a6d87e-c4ad-345c-8a4e-b4fa9736246a",
                        "entry_id": "2c63ec1b-f853-3e9b-8f37-c02e64b39bdc",
                        "glosses": [
                            "die obere Abschlussfläche einer Mauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3ef344-5bc8-45a4-a914-0d59feee1f89",
                                "sense_id": "48a6d87e-c4ad-345c-8a4e-b4fa9736246a",
                                "text": "Er ist über die Mauerkrone geklettert."
                            },
                            {
                                "example_id": "968d49c5-2c61-41aa-90f7-22e675ee1444",
                                "sense_id": "48a6d87e-c4ad-345c-8a4e-b4fa9736246a",
                                "text": "„Über der Mauerkrone dehnte sich das stählerne Grau des schottischen Abendhimmels.“"
                            },
                            {
                                "example_id": "599f1ee0-7e1e-4373-a5a8-ccd2bd0f70d9",
                                "sense_id": "48a6d87e-c4ad-345c-8a4e-b4fa9736246a",
                                "text": "„Auf den Mauerkronen sah ich die Zinnen, die zum größten Teil unversehrt waren; sie stammten immerhin aus dem zweiten Punischen Krieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
