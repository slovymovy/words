                                "target_senses": [
                                    {
                                        "sense_id": "1196aaab-c27e-388d-b56a-856131ef9e6c",
                                        "entry_id": "d684ba8e-ca81-336f-8d4f-3b94ff3c5673",
                                        "glosses": [
                                            "Relatif au sacrum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88121d68-6fae-4b64-9e4d-99431184375e",
                                                "sense_id": "1196aaab-c27e-388d-b56a-856131ef9e6c",
                                                "text": "Le Tableau 9.1 récapitule les principales caractéristiques des vertèbres cervicales, thoraciques, lombales et sacrales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd45399f-740c-3fce-b65c-3939feee53b2",
                                        "entry_id": "d684ba8e-ca81-336f-8d4f-3b94ff3c5673",
                                        "glosses": [
                                            "Sacré, religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e64115a-d853-4603-bdd2-c1ce5c5bb714",
                                                "sense_id": "cd45399f-740c-3fce-b65c-3939feee53b2",
                                                "text": "Ceux-ci se perçoivent, en effet, comme membres d’une petite société politique qui se voit transformée, en vertu de la célébration liturgique, en une communauté sacrale réalisant la perfection islamique."
                                            },
                                            {
                                                "example_id": "458f02fb-acc3-4d13-88ff-0ca38d098e32",
                                                "sense_id": "cd45399f-740c-3fce-b65c-3939feee53b2",
                                                "text": "De toute façon, peuvent-ils dire : « La laïcité, c’est une affaire d’Occidentaux des sociétés sécularisées», ce qui ne tient pas compte des nombreuses sociétés sacrales qui existent encore aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d610e090-b39f-4de3-939f-0facc85cc8d0",
                        "source_entry_id": "0dfe479e-1b92-34ab-979b-93bb77ba3844",
                        "source_sense_id": "78d13f9d-b263-3576-bb24-8ea7633e3db4",
                        "target_lang_word": "sakral",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sakral",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97cbf864-1ac7-3f88-8e2d-b023b344b00d",
                                        "entry_id": "c2c47bd2-809c-30b2-a180-8ecc5ee3cf5a",
                                        "glosses": [
                                            "heilig, kirchlich; den Gottesdienst betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "392bb6be-b6d1-4ca5-8ae5-4e1196fac1d7",
                                                "sense_id": "97cbf864-1ac7-3f88-8e2d-b023b344b00d",
                                                "text": "„Ein solches Volk oder Völkerbündnis der Alemannen usw. bildete nun durchaus keinen Staat, nur einen sakral und politisch vereinten Staatenbund […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04b1bba8-7a39-3861-abab-594c08f803fa",
                                        "entry_id": "c2c47bd2-809c-30b2-a180-8ecc5ee3cf5a",
                                        "glosses": [
                                            "das Kreuzbein (Os sacrum) betreffend, zum Kreuzbein gehörend"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b85cee01-3490-4a75-979e-c88a2458d725",
                                                "sense_id": "04b1bba8-7a39-3861-abab-594c08f803fa",
                                                "text": "Insbesondere beim Marfan-Syndrom finden sich oft weitere sakrale Veränderungen, vor allem eine sakrale Ektasie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df8bb4f9-90be-4ad8-8275-7611517df2e3",
                        "source_entry_id": "0dfe479e-1b92-34ab-979b-93bb77ba3844",
                        "source_sense_id": "78d13f9d-b263-3576-bb24-8ea7633e3db4",
                        "target_lang_word": "сакральный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сакральный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "76eb1c60-8f93-3533-9b70-ce9af3aaffe1",
                                        "entry_id": "9a5c2a92-9925-3cbc-88a3-74317f024379",
                                        "glosses": [
                                            "книжн. относящийся к религиозному культу; священный, ритуальный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9b9bc5-7d11-4098-ba01-e8b7b374948c",
                                                "sense_id": "76eb1c60-8f93-3533-9b70-ce9af3aaffe1",
                                                "text": "Ислам начал с того, что обратил народ, среди которого возник, — арабов. Арабский язык, язык основателя религии, до сих пор остается её сакральным языком."
                                            },
                                            {
                                                "example_id": "263af490-a1f5-47ef-8ef2-1952d1cff273",
                                                "sense_id": "76eb1c60-8f93-3533-9b70-ce9af3aaffe1",
                                                "text": "По своей теургической природе миф имеет необходимую связь с культом как системой сакральных и теургических действий, богодейством и богослужением."
                                            },
                                            {
                                                "example_id": "9cc109f8-be2d-4daa-92fa-126bdca1f43a",
                                                "sense_id": "76eb1c60-8f93-3533-9b70-ce9af3aaffe1",
                                                "text": "Вся эта скульптура была сакральной; изваяния людей-современников допускались только в тех случаях, когда их освятила либо победа — на всеэллинских играх, либо смерть."
                                            },
                                            {
                                                "example_id": "07909977-5746-4b2b-90a9-88ecd6dbb53e",
                                                "sense_id": "76eb1c60-8f93-3533-9b70-ce9af3aaffe1",
                                                "text": "Даже узор на гуслях носил сакральный характер, оберегая от опасности и бед или призывая духов музыки."
                                            }
                                        ]
                                    }
                                ]
                            },
