                                "target_senses": [
                                    {
                                        "sense_id": "89eac26a-27ed-3766-a80a-5d7b30c6408a",
                                        "entry_id": "8ef49ecb-f01c-393e-9de1-302cee0953fb",
                                        "glosses": [
                                            "upadły anioł"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ed3aa9-ed31-40ba-b3e1-f43d9a7f6e52",
                                                "sense_id": "89eac26a-27ed-3766-a80a-5d7b30c6408a",
                                                "text": "Ale przed nim miał jeszcze przyjść diabeł filozof, oświeceniowy intelektualista, goetheański Mefistofeles"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ba5615c-7e8c-4114-a50c-2bd96fe8cd80",
                        "source_entry_id": "d782133c-e479-3373-908c-45347508e282",
                        "source_sense_id": "e22713b3-9784-3230-b6f7-878a75bfcb1c",
                        "source_sense_description": "Devil to whom Faust sold his soul",
                        "target_lang_word": "Мефисто́фель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Мефисто́фель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11f26d7f-ee8f-3777-88eb-e19dd25285b3",
                                        "entry_id": "d102d551-d4f4-3084-83c2-3e8771430234",
                                        "glosses": [
                                            "религ., мифол. : злой дух, дьявол, демон, чёрт, бес, чаще всего, по преданию, падший ангел, Сатана"
                                        ],
                                        "tags": [
                                            "мифологии народов Западной Европы"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "280b7745-697f-4783-b113-91bfba52b08b",
                                                "sense_id": "11f26d7f-ee8f-3777-88eb-e19dd25285b3",
                                                "text": "Вадим стоял перед ней, как Мефистофель перед погибшею Маргаритой, с язвительным выражением очей, как раскаяние перед душою грешника"
                                            },
                                            {
                                                "example_id": "6542f46e-8051-49ee-a840-48d1a22aa921",
                                                "sense_id": "11f26d7f-ee8f-3777-88eb-e19dd25285b3",
                                                "text": "И едва состоялась сделка, он начинает мучить Мефистофеля вопросами о том, где находится ад, сколько небес громоздится за луной, какое у них движение и многое еще в этом роде."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae04717f-7dd0-3816-8549-ab2315ab6cf5",
                                        "entry_id": "d102d551-d4f4-3084-83c2-3e8771430234",
                                        "glosses": [
                                            "поэт. употребляется метафорически как символ отрицания морально-нравственных устоев и доброго начала в человеке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32eb86ed-0289-453e-931d-56805a2b3511",
                                                "sense_id": "ae04717f-7dd0-3816-8549-ab2315ab6cf5",
                                                "text": "― Этот Германн, ― продолжал Томский, ― лицо истинно романическое: у него профиль Наполеона, а душа Мефистофеля."
                                            },
                                            {
                                                "example_id": "cb3389d4-e3a6-41fb-92d4-9e57ffac8385",
                                                "sense_id": "ae04717f-7dd0-3816-8549-ab2315ab6cf5",
                                                "text": "Ох уж эта Ира! Вот кого надо вывести в качестве персонажа, и не просто отрицательного, а злодейки, ходячей чумы, Мефистофеля в юбке, да еще и уродиной сделать, кривоногой с большущим носом и рыбьими глазами…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
