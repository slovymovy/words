                    {
                        "sense_id": "3e82581d-7a88-3427-bad9-b5632c2b676e",
                        "entry_id": "964f4c58-9206-3640-b033-bf25ef8ef53d",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord pop"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "45c3bf7c-90bb-41a6-ac67-ea0ad66268f3",
                                "sense_id": "3e82581d-7a88-3427-bad9-b5632c2b676e",
                                "text": "Sinds de poppen en de kleine Pibo heeft Nella niets meer ontvangen, en ze begint ongeduldig te worden."
                            },
                            {
                                "example_id": "16c25a05-2e88-4924-bc71-76c28313dcbf",
                                "sense_id": "3e82581d-7a88-3427-bad9-b5632c2b676e",
                                "text": "Hij mag niet weten dat Nella naar de vliering is geslopen en de poppen van hem en Maren tevoorschijn heeft gehaald, omdat ze dolgraag wilde dat de miniatuurmaakster ingreep en hun lot gunstig zou beïnvloeden."
                            }
                        ]
                    }
