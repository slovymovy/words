                                "target_senses": [
                                    {
                                        "sense_id": "b7d40a59-d9e4-3be0-99fb-3fb89a2647aa",
                                        "entry_id": "1df72e33-f975-3c63-9502-1559d6aafe32",
                                        "glosses": [
                                            "Of or relating to the Goths or their language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77e4a639-6d7f-3a80-901b-2a38f26bbdb0",
                                        "entry_id": "1df72e33-f975-3c63-9502-1559d6aafe32",
                                        "glosses": [
                                            "Barbarous, rude, unpolished, belonging to the “Dark Ages”, medieval as opposed to classical."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f4e998-88a3-455e-8bc5-2c40fe34cc58",
                                                "sense_id": "77e4a639-6d7f-3a80-901b-2a38f26bbdb0",
                                                "text": "“[W]hat he holds of all things to be most gothic, is gallantry to the women.”"
                                            },
                                            {
                                                "example_id": "68225519-f2de-4f97-8c2f-496d24a83ff8",
                                                "sense_id": "77e4a639-6d7f-3a80-901b-2a38f26bbdb0",
                                                "text": "Enormities which gleam like comets through the darkness of gothic and superstitious ages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e644b244-c1fc-3bcc-9c3f-525c9acf7146",
                                        "entry_id": "1df72e33-f975-3c63-9502-1559d6aafe32",
                                        "glosses": [
                                            "Of or relating to the architectural style favored in Western Europe in the 12th to 16th centuries, with high-pointed arches, clustered columns, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e71f78c2-6f72-40e0-9c79-a59df5573512",
                                                "sense_id": "e644b244-c1fc-3bcc-9c3f-525c9acf7146",
                                                "text": "Gothic arches"
                                            },
                                            {
                                                "example_id": "263a2811-2b6f-4470-96be-2915de91d1ca",
                                                "sense_id": "e644b244-c1fc-3bcc-9c3f-525c9acf7146",
                                                "text": "Or does the L.C.C. [London County Council] dislike nineteenth century Gothic?"
                                            },
                                            {
                                                "example_id": "1bfacbb0-741e-483c-a9f5-58532dd32d35",
                                                "sense_id": "e644b244-c1fc-3bcc-9c3f-525c9acf7146",
                                                "text": "The Gothic style did not cease to exist: it did, however, cease to be all-powerful, and it almost ceased to create new forms. Gothic architects had by this time drawn every possible conclusion from the premises which had been laid down […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d84779d7-cd9c-3ae6-b37c-1fe67fdacada",
                                        "entry_id": "1df72e33-f975-3c63-9502-1559d6aafe32",
                                        "glosses": [
                                            "Of or relating to the style of fictional writing associated with Gothic fiction, emphasizing violent or macabre events in a mysterious, desolate setting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f75addf-865f-455d-ae9a-0e856a51e164",
                                                "sense_id": "d84779d7-cd9c-3ae6-b37c-1fe67fdacada",
                                                "text": "Gothic tales"
                                            },
                                            {
                                                "example_id": "d4de82c3-f661-4f82-a17b-fc6432018160",
                                                "sense_id": "d84779d7-cd9c-3ae6-b37c-1fe67fdacada",
                                                "text": "Shelley's two early novels Zastrozzi and St. Irvyne are, as many scholars have noted, obviously connected to the tradition of the Gothic novel; as well, two volumes of early poetry contain Gothic elements and his tragedy The Cenci has been […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b114eb-f453-3d4a-8b08-01dc5992a625",
                                        "entry_id": "1df72e33-f975-3c63-9502-1559d6aafe32",
                                        "glosses": [
                                            "Synonym of black letter."
                                        ],
                                        "tags": [
                                            "England"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c35a7c-bbf1-478b-a701-133b9b8382ec",
                                                "sense_id": "a3b114eb-f453-3d4a-8b08-01dc5992a625",
                                                "text": "Gothic letters"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b391194-b5b4-3a41-bf63-406bcea52360",
                                        "entry_id": "1df72e33-f975-3c63-9502-1559d6aafe32",
                                        "glosses": [
                                            "Of a sans serif typeface using straight, even-width lines, also known as grotesque or lineal."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ce64725-394c-31b0-95a8-89cd4906bbfc",
                                        "entry_id": "1df72e33-f975-3c63-9502-1559d6aafe32",
                                        "glosses": [
                                            "Of or relating to the goth subculture, music or lifestyle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ff88e1-3a38-4706-a120-4dbba183418d",
                                                "sense_id": "0ce64725-394c-31b0-95a8-89cd4906bbfc",
                                                "text": "Gothic rock"
                                            },
                                            {
                                                "example_id": "bf375fb2-6e5f-41ab-8492-a91f66fd699a",
                                                "sense_id": "0ce64725-394c-31b0-95a8-89cd4906bbfc",
                                                "text": "Gothic dress"
                                            },
                                            {
                                                "example_id": "3295d001-94fb-467f-9276-cbfb762d1851",
                                                "sense_id": "0ce64725-394c-31b0-95a8-89cd4906bbfc",
