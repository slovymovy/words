                        "entry_id": "3bf664e1-dc00-31dd-8737-1a3cd9ef5434",
                        "glosses": [
                            "een driehoekige rode reflector die in sommige Europese landen verplicht in de auto aanwezig moet zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8554ef0-6527-4c92-8597-6b548028bd31",
                                "sense_id": "d18b3544-daf5-31a7-9f8b-ebd6f6e3790b",
                                "text": "Moet ik een gevarendriehoek in mijn auto hebben?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8390093d-2e37-4751-8f48-3590d7ee7c31",
                        "source_entry_id": "3bf664e1-dc00-31dd-8737-1a3cd9ef5434",
                        "source_sense_id": "d18b3544-daf5-31a7-9f8b-ebd6f6e3790b",
                        "source_sense_description": "1een driehoekige rode reflector",
                        "target_lang_word": "Warnschild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warnschild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab920c57-398d-33ab-8429-f1ee2ad91a5d",
                                        "entry_id": "8dd80446-6f38-3823-9969-8fbe7b8eabca",
                                        "glosses": [
                                            "sichtbar aufgestellte Hinweistafel mit einem Piktogramm, die vor einer Gefahr warnen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f0cb06-1c48-45ab-b1a0-fe1b00555ca1",
                                                "sense_id": "ab920c57-398d-33ab-8429-f1ee2ad91a5d",
                                                "text": "Das Warnschild am Wegrand weist auf umsturzgefährdete Bäume hin."
                                            },
                                            {
                                                "example_id": "ea3f7d28-ae37-46c8-9e86-6e330dd3efc9",
                                                "sense_id": "ab920c57-398d-33ab-8429-f1ee2ad91a5d",
                                                "text": "In der Werkstatt hängen verschiedene Warnschilder, weil dort mit Benzin gearbeitet wird."
                                            },
                                            {
                                                "example_id": "6bd58ee7-86c9-466e-a95a-4618c16559c0",
                                                "sense_id": "ab920c57-398d-33ab-8429-f1ee2ad91a5d",
                                                "text": "Die Schwimmer ignorieren die Warnschilder am Strand und begeben sich so in Lebensgefahr."
                                            },
                                            {
                                                "example_id": "f2d642d6-8e71-48e7-b5a3-02e73861b306",
                                                "sense_id": "ab920c57-398d-33ab-8429-f1ee2ad91a5d",
                                                "text": "„Versuchen Sie nicht, Isländer davon zu überzeugen, dass Walfang schlecht ist.“"
                                            },
                                            {
                                                "example_id": "70f7b78c-0880-42a8-a664-a878e2e5d362",
                                                "sense_id": "ab920c57-398d-33ab-8429-f1ee2ad91a5d",
                                                "text": "„Nur Hypochonder, die im Wartezimmer von einem Warnschild ersucht werden, mit anderen Patienten keine Symptome auszutauschen, geben offene Rebellionen gegen ihre Ärzte nicht auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61469b17-1494-4361-9110-7967374fdccf",
                        "source_entry_id": "3bf664e1-dc00-31dd-8737-1a3cd9ef5434",
