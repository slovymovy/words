                        "form": "das Dossier"
                    },
                    {
                        "form_id": "d14307db-2ae1-4781-a772-5b3324e317d7",
                        "entry_id": "79648f72-0d1d-3ead-875d-88ab664dedc8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dossiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5614c5f0-aaa3-33a4-9dca-821363d3a5ac",
                        "entry_id": "79648f72-0d1d-3ead-875d-88ab664dedc8",
                        "glosses": [
                            "Aktensammlung, Zusammenstellung von Datenmaterial zu einem Vorgang, zu einem Thema, zu einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e564823c-19c8-4bb1-a073-61e1b5fdde24",
                                "sense_id": "5614c5f0-aaa3-33a4-9dca-821363d3a5ac",
                                "text": "„Jetzt aber war es für mich belustigend, wie er genau das Dossier studierte mit dem überflüssigsten Scharfsinn.“"
                            },
                            {
                                "example_id": "6e69b650-3a8b-4eee-b599-3780b6fe046d",
                                "sense_id": "5614c5f0-aaa3-33a4-9dca-821363d3a5ac",
                                "text": "„Bei ihrem Treffen mit Bush übergab die Familie des ermordeten Familienvaters dem amerikanischen Präsidenten ein Dossier, das ihre gegen die IRA erhobenen Vorwürfe im Detail darlegt und konkrete Anschuldigungen erhebt.“"
                            },
                            {
                                "example_id": "5f667c15-2dbf-4db7-af48-0053beee48b4",
                                "sense_id": "5614c5f0-aaa3-33a4-9dca-821363d3a5ac",
                                "text": "„Wenn ich heute das Dossier durchsehe, in dem ich alle heiklen Momente eingetragen habe, die mir – als ahnungslosem Reisenden oder als alarmiertem Reporter – begegnet sind, dann überkommen mich verschiedene Gefühle.“"
                            },
                            {
                                "example_id": "f8f7c669-9915-45a4-afe0-baa608628477",
                                "sense_id": "5614c5f0-aaa3-33a4-9dca-821363d3a5ac",
                                "text": "„Weder die Deutsche Abwehr noch der französische Geheimdienst sollten die Dossiers bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7886b01d-67ca-304d-a7eb-638520737ddc",
                        "entry_id": "79648f72-0d1d-3ead-875d-88ab664dedc8",
                        "glosses": [
                            "Teil einer Zeitung (oder Beilage), der ausführliche Dokumentationen, Informationen zu einem Themengebiet enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e14b2aef-20c0-4dad-920f-785112b65c0b",
                                "sense_id": "7886b01d-67ca-304d-a7eb-638520737ddc",
                                "text": "„Im Dossier untersuchen fünf Autoren die Motive und Hintergründe für die Hilfewelle nach dem Tsunami.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2626b23-6bbf-437e-ad60-fcba21befebb",
                        "source_entry_id": "79648f72-0d1d-3ead-875d-88ab664dedc8",
                        "source_sense_id": "5614c5f0-aaa3-33a4-9dca-821363d3a5ac",
                        "source_sense_description": "Aktensammlung, Zusammenstellung von Datenmaterial",
                        "target_lang_word": "dossier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dossier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "472f2e97-0cfa-3904-b6fc-be3f760f16c9",
                                        "entry_id": "289f6ba0-c2fa-3b54-9f46-6cc86c15074a",
                                        "glosses": [
                                            "A collection of papers and/or other sources, containing detailed information about a particular person or subject, together with a synopsis of their content."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51c6d9f-0b86-411e-befa-5b7684a6a294",
                                                "sense_id": "472f2e97-0cfa-3904-b6fc-be3f760f16c9",
                                                "text": "For Lothian and Borders Police, the early-morning raid had come at the end one of biggest investigations carried out by the force, which had originally presented a dossier of evidence on the murder of Jodi Jones to the Edinburgh procurator-fiscal, William Gallagher, on 25 November last year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79ef0594-cf69-4702-a301-9089ca90a450",
                        "source_entry_id": "79648f72-0d1d-3ead-875d-88ab664dedc8",
                        "source_sense_id": "5614c5f0-aaa3-33a4-9dca-821363d3a5ac",
                        "source_sense_description": "Aktensammlung, Zusammenstellung von Datenmaterial",
                        "target_lang_word": "dossier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dossier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Partie d’un siège contre laquelle on pose le dos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04abe9cf-2556-47d8-855b-d02a2facca53",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Sur les crédences en style de la Renaissance se dressaient des figures de sirènes, et les chaises en bois sculpté avaient des dossiers surmontés de têtes de femmes dans le goût Henri II."
                                            },
                                            {
                                                "example_id": "cc950c09-98c9-4b18-9a72-53b38056a6e0",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Assis dans un petit fauteuil à dossier bref, papa travaillait."
                                            },
                                            {
                                                "example_id": "b8917d4a-190b-4d00-90e7-45276c12a056",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Il chevaucha une chaise, s'approcha du poêle et se croisa les bras sur le dossier."
                                            },
                                            {
                                                "example_id": "625cdba6-4f68-41a3-86f0-a8cf20cc61c0",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "[…] ; la gorge nouée, Adeline s'était mise à triturer un petit morceau de cuir qui dépassait d'un clou tapissier mal fixé au dossier du fauteuil fauve qu'elle regardait avec intensité pour détourner ses larmes."
                                            },
                                            {
                                                "example_id": "48c8167e-616f-4bc8-b8ae-8c27ffbb0800",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Jordan pointa un doigt interrogateur sur un appareil doté d'une seringue, fixé au dossier du fauteuil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70da6ed-e9c3-3793-abbd-852bd1851c24",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Assemblage de documents regroupés dans un but déterminé. (Une liasse de papiers étiquetée au dos)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd1fc838-4101-4cfa-a896-247f1488c450",
                                                "sense_id": "c70da6ed-e9c3-3793-abbd-852bd1851c24",
                                                "text": "Concentrez-vous sur vos dossiers."
                                            },
                                            {
                                                "example_id": "79c3316e-86c8-4d48-a054-3113cc6a0470",
                                                "sense_id": "c70da6ed-e9c3-3793-abbd-852bd1851c24",
                                                "text": "« Voilà le dossier de votre père… » dit-elle en lui tendant une mince chemise. Le mot de dossier paraissait un peu exagéré: il y avait une feuille recto-verso, rédigée en suisse allemand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "331ba470-ee28-3c8d-b928-09cc7e6d90ed",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Pièces d’un procès ou d’archives."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e01edb-cc57-46b9-afab-e331d4821d70",
                                                "sense_id": "331ba470-ee28-3c8d-b928-09cc7e6d90ed",
                                                "text": "Le secours allait venir aux révisionnistes du côté où on l'attendait le moins. Une pièce du dossier secret, deux fois rendue publique, se trouva être un faux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2313f114-6a80-35c1-8256-8fa4475560a1",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Ensemble de pièces concernant telle ou telle personne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecdc2ac2-38c9-4d60-b0f0-af419adb53a0",
                                                "sense_id": "2313f114-6a80-35c1-8256-8fa4475560a1",
                                                "text": "Il s'agit de se tenir à l'affut des affaires, de les suivre de près, de constituer des dossiers sur chacun des as de la finance tripatouillarde, d'étudier leurs faiblesses et même leurs vices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1b3786-83e1-3d96-ba32-c413d17bbe7c",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Répertoire, emplacement virtuel dans lequel peuvent se trouver d’autres dossiers ou des fichiers informatiques d’un système de fichier en arborescence."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cbf1f4f-bfdf-3b26-a373-fa9fa082ae99",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Anecdote embarrassante concernant une personne."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9962027-0fb7-350b-b16e-1e9c19b2a62e",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Sur un wagon couvert de chemin de fer, partie étroite de la caisse positionnée du côté des attelages, reliant le châssis au toit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a22577d2-9c6d-4fe4-87e0-2bc151d4ff5a",
                        "source_entry_id": "79648f72-0d1d-3ead-875d-88ab664dedc8",
