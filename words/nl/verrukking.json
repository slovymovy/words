                            }
                        },
                        {
                            "text": "Het publiek keek met <w>verrukking</w> naar het prachtige optreden van de jonge danseres.",
                            "target_lang_translations": {
                                "en": "The audience watched the young dancer's beautiful performance with <w>rapture</w>.",
                                "fr": "Le public regardait avec <w>enchantement</w> la magnifique prestation de la jeune danseuse."
                            }
                        }
