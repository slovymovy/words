            "senses": [
                {
                    "sense_id": "8f27b388-b995-3195-9775-23b023101754",
                    "sense_definition": "The capital city of the Philippines.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "city_location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We booked a flight to <w>Manila</w> for our summer vacation.",
