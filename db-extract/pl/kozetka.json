                "senses": [
                    {
                        "sense_id": "b340edbe-ce99-397a-8dfd-377e02154305",
                        "entry_id": "1fa07e2a-3838-3e71-a9d8-7f57aedde6f4",
                        "glosses": [
                            "wąski mebel bez oparcia, przeznaczony do leżenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce45bebf-bca5-47e0-98e1-e709bc29e582",
                                "sense_id": "b340edbe-ce99-397a-8dfd-377e02154305",
                                "text": "Otuliła się w wytarte futro, umieściła się wygodniej na kozetce i powróciła do książki"
                            },
                            {
                                "example_id": "f3b31db5-6051-431c-a486-a9f9fc34a13e",
                                "sense_id": "b340edbe-ce99-397a-8dfd-377e02154305",
                                "text": "Podchodzę do kozetki i układam się wygodnie. Zamykam oczy, ale natychmiast otwieram je na powrót, bo doznaję nieprzyjemnego uczucia zapadania się, zupełnie jak po dużej dawce alkoholu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
