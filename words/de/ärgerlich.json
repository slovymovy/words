                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verursachend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist wirklich sehr <w>ärgerlich</w>, dass unser Zug heute schon wieder Verspätung hat.",
                            "target_lang_translations": {
                                "en": "It is really very <w>annoying</w> that our train is delayed again today.",
                                "ru": "Действительно очень <w>досадно</w>, что наш поезд сегодня опять опаздывает.",
                                "nl": "Het is echt heel <w>vervelend</w> dat onze trein vandaag alweer vertraging heeft.",
                                "pl": "To naprawdę bardzo <w>irytujące</w>, że nasz pociąg znowu ma dzisiaj opóźnienie.",
                                "fr": "Il est vraiment très <w>agaçant</w> que notre train ait encore du retard aujourd'hui.",
                                "it": "È davvero molto <w>seccante</w> che il nostro treno sia di nuovo in ritardo oggi.",
                                "cs": "Je opravdu velmi <w>mrzuté</w>, že náš vlak má dnes zase zpoždění.",
                                "tr": "Trenimizin bugün yine rötarlı olması gerçekten çok <w>can sıkıcı</w>.",
                                "es": "Es realmente muy <w>molesto</w> que nuestro tren vuelva a llegar con retraso hoy.",
                                "zh": "我们的火车今天居然又晚点了，这真<w>令人恼火</w>。"
                            }
                        },
                        {
                            "text": "Durch einen <w>ärgerlichen</w> Fehler gingen leider alle ungespeicherten Daten der letzten zwei Stunden verloren.",
                            "target_lang_translations": {
                                "en": "Unfortunately, all unsaved data from the last two hours were lost due to an <w>annoying</w> mistake.",
                                "ru": "Из-за одной <w>досадной</w> ошибки, к сожалению, пропали все несохранённые данные за последние два часа.",
                                "nl": "Door een <w>vervelende</w> fout gingen helaas alle niet-opgeslagen gegevens van de afgelopen twee uur verloren.",
                                "pl": "Przez <w>przykry</w> błąd niestety przepadły wszystkie niezapisane dane z ostatnich dwóch godzin.",
                                "fr": "À cause d'une <w>fâcheuse</w> erreur, toutes les données non enregistrées des deux dernières heures ont malheureusement été perdues.",
                                "it": "A causa di uno <w>spiacevole</w> errore, purtroppo sono andati persi tutti i dati non salvati delle ultime due ore.",
                                "cs": "Kvůli <w>nepříjemné</w> chybě se bohužel ztratila všechna neuložená data za poslední dvě hodiny.",
                                "tr": "<w>Can sıkıcı</w> bir hata yüzünden son iki saatin kaydedilmemiş tüm verileri maalesef kayboldu.",
                                "es": "Por un <w>fastidioso</w> error, por desgracia se perdieron todos los datos no guardados de las últimas dos horas.",
                                "zh": "由于一个<w>令人懊恼的</w>错误，过去两小时所有未保存的数据遗憾地丢失了。"
                            }
                        }
