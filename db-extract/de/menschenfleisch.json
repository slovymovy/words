                        "cross_references": []
                    },
                    {
                        "translation_id": "8f712ef9-7015-45f3-8be0-07fb4e48f978",
                        "source_entry_id": "8cafda07-4087-323e-a947-0ea45be9a25a",
                        "source_sense_id": "7a882253-070b-3520-b942-e1d476d83884",
                        "source_sense_description": "Fleisch vom Menschen",
                        "target_lang_word": "mensenvlees",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mensenvlees",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a78c0e50-55a7-3ccc-bed3-548eab656d5b",
                                        "entry_id": "c6d393bd-9a53-3350-9054-36bb1aebc527",
                                        "glosses": [
                                            "het vlees van mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85774028-0df6-43c7-9484-f6d8cb94c4ea",
                                                "sense_id": "a78c0e50-55a7-3ccc-bed3-548eab656d5b",
                                                "text": "In Moldavië zijn twee vrouwen gearresteerd wegens het verkopen van mensenvlees. Ze vertelden de politie dat het mensenvlees afkomstig was uit een ziekenhuis voor kankerpatiënten. Naar de rol van dat ziekenhuis wordt een onderzoek ingesteld. Moldavië is de afgelopen tien jaar drastisch verpauperd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c2bf905-d523-3ad7-a675-62099bf409c3",
                                        "entry_id": "c6d393bd-9a53-3350-9054-36bb1aebc527",
                                        "glosses": [
                                            "het menselijk lichaam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "746dda65-70f1-4e04-8202-dc3e8d73976e",
                                                "sense_id": "0c2bf905-d523-3ad7-a675-62099bf409c3",
                                                "text": "Het grote gebaar kenmerkt het werk van de Antwerpse schilder Peter Paul Rubens (1577-1640). Grote oppervlakken naakt mensenvlees zijn prominent in zijn werk aanwezig."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9009acf-c632-406c-ad62-e6890974b852",
                        "source_entry_id": "8cafda07-4087-323e-a947-0ea45be9a25a",
                        "source_sense_id": "7a882253-070b-3520-b942-e1d476d83884",
                        "source_sense_description": "Fleisch vom Menschen",
                        "target_lang_word": "человечина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "человечина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "95eeaeef-e9a7-3ea1-b52a-02b72c944d43",
                                        "entry_id": "370d242c-d9d5-3fc2-b810-42340ed331aa",
                                        "glosses": [
                                            "разг. о человеческом трупе, о человеческом мясе как пище (обычно людоедов или хищных зверей, птиц, грызунов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6676fb8e-dfbf-4abc-bed0-aa2007c74601",
                                                "sense_id": "95eeaeef-e9a7-3ea1-b52a-02b72c944d43",
                                                "text": "Потом? А сегодня опять с «человечиной». Это ядение человечины случается всё чаще."
                                            },
                                            {
                                                "example_id": "d6dc3d85-2a84-41ea-a926-3e579039b2a9",
                                                "sense_id": "95eeaeef-e9a7-3ea1-b52a-02b72c944d43",
                                                "text": "Из затопленной берлоги вылез медведь, да раньше срока, и с бескормицы подался на человечину."
                                            },
                                            {
                                                "example_id": "95645741-d338-4ed8-88b9-dbdba41634f2",
                                                "sense_id": "95eeaeef-e9a7-3ea1-b52a-02b72c944d43",
                                                "text": "Через пару недель грызуны, которыми кишит степь, обгладают человечину до костей."
                                            },
                                            {
                                                "example_id": "45fdc4fa-f683-47b9-91e1-75ecf0a3e1ac",
                                                "sense_id": "95eeaeef-e9a7-3ea1-b52a-02b72c944d43",
                                                "text": "Все пересказывали прочитанные в книгах, увиденные в фильмах, услышанные от других страшные истории — например, о каннибалах, которые делали пирожки с человечиной, или про «чёрный-чёрный гроб»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf904c0c-6ea7-3f5f-b049-733cd1503630",
                                        "entry_id": "370d242c-d9d5-3fc2-b810-42340ed331aa",
                                        "glosses": [
                                            "перен. следы, приметы пребывания, присутствия человека, его жилья и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f28b71-3e25-4750-8fba-a2a51c8c5a35",
                                                "sense_id": "bf904c0c-6ea7-3f5f-b049-733cd1503630",
                                                "text": "А то придёт вдруг день и час … и пузатенький дом пропадёт — и вырастет на его месте то, что, по словам моей бабушки, всегда вырастает на месте, где была «человечина», а именно: крапива, репейник, осот, полынь и конский щавель; самой улицы не будет — и придут люди, и ничего уже больше такого не найдут во веки веков!.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "299736ba-4958-32aa-9b50-7bda17ccbced",
                                        "entry_id": "370d242c-d9d5-3fc2-b810-42340ed331aa",
                                        "glosses": [
                                            "перен., собир. люди как источник и причина взаимоотношений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bda265c4-92a8-43bb-9065-e9ef9f040304",
                                                "sense_id": "299736ba-4958-32aa-9b50-7bda17ccbced",
                                                "text": "Это упрощённое природное отношение к женщине-самке давало, освобождало во мне силу любования украшенной поверхностью земли, и «человечина» меня не цепляла."
                                            },
                                            {
                                                "example_id": "eeb16289-c165-4c38-bbfd-38e9cfa7505a",
                                                "sense_id": "299736ba-4958-32aa-9b50-7bda17ccbced",
                                                "text": "Впрочем, кто-то раз обмолвился вскользь на страницах, кажется, «Нового Времени», что очень хорошо это, и не нужно, надоела человечина."
                                            },
                                            {
                                                "example_id": "d1778d4e-f48f-4dec-a838-8275ea330bff",
                                                "sense_id": "299736ba-4958-32aa-9b50-7bda17ccbced",
                                                "text": "Что-то общее, бедовое было в них, пьяницы ли они были горькие или просто бессребреники, но добрые, с открытыми душами люди (не зря их и тянуло друг к другу), и человечина, не работа, в жизни их больше всего интересовала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f519007-fdfd-37c7-8225-db392edb2a80",
                                        "entry_id": "370d242c-d9d5-3fc2-b810-42340ed331aa",
                                        "glosses": [
                                            "перен., собир., редк. большое количество людей; многолюдье"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdc66439-3d6b-4ec8-adb6-10421b6669a8",
                                                "sense_id": "0f519007-fdfd-37c7-8225-db392edb2a80",
                                                "text": "Арбат: многоногая здесь человечина вшаркалась. 〈…〉 Народу напёрло; и все — в одно место; сроился; городовой посредине утряхивал пьяного парня в пролётку и — тёр ему уши; закрывшись плащом, нахлобучил огромную шляпу и рот разрывал, указуя на площадь, — испанец: с плаката «Кино»; под ним дама влачилась мехами; и шла человечина — путчики, свёртчики — в яснь, в светосверки снежиночек; щурили взоры."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "человечина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cd54be27-34e3-3f94-976b-de807fe40500",
                                        "entry_id": "a7d77f47-3781-3878-ba78-934626594ea2",
                                        "glosses": [
                                            "экспр., шутл., пренебр. или усилит. к человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affae62d-fecb-4b92-b63b-878ca5062927",
                                                "sense_id": "cd54be27-34e3-3f94-976b-de807fe40500",
                                                "text": "В табачном дыму, как в мешке, сидел у порога старый губатый человечина."
                                            },
                                            {
                                                "example_id": "0410f67a-9e41-4723-ad68-764b89c5f53f",
                                                "sense_id": "cd54be27-34e3-3f94-976b-de807fe40500",
                                                "text": "В театре это звучит почти «героично», — дескать, глядите, какой человечина, волища какая!"
                                            },
                                            {
                                                "example_id": "b75429ed-accc-4476-a0c0-74ac6aaeae40",
                                                "sense_id": "cd54be27-34e3-3f94-976b-de807fe40500",
                                                "text": "— Заработок это у него, пойми, скудного ты ума человечина, — эхом и заметно серчая на Николкину неуступчивость, заворчали со стороны, а один, в особенности нетерпеливый, даже присоветовал вполголоса, кто поближе, шарахнуть купца разок для вразумленья. 〈…〉 — Да в чём же вы видите изуверство моё, непотребная вы человечина?"
                                            },
                                            {
                                                "example_id": "fda6398d-e136-4f81-9803-39dc884f6ad4",
                                                "sense_id": "cd54be27-34e3-3f94-976b-de807fe40500",
                                                "text": "Глядел не на Ремедия, а на встающее солнце. Могучий человечина, бородища лопатой."
                                            },
                                            {
                                                "example_id": "8aee94e7-8b26-4400-9da6-2a33ac4df7a0",
                                                "sense_id": "cd54be27-34e3-3f94-976b-de807fe40500",
                                                "text": "Как раз тогда я получила телеграмму от Дунаевского: «Такая человечина, как вы, не может умереть»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
