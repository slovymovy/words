                        "sense_id": "7a97f01e-13a7-3b07-b623-969b98dfb15b",
                        "entry_id": "064755c1-8b05-3f3d-b0a2-3c2030389fa4",
                        "glosses": [
                            "Ort, an dem viel Industrie angesiedelt ist, der eine zentrale Rolle für die Industrie einer Region spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b82d0f2-9963-4ea9-be6a-b7fb39e27473",
                                "sense_id": "7a97f01e-13a7-3b07-b623-969b98dfb15b",
                                "text": "„Jeden Tag trafen viele Menschen aus dem ganzen Land ein und hofften, dass sich der Lebensunterhalt in einem Industriezentrum leichter verdienen ließ als auf dem Land und dass sie das, was sie verloren hatten, zurückgewinnen konnten.“"
                            }
                        ],
