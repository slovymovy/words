                                                "sense_id": "85f32346-2360-3ffa-9a11-a3bd86257e00",
                                                "text": "Black metal is a subgenre of heavy metal music that typically takes on anti-Christian, satanic and pagan themes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0684a1-d1a9-312c-8371-2fe8da2f5558",
                                        "entry_id": "8acd7214-70a7-309c-908d-d6d232eb80c8",
                                        "glosses": [
                                            "Evil, fiendish, devilish or diabolical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b8cda6-07a9-4d28-9ea6-bfc20a36dcb2",
                                                "sense_id": "5a0684a1-d1a9-312c-8371-2fe8da2f5558",
                                                "text": "Can Abrahamic religious leaders call other religions \"satanic\" without being in jail?"
                                            },
                                            {
                                                "example_id": "0e7e4188-7340-4d1f-ab48-c114805b4c70",
                                                "sense_id": "5a0684a1-d1a9-312c-8371-2fe8da2f5558",
                                                "text": "Instead, the 30-year-old singer's subjects include that modern satanic mill, the call centre."
                                            },
                                            {
                                                "example_id": "1ebfa51e-2bd7-4c58-a0e9-a2309c7d58a7",
                                                "sense_id": "5a0684a1-d1a9-312c-8371-2fe8da2f5558",
                                                "text": "The working class just looks different. \"Call centres are the new dark satanic mills. We have people who have to put their hand up to ask to go to the toilet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb4ec903-d27c-3227-a859-830c7ff079de",
                                        "entry_id": "8acd7214-70a7-309c-908d-d6d232eb80c8",
                                        "glosses": [
                                            "Of or pertaining to any form of Satanism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e1065f9-6d81-4403-b100-4a0f137eaff6",
                        "source_entry_id": "22d98ab3-99bc-3be6-9608-5a686839fc59",
                        "source_sense_id": "6161aa7a-0d02-30cd-918e-a982cff69037",
                        "target_lang_word": "devilish",
