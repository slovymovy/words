                    {
                        "sense_id": "a458dd35-3a89-3aac-80d6-ecbb2f98ebd0",
                        "entry_id": "25810cc5-2c99-3f4e-b7bc-fb1700589acd",
                        "glosses": [
                            "eine rhetorische Figur, bei der der Redner ankündigt, zu einem bestimmten Thema nichts zu sagen und dieses gerade damit besonders hervorhebt"
                        ],
                        "tags": [
                            "Rhetorik"
                        ],
                        "examples": [
                            {
                                "example_id": "b2d33569-1636-4ccc-9af6-33a39cb5d694",
                                "sense_id": "a458dd35-3a89-3aac-80d6-ecbb2f98ebd0",
                                "text": "Dieser Politiker verwendet häufig Paralipsen in seinen Reden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbd86654-d20c-4376-b77e-92f1d9327861",
                        "source_entry_id": "25810cc5-2c99-3f4e-b7bc-fb1700589acd",
                        "source_sense_id": "a458dd35-3a89-3aac-80d6-ecbb2f98ebd0",
                        "target_lang_word": "paralipsis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralipsis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                        "entry_id": "5aa8891f-ed9c-3035-8478-89080c29f0dd",
                                        "glosses": [
                                            "A figure of speech in which one pretends to ignore or omit something by actually mentioning it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7b8518-05f2-4c40-8cdf-aaafaccfaace",
                                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                                "text": "These negatives are a paraleipsis: what cannot be done to the soul can be done to the body."
                                            },
                                            {
                                                "example_id": "0fbc75ba-5446-4f58-96bb-796c0af640f8",
                                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                                "text": "Oxenberg tells us twice that she does not talk about the sister who died. She fools no one with this paralipsis […]."
                                            },
                                            {
                                                "example_id": "038c81e1-7538-4388-9b6c-1141f800fe43",
                                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                                "text": "What's left to consider? I am loath to bring up Trump's paralipsis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0da018ae-5df6-4615-9363-67becb86f347",
                        "source_entry_id": "25810cc5-2c99-3f4e-b7bc-fb1700589acd",
                        "source_sense_id": "a458dd35-3a89-3aac-80d6-ecbb2f98ebd0",
