    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45592cc8-f7de-3fee-814a-90f930aeaf71",
                "word": "cascaded",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "827baeac-f9cd-3d0d-9b20-1bf74debd607",
                        "entry_id": "45592cc8-f7de-3fee-814a-90f930aeaf71",
                        "glosses": [
                            "Arranged so that the result of one step or process provides the input to the next."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5c36c71-a3c1-4d09-aed1-ab605eeeda64",
                                "sense_id": "827baeac-f9cd-3d0d-9b20-1bf74debd607",
                                "text": "When operating synchronous counters in a cascaded configuration, it is necessary to use count enable and TC to achieve higher-modulus operation."
                            },
                            {
                                "example_id": "528fa6cb-4b73-4479-9442-d49c096e0c4f",
                                "sense_id": "827baeac-f9cd-3d0d-9b20-1bf74debd607",
                                "text": "One widely investigated concept is cascaded cooling cycles, which integrates two cooling technologies: medium to high-level cooling and low-level refrigeration."
                            },
                            {
                                "example_id": "61ab53fa-294b-4ef5-a982-d1df22126418",
                                "sense_id": "827baeac-f9cd-3d0d-9b20-1bf74debd607",
                                "text": "Therefore, it is likely that the CLLC resonant DCT will experience instability when used in a cascaded arrangement."
                            }
                        ]
                    },
                    {
                        "sense_id": "34860aca-7948-334c-82ff-9646c7ea7601",
                        "entry_id": "45592cc8-f7de-3fee-814a-90f930aeaf71",
                        "glosses": [
                            "Flowing on from the previous step or process; Using as input the output of the previous step."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66617c55-f594-46ed-8251-5871207d4e15",
                                "sense_id": "34860aca-7948-334c-82ff-9646c7ea7601",
                                "text": "After an entry has been invoked in a cascaded menu, both it and its parent are unposted."
                            },
                            {
                                "example_id": "ce45d354-2e44-4c3e-b9fb-a4cea2c6f424",
                                "sense_id": "34860aca-7948-334c-82ff-9646c7ea7601",
                                "text": "According to the definition of the cascaded star presented above, the dimensions of the cascaded star can be either single star or another cascaded star schema."
                            },
                            {
                                "example_id": "b348de13-8737-4a5c-87f5-603da469fc82",
                                "sense_id": "34860aca-7948-334c-82ff-9646c7ea7601",
                                "text": "The “cascaded heat” is shown by arrows and values indicated outside the boxes and beside the arrows. Since they are outside the boxes (boxes representing process streams), the cascaded enthalpies are representative of the enthalpy change of the external surroundings, -ΔH."
                            }
                        ]
                    }
                ],
