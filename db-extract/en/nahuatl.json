                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "271eb446-1bff-4e2e-8149-f6328bd38e1d",
                                                "sense_id": "a09c9fb6-378b-31ce-87df-12d5e80412ab",
                                                "text": "Spreek jij vloeiend Nahuatl?"
                                            }
                                        ]
