{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbd826c2-6ec4-3256-994c-21cc11773aa6",
                    "sense_definition": "A commercial establishment, resort, or health club offering health and beauty treatments such as steam baths, massages, and facials.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wellness_facilities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the entire afternoon at the <w>spa</w> enjoying a relaxing massage.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день в <w>спа</w>, наслаждаясь расслабляющим массажем.",
                                "zh": "她整个下午都待在<w>水疗中心</w>，享受着放松的按摩。"
                            }
                        },
                        {
                            "text": "We booked a weekend at a luxury <w>spa</w> to recover from the stress of work.",
                            "target_lang_translations": {
                                "ru": "Мы забронировали выходные в роскошном <w>спа-отеле</w>, чтобы восстановиться после рабочего стресса.",
                                "zh": "我们预订了一个周末的豪华<w>SPA会所</w>，以缓解工作压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "health club",
                        "resort"
                    ],
                    "common_phrases": [
                        "day spa",
                        "spa treatment",
                        "luxury spa",
                        "spa hotel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коммерческое учреждение, курорт или оздоровительный клуб, предлагающий процедуры для здоровья и красоты, такие как паровые бани, массаж и уход за лицом.",
                        "zh": "提供蒸汽浴、按摩和面部护理等健康与美容服务的商业机构、度假村或健身俱乐部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спа",
                                "target_lang_sense_clarification": "оздоровительный комплекс"
                            },
                            {
                                "target_lang_word": "спа-салон",
                                "target_lang_sense_clarification": "заведение с процедурами"
                            },
                            {
                                "target_lang_word": "курорт",
                                "target_lang_sense_clarification": "место отдыха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水疗中心",
                                "target_lang_sense_clarification": "提供专业健康护理的场所"
                            },
                            {
                                "target_lang_word": "SPA会所",
                                "target_lang_sense_clarification": "休闲美容场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df7dafd0-25b5-3cc0-9c5b-d7dccc275a8c",
                    "sense_definition": "A large tub or small pool equipped with underwater jets of water that massage the body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wellness_facilities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day of skiing, they relaxed in the warm bubbles of the <w>spa</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого дня катания на лыжах они расслабились в теплых пузырьках <w>джакузи</w>.",
                                "zh": "滑了一整天雪后，他们在<w>按摩浴缸</w>温暖的气泡中放松身心。"
                            }
                        },
                        {
                            "text": "Their backyard features a swimming pool and a heated <w>spa</w>.",
                            "target_lang_translations": {
                                "ru": "На их заднем дворе есть плавательный бассейн и <w>гидромассажная ванна</w> с подогревом.",
                                "zh": "他们的后院有一个游泳池和一个加热的<w>水疗池</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "outdoor spa",
                        "spa bath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая ванна или небольшой бассейн, оборудованный подводными струями воды для массажа тела.",
                        "zh": "一种配有水下喷嘴，可对身体进行按摩的大型浴缸或小型水池。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джакузи",
                                "target_lang_sense_clarification": "гидромассажная ванна"
                            },
                            {
                                "target_lang_word": "гидромассажная ванна",
                                "target_lang_sense_clarification": "техническое название"
                            },
                            {
                                "target_lang_word": "спа-бассейн",
                                "target_lang_sense_clarification": "бассейн с подогревом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按摩浴缸",
                                "target_lang_sense_clarification": "带有喷水功能的浴缸"
                            },
                            {
                                "target_lang_word": "水疗池",
                                "target_lang_sense_clarification": "带有加热和按摩功能的小型泳池"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f00c418-dafd-30d8-a4ea-d9027e3a605f",
                    "sense_definition": "A stupid, clumsy, or incompetent person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a complete <w>spa</w> when he realized he had forgotten the tickets.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя полным <w>идиотом</w>, когда понял, что забыл билеты.",
                                "zh": "当他意识到自己忘了带票时，觉得自己简直是个<w>笨蛋</w>。"
                            }
                        },
                        {
                            "text": "Don't be such a <w>spa</w>; nobody is going to believe that story.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>тупицей</w>; никто не поверит в эту историю.",
                                "zh": "别当<w>蠢货</w>了，没人会相信那个故事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Irish English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "often offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, неуклюжий или некомпетентный человек (ирландский сленг).",
                        "zh": "指代愚蠢、笨拙或无能的人（爱尔兰俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупица",
                                "target_lang_sense_clarification": "ругательство"
                            },
                            {
                                "target_lang_word": "идиот",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "тормоз",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "指代愚蠢的人"
                            },
                            {
                                "target_lang_word": "蠢货",
                                "target_lang_sense_clarification": "带有冒犯性的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4e93290-1eca-39a0-916b-89c7db7c6c97",
                    "sense_definition": "A convenience store or small shop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going down to the <w>spa</w> to pick up a newspaper and some milk.",
                            "target_lang_translations": {
                                "ru": "Я иду в <w>магазинчик</w>, чтобы купить газету и немного молока.",
                                "zh": "我要去<w>便利店</w>买份报纸和一些牛奶。"
                            }
                        },
                        {
                            "text": "The corner <w>spa</w> is the only place open at this hour.",
                            "target_lang_translations": {
                                "ru": "Этот угловой <w>минимаркет</w> — единственное место, открытое в этот час.",
                                "zh": "街角的<w>小卖部</w>是这个时间唯一开门的店。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "New England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Магазин шаговой доступности или небольшая лавка (регионализм Новой Англии).",
                        "zh": "便利店或小型商店（美国新英格兰地区方言）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магазинчик",
                                "target_lang_sense_clarification": "небольшая лавка"
                            },
                            {
                                "target_lang_word": "минимаркет",
                                "target_lang_sense_clarification": "магазин у дома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便利店",
                                "target_lang_sense_clarification": "社区内的小型零售店"
                            },
                            {
                                "target_lang_word": "小卖部",
                                "target_lang_sense_clarification": "小型杂货店"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "45457e89-d11b-30db-8321-daf42f8896c7",
                    "sense_definition": "A city in Belgium famous for its mineral springs, which gave its name to health resorts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wellness_facilities",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The modern word for a health resort comes from the town of <w>Spa</w>.",
                            "target_lang_translations": {
                                "ru": "Современное слово, обозначающее оздоровительный курорт, происходит от названия города <w>Спа</w>.",
                                "zh": "现代意义上的健康度假村一词源自<w>斯帕</w>镇。"
                            }
                        },
                        {
                            "text": "Tourists visit <w>Spa</w> to experience the historic thermal baths.",
                            "target_lang_translations": {
                                "ru": "Туристы посещают <w>Спа</w>, чтобы побывать в исторических термальных купальнях.",
                                "zh": "游客们来到<w>斯帕</w>体验历史悠久的温泉浴场。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в Бельгии, известный своими минеральными источниками, давший название оздоровительным курортам.",
                        "zh": "比利时的一座城市，以矿泉闻名，也是“水疗”一词的来源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спа",
                                "target_lang_sense_clarification": "город"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯帕",
                                "target_lang_sense_clarification": "比利时城市名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}