                        "translation_id": "a9b3a571-ff9d-4784-80f7-1552ffa2ccf8",
                        "source_entry_id": "ab1697f5-fc8b-3658-b6e6-0c81918fb0d4",
                        "source_sense_id": "c370a0c7-80b7-39a0-90b7-e83e26a4bcca",
