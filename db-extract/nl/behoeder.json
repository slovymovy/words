                ],
                "senses": [
                    {
                        "sense_id": "49b619ba-ab18-3790-939c-7c291b117a5b",
                        "entry_id": "3539d1bf-7428-34e6-bed3-d3f8a244c458",
                        "glosses": [
                            "een beschermer van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3d84f8-0557-4844-ac90-79037e3ac118",
                                "sense_id": "49b619ba-ab18-3790-939c-7c291b117a5b",
                                "text": "Volgens Vleugels komt het vaker voor dat afgeschermde informatie door middel van een trucje alsnog zichtbaar wordt voor journalisten. ,,Het wordt tijd dat iemand een keer opstaat en zegt: dit kan zo niet langer. De overheid wordt gezien als de behoeder, de waakhond van onze privacy, maar het tegendeel blijkt waar. Keer op keer.”"
                            },
                            {
                                "example_id": "3154055f-c7b0-43f5-8f24-fbb92bcd1ae6",
                                "sense_id": "49b619ba-ab18-3790-939c-7c291b117a5b",
                                "text": "‘Politiek rechts betoogt dat moslims een bedreiging vormen voor onze culturele erfenis. Ze misbruiken de christelijke erfenis als cultuurpolitiek instrument in een strijd tegen de multiculturele samenleving. Plots staat het christendom lijnrecht tegenover het islamitische gedachtegoed. Plots worden die politici de behoeders van het katholiek onderwijs en onze katholieke voorzieningen’, zei Van Gorp woensdagavond tijdens zijn toespraak ter ere van Rerum Novarum, het feest van de christelijke werknemersbeweging, in Lier."
                            },
                            {
                                "example_id": "3fc81450-6cba-430c-a2b9-a06b7da4b0a1",
                                "sense_id": "49b619ba-ab18-3790-939c-7c291b117a5b",
                                "text": "Hun echtgenoten, de boeren, weigeren ondanks de hun zware bestaan het land dat ze van generatie op generatie hebben geërfd, te verkopen. Daarmee zijn ze de behoeders van het fraaie landschap met zijn authentieke dorpen en pubs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0c4a783-6332-4818-850b-26c069937778",
                        "source_entry_id": "3539d1bf-7428-34e6-bed3-d3f8a244c458",
                        "source_sense_id": "49b619ba-ab18-3790-939c-7c291b117a5b",
                        "target_lang_word": "protector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24544674-a4b0-385d-843e-9988500e6c28",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "Someone who protects or guards, by assignment or on their own initiative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e3d028-c801-4164-aeb3-31022b86c016",
                                                "sense_id": "24544674-a4b0-385d-843e-9988500e6c28",
                                                "text": "I stand before you in the spirit of pure public service — not as a protector of the status quo, but as an agent of change."
                                            },
                                            {
                                                "example_id": "f11c631e-3f48-4e7d-9e72-5dac85fa994e",
                                                "sense_id": "24544674-a4b0-385d-843e-9988500e6c28",
                                                "text": "They [the Lightners] were like Gods to us. Our protectors. Our creators. Those who gave us purpose... Then, one day we were all locked away in this prison... And the Lightners never returned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a808f6a-8578-349d-a71b-7df97945e0e4",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "Someone who protects or guards, by assignment or on their own initiative.",
                                            "A headmate who primarily fronts, or otherwise protects the system, in situations where the system is at risk of psychological harm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd466f02-1066-3492-a9d7-862962fe1e44",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "A device or mechanism which is designed to protect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad1e75a4-2c97-3727-bc6c-3e5b755176f1",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "One who prevents interference."
