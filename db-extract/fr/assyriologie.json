        "fr-extract.jsonl": [
            {
                "entry_id": "47a14a5f-f96d-3e7c-a053-a5725cdb9a00",
                "word": "assyriologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d7f58165-ad66-3f98-a67f-f75098459056",
                        "entry_id": "47a14a5f-f96d-3e7c-a053-a5725cdb9a00",
                        "glosses": [
                            "Connaissance de la langue et des antiquités de l’Assyrie et de la Babylonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c23eea47-c357-408c-908d-97e55acbe8d4",
                                "sense_id": "d7f58165-ad66-3f98-a67f-f75098459056",
                                "text": "Il est un domaine, enfin, pour lequel l’assyriologie revêt une importance capitale, c’est celui des études bibliques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a7ece51-3507-46bc-89af-5fcedaada2a4",
                        "source_entry_id": "47a14a5f-f96d-3e7c-a053-a5725cdb9a00",
                        "source_sense_id": "d7f58165-ad66-3f98-a67f-f75098459056",
                        "target_lang_word": "Assyriologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Assyriologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43e2e794-ed3d-3fa9-9752-e110d2eaec89",
                                        "entry_id": "de761eea-062c-341f-ba3d-27c5a5365b7f",
                                        "glosses": [
                                            "Wissenschaft und Lehre von den überwiegend in Keilschriftdokumenten überlieferten Sprachen und der Kultur des alten, vorhellenistischen Vorderasien. Im engeren Sinne Wissenschaft des Akkadischen (und Sumerischen). In der Regel schließt sie die Archäologie und Kunstgeschichte nicht mit ein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e9a32f-578a-40b2-b2c9-bdf9e114913c",
                                                "sense_id": "43e2e794-ed3d-3fa9-9752-e110d2eaec89",
                                                "text": "(1979:) „Den beträchtlichen Fortschritten der Assyriologie in den vergangenen 15 Jahren musste jedoch natürlich Rechnung getragen werden. Die Transiterationen mussten auf das […] neue Umschriftsystem umgestellt werden.“"
                                            },
                                            {
                                                "example_id": "db9ef996-44f8-4a0e-a49b-9acafb4fb090",
                                                "sense_id": "43e2e794-ed3d-3fa9-9752-e110d2eaec89",
                                                "text": "Die Forschungsergebnisse der Assyriologie sind auch für das Verständnis des Alten Testamentes wichtig."
                                            },
                                            {
                                                "example_id": "9a4f3457-6fe7-4d9e-9bf5-e1eecef899a7",
                                                "sense_id": "43e2e794-ed3d-3fa9-9752-e110d2eaec89",
                                                "text": "Die Assyriologie in Leipzig hat eine lange Geschichte."
                                            },
                                            {
                                                "example_id": "50e07710-6fa6-4194-8f1b-71c0b51820f9",
                                                "sense_id": "43e2e794-ed3d-3fa9-9752-e110d2eaec89",
                                                "text": "Welchen Abschluss kann hier ich in der Assyriologie machen?."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dd76788-fbca-4de6-a53a-d44bcc0f40ff",
                        "source_entry_id": "47a14a5f-f96d-3e7c-a053-a5725cdb9a00",
                        "source_sense_id": "d7f58165-ad66-3f98-a67f-f75098459056",
                        "target_lang_word": "Altorientalistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altorientalistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7917bb01-096f-30ad-a536-f9968d086cdc",
                                        "entry_id": "45a62903-d2cf-31e6-ab3b-fe57bfbb363e",
                                        "glosses": [
                                            "Wissenschaft, Lehre von den Sprachen, Kulturen und der Geschichte des alten Vorderen Orients mit Ausnahme Ägyptens, oft einfach: des Alten Orients. Mitunter Synonym für Altorientalische Philologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3270ef-2ab8-42c0-ba47-2cdcdaad87aa",
                                                "sense_id": "7917bb01-096f-30ad-a536-f9968d086cdc",
                                                "text": "„Die Keilschriftentzifferung im 19. Jh. gestattete das Verständnis der assyr. Geschichtsquellen, daher die Bezeichnung A[ssyriologie], die heute oft durch Altorientalistik ersetzt wird, da sich das Forschungsgebiet durch die Erschließung weiterer Keilschriftsprachen […] weitete.“"
                                            },
                                            {
                                                "example_id": "ed898249-2c4f-4c24-b2e3-4156d9e3cd26",
                                                "sense_id": "7917bb01-096f-30ad-a536-f9968d086cdc",
                                                "text": "„Die provozierende Frage nach den reichen Eltern stellt die Professorin für Altorientalistik an der Universität Hamburg allen, die im Hauptfach die Kulturen Vörderasiens in vorhellenistischer Zeit studieren möchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
