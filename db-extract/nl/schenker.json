                    {
                        "sense_id": "09e0c274-a6f8-39d4-b9dc-ae75c1a2812a",
                        "entry_id": "0f442d7a-fbc9-363b-a448-7dadc2434d81",
                        "glosses": [
                            "iemand die iets cadeau geeft aan een ander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b09b6538-18eb-479f-9e16-9a0def3b9451",
                                "sense_id": "09e0c274-a6f8-39d4-b9dc-ae75c1a2812a",
                                "text": "Schenkers zijn blij, omdat ze iets kunnen schenken, klanten zijn blij met hun aankoop en wij kunnen de opbrengst gebruiken voor onze projecten. Op het eind van de dag zijn er alleen maar winnaars."
                            },
                            {
                                "example_id": "1ce03525-558c-4c92-b058-4e2abaf54532",
                                "sense_id": "09e0c274-a6f8-39d4-b9dc-ae75c1a2812a",
                                "text": "Dankzij giften van plaatselijke bedrijven, scholen en andere organisaties is het afgelopen jaar veel tot stand gekomen op de kinderboerderij. Alle schenkers waren vrijdagmiddag uitgenodigd om de resultaten te bewonderen."
                            }
                        ]
