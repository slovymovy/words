                                "sense_id": "432e43eb-af43-3ffe-bc2f-2de6973a554f",
                                "text": "„Da erschienen nicht schwebend, sondern festen Fusses zwey Gestalten, eine Bucklichte männlichen und eine Einäugige weiblichen Geschlechts.“"
                            },
                            {
                                "example_id": "19621e49-0641-4eab-854e-ec451b224560",
                                "sense_id": "432e43eb-af43-3ffe-bc2f-2de6973a554f",
                                "text": "„Vorsichtig kletterte ich die Stufen hinauf, denn Wein zu trinken war für eine Einäugige und Halbtaube fataler als für andere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
