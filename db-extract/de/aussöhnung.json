                "senses": [
                    {
                        "sense_id": "1c9e2563-e571-3511-8c99-35dbc450dfad",
                        "entry_id": "3c31435f-e714-3213-9d15-7b82fef6bc4a",
                        "glosses": [
                            "Beendigung einer Zwietracht, eines Streits"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d469604a-3d30-4045-b1e1-eaca2293efa4",
                                "sense_id": "1c9e2563-e571-3511-8c99-35dbc450dfad",
                                "text": "Präsident Ma Ying Jeou, der auf eine Aussöhnung mit Peking setzt, weist die Bedenken der Opposition jedoch zurück."
                            },
                            {
                                "example_id": "48306d1c-bc0d-4b99-b522-fa397802fc50",
                                "sense_id": "1c9e2563-e571-3511-8c99-35dbc450dfad",
                                "text": "„Sie alle wollen Wege zur gegenseitigen Versöhnung und dauerhaften Aussöhnung zwischen Deutschen und Polen ebnen.“"
                            },
                            {
                                "example_id": "5621f676-940d-4d0e-b6ec-500b49837e1f",
                                "sense_id": "1c9e2563-e571-3511-8c99-35dbc450dfad",
                                "text": "„1963 zwingen sie Moise Tschombé zur Aussöhnung mit der Regierung.“"
                            },
                            {
                                "example_id": "8f0a149e-9192-4542-8ad1-44e65a27c169",
                                "sense_id": "1c9e2563-e571-3511-8c99-35dbc450dfad",
                                "text": "„Die Aussöhnung war im Vorjahr durch den Vormarsch ›des Türken‹ nach Wien erzwungen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
