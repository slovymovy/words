    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "760439b1-a9dd-36ee-9757-f62a7cae4722",
                    "sense_definition": "Een smet of vlek op iemands reputatie, of een schandelijke vertoning of situatie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat vervallen gebouw in het centrum is al jaren een <w>schandvlek</w> voor de hele stad.",
                            "target_lang_translations": {
                                "en": "That dilapidated building in the center has been an <w>eyesore</w> for the entire city for years."
                            }
                        },
                        {
                            "text": "Zijn frauduleuze handelingen vormden een onuitwisbare <w>schandvlek</w> op zijn anders zo glansrijke carrière.",
                            "target_lang_translations": {
                                "en": "His fraudulent actions formed an indelible <w>stain</w> on his otherwise illustrious career."
                            }
                        }
                    ],
                    "synonyms": [
                        "smet",
                        "schanddaad",
                        "blaam"
                    ],
                    "antonyms": [
                        "eer",
                        "trots"
                    ],
                    "common_phrases": [
                        "een schandvlek voor"
                    ],
                    "target_lang_definitions": {
                        "en": "A stain or blot on someone's reputation, or a shameful sight or situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eyesore",
                                "target_lang_sense_clarification": "referring to an ugly building or object"
                            },
                            {
                                "target_lang_word": "blot",
                                "target_lang_sense_clarification": "referring to a stain on reputation or character"
                            },
                            {
                                "target_lang_word": "stain",
                                "target_lang_sense_clarification": "referring to a mark of disgrace"
                            },
                            {
                                "target_lang_word": "disgrace",
                                "target_lang_sense_clarification": "referring to a shameful situation or person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bb9ae77-2cf0-3e2d-a2f1-fac6ef0e8ea8",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>schandvlekken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schandvlek</w> mijn eigen familie niet met zulke daden.",
                            "target_lang_translations": {
                                "en": "I do not <w>disgrace</w> my own family with such actions."
                            }
                        },
                        {
                            "text": "Als ik lieg, <w>schandvlek</w> ik mijn eigen geweten.",
                            "target_lang_translations": {
                                "en": "If I lie, I <w>stain</w> my own conscience."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present indicative of 'schandvlekken' (to stain, disgrace, or defile)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disgrace",
                                "target_lang_sense_clarification": "to bring shame upon"
                            },
                            {
                                "target_lang_word": "stain",
                                "target_lang_sense_clarification": "to damage the reputation of"
                            }
                        ]
                    }
                },
                {
