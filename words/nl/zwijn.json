                    "semantic_group_id": "voertuig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>zwijntje</w> opbergen in een bescheiden appartementje lijkt vaak onmogelijk, maar met wat handig en creatief integratiewerk wordt uw fiets zowaar een pronkstuk in de huiskamer.",
                            "target_lang_translations": {
                                "en": "Storing your <w>bike</w> in a modest little apartment often seems impossible, but with some clever and creative integration work, your bicycle actually becomes a showpiece in the living room."
                            }
                        },
                        {
                            "text": "Ik spring snel op mijn <w>zwijntje</w> om naar de supermarkt te rijden.",
                            "target_lang_translations": {
                                "en": "I'll quickly hop on my <w>bike</w> to ride to the supermarket."
                            }
