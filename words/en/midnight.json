                    "sense_definition": "A pair of sixes rolled in dice games.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rolled a <w>midnight</w> and lost his turn immediately.",
                            "target_lang_translations": {
