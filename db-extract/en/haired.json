    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c8d0ae73-c49e-311e-905b-6a02a0f7d868",
                "word": "haired",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ad9d47a8-1d76-4ac2-b340-b198014f0dd6",
                        "entry_id": "c8d0ae73-c49e-311e-905b-6a02a0f7d868",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more haired"
                    },
                    {
                        "form_id": "cccdd5e5-31f3-49b2-91c4-82e2b7745fa5",
                        "entry_id": "c8d0ae73-c49e-311e-905b-6a02a0f7d868",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most haired"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46b010be-ab09-3b38-b9f5-4a313e3df715",
                        "entry_id": "c8d0ae73-c49e-311e-905b-6a02a0f7d868",
                        "glosses": [
                            "Bearing one's own hair as grown and yet attached; neither bald nor hairless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ae3374-1b7d-468b-ad80-c8f52b9c629a",
                                "sense_id": "46b010be-ab09-3b38-b9f5-4a313e3df715",
                                "text": "It was pointed at the tip, and whilst its dorsum was haired the opposite surface was hairless, hollowed out into a concha and directed forwards and outwards."
                            },
                            {
                                "example_id": "f709ff8f-58b1-45ad-a44b-e046445b72bd",
                                "sense_id": "46b010be-ab09-3b38-b9f5-4a313e3df715",
                                "text": "He made only one exception: our big rangy Llewellin setter named Frank, a blue-ticked genius that knew integral calculus where quail were concerned, and was haired almost as thinly as a pointer."
                            },
                            {
                                "example_id": "dde5642e-4168-47f4-847a-003108e9acf8",
                                "sense_id": "46b010be-ab09-3b38-b9f5-4a313e3df715",
                                "text": "Their tails are both indistinctly bicolored, but N. picta has a thinner and more haired tail."
                            }
                        ]
                    },
                    {
                        "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                        "entry_id": "c8d0ae73-c49e-311e-905b-6a02a0f7d868",
                        "glosses": [
                            "Bearing some specific type of hair."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "8eea08fb-738c-4f78-8c40-3ef7271d5b68",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "He had never walked anywhere arm-in-arm with Colonel Wallis (who was a fine military figure, though sandy-haired) without observing that every woman's eye was upon him; every woman's eye was sure to be upon Colonel Wallis."
                            },
                            {
                                "example_id": "299d887d-4135-48ff-9429-ed27e8110502",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "Mr Brogley himself was a moist-eyed, pink-complexioned, crisp-haired man, of a bulky figure and an easy temper […]"
                            },
                            {
                                "example_id": "5e186459-a55c-4937-877a-5ca2ffe69fca",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "At half-past six the sun settled down upon the levels, with the aspect of a great forge in the heavens, and presently a monstrous pumpkin-like moon arose on the other hand. The pollard willows, tortured out of their natural shape by incessant choppings, became spiny-haired monsters as they stood up against it."
                            },
                            {
                                "example_id": "482f4d46-70c2-4b4f-9cad-96d315c19823",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "1924, Yevgeny Zamyatin, We, translated by Gregory Zilboorg, New York: Dutton, 1952, Record Twenty-Seven, p. 145,\nLong-haired, austere eyebrows turned to me."
                            },
                            {
                                "example_id": "c66a264b-f50e-4f6a-bcee-9780e2a4c3c7",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "He was a tiny wiry-haired fellow with a pale, sharp-featured face and restless movements."
                            },
                            {
                                "example_id": "49c8d1a1-e648-470c-93c1-e045d19167d4",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "A clean-shaven, close-haired saint was an anomaly."
                            },
                            {
                                "example_id": "534bcecf-4c26-47ce-8503-4ee47fdfecc9",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "Even the curly-haired boys from merchant families, very much to the disgust of their parents, fraternized with Coloured girls."
                            },
                            {
                                "example_id": "7b2345cf-0339-48d1-9b46-35c0b2e30537",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "Remember the Furies, / The snake-haired, dreadful sisters / Who climb from the hell of conscience / Whirling their torches."
                            },
                            {
                                "example_id": "a7a3a680-a2a6-40f7-89ba-7b9b39c40d7a",
                                "sense_id": "6abbbcc9-4a1c-3a95-a95f-5da3c0a29f8c",
                                "text": "She was a raven-haired beauty."
                            }
                        ]
                    }
