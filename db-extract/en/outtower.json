                        "glosses": [
                            "To rise higher than; to tower above."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc6b6fe-d0dd-4d60-a889-f5b78b9f3df2",
                                "sense_id": "953e1786-8964-36bc-bfd5-a9a81558af80",
                                "text": "Tou see a person, who, added to yourself, would make, you think, a glorious being, and you proceed to idealize accordingly; you stand on his head, and outtower the tallest; you club your brains with his, and are wiser than the wisest; you add the heat of your heart to his, and produce a very furnace of love."
                            }
                        ]
