        "de-extract.jsonl": [
            {
                "entry_id": "fe8bba26-addf-3e1f-a71e-949814e4de15",
                "word": "IPA",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a47f28c-8336-354a-bb72-79d5fcc96cf8",
                        "entry_id": "fe8bba26-addf-3e1f-a71e-949814e4de15",
                        "glosses": [
                            "Internationales Phonetisches Alphabet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6e624e-e036-42a7-9f06-0aebf9076241",
                                "sense_id": "4a47f28c-8336-354a-bb72-79d5fcc96cf8",
                                "text": "„Tatsächlich universell ist seiner Natur nach natürlich das Internationale Phonetische Alphabet (IPA), das ja speziell zu dem Zweck, universell zu sein, geschaffen wurde.“"
                            },
                            {
                                "example_id": "95ce3a9c-9410-44dd-a6b7-801f13e6a4f1",
                                "sense_id": "4a47f28c-8336-354a-bb72-79d5fcc96cf8",
                                "text": "„Die Idee, ein phonetisches Alphabet aufzustellen, trug zuerst Otto Jespersen (1860-1943) im Jahr 1886 vor, und die erste Version des Internationalen Phonetischen Alphabets (IPA) wurde im August 1888 veröffentlicht.“"
                            },
                            {
                                "example_id": "f5eb60bb-5c22-45f6-9475-5b8c54457e96",
                                "sense_id": "4a47f28c-8336-354a-bb72-79d5fcc96cf8",
                                "text": "„Dabei bilden die Merkmale, die einen Laut charakterisieren, der im IPA durch ein Symbol ausgedrückt ist, eine Dimension.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
