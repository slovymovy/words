                {
                    "sense_id": "f2ab271b-4f0b-3422-9d26-519c18915c35",
                    "sense_definition": "Sans se presser, de façon douce et tranquille.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train avance <w>gentiment</w> à travers les collines verdoyantes.",
                            "target_lang_translations": {
                                "en": "The train moves <w>gently</w> through the green hills.",
                                "ru": "Поезд <w>плавно</w> едет через зелёные холмы.",
                                "de": "Der Zug rollt <w>gemächlich</w> durch die grünen Hügel.",
                                "es": "El tren avanza <w>suavemente</w> a través de las colinas verdes.",
                                "zh": "火车<w>慢慢地</w>穿过青翠的山丘。"
                            }
                        },
                        {
                            "text": "Nous marchons <w>gentiment</w> vers le village en profitant du soleil.",
                            "target_lang_translations": {
                                "en": "We walk <w>unhurriedly</w> toward the village, enjoying the sunshine.",
                                "ru": "Мы <w>неторопливо</w> идём к деревне, наслаждаясь солнцем.",
                                "de": "Wir gehen <w>gemächlich</w> zum Dorf und genießen dabei die Sonne.",
                                "es": "Caminamos <w>pausadamente</w> hacia el pueblo, disfrutando del sol.",
                                "zh": "我们享受着阳光，<w>从容地</w>走向村庄。"
                            }
                        }
                    ],
                    "synonyms": [
                        "en douceur"
                    ],
                    "common_phrases": [
                        "avancer gentiment"
                    ],
                    "target_lang_definitions": {
                        "en": "Without hurrying, in a soft and calm way.",
                        "ru": "Не торопясь, мягко и спокойно.",
                        "de": "Ohne Eile und auf sanfte, ruhige Weise.",
                        "es": "Sin prisas, de forma suave y tranquila.",
                        "zh": "不急不躁，以轻柔平缓的方式进行。"
                    },
