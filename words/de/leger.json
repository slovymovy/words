                    "common_phrases": [
                        "legere Kleidung",
                        "leger gekleidet"
                    ],
                    "target_lang_definitions": {
                        "en": "in terms of clothing or appearance: comfortable, relaxed, and not formal"
                    },
                    "translations": {
