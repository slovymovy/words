                        "target_lang_word": "Grace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99fc78e4-a211-3c4b-8d30-91c0a7fd46bb",
                                        "entry_id": "67efdc05-ce99-3d12-825d-35ee6bf3f8fc",
                                        "glosses": [
                                            "A female given name from English."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619d1dc7-d870-472a-98d0-a154d3b76a30",
                                                "sense_id": "99fc78e4-a211-3c4b-8d30-91c0a7fd46bb",
                                                "text": "To The Handsome Mistress Grace Potter: As is your name, so is your comely face / Touch'd everywhere with such a diffused grace /"
                                            },
                                            {
                                                "example_id": "08e3d3ef-c32a-4a52-922a-ce6368a53c57",
                                                "sense_id": "99fc78e4-a211-3c4b-8d30-91c0a7fd46bb",
                                                "text": "Grace does not belie her name; for she is indeed a sweet girl, modest and unassuming, and appearing to be unconscious of having done anything great or noble. - OBSERVER, Dec.16, 1838."
                                            },
                                            {
                                                "example_id": "d2aae9b7-d314-4ae6-a7d2-c7d992c1d3b5",
                                                "sense_id": "99fc78e4-a211-3c4b-8d30-91c0a7fd46bb",
                                                "text": "They named me Grace and waited for a light and agile dancer. / But some trick of genes mixed me up / And instead I turned out big and black and burly."
                                            },
                                            {
                                                "example_id": "694495e8-53e4-44fa-b697-6e4b847268f2",
                                                "sense_id": "99fc78e4-a211-3c4b-8d30-91c0a7fd46bb",
                                                "text": "Had I given birth to a daughter of my own, I'd like to have called her Grace, a classic and poetic name, one that illuminates a person of dignity and poise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95488e43-486a-3ea3-9e47-0f893c56039e",
                                        "entry_id": "67efdc05-ce99-3d12-825d-35ee6bf3f8fc",
                                        "glosses": [
                                            "A surname."
                                        ],
