                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "058b54cd-cc85-390a-89ce-d4f4cea77d6a",
                                        "entry_id": "59a1b2a2-469c-3ad1-a0e5-5e997e2c41bc",
                                        "glosses": [
                                            "To become hard by rapid cooling."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43c2d05f-b999-3b0d-9153-9effd6769e7f",
                                        "entry_id": "59a1b2a2-469c-3ad1-a0e5-5e997e2c41bc",
                                        "glosses": [
                                            "To relax; to lie back; to take things easy."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18820cbe-11a1-4331-b56e-ed7119ec471e",
                                                "sense_id": "43c2d05f-b999-3b0d-9153-9effd6769e7f",
                                                "text": "Chill, man, we've got a whole week to do it; no sense in getting worked up."
                                            },
                                            {
                                                "example_id": "ca6444d4-626b-4c57-a64b-d36e21ac7b10",
                                                "sense_id": "43c2d05f-b999-3b0d-9153-9effd6769e7f",
                                                "text": "The new gym teacher really has to chill or he's gonna blow a gasket."
                                            },
                                            {
                                                "example_id": "0f2bab1e-6a6a-4d7a-b452-e611c4437a1f",
                                                "sense_id": "43c2d05f-b999-3b0d-9153-9effd6769e7f",
                                                "text": "A time to live and a time to die / A time to break and a time to chill / To act civilized or act real ill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24335aae-4c7d-3229-98d0-45d9ccc6776a",
                                        "entry_id": "59a1b2a2-469c-3ad1-a0e5-5e997e2c41bc",
                                        "glosses": [
                                            "To \\\"hang\\\", hang out; to spend time with another person or group."
                                        ],
                                        "tags": [
                                            "intransitive",
