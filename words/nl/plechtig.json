    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "590f7348-9aa4-3b71-8a14-43265a0702c9",
                    "sense_definition": "gekenmerkt door ernst en officieel ceremonieel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ceremonieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning hield een <w>plechtige</w> toespraak tijdens de nationale herdenking.",
                            "target_lang_translations": {
                                "en": "The king gave a <w>solemn</w> speech during the national commemoration."
                            }
                        },
                        {
                            "text": "Zij legden een <w>plechtige</w> belofte af om elkaar altijd te steunen.",
                            "target_lang_translations": {
                                "en": "They made a <w>solemn</w> promise to always support each other."
                            }
                        }
                    ],
                    "synonyms": [
                        "solemneel"
                    ],
                    "antonyms": [
                        "informeel",
                        "luchtig"
                    ],
                    "common_phrases": [
                        "plechtige belofte",
                        "plechtige herdenking",
                        "plechtige ceremonie"
                    ],
                    "target_lang_definitions": {
                        "en": "characterized by seriousness and official ceremony"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solemn",
                                "target_lang_sense_clarification": "serious and formal"
                            },
                            {
                                "target_lang_word": "ceremonial",
                                "target_lang_sense_clarification": "relating to a formal event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bcb8fca-0891-30e9-a9c2-d3b125a464fa",
                    "sense_definition": "overdreven formeel of stijf in de omgang",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sfeer aan tafel was nogal <w>plechtig</w> en ongemakkelijk.",
                            "target_lang_translations": {
                                "en": "The atmosphere at the table was rather <w>stiff</w> and uncomfortable."
                            }
                        },
                        {
                            "text": "Hij gedroeg zich erg <w>plechtig</w> voor een informeel feestje.",
                            "target_lang_translations": {
                                "en": "He behaved very <w>formally</w> for an informal party."
                            }
                        }
                    ],
                    "antonyms": [
                        "losjes",
                        "ontspannen"
                    ],
                    "common_phrases": [
                        "plechtige sfeer",
                        "erg plechtig"
                    ],
                    "target_lang_definitions": {
                        "en": "excessively formal or stiff in social interaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "not relaxed or friendly"
                            },
                            {
                                "target_lang_word": "formal",
                                "target_lang_sense_clarification": "strictly following rules of etiquette"
                            },
                            {
                                "target_lang_word": "stately",
                                "target_lang_sense_clarification": "impressive but very formal"
                            }
                        ]
                    }
                }
            ]
        }
