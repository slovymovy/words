                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muffler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33d8d94e-0cfa-3c97-a669-ab42f9c7ea51",
                                        "entry_id": "98aded18-5565-3b25-8743-07507a2c63b7",
                                        "glosses": [
                                            "Something or someone that muffles.",
                                            "A part of the exhaust pipe of a car that dampens the noise the engine produces."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1fb766-9ad1-46bb-8369-006fbfaaa409",
                                                "sense_id": "33d8d94e-0cfa-3c97-a669-ab42f9c7ea51",
                                                "text": "Holonym: exhaust system"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92c56c2b-3cc6-3a87-8e96-702c30b9ba8a",
                                        "entry_id": "98aded18-5565-3b25-8743-07507a2c63b7",
                                        "glosses": [
                                            "Something or someone that muffles.",
                                            "An accessory for a firearm that lessens the noise at the muzzle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33443e3f-f01f-317a-b2d1-9175cd89fb3a",
                                        "entry_id": "98aded18-5565-3b25-8743-07507a2c63b7",
                                        "glosses": [
                                            "Something or someone that muffles.",
                                            "A type of scarf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9eaa3aa-0cec-4e2d-beb3-f598012884b3",
                                                "sense_id": "33443e3f-f01f-317a-b2d1-9175cd89fb3a",
                                                "text": "The newcomer took off his cap and his big woollen muffler. His nose was pointed and red."
                                            },
                                            {
                                                "example_id": "70e5d828-90f7-4450-97fe-c5b4d7ee2c6a",
                                                "sense_id": "33443e3f-f01f-317a-b2d1-9175cd89fb3a",
                                                "text": "He was wearing a maroon cashmere muffler which had hiked up on his neck, giving him next to no protection against the cold. Abruptly, and rather absently, he took his right hand out of his coat pocket and started to adjust the muffler, but before it was adjusted, he changed his mind […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0b3b90e-2c25-39bd-b0ec-1d3fdea2f12c",
                                        "entry_id": "98aded18-5565-3b25-8743-07507a2c63b7",
                                        "glosses": [
                                            "Something or someone that muffles.",
                                            "A gas mask."
                                        ],
                                        "tags": [
                                            "World-War-I",
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "656bb718-03de-47f4-bba9-49cd8e2fbac1",
                        "source_entry_id": "741f831f-07ed-3bba-b00e-d2fd32c8c749",
                        "source_sense_id": "f0c57c84-ef5e-3637-81d6-5daf9f091093",
                        "target_lang_word": "silenciador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a506286b-a02b-434e-b177-f24af6a3afb1",
                        "source_entry_id": "741f831f-07ed-3bba-b00e-d2fd32c8c749",
                        "source_sense_id": "f0c57c84-ef5e-3637-81d6-5daf9f091093",
                        "target_lang_word": "глушитель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глушитель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3280c938-46fc-346a-b342-7b82e3636981",
                                        "entry_id": "f3e99a87-2a83-3936-8b5b-5dc500f43b9a",
                                        "glosses": [
                                            "то, что глушит, заглушает, препятствует распространению звуковых волн"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b0d849-0498-4696-9a48-3939d0f641b6",
                                                "sense_id": "3280c938-46fc-346a-b342-7b82e3636981",
                                                "text": "Сопротивление — это глушитель колебаний: оно не только не поддерживает их, но, наоборот, пожирает энергию и, наконец, прекращает колебания вовсе."
                                            },
                                            {
                                                "example_id": "06f6fe16-05ee-44d4-8f6c-76ab9fd45701",
                                                "sense_id": "3280c938-46fc-346a-b342-7b82e3636981",
                                                "text": "Не грохот воспевать, а ставить глушители — нам, поэтам, надо разговаривать в вагоне."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4132efbb-d90b-36e0-b786-0d6ed3635e88",
                                        "entry_id": "f3e99a87-2a83-3936-8b5b-5dc500f43b9a",
                                        "glosses": [
                                            "техн. устройство, уменьшающее передачу звука через канал, трубу или отверстие, не препятствуя переносу среды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d78a2db-66b5-469a-b8c3-f5cbf304d505",
                                                "sense_id": "4132efbb-d90b-36e0-b786-0d6ed3635e88",
                                                "text": "Козлевич открыл глушитель, и машина выпустила шлейф синего дыма, от которого зачихали бежавшие за автомобилем собаки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb11aee-a08d-3624-a54a-cd3bf1fe4c8f",
                                        "entry_id": "f3e99a87-2a83-3936-8b5b-5dc500f43b9a",
                                        "glosses": [
                                            "воен. специальная насадка на ствольное оружие, позволяющая ослабить звук выстрела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdf8c6d-2fe2-4c4c-ae47-b6bc1d91f146",
                                                "sense_id": "6bb11aee-a08d-3624-a54a-cd3bf1fe4c8f",
                                                "text": "У пулемёта не было глушителя, поэтому стрельба его наводила особенно страшную панику."
                                            },
                                            {
                                                "example_id": "f7fc5b6c-9a5f-4b39-a672-ab5d84a2f57b",
                                                "sense_id": "6bb11aee-a08d-3624-a54a-cd3bf1fe4c8f",
                                                "text": "Вайс успел сбить с ног Генриха, упал на него как раз в то мгновение, когда раздались глухие, частые звуки, будто пробки вылетали из пивных бутылок, — так стреляет пистолет с глушителем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62194234-e7eb-4798-bcb3-a3a02739765a",
                        "source_entry_id": "741f831f-07ed-3bba-b00e-d2fd32c8c749",
                        "source_sense_id": "8e5cd5b0-f3b8-3697-849f-96a42e05ab02",
                        "target_lang_word": "silencer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silencer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeeb8178-017d-359e-badd-c153d902cc67",
                                        "entry_id": "870ec60e-661f-3336-b858-b15a58301066",
                                        "glosses": [
                                            "Something that silences or (notionally) nearly silences.",
                                            "An attachment to a gun that reduces the sound it emits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7ab56a-196d-49f2-ace0-c1fae568e860",
                                                "sense_id": "aeeb8178-017d-359e-badd-c153d902cc67",
                                                "text": "The Justice Department has defended the law for decades, arguing that it doesn’t ban silencers but simply governs how a buyer can acquire one. Still, late last week, prosecutors requested a 30-day pause in the criminal case against a firearms dealer found with an unregistered silencer because “the Department of Justice is re-evaluating its litigation positions regarding silencers.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c1963b-7254-3d28-8f84-be0a13ed4b82",
                                        "entry_id": "870ec60e-661f-3336-b858-b15a58301066",
                                        "glosses": [
                                            "Something that silences or (notionally) nearly silences.",
                                            "The muffler of an internal combustion engine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a09d1c-ecf1-43c0-8be4-5e6fb0589d94",
                                                "sense_id": "90c1963b-7254-3d28-8f84-be0a13ed4b82",
                                                "text": "Before the fitting of silencers to these locomotives was completed by the end of 1961, they were very noisy in operation, but the effect of the silencer has been remarkable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10a7b47c-b52d-3656-ae87-fca75e95296f",
                                        "entry_id": "870ec60e-661f-3336-b858-b15a58301066",
                                        "glosses": [
                                            "Something that silences or (notionally) nearly silences.",
                                            "Any of various devices to silence the humming noise of telegraph wires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48916fa1-1198-35be-bd8d-614ddbcb437c",
                                        "entry_id": "870ec60e-661f-3336-b858-b15a58301066",
