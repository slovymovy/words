                "senses": [
                    {
                        "sense_id": "814f2b74-94d4-3e1f-b4f8-1b15d67b9f15",
                        "entry_id": "5eb7d01e-7914-3758-81f8-27014cb359cd",
                        "glosses": [
                            "een militaire eenheid die probeert de vrede in een bepaald gebied te handhaven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b7734f-ed25-4832-b580-87e5aff125b8",
                                "sense_id": "814f2b74-94d4-3e1f-b4f8-1b15d67b9f15",
                                "text": "Drie Bengalese militairen van de vredesmacht van de Verenigde Naties in Mali zijn zondag om het leven gekomen door een aanslag in het noorden van het Afrikaanse land. Vijf andere blauwhelmen raakten ernstig gewond toen een explosief ontplofte tijdens de begeleiding van een konvooi tussen de steden Anefis en Goa."
                            },
                            {
                                "example_id": "d4e0009b-5aaf-4058-b9d1-867499ce7c2a",
                                "sense_id": "814f2b74-94d4-3e1f-b4f8-1b15d67b9f15",
                                "text": "Oekraïne wil een heel andere VN-missie en zal daar voorstellen voor indienen bij de Algemene Vergadering van de Verenigde Naties. Kiev wil een internationale vredesmacht in het gebied van de separatisten."
                            }
                        ]
                    }
