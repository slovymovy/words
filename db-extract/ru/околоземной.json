                "senses": [
                    {
                        "sense_id": "21e7c3fb-8bfc-3826-927b-b18a6534ec7c",
                        "entry_id": "eacfe80b-b3cb-334f-9310-001d85268b4b",
                        "glosses": [
                            "то же, что околоземный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1956cb2d-70dd-47a9-b208-74b7aa11dc57",
                                "sense_id": "21e7c3fb-8bfc-3826-927b-b18a6534ec7c",
                                "text": "Созданы долговременные орбитальные научные станции, ставшие как бы опытным полигоном глубокого проникновения в околоземной космос."
                            },
                            {
                                "example_id": "b5d211ab-f278-4215-aa0e-76b7b61547f3",
                                "sense_id": "21e7c3fb-8bfc-3826-927b-b18a6534ec7c",
                                "text": "Именно станции позволят нам освоить не только ближний, околоземной, но и дальний, межзвездный, космос."
                            }
                        ]
                    }
