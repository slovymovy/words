{
    "word_family": [
        "zip",
        "unzip",
        "unzipper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "331c66b7-147f-3288-9009-56be84e8d0b4",
                    "sense_definition": "A device used for fastening clothes or bags, consisting of two rows of metal or plastic teeth that are pulled together by a sliding piece.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got his T-shirt stuck in the <w>zipper</w> of his jacket.",
                            "target_lang_translations": {
                                "ru": "Его футболка застряла в <w>молнии</w> куртки.",
                                "zh": "他的T恤被夹在了夹克的<w>拉链</w>里。"
                            }
                        },
                        {
                            "text": "The <w>zipper</w> on my backpack broke, so I cannot close it properly.",
                            "target_lang_translations": {
                                "ru": "<w>Молния</w> на моем рюкзаке сломалась, поэтому я не могу его нормально закрыть.",
                                "zh": "我背包上的<w>拉链</w>坏了，所以我没法把它关好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zip",
                        "zip fastener",
                        "slide fastener"
                    ],
                    "common_phrases": [
                        "broken zipper",
                        "jacket zipper",
                        "metal zipper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство для застегивания одежды или сумок, состоящее из двух рядов металлических или пластиковых зубцов, которые соединяются скользящим элементом.",
                        "zh": "一种用于扣合衣服或包袋的装置，由两排金属或塑料齿组成，通过一个滑动件拉合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молния",
                                "target_lang_sense_clarification": "застежка"
                            },
                            {
                                "target_lang_word": "застежка-молния",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉链",
                                "target_lang_sense_clarification": "最常用的名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f5b47a-f0d2-3a85-99eb-a3941eed67f5",
                    "sense_definition": "A plastic closure that seals by pressing two sides together, commonly found on storage bags.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the plastic <w>zipper</w> is completely sealed to keep the food fresh.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что пластиковая <w>застежка</w> полностью закрыта, чтобы сохранить продукты свежими.",
                                "zh": "确保塑料<w>密封条</w>完全闭合，以保持食物新鲜。"
                            }
                        },
                        {
                            "text": "The sandwich bag has a double <w>zipper</w> to prevent any leaks.",
                            "target_lang_translations": {
                                "ru": "Пакет для бутербродов имеет двойную <w>застежку</w>, чтобы предотвратить протекание.",
                                "zh": "这个三明治袋有双重<w>密封条</w>，以防止泄漏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plastic zipper",
                        "bag zipper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пластиковая застежка, которая закрывается путем прижатия двух сторон друг к другу, часто встречается на пакетах для хранения.",
                        "zh": "一种塑料密封条，通过将两侧按压在一起进行密封，常见于储物袋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зип-лок",
                                "target_lang_sense_clarification": "пластиковая застежка"
                            },
                            {
                                "target_lang_word": "гриппер",
                                "target_lang_sense_clarification": "техническое название пакета с застежкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "密封条",
                                "target_lang_sense_clarification": "塑料袋上的封口"
                            },
                            {
                                "target_lang_word": "自封口",
                                "target_lang_sense_clarification": "指代自封袋的封口方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34f75abc-53cc-3aa3-8e0c-b7f853544ea8",
                    "sense_definition": "A long, prominent scar on a person's body, often from a major surgery.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heart surgery, he was left with a long <w>zipper</w> down his chest.",
                            "target_lang_translations": {
                                "ru": "После операции на сердце у него на груди остался длинный <w>шрам</w>.",
                                "zh": "心脏手术后，他的胸口留下了一道长长的<w>手术疤痕</w>。"
                            }
                        },
                        {
                            "text": "Many athletes had <w>zippers</w> down the side of their knees from past operations.",
                            "target_lang_translations": {
                                "ru": "У многих атлетов были <w>шрамы</w> на коленях после прошлых операций.",
                                "zh": "许多运动员的膝盖侧面都有过去手术留下的<w>手术疤痕</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "surgical zipper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically for surgical scars"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный, заметный шрам на теле человека, часто после серьезной операции.",
                        "zh": "身体上的一道长而明显的疤痕，通常由大型手术引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молния",
                                "target_lang_sense_clarification": "сленговое название шрама"
                            },
                            {
                                "target_lang_word": "шрам",
                                "target_lang_sense_clarification": "послеоперационный след"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手术疤痕",
                                "target_lang_sense_clarification": "指代手术留下的长条状疤痕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d80e9270-06d2-3446-8f7a-3f314e00f3d0",
                    "sense_definition": "A cable or rope stretched between two points at different heights, down which a person slides for entertainment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recreation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Riding the <w>zipper</w> involved sliding four hundred feet on a cable between two mountain peaks.",
                            "target_lang_translations": {
                                "ru": "Поездка на <w>зиплайне</w> включала спуск на четыреста футов по тросу между двумя горными вершинами.",
                                "zh": "乘坐<w>高空滑索</w>需要在两座山峰之间沿着钢索滑行四百英尺。"
                            }
                        },
                        {
                            "text": "The adventure park features a high-speed <w>zipper</w> over the forest canopy.",
                            "target_lang_translations": {
                                "ru": "В парке приключений есть скоростной <w>зиплайн</w> над кронами деревьев.",
                                "zh": "这个探险公园里有一条横跨森林树冠的高速<w>高空滑索</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ride the zipper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "less common than zipline"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трос или канат, натянутый между двумя точками на разной высоте, по которому человек скользит для развлечения.",
                        "zh": "一种在两点之间架设的钢索，供人滑行娱乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зиплайн",
                                "target_lang_sense_clarification": "спуск по тросу"
                            },
                            {
                                "target_lang_word": "тарзанка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高空滑索",
                                "target_lang_sense_clarification": "娱乐设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2ca7bea-7766-34fe-abf7-ca3cd94b9b02",
                    "sense_definition": "A technique in computer science for traversing and updating an aggregate data structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The functional programmer used a <w>zipper</w> to efficiently update the tree structure.",
                            "target_lang_translations": {
                                "ru": "Функциональный программист использовал <w>зиппер</w> для эффективного обновления древовидной структуры.",
                                "zh": "函数式程序员使用<w>拉链</w>高效地更新了树状结构。"
                            }
                        },
                        {
                            "text": "Implementing a <w>zipper</w> allows for local navigation within a complex data set.",
                            "target_lang_translations": {
                                "ru": "Реализация <w>зиппера</w> позволяет осуществлять локальную навигацию внутри сложного набора данных.",
                                "zh": "实现<w>拉链</w>可以在复杂数据集内进行局部导航。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "data structure zipper"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод в информатике для обхода и обновления агрегированной структуры данных.",
                        "zh": "计算机科学中用于遍历和更新聚合数据结构的一种技术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зиппер",
                                "target_lang_sense_clarification": "структура данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉链",
                                "target_lang_sense_clarification": "函数式编程中的数据结构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e2ddc0b-3742-368e-8102-d86d5460ccdc",
                    "sense_definition": "To fasten or close something using a zipper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fastening_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>zippered</w> his sweater against the cold wind.",
                            "target_lang_translations": {
                                "ru": "Он <w>застегнул</w> свитер, спасаясь от холодного ветра.",
                                "zh": "他<w>拉上</w>了毛衣的拉链以抵御寒风。"
                            }
                        },
                        {
                            "text": "Please <w>zipper</w> up your coat before you go outside.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>застегни</w> пальто, прежде чем выходить на улицу.",
                                "zh": "出门前请把外套的拉链<w>拉好</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zip",
                        "zip up",
                        "zipper up"
                    ],
                    "antonyms": [
                        "unzip",
                        "unzipper",
                        "zip down",
                        "zipper down"
                    ],
                    "common_phrases": [
                        "zipper up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Застегнуть или закрыть что-либо с помощью молнии.",
                        "zh": "用拉链扣合或关闭某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застегивать",
                                "target_lang_sense_clarification": "на молнию"
                            },
                            {
                                "target_lang_word": "застегнуть",
                                "target_lang_sense_clarification": "завершить действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉上",
                                "target_lang_sense_clarification": "拉上拉链"
                            },
                            {
                                "target_lang_word": "拉好",
                                "target_lang_sense_clarification": "完成拉链动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af45e597-dadb-31fc-b2d4-07c3aa0388d9",
                    "sense_definition": "To provide or equip an article of clothing or a bag with a zipper.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manufacturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These fall jackets are <w>zippered</w> rather than buttoned for convenience.",
                            "target_lang_translations": {
                                "ru": "Эти осенние куртки для удобства сделаны на <w>молнии</w>, а не на пуговицах.",
                                "zh": "为了方便，这些秋季夹克都<w>装</w>了拉链，而不是扣子。"
                            }
                        },
                        {
                            "text": "The designer decided to <w>zipper</w> the side of the boots.",
                            "target_lang_translations": {
                                "ru": "Дизайнер решил <w>вшить молнию</w> сбоку сапог.",
                                "zh": "设计师决定在靴子侧面<w>装</w>上拉链。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "zippered pockets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабдить или оснастить предмет одежды или сумку молнией.",
                        "zh": "为衣物或包袋安装拉链。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оснащать молнией",
                                "target_lang_sense_clarification": "в процессе производства"
                            },
                            {
                                "target_lang_word": "вшивать молнию",
                                "target_lang_sense_clarification": "в одежду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装拉链",
                                "target_lang_sense_clarification": "制造工艺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d62d2cf-53ed-3e70-afeb-5765fdf77172",
                    "sense_definition": "To open or unfasten something using a zipper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastening_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>zippered</w> down her jacket as she entered the warm room.",
                            "target_lang_translations": {
                                "ru": "Она <w>расстегнула</w> куртку, войдя в теплую комнату.",
                                "zh": "她走进温暖的房间时，把夹克的拉链<w>拉开</w>了。"
                            }
                        },
                        {
                            "text": "It is easier to <w>zipper</w> down the bag to see what is inside.",
                            "target_lang_translations": {
                                "ru": "Проще <w>расстегнуть</w> сумку, чтобы увидеть, что внутри.",
                                "zh": "把包的拉链<w>拉开</w>看看里面有什么会更容易。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unzip",
                        "zip down",
                        "zipper down"
                    ],
                    "antonyms": [
                        "zip down",
                        "zipper down"
                    ],
                    "common_phrases": [
                        "zipper down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыть или расстегнуть что-либо с помощью молнии.",
                        "zh": "用拉链打开或解开某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстегивать",
                                "target_lang_sense_clarification": "молнию"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "с помощью молнии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉开",
                                "target_lang_sense_clarification": "拉开拉链"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52b99733-8580-3e69-b000-9ad8407d4644",
                    "sense_definition": "To interleave or combine two sets of data or objects in an alternating fashion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "combining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm will <w>zipper</w> the two lists into a single ordered sequence.",
                            "target_lang_translations": {
                                "ru": "Алгоритм <w>объединит</w> два списка в одну упорядоченную последовательность.",
                                "zh": "该算法会将两个列表<w>交替合并</w>成一个有序序列。"
                            }
                        },
                        {
                            "text": "Traffic began to <w>zipper</w> together as the two lanes merged into one.",
                            "target_lang_translations": {
                                "ru": "Машины начали <w>съезжаться</w> по принципу молнии, когда две полосы слились в одну.",
                                "zh": "当两条车道合并为一条时，车辆开始<w>交替合并</w>通行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "zipper merge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чередовать или объединять два набора данных или объектов в шахматном порядке.",
                        "zh": "以交替方式合并两组数据或对象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "по принципу молнии"
                            },
                            {
                                "target_lang_word": "перемежать",
                                "target_lang_sense_clarification": "данные или потоки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交替合并",
                                "target_lang_sense_clarification": "数据处理或交通流"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}