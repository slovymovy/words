                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Smycz</w> została wybrana na nową przewodniczącą komisji edukacji.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Смыч</w> была избрана новым председателем комиссии по образованию."
                            }
