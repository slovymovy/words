                "senses": [
                    {
                        "sense_id": "c7ce9f2c-3b01-32b0-a943-d7f39808b86c",
                        "entry_id": "dc4a3e66-b25c-37eb-86f2-bc537e754347",
                        "glosses": [
                            "vereinzelte Stelle, von der aus Widerstand geleistet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01edb430-3b57-471d-a4bd-56642a705082",
                                "sense_id": "c7ce9f2c-3b01-32b0-a943-d7f39808b86c",
                                "text": "„Die Angreifer hatten die hartnäckigen Widerstandsnester umgangen und waren schnell so weit wie möglich nach Westen vorgestoßen.“"
                            },
                            {
                                "example_id": "793618d9-0c99-4de3-b8cb-46ea8f2fa73c",
                                "sense_id": "c7ce9f2c-3b01-32b0-a943-d7f39808b86c",
                                "text": "„Abgesehen von vereinzelten Widerstandsnestern war allein Masʿud, der mit Badakhschan und dem Pandchirtal zehn Prozent der Landesfläche kontrollierte, als ernst zu nehmender Gegner übrig geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
