                    {
                        "translation_id": "10c58a90-b3e6-4350-b6a2-ea6f54a9522d",
                        "source_entry_id": "484ac76d-4cf5-34c8-9ab1-bbee43bbacab",
                        "source_sense_id": "602f4e10-6353-3c72-9870-0f86d87cf99a",
