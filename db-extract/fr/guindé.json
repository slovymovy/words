                    },
                    {
                        "form_id": "1d807341-f2b0-4cc5-bdc6-9a572c3ffdc0",
                        "entry_id": "c1fe3ee9-2147-3639-9c08-c39c8a5d9a21",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "guindée"
                    },
                    {
                        "form_id": "428ea4ba-55ce-45ce-b31b-b5992a7571ad",
                        "entry_id": "c1fe3ee9-2147-3639-9c08-c39c8a5d9a21",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "guindées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfdfd224-df43-3a01-87cf-fa04bcc75409",
                        "entry_id": "c1fe3ee9-2147-3639-9c08-c39c8a5d9a21",
                        "glosses": [
                            "Qui a l’air contraint, qui veut paraître toujours grave. — Note d’usage : S’applique surtout aux manières, aux allures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0515e2f-20b1-4b8a-bed7-fb772cd82ff9",
                                "sense_id": "bfdfd224-df43-3a01-87cf-fa04bcc75409",
                                "text": "Dans une atmosphère d’usages si froids et si guindés, elle avait si peu joui de la fraîcheur et de la poésie de son âge."
                            },
                            {
                                "example_id": "9379ce3c-5bcd-40f7-a856-938e2da4bdf7",
                                "sense_id": "bfdfd224-df43-3a01-87cf-fa04bcc75409",
                                "text": "À beaucoup d’égards, nous préférons la piété amusante et spirituelle de Pierre Camus, l’ami de François de Sales, à la tenue raide et guindée qui est devenue plus tard la règle du clergé français et a fait de lui une sorte d’armée noire à part du monde et en guerre avec lui."
                            },
                            {
                                "example_id": "9a82aadf-1f3f-4f2a-90c8-5695ff48d2eb",
                                "sense_id": "bfdfd224-df43-3a01-87cf-fa04bcc75409",
                                "text": "En vis-à-vis du bâtiment vétuste, l’établissement des jeunes élèves-maîtresses, guindées en leur costume sévère sous le chapeau de feutre sans élégance. Le plupart portent lorgnons. Un peu bas-bleu ! pas mal pimbêches."
                            },
                            {
                                "example_id": "0012adc3-97d7-4d96-afc6-5545028dde31",
                                "sense_id": "bfdfd224-df43-3a01-87cf-fa04bcc75409",
                                "text": "Pourquoi ai-je choisi d’écrire ? Enfant, je n’avais guère pris au sérieux mes gribouillages ; mon véritable souci avait été de connaître ; je me plaisais à rédiger mes compositions françaises, mais ces demoiselles me reprochaient mon style guindé ; je ne me sentais pas « douée »."
                            },
                            {
                                "example_id": "79b28856-645a-47e0-971e-d6e2eb03adaf",
                                "sense_id": "bfdfd224-df43-3a01-87cf-fa04bcc75409",
                                "text": "Une femme à la puissante aura de pouvoir, aussi réservée et aussi imposante qu’on pouvait l’attendre d’une reine, mais également « comme il faut », du moins selon les critères andoriens. Un bonnet de nuit guindé, pour quiconque d’autre…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "518c5489-00df-449c-b3a4-3c4db9ee42a7",
                        "source_entry_id": "c1fe3ee9-2147-3639-9c08-c39c8a5d9a21",
                        "source_sense_id": "bfdfd224-df43-3a01-87cf-fa04bcc75409",
                        "target_lang_word": "steif",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steif",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edf1e24c-6641-3954-95e3-e1f8768c6f47",
                                        "entry_id": "fa4d5a1e-1aed-3bb6-a4e0-59a45d8ba749",
                                        "glosses": [
                                            "unbiegsam, fest, starr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8551e0-fa27-4a96-8ab8-19ddfb8c4fe7",
                                                "sense_id": "edf1e24c-6641-3954-95e3-e1f8768c6f47",
                                                "text": "Durch den Einsatz von Wäschestärke war der Kragen ganz steif."
                                            },
                                            {
                                                "example_id": "438adae9-a1c7-4f90-9632-7b3119181e00",
                                                "sense_id": "edf1e24c-6641-3954-95e3-e1f8768c6f47",
                                                "text": "Dann das steif geschlagene Eiweiß unterrühren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfbfb431-2381-3e5c-9bd6-1afc23fa04e5",
                                        "entry_id": "fa4d5a1e-1aed-3bb6-a4e0-59a45d8ba749",
                                        "glosses": [
                                            "in einzelnen Gelenken oder dem ganzen Körper entweder vorübergehend oder auch dauerhaft wenig beweglich, ungelenk"
                                        ],
                                        "tags": [
                                            "mehr oder weniger medizinisch und nur auf den Körper bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6630c5b3-18c6-430a-9715-0c2faebcc7fb",
                                                "sense_id": "cfbfb431-2381-3e5c-9bd6-1afc23fa04e5",
                                                "text": "Wegen der stundenlangen Märsche waren meine Gelenke steif."
                                            },
                                            {
                                                "example_id": "9d28183d-a712-4ff8-8fa1-423daefb16f2",
                                                "sense_id": "cfbfb431-2381-3e5c-9bd6-1afc23fa04e5",
                                                "text": "Nach der Operation hatte er links ein steifes Knie zurückbehalten, was ihm das Reiten stark erschwerte."
                                            },
                                            {
                                                "example_id": "84daa08d-f003-4a13-b78d-ebf61df8c810",
                                                "sense_id": "cfbfb431-2381-3e5c-9bd6-1afc23fa04e5",
                                                "text": "Meine Finger waren mir ganz steif gefroren, und ich war froh, dass das Ende der Wanderung in Sicht war."
                                            },
                                            {
                                                "example_id": "982b28f1-e99e-496b-b4c8-430828d34eaa",
                                                "sense_id": "cfbfb431-2381-3e5c-9bd6-1afc23fa04e5",
                                                "text": "Beweg dich mal, wenn du immer nur vor dem Bildschirm sitzt, wirst du noch ganz steif!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cdbea696-9d00-3431-b869-9bac4214bc58",
                                        "entry_id": "fa4d5a1e-1aed-3bb6-a4e0-59a45d8ba749",
                                        "glosses": [
                                            "unpersönlich, förmlich, ohne Ausstrahlung und Charisma"
                                        ],
                                        "tags": [
                                            "in übertragener Bedeutung auf eine Geisteshaltung bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ad4058-0aba-4d52-9e64-815154d915f9",
                                                "sense_id": "cdbea696-9d00-3431-b869-9bac4214bc58",
                                                "text": "Sein steifes Verhalten machen ihn nicht geeignet als Interviewer zu arbeiten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d3697257-eacb-3fcc-9f7f-fc0e474c4ecd",
                                        "entry_id": "fa4d5a1e-1aed-3bb6-a4e0-59a45d8ba749",
                                        "glosses": [
                                            "heftig, stark bewegt"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa222d0-5a1a-43bc-90c1-1aac8e3be7cb",
                                                "sense_id": "d3697257-eacb-3fcc-9f7f-fc0e474c4ecd",
                                                "text": "Eine steife Brise machte den Fischern das Einbringen der Netze schwer."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6bc91634-b5a1-3138-97a9-9724b360678a",
                                        "entry_id": "fa4d5a1e-1aed-3bb6-a4e0-59a45d8ba749",
                                        "glosses": [
                                            "stark, kräftig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cbeb712-5047-44c1-bd5e-846d3bf2904f",
                                                "sense_id": "6bc91634-b5a1-3138-97a9-9724b360678a",
                                                "text": "Sein steifer Gang zeigte, wie gereizt er war."
                                            },
                                            {
                                                "example_id": "125ef5e4-017b-4994-841a-51de1a8726b7",
                                                "sense_id": "6bc91634-b5a1-3138-97a9-9724b360678a",
                                                "text": "Nun brauche ich erst einmal einen steifen Grogg."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "dab8c59c-bc0e-3c8b-98b5-5a00d79d6766",
                                        "entry_id": "fa4d5a1e-1aed-3bb6-a4e0-59a45d8ba749",
                                        "glosses": [
                                            "sexuell erregt, mit erigiertem Penis"
                                        ],
                                        "tags": [
                                            "speziell über das männliche Glied"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f020d8-f0ac-4881-a370-a7453d8b8916",
                                                "sense_id": "dab8c59c-bc0e-3c8b-98b5-5a00d79d6766",
                                                "text": "Wenn ich nur daran dachte, war er sofort steif."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
