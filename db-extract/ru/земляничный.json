                ],
                "senses": [
                    {
                        "sense_id": "9c796e70-188f-3e1d-8bf8-f1c1d39981fc",
                        "entry_id": "a5047987-7fd8-3847-8745-e6db8ed40e15",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным земляника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202613f5-d067-4e82-9135-999a46973819",
                                "sense_id": "9c796e70-188f-3e1d-8bf8-f1c1d39981fc",
                                "text": "Тут были качели, куртины со смородиной, земляничные гряды, а в глубине — пруд, где утонула Минушка, и баня."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ba2e7de-3461-3b7f-8be3-555cf0120a70",
                        "entry_id": "a5047987-7fd8-3847-8745-e6db8ed40e15",
                        "glosses": [
                            "приготовленный из земляники, с земляникой, её соком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "340e366c-a0b8-459e-9781-d1ee708092cf",
                                "sense_id": "8ba2e7de-3461-3b7f-8be3-555cf0120a70",
                                "text": "Да не забудь сказать, что я купила для Наталии Павловны ее любимый английский кекс и земляничные паты."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f470dd3-e0b1-3412-85cc-6c8e4e33ae8f",
                        "entry_id": "a5047987-7fd8-3847-8745-e6db8ed40e15",
                        "glosses": [
                            "розовато-красный, цвета земляники"
                        ],
                        "tags": [],
                        "examples": []
                    }
