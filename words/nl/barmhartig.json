{
    "word_family": [
        "barmhartigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a4874fb2-d5f6-3c70-a2ad-61e4edd3c8c9",
                    "sense_definition": "vol mededogen en bereidheid om te vergeven of te helpen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mededogend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter toonde zich <w>barmhartig</w> en gaf de jonge dader een lichte straf.",
                            "target_lang_translations": {
                                "en": "The judge showed himself to be <w>merciful</w> and gave the young offender a light sentence."
                            }
                        },
                        {
                            "text": "Zij staat bekend als een <w>barmhartige</w> vrouw die altijd klaarstaat voor de armen.",
                            "target_lang_translations": {
                                "en": "She is known as a <w>compassionate</w> woman who is always there for the poor."
                            }
                        }
                    ],
                    "synonyms": [
                        "genadig",
                        "mededogend",
                        "vergevingsgezind"
                    ],
                    "antonyms": [
                        "onbarmhartig"
                    ],
                    "common_phrases": [
                        "een barmhartige rechter",
                        "barmhartig zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "full of compassion and willingness to forgive or help"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "merciful",
                                "target_lang_sense_clarification": "showing mercy or forgiveness"
                            },
                            {
                                "target_lang_word": "compassionate",
                                "target_lang_sense_clarification": "feeling or showing sympathy and concern for others"
                            },
                            {
                                "target_lang_word": "lenient",
                                "target_lang_sense_clarification": "merciful or tolerant in judgment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed56d34f-18d9-344b-a9c2-ce6cbaee3767",
                    "sense_definition": "vrijgevig en hulpvaardig ten opzichte van behoeftigen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mededogend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>barmhartige</w> Samaritaan hielp de gewonde man langs de kant van de weg.",
                            "target_lang_translations": {
                                "en": "The <w>Good</w> Samaritan helped the injured man by the side of the road."
                            }
                        },
                        {
                            "text": "Dankzij enkele <w>barmhartige</w> donateurs kon het opvangcentrum open blijven.",
                            "target_lang_translations": {
                                "en": "Thanks to a few <w>charitable</w> donors, the shelter was able to remain open."
                            }
                        }
                    ],
                    "synonyms": [
                        "liefdadig",
                        "vrijgevig",
                        "hulpvaardig"
                    ],
                    "antonyms": [
                        "onbarmhartig"
                    ],
                    "common_phrases": [
                        "barmhartige Samaritaan"
                    ],
                    "target_lang_definitions": {
                        "en": "generous and helpful towards those in need"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "charitable",
                                "target_lang_sense_clarification": "relating to the assistance of those in need"
                            },
                            {
                                "target_lang_word": "benevolent",
                                "target_lang_sense_clarification": "well-meaning and kindly"
                            },
                            {
                                "target_lang_word": "merciful",
                                "target_lang_sense_clarification": "showing kindness and aid to the needy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca530fef-ee10-3593-96c4-bcbc1cbc3fb1",
                    "sense_definition": "op vergevende wijze begrip tonend voor iemands moeilijkheden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mededogend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij luisterde met een <w>barmhartig</w> oor naar haar verdrietige verhaal.",
                            "target_lang_translations": {
                                "en": "He listened to her sad story with a <w>sympathetic</w> ear."
                            }
                        },
                        {
                            "text": "De leraar was <w>barmhartig</w> bij het beoordelen van de te laat ingeleverde opdrachten.",
                            "target_lang_translations": {
                                "en": "The teacher was <w>lenient</w> when grading the assignments that were handed in late."
                            }
                        }
                    ],
                    "synonyms": [
                        "begripvol",
                        "toegeeflijk"
                    ],
                    "antonyms": [
                        "onbarmhartig"
                    ],
                    "common_phrases": [
                        "een barmhartige blik"
                    ],
                    "target_lang_definitions": {
                        "en": "showing understanding for someone's difficulties in a forgiving manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sympathetic",
                                "target_lang_sense_clarification": "showing approval and support for someone's feelings"
                            },
                            {
                                "target_lang_word": "understanding",
                                "target_lang_sense_clarification": "sympathetic, tolerant, or forgiving"
                            },
                            {
                                "target_lang_word": "lenient",
                                "target_lang_sense_clarification": "not strict or severe in grading or judging"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}