                        ]
                    },
                    {
                        "translation_id": "eda2a170-c6b6-4425-a03d-9fa46f8e0590",
                        "source_entry_id": "b6a55c45-8e3d-3644-a628-bdd27a8ad2fb",
                        "source_sense_id": "b1b73097-4db2-324f-82e1-78b00dbab5cc",
                        "target_lang_word": "cheminot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheminot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2ed191-78da-3922-a67b-0692b8b51361",
                                        "entry_id": "e31c5528-c45f-327a-a3bb-f8ab06a3556d",
                                        "glosses": [
                                            "Relatif aux chemins de fer, aux employés des chemins de fer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9dc97b-6dfb-412e-8e8f-2792a6109efd",
                                                "sense_id": "3d2ed191-78da-3922-a67b-0692b8b51361",
                                                "text": "Il dit surtout tenir compte de l’échec des deux dernières grandes mobilisations cheminotes, en avril 2010 (sur des revendications internes) et, cet automne, contre les retraites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cheminot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                        "entry_id": "34a2ebb0-3623-3df3-8773-23c8f4fe33c4",
                                        "glosses": [
                                            "Employé des chemins de fer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9899bd2-c44f-4564-a8e9-e169b8121f8b",
                                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                                "text": "Lorsque Pizarro, le mécanicien de l’Aquila Azteca, immobilise sa locomotive à la verticale du signal rouge, il est stupéfait de voir surgir sur le marchepied gauche un cheminot en salopette, le visage barbouillé de cambouis."
                                            },
                                            {
                                                "example_id": "9c56363c-e582-4d8a-82f2-c2a4e4d01c5b",
                                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                                "text": "Il oppose les « anciens », les T5 (conducteurs de grandes lignes ou « tégévistes ») et autres « sénateurs du rail », syndiqués dans leur grande majorité à la CGT ou à la FGAAC (Fédération générale autonome des agents de conduite), aux T4 (conducteurs de banlieue), plus jeunes et dotés d'une culture distincte de celle de la corporation traditionnelle des cheminots."
                                            },
                                            {
                                                "example_id": "fbfbbdcd-ad92-4620-9207-45aae1a1dc94",
                                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                                "text": "Dans les cortèges qui défilent aux quatre coins du pays se mêlent employés de banque, contrôleurs aériens, cheminots, enseignants et travailleurs de la santé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cheminot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "122698b8-9560-30b1-8704-d428647c97ca",
                                        "entry_id": "0c7c46e0-b532-3306-a889-537c09c9f9c1",
                                        "glosses": [
                                            "Autre orthographe de chemineau"
                                        ],
                                        "tags": [
                                            "Rouen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5a05309-ad19-4771-be1b-f8a518c9d211",
                                                "sense_id": "122698b8-9560-30b1-8704-d428647c97ca",
                                                "text": "A Rouen, on consommait des cheminots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
