                        "glosses": [
                            "Sorte de petit pain italien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280aeb2b-6f4d-4ff1-9af1-97a7fd122359",
                                "sense_id": "cc7610b2-b371-394c-b458-c6540ca0659e",
                                "text": "Dominique est condamné à se mettre sur les rangs, comme les autres, pour y recevoir un joli pain doré, qu'on appelle dans son pays [à Turin] une « pagnotte »."
                            },
                            {
                                "example_id": "99b24323-e813-459a-92f5-b7c976f0f74c",
                                "sense_id": "cc7610b2-b371-394c-b458-c6540ca0659e",
                                "text": "Dans l'ombre, quelques gabionneurs, étendus sous de grands acacias, prennent leur repas de midi. Des flacons à col allongé, tout entouré de pampres, circulent de bouche en bouche. On mord à belles dents la pagnotte."
                            }
                        ]
                    }
