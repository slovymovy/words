        "ru-extract.jsonl": [
            {
                "entry_id": "6b4aee44-67f5-3c29-bcae-1a6b4de95f11",
                "word": "впрок",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ad92cff-9f53-3cb1-9671-77755da8c84c",
                        "entry_id": "6b4aee44-67f5-3c29-bcae-1a6b4de95f11",
                        "glosses": [
                            "про запас; на будущее"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2957fe55-da59-4c19-a3c8-c750209f95ba",
                                "sense_id": "2ad92cff-9f53-3cb1-9671-77755da8c84c",
                                "text": "Вода, кроме вёдер, была налита в кастрюли, кастрюльки и бидоны, потому что старикам стало тяжело ходить к колодцу, и они пользовались случаем запастись водою впрок ― насколько это было возможно."
                            }
                        ]
                    },
                    {
                        "sense_id": "cad6e6fd-136b-38b7-bee4-5471031b7044",
                        "entry_id": "6b4aee44-67f5-3c29-bcae-1a6b4de95f11",
                        "glosses": [
                            "на пользу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6004c37c-81e7-4f99-ba54-2ec9c98bc80c",
                                "sense_id": "cad6e6fd-136b-38b7-bee4-5471031b7044",
                                "text": "― Пусть это послужит вам хорошим уроком, ― сказала незлобивая чудесная Ирина Григорьевна, отпуская приунывших учеников и почти точь-в-точь повторив мысль, некогда высказанную Колюниным родителем на пыльной купавнинской дорожке, однако и этот урок, видно, пошёл не впрок, и доверчивый Колюня ещё много раз попадался на чужие уловки, оказывался в дураках, переживал, печалился и дулся."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b5ff278-a46a-4c48-a577-0fabce92cb2d",
                        "source_entry_id": "6b4aee44-67f5-3c29-bcae-1a6b4de95f11",
                        "source_sense_description": "про запас; на будущее",
                        "target_lang_word": "en réserve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en réserve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4a25f33-1af6-3aa3-8000-0662929371e2",
                                        "entry_id": "0ab49b70-d6ea-3153-b10b-ec2750926faa",
                                        "glosses": [
                                            "À part, de côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d171b7-c4aa-468e-a97d-946f69de31c3",
                                                "sense_id": "a4a25f33-1af6-3aa3-8000-0662929371e2",
                                                "text": "Il a mis une forte somme en réserve."
                                            },
                                            {
                                                "example_id": "736f6e10-677f-4a61-b911-b86c020d5caf",
                                                "sense_id": "a4a25f33-1af6-3aa3-8000-0662929371e2",
                                                "text": "Il a toujours de l’argent en réserve."
                                            },
                                            {
                                                "example_id": "72816f71-218c-4fd6-9cc0-4ba60cc19630",
                                                "sense_id": "a4a25f33-1af6-3aa3-8000-0662929371e2",
                                                "text": "Cet avocat a toujours quelque argument en réserve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea87cd4-409a-3997-a2e7-94600b1c5d48",
                                        "entry_id": "0ab49b70-d6ea-3153-b10b-ec2750926faa",
                                        "glosses": [
                                            "Marquage, martelage des arbres à conserver lors d’une coupe ; marque apposée sur les arbres réservés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37931dc1-656e-4faa-ae77-1e79301bfac9",
                                                "sense_id": "4ea87cd4-409a-3997-a2e7-94600b1c5d48",
                                                "text": "Dans les coupes marquées en réserve, l'acheteur peut, avant la délivrance du permis d'exploiter, réclamer une vérification à l'effet de faire constater un écart dans le nombre des tiges en réserve indiqué aux clauses particulières."
                                            },
                                            {
                                                "example_id": "c515ba18-5e27-4b63-8c8d-164e6aaa050c",
                                                "sense_id": "4ea87cd4-409a-3997-a2e7-94600b1c5d48",
                                                "text": "Il ajoute que le marquage ayant évolué en cours de chantier puisque le marquage initial en réserve avait fait place à un marquage en abandon et que, le marquage en abandon n’ayant pas été contractuellement prévu, si des feuillus ont été irrégulièrement coupés la responsabilité en incombe au groupement foncier des Cent arpents qui a modifié en cours de chantier les règles concernant le marquage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
