                    {
                        "sense_id": "95203603-0311-31e7-bfe0-c35c1882678e",
                        "entry_id": "f000d38b-2d47-34ed-b456-598a75e0ace4",
                        "glosses": [
                            "Qui n’est pas pareil ; qui forme une disparate ; qui présente une disparité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6986a8-d93f-42f3-9afa-2f41867d26c5",
                                "sense_id": "95203603-0311-31e7-bfe0-c35c1882678e",
                                "text": "Même la simple assonance nous satisfait mieux, et la surprise nous charme davantage des sons un peu dispareils que la concordance tapageuse des coups de cymbale."
                            },
                            {
                                "example_id": "8996c3d4-fef8-4641-a0fb-753b20671545",
                                "sense_id": "95203603-0311-31e7-bfe0-c35c1882678e",
                                "text": "L’égalité reste la plus démente des injustices sur une planète où nous naissons pour nous former dispareils."
                            },
                            {
                                "example_id": "7e08d4c8-f894-439c-ad64-32d7b2e9010a",
                                "sense_id": "95203603-0311-31e7-bfe0-c35c1882678e",
                                "text": "Ô ! Qu’il y en a plusieurs dispareilles à une telle dame, et plusieurs pareilles aussi."
                            }
                        ]
                    }
                ],
