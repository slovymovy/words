                        "entry_id": "0373645e-6d4f-33f7-ad0e-fe413944f506",
                        "glosses": [
                            "Lacking or devoid of good or goodness."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "47a38477-04dd-43ac-9585-48806d640c82",
                                "sense_id": "ffa6a5fa-f885-39c6-8611-85a0893ab914",
                                "text": "If there are souls to whom this world seems a goodless realm, who fail to find divine tokens of love anywhere, you and I are partly responsible."
