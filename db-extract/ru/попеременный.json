                                        "entry_id": "e2a4d461-4e94-38d8-8442-878abdf8f39b",
                                        "glosses": [
                                            "A substitute; an alternative; one designated to take the place of another, if necessary, in performing some duty."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996ae1e7-b5c7-4373-b2f8-a4603342e594",
                                                "sense_id": "2316004b-cf2b-30cb-85aa-7c1256529e00",
                                                "text": "Corridors beyond this point have collapsed. I'm looking for an alternate. Careful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32591e07-ddef-3627-af30-d674b7534f43",
                                        "entry_id": "e2a4d461-4e94-38d8-8442-878abdf8f39b",
                                        "glosses": [
                                            "A proportion derived from another proportion by interchanging the means."
