                "translations": [
                    {
                        "translation_id": "c72f14a1-86cd-452e-bbf0-25ec66a27cee",
                        "source_entry_id": "e8cc68ea-625e-3979-bb21-ec064dd98ae5",
                        "source_sense_description": "to make something more urban in character",
                        "target_lang_word": "urbanisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urbanisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b06f6cd-6903-3c27-9453-0c94c6477c62",
                                        "entry_id": "97dd8d17-b75c-369e-aefd-3aef23a61673",
                                        "glosses": [
                                            "zur Stadt machen; so anpassen, dass es den Gepflogenheiten eines Lebens in der Stadt entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "628d195f-48ed-40b3-a5fb-ff2952f802af",
                                                "sense_id": "2b06f6cd-6903-3c27-9453-0c94c6477c62",
                                                "text": "„Eine unbewusste Scheu vor dieser bis zu achtzig Kilometer großen künstlichen Wasserfläche schien die Menschen zu hindern, den See und seine Ufer zu bevölkern und zu urbanisieren.“"
                                            },
                                            {
                                                "example_id": "fada6080-2ffc-4387-a5f5-eac980fc7c06",
                                                "sense_id": "2b06f6cd-6903-3c27-9453-0c94c6477c62",
                                                "text": "„Denn: »Urbanisieren heißt valorisieren. Urbanisieren heißt nicht, Geld ausgeben, vielmehr Geld verdienen, Geld machen. Das Zentrum der Großstädte bedeutet einen gewaltigen Bodenwert, der vervielfacht werden kann.“"
                                            },
                                            {
                                                "example_id": "f9e6c5f5-fd58-4710-945c-757a8666d8db",
                                                "sense_id": "2b06f6cd-6903-3c27-9453-0c94c6477c62",
                                                "text": "„Die Sitten an der Alma Mater begannen sich zu urbanisieren. Lobend schrieben Zeitgenossen, vor Ickstatts und Loris Zeiten hätte man an der Universität zu Ingolstadt das Wort Disziplin nicht aussprechen dürfen, ohne geprügelt zu werden.“"
                                            },
                                            {
                                                "example_id": "e1030d9a-f2b5-4bb0-bcf5-70941e6f07a5",
                                                "sense_id": "2b06f6cd-6903-3c27-9453-0c94c6477c62",
                                                "text": "„Diese Region ist auch sehr viel stärker urbanisiert als der Rest Indiens, während der Osten Indiens außer der alten Metropole Kolkata (Kalkutta) nur wenige größere Städte aufweist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
