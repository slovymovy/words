    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9cd76218-2bcc-35b9-8dcd-ebb67aecfe7c",
                    "sense_definition": "Faire entrer de l'air dans ses poumons pour absorber l'oxygène puis le rejeter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "respiration_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvrez grand la fenêtre pour laisser entrer l'air frais et <w>respirer</w> un peu."
                        },
                        {
                            "text": "Après avoir couru pendant une demi-heure, il s'est assis sur le banc pour <w>respirer</w> calmement."
                        }
                    ],
                    "antonyms": [
                        "asphyxier",
                        "étouffer"
                    ],
                    "common_phrases": [
                        "respirer profondément",
                        "respirer à pleins poumons",
                        "mentir comme on respire"
                    ]
                },
                {
                    "sense_id": "970abb53-22da-35e7-a920-6018228fb4bf",
                    "sense_definition": "Humer ou sentir une odeur par le nez en aspirant l'air.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration_olfactive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'est approchée du rosier fleuri pour <w>respirer</w> le doux parfum des pétales."
                        },
                        {
                            "text": "En entrant dans la cuisine, le jeune homme <w>respire</w> la bonne odeur du gâteau chaud."
                        }
                    ],
                    "synonyms": [
                        "humer",
                        "sentir"
                    ],
                    "common_phrases": [
                        "respirer un parfum",
                        "respirer une odeur"
                    ]
                },
                {
                    "sense_id": "dfb06d38-3a24-3f1a-b927-144f916f9c00",
                    "sense_definition": "Prendre un temps de repos ou éprouver du soulagement après un effort, une peur ou un moment difficile.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soulagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les examens sont enfin terminés, nous pouvons maintenant <w>respirer</w> et préparer nos vacances."
