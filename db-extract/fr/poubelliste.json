                ],
                "senses": [
                    {
                        "sense_id": "759c902f-128b-3eff-823e-2ea41db7795c",
                        "entry_id": "5dd1f0d1-7865-3176-b77e-04c03d2f9701",
                        "glosses": [
                            "Préposé ou préposée au ramassage des poubelles."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "64b7fa0c-b2fd-40b1-8a7a-789532997ba4",
                                "sense_id": "759c902f-128b-3eff-823e-2ea41db7795c",
                                "text": "Le bon ouvrier se demande à quoi sert d'être qualifié, d'être habile, alors qu'il ne gagne que 75 % du salaire du poubelliste et du nettoyeur de carreaux."
                            },
                            {
                                "example_id": "9665d8b1-615d-4eb8-b0ef-68b9ea0f388d",
                                "sense_id": "759c902f-128b-3eff-823e-2ea41db7795c",
                                "text": "C'est la voiture des poubellistes qui les réveilla tous les deux. Le grondement du moteur, les chocs métalliques des poubelles, faisaient un grand tapage dans le calme du matin."
                            },
                            {
                                "example_id": "9e9f95f4-9b0e-4f59-ae4f-74aa958d3f58",
                                "sense_id": "759c902f-128b-3eff-823e-2ea41db7795c",
                                "text": "Doudou était préposé à la propreté des lieux − employé communal pour les gens de gauche, poubelliste ou éboueur pour ceux de droite, je n'ose pas vous dire comment les fascistes d’extrême-droite le désignent −, vers huit heures et demie c'est lui qui amenait avec sa charrette à bras les trois énormes poubelles pour le tri sélectif, il les disposait à l'angle sud-ouest de la place, non loin de l'étal aux poissons."
                            }
                        ]
                    }
                ],
