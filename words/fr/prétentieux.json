{
    "word_family": [
        "prétendre",
        "prétention",
        "prétentieusement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "533bcc2d-c336-3965-b12f-6d36aca3a26d",
                    "sense_definition": "Qui a des prétentions excessives ou injustifiées, qui cherche à en imposer ou à attirer l'admiration d'autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pretention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je le trouve très <w>prétentieux</w> depuis qu'il a obtenu cette promotion au bureau."
                        },
                        {
                            "text": "Elle n'est pas du tout <w>prétentieuse</w> malgré son immense succès dans le milieu artistique."
                        }
                    ],
                    "synonyms": [
                        "présomptueux",
                        "suffisant",
                        "vaniteux",
                        "vantard"
                    ],
                    "antonyms": [
                        "humble",
                        "modeste"
                    ],
                    "common_phrases": [
                        "air prétentieux"
                    ]
                },
                {
                    "sense_id": "6404ae73-32cf-3378-9870-bab74cbc12f2",
                    "sense_definition": "Où se manifestent de l'affectation, un manque de simplicité ou une recherche excessive d'effet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pretention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a répondu à ma question sur un ton particulièrement <w>prétentieux</w>."
                        },
                        {
                            "text": "Ce roman utilise un style <w>prétentieux</w> qui rend la lecture assez pénible."
                        }
                    ],
                    "antonyms": [
                        "naturel",
                        "simple"
                    ],
                    "common_phrases": [
                        "style prétentieux",
                        "ton prétentieux"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c04402b-1cdc-3471-bdc9-c75ab2ca828e",
                    "sense_definition": "Personne imbue d'elle-même qui fait preuve d'orgueil ou de vanité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pretention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne fais pas le <w>prétentieux</w> devant tout le monde et reste modeste."
                        },
                        {
                            "text": "Ce jeune homme est un <w>prétentieux</w> qui refuse de parler à ses collègues."
                        }
                    ],
                    "synonyms": [
                        "poseur"
                    ],
                    "common_phrases": [
                        "faire le prétentieux"
                    ]
                }
            ]
        }
    ]
}