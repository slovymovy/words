                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "947343b1-bdd3-4fb9-b0b3-4cab842b2b85",
                                "sense_id": "c11dfd05-bb90-3518-a1fc-1157f48e0c74",
                                "text": "I've successfully transformed myself from an AFC (Average Frustrated Chump) into an RAFC (Recovering Average Frustrated Chump)."
                            },
                            {
                                "example_id": "be97ba32-acde-4ca5-a523-979a6aa01e0c",
                                "sense_id": "c11dfd05-bb90-3518-a1fc-1157f48e0c74",
                                "text": "Most AFCs, most guys looking in from the outside, can relate to the idea of what an average frustrated chump is – they can identify with it."
                            },
                            {
                                "example_id": "0e13e7ac-9d72-4fc1-b1d0-eb5972a193a9",
                                "sense_id": "c11dfd05-bb90-3518-a1fc-1157f48e0c74",
                                "text": "My problem was the same as every other average frustrated chump (AFC)."
                            }
                        ]
                    }
