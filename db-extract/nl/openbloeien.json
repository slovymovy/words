        "nl-extract.jsonl": [
            {
                "entry_id": "f442d020-46dc-3c4d-87bb-f8079f186ade",
                "word": "openbloeien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b980f3c8-e0db-3e6e-a7af-348449eb9cc9",
                        "entry_id": "f442d020-46dc-3c4d-87bb-f8079f186ade",
                        "glosses": [
                            "het openen van een bloemknop tot een bloem"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "da51b55a-f550-325a-8a65-4912d2ead4f2",
                        "entry_id": "f442d020-46dc-3c4d-87bb-f8079f186ade",
                        "glosses": [
                            "tot volle pracht ontwikkelen; laten zien wat in potentie aanwezig is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "21a9b107-8a66-4b7f-b7fa-b71848ac5208",
                                "sense_id": "da51b55a-f550-325a-8a65-4912d2ead4f2",
                                "text": "Hij ging om er een week of twee uit te rusten en om er in het allerheiligste, in de schoot van het volk zelf, te genieten van dit openbloeien van de volksziel, waaraan hij en alle bewoners van de beide hoofdsteden en andere steden geen ogenblik twijfelden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f6a1f2a-fab4-49f0-bbf5-f6bc8ee8b384",
                        "source_entry_id": "f442d020-46dc-3c4d-87bb-f8079f186ade",
                        "source_sense_id": "b980f3c8-e0db-3e6e-a7af-348449eb9cc9",
                        "target_lang_word": "épanouir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épanouir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d148a28-3638-38fc-b1f7-a32530f5d6d5",
                                        "entry_id": "0ff887c9-c202-3e17-8fb5-73f05b251c57",
                                        "glosses": [
                                            "Ouvrir, faire ouvrir une fleur."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cfa3c56-854d-4867-b575-5f35ce87ebf8",
                                                "sense_id": "2d148a28-3638-38fc-b1f7-a32530f5d6d5",
                                                "text": "Voyez-vous comme ce rosier a épanoui ses fleurs !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6d24a50-02c4-3eab-b440-3fb52aafed3a",
                                        "entry_id": "0ff887c9-c202-3e17-8fb5-73f05b251c57",
                                        "glosses": [
                                            "Réjouir, faire rire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8296534-b4cb-4c65-8698-d666f73c7647",
                                                "sense_id": "c6d24a50-02c4-3eab-b440-3fb52aafed3a",
                                                "text": "Je lui ai fait un conte qui lui a épanoui la rate."
                                            },
                                            {
                                                "example_id": "7c36c725-74fb-4ab6-8eeb-51809cd8b166",
                                                "sense_id": "c6d24a50-02c4-3eab-b440-3fb52aafed3a",
                                                "text": "La gaieté, la joie épanouit le visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f044b338-8cb0-3171-a6e6-0600500c2b17",
                                        "entry_id": "0ff887c9-c202-3e17-8fb5-73f05b251c57",
                                        "glosses": [
                                            "Déployer les pétales d’une fleur."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e21901-044d-4782-b680-fb0386ec4c68",
                                                "sense_id": "f044b338-8cb0-3171-a6e6-0600500c2b17",
                                                "text": "Un bouton de rose qui s’épanouit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee8251da-7b33-3ba4-8cdf-2159a81aeb4a",
                                        "entry_id": "0ff887c9-c202-3e17-8fb5-73f05b251c57",
                                        "glosses": [
                                            "Se développer et évoluer positivement jusqu’à atteindre sa plénitude."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "636e2c2d-1946-4e6a-b35b-ec2590dd7214",
                                                "sense_id": "ee8251da-7b33-3ba4-8cdf-2159a81aeb4a",
                                                "text": "Le cirque circonscrivait la vie extérieure à une place éloignée et inoffensive, et permettait aux égratignés de trouver un lieu où s’épanouir sans trop de casse supplémentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09ca856e-aa74-37fb-9f5a-79cce85ed2b3",
                                        "entry_id": "0ff887c9-c202-3e17-8fb5-73f05b251c57",
                                        "glosses": [
                                            "Se dérider, devenir serein."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a5e76d1-c353-473d-ad30-74d78f60b6c2",
                                                "sense_id": "09ca856e-aa74-37fb-9f5a-79cce85ed2b3",
                                                "text": "Son visage, son front s’épanouit, ses traits s’épanouissent."
                                            },
                                            {
                                                "example_id": "1dbee512-d878-43cb-be77-92b305b30511",
                                                "sense_id": "09ca856e-aa74-37fb-9f5a-79cce85ed2b3",
                                                "text": "Rébecca, le vin aidant, s'épanouissait dans une humeur heureuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "695fb948-a9a9-3d2e-86f8-100802999735",
                                        "entry_id": "0ff887c9-c202-3e17-8fb5-73f05b251c57",
                                        "glosses": [
                                            "Se dit des nerfs, des fibres, des vaisseaux qui s’étendent et se ramifient en se terminant."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0417c443-54d8-4b9a-9fae-e64b34789be9",
                                                "sense_id": "695fb948-a9a9-3d2e-86f8-100802999735",
                                                "text": "Les nerfs s’épanouissent sous la peau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
