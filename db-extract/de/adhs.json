                                            {
                                                "example_id": "5d187dba-8a74-4528-bbf3-d564ffccdaa4",
                                                "sense_id": "711c9fef-4042-32e4-aece-8f093991ffd4",
                                                "text": "John (le prénom a été changé) raconte que son fils, aujourd’hui adolescent, a été diagnostiqué TDAH (trouble du déficit de l’attention avec ou sans hyperactivité) à l’âge de 6 ans."
                                            },
                                            {
                                                "example_id": "01dacfee-eba0-4a9a-8ad7-a314e59582e5",
                                                "sense_id": "711c9fef-4042-32e4-aece-8f093991ffd4",
                                                "text": "Tout comme les enfants hypersensibles, avec lesquels ils partagent de nombreux traits de caractère, les enfants avec un TDA/H sont attachants, voire même « attachiants » comme disait un de nos fils, tant ils sont uniques, originaux et ne laissent pas indifférents."
                                            },
                                            {
                                                "example_id": "01e884af-f058-4b55-80aa-f51175aee358",
                                                "sense_id": "711c9fef-4042-32e4-aece-8f093991ffd4",
                                                "text": "Cette année, dans ma classe, j'ai sept TDAH."
                                            }
