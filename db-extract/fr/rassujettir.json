                "senses": [
                    {
                        "sense_id": "c09ba992-d603-3689-923c-23a5113f70b8",
                        "entry_id": "9bd93e77-14a6-33a6-8d53-a6268e8eaf63",
                        "glosses": [
                            "Assujettir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ff84e6-91d4-4448-ae4d-53eb1fa985e5",
                                "sense_id": "c09ba992-d603-3689-923c-23a5113f70b8",
                                "text": "Il se réfugiait dans sa myopie, réelle ou feinte; il occupait ses mains tantôt à rassujettir son binocle, tantôt à caresser sa barbiche blanche et clairsemée."
                            },
                            {
                                "example_id": "15b7a203-884d-4793-a875-48e837c3c4a3",
                                "sense_id": "c09ba992-d603-3689-923c-23a5113f70b8",
                                "text": "Son sourire à rassujettir, un peu de mouvement à donner dans ses bouclettes, — la Gorgone n'a pas tout à fait renoncé à plaire... aux croupiers, — elle entre dans sa chambre, donne l'électricité et s'arrête, figée de terreur."
                            }
                        ]
                    }
                ],
