                "senses": [
                    {
                        "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                        "entry_id": "9e93e710-6b3e-3f55-9d00-8d0ff90ac2be",
                        "glosses": [
                            "jemand, der an der Rezeption (dem Empfang) arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ee8c5b-f0ad-4bc0-be7e-f9e1dd106b3f",
                                "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                                "text": "„Ich stand an der aus dunklem Holz verkleideten Rezeption des Danube Plaza in Russe, dem teuersten Hotel in der bulgarischen Kulturhauptstadt, und blickte dem jungen Rezeptionisten in die Augen.“"
                            },
                            {
                                "example_id": "ddd6535d-997d-4a17-8829-6a647cbde292",
                                "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                                "text": "„Der Rezeptionist ruft den Real-Madrid-Fan an, der fünfzehn Minuten später hupend vor der Tür steht.“"
                            },
                            {
                                "example_id": "3e670a3d-8586-4674-a4d1-02b95dce7caf",
                                "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                                "text": "„Schließlich fand der Rezeptionist heraus, wo meine Tante lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
