                    "frequency": "Middle",
                    "semantic_group_id": "changement_couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil d'été a visiblement <w>bruni</w> son teint au cours des dernières semaines."
                        },
                        {
                            "text": "Le cuisinier utilise un chalumeau pour <w>brunir</w> délicatement le dessus de la crème."
