                                "example_id": "fa5144e5-8fdb-431e-8a7a-5c547978628d",
                                "sense_id": "825120b5-9aa6-30ad-863f-5524613a406c",
                                "text": "„Mir fiel ein, dass ich mir die Morgenausgabe einer Rennzeitung kaufen sollte.“"
                            }
