                                        "tags": [
                                            "ditransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "521fd6b7-8c9f-45c3-8f13-852d2ffe0c86",
                                                "sense_id": "6076f590-0ae3-3f7b-bf5f-9765003bb922",
                                                "text": "They put me in the state pen for a year for that."
                                            },
                                            {
                                                "example_id": "d4b789ae-a263-48b4-a3a5-642350978790",
                                                "sense_id": "6076f590-0ae3-3f7b-bf5f-9765003bb922",
                                                "text": "They put me in with an absolute maniac for a cellmate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623e3a93-84f5-3efc-a739-278838e8a4ea",
                                        "entry_id": "68773aaf-c390-3fb3-b4ec-76d8d5e27805",
                                        "glosses": [
                                            "To apply, request, or submit."
