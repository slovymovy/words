                "entry_id": "8670dcaa-a30e-358b-881d-3c1d46b2846d",
                "word": "pliability",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4c85d214-2df7-452c-afa0-d34419b801b6",
