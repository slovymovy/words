                                "example_id": "548821cc-8ffc-4331-83f9-5079e5f93c7b",
                                "sense_id": "55430c0d-7e0e-385c-bd4d-23b9134ab048",
                                "text": "„Die Einführung der Zweinamigkeit begann etwa im 12. Jahrhundert.“"
                            },
                            {
                                "example_id": "42f0f41b-db02-47da-8b3a-835e9f9d22c8",
                                "sense_id": "55430c0d-7e0e-385c-bd4d-23b9134ab048",
                                "text": "„Zusammenfassend können wir auch hier sagen, dass es in allererster Linie die Städte waren, die die Zweinamigkeit und ganz besonders die Etablierung des Familiennamens vorantrieben.“"
                            },
                            {
                                "example_id": "7dca10b6-01ba-4e87-aeae-10470820447b",
                                "sense_id": "55430c0d-7e0e-385c-bd4d-23b9134ab048",
                                "text": "„Die Prozesse der Herausbildung der Zweinamigkeit sind im mittelalterlichen Europa unter ähnlichen gesellschaftlichen Verhältnissen auch ähnlich verlaufen.“"
                            }
