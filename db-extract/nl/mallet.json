                    },
                    {
                        "translation_id": "93fe5af8-0307-407b-8f44-d53f962b8cd9",
                        "source_entry_id": "b84eee2c-48ea-3bcd-b455-e72d0c4f0630",
                        "source_sense_id": "59a08765-e3d0-3f2a-af3c-b8fab567a0fa",
                        "source_sense_description": "stok voor slagwerkinstrumenten",
                        "target_lang_word": "mallet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mallet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c86cba17-2a7d-3f15-8ecf-15fa6751c2a0",
                                        "entry_id": "3f94ffe9-10da-3e94-8654-ae8d6aaf05ec",
                                        "glosses": [
                                            "A type of hammer with a larger-than-usual head made of wood, rubber or similar non-iron material, used by woodworkers for driving a tool, such as a chisel. A kind of maul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "badbb784-518b-40fd-97d4-c2d2806bd34e",
                                                "sense_id": "c86cba17-2a7d-3f15-8ecf-15fa6751c2a0",
                                                "text": "Carpenters use mallets for assembling."
                                            },
                                            {
                                                "example_id": "10f1ef19-c347-4c4f-bd17-d7fdd2f53e50",
                                                "sense_id": "c86cba17-2a7d-3f15-8ecf-15fa6751c2a0",
                                                "text": "We used a mallet to drive the tent pegs into the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41000ff8-633a-3c94-a848-7129cb5377cc",
                                        "entry_id": "3f94ffe9-10da-3e94-8654-ae8d6aaf05ec",
                                        "glosses": [
                                            "A weapon resembling the tool, but typically much larger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd42b49d-6f99-4489-95d3-870351d0ffa6",
                                                "sense_id": "41000ff8-633a-3c94-a848-7129cb5377cc",
                                                "text": "The Mallet of arms, according to the representation of it given by Father Daniel, exactly resembles the wooden instrument of that name, now in use, except in the length of the handle, it was like the hammer of arms, to be used with both hands, indeed it differed very little from that weapon in its form."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2d0520-8956-33c4-90de-1669e5a36f8b",
                                        "entry_id": "3f94ffe9-10da-3e94-8654-ae8d6aaf05ec",
                                        "glosses": [
                                            "A small hammer-like tool used for playing certain musical instruments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf82b2e3-55c0-34e0-94b0-5870f32aadaf",
                                        "entry_id": "3f94ffe9-10da-3e94-8654-ae8d6aaf05ec",
                                        "glosses": [
                                            "A light beetle with a long handle used in playing croquet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b89697-27dd-49f7-9efc-317145687ce4",
                                                "sense_id": "cf82b2e3-55c0-34e0-94b0-5870f32aadaf",
                                                "text": "I had had no opportunity as yet of passing on Poirot’s message to Lawrence. But now, as I strolled out on the lawn, still nursing a grudge against my friend’s high-handedness, I saw Lawrence on the croquet lawn, aimlessly knocking a couple of very ancient balls about, with a still more ancient mallet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c096e69-6fc1-3177-b20e-78a0a6d2fdcd",
                                        "entry_id": "3f94ffe9-10da-3e94-8654-ae8d6aaf05ec",
                                        "glosses": [
                                            "The stick used to strike the ball in the sport of polo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bcde17c-af58-4d1d-b153-373e246168f9",
                                                "sense_id": "7c096e69-6fc1-3177-b20e-78a0a6d2fdcd",
                                                "text": "I regularly have cause to recall a scene from a novel called Madder Music, by Peter de Vries, in which the main character, a writer who specialises in polo, hears a match announcer telling newcomers to the ground that, contrary to popular belief, the ball is struck with the side of the mallet, rather than the end."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mallet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b60765b-3b7f-378c-8e89-91e980f96f7a",
                                        "entry_id": "5ab70c08-661e-3d3b-9d8b-445572318ebc",
                                        "glosses": [
                                            "To beat or strike with, or as if with, a mallet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "601c7da3-34da-41e6-8f85-9935cc805084",
                                                "sense_id": "6b60765b-3b7f-378c-8e89-91e980f96f7a",
                                                "text": "[…] and when a couple of insurgents ran in to make the capture she malleted them with her rifle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af73ebc5-05eb-43b8-9cf2-faf661ac8469",
                        "source_entry_id": "b84eee2c-48ea-3bcd-b455-e72d0c4f0630",
                        "source_sense_id": "59a08765-e3d0-3f2a-af3c-b8fab567a0fa",
                        "source_sense_description": "stok voor slagwerkinstrumenten",
                        "target_lang_word": "baguette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baguette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d52e9a44-2d9a-37ba-bd44-2ba3dc16dd95",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc764a25-fd95-4429-b5e6-00f8053cb496",
                                                "sense_id": "d52e9a44-2d9a-37ba-bd44-2ba3dc16dd95",
                                                "text": "On coupa des baguettes et l’on chercha des perches légères, mais aucune ne se trouva être assez grande pour atteindre la grenouille, qui bâillait toujours, la gueule ouverte, sur sa feuille de nénuphar."
                                            },
                                            {
                                                "example_id": "262fba79-8262-4f5f-81f7-03bfb24165a4",
                                                "sense_id": "d52e9a44-2d9a-37ba-bd44-2ba3dc16dd95",
                                                "text": "J’ai vu les bœufs humiliés sous le joug et le paysan qui les touche de sa baguette longue, avec un geste de magicien, le même que firent son père et son aïeul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d34e76a5-9f05-3fdf-a938-bd3ff4fe97bb",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Tige de bois que l’on attache au corps d’une fusée volante."
                                        ],
                                        "tags": [
                                            "Pyrotechnique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaeb27f9-de8e-4ca3-972b-5b9d083eb459",
                                                "sense_id": "d34e76a5-9f05-3fdf-a938-bd3ff4fe97bb",
                                                "text": "Enfin, une baguette en bois sec et léger , ayant la forme d’une pyramide à quatre pans, est fixée à la fusée, dont elle sert à diriger le vol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bd9c9e2-36b2-3d47-8585-6568d27cbd44",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Bâton terminé par un bout arrondi servant à la percussion. → voir baguette de tambour"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a3bf8c0-0499-4eea-bc67-5f58c2b4f75a",
                                                "sense_id": "0bd9c9e2-36b2-3d47-8585-6568d27cbd44",
                                                "text": "[…] le second avec une espèce de crochet qui fait rendre à la peau tendue un son légèrement différent de celui que produit la percussion de la baguette ordinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d68ecf-d523-3050-a0e2-5924c47da044",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Instrument servant au chef d’orchestre pour diriger les musiciens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8944ce36-0939-46b9-8819-051243d405bd",
                                                "sense_id": "30d68ecf-d523-3050-a0e2-5924c47da044",
                                                "text": "Plusieurs coups de baguette assénés sèchement par le chef d'orchestre sur son pupitre interrompirent le colloque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0437e2-bc79-366b-bf2c-1ad9f9b3b6fe",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Élément composite d’un archet."
                                        ],
                                        "tags": [
                                            "Lutherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45a39b1a-8b99-468a-a137-53aebbf77842",
                                                "sense_id": "6f0437e2-bc79-366b-bf2c-1ad9f9b3b6fe",
                                                "text": "L’archet, tel qu’on le fabrique de nos jours, se compose d’une baguette en bois dur et assez souple à la fois ; c’est le bois de Pernambouc qui est généralement préféré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "298178cd-7467-36c8-b526-5f4b7f6534cc",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Tige qui servait à bourrer une arme à feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83988969-33e5-4a93-9f0d-b923e6cdfdaf",
                                                "sense_id": "298178cd-7467-36c8-b526-5f4b7f6534cc",
                                                "text": "Il est vrai que c’est une arme réellement très commode ; à part le surcroît de dépense des douilles, le fusil Lefaucheux a de grands avantages sur l’arme à baguette ; avec lui on est toujours sur de bien charger son arme […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00550fde-6f91-34a9-97cd-6e0ffb5482f6",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Châtiment exercé en frappant avec un bâton."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "610723d2-51c9-4fbe-998b-cf2e95e5c3ce",
                                                "sense_id": "00550fde-6f91-34a9-97cd-6e0ffb5482f6",
                                                "text": "Qui épargne la baguette hait son fils, celui qui l’aime le corrige soigneusement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85906779-8d47-3ca9-ad83-9ce4966ddc66",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Instrument servant à réaliser des tours de magie ou des enchantements. → voir baguette magique"
                                        ],
                                        "tags": [
                                            "Contes de fée"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456c3d28-bc2a-4920-9090-b11be8fb6a24",
                                                "sense_id": "85906779-8d47-3ca9-ad83-9ce4966ddc66",
                                                "text": "Au secours ! Un voleur très très bête a kidnappé Fifolette pour lui voler sa baguette !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7ca7c13-ec85-3641-8630-e23a43f7055f",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Ustensile permettant de prendre la nourriture pour manger, couramment utilisé en Extrême-Orient."
                                        ],
                                        "tags": [],
                                        "note": "souvent utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "5d309cf4-bb27-4599-95f0-9c5fe6a95b04",
                                                "sense_id": "e7ca7c13-ec85-3641-8630-e23a43f7055f",
                                                "text": "Comme chacun le sait, il faut deux baguettes pour manger du riz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb176f75-a540-3ef7-936f-bfbe7e5143cd",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Verge servant à étendre les peaux pour le séchage."
                                        ],
                                        "tags": [
                                            "Travail du cuir"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf6f369-c5b2-4630-b839-a9b9773455b3",
                                                "sense_id": "fb176f75-a540-3ef7-936f-bfbe7e5143cd",
                                                "text": "[…] à l’étuve les peaux y sont suspendues par des baguettes de cornouiller, comme cela se pratique dans le corroyage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f334dfee-e803-352e-9afe-7fd169ad4fac",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Bâton grâce auquel on résout un problème. → voir baguette divinatoire"
                                        ],
                                        "tags": [
                                            "Divination"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f360797-be2a-4868-a411-24e83d042640",
                                                "sense_id": "f334dfee-e803-352e-9afe-7fd169ad4fac",
                                                "text": "La Baguette y conduit le Devin ; & fait connoitre que les meurtriers y sont entrez (sic)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a75b45d-7950-3362-8a21-8f6f0b8f7774",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Bâton grâce auquel on résout un problème. → voir baguette divinatoire",
                                            "Bâton fourchu en bois flexible que le sourcier tient dans ses mains pour découvrir une veine d’eau. → voir baguette de coudrier et baguette de sourcier"
                                        ],
                                        "tags": [
                                            "Divination",
                                            "Radiesthésie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53059a1f-a220-4c47-b6f9-5935b39a7777",
                                                "sense_id": "2a75b45d-7950-3362-8a21-8f6f0b8f7774",
                                                "text": "Dans la Nouvelle—Angleterre, où les sources sont très abondantes et toujours pures, l’usage de la baguette est moins fréquent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00906f41-8898-3d1a-8d62-525c4fbf1225",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit bâton mince, plus ou moins long et flexible.",
                                            "Bâton grâce auquel on résout un problème. → voir baguette divinatoire",
                                            "En rhabdomancie, verge en bois de tamaris servant à deviner les événements."
                                        ],
                                        "tags": [
                                            "Divination"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf7c090-0c48-4b99-a9ee-30cc0e727fad",
                                                "sense_id": "00906f41-8898-3d1a-8d62-525c4fbf1225",
                                                "text": "Les insulaires de Mélélin se servaient d’une baguette de tamaris, et croyaient qu’Apollon avait donné à cette plante la vertu de deviner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184a9f92-98d7-34a8-b960-92c871207323",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit objet allongé à caractère distinctif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb527a57-2456-4009-b96d-7dcb36c8e470",
                                                "sense_id": "184a9f92-98d7-34a8-b960-92c871207323",
                                                "text": "La baguette est leur seule distinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41e7e417-7325-3cb7-b4e5-0c06a2c6f288",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit objet allongé à caractère distinctif.",
                                            "Éclat de bambou sur lequel est inscrit le nom du moine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05793316-2279-445c-8a5d-f4c97bb28966",
                                                "sense_id": "41e7e417-7325-3cb7-b4e5-0c06a2c6f288",
                                                "text": "Que celui d’entre vous qui désire se rendre demain à la ville de Sûrpâraka pour y faire son repas prenne sa baguette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786de252-7d7f-3f96-a253-f4e27d4374ee",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Petit objet allongé à caractère distinctif.",
                                            "Ornement brodé marquant un grade."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbdea598-4298-4840-a8de-d351501fae55",
                                                "sense_id": "786de252-7d7f-3f96-a253-f4e27d4374ee",
                                                "text": "Le président du conseil de santé aura les mêmes ornements au collet qu’au grand uniforme, dont la broderie supérieure descendra jusqu’au bas des pans de l’habit ; une seule broderie et la baguette sur chaque parement […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc376ffa-f79c-3ed8-bb46-301b3eb3dcdc",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Tout objet long et fin de matière quelconque."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc082d9-1453-45c4-900c-3ba8146da0fd",
                                                "sense_id": "fc376ffa-f79c-3ed8-bb46-301b3eb3dcdc",
                                                "text": "Au moyen de ce système de guide-baguette mécanique, on peut, sans le secours du fileur, confectionner toutes sortes de bobines dans des conditions économiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418e43d0-dbbf-3c3f-a835-b1e81c136cf5",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Tout objet long et fin de matière quelconque.",
                                            "Organe d’une machine servant d’axe."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d8b05e-a893-4658-906f-d1b8119b5f33",
                                                "sense_id": "418e43d0-dbbf-3c3f-a835-b1e81c136cf5",
                                                "text": "Sur le châssis on trouve (fig. 53) :\n2º La virgule B qui actionne la baguette et la contre-baguette au moment du dépointage et limite cette dernière période."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80019431-0822-3e37-815e-54c28672b2bd",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Tout objet long et fin de matière quelconque.",
                                            "Pain long et croustillant."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bfcafdc-4be4-40d5-8d2b-b3a7b7fb8525",
                                                "sense_id": "80019431-0822-3e37-815e-54c28672b2bd",
                                                "text": "[…], Nath a dû contracter un crédit revolving à la con. Merci internet qui permet de trouver un crédit aussi facilement qu’une baguette dans une boulangerie."
                                            },
                                            {
                                                "example_id": "96fe0069-4527-4f2b-8bfd-9ec77b6f977a",
                                                "sense_id": "80019431-0822-3e37-815e-54c28672b2bd",
                                                "text": "On en sort le plus souvent avec de gros pains d’un kilo ou des miches qu’on conserve. Pour nous, le luxe c’était la baguette ou la ficelle qu’on achetait exceptionnellement et qu’on ne trouvait pas d’ailleurs tous les jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ebe69d6-64c9-3f5e-b57d-9674c38e2a94",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Tout objet long et fin de matière quelconque.",
                                            "Sorte de moulure. — Celle qui sert à l’encadrement."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c203b385-786c-4dba-8820-4bf87de5c2bc",
                                                "sense_id": "1ebe69d6-64c9-3f5e-b57d-9674c38e2a94",
                                                "text": "Ce dessin [de Marie Laurencin] est ravissant et extrêmement touchant, faites-lui mettre une petite baguette très étroite et un verre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2177d879-f234-3c21-957f-e7ab919dc42a",
                                        "entry_id": "b804f330-b2ac-309a-bb09-8cb8c7659b8e",
                                        "glosses": [
                                            "Tout objet long et fin de matière quelconque.",
                                            "Jambes longues et fines."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9d89d80-c106-46e4-ad58-f41829fc4334",
                                                "sense_id": "2177d879-f234-3c21-957f-e7ab919dc42a",
                                                "text": "Elle avait les jambes comme des baguettes sous son pantalon, mais on ne s’en apercevait pas si l’on n’y prêtait pas attention."
                                            }
                                        ]
                                    }
                                ]
