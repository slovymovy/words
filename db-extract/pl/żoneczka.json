                ],
                "senses": [
                    {
                        "sense_id": "27ad1511-1cbb-3d69-b91f-6d3658efa83f",
                        "entry_id": "a75bc7a1-81c2-3595-926d-5897c5ee1d8b",
                        "glosses": [
                            "od: żona, żonka"
                        ],
                        "tags": [
                            "colloquial",
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "ecc4fd54-b8aa-46be-b9f8-3ee57bbdbbf4",
                                "sense_id": "27ad1511-1cbb-3d69-b91f-6d3658efa83f",
                                "text": "Kiedy zapytałem żoneczkę, co jej kupić na urodziny, odpowiedziała: „Nic” – i teraz mam zagwozdkę."
                            },
                            {
                                "example_id": "23ff7998-3363-4a20-9cdb-1e106bb2319a",
                                "sense_id": "27ad1511-1cbb-3d69-b91f-6d3658efa83f",
                                "text": "Gdy żoneczka mówi „zrób, jak chcesz”, to wcale nie oznacza, że mogę zrobić, jak chcę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af93b1e9-875b-43da-86b6-98c6e5fda186",
                        "source_entry_id": "a75bc7a1-81c2-3595-926d-5897c5ee1d8b",
                        "source_sense_id": "27ad1511-1cbb-3d69-b91f-6d3658efa83f",
                        "target_lang_word": "жёнушка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жёнушка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "31868f11-d368-3e3b-a6e1-2c8bc6d79e1c",
                                        "entry_id": "73a15a1b-bab8-365a-a534-f82e619546d6",
                                        "glosses": [
                                            "уменьш.-ласк. к жена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c27d05d-94e4-4c6b-be72-9cab556ced43",
                                                "sense_id": "31868f11-d368-3e3b-a6e1-2c8bc6d79e1c",
                                                "text": "Дорогая моя, любимая жёнушка, Душа моя, милая моя, как я по тебе уже соскучился и как мечтаю о том времени, когда наконец обниму тебя."
                                            },
                                            {
                                                "example_id": "b2b05ed3-2b21-4894-93d2-8e24dc046267",
                                                "sense_id": "31868f11-d368-3e3b-a6e1-2c8bc6d79e1c",
                                                "text": "Эй, вправду, пора бы тебе хорошую жёнушку взять, ты же, кажись, мотоват, а мотоват да не женат, себе же в наклад."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
