                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69b50189-139f-49e4-b49f-0fed00e6d963",
                        "source_entry_id": "21d1662c-f073-3d0b-9c15-f885cc5aed30",
                        "source_sense_id": "d2578c6f-6f58-3bcc-a3f5-2cb91ace73f8",
                        "target_lang_word": "pleasantness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleasantness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d85f9ab6-af8e-3826-95e9-6bcf20ee6768",
                                        "entry_id": "f50be026-b8af-3f85-995b-e45d2e1e1512",
                                        "glosses": [
                                            "The state or quality of being pleasant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8439ef71-120d-47fc-b369-c42cca97975f",
                                                "sense_id": "d85f9ab6-af8e-3826-95e9-6bcf20ee6768",
                                                "text": "If this is sound, the pleasantness of pleasure can no longer be our guide; the higherness of the higher pleasure must have the decisive word — hedonism has committed suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45a7efa-3693-3e1e-9dd7-999567c86081",
                                        "entry_id": "f50be026-b8af-3f85-995b-e45d2e1e1512",
                                        "glosses": [
                                            "Something pleasant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2aa9d20-32ed-411e-9d57-4ce0e815053e",
                                                "sense_id": "e45a7efa-3693-3e1e-9dd7-999567c86081",
                                                "text": "[…] to destroy the affections of truth, and thereby the pleasantnesses and happinesses of heaven […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "818a6b87-b0e8-4e0b-a172-b0af177c7d02",
                        "source_entry_id": "21d1662c-f073-3d0b-9c15-f885cc5aed30",
                        "source_sense_id": "d2578c6f-6f58-3bcc-a3f5-2cb91ace73f8",
                        "target_lang_word": "comfort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comfort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "Contentment, ease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ba6da0-9cdf-4454-afb1-08ce9af2a8f6",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "Sleep in comfort with our new mattress."
                                            },
                                            {
                                                "example_id": "f096a95f-a91f-43c4-a221-4478e96b25db",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "But all was in vain: For having ranged up and down the Woods for ſome days, without finding the leaſt comfort to their hungry deſires, they were forced to return again unto the River. […] At laſt they arrived at the Coaſt of the Sea, where they found ſome comfort and relief to their former miſeries, and alſo means to ſeek more."
                                            },
                                            {
                                                "example_id": "b12b7759-1c30-40b4-b2a2-e203c3f37f1c",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "How often is the comfort of a whole family abridged by some trifling circumstance, that ought not to have made a visible impression!"
                                            },
                                            {
                                                "example_id": "6277940d-74d4-4d2b-a02d-cc5d1ee23bfd",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "In a hole in the ground there lived a hobbit. Not a nasty, dirty, wet hole, filled with the ends of worms and an oozy smell, nor yet a dry, bare, sandy hole with nothing in it to sit down on or to eat: it was a hobbit-hole, and that means comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f578e6e7-61cf-32a1-98de-b35ad9726c04",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "Something that offers comfort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec5c482-f43b-4576-b4c9-5b21d542a44f",
                                                "sense_id": "f578e6e7-61cf-32a1-98de-b35ad9726c04",
                                                "text": "the comforts of home"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fff75c8-aad7-339a-8a89-7abdd8d5f16c",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "A consolation; something relieving suffering or worry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b6956d-da19-41c3-bca1-1511d36523e3",
                                                "sense_id": "3fff75c8-aad7-339a-8a89-7abdd8d5f16c",
                                                "text": "We still have the spare tire? That's a comfort at least."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457a5416-6c79-36ee-b4f3-96d6b028b9da",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "A cause of relief or satisfaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec34e29-0375-4ca6-8c7f-06b6a0a5fdf9",
                                                "sense_id": "457a5416-6c79-36ee-b4f3-96d6b028b9da",
                                                "text": "The outcome of the peace negotiations in Moscow in 1940 was a heavy blow to the young nation, but in the same time a great comfort: at least the independency was preserved."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comfort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To relieve the distress or suffering of; to provide comfort to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "723626b3-f0f5-413f-8f66-7f61a4088b44",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Rob comforted Aaron because he was lost and very sad."
                                            },
                                            {
                                                "example_id": "5fdf40ef-9d60-4817-bf92-ec5e7f482c5f",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Shew me a token foꝛ good, that they which hate me may ſee it, and bee aſhamed: becauſe thou, Lord, hast holpen me, and comfoꝛted me."
                                            },
                                            {
                                                "example_id": "dbd77268-90e0-4d48-91fa-4ed4fc71306d",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Light, above all things, excelleth in comforting the spirits of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41f1b2e-7dd0-3657-93bc-7bc1465e07d0",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To make strong; to invigorate; to fortify; to corroborate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620e1633-f609-4162-861a-db2383c7afd2",
                                                "sense_id": "d41f1b2e-7dd0-3657-93bc-7bc1465e07d0",
                                                "text": "God's own testimony […] doth not a little comfort and confirm the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69cf8bed-aaa7-3367-9894-bec0a3dd019b",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To assist or help; to aid."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aae4e1b-05d5-4d52-ac18-28c2c33185f7",
                                                "sense_id": "69cf8bed-aaa7-3367-9894-bec0a3dd019b",
                                                "text": "I […] cannot help the noble chevalier: / God comfort him in this necessity!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
