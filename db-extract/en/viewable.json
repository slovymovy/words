                    {
                        "translation_id": "455fac9d-4162-442f-9a8a-a3685b6b82dc",
                        "source_entry_id": "1f6dbe15-e81e-36e4-a7af-109ede252f80",
                        "source_sense_description": "able to be viewed",
                        "target_lang_word": "zugänglich",
                        "target_lang_code": "de",
