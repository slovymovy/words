                ],
                "senses": [
                    {
                        "sense_id": "e105ac54-d0e3-3aab-a1c1-5f673905db51",
                        "entry_id": "f54f1a7b-90e3-3c9b-af32-bb49e040d516",
                        "glosses": [
                            "Gesamtheit von Methoden und Strategien zur Entwicklung und Umsetzung von innovativen Ideen und Lösungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327d8252-a6fb-41f0-b533-57856c1db1d6",
                                "sense_id": "e105ac54-d0e3-3aab-a1c1-5f673905db51",
                                "text": "„Das Nachvolziehen von Erfindungen im Rahmen der Aus- und Weiterbildung kann dazu beitragen, das Interesse am Bildungsgegenstand zu wecken, den Bildungsgegenstand in seiner Weiterentwicklung besser zu begreifen (genetische Methode) und dabei gleichzeitig Kenntnisse über die Anwendung schöpferischer Methoden (Innovationsmethodik) zu erwerben.“"
                            },
                            {
                                "example_id": "768b40ff-8431-4721-b4b1-d28292ce9dee",
                                "sense_id": "e105ac54-d0e3-3aab-a1c1-5f673905db51",
                                "text": "„Die bisherigen Versuche, Innovationsmethodik zu einer nachvollziehbaren und halbwegs sicheren Erfolgsmethode zu machen, haben nur einen Teilerfolg gebracht.“"
                            },
                            {
                                "example_id": "20adb106-d3f6-4a68-bd99-aac8f2413e1f",
                                "sense_id": "e105ac54-d0e3-3aab-a1c1-5f673905db51",
                                "text": "„Der Begriff Geschäftsmodellinnovation ist erst mit den Arbeiten von Chesbrough (2010) Osterwalder (2010) und Gassmann& Pigneur (2017) strukturiert und als Innovationsmethodik in den Geschäftsleitungen verankert worden.“"
                            },
                            {
                                "example_id": "fe4bfb0e-7c00-4fd9-90f7-490b7bb99ea7",
                                "sense_id": "e105ac54-d0e3-3aab-a1c1-5f673905db51",
                                "text": "„Eine Anleitung zur Innovationsmethodik gibt es aber auch in Stanford nicht. Man kann Innovation nicht mit einem schrittweise aufgebauten und kontrollierten Prozess erzwingen.“"
                            },
                            {
                                "example_id": "ca2d94b3-7b69-4902-8607-975114e98ba5",
                                "sense_id": "e105ac54-d0e3-3aab-a1c1-5f673905db51",
                                "text": "„Bionik ist eine Innovationsmethodik zur Übertragung biologischer Lösungen in die Technik, beispielsweise für die Konstruktion gewichts- und belastungsoptimierter Bauteile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
