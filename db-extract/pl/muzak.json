                "senses": [
                    {
                        "sense_id": "a662630c-8749-3a5e-b2ba-c76add7fd4e8",
                        "entry_id": "1f3a35d5-c5da-3598-bfe6-91fd6f4c18c9",
                        "glosses": [
                            "muzyka odtwarzana w tle w przestrzeniach publicznych, zwłaszcza placówkach handlowych czy innych lokalach użytkowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49fe463-fd5a-43ed-b079-92fd0ba3f93d",
                                "sense_id": "a662630c-8749-3a5e-b2ba-c76add7fd4e8",
                                "text": "Ów tak zwany muzak od początku był traktowany jako całkowicie bezwartościowy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70cca62b-a7c1-4a5c-aacc-10ff31434aaa",
                        "source_entry_id": "1f3a35d5-c5da-3598-bfe6-91fd6f4c18c9",
                        "source_sense_id": "a662630c-8749-3a5e-b2ba-c76add7fd4e8",
                        "target_lang_word": "Muzak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muzak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8d747c1-9a4a-362a-9659-047f2cb9df97",
                                        "entry_id": "5ab70bb1-6878-35b5-826c-b3937ed16a94",
                                        "glosses": [
                                            "Recorded background music characterized by soft, soothing instrumental sounds which is transmitted by wire, radio, or recorded media (originally on a subscription basis) to doctors' offices, shops, and other business premises."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6ddf72d-4056-40b9-b5da-e7eedbde8a1c",
                                                "sense_id": "a8d747c1-9a4a-362a-9659-047f2cb9df97",
                                                "text": "It dawned on her that he was talking about the Muzak. It had been seeping in, in its subliminal, unidentifiable way since they'd entered the place, all strings, reeds, muted brass."
                                            },
                                            {
                                                "example_id": "497939b0-1273-490e-adb8-f210acc65df4",
                                                "sense_id": "a8d747c1-9a4a-362a-9659-047f2cb9df97",
                                                "text": "There's no way I can change internal body functions. Only yogis can do that. Muzak, for example, can't change you. Aaron Copeland [i.e., Aaron Copland] calls Muzak 'the obsequious.' We're super-saturated with shitty music. [Originally published in New Times.]"
                                            },
                                            {
                                                "example_id": "e8d7665d-c5e6-4456-ae4e-ba363cf72dc5",
                                                "sense_id": "a8d747c1-9a4a-362a-9659-047f2cb9df97",
                                                "text": "Some people, of course, have no trouble making that decision: they know they don't like Muzak. Critics charge that Muzak invades what could be pleasurable silence, disrupts conversation, or smacks of George Orwell's 1984. [Originally published in American Way.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Muzak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c25b10f-3f01-3e70-a95e-4470529261c9",
                                        "entry_id": "4b743ee4-f1d6-36fd-beb6-1157dd0f3c0c",
                                        "glosses": [
                                            "Easy listening music, whether played live or recorded, especially if regarded as uninteresting."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99769b7a-a251-467f-871d-508dde25aea1",
                                                "sense_id": "7c25b10f-3f01-3e70-a95e-4470529261c9",
                                                "text": "The sound you make is muzak to my ears / You must have learned something in all those years"
                                            },
                                            {
                                                "example_id": "c2803865-a0c3-4fb4-a447-cb067fc2500c",
                                                "sense_id": "7c25b10f-3f01-3e70-a95e-4470529261c9",
                                                "text": "[T]he supermarket is very crowded, because of course it's the time of day when all other people with jobs also try to squeeze in some grocery shopping, and the store is hideously, fluorescently lit, and infused with soul-killing Muzak or corporate pop, and it's pretty much the last place you want to be, but you can't just get in and quickly out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "453f9352-e5c4-37d0-84fa-c51afbe8fc36",
                                        "entry_id": "4b743ee4-f1d6-36fd-beb6-1157dd0f3c0c",
                                        "glosses": [
                                            "Something (such as speech) regarded as droning on and often boring, or soothing but undemanding."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Muzak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b170d6-c216-3203-938f-fe1a2dd01641",
                                        "entry_id": "44ece200-da86-3152-bec8-951f1c18557d",
                                        "glosses": [
                                            "To provide (premises, etc.) with Muzak."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f752d3a-8592-3a6e-b2e0-291c959894b0",
                                        "entry_id": "44ece200-da86-3152-bec8-951f1c18557d",
                                        "glosses": [
                                            "To adapt or reduce (a piece of music, etc.) to the status of Muzak."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db01bd90-4d02-4114-b792-2c0a6b67f383",
                                                "sense_id": "6f752d3a-8592-3a6e-b2e0-291c959894b0",
                                                "text": "Willington had seen disco for what it was – the great Muzaking of rock and roll via a chintzy chorus, chintzy rotating mirror balls, and chintzy Arthur Murray twirling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
