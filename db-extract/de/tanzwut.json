                        "sense_id": "d6d68ff2-39f5-3c59-a50d-425faf0b4f39",
                        "entry_id": "1f3032f9-2dd5-3fa3-868b-adf8f890a1e3",
                        "glosses": [
                            "epidemische Erscheinung krankhaften Tanzens"
                        ],
                        "tags": [
                            "Spätmittelalter"
                        ],
                        "examples": [
                            {
                                "example_id": "b5ed5c63-004a-4d4c-8d28-419d5f4be130",
                                "sense_id": "d6d68ff2-39f5-3c59-a50d-425faf0b4f39",
                                "text": "„Jetzt wird diese Tanzwut als Chorea major oder magna bezeichnet und als ein Symptom besonders der Hysterie aufgefaßt.“"
                            },
                            {
                                "example_id": "0c205e7b-dc9c-4b7f-a5f2-9c1f61b82e9c",
                                "sense_id": "d6d68ff2-39f5-3c59-a50d-425faf0b4f39",
                                "text": "„Im Antlitz der Pest und der Kriege, des todbringenden Chaos’ und des drohenden Endes der gesellschaftlichen Ordnung bricht eine ekstatische Tanzwut aus. Die Dreiheit Tanz – Ekstase – Tod ist in zahlreichen Abbildungen archiviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
