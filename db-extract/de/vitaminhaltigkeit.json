                "senses": [
                    {
                        "sense_id": "194c9b02-f622-3451-84aa-6b974e85f0e0",
                        "entry_id": "e09e1d14-a79e-3e93-9c5f-1dc2a67dd2e7",
                        "glosses": [
                            "Eigenschaft, Vitamine zu enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7791935-7638-4e6b-8e5c-5b6aec566cbe",
                                "sense_id": "194c9b02-f622-3451-84aa-6b974e85f0e0",
                                "text": "„Die besondere Vitaminhaltigkeit der Eingeweide, wie Leber und Herz (auch Gehirn), ist bekannt.“"
                            },
                            {
                                "example_id": "76880347-3d67-4526-9fb5-606669846a39",
                                "sense_id": "194c9b02-f622-3451-84aa-6b974e85f0e0",
                                "text": "„Infolge ihrer mangelhaften Ernährung, sowohl was die Vitaminhaltigkeit anbelangte als auch die Kalorienmengen, war dies aber kein Zuckerschlecken.“"
                            },
                            {
                                "example_id": "9ccf5558-d6e3-405b-8db4-3687d972de5e",
                                "sense_id": "194c9b02-f622-3451-84aa-6b974e85f0e0",
                                "text": "„Jetzt werfen wir aber doch noch schnell einen Blick in jenes gelobte Land, in dem Tiefkühlpizza wegen ihrer Vitaminhaltigkeit geschätzt wird und Broccoli ob seiner Herkunft aus mexikanischer Erde als schmutzige Gesundheitsgefährdung gilt: die USA.“"
                            },
                            {
                                "example_id": "7d75807d-501b-45f2-9f58-aa1b82f706df",
                                "sense_id": "194c9b02-f622-3451-84aa-6b974e85f0e0",
                                "text": "„Er vertraute dabei der Reichhaltigkeit des politischen Marktes und der Vitaminhaltigkeit der angebotenen Früchte […].“"
                            },
                            {
                                "example_id": "99ed88cb-e380-4ad2-aba3-1e4e2d487e7b",
                                "sense_id": "194c9b02-f622-3451-84aa-6b974e85f0e0",
                                "text": "„Aufgrund ihrer materiellen Besonderheiten ist sie seit Beginn dieses Jahrhunderts ein in Europa wegen ihrer Vitaminhaltigkeit und ihres Kalorienreichtums beliebtes Nahrungsmittel, von Ärzten und Ernährungswissenschaftlern nachdrücklich empfohlen und in den zwanziger Jahren massenhaft als Unterschichtsspeise eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
