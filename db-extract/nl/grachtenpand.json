                "senses": [
                    {
                        "sense_id": "dd5930d9-6f7c-31a6-98b2-8e1603505a04",
                        "entry_id": "e75f2ff0-e8cd-389c-be6f-205432c85225",
                        "glosses": [
                            "gebouw dat staat aan de kade van een gracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1289c70f-72a9-44f6-81a4-c2b9a4f9d7f2",
                                "sense_id": "dd5930d9-6f7c-31a6-98b2-8e1603505a04",
                                "text": "André van Duin (72) heeft zijn grachtenpand in Amsterdam te koop gezet. De komiek en presentator woonde er jarenlang met zijn echtgenoot Martin Elferink (55), die vorige week maandag overleed, maar is nu bezig met een verhuizing."
                            },
                            {
                                "example_id": "163065a1-199d-4b96-80b1-21d892772bd4",
                                "sense_id": "dd5930d9-6f7c-31a6-98b2-8e1603505a04",
                                "text": "Ooit had ik in het Amsterdamse kennis aan een wannabe nouveau riche nichtensetje. De ene zat in het antiek, de andere was decorateur. Hun grachtenpandje was volgestouwd met Oranje-prullaria en ik waande me weer terug bij oma. Alleen kon die niet zo lekker koken als mijn twee suikeroompjes maar ze was minstens zo vals."
                            }
                        ]
                    }
