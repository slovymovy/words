                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0596e41f-14e8-4417-a942-9c187544cbf2",
                                "sense_id": "e7e46a24-0336-3d90-acf7-66a6218346fa",
                                "text": "On convoque les assemblées bailliagères pour l’élection des députés aux états généraux."
                            },
                            {
                                "example_id": "6411d517-28e8-486a-87bf-a2435366a991",
                                "sense_id": "e7e46a24-0336-3d90-acf7-66a6218346fa",
                                "text": "Par l'édit du 31 août 1698, le duc Léopold réorganisa l'administration de la Lorraine : la prévôté de Bruyères devint alors le siège bailliager de Bruyères, sans que sa consistance en soit affectée."
                            }
                        ]
