    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9239f0cd-0ab8-3fe7-b306-42b1789633df",
                    "sense_definition": "De maximale afstand die een voertuig kan afleggen zonder opnieuw te hoeven tanken of opladen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bereik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe elektrische auto heeft een indrukwekkende <w>actieradius</w> van ruim zeshonderd kilometer.",
                            "target_lang_translations": {
                                "en": "The new electric car has an impressive <w>range</w> of over six hundred kilometers."
                            }
                        },
                        {
                            "text": "Met een <w>beperkte actieradius</w> is deze scooter vooral geschikt voor ritten binnen de stad.",
                            "target_lang_translations": {
                                "en": "With a <w>limited range</w>, this scooter is mainly suitable for trips within the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "bereik",
                        "actieradius"
                    ],
                    "common_phrases": [
                        "beperkte actieradius",
                        "maximale actieradius",
                        "grote actieradius"
                    ],
                    "target_lang_definitions": {
                        "en": "The maximum distance a vehicle can travel without needing to refuel or recharge."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "range",
                                "target_lang_sense_clarification": "of a vehicle"
                            },
                            {
                                "target_lang_word": "radius of action",
                                "target_lang_sense_clarification": "maximum distance a vehicle can travel from its base"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c30d8f9-5755-3756-a4f7-acef93707ed2",
                    "sense_definition": "Het gebied of de straal waarbinnen iemand of iets invloed kan uitoefenen of actief kan zijn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bereik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie probeert de <w>actieradius</w> van de criminele bende in kaart te brengen.",
                            "target_lang_translations": {
                                "en": "The police are trying to map the criminal gang's <w>radius of action</w>."
                            }
                        },
                        {
                            "text": "Als lokale ondernemer is onze <w>actieradius</w> beperkt tot de omliggende dorpen.",
                            "target_lang_translations": {
                                "en": "As a local entrepreneur, our <w>sphere of influence</w> is limited to the surrounding villages."
                            }
                        }
                    ],
                    "synonyms": [
                        "invloedssfeer",
                        "werkingsgebied"
                    ],
                    "common_phrases": [
                        "actieradius vergroten"
                    ],
                    "target_lang_definitions": {
                        "en": "The area or radius within which someone or something can exert influence or be active."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sphere of influence",
                                "target_lang_sense_clarification": "area of activity or control"
                            },
                            {
                                "target_lang_word": "range",
                                "target_lang_sense_clarification": "scope or reach of activity"
                            },
                            {
                                "target_lang_word": "radius of action",
                                "target_lang_sense_clarification": "area of operation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
