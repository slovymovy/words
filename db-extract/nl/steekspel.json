                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                        "entry_id": "4a641d33-07d7-3a8b-b63e-80a1ebf891cd",
                                        "glosses": [
                                            "Combat à cheval d'homme à homme avec la lance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1d05b6-be2d-4c16-8433-c82578e83d08",
                                                "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                                "text": "Une joute à lances brisées, à fer émoulu."
                                            },
                                            {
                                                "example_id": "0d595663-994b-4eb5-8dd8-c7adc5593307",
                                                "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                                "text": "Les joutes étaient des combats d'occasion qui se faisaient le plus souvent sans dresser des lices, en étendant des cordes qu'on nommait estachettes."
                                            },
                                            {
                                                "example_id": "f7eb15d9-2083-4854-bce0-c596b083c131",
                                                "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                                "text": "Il emporta le prix de la joute."
                                            },
                                            {
                                                "example_id": "813ebd67-8621-4119-8e9b-7be6c02c418a",
                                                "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                                "text": "Joute sur l’eau ou joute nautique, Espèce de divertissement dans lequel deux hommes, placés chacun sur l’avant ou sur une plate- forme élevée à l’arrière d’un batelet, tâchent de se faire tomber à l’eau, en se poussant l’un l’autre avec de longues perches au moment où les bateaux s’approchent."
                                            },
                                            {
                                                "example_id": "01d079f7-9b2f-4555-a5a1-5a01b8987e1d",
                                                "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                                "text": "'(Sens figuré),"
                                            },
                                            {
                                                "example_id": "e0722f03-3877-41ae-9c89-e94609591a3b",
                                                "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                                "text": "Une joute d’éloquence."
                                            },
                                            {
                                                "example_id": "2b7f974f-3997-4f16-9b25-e3bfd1cc2c5d",
                                                "sense_id": "74ee7020-b08a-3567-9899-54634adb53d4",
                                                "text": "Une joute de courtoisie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63c0eee-dc35-39ef-b905-2f48271dd7d6",
                                        "entry_id": "4a641d33-07d7-3a8b-b63e-80a1ebf891cd",
                                        "glosses": [
                                            "Toute espèce de combat entre deux personnes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1153dc0b-f2e2-4aad-a88c-698c0a91498d",
                                                "sense_id": "a63c0eee-dc35-39ef-b905-2f48271dd7d6",
                                                "text": "La joute d'Arlequin et de Scapin, qui se menacent avec grand bruit, se donnent quelques coups de bâton, et s'enfuient chacun de leur côté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed0d6dd2-5e7e-36b7-a781-c6e37839ab03",
                                        "entry_id": "4a641d33-07d7-3a8b-b63e-80a1ebf891cd",
                                        "glosses": [
                                            "Toute espèce de lutte ou de rivalité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf952e8-0214-4bf1-b1b1-f03ca86f3917",
                                                "sense_id": "ed0d6dd2-5e7e-36b7-a781-c6e37839ab03",
                                                "text": "D'autres fois Psyché se divertissait à entendre un défi de rossignols, ou à voir un combat naval de cygnes, des tournois et des joutes de poissons."
                                            },
                                            {
                                                "example_id": "185fe6d6-8451-49b3-806f-43813006930e",
                                                "sense_id": "ed0d6dd2-5e7e-36b7-a781-c6e37839ab03",
                                                "text": "Quand, la première fois, un athlète nouveau\nVient combattre en champ clos aux joutes du barreau."
                                            },
                                            {
                                                "example_id": "beb0d6ff-104f-47d5-9a3e-b14128b97e03",
                                                "sense_id": "ed0d6dd2-5e7e-36b7-a781-c6e37839ab03",
                                                "text": "Je crois vraiment que Madeleine et moi nous nous regardâmes avec colère tant cette joute extravagante mêlait d’excitations et de défis à d’autres sentiments intraduisibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c7555b2-eec9-33ae-a5ad-8ddcad72ea4e",
                                        "entry_id": "4a641d33-07d7-3a8b-b63e-80a1ebf891cd",
                                        "glosses": [
                                            "Se dit de certains animaux qu'on fait combattre les uns contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f945ef37-a566-44c2-a983-3014b476969a",
                                                "sense_id": "6c7555b2-eec9-33ae-a5ad-8ddcad72ea4e",
                                                "text": "La joute des coqs."
                                            },
                                            {
                                                "example_id": "cca7b125-b600-4966-a439-eb78a9fa72d0",
                                                "sense_id": "6c7555b2-eec9-33ae-a5ad-8ddcad72ea4e",
                                                "text": "La joute des cailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5216f165-52fc-3577-8e7d-8c166d8b0248",
                                        "entry_id": "4a641d33-07d7-3a8b-b63e-80a1ebf891cd",
                                        "glosses": [
                                            "Compétition de chant, de danse, de slam ou d’art oratoire arbitrée par un jury."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "joute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7623d4f0-ee05-3b7a-a705-0dfc90bd25be",
                                        "entry_id": "7ba84910-8bce-3ef1-9845-b7c1f663f97f",
                                        "glosses": [
                                            "Décharge électrique. Synonyme de châtaigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b41432d-2000-4c50-ba64-430720c87f49",
                                                "sense_id": "7623d4f0-ee05-3b7a-a705-0dfc90bd25be",
                                                "text": "On a tous reçu une décharge électrique par accident, à un moment ou un autre. Une fois, j'ai reçu une décharge de 22 000 volts à cause d'un téléviseur. J'ai fait un bond de deux mètres ! Les électroniciens ont l'habitude de ce genre d'incident. En général, ils craignent moins les joutes que la plupart des gens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2beaa70c-d533-3bf7-b773-702160be207f",
                                        "entry_id": "7ba84910-8bce-3ef1-9845-b7c1f663f97f",
                                        "glosses": [
                                            "Betterave, en particulier les betteraves fourragères. On dit jotte dans d'autres régions."
                                        ],
                                        "tags": [
                                            "Poitou"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5496d00b-5311-4620-aa3a-86538abf5e55",
                                                "sense_id": "2beaa70c-d533-3bf7-b773-702160be207f",
                                                "text": "Les animaux étaient surtout nourris avec du foin, du son (le bron), des betteraves (joutes) avec les balles de blé stockées après le battage, et étaient conduits au pâturage d'Avril à Novembre."
                                            },
                                            {
                                                "example_id": "9e162cec-9e0a-449a-a6f4-d6ceacc1598f",
                                                "sense_id": "2beaa70c-d533-3bf7-b773-702160be207f",
                                                "text": "Sitôt les vendanges terminées, il fallait se hâter de rentrer les betteraves fourragères, les joutes comme on disait en patois, ce précieux aliment, mais très gourmand de main-d’œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c42fdcfa-3f22-303b-ab8b-a93d6dbfcf8c",
                                        "entry_id": "7ba84910-8bce-3ef1-9845-b7c1f663f97f",
                                        "glosses": [
                                            "Nom donné à divers plante potagères dont on mange les feuilles, (chou, bette, poirée, carde...)."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4c2c57-27ec-4abb-9268-277d8b4961c6",
                                                "sense_id": "c42fdcfa-3f22-303b-ab8b-a93d6dbfcf8c",
                                                "text": "Joutes : côtes ou pétioles des blettes ou poirées."
                                            }
                                        ]
                                    }
