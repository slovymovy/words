                                "target_senses": [
                                    {
                                        "sense_id": "e2a88724-03aa-3691-bcf7-3e18e540b343",
                                        "entry_id": "dddae5cc-9446-3a8c-87b8-add9311741fb",
                                        "glosses": [
                                            "im Stoffwechselprozess entstanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef75a97-a46a-4537-8706-244e9cb178d3",
                                                "sense_id": "e2a88724-03aa-3691-bcf7-3e18e540b343",
                                                "text": "Dort, wie in Prokaryoten, vermittelt das Membranpotential die Konvertierung zwischen physikalischer Energie (z.B. Licht und elektrochemische Gradienten) und metabolischer Energie (typischerweise ATP), so bei Photosynthese und zellulärer Atmung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "318bded2-d5e7-30c7-8734-9d016b82f1b2",
                                        "entry_id": "dddae5cc-9446-3a8c-87b8-add9311741fb",
                                        "glosses": [
                                            "veränderlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "370b76de-d04c-4448-af5b-b1fa61c4020c",
                                                "sense_id": "318bded2-d5e7-30c7-8734-9d016b82f1b2",
                                                "text": "Bei ausreichender Wasserzufuhr können diese Zellen innerhalb weniger Minuten vom Zustand des „latenten Lebens“ wieder zum metabolisch aktiven Zutand zurückkehren (…)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
