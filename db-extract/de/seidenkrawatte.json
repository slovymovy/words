                "senses": [
                    {
                        "sense_id": "5dc931f7-fe01-3d31-b109-c040eac961b8",
                        "entry_id": "de0d8672-0445-33ce-b0f9-5cfa7b7f513e",
                        "glosses": [
                            "Krawatte, die aus Seide hergestellt worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c86e67b1-b20c-4582-8bd1-67797fb6cdc2",
                                "sense_id": "5dc931f7-fe01-3d31-b109-c040eac961b8",
                                "text": "„Wie zum Beweis kommen nun die Sargträger, die Brüder des Toten, sie haben sich goldgelbe Seidenkrawatten umgebunden und jeder einen Glitzerhandschuh an.“"
                            },
                            {
                                "example_id": "deded75b-582c-4592-9df8-6093e26325c6",
                                "sense_id": "5dc931f7-fe01-3d31-b109-c040eac961b8",
                                "text": "„Niemand käme auf die Idee, dass ausgerechnet von hier aus seit nunmehr hundert Jahren Europas Anzugträger mit edlen handgemachten Seidenkrawatten ausstaffiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
