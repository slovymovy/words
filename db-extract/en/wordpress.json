        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "042dde24-8f06-309e-883c-43fd63d4e8f5",
                "word": "WordPress",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "414b9708-a993-3783-b652-8898dc528cd1",
                        "entry_id": "042dde24-8f06-309e-883c-43fd63d4e8f5",
                        "glosses": [
                            "A content management system used to create websites of all kinds, especially blogs."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "787ee15d-3369-4614-a94f-8695b565649e",
                                "sense_id": "414b9708-a993-3783-b652-8898dc528cd1",
                                "text": "In mid-1999 the first free build-your-own-web log tools began appearing and suddenly there were a large variety of easy to use blogging software to choose from including remote web log systems like Blogger a turnkey service offered by Google or stand-alone open source applications such as WordPress."
                            },
                            {
                                "example_id": "cf7a8241-1d85-4e9c-bafb-7deb95ebf446",
                                "sense_id": "414b9708-a993-3783-b652-8898dc528cd1",
                                "text": "With the free Scripts Installer included in the Unlimited Hosting plan, customers can easily install a wide range of open source applications such as Wordpress,^([sic]) Joomla!, Drupal, PhpBB,^([sic]) Mambo, Php-Nuke,^([sic]) Zen Cart, Magento, just to name a few."
                            },
                            {
                                "example_id": "23701b12-dbb9-43ad-b3c2-3d6701491917",
                                "sense_id": "414b9708-a993-3783-b652-8898dc528cd1",
                                "text": "With the new version of Virtuozzo’s Application Platform for WordPress, any service provider can offer cost-effective, enterprise-grade WordPress hosting with automatic deployment and scaling of WordPress websites, databases, CDN, security and associated software stacks, that can be controlled easily by the business user."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e9803742-6700-3ff4-b294-f66e5bc376e9",
                "word": "WordPress",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d47f7ce5-d0a6-4837-97e0-65f3313fd147",
                        "entry_id": "e9803742-6700-3ff4-b294-f66e5bc376e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "WordPresses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0eccd419-1395-3f95-9382-4485e9b69323",
                        "entry_id": "e9803742-6700-3ff4-b294-f66e5bc376e9",
                        "glosses": [
                            "A WordPress website."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "423bc2c3-581b-4956-9d7b-21f5a921eaf8",
                                "sense_id": "0eccd419-1395-3f95-9382-4485e9b69323",
                                "text": "Wikipedia contributors are often prolific bloggers, wont to talk about their work on Wikipedia in LiveJournals and TypePads and WordPresses."
                            },
                            {
                                "example_id": "dc7bf69c-715b-4100-bfc5-c87aee965800",
                                "sense_id": "0eccd419-1395-3f95-9382-4485e9b69323",
                                "text": "According to Automattic, as of 2011, over 100,000 new WordPresses are created every day (http://en.wordpress.com/stats/)."
                            },
                            {
                                "example_id": "8d8b1e13-60fe-4793-8d19-4ff67c57c2dc",
                                "sense_id": "0eccd419-1395-3f95-9382-4485e9b69323",
                                "text": "Remember blogs? They were about before Tumblr turned up and turfed all but the most dedicated off their Wordpresses,^([sic]) and were more likely to be thematically concerned with Sarah Records or late 80s German centre backs than otherkins and sitcom reaction .gifs."
                            },
                            {
                                "example_id": "715b68c6-7db0-4731-96cf-a81569226a0b",
                                "sense_id": "0eccd419-1395-3f95-9382-4485e9b69323",
                                "text": "WordPress.com allows us to host WordPresses from all over the world and give people a really easy place to start."
                            },
                            {
                                "example_id": "497a20e5-2a92-4314-b75d-cea4cbd72170",
                                "sense_id": "0eccd419-1395-3f95-9382-4485e9b69323",
                                "text": "I mean, we met yesterday – how do I know he’s not some sociopathic stalker, or a blogger worming his way under my skin to get to the good dirt for his WordPress, or just a mean boy, a fuckboy, a softboy, a boy who’s going to ghost me after summer’s over."
                            }
                        ]
                    }
