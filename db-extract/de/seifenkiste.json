                "senses": [
                    {
                        "sense_id": "c8dc4173-54b6-3dea-9d46-691faff5ece1",
                        "entry_id": "8d9ff344-6772-3f59-a783-63bfbe52e4c7",
                        "glosses": [
                            "selbstgebasteltes, nicht motorisiertes Gefährt, mit dem man einen Hang hinunterfahren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714da4ab-3719-47fe-8d06-6c4d04f23d46",
                                "sense_id": "c8dc4173-54b6-3dea-9d46-691faff5ece1",
                                "text": "Als ich ein Kind war, habe ich mit meinem Vater zusammen eine Seifenkiste gebaut, die noch heute im Schuppen steht."
                            },
                            {
                                "example_id": "8ef077e3-dbc1-47fe-af64-4fa4a3adb3bf",
                                "sense_id": "c8dc4173-54b6-3dea-9d46-691faff5ece1",
                                "text": "„Volker wollte sich aus Wiebkes altem Kinderwagen eine Seifenkiste bauen, aber Mama sagte, der sei noch tadellos in Schuß und zu schade für solche Schnapsideen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
