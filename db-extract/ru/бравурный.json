                ],
                "senses": [
                    {
                        "sense_id": "329b8fea-d48e-3aba-b4c2-961f6f025c2d",
                        "entry_id": "feef4ba8-cff9-3a11-991e-878c9c1f9c31",
                        "glosses": [
                            "о музыке — шумный, оживлённый, выражающий бодрость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990f17a9-cd57-4139-a828-95a7a777edf1",
                                "sense_id": "329b8fea-d48e-3aba-b4c2-961f6f025c2d",
                                "text": "За стеной на пианино играли бравурный марш."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5505193-8fde-3cc7-a60e-cc3008a789d0",
                        "entry_id": "feef4ba8-cff9-3a11-991e-878c9c1f9c31",
                        "glosses": [
                            "муз. о музыкальном произведении — изобилующий техническими трудностями, требующий виртуозного исполнения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0365d51f-4f37-4101-825a-ac0bf78f32f5",
                                "sense_id": "c5505193-8fde-3cc7-a60e-cc3008a789d0",
                                "text": "Насыщенная партитура барочной оперы обрушилась на слушателя единым потоком бравурных пассажей, не задерживая внимание на деталях нюансировки."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dad6cc4-f411-3cb9-96b5-44a3aae1b43d",
                        "entry_id": "feef4ba8-cff9-3a11-991e-878c9c1f9c31",
                        "glosses": [
                            "перен. бодрый, шумный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4559e056-c2c6-432e-ad22-2fd244a7b84e",
                                "sense_id": "2dad6cc4-f411-3cb9-96b5-44a3aae1b43d",
                                "text": "В предложенной беседе ― никаких бравурных интонаций, никакой рекламной декларативности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81169e2d-f382-4977-b49e-bd385413530b",
                        "source_entry_id": "feef4ba8-cff9-3a11-991e-878c9c1f9c31",
                        "target_lang_word": "bravura",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bravura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "027676e4-35e3-3d12-b0b6-63809359b348",
                                        "entry_id": "ccedee61-4af2-3f7f-9705-b251fadcb8d8",
                                        "glosses": [
                                            "A highly technical or difficult piece, usually written for effect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab1343e0-472f-37d0-bcfe-e90f4841dfb4",
                                        "entry_id": "ccedee61-4af2-3f7f-9705-b251fadcb8d8",
                                        "glosses": [
                                            "A display of daring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d7d6927-dfab-4210-8a6d-c9f8c8a578f3",
                                                "sense_id": "ab1343e0-472f-37d0-bcfe-e90f4841dfb4",
                                                "text": "Yet just as, in opposition to the majority, I admired Fosse's Nightsongs and The Girl On The Sofa, so I found myself absorbed by this 70-minute play; and, whatever it may mean, there is no denying the production's visual bravura."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bravura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e5a28f7-b149-3be4-b655-a83d7da2c6a2",
                                        "entry_id": "e64e4b45-78ca-3600-953e-ea75cb45eb3c",
                                        "glosses": [
                                            "Highly showy; ostentatious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b7a391-7d9d-4ba1-8d6f-6d528ab17119",
                                                "sense_id": "4e5a28f7-b149-3be4-b655-a83d7da2c6a2",
                                                "text": "Look closely, and the minute interconnectedness of her novels is a bravura achievement."
                                            },
                                            {
                                                "example_id": "a4ccad63-ab24-4b90-8771-fdd3c4bc784b",
                                                "sense_id": "4e5a28f7-b149-3be4-b655-a83d7da2c6a2",
                                                "text": "But that won't stop the breakout star of the A&E reality series Dallas Three Ways from delivering one of his bravura, impromptu mini-lectures on the subject of Murphy's history of homophobic stand-up comedy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
