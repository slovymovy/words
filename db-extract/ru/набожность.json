                ],
                "senses": [
                    {
                        "sense_id": "4d467a5e-6864-372d-91c6-1420a10b2b8a",
                        "entry_id": "01c2456f-a736-3f07-85d7-070bbfd02d95",
                        "glosses": [
                            "глубокая вера в бога, со строгим соблюдением всех религиозных обрядов и предписаний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f82c710-f4b4-4c06-a981-d1e108429c89",
                                "sense_id": "4d467a5e-6864-372d-91c6-1420a10b2b8a",
                                "text": "Последние годы царствования Людовика XIV, ознаменованные строгой набожностию двора, важностию и приличием, не оставили никаких следов."
                            },
                            {
                                "example_id": "63f73c36-4612-4682-8b29-1b2b3476342a",
                                "sense_id": "4d467a5e-6864-372d-91c6-1420a10b2b8a",
                                "text": "Она охотно предавалась са́мому рискованному флирту во всех столицах и на всех курортах Европы, ⟨…⟩ но в то же время отличалась щедрой добротой и глубокой, искренней набожностью, которая заставила её даже принять тайно католичество."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f20478b3-6d46-44c0-b050-9ab27b55d86e",
                        "source_entry_id": "01c2456f-a736-3f07-85d7-070bbfd02d95",
                        "source_sense_id": "4d467a5e-6864-372d-91c6-1420a10b2b8a",
                        "target_lang_word": "devotion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "devotion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d30318a2-63b9-3c5f-83a0-73c9dbaf8272",
                                        "entry_id": "9a4dcf18-0204-3068-88ee-79648e325bdb",
                                        "glosses": [
                                            "The act or state of devoting or being devoted."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06080e45-4a29-4fc5-bc73-144d3e8a8879",
                                                "sense_id": "d30318a2-63b9-3c5f-83a0-73c9dbaf8272",
                                                "text": "deep devotion"
                                            },
                                            {
                                                "example_id": "14a4e22e-2ec1-45a2-bef9-589c1dcded1c",
                                                "sense_id": "d30318a2-63b9-3c5f-83a0-73c9dbaf8272",
                                                "text": "blind devotion"
                                            },
                                            {
                                                "example_id": "3322873d-96c3-4acb-afde-437ad3e6747f",
                                                "sense_id": "d30318a2-63b9-3c5f-83a0-73c9dbaf8272",
                                                "text": "show devotion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35818310-bf29-3d54-aea0-daad346bce5c",
                                        "entry_id": "9a4dcf18-0204-3068-88ee-79648e325bdb",
                                        "glosses": [
                                            "Feeling of strong or fervent affection; dedication."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd0a2e5-b039-4f34-b47e-4cd8648a828b",
                                                "sense_id": "35818310-bf29-3d54-aea0-daad346bce5c",
                                                "text": "Her devotion to her family was clear in everything she did."
                                            },
                                            {
                                                "example_id": "3a80875f-8367-40db-8795-2a71d927d6c3",
                                                "sense_id": "35818310-bf29-3d54-aea0-daad346bce5c",
                                                "text": "The teacher’s devotion to her students inspired many."
                                            },
                                            {
                                                "example_id": "b6a783a6-0ca9-4369-8bff-bdb8d06d4a36",
                                                "sense_id": "35818310-bf29-3d54-aea0-daad346bce5c",
                                                "text": "The book describes the knight’s devotion to his king."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac684711-4fa4-3fbd-9677-79e2b7cb5543",
                                        "entry_id": "9a4dcf18-0204-3068-88ee-79648e325bdb",
                                        "glosses": [
                                            "Religious veneration, zeal, or piety."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05b0ef72-13e2-46be-8d44-0d317120738a",
                                                "sense_id": "ac684711-4fa4-3fbd-9677-79e2b7cb5543",
                                                "text": "He showed great devotion to his religious practices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5d7f980-1785-392b-a06a-a5f150db29e5",
                                        "entry_id": "9a4dcf18-0204-3068-88ee-79648e325bdb",
                                        "glosses": [
                                            "A prayer (often found in the plural)."
                                        ],
