                "senses": [
                    {
                        "sense_id": "0e47ff21-299e-3054-8759-13d91e02a856",
                        "entry_id": "a54722de-4155-36b8-b5f4-7103c1ae8224",
                        "glosses": [
                            "Se contredire soi-même (verbe utilisé pour renforcer l’idée de se contredire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e316b3-c446-4aa9-aee7-5868c8e680db",
                                "sense_id": "0e47ff21-299e-3054-8759-13d91e02a856",
                                "text": "ça ne surprendra personne : mais dès que je suis seul, je suis obligé de m’énerver contre moi-même, de m’auto-contredire et de m’auto-provoquer, donc je frôle la schizo, et c’est une forme de tabou qui m’insupporte !"
                            },
                            {
                                "example_id": "ac1bf3ea-4c15-494c-8c01-70726cbb9180",
                                "sense_id": "0e47ff21-299e-3054-8759-13d91e02a856",
                                "text": "Sans contexte, il n'y a pas d'histoire, et sans histoire, pas de contexte. Ce qui revient à t'auto-contredire."
                            },
                            {
                                "example_id": "c5a6b40c-d657-4a76-bab5-ad446dabed90",
                                "sense_id": "0e47ff21-299e-3054-8759-13d91e02a856",
                                "text": "Parfaitement d'accord le mensonge finit top ou tard par saturer et s'auto-contredire."
                            }
                        ]
                    }
