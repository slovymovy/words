                "senses": [
                    {
                        "sense_id": "5ac6e48d-09f2-3e5a-9829-8cd5e65dc93b",
                        "entry_id": "1845df4b-c19c-3f98-b7ef-02372b4ea8fb",
                        "glosses": [
                            "związany z rodzajem, dotyczący rodzaju"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e582a5-11c2-48db-87a7-9f14bdd09e64",
                                "sense_id": "5ac6e48d-09f2-3e5a-9829-8cd5e65dc93b",
                                "text": "Przynależność rodzajowa tego kota jest więc niepewna"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c6766c78-034d-3ddc-8c95-cccb893bd7d1",
                        "entry_id": "1845df4b-c19c-3f98-b7ef-02372b4ea8fb",
                        "glosses": [
                            "związany z rodzajem literackim, dotyczący rodzaju literackiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d44e023c-5654-40e2-a4bc-058c56e2f022",
                                "sense_id": "c6766c78-034d-3ddc-8c95-cccb893bd7d1",
                                "text": "W dziele pojawił się synkretyzm rodzajowy, gdyż autor użył wierszowanej formy w przedstawieniu typowej dla epiki rozbudowanej fabuły."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "144da4d0-c56f-3b56-bb11-5e46f2320891",
                        "entry_id": "1845df4b-c19c-3f98-b7ef-02372b4ea8fb",
                        "glosses": [
                            "związany z rodzajem gramatycznym, dotyczący rodzaju gramatycznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b4f82f-7fdb-4afe-97a2-e4ffda92e698",
                                "sense_id": "144da4d0-c56f-3b56-bb11-5e46f2320891",
                                "text": "Użycie odpowiedniej końcówki rodzajowej świadczy o dbałości językowej."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "d48b4280-d22e-3714-bdfa-f606e136b7d3",
                        "entry_id": "1845df4b-c19c-3f98-b7ef-02372b4ea8fb",
                        "glosses": [
                            "dotyczący tematyki życia codziennego, związany z tematyką życia codziennego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfa0859-e0dc-4ed5-a2a6-aed27f30d1f9",
                                "sense_id": "d48b4280-d22e-3714-bdfa-f606e136b7d3",
                                "text": "Popularność zaczęły zdobywać pejzaże, sceny rodzajowe i martwe natury"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "364e8a96-f95c-4c9d-9296-aa82a1278a72",
                        "source_entry_id": "1845df4b-c19c-3f98-b7ef-02372b4ea8fb",
                        "source_sense_id": "5ac6e48d-09f2-3e5a-9829-8cd5e65dc93b",
                        "target_lang_word": "generic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34b428cc-ecab-3a6a-9601-ae9bf44f4398",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
                                            "Very broad; pertaining or appropriate to large classes or groups as opposed to specific instances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de2cf1f-fa43-4186-b972-4b999b35039d",
                                                "sense_id": "34b428cc-ecab-3a6a-9601-ae9bf44f4398",
                                                "text": "Capri pants can be a generic term for any cropped slim pants."
                                            },
                                            {
                                                "example_id": "e8f30641-c78e-42a2-92a4-aaaf6cab0c94",
                                                "sense_id": "34b428cc-ecab-3a6a-9601-ae9bf44f4398",
                                                "text": "[…] the essence is that such self-describing poets describe what is in them, but not peculiar to them, – what is generic, not what is special and individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "190a709d-f54c-3c43-b502-a8cdc1207e59",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
                                            "Lacking in precision, often in an evasive fashion; vague; imprecise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce6f8aee-bb9f-39b9-b170-2f9fece0a979",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
                                            "Not having a brand name; nonproprietary in design or contents; fungible with the rest of its class."
                                        ],
                                        "tags": [
                                            "of a product or drug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06fe31d-7a40-4f01-a4da-78acb086953b",
                                                "sense_id": "ce6f8aee-bb9f-39b9-b170-2f9fece0a979",
                                                "text": "The four-and-one-half-day trial was centered on acts that neither she nor prosecutors dispute: On July 13, 2012, she drove her Lexus S.U.V. erratically after swallowing Zolpidem, a generic form of the sleep medication Ambien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26117afc-96aa-3899-9855-810e7979653f",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
                                            "Pertaining to genera of life instead of particular species thereof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e620e1-0503-4948-bb64-9e8566e446ee",
                                                "sense_id": "26117afc-96aa-3899-9855-810e7979653f",
                                                "text": "Holonym: familial"
                                            },
                                            {
                                                "example_id": "112bc40f-d479-459e-b3d8-0a0e6534fe57",
                                                "sense_id": "26117afc-96aa-3899-9855-810e7979653f",
                                                "text": "Meronyms: infrasubspecific, infraspecific, subspecific, specific"
                                            },
                                            {
                                                "example_id": "5f781151-7f2d-449d-a8ce-d70c5d7f950e",
                                                "sense_id": "26117afc-96aa-3899-9855-810e7979653f",
                                                "text": "There are scores of generic names within the order Decapoda, which includes many sea creatures that are called shrimp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97c8723b-c011-3b80-b5cb-e796b00b60d7",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
                                            "Relating to gender."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3edc7b70-471d-3541-b7e8-55742d6f2334",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
                                            "Specifying neither masculine nor feminine; epicene; unisex."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c82533-5b69-405f-a269-14f80602e919",
                                                "sense_id": "3edc7b70-471d-3541-b7e8-55742d6f2334",
                                                "text": "Words like salesperson and firefighter are generic."
                                            },
                                            {
                                                "example_id": "1c6fffe3-fe6e-47b0-acc8-24d1afe6ad0c",
                                                "sense_id": "3edc7b70-471d-3541-b7e8-55742d6f2334",
                                                "text": "This included criticism of the generic use of man to include men and women."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3962c20c-fd4e-373d-80ed-61f7ca50d717",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
                                            "Written so as to operate on any data type, the type required being passed as a parameter."
                                        ],
                                        "tags": [
                                            "of procedures"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1472f17c-8f0a-3007-b2f0-0545593a7bec",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
