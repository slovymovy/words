        "fr-extract.jsonl": [
            {
                "entry_id": "6f89cf78-2ca4-36ea-90ac-def8441de44c",
                "word": "diamétralement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b580b56-d555-3fcc-a1e9-7f4d001ad986",
                        "entry_id": "6f89cf78-2ca4-36ea-90ac-def8441de44c",
                        "glosses": [
                            "D’une extrémité du diamètre à l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc34102-dd58-4f22-b343-63c1b07f4ea4",
                                "sense_id": "2b580b56-d555-3fcc-a1e9-7f4d001ad986",
                                "text": "Les deux pôles sont diamétralement opposés."
                            }
                        ]
                    },
                    {
                        "sense_id": "707620ac-4f50-379e-934b-0176a7d1c1e2",
                        "entry_id": "6f89cf78-2ca4-36ea-90ac-def8441de44c",
                        "glosses": [
                            "À l’opposé extrême."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0c5b35c8-5031-4146-baf9-5936eef1801e",
                                "sense_id": "707620ac-4f50-379e-934b-0176a7d1c1e2",
                                "text": "L'esprit du monde, bien différent de celui du chrétien, renferme quatre sortes d’esprits diamétralement opposés à la charité."
                            },
                            {
                                "example_id": "bd43a65e-61af-4bb0-9099-47107fe7271f",
                                "sense_id": "707620ac-4f50-379e-934b-0176a7d1c1e2",
                                "text": "Je crois voir toutes choses diamétralement opposées au bon esprit."
                            },
                            {
                                "example_id": "9d41973b-7dcf-4589-bcda-793e01b41ce8",
                                "sense_id": "707620ac-4f50-379e-934b-0176a7d1c1e2",
                                "text": "Il est impossible que ces philosophes, quoique diamétralement opposés, se trompent dans leurs calculs."
                            },
                            {
                                "example_id": "61127da3-f2e0-4ee0-8050-790420762764",
                                "sense_id": "707620ac-4f50-379e-934b-0176a7d1c1e2",
                                "text": "La vérité est diamétralement opposée au ton de la bonne compagnie."
                            },
                            {
                                "example_id": "b1719118-e639-463f-a223-8a7cd8e74240",
                                "sense_id": "707620ac-4f50-379e-934b-0176a7d1c1e2",
                                "text": "Tous deux, bien que leur vie se fût passée dans des conditions diamétralement opposées, possédaient une égale fraîcheur de sentiments, une égale naïveté de cœur."
                            },
                            {
                                "example_id": "2d75bd01-0358-474a-8746-431542f6db0c",
                                "sense_id": "707620ac-4f50-379e-934b-0176a7d1c1e2",
                                "text": "Dans les situations préoccupantes, ils réagissaient de manière diamétralement opposée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8813441-8d6e-4202-a514-ee02f817a975",
                        "source_entry_id": "6f89cf78-2ca4-36ea-90ac-def8441de44c",
                        "target_lang_word": "diametrically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diametrically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ccbbc2-91c3-39da-9c95-b379405dd555",
                                        "entry_id": "d7067d7c-f002-3848-a9b9-0d5330b06fe3",
                                        "glosses": [
                                            "Separated by a diameter, on exactly the opposite side."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07a1efb7-05a3-3485-b7ab-2ff60d1b8786",
                                        "entry_id": "d7067d7c-f002-3848-a9b9-0d5330b06fe3",
                                        "glosses": [
                                            "Absolutely (in opposition)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49242bd0-479c-459b-935e-29debd5ffa01",
                                                "sense_id": "07a1efb7-05a3-3485-b7ab-2ff60d1b8786",
                                                "text": "\"I do not see that we are at all called upon to pay so costly a compliment to society, as to assume a character diametrically opposed to our real one,—to utter sentiments we secretly disbelieve,—and to be as angry with our better nature for bursting from restraint, as at other times with our own inferior nature for refusing to submit to it."
                                            },
                                            {
                                                "example_id": "5228f49f-865c-4380-8fc6-c12fc416daed",
                                                "sense_id": "07a1efb7-05a3-3485-b7ab-2ff60d1b8786",
                                                "text": "The distinctness of London has led many to clamor for the capital to pursue its own policies, especially on immigration. The British prime minister, David Cameron, is a Conservative. So is the mayor of London, Boris Johnson. But they have diametrically opposed views on immigration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
