                                                "sense_id": "59665226-96e3-3042-bdf4-579113cc9a5c",
                                                "text": "Die elegische Kurzdichtung brachte mich zum Weinen."
                                            },
                                            {
                                                "example_id": "ab0a9ff9-0849-4c6a-b28a-e5543eb28fd0",
                                                "sense_id": "59665226-96e3-3042-bdf4-579113cc9a5c",
                                                "text": "Sie ist heute sehr elegisch gestimmt."
                                            },
                                            {
                                                "example_id": "dec1902d-4ad2-433a-ac27-d347ad82b550",
                                                "sense_id": "59665226-96e3-3042-bdf4-579113cc9a5c",
                                                "text": "Das Gedicht ist zwar elegisch, aber dann doch wieder fröhlich."
                                            }
