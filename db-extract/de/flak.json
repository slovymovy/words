                        "form": "die Flaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                        "entry_id": "3bf3cd8c-1e82-3747-b68a-5b523522da37",
                        "glosses": [
                            "zur Abwehr von Luftangriffen dienliche Waffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e472a935-3841-4053-8f97-ad502ec05ade",
                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                "text": "Wir hatten sehr schnell keine Flak mehr."
                            },
                            {
                                "example_id": "10248d14-f034-4b52-8522-c00ae18b4ea5",
                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                "text": "„Das sind die Geschosse der Flaks.“"
                            },
                            {
                                "example_id": "a3c3a6af-1f6d-4d1b-8b19-0024dfb41a03",
                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                "text": "„Nur die Flak meldete sich von ferne.“"
                            },
                            {
                                "example_id": "8cce8b5b-ac6d-4f7c-bd3e-1fe03ebc1b10",
                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                "text": "„Die Flak schoß auch nicht, die war bloß eine Attrappe.“"
                            },
                            {
                                "example_id": "7aa80064-2dfc-4d8f-bcc1-1f8a582f980d",
                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                "text": "„Dann donnerte die Flak los, daß die Fensterscheiben dröhnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "787d7498-65d3-4986-b01b-079c41911d9b",
                        "source_entry_id": "3bf3cd8c-1e82-3747-b68a-5b523522da37",
                        "source_sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                        "source_sense_description": "Zur Abwehr von Luftangriffen dienliche Waffe",
                        "target_lang_word": "flak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29dcc0be-d300-3898-8c9a-8eb92102657b",
                                        "entry_id": "ccb35792-dcc1-39fa-b497-55add2601e9a",
                                        "glosses": [
                                            "Ground-based anti-aircraft guns firing explosive shells."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a37b7be0-e3f6-4319-ad1a-9104e15d621c",
                                                "sense_id": "29dcc0be-d300-3898-8c9a-8eb92102657b",
                                                "text": "Another peculiar modern development is that of […] military abbreviations in army orders such as Flak ('Fliegerabwehrkanone' or 'archie')[.]"
                                            },
                                            {
                                                "example_id": "0c6e842e-1980-479e-bb36-d506e2d52352",
                                                "sense_id": "29dcc0be-d300-3898-8c9a-8eb92102657b",
                                                "text": "[…] to consider whether the city was in February 1945 an undefended city within the meaning of the 1907 Hague Convention, it will be necessary to examine the establishment and subsequent total dispersal of the city's flak batteries, before the date of the triple blow."
                                            },
                                            {
                                                "example_id": "c0acce1d-bcb1-47a9-9341-d0a4addef2b4",
                                                "sense_id": "29dcc0be-d300-3898-8c9a-8eb92102657b",
                                                "text": "He was promoted to general of flak artillery on March 1, 1945, and ended the war as the general of the flak arm at OKL, the High Command of the Luftwaffe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67d613b3-df18-3586-83c4-f8511a453b6c",
                                        "entry_id": "ccb35792-dcc1-39fa-b497-55add2601e9a",
                                        "glosses": [
                                            "Anti-aircraft shell fire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3abff8-b75f-44b0-9632-cbad169f8eec",
                                                "sense_id": "67d613b3-df18-3586-83c4-f8511a453b6c",
                                                "text": "At 1057 we were just over the islands and at 1100 the tail gunner reported flak at six o'clock, below."
                                            },
                                            {
                                                "example_id": "b7834c36-9ee9-4550-93ad-f974c9b755d2",
                                                "sense_id": "67d613b3-df18-3586-83c4-f8511a453b6c",
                                                "text": "Young Ratchford was first reported missing in action and later reported killed in action as of March 9. He was flight engineer on a B-24 Liberator bomber, and his plane was seen to go down in flames just after it had passed over Munster, where it had encountered heavy flak."
                                            },
                                            {
                                                "example_id": "40fe40b2-9ad1-4be1-9a9f-5ebb00fedbb8",
                                                "sense_id": "67d613b3-df18-3586-83c4-f8511a453b6c",
                                                "text": "1984, Steve Harris, \"Aces High\", Iron Maiden, Powerslave.\nThere goes the siren that warns of the air raid / Then comes the sound of the guns sending flak / Out for the scramble we've got to get airborne / Got to get up for the coming attack."
                                            },
                                            {
                                                "example_id": "f32c746e-6d2f-4132-9b49-1ffb07e0ca13",
                                                "sense_id": "67d613b3-df18-3586-83c4-f8511a453b6c",
                                                "text": "I could hear the fragments from the flak shells hitting the plane like someone throwing rocks at it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e45e9c-5c52-32b1-b1d6-6c141e969001",
                                        "entry_id": "ccb35792-dcc1-39fa-b497-55add2601e9a",
                                        "glosses": [
                                            "Adverse criticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5daf2ae7-db9a-4eda-b608-229f4bbeac43",
                                                "sense_id": "26e45e9c-5c52-32b1-b1d6-6c141e969001",
                                                "text": "There’s always been a built-in backlash against big-scale caprices like Raiders of the Lost Ark from people who think that $20 million should be spent on more than entertainment for its own sake. Raiders may also get flak for not being as cuddly-lovable as Star Wars, or for using those old reliables – the Nazis – as villains, or for dazzling the audience with an almost brazen self-confidence."
                                            },
                                            {
                                                "example_id": "a3d4cc21-3ff9-4b9f-892a-f8e22f0c62b7",
                                                "sense_id": "26e45e9c-5c52-32b1-b1d6-6c141e969001",
                                                "text": "This filter Herman and Chomsky call “flak,” which refers to letters, speeches, phone calls, and other forms of group and individual complaints. Advertisers and broadcasters avoid programming content that might cause large volumes of flak."
                                            },
                                            {
                                                "example_id": "dfb1a71d-0ecc-483f-86a4-c30972b1916d",
                                                "sense_id": "26e45e9c-5c52-32b1-b1d6-6c141e969001",
                                                "text": "Alex McLeish, perhaps mindful of the flak he has been taking from sections of the Villa support for a perceived negative style of play, handed starts to wingers Charles N'Zogbia and Albrighton."
                                            },
                                            {
                                                "example_id": "d352e46c-25d4-46d3-88d3-014333af1b8a",
                                                "sense_id": "26e45e9c-5c52-32b1-b1d6-6c141e969001",
                                                "text": "More flak was aimed at the Treasury's apparent lack of marketing skills, when it was argued that its idea of how to sell tickets was along the lines of \"you can get two tickets for the price of two\", and it lacks the sales and promotional skills of the train operating companies which are needed to boost revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63dba74-94b2-3c38-b858-6c8bc4b15c4b",
                                        "entry_id": "ccb35792-dcc1-39fa-b497-55add2601e9a",
                                        "glosses": [
                                            "A public-relations spokesperson."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c898fd3c-2043-4c1d-9ac6-49edd7e44ed8",
                                                "sense_id": "a63dba74-94b2-3c38-b858-6c8bc4b15c4b",
                                                "text": "2006, Edward Herman, Noam Chomsky, A Propaganda Model, in 2006 [2001], Meenakshi Gigi Durham, Douglas Kellner (editors), Media and Cultural Studies: Keyworks, revised edition, page 277,\nAIM head, Reed Irvine's diatribes are frequently published, and right-wing network flaks who regularly assail the “liberal media,” such as Michael Ledeen, are given Op-ed column space, sympathetic reviews, and a regular place on talk shows as experts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c071d6df-836a-4532-9715-55ac7c0b08ba",
                        "source_entry_id": "3bf3cd8c-1e82-3747-b68a-5b523522da37",
                        "source_sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                        "source_sense_description": "Zur Abwehr von Luftangriffen dienliche Waffe",
                        "target_lang_word": "canon antiaérien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c8db054a-280f-4f10-b40c-4d07ee8d1aa3",
                        "source_entry_id": "3bf3cd8c-1e82-3747-b68a-5b523522da37",
                        "source_sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                        "source_sense_description": "Zur Abwehr von Luftangriffen dienliche Waffe",
                        "target_lang_word": "luchtafweergeschut",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luchtafweergeschut",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2f4bbf77-c54f-3ad5-8682-70015dd0215e",
                                        "entry_id": "c10593f6-9858-3788-8dbc-762d34753c79",
                                        "glosses": [
                                            "een onderdeel van de luchtverdediging en kan bestaan uit grootkaliber-machinegeweren tot snelvuurkanonnen bestemd voor het bestoken van vliegtuigen en andere luchtdoelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ae31aa-8402-4531-81ad-f9155e897d8f",
                                                "sense_id": "2f4bbf77-c54f-3ad5-8682-70015dd0215e",
                                                "text": "Meer dan 10.000 oorlogswapens, luchtafweergeschut, granaatwerpers, revolvers. Dat is de buit van een internationale politieactie tegen georganiseerde wapenhandel in Europa. De bende verkocht ook in ons land wapens."
                                            },
                                            {
                                                "example_id": "11fefe0e-e8b6-45b4-a862-be7dcce51a19",
                                                "sense_id": "2f4bbf77-c54f-3ad5-8682-70015dd0215e",
                                                "text": "De tank-biatlon is het populairste onderdeel van de Army Games. Verder zijn er luchtbombardementen, luchtafweergeschut, een sluipschutterwedstrijd en competitie voor de beste veldkeuken."
                                            },
                                            {
