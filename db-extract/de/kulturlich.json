                ],
                "senses": [
                    {
                        "sense_id": "936009b3-1dae-3458-baea-d674dcd905a1",
                        "entry_id": "7b81457d-153b-3d4f-8502-488b692127e1",
                        "glosses": [
                            "eine Kultur (Entwicklungsstufe menschlichen Zusammenlebens) betreffend, gemäß einer Kultur"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7b248eae-97cf-4334-8178-88ea1b27bdb0",
                                "sense_id": "936009b3-1dae-3458-baea-d674dcd905a1",
                                "text": "„Auf neuem Boden arbeiten Völker kulturlich wie politisch unter viel günstigeren Bedingungen als auf altem.“"
                            },
                            {
                                "example_id": "6b682ad8-e4a3-465e-ab3a-1344000dec98",
                                "sense_id": "936009b3-1dae-3458-baea-d674dcd905a1",
                                "text": "„Es liegt auf der Hand, daß ein Volk ohne jede örtliche Zusammenfassung der auf Zusammenarbeit angewiesenen menschlichen Kräfte unter kulturlichem Gesichtspunkte rückständig bleiben muß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
