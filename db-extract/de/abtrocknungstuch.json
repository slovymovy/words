                "senses": [
                    {
                        "sense_id": "81e50cc5-01ab-32c4-87d7-4df2888d370b",
                        "entry_id": "5e805046-d285-313f-89d8-1d4c80166543",
                        "glosses": [
                            "Tuch zum Abtrocknen von gespültem sauberen Geschirr"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7c19e9-7af4-417e-a0e9-b8552af5d73c",
                                "sense_id": "81e50cc5-01ab-32c4-87d7-4df2888d370b",
                                "text": "„Transportieren Sie folgende Sachen getrennt vom allgemeinen Zügelgut: Werkzeuge für die Montage von Möbeln und Beleuchtungen, Verlängerungskabel, Klebeband, Notfall-Apotheke, Adressbüchlein, Schreibzeug, Taschenlampe, Glühbirnen, Toilettenartikel wie WC-Papier, Abfallsäcke, Seife, Abtrocknungstücher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
