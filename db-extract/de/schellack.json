                        "examples": [
                            {
                                "example_id": "a8fda626-3ae0-4e65-bd6b-0077445d2989",
                                "sense_id": "920b56ed-919b-373d-a4ba-5d56d26cf7e0",
                                "text": "Zum Restaurieren von alten Möbeln wird Schellack verwendet."
                            },
                            {
                                "example_id": "45191230-0602-43fe-ae65-64984a37e3e2",
                                "sense_id": "920b56ed-919b-373d-a4ba-5d56d26cf7e0",
                                "text": "Schellack ist ein Naturrohstoff und deshalb biologisch abbaubar."
                            },
                            {
                                "example_id": "a8b1924f-5908-4a9b-924c-6cebc340380a",
                                "sense_id": "920b56ed-919b-373d-a4ba-5d56d26cf7e0",
                                "text": "Aus Schellack wurden die ersten Schallplatten hergestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
