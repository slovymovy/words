                    {
                        "sense_id": "23f38c7f-ebda-3d9e-8e2d-5e571750a1dd",
                        "entry_id": "2f93cbf3-c74c-3fe6-a7e0-614e6a2b81ef",
                        "glosses": [
                            "Personne ou chose qui réveille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5d5398-4180-46d4-b266-adbfd3fb92ec",
                                "sense_id": "23f38c7f-ebda-3d9e-8e2d-5e571750a1dd",
                                "text": "Source vitale d'où jaillit toutes les eaux porteuses d'espoir, annonciatrices de festins, réveilleuses d'appétit."
                            },
                            {
                                "example_id": "5c5db7a0-1425-474b-aaf3-479673a69f8f",
                                "sense_id": "23f38c7f-ebda-3d9e-8e2d-5e571750a1dd",
                                "text": "Cet artiste engagé est un réveilleur de nos consciences endormies."
                            },
                            {
                                "example_id": "360b0ba6-038f-45d1-acf0-a53dede4bb35",
                                "sense_id": "23f38c7f-ebda-3d9e-8e2d-5e571750a1dd",
                                "text": "Cependant, tout serait éternellement beau si ce petit pouvoir du réel ne nous imposait pas son sel corrosif comme un réveilleur de rêve !"
                            }
                        ]
                    }
                ],
