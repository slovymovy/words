        "nl-extract.jsonl": [
            {
                "entry_id": "a7c4655b-c3f4-3b14-9e79-bab5b24c20c0",
                "word": "calamiteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "44cfce78-9583-4fc7-a6da-76aac8edfc76",
