                    {
                        "sense_id": "13b83a0d-ed38-3e98-a6f1-836e192c9871",
                        "entry_id": "ea36a668-aca4-3a58-a905-e40d5b820766",
                        "glosses": [
                            "An officer of the ancient Roman army, in command of a century of soldiers."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2b036916-182d-4dfb-ab70-491a53fd09d8",
                                "sense_id": "13b83a0d-ed38-3e98-a6f1-836e192c9871",
                                "text": "“Man,” said the largest, most protective of the Praetorian guard, her lover, no doubt, and her peroxide-blond centurion, “for an apostle of peace you sure are filled up with war.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "445a79e6-4eda-3b1f-b940-d3262168f1a3",
                        "entry_id": "ea36a668-aca4-3a58-a905-e40d5b820766",
                        "glosses": [
                            "A player who scores a century."
