                                        "entry_id": "83f56372-27b5-3d7c-8b74-94bb72c9df3b",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de gosser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c8d270-4766-4dff-a20d-905c2fe0e72d",
                                                "sense_id": "5f006bca-a2eb-3312-bef0-50aa3a7cd862",
                                                "text": "Pour refermer ta valise, gosse dans le loquet, il doit être jammé, une fois déjammé, tu vas pouvoir la refermer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "456af2f7-1ec4-4b5f-8029-dfd2f6810c6d",
                        "source_entry_id": "87b96f7f-84ea-318e-8b77-c7d4ee295d85",
                        "source_sense_id": "bdfe0603-f881-3c53-b885-d86025d87661",
                        "target_lang_word": "fiston",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiston",
