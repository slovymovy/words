                "senses": [
                    {
                        "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                        "entry_id": "f3c71e1f-9e0b-3c90-9725-7d01187acbdb",
                        "glosses": [
                            "scherp afgegrensde, bloemkoolachtige wolken van het geslacht Cumulus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b57ffe7-ecb7-4290-a36d-2bdf74e755a2",
                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                "text": "Forse stapelwolken joegen in een wedloop met de trein door de hoge, diepblauwe lucht, van station tot station Barendrecht, Zwijndrecht, Dordrecht, Zwaluwe, Langeweg, Breda. Hij bleef in zijn gedachten opgesloten zitten, getroost door de nabijheid van zijn zoon, totdat de trein bij de grens aankwam en opnieuw stilhield."
                            },
                            {
                                "example_id": "5d1b47de-679c-430b-abdd-5c95bf94216a",
                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                "text": "Het was een mooie dag. Een paar stapelwolken. Op de telefoondraden langs de weg zaten de eerste zwaluwen. In Saint Léonard liepen zelfs al toeristen rond. Opvallend veel stelletjes die meer oog schenen te hebben voor elkaar dan voor de historische gevels."
                            },
                            {
                                "example_id": "4f942090-981d-47b3-a9c5-78b80494adad",
                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                "text": "VANDAAG wordt het vrij zonnig met stapelwolken, maar op de meeste plaatsen blijft het droog."
                            },
                            {
                                "example_id": "a608dcdb-74f1-4208-8f76-373242d11395",
                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                "text": "Nadat de mist is opgelost is het zowel vandaag als morgen prima nazomerweer. Vandaag loopt het kwik op naar 17 tot 19 graden, morgen wordt het met 17 tot 21 graden iets warmer. De zon schijnt in sommige regio's flink, elders zijn er enkele stapelwolken. Het blijft vrijwel droog, alleen het noordoosten blijft gevoelig voor een enkele bui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7970e97-69c1-42d9-9d74-8b44588eddd2",
                        "source_entry_id": "f3c71e1f-9e0b-3c90-9725-7d01187acbdb",
                        "source_sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
