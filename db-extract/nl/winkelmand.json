                    {
                        "sense_id": "678763e3-6d8e-36c4-a922-24871ee40120",
                        "entry_id": "a376727e-b179-3f87-9463-91b8c820c5ff",
                        "glosses": [
                            "een mand waarin de klanten van een supermarkt enkele lichte artikelen kunnen dragen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692fda11-79d7-40c8-9110-f9e46a5277ad",
                                "sense_id": "678763e3-6d8e-36c4-a922-24871ee40120",
                                "text": "Voor die paar pakjes heb ik geen wagentje nodig, die kunnen wel in een winkelmand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "320483b3-c9a6-419d-b2a6-a4bf48f3b70e",
                        "source_entry_id": "a376727e-b179-3f87-9463-91b8c820c5ff",
                        "source_sense_id": "678763e3-6d8e-36c4-a922-24871ee40120",
                        "source_sense_description": "een mand waarin de klanten van een supermarkt enkele lichte artikelen kunnen dragen",
                        "target_lang_word": "Warenkorb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warenkorb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72ec9228-0550-3968-a4cb-275a6cf64c21",
                                        "entry_id": "2d5d5387-1eaa-3d65-8aac-0da83771ce57",
                                        "glosses": [
                                            "repräsentative Auswahl von privat häufig nachgefragten Waren und Dienstleistungen aus verschiedenen Lebensbereichen, die beim periodischen Preisvergleich zur Berechnung der Inflation, zur Berechnung des Preisindexes dienen"
                                        ],
                                        "tags": [
                                            "Volkswirtschaftslehre",
                                            "Statistik",
                                            "Marketing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48677d1d-94b3-472a-9465-2288c0be3be3",
                                                "sense_id": "72ec9228-0550-3968-a4cb-275a6cf64c21",
                                                "text": "„Der studentische Konsum ist kaum erforscht, einen Anhaltspunkt liefert der Verbraucherpreisindex, den das Statistische Bundesamt mit Hilfe des Warenkorbes ermittelt: Rund 750 Produkte werden hier über einen längeren Zeitraum verglichen. Der Wert dieses Warenkorbs stieg von 1991 bis 2006 um rund 30 Prozent.“"
                                            },
                                            {
                                                "example_id": "32cbb719-0f83-4a54-995e-4f5252b37bd2",
                                                "sense_id": "72ec9228-0550-3968-a4cb-275a6cf64c21",
                                                "text": "„Vor allem die Preissteigerungen bei Dienstleistungen, die immerhin 40 Prozent im Warenkorb ausmachen, sind noch die große Unbekannte.“"
                                            },
                                            {
                                                "example_id": "50924dc5-a2bc-4a17-8ae5-baeb23e324d0",
                                                "sense_id": "72ec9228-0550-3968-a4cb-275a6cf64c21",
                                                "text": "„Da aber dieser Tarif Teil des Warenkorbes ist, mit dem die Inflationsrate berechnet wird, drückt dies die amtliche Teuerung um ein Zehntel Punkt.“"
                                            },
                                            {
                                                "example_id": "4aaefbff-a471-4577-9164-cc16a4c51253",
                                                "sense_id": "72ec9228-0550-3968-a4cb-275a6cf64c21",
                                                "text": "„Besonders stark verteuerte sich erneut der für Pensionisten relevante Warenkorb: Der Preisindex für Pensionistenhaushalte (PIPH) erhöhte sich im November auf 3,5 Prozent, nach 3,1 Prozent Jahresrate im Monat davor.“"
                                            },
                                            {
                                                "example_id": "cb5f248b-11f6-4507-96ee-37dcc46627b0",
                                                "sense_id": "72ec9228-0550-3968-a4cb-275a6cf64c21",
                                                "text": "„Pensionisten haben in der Tat alters- und krankheitsbedingte Sonderbedürfnisse, deren Kosten bei einer gerechten Pensionserhöhung durch stärkere Gewichtung in dem der Indexberechnung zugrundeliegenden Warenkorb zu berücksichtigen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d488d434-8d49-3243-8643-5cd1fd74ea74",
                                        "entry_id": "2d5d5387-1eaa-3d65-8aac-0da83771ce57",
                                        "glosses": [
                                            "Softwarefunktion für einen virtuellen Einkaufskorb im Internetgeschäft, Internetshopping, Online-Shopping, in dem die vom Kaufinteressenten ausgesuchten Produkte und Dienstleistungen für die nachfolgende Bestellung vorgemerkt werden können"
                                        ],
                                        "tags": [
                                            "E-Commerce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "903a7dd4-26b1-47d8-b0f6-28c7d501d56f",
                                                "sense_id": "d488d434-8d49-3243-8643-5cd1fd74ea74",
                                                "text": "„Von der Aufmachung her ist der Webshop simpel, und daher übersichtlich – eine Art Minimalvariante von Amazon, inklusive Online-Warenkorb und Kurzbeschreibung der Produkte, aber ohne viel unnötigen Schnickschnack.“"
                                            },
                                            {
                                                "example_id": "f5a4f88b-c4df-42cf-a357-a551124cd13d",
                                                "sense_id": "d488d434-8d49-3243-8643-5cd1fd74ea74",
                                                "text": "„Vor der Kasse drehen im Internet immer noch die meisten ab. Der Warenkorb ist gut gefüllt, genügend Cash ist auch vorhanden, aber dann kommen die Zweifel: Warum will der Händler auf einmal so viele Dinge von mir wissen? Und was genau passiert mit meinem Geld?“"
                                            },
                                            {
                                                "example_id": "b91572b6-c2c7-4293-9578-e2b11f471dc7",
                                                "sense_id": "d488d434-8d49-3243-8643-5cd1fd74ea74",
                                                "text": "„Nachdem man das Ticket in den Warenkorb gelegt und per Kreditkarte bezahlt hat, erhält man Sekunden später ein E-Mail, in dem sich ein Link befindet, über den man sich den Fahrschein ausdrucken kann. Klingt ein bisschen umständlich, geht aber relativ zügig.“"
                                            },
                                            {
                                                "example_id": "89303c67-c44b-4027-9eb5-77f374331d2d",
                                                "sense_id": "d488d434-8d49-3243-8643-5cd1fd74ea74",
                                                "text": "„Der virtuelle Warenkorb bleibt meistens leer: Der als Wachstumsmarkt gepriesene Lebensmittelverkauf über das Internet ist für viele deutsche Handelskonzerne endgültig gescheitert.“"
                                            },
                                            {
                                                "example_id": "52a01856-0a16-48fa-9059-9ebdf70c823f",
                                                "sense_id": "d488d434-8d49-3243-8643-5cd1fd74ea74",
                                                "text": "„Eine besondere Qualität sehe ich im E-Commerce. Hier ist die Interaktivität des Mediums ein unschlagbarer Verkaufsturbo: Produkte gelangen vom interaktiven Web-Flugblatt direkt in den Warenkorb, die Adressdaten des Kunden wandern in eine CRM-Datenbank und so beginnt ein Kreislauf, der Kaufzyklen verkürzt, Angebote personalisiert und Umsätze maximiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c9341536-be70-3410-89c0-53942af42cf8",
                                        "entry_id": "2d5d5387-1eaa-3d65-8aac-0da83771ce57",
                                        "glosses": [
                                            "kurz für: Einkaufskorb, Einkaufswagen, Transportkorb im Handel, zum Transport und zur Lagerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2706db-228e-4aa9-be3e-02d070145de3",
                                                "sense_id": "c9341536-be70-3410-89c0-53942af42cf8",
                                                "text": "„Die Bäuerin mit Warenkorb lugt neugierig um die Ecke.“"
                                            },
                                            {
                                                "example_id": "b803a55f-aaac-43bd-966e-d5eeacf008bd",
                                                "sense_id": "c9341536-be70-3410-89c0-53942af42cf8",
                                                "text": "„Wer seinen Einkauf von zu Hause erledigen möchte, kann dies per Telefon beim Markt veranlassen, und dem Kunden wird der Warenkorb ins Haus geliefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
