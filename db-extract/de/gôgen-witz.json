                "senses": [
                    {
                        "sense_id": "3d1cbe6d-388f-3b00-9f69-16dc2cc2b1ea",
                        "entry_id": "748714cc-eb03-3a1b-b325-9ead1addd685",
                        "glosses": [
                            "Witz, in dem ein Gôg (oder: Gôgen) als Protagonist vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf14d8f7-f634-4ed6-8967-0646be6b841b",
                                "sense_id": "3d1cbe6d-388f-3b00-9f69-16dc2cc2b1ea",
                                "text": "„Um Aussprachefehlern vorzubeugen, gab uns Heinz-Eugen Schramm den folgenden Gôgen-Witz mit auf den Weg:...“"
                            },
                            {
                                "example_id": "f5e75202-3504-4665-bf5c-3b90ba0c493e",
                                "sense_id": "3d1cbe6d-388f-3b00-9f69-16dc2cc2b1ea",
                                "text": "„Soziologisch gesehen leben die Gôgen-Witze vom Gegensatz der autochthonen Tübinger Weingärtnerbevölkerung, eben den ›Gôgen‹ (oder ›Raupen‹) und den meist von auswärts, insbesondere aus Norddeutschland kommenden Professoren und deren Gattinnen sowie den Studenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
