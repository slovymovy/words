        "fr-extract.jsonl": [
            {
                "entry_id": "a8b2ddcf-0a54-352f-bbc3-a0cf596bd69d",
                "word": "eurocentrisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "34a3e8ef-d4e4-4b04-9a0d-50ab7798de3d",
                        "entry_id": "a8b2ddcf-0a54-352f-bbc3-a0cf596bd69d",
                        "tags": [
                            "plural"
                        ],
                        "form": "eurocentrismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                        "entry_id": "a8b2ddcf-0a54-352f-bbc3-a0cf596bd69d",
                        "glosses": [
                            "Conception ou système de pensée — implicite ou explicite — qui place l’Europe au centre de l’histoire, du savoir ou des normes, en considérant ses normes comme universelles."
                        ],
                        "tags": [
                            "Études postcoloniales",
                            "Sciences humaines et sociales"
                        ],
                        "examples": [
                            {
                                "example_id": "e5aa5793-032d-48ab-8aa2-749a06eb3b36",
                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                "text": "L’eurocentrisme valide le colonialisme et légitime l’orientalisme."
                            },
                            {
                                "example_id": "d29ab509-d4a2-4244-ae17-efdcafbbfd00",
                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                "text": "L’eurocentrisme ne permet pas une interprétation idéaliste, mais seulement une interprétation matérialiste."
                            },
                            {
                                "example_id": "af221e18-9e1d-4fdb-a544-0bfb7005fcf8",
                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                "text": "La domination même de l’eurocentrisme dans le curriculum des sciences sociales constitue un obstacle majeur à la décolonisation de la connaissance."
                            },
                            {
                                "example_id": "1d03e331-3948-44f5-953c-7f68b64b7412",
                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                "text": "Le modèle centre‑périphérie illustre comment l’eurocentrisme structure la production et la diffusion des connaissances en sciences sociales, en segmentant le Nord global comme source légitime de savoir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dc296c3-2e90-476e-9dca-3be29690d5f2",
                        "source_entry_id": "a8b2ddcf-0a54-352f-bbc3-a0cf596bd69d",
                        "source_sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                        "target_lang_word": "Eurozentrismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eurozentrismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7146cd82-4400-3f56-a6e0-ab8fbcf01f7f",
                                        "entry_id": "2ea1a90f-4a0d-3572-9570-b80358d9e0a7",
                                        "glosses": [
                                            "„Betrachtung und Einschätzung inner- und außereuropäischer Gesellschaften aus herkömmlicher europäischer Perspektive und gemäß den von Europäern entwickelten Werten und Normen“"
                                        ],
                                        "tags": [
                                            "Ideologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc2c543-8e14-4112-89a8-a0154857c3b2",
                                                "sense_id": "7146cd82-4400-3f56-a6e0-ab8fbcf01f7f",
                                                "text": "„Doch umfasst der Begriff Eurozentrismus nicht nur das geografische Europa, sondern alle „neoeuropäischen“ industrialisierten Staaten der sogenannten westlichen Welt in Nordamerika, Südafrika und Australien.“"
                                            },
                                            {
                                                "example_id": "13586ec6-2ede-4c0f-89c8-688de14ae704",
                                                "sense_id": "7146cd82-4400-3f56-a6e0-ab8fbcf01f7f",
                                                "text": "„Hinter der viel diskutierten Globalisierung verbirgt sich auch ein Eurozentrismus, der mit problematischer Selbstverständlichkeit bestimmte Wertvorstellungen auf außereuropäische Kulturen überträgt, mit denen sie nicht immer kompatibel sind.“"
                                            },
                                            {
                                                "example_id": "b3dd3eae-dc3e-4036-a387-3c4626aa5ad8",
                                                "sense_id": "7146cd82-4400-3f56-a6e0-ab8fbcf01f7f",
                                                "text": "„Kolja Lindner differenziert am Beispiel von Karl Marx vier Dimensionen des Eurozentrismus: einen Ethnozentrismus, der die Überlegenheit westlicher Gesellschaften behauptet (s. u.); einen „orientalistischen“ Blick auf nicht-westliche Weltgegenden (anschließend an Edward Said); ein Entwicklungsdenken, das europäische Geschichte als Vorbild für weltweite Entwicklungen universalisiert; und eine Unterschlagung nicht-westlicher Geschichte bzw. ihres Einflusses auf die Entwicklung Europas (anschließend an Ansätze aus der Globalgeschichte)“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cff6405-d9c7-451f-a0ad-277414e60b05",
                        "source_entry_id": "a8b2ddcf-0a54-352f-bbc3-a0cf596bd69d",
                        "source_sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
