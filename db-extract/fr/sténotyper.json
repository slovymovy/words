                        "examples": [
                            {
                                "example_id": "60974122-6b9b-4137-900b-8d384dc93c5e",
                                "sense_id": "69e42f53-4e9c-30cb-9fc4-c7825fa41710",
                                "text": "Presque aussitôt une princesse russe entra, fatale et ondulante, munie d'un derrière insistant et d'une petite machine à sténotyper."
                            },
                            {
                                "example_id": "52c35fc5-1223-4c50-9f09-002f8109eb35",
                                "sense_id": "69e42f53-4e9c-30cb-9fc4-c7825fa41710",
                                "text": "(...) ils ne nous permettront pas d'insérer nos conférences avec la discussion complète, que nous faisons parfois sténotyper, la totalité des causeries radiodiffusées, les entretiens dont je parlerai dans un instant, etc."
                            }
                        ]
