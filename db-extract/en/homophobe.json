        "zh-extract.jsonl": [
            {
                "entry_id": "4b2eabee-da63-3f1d-8403-75f13e9a7fd7",
                "word": "homophobe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9689379b-7253-4bc5-af09-016a57622d33",
                        "entry_id": "4b2eabee-da63-3f1d-8403-75f13e9a7fd7",
                        "tags": [
