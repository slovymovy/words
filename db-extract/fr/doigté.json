                                "target_word": "Fingerspitzengefühl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                        "entry_id": "fe72240c-9250-30eb-94e5-17f3ecded2b6",
                                        "glosses": [
                                            "feines Gespür dafür, wie man sich jemandem gegenüber verhalten oder ausdrücken sollte, sodass dieser nicht verletzt/vor den Kopf gestoßen/brüskiert wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7553226e-d7f2-42da-9ed5-d638515d708d",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "Gespräche mit Gewaltopfern verlangen Fingerspitzengefühl."
                                            },
                                            {
                                                "example_id": "5657068d-7bab-4f5f-9de7-cb9ef32273b5",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "Bei einem Konflikt mit einem Mitarbeiter muss der Vorgesetzte Fingerspitzengefühl beweisen."
                                            },
                                            {
                                                "example_id": "7b4ebf4c-fd96-42e5-8d2a-6c7f5fa1bfc6",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "„Mit deinem neuen Parfum riechst du einfach schlecht!“ „Du zeigst ja wieder echtes Fingerspitzengefühl.“"
                                            },
                                            {
                                                "example_id": "404ea7bd-40f6-422c-b961-6f7b5a1d014d",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "„Das verlangt viel Fingerspitzengefühl und auch etwas Erfahrung.“"
                                            },
                                            {
                                                "example_id": "f7b8cc8e-f5ec-4d3b-89d5-ca2000e9f992",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "„Requiem, der gutes Fingerspitzengefühl bewies, prüfte den Stoff und gab Instruktionen.“"
                                            },
                                            {
                                                "example_id": "a23ce4d4-4a6a-4ef4-aeeb-3960d18bc83d",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "„Er [der Diplomat Felix Klein] wird sich mit großem Nachdruck und Fingerspitzengefühl für jüdisches Leben in Deutschland engagieren […].“"
                                            },
                                            {
                                                "example_id": "e12250a7-20a8-4ce4-8ea5-19b1660c4df8",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "Bildhaftigkeit, Klarheit und Präzision sind für Katharina die Hauptmerkmale der deutschen Sprache. Mit viel Fingerspitzengefühl vermittelt die gebürtige Deutsche ihren Schülern nicht nur die schwierige Grammatik."
                                            },
                                            {
                                                "example_id": "cfa118f4-8435-4c0f-820e-09676b9fa95b",
                                                "sense_id": "fe6d35ce-6660-3aa8-b133-2e1c10b0ab7a",
                                                "text": "Fingerspitzengefühl zählt sicher nicht zu den Stärken saarländischer Sportfunktionäre rund um den Landessportverband. Und durch Sensibilität zeichnet sich auch das Aufsicht führende saarländische Innen-und Sportministerium in der Finanzaffäre des LSVS nicht aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7be82d9b-a335-3014-8f16-4c372e05b095",
                                        "entry_id": "fe72240c-9250-30eb-94e5-17f3ecded2b6",
                                        "glosses": [
                                            "fähig, kleine oder empfindliche Dinge sehr sorgfältig zu behandeln und seine Kraft richtig zu dosieren; wichtig beispielsweise bei Montagen, Reparaturen, etc."
                                        ],
                                        "tags": [
                                            "Gefühl in den Fingerspitzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631d8b41-c96c-42ed-96f4-96eea1675b4d",
                                                "sense_id": "7be82d9b-a335-3014-8f16-4c372e05b095",
                                                "text": "Als Uhrmacher braucht man viel Fingerspitzengefühl."
                                            },
                                            {
                                                "example_id": "6412611b-4263-48bf-8aa1-086c6aba4ccc",
                                                "sense_id": "7be82d9b-a335-3014-8f16-4c372e05b095",
                                                "text": "Autos, Bohrmaschinen oder Turbinen zusammenzuschrauben erfordert manchmal einiges an Fingerspitzengefühl - und darum können diesen Teil der industriellen Produktion kaum Maschinen erledigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
