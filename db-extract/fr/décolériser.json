                        ],
                        "examples": [
                            {
                                "example_id": "b8471b4d-8b0e-496e-beb4-fc2a0d5a2a9c",
                                "sense_id": "53e5f4d1-331b-319a-94d0-54d2545e9e0d",
                                "text": "Le Journal des Débats a de la peine à décolériser, et sa furie dure encore contre les jeunes conservateurs."
                            },
                            {
                                "example_id": "26502f82-129d-4648-af0d-62333bcdc33e",
                                "sense_id": "53e5f4d1-331b-319a-94d0-54d2545e9e0d",
                                "text": "Tu me vois cholérifiant sans décolériser en Algérie !"
                            },
                            {
                                "example_id": "ecf6c199-fbb9-4709-9fdd-9138dfe382c9",
                                "sense_id": "53e5f4d1-331b-319a-94d0-54d2545e9e0d",
                                "text": "Pour « se décolériser », il fuit Paris."
                            }
                        ]
