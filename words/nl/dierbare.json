                {
                    "sense_id": "2ff1b740-0bb1-34f5-951e-4967fc23f1bb",
                    "sense_definition": "Iemand van wie je veel houdt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geliefde_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik breng de feestdagen het liefst door met mijn <w>dierbaren</w>.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю проводить праздники со своими <w>близкими</w>.",
                                "de": "Ich verbringe die Feiertage am liebsten mit meinen <w>Liebsten</w>."
                            }
                        },
                        {
                            "text": "Als je vermoedt dat een <w>dierbare</w> financiële problemen heeft, is het goed om hulp te bieden.",
                            "target_lang_translations": {
                                "ru": "Если вы подозреваете, что у <w>близкого человека</w> финансовые проблемы, хорошо бы предложить помощь.",
                                "de": "Wenn Sie vermuten, dass eine <w>nahestehende Person</w> finanzielle Probleme hat, ist es gut, Hilfe anzubieten."
                            }
                        }
                    ],
                    "synonyms": [
                        "geliefde",
                        "naaste"
                    ],
                    "common_phrases": [
                        "zorg voor dierbaren",
                        "omringd door dierbaren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кого вы очень любите; близкий человек",
                        "de": "Jemand, den man sehr liebt; eine nahestehende Person"
