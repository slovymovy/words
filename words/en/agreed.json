                        "zh": "动词 agree 的过去式和过去分词形式，表示同意、达成协议或决定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "договорились",
                                "target_lang_sense_clarification": "пришли к соглашению"
                            },
                            {
                                "target_lang_word": "согласились",
                                "target_lang_sense_clarification": "выразили согласие"
                            },
                            {
                                "target_lang_word": "согласовано",
                                "target_lang_sense_clarification": "официально одобрено или решено"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同意",
                                "target_lang_sense_clarification": "表示赞同或许可"
                            },
                            {
                                "target_lang_word": "商定",
                                "target_lang_sense_clarification": "经协商后决定"
                            },
                            {
                                "target_lang_word": "达成一致",
                                "target_lang_sense_clarification": "取得共识"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4a722114-0378-3c66-8286-1a17c995305b",
                    "sense_definition": "In harmony; united in opinion or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are much more <w>agreed</w> on goals than on methods.",
                            "target_lang_translations": {
                                "ru": "Мы гораздо больше <w>согласны</w> в целях, чем в методах.",
                                "zh": "我们在目标上远比在方法上更<w>意见一致</w>。"
                            }
                        },
                        {
                            "text": "The committee is <w>agreed</w> that this is the best solution.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>согласен</w> с тем, что это лучшее решение.",
                                "zh": "委员会<w>一致认为</w>这是最佳解决方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "united",
                        "unanimous",
                        "harmonious"
                    ],
                    "antonyms": [
                        "divided",
                        "disagreed"
                    ],
                    "common_phrases": [
                        "fully agreed",
                        "agreed on"
