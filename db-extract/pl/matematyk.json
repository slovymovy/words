                                    {
                                        "sense_id": "c703d955-b189-38bb-9cfe-a93deb00f1e7",
                                        "entry_id": "3260bf11-0e03-3e6c-b12f-9a0a41c85471",
                                        "glosses": [
                                            "школьн. учитель математики или алгебры"
                                        ],
