                ],
                "senses": [
                    {
                        "sense_id": "93894e95-d48c-3f04-bde6-3e7cdfa49879",
                        "entry_id": "943d2881-b11d-3dc1-b352-a5bca424ee24",
                        "glosses": [
                            "adlige weibliche Person, die an einem Hof (zum Beispiel eines Fürsten) lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3cd33b1-de13-4a44-b0f9-0493d32ce06c",
                                "sense_id": "93894e95-d48c-3f04-bde6-3e7cdfa49879",
                                "text": "„Zusammen mit Rostows sollte Marja Ignatjewna Peronskaja auf den Ball gehen, eine Freundin und Verwandte der Gräfin, eine dürre und gelbliche Person, ehemals Hofdame der alten Kaiserin, die jetzt die Rostows als Provizialen in der großen Welt Petersburgs unter ihre Fittiche nahm.“"
                            },
                            {
                                "example_id": "4a8e1257-ecd6-4712-82ce-857dafcdabb8",
                                "sense_id": "93894e95-d48c-3f04-bde6-3e7cdfa49879",
                                "text": "„Endlich sah er die Königin von der Fährbrücke her auf sich zukommen, eine Hofdame mit ihr, allem Anscheine nach das jüngere Fräulein von Viereck.“"
                            },
                            {
                                "example_id": "8157f5b5-2a96-4771-96ca-66a9c3a77e57",
                                "sense_id": "93894e95-d48c-3f04-bde6-3e7cdfa49879",
                                "text": "„Das Irrenhaus-Theater von Charenton wird für einen Teil der Pariser Gesellschaft zu einer Sensation, zu der Hofdamen, Bankiers, Salonmatadoren und vor allen Theaterpersönlichkeiten, darunter die damals bekanntesten Pariser Schauspielerinnen, sich drängten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb864070-a830-4390-a178-69d404d051b0",
                        "source_entry_id": "943d2881-b11d-3dc1-b352-a5bca424ee24",
                        "source_sense_id": "93894e95-d48c-3f04-bde6-3e7cdfa49879",
                        "source_sense_description": "adlige weibliche Person, die an einem Hof (zum Beispiel eines Fürsten) lebt",
                        "target_lang_word": "court lady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "court lady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30a60dae-9c4f-37c1-9517-18867eed95d7",
                                        "entry_id": "8858ab5e-b59c-30e6-81f1-d9df920ecdbc",
                                        "glosses": [
                                            "Synonym of lady-in-waiting."
                                        ],
                                        "tags": [],
