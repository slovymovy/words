                        "source_sense_id": "a0922f18-e673-3558-a579-165fef1e8a8a",
                        "source_sense_description": "to move with rushing or swirling sound",
                        "target_lang_word": "zischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3917d39b-8dfe-39d1-bacb-ba0829d9f464",
                                        "entry_id": "2ad3c425-10a3-3745-8e93-b66270ea68e2",
                                        "glosses": [
                                            "ein Geräusch machen wie Luft, die durch eine enge Öffnung strömt"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7109208-cd3e-472f-9b2e-70e4f4201a08",
                                                "sense_id": "3917d39b-8dfe-39d1-bacb-ba0829d9f464",
                                                "text": "Als ich sie berührte, zischte die Schlange."
                                            },
                                            {
                                                "example_id": "cd91449b-a811-419c-aa8e-8627a099774d",
                                                "sense_id": "3917d39b-8dfe-39d1-bacb-ba0829d9f464",
                                                "text": "Das Fett zischte beim Braten des Steaks in der Pfanne."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8e0cfa6-b261-39da-981f-4ac6d9d212bc",
                                        "entry_id": "2ad3c425-10a3-3745-8e93-b66270ea68e2",
                                        "glosses": [
                                            "mit zischendem Geräusch strömen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c60dc913-44c7-4d80-bf31-246c2a9ff8ae",
                                                "sense_id": "a8e0cfa6-b261-39da-981f-4ac6d9d212bc",
                                                "text": "Die Luft zischte aus dem Reifen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15bbbd66-0b2a-34f0-a1b2-e1bd91ba05f9",
                                        "entry_id": "2ad3c425-10a3-3745-8e93-b66270ea68e2",
                                        "glosses": [
                                            "in scharfem Ton mehr oder weniger flüsternd reden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3e6ce2-43c0-417a-ac68-bb27e8aef144",
                                                "sense_id": "15bbbd66-0b2a-34f0-a1b2-e1bd91ba05f9",
                                                "text": "„Halt den Mund!“ zischte sie."
                                            },
                                            {
                                                "example_id": "a2d15d35-d82c-4382-9094-8007e78be5de",
                                                "sense_id": "15bbbd66-0b2a-34f0-a1b2-e1bd91ba05f9",
                                                "text": "„«Zu einem Arzt geht man nicht im Straßenaufzug. Das gehört sich nicht», zischte der Papa.“"
                                            },
                                            {
                                                "example_id": "5efbdf8e-30bb-47db-96a9-e7e4aa24ed5c",
                                                "sense_id": "15bbbd66-0b2a-34f0-a1b2-e1bd91ba05f9",
                                                "text": "„»Bald!«, zischte sie, bevor ich wieder ansetzen könnte, mich zu beschweren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "51ecb290-b685-3caa-bb07-05fdc8a730cb",
                                        "entry_id": "2ad3c425-10a3-3745-8e93-b66270ea68e2",
                                        "glosses": [
                                            "sich schnell fortbewegen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84d612db-9722-44c0-bf72-47520faa0906",
                                                "sense_id": "51ecb290-b685-3caa-bb07-05fdc8a730cb",
                                                "text": "Eine Silvesterrakete zischte über die Straße."
                                            },
                                            {
                                                "example_id": "afd4115e-9136-4f01-ace3-f22f836dddba",
                                                "sense_id": "51ecb290-b685-3caa-bb07-05fdc8a730cb",
                                                "text": "Er zischte aus dem Eingang."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5955f6db-b21f-3d71-a073-30bcae42974f",
                                        "entry_id": "2ad3c425-10a3-3745-8e93-b66270ea68e2",
                                        "glosses": [
                                            "trinken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de9e08ab-9125-4dee-8bfb-56949a8c5f33",
                                                "sense_id": "5955f6db-b21f-3d71-a073-30bcae42974f",
                                                "text": "Komm, wir gehen noch ein kühles Blondes zischen."
                                            },
                                            {
                                                "example_id": "b031db5d-839c-445b-b0a8-20d0a930de74",
                                                "sense_id": "5955f6db-b21f-3d71-a073-30bcae42974f",
                                                "text": "„Und ick zisch’ dabei een Bia, / wie in eena Osteria“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
