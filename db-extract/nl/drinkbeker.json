                                            {
                                                "example_id": "3464cb8d-8fdf-45c1-8a1e-5901546d0c09",
                                                "sense_id": "699d3c75-92be-3bbd-9774-ad1f380050fb",
                                                "text": "„Er formte seine rechte Hand zu einer gehöhlten Faust, die er wie einen Trinkbecher an seinen Mund führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
