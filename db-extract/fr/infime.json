                                "target_senses": [
                                    {
                                        "sense_id": "9613e73f-cb8f-3dd4-801c-aad1553ec289",
                                        "entry_id": "20a86199-ac0f-3529-a919-9ff1d3f456e2",
                                        "glosses": [
                                            "superlative form of low: most low"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c52d55-9daf-4e25-9e49-460aa35db799",
                                                "sense_id": "9613e73f-cb8f-3dd4-801c-aad1553ec289",
                                                "text": "Yang says he remembers being able to see the glacier’s lowest edge from his home village. But that time has passed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lowest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e052b541-7579-3598-bf8e-aa77d76d4274",
                                        "entry_id": "a855db9a-eee8-3d9e-b103-02337b361fdc",
                                        "glosses": [
                                            "superlative form of low: most low"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd47ddc-0c4a-4e67-a8d2-5674cde1291d",
                                                "sense_id": "e052b541-7579-3598-bf8e-aa77d76d4274",
                                                "text": "Whoever bends lowest will will the limbo tournament."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eaa0ae1-5853-4041-97f3-10094ada221f",
                        "source_entry_id": "fe09bea5-3984-3042-b0cf-8823a1f1898a",
                        "source_sense_description": "Tout petit",
                        "target_lang_word": "tiny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba5c08e7-4d57-30f7-b04e-c7a14b4f254a",
                                        "entry_id": "5d9be602-8910-3bc8-a4a9-b9d7df114177",
                                        "glosses": [
                                            "Very small."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4a6fdc-e9bf-455c-adc4-e08a052b6002",
                                                "sense_id": "ba5c08e7-4d57-30f7-b04e-c7a14b4f254a",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus. That’s because the lenses that are excellent at magnifying tiny subjects produce a narrow depth of field. A photo processing technique called focus stacking has changed that."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tiny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15e29450-cc1e-30eb-b17b-1bacc4a7a220",
                                        "entry_id": "775f71fa-017b-3019-9231-0df3e1c0b5f1",
                                        "glosses": [
                                            "A small child; an infant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0912992b-b096-40e2-8ef8-1f4a819f22b6",
                                                "sense_id": "15e29450-cc1e-30eb-b17b-1bacc4a7a220",
                                                "text": "‘You know I loved your husband like a brother, and you know I've loved you and Sylvia ever since she was a tiny.’"
                                            },
                                            {
                                                "example_id": "dc045e38-87cc-4b42-baeb-5ef3ccdceef9",
                                                "sense_id": "15e29450-cc1e-30eb-b17b-1bacc4a7a220",
                                                "text": "The lessons we saw have been well suited to the age of the children as regards music, singing and moving (and stories about animals for the tinies and more abstract themes for the older children)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e82dee6-d1ce-37cc-acfc-8ed99928bf3c",
                                        "entry_id": "775f71fa-017b-3019-9231-0df3e1c0b5f1",
                                        "glosses": [
                                            "Anything very small."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97329ad-5ae6-45eb-a9db-5ea58ea022fe",
                                                "sense_id": "9e82dee6-d1ce-37cc-acfc-8ed99928bf3c",
                                                "text": "Might I now add a plea for the smaller irises, the tinies? They, also, should be divided up and replanted just now."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ffe5544-0d7b-479b-b826-9099025f9051",
                        "source_entry_id": "fe09bea5-3984-3042-b0cf-8823a1f1898a",
                        "source_sense_description": "Tout petit",
                        "target_lang_word": "minute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7674c70b-48a6-3fc4-abe5-57ae56abadc9",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A unit of time which is one sixtieth of an hour (sixty seconds)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "618fe05f-5071-4b6d-9d97-16b02f98c297",
                                                "sense_id": "7674c70b-48a6-3fc4-abe5-57ae56abadc9",
                                                "text": "Holonyms: hectosecond < kilosecond < hour < day < week < megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "7c5f52e4-0785-42c2-8414-449034c7c650",
                                                "sense_id": "7674c70b-48a6-3fc4-abe5-57ae56abadc9",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond"
                                            },
                                            {
                                                "example_id": "057ce29a-e118-4ce1-8e71-8f14c3540c66",
                                                "sense_id": "7674c70b-48a6-3fc4-abe5-57ae56abadc9",
                                                "text": "You have twenty minutes to complete the test."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab6aa90e-31a9-3f88-9c31-4c9ad1da55af",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A short but unspecified time period."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62179af8-4812-48f7-998d-ff1d90843fbe",
                                                "sense_id": "ab6aa90e-31a9-3f88-9c31-4c9ad1da55af",
                                                "text": "give me a minute"
                                            },
                                            {
                                                "example_id": "298eadd9-9c5e-4b55-96be-9eab6f2c75ad",
                                                "sense_id": "ab6aa90e-31a9-3f88-9c31-4c9ad1da55af",
                                                "text": "Wait a minute, I’m not ready yet!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "149b4810-c531-3de1-b7e2-ca8c825844d8",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A unit of angle equal to one-sixtieth of a degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a29a244-f24d-4b61-89b3-13f10c6da3ca",
                                                "sense_id": "149b4810-c531-3de1-b7e2-ca8c825844d8",
                                                "text": "We need to be sure these maps are accurate to within one minute of arc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ed47c84-a769-3352-80ec-2899195a0a33",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A (usually formal) written record of a meeting or a part of a meeting."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc70891b-54d6-4128-8278-6bbf1dda279b",
                                                "sense_id": "6ed47c84-a769-3352-80ec-2899195a0a33",
                                                "text": "Let’s look at the minutes of last week’s meeting."
                                            },
                                            {
                                                "example_id": "c30c144f-04b7-49b5-8ea2-84e13941238a",
                                                "sense_id": "6ed47c84-a769-3352-80ec-2899195a0a33",
                                                "text": "The Clerk or 'recording Clerk' drafts a minute and then, or at a later time, reads it to the Meeting. Subsequent contributions are on the wording of the minute only, until it can be accepted by the Meeting. Once the minute is accepted, the Meeting moves on to the next item on the agenda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cbfbb82-9bf6-3bfc-b425-6b74cafdf851",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A unit of purchase on a telephone or other similar network, especially a cell phone network, roughly equivalent in gross form to sixty seconds' use of the network."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47aee52-e884-4703-b0e3-41f676c376a4",
                                                "sense_id": "1cbfbb82-9bf6-3bfc-b425-6b74cafdf851",
                                                "text": "If you buy this model, you’ll get 100 free minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13480b98-9ec0-3366-9b3e-aa47083e3bfa",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A point in time; a moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f716054-2ff1-4d1c-8f38-c92361560a9b",
                                                "sense_id": "13480b98-9ec0-3366-9b3e-aa47083e3bfa",
                                                "text": "Tell her, that I some Certainty may bring; / I go this minute to attend the king."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57d1fbdb-7e6d-34e0-862b-0a494e602ec7",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A nautical or a geographic mile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b48545ff-fccb-3aa4-9d50-b832c3fcb95d",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "An old coin, a half farthing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d8fd1ab-971a-3a1d-b777-289621b82982",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A very small part of anything, or anything very small; a jot; a whit."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46e97db-0136-4d83-aef9-3f066b15e4c3",
                                                "sense_id": "4d8fd1ab-971a-3a1d-b777-289621b82982",
                                                "text": "[…]according to the Prophecies of him, which were so clear and descended to minutes and circumstances of his passion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af82ed6-8aff-398b-9dfe-b0049488ee60",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A fixed part of a module."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3de7eefb-6587-3afd-8d4e-56c6562f5c65",
                                        "entry_id": "b1c7d55a-bd0c-35ca-b42c-d2cb48839126",
                                        "glosses": [
                                            "A while or a long unspecified period of time."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "dialectal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6f6b630-363c-40aa-9419-e720df13e3a2",
                                                "sense_id": "3de7eefb-6587-3afd-8d4e-56c6562f5c65",
                                                "text": "Oh, I ain't heard that song in a minute!"
                                            },
                                            {
                                                "example_id": "2279f806-020e-49ed-85b1-6c576558cfa7",
                                                "sense_id": "3de7eefb-6587-3afd-8d4e-56c6562f5c65",
                                                "text": "“Man, I haven’t seen you in a minute,” he says, smiling still. “Maybe like two, three years ago?”"
                                            },
                                            {
                                                "example_id": "4060abc3-1ba4-40c1-a804-8e7dae472012",
                                                "sense_id": "3de7eefb-6587-3afd-8d4e-56c6562f5c65",
                                                "text": "I seen Too$hort up there. Me and $hort ain't talked in a minute."
                                            },
                                            {
                                                "example_id": "e0f90749-ddd3-464b-8c04-c8d8c3a5dffc",
                                                "sense_id": "3de7eefb-6587-3afd-8d4e-56c6562f5c65",
                                                "text": "RON:I remember my first. I was a minute younger than you. […]I remember thinking, saying to myself...\"This is the first time I'm eating as a person who killed someone.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "480469e1-416b-38d9-95b2-ec82c3a3cdb0",
                                        "entry_id": "a11c472b-f6bf-3c12-ad4d-b81f517e4cf2",
                                        "glosses": [
                                            "Of an event, to write in a memo or the minutes of a meeting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efbb60a5-d6bf-49a9-b5a9-274eb7043057",
                                                "sense_id": "480469e1-416b-38d9-95b2-ec82c3a3cdb0",
                                                "text": "I’ll minute this evening’s meeting."
                                            },
                                            {
                                                "example_id": "08eb61d8-ae65-47b7-9314-218747f4498e",
                                                "sense_id": "480469e1-416b-38d9-95b2-ec82c3a3cdb0",
                                                "text": "I dare say there was a vast amount of minuting, memoranduming, and despatch-boxing, on this mighty subject."
                                            },
                                            {
                                                "example_id": "c907cbed-464b-48d8-9bf0-7dd933227f8c",
                                                "sense_id": "480469e1-416b-38d9-95b2-ec82c3a3cdb0",
                                                "text": "On 17 November 1949 Jay minuted Cripps, arguing that trade liberalization on inessentials was socially regressive."
                                            },
                                            {
                                                "example_id": "8c3c2481-9e24-455c-aeb1-f6f3100f6951",
                                                "sense_id": "480469e1-416b-38d9-95b2-ec82c3a3cdb0",
                                                "text": "The Commander-in-Chief of Bomber Command, Sir Richard Peirse, was sceptical of its findings, minuting, ‘I don’t think at this rate we could have hoped to produce the damage which is known to have been achieved.’"
                                            },
                                            {
                                                "example_id": "4e83ed7f-ad13-4d4d-b2c5-0b5d9187904f",
                                                "sense_id": "480469e1-416b-38d9-95b2-ec82c3a3cdb0",
                                                "text": "Mr. Klingstadt, chief Auditor of the Admiralty of that city, sent for and examined them very particularly concerning the events which had befallen them; minuting down their answers in writing, with an intention of publishing himself an account of their extraordinary adventures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ce3d4d-4435-3b22-89ea-4f48e20b4768",
                                        "entry_id": "a11c472b-f6bf-3c12-ad4d-b81f517e4cf2",
                                        "glosses": [
                                            "To set down a short sketch or note of; to jot down; to make a minute or a brief summary of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a02d10-6cd9-4739-bd0e-dd61727828ab",
                                                "sense_id": "b1ce3d4d-4435-3b22-89ea-4f48e20b4768",
                                                "text": "The Empress of Russia, with her own hand, minuted an edict for universal tolerance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minute",
                                "target_lang_code": "en",
