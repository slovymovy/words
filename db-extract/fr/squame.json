                "senses": [
                    {
                        "sense_id": "454f10ae-839f-32fa-82b0-11da8de768fb",
                        "entry_id": "302859c2-8f39-3c34-8244-662abd31a758",
                        "glosses": [
                            "Morceau de peau morte qui se détache de l’épiderme, notamment à la suite d'une brûlure ou dans le cas d’une dermatose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2d24e8-7647-4521-932b-77e783a41d27",
                                "sense_id": "454f10ae-839f-32fa-82b0-11da8de768fb",
                                "text": "Une carapace de squames lui cache les côtés, comme ferait un gilet."
                            },
                            {
                                "example_id": "dd0c096e-369c-4311-a104-d66058b9bcf4",
                                "sense_id": "454f10ae-839f-32fa-82b0-11da8de768fb",
                                "text": "Mais deux jours après, les taches de la peau prirent une teinte violette, puis blanche, et elles tombèrent en squames."
                            },
                            {
                                "example_id": "01707b38-7f55-420f-9d98-454451cc99ce",
                                "sense_id": "454f10ae-839f-32fa-82b0-11da8de768fb",
                                "text": "Le lendemain, dès l’éveil, son bouton, au palper, lui parut bizarre ; il l’examina dans une glace et constata qu’une squame jaunâtre en recouvrait l’écorniflure ; le tout avait un méchant aspect."
                            }
                        ]
                    }
                ],
