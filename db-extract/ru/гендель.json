                "senses": [
                    {
                        "sense_id": "cdbbe9fb-8a2c-3eda-81c0-004beefdbf43",
                        "entry_id": "89a515d5-a1d9-39be-a42a-46288af5db1f",
                        "glosses": [
                            "немецкая фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ad07f7-7660-4064-a3fc-a690c97e6ae5",
                                "sense_id": "cdbbe9fb-8a2c-3eda-81c0-004beefdbf43",
                                "text": "Музыкант Гендель, изображенный славным Рубильяком, слушает ангела, который в облаках, над его головою, играет на арфе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "870fdd0b-01f0-4bd7-a66a-c9c307dfff08",
                        "source_entry_id": "89a515d5-a1d9-39be-a42a-46288af5db1f",
                        "source_sense_id": "cdbbe9fb-8a2c-3eda-81c0-004beefdbf43",
                        "target_lang_word": "Handel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59d5305a-d04f-3b27-b160-2d828da6ae87",
                                        "entry_id": "192a5906-3650-31ca-aa3d-4ae6793f589b",
                                        "glosses": [
                                            "A surname from German; (music) used specifically of George Frideric Handel (1685–1759), a German-British Baroque composer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff46c761-b24e-4a11-a0c0-b7e50455a3f3",
                                                "sense_id": "59d5305a-d04f-3b27-b160-2d828da6ae87",
                                                "text": "Handel's masterpiece, Messiah, is one of the incontrovertible masterpieces of the Western canon, a work whose place in the musical life of the nation looks, with the benefit of hindsight, to have been assured since its first performance in 1742."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5293fd5-067d-4114-be57-5f29f25016b5",
                        "source_entry_id": "89a515d5-a1d9-39be-a42a-46288af5db1f",
                        "source_sense_id": "cdbbe9fb-8a2c-3eda-81c0-004beefdbf43",
                        "target_lang_word": "Haendel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "86334226-7842-422b-9e8d-92e29be8f6a6",
                        "source_entry_id": "89a515d5-a1d9-39be-a42a-46288af5db1f",
                        "source_sense_id": "cdbbe9fb-8a2c-3eda-81c0-004beefdbf43",
                        "target_lang_word": "Händel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Händel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "647354cf-8df5-34bd-82eb-77c9e67add40",
                                        "entry_id": "27638d6f-05e9-3972-bfd5-ae24d851afa4",
                                        "glosses": [
                                            "Streit, Streitigkeiten, wobei das Wort selbst impliziert, dass bei dem Streit Handgreiflichkeiten nicht gänzlich ausgeschlossen sind"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bf8bf6f-8482-4532-ac7c-55b199370dfc",
                                                "sense_id": "647354cf-8df5-34bd-82eb-77c9e67add40",
                                                "text": "Die Brüder mussten ihre Händel ausgerechnet vor ihrem Vater austragen."
                                            },
                                            {
                                                "example_id": "0f5425c3-428b-4b39-9005-916238f1afb4",
                                                "sense_id": "647354cf-8df5-34bd-82eb-77c9e67add40",
                                                "text": "Sie hatten einige Händel miteinander."
                                            },
                                            {
                                                "example_id": "6abcde27-4912-4f27-9857-075e87445425",
                                                "sense_id": "647354cf-8df5-34bd-82eb-77c9e67add40",
                                                "text": "„Während der ersten zwei Wochen meines Pariser Aufenthalts kam es mir vor, als machte ich die größten Fehler, denn ich hörte gar nicht mehr auf, um Verzeihung zu bitten. Eines Abends im Theater glaubte ich sogar, es wolle jemand Händel mit mir anfangen, weil ich ihn in unangebrachter Weise um Verzeihung gebeten hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Händel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97895471-8492-3c70-93ac-65449a12a537",
                                        "entry_id": "d4a1eb69-8b2e-389e-8e43-2d8c22c62fd1",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e805d7-8c90-4374-8c96-ee070a637f03",
                                                "sense_id": "97895471-8492-3c70-93ac-65449a12a537",
                                                "text": "Herrn Händels Tochter ist zu Besuch bei uns."
                                            },
                                            {
                                                "example_id": "ac0c6e42-f3fd-413a-9aae-51aa570dbe2b",
                                                "sense_id": "97895471-8492-3c70-93ac-65449a12a537",
                                                "text": "Ich habe lange nicht mehr Händels Wassermusik gehört."
                                            },
                                            {
                                                "example_id": "d0af9d4c-57e4-448a-a2a4-2ba9c3d53280",
                                                "sense_id": "97895471-8492-3c70-93ac-65449a12a537",
                                                "text": "Hast du Herrn Händel gesehen?"
                                            },
                                            {
                                                "example_id": "acf7586a-5b96-411b-9164-1b22be42fe0e",
                                                "sense_id": "97895471-8492-3c70-93ac-65449a12a537",
                                                "text": "Wusstest du, dass Jürgen der Stiefsohn von Herrn und Frau Händel ist?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
