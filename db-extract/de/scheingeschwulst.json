                "senses": [
                    {
                        "sense_id": "39a173cf-ef97-3e04-a4d0-03572a5149c7",
                        "entry_id": "b65fdfe6-8186-3bf8-9d15-f0aea0ff027b",
                        "glosses": [
                            "Geschwulst, das nur einzelne, aber nicht alle Merkmale eines Tumors aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ac056c-5ae3-4e53-a99c-8f49702d2bc2",
                                "sense_id": "39a173cf-ef97-3e04-a4d0-03572a5149c7",
                                "text": "„Die Scheingeschwülste können so groß werden, daß sie nicht nur das ganze kleine Becken ausfüllen, sondern auch noch respektable Abschnitte des oberhalb des kleinen Beckens liegenden Bauchraumes beanspruchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25c1a76a-0b70-4419-b628-a788d86fe480",
                        "source_entry_id": "b65fdfe6-8186-3bf8-9d15-f0aea0ff027b",
                        "source_sense_id": "39a173cf-ef97-3e04-a4d0-03572a5149c7",
                        "source_sense_description": "Medizin: Geschwulst, das nur einzelne, aber nicht alle Merkmale eines Tumors aufweist",
                        "target_lang_word": "pseudotumor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudotumor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d288842f-711a-3b13-b3d5-49401fdeb27b",
                                        "entry_id": "fb1cc9db-b141-3889-99df-3d715995da94",
                                        "glosses": [
                                            "An enlarged portion of tissue that resembles a tumor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f9e2db-6b0b-489c-9c20-78decfa40c1b",
                                                "sense_id": "d288842f-711a-3b13-b3d5-49401fdeb27b",
                                                "text": "The so-called Danlos or Ehlers-Danlos syndrome consists of three symptoms: (1) pronounced fragility of the skin and its blood vessels, with breaking, splitting and the formation of hematomas and pseudotumors subsequent to the slightest trauma (dermatorrhexis-fragilitas cutis), (2) a more or less pronounced hyperlaxity and hyperelasticity of the skin (dermatochalasis-laxitas cutis) and (3) more or less pronounced hyperlaxity or hyperflexibility of the joints (arthrochalasis-laxitas articularis)."
                                            },
                                            {
                                                "example_id": "c7a2fd9d-a2f9-4e3c-9616-604ffa367f33",
                                                "sense_id": "d288842f-711a-3b13-b3d5-49401fdeb27b",
                                                "text": "It can be hard to tell a pseudotumor from a real tumor. So you should see your doctor to have your symptoms checked out. The symptoms of pseudotumor cerebri can get worse and hurt your vision. Getting treated quickly can help save your sight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
