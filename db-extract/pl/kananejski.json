                "translations": [
                    {
                        "translation_id": "66b07e97-fe3a-449e-a0c9-7a251892a3e1",
                        "source_entry_id": "fe54887f-873f-3fb6-9305-5f6550f0b89a",
                        "source_sense_id": "24cf9b40-3671-3ead-82d2-63ad2a8f4dcb",
                        "target_lang_word": "Canaanite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Canaanite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5815e520-ac50-377d-a384-3d5fe62fd781",
                                        "entry_id": "283c2055-dd2e-3b77-a3da-cdeb278c544a",
                                        "glosses": [
                                            "A subfamily of the Semitic languages, which were spoken by the ancient peoples of the Canaan region, including Canaanites, Israelites and Phoenicians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "904e2118-ea19-434d-93b7-b32eb74b80be",
                                                "sense_id": "5815e520-ac50-377d-a384-3d5fe62fd781",
                                                "text": "An affricated realization of *-z, as well as of voiceless *-s and emphatic *-ṣ-, is in any case reconstructed for Proto-Semitic, Northwest Semitic, and Canaanite, to which Phoenician belongs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Canaanite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "413ecf3d-2fe2-30d0-acb4-7c2ced40b004",
                                        "entry_id": "23f4ca9e-ed25-31f6-b276-c0f392df7d56",
                                        "glosses": [
                                            "A member of the ancient Semitic people who occupied Canaan before its conquest by Israelites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f103283a-2f5e-4188-b36a-efe04c289bf7",
                                                "sense_id": "413ecf3d-2fe2-30d0-acb4-7c2ced40b004",
                                                "text": "Among the ancient Canaanites it was considered a divine honor to perform the sexual act."
                                            },
                                            {
                                                "example_id": "983b8ca4-ad52-4e0e-801c-26ad497a4f67",
                                                "sense_id": "413ecf3d-2fe2-30d0-acb4-7c2ced40b004",
                                                "text": "It’s a simple sentence that captures the hopes and fears of modern-day parents as much as the bronze age Canaanite who owned the doubled-edged ivory comb on which the words appear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65cda339-691a-381e-80b9-78060dad2e98",
                                        "entry_id": "23f4ca9e-ed25-31f6-b276-c0f392df7d56",
                                        "glosses": [
                                            "A zealot or fanatic."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06109936-5660-3219-8351-2b3350b8d398",
                                        "entry_id": "23f4ca9e-ed25-31f6-b276-c0f392df7d56",
                                        "glosses": [
                                            "A member of the Canaanism movement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Canaanite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11b41335-521a-3594-8802-c4e1e590d706",
                                        "entry_id": "a8a8b045-05cf-35dd-81f5-7c3e27b7b391",
                                        "glosses": [
                                            "Of or pertaining to the people or language of Canaan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b5fa8c-b241-4e46-a989-72d5ab067428",
                                                "sense_id": "11b41335-521a-3594-8802-c4e1e590d706",
                                                "text": "Unearthed in Lachish, a Canaanite city state in the second millennium BCE and the second most important city in the kingdom of Judah, the comb suggests that humans have endured lice for thousands of years and that even the wealthiest were not spared the grim infestations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c43ffd9-c9fe-33d5-b371-57903e966b4e",
                                        "entry_id": "a8a8b045-05cf-35dd-81f5-7c3e27b7b391",
                                        "glosses": [
                                            "Of or pertaining to this sect or its followers; Canaanitic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdd75c0d-e009-308f-baa2-afa3bb6ce274",
                                        "entry_id": "a8a8b045-05cf-35dd-81f5-7c3e27b7b391",
                                        "glosses": [
                                            "zealous or fanatical."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
