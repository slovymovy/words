                            },
                            {
                                "target_lang_word": "主张",
                                "target_lang_sense_clarification": "理论陈述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea88524a-205b-39f9-bcff-f040bea241fc",
                    "sense_definition": "Состояние беременности (употребляется в устойчивых выражениях).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "situation_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все коллеги относились к ней бережно, зная, что она находится в интересном <w>положении</w>.",
                            "target_lang_translations": {
                                "en": "All colleagues treated her gently, knowing she was in a delicate <w>condition</w>.",
                                "zh": "同事们都知道她有<w>身孕</w>，所以对她都很照顾。"
                            }
                        },
                        {
                            "text": "Женщинам в <w>положении</w> следует избегать стрессов и тяжёлых физических нагрузок.",
                            "target_lang_translations": {
                                "en": "Women who are <w>expecting</w> should avoid stress and heavy physical loads.",
                                "zh": "怀孕的女性应避免压力和繁重的体力劳动。"
                            }
                        }
