{
    "word_family": [
        "frustration",
        "frustrating",
        "frustrated",
        "frustratingly",
        "frustratable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "591e90da-c132-32db-b400-057483acb695",
                    "sense_definition": "To cause feelings of annoyance, disappointment, or insecurity by preventing someone from achieving something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It really <w>frustrates</w> me when I work hard and lose all my progress.",
                            "target_lang_translations": {
                                "tr": "Çok çalışıp tüm ilerlememi kaybettiğimde bu beni gerçekten <w>hüsrana uğratıyor</w>.",
                                "zh": "当我努力工作却丢失了所有进度时，这真的让我感到很<w>沮丧</w>。",
                                "es": "Realmente me <w>frustra</w> cuando trabajo duro y pierdo todo mi progreso."
                            }
                        },
                        {
                            "text": "The constant delay will <w>frustrate</w> the users who are waiting for an update.",
                            "target_lang_translations": {
                                "tr": "Sürekli yaşanan gecikme, güncelleme bekleyen kullanıcıları <w>sinirlendirecek</w>.",
                                "zh": "不断的延迟会<w>惹恼</w>那些等待更新的用户。",
                                "es": "El retraso constante <w>frustrará</w> a los usuarios que esperan una actualización."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "exasperate",
                        "irritate",
                        "vex"
                    ],
                    "common_phrases": [
                        "frustrate someone"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin bir şeyi başarmasını engelleyerek sinirlenmesine, hayal kırıklığına uğramasına veya güvensizlik hissetmesine neden olmak.",
                        "zh": "通过阻止某人实现目标，从而引起其烦恼、失望或不安的情绪。",
                        "es": "Causar sentimientos de molestia, decepción o inseguridad al impedir que alguien logre algo."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hüsrana uğratmak",
                                "target_lang_sense_clarification": "hayal kırıklığına uğratmak"
                            },
                            {
                                "target_lang_word": "sinirlendirmek",
                                "target_lang_sense_clarification": "öfkelendirmek"
                            },
                            {
                                "target_lang_word": "bunalatmak",
                                "target_lang_sense_clarification": "sıkıntı vermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……感到沮丧",
                                "target_lang_sense_clarification": "让人产生挫败感"
                            },
                            {
                                "target_lang_word": "使……恼火",
                                "target_lang_sense_clarification": "让人感到烦躁或生气"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "frustrar",
                                "target_lang_sense_clarification": "causar decepción o desánimo"
                            },
                            {
                                "target_lang_word": "desesperar",
                                "target_lang_sense_clarification": "causar impaciencia o irritación"
                            },
                            {
                                "target_lang_word": "molestar",
                                "target_lang_sense_clarification": "causar irritación o fastidio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "449f13a8-ee0b-321d-b851-47f5706ff472",
                    "sense_definition": "To prevent a plan, effort, or desire from succeeding; to block or thwart.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "block",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bad weather threatened to <w>frustrate</w> our plans for an outdoor concert.",
                            "target_lang_translations": {
                                "tr": "Kötü hava koşulları açık hava konseri planlarımızı <w>boşa çıkarmak</w> ile tehdit etti.",
                                "zh": "恶劣的天气威胁到了我们户外音乐会的计划，可能会将其<w>挫败</w>。",
                                "es": "El mal tiempo amenazó con <w>frustrar</w> nuestros planes para un concierto al aire libre."
                            }
                        },
                        {
                            "text": "Unexpected technical issues can <w>frustrate</w> your progress on this project.",
                            "target_lang_translations": {
                                "tr": "Beklenmedik teknik sorunlar bu projedeki ilerlemenizi <w>engelleyebilir</w>.",
                                "zh": "突如其来的技术问题可能会<w>阻碍</w>你在这个项目上的进展。",
                                "es": "Los problemas técnicos inesperados pueden <w>frustrar</w> tu progreso en este proyecto."
                            }
                        }
                    ],
                    "synonyms": [
                        "thwart",
                        "hinder",
                        "impede",
                        "obstruct",
                        "stymie"
                    ],
                    "common_phrases": [
                        "frustrate plans",
                        "frustrate efforts",
                        "frustrate progress"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir planın, çabanın veya isteğin başarıya ulaşmasını engellemek; boşa çıkarmak.",
                        "zh": "阻止计划、努力或愿望的实现；阻碍或破坏。",
                        "es": "Impedir que un plan, esfuerzo o deseo tenga éxito; bloquear o frustrar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boşa çıkarmak",
                                "target_lang_sense_clarification": "planı veya çabayı engellemek"
                            },
                            {
                                "target_lang_word": "engellemek",
                                "target_lang_sense_clarification": "akşamasına neden olmak"
                            },
                            {
                                "target_lang_word": "suya düşürmek",
                                "target_lang_sense_clarification": "planları bozmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻碍",
                                "target_lang_sense_clarification": "使进展受阻"
                            },
                            {
                                "target_lang_word": "挫败",
                                "target_lang_sense_clarification": "使计划或努力落空"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "frustrar",
                                "target_lang_sense_clarification": "impedir la realización de algo"
                            },
                            {
                                "target_lang_word": "malograr",
                                "target_lang_sense_clarification": "hacer que algo no salga bien"
                            },
                            {
                                "target_lang_word": "obstaculizar",
                                "target_lang_sense_clarification": "poner obstáculos para impedir el progreso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0404a1f1-930a-3a44-8584-a2dab5cc3fd5",
                    "sense_definition": "To cause mental stress, irritation, or dissatisfaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This difficult exam will <w>frustrate</w> students who did not study properly.",
                            "target_lang_translations": {
                                "tr": "Bu zor sınav, düzgün çalışmayan öğrencilerin <w>canını sıkacak</w>.",
                                "zh": "这场高难度的考试会让那些没好好复习的学生感到<w>心烦</w>。",
                                "es": "Este examen difícil <w>frustrará</w> a los estudiantes que no estudiaron adecuadamente."
                            }
                        },
                        {
                            "text": "Unclear instructions tend to <w>frustrate</w> new employees on their first day.",
                            "target_lang_translations": {
                                "tr": "Belirsiz talimatlar, yeni çalışanları ilk günlerinde <w>çileden çıkarma</w> eğilimindedir.",
                                "zh": "不明确的指示往往会让新员工在入职第一天就感到<w>恼怒</w>。",
                                "es": "Las instrucciones poco claras tienden a <w>frustrar</w> a los nuevos empleados en su primer día."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "irk",
                        "bug"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zihinsel strese, rahatsızlığa veya hoşnutsuzluğa yol açmak.",
                        "zh": "引起心理压力、烦躁或不满。",
                        "es": "Causar estrés mental, irritación o insatisfacción."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çileden çıkarmak",
                                "target_lang_sense_clarification": "aşırı rahatsız etmek"
                            },
                            {
                                "target_lang_word": "canını sıkmak",
                                "target_lang_sense_clarification": "huzursuz etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……心烦",
                                "target_lang_sense_clarification": "造成心理上的不快"
                            },
                            {
                                "target_lang_word": "使……恼怒",
                                "target_lang_sense_clarification": "引起不满情绪"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desesperar",
                                "target_lang_sense_clarification": "causar gran inquietud o pérdida de paciencia"
                            },
                            {
                                "target_lang_word": "fastidiar",
                                "target_lang_sense_clarification": "causar molestia o enfado"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "450c1b16-610f-3a2e-b347-c79ea942d382",
                    "sense_definition": "Ineffectual, useless, or producing no successful result.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their <w>frustrate</w> attempt to find the missing documents ended in failure.",
                            "target_lang_translations": {
                                "tr": "Kayıp belgeleri bulmaya yönelik <w>boş</w> çabaları başarısızlıkla sonuçlandı.",
                                "zh": "他们寻找丢失文件的<w>徒劳</w>尝试最终以失败告终。",
                                "es": "Su <w>infructuoso</w> intento de encontrar los documentos perdidos terminó en fracaso."
                            }
                        },
                        {
                            "text": "The weary travelers abandoned their <w>frustrate</w> search after night fell.",
                            "target_lang_translations": {
                                "tr": "Yorgun yolcular, gece çöktükten sonra <w>faydasız</w> aramalarını bıraktılar.",
                                "zh": "疲惫的旅行者在夜幕降临后放弃了他们<w>无用</w>的搜寻。",
                                "es": "Los viajeros cansados abandonaron su <w>inútil</w> búsqueda después de que cayó la noche."
                            }
                        }
                    ],
                    "synonyms": [
                        "fruitless"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an adjective in modern English; replaced by 'frustrated' or 'fruitless'."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Etkisiz, yararsız veya hiçbir başarılı sonuç vermeyen.",
                        "zh": "无效的、无用的，或无法产生成功结果的。",
                        "es": "Ineficaz, inútil o que no produce ningún resultado exitoso."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boş",
                                "target_lang_sense_clarification": "sonuçsuz, faydasız"
                            },
                            {
                                "target_lang_word": "faydasız",
                                "target_lang_sense_clarification": "etkisiz"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徒劳的",
                                "target_lang_sense_clarification": "没有效果的"
                            },
                            {
                                "target_lang_word": "无用的",
                                "target_lang_sense_clarification": "没有实际价值的"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "inútil",
                                "target_lang_sense_clarification": "que no produce provecho o resultado"
                            },
                            {
                                "target_lang_word": "infructuoso",
                                "target_lang_sense_clarification": "que no da fruto o resultado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}