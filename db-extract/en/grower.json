                                                "example_id": "00b4dcd0-3fe6-4363-9126-82951af3b0bd",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Unter zärtlichen Beschwichtigungen brachte sie den aufgebrachten Papagei in ihre Wohnung, verschloß sorgfältig alle Fenster und ließ den Exoten aus dem Bauer schlüpfen.“"
                                            },
                                            {
                                                "example_id": "1903e22a-6a86-44df-96dd-ca68b63e9ce4",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Dann aber verschwanden die Frauen plötzlich und sprangen hinauf in ihren gewohnten Bauer mit den vergitterten Fenstern.“"
                                            },
                                            {
                                                "example_id": "171eadd2-c66d-4160-950e-cef802bbe97b",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Eine Frau in einem karierten Umhängetuch trug vorsichtig einen Bauer mit einem Papageien weit ausgestreckt vor sich her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                        "entry_id": "b8e7cb82-caf1-39ce-9013-7255ef9c0c26",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0828783f-6695-4904-873a-05248f14d8e3",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Ich möchte Frau Bauer bitten, nach vorne zu kommen."
                                            },
                                            {
                                                "example_id": "ee6cfd33-d119-4d4d-a4b3-69582439f635",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Frau Bauer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f308b5f4-ad7c-4a20-a3e3-64a7bc95b7a2",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Herr Bauer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f46ff882-685e-4941-a547-05951c61a3a8",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Die Bauers fahren heute ins Sauerland."
                                            },
                                            {
                                                "example_id": "f6e6fb1c-d5af-4a0c-bd4e-647dfc612037",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Der Bauer trägt nie die Schals, die die Bauer ihm strickt."
                                            },
                                            {
                                                "example_id": "27294cd5-3c58-40bc-b0a2-dba258bb81c4",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bauer kommt, geht der Herr Bauer.“"
                                            },
                                            {
                                                "example_id": "db73c510-e9b8-45df-846b-25610a5e6298",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Bauer kommt und geht."
                                            },
                                            {
                                                "example_id": "d6bafc85-ca51-48c3-b5ac-5ddf5a78228c",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Bauers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e366d377-a9f6-4c4b-9894-cd40112caa16",
                        "source_entry_id": "4cfc6435-942c-37f7-928e-424f57e1c342",
                        "source_sense_id": "2d86eeda-c4c7-34c1-82b9-a6acaa4c5cf6",
                        "source_sense_description": "Anbauer, Bauer, Erzeuger, Pflanzer, Züchter",
                        "target_lang_word": "Erzeuger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzeuger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14bb55a2-96d1-3b86-b9f6-d525ae097ed8",
                                        "entry_id": "81492d76-cdbd-3a7b-b96d-695a6885b697",
                                        "glosses": [
                                            "Hersteller eines Produktes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db15fca-8ea8-4eb1-8b41-aeef2efb5135",
                                                "sense_id": "14bb55a2-96d1-3b86-b9f6-d525ae097ed8",
                                                "text": "Die Erzeuger des Fahrzeuges wollen die Lampen verbessern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                        "entry_id": "81492d76-cdbd-3a7b-b96d-695a6885b697",
                                        "glosses": [
                                            "genetischer Vater eines Nachwuchses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd01556-dbbc-4f4b-a36a-8e7b721ea474",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "Er mag zwar mein Erzeuger sein, aber du warst immer mein Vater für mich."
                                            },
                                            {
                                                "example_id": "14309c3f-d8e1-442c-b4fb-aeaf731c10f3",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "„Ich sah ihn als Erzeuger, nicht als Vater.“"
                                            },
                                            {
                                                "example_id": "ba88c0dd-dc33-4e5f-85a9-1b570ef5b4fe",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "„Ihnen verbot der Gouverneur kurzerhand das Recht, den Namen ihres deutschen Vaters zu führen, denn die Erzeuger sollten inkognito bleiben.“"
                                            },
                                            {
                                                "example_id": "56ad9013-ceae-4bf1-a3c8-3b8b3ae6052a",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "„Nachdem sich mein Herr Erzeuger davongemacht hatte, zogen meine Mutter, meine Oma und ich nach Newcastle — das heißt, nach Newcastle-under-Lyme, nicht weit von Stoke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de247dcf-36dd-45b8-89f3-e66f2adf2004",
                        "source_entry_id": "4cfc6435-942c-37f7-928e-424f57e1c342",
                        "source_sense_id": "2d86eeda-c4c7-34c1-82b9-a6acaa4c5cf6",
                        "source_sense_description": "Anbauer, Bauer, Erzeuger, Pflanzer, Züchter",
                        "target_lang_word": "Pflanzer",
