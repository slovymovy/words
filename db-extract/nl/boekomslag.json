                        "examples": [
                            {
                                "example_id": "11a20675-548c-416e-b778-971ab8e946cc",
                                "sense_id": "49f75ce7-a111-34ec-97d3-dde98060724d",
                                "text": "Toch is het nog niet zo gemakkelijk om een bookface te maken, stelt Ray Delara van de Californische bibliotheek. Hij neemt echt de tijd voor het maken van de speciale foto's. Zo moet de achtergrond van de boekomslag en die van degene die gefotografeerd worden wel enigszins overeenkomen. Of de kleding. Of de haren. „Ik ben altijd op zoek naar de wow-factor.”"
                            },
                            {
                                "example_id": "1f1d2998-ee4d-4f85-9e5f-50e8fa91ac9f",
                                "sense_id": "49f75ce7-a111-34ec-97d3-dde98060724d",
                                "text": "Ze wil nog twee dingen kwijt: stop met die verplichte boekenlijsten - ‘waarom zou ik mijn leerlingen verbieden een mooi jeugdboek te lezen?’ - en laat ze alsjeblieft niet ‘van die saaie boekverslagen’ maken. Pijpker: ,,Wij hebben zeven of acht opdrachten bedacht waar de leerlingen uit mogen kiezen. Ze mogen bijvoorbeeld een eigen boekomslag maken of ze verzinnen zelf het laatste hoofdstuk van het verhaal.”"
                            }
                        ]
                    }
