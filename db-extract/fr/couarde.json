                            {
                                "example_id": "4b7dc74e-ef9f-465b-b667-264fb84f04d7",
                                "sense_id": "808a1963-7441-316d-ac32-87ecdddae4c9",
                                "text": "Si vous n’avez pas le cran de faire face à une penture, comment réagirez-vous à ce qui nous attend ? La Tour Blanche n’a nul besoin de couardes !"
                            },
                            {
                                "example_id": "e032505f-3fa7-432f-9690-ff3abac5d890",
                                "sense_id": "808a1963-7441-316d-ac32-87ecdddae4c9",
                                "text": "Je pensais que j’avais des seins à bustier, mais comme je suis une couarde, j’ai choisi le dos nu à ficelle amovible."
                            }
                        ]
                    }
