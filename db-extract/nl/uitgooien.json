        "nl-extract.jsonl": [
            {
                "entry_id": "4351d75d-fd40-3e1c-92ad-87e8a22de7c9",
                "word": "uitgooien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b01d4671-c728-302d-ab86-9b6f88b75f79",
                        "entry_id": "4351d75d-fd40-3e1c-92ad-87e8a22de7c9",
                        "glosses": [
                            "snel en slordig uitkleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9982b72-1fbe-4555-ad23-3e632eff6a6c",
                                "sense_id": "b01d4671-c728-302d-ab86-9b6f88b75f79",
                                "text": "De kinderen gooiden kun kleren uit om zo snel mogelijk te kunnen gaan zwemmen."
                            },
                            {
                                "example_id": "ee47c9cb-487e-4bea-8c70-cbe49b2de33e",
                                "sense_id": "b01d4671-c728-302d-ab86-9b6f88b75f79",
                                "text": "Vincenzo knikt, waarna ze beiden hun schoenen uit gooien en tot de enkels het water in plonsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a00f6c0c-a1c8-3492-bbd1-c055a5bfbee9",
                        "entry_id": "4351d75d-fd40-3e1c-92ad-87e8a22de7c9",
                        "glosses": [
                            "snel en slordig leeggieten"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a80419dc-14f3-348b-8510-fc597df52e86",
                        "entry_id": "4351d75d-fd40-3e1c-92ad-87e8a22de7c9",
                        "glosses": [
                            "iets van je af gooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "627f76da-e37b-4954-b999-b2e052f6943f",
                                "sense_id": "a80419dc-14f3-348b-8510-fc597df52e86",
                                "text": "De visser gooide zijn net uit."
                            },
                            {
                                "example_id": "b210d1ff-50a4-494c-9362-a4a926d57634",
                                "sense_id": "a80419dc-14f3-348b-8510-fc597df52e86",
                                "text": "De keeper kon heel ver uitgooien."
                            }
                        ]
                    }
                ],
