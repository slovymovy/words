                        "entry_id": "5879c14f-e89e-3ebf-ad32-e09d823f7754",
                        "glosses": [
                            "Pencher vers un côté latéral de la bouche, en parlant d’une dent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e6170b-b14b-4b04-9f21-c84fc50c5542",
                                "sense_id": "bfeeab6d-c4ee-352f-b682-a75ade5c0344",
                                "text": "Quand vous parlez d'ortho pour ce cas, vous envisagez des traitement multiattache de plusieurs semestres pour tout niveler et recréer une occlusion 'idéalisée', ou juste minivis pour refaire de la place, ingresser/distoverser certaines dents ?"
                            },
                            {
                                "example_id": "4ed00c2b-55f4-4344-8630-fb2de9db1d92",
                                "sense_id": "bfeeab6d-c4ee-352f-b682-a75ade5c0344",
                                "text": "Le plus souvent la seconde prémolaire définitive se distoverse ou effectue une migration distale."
                            }
                        ]
                    }
