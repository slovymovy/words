                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7cf55c3-32df-4794-9e7b-5d5192381f08",
                        "source_entry_id": "fbd0249f-09d3-3e0e-b15d-01e97b0b5173",
                        "source_sense_id": "ca3a9cde-598b-3d04-be8b-416d70fe98f0",
                        "source_sense_description": "het onderste deel van de oorschelp bestaande uit vetweefsel",
                        "target_lang_word": "Ohrläppchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrläppchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                        "entry_id": "33b5366b-838c-3d9f-8010-6a3e7140ae26",
                                        "glosses": [
                                            "unterer, zipfelartiger Teil des (menschlichen) Außenohrs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd38ac67-1375-4a87-9a28-11b884ff40d8",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "Die Blutabnahme über das Ohrläppchen wird besonders bei Kindern angewandt, da dort kaum Nervenzellen vorhanden sind, wodurch der Schmerz des Einstiches gemindert wird."
                                            },
                                            {
                                                "example_id": "b6999e4e-4f62-4116-9abb-f53ddfbe2309",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Warum, warum machten sie das mit Schrella, stellten ihm ein Bein, wenn er zur Pause die Treppe hinunterging; er schlug mit dem Kopf auf die stählerne Treppenkante, der Stahlbügel der Brille bohrte sich ins Ohrläppchen, und viel zu spät kam Wackes mit dem Erste-Hilfe-Kasten aus dem Lehrerzimmer.“"
                                            },
                                            {
                                                "example_id": "523f3c8c-3117-4900-aae5-1672ac7ede17",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Der Brigadier hob das Bierglas, trank in mäßigen Schlucken, setzte das Gefäß ab und zupfte selbstvergessen an der erbsengroßen goldgefaßten Perle, die durch sein linkes Ohrläppchen gestochen war.“"
                                            },
                                            {
                                                "example_id": "abc0a318-3622-47c0-9f81-e2e0ca717daa",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Als relativ unbeeinflußt von der hirnelektrischen Aktivität haben sich die Nasenspitze (N), die äußeren Flächen der Ohrläppchen (A) und die Mastoidpunkte erwiesen.“"
                                            },
                                            {
                                                "example_id": "37575ba5-5689-4d0a-b82d-937be7cc8cbc",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Golub hat angewachsene Ohrläppchen, lächelt gütig aus rundem Gesicht, ist stark, dabei sanft und bei Frauen beliebt.“"
                                            },
                                            {
                                                "example_id": "08f1cde8-540f-4609-8aaf-750143567df6",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Es kamen fast nur alte Leute hierher, Menschen mit schrecklich dünnen Haaren, heiseren Stimmen und zerwachsenen Nasen, mit wäßrigen Augen und großen flaumbedeckten Ohrläppchen.“"
                                            },
                                            {
                                                "example_id": "5534f64c-027b-4a55-8062-05663c8afbae",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Es muß ja einen Menschen schon in die Krankheit führen, wenn er selber so wenig Neues erlebt, sich immerzu wiederholen muß, ein Mann zum Beispiel beißt mich ins Ohrläppchen, aber nicht weil es mein Ohrläppchen ist oder weil er, vernarrt in das Ohrläppchen, unbedingt hineinbeißen muß, sondern er beißt, weil er alle anderen Frauen auch in die Ohrläppchen gebissen hat, in kleine oder größere, in rotblaue, in blasse, in fühllose, in gefühlvolle, es ist ihm völlig gleich, was die Ohrläppchen dazu meinen.“"
                                            },
                                            {
                                                "example_id": "0cbc735f-cfa3-451c-b51f-fcdf84e91909",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Modeschmuck klapperte an Hälsen, Handgelenken und Ohrläppchen.“"
                                            },
                                            {
                                                "example_id": "1ee1a55b-c33c-4b77-b72b-90428f10b6b5",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Brandend, tosend vor Spiritus, mit glühenden Ohrläppchen, rotgeäderten Augen, Wasser im Blick, siedend vor Angefangenem, Alissas naßkalte Lappen fürchtend, ihre lippenkräuselnde Besserwisserei, was mach’ ich jetzt? frägst du, heimgehen, die Kinder küssen, beißen, prügeln, oder Alissa? So bist du, maulst zu mir herauf und hast keine Ahnung, daß ich schon vorgesorgt habe!“"
                                            },
                                            {
                                                "example_id": "bbeb5b7f-06af-424b-a93b-57c81c736f4d",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Über jeden einzelnen möchte sie sich tasten, seine Brusthaare kraulen, ihm in die weichen Ohrläppchen beißen.“"
                                            },
                                            {
                                                "example_id": "341fd2e5-5f5c-4bbe-a542-787c33073fe3",
                                                "sense_id": "8a7eaa4e-885c-31b0-8fe8-a719565a6ab5",
                                                "text": "„Ihr fiel auf, daß sein linkes Ohrläppchen rot und geschwollen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
