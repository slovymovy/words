{
    "word_family": [
        "wait",
        "waiter",
        "waitress",
        "waiterless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3deae8ca-972e-36f1-92db-47f05a046ef6",
                    "sense_definition": "The act of staying or remaining in expectation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "expectation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long <w>waiting</w> for the bus made everyone feel very tired.",
                            "target_lang_translations": {
                                "zh": "大家因为<w>等</w>公交车等了太久，都感到非常疲惫。"
                            }
                        },
                        {
                            "text": "After a short <w>waiting</w> period, the doctor finally called my name.",
                            "target_lang_translations": {
                                "zh": "经过短暂的<w>等候</w>，医生终于叫到了我的名字。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delay",
                        "pause"
                    ],
                    "common_phrases": [
                        "waiting room",
                        "waiting list",
                        "waiting period"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在某处停留或滞留以等待某事发生的状态或过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "等待",
                                "target_lang_sense_clarification": "指为了等待某人或某事而停留的状态。"
                            },
                            {
                                "target_lang_word": "等候",
                                "target_lang_sense_clarification": "较为正式的等待表达。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84690b1d-4412-389a-b502-0b479a341205",
                    "sense_definition": "The act of providing service to guests, especially at a table.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant is famous for its excellent <w>waiting</w> at dinner.",
                            "target_lang_translations": {
                                "zh": "这家餐厅以其晚餐时出色的<w>服务</w>而闻名。"
                            }
                        },
                        {
                            "text": "He learned the art of professional <w>waiting</w> while working at the hotel.",
                            "target_lang_translations": {
                                "zh": "他在酒店工作时学会了专业的<w>侍应</w>技巧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "service",
                        "serving"
                    ],
                    "target_lang_definitions": {
                        "zh": "指为客人提供餐饮服务的工作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "服务",
                                "target_lang_sense_clarification": "指餐厅或酒店提供的餐饮服务。"
                            },
                            {
                                "target_lang_word": "侍应",
                                "target_lang_sense_clarification": "指从事餐饮服务的工作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e76a49cd-60d8-3680-a6bb-86e69bae4391",
                    "sense_definition": "The act of watching or guarding something.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The night <w>waiting</w> by the soldiers ensured the camp remained secure.",
                            "target_lang_translations": {
                                "zh": "士兵们彻夜的<w>守候</w>确保了营地的安全。"
                            }
                        },
                        {
                            "text": "Constant <w>waiting</w> for signs of movement was exhausting for the scouts.",
                            "target_lang_translations": {
                                "zh": "侦察兵们不断地<w>监视</w>是否有动静，这让他们精疲力竭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "watching",
                        "guarding",
                        "observation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指为了观察或守卫某物而进行的监视活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "守候",
                                "target_lang_sense_clarification": "指为了看守或等待某事而停留。"
                            },
                            {
                                "target_lang_word": "监视",
                                "target_lang_sense_clarification": "指为了观察动向而进行的守候。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e405b2a7-5e3a-35b0-afc3-62c5b2cb4bc2",
                    "sense_definition": "Present participle and gerund of <w>wait</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "expectation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been <w>waiting</w> for her friend for over an hour.",
                            "target_lang_translations": {
                                "zh": "她已经<w>等</w>了她的朋友一个多小时了。"
                            }
                        },
                        {
                            "text": "The <w>waiting</w> taxi was parked right outside the front door.",
                            "target_lang_translations": {
                                "zh": "那辆正在<w>等候</w>的出租车就停在前门外。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "waiting for"
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 wait 的现在分词或动名词形式，表示正在进行等待的动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "等",
                                "target_lang_sense_clarification": "表示等待的动作。"
                            },
                            {
                                "target_lang_word": "等待",
                                "target_lang_sense_clarification": "表示等待的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}