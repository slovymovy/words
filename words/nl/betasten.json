                {
                    "sense_id": "23e57eef-d912-3655-bce1-16704fb817ef",
                    "sense_definition": "Met de handen iemands lichaam of een voorwerp aanraken om te voelen, vaak op een ongewenste of intieme manier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man trachtte haar te <w>betasten</w>, maar zij wilde er niets van hebben.",
                            "target_lang_translations": {
                                "en": "The man tried to <w>grope</w> her, but she wanted nothing to do with it."
                            }
                        },
                        {
                            "text": "De beveiliger moest de verdachte grondig <w>betasten</w> om te controleren op verboden voorwerpen.",
                            "target_lang_translations": {
                                "en": "The security guard had to <w>pat down</w> the suspect thoroughly to check for prohibited items."
                            }
