                        "entry_id": "25397b87-3603-3b18-8705-ebf80a490fbe",
                        "glosses": [
                            "żartobliwa gra słów podobnych pod względem brzmienia, ale różniących się znaczeniowo lub dwuznacznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce64a91-6a66-40a3-a6e1-2bbd6db2804f",
                                "sense_id": "dd8b5c32-1269-36b9-9437-e4a2b349173c",
                                "text": "Polska od noża do noża - kalambur sprzed lat autorstwa Jerzego Ludwika Kerna zachował aktualność"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
