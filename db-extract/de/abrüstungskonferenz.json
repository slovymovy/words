                        "form": "die Abrüstungskonferenzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7a5c200-31d6-348f-842d-b20065986b90",
                        "entry_id": "6f0b638b-ebcd-3a5a-b73b-669cc9839c22",
                        "glosses": [
                            "Konferenz, bei der Fragen zum Thema Abrüstung besprochen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deaa9d5a-5b29-4a9f-801f-843570abde1c",
                                "sense_id": "a7a5c200-31d6-348f-842d-b20065986b90",
                                "text": "„In Madrid waren die sowjetischen Vertreter in der Frage der Familienzusammenführung konzessionsbereit, um westliche Zustimmung zu einer Abrüstungskonferenz zu erlangen.“"
                            },
                            {
                                "example_id": "929f3178-53e4-49c6-89f6-e0afa24a7088",
                                "sense_id": "a7a5c200-31d6-348f-842d-b20065986b90",
                                "text": "„Zudem blockiert Pakistan Bemühungen der USA, bei der an das Konsensprinzip gebundenen Abrüstungskonferenz in Genf Verhandlungen über einen Vertrag in Gang zu bringen, der die Produktion von spaltbarem Material für Atomwaffen verbieten soll - ein Kernstück der Abrüstungsinitiative von Präsident Obama.“"
                            },
                            {
                                "example_id": "d989cdad-0b3d-42db-91a4-c91d24cb2c11",
                                "sense_id": "a7a5c200-31d6-348f-842d-b20065986b90",
                                "text": "„Hitler, dem jede Opferrolle Deutschlands recht ist, sieht die Chance für eine riskante und spektakuläre Demonstration deutschen Selbstbewusstseins und verkündet am 14. Oktober 1933 in einer von Friedensbezeugungen durchdrungenen Radiorede den Rückzug aus der Abrüstungskonferenz und den Austritt aus dem Völkerbund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
