                                        "entry_id": "4bfe867f-a1cc-3f16-9100-e2333c47a8c4",
                                        "glosses": [
                                            "legering van ijzer met koolstof, chroom en andere metalen die goed bestand is tegen roestvorming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
