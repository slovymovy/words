                "senses": [
                    {
                        "sense_id": "89de37a8-a05a-304f-95e4-218eb61b4bf3",
                        "entry_id": "6a1022ff-400a-3dd3-821b-e7d0371e1737",
                        "glosses": [
                            "Considérer comme substance."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "469fda5a-c91a-4421-9b6a-7341a30dcfd8",
                                "sense_id": "89de37a8-a05a-304f-95e4-218eb61b4bf3",
                                "text": "L’ancienne physique substantialisait le froid et le chaud."
                            },
                            {
                                "example_id": "2f5cb7dc-6839-4ed2-8171-42c64a1d1728",
                                "sense_id": "89de37a8-a05a-304f-95e4-218eb61b4bf3",
                                "text": "Jusqu’au ciel, la neige avait substantialisé la matière, réinventé le réel, recréé le monde. Chaque hiver, même genèse. Et cette recomposition intégrale disparaîtrait en quelques heures de redoux."
                            }
                        ]
                    }
