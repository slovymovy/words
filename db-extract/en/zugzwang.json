                    },
                    {
                        "form_id": "1dd78bd3-b619-460f-b869-7c11592b9fd0",
                        "entry_id": "e108afc9-043e-3bfb-8ca4-0c8a617f56a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "zugzwänge"
