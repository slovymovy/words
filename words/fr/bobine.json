                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enrouler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier <w>bobine</w> soigneusement le câble de cuivre sur le tambour.",
                            "target_lang_translations": {
                                "en": "The worker carefully <w>winds</w> the copper cable onto the drum.",
                                "ru": "Рабочий аккуратно <w>наматывает</w> медный кабель на барабан.",
                                "de": "Der Arbeiter <w>wickelt</w> das Kupferkabel sorgfältig auf die Trommel <w>auf</w>.",
                                "es": "El obrero <w>bobina</w> cuidadosamente el cable de cobre sobre el tambor.",
                                "zh": "工人小心地把铜缆<w>缠绕</w>到滚筒上。"
                            }
                        },
