                ],
                "translations": [
                    {
                        "translation_id": "f9a8d64e-f340-456a-8d3d-3b8ee80ba25f",
                        "source_entry_id": "d7d89426-f7bf-3cd4-99b3-8a3a93ec62dd",
                        "target_lang_word": "sear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46a9061f-3861-3c24-826d-56341c5fad13",
                                        "entry_id": "97a15b78-a486-39a1-b52f-92ec905482ed",
                                        "glosses": [
                                            "Dry; withered, especially of vegetation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0891bc0f-3a49-463c-bbdd-2d66087b1bf3",
                                                "sense_id": "46a9061f-3861-3c24-826d-56341c5fad13",
                                                "text": "There are in all but three vvayes of going thither [to the moon]. […] [The] third, Old Empedocles vvay; vvho vvhen he leaped into Ætna, having a drie ſeare bodie, and light, the ſmoake took him and vvhift him up into the Moone, vvhere he lives yet vvaving up and dovvne like a feather, all foot and embers comming out of that cole-pit; our Poet met him, and talkt vvith him."
                                            },
                                            {
                                                "example_id": "1e5f5a75-20b9-4ce6-854a-a55c96b78a07",
                                                "sense_id": "46a9061f-3861-3c24-826d-56341c5fad13",
                                                "text": "The autumn winds rushing / Waft the leaves that are searest, / But our flower was in flushing, / When blighting was nearest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "942281fb-19ad-32de-b216-1439701beadc",
                                        "entry_id": "846b1654-1ef9-3ca7-af29-136656876d12",
                                        "glosses": [
                                            "To char, scorch, or burn the surface of (something) with a hot instrument."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e68308aa-2750-43f7-92e0-1111f5909748",
                                                "sense_id": "942281fb-19ad-32de-b216-1439701beadc",
                                                "text": "He likes to sear his steaks while maintaining rareness at the center."
                                            },
                                            {
                                                "example_id": "125ff0e2-d008-4ece-935e-1ef75c10e83e",
                                                "sense_id": "942281fb-19ad-32de-b216-1439701beadc",
                                                "text": "I will sear the skin from your flesh. You will die a thousand deaths!"
                                            },
                                            {
                                                "example_id": "2aabd7b7-a81f-409f-8f88-14a6453ed4cc",
                                                "sense_id": "942281fb-19ad-32de-b216-1439701beadc",
                                                "text": "When you drop the tuna onto the pan, the outside will sear and cook quickly while leaving as much of the center as possible in its raw state."
                                            },
                                            {
                                                "example_id": "c92d6c4a-8f42-415f-afab-ef765ae6ce7a",
                                                "sense_id": "942281fb-19ad-32de-b216-1439701beadc",
                                                "text": "I often will sear steaks, move them to a cooler side, then use the hot side to grill or sauté vegetables, make a sauce in a cast-iron skillet, or grill some fruit for dessert while the steak finishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a57b1c6b-b44d-3c6f-ba92-7710b93f1f6a",
                                        "entry_id": "846b1654-1ef9-3ca7-af29-136656876d12",
                                        "glosses": [
                                            "To wither; to dry up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3257391-6f7c-4b7c-986b-7d234fc285ed",
                                                "sense_id": "a57b1c6b-b44d-3c6f-ba92-7710b93f1f6a",
                                                "text": "The drought was so severe as to sear the grass and the leaves of maple trees which had grown well for two years, standing in sward land by the roadside, and yet the corn, within ten feet, on the subsoiled land, did not roll once in the whole season, even at mid-day, and there was scarcely another piece in the neighborhood which escaped serious injury."
                                            },
                                            {
                                                "example_id": "33deacee-de02-41fe-8803-f6576a1995df",
                                                "sense_id": "a57b1c6b-b44d-3c6f-ba92-7710b93f1f6a",
                                                "text": "The spring and summer of 1936 brought to the Great Plains one of those terrible periodic droughts that sear the crops and convert the “short-grass country” into a desert."
                                            },
                                            {
                                                "example_id": "e1aab085-62d3-4f99-93e6-75206130bb2b",
                                                "sense_id": "a57b1c6b-b44d-3c6f-ba92-7710b93f1f6a",
                                                "text": "The early morning sun had begun to sear the grass."
                                            },
                                            {
                                                "example_id": "a9037598-9608-43cc-9411-116a6509ffa2",
                                                "sense_id": "a57b1c6b-b44d-3c6f-ba92-7710b93f1f6a",
                                                "text": "She might just as easily have been a goddess of the harvest, since the ancient Greeks sowed in the fall and reaped in the spring before the dry heat of summer could sear the crops in the fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e04c8a29-a20e-3578-a72e-326935e89f9b",
                                        "entry_id": "846b1654-1ef9-3ca7-af29-136656876d12",
                                        "glosses": [
                                            "To make callous or insensible."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3ef6fe9-59cd-3ac2-b36d-d46a0d2efdc0",
                                        "entry_id": "846b1654-1ef9-3ca7-af29-136656876d12",
                                        "glosses": [
                                            "To mark permanently, as if by burning."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54b0886e-c397-4895-9592-b219c3a60771",
                                                "sense_id": "b3ef6fe9-59cd-3ac2-b36d-d46a0d2efdc0",
                                                "text": "The events of that day were seared into her memory."
                                            }
                                        ]
                                    }
                                ]
                            },
