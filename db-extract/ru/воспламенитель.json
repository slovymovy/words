                                    {
                                        "sense_id": "88259d8e-019e-342a-817c-a0b97dabb43f",
                                        "entry_id": "20601c85-2d89-341b-81a7-252dce8d4611",
                                        "glosses": [
                                            "A person who lights things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b2604d-98a4-4773-9753-966410c410c7",
                                                "sense_id": "88259d8e-019e-342a-817c-a0b97dabb43f",
                                                "text": "a lighter of lamps"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2180f6b-f839-3162-8a0e-c8330a584bbb",
                                        "entry_id": "20601c85-2d89-341b-81a7-252dce8d4611",
                                        "glosses": [
                                            "A device used to light things, especially a reusable handheld device for creating fire to light cigarettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbf5cab-fed0-45e5-b16a-230994f9585b",
                                                "sense_id": "e2180f6b-f839-3162-8a0e-c8330a584bbb",
                                                "text": "Cigarette in mouth, he clutched his pockets in search of a lighter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lighter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afe28791-3933-3d8d-ae6b-62d12827d703",
                                        "entry_id": "79a8c87a-5a5b-3a5c-bb14-f4e981ed5e48",
                                        "glosses": [
                                            "A flat-bottomed boat for carrying heavy loads across short distances (especially for canals or for loading or unloading larger boats)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb672d3d-7321-4a9a-bb14-ae71af3fb214",
                                                "sense_id": "afe28791-3933-3d8d-ae6b-62d12827d703",
                                                "text": "It is, of course, possible to work only to or from lighters in this way, and such working is not very general in this country, although a certain amount of such overside work is carried on in enclosed docks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lighter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16dd37c1-860d-3046-832c-eca332616a8e",
                                        "entry_id": "cbb5c0af-6a03-387b-a98f-92e18543da5c",
                                        "glosses": [
                                            "To transfer (cargo or passengers) to or from a ship by means of a lighter or other small vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a9d5fb-89b8-400b-9fe6-0f4eb8caaa87",
                                                "sense_id": "16dd37c1-860d-3046-832c-eca332616a8e",
                                                "text": "1900. Report of the Commission Appointed by the President to Investigate the Conduct of the War Department in the War with Spain. Vol. 7, pg. 3227.\nTroops and stores were lightered to the wharves inside the harbor by steamers Orizaba and Berkshire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28cd0414-5c3e-3ddc-ab5d-ce2a6ba2104b",
                                        "entry_id": "cbb5c0af-6a03-387b-a98f-92e18543da5c",
                                        "glosses": [
                                            "To transfer cargo or fuel from (a ship), lightening it to make its draft less or to make it easier to refloat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lighter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cd50599-4360-355a-8485-d4c097608463",
                                        "entry_id": "527108e4-faba-36d0-86be-bb4537680747",
                                        "glosses": [
                                            "comparative form of light: more light"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a045067-6ef7-4c26-8936-a90f58240a3b",
                                                "sense_id": "3cd50599-4360-355a-8485-d4c097608463",
                                                "text": "I prefer a lighter shade of pink."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lighter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20d54645-2070-3366-8379-4876bf7714cc",
                                        "entry_id": "59f9c8c5-4150-337f-86c8-25efe3381fe4",
                                        "glosses": [
                                            "comparative form of light: more light"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8077a88c-914e-448a-aaeb-a199e118a7a5",
                                                "sense_id": "20d54645-2070-3366-8379-4876bf7714cc",
                                                "text": "What happened? You look 10 lbs. lighter!"
                                            },
                                            {
                                                "example_id": "2bc03a56-9b6f-49a0-ac10-48b95616020b",
                                                "sense_id": "20d54645-2070-3366-8379-4876bf7714cc",
                                                "text": "I wish I'd thrown a lighter punch; he's out cold."
                                            },
                                            {
                                                "example_id": "8d31dfa9-c6f4-478e-819f-5b88e8bc0c2a",
                                                "sense_id": "20d54645-2070-3366-8379-4876bf7714cc",
                                                "text": "The way the glare from our engine firehole pulsated, reflecting continuously in the steam, combined with our achievement in keeping level with the lighter train until our metals parted at Wilton, provided another lasting memory."
                                            },
                                            {
                                                "example_id": "f1685792-2fd0-4b7a-847f-df671d59ae2e",
                                                "sense_id": "20d54645-2070-3366-8379-4876bf7714cc",
                                                "text": "It is lighter to handle and more manoeuvrable, and its three caged sides with web straps on the fourth prevent movement of the contents."
                                            },
                                            {
                                                "example_id": "75a2eae3-fa85-4200-a9d4-c4b257ad5294",
                                                "sense_id": "20d54645-2070-3366-8379-4876bf7714cc",
                                                "text": "For example, lightweight construction and Jacobs bogies save weight, and a lighter train uses less power."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
