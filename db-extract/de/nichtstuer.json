                        "examples": [
                            {
                                "example_id": "d8e837cc-c0fe-4996-915d-7ba2d13fcc3c",
                                "sense_id": "ceb62a2c-5861-3e50-9828-52d73ab92328",
                                "text": "„Das war ein dicker Franzose, ein ungebildeter träger Nichtstuer; man sieht jedoch bei einem Franzosen gern darüber hinweg und prüft selten seinen inneren Wert, wenn er sich gut benimmt, anständig kleidet, bei Tisch heiter ist, die Mädchen liebt und sich den Freuden der Tafel verschreibt.“"
                            }
                        ],
