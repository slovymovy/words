        "nl-extract.jsonl": [
            {
                "entry_id": "bc80e63e-685e-3af8-9e42-6c952a529312",
                "word": "toverheks",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cfc73f6c-bd96-4c4a-9416-1be6174450e3",
                        "entry_id": "bc80e63e-685e-3af8-9e42-6c952a529312",
                        "tags": [
                            "plural"
                        ],
                        "form": "toverheksen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7d3364c-1bb8-3fef-8501-bdc1c6c277c5",
                        "entry_id": "bc80e63e-685e-3af8-9e42-6c952a529312",
                        "glosses": [
                            "een vrouwelijke tovenaar als sprookjesfiguur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c008fe5-8e03-41e2-82c8-8a80c9a7c843",
                                "sense_id": "d7d3364c-1bb8-3fef-8501-bdc1c6c277c5",
                                "text": "Het is intussen ook al traditioneel, maar tijdens iedere Gentse Feesten vallen er allerlei aangepaste boottochtjes te maken voor kinderen. Of het nu de Piratenboot en de boot van Hanneke Tanneke Toverheks zijn van Boat in Gent of de Kabouterboot van Gent Watertoerist, ook voor Gentse kinderen valt er in hun eigen stad nog veel te ontdekken vanop het water, en als dat gepaard gaat met een leuk verhaal is dat des te spannender."
                            },
                            {
                                "example_id": "ff1e9ce5-f22b-4677-9d2c-ff95be593e80",
                                "sense_id": "d7d3364c-1bb8-3fef-8501-bdc1c6c277c5",
                                "text": "Deze spiegel is een misleider die fleemt, lispelt en levenskracht uit planten, dieren en mensen zuigt. Soms toont hij even zijn ware aard, dan is hij niet zo eng: zo’n hybride van toverheks en ‘hongerige geest’ uit de Japanse horror die je in het gros van dit soort films tegenkomt – huid van blauwaderkaas, sluik zwart haar, witte ogen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fc45e60-f9ec-3b39-94b8-953e858bb111",
                        "entry_id": "bc80e63e-685e-3af8-9e42-6c952a529312",
                        "glosses": [
                            "oude lelijke vrouw"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25f84716-ecf1-4a44-b638-26c1adcc15b4",
                        "source_entry_id": "bc80e63e-685e-3af8-9e42-6c952a529312",
                        "source_sense_id": "d7d3364c-1bb8-3fef-8501-bdc1c6c277c5",
                        "source_sense_description": "tovenares",
                        "target_lang_word": "witch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "witch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "A person (now usually particularly a woman) who uses magical or similar supernatural powers to influence or predict events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd78377-09fd-4ae3-8418-fcda4b892ecc",
                                                "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                                "text": "He cannot abide the old woman of Brentford; he swears she's a witch."
                                            },
                                            {
                                                "example_id": "74618e99-4e91-47f3-be20-41f8890331b5",
                                                "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                                "text": "It was easy to understand that they were witches, who had turned themselves into ravens."
                                            },
                                            {
                                                "example_id": "91354c5d-eef7-4a01-8ec1-57832fd0ddbf",
                                                "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                                "text": "However, the word \"witch\" came to be applied almost exclusively to women who were believed to achieve their power by making a blood pact with the Devil, sealed with their blood. They were usually old and ugly, and for this reason many unfortunate old ladies, whose only crimes were loneliness and a lack of beauty, went to the stake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83b8936-a954-3c57-bbe3-30f16d8ba562",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "A woman who follows Wicca or similar New Age pagan beliefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291490b4-3204-44e3-93d6-0efb0d2af37d",
                                                "sense_id": "b83b8936-a954-3c57-bbe3-30f16d8ba562",
                                                "text": "To be considered a Witch of a particular tradition you will have to be initiated into that tradition by someone else within that tradition, after following their specific program of study."
                                            },
                                            {
                                                "example_id": "e5ca1ff2-162d-4fa9-857a-b7401d63cb4b",
                                                "sense_id": "b83b8936-a954-3c57-bbe3-30f16d8ba562",
                                                "text": "For many neopagan witch traditions the moon is seen as both a symbol of the Goddess and of the witch's power, symbolically, and the belief is that the full moon is the best time for all acts of magic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727c75a7-5d3f-3b10-b83d-2e497de1f32e",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "An ugly or unpleasant woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c589f1b-af81-4e11-a139-60b0399c38d7",
                                                "sense_id": "727c75a7-5d3f-3b10-b83d-2e497de1f32e",
                                                "text": "I hate that old witch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e86b5f-f25b-3c2d-affa-928082b516ad",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "One who exercises more-than-common power of attraction; a charming or bewitching person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9559fbb0-2f00-38bb-ab0c-e93dbfd27e71",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "One given to mischief, especially a woman or child."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dbe2c37-4b61-3610-a808-1d4fe267917c",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "A certain curve of the third order, described by Maria Agnesi under the name versiera."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb4c4dd-772b-3e66-9a18-0bd4eeeb410b",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "A storm petrel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96628b4a-81df-30de-92a1-9d7d679a7a33",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "Any of a number of flatfish of species:",
                                            "Glyptocephalus cynoglossus, the witch flounder or Torbay sole, found in the North Atlantic."
                                        ],
                                        "tags": [],
