                ],
                "senses": [
                    {
                        "sense_id": "823f6ff5-cfaa-3683-8899-305da7d8b713",
                        "entry_id": "a4dd5d5e-9b9c-3f5d-95d2-a76f846ba32e",
                        "glosses": [
                            "Qualifie un gros mangeur, mangeant de tout."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "47658df4-f0d4-3932-9256-446ea492b29a",
                        "entry_id": "a4dd5d5e-9b9c-3f5d-95d2-a76f846ba32e",
                        "glosses": [
                            "Qualifie un parasite se développant sur plusieurs espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebc39f97-b9e7-4cbc-b4cd-d1e5357cea63",
                                "sense_id": "47658df4-f0d4-3932-9256-446ea492b29a",
                                "text": "La plupart des Claviceps n’attaquent qu’une seule espèce ou un seul genre à l’exception notable de Claviceps purpurea qui est polyphage."
                            }
                        ]
                    },
                    {
                        "sense_id": "932048ec-4aa1-38c9-ba28-ea15ce7a5986",
                        "entry_id": "a4dd5d5e-9b9c-3f5d-95d2-a76f846ba32e",
                        "glosses": [
                            "Qualifie un animal qui se nourrit d’aliments d’origine variée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667ee44b-c3a0-436f-ba1d-ca86eb533f1a",
                                "sense_id": "932048ec-4aa1-38c9-ba28-ea15ce7a5986",
                                "text": "La chenille est polyphage, mais elle préfère le Ricin, le Manioc, l’Anda gomesii."
                            },
                            {
                                "example_id": "088930b9-fe0b-401b-9726-d161f19f4079",
                                "sense_id": "932048ec-4aa1-38c9-ba28-ea15ce7a5986",
                                "text": "Le ragondin présente un régime alimentaire herbivore. C'est un rongeur polyphage qui s'attaque aux bulbes et aux racines des plantes aquatiques en particulier les roseaux. Il aime aussi potamots et laîches, scirpes, trèfles, lentilles d'eau, nénuphars et cultures […]."
                            },
                            {
                                "example_id": "3d681cc7-5438-485d-a733-7fa21bdc5b46",
                                "sense_id": "932048ec-4aa1-38c9-ba28-ea15ce7a5986",
                                "text": "A l’exception de quelques espèces lichénivores, fongivores ou occasionnellement voire exclusivement prédatrices, les larves sont phytophages (généralement oligophage ou monophage). Parmi les espèces nuisibles rencontrées en serres, la majorité sont polyphages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c108762a-b99f-41ff-84b9-44cdfd0f99bd",
                        "source_entry_id": "a4dd5d5e-9b9c-3f5d-95d2-a76f846ba32e",
