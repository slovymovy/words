                    {
                        "translation_id": "d8d3d4bf-70f9-4616-a95e-7ee25b1afa97",
                        "source_entry_id": "f5cd080b-d626-3110-9eae-db16a033a41d",
                        "source_sense_id": "e494faa6-f0c4-35c3-8a6d-478efe8b7f2e",
                        "target_lang_word": "oroscopo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oroscopo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "9a21de23-a258-3fb8-85b3-d2bfd90685ee",
                                        "entry_id": "00d103d4-6850-3ca9-9637-6de3af827f03",
                                        "glosses": [
                                            "nell'astrologia, profezia sul futuro di un individuo, fondata sul rapporto tra la posizione degli astri e l'ora della sua nascita"
                                        ],
                                        "tags": [],
