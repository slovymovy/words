                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a9e8bb-5625-4a22-a86c-ffa421646cff",
                                "sense_id": "fdf33c28-af3a-32f3-9ae7-c9d146829296",
                                "text": "„Die Kombinationsgabe, durch die sich die Klugheit gewöhnlich äußert und der die Phrenologen, wie ich glaube irrtümlich, ein besonderes Organ zugewiesen haben, da sie dieselbe für eine angeborene Fähigkeit halten, ist so häufig bei Menschen, deren Verstand fast an Blödsinn grenzt, wahrgenommen worden, daß die Tatsache die Aufmerksamkeit vieler Gelehrten auf sich gezogen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
