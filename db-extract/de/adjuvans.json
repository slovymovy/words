                "senses": [
                    {
                        "sense_id": "5fafe486-c382-3b2f-8859-f3dbeb593fe9",
                        "entry_id": "12c25c7f-c1bb-3cf8-9898-f05a6687aeef",
                        "glosses": [
                            "Adjuvant : substance destinée à renforcer ou autrement améliorer l’effet d’un médicament ou vaccin."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "59f4b953-14ac-4469-8c8f-edf1dadfe668",
                                "sense_id": "5fafe486-c382-3b2f-8859-f3dbeb593fe9",
                                "text": "Somit kann Ketamin auch ein wichtiges Adjuvans zur Prävention chronisch persistierender Schmerzen, ein Adjuvans im Rahmen einer Opioidtoleranz sowie zur Prävention einer opioidinduzierten Hyperalgesie sein.",
                                "translation": "Ainsi, la kétamine peut également être un adjuvant important pour la prévention des douleurs persistantes chroniques, un adjuvant dans le cadre d’une tolérance aux opioïdes et pour la prévention de l’hyperalgésie induite par les opioïdes."
                            },
                            {
                                "example_id": "550fa608-71ac-4428-afaa-47245e75e626",
                                "sense_id": "5fafe486-c382-3b2f-8859-f3dbeb593fe9",
                                "text": "Dabei stießen sie auf die Strategie der Antigen sparenden Adjuvantia.",
                                "translation": "Ce faisant, ils sont tombés sur la stratégie consistant à utiliser des adjuvants pour réduire les besoins en antigène."
                            },
                            {
                                "example_id": "876d3e56-e67f-4a68-99c7-cc72b4d990fa",
                                "sense_id": "5fafe486-c382-3b2f-8859-f3dbeb593fe9",
                                "text": "Andere Impfstoffe enthalten ebenfalls Adjuvanzien! Ein systematischer Blick auf die Impfstoffe, die Adjuvanzien enthalten, verdeutlicht, wie \"normal\" Adjuvanzien im Versorgungsalltag tatsächlich sind (Tab. 1).",
                                "translation": "D’autres vaccins contiennent également des adjuvants ! Un regard systématique sur les vaccins contenant des adjuvants souligne à quel point les adjuvants sont réellement \"normaux\" dans le quotidien de la distribution [de vaccins] (tableau 1)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
