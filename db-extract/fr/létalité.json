                                "target_word": "Letalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b977d90-c293-3290-a146-090155f18a7a",
                                        "entry_id": "3e2cb320-c13a-3692-985e-ea5f484c47b0",
                                        "glosses": [
                                            "Demografie, Wahrscheinlichkeit, an einer bestimmten Krankheit(s)/Ursache zu sterben"
                                        ],
                                        "tags": [
                                            "Sozialmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93bd3bb0-a462-4b86-a208-dc7789cbea67",
                                                "sense_id": "9b977d90-c293-3290-a146-090155f18a7a",
                                                "text": "Die Letalität ist der Anteil der an einer bestimmten Krankheit in einem bestimmten Zeitraum (meist 1 Jahr) Gestorbenen, bezogen auf die Gesamtanzahl der an der betrachteten Krankheit Erkrankten einer definierten Population."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0423ced0-014f-3037-b655-f9d0d3a1f8a1",
                                        "entry_id": "3e2cb320-c13a-3692-985e-ea5f484c47b0",
                                        "glosses": [
                                            "Tödlichkeit einer bestimmten Erkrankung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa5fb5e-b28c-4831-80df-9cd08f8c023b",
                                                "sense_id": "0423ced0-014f-3037-b655-f9d0d3a1f8a1",
                                                "text": "Dieser Typ der Hirnblutung hat eine Letalität von 50-80%."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
