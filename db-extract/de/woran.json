                        "source_entry_id": "38a39a93-3d54-3890-8668-1170620ff197",
                        "source_sense_id": "c629913b-cfdc-3228-87fa-511f4ee8203f",
                        "source_sense_description": "relativ auf das Gesagte bezogen: daran",
                        "target_lang_word": "which",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "which",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce0bf5e6-f39d-34ff-bae8-02736d8da8f9",
                                        "entry_id": "3681088a-d49b-3501-b8ef-0a61244767d3",
                                        "glosses": [
                                            "And."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25fab742-5662-4085-9713-8c062b49a662",
                                                "sense_id": "ce0bf5e6-f39d-34ff-bae8-02736d8da8f9",
                                                "text": "They only offered me five dollars, which I wouldn’t do it for less than fifteen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "which",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9e388b-f256-3744-9d4c-0cedc45fabdc",
                                        "entry_id": "28a6199c-253f-3bb2-aa73-8d0f98693cd4",
                                        "glosses": [
                                            "What, of those mentioned or implied."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5afad37c-9657-44ae-b781-13caedc5310f",
                                                "sense_id": "ab9e388b-f256-3744-9d4c-0cedc45fabdc",
                                                "text": "Which song shall we play?"
                                            },
                                            {
                                                "example_id": "590761c6-f5ab-44d2-b8ae-33d07dbb1d7f",
                                                "sense_id": "ab9e388b-f256-3744-9d4c-0cedc45fabdc",
                                                "text": "They couldn't decide which song to play."
                                            },
                                            {
                                                "example_id": "59e932de-ba48-436d-ae1b-e846bd98c555",
                                                "sense_id": "ab9e388b-f256-3744-9d4c-0cedc45fabdc",
                                                "text": "Which one is bigger?"
                                            },
                                            {
                                                "example_id": "95ce7d4d-e163-42dd-a967-05f7dd6c2c64",
                                                "sense_id": "ab9e388b-f256-3744-9d4c-0cedc45fabdc",
                                                "text": "Show me which one is bigger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a078a43-6951-3953-b61b-533f65b84ccb",
                                        "entry_id": "28a6199c-253f-3bb2-aa73-8d0f98693cd4",
                                        "glosses": [
                                            "The/Any ... that; whichever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9aeb70c-a067-4df9-8c25-e234a4061901",
                                                "sense_id": "3a078a43-6951-3953-b61b-533f65b84ccb",
                                                "text": "Take which one you want."
                                            },
                                            {
                                                "example_id": "e1027e7e-12e9-4966-8d74-db840373cbf9",
                                                "sense_id": "3a078a43-6951-3953-b61b-533f65b84ccb",
                                                "text": "You may go which way you please."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                        "entry_id": "28a6199c-253f-3bb2-aa73-8d0f98693cd4",
                                        "glosses": [
                                            "Designates the one(s) previously mentioned."
                                        ],
                                        "tags": [
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb48d015-7e0d-4a79-9992-edb339d932a1",
                                                "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                                "text": "After glaring upon the smoking philosopher, who took his misfortunes with such positive nonchalance, he growled out an oath in German, which language is particularly adapted for growling in; then, raising his hand, he dealt him a blow on his pipe, which sent it, like a rocket, into the midst of the players."
                                            },
                                            {
                                                "example_id": "db349d3c-d5fe-4df7-9033-08c17c5b8176",
                                                "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                                "text": "Whitaker’s blog post, housed on a website called Minutes Before Six, goes on to make references to Albert Camus’ 1947 classic, The Plague, dips into a Camus-inspired existential ramble and returns to an attempt to convey the detail of Prieto’s being essentially “noble,” which fact, he admits, will be lost in translation to anyone unfamiliar with death row units."
                                            },
                                            {
                                                "example_id": "daec02ab-30fe-4a27-a2e4-59b7e1f6f4e5",
                                                "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                                "text": "All the phones come in plastic bodies that have been given a brushed-metal finish and carry 64-bit processors from Intel, which fact they proudly announce with an Intel Inside logo on the back."
                                            },
                                            {
                                                "example_id": "b9b43003-6835-487e-bbd1-037b2095073e",
                                                "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                                "text": "He once owned a painting of the house, which painting would later be stolen."
                                            },
                                            {
                                                "example_id": "55f053eb-e40a-4178-b8b0-2c79e08faa14",
                                                "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                                "text": "She only speaks Chinese, which language I can hardly follow."
                                            },
                                            {
                                                "example_id": "ed046f87-62d1-43b2-9cf5-aa6897fe934f",
                                                "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                                "text": "For several seconds he sat in silence, during which time the tea and sandwiches arrived."
                                            },
                                            {
                                                "example_id": "ac49b53d-8a1e-4b97-9b88-fbe95c672875",
                                                "sense_id": "b791d48a-5375-3a6e-a0ae-6d81bf1924f4",
                                                "text": "I'm thinking of getting a new car, in which case I'd get a red one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "which",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d970270a-af96-3c1f-997e-0eeae98abfeb",
                                        "entry_id": "8ad988dd-dc81-3442-96d3-9e1279b11923",
                                        "glosses": [
                                            "What one or ones (of those mentioned or implied)."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c335d5c-c103-49de-82ef-2a5a23833089",
                                                "sense_id": "d970270a-af96-3c1f-997e-0eeae98abfeb",
                                                "text": "Which is which?"
                                            },
                                            {
                                                "example_id": "d93f83de-1bf0-4b28-966e-8932c7241409",
                                                "sense_id": "d970270a-af96-3c1f-997e-0eeae98abfeb",
                                                "text": "By now, you must surely know which is which."
                                            },
                                            {
                                                "example_id": "4bcf24c7-49ae-4639-a6db-205055f8cf39",
                                                "sense_id": "d970270a-af96-3c1f-997e-0eeae98abfeb",
                                                "text": "Which is bigger, the red one or the blue one?"
                                            },
                                            {
                                                "example_id": "eb135aca-4e19-4fd9-ae7b-74068c41a117",
                                                "sense_id": "d970270a-af96-3c1f-997e-0eeae98abfeb",
                                                "text": "I'm unable to determine which is bigger."
                                            },
                                            {
                                                "example_id": "a3760b87-af11-4839-b72b-bec90d3295d4",
                                                "sense_id": "d970270a-af96-3c1f-997e-0eeae98abfeb",
                                                "text": "Which's your spouse? -The one in trousers."
                                            },
                                            {
                                                "example_id": "1ae0aed5-2f18-473a-9597-87bb1e3d69f4",
                                                "sense_id": "d970270a-af96-3c1f-997e-0eeae98abfeb",
                                                "text": "Which of these banes of modern business life is worse remains open to debate. But what is clear is that office workers are on a treadmill of pointless activity. Managers allow meetings to drag on for hours. Workers generate e-mails because it requires little effort and no thought. An entire management industry exists to spin the treadmill ever faster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e0f9deb-c573-3663-a12a-2f6529bf1bc3",
                                        "entry_id": "8ad988dd-dc81-3442-96d3-9e1279b11923",
                                        "glosses": [
                                            "The/Any ones that; whichever."
                                        ],
                                        "tags": [
                                            "not in common use"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d74f6fab-8938-498f-8761-1e5a089d5bee",
                                                "sense_id": "8e0f9deb-c573-3663-a12a-2f6529bf1bc3",
                                                "text": "Please take which you please."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "338fbc18-5147-3697-b28a-c1bfd226165c",
                                        "entry_id": "8ad988dd-dc81-3442-96d3-9e1279b11923",
                                        "glosses": [
                                            "In a non-restrictive relative clause, referring to something previously mentioned.",
                                            "Referring to a preceding noun."
                                        ],
                                        "tags": [
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40349b53-6d24-4de1-a103-5610458baa32",
                                                "sense_id": "338fbc18-5147-3697-b28a-c1bfd226165c",
                                                "text": "I dropped a saucepan, which knocked over the eggs, which went all over the kitchen floor."
                                            },
                                            {
                                                "example_id": "fe8e70f8-61fe-4943-9ef3-a3477a1f384b",
                                                "sense_id": "338fbc18-5147-3697-b28a-c1bfd226165c",
                                                "text": "I found my camera, which I thought I'd lost, under the bed."
                                            },
                                            {
                                                "example_id": "c40204ad-0043-47aa-b4f8-2f126afc0528",
                                                "sense_id": "338fbc18-5147-3697-b28a-c1bfd226165c",
                                                "text": "I entered the room, at the far end of which was a small table."
                                            },
                                            {
                                                "example_id": "4b5cb7c6-ac9d-4bb7-b03f-88d413617d07",
                                                "sense_id": "338fbc18-5147-3697-b28a-c1bfd226165c",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            },
                                            {
                                                "example_id": "1cb2de2a-a7e8-45b9-9595-5ec938e8a7be",
                                                "sense_id": "338fbc18-5147-3697-b28a-c1bfd226165c",
                                                "text": "There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            },
                                            {
                                                "example_id": "3ae0724d-c7eb-4b75-a55c-63abaf80cdb1",
                                                "sense_id": "338fbc18-5147-3697-b28a-c1bfd226165c",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b9c83ca-8f47-3014-84d3-1e76a64bf5a0",
                                        "entry_id": "8ad988dd-dc81-3442-96d3-9e1279b11923",
                                        "glosses": [
                                            "In a non-restrictive relative clause, referring to something previously mentioned.",
                                            "Referring to a preceding noun.",
                                            "Used of people (now generally who, whom, that; which remains possible with words also referred to by it such as baby, child)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46f8f09-e425-402b-903c-27a012178130",
                                                "sense_id": "9b9c83ca-8f47-3014-84d3-1e76a64bf5a0",
                                                "text": "She had a young child, which cried incessantly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a50ed5c-b6ba-394a-abbe-2ff4db39576e",
                                        "entry_id": "8ad988dd-dc81-3442-96d3-9e1279b11923",
                                        "glosses": [
                                            "In a non-restrictive relative clause, referring to something previously mentioned.",
                                            "Referring to a preceding statement."
                                        ],
                                        "tags": [
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7ebe84-84e0-45c8-98c3-158afb649d8d",
                                                "sense_id": "4a50ed5c-b6ba-394a-abbe-2ff4db39576e",
                                                "text": "The front door was open, which concerned me."
                                            },
                                            {
                                                "example_id": "c038da59-369f-4fe8-a04e-758f68e96c5c",
                                                "sense_id": "4a50ed5c-b6ba-394a-abbe-2ff4db39576e",
                                                "text": "He had to leave, which was very difficult."
                                            },
                                            {
                                                "example_id": "bd39c7e0-9c56-4b92-b7da-63c9b4550005",
                                                "sense_id": "4a50ed5c-b6ba-394a-abbe-2ff4db39576e",
                                                "text": "She saved my life, for which I am eternally grateful."
                                            },
                                            {
                                                "example_id": "dadc981e-a12e-4945-8a04-ef96e4257908",
                                                "sense_id": "4a50ed5c-b6ba-394a-abbe-2ff4db39576e",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868d6515-c69e-38c5-b16c-0921536156d5",
                                        "entry_id": "8ad988dd-dc81-3442-96d3-9e1279b11923",
                                        "glosses": [
                                            "In a restrictive relative clause, referring to a noun previously mentioned."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "relative",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34124f71-6fb3-4645-9fc1-e4c69bac96cb",
                                                "sense_id": "868d6515-c69e-38c5-b16c-0921536156d5",
                                                "text": "This is the letter which I received."
                                            },
                                            {
                                                "example_id": "8b6d6c22-ffb3-4bd4-a842-02b5a57344e5",
                                                "sense_id": "868d6515-c69e-38c5-b16c-0921536156d5",
                                                "text": "This is the letter in which he explains his decision."
                                            },
                                            {
                                                "example_id": "719e21a6-dd02-4540-aaa5-df01d437e919",
                                                "sense_id": "868d6515-c69e-38c5-b16c-0921536156d5",
                                                "text": "Forasmuch as many have taken in hand to set forth in order a declaration of those things which are most surely believed among us..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498e36e2-9421-35d8-b3df-a713f464da6a",
                                        "entry_id": "8ad988dd-dc81-3442-96d3-9e1279b11923",
                                        "glosses": [
                                            "In a restrictive relative clause, referring to a noun previously mentioned.",
                                            "Used of people."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "proscribed",
                                            "relative",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2daa0ce2-6f00-4ad1-a462-94481046eb8d",
                                                "sense_id": "498e36e2-9421-35d8-b3df-a713f464da6a",
                                                "text": "The men which acompanyed him on his waye stode amased, for they herde a voyce, butt sawe no man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
