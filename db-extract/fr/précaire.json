                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6dba585-03b9-3f59-91d5-24d2fdb97e8f",
                        "entry_id": "424b752c-f527-3c58-9ed3-0962d26616a9",
                        "glosses": [
                            "Ce dont on ne jouit, dont on n’a l’usage que par une concession toujours révocable au gré de celui qui l’a faite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18961ae2-d1c6-480d-8bd4-9eb80615b183",
                                "sense_id": "b6dba585-03b9-3f59-91d5-24d2fdb97e8f",
                                "text": "Il ne jouit de cette terre que par précaire, qu’à titre de précaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "981197cb-a701-30c8-a5fc-8ba4d0e18634",
                        "entry_id": "424b752c-f527-3c58-9ed3-0962d26616a9",
                        "glosses": [
                            "Personne ayant un statut social précaire (absence de revenus, irrégularité des revenus, précarité de l’emploi, sans domicile fixe, etc.)."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "4f63311a-c39e-4647-9505-b8d78c3a6dad",
                                "sense_id": "981197cb-a701-30c8-a5fc-8ba4d0e18634",
                                "text": "Je suis étudiant, chômeur ou précaire et souhaite m’abonner pour un an et règle la somme de 21 euros."
                            },
                            {
                                "example_id": "2d308871-660d-4582-97ed-f008c58ea438",
                                "sense_id": "981197cb-a701-30c8-a5fc-8ba4d0e18634",
                                "text": "Les sans-travail et les précaires ne sont pas que les protagonistes auxquels l’actualité ne cesse de nous ramener."
                            }
                        ]
                    }
                ],
