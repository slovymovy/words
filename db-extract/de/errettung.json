                ],
                "senses": [
                    {
                        "sense_id": "7dd39f23-cf92-3b34-bc6e-37a322a2b12e",
                        "entry_id": "3607026c-2729-35d9-94b4-c9d1e9f21c99",
                        "glosses": [
                            "Befreiung, Rettung (aus einer Notlage, einer gefährlichen Situation)"
                        ],
                        "tags": [
                            "heute gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "241479ba-c89b-450d-907c-59c4797d7344",
                                "sense_id": "7dd39f23-cf92-3b34-bc6e-37a322a2b12e",
                                "text": "„So ist derwegen hoch noth / daß wir elende Würmlein in diesem schmeltz vnd probier Ofen mehr vmb gedult vnnd stillhalten / als vmb errettung bitten.“"
                            },
                            {
                                "example_id": "9b57d7f7-170e-492d-bd99-736064a1e87a",
                                "sense_id": "7dd39f23-cf92-3b34-bc6e-37a322a2b12e",
                                "text": "„Alle Straßen bis Wien waren mit Fliehenden angefüllt, die sich nicht eher als in der Kaiserstadt von ihrem Schrecken erholten. Maradas selbst, an Prags Errettung verzweifelnd, folgte den übrigen, und führte seine kleine Mannschaft bis Tabor, wo er den Ausgang erwarten wollte.“"
                            },
                            {
                                "example_id": "53ff79d7-4c9e-4f80-a07f-918104e7a802",
                                "sense_id": "7dd39f23-cf92-3b34-bc6e-37a322a2b12e",
                                "text": "„Wer auf nichts hofft als auf die Errettung des Abendlandes, muss in der Möglichkeit seines Untergangs ein auswegloses Grauen finden.“"
                            },
                            {
                                "example_id": "b7058044-0c9b-4eda-94dd-2dbf6cad59d0",
                                "sense_id": "7dd39f23-cf92-3b34-bc6e-37a322a2b12e",
                                "text": "„Wer sich um die Errettung eines Menschenlebens ein Verdienst erworben hat, wird ausgezeichnet.“"
                            },
                            {
                                "example_id": "a2b8e29d-1c8a-4ff5-87bf-b5ec65fb62eb",
                                "sense_id": "7dd39f23-cf92-3b34-bc6e-37a322a2b12e",
                                "text": "„Um der Errettung aus existentieller Verzweiflung willen ging er 1875 zum Studium nach Basel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
