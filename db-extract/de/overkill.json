                ],
                "senses": [
                    {
                        "sense_id": "82d3c643-a3b8-30e4-9a8c-7169aecbaf60",
                        "entry_id": "69f19bb1-bfca-330f-b105-12d9b90b58df",
                        "glosses": [
                            "Zustand, in dem ein oder mehrere Staaten über mehr Waffen, insbesondere Atomwaffen, verfügen, als für die völlige Vernichtung des Gegners nötig wären"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff6c86ad-09e7-36ff-ac76-0fc4e136559a",
                        "entry_id": "69f19bb1-bfca-330f-b105-12d9b90b58df",
                        "glosses": [
                            "übermäßige Versorgung und/oder übermäßiges Angebot"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "106b779f-1579-47db-a136-83c2390792f4",
                                "sense_id": "ff6c86ad-09e7-36ff-ac76-0fc4e136559a",
                                "text": "„Die letzten Tage waren für uns ein religiöser und abergläubischer Overkill.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e664c39e-0636-3e2b-ac46-89d1939aeda2",
                        "entry_id": "69f19bb1-bfca-330f-b105-12d9b90b58df",
                        "glosses": [
                            "Tötungsdelikt mit übermäßig viel Gewalt"
                        ],
                        "tags": [
                            "Kriminologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c510872b-fa1e-4c52-bf21-484dea771798",
                                "sense_id": "e664c39e-0636-3e2b-ac46-89d1939aeda2",
                                "text": "„Manche Täter versuchen, ihre Tat symbolisch wiedergutzumachen, indem sie ihr Opfer waschen oder zudecken. Oder sie begehen einen Overkill: Der Mensch ist längst tot, doch der Täter drischt wieder und wieder auf sein Opfer ein.“"
                            },
                            {
                                "example_id": "1777308c-6dc0-465b-ba98-2523aa8a5e94",
                                "sense_id": "e664c39e-0636-3e2b-ac46-89d1939aeda2",
                                "text": "„Da hat sich in einem Overkill der ganze Frust seines Lebens entladen – stellvertretend für alle Kränkungen, die er schon erlebt hat.“"
                            },
                            {
                                "example_id": "07d73a85-c6c4-4087-b69b-59e42aa1fbb8",
                                "sense_id": "e664c39e-0636-3e2b-ac46-89d1939aeda2",
                                "text": "„Es war ein Overkill, ein Übertöten, wie es die Kriminologen nennen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eb2645e-ff72-44a7-844e-1929981b7a8f",
                        "source_entry_id": "69f19bb1-bfca-330f-b105-12d9b90b58df",
                        "source_sense_id": "82d3c643-a3b8-30e4-9a8c-7169aecbaf60",
                        "target_lang_word": "overkill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overkill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27753381-649f-3ccf-8fa0-f864a620aef9",
                                        "entry_id": "a101c853-8c1c-3ed1-9913-311a20f76f7d",
                                        "glosses": [
                                            "A destructive capacity that exceeds that needed to destroy an enemy; especially with nuclear weapons."
                                        ],
                                        "tags": [
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d61d5680-b1c7-4500-b3a7-3aeb80a4bca9",
                                                "sense_id": "27753381-649f-3ccf-8fa0-f864a620aef9",
                                                "text": "[The] increase in nuclear missiles available to the West was operationally unnecessary and would only add to the existing nuclear overkill; mixed manning was a formula for military disaster; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05b9f030-dcfb-33f5-8758-527763f1f2bf",
                                        "entry_id": "a101c853-8c1c-3ed1-9913-311a20f76f7d",
                                        "glosses": [
                                            "Destruction beyond what is necessary to kill, especially in murder."
                                        ],
                                        "tags": [
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bda3e75-cac2-47f9-aa86-f06a16b6f94f",
                                                "sense_id": "05b9f030-dcfb-33f5-8758-527763f1f2bf",
                                                "text": "Bodies that have been stabbed or shot multiple times—far beyond what was sufficient to kill the victim (overkill)— suggest that the victim and assailant knew each other, […]"
                                            },
                                            {
                                                "example_id": "4a6723c3-6af1-4683-85f5-9ddbcec55777",
                                                "sense_id": "05b9f030-dcfb-33f5-8758-527763f1f2bf",
                                                "text": "For some killers with a great deal of love/hate for their victims, it [an edged weapon] is the perfect instrument for a maniacal overkill."
                                            },
                                            {
                                                "example_id": "04006713-0961-4696-8308-bb9ac5dd8bd4",
                                                "sense_id": "05b9f030-dcfb-33f5-8758-527763f1f2bf",
                                                "text": "\"Trans people generally don't get stabbed once; they get stabbed 20 times, shot, burned and thrown into a dumpster.\" […] Their killers, in displaying an especially virulent form of hatred, often went from murder to overkill, attempting to obliterate their victims, perhaps in an attempt to erase them completely, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60306e99-18e1-353d-ae80-33cf86105de7",
                                        "entry_id": "a101c853-8c1c-3ed1-9913-311a20f76f7d",
                                        "glosses": [
                                            "An unnecessary excess of whatever is needed to achieve a goal."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "897b177c-3a8f-4822-8794-c25022986979",
                                                "sense_id": "60306e99-18e1-353d-ae80-33cf86105de7",
                                                "text": "24 hours of TV coverage of the US election verged on overkill."
                                            },
                                            {
                                                "example_id": "a20290a5-fec4-4a4e-b725-35b90b7d635d",
                                                "sense_id": "60306e99-18e1-353d-ae80-33cf86105de7",
                                                "text": "Should I give you yet more homework, or would that be overkill?"
                                            },
                                            {
                                                "example_id": "ecfea13f-7c70-4dc5-bf5a-b5b69926c8a1",
                                                "sense_id": "60306e99-18e1-353d-ae80-33cf86105de7",
                                                "text": "This is a live concert album, a good choice because it allows for simpler instrumental backup and avoids the studio overkill that would be inappropriate for such a forthright album."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "048b623e-f3ea-3388-87e3-4a3a41583f00",
                                        "entry_id": "a101c853-8c1c-3ed1-9913-311a20f76f7d",
                                        "glosses": [
                                            "An unnecessary excess of disposal because of too high criteria of inspection."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "overkill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d78d0627-4ab4-3f16-8168-506dac961371",
                                        "entry_id": "dc079edc-fc77-3b4f-89d0-32526900a5c0",
                                        "glosses": [
                                            "To destroy something with more (nuclear) force than is required."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4f77ce8-5837-3967-a14a-c41c56696493",
                                        "entry_id": "dc079edc-fc77-3b4f-89d0-32526900a5c0",
                                        "glosses": [
                                            "To dispose of too many items because of too-high criteria of inspection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67c1a3ad-b750-3082-8710-eda171cc5aaa",
                                        "entry_id": "dc079edc-fc77-3b4f-89d0-32526900a5c0",
                                        "glosses": [
                                            "To do something excessive to achieve a goal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
