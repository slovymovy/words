                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "16c90d09-4cf6-4289-8e66-0be8bdc6e995",
                        "entry_id": "6f5848f0-d7d2-39eb-b1aa-6ea249a1d52e",
                        "tags": [
                            "plural"
                        ],
                        "form": "interlockings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93afc340-a633-34c7-bb20-dd196db43793",
                        "entry_id": "6f5848f0-d7d2-39eb-b1aa-6ea249a1d52e",
                        "glosses": [
                            "An arrangement of signal apparatus that prevents conflicting movements through a set of intersecting tracks, such as junctions or crossings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975bea84-35a1-4bfd-b49c-39bba3531749",
                                "sense_id": "93afc340-a633-34c7-bb20-dd196db43793",
                                "text": "There was still no attempt to arrange interlocking between points and signals; that came later. In 1856, John Saxby carried out the principle involved in interlocking—the prevention of signals and points being in conflicting positions—and erected apparatus to do that at this same junction."
                            },
                            {
                                "example_id": "32653870-bb98-4541-9f2e-ff38c28e480e",
                                "sense_id": "93afc340-a633-34c7-bb20-dd196db43793",
                                "text": "In addition to the usual interlocking between conflicting signal and point levers achieved by electric locks, track circuits, when occupied, hold signals governing entry to the relevant line at danger; [...] The up main through inner home signal was held at danger by interlocking, because the track circuits of a conflicting route ahead of it were occupied by another train [...]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b26da8f-9460-48af-b100-74fa5875735b",
                        "source_entry_id": "6f5848f0-d7d2-39eb-b1aa-6ea249a1d52e",
                        "source_sense_id": "93afc340-a633-34c7-bb20-dd196db43793",
                        "source_sense_description": "arrangement of signal apparatus",
                        "target_lang_word": "Stellwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stellwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                        "entry_id": "c28064b5-4acf-3999-9728-eded15a2c85c",
                                        "glosses": [
                                            "„[…] eine Bahnanlage der Eisenbahn, von der aus Einrichtungen im und am Schienenfahrweg, wie Weichen und Signale, zur Durchführung von Zugfahrten und beim Rangieren zentral gestellt werden“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a408baa7-4b02-4209-aa02-1472a43ddb45",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "Stellwerke dürfen nur von speziell dafür ausgebildeten Personen bedient werden."
                                            },
                                            {
                                                "example_id": "3899f838-5af0-4f51-b9a2-99a532af00c4",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "„15.000 Fahrgäste waren laut ÖBB am Freitag von den Zugverspätungen durch den Kabelbrand im Stellwerk betroffen.“"
                                            },
                                            {
                                                "example_id": "be5c66be-162f-4c48-a402-9d3e9d9c95d0",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "„In einigen Stellwerken müssen Signale noch über mechanische Hebel gestellt werden, das ist nicht unbedingt ein moderner Arbeitsplatz.“"
                                            },
                                            {
                                                "example_id": "1f1c3e47-d1d4-43b3-af15-d6d48bd113f9",
                                                "sense_id": "9e6024b7-31f0-393d-b278-9328b0ce084e",
                                                "text": "„Die Modernisierung der Stellwerke gehe langsamer voran als gedacht, und »Arbeitsplätze mit veralteter technischer Ausstattung« seien für viele junge Leute »nicht hinreichend attraktiv«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
