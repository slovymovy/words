                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82152bfa-c0c1-44ae-beb7-25be5d1648fd",
                                                "sense_id": "f86312fb-cba6-333f-928f-f7a7ef9e9cf0",
                                                "text": "Inigo wzruszył ramionami. Wskutek tego ruchu coś srebrzystego wystrzeliło mu z rękawa; była to starannie ukształtowana klinga, wyściełana z jednej strony i ustawiająca się wzdłuż kantu dłoni."
                                            },
                                            {
                                                "example_id": "3cb57119-bfc9-4dd5-8b65-24ba92ffd42b",
                                                "sense_id": "f86312fb-cba6-333f-928f-f7a7ef9e9cf0",
                                                "text": "Inżynier Jaworski ukształtował nasze wszystkie postulaty w formie listu otwartego do prezesa."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "38947418-46b7-3dec-97e7-13ee8ae47d1f",
                                        "entry_id": "5bf82bdd-99df-35d5-86b4-ab048c5a673e",
                                        "glosses": [
                                            "wpłynąć na coś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39b898cc-332e-4db7-8f82-a4cc1a5e84ad",
                                                "sense_id": "38947418-46b7-3dec-97e7-13ee8ae47d1f",
                                                "text": "Biedny głupi skurwysyn, któremu się wydawało, że otaczającą go rzeczywistość można wykorzystać, ukształtować wedle jego woli, kontrolować i regulować."
                                            },
                                            {
                                                "example_id": "0d1073d2-34f1-4ff4-99c5-5d1fcf9a9b96",
                                                "sense_id": "38947418-46b7-3dec-97e7-13ee8ae47d1f",
                                                "text": "W wywiadzie dla jednego z regionalnych dzienników artysta przyznał, że jego światopogląd ukształtowała nie tyle szkoła, co dziadkowie i ulubione lektury."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
