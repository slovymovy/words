                    },
                    {
                        "form_id": "1e08b9a0-8b57-4838-9935-ec5ef2e6aee3",
                        "entry_id": "197be838-7a20-3cdd-9908-723ad5156356",
                        "tags": [
                            "Plus courant"
                        ],
                        "form": "punching ball"
                    },
                    {
                        "form_id": "844c58f2-fbfc-4f7b-9c16-0b1716a7a5f6",
                        "entry_id": "197be838-7a20-3cdd-9908-723ad5156356",
                        "tags": [
                            "Québec"
                        ],
                        "form": "punching bag"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "add4a86e-bcaa-3bd4-b34b-61068fb7cbf5",
                        "entry_id": "197be838-7a20-3cdd-9908-723ad5156356",
                        "glosses": [
                            "Gros ballon maintenu au sol ou attaché au plafond sur lequel s’entraîne un boxeur."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "09142712-c7f2-4318-9ffa-45fd058e31fd",
                                "sense_id": "add4a86e-bcaa-3bd4-b34b-61068fb7cbf5",
                                "text": "Il se détourna, comme un homme qui a dû apprendre à renoncer, presque comme un malade que tout contact brutal effraie ; et quand, traversant le cabinet de toilette contigu, il passa devant un punching-ball qui y était suspendu, il lui donna un coup d’une rapidité et d’une violence telles qu’on n’en voit guère dans une humeur résignée ou dans un état de faiblesse."
                            },
                            {
                                "example_id": "cc0289bb-4748-4096-a79b-76b8ffca6de2",
                                "sense_id": "add4a86e-bcaa-3bd4-b34b-61068fb7cbf5",
                                "text": "Il m’emmena sur le court de tennis, me proposa d’échanger quelques balles, m’écrasa, et s’excusa avec désinvolture de m’avoir utilisée comme punching-ball."
                            },
                            {
                                "example_id": "a87bf0d8-d5dc-496f-99f5-59f73e00afdf",
                                "sense_id": "add4a86e-bcaa-3bd4-b34b-61068fb7cbf5",
                                "text": "12 juillet 1941 – Je suis comme un punching-ball qui vient de recevoir deux gifles, l’une à droite, l’autre à gauche. Je suis revenue au milieu et j’arbore un sourire idiot."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4a6e881-2a59-3b09-bc00-52adece5682c",
                        "entry_id": "197be838-7a20-3cdd-9908-723ad5156356",
                        "glosses": [
                            "Objet ou personne qui sert à passer sa colère."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7ce06946-c1ff-4345-83f3-b0f28d4cb4df",
                                "sense_id": "a4a6e881-2a59-3b09-bc00-52adece5682c",
                                "text": "Il tenta d’abord d’éviter la poigne de Vieillard, en sautant de table en table. Mais ce jeu risquant de surexciter le sous-off, Simon, résigné, s’offrit comme punching-ball."
                            },
                            {
                                "example_id": "6ce0f12d-b9fb-4923-9875-76eaa8929f20",
                                "sense_id": "a4a6e881-2a59-3b09-bc00-52adece5682c",
                                "text": "En attendant cette France aux yeux bridés, Pat et Henri savourèrent ce Paris jailli de ses ruines, et son visage qui, demain, reprendrait son office de punching-ball."
                            },
                            {
                                "example_id": "a7320db4-57a7-455a-aaae-0aa3402e7f28",
                                "sense_id": "a4a6e881-2a59-3b09-bc00-52adece5682c",
                                "text": "En vol, certains se vengent sur les PNC, premier punching-ball humain après enregistrement sur bornes automatiques."
                            },
                            {
                                "example_id": "abd01a2d-a45b-4eac-9eb9-f1496e0bed7d",
                                "sense_id": "a4a6e881-2a59-3b09-bc00-52adece5682c",
                                "text": "- Nous autres, punching-balls, nous ne prenons jamais rien personnellement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab509c61-cebf-40e2-af9b-13be33925a53",
                        "source_entry_id": "197be838-7a20-3cdd-9908-723ad5156356",
                        "target_lang_word": "Sandsack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandsack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14d5bc47-1605-3f9f-aa3f-b675c3bb2606",
                                        "entry_id": "14c59fe4-2ec8-35d9-9c6d-a5be2eef3993",
                                        "glosses": [
                                            "mit Sand gefüllter Sack, bestehend aus Naturfasern oder Kunststoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1baabc81-4bc5-4c03-b5f7-77978cc11729",
                                                "sense_id": "14d5bc47-1605-3f9f-aa3f-b675c3bb2606",
                                                "text": "Die verheerende Flutwelle wird durch Sandsäcke gestoppt, damit die Stadt vor der Überflutung verschont bleibt."
                                            },
                                            {
                                                "example_id": "9f123849-f019-497b-bd87-585b3a01f85e",
                                                "sense_id": "14d5bc47-1605-3f9f-aa3f-b675c3bb2606",
                                                "text": "„Val dichtete währenddessen die zugigen Fenster mit Sandsäcken aus einem nie zu Ende gebauten Gewächshaus ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2b92cc6-73c8-3206-a382-b02a2eb77abe",
                                        "entry_id": "14c59fe4-2ec8-35d9-9c6d-a5be2eef3993",
                                        "glosses": [
                                            "Trainingsgerät, unter anderem für Boxer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "479e4169-e9ae-4841-bcf2-25085445c990",
                                                "sense_id": "a2b92cc6-73c8-3206-a382-b02a2eb77abe",
                                                "text": "Der Boxer trainiert jeden Tag am Sandsack."
                                            },
                                            {
                                                "example_id": "35ccf4f5-a819-4c59-96c0-51ebea0b8b32",
                                                "sense_id": "a2b92cc6-73c8-3206-a382-b02a2eb77abe",
                                                "text": "„Unter den Bäumen war ein Ring aufgebaut, in dem die Kämpfer bei gutem Wetter trainierten, und im Tanzsaal gab es einen großen und einen kleinen Sandsack und eine Matte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9074f4b5-1855-424f-bd40-80f973fdaa1f",
