                                            {
                                                "example_id": "01008544-f395-43a0-9c39-27b1353a7667",
                                                "sense_id": "ab25dd98-644b-3e16-9def-36f0cfdd1a0c",
                                                "text": "In the wind he chilled quickly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d67e58-498a-3dee-b898-3cb5acd3e92a",
                                        "entry_id": "59a1b2a2-469c-3ad1-a0e5-5e997e2c41bc",
                                        "glosses": [
                                            "To harden a metal surface by sudden cooling."
                                        ],
