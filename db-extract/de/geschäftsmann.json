                                                "sense_id": "7d971495-c995-30f2-8bfd-4d1f8f5b0e33",
                                                "text": "I'm not a businessman, I'm a business, man"
                                            },
                                            {
                                                "example_id": "dd71e9e8-cc96-4878-aef4-6cb1360fbf22",
                                                "sense_id": "7d971495-c995-30f2-8bfd-4d1f8f5b0e33",
                                                "text": "BERTIE Ahern's explanation that he received an envelope stuffed with £8,000 in cash following a whip-around by a group of Manchester-based businessmen was branded untrue by the Mahon Tribunal."
                                            },
                                            {
                                                "example_id": "d9d569cb-1f71-4a8b-bb4b-36b680800643",
                                                "sense_id": "7d971495-c995-30f2-8bfd-4d1f8f5b0e33",
                                                "text": "Needless to say the obituaries for Hefner, even if they acknowledge the seaminess, have been full of encomia for his great deeds: Hef the vanquisher of puritanism, Hef the political progressive, Hef the great businessman and all the rest."
                                            }
