                        "glosses": [
                            "a crybaby, a child that weeps often and long"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a19fc383-82c3-4ddc-beb1-206e9f7e756a",
                                "sense_id": "64c4ce93-82fe-30b2-ac7e-927cf1f1aaff",
                                "text": "De kinderopvang werd bevolkt door huilebalken.",
                                "translation": "The daycare was populated by crybabies.",
                                "english": "The daycare was populated by crybabies."
                            }
                        ]
                    },
                    {
                        "sense_id": "136897b9-33a8-3212-be64-30652fc5f142",
                        "entry_id": "714b1c83-6fa2-3390-98e8-65d98dcd16c7",
                        "glosses": [
                            "any weepy person, regardless of age"
                        ],
                        "tags": [
                            "broadly",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ca28c27d-17be-41db-9e7d-140b2debfac7",
                                "sense_id": "136897b9-33a8-3212-be64-30652fc5f142",
                                "text": "Wees niet zo'n huilebalk, de tandarts is er niet om je kwaad te doen.",
                                "translation": "Don't be such a crybaby, the dentist doesn't intend to harm you.",
                                "english": "Don't be such a crybaby, the dentist doesn't intend to harm you."
                            }
                        ]
                    },
                    {
