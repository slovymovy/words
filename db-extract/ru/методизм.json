                "senses": [
                    {
                        "sense_id": "847db967-ebb0-33e6-bec9-0866d3933157",
                        "entry_id": "f92dfbfb-111d-3cbd-a6b3-e6c6d4004d10",
                        "glosses": [
                            "религ. направление в протестантизме, возникшее в Англии в первой четверти XVIII в. и получившее распространение в США, Канаде и некоторых других странах и основанное на требованиях последовательного и методичного соблюдения евангельских предписаний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2d1cbb5-6007-42bb-91c1-8f1090a881b5",
                                "sense_id": "847db967-ebb0-33e6-bec9-0866d3933157",
                                "text": "В методизме, в сравнении с другими течениями протестантизма, мало внимания уделяется догматике, поэтому он легко эволюционирует под воздействием окружающей культуры."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "add0cbe3-70c9-435a-a917-9ddff78f90c4",
                        "source_entry_id": "f92dfbfb-111d-3cbd-a6b3-e6c6d4004d10",
                        "source_sense_id": "847db967-ebb0-33e6-bec9-0866d3933157",
                        "target_lang_word": "Methodism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Methodism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1874bc90-dec0-3f80-bf5a-def979573ccf",
                                        "entry_id": "0f921ce1-4d0a-31f0-9091-c090c85dc675",
                                        "glosses": [
                                            "The Methodist Christian movement founded by John Wesley in 18th-century England."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e20e770a-96cc-4037-9722-0b81d813f4c3",
                                                "sense_id": "1874bc90-dec0-3f80-bf5a-def979573ccf",
                                                "text": "Far more Yankees shifted to Methodism, an eighteenth-century splinter from the Anglican Church with an emphasis on effecting social change[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5109fc29-3562-39a3-8b25-cffb55730764",
                                        "entry_id": "0f921ce1-4d0a-31f0-9091-c090c85dc675",
                                        "glosses": [
                                            "Any of several related movements."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
