                    {
                        "translation_id": "ee6cd990-ce68-49c1-b06b-77b86df6eefe",
                        "source_entry_id": "499b4043-5ae4-323a-b72f-1920557e7331",
                        "source_sense_id": "bb60ea90-95bf-3282-b0a9-d227a5449163",
                        "target_lang_word": "given name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "given name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75d6296e-6e2b-38f4-b692-bdf145114581",
                                        "entry_id": "e626379a-649c-3061-b71a-8c18a5039ac3",
                                        "glosses": [
                                            "A personal name chosen for a child, usually by their parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0302f4f-75ec-4fe8-9a07-e3175dc39a86",
                                                "sense_id": "75d6296e-6e2b-38f4-b692-bdf145114581",
                                                "text": "Japan: Use family names first, followed by given names, but be aware that some may introduce themselves to Westerners with their given name first."
                                            },
                                            {
                                                "example_id": "d4695489-728c-478d-9073-46625e40743d",
                                                "sense_id": "75d6296e-6e2b-38f4-b692-bdf145114581",
                                                "text": "This may explain why some Chinese Americans write their Chinese name backwards. For example, the Chinese characters to Ching Tien Chay′s name show that his given name is really Tien Ching."
                                            },
                                            {
                                                "example_id": "b3658f55-e5a1-4927-9a6d-f43866c6fdc8",
                                                "sense_id": "75d6296e-6e2b-38f4-b692-bdf145114581",
                                                "text": "In one experiment, the researchers had people rate the characteristics of people with various given names or nicknames.[…]A person with a nickname like Liz, for example, would probably be rated as friendlier and more popular than a person with the given name Elizabeth, but Elizabeth would probably be rated more intelligent and trustworthy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e25dca56-2ea8-3296-be33-c43b05a5a59f",
                                        "entry_id": "e626379a-649c-3061-b71a-8c18a5039ac3",
                                        "glosses": [
                                            "A name bestowed by oneself or another, as opposed to the name given by one's parents."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c581ced3-25ff-4e62-9293-b73b70d2ba9e",
                                                "sense_id": "e25dca56-2ea8-3296-be33-c43b05a5a59f",
                                                "text": "Professor: Lady Bird, is that your given name?\nChristine \"Lady Bird\" McPherson: Yeah.\nProfessor: Why is it in quotes?\nChristine \"Lady Bird\" McPherson: I gave it to myself, it’s given to me by me."
