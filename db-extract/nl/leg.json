                                "example_id": "131aee74-a959-4852-9175-c42acc91d90d",
                                "sense_id": "0c8470dd-e052-3c86-8048-eb4dace189e2",
                                "text": "Ik leg mijn hoofd zachtjes tegen haar schouder."
