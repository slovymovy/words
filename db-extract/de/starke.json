                    }
                ],
                "senses": [
                    {
                        "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                        "entry_id": "caf0aca7-4ac6-34db-9c54-9192b2c858e6",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb80781-6b4e-44c8-9355-f46106bfde00",
                                "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                                "text": "Frau Starke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cbb74639-f285-434d-adeb-86a6e361c95a",
                                "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                                "text": "Herr Starke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0e341c0c-23b5-4bd8-ad37-061413234f9e",
                                "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                                "text": "Die Starkes kommen heute aus Speyer."
                            },
                            {
                                "example_id": "d576fb00-7aa5-461a-9dc2-23df5cf444be",
                                "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                                "text": "Der Starke trägt nie die Schals, die die Starke ihm strickt."
                            },
                            {
                                "example_id": "665c0212-548d-44ea-9e7a-8cd88926976d",
                                "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Starke kommt, geht der Herr Starke.“"
                            },
                            {
                                "example_id": "e1f53d6e-b4dc-4c43-8ce5-f4f64da3e2f8",
                                "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                                "text": "Starke kommt und geht."
                            },
                            {
                                "example_id": "496b9c0e-4c27-4196-a9ed-0b21da6394ae",
                                "sense_id": "b418aca4-0147-3c44-bc82-9c4979c5d20c",
                                "text": "Starkes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b9dd5a7f-47de-44f8-9a8a-d8b4a240a0a2",
