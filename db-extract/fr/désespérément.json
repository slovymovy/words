        "fr-extract.jsonl": [
            {
                "entry_id": "1d035e2b-b63e-3b5a-8e68-07d34cf91174",
                "word": "désespérément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb923b1f-5d0e-3309-8d83-9488137de294",
                        "entry_id": "1d035e2b-b63e-3b5a-8e68-07d34cf91174",
                        "glosses": [
                            "D’une façon désespérée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf666480-546f-4512-8243-4ff75cfa15ed",
                                "sense_id": "fb923b1f-5d0e-3309-8d83-9488137de294",
                                "text": "Les autres apprennent à guérir les âmes par des austérités pénibles ; mais vous montrez que celles qu’on aurait crues le plus désespérément malades se portent bien."
                            },
                            {
                                "example_id": "a08f854c-b25d-4fa6-ab39-ddc2f3123e95",
                                "sense_id": "fb923b1f-5d0e-3309-8d83-9488137de294",
                                "text": "Sous un ciel fuligineux et sur une mer furieuse, un voilier démâté fuyait la tempête, donnant fortement de la bande, luttant désespérément contre l’assaut d’énormes vagues bondissantes qui se ruaient, secouant leurs crinières écumantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2a6f02f-100b-309b-bc82-7b90e44a894f",
                        "entry_id": "1d035e2b-b63e-3b5a-8e68-07d34cf91174",
                        "glosses": [
                            "Avec excès, surtout avec l’idée de manquer d’espoir dans le succès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41dc3ca5-0bdd-4eba-8038-dae0bb1b63cc",
                                "sense_id": "c2a6f02f-100b-309b-bc82-7b90e44a894f",
                                "text": "J’étais maintenant, en ces après-midi du samedi, un jeune homme désespérément amoureux, un crétin absolu totalement indifférent à quoi que ce soit d’autre dans le monde."
                            },
                            {
                                "example_id": "8493213a-1ef9-4c49-9fff-2131f7516305",
                                "sense_id": "c2a6f02f-100b-309b-bc82-7b90e44a894f",
                                "text": "J'ai désespérément besoin d'une douche. Je suis à deux doigts de faire couler l'eau quand j'entends frapper à la porte d'entrée. Je grognasse en regardant la pendule :"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fc7223d-5411-4468-b02c-7cf3643e0e80",
                        "source_entry_id": "1d035e2b-b63e-3b5a-8e68-07d34cf91174",
                        "source_sense_id": "fb923b1f-5d0e-3309-8d83-9488137de294",
                        "source_sense_description": "D’une façon désespérée.",
                        "target_lang_word": "desperately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desperately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                        "entry_id": "201c2a18-25ef-3219-a873-3d0355d80b3a",
                                        "glosses": [
                                            "In a desperate manner; without regard to danger or safety; recklessly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b4dbaf1-29e3-418c-8788-2209b2cf705d",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "She desperately grabbed at the nearby branches as she heard the branch she was standing on start to snap."
                                            },
                                            {
                                                "example_id": "10aa771e-1f1c-49bb-b59c-628d71b57706",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "I could desperately do with some coffee right now."
                                            },
                                            {
                                                "example_id": "2b29c36e-c0f6-4e56-bb73-5dd5f85be965",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "I just need you miserably\nBroken man come to me\nI just need you desperately\nJust want to change your mind"
                                            },
                                            {
                                                "example_id": "0e6038a9-4b1b-46d7-a026-c146a70eaa71",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "The patient, who lumbers painfully, has a question: She desperately wants a knee replacement, but doesn’t understand why three doctors have rejected her. Ms. Purdie translates doctorspeak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc0f83c-4037-337d-89f2-8859a4998db3",
                                        "entry_id": "201c2a18-25ef-3219-a873-3d0355d80b3a",
                                        "glosses": [
                                            "extremely"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbc634c-6489-48a2-8242-dd101638dbb5",
                                                "sense_id": "6fc0f83c-4037-337d-89f2-8859a4998db3",
                                                "text": "The race for silver medal was desperately close, they needed a photo finish to separate the runners."
                                            },
                                            {
                                                "example_id": "9de48c6f-1858-4b90-9c0b-5fedaa32435c",
                                                "sense_id": "6fc0f83c-4037-337d-89f2-8859a4998db3",
                                                "text": "They would be surprised to discover that we're all actually fighting for the same thing; that is, the sacredness of human love. The trouble is, they have almost every one of their facts totally and desperately wrong. Those who would lecture us on the \"immorality\" of our lives don't know the first thing about how we actually live them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b08f463a-dea4-4e39-b7e1-7ce65a7df355",
                        "source_entry_id": "1d035e2b-b63e-3b5a-8e68-07d34cf91174",
                        "source_sense_id": "c2a6f02f-100b-309b-bc82-7b90e44a894f",
                        "source_sense_description": "Avec excès, surtout avec l’idée de manquer d’espoir dans le succès.",
                        "target_lang_word": "hopelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hopelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89fe2876-50d7-3d02-85ad-ae8998a1ecd5",
                                        "entry_id": "5606bb62-fff3-3a9e-8397-c8ba1edbabff",
                                        "glosses": [
                                            "In a manner showing no hope"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "991b8a38-131e-4a29-942e-fecdfdcc29e9",
                                                "sense_id": "89fe2876-50d7-3d02-85ad-ae8998a1ecd5",
                                                "text": "The whole covey of victims was thus netted; the household ruin was thus full and orbicular; and in that proportion the tendency of men and women, flutter as they might, would be helplessly and hopelessly to sink into the all-conquering hands of the mighty murderer."
                                            },
                                            {
                                                "example_id": "55d79b6a-68ce-4896-a409-72692310972a",
                                                "sense_id": "89fe2876-50d7-3d02-85ad-ae8998a1ecd5",
                                                "text": "Crouch had earlier hopelessly miskicked an excellent volleyed chance from eight yards out after a delightful Pennant cross."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
