                "senses": [
                    {
                        "sense_id": "3835f4db-2545-3536-9075-ebe36f8ca7e7",
                        "entry_id": "47a44e0e-d5ce-3783-9a01-872c23612249",
                        "glosses": [
                            "Stellenwertsystem zur Basis fünf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7603b6-4ac3-4144-b68b-252a80db1916",
                                "sense_id": "3835f4db-2545-3536-9075-ebe36f8ca7e7",
                                "text": "„Bezüglich des Zehnersystems habe eine Zahl die Darstellung 47. Gesucht ist die Darstellung dieser Zahl im Fünfersystem.“"
                            },
                            {
                                "example_id": "d1165c4d-85b7-4199-8897-083164bbc479",
                                "sense_id": "3835f4db-2545-3536-9075-ebe36f8ca7e7",
                                "text": "„Da beim Erreichen der 5 im Fünfersystem eine neue Stufenzahl auftritt, benötigt man die Ziffern 0, 1, 2, 3 und 4.“"
                            },
                            {
                                "example_id": "d5f09a50-fa90-4076-8dfd-01f6ae0c2d6d",
                                "sense_id": "3835f4db-2545-3536-9075-ebe36f8ca7e7",
                                "text": "„Wie von Daniel und anderen angekündigt, hat Gott zweidimensionale Prophetien gesandt, die durch zwei parallel verlaufende Zahlensysteme dargestellt werden: das eine ist ein Siebener-, das andere ein Fünfersystem.“"
                            },
                            {
                                "example_id": "22d6bd75-b318-43af-bece-e0af4009825b",
                                "sense_id": "3835f4db-2545-3536-9075-ebe36f8ca7e7",
                                "text": "„Ursprünglich weite Verbreitung hatte das Fünfersystem, welches noch heute in den Indianersprachen im nördlichen Teil des südamerikanischen Kontinents sowie in vielen afrikanischen Sprachen lebendig ist.“"
                            },
                            {
                                "example_id": "25fbc920-5be6-4ba1-b336-d68ff1327fbe",
                                "sense_id": "3835f4db-2545-3536-9075-ebe36f8ca7e7",
                                "text": "„Die Fünf wird Basis des Fünfersystems: 10, 15, 20 … 30 … 50, 100, 1000.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
