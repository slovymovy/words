                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическая процедура для волос, делающая их кудрявыми или прямыми на длительный период."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перманент",
