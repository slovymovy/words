                    },
                    {
                        "form_id": "e0f9d4f1-1d1c-4c2e-9fbe-6a481ade4576",
                        "entry_id": "e1b20784-8339-3be1-a1d3-4c9b3968cf57",
                        "tags": [],
                        "form": "civette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7df0297-caa3-3e50-ba3a-9beaa4e55032",
                        "entry_id": "e1b20784-8339-3be1-a1d3-4c9b3968cf57",
                        "glosses": [
                            "Ciboule, plante bulbeuse de la famille des Liliacées, dont les feuilles sont utilisées comme condiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c374c387-a75f-482a-9255-640bc1114ca3",
                                "sense_id": "d7df0297-caa3-3e50-ba3a-9beaa4e55032",
                                "text": "Et puis, elle murmure, en des poses lascives,\nMais sans songer à mal : — L’oignon, l’ail et les cives,\nCela donne la faim au lieu de l’apaiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "6eb80c97-8c2d-3687-97ab-716c066a4690",
                        "entry_id": "e1b20784-8339-3be1-a1d3-4c9b3968cf57",
                        "glosses": [
                            "Disque de verre obtenu par la méthode de soufflage en plateau."
                        ],
                        "tags": [
                            "Verrerie"
                        ],
                        "examples": [
                            {
                                "example_id": "acef42d5-ec87-4ca4-8ee5-820a2cd4ec2e",
                                "sense_id": "6eb80c97-8c2d-3687-97ab-716c066a4690",
                                "text": "Autour de l’arcature court un motif de pampres et de dragons. De chaque côté, d’autres espaces fermés par des vitrages blancs formés de cives rondes."
                            },
                            {
                                "example_id": "914d8886-20cc-480e-b2c7-813a3e496403",
                                "sense_id": "6eb80c97-8c2d-3687-97ab-716c066a4690",
                                "text": "Les glaces de grandes dimensions, les vitres parfaitement incolores ont été substituées aux anciennes cives, aux vitraux colorés d’autrefois, aux vitres verdâtres, souvent défectueuses, et nous ne nous en plaindrons pas."
                            }
                        ]
                    }
