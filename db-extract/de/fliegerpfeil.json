                        "entry_id": "5a752471-08ca-30df-8be0-1e9514c846ce",
                        "glosses": [
                            "Waffe im Ersten Weltkrieg: kurzer Metallpfeil, der vom Flugzeug/Zeppelin aus abgeworfen werden konnte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00cef35f-8282-475c-a5ea-3ebc645e6c76",
                                "sense_id": "e9bb72b5-0e03-31de-be60-99aac2ad700d",
                                "text": "„Im 1. Krieg hätten sie ja noch Fliegerpfeile gehabt, sagte mein Vater und mischte.“"
                            },
                            {
                                "example_id": "3745ce2a-93e3-49cf-a948-9a0fddb9da9a",
                                "sense_id": "e9bb72b5-0e03-31de-be60-99aac2ad700d",
                                "text": "„Darum war das mein erster Fliegerpfeil; aber Bomben und Maschinengewehrschüsse hört man ganz anders, und ich wußte sofort, womit ich es zu tun hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
