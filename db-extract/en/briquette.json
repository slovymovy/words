                        "target_lang_word": "Brikett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brikett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d164fadc-bf37-3456-9af1-dd0b7447b5f6",
                                        "entry_id": "20e26865-43fd-32d1-9955-c56b6a0c40da",
                                        "glosses": [
                                            "geformtes Stück Brennmaterial"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7114b7f7-2e2b-43ab-9097-85ce82e6a0b7",
                                                "sense_id": "d164fadc-bf37-3456-9af1-dd0b7447b5f6",
                                                "text": "Mit Briketts kann man den Herd lange am Brennen halten."
                                            },
                                            {
                                                "example_id": "3876b0f4-a9e9-4d24-b464-91b955cea6e4",
                                                "sense_id": "d164fadc-bf37-3456-9af1-dd0b7447b5f6",
                                                "text": "„Als Bergmann bekam er jedes Jahr den Keller mit Briketts und Eierkohlen vollgemacht.“"
                                            },
                                            {
                                                "example_id": "9e7b8807-bf47-4960-9362-8e0b91eed5f1",
                                                "sense_id": "d164fadc-bf37-3456-9af1-dd0b7447b5f6",
                                                "text": "„Sie mussten Holz oder Briketts mitbringen, damit das Schulgebäude wenigstens angewärmt werden konnte.“"
                                            },
                                            {
                                                "example_id": "9f8ff30c-24a6-4cbd-a8e0-e1f8c57b4fee",
                                                "sense_id": "d164fadc-bf37-3456-9af1-dd0b7447b5f6",
                                                "text": "„Damals konntest du froh sein, wenn dich ein Pferdefuhrwerk mitnahm, das Briketts oder Kunstdünger vom Kleinbahnhof holte oder Kartoffeln hinbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
