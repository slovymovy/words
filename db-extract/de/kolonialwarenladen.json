                "senses": [
                    {
                        "sense_id": "88138c16-1090-3eb5-a197-c203abea6758",
                        "entry_id": "d5a43412-a0fc-36d6-bc98-42203d89fa02",
                        "glosses": [
                            "colonial goods shop (shop with goods imported from German or other European colonies)"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "7aa67811-2786-40d2-ba50-0aa062521961",
                                "sense_id": "88138c16-1090-3eb5-a197-c203abea6758",
                                "text": "Räumt in den Familien auf, in den kleinen Konferenzzimmern der Schulen, unter der Kundſchaft der Kolonialwarenläden, in den Portierslogen – da iſt Arbeit –!",
                                "translation": "Change needs to come from within families, from within the small conference rooms in schools, from among the customers of the colonial goods shops, from within the porter’s lodges – that’s where you have to work on change –!",
                                "english": "Change needs to come from within families, from within the small conference rooms in schools, from among the customers of the colonial goods shops, from within the porter’s lodges – that’s where you have to work on change –!"
                            },
                            {
                                "example_id": "043eb390-1bf8-4b99-bfcd-5d419add1e9a",
                                "sense_id": "88138c16-1090-3eb5-a197-c203abea6758",
                                "text": "Ciotka deutete auf einen Kolonialwarenladen ein paar Häuser weiter, auf der anderen Straßenseite.",
                                "translation": "Ciotka pointed to a colonial goods shop a few doors down, on the other side of the street.",
                                "english": "Ciotka pointed to a colonial goods shop a few doors down, on the other side of the street."
                            }
                        ]
                    },
