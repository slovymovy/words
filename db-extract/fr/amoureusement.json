                                        "entry_id": "7bec18cf-55ae-35d5-b9db-c68be771ea4f",
                                        "glosses": [
                                            "In an amorous or loving manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc79a80b-0a87-42d5-9c63-1fea24aa21ab",
                                                "sense_id": "5f6824d8-4ef9-33cf-a9fb-1e4530767c8e",
                                                "text": "A unique anti-aphrodisiac was the heart of a turtle carried in a wolf's skin. It prevented a person from ever being tempted amorously."
                                            }
