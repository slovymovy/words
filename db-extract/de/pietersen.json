                ],
                "senses": [
                    {
                        "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                        "entry_id": "8f3b00ba-7ccd-32c0-8786-807e3ca8ffd2",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f82b14c1-f0ed-47a6-980f-023d7659788b",
                                "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                                "text": "Frau Pietersen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f3a2afd3-7f1b-4def-b723-f2774e7ae1af",
                                "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                                "text": "Herr Pietersen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "79304027-b3bf-433e-a617-b899e8f777c8",
                                "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                                "text": "Die Pietersens fliegen heute nach Belgrad."
                            },
                            {
                                "example_id": "3bb65ec5-b177-4b9c-a288-0450c68b026d",
                                "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                                "text": "Der Pietersen trägt nie die Schals, die die Pietersen ihm strickt."
                            },
                            {
                                "example_id": "ec2e0bd1-c680-47b8-9324-ae9eb2061e14",
                                "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pietersen kommt, geht der Herr Pietersen.“"
                            },
                            {
                                "example_id": "d6178b0b-c5bb-4546-8e3a-f79318e3c47a",
                                "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                                "text": "Pietersen kommt und geht."
                            },
                            {
                                "example_id": "cd5f3c36-441c-4d3c-8491-b6d3b6d64a4e",
                                "sense_id": "2dd938e0-b953-39c4-9fac-71baa32fc1e7",
                                "text": "Pietersens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
