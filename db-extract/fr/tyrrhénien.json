                                    {
                                        "sense_id": "09067cf5-535c-3198-b0f8-9639360ec802",
                                        "entry_id": "45f9dea2-3517-3489-b6cf-68426a32fe11",
                                        "glosses": [
                                            "Of the languages of the Tyrrhenian family: Etruscan, Raetic or Lemnian."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7de6426-a907-30df-9cf8-ced7580aabdd",
                                        "entry_id": "45f9dea2-3517-3489-b6cf-68426a32fe11",
                                        "glosses": [
                                            "Of or relating to the Tyrrhenian Sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "865c5150-47f1-4af7-b627-287cf66e33fe",
                                                "sense_id": "d7de6426-a907-30df-9cf8-ced7580aabdd",
                                                "text": "This word [mufrone, 'mouflon'] has no Latin etymology and, especially since it specifically refers to animals endemic to the Tyrrhenian islands, it is suspect of being of pre-Roman origin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tyrrhenian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "499c2ea5-446c-3087-852b-57920dab9e1e",
                                        "entry_id": "2ba731a6-737a-303a-bf9a-7a3fceb25763",
                                        "glosses": [
                                            "An Etruscan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65748589-aeba-496c-af0d-310be2e86b1d",
                                                "sense_id": "499c2ea5-446c-3087-852b-57920dab9e1e",
                                                "text": "Among the ancient Tyrrhenians also mixoscopy was prevalent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tyrrhenian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad198a95-c79e-3d84-9072-da788281194a",
                                        "entry_id": "c333ec7e-4d53-3828-8af2-3deaf99c3ccc",
                                        "glosses": [
                                            "A proposed extinct language family consisting of Etruscan, Raetic and Lemnian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "217cd0a3-6cfc-424b-a24f-c7a2f1cc96e0",
                                                "sense_id": "ad198a95-c79e-3d84-9072-da788281194a",
                                                "text": "Nuragic and Etruscan would have been introduced to Sardinia and Etruria ca. 1000 BCE from Anatolia. More specifically, the putative introduction of Tyrrhenian in these places, as well as in Corsica, the Balearic islands and the Iberian Peninsula is connected to a so-called \"thalassocracy\" and ensuing colonization by the Lydian people of Anatolia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
