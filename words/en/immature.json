                    "sense_id": "4ff0832f-0cc0-344b-b157-0da13de9db89",
                    "sense_definition": "Childish in behavior; juvenile.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop being so <w>immature</w> and listen to what I am saying.",
