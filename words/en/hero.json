{
    "word_family": [
        "heroic",
        "heroism",
        "heroine",
        "antihero",
        "superhero"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4fdb6d8-275c-39e5-b04f-ee279872b3e3",
                    "sense_definition": "A person who is admired for their great bravery, courage, or noble qualities.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "brave_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighter became a local <w>hero</w> after saving the family from the burning building.",
                            "target_lang_translations": {
                                "ru": "Пожарный стал местным <w>героем</w> после спасения семьи из горящего здания."
                            }
                        },
                        {
                            "text": "He is a true <w>hero</w> who risked his own life to help others during the flood.",
                            "target_lang_translations": {
                                "ru": "Он настоящий <w>герой</w>, который рискнул собственной жизнью, чтобы помочь другим во время наводнения."
                            }
                        }
                    ],
                    "synonyms": [
                        "lionheart",
                        "worthy",
                        "the brave"
                    ],
                    "antonyms": [
                        "coward"
                    ],
                    "common_phrases": [
                        "true hero",
                        "war hero",
                        "local hero"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, вызывающий восхищение своей исключительной храбростью, мужеством или благородными качествами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "герой",
                                "target_lang_sense_clarification": "человек, совершивший подвиг"
                            },
                            {
                                "target_lang_word": "героиня",
                                "target_lang_sense_clarification": "женщина, проявившая отвагу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b55b65d-7c55-3c6d-949b-5da0bfd2537b",
                    "sense_definition": "A person who is admired and used as an example for others to follow.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "brave_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father has always been my personal <w>hero</w> because of his hard work and kindness.",
                            "target_lang_translations": {
                                "ru": "Мой отец всегда был моим личным <w>кумиром</w> благодаря своему трудолюбию и доброте."
                            }
                        },
                        {
                            "text": "Many young athletes look up to him as a childhood <w>hero</w> and role model.",
                            "target_lang_translations": {
                                "ru": "Многие молодые атлеты равняются на него как на <w>героя</w> своего детства и образец для подражания."
                            }
                        }
                    ],
                    "synonyms": [
                        "good guy"
                    ],
                    "common_phrases": [
                        "personal hero",
                        "childhood hero",
                        "unsung hero"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которым восхищаются и которого ставят в пример другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кумир",
                                "target_lang_sense_clarification": "объект восхищения и подражания"
                            },
                            {
                                "target_lang_word": "герой",
                                "target_lang_sense_clarification": "образец для подражания"
                            },
                            {
                                "target_lang_word": "идеал",
                                "target_lang_sense_clarification": "совершенный образец"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c904823-c298-3c84-b0da-42dd5fc10167",
                    "sense_definition": "The main male character in a story, movie, or play, who usually has good qualities.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protagonist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the final chapter, the <w>hero</w> of the story finally defeats the dragon.",
                            "target_lang_translations": {
                                "ru": "В последней главе <w>герой</w> истории наконец побеждает дракона."
                            }
                        },
                        {
                            "text": "The audience cheered when the <w>hero</w> saved the city from the villain.",
                            "target_lang_translations": {
                                "ru": "Зрители ликовали, когда <w>герой</w> спас город от злодея."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "villain",
                        "antihero"
                    ],
                    "common_phrases": [
                        "hero of the story",
                        "tragic hero",
                        "romantic hero"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главное действующее лицо мужского пола в литературном произведении, фильме или пьесе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главный герой",
                                "target_lang_sense_clarification": "центральный персонаж"
                            },
                            {
                                "target_lang_word": "персонаж",
                                "target_lang_sense_clarification": "действующее лицо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3277d7f9-b8ad-311b-84f6-6f7ace7588ad",
                    "sense_definition": "A very large sandwich filled with various meats, cheeses, and vegetables, served on a long roll.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sandwich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a giant <w>hero</w> sandwich with extra ham and provolone for lunch.",
                            "target_lang_translations": {
                                "ru": "На обед я заказал гигантский <w>сэндвич</w> с двойной порцией ветчины и провиолоне."
                            }
                        },
                        {
                            "text": "We shared a massive Italian <w>hero</w> while watching the football game.",
                            "target_lang_translations": {
                                "ru": "Мы съели на двоих огромный итальянский <w>саб</w> во время просмотра футбольного матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "sub"
                    ],
                    "common_phrases": [
                        "hero sandwich",
                        "italian hero"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой сэндвич на длинной булке с разнообразной начинкой из мяса, сыра и овощей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "большой сэндвич",
                                "target_lang_sense_clarification": "на длинном батоне"
                            },
                            {
                                "target_lang_word": "саб",
                                "target_lang_sense_clarification": "разновидность длинного бутерброда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1007954c-4db5-3014-9fde-7039af694aa6",
                    "sense_definition": "In poker, the player from whose perspective a hand is being described or analyzed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this hand, the <w>hero</w> decides to call the bet despite having a weak pair.",
                            "target_lang_translations": {
                                "ru": "В этой раздаче <w>хиро</w> решает уравнять ставку, несмотря на слабую пару."
                            }
                        },
                        {
                            "text": "The <w>hero</w> has a pair of kings and faces a large raise from the opponent.",
                            "target_lang_translations": {
                                "ru": "У <w>героя</w> пара королей, и он сталкивается с крупным рейзом от оппонента."
                            }
                        }
                    ],
                    "antonyms": [
                        "villain"
                    ],
                    "target_lang_definitions": {
                        "ru": "В покере — игрок, с чьей позиции описывается или анализируется раздача."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хиро",
                                "target_lang_sense_clarification": "игрок, от лица которого идет разбор"
                            },
                            {
                                "target_lang_word": "герой",
                                "target_lang_sense_clarification": "в покерном анализе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff19a086-73eb-3c6f-8db7-02c7943e1d4a",
                    "sense_definition": "The specific item or product selected to be the main focus of a professional photograph or film scene.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The food stylist spent hours preparing the <w>hero</w> product for the commercial shoot.",
                            "target_lang_translations": {
                                "ru": "Фуд-стилист потратил часы на подготовку <w>основного</w> продукта для рекламной съемки."
                            }
                        },
                        {
                            "text": "Make sure no one eats the <w>hero</w> burger before the photographer finishes the session.",
                            "target_lang_translations": {
                                "ru": "Следите, чтобы никто не съел <w>главный</w> бургер, пока фотограф не закончит сессию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hero product",
                        "hero food"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "advertising and film industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный предмет или продукт, выбранный в качестве основного объекта профессиональной фото- или киносъемки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главный объект",
                                "target_lang_sense_clarification": "в кадре"
                            },
                            {
                                "target_lang_word": "герой-продукт",
                                "target_lang_sense_clarification": "основной товар в рекламе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef91aa8c-cb8d-319d-9125-46c081799726",
                    "sense_definition": "A large, prominent image or section at the top of a webpage, designed to grab the user's attention.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer placed a high-resolution <w>hero</w> image at the top of the homepage.",
                            "target_lang_translations": {
                                "ru": "Дизайнер разместил <w>главное</w> изображение в высоком разрешении в верхней части главной страницы."
                            }
                        },
                        {
                            "text": "We need to update the <w>hero</w> section to highlight our new summer collection.",
                            "target_lang_translations": {
                                "ru": "Нам нужно обновить <w>центральный</w> блок, чтобы выделить нашу новую летнюю коллекцию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hero image",
                        "hero section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное, заметное изображение или блок в верхней части веб-страницы, предназначенное для привлечения внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "герой-баннер",
                                "target_lang_sense_clarification": "главное изображение сайта"
                            },
                            {
                                "target_lang_word": "хиро-имидж",
                                "target_lang_sense_clarification": "центральный визуальный блок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea4a0b0a-9f15-3f98-abc4-7dd91fd15b74",
                    "sense_definition": "The primary or most important ingredient in a culinary dish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef explained that the fresh lobster should be the <w>hero</w> of the dish.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар объяснил, что свежий лобстер должен быть <w>основой</w> блюда."
                            }
                        },
                        {
                            "text": "In this recipe, the wild mushrooms are the <w>hero</w> and provide all the flavor.",
                            "target_lang_translations": {
                                "ru": "В этом рецепте лесные грибы являются <w>главным</w> ингредиентом и задают весь вкус."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hero of the dish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной или самый важный ингредиент в кулинарном блюде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа блюда",
                                "target_lang_sense_clarification": "главный ингредиент"
                            },
                            {
                                "target_lang_word": "центр композиции",
                                "target_lang_sense_clarification": "в кулинарии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29f8e466-a3d6-36b0-a9b0-c5ffb10cb39c",
                    "sense_definition": "To behave in a brave or noble manner, or to perform the role of a protagonist.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the afternoon <w>heroing</w> around the neighborhood, helping elderly residents with their groceries.",
                            "target_lang_translations": {
                                "ru": "Весь день он <w>геройствовал</w> по соседству, помогая пожилым жителям с продуктами."
                            }
                        },
                        {
                            "text": "Stop <w>heroing</w> and let the professionals handle this dangerous situation.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>геройствовать</w> и позволь профессионалам разобраться с этой опасной ситуацией."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя храбро или благородно, либо исполнять роль главного героя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "геройствовать",
                                "target_lang_sense_clarification": "вести себя как герой"
                            },
                            {
                                "target_lang_word": "строить из себя героя",
                                "target_lang_sense_clarification": "часто иронично"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2a4bd6b-2799-3433-838b-c85e17e13a49",
                    "sense_definition": "To speak of or represent someone with great praise and admiration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media <w>heroed</w> the young scientist for her groundbreaking discovery in medicine.",
                            "target_lang_translations": {
                                "ru": "СМИ <w>героизировали</w> молодую ученую за ее революционное открытие в медицине."
                            }
                        },
                        {
                            "text": "He was <w>heroed</w> by his peers for his unwavering commitment to justice.",
                            "target_lang_translations": {
                                "ru": "Коллеги <w>превозносили</w> его за непоколебимую приверженность справедливости."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить о ком-либо или представлять кого-либо с великой похвалой и восхищением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "героизировать",
                                "target_lang_sense_clarification": "представлять в героическом свете"
                            },
                            {
                                "target_lang_word": "превозносить",
                                "target_lang_sense_clarification": "чрезмерно хвалить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf14421b-3e40-359e-852f-a5f5ea6fd196",
                    "sense_definition": "To draw significant attention to a specific feature or item; to highlight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing campaign <w>heroed</w> the new safety features of the family car.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая кампания <w>акцентировала</w> внимание на новых функциях безопасности семейного автомобиля."
                            }
                        },
                        {
                            "text": "The exhibition <w>heroed</w> the artist's early sketches rather than his famous paintings.",
                            "target_lang_translations": {
                                "ru": "Выставка <w>выделяла</w> ранние наброски художника, а не его знаменитые картины."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать значительное внимание к определенной функции или предмету; выделять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акцентировать",
                                "target_lang_sense_clarification": "выделять главное"
                            },
                            {
                                "target_lang_word": "выдвигать на первый план",
                                "target_lang_sense_clarification": "делать акцент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0af3601c-2276-315a-bd77-3195c8ac1adf",
                    "sense_definition": "A female given name of Greek origin.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "In Shakespeare's play, <w>Hero</w> is the daughter of Leonato and the lover of Claudio.",
                            "target_lang_translations": {
                                "ru": "В пьесе Шекспира <w>Геро</w> — дочь Леонато и возлюбленная Клавдио."
                            }
                        },
                        {
                            "text": "She decided to name her daughter <w>Hero</w> after the character in the classic myth.",
                            "target_lang_translations": {
                                "ru": "Она решила назвать дочь <w>Геро</w> в честь персонажа классического мифа."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя греческого происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Геро",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74fab2f9-691d-3c29-9adf-f8b7653ea1f6",
                    "sense_definition": "A figure from Greek mythology, specifically the priestess of Aphrodite who loved Leander.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "The tragic story of <w>Hero</w> and Leander has inspired poets for centuries.",
                            "target_lang_translations": {
                                "ru": "Трагическая история <w>Геро</w> и Леандра веками вдохновляла поэтов."
                            }
                        },
                        {
                            "text": "According to the myth, <w>Hero</w> threw herself into the sea after Leander drowned.",
                            "target_lang_translations": {
                                "ru": "Согласно мифу, <w>Геро</w> бросилась в море после того, как Леандр утонул."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Персонаж греческой мифологии, жрица Афродиты, возлюбленная Леандра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Геро",
                                "target_lang_sense_clarification": "мифологический персонаж"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}