                ],
                "senses": [
                    {
                        "sense_id": "c95a8497-7772-3455-94b4-b7463d7ccc7d",
                        "entry_id": "450c5a69-6a5f-3e77-b55c-a0a27784f2b6",
                        "glosses": [
                            "starkes Seil, das zum Ziehen eines Fahrzeuges verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fb3f744-3eba-4e2c-a705-ebf20fe7ae88",
                                "sense_id": "c95a8497-7772-3455-94b4-b7463d7ccc7d",
                                "text": "Das alte Schiff wurde mit einem Schlepptau zurück in den Hafen gebracht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f7b5c5a9-544d-3f20-bf65-dcc3860c5cbb",
                        "entry_id": "450c5a69-6a5f-3e77-b55c-a0a27784f2b6",
                        "glosses": [
                            "langes Seil bei einem Heißluftballon, das als Hilfe bei der Landung zum Boden herabgelassen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254d76ef-58ad-4bf2-89f9-fab47e9236fc",
                                "sense_id": "f7b5c5a9-544d-3f20-bf65-dcc3860c5cbb",
                                "text": "Das Schlepptau wurde herabgeworfen und schon fing der Ballon an, langsamer zu sinken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                        "entry_id": "450c5a69-6a5f-3e77-b55c-a0a27784f2b6",
                        "glosses": [
                            "Person oder Gruppe, die sich jemandem anschließt, jemanden begleitet, beisteht oder auch von einem anderen abhängig ist"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3487e6ca-db5d-4a1b-a824-91c0f73abdb7",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "Der weltberühmte Sportler hat tausende Fans im Schlepptau."
                            },
                            {
                                "example_id": "a97cf0f3-53cc-4851-9397-f597cd65b202",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "Die mächtigen Politiker wollten das arme Volk in ihr Schlepptau nehmen."
                            },
                            {
                                "example_id": "868f5a2b-1dca-433d-acb4-b810ab0bb70d",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "Er ist in das Schlepptau seiner Feinde geraten."
                            },
                            {
                                "example_id": "1fd7f107-ec7a-4d59-a340-dfa44adba6d1",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "„Der deutsche Profi, hauptberuflich in Diensten der Buffalo Sabres, flog im Schlepptau der Nordamerikaner vergangene Woche nach Riga.“"
                            },
                            {
                                "example_id": "74aa9bf5-7767-4d98-ac4c-e8376f0dd6c1",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "„Kurz nach 10 Uhr Ortszeit verkündete Stephen Elop, Chef von Nokia, die neue Strategie des finnischen Handy-Riesen – und hatte einen Überraschungsgast im Schlepptau: Steve Ballmer, Chef des amerikanischen Software-Giganten Microsoft.“"
                            },
                            {
                                "example_id": "1771ba5a-c0e3-46af-9e4f-f05a64bb872b",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "„Minuten später taucht er mit zwei Kellnern im Schlepptau wieder auf, die in ihren Händen gleich mehrere der dringend benötigten Gummiringe halten.“"
                            },
                            {
                                "example_id": "652c144b-c1c0-48ad-860b-db8a9f8a2ccf",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "„Weil sie mit nun über siebzig Jahren nicht miterleben wollte, wie ein Rassist (und Sexist) im Weißen Haus mit einer Meute gewalttätiger Anhänger im Schlepptau diese Errungenschaften ruinieren würde.“"
                            },
                            {
                                "example_id": "1d7db219-a0d9-46ca-bddf-17095288f73e",
                                "sense_id": "20d0b400-9aa7-3de7-ac89-c901551553e6",
                                "text": "„Im Jahr 1926 war Heuss ein Journalist, freiberuflicher Publizist und engagierter liberaler Politiker im Schlepptau des Nationalliberalen Friedrich Naumann.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "233c13bd-00ff-4823-9fbf-1fa66103b9ff",
                        "source_entry_id": "450c5a69-6a5f-3e77-b55c-a0a27784f2b6",
                        "source_sense_id": "c95a8497-7772-3455-94b4-b7463d7ccc7d",
