                        "translation_id": "c556d226-4e25-4c3c-bbbe-1fc60eb077fa",
                        "source_entry_id": "4dacca8f-c4b5-39d6-823a-a8f898643e16",
                        "source_sense_id": "ac03595b-5e49-3920-86bc-91629cb00226",
                        "source_sense_description": "Seefahrt, veraltet: wegstoßen, abstoßen",
                        "target_lang_word": "wegstoßen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wegstoßen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c957e717-fd2c-3fb2-bd29-2c0267645d11",
                                        "entry_id": "3f8b9fc1-fb8f-3053-8ec9-3e712a3675a6",
                                        "glosses": [
                                            "jemanden oder etwas (mit einem Stoß der Hände) von sich wegschubsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb76dab0-52a7-408d-90cb-25d6ad4631ac",
                                                "sense_id": "c957e717-fd2c-3fb2-bd29-2c0267645d11",
                                                "text": "„Risa hebt die Hand, um ihn wegzustoßen, aber er ist schneller und packt sie am Gelenk, bevor sie ihn schubsen kann.“"
                                            },
                                            {
                                                "example_id": "240be726-e566-4cb2-8c80-f969abc889b2",
                                                "sense_id": "c957e717-fd2c-3fb2-bd29-2c0267645d11",
                                                "text": "„Er wollte sie in den Arm nehmen, aber sie stieß ihn weg.“"
                                            },
                                            {
                                                "example_id": "8424e864-e238-4019-bd07-5f038fe472ce",
                                                "sense_id": "c957e717-fd2c-3fb2-bd29-2c0267645d11",
                                                "text": "„Mit Hilfe der Muskulatur bewegt sich der menschliche Körper im Raum, bewegt er fremde Körper auf sich zu oder stößt sie von sich weg, hält er äußeren Kräften, z. B. der Schwerkraft im Sitzen und Stehen, das Gleichgewicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd8b5862-4f0a-41c2-ad27-6db73fdf32e8",
                        "source_entry_id": "4dacca8f-c4b5-39d6-823a-a8f898643e16",
