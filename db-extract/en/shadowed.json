                "forms": [],
                "senses": [
                    {
                        "sense_id": "c52db0eb-2047-349a-a619-77dbf332becb",
                        "entry_id": "10179c4f-bb7f-3125-b089-4296a4616900",
                        "glosses": [
                            "Depicted with shading, as if showing areas in shadow."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0dc8f630-ebf4-4495-ac98-78d498561194",
                                "sense_id": "c52db0eb-2047-349a-a619-77dbf332becb",
                                "text": "[...] 2d and 3d Gules, a Man's Heart proper, Shadowed Or, betwixt three Cinquefoils Ermine, for Hamilton […]"
                            },
                            {
                                "example_id": "d5691bfd-7db1-476e-b4e7-c07376246c9e",
                                "sense_id": "c52db0eb-2047-349a-a619-77dbf332becb",
                                "text": "The supporters have rede collares about there nekes \"bordered with gold, and are vert\" shadowed gules and blew, proper, like parates."
                            },
                            {
                                "example_id": "2947a291-9338-490f-a260-91f5ebf3876e",
                                "sense_id": "c52db0eb-2047-349a-a619-77dbf332becb",
                                "text": "Consequently, a month later, by the Maid's desire, the King gave to Guy de Cailly a grant of new arms on a field azure, three heads of cherubim, winged, bearded in flame-colour, which is or shadowed with gules."
                            },
                            {
                                "example_id": "9cbc5841-6fe6-4b00-b3d0-e5685928bcf3",
                                "sense_id": "c52db0eb-2047-349a-a619-77dbf332becb",
                                "text": "Armorial bearings (L.O., 1678-9) Quarterly 1 and 4, gules a mullet argent between three cinquefoils ermine; 2 and 3 gules, a man's heart proper shadowed or, between three cinquefoils ermine, all within a bordure argent[…]"
                            }
                        ]
                    }
