                                "target_senses": [
                                    {
                                        "sense_id": "92a8f6bd-2d5d-3703-8a95-bd096bba0963",
                                        "entry_id": "b45f4b90-306d-3592-a09a-776943801a1c",
                                        "glosses": [
                                            "Anything that raises or uplifts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6aaa3ac-8e5d-43fa-a5b7-f39d6b8d496c",
                                                "sense_id": "92a8f6bd-2d5d-3703-8a95-bd096bba0963",
                                                "text": "And then the foaming flagons raised on high, with that best of all beverages, that elevator of spirits, that foaming sunshine, that grand and glorious brew of ale."
                                            },
                                            {
                                                "example_id": "81e615ef-308b-4246-9d9b-6fd6b222a25e",
                                                "sense_id": "92a8f6bd-2d5d-3703-8a95-bd096bba0963",
                                                "text": "Bulk loading of grain in progress from road to rail at Biggleswade using a portable elevator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e28da04-c4c4-3979-a36f-8a13ce428478",
                                        "entry_id": "b45f4b90-306d-3592-a09a-776943801a1c",
                                        "glosses": [
                                            "A permanent construction with a built-in platform or cab that can be raised and lowered, used to transport people and goods, as between different floors of a building."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6def4b9b-2986-3336-9228-78eb40e13c69",
                                        "entry_id": "b45f4b90-306d-3592-a09a-776943801a1c",
                                        "glosses": [
                                            "A silo used for storing wheat, corn or other grain (grain elevator)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f87e90-84b9-4aba-9af8-c33cdbeef1cd",
                                                "sense_id": "6def4b9b-2986-3336-9228-78eb40e13c69",
                                                "text": "The harvest is now in full swing in the Great Plains and efforts are being made to rush the grain from the fields to the country elevators and then to the large terminals, such as Kansas City, Houston, Galveston and New Orleans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0034fce6-9da8-380e-926b-1b2398601155",
                                        "entry_id": "b45f4b90-306d-3592-a09a-776943801a1c",
                                        "glosses": [
                                            "A control surface of an aircraft responsible for controlling the pitching motion of the machine."
                                        ],
