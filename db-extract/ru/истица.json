                        "glosses": [
                            "юр. женск. к истец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a84703a-1b3c-41ec-854b-0c188c15a3d6",
                                "sense_id": "857ea6a9-131d-315b-8f0d-e762c12de229",
                                "text": "Истица реализовала данное право, изменила свои исковые требования, которые после судебного разбирательства были удовлетворены."
                            },
                            {
                                "example_id": "f6252c15-0157-4875-a27e-8a97d8b7cfb6",
                                "sense_id": "857ea6a9-131d-315b-8f0d-e762c12de229",
                                "text": "Обосновывая свои требования, истица подкрепила их соответствующими доказательствами."
                            }
                        ]
                    }
