                                        "examples": [
                                            {
                                                "example_id": "cd9276b7-58a4-4017-af77-424e056e65cc",
                                                "sense_id": "b66ce789-4fb3-32ff-80c6-6a92a8113d8c",
                                                "text": "Following all relevant safety instructions, administer a dose of the corticosteroid."
                                            },
                                            {
                                                "example_id": "cb4646aa-c0ac-424b-a901-48ad3252c3b3",
                                                "sense_id": "b66ce789-4fb3-32ff-80c6-6a92a8113d8c",
                                                "text": "Administer a dose of the corticosteroid, following all relevant safety instructions."
                                            }
                                        ]
