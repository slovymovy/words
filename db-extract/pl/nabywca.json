                    {
                        "translation_id": "dc4419b9-b127-4aad-85a3-9fc48346e2cf",
                        "source_entry_id": "0bd510d5-b5d6-3c99-8d6a-0c73ba46ca3f",
                        "source_sense_id": "e2523674-fe38-31e8-8e7f-48204fcab8f8",
                        "target_lang_word": "Käufer",
