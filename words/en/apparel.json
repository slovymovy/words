                        {
                            "text": "The garden was <w>appareled</w> with lush greenery after the rain.",
                            "target_lang_translations": {
                                "ru": "Сад <w>оделся</w> в пышную зелень после дождя.",
                                "de": "Nach dem Regen war der Garten in sattes Grün <w>gekleidet</w>."
                            }
