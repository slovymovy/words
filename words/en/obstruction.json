{
    "word_family": [
        "obstruct",
        "obstructive",
        "obstructor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9932cf05-a1f6-30d4-8d8e-b98abe10f7e2",
                    "sense_definition": "Something that blocks a path or prevents movement or progress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen tree created a major <w>obstruction</w> on the narrow mountain road.",
                            "target_lang_translations": {
                                "ru": "Упавшее дерево создало серьезное <w>препятствие</w> на узкой горной дороге."
                            }
                        },
                        {
                            "text": "The referee stopped play because of an <w>obstruction</w> by the defender.",
                            "target_lang_translations": {
                                "ru": "Судья остановил игру из-за <w>блокировки</w> со стороны защитника."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstacle",
                        "impediment",
                        "hindrance",
                        "block",
                        "roadblock"
                    ],
                    "common_phrases": [
                        "clear the obstruction",
                        "remove the obstruction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или преграда, блокирующая путь либо мешающая движению или продвижению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствие",
                                "target_lang_sense_clarification": "физическая преграда на пути или в спорте"
                            },
                            {
                                "target_lang_word": "преграда",
                                "target_lang_sense_clarification": "то, что физически загораживает путь"
                            },
                            {
                                "target_lang_word": "помеха",
                                "target_lang_sense_clarification": "то, что мешает движению или действию"
                            },
                            {
                                "target_lang_word": "завал",
                                "target_lang_sense_clarification": "скопление предметов, блокирующее проход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6b81f58-8d5e-37ca-b1d0-7b965d78ccdd",
                    "sense_definition": "The act of preventing something from happening or making progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_of_blocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was charged with the <w>obstruction</w> of justice during the investigation.",
                            "target_lang_translations": {
                                "ru": "Политику было предъявлено обвинение в <w>воспрепятствовании</w> осуществлению правосудия в ходе расследования."
                            }
                        },
                        {
                            "text": "Constant <w>obstruction</w> by the opposition party delayed the passing of the new law.",
                            "target_lang_translations": {
                                "ru": "Постоянная <w>обструкция</w> со стороны оппозиционной партии затянула принятие нового закона."
                            }
                        }
                    ],
                    "synonyms": [
                        "hindrance"
                    ],
                    "common_phrases": [
                        "obstruction of justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, направленное на создание помех, предотвращение или срыв какого-либо процесса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствование",
                                "target_lang_sense_clarification": "создание помех, противодействие (например, правосудию)"
                            },
                            {
                                "target_lang_word": "обструкция",
                                "target_lang_sense_clarification": "намеренный срыв или саботаж, в том числе в политике"
                            },
                            {
                                "target_lang_word": "воспрепятствование",
                                "target_lang_sense_clarification": "официальное или юридическое противодействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21e1b760-a398-3979-bd4a-1fe9eacdb8cb",
                    "sense_definition": "A medical condition where a bodily passage or function is blocked.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient required surgery to remove an intestinal <w>obstruction</w>.",
                            "target_lang_translations": {
                                "ru": "Пациенту потребовалась операция для устранения кишечной <w>непроходимости</w>."
                            }
                        },
                        {
                            "text": "Doctors identified a severe <w>obstruction</w> in the patient's airway.",
                            "target_lang_translations": {
                                "ru": "Врачи выявили тяжелую <w>обструкцию</w> дыхательных путей пациента."
                            }
                        }
                    ],
                    "synonyms": [
                        "block"
                    ],
                    "common_phrases": [
                        "intestinal obstruction",
                        "airway obstruction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское состояние, при котором происходит закупорка или непроходимость внутреннего органа, просвета или дыхательных путей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обструкция",
                                "target_lang_sense_clarification": "медицинское сужение или закупорка просвета органа"
                            },
                            {
                                "target_lang_word": "непроходимость",
                                "target_lang_sense_clarification": "нарушение проходимости (например, кишечника)"
                            },
                            {
                                "target_lang_word": "закупорка",
                                "target_lang_sense_clarification": "перекрытие сосуда или протока"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}