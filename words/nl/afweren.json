    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58dea2bf-d6ac-374a-8a94-b3cb524b5e1b",
                    "sense_definition": "een fysieke aanval of slag tegenhouden of van richting doen veranderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verdediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bokser wist de harde stoot van zijn tegenstander behendig <w>af</w> te <w>weren</w>.",
                            "target_lang_translations": {
                                "en": "The boxer managed to skillfully <w>ward off</w> his opponent's hard punch."
                            }
                        },
                        {
                            "text": "Met een snelle beweging kon hij de slag <w>afweren</w> voordat deze hem raakte.",
                            "target_lang_translations": {
                                "en": "With a quick movement, he was able to <w>parry</w> the blow before it hit him."
                            }
                        }
                    ],
                    "synonyms": [
                        "pareren",
                        "tegenhouden"
                    ],
                    "common_phrases": [
                        "slag afweren",
                        "stoot afweren"
                    ],
                    "target_lang_definitions": {
                        "en": "To block or change the direction of a physical attack or blow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ward off",
                                "target_lang_sense_clarification": "to parry or turn aside a physical strike"
                            },
                            {
                                "target_lang_word": "parry",
                                "target_lang_sense_clarification": "to ward off a weapon or blow with a countermove"
                            },
                            {
                                "target_lang_word": "fend off",
                                "target_lang_sense_clarification": "to defend oneself from a physical attack"
                            },
                            {
                                "target_lang_word": "deflect",
                                "target_lang_sense_clarification": "to cause something to change direction on impact"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f3b980b-43a1-3603-9293-cbb43fccd557",
                    "sense_definition": "voorkomen dat iets vervelends of vijandigs effect heeft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verdediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De onverhoedse aanval werd ternauwernood <w>afgeweerd</w> door de beveiliging.",
                            "target_lang_translations": {
                                "en": "The sudden attack was narrowly <w>fended off</w> by security."
                            }
                        },
                        {
                            "text": "Het bedrijf probeert de vijandige overname met alle mogelijke middelen <w>af</w> te <w>weren</w>.",
                            "target_lang_translations": {
                                "en": "The company is trying to <w>thwart</w> the hostile takeover by all possible means."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstoten",
                        "verijdelen",
                        "afslaan"
                    ],
                    "antonyms": [
                        "toelaten"
                    ],
                    "common_phrases": [
                        "aanval afweren",
                        "kritiek afweren",
                        "gevaar afweren"
                    ],
                    "target_lang_definitions": {
                        "en": "To prevent something unpleasant or hostile from having an effect."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ward off",
                                "target_lang_sense_clarification": "to avert or prevent something negative like danger or illness"
                            },
                            {
                                "target_lang_word": "fend off",
                                "target_lang_sense_clarification": "to resist or repel an unwanted attempt or criticism"
                            },
                            {
                                "target_lang_word": "thwart",
                                "target_lang_sense_clarification": "to prevent someone from accomplishing a plan or attack"
                            },
                            {
                                "target_lang_word": "deflect",
                                "target_lang_sense_clarification": "to avoid addressing questions or criticism by redirecting them"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}