                            {
                                "target_lang_word": "переполох",
                                "target_lang_sense_clarification": "состояние тревоги или суеты"
                            },
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "сильное волнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦躁",
                                "target_lang_sense_clarification": "因不安而急躁"
                            },
                            {
                                "target_lang_word": "心烦意乱",
                                "target_lang_sense_clarification": "心情烦躁，思绪混乱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "497ded8d-751e-3d7d-9a83-0c7153a924d1",
                    "sense_definition": "A steward or stewardess on an airplane or boat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She worked as a <w>stew</w> for a major airline for over ten years.",
                            "target_lang_translations": {
                                "ru": "Она проработала <w>стюардессой</w> в крупной авиакомпании более десяти лет.",
                                "zh": "她在一家大型航空公司做了十多年的<w>乘务员</w>。"
                            }
                        },
                        {
                            "text": "The <w>stew</w> walked down the aisle to check if everyone had their seatbelts fastened.",
                            "target_lang_translations": {
                                "ru": "<w>Бортпроводник</w> прошел по проходу, чтобы проверить, все ли пристегнуты ремнями безопасности.",
                                "zh": "<w>乘务员</w>沿着过道走去，检查每个人是否都系好了安全带。"
                            }
