{
    "word_family": [
        "facile",
        "facilement",
        "faciliter",
        "facilitateur",
        "facilitatrice",
        "facilitation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e3f8b80-2782-3ed4-857e-ea48a5a02c06",
                    "sense_definition": "Caractère ou qualité de ce qui ne demande aucun effort pénible, de ce qui est simple à réaliser ou à comprendre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "simplicite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a résolu cet exercice de mathématiques avec une grande <w>facilité</w>."
                        },
                        {
                            "text": "La <w>facilité</w> d'utilisation de ce nouveau logiciel séduit beaucoup d'utilisateurs."
                        }
                    ],
                    "synonyms": [
                        "aisance",
                        "simplicité"
                    ],
                    "antonyms": [
                        "difficulté",
                        "complexité",
                        "peine"
                    ],
                    "common_phrases": [
                        "avec facilité",
                        "grande facilité"
                    ]
                },
                {
                    "sense_id": "347bce38-5dfc-32c9-bdf0-43a0a9b6bb02",
                    "sense_definition": "Aptitude naturelle ou acquise à accomplir quelque chose aisément et sans peine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aptitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet élève montre une remarquable <w>facilité</w> pour apprendre les langues étrangères."
                        },
                        {
                            "text": "Il possède de réelles <w>facilités</w> pour la musique depuis son enfance."
                        }
                    ],
                    "synonyms": [
                        "aptitude",
                        "disposition",
                        "don",
                        "talent"
                    ],
                    "antonyms": [
                        "lourdeur",
                        "maladresse"
                    ],
                    "common_phrases": [
                        "avoir des facilités",
                        "facilité d'apprentissage",
                        "facilité d'élocution"
                    ]
                },
                {
                    "sense_id": "e65e82c3-9405-38f4-a997-68f9acd381f5",
                    "sense_definition": "Commodités, avantages ou délais accordés pour rendre une démarche ou un règlement financier plus aisé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le magasin propose des <w>facilités</w> de paiement en plusieurs fois sans frais."
                        },
                        {
                            "text": "Le banquier lui a accordé des <w>facilités</w> de caisse pour surmonter cette crise temporaire."
                        }
                    ],
                    "synonyms": [
                        "commodité",
                        "allégement",
                        "arrangement"
                    ],
                    "common_phrases": [
                        "facilités de paiement",
                        "facilités de caisse"
                    ]
                },
                {
                    "sense_id": "938f721e-8735-3eb2-bc22-6d6cfa002434",
                    "sense_definition": "Occasion ou moyen favorable permettant d'agir commodément et sans contrainte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opportunite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce au télétravail, nous avons la <w>facilité</w> d'organiser notre emploi du temps."
                        },
                        {
                            "text": "Le nouveau réseau de transports offre la <w>facilité</w> de traverser la ville en quelques minutes."
                        }
                    ],
                    "synonyms": [
                        "commodité",
                        "moyen",
                        "opportunité",
                        "possibilité"
                    ],
                    "antonyms": [
                        "obstacle",
                        "empêchement"
                    ],
                    "common_phrases": [
                        "avoir la facilité de"
                    ]
                },
                {
                    "sense_id": "cc209d2e-1db7-3296-8537-654f13929f62",
                    "sense_definition": "Tendance à choisir la voie du moindre effort ou à faire preuve d'une complaisance excessive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Copier le travail d'un autre auteur est une <w>facilité</w> que la critique n'a pas pardonnée."
                        },
                        {
                            "text": "Il a refusé de céder à la <w>facilité</w> en choisissant le sujet le plus difficile."
                        }
                    ],
                    "synonyms": [
                        "complaisance",
                        "faiblesse",
                        "laisser-aller"
                    ],
                    "antonyms": [
                        "rigueur",
                        "exigence"
                    ],
                    "common_phrases": [
                        "solution de facilité",
                        "céder à la facilité"
                    ]
                }
            ]
        },
