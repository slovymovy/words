    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76d43051-4194-37fa-8783-7dfd0b9c0966",
                    "sense_definition": "niet in staat om zichzelf te helpen of te verdedigen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onvermogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby lag <w>hulpeloos</w> in zijn wiegje te huilen.",
                            "target_lang_translations": {
                                "en": "The baby lay crying <w>helplessly</w> in his crib."
                            }
                        },
                        {
                            "text": "Zonder kaart of telefoon voelde hij zich volkomen <w>hulpeloos</w> in de grote stad.",
                            "target_lang_translations": {
                                "en": "Without a map or phone, he felt completely <w>helpless</w> in the big city."
                            }
                        }
                    ],
                    "synonyms": [
                        "weerloos"
                    ],
                    "antonyms": [
                        "zelfredzaam"
                    ],
                    "common_phrases": [
                        "zich hulpeloos voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "unable to help or defend oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "helpless",
                                "target_lang_sense_clarification": "unable to act without help"
                            },
                            {
                                "target_lang_word": "defenseless",
                                "target_lang_sense_clarification": "unable to protect oneself"
                            },
                            {
                                "target_lang_word": "powerless",
                                "target_lang_sense_clarification": "lacking the power to change a situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4700b14-2e59-3321-9aad-045d329c3ed4",
                    "sense_definition": "in een situatie verkerend waarin geen redding of verbetering meer mogelijk is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "onvermogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De keeper keek <w>hulpeloos</w> toe hoe de bal in het net vloog.",
                            "target_lang_translations": {
                                "en": "The goalkeeper watched <w>helplessly</w> as the ball flew into the net."
                            }
                        },
                        {
                            "text": "Het wapperende lint onderstreepte de nonchalance waarmee hij de bal over de <w>hulpeloze</w> tegenstander heen krulde.",
                            "target_lang_translations": {
                                "en": "The fluttering ribbon emphasized the nonchalance with which he curled the ball over his <w>helpless</w> opponent."
                            }
                        }
                    ],
                    "synonyms": [
                        "reddeloos",
                        "hopeloos",
                        "gedoemd"
                    ],
                    "common_phrases": [
                        "een hulpeloze situatie"
                    ],
                    "target_lang_definitions": {
                        "en": "being in a situation where no rescue or improvement is possible"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "helpless",
                                "target_lang_sense_clarification": "unable to prevent something from happening"
                            },
                            {
                                "target_lang_word": "hopeless",
                                "target_lang_sense_clarification": "without hope of improvement"
                            },
                            {
                                "target_lang_word": "beyond help",
                                "target_lang_sense_clarification": "in a state where no assistance can change the outcome"
                            }
                        ]
                    }
                }
            ]
        }
    ]
