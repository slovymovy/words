                        "glosses": [
                            "literair werk waarin actie, fysiek gevaar en spanning heel belangrijke elementen zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efd8cc1-0e7d-490e-a335-f652e3a8619c",
                                "sense_id": "934044fb-c94d-39eb-8a9c-5434215728c4",
                                "text": "\"Dit hoort bij ontdekkingsreizen in de ruimte. Het gevaar hoort bij de schoonheid\", schreef Yutu verder. \"Ik zal jullie een geheim vertellen: ik ben niet verdrietig. Dit was mijn eigen avonturenverhaal, en net zoals elke held kwam ik een klein probleem tegen.\""
                            },
                            {
                                "example_id": "71767dcf-0161-482c-b1c6-fd762c4a5e26",
                                "sense_id": "934044fb-c94d-39eb-8a9c-5434215728c4",
                                "text": "Na Soldaat van Oranje is ANNE een bewijs van de theaterpotentie van thema's uit de Tweede Wereldoorlog. Regisseur Theu Boermans bewerkte het harde avonturenverhaal van Erik Hazelhoff Roelfzema tot de musical die een ongekend publiekssucces is."
                            },
                            {
                                "example_id": "51898ebe-f5ce-439f-aff4-22898f44de60",
                                "sense_id": "934044fb-c94d-39eb-8a9c-5434215728c4",
                                "text": "Zodoende kwam Plinius weer uit mijn kast, een opgewekt verteld avonturenverhaal over een pinguïn die al op zijn derde depressief is."
                            }
                        ]
                    }
