                "forms": [],
                "senses": [
                    {
                        "sense_id": "539f39b1-877d-37f8-beb3-a05c789e7023",
                        "entry_id": "aaecd597-0557-3e35-a606-079ac64d5318",
                        "glosses": [
                            "Département français de la région administrative des Pays de la Loire, qui porte le numéro de département 49."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ac6538-0b04-4b74-95c2-6f5695f58123",
                                "sense_id": "539f39b1-877d-37f8-beb3-a05c789e7023",
                                "text": "Tout le territoire, compris aujourd’hui dans le Département de Maine-et-Loire, ne formait, on peut l’affirmer, dans les temps antiques, qu’une suite de forêts immenses, au travers desquelles circulait la grande Loire, abordée pendant des siècles, jusque sur sa rive aplanie vers Nord, par les hautes futaies des Bois-de-Vallée et de Belle-Poule."
                            },
                            {
                                "example_id": "8a387557-5d54-4435-99e2-7e75a0f5c124",
                                "sense_id": "539f39b1-877d-37f8-beb3-a05c789e7023",
                                "text": "Depuis quelques jours, un drôle de texte est entré en vigueur sur la commune de La Lande-Chasles, dans le Maine-et-Loire."
                            },
                            {
                                "example_id": "9184c9b1-0ab8-4598-9356-19b33d4bbb78",
                                "sense_id": "539f39b1-877d-37f8-beb3-a05c789e7023",
                                "text": "En 2012, Jean-Louis Seillant, qui habite à Cholet (Maine-et-Loire), avait eu une brillante idée : collecter toutes les pubs reçues dans sa boîte aux lettres pendant une année et peser le tout."
                            }
                        ]
                    }
                ],
