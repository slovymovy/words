                "senses": [
                    {
                        "sense_id": "35e50361-3b63-3fa1-8d54-7535dec105ef",
                        "entry_id": "a12034f1-ffef-35f8-8145-978bac539394",
                        "glosses": [
                            "Danser la gavotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e213249d-504f-442e-9a99-565e179bd156",
                                "sense_id": "35e50361-3b63-3fa1-8d54-7535dec105ef",
                                "text": "C’est juste pimpant qu’au printemps, aux premières jonquilles, à la brume mouillée sur Paris, aux premiers passereaux… tout là-haut dominant rêveur avant les brutals, et puis tous les ploucs rappliquent, regrimpent là-haut, piétinent, beuglent, rôdent, entendent bien se divertir… Les Blés d’or, Le Temps des cerises, s’entrelacent, gavottent, juronnent, extasent, pètent…"
                            },
                            {
                                "example_id": "0ee8cad5-1fd4-4a17-97c3-a31381db70b8",
                                "sense_id": "35e50361-3b63-3fa1-8d54-7535dec105ef",
                                "text": "Des danses chevaleresques ont-elles lieu quand vous glissez de vos cadres pour gavotter dans les salles après que le gardien de nuit s’est endormi ?"
                            }
                        ]
                    }
                ],
