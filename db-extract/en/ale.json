                    {
                        "translation_id": "9110a2be-f89a-4e43-9263-376475b4f2d4",
                        "source_entry_id": "1ddfc215-3aaf-3dec-8455-90a9255df00e",
                        "source_sense_description": "beer produced by warm fermentation",
