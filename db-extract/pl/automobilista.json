                    },
                    {
                        "sense_id": "c5288b6f-bc01-3af7-90e2-df983009ff3a",
                        "entry_id": "ea652dcb-d5bd-32a7-a7d9-d7e07e3f42c3",
                        "glosses": [
                            "człowiek uprawiający sporty samochodowe"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c6f1a757-d339-42a6-b7b2-5522998f4620",
                                "sense_id": "c5288b6f-bc01-3af7-90e2-df983009ff3a",
                                "text": "Hubert Latham był francuskim automobilistą i pionierem lotnictwa."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1145e6d-d69a-45f3-9468-63dfb70118b5",
                        "source_entry_id": "ea652dcb-d5bd-32a7-a7d9-d7e07e3f42c3",
                        "source_sense_id": "ef48d083-cded-35e8-849d-a243d644386e",
                        "target_lang_word": "automobilist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automobilist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "758d96c3-7604-33e6-bd41-22cfb43fd6cc",
                                        "entry_id": "59415047-5540-3ed3-bcc7-4bc8f9ad8654",
                                        "glosses": [
                                            "The driver of an automobile."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eab85bb-cb9a-4e1f-938e-04ae3895077f",
                                                "sense_id": "758d96c3-7604-33e6-bd41-22cfb43fd6cc",
                                                "text": "For the automobilist beginner the problem comes when he first meets traffic, and a big truck, say, suddenly cuts in ahead of him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a9d9a9b-19fe-43d7-913e-228e00a52858",
                        "source_entry_id": "ea652dcb-d5bd-32a7-a7d9-d7e07e3f42c3",
                        "source_sense_id": "ef48d083-cded-35e8-849d-a243d644386e",
                        "target_lang_word": "automobiliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automobiliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                        "entry_id": "5c20b8fd-62cd-35b9-8029-d58a84af03bf",
                                        "glosses": [
                                            "Celui, celle qui conduit une automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfab6897-ed92-4250-8aa5-91314b9cce49",
                                                "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                                "text": "De là est née l’idée de recourir à l’auto-stop, mais cela d'une manière organisée donnant un maximum de satisfaction et de garantie aussi bien à l’automobiliste qu'à l’auto-stoppeur. Ainsi fut créée par l'initiative privée dans le courant du mois de mai 1978, une association sans but lucratif, dénommée \"Taxistop\"."
                                            },
                                            {
                                                "example_id": "5a7dab58-9e4f-4a50-9e3e-fcb47ab90ee2",
                                                "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                                "text": "En fait lorsque la R5 Turbo aborde l'entrée du tunnel, elle ne ralentit que très légèrement et la traversée de Lyon s'effectue sans problème. A la sortie des autostoppeurs font des signes désespérés aux automobilistes indifférents."
                                            },
                                            {
                                                "example_id": "ae9407fb-98b5-4dc0-9df9-4c32fc84cb83",
                                                "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                                "text": "Je me suis rendu compte, au fil de ma carrière, de l’évolution effarante de la situation ; d’occasionnelle, la contravention est devenue quotidienne : chaque fois qu’il s'installe à son volant, l’automobiliste risque de se retrouver en tort malgré lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62f1e0f6-cc18-419a-ad0e-d3eabc0c8e19",
                        "source_entry_id": "ea652dcb-d5bd-32a7-a7d9-d7e07e3f42c3",
                        "source_sense_id": "ef48d083-cded-35e8-849d-a243d644386e",
                        "target_lang_word": "автомобилист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "автомобилист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dbee390e-31d7-3549-ad5e-e43e421045a9",
                                        "entry_id": "5f3edc29-ecb0-3e2e-bb80-30b9181526ec",
                                        "glosses": [
                                            "специалист по автомобильному делу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0afd5de-fed5-45ef-8767-69f43668b94b",
                                                "sense_id": "dbee390e-31d7-3549-ad5e-e43e421045a9",
                                                "text": "Впрочем, Максим Медведков сказал, что если до 10 марта автомобилисты представят подробное обоснование, каким образом они сделают через 10 лет автомобили будущего, то правительство может своё решение и пересмотреть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37e501c6-06ae-3a9d-96d9-f35850741a97",
                                        "entry_id": "5f3edc29-ecb0-3e2e-bb80-30b9181526ec",
                                        "glosses": [
                                            "водитель или владелец автомобиля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079fbb8b-c5ac-420c-a4c7-e7a47309045f",
                                                "sense_id": "37e501c6-06ae-3a9d-96d9-f35850741a97",
                                                "text": "Вообразим грустную для автомобилиста ситуацию: надо уехать надолго, а последить за машиной некому."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c69e7c6-2120-3abf-996a-4b0a4d691dea",
                                        "entry_id": "5f3edc29-ecb0-3e2e-bb80-30b9181526ec",
                                        "glosses": [
                                            "спортсмен, занимающийся автомобильным спортом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19c4a62-fb8c-4c74-a63c-915aa9144ce1",
                                                "sense_id": "9c69e7c6-2120-3abf-996a-4b0a4d691dea",
                                                "text": "Первым из 78 участников пробега прибыл в Монако русский автомобилист А. П. Нагель на машине русского производства, постройки Русско-Балтийского завода."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
