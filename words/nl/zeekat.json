                    "sense_id": "678054cd-afcc-33f2-a301-e308487ef548",
                    "sense_definition": "een tienarmige inktvis uit de orde Sepiida die in zee leeft",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inktvis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn dochter vond die <w>zeekat</w> op het strand maar eng.",
                            "target_lang_translations": {
                                "en": "My daughter thought that <w>cuttlefish</w> on the beach was quite scary."
                            }
                        },
                        {
                            "text": "De <w>zeekat</w> kan heel snel van kleur veranderen om zich te camoufleren.",
                            "target_lang_translations": {
                                "en": "The <w>cuttlefish</w> can change color very quickly to camouflage itself."
                            }
                        }
                    ],
                    "synonyms": [
                        "sepia"
                    ],
                    "common_phrases": [
                        "gewone zeekat"
                    ],
                    "target_lang_definitions": {
                        "en": "a ten-armed cephalopod of the order Sepiida that lives in the sea"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cuttlefish",
                                "target_lang_sense_clarification": "the marine animal"
                            },
                            {
                                "target_lang_word": "sepia",
                                "target_lang_sense_clarification": "the scientific or artistic name for the cuttlefish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3312b5e3-93dc-365c-b70c-8b078ccb08b3",
                    "sense_definition": "een benaming voor bepaalde kraakbeenvissen uit de onderklasse Holocephali",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is dat dier een <w>zeekat</w> of een andere soort kraakbeenvis?",
                            "target_lang_translations": {
                                "en": "Is that animal a <w>chimaera</w> or another type of cartilaginous fish?"
                            }
                        },
                        {
                            "text": "De <w>zeekat</w> leeft meestal in de diepere delen van de oceaan.",
                            "target_lang_translations": {
                                "en": "The <w>ghost shark</w> usually lives in the deeper parts of the ocean."
                            }
                        }
                    ],
                    "synonyms": [
                        "draakvis"
                    ],
                    "target_lang_definitions": {
                        "en": "a name for certain cartilaginous fish from the subclass Holocephali"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chimaera",
                                "target_lang_sense_clarification": "the cartilaginous fish"
                            },
                            {
                                "target_lang_word": "ghost shark",
                                "target_lang_sense_clarification": "informal name for the chimaera"
                            },
                            {
                                "target_lang_word": "ratfish",
                                "target_lang_sense_clarification": "common name for certain chimaeras"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e9ab18d-a443-3245-9f5c-27b929b0d5ae",
                    "sense_definition": "een specifiek type vaartuig dat door de marine wordt gebruikt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk, daar vaart een <w>zeekat</w> de haven van Den Helder binnen.",
                            "target_lang_translations": {
                                "en": "Look, a <w>naval vessel</w> is sailing into the harbor of Den Helder."
                            }
                        },
                        {
                            "text": "De bemanning van de <w>zeekat</w> bereidde zich voor op de oefening op open zee.",
                            "target_lang_translations": {
                                "en": "The crew of the <w>sea cat</w> prepared for the exercise on the open sea."
                            }
                        }
                    ],
                    "target_lang_definitions": {
