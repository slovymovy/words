                        "tags": [
                            "comparative"
                        ],
                        "form": "more baller"
                    },
                    {
                        "form_id": "cda2da1e-7d13-4949-ac60-df77a21ee7b9",
                        "entry_id": "2287e4a5-8692-3c43-9c50-5467f1f9f742",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most baller"
