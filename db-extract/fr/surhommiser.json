                "senses": [
                    {
                        "sense_id": "035e74ce-11d4-3871-b3d4-393cd33dd36f",
                        "entry_id": "d130d712-f9d4-3dd0-94d4-1fa970625130",
                        "glosses": [
                            "Considérer comme surhomme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f81926-4861-4d02-b48c-8dc724401720",
                                "sense_id": "035e74ce-11d4-3871-b3d4-393cd33dd36f",
                                "text": "Les « bourreurs de crâne » n’auraient pas eu de peine, sans doute, à surhommiser des milliers de braves et pauvres moujiks."
                            },
                            {
                                "example_id": "ba46da80-a4ca-494c-bc56-a68059cdbffb",
                                "sense_id": "035e74ce-11d4-3871-b3d4-393cd33dd36f",
                                "text": "On le cerne, on l’absorbe, on le vénère, on l’humecte, on le désire, on le surhommise."
                            },
                            {
                                "example_id": "254a5789-e50a-47a8-a016-10c3ce413755",
                                "sense_id": "035e74ce-11d4-3871-b3d4-393cd33dd36f",
                                "text": "Le film est bien pour beaucoup de monde, je le respecte, mais je n’ai pas du tout accroché à l’univers et au scénario, Rambo est bien trop \"surhommisé\" et la VF est pourrie de chez pourrie."
                            }
                        ]
                    }
                ],
