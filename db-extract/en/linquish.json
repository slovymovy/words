                        "examples": [
                            {
                                "example_id": "f6ae9303-9716-479e-8f1c-c14d094c6033",
                                "sense_id": "40a11e09-af92-3150-b513-1a86db355847",
                                "text": "But now a while I linquiſh this conflict, / And paſſe beyond the ſeas without a backe[…]"
                            },
                            {
                                "example_id": "ddd176f8-494c-4786-9ee9-50c541e625cc",
                                "sense_id": "40a11e09-af92-3150-b513-1a86db355847",
                                "text": "They pittie not their owne ſpirituall miſery how Satan deludes them of the Beniſſon; but are foggie, full of feſtiuitie, loth to linquiſh, like to languiſh, and illiterated[…]"
                            },
                            {
                                "example_id": "aa15ac38-1395-41c3-8d9c-07de186e8b03",
                                "sense_id": "40a11e09-af92-3150-b513-1a86db355847",
                                "text": "For, shou'd you come before the Brume's abated / Th' Opime you'd linquish for the Macerated."
                            }
                        ]
                    }
