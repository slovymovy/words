                "senses": [
                    {
                        "sense_id": "896788c8-918a-35dc-afe8-12ddce2f9036",
                        "entry_id": "422e7fb1-78cb-3ec2-82b0-51c84053ef83",
                        "glosses": [
                            "Palast aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd126b99-e3b0-4241-bafb-dd644e881bf3",
                                "sense_id": "896788c8-918a-35dc-afe8-12ddce2f9036",
                                "text": "„Drehbuchschreiber machen aus ihnen schillernde Figuren zwischen Nadelstreifenanzug und Dialekt, zwischen Marmorpalästen und Gosse, mit faszinierender Ambiguität und verstörenden Widersprüchen.“"
                            },
                            {
                                "example_id": "41c3acda-cbc1-406d-a50b-868e2425aaf5",
                                "sense_id": "896788c8-918a-35dc-afe8-12ddce2f9036",
                                "text": "„Der neuere Teil sah aus wie eine Spielzeugstadt und schien nur aus weißen Marmorpalästen, repräsentativen Regierungsgebäuden und luxuriösen Wohnhäusern zu bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
