                ],
                "senses": [
                    {
                        "sense_id": "4301ef08-d454-3800-9c20-81d021264629",
                        "entry_id": "b6260b5c-3e48-3f76-bbb0-4d1b9fe4a3f4",
                        "glosses": [
                            "abstrakter Sammelbegriff für verfügbare Arbeitsplätze und deren Bedingungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbcc7868-e211-4b2a-baef-538c86398c9e",
                                "sense_id": "4301ef08-d454-3800-9c20-81d021264629",
                                "text": "Die Situation auf dem Arbeitsmarkt ist nicht berauschend."
                            },
                            {
                                "example_id": "38138d99-cbb0-40ac-9a88-a870a5944a6d",
                                "sense_id": "4301ef08-d454-3800-9c20-81d021264629",
                                "text": "„Die zunehmende Globalisierung, geprägt durch die Internationalisierung des Arbeitsmarktes, führte dazu, dass die neue Lingua franca Englisch wurde.“"
                            },
                            {
                                "example_id": "9ae1b472-9e98-454e-b58f-259bfea7e803",
                                "sense_id": "4301ef08-d454-3800-9c20-81d021264629",
                                "text": "„Meine Integration in den Arbeitsmarkt fand übrigens ohne jedwede Diskriminierung durch meine Herkunft statt.“"
                            },
                            {
                                "example_id": "624a416a-0667-453a-b11a-d7cb28fcd70f",
                                "sense_id": "4301ef08-d454-3800-9c20-81d021264629",
                                "text": "„Ganz ähnlich war die Lage auf dem Münchner Arbeitsmarkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db341660-b499-414f-8446-afcfa99b0bcd",
                        "source_entry_id": "b6260b5c-3e48-3f76-bbb0-4d1b9fe4a3f4",
                        "source_sense_id": "4301ef08-d454-3800-9c20-81d021264629",
                        "source_sense_description": "abstrakter Sammelbegriff für verfügbare Arbeitsplätze und deren Bedingungen",
                        "target_lang_word": "job market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "job market",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc42a79-d8be-37c4-b00f-4de5c53caa6b",
                                        "entry_id": "fb4500ab-2cc3-399d-84ad-14af0c15266e",
                                        "glosses": [
                                            "A market in which employers seek out potential employees and employees search for prospective jobs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64e8b97-ff2d-48a4-8269-8a3f30b5b36c",
                                                "sense_id": "5fc42a79-d8be-37c4-b00f-4de5c53caa6b",
                                                "text": "America’s job market continues to expand despite elevated interest rates maintained by the Federal Reserve (Fed)."
                                            },
                                            {
                                                "example_id": "83fb1c9d-0901-4f97-8425-cf78af361b4c",
                                                "sense_id": "5fc42a79-d8be-37c4-b00f-4de5c53caa6b",
                                                "text": "The job market remains one of the U.S. economy's main engines, with the nation's unemployment rate near a 50-year low and wages finally pulling ahead of inflation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b9de5d1-ba9c-4b94-9fe2-bb1e28a464bb",
                        "source_entry_id": "b6260b5c-3e48-3f76-bbb0-4d1b9fe4a3f4",
                        "source_sense_id": "4301ef08-d454-3800-9c20-81d021264629",
                        "source_sense_description": "abstrakter Sammelbegriff für verfügbare Arbeitsplätze und deren Bedingungen",
                        "target_lang_word": "labour market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labour market",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dedd8e8-b22a-35a3-9dd6-1c471f7ace8f",
                                        "entry_id": "c0865174-df06-39b6-b087-2e3c85754ac9",
                                        "glosses": [
                                            "Alternative form of labor market."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ff8251-201b-4b33-8aea-37cbc5427ca8",
                                                "sense_id": "2dedd8e8-b22a-35a3-9dd6-1c471f7ace8f",
                                                "text": "She gets jobs that last only a few months, in the flexible labour market beloved of politicians, but which leaves her struggling to pay the bills."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
