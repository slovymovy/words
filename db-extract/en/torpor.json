                    }
                ],
                "senses": [
                    {
                        "sense_id": "0fadaa57-a651-38a6-aeee-57dad21f2f98",
                        "entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                        "glosses": [
                            "A state of being inactive or stuporous."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c0406cdd-f798-38aa-8a99-611b2b0c9f29",
                        "entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                        "glosses": [
                            "A state of apathy or lethargy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3e23ff49-0d9d-4a5f-b480-402553dceedf",
                                "sense_id": "c0406cdd-f798-38aa-8a99-611b2b0c9f29",
                                "text": "She knew that she was the cause of her husband's utter ruin; and she strung herself to bear the consequences. The reproaches which agony extorted; or worse, cureless, uncomplaining depression, when his mind was sunk in a torpor, not the less painful because it was silent and moveless."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0dc1ebd-ed43-337a-81f0-2020c58d4260",
                        "entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                        "glosses": [
                            "A state similar to hibernation characterised by energy-conserving, very deep sleep."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5e81dfb-42b6-484d-bd45-a4561437a22d",
                        "source_entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                        "source_sense_description": "being inactive or stuporous",
                        "target_lang_word": "verstarring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstarring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a09d2279-3198-3e5a-872f-75454030aa29",
                                        "entry_id": "5b9c1ea5-a3e3-3ef6-97f3-6cb8ac482895",
                                        "glosses": [
                                            "het door het aanspannen van spieren verstijven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d357367-47f3-4ac8-889f-e12fabe32fa9",
                                                "sense_id": "a09d2279-3198-3e5a-872f-75454030aa29",
                                                "text": "Natasja was in die toestand van verstarring sinds die ochtend, toen Sonja het tot verbazing en ergernis van de gravin om een onbegrijpelijke reden nodig had gevonden om Natasja in te lichten over de verwonding van vorst Andrej en over zijn aanwezigheid in hun reisgezelschap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "485189fe-4c7e-398d-8aa0-75f0817c99db",
                                        "entry_id": "5b9c1ea5-a3e3-3ef6-97f3-6cb8ac482895",
                                        "glosses": [
                                            "minder flexibel worden"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8685dfc3-36f8-4fcd-8111-98b30cd266f2",
                                                "sense_id": "485189fe-4c7e-398d-8aa0-75f0817c99db",
                                                "text": "De SP-senator stelt dat het kabinet een moeilijke tijd tegemoet gaat zonder een meerderheid in de Senaat. Hij voorziet twee mogelijke uitkomsten: \"Als ze dit met creativiteit aanpakken, zijn ze bij ons welkom. Volharden ze in verstarring, dan zie ik maar één mogelijkheid: dan zullen we snel afscheid moeten nemen van dit kabinet.\" De SP gaat van 8 naar 9 zetels in de nieuwe Eerste Kamer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78e24610-edba-4336-971e-6d104744abec",
                        "source_entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                        "source_sense_description": "being inactive or stuporous",
                        "target_lang_word": "letargie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b8356bac-7f32-4085-89ba-799762eefe0c",
                        "source_entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                        "source_sense_description": "being inactive or stuporous",
                        "target_lang_word": "torpeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torpeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bff7942a-4c2b-3cb7-b500-35959722ef1b",
                                        "entry_id": "c10e6f09-0e03-3c10-a787-ee5bb5d5b81f",
                                        "glosses": [
                                            "Engourdissement, somnolence, ralentissement des fonctions vitales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aef1a0d2-81e2-4ab3-b0d4-ed7ddd799f65",
                                                "sense_id": "bff7942a-4c2b-3cb7-b500-35959722ef1b",
                                                "text": "Ce malade est dans la torpeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                        "entry_id": "c10e6f09-0e03-3c10-a787-ee5bb5d5b81f",
                                        "glosses": [
                                            "Engourdissement des facultés de l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd776fdb-f8bc-42e0-b3e6-de388f98af48",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Il voulait se reposer et se recueillir. A l'activité qui s'était emparée de lui tout à coup avait succédé une sorte de torpeur morale et physique. C'est un effet assez ordinaire du surmenage et des émotions répétées."
                                            },
                                            {
                                                "example_id": "f84315a6-e253-4c71-a3ae-175b94c4bf21",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Dans la tiède torpeur du réveil le père Jourgeot savoura ce délicieux engourdissement qui est comme la prise de conscience des bons sommeils réparateurs et des nuits tranquilles ; […]."
                                            },
                                            {
                                                "example_id": "8befd944-3c88-481f-8c7a-af33f2742537",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Un mois s’étant écoulé depuis le départ de Jacques, Yasmina vivait en une sorte de torpeur morne."
                                            },
                                            {
                                                "example_id": "4cda94bb-9a66-444e-9883-775b4881b9e7",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Tout le monde excepté la mère avait pris la torpeur de cette attente pour le calme de l’innocence."
                                            },
                                            {
                                                "example_id": "9388714d-0700-49d7-a337-42f839481180",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Et la rue retomba dans le demi-silence, la torpeur, la résignation qu’une descente de police laisse toujours derrière elle."
                                            },
                                            {
                                                "example_id": "0255f2d8-3595-486c-b8e2-0ebad695a7f0",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "La torpeur qui paralysait son cerveau lui procurait trop de bien-être pour qu’il tentât de la chasser."
                                            },
                                            {
                                                "example_id": "e2a5832a-1bb8-435a-9b8f-3545d9d3c5ab",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Les ouvrières ne se pressèrent pas, engourdies d’une torpeur de paresse, les bras abandonnés sur leurs jupes, tenant toujours d’une main leurs verres vides, où un peu de marc de café restait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d9e671-8909-4494-9d52-8078166ea62e",
                        "source_entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                        "source_sense_description": "being inactive or stuporous",
