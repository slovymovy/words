                                "target_senses": [
                                    {
                                        "sense_id": "206227b4-2680-3e6a-9b8d-8331e8994c55",
                                        "entry_id": "50434528-726f-3c88-845c-8cdfed5c752a",
                                        "glosses": [
                                            "capacità di ridere di sé stessi"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17243f37-91dd-3db0-b0ba-40d883f39d63",
                                        "entry_id": "50434528-726f-3c88-845c-8cdfed5c752a",
                                        "glosses": [
                                            "scherzare lievemente, quasi sino al punto di provare disagio però invero con equilibrio e sane risa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f6ceb7-8d9d-4d27-bb85-43d7e94b04b6",
                                                "sense_id": "17243f37-91dd-3db0-b0ba-40d883f39d63",
                                                "text": "con autoironia si è vestito da donna per fare un po' ridere gli amici"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b225c94c-d892-3699-b615-4f22d345a4bd",
                                        "entry_id": "50434528-726f-3c88-845c-8cdfed5c752a",
                                        "glosses": [
                                            "prendersi un po' in giro, sinonimo di autoironismo [fonte: G.F., nuovo dizionario degli italiani]"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3bcc2f2-00e1-4cdf-851e-7d1e3b2dc6a0",
                                                "sense_id": "b225c94c-d892-3699-b615-4f22d345a4bd",
                                                "text": "\"Pipetto è così serioso, fissato e frustrato, nonché fanatico, da non concepire nemmeno cosa sia l'autoironia!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
