                        "translation_id": "f6010931-a280-4a3a-a250-ec0af1e6c476",
                        "source_entry_id": "4779c967-984a-3466-bbf5-1f8b14c84f3c",
                        "source_sense_id": "4ac951fc-5bb7-30a4-8736-8ad4ab7d2b70",
                        "source_sense_description": "een arts die gespecialiseerd is in de behandeling van kinderen",
                        "target_lang_word": "Kinderarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kinderarzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3be5c9a2-fabd-3d7c-be70-7aef4e702aa5",
                                        "entry_id": "a3c5e064-d035-39bc-aac3-ab037a5e556b",
                                        "glosses": [
                                            "Facharzt, der auf Kinderheilkunde spezialisiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d56628f-75f9-48cd-91b0-c07235cd5d67",
                                                "sense_id": "3be5c9a2-fabd-3d7c-be70-7aef4e702aa5",
                                                "text": "Ein Kinderarzt hat gelernt, die besonderen Erkrankungen von Kindern zu behandeln."
                                            },
                                            {
                                                "example_id": "7ef3ccbd-38a3-4155-9afc-6345770fa797",
                                                "sense_id": "3be5c9a2-fabd-3d7c-be70-7aef4e702aa5",
                                                "text": "„Mama brachte mich zum Kinderarzt, der mir mit einem Holzstück die Zunge runterdrückte, wovon ich fast brechen mußte.“"
                                            },
                                            {
                                                "example_id": "5bec7a6c-be51-4027-ba36-eb67863a4c5b",
                                                "sense_id": "3be5c9a2-fabd-3d7c-be70-7aef4e702aa5",
                                                "text": "„Dummerweise passierte das Ganze auch noch in der Vorweihnachtszeit, alle Kinderärzte waren mit niesenden und hustenden Patienten beschäftigt, die Wartezimmer überfüllt.“"
                                            },
                                            {
                                                "example_id": "b03f6f99-aa4a-4ad0-a92c-08a14b12c94d",
                                                "sense_id": "3be5c9a2-fabd-3d7c-be70-7aef4e702aa5",
                                                "text": "„Er war Kinderarzt.“"
                                            },
                                            {
                                                "example_id": "cf6d7b05-865f-413d-a83a-50190152de48",
                                                "sense_id": "3be5c9a2-fabd-3d7c-be70-7aef4e702aa5",
                                                "text": "„Weil es dem Kinde nicht gut ging, ließ Frau Mondtraut durch einen Diener die alte Liu rufen, außerdem einen Kinderarzt holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
