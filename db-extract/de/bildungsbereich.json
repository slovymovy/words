                ],
                "senses": [
                    {
                        "sense_id": "776cb963-37fd-3bbc-bd6f-b53978207e24",
                        "entry_id": "55a3fcfb-610e-312e-bf87-6fb35ff76308",
                        "glosses": [
                            "Gesamtheit dessen, was die Bildung anbelangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "160efe36-cb30-4bac-b7b0-c3fbcd5449cc",
                                "sense_id": "776cb963-37fd-3bbc-bd6f-b53978207e24",
                                "text": "„Microsoft hat in New York eine neue Light-Version seines Windows-Betriebssystems speziell für den Bildungsbereich vorgestellt.“"
                            },
                            {
                                "example_id": "1bb804c8-5115-4582-870d-07620b2a5a55",
                                "sense_id": "776cb963-37fd-3bbc-bd6f-b53978207e24",
                                "text": "„In China selbst werden Hunderttausende Uiguren in Xinjiang ‚umerzogen‘, im Bildungsbereich die Lehrbücher umgeschrieben, und über soziale Kreditziffern wird eine ‚formierte Gesellschaft‘ geschaffen.“"
                            },
                            {
                                "example_id": "82733ceb-98c8-4f37-8e93-4b141254949a",
                                "sense_id": "776cb963-37fd-3bbc-bd6f-b53978207e24",
                                "text": "„Auch die Kontrollrechte zur Verwendung der Mittel wurden noch einmal geändert: Dem Kompromiss zufolge dürfte die Bundesregierung künftig im Bildungsbereich von den Ländern Berichte und anlassbezogen die Vorlage von Akten verlangen.“"
                            },
                            {
                                "example_id": "90b6fcee-31f0-48c9-a1ad-b21be949f2ae",
                                "sense_id": "776cb963-37fd-3bbc-bd6f-b53978207e24",
                                "text": "„Es bedarf geeigneter Maßnahmen, um bessere Leitlinien für die Einführung digitaler Technologien zu entwickeln, vor allem im Bildungsbereich, aber auch ganz allgemein im Bereich der Medien.“"
                            },
                            {
                                "example_id": "ed0e35b7-ac13-4d59-a405-a063c86a872c",
                                "sense_id": "776cb963-37fd-3bbc-bd6f-b53978207e24",
                                "text": "„Bayern ist ja nicht nur im Bildungsbereich dafür bekannt, eine selbstbewusste Vetomacht zu sein.“"
                            },
                            {
                                "example_id": "8ba0ccef-dfe7-4ece-af10-0e852e6b180e",
                                "sense_id": "776cb963-37fd-3bbc-bd6f-b53978207e24",
                                "text": "„Zur Finanzierung von Gehältern, indirekten Arbeitskosten und Investitionen im Bildungsbereiche werden staatliche Mittel bereitgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "81d5436e-b84c-3c88-9ece-df6556d0c5dd",
                        "entry_id": "55a3fcfb-610e-312e-bf87-6fb35ff76308",
                        "glosses": [
                            "Art der Bildungsstätte (beispielsweise Kindertagesstätte, Berufsschule und so weiter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c007dc61-d256-467c-8783-106901bf8c07",
                                "sense_id": "81d5436e-b84c-3c88-9ece-df6556d0c5dd",
                                "text": "„Für die Schulen gebe es die Bildungsstandards der KMK als Qualitätsmaßstab, für die übrigen Bildungsbereiche allerdings fehlten solche Kompetenzziele.“"
                            },
                            {
                                "example_id": "60ef321f-61a0-4d7e-9202-36b13ce5ab6a",
                                "sense_id": "81d5436e-b84c-3c88-9ece-df6556d0c5dd",
                                "text": "„Bei einem gezielt auf die Bildungsbereiche Lesen, Mathematik, Naturwissenschaft und interkulturelles Lernen ausgerichteten Qualitätstest schnitt jede zweite Betreuungseinrichtung ‚unzureichend‘ ab.“"
                            },
                            {
                                "example_id": "ca5fcded-a4b2-45fd-af72-cfd667774eb8",
                                "sense_id": "81d5436e-b84c-3c88-9ece-df6556d0c5dd",
                                "text": "„Demnach darf man sich freuen über eine ‚Vielzahl positiver Entwicklungen über alle Bildungsbereiche hinweg‘: Es gehen viel mehr Kleinkinder in die Kitas, mehr Jugendliche in Ganztagsschulen und gut jeder zweite eines Jahrgangs schafft es an eine Hochschule.“"
                            },
                            {
                                "example_id": "7699670d-a6d0-4827-828f-c9e60657b264",
                                "sense_id": "81d5436e-b84c-3c88-9ece-df6556d0c5dd",
                                "text": "„Dieser sollte im Auftrag des Bundestages regelmäßig über alle Bildungsbereiche berichten und Empfehlungen für die Weiterentwicklung von Kindertagesstätten, Schulen, Hochschulen und Weiterbildung geben.“"
                            },
                            {
                                "example_id": "4ed9dba9-fba1-482f-8001-595b7b718aec",
                                "sense_id": "81d5436e-b84c-3c88-9ece-df6556d0c5dd",
                                "text": "„‚In den meisten Bildungsbereichen können wir keinen wissenschaftlichen Zusammenhang zwischen eingesetzten Mitteln und Bildungserfolg herstellen‘, sagt Bildungsökonom Ludger Wößmann und entzaubert beispielhaft eine der gängigsten Ideen für bessere Bildung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
