                "senses": [
                    {
                        "sense_id": "b9b18c7e-9a18-3070-af6a-e058140476f1",
                        "entry_id": "453f5b95-98b6-3f37-86a8-40a04aa298dc",
                        "glosses": [
                            "een woning bewoond door mensen die daar juridisch geen recht hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a78844-aeaf-4c0d-b2d2-086a340b1d75",
                                "sense_id": "b9b18c7e-9a18-3070-af6a-e058140476f1",
                                "text": "Dit kraakpand werd met geweld ontruimd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "370cda9c-e351-4019-8ebe-adbd7fb929f7",
                        "source_entry_id": "453f5b95-98b6-3f37-86a8-40a04aa298dc",
                        "source_sense_id": "b9b18c7e-9a18-3070-af6a-e058140476f1",
                        "source_sense_description": "een woning bewoond door mensen die daar juridisch geen recht hebben",
                        "target_lang_word": "Haus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5282cf7-d1f8-3855-89bb-ed89475b9b28",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "zu einem bestimmten Zweck erbautes Gebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599a6387-00d5-4481-9db8-9378b59f4461",
                                                "sense_id": "c5282cf7-d1f8-3855-89bb-ed89475b9b28",
                                                "text": "„‚Wir dürften in München die größte Auswahl haben‘, sind sie überzeugt und auch davon, dass ihr Haus besten Service bietet.“"
                                            },
                                            {
                                                "example_id": "82b73f02-009c-41a2-aa88-bcb58870c954",
                                                "sense_id": "c5282cf7-d1f8-3855-89bb-ed89475b9b28",
                                                "text": "„Was macht denn so ein IOC-Mitglied? Es besucht kandidierende Möchtegern-Olympiastädte. Kostenloses Reisen, Beherbergung in den nobelsten Häusern, festliche Anlässe, piekfeine Verpflegung, Geschenke (keine Bestechung versteht sich) entgegennehmen und schlussendlich eine fast unkündbare Anstellung auf Lebzeiten geniessen… Keine Frage, wer es in dieses Gremium schafft, hat ausgesorgt.“"
                                            },
                                            {
                                                "example_id": "7d1d9682-1c19-4f00-a2f3-949803e02848",
                                                "sense_id": "c5282cf7-d1f8-3855-89bb-ed89475b9b28",
                                                "text": "„Bei Bedarf bekommen sie eine Brille angepasst - auf Kosten des Hauses.“"
                                            },
                                            {
                                                "example_id": "a865dff3-4f2e-4ff3-8c66-6fd2398ccfe1",
                                                "sense_id": "c5282cf7-d1f8-3855-89bb-ed89475b9b28",
                                                "text": "„Wer noch mehr Anwendungen will, dem stehen zusätzliche Kuren, Massagen und Spezialitäten des Hauses zur Auswahl.“"
                                            },
                                            {
                                                "example_id": "adba938e-7276-42de-8fd8-ba51f49a85c2",
                                                "sense_id": "c5282cf7-d1f8-3855-89bb-ed89475b9b28",
                                                "text": "„»[…] Ich bedauere, er ist zurzeit nicht im Haus, und ich kann Ihnen leider nicht sagen, wann er wieder zurück sein wird.« »Das verstehe ich nicht. Sie wissen nicht, wo Ihr Chef ist und wann er wieder im Büro sein wird?«“"
                                            },
                                            {
                                                "example_id": "6c44bd45-f43d-499d-ab22-516641191040",
                                                "sense_id": "c5282cf7-d1f8-3855-89bb-ed89475b9b28",
                                                "text": "Das Haus steht seit 1898."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42ff1041-0d88-3e93-9a72-95dbcbc0642f",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "zum Wohnen dienendes und genutztes Gebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b597564a-0675-424c-88b5-ee1550a24a3a",
                                                "sense_id": "42ff1041-0d88-3e93-9a72-95dbcbc0642f",
                                                "text": "Das Haus steht seit 1898."
                                            },
                                            {
                                                "example_id": "b2ccbf7c-cb07-4592-a18a-1b504f544196",
                                                "sense_id": "42ff1041-0d88-3e93-9a72-95dbcbc0642f",
                                                "text": "„Für Wochen schloss er sich in seinem Zimmer ein und wagte kaum einen Schritt vors Haus.“"
                                            },
                                            {
                                                "example_id": "2331e7fa-4f53-4032-a6a5-64722173fb26",
                                                "sense_id": "42ff1041-0d88-3e93-9a72-95dbcbc0642f",
                                                "text": "„Der Neu-Multimillionär will seinen Job behalten, aber mit der Familie (Frau, 2 Kinder) aus der kleinen Mietwohnung in ein Haus im Grünen umziehen.“"
                                            },
                                            {
                                                "example_id": "18a909eb-6fb6-4780-96b6-bf660e41dd1e",
                                                "sense_id": "42ff1041-0d88-3e93-9a72-95dbcbc0642f",
                                                "text": "Mein Haus wird gerade renoviert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0c011052-43a9-30c5-a2e6-6a16370dc585",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "aus mehreren Räumen bestehender, abgetrennter Bereich innerhalb eines unter [2] beschriebenen Gebäudes, in dem sich eine oder mehrere Personen ständig aufhalten können, leben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a459a5d-7377-444a-a5fe-6a0f3047c39d",
                                                "sense_id": "0c011052-43a9-30c5-a2e6-6a16370dc585",
                                                "text": "Mein Haus wird gerade renoviert."
                                            },
                                            {
                                                "example_id": "5bce7965-a95e-48fd-aa5e-02a61599c536",
                                                "sense_id": "0c011052-43a9-30c5-a2e6-6a16370dc585",
                                                "text": "Kommst du mit nach Hause?"
                                            },
                                            {
                                                "example_id": "06caa9e2-44c2-4bc9-8e2b-5aacdaf80e5c",
                                                "sense_id": "0c011052-43a9-30c5-a2e6-6a16370dc585",
                                                "text": "„Das ganze Haus war auf den Kopf gestellt, die Betten ungemacht, auf dem Tisch stand eine halbgegessene Mahlzeit.“"
                                            },
                                            {
                                                "example_id": "8604fd8e-dc59-4955-a882-e25c8d8158ec",
                                                "sense_id": "0c011052-43a9-30c5-a2e6-6a16370dc585",
                                                "text": "„Ich sagte nadelspitz: »Siehst du, das hast du nun davon: ich komme nicht mit nach Haus …«“"
                                            },
                                            {
                                                "example_id": "33dd543c-a9b2-4a7c-8503-8427d09da049",
                                                "sense_id": "0c011052-43a9-30c5-a2e6-6a16370dc585",
                                                "text": "„Das Haus ist vollständig eingerichtet, im Wohnzimmer gibt es diesen riesig großen Schreibtisch aus dunkelbraunem Holz mit einer grünen Ledereinlage auf der Oberfläche.“"
                                            },
                                            {
                                                "example_id": "13f1c372-a318-436c-8bbf-67f9f267ee98",
                                                "sense_id": "0c011052-43a9-30c5-a2e6-6a16370dc585",
                                                "text": "„Nie kommst du nach Hause, wir wissen nicht mehr weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2c823ef1-6e85-3ce6-9a3d-cedb5d3bbce4",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "Gesamtheit der Bewohner in dem unter [2] beschriebenen Gebäude"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff43e7e8-92a4-40c0-a1cb-e2f158b6a451",
                                                "sense_id": "2c823ef1-6e85-3ce6-9a3d-cedb5d3bbce4",
                                                "text": "„Unser Haus versammelte sich im Betsale.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c66f3053-4c17-3c29-8c21-adec0d5fefa5",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "Gesamtheit der Personen, die sich in einem bestimmten Amt, in einer bestimmten Stellung oder Tätigkeit in einem unter [1] beschriebenen Gebäude aufhalten oder dort einer Beschäftigung nachgehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ae4799-1857-42b5-a03f-59f93097de06",
                                                "sense_id": "c66f3053-4c17-3c29-8c21-adec0d5fefa5",
                                                "text": "Er ist durchaus in der Lage, ein großes Haus zu leiten."
                                            },
                                            {
                                                "example_id": "26da4929-609a-4159-a2c5-24a20c91edb1",
                                                "sense_id": "c66f3053-4c17-3c29-8c21-adec0d5fefa5",
                                                "text": "„Befürchtete etwa Thomas Mann, daß der Schwiegersohn und Nachfolger Samuel Fischers, der seit 1928 als Geschäftsführer des berühmten Verlages tätige Gottfried Bermann Fischer ihn, den in den Jahren der Emigration (und natürlich auch später) prominentesten Autor des Hauses schlechterdings übervorteilen wollte? Aber sicher.“"
                                            },
                                            {
                                                "example_id": "10812796-29ab-4fae-b952-b4b271c1c8f0",
                                                "sense_id": "c66f3053-4c17-3c29-8c21-adec0d5fefa5",
                                                "text": "„Angeblich wurde sie vom Geheimdienst MIT geführt, beteiligt waren nach Angaben des türkischen Außenministers Mevlüt auch sein Haus sowie die türkische Armee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0873622f-df73-34ee-ba2d-2eff25a25d17",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "gesetzgebende Körperschaft der Volksvertretung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418d239c-316c-43e1-98c3-4f9434fcdac7",
                                                "sense_id": "0873622f-df73-34ee-ba2d-2eff25a25d17",
                                                "text": "„Binnen weniger Stunden entschärften beide Häuser des Parlaments einen umstrittenen Artikel und stärkten so die Demokratie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "a930fd47-081a-3caa-a2a0-842baadd173f",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "im selben unter [2] beschriebenen Gebäude/im selben unter [3] beschriebenen Bereich lebende Gemeinschaft aus einem Elternpaar oder einem Elternteil samt mindestens einem Kind"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8418b06-b4b6-448c-9845-5a1337569b74",
                                                "sense_id": "a930fd47-081a-3caa-a2a0-842baadd173f",
                                                "text": "Dies ist ein ehrenwertes Haus."
                                            },
                                            {
                                                "example_id": "7569184f-1438-4c8d-b9eb-cd894b51bc65",
                                                "sense_id": "a930fd47-081a-3caa-a2a0-842baadd173f",
                                                "text": "Sie kam aus gutem Hause."
                                            },
                                            {
                                                "example_id": "9ffdcf1f-88be-4650-864d-286a849c3ab2",
                                                "sense_id": "a930fd47-081a-3caa-a2a0-842baadd173f",
                                                "text": "„[…] Joshua Wong kommt aus konservativem Haus, seine Eltern sind fromme Christen.“"
                                            },
                                            {
                                                "example_id": "da6db5cb-8ce1-40e9-bcdf-7fa2794a6f25",
                                                "sense_id": "a930fd47-081a-3caa-a2a0-842baadd173f",
                                                "text": "„Ein höherer Kanzleibeamter des Hauses Hochstätter tritt ein, eine würdige Erscheinung, der Zuverlässigkeit mit Gewandtheit verbindet. Er wendet sich zwar respektvoll, aber doch bestimmt an den Sohn des Hauses: Der Herr Vater läßt zur Unterschrift bitten, Herr Felix.“"
                                            },
                                            {
                                                "example_id": "9cc0ee6e-bfa4-4ad3-ae29-a9bfb1761144",
                                                "sense_id": "a930fd47-081a-3caa-a2a0-842baadd173f",
                                                "text": "„»Den Gang einer Mutter« nannte sie etwas pathetisch ihren Besuch, der den Nebenzweck hatte, Ulrich wieder für ihr Haus zu gewinnen, nachdem er in der Parallelaktion, wie man hörte, so große Erfolge hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "36ec417b-ebd6-39c5-a5bf-ab32ef02796a",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "Hauswesen der unter [7] beschriebenen Gemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49390c28-1898-4547-a223-e585686772d5",
                                                "sense_id": "36ec417b-ebd6-39c5-a5bf-ab32ef02796a",
                                                "text": "„Als sie die schmale Kost verzehrt hatten, legten sie sich zu Bett: aber am Morgen trieb er sie schon ganz früh heraus, weil sie das Haus besorgen sollte.“"
                                            },
                                            {
                                                "example_id": "90da4bf0-e713-4d0b-9995-c8f084926f18",
                                                "sense_id": "36ec417b-ebd6-39c5-a5bf-ab32ef02796a",
                                                "text": "„Sie brachte eine schöne Mitgift ins Haus und hinterließ ihrem Mann, kaum dass 1793 der einzige Sohn Karl August geboren war, bei ihrem frühen Tod Anno 1794 ein reiches Vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "c4d0d821-29a9-3b8e-b843-8dca15f70f4f",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "eine Reihe von adligen (angesehenen) Persönlichkeiten, Herrschern hervorgebrachtes Geschlecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4253b5b8-de39-4de8-a4d6-69874c3d7bd0",
                                                "sense_id": "c4d0d821-29a9-3b8e-b843-8dca15f70f4f",
                                                "text": "Man sieht es ihm nicht an, aber er kommt aus einem königlichen Haus."
                                            },
                                            {
                                                "example_id": "21e36b63-82c0-43c1-a2b5-c3337a6c9ebf",
                                                "sense_id": "c4d0d821-29a9-3b8e-b843-8dca15f70f4f",
                                                "text": "„Ist er wirklich der Prinz aus regierendem Hause, den ruchlose Verwandte in der Wildnis ausgesetzt haben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "e69a2686-c780-352d-a918-8f566838bd21",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "Mensch, Person"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1efa843-fd4c-46ba-871a-ef6661745992",
                                                "sense_id": "e69a2686-c780-352d-a918-8f566838bd21",
                                                "text": "„Eigentlich wollen sie nur zeigen, was für gelehrte, gescheite Häuser, für geistreiche Köpfe, für enorme Könner sie sind.“"
                                            },
                                            {
                                                "example_id": "e576f3c1-32cd-4c2e-9324-1886d5c0cf3e",
                                                "sense_id": "e69a2686-c780-352d-a918-8f566838bd21",
                                                "text": "„Es war ein hochgelehrtes Haus, berühmt als Orgelspieler und stets etwas stutzerhaft gekleidet mit Cut und gestreifter Hose.“"
                                            },
                                            {
                                                "example_id": "366960e4-a371-4478-ae32-36938a759b9d",
                                                "sense_id": "e69a2686-c780-352d-a918-8f566838bd21",
                                                "text": "„Herr Müller-Andreä jedoch lebt, er ist sogar obenauf, ein flottes Haus, eine fidele Nummer.“"
                                            },
                                            {
                                                "example_id": "5630b810-3c4b-415e-ba1a-94cfcc7dbf21",
                                                "sense_id": "e69a2686-c780-352d-a918-8f566838bd21",
                                                "text": "„Sonst war der Koch ja ein patentes Haus.“"
                                            },
                                            {
                                                "example_id": "243ac13d-8289-49cc-b1e9-3d66679e7ff8",
                                                "sense_id": "e69a2686-c780-352d-a918-8f566838bd21",
                                                "text": "„Die ältere Tochter vom Hauptmann, sie war wohl fast dreißig, war ein lustiges Haus.“"
                                            },
                                            {
                                                "example_id": "4b389259-5071-4580-92ac-e833c7f646da",
                                                "sense_id": "e69a2686-c780-352d-a918-8f566838bd21",
                                                "text": "„Sie, die sonst ein fideles Haus war, haderte mit allen Menschen, die es eigentlich gut mit ihr meinten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "503afc3e-af3a-3f81-898f-aa45c68b64ed",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "bestimmte Tiere (vor allem Weichtiere wie Gastropoden) umgebende feste, panzerartige, schützende Umhüllung"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "jargon",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45a4a6d-72ac-452c-b0ed-4a5e079bfb1a",
                                                "sense_id": "503afc3e-af3a-3f81-898f-aa45c68b64ed",
                                                "text": "Die Schnecke trägt ihr Haus mit sich."
                                            },
                                            {
                                                "example_id": "a7ec3352-c50b-48ab-8bfb-338a762eb9da",
                                                "sense_id": "503afc3e-af3a-3f81-898f-aa45c68b64ed",
                                                "text": "„Zur ersten Stufe gehörte die Kauri, Cypraea moneta; zur zweiten Stufe ein rund geschliffenes, durchbohrtes Muschelkügelchen; zur dritten Stufe zylinderförmiger Purpurwampum und das langgezogene Gehäuse des Cerithium muscarium, und zur vierten das ebenfalls gewundene Haus der Vivipara georgiana, einer Süßwasserschnecke, dazu kleine Hirschhornstücke, die halb rot halb grün gefärbt sind.“"
                                            },
                                            {
                                                "example_id": "c587f254-97ab-45d1-b900-76a84509fce5",
                                                "sense_id": "503afc3e-af3a-3f81-898f-aa45c68b64ed",
                                                "text": "„Für die Beschäftigung Jonathan Leverkühns mit der Naturwissenschaft werden im Roman zwölf Beispiele gegeben: das Blaulicht auf den Falterflügeln mit der Frage, ob das Himmelblau Trug sei, der Glasflügler Haetera Esmeralda, der Blattschmetterling, der sich seiner Umgebung anpaßt und daher nicht sichtbar ist, der Schmetterling, der durch Schönheit und Ungenießbarkeit gekennzeichnet ist, die Nachahmung dessen durch einen weiteren Schmetterling, der den Betrachter täuscht, das Haus der Schnecken und Muscheln, die schöne, aber giftige Kegelschnecke, die Strich-Ornamentik auf den Schneckenhäusern, die sichtbare Musik, die Eisblumen, der fressende Tropfen und die toten Gewächse der Kristalle.“"
                                            },
                                            {
                                                "example_id": "5c59eff3-0003-4d64-b5d2-48b91b75b189",
                                                "sense_id": "503afc3e-af3a-3f81-898f-aa45c68b64ed",
                                                "text": "„Die Häuser der Meeresschnecken wurden bei wichtigen Zeremonien wie Fanfaren eingesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    },
                                    {
                                        "sense_id": "b51ce0b5-eeaf-345f-a7ce-6362e0e5a4d7",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "Tierkreiszeichen in seiner Zuordnung zu einem Planeten"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "204d91e0-c4d4-4d18-bb23-5ea00b4c8bb1",
                                                "sense_id": "b51ce0b5-eeaf-345f-a7ce-6362e0e5a4d7",
                                                "text": "„ Es bestehen systematische Analogien zwischen Planeten, Zeichen, Häusern und Winkelbeziehungen: Jedes Haus ist beispielsweise einem Tierkreiszeichen zugeordnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"12\""
                                    },
                                    {
                                        "sense_id": "d90dae87-876a-3cd9-a3bf-3304c0ea32bf",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "einer der zwölf Abschnitte, in die der Tierkreis eingeteilt ist"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63ec6051-3394-4a74-ad05-a36572999a9d",
                                                "sense_id": "d90dae87-876a-3cd9-a3bf-3304c0ea32bf",
                                                "text": "Jedes der zwölf astrologischen Häuser entspricht einem bestimmten Bereich des alltäglichen Lebens, auf denen die Energie eines Planeten zum Ausdruck kommt."
                                            },
                                            {
                                                "example_id": "841b8f78-c6ae-4c72-a44d-b1d93b664a2c",
                                                "sense_id": "d90dae87-876a-3cd9-a3bf-3304c0ea32bf",
                                                "text": "„Ausgehend vom Aszendenten und den zwei Hauptachsen, werden nun die zwölf astrologischen Häuser berechnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"13\""
                                    },
                                    {
                                        "sense_id": "9c183a9c-860f-30cf-882a-7736fd0923e0",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "mittlerer Teil eines Hammerkopfes"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22481fa1-eb27-42df-a5e3-a4f67ac770dc",
                                                "sense_id": "9c183a9c-860f-30cf-882a-7736fd0923e0",
                                                "text": "„Hammer mit verbreiterter, stumpfer Finne, hohem, unregelmäßig ausgewölbtem Haus und schlankem Hammerteil mit gestauchter Bahn.“"
                                            },
                                            {
                                                "example_id": "5a63f3a6-19d2-46e6-a71a-3daccd1e2dc5",
                                                "sense_id": "9c183a9c-860f-30cf-882a-7736fd0923e0",
                                                "text": "„Der alte Nagelstock, an dem die Nägel nicht wie üblich mit dem Haus des Hammers eingeschlagen werden, sondern zur Erschwernis mit der Finne, also mit der schmalen Seite des Hammers, war bereits voll mit Nägeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"14\""
                                    },
                                    {
                                        "sense_id": "1fa1b401-3196-3302-9f9b-0bc9116c1ff3",
                                        "entry_id": "b6c7961c-b664-3fcb-8a5d-ec94a71eb7ff",
                                        "glosses": [
                                            "die drei konzentrischen Kreise, in denen Punkte erzielt werden können, die vom Kreis mit dem Radius von 6′ umschlossene Fläche"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6624301-f46a-4ec6-84e9-6b9dd84e74c5",
                                                "sense_id": "1fa1b401-3196-3302-9f9b-0bc9116c1ff3",
                                                "text": "„Pro Stein, der näher zur Mitte des Hauses liegt als der Stein des Gegners, gibt es einen Punkt.“"
                                            },
                                            {
                                                "example_id": "53755a9f-79f6-44fc-bbb6-aabf0f931991",
                                                "sense_id": "1fa1b401-3196-3302-9f9b-0bc9116c1ff3",
                                                "text": "„Während beim Curling in ein Haus gespielt wird, visiert der Eisstockschütze die so genannte Daube an, die aus Gummi besteht und deren Durchmesser knapp acht Zentimeter beträgt.“"
                                            },
                                            {
                                                "example_id": "c910d800-1878-4509-b53d-b553fe894af4",
                                                "sense_id": "1fa1b401-3196-3302-9f9b-0bc9116c1ff3",
                                                "text": "„Im Curling gilt es, den Stein ins Haus zu schieben – deshalb gelten erfolgreiche Curler als «häusliche Typen».“"
                                            },
                                            {
                                                "example_id": "e1b55d33-975f-46e8-9033-ca1acdb4b682",
                                                "sense_id": "1fa1b401-3196-3302-9f9b-0bc9116c1ff3",
                                                "text": "„Viertes End im Finale der 18. Internationalen Herb-Lackhoff-Trophy: Der letzte rote Stein von Skip Uwe Saile passt, bleibt wie berechnet im Haus liegen und bringt den Curling Club Mannheim gegenüber dem Team Solothurn I mit 4:3 in Führung.“"
                                            },
                                            {
                                                "example_id": "8563e933-b077-480d-978d-bedfbf2a6e7f",
                                                "sense_id": "1fa1b401-3196-3302-9f9b-0bc9116c1ff3",
                                                "text": "„Da Curling immer abwechselnd von einer auf die andere Seite gespielt wird, gibt es pro Rink zwei Häuser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"15\""
                                    }
                                ]
                            },
