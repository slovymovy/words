                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d77b0d60-d14f-487d-b6d5-8855c0b03428",
                                "sense_id": "62f98432-2459-35ef-9412-24ef1a1fac0a",
                                "text": "Dame! quand j'aurai tout claqué, faudra bien que je me dém… pour continuer à boire et à vacharder avec les copains !"
                            },
                            {
                                "example_id": "35d6cfb3-a3f6-4d72-937e-4e8bfdde4cb9",
                                "sense_id": "62f98432-2459-35ef-9412-24ef1a1fac0a",
                                "text": "Je n'ai plus maintenant qu'à fumer des cigarettes et à « vacharder », — suivant l'expression de mon dactylographe, le légionnaire Keller."
                            }
                        ]
                    }
