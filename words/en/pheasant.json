            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12e5db9a-45f3-3532-aeb4-1df6da11c361",
                    "sense_definition": "A large, long-tailed game bird native to Asia and widely introduced elsewhere, often hunted for sport and food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A wild <w>pheasant</w> suddenly flew out from the tall grass beside the road.",
                            "target_lang_translations": {
                                "ru": "Дикий <w>фазан</w> внезапно вылетел из высокой травы у дороги."
                            }
                        },
                        {
                            "text": "Many hunters travel to the countryside in the autumn to shoot <w>pheasants</w>.",
                            "target_lang_translations": {
                                "ru": "Осенью многие охотники отправляются за город, чтобы пострелять <w>фазанов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pheasant hunting",
                        "ring-necked pheasant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная длиннохвостая промысловая птица родом из Азии, широко расселённая в других регионах и являющаяся объектом охоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фазан",
                                "target_lang_sense_clarification": "птица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                    "sense_definition": "The meat of a pheasant eaten as food.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For the special dinner, the chef prepared roast <w>pheasant</w> with seasonal vegetables.",
                            "target_lang_translations": {
                                "ru": "Для праздничного ужина шеф-повар приготовил жареного <w>фазана</w> с сезонными овощами."
                            }
                        },
                        {
                            "text": "He ordered a slice of <w>pheasant</w> served with a rich red wine sauce.",
                            "target_lang_translations": {
                                "ru": "Он заказал кусочек <w>фазанятины</w> под насыщенным соусом из красного вина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roast pheasant"
                    ],
                    "target_lang_definitions": {
