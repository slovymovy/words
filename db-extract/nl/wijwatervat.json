                        "source_sense_id": "aff17f0c-e282-300f-ba9d-4ad89d5e8834",
                        "source_sense_description": "een meestal aan de muur van een kerk bevestigd vat met water waarmee gelovigen zich besprenkelen",
                        "target_lang_word": "Weihwasserbecken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weihwasserbecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c24a142-732d-39e1-9a92-5612d5e5d127",
                                        "entry_id": "39569d33-e87c-3dcc-aff5-ddd8f3311131",
                                        "glosses": [
                                            "ein Behältnis in Kirchen, das vom Priester gesegnetes Wasser enthält"
                                        ],
                                        "tags": [
                                            "Religion; katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b89e886-f1d3-474e-b4ae-16d530377980",
                                                "sense_id": "0c24a142-732d-39e1-9a92-5612d5e5d127",
                                                "text": "„So lebte sie also … in der lauen Atmosphäre der Klassenzimmer … und versank sanft in das mystische Schmachten, das die Düfte vom Altar her, die Kühle der Weihwasserbecken und der Schimmer der Kerzen aushauchten.“"
                                            },
                                            {
                                                "example_id": "58a3ca07-e235-435e-b172-805b30a4d3e3",
                                                "sense_id": "0c24a142-732d-39e1-9a92-5612d5e5d127",
                                                "text": "„Noch am gleichen Tag stahl ich mich nach der Schule in die Kirche und tauchte eine kleine Flasche - Liebesperlen von der letzten Kirmes waren darin gewesen - ins Weihwasserbecken, der Bruder füllte sein Marmeladenglas, mit dem er sonst am Rhein Kaulquappen fing.“"
                                            },
                                            {
                                                "example_id": "7ad1f8ee-5139-402b-ba23-1d0582259a28",
                                                "sense_id": "0c24a142-732d-39e1-9a92-5612d5e5d127",
                                                "text": "„Der Archivar, der vorsichtig dem Geräusch nachging, entdeckte über einem alten Weihwasserbecken neben der Eingangspforte des Saales einen schwarz polierten Holzkasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b51d6424-af0a-43e3-9415-f016e6432c4b",
                        "source_entry_id": "17a99981-71a1-3d54-bf53-29eed30ed2b7",
