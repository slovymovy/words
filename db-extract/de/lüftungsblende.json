                "senses": [
                    {
                        "sense_id": "d2a3ac0f-5ce6-3432-9050-eae04bf32545",
                        "entry_id": "03098b89-2e0a-399c-9a8a-46ec8e3f13e4",
                        "glosses": [
                            "Bauteil zur Gliederung oder Verzierung von Lüftungstechnik; unspezifisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff52e97-c7d2-4962-84a9-c62bfb34ebb9",
                                "sense_id": "d2a3ac0f-5ce6-3432-9050-eae04bf32545",
                                "text": "„Dann die Lüftungsblende nach unten ziehen und die 2 Schrauben lösen.“"
                            },
                            {
                                "example_id": "a8d0ca43-55e8-445b-88d7-7452c1ec43e9",
                                "sense_id": "d2a3ac0f-5ce6-3432-9050-eae04bf32545",
                                "text": "„Über geschlitzte Lüftungshauben im Dachblech, geschlitzte Sockelblenden und Lüftungsblenden im Bodenbereich des Schrankfeldes wird eine gute Belüftung der eingebauten Schaltgeräte sichergestellt.“"
                            },
                            {
                                "example_id": "8c9a607d-3750-415a-9af6-b3e0df2b2267",
                                "sense_id": "d2a3ac0f-5ce6-3432-9050-eae04bf32545",
                                "text": "„Ein Wechselspiel von horizontalen, vertikalen und diagonalen Bauteil-Elementen sorgt für ein angenehm abwechslungsreiches Fassadenbild, das zusätzlich noch durch die punktuell gesetzten farbigen Lüftungsblenden aufgelockert wird.“"
                            },
                            {
                                "example_id": "111cfca4-34a9-4821-9a99-416c081a412d",
                                "sense_id": "d2a3ac0f-5ce6-3432-9050-eae04bf32545",
                                "text": "„Ein neues Lenkrad, farblich anders gestaltete Lüftungsblenden und haptisch etwas höherwertigere Kunststoffe, das war es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
