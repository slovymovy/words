                ],
                "senses": [
                    {
                        "sense_id": "40b6013c-3de6-315b-b238-2ebe8ca629b9",
                        "entry_id": "84c1e5e5-abb5-3932-a5d9-1e2f73cc0dda",
                        "glosses": [
                            "Forme pronominale de afficher, être affiché ou être affichable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49712d42-5d9b-4c60-a1f0-22127c0ffa04",
                                "sense_id": "40b6013c-3de6-315b-b238-2ebe8ca629b9",
                                "text": "Pour les copies qui se signifient, il suffit qu’elles soient signées du Procureur du poursuivant ; il ne s’expédie rien au Greffe, de ce placard qui ne se met point en parchemin, il s’affiche sur les lieux sans Commissions, sous la signature du principal Commis."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0760c5c-ac43-3934-b97d-191789e93dab",
                        "entry_id": "84c1e5e5-abb5-3932-a5d9-1e2f73cc0dda",
                        "glosses": [
                            "Devenir visible sur un écran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82dfc353-12cf-42ec-a53e-ee8369c65eef",
                                "sense_id": "b0760c5c-ac43-3934-b97d-191789e93dab",
                                "text": "L’arborescence peut aussi s’afficher à droite du site, mais également être incorporée dans une WebPart."
                            }
                        ]
                    },
                    {
                        "sense_id": "28899cce-6c06-3cad-afdb-130c5be980db",
                        "entry_id": "84c1e5e5-abb5-3932-a5d9-1e2f73cc0dda",
                        "glosses": [
                            "S’affirmer, se mettre en scène, montrer aux autres ses défauts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45ff3185-4e61-4d33-8f95-76aa89812773",
                                "sense_id": "28899cce-6c06-3cad-afdb-130c5be980db",
                                "text": "Alors que certains s’en agacent, la cuisine ouverte possède, aux yeux d’autres habitants, une qualité car cette ouverture la rend « noble », elle s’affiche, elle s’affirme dans l’espace de réception qu’est le séjour."
                            }
                        ]
                    },
                    {
                        "sense_id": "a73d6fa5-92c6-3254-afe0-4eff6f1bf1a9",
                        "entry_id": "84c1e5e5-abb5-3932-a5d9-1e2f73cc0dda",
                        "glosses": [
                            "Se montrer avec quelqu’un en public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bfd4132-1b09-418b-9dfc-c60e45432546",
                                "sense_id": "a73d6fa5-92c6-3254-afe0-4eff6f1bf1a9",
                                "text": "— […] Regardez, Annette Villard : elle s’affiche de plus en plus avec ce soldat allemand."
                            }
                        ]
                    }
                ],
