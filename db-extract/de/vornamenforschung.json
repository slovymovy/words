                        "examples": [
                            {
                                "example_id": "922c874d-ef5b-47e8-8b5c-c2047170f524",
                                "sense_id": "6309e67d-95be-32ba-ad88-ecfe7c16a19f",
                                "text": "„Dieses Werk ist ebenso wie die weiteren benutzten Arbeiten zur Vornamenforschung und die herangezogenen Internetquellen im Literaturverzeichnis am Ende dieses Buches zu finden.“"
                            },
                            {
