            },
            {
                "entry_id": "6cd47539-9788-30f3-a462-977c88f5ad6d",
                "word": "lourde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b540561-2327-4e8c-a250-fa6af1592029",
                        "entry_id": "6cd47539-9788-30f3-a462-977c88f5ad6d",
                        "tags": [
                            "plural"
                        ],
                        "form": "lourdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44d4e402-a421-3083-9deb-33f4302eb52d",
                        "entry_id": "6cd47539-9788-30f3-a462-977c88f5ad6d",
                        "glosses": [
                            "Porte."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d8d6cacb-9c6e-42f8-9442-ce071f1d699c",
                                "sense_id": "44d4e402-a421-3083-9deb-33f4302eb52d",
                                "text": "J’men vas la boucler, moi, la lourde ! C’te putain de lourde !"
                            },
                            {
                                "example_id": "d67dacd8-d71e-40d8-8fe2-d0cca6fac09a",
                                "sense_id": "44d4e402-a421-3083-9deb-33f4302eb52d",
                                "text": "Elle traversa la pièce pour aller coller une oreille contre la lourde."
                            },
                            {
                                "example_id": "6dc683ba-cd0b-48c9-ae96-86f8126109a0",
                                "sense_id": "44d4e402-a421-3083-9deb-33f4302eb52d",
                                "text": "Mon idée, je la pense normalement en langage classique, en langage couleur muraille, et puis j’arrive avec mon pied-de-biche et je craque la lourde."
                            },
                            {
                                "example_id": "b21cc9d2-7f89-474d-a55c-1b6b07506783",
                                "sense_id": "44d4e402-a421-3083-9deb-33f4302eb52d",
                                "text": "Kalel saute de son pieu pour cavaler à la lourde."
                            },
                            {
                                "example_id": "09a1e04b-a8fd-40bc-bc37-d5332d7f5cea",
                                "sense_id": "44d4e402-a421-3083-9deb-33f4302eb52d",
                                "text": "Tout de suite, j’avise ce que je compte trouver là : un flic assis près de la lourde, avec cet air infiniment malheureux des gens condamnés à se faire chier des heures durant."
                            }
                        ]
                    },
                    {
                        "sense_id": "70944de0-664d-34f1-a6f4-7f4c3f08c02f",
                        "entry_id": "6cd47539-9788-30f3-a462-977c88f5ad6d",
                        "glosses": [
                            "Vertige, tournis."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "fd9c0221-676e-40b8-a1d6-889c25c08087",
                                "sense_id": "70944de0-664d-34f1-a6f4-7f4c3f08c02f",
                                "text": "Tu parles ni peu ni assez ; tu me fous la lourde !"
                            }
                        ]
                    },
                    {
                        "sense_id": "4f301b85-a73d-3cb8-8125-4aceb2f0d6e5",
                        "entry_id": "6cd47539-9788-30f3-a462-977c88f5ad6d",
                        "glosses": [
                            "Ivresse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "803b6d31-744a-4115-8984-5212f1e00e22",
                                "sense_id": "4f301b85-a73d-3cb8-8125-4aceb2f0d6e5",
                                "text": "Tu l’aurais vu, il avait une de ces lourdes, il ne marchait plus très droit !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
