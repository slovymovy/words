                "senses": [
                    {
                        "sense_id": "083fdae7-8746-3c7d-ad54-545fbfb0018a",
                        "entry_id": "5c22f92d-6f15-3b7c-bbeb-a5bdc9e2b323",
                        "glosses": [
                            "die Jahre 20 bis 29 des gegenwärtigen oder besagten Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b02ab8f-49c7-4f26-a26d-c363cd55f9c7",
                                "sense_id": "083fdae7-8746-3c7d-ad54-545fbfb0018a",
                                "text": "„In den Zwanzigerjahren war Rijeka das Zentrum eines kleinen, unabhängigen Freistaats mit dem italienischen Namen Fiume, der im Herbst 1920 ein dreimonatigen Intermezzo unter dem Namen Carnaro erlebte.“"
                            },
                            {
                                "example_id": "4b92080c-bf65-4627-81f2-5f80b6835d78",
                                "sense_id": "083fdae7-8746-3c7d-ad54-545fbfb0018a",
                                "text": "„Daddy kannte bereits seit Mitte der Zwanzigerjahre eine Pariserin namens Yvonne.“"
                            },
                            {
                                "example_id": "215fd39b-9c1b-4816-ab84-f405b1d2c2dd",
                                "sense_id": "083fdae7-8746-3c7d-ad54-545fbfb0018a",
                                "text": "„Anfang der Zwanzigerjahre hatte Zuckmayer Brecht in München kennengelernt und sogleich dessen genialische Überlegenheit erkannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
