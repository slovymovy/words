        "fr-extract.jsonl": [
            {
                "entry_id": "64082d1c-75e9-3222-b120-723bfb73318f",
                "word": "mmm",
                "pos": "onomatopoeia",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c914e38-842a-370a-96da-c264c097335c",
                        "entry_id": "64082d1c-75e9-3222-b120-723bfb73318f",
                        "glosses": [
                            "Onomatopée qui exprime le désir ou le bonheur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595b54f7-9b89-48b9-a2f8-f6f33e51f78a",
                                "sense_id": "3c914e38-842a-370a-96da-c264c097335c",
                                "text": "Un morceau de gâteau au chocolat ? Mmm, ça doit être bon."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c521495-e6b9-36cc-9203-7370ea1fc272",
                        "entry_id": "64082d1c-75e9-3222-b120-723bfb73318f",
                        "glosses": [
                            "Onomatopée qui exprime l’hésitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8734efbb-2061-460e-b08a-94b1bac2b4ca",
                                "sense_id": "2c521495-e6b9-36cc-9203-7370ea1fc272",
                                "text": "— Justement, ça laisse peut-être la possibilité de dire tout ce que tu veux.\n— Mmm. Je ne sais pas quoi marquer."
                            },
                            {
                                "example_id": "758f75eb-c620-4301-9563-79e132832c36",
                                "sense_id": "2c521495-e6b9-36cc-9203-7370ea1fc272",
                                "text": "Mmm... ça ressemble bien à un message. Mais ça fait des siècles que je n'ai pas transcrit un message en morse."
                            }
                        ]
                    },
                    {
                        "sense_id": "eef4558f-c40b-3539-bdda-d915cecaa579",
                        "entry_id": "64082d1c-75e9-3222-b120-723bfb73318f",
                        "glosses": [
                            "Onomatopée qui remplace les paroles de quelqu’un en train de lire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4011e3b5-37de-4b6b-ba18-ead1bc20d7cb",
                                "sense_id": "eef4558f-c40b-3539-bdda-d915cecaa579",
                                "text": "Il lut à très haute voix : « Je ne puis qu’approuver, monsieur, le titre de votre futur journal et je souhaite longue vie à L’indépendant. L’indépendance est l’affranchissement vis-à-vis des autres, c’est-à-dire la vraie liberté, liberté qu’une subvention du ministère de l’intérieur risquerait de compromettre… mmm… mmm… »\n— Le reste est sans importance, grommela M. de Rocheflamme."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c9ccc05-e8ad-3444-9b85-089e2f46b89c",
                        "entry_id": "64082d1c-75e9-3222-b120-723bfb73318f",
                        "glosses": [
                            "Sous forme interrogative, onomatopée sollicitant une approbation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c1ac60-8f2d-4ea5-8c28-bbbe157609d8",
                                "sense_id": "4c9ccc05-e8ad-3444-9b85-089e2f46b89c",
                                "text": "Tu pourrais me trouver un nouveau fauteuil. Je veux remplacer celui-ci que tu m'as fait acheter il y a dix ans. Un confortable en bon vieux bois, mmm? Coûtera pas cher... »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b02aed1a-72c8-4823-9388-bcfe0d624c6a",
                        "source_entry_id": "64082d1c-75e9-3222-b120-723bfb73318f",
                        "target_lang_word": "mmm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mmm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e6645e1-ec97-37a0-919c-c04d171c4840",
                                        "entry_id": "41271c30-48dc-3341-9103-a6da20e98c03",
                                        "glosses": [
                                            "An emotional expression of deliciousness"
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaee7d23-d81c-4b34-b4de-bc4cb484f930",
                                                "sense_id": "2e6645e1-ec97-37a0-919c-c04d171c4840",
                                                "text": "Mmm, this is a tasty pie!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604c4283-82bf-3959-b0d4-31b235a7c150",
                                        "entry_id": "41271c30-48dc-3341-9103-a6da20e98c03",
                                        "glosses": [
                                            "An expression used to show thought or reflection"
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "358968ef-67a1-40ac-9929-70eeea0f726f",
                                                "sense_id": "604c4283-82bf-3959-b0d4-31b235a7c150",
                                                "text": "Mmm, I see what you mean."
                                            },
                                            {
                                                "example_id": "abb2e3b4-6f1e-47c7-b010-0cb48a2640e3",
                                                "sense_id": "604c4283-82bf-3959-b0d4-31b235a7c150",
                                                "text": "In his final years he [John Ogdon] gave an interview to an American journalist who noticed that “his handshake is a boneless fadeaway. His response to a lengthy anecdote from a close friend is likely to range from a non-committal ‘Mmmmmmm’ to a rare ‘Very interesting’.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211556c9-b785-33e5-b3a7-693d8c50c2a7",
                                        "entry_id": "41271c30-48dc-3341-9103-a6da20e98c03",
                                        "glosses": [
                                            "Used to represent an utterance that is muffled or spoken with a full mouth (also spelled \\\"mmph\\\")."
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa8df72f-ec4b-31ab-be47-a24173bf8ebe",
                                        "entry_id": "41271c30-48dc-3341-9103-a6da20e98c03",
                                        "glosses": [
                                            "Yes."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08c0d6b-c669-4078-b567-509f6cb3a1cc",
                                                "sense_id": "fa8df72f-ec4b-31ab-be47-a24173bf8ebe",
                                                "text": "Danny: Have you got any food?\nI: Mmm! As a matter of fact, got a saveloy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
