                        "examples": [
                            {
                                "example_id": "8da199b0-f2ff-45e0-a793-817a91dabeea",
                                "sense_id": "b4e56699-f27b-3265-96ae-8ca839b88e68",
                                "text": "Als er in einer Kurve auf die Gegenfahrbahn geriet, kam es zur Kollision."
                            },
                            {
                                "example_id": "36062984-ca54-48b1-a3f5-13210e567b96",
                                "sense_id": "b4e56699-f27b-3265-96ae-8ca839b88e68",
                                "text": "„Ein Auto prallte auf einer Bundesstraße bei Pfunds auf der Gegenfahrbahn frontal gegen einen Lkw.“"
                            },
                            {
                                "example_id": "5d917ba7-3549-4b61-8cef-9a9b351a7f12",
                                "sense_id": "b4e56699-f27b-3265-96ae-8ca839b88e68",
                                "text": "„Es erstreckte sich von der Mitte der rechten Fahrspur, auf der sich der Truck befand, schräg nach vorne über die komplette Gegenfahrbahn und ragte dann links noch etwa fünf Meter frei über die Brücke hinaus.“"
                            }
                        ],
