                    },
                    {
                        "translation_id": "28c2e1ba-83d0-4536-b9f6-a13e8cdaaefb",
                        "source_entry_id": "cb74d5e3-1805-31c6-a1db-1b05e9295c8c",
                        "source_sense_id": "685143ce-2bff-37b0-b960-345d7db83dba",
                        "source_sense_description": "een onderstel voor o.a. beelden en vazen",
                        "target_lang_word": "piédestal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piédestal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                        "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                                        "glosses": [
                                            "Support isolé avec base et corniche, qui soutient une statue, une colonne, un candélabre, etc."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6f3356-0254-443c-b1c1-37e4cdf7100d",
                                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                                "text": "Et tout autour du perron, en dehors, vingt-quatre piédestaux se rangeaient, supportant aussi des statues de jeunes filles, toutes admirablement belles, mais toutes attaquées et domptées par l’outrage d’un invisible ennemi."
                                            },
                                            {
                                                "example_id": "acc2d3ed-aeab-4e7a-b482-73e6a799b033",
                                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                                "text": "Le maitre fut de l'avis du serviteur et ils passèrent ensemble de l’autre côté du vaste piédestal de la colonne."
                                            },
                                            {
                                                "example_id": "c7e87ffc-ef6d-4bc2-b1be-b8033f6f64fc",
                                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                                "text": "Jamais P’tit-Bonhomme et Bob n’avaient vu pareille foule d’illustres personnages sur leurs piédestaux !"
                                            },
                                            {
                                                "example_id": "8907ef4a-0939-4918-b14a-90be8f6fd6f0",
                                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                                "text": "Agenouillées, elles fleurissent de nouvelles fleurs son piédestal moussu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a510cc-731d-3452-9c8c-ef7aca710322",
                                        "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                                        "glosses": [
                                            "Soubassement d’une file de colonnes avec base et corniche."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fa2340b-32b8-4067-a784-2c0df6e528bc",
                                                "sense_id": "c6a510cc-731d-3452-9c8c-ef7aca710322",
                                                "text": "Piédestal continu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                                        "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                                        "glosses": [
                                            "Ce qui sert à hausser quelqu’un, à le faire paraître."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbad2886-91cf-4e4f-b2ab-9db912ba57bd",
                                                "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                                                "text": "Le président de cette république pavoise sur son piédestal."
                                            },
                                            {
                                                "example_id": "5fec5512-dd43-4311-9867-b86dfdcaf846",
                                                "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                                                "text": "[…] quand on aborde ce sujet, ils ressentent inconsciemment le vertige de leur ignorance et, tout aussi inconsciemment, rejettent un dossier qui pourrait les faire tomber de leur piédestal."
                                            },
                                            {
                                                "example_id": "d1eeb5c0-1e0a-416c-8cc2-2ede50e0a19c",
                                                "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                                                "text": "Ainsi, on se sent obligé de la remercier et de cette façon, elle remonte sur son piédestal…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
