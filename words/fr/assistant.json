    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff742d5e-e184-3974-bd15-6e2a7e7ab67f",
                    "sense_definition": "Personne qui seconde quelqu'un d'autre dans ses fonctions ou son travail quotidien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "metier_aide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a engagé un nouvel <w>assistant</w> pour l'aider à traiter le courrier urgent."
                        },
                        {
                            "text": "Mon collègue a longtemps exercé comme <w>assistant</w> de direction avant d'obtenir ce poste."
                        }
                    ],
                    "synonyms": [
                        "aide",
                        "collaborateur",
                        "adjoint"
                    ],
                    "common_phrases": [
                        "assistant de direction",
                        "assistant parlementaire",
                        "assistant de recherche"
                    ]
                },
                {
                    "sense_id": "ba5e2644-e755-34d6-ac1b-51aec955807c",
                    "sense_definition": "Personne présente en un lieu à un moment donné, particulièrement lors d'une assemblée, d'une cérémonie ou d'un spectacle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur a pris tous les <w>assistants</w> à témoin pour appuyer sa déclaration solennelle."
                        },
                        {
                            "text": "Une grande émotion s'est propagée parmi les <w>assistants</w> dès le début de la cérémonie."
                        }
                    ],
                    "synonyms": [
                        "spectateur",
                        "témoin",
                        "participant"
                    ],
                    "common_phrases": [
                        "prendre les assistants à témoin"
                    ]
                },
                {
                    "sense_id": "0664710f-3f07-3464-b932-e583c1052078",
                    "sense_definition": "Programme d'aide intégré à un logiciel ou appareil, guidant l'utilisateur dans l'exécution de tâches spécifiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez facilement configurer votre logiciel en suivant les étapes recommandées par l'<w>assistant</w>."
                        },
                        {
                            "text": "Il utilise quotidiennement un <w>assistant</w> vocal pour dicter ses courriels et gérer son agenda."
                        }
                    ],
                    "synonyms": [
                        "guide"
                    ],
                    "common_phrases": [
                        "assistant vocal",
                        "assistant virtuel",
                        "assistant d'installation"
                    ]
                },
                {
                    "sense_id": "bc01f089-01b1-3d16-b45d-a0ed9c332177",
                    "sense_definition": "Personne qui aide le supérieur général ou le provincial dans l'administration d'un ordre religieux.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le religieux a été désigné comme <w>assistant</w> du général lors du dernier chapitre de l'ordre."
                        },
                        {
                            "text": "L'<w>assistant</w> provincial supervise les différentes communautés installées dans la région nord."
                        }
                    ],
                    "common_phrases": [
                        "assistant général",
                        "assistant provincial"
                    ]
                }
            ]
        },
