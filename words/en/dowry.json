        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62db4bc0-5a52-3bd1-93b7-91fe724a5e8e",
                    "sense_definition": "To bestow a dowry upon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy merchant <w>dowried</w> his daughter with gold and fine silks.",
                            "target_lang_translations": {
                                "ru": "Богатый купец <w>наделил приданым</w> свою дочь золотом и тонкими шелками.",
                                "fr": "Le riche marchand a <w>doté</w> sa fille d'or et de soies fines.",
                                "zh": "富商用黄金和上等丝绸为女儿<w>陪嫁</w>。"
                            }
                        },
                        {
                            "text": "She was <w>dowried</w> handsomely to ensure a good match.",
                            "target_lang_translations": {
                                "ru": "За ней <w>дали хорошее приданое</w>, чтобы обеспечить выгодную партию.",
                                "fr": "Elle a été richement <w>dotée</w> afin de lui assurer un bon parti.",
                                "zh": "家人为她准备了丰厚的<w>陪嫁</w>，以确保结成一门好亲事。"
                            }
