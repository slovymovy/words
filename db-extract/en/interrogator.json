                                                "example_id": "2d15a64d-ef4a-4f27-9eb2-7968805b2c4c",
                                                "sense_id": "1ee19d96-66f1-375e-88b9-33cf7aa8e85c",
                                                "text": "Die Antwort genügte dem Fragesteller nicht."
                                            },
                                            {
                                                "example_id": "79749e04-8974-4cb4-a6c1-f982f54836d7",
                                                "sense_id": "1ee19d96-66f1-375e-88b9-33cf7aa8e85c",
                                                "text": "„Man konnte fast die beruhigten Seufzer meiner Fragesteller hören.“"
                                            },
                                            {
                                                "example_id": "57deb281-87af-40f1-8f0f-7a04498a5a23",
                                                "sense_id": "1ee19d96-66f1-375e-88b9-33cf7aa8e85c",
                                                "text": "„Seine Antworten machten tiefen Eindruck auf die Fragesteller und flößten größte Hochachtung ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
