                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b01a210-ae4a-43e7-833b-3d1bc04d113b",
                                "sense_id": "956a4424-b56e-38d7-b4ec-d191f603bbfd",
                                "text": "Een tweestrijd tussen viervoudig winnaar Bernard Hinault en de winnaar van 1983 Laurent Fignon mondde uit in een ruime zege voor de laatste."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4722def-17d5-37cd-8366-67344edb0108",
