                                    {
                                        "sense_id": "95e1c5e8-c600-3992-bf06-e86175c89941",
                                        "entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                                        "glosses": [
                                            "Fähigkeit der Zusammenarbeit von verschiedenen Systemen, Techniken oder Organisationen; insbesondere möglichst nahtloses Zusammenarbeiten, um Informationen auf effiziente und verwertbare Art und Weise auszutauschen beziehungsweise den Benutzern zur Verfügung zu stellen"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc8525c2-e5c4-31c3-a4ea-b1533ef6033f",
                                        "entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                                        "glosses": [
                                            "Konstellation, in der mehrere Programme dasselbe Protokoll beziehungsweise dieselben Protokolle oder Datenformate verwenden können"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0236e01-14a0-42df-b649-8a14fd49d45d",
                                                "sense_id": "dc8525c2-e5c4-31c3-a4ea-b1533ef6033f",
                                                "text": "…“der große Erfolg des Internets beruht schließlich darauf, dass die offenen Internetprotokolle eine maximale Interoperabilität ermöglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7617a28f-ae93-44c8-bea1-fbf206611652",
                        "source_entry_id": "e028f235-32ac-3315-aef4-7d3e48916807",
                        "source_sense_description": "computing",
                        "target_lang_word": "Kompatibilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kompatibilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                        "entry_id": "8ae90ea4-18a7-3c96-bb9d-7d9cb911256a",
                                        "glosses": [
                                            "die Eigenschaft kompatibel zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8945dd49-f8a1-4e89-a866-0c01bf027219",
                                                "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                                "text": "Bevor man die Bauteile in den Computer einbaut, sollte man auf deren Kompatibilität achten."
                                            },
                                            {
                                                "example_id": "de0dba87-1b73-44a0-b621-94a6415868cc",
                                                "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                                "text": "„Allerdings ist das so eine Sache mit der Kompatibilität von Sehnsucht und Realität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                        "entry_id": "8ae90ea4-18a7-3c96-bb9d-7d9cb911256a",
                                        "glosses": [
                                            "Verträglichkeit, Kombinierbarkeit sprachlicher Elemente im Satz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c843ee15-745c-4a88-b1f0-bdbcb74a9ae0",
                                                "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                                "text": "„Auf semantischen Merkmalen als bedeutungskonstitutiven Elementen beruhen Kompatibilität oder Inkompatibilität lexikalischer Einheiten.“"
                                            },
                                            {
                                                "example_id": "15e001d2-59d7-40dd-afb1-9c68657d4b3a",
                                                "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                                "text": "„Die Kompatibilität, die in den soeben genannten Forschungsrichtungen als eine primär semantische Erscheinung gewertet wurde, muß auf der Ausdrucksseite der Sprache eine irgendwie geartete Entsprechung haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
