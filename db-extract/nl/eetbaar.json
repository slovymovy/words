                                "target_senses": [
                                    {
                                        "sense_id": "e2d86578-16e4-3e83-899b-c56642b44379",
                                        "entry_id": "c1064dcc-61de-3b86-b567-6f540ba9e286",
                                        "glosses": [
                                            "Qui peut servir d’aliment à l’humain, que l’on peut consommer sans se blesser ni s’intoxiquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492f5753-1da5-46fc-89ce-95c5a128c649",
                                                "sense_id": "e2d86578-16e4-3e83-899b-c56642b44379",
                                                "text": "Notre vieille amie, murée dans sa fâcherie, mélangea allégrement russules et lactaires, clitocybes et coprins, et même quelques amanites — parfaitement comestibles celles-là, et même savoureuses, comme le sont la plupart des représentants de cette famille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79201835-5fbc-32bc-8597-4eda6a5360ab",
                                        "entry_id": "c1064dcc-61de-3b86-b567-6f540ba9e286",
                                        "glosses": [
                                            "Apte à être sexuellement consommé."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c560258f-b86c-4981-84ef-3ac44e68b8c3",
                                                "sense_id": "79201835-5fbc-32bc-8597-4eda6a5360ab",
                                                "text": "Elle me fixait de son œil large de vache sacrée. Elle appartenait à l’espèce pour laquelle je sais que je suis comestible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comestible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c822b4d5-5b25-3d51-8220-d0d3e66dd676",
                                        "entry_id": "f525442a-7e0f-36c1-bfa9-4f55c47d233e",
                                        "glosses": [
                                            "Produit alimentaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca49ceb-ef37-40ac-bf71-9bb0cac56689",
                                                "sense_id": "c822b4d5-5b25-3d51-8220-d0d3e66dd676",
                                                "text": "Le premier acte qui classe l’argent et les comestibles parmi les objets de contrebande, est le traité du 16 août 1604, entre l’Espagne et l’Angleterre; […]."
                                            },
                                            {
                                                "example_id": "84d74b9b-b0ed-42bf-9182-06b2c68ff247",
                                                "sense_id": "c822b4d5-5b25-3d51-8220-d0d3e66dd676",
                                                "text": "Duchotel.— Et tiens !… la bourriche : rien ne me force à te le dire : eh bien ! elle venait de chez le marchand de comestibles !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
