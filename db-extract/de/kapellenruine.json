                "senses": [
                    {
                        "sense_id": "f0d66615-a619-3798-ba90-b3899fac4db4",
                        "entry_id": "41a400fb-6ac3-3006-a640-b8ab396f1980",
                        "glosses": [
                            "ungenutzter, teilweise eingestürzter, verfallener oder zerstörter Kapellenbau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6201e2-c84d-415d-b7bc-6321f78d35e3",
                                "sense_id": "f0d66615-a619-3798-ba90-b3899fac4db4",
                                "text": "„Wer noch vor wenigen Jahren die Kapellenruine suchte, mußte ein gut geschultes Auge für das „Verborgene“ haben.“"
                            },
                            {
                                "example_id": "dd71bcbe-20a5-46d9-85fe-4ced5f7c263d",
                                "sense_id": "f0d66615-a619-3798-ba90-b3899fac4db4",
                                "text": "„In den eigentlichen Garten geht es rechts an der Scheune vorbei durch die Kapellenruine.“"
                            },
                            {
                                "example_id": "932fb5b2-6cb6-48b3-a2c2-9b18ea4e4caf",
                                "sense_id": "f0d66615-a619-3798-ba90-b3899fac4db4",
                                "text": "„Die Kapellenruine von Sogn Benedetg oberhalb von Sumvitg soll saniert werden.“"
                            },
                            {
                                "example_id": "3f8fd9d3-b52b-418d-87c4-4ac1ef134f8d",
                                "sense_id": "f0d66615-a619-3798-ba90-b3899fac4db4",
                                "text": "„Als nach dem Krieg viele katholische Flüchtlinge und Aussiedler nach Gimmeldingen kamen, die ein eigenes Gotteshaus wollten und die Kirchenstiftung \"St. Nikolaus\" gegründet wurde, beschloss der Gimmeldinger Gemeinderat 1955, ihnen die Kapellenruine zu verkaufen.“"
                            },
                            {
                                "example_id": "57dad360-f2ad-4b30-9b2d-0daca6b347dd",
                                "sense_id": "f0d66615-a619-3798-ba90-b3899fac4db4",
                                "text": "„Auf der Plattform neben der alten Kapellenruine hat Tassilo Wenzl-Sylvester eindecken lassen, der Schampus ist gekühlt, er wartet auf seine Frau Marion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
