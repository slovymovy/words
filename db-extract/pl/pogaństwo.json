                "translations": [
                    {
                        "translation_id": "6113bc00-15e2-4e32-9e0b-b15d2bc56a5c",
                        "source_entry_id": "5b9544b7-368c-3613-abac-d8e6eaf2e3a0",
                        "source_sense_id": "6e0d289f-7eeb-3c60-a761-52ee1ee661f4",
                        "target_lang_word": "paganism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paganism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef018ff0-2a0b-39c4-a96f-e8f6f4e16ddd",
                                        "entry_id": "ed1f96ed-56dc-3e97-81c4-3d65f59e6222",
                                        "glosses": [
                                            "Any indigenous polytheistic religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3c09f8-64ae-4091-a725-f0ba7e1be4d3",
                                                "sense_id": "ef018ff0-2a0b-39c4-a96f-e8f6f4e16ddd",
                                                "text": "Most people in that region practise their own form of paganism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73b70e22-9723-33b8-b118-975ca7884910",
                                        "entry_id": "ed1f96ed-56dc-3e97-81c4-3d65f59e6222",
                                        "glosses": [
                                            "Any of a class of religions often associated with nature rituals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ecca89-bd6f-40c7-b290-7c80d4f093ba",
                                                "sense_id": "73b70e22-9723-33b8-b118-975ca7884910",
                                                "text": "Various neopagan movements have arisen, each advancing its own form of paganism. Some are monotheist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c2b91f6-0d0d-4448-8270-983e428af7b9",
                        "source_entry_id": "5b9544b7-368c-3613-abac-d8e6eaf2e3a0",
                        "source_sense_id": "6e0d289f-7eeb-3c60-a761-52ee1ee661f4",
                        "target_lang_word": "paganity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paganity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c25cb103-fa76-3fc8-a94c-680c79a840da",
                                        "entry_id": "9c0c8c5c-eff9-3b38-9b3c-ee497e8641ba",
