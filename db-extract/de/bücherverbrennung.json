                        ],
                        "form": "die Bücherverbrennung"
                    },
                    {
                        "form_id": "1112f10c-8647-448f-870a-4b16ae9dd570",
                        "entry_id": "e88d4ee6-802d-3297-b404-57d954ad2a6f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bücherverbrennungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57398745-f7a0-3785-93d4-1c264144d8ef",
                        "entry_id": "e88d4ee6-802d-3297-b404-57d954ad2a6f",
                        "glosses": [
                            "demonstrative Brandmarkung unliebsamer Schriften als unerwünscht/ungeduldet, indem sie verbrannt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ece3e4-2160-405f-bb84-3e5b8aca3ae1",
                                "sense_id": "57398745-f7a0-3785-93d4-1c264144d8ef",
                                "text": "Im Nationalsozialismus wurden 1933 durch Bücherverbrennung die Werke bedeutsamer Autoren als unerwünscht gebrandmarkt."
                            },
                            {
                                "example_id": "1abc073e-6cf2-40b2-9bd4-a2db080ed191",
                                "sense_id": "57398745-f7a0-3785-93d4-1c264144d8ef",
                                "text": "„Sie wußten, wir hatten die Geschichten von den »Zwischenfällen« zwischen den Truppen und den Flüchtlingen gehört und auch die Geschichte von der Bücherverbrennung.“"
                            },
                            {
                                "example_id": "faeaff6a-8799-4a69-8d64-f6fea13d26b4",
                                "sense_id": "57398745-f7a0-3785-93d4-1c264144d8ef",
                                "text": "„Schließlich geht es - im Gegensatz zur Bücherverbrennung der Nazis - nicht um den Inhalt der Bücher, sondern um die Auslöschung der deutschen Buchstaben.“"
                            },
                            {
                                "example_id": "e70bdd5e-a39b-446a-ad4d-3a153fc70798",
                                "sense_id": "57398745-f7a0-3785-93d4-1c264144d8ef",
                                "text": "„Sie hatten die Bücherverbrennungen, die Judenverfolgungen und das Gefühl nicht ertragen können, daß ein schwarzer Vorhang sich über das Land senkte.“"
                            },
                            {
                                "example_id": "ae04f0e6-2e30-4a7f-b2b1-f6c1ae93dd6f",
                                "sense_id": "57398745-f7a0-3785-93d4-1c264144d8ef",
                                "text": "„Die propagandistisch gezielte und brutale Machtdurchsetzung im Deutschen Reich von Januar 1933 bis zur Bücherverbrennung in den Universitätsstädten am 10. Mai 1933 erscheint ins Drama transponiert.“"
                            },
                            {
                                "example_id": "57413c87-c32b-4381-afb4-abc0852d16b0",
                                "sense_id": "57398745-f7a0-3785-93d4-1c264144d8ef",
                                "text": "„Am Abend des 10. Mai 1933 geht es los: Kundgebung im Auditorium der jeweiligen Universität, 22:00 Fackelzug zum Verbrennungsort, 23:00 bis 24:00 Bücherverbrennung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
