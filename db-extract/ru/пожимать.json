                        "examples": [
                            {
                                "example_id": "bce4ed4b-ae6c-4a9f-b2b4-80da7c477b9e",
                                "sense_id": "d6f4a7cb-c8c9-3116-91b8-a45a557b2605",
                                "text": "пожима́ть ру́ку",
                                "translation": "to press hand / to shake hands",
                                "english": "to press hand / to shake hands"
                            },
                            {
                                "example_id": "666ca113-2fd5-4ceb-852e-f6a62997705f",
                                "sense_id": "d6f4a7cb-c8c9-3116-91b8-a45a557b2605",
                                "text": "Я хочу́ пожима́ть мое́й прия́тельнице ру́ку.",
                                "translation": "I want to shake my friend's hand.",
                                "english": "I want to shake my friend's hand."
                            },
                            {
                                "example_id": "cb76c909-bf17-4253-8c9d-038d7506dc87",
                                "sense_id": "d6f4a7cb-c8c9-3116-91b8-a45a557b2605",
                                "text": "пожима́ть плеча́ми",
                                "translation": "to shrug one's shoulders",
                                "english": "to shrug one's shoulders"
                            }
                        ]
                    }
