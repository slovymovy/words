{
    "word_family": [
        "knak",
        "knik",
        "knikken",
        "afknakken",
        "geknak"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7477885-053d-3d78-8ad1-d7996979f6c4",
                    "sense_definition": "breken waarbij de uiteinden nog aan elkaar vast blijven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "breken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De takjes <w>knakken</w> onder de zware schoenen van de wandelaar.",
                            "target_lang_translations": {
                                "en": "The twigs <w>snap</w> under the hiker's heavy shoes."
                            }
                        },
                        {
                            "text": "Door de harde wind begon de jonge boom gevaarlijk te <w>knakken</w>.",
                            "target_lang_translations": {
                                "en": "Because of the strong wind, the young tree began to <w>crack</w> dangerously."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een takje knakken"
                    ],
                    "target_lang_definitions": {
                        "en": "to snap or break partially so that the ends remain attached"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to snap",
                                "target_lang_sense_clarification": "breaking partially with a sound"
                            },
                            {
                                "target_lang_word": "to crack",
                                "target_lang_sense_clarification": "breaking without fully separating"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b71442-f114-35a2-9e1d-71c6a017ae17",
                    "sense_definition": "een kort, scherp geluid maken met de gewrichten van de handen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een slechte gewoonte om voortdurend je vingers te <w>knakken</w>.",
                            "target_lang_translations": {
                                "en": "It is a bad habit to constantly <w>crack</w> your knuckles."
                            }
                        },
                        {
                            "text": "Hij zat zenuwachtig met zijn vingers te <w>knakken</w> tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "He was nervously <w>cracking</w> his knuckles during the conversation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vingers laten knakken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a short, sharp sound with the joints of the hands"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to crack",
                                "target_lang_sense_clarification": "making a sound with knuckles"
                            },
                            {
                                "target_lang_word": "to pop",
                                "target_lang_sense_clarification": "making a popping sound with joints"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8cf3398-f3a9-3024-9d4f-6e8b37a45b4e",
                    "sense_definition": "plotseling de moed of geestelijke kracht verliezen door een schokkende gebeurtenis",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij hoorde dat zijn kind was overleden <w>knakte</w> er iets in hem.",
                            "target_lang_translations": {
                                "en": "When he heard that his child had passed away, something in him <w>broke</w>."
                            }
                        },
                        {
                            "text": "Na jaren van tegenslag <w>knakte</w> zijn wilskracht uiteindelijk volledig.",
                            "target_lang_translations": {
                                "en": "After years of adversity, his willpower finally <w>snapped</w> completely."
                            }
                        }
                    ],
                    "common_phrases": [
                        "er knakt iets"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figuurlijk"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to suddenly lose courage or mental strength due to a shocking event"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to break",
                                "target_lang_sense_clarification": "losing mental or emotional strength"
                            },
                            {
                                "target_lang_word": "to snap",
                                "target_lang_sense_clarification": "suddenly losing composure or will"
                            },
                            {
                                "target_lang_word": "to crumble",
                                "target_lang_sense_clarification": "gradually losing resolve"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "404cb8ae-9082-3403-9472-abf320add79d",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>knak</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude stoel gaf verschillende luide <w>knakken</w> voordat hij instortte.",
                            "target_lang_translations": {
                                "en": "The old chair gave several loud <w>cracks</w> before it collapsed."
                            }
                        },
                        {
                            "text": "Na de val voelde hij een paar gemene <w>knakken</w> in zijn rug.",
                            "target_lang_translations": {
                                "en": "After the fall, he felt a few nasty <w>cracks</w> in his back."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'knak', referring to sharp cracking or snapping sounds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cracks",
                                "target_lang_sense_clarification": "sharp snapping sounds"
                            },
                            {
                                "target_lang_word": "snaps",
                                "target_lang_sense_clarification": "sudden breaking sounds"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}