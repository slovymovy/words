                            }
                        ]
                    }
                },
                {
                    "sense_id": "162d5648-49ab-3bec-b73a-9a91cfb79d9e",
                    "sense_definition": "Stupefied, senseless, or dazed, often as a result of a shock or repetitive action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise scared me <w>silly</w> when I was walking home alone.",
                            "target_lang_translations": {
                                "ru": "Громкий шум напугал меня до <w>безумия</w>, когда я шел домой один.",
                                "tr": "Eve yalnız yürürken yüksek ses beni <w>ölesiye</w> korkuttu.",
                                "de": "Das laute Geräusch hat mich <w>zu Tode</w> erschreckt, als ich alleine nach Hause ging."
                            }
                        },
                        {
                            "text": "He was knocked <w>silly</w> after bumping his head on the low doorway.",
                            "target_lang_translations": {
                                "ru": "Он был <w>оглушен</w>, ударившись головой о низкий дверной проем.",
                                "tr": "Alçak kapı eşiğine kafasını çarptıktan sonra <w>sersemledi</w>.",
                                "de": "Er war völlig <w>benommen</w>, nachdem er sich den Kopf am niedrigen Türrahmen gestoßen hatte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scared silly",
                        "knocked silly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in phrases like 'scared silly' or 'knocked silly'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошеломленный, потерявший сознание или одурманенный, часто в результате шока или повторяющегося действия.",
                        "tr": "Şok veya tekrarlayan bir eylem sonucunda sersemlemiş, bilincini veya dengesini kaybetmiş.",
                        "de": "Benommen, betäubt oder verwirrt, oft als Folge eines Schocks oder einer wiederholten Einwirkung."
                    },
                    "translations": {
                        "ru": [
