{
    "word_family": [
        "harmful",
        "harmless",
        "unharmed",
        "harmfully",
        "harmlessly",
        "harmfulness",
        "harmlessness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                    "sense_definition": "Physical injury or damage caused to a person or object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Luckily, no <w>harm</w> came to the children during the storm.",
                            "target_lang_translations": {
                                "ru": "К счастью, во время шторма детям не было причинено никакого <w>вреда</w>.",
                                "zh": "幸运的是，暴风雨期间孩子们没有受到任何<w>伤害</w>。"
                            }
                        },
                        {
                            "text": "You can do a lot of <w>harm</w> to your body by smoking.",
                            "target_lang_translations": {
                                "ru": "Курением можно нанести огромный <w>вред</w> своему организму.",
                                "zh": "吸烟会给你的身体带来巨大的<w>损害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "damage",
                        "wound",
                        "injury"
                    ],
                    "common_phrases": [
                        "do harm",
                        "cause harm",
                        "physical harm",
                        "serious harm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая травма или ущерб, нанесенный человеку или предмету.",
                        "zh": "对人或物体造成的身体伤害或损坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вред",
                                "target_lang_sense_clarification": "физический или общий ущерб"
                            },
                            {
                                "target_lang_word": "повреждение",
                                "target_lang_sense_clarification": "нарушение целостности, травма"
                            },
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "урон здоровью или имуществу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤害",
                                "target_lang_sense_clarification": "身体上的损伤或痛苦"
                            },
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "对物体或利益造成的破坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                    "sense_definition": "Emotional pain or a negative effect on a situation or abstract concept.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal did serious <w>harm</w> to his professional reputation.",
                            "target_lang_translations": {
                                "ru": "Скандал нанес серьезный <w>ущерб</w> его профессиональной репутации.",
                                "zh": "这起丑闻严重<w>损害</w>了他的职业声誉。"
                            }
                        },
                        {
                            "text": "Sometimes trying to help causes more <w>harm</w> than good.",
                            "target_lang_translations": {
                                "ru": "Иногда попытка помочь приносит больше <w>вреда</w>, чем пользы.",
                                "zh": "有时候试图帮忙反而会<w>弊</w>大于利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "damage",
                        "hurt"
                    ],
                    "common_phrases": [
                        "psychological harm",
                        "more harm than good"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональная боль или негативное воздействие на ситуацию или абстрактное понятие.",
                        "zh": "情感上的痛苦，或对某种情况或抽象概念的负面影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "урон репутации или интересам"
                            },
                            {
                                "target_lang_word": "вред",
                                "target_lang_sense_clarification": "негативное последствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "对声誉或抽象事物的负面影响"
                            },
                            {
                                "target_lang_word": "弊端",
                                "target_lang_sense_clarification": "负面后果或坏处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f72db51-9adc-388b-a487-dcfe42eb7aeb",
                    "sense_definition": "Ill will, bad luck, or negative intention towards someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I promise that I meant no <w>harm</w> by my comment.",
                            "target_lang_translations": {
                                "ru": "Обещаю, что я не хотел причинить <w>зла</w> своим комментарием.",
                                "zh": "我保证我的评论并无<w>恶意</w>。"
                            }
                        },
                        {
                            "text": "He wishes no <w>harm</w> to his former enemies despite their history.",
                            "target_lang_translations": {
                                "ru": "Он не желает <w>зла</w> своим бывшим врагам, несмотря на их прошлое.",
                                "zh": "尽管过去有过节，他并不希望他的前敌人们受到<w>伤害</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mean no harm",
                        "wish someone harm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недоброжелательность, злой умысел или негативные намерения по отношению к кому-либо.",
                        "zh": "对他人的恶意、坏运气或负面意图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зло",
                                "target_lang_sense_clarification": "дурные намерения"
                            },
                            {
                                "target_lang_word": "вред",
                                "target_lang_sense_clarification": "желание сделать плохо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶意",
                                "target_lang_sense_clarification": "怀有坏心思"
                            },
                            {
                                "target_lang_word": "坏心",
                                "target_lang_sense_clarification": "不怀好意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b82f5774-c4e6-368d-a9a8-69a7d12da4c1",
                    "sense_definition": "A specific source or cause of injury, damage, or loss.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We often invite our own <w>harms</w> without realizing the consequences.",
                            "target_lang_translations": {
                                "ru": "Мы часто сами навлекаем на себя <w>беды</w>, не осознавая последствий.",
                                "zh": "我们常常在没意识到后果的情况下自招<w>祸害</w>。"
                            }
                        },
                        {
                            "text": "The storm brought many <w>harms</w> to the small coastal village.",
                            "target_lang_translations": {
                                "ru": "Шторм принес много <w>бед</w> маленькой прибрежной деревне.",
                                "zh": "这场风暴给这个沿海小村庄带来了许多<w>灾难</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный источник или причина травмы, ущерба или потери.",
                        "zh": "造成伤害、损害或损失的具体来源或原因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "несчастье, источник горя"
                            },
                            {
                                "target_lang_word": "напасть",
                                "target_lang_sense_clarification": "неприятность, бедствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祸害",
                                "target_lang_sense_clarification": "造成灾祸的人或事物"
                            },
                            {
                                "target_lang_word": "灾难",
                                "target_lang_sense_clarification": "导致严重损失的事件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05de3270-c097-33e9-972c-27360469aafc",
                    "sense_definition": "To cause physical injury, damage, or pain to someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollution will <w>harm</w> the environment if we do not take action.",
                            "target_lang_translations": {
                                "ru": "Загрязнение <w>навредит</w> окружающей среде, если мы не примем меры.",
                                "zh": "如果我们不采取行动，污染将会<w>损害</w>环境。"
                            }
                        },
                        {
                            "text": "He is a gentle person who would never <w>harm</w> a fly.",
                            "target_lang_translations": {
                                "ru": "Он мягкий человек, который и мухи не <w>обидит</w>.",
                                "zh": "他是个温和的人，连一只苍蝇都不会<w>伤害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "damage",
                        "hurt",
                        "injure",
                        "wound"
                    ],
                    "antonyms": [
                        "heal",
                        "repair"
                    ],
                    "common_phrases": [
                        "harm the environment",
                        "harm someone's reputation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять физическую травму, ущерб или боль кому-либо или чему-либо.",
                        "zh": "对某人或某物造成身体伤害、损害或痛苦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вредить",
                                "target_lang_sense_clarification": "наносить вред (несов. вид)"
                            },
                            {
                                "target_lang_word": "навредить",
                                "target_lang_sense_clarification": "причинить ущерб (сов. вид)"
                            },
                            {
                                "target_lang_word": "повредить",
                                "target_lang_sense_clarification": "испортить или травмировать что-то конкретное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤害",
                                "target_lang_sense_clarification": "造成身体或心理上的损伤"
                            },
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "破坏某物的完整性或价值"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}