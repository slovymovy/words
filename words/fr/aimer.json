{
    "word_family": [
        "aimable",
        "aimablement",
        "amour",
        "amoureux",
        "amoureusement",
        "désaimer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7676bc87-95ef-389a-9356-277bff516b30",
                    "sense_definition": "Éprouver de l'amour ou une profonde affection pour quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>aime</w> sa famille plus que tout au monde."
                        },
                        {
                            "text": "Depuis leur rencontre à l'université, ils s'<w>aiment</w> tendrement."
                        }
                    ],
                    "synonyms": [
                        "adorer",
                        "affectionner",
                        "vénérer"
                    ],
                    "antonyms": [
                        "détester",
                        "haïr"
                    ],
                    "common_phrases": [
                        "aimer à la folie",
                        "aimer de tout son cœur"
                    ]
                },
                {
                    "sense_id": "b04ffedf-7864-3dee-8343-8b80fa84d976",
                    "sense_definition": "Apprécier quelque chose, trouver du plaisir ou du goût à une activité ou un objet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>aime</w> beaucoup lire un bon livre le soir."
                        },
                        {
                            "text": "Nous <w>aimons</w> bien marcher dans la forêt en automne."
                        }
                    ],
                    "synonyms": [
                        "adorer",
                        "apprécier",
                        "kiffer"
                    ],
                    "antonyms": [
                        "détester"
                    ],
                    "common_phrases": [
                        "aimer bien",
                        "aimer mieux"
                    ]
                },
                {
                    "sense_id": "87006644-16a2-3f7e-8a91-669e45f9cdc8",
                    "sense_definition": "Manifester son approbation sur un réseau social en cliquant sur une mention prévue à cet effet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des centaines d'utilisateurs ont <w>aimé</w> cette magnifique photo de vacances."
                        },
                        {
                            "text": "Pense à <w>aimer</w> la vidéo si tu as trouvé ces explications utiles."
                        }
                    ]
                },
                {
                    "sense_id": "c88fc55a-f60e-3b48-ae6f-a354e6dd28d9",
                    "sense_definition": "Prospérer ou se plaire dans un environnement particulier, en parlant d'un végétal ou d'un animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces fleurs délicates <w>aiment</w> les sols humides et les endroits ombragés."
                        },
                        {
                            "text": "Les oliviers <w>aiment</w> particulièrement les coteaux bien ensoleillés."
                        }
                    ]
                },
                {
                    "sense_id": "1489ba0e-e218-33a5-83cd-e27444e7cb37",
                    "sense_definition": "S'unir charnellement avec quelqu'un ; faire l'amour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils s'<w>aimèrent</w> passionnément durant cette longue nuit d'été."
                        },
                        {
                            "text": "Dans le secret de cette chambre, il l'a <w>aimée</w> avec une infinie délicatesse."
                        }
                    ]
                }
            ]
        }
    ]
}