                "senses": [
                    {
                        "sense_id": "9d88b966-8014-3b62-90b8-e1e4e860f67b",
                        "entry_id": "2d8324df-03da-3576-b018-7cc00193016d",
                        "glosses": [
                            "Balkon in einem Theater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83f7168e-5804-4965-882d-8f213d1b837d",
                                "sense_id": "9d88b966-8014-3b62-90b8-e1e4e860f67b",
                                "text": "Kleine Theaterbalkone nennt man auch Logen."
                            },
                            {
                                "example_id": "e805165b-5adc-4036-9530-15059ee3d891",
                                "sense_id": "9d88b966-8014-3b62-90b8-e1e4e860f67b",
                                "text": "„Augenzeugenberichten zufolge stürzten vermutlich Teile des Daches ein. Andere Zeugen hatten von einem eingestürzten Theaterbalkon berichtet.“"
                            },
                            {
                                "example_id": "b4efb5ed-736b-4a41-b917-23a392f0ec0e",
                                "sense_id": "9d88b966-8014-3b62-90b8-e1e4e860f67b",
                                "text": "„Nach Berichten von Augenzeugen soll es sich um einen Teil des Daches gehandelt haben. Andere Zeugen hatten von einem eingestürzten Theaterbalkon und von einer dichten Staubwolke berichtet.“"
                            },
                            {
                                "example_id": "07ad1c9b-d135-42b1-ba4a-dd9e37f40e3e",
                                "sense_id": "9d88b966-8014-3b62-90b8-e1e4e860f67b",
                                "text": "„Durch den roten Vorhang schiebt sich eine bemalte Kulisse in den Bühnenhimmel. Darauf ist der Flügel eines Theaterbalkons gemalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
