                    {
                        "translation_id": "051a72c8-ba1a-4aae-8469-86a7c5b2a352",
                        "source_entry_id": "4a569cbf-65d6-3e4f-8ae9-dbbd59f9356c",
                        "source_sense_description": "Qui suscite de l’empathie",
                        "target_lang_word": "nachvollziehbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
