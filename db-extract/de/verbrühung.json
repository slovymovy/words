                    {
                        "sense_id": "8e874028-5693-35f6-ab8f-a5333709da55",
                        "entry_id": "a5914608-2cff-3f83-a6f7-fb68f33f955a",
                        "glosses": [
                            "durch Kontakt mit einer heißen Flüssigkeit oder heißem Dampf entstandene Verletzung"
