                ],
                "senses": [
                    {
                        "sense_id": "bb25fe6d-92dd-3271-abc6-014336804c02",
                        "entry_id": "f03cb706-f7bf-3fdb-bc56-551c9474ef55",
                        "glosses": [
                            "Manger en faisant un bruit de slurp, d’aspiration bruyante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90920e6-7302-4215-a9b5-ea428f3011ef",
                                "sense_id": "bb25fe6d-92dd-3271-abc6-014336804c02",
                                "text": "Les nouilles, taillées d’un bon diamètre pour rester al dente après quarante secondes dans l’eau bouillante, permettent d’être aspirées – ou slurpées – comme il faut."
                            },
                            {
                                "example_id": "3768157c-5371-4368-8e35-863437db5cb6",
                                "sense_id": "bb25fe6d-92dd-3271-abc6-014336804c02",
                                "text": "Les Japonais ont tendance à « slurper » (aspirer bruyamment) les nouilles."
                            },
                            {
                                "example_id": "8ff1bd0a-dd3f-49a0-a6c4-d9d9065540a3",
                                "sense_id": "bb25fe6d-92dd-3271-abc6-014336804c02",
                                "text": "Face aux vitres embuées, deux touristes chinoises “slurpent” sans fin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0736982a-56d1-412f-90c8-f7cc6b04dd3f",
                        "source_entry_id": "f03cb706-f7bf-3fdb-bc56-551c9474ef55",
                        "source_sense_id": "bb25fe6d-92dd-3271-abc6-014336804c02",
                        "target_lang_word": "сёрбать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сёрбать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b5971777-dbe3-3106-97e1-017479c80093",
                                        "entry_id": "f5790e35-ee3b-3621-957c-3cee7a545948",
                                        "glosses": [
                                            "рег., прост. шумно прихлёбывая, пить что-либо или есть жидкую пищу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e06f8235-2a9e-482a-b581-cbf4c1aa17c2",
                                                "sense_id": "b5971777-dbe3-3106-97e1-017479c80093",
                                                "text": "Не думая, купец взял большой котел с вкусно пахнущей ухой и, прижав к себе закопчённым боком, стал быстро сёрбать густое варево."
                                            },
                                            {
                                                "example_id": "970a2b5a-0fa6-446d-a5e4-1da9d29af4e5",
                                                "sense_id": "b5971777-dbe3-3106-97e1-017479c80093",
                                                "text": "Мал мала ребятишки, Дуняшкины братик и сестрички, в чистых расшитых рубашонках, причёсанные, сидели за столом чинно, откусывали степенно, ибо матушка их строго наказывала: не хватать, не сёрбать громко, не пить крепких наливок, а токмо квасок холодный, и все вокруг умилялись — ну што за детки такие, ай да детки!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
