                    },
                    {
                        "translation_id": "b644fa9d-3728-408a-9d8c-20dccfcb578f",
                        "source_entry_id": "b284e2f9-bfec-3b26-a734-84a4a7755695",
                        "source_sense_description": "under the influence of beer",
                        "target_lang_word": "nachmelený",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachmelený",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "449b56bd-633b-3ad9-92dc-0b48b19b4090",
                                        "entry_id": "7dd8f288-731d-3186-809b-d8610064532f",
                                        "glosses": [
                                            "(o člověku) znatelně pod vlivem alkoholu, zejména po požití většího množství piva"
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dfe34e3-f195-4c34-bb6e-67892c77fed2",
                                                "sense_id": "449b56bd-633b-3ad9-92dc-0b48b19b4090",
                                                "text": "V tom mezidobí nikoho je ale třeba působit dojmem, že máte všechno pod kontrolou. Jinak to skončí jako na lodi s nachmeleným kapitánem: námořníků se nutně začne zmocňovat neklid"
                                            },
                                            {
                                                "example_id": "323b4dea-bbe0-4c96-bdcf-3f27ab857de9",
                                                "sense_id": "449b56bd-633b-3ad9-92dc-0b48b19b4090",
                                                "text": "Strýček už byl trochu nachmelený."
                                            },
                                            {
                                                "example_id": "08eecdba-8746-4da2-8a46-df07d1b0134a",
                                                "sense_id": "449b56bd-633b-3ad9-92dc-0b48b19b4090",
                                                "text": "který si nastřádal svou hromádku a teď ji utrácel.\" \"Likvidoval ji.\" \"Měl jen jedno dítě, právě Marii, a ta byla tak vzorná, že ho nemohla vidět nachmeleného. Když přicházel noc co noc domů podroušený, zavírala se do ložnice a slyšela ho, jak se potácí po domě a volají a občas rozbíjí porcelán."
                                            },
                                            {
                                                "example_id": "9463ab29-7941-4ef1-86c5-2b3c20d07eb8",
                                                "sense_id": "449b56bd-633b-3ad9-92dc-0b48b19b4090",
                                                "text": "tak teďka to všechno zase vracel zpátky do toulce a trvalo mu hodně dlouho, než začal s opatrným udělováním instrukcí, kam že si kdo má stoupnout, sednout a lehnout, a k Vencovi Popelkovi přivedla nějaká asistentka jednu mírně nachmelenou holku, která se všemu smála, a ta asistentka, že prej jestli by neměli nic proti tomu sehrát, když už to má bejt jako o hipís a jako snad v létě lásky, prostě jen předvádět"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
