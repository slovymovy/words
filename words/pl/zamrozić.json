    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6bdbc2d-bdb7-33b6-884c-6e25b8dd0ad6",
                    "sense_definition": "obniżyć temperaturę czegoś poniżej zera, doprowadzając do zamarznięcia lub silnego schłodzenia",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <w>zamrozić</w> świeże truskawki, aby zachować je na zimę.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>заморозить</w> свежую клубнику, чтобы сохранить её на зиму."
                            }
                        },
                        {
                            "text": "Mama <w>zamroziła</w> resztę obiadu w plastikowym pojemniku.",
                            "target_lang_translations": {
                                "ru": "Мама <w>заморозила</w> остатки обеда в пластиковом контейнере."
                            }
                        }
                    ],
                    "synonyms": [
                        "schłodzić"
                    ],
                    "antonyms": [
                        "rozmrozić"
                    ],
                    "common_phrases": [
                        "zamrozić owoce",
                        "zamrozić mięso"
                    ],
                    "target_lang_definitions": {
                        "ru": "понизить температуру чего-либо ниже нуля, вызвав замерзание или сильное охлаждение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заморозить",
                                "target_lang_sense_clarification": "продукты, еду, предметы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1dee8ae-801c-35e9-bd6f-cf82de6ebbad",
                    "sense_definition": "wstrzymać wypłatę, obrót środkami finansowymi lub realizację jakichś planów i projektów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blokada",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąd postanowił natychmiast <w>zamrozić</w> konta bankowe podejrzanego biznesmena.",
                            "target_lang_translations": {
                                "ru": "Суд постановил немедленно <w>заморозить</w> банковские счета подозреваемого бизнесмена."
                            }
                        },
                        {
                            "text": "Z powodu nagłego kryzysu firma musiała <w>zamrozić</w> wszystkie nowe inwestycje.",
                            "target_lang_translations": {
                                "ru": "Из-за внезапного кризиса компании пришлось <w>заморозить</w> все новые инвестиции."
                            }
                        }
                    ],
                    "synonyms": [
                        "unieruchomić"
                    ],
                    "antonyms": [
                        "odmrozić"
                    ],
                    "common_phrases": [
                        "zamrozić konta bankowe",
                        "zamrozić ceny",
                        "zamrozić płace"
                    ],
                    "target_lang_definitions": {
                        "ru": "приостановить выплату, оборот финансовых средств или реализацию каких-либо планов и проектов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заморозить",
                                "target_lang_sense_clarification": "счета, цены, проекты, инвестиции"
                            },
                            {
                                "target_lang_word": "приостановить",
                                "target_lang_sense_clarification": "работу над проектом, финансирование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da38ea8d-8ee2-36bd-86bd-999b9133b4e0",
                    "sense_definition": "ulec zamarznięciu pod wpływem bardzo niskiej temperatury (używane z zaimkiem „się”)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Woda w rurach może się <w>zamrozić</w> podczas silnych, zimowych mrozów.",
                            "target_lang_translations": {
                                "ru": "Вода в трубах может <w>замёрзнуть</w> во время сильных зимних морозов."
                            }
                        },
                        {
                            "text": "Nie zostawiaj szklanej butelki na balkonie, bo płyn gotów się <w>zamrozić</w> i rozsadzić szkło.",
                            "target_lang_translations": {
                                "ru": "Не оставляй стеклянную бутылку на балконе, ведь жидкость может <w>замёрзнуть</w> и она лопнет."
                            }
                        }
                    ],
                    "synonyms": [
                        "zamarznąć"
                    ],
                    "target_lang_definitions": {
                        "ru": "замерзнуть под воздействием очень низкой температуры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замёрзнуть",
                                "target_lang_sense_clarification": "о жидкости, воде"
                            },
                            {
                                "target_lang_word": "перемёрзнуть",
                                "target_lang_sense_clarification": "о трубах, воде в трубах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
