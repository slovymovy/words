                "senses": [
                    {
                        "sense_id": "d7fea05a-128f-3e8f-8a0e-fe13493665bc",
                        "entry_id": "a7dc5562-9716-396b-8204-baeda2e60499",
                        "glosses": [
                            "vorsätzliche Tötung einer Person, die von jemandem angewiesen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b718f0ef-cb39-47ca-8950-3930a6fe6a41",
                                "sense_id": "d7fea05a-128f-3e8f-8a0e-fe13493665bc",
                                "text": "„Der illegale Schwarzmarkt [Silk Road], den Nutzer über den Anonymisierungsdienst Tor erreichten und auf dem Drogen, Waffen und angeblich sogar Dienstleistungen wie Auftragsmorde angeboten wurden, war lange Zeit der bekannteste Umschlagplatz für die Währung Bitcoin.“"
                            },
                            {
                                "example_id": "a43f1bb9-7fda-4d1b-9ce4-f1f98aa047b2",
                                "sense_id": "d7fea05a-128f-3e8f-8a0e-fe13493665bc",
                                "text": "„Auftragsmorde, terroristische Aktionen und gewaltsame Zusammenstöße zwischen den verschiedenen Gruppen prägen den Alltag der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
