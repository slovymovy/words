                "senses": [
                    {
                        "sense_id": "755ce2ca-0512-3365-831c-4b091ac600fc",
                        "entry_id": "d7cc1cf7-0ea4-3a7a-9ced-9de6205e2c93",
                        "glosses": [
                            "thoughtfulness, consideration"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ece6f420-a72e-4c53-8e9d-3815720556d9",
                                "sense_id": "755ce2ca-0512-3365-831c-4b091ac600fc",
                                "text": "Julien ne répondit pas un seul mot aux prévenances, dont pendant tout le reste de la promenade il fut l’objet.",
                                "translation": "Julien did not respond with even a single word to the consideration of which he was the object during the entire remainder of the walk.",
                                "english": "Julien did not respond with even a single word to the consideration of which he was the object during the entire remainder of the walk."
                            },
                            {
                                "example_id": "9afc69a5-1c59-4405-9b6d-8ec0817bb811",
                                "sense_id": "755ce2ca-0512-3365-831c-4b091ac600fc",
                                "text": "Et tous, me voyant en bons termes avec le maître tout-puissant, sont pour moi pleins d’amabilité et de prévenances.",
                                "translation": "And seeing that I was in good terms with the almighty master, everyone was full of friendliness and consideration for me.",
                                "english": "And seeing that I was in good terms with the almighty master, everyone was full of friendliness and consideration for me."
                            },
                            {
                                "example_id": "4fb01e43-c69d-4b07-b65c-cd45bb50504f",
                                "sense_id": "755ce2ca-0512-3365-831c-4b091ac600fc",
                                "text": "Elle se plaint de nos prévenances. Il paraît que, chaque fois qu’elle commence à dormir, l’une de nous entre pour lui demander si elle a besoin de quelque chose[…]",
                                "translation": "She's complaining about our consideration. It appears that every time she starts falling asleep, one of us goes in to ask her if she needs something […]",
                                "english": "She's complaining about our consideration. It appears that every time she starts falling asleep, one of us goes in to ask her if she needs something […]"
                            }
                        ]
                    }
                ],
