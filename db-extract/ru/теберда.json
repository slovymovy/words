                            {
                                "example_id": "674d7eb3-e21a-4fc3-a6d3-1d4f0393709e",
                                "sense_id": "0c622e05-e59e-3a1f-820e-af7e597294f3",
                                "text": "Из Микоян-Шахара дорога покидает Кубань и входит в долину Теберды."
                            }
                        ]
                    },
                    {
                        "sense_id": "98a9e474-261a-34f4-9a08-3dd9ab47b5ed",
                        "entry_id": "495e5fce-0fac-39f7-8f5e-4d7d57cd9ba3",
                        "glosses": [
                            "город в Российской Федерации, Карачаево-Черкесия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e6d544-c325-4193-a38b-03e65780758d",
                                "sense_id": "98a9e474-261a-34f4-9a08-3dd9ab47b5ed",
                                "text": "Врачебная комиссия предложила мне три места на выбор: Абастуман, Крым или Теберда (Карачаево-Черкесская область)."
