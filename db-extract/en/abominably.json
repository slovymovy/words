                                                "sense_id": "8ace9665-5291-3032-aaff-fdbde2732adb",
                                                "text": "Einen schrecklichen Anblick bot die lynchende Menge."
                                            },
                                            {
                                                "example_id": "adde5ed8-7f69-456e-921f-086697858b65",
                                                "sense_id": "8ace9665-5291-3032-aaff-fdbde2732adb",
                                                "text": "Sie kamen auf schreckliche Weise ums Leben."
                                            },
                                            {
                                                "example_id": "0d9fd6a2-a11a-4720-aab2-660f9c0220d9",
