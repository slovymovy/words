                    {
                        "sense_id": "4ccbca6c-8419-3bda-9d12-747f2bd5442b",
                        "entry_id": "ae9dad2a-9537-38f0-8b55-d525f55b0302",
                        "glosses": [
                            "Beförderung der Post durch Kuriere zwecks Geheimhaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929b591e-2dbd-4302-a92d-d7f5baec548f",
                                "sense_id": "4ccbca6c-8419-3bda-9d12-747f2bd5442b",
                                "text": "„»Klassische« Kurierpost gibt es heute noch unter anderem als Diplomatenpost.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c1cc4af4-b5bb-3afe-85bd-a210eaa8c4ab",
                        "entry_id": "ae9dad2a-9537-38f0-8b55-d525f55b0302",
                        "glosses": [
                            "das durch Kuriere beförderte Postgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a1d586-45c5-4200-870f-215ee116f030",
                                "sense_id": "c1cc4af4-b5bb-3afe-85bd-a210eaa8c4ab",
                                "text": "„Die Sendungen trugen neben dem Dienststempel der absendenden Behörde handschriftliche Vermerke, später auch Gummistempel, die sie als Kurierpost kenntlich machte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fd6dac30-6d30-3320-9cdb-a7ec0b715a6b",
                        "entry_id": "ae9dad2a-9537-38f0-8b55-d525f55b0302",
                        "glosses": [
                            "beschleunigte Beförderung der Post mittels Kurieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd160103-033c-49a9-844c-f843c85b2ac3",
                                "sense_id": "fd6dac30-6d30-3320-9cdb-a7ec0b715a6b",
                                "text": "„Im modernen Verständnis wird dagegen von Kurierpost gesprochen, wenn damit der Schnelltransport von Schrift- und Kleingut gegen Gebühr gemeint ist - entweder global, national oder auch innerstädtisch.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
