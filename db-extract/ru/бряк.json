                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2027123-c5a4-4e89-a6ff-88b228607a96",
                                "sense_id": "c2c0f5b8-92ac-3613-920f-5a880b3be098",
                                "text": "Под топотом, под бряком оружия и под стрельбой резко послышались голоса французских офицеров…"
                            },
                            {
                                "example_id": "2a50938c-6e03-47b6-a22d-02821806abea",
                                "sense_id": "c2c0f5b8-92ac-3613-920f-5a880b3be098",
                                "text": "Стас принялся расчищать неприбранный стол, с бряком сваливая посуду в мойку."
                            }
                        ]
                    }
