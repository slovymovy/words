                        "glosses": [
                            "Synonym of leonine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99ef40ec-8eba-49fc-b724-14a909218ebc",
                                "sense_id": "4658570d-68e8-3a23-924d-85b8c7dd6a7e",
                                "text": "The Psalms provided the Gnostics with the source of this portrait of the creator as lionesque, enabling them to identify him as an erotic, lion-headed leader of the animal-like archons."
                            },
                            {
                                "example_id": "53843b35-07c8-4370-a5fa-6948f06f4190",
                                "sense_id": "4658570d-68e8-3a23-924d-85b8c7dd6a7e",
                                "text": "Preston was a lionesque, tall, massive man, with a generous sized moustache, and beautiful green eyes."
                            },
                            {
                                "example_id": "b05122eb-7dfe-43f4-8223-3dd97361cee7",
                                "sense_id": "4658570d-68e8-3a23-924d-85b8c7dd6a7e",
                                "text": "With her copper skin and her golden hair, B.B. thought she looked positively lionesque."
                            },
                            {
                                "example_id": "8da032ad-26dd-473f-afed-513b0e663432",
                                "sense_id": "4658570d-68e8-3a23-924d-85b8c7dd6a7e",
                                "text": "On his bas-reliefs and plaques, allegorical, stylized, and muscular heroes break their chains and brandish large swords. LaSalle holds his two hands on a hugesword planted in front of him and looks like a medieval chevalier, fierce and lionesque."
                            }
                        ]
                    }
