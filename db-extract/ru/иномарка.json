                                "target_senses": [
                                    {
                                        "sense_id": "5ca7f53d-f3ce-3074-90b5-25a2aed1f515",
                                        "entry_id": "b9df3dca-1c81-36e6-98be-aeab7f7b3af4",
                                        "glosses": [
                                            "A type of motor vehicle designed to move on the ground under its own stored power and intended to carry a driver, a small number of additional passengers, and a very limited amount of other load."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac0d37c5-3304-4d55-8f04-7ef8a01a53a1",
                                                "sense_id": "5ca7f53d-f3ce-3074-90b5-25a2aed1f515",
                                                "text": "Meronym: see list of auto parts"
                                            },
                                            {
                                                "example_id": "c77b6a33-42da-4ce0-bc91-e1bebe4fe224",
                                                "sense_id": "5ca7f53d-f3ce-3074-90b5-25a2aed1f515",
                                                "text": "Surprisingly, this analysis revealed that acute exposure to solvent vapors at concentrations below those associated with long-term effects appears to increase the risk of a fatal automobile accident."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "automobile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22cbcc5a-664f-3551-8a71-abf23b6c81cd",
                                        "entry_id": "6159681a-1419-39a9-9e08-48b459c31b9b",
                                        "glosses": [
                                            "To travel by automobile."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "489dc293-193b-47fd-94b3-b8d7334a1f73",
                                                "sense_id": "22cbcc5a-664f-3551-8a71-abf23b6c81cd",
                                                "text": "The misguided youngsters are yachting, attending the races, playing the \"stage Johnny,\" automobiling, playing poker for high stakes, overliving at home, on expensive shopping tours, attending box parties to the theatre, visiting high-priced restaurants, etc., etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "automobile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8398d40b-49cf-34c0-94c6-e8cbf16b5daf",
                                        "entry_id": "2e1e33aa-8b5f-3be9-a653-832a48fe6ebe",
                                        "glosses": [
                                            "Self-moving; self-propelled."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ad100b-780e-4384-af50-d4c8571eb7c4",
                                                "sense_id": "8398d40b-49cf-34c0-94c6-e8cbf16b5daf",
                                                "text": "As early as 1898 I proposed to representatives of a large manufacturing concern the construction and public exhibition of an automobile carriage which, left to itself, would perform a great variety of operations involving something akin to judgment."
                                            }
                                        ]
                                    }
