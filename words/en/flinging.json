    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14a00780-e88c-3c94-bf5a-355712da6264",
                    "sense_definition": "present participle and gerund of <w>fling</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>flinging</w> her clothes into the suitcase in a desperate hurry.",
                            "target_lang_translations": {
                                "de": "In verzweifelter Eile <w>warf</w> sie ihre Kleider in den Koffer."
                            }
                        },
                        {
                            "text": "Stop <w>flinging</w> mud at each other and try to talk calmly.",
                            "target_lang_translations": {
                                "de": "Hört auf, euch gegenseitig mit Schlamm zu <w>bewerfen</w>, und versucht, ruhig miteinander zu reden."
                            }
                        }
                    ],
                    "synonyms": [
                        "throwing",
                        "tossing",
                        "hurling"
                    ],
                    "common_phrases": [
                        "flinging mud",
                        "flinging arms around"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von 'fling' (schleudern, werfen)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schleudernd",
                                "target_lang_sense_clarification": "mit Kraft werfend"
                            },
                            {
                                "target_lang_word": "werfend",
                                "target_lang_sense_clarification": "etwas heftig oder unachtsam werfend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e39b388-7b6f-366c-a319-98354193a6e4",
                    "sense_definition": "The act by which something is flung.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>flinging</w> of the door startled everyone in the quiet room.",
                            "target_lang_translations": {
                                "de": "Das plötzliche <w>Aufwerfen</w> der Tür erschreckte alle im ruhigen Raum."
                            }
                        },
                        {
                            "text": "We watched the dramatic <w>flinging</w> of autumn leaves by the strong wind.",
                            "target_lang_translations": {
                                "de": "Wir beobachteten das dramatische <w>Wirbeln</w> der Herbstblätter durch den starken Wind."
                            }
                        }
                    ],
                    "synonyms": [
                        "throwing",
                        "tossing",
                        "cast"
                    ],
                    "common_phrases": [
                        "sudden flinging"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Akt des Schleuderns oder heftigen Werfens"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schleudern",
                                "target_lang_sense_clarification": "das heftige Werfen"
                            },
                            {
                                "target_lang_word": "Werfen",
                                "target_lang_sense_clarification": "das unachtsame oder schwungvolle Werfen"
                            },
                            {
                                "target_lang_word": "Aufwerfen",
                                "target_lang_sense_clarification": "z.B. einer Tür"
                            }
                        ]
                    }
                }
            ]
        }
    ]
