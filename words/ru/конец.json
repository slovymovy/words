    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a9ede95-1d84-31e0-be36-224c7d7a99a3",
                    "sense_definition": "Последний момент чего-либо, протекающего во времени; завершение действия, события или периода.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temporal_end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы досмотрели этот интересный фильм до самого <w>конца</w>.",
                            "target_lang_translations": {
                                "en": "We watched this interesting movie to the very <w>end</w>.",
                                "zh": "我们把这部有趣的电影看完了，一直看到<w>末尾</w>。"
                            }
                        },
                        {
                            "text": "В <w>конце</w> концов они решили остаться дома.",
                            "target_lang_translations": {
                                "en": "In the <w>end</w> they decided to stay home.",
                                "zh": "他们<w>最终</w>决定待在家里。"
                            }
                        }
                    ],
                    "antonyms": [
                        "начало"
                    ],
                    "common_phrases": [
                        "в конце концов",
                        "под конец",
                        "до конца",
                        "без конца"
                    ],
                    "target_lang_definitions": {
                        "en": "The last moment of something occurring in time; the completion of an action, event, or period.",
                        "zh": "指时间上某事的最后时刻；动作、事件或时期的结束。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "conclusion of a period or event"
                            },
                            {
                                "target_lang_word": "ending",
                                "target_lang_sense_clarification": "last part of a story or event"
                            },
                            {
                                "target_lang_word": "close",
                                "target_lang_sense_clarification": "conclusion"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "指事件或过程的终结"
                            },
                            {
                                "target_lang_word": "末尾",
                                "target_lang_sense_clarification": "指时间或序列的最后部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79b470ac-abf5-3380-9178-cd1495fe4a33",
                    "sense_definition": "Предел, граница, крайняя часть какого-либо предмета или пространства.",
