                                "target_senses": [
                                    {
                                        "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                        "entry_id": "4975487c-8fdb-39fc-a7ae-31aa8c89778b",
                                        "glosses": [
                                            "mit ziemlicher Sicherheit; oftmals eine gewisse Beeinschränkung beinhaltend, die zum Beispiel mit aber angeschlossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efcc9f1b-6ab4-4f17-9d7d-8a8f2666e8a4",
                                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                                "text": "Sie hat sich sicherlich Mühe gegeben, aber Mühe alleine reicht eben nicht immer."
                                            },
                                            {
                                                "example_id": "9aa492dd-7788-4948-a9d6-9593849347cd",
                                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                                "text": "Der Artikel ist gut, aber sicherlich ausbaufähig."
                                            },
                                            {
                                                "example_id": "aa2d1e30-b32b-478a-95e4-35dbf3762217",
                                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                                "text": "Seine Schilderung der Ereignisse entspricht sicherlich der Wahrheit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
