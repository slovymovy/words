                {
                    "sense_id": "71229e63-f817-3d58-9abb-70c6659084d7",
                    "sense_definition": "met veel lichaamsvet of een dikke omvang",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer heeft een <w>vet</w> varken dat klaar is voor de markt.",
                            "target_lang_translations": {
