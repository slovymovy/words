                "senses": [
                    {
                        "sense_id": "9f991a64-5920-36ab-b291-d94510b1c078",
                        "entry_id": "bca0dde3-4555-34fe-bd62-f1e8fa7faa5c",
                        "glosses": [
                            "Téléphoner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae46815-f881-4742-99a5-7c6a0bfdad38",
                                "sense_id": "9f991a64-5920-36ab-b291-d94510b1c078",
                                "text": "Je ne re-téléphonai pas au père."
                            },
                            {
                                "example_id": "b14c2230-dd8c-4577-bac1-4147050045eb",
                                "sense_id": "9f991a64-5920-36ab-b291-d94510b1c078",
                                "text": "J’ai décidé de re-téléphoner à Bertrand que j’avais eu à mon arrivée à Roissy ce matin même."
                            },
                            {
                                "example_id": "b6b6d7c6-ddb4-4758-874a-124e63b121ca",
                                "sense_id": "9f991a64-5920-36ab-b291-d94510b1c078",
                                "text": "Mais c’est quoi, re-téléphoner dans presque un mois ? Et quoi encore !"
                            }
                        ]
                    }
