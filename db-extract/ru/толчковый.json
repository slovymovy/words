                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70b3b65-56e7-3da2-bef0-60fd417103ae",
                                        "entry_id": "1bf7caeb-f519-3135-b9a6-cfa4b3cd5a49",
                                        "glosses": [
                                            "The striking of one body against another; collision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cd81a1b-16ff-3994-9e4b-3d1a3a73d062",
                                        "entry_id": "1bf7caeb-f519-3135-b9a6-cfa4b3cd5a49",
                                        "glosses": [
                                            "The force or energy of a collision of two objects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00d1a624-e962-4be4-b950-548831a84176",
                                                "sense_id": "6cd81a1b-16ff-3994-9e4b-3d1a3a73d062",
                                                "text": "The hatchet cut the wood on impact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fad3d06-9114-3de6-b8db-861d1f8df844",
                                        "entry_id": "1bf7caeb-f519-3135-b9a6-cfa4b3cd5a49",
                                        "glosses": [
                                            "A forced impinging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90abc2e1-9d2c-4aa2-a401-c97e4ada1c51",
                                                "sense_id": "9fad3d06-9114-3de6-b8db-861d1f8df844",
                                                "text": "His spine had an impingement; L4 and L5 made impact, which caused numbness in his leg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9559e9d-1ced-30ec-b431-3b9c5d19c6db",
                                        "entry_id": "1bf7caeb-f519-3135-b9a6-cfa4b3cd5a49",
                                        "glosses": [
                                            "A significant or strong influence or effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "400303ab-eee4-46eb-9b1e-19755c9a6441",
                                                "sense_id": "b9559e9d-1ced-30ec-b431-3b9c5d19c6db",
                                                "text": "His friend's opinion had an impact on his decision."
                                            },
                                            {
                                                "example_id": "5195127a-2223-49e6-8436-a1d77c3be7e1",
                                                "sense_id": "b9559e9d-1ced-30ec-b431-3b9c5d19c6db",
                                                "text": "Our choice of concrete will have a tremendous impact on the building's mechanical performance."
                                            },
                                            {
                                                "example_id": "c12f1282-0c87-463e-921e-59f072a0d385",
                                                "sense_id": "b9559e9d-1ced-30ec-b431-3b9c5d19c6db",
                                                "text": "December 7, 1941, November 22, 1963, and September 11, 2001 had an impact on many throughout the world."
                                            },
                                            {
                                                "example_id": "138d807c-c77d-4562-8849-164352715bfa",
                                                "sense_id": "b9559e9d-1ced-30ec-b431-3b9c5d19c6db",
                                                "text": "The French revolution, the Russian revolution, and the Iranian revolution had an impact on many throughout the world."
                                            },
                                            {
                                                "example_id": "6fd13569-a2b4-4dd6-b279-68e852266b8c",
                                                "sense_id": "b9559e9d-1ced-30ec-b431-3b9c5d19c6db",
                                                "text": "One way to reduce the environmental impact of meat eating is to make livestock more productive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfa7afba-7b40-32c3-8748-ac6c97b70b12",
                                        "entry_id": "52b2fde0-10b0-388a-a479-75e36a8a83bf",
                                        "glosses": [
                                            "To collide or strike, the act of impinging."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141b9e18-d0b3-4126-8209-c05b9869d8d3",
                                                "sense_id": "cfa7afba-7b40-32c3-8748-ac6c97b70b12",
                                                "text": "When the hammer impacts the nail, it bends."
                                            },
                                            {
                                                "example_id": "6a29b06a-372b-4109-9721-84db9df50b49",
                                                "sense_id": "cfa7afba-7b40-32c3-8748-ac6c97b70b12",
                                                "text": "As a microbullet impacts the graphene, the diameter of the cone it creates – determined by later examination of the petals – provides a way to measure how much energy the graphene absorbs before breaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78865f29-4025-3ec8-8a7c-4566044b69b2",
                                        "entry_id": "52b2fde0-10b0-388a-a479-75e36a8a83bf",
                                        "glosses": [
                                            "To compress; to compact; to press into something or pack together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08907597-8fdd-4c49-bf6e-b3eb53ed293b",
                                                "sense_id": "78865f29-4025-3ec8-8a7c-4566044b69b2",
                                                "text": "The footprints of birds do not impact the soil in the way those of dinosaurs do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ffd15e4-c18e-3976-b28c-dac0c18614ba",
                                        "entry_id": "52b2fde0-10b0-388a-a479-75e36a8a83bf",
                                        "glosses": [
                                            "To significantly or strongly influence or affect; to have an impact on."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "proscribed",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4271cb6-c5c1-43a7-9498-bcb031611c8d",
                                                "sense_id": "3ffd15e4-c18e-3976-b28c-dac0c18614ba",
                                                "text": "I can make the changes, but it will impact the schedule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8124d7-f0c9-3c9d-8cec-73f65c8f99f4",
                                        "entry_id": "52b2fde0-10b0-388a-a479-75e36a8a83bf",
                                        "glosses": [
                                            "To stamp or impress onto something."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9420a89-1f81-4b68-9b77-29bfa516eb19",
                                                "sense_id": "5f8124d7-f0c9-3c9d-8cec-73f65c8f99f4",
                                                "text": "Ideas impacted on the mind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
