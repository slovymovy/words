                "senses": [
                    {
                        "sense_id": "92f4b7c5-34f0-3d2b-872e-009bd5756e68",
                        "entry_id": "5c90c821-d726-33fb-a1ad-74f9ca226283",
                        "glosses": [
                            "ботан. то же, что лавсония неколючая; кустарниковое растение семейства дербенниковых, из листьев которого получают жёлто-красную краску"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bc16c1a6-8acd-312e-aeeb-370b0f7509cc",
                        "entry_id": "5c90c821-d726-33fb-a1ad-74f9ca226283",
                        "glosses": [
                            "краска из высушенных листьев такого растения, традиционно используемая для украшения тела, окраски волос и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd253baf-5ca3-4c40-a0b3-6a1626708cf4",
                                "sense_id": "bc16c1a6-8acd-312e-aeeb-370b0f7509cc",
                                "text": "Хна и басма — наиболее популярные натуральные красители."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcbed75d-bb69-4c69-a9af-97d7229aaa7d",
                        "source_entry_id": "5c90c821-d726-33fb-a1ad-74f9ca226283",
                        "target_lang_word": "henna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "henna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4787f37f-da01-33af-a095-437505030e55",
                                        "entry_id": "ffa43792-f9bf-360f-8150-66eae0d441fe",
                                        "glosses": [
                                            "A shrub, Lawsonia inermis, having fragrant reddish flowers."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51f5f0cc-edff-3dd3-a0fc-2fc60578ec8d",
                                        "entry_id": "ffa43792-f9bf-360f-8150-66eae0d441fe",
                                        "glosses": [
                                            "A flower of this plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76cbaa12-3f11-48a7-b3c5-1b45e07133a8",
                                                "sense_id": "51f5f0cc-edff-3dd3-a0fc-2fc60578ec8d",
                                                "text": "The aroma given off by flowers has an aphrodisiac effect, especially on women. This is so particularly in the case of lilies of the valley, gardenia, frangipani, and henna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47a891e9-c725-3b29-ab84-d98f472e9137",
                                        "entry_id": "ffa43792-f9bf-360f-8150-66eae0d441fe",
                                        "glosses": [
                                            "A reddish plant substance, prepared from the dried leaves of this plant, used for temporary tattoos and hair coloring. Hair colorings range from bright red to earth brown to near black."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cfe7a25-ff73-40e3-b08d-f9a753e7bf3b",
                                                "sense_id": "47a891e9-c725-3b29-ab84-d98f472e9137",
                                                "text": "Among Arabs, it is believed that henna rubbed on the fingers, skull, and feet produces an aphrodisiac effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2f2e7b1-07f9-3ab8-93ac-1851e2990c0e",
                                        "entry_id": "ffa43792-f9bf-360f-8150-66eae0d441fe",
                                        "glosses": [
                                            "A rich reddish-brown colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
