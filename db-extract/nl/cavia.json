                        "sense_id": "397fe385-fae1-328a-82ef-7022c715f39e",
                        "entry_id": "e4f4519d-669b-3fcb-9769-1eac70712a20",
                        "glosses": [
                            "benaming voor knaagdieren uit het geslacht Cavia, van oorsprong afkomstig uit Zuid-Amerika, die vooral als huisdier gehouden worden"
                        ],
                        "tags": [
                            "knaagdieren"
                        ],
                        "examples": [
                            {
                                "example_id": "f0fc9218-60ad-43ad-8b62-a1dc0bbd3a36",
                                "sense_id": "397fe385-fae1-328a-82ef-7022c715f39e",
                                "text": "Wij hebben een cavia thuis."
                            },
                            {
                                "example_id": "02689b9f-d5f9-438c-af62-9273401e1aa9",
                                "sense_id": "397fe385-fae1-328a-82ef-7022c715f39e",
                                "text": "Dat de cavia een huisdier is danken we aan de Inca’s. Die domesticeerden het beestje zo’n 3.000 jaar geleden in Peru. Sindsdien is de cavia - cuy in het Spaans - een belangrijke voedselbron voor Peruanen."
                            },
                            {
                                "example_id": "95c33f6c-ab98-4dba-b326-a9e8a24f81ff",
                                "sense_id": "397fe385-fae1-328a-82ef-7022c715f39e",
                                "text": "Een aardige vrouw met de herseninhoud van een cavia."
                            }
                        ]
                    }
                ],
