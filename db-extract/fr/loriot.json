            {
                "entry_id": "9c01a333-a1a0-3931-b9f4-d2d992d8b135",
                "word": "loriot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b1579daf-21da-4425-a95f-5b75ee46f4ca",
                        "entry_id": "9c01a333-a1a0-3931-b9f4-d2d992d8b135",
                        "tags": [
