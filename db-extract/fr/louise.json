                            "plural"
                        ],
                        "form": "louises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4b81c0c-d201-3e0f-8c4b-79e418cd0c9f",
                        "entry_id": "f461466b-4ef0-3273-bc26-b87c9dce99cb",
                        "glosses": [
                            "fart"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "4d1abf27-7b9e-454d-8c26-3644c0c1ecc6",
                                "sense_id": "f4b81c0c-d201-3e0f-8c4b-79e418cd0c9f",
                                "text": "– Pas l'gaz ! ricane l'Enflure. Tire mon p'tit doigt. J'vais te craquer une louise qu'si ton cocu y croive pas qu'on vient d'vous l'installer, l'gaz, c'est qu'y manque vraiment d'imagination."
                            },
                            {
                                "example_id": "fd742cd3-af52-4b2d-9144-a6713fcc11b8",
                                "sense_id": "f4b81c0c-d201-3e0f-8c4b-79e418cd0c9f",
                                "text": "Vi, vu qu'à force de bons mots et de contrepets y en a bien un(e) qui va nous craquer une louise, bonne mère!"
                            },
                            {
                                "example_id": "99eddab5-c158-4727-916a-ad3ceee6fb03",
                                "sense_id": "f4b81c0c-d201-3e0f-8c4b-79e418cd0c9f",
                                "text": "Pour ne pas être en reste, l'un des occupants se met à craquer une louise, mais après tout, peutêtre s'agitil du même qui serait biloque."
                            },
                            {
                                "example_id": "1ce0569c-09f9-45b9-a0e2-8396ba3c98bc",
                                "sense_id": "f4b81c0c-d201-3e0f-8c4b-79e418cd0c9f",
                                "text": "J'ai un bras droit qui, quand il pense lâcher une louise discrète fait le même bruit qu'un Boeing au décollage."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
