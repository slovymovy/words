                ],
                "senses": [
                    {
                        "sense_id": "94b1523a-fcc4-329d-bb1f-64442fdb75c0",
                        "entry_id": "edb769a1-4072-316a-873f-963b53856fb2",
                        "glosses": [
                            "Linguistik: Wort, das als vulgär/anstößig empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "604cfd30-38e0-491d-9f78-6c0be951f0fa",
                                "sense_id": "94b1523a-fcc4-329d-bb1f-64442fdb75c0",
                                "text": "„Derbe, dialektverhaftete sowie wenig »höfliche« Ausdrucksformen und Vulgärworte kamen so gut wie nie in literarisch anspruchsvollen Texten vor.“"
                            },
                            {
                                "example_id": "4b48d6f2-f777-4c59-a7d1-e66d1f5fea48",
                                "sense_id": "94b1523a-fcc4-329d-bb1f-64442fdb75c0",
                                "text": "„So bezeichnet in der italienischen Sprache das Wort „Fica“ nicht nur die Feige als Frucht, sondern auch die Vulva und ist ein Vulgärwort für diese.“"
                            },
                            {
                                "example_id": "2f177dc4-5a4b-40cc-86cb-1b89f79e545b",
                                "sense_id": "94b1523a-fcc4-329d-bb1f-64442fdb75c0",
                                "text": "„Der Philologe weiß, daß sich Berufs- und Sondersprachen bevorzugt aus der Umgangssprache nähren, und so klingt unser Vulgärwort, artig verpackt in französisches oder lateinisches Wortmaterial, recht aufgehöht.“"
                            },
                            {
                                "example_id": "4ee68e9c-57d1-4b03-996e-6169fbaf0366",
                                "sense_id": "94b1523a-fcc4-329d-bb1f-64442fdb75c0",
                                "text": "„Heißer Ortsname - Die Bewohner der Gemeinde \"Fucking\" in Innviertel/Niederösterreich sind nicht nur spöttischen Bemerkungen ausgesetzt, weil \"fucking\" im Englischen ein Vulgärwort für Geschlechtsverkehr ist.“"
                            },
                            {
                                "example_id": "f6318f27-3e16-4c25-8d03-89a7d3f9add4",
                                "sense_id": "94b1523a-fcc4-329d-bb1f-64442fdb75c0",
                                "text": "„Vulgärwörter finden also mehr und mehr Eingang in die Standard- und Umgangssprache, aber es fällt andererseits auf, dass solche Wörter in der alltäglichen Kommunikation nicht oder äußerst selten vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
