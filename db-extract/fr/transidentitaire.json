                        "entry_id": "b80b9728-e53b-3f1f-8f68-f5e73b253359",
                        "glosses": [
                            "Personne dont l’identité de genre ne correspond pas à celle que l’état civil lui a assigné à la naissance."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "9d2afb3c-5268-4172-9e01-3ee2b7e273b0",
                                "sense_id": "600d1a24-0e5e-3cb3-88b5-50ec587da4af",
                                "text": "Il nous explique comment accepter et accompagner un transidentitaire."
                            },
                            {
                                "example_id": "f7fb518e-b59a-4d7f-b533-61d487653ba2",
                                "sense_id": "600d1a24-0e5e-3cb3-88b5-50ec587da4af",
                                "text": "En féministe, elle le sort de la hiérarchie binaire inégalitaire ; en lesbienne queer, elle le sort du clivage politique homo/hétéro. Je résume sa pensée par la mienne : je ne suis pas une femme mais une transidentitaire."
                            }
                        ]
                    }
