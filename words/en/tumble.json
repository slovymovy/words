{
    "word_family": [
        "tumbler",
        "tumbling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8e46322-34ab-3fb5-a84d-e0a1263e6690",
                    "sense_definition": "To fall end over end; to roll over and over.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child watched the ball <w>tumble</w> down the grassy hill.",
                            "target_lang_translations": {
                                "zh": "孩子看着球从长满草的山坡上<w>滚落</w>下来。"
                            }
                        },
                        {
                            "text": "Old books began to <w>tumble</w> from the shelf when the earthquake started.",
                            "target_lang_translations": {
                                "zh": "地震开始时，旧书开始从书架上<w>滚落</w>下来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tumble down"
                    ],
                    "target_lang_definitions": {
                        "zh": "翻着跟头落下；不断滚动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滚落",
                                "target_lang_sense_clarification": "指物体一边翻滚一边落下"
                            },
                            {
                                "target_lang_word": "翻滚",
                                "target_lang_sense_clarification": "强调连续翻滚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ade9f80a-ef40-3fd3-bd0a-6daa783c4310",
                    "sense_definition": "To drop rapidly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stock market prices <w>tumble</w> when investors lose confidence in the economy.",
                            "target_lang_translations": {
                                "zh": "当投资者对经济失去信心时，股市价格会<w>暴跌</w>。"
                            }
                        },
                        {
                            "text": "Temperatures will <w>tumble</w> tonight as the cold front moves through the region.",
                            "target_lang_translations": {
                                "zh": "随着冷锋穿过这一地区，今晚气温将<w>骤降</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plummet",
                        "drop"
                    ],
                    "antonyms": [
                        "soar",
                        "rise"
                    ],
                    "target_lang_definitions": {
                        "zh": "迅速下跌或下降。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暴跌",
                                "target_lang_sense_clarification": "用于价格、数值等迅速大幅下降"
                            },
                            {
                                "target_lang_word": "骤降",
                                "target_lang_sense_clarification": "用于气温等快速下降"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90391eae-b1d8-3d6a-aafa-23f5d07d5225",
                    "sense_definition": "To move or rush in a headlong or uncontrolled way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excited children <w>tumble</w> out of the school bus at the end of the day.",
                            "target_lang_translations": {
                                "zh": "一天结束时，兴奋的孩子们从校车上<w>蜂拥</w>而出。"
                            }
                        },
                        {
                            "text": "Crowds <w>tumble</w> into the stadium to find their seats before the game begins.",
                            "target_lang_translations": {
                                "zh": "比赛开始前，人群<w>蜂拥</w>进体育场寻找自己的座位。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "莽撞地、失控地移动或猛冲。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜂拥",
                                "target_lang_sense_clarification": "指人群慌忙、无序地冲出或冲入"
                            },
                            {
                                "target_lang_word": "涌",
                                "target_lang_sense_clarification": "强调一下子冲动起来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "601e1c1c-9002-3f2f-99e8-e9f9803c878b",
                    "sense_definition": "To muss, to make disorderly; to tousle or rumple.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind began to <w>tumble</w> her hair as she walked along the beach.",
                            "target_lang_translations": {
                                "zh": "她沿着海滩走时，风开始把她的头发<w>弄乱</w>了。"
                            }
                        },
                        {
                            "text": "Do not <w>tumble</w> the clean laundry before you have a chance to fold it.",
                            "target_lang_translations": {
                                "zh": "在你还没来得及叠之前，别把干净的衣物<w>弄乱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rumple",
                        "tousle"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "tumble a bed"
                    ],
                    "target_lang_definitions": {
                        "zh": "弄得凌乱；弄蓬松；弄皱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄乱",
                                "target_lang_sense_clarification": "把头发、衣物等弄得不整齐"
                            },
                            {
                                "target_lang_word": "弄蓬乱",
                                "target_lang_sense_clarification": "尤指把头发弄得蓬乱"
                            },
                            {
                                "target_lang_word": "弄皱",
                                "target_lang_sense_clarification": "把布料、床铺等弄皱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff1370ba-2be1-32d6-a10d-5e5f28dde251",
                    "sense_definition": "To perform gymnastics such as somersaults, rolls, and handsprings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athletes learn to <w>tumble</w> safely on the padded mats.",
                            "target_lang_translations": {
                                "zh": "年轻运动员学习如何在软垫上安全地<w>翻腾</w>。"
                            }
                        },
                        {
                            "text": "She practiced her routine to <w>tumble</w> across the floor with grace and speed.",
                            "target_lang_translations": {
                                "zh": "她练习整套动作，以便优雅而迅速地<w>翻腾</w>穿过场地。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "做翻跟头、滚翻、手翻等体操动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翻腾",
                                "target_lang_sense_clarification": "做体操翻滚动作的通用说法"
                            },
                            {
                                "target_lang_word": "翻筋斗",
                                "target_lang_sense_clarification": "特指翻跟头类动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d1cece5-9bda-352f-9740-5e505a0bc651",
                    "sense_definition": "To throw headlong.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong waves <w>tumble</w> the rocks against the shore during the storm.",
                            "target_lang_translations": {
                                "zh": "暴风雨中，巨浪把岩石<w>掀动</w>着撞向岸边。"
                            }
                        },
                        {
                            "text": "He managed to <w>tumble</w> the heavy boxes into the back of the truck.",
                            "target_lang_translations": {
                                "zh": "他设法把沉重的箱子<w>扔</w>进了卡车后部。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "猛力把某物甩出或掀动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "使某物被猛力甩动或抛出去"
                            },
                            {
                                "target_lang_word": "掀动",
                                "target_lang_sense_clarification": "多用于浪等把东西翻搅着推动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8988d259-90b3-31b2-aa09-65e43407e8a9",
                    "sense_definition": "To smooth and polish (e.g. gemstones or pebbles) by means of a rotating tumbler.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>tumble</w> the rough stones for several days to get a high shine.",
                            "target_lang_translations": {
                                "zh": "你得把粗糙的石头<w>滚磨抛光</w>好几天，才能得到很高的光泽。"
                            }
                        },
                        {
                            "text": "They <w>tumble</w> raw quartz to create beautiful jewelry pieces.",
                            "target_lang_translations": {
                                "zh": "他们把原始石英<w>滚磨抛光</w>，制成漂亮的首饰。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用旋转滚筒把石料等磨平并抛光。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滚磨抛光",
                                "target_lang_sense_clarification": "用滚筒把石头等磨光抛亮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf482de-24f6-3658-b082-be31edb355f9",
                    "sense_definition": "To comprehend; often in tumble to.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took him a while to <w>tumble</w> to the fact that he was being tricked.",
                            "target_lang_translations": {
                                "zh": "过了一会儿他才<w>明白过来</w>，自己一直在被耍。"
                            }
                        },
                        {
                            "text": "She finally began to <w>tumble</w> to the complex rules of the new game.",
                            "target_lang_translations": {
                                "zh": "她终于开始<w>明白过来</w>这个新游戏的复杂规则了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "understand",
                        "realize"
                    ],
                    "common_phrases": [
                        "tumble to"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'tumble to'."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "明白；领悟到，常见于 tumble to。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "明白过来",
                                "target_lang_sense_clarification": "口语，指终于意识到或懂了"
                            },
                            {
                                "target_lang_word": "察觉",
                                "target_lang_sense_clarification": "强调察觉到真相或情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "411f474e-e664-375e-aaf2-a144f836dc15",
                    "sense_definition": "To obscure the audit trail of funds by means of a tumbler.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Criminals often <w>tumble</w> digital currency to hide the origin of their money.",
                            "target_lang_translations": {
                                "zh": "犯罪分子常常把数字货币拿去<w>混币</w>，以隐藏资金来源。"
                            }
                        },
                        {
                            "text": "The software allows users to <w>tumble</w> transactions to increase financial privacy.",
                            "target_lang_translations": {
                                "zh": "这款软件允许用户对交易进行<w>混币</w>，以增强资金隐私。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过混币器掩盖资金交易痕迹。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混币",
                                "target_lang_sense_clarification": "在加密货币领域指通过混币器打乱资金来源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e651e17-1c0b-3bd6-809e-e18f30266ca7",
                    "sense_definition": "To have sexual intercourse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The characters in the old novel <w>tumble</w> in the hayloft.",
                            "target_lang_translations": {
                                "zh": "旧小说里的人物在干草阁楼里<w>交欢</w>。"
                            }
                        },
                        {
                            "text": "They decided to <w>tumble</w> after a long night of dancing.",
                            "target_lang_translations": {
                                "zh": "他们跳了一整夜舞后，决定去<w>上床</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "copulate",
                        "mate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Euphemistic or literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发生性关系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "交欢",
                                "target_lang_sense_clarification": "较委婉、较文气的说法"
                            },
                            {
                                "target_lang_word": "上床",
                                "target_lang_sense_clarification": "较口语的说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5c90c6f-2431-3476-999a-267369720df6",
                    "sense_definition": "A fall, especially end over end.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a nasty <w>tumble</w> on the ice and hurt her knee.",
                            "target_lang_translations": {
                                "zh": "她在冰上狠狠<w>摔了一跤</w>，伤了膝盖。"
                            }
                        },
                        {
                            "text": "After a long <w>tumble</w> down the stairs, he was lucky to only have bruises.",
                            "target_lang_translations": {
                                "zh": "从楼梯上一路<w>翻滚</w>下来后，他只是有些瘀伤，算是走运了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fall"
