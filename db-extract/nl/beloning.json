                        "sense_id": "59c35039-faaf-388f-878d-76a0de7a054e",
                        "entry_id": "151f7b7b-4d64-331d-9451-8462ea652eed",
                        "glosses": [
                            "iets wat men krijgt na het verrichten van een goede daad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81942d5d-7c6c-474b-9046-a9ae0b5d9e46",
                                "sense_id": "59c35039-faaf-388f-878d-76a0de7a054e",
                                "text": "laatste fase van een project: beloning van hen die er niets mee te maken hebben"
                            },
                            {
                                "example_id": "6fda4857-46a2-4861-8330-9f11c27f657c",
                                "sense_id": "59c35039-faaf-388f-878d-76a0de7a054e",
                                "text": "Een pluim van de juf is natuurlijk de mooiste beloning die een kind op school kan krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6b1f560-250d-405e-ae9d-adb4a48b32ab",
