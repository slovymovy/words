    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db5a8b3b-1e50-3da7-b19d-731bc77c03ce",
                    "sense_definition": "A young dog, especially one that has not yet reached sexual maturity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little <w>puppy</w> played happily in the garden.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>щенок</w> весело играл в саду.",
                                "zh": "那只小<w>幼犬</w>在花园里快乐地玩耍。"
                            }
                        },
                        {
                            "text": "She wants to adopt a <w>puppy</w> from the animal shelter.",
                            "target_lang_translations": {
                                "ru": "Она хочет взять <w>щенка</w> из приюта для животных.",
                                "zh": "她想从动物收容所领养一只<w>小狗</w>。"
                            }
                        },
                        {
                            "text": "It is just a case of <w>puppy</w> love between the two teenagers.",
                            "target_lang_translations": {
                                "ru": "Это просто <w>щенячья</w> любовь между двумя подростками.",
                                "zh": "这两个青少年之间不过是<w>青涩的初恋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pup"
                    ],
                    "common_phrases": [
                        "puppy love",
                        "puppy fat",
                        "puppy dog eyes",
                        "hush puppy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодая собака, особенно та, которая еще не достигла половой зрелости.",
                        "zh": "幼犬，指尚未达到性成熟的狗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щенок",
                                "target_lang_sense_clarification": "детеныш собаки"
                            },
                            {
                                "target_lang_word": "кутёнок",
                                "target_lang_sense_clarification": "разговорное название щенка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小狗",
                                "target_lang_sense_clarification": "幼犬的通用称呼"
                            },
                            {
                                "target_lang_word": "幼犬",
                                "target_lang_sense_clarification": "较正式的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "850b681d-c2fb-308f-83b9-9aab47c3d81f",
                    "sense_definition": "A generic thing or object, often used to refer to something with a specific attitude or when the speaker is annoyed or impressed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to fix this <w>puppy</w> before we can leave the garage.",
                            "target_lang_translations": {
                                "ru": "Мне нужно починить эту <w>штуковину</w>, прежде чем мы сможем уехать из гаража.",
                                "zh": "我得把这个<w>玩意儿</w>修好才能离开车库。"
                            }
                        },
                        {
                            "text": "Let's fire this <w>puppy</w> up and see what it can do.",
                            "target_lang_translations": {
                                "ru": "Давай заведем эту <w>штуковину</w> и посмотрим, на что она способна.",
                                "zh": "让我们启动这个<w>家伙</w>，看看它能干什么。"
                            }
