                                        "glosses": [
                                            "Gebet für jemand anderen (sowohl im persönlichen Gebet als auch innerhalb der kirchlichen Liturgie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56f8431-2a0f-4f53-af79-b58e42edea2d",
                                                "sense_id": "1eb99a3f-777b-3f6e-9f3c-843d83ffcbb1",
                                                "text": "Diese Wünsche vertraue ich der Fürbitte der Heiligen Jungfrau, der Mutter des Erlösers an …"
                                            },
                                            {
                                                "example_id": "b518e1cb-a044-4171-ab6d-a5c6ac3a910f",
                                                "sense_id": "1eb99a3f-777b-3f6e-9f3c-843d83ffcbb1",
                                                "text": "„Ganze Kirchspiele hatten sich vereinigt und kamen 10, 20 und mehr Meilen weit her, um der schönen Mutter Gottes zu opfern und sich ihrer Fürbitte zu empfehlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b67add5-4b02-426f-801a-7d18aa328926",
                        "source_entry_id": "a53e70a4-1d86-3382-84ed-a158225d7597",
                        "source_sense_id": "4da4bb58-d350-3828-a0c2-7a69935fa1d7",
                        "source_sense_description": "Fürbitte, Fürsprache",
                        "target_lang_word": "Fürsprache",
