                                    {
                                        "sense_id": "ce196fb4-0ba6-3f21-9aeb-3e2435e3f8e5",
                                        "entry_id": "d1106b18-9951-31a6-8299-d4f79e0d769e",
                                        "glosses": [
                                            "Personnage de la mythologie grecque, condamné par Zeus à rouler perpétuellement un énorme rocher jusqu’en haut d’une montagne, d’où il retombait sans cesse."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1fbb996-2b59-4d4e-8cdf-8fd2c789a736",
                                                "sense_id": "ce196fb4-0ba6-3f21-9aeb-3e2435e3f8e5",
                                                "text": "Un travail de Sisyphe : Un travail qui se défait et qu’il faut sans cesse recommencer."
                                            },
                                            {
                                                "example_id": "fcf6bc44-b10d-4bff-9515-c303488b7063",
                                                "sense_id": "ce196fb4-0ba6-3f21-9aeb-3e2435e3f8e5",
                                                "text": "Le bécasseau variable picore son estran au gré des marées, tel un Sisyphe des sables."
                                            },
                                            {
                                                "example_id": "815ceea1-6463-4322-a2d3-3215d3d7fa14",
                                                "sense_id": "ce196fb4-0ba6-3f21-9aeb-3e2435e3f8e5",
                                                "text": "Le patient atteint d’un tel syndrome est enfermé dans un perpétuel présent dont il ne conserve aucune trace consciente, incarnation du mythe de Sisyphe dépourvu de la conscience de la répétition. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 389)"
                                            }
                                        ]
                                    }
                                ]
