                        "glosses": [
                            "Où est-ce que. — Note d’usage : Utilisé sans inversion sujet-verbe."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eed8644d-286c-42df-9dd4-01bb603f575b",
                                "sense_id": "8a3c5cd9-4a96-386a-b4c5-ceebc29b374d",
                                "text": "Oùsqu’est le temps où j’avalais des sabres ?\nOùsque j’faisais l’albinos du l’boul’vard ?\nOùsque j’dansais à l’ombre des grands âbres\nUn’ cachucha nativ’ d’la ru’ Mouff’tard,\nAvec mon andalous’ de Vaugirard ?"
                            }
                        ]
                    }
