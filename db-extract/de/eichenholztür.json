                        "examples": [
                            {
                                "example_id": "294692b5-5f09-4530-bd0d-0d9e7ec0acb3",
                                "sense_id": "d0130c84-37d0-3033-87cb-eeaba8c892d4",
                                "text": "„Dann zogen sie Masken über und klopften höflich an die wetterzerfressene Eichenholztür.“"
                            },
                            {
                                "example_id": "6dcaf125-c431-45e9-937d-06c3e644da18",
                                "sense_id": "d0130c84-37d0-3033-87cb-eeaba8c892d4",
                                "text": "„Katie kehrt in ihr Haus zurück und verriegelt die dicke Eichenholztür.“"
                            },
                            {
                                "example_id": "a074c47d-986c-474a-8662-09d9f751f521",
                                "sense_id": "d0130c84-37d0-3033-87cb-eeaba8c892d4",
                                "text": "„Das Hauptportal besteht aus schweren Eichenholztüren, als wollte man die Kranken daran hindern abzuhauen oder die Trauernden dazu verleiten kehrtzumachen.“"
                            }
                        ],
