        "fr-extract.jsonl": [
            {
                "entry_id": "aeba1e79-0476-3b30-820d-e02279727234",
                "word": "moxibustion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2cbdeca3-2a68-4072-bbbd-21f211d31809",
                        "entry_id": "aeba1e79-0476-3b30-820d-e02279727234",
                        "tags": [
                            "plural"
                        ],
                        "form": "moxibustions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                        "entry_id": "aeba1e79-0476-3b30-820d-e02279727234",
                        "glosses": [
                            "Médecine traditionnelle asiatique, basée sur la stimulation de points d’acupuncture par du moxa."
                        ],
                        "tags": [
                            "Médecine non conventionnelle"
                        ],
                        "examples": [
                            {
                                "example_id": "65777313-3eab-4c9d-b724-c220ec01b1f3",
                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                "text": "Xiluan frotta aussi mon corps à la médecine traditionnelle, à la pharmacopée végétale et minérale, à la moxibustion comme à l’acupuncture."
                            },
                            {
                                "example_id": "5337fe9a-cb1a-43d8-becd-66813dd0dbaa",
                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                "text": "Il se peut que la moxibustion ait été d’abord utilisée en Chine pour soulager les douleurs rhumatismales aux articulations et à d’autres fins analgésiques."
                            },
                            {
                                "example_id": "e5702bb4-0b35-4f60-a240-d2dbc5588ce1",
                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                "text": "Si de terribles maladies frappent votre village, si des enfants passent de vie à trépas sans raison apparente, les remèdes traditionnels - saignées, cataplasmes, moxibustions - resteront sans effet pour la bonne raison qu’ils ne s’attaquent pas à la raison réelle des catastrophes : une règle a été enfreinte et un génie malveillant s’est introduit dans les lieux."
                            },
                            {
                                "example_id": "1bdfe701-b60e-45eb-a048-25528f376960",
                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                "text": "Une salle axée sur la pharmacopée, l’acupuncture et la moxibustion aborde également les techniques de traitement, telles que le massage et les pratiques énergétiques (qi gong, tai-chi, yoga)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cabe4e47-8653-43c7-9a87-6ef7c8dab0e4",
                        "source_entry_id": "aeba1e79-0476-3b30-820d-e02279727234",
                        "source_sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                        "target_lang_word": "Moxa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moxa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                                        "entry_id": "b69f0aec-9fc2-36c1-94b3-6fab11abd6de",
                                        "glosses": [
                                            "in Ostasien als Brennkraut verwendete Beifußwolle"
                                        ],
                                        "tags": [
                                            "TCM",
                                            "Naturheilmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "339cb52a-bdb3-4a3f-9e29-fc2568111d7a",
                                                "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                                                "text": "„Nun brannte die alte Liu dem Kinde über den Augenbrauen, auf dem Nacken, in den Fingergelenken der Hände und auf der Herzgrube insgesamt fünf Moxen ab und legte es dann zum Schlafe nieder.“"
                                            },
                                            {
                                                "example_id": "eeed8ac7-210e-49a3-99bb-ae6768956831",
                                                "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                                                "text": "„Im Gesicht ist Moxa ebenfalls kontraindiziert. Die einzige Ausnahme ist der Punkt Yìntáng auf der Stirn zwischen den Augenbrauen. Die Geschlechtsteile sind generell nicht mit Moxa zu behandeln. Während der Menstruation kein Moxa!“"
                                            },
                                            {
                                                "example_id": "1d535987-1524-43a4-a745-5001791a704b",
                                                "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                                                "text": "„Im Bian Gue Shin Shu heißt es: „Dringen Kälte und Wind in den Körper ein, behandle mit Moxa.“ Und im Lingshu wird formuliert: „Was die Nadel nicht zu heilen vermag, dagegen wirkt das Brennen (= Moxa).“ “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac894deb-fce0-302f-bc2d-696d21176520",
                                        "entry_id": "b69f0aec-9fc2-36c1-94b3-6fab11abd6de",
                                        "glosses": [
                                            "Moxibustion"
                                        ],
                                        "tags": [
                                            "anderer Name für die Therapie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb97e1e-218d-4eb2-9671-6149ed9a4020",
                                                "sense_id": "ac894deb-fce0-302f-bc2d-696d21176520",
                                                "text": "„Im Gesicht ist Moxa ebenfalls kontraindiziert. Die einzige Ausnahme ist der Punkt Yìntáng auf der Stirn zwischen den Augenbrauen. Die Geschlechtsteile sind generell nicht mit Moxa zu behandeln. Während der Menstruation kein Moxa!“"
                                            },
                                            {
                                                "example_id": "b5939038-18f8-475d-80d0-2bb87ed5afc1",
                                                "sense_id": "ac894deb-fce0-302f-bc2d-696d21176520",
                                                "text": "„Im Bian Gue Shin Shu heißt es: „Dringen Kälte und Wind in den Körper ein, behandle mit Moxa.“ Und im Lingshu wird formuliert: „Was die Nadel nicht zu heilen vermag, dagegen wirkt das Brennen (= Moxa).“ “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
