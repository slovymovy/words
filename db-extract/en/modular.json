                                "target_senses": [
                                    {
                                        "sense_id": "52cbb76c-fbf2-3ea9-b9d8-1951c4202611",
                                        "entry_id": "4b066f45-6040-32c1-8969-afdb2ea50d8d",
                                        "glosses": [
                                            "Constitué de modules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15490d01-0d7c-4962-9066-5a173a8984bc",
                                                "sense_id": "52cbb76c-fbf2-3ea9-b9d8-1951c4202611",
                                                "text": "Ara est \"un téléphone modulaire\", avec une structure de base sur laquelle l'utilisateur peut assembler avec des électro-aimants, comme sur un jeu de construction, des modules de différentes couleurs et fonctionnalités …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c6436b7-f3e0-34d9-834f-2f9174e3613b",
                                        "entry_id": "4b066f45-6040-32c1-8969-afdb2ea50d8d",
                                        "glosses": [
                                            "Relatif à la modularité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf753bcf-44bc-3e09-af42-240800bcc7d8",
                                        "entry_id": "4b066f45-6040-32c1-8969-afdb2ea50d8d",
                                        "glosses": [
                                            "Se dit de l'architecture qui réutilise les styles de l'antiquité gréco-romaine basés sur le module."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f36eaf2-d53d-40e8-9351-1279ad362f9d",
                                                "sense_id": "bf753bcf-44bc-3e09-af42-240800bcc7d8",
                                                "text": "L'architecture modulaire est celle qui dérive des ordres grecs et romains qui ont le module comme règle ou canon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9f62b11-8f72-3683-93bc-5083ae3bdbd5",
                                        "entry_id": "4b066f45-6040-32c1-8969-afdb2ea50d8d",
                                        "glosses": [
                                            "Se dit de l'architecture qui utilise des modules préfabriqués."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3705ab5d-0831-43b1-9e42-894567dc9e59",
                                                "sense_id": "e9f62b11-8f72-3683-93bc-5083ae3bdbd5",
                                                "text": "Comme le souligne Frigant, l'architecture modulaire permet de réduire la complexité d'un produit décomposable en modules potentiellement concevables et réalisables de façon autonome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
