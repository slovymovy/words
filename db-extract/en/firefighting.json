                        "source_entry_id": "8016d1e8-f494-3fa9-a8a7-3fff74907ffb",
                        "source_sense_description": "action of extinguishing a fire",
                        "target_lang_word": "lutte contre l’incendie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lutte contre l’incendie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ece5b5d-8f5c-3acc-9dde-8d28960a1872",
                                        "entry_id": "6cea97f5-2cd5-3ea5-965e-21a690cfbce0",
                                        "glosses": [
                                            "Atténuation ou extinction d’un feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0075c8-d411-4636-8812-a33c5dafa3c5",
                                                "sense_id": "8ece5b5d-8f5c-3acc-9dde-8d28960a1872",
                                                "text": "À cette occasion, le président a réitéré l’offre qu’il avait déjà formulée jeudi soir d’envoyer des ressources « aussi importantes que possible » pour assister les efforts de lutte contre l’incendie, a précisé M. Rhodes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0667b452-69e6-33c3-9a62-e4a6f54e237c",
                                        "entry_id": "6cea97f5-2cd5-3ea5-965e-21a690cfbce0",
                                        "glosses": [
                                            "Profession ou activité de sapeur-pompier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a64d5b-991b-41e4-b529-002a5aa5c1e2",
                                                "sense_id": "0667b452-69e6-33c3-9a62-e4a6f54e237c",
                                                "text": "Le contrôle de l’incendie « est désormais plus proche », selon l’Office national des forêts (Conaf), l’organisme officiel qui coordonne les opérations de lutte contre l’incendie."
                                            },
                                            {
                                                "example_id": "70368b33-b432-4b1e-9cf1-edc817ef208c",
                                                "sense_id": "0667b452-69e6-33c3-9a62-e4a6f54e237c",
                                                "text": "Espérons que l’administration qui connaît l’infériorité de nos moyens matériels de lutte contre l’incendie, mettra quelques ardeur à mieux pourvoir l’admirable personnelle dont elle dispose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3586886-bc58-4200-9674-0225bbae6c43",
                        "source_entry_id": "8016d1e8-f494-3fa9-a8a7-3fff74907ffb",
                        "source_sense_description": "action of extinguishing a fire",
                        "target_lang_word": "Brandbekämpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brandbekämpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "057ee3ef-bd92-3745-a426-a99e561d8198",
                                        "entry_id": "23043180-79f9-3c47-af74-552005a64115",
                                        "glosses": [
                                            "Gesamtheit aller Maßnahmen, die nötig sind, um ein ausgebrochenes Feuer zu löschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5132e2e-df3c-406f-a8b9-c3bbfec938d3",
                                                "sense_id": "057ee3ef-bd92-3745-a426-a99e561d8198",
                                                "text": "Die Feuerwehrleute üben die Brandbekämpfung an einer Hausruine."
                                            },
                                            {
                                                "example_id": "dc71d4e4-223a-4392-afb3-4cb03c869356",
                                                "sense_id": "057ee3ef-bd92-3745-a426-a99e561d8198",
                                                "text": "„Die feuerpolizeiliche Aufsicht dient der Überwachung der Einhaltung dieses Gesetzes sowie allgemein der Feststellung von Zuständen, die eine Brandgefahr herbeiführen oder vergrößern oder die Brandbekämpfung oder die Durchführung von Rettungsarbeiten erschweren oder verhindern können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
