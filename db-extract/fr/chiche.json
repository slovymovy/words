                                "example_id": "412c5429-b25a-4aa1-9324-436656c44102",
                                "sense_id": "76a82279-ee3f-3804-bd16-b39cd5e3fc82",
                                "text": "Après plus de sept ans dans le prêt-à-porter, la Clodoaldienne Patricia Chiche a choisi de s’installer dans ce quartier qu’elle affectionne particulièrement."
                            },
                            {
                                "example_id": "e9e82b09-f2ed-49db-89f1-d60abc982901",
                                "sense_id": "76a82279-ee3f-3804-bd16-b39cd5e3fc82",
                                "text": "Les romans de Dominique Barbéris, Sarah Chiche et Antoine Sénanque sont finalistes du Grand Prix du roman de l’Académie française, a annoncé l’institution jeudi."
                            }
                        ]
                    }
