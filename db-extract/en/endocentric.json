                        "sense_id": "a54973c3-3cbf-3a5b-ae90-022761ce5a44",
                        "entry_id": "1fabb88c-7198-335e-8833-1b3ac3213886",
                        "glosses": [
                            "Fulfilling the same grammatical role as one of its constituents."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c851357-4596-43f6-8356-52c87a5d3364",
                                "sense_id": "a54973c3-3cbf-3a5b-ae90-022761ce5a44",
                                "text": "The noun \"houseboat\" is endocentric because \"boat\" is also a noun."
                            }
                        ]
                    }
                ],
                "translations": [
