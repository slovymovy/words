                    },
                    {
                        "form_id": "a62349e8-7eef-4254-8ff7-705a6959ac72",
                        "entry_id": "8c86609e-334b-34a3-8b2d-7590854257b9",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "cimmérienne"
                    },
                    {
                        "form_id": "4083cd1c-a232-4d6f-8058-05be6a04eff2",
                        "entry_id": "8c86609e-334b-34a3-8b2d-7590854257b9",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "cimmériennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5e77cfc-3e10-384a-a62f-99b823b2e698",
                        "entry_id": "8c86609e-334b-34a3-8b2d-7590854257b9",
                        "glosses": [
                            "Relatif aux Cimmériens, un peuple scythique habitant au nord, ou à la Cimmérie, leur territoire."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "3e7784c3-8079-4132-83dc-a1afc73d7a38",
                                "sense_id": "f5e77cfc-3e10-384a-a62f-99b823b2e698",
                                "text": "Bosphore cimmérien : Détroit qui conduisait de la mer Noire à la mer d’Azov."
                            },
                            {
                                "example_id": "be2d8db0-ddb6-41ce-82a4-4c273c781a9c",
                                "sense_id": "f5e77cfc-3e10-384a-a62f-99b823b2e698",
                                "text": "À mi-chemin, se trouvait le royaume-client du Bosphore cimmérien dans l’actuelle Crimée."
                            },
                            {
                                "example_id": "ef1370d1-9321-4f0c-8bef-9a79af1091b2",
                                "sense_id": "f5e77cfc-3e10-384a-a62f-99b823b2e698",
                                "text": "Ténèbres cimmériennes : Nuit permanente que les Grecs plaçaient dans le pays des Cimmériens."
                            },
                            {
                                "example_id": "480a5532-6c7d-4cdd-88c8-5c16343d4504",
                                "sense_id": "f5e77cfc-3e10-384a-a62f-99b823b2e698",
                                "text": "Le Tyran lui raconta l’aventure tragique du capitaine resté dans la neige.\n« Sans la rencontre heureuse que nous avons faite d’un ancien et brave camarade, il nous en pendait autant cette nuit au bout du nez, dit Blazius. On nous eût trouvés gelés comme matelots dans les ténèbres et frimas cimmériens. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2fcb6aa-4a8c-37ec-bcf9-e56e63ab705d",
                        "entry_id": "8c86609e-334b-34a3-8b2d-7590854257b9",
                        "glosses": [
                            "Qui concerne la Cimmérie, terre de l’univers fictif de Conan, créé par Robert E. Howard, qui correspond à ce qui deviendra les îles Britanniques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe0d40ce-3a89-4dfe-aff6-87c219eb7975",
                        "source_entry_id": "8c86609e-334b-34a3-8b2d-7590854257b9",
                        "target_lang_word": "Cimmerian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cimmerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea5094ae-e936-3382-b199-ce6599c3f20f",
                                        "entry_id": "fdf5593d-cd3a-302f-a10e-bd894bc8397a",
                                        "glosses": [
                                            "Any of the mythical people supposed to inhabit a land of perpetual darkness."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "275b9bdd-d6fe-4619-a9cb-ae1fa6665b64",
                                                "sense_id": "ea5094ae-e936-3382-b199-ce6599c3f20f",
                                                "text": "The city, there, of the Cimmerians stands\nWith clouds and darkness veil’d, on whom the sun\nDeigns not to look with his beam-darting eye,"
                                            },
                                            {
                                                "example_id": "ff23d6f4-a105-4350-acc8-7dc55f698d7c",
                                                "sense_id": "ea5094ae-e936-3382-b199-ce6599c3f20f",
                                                "text": "On their mysterious shores were the improbable homes of impossible peoples. The Great Sea, the Broad Sea, the Boundless Sea; the Ethiopians, \"dwelling far away, the most distant of men,\" and the Cimmerians, \"covered with darkness and cloud,\" where \"baleful night is spread over timid mortals.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6812e2-99d9-32a3-aafd-587128e6d5ed",
                                        "entry_id": "fdf5593d-cd3a-302f-a10e-bd894bc8397a",
                                        "glosses": [
                                            "One of the Cimmerii, ancient equestrian nomads of Indo-European origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0153227-ad81-4114-abb3-2cbf171dc4eb",
                                                "sense_id": "9f6812e2-99d9-32a3-aafd-587128e6d5ed",
                                                "text": "1910, Herodotus (484 B.C.E.–425 B.C.E.), History of Herodotus, translated by George Rawlinson\nIn his reign the Cimmerians, driven from their homes by the nomads of Scythia, entered Asia and captured Sardis"
                                            },
                                            {
                                                "example_id": "58cae4d4-33fe-41b0-88bb-2b04987d90fe",
                                                "sense_id": "9f6812e2-99d9-32a3-aafd-587128e6d5ed",
                                                "text": "Believe me, queen, your swarth Cimmerian\nDoth make your honour of his body's hue,\nSpotted, detested, and abominable."
                                            },
                                            {
                                                "example_id": "d8c1bf33-98f6-440d-8959-563267f130e9",
                                                "sense_id": "9f6812e2-99d9-32a3-aafd-587128e6d5ed",
                                                "text": "The Phrygian power was broken in the 9th or 8th century B.C. by the Cimmerians, who entered Asia Minor through Armenia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e7a966-c886-33e0-87e0-b94dedc5bdad",
                                        "entry_id": "fdf5593d-cd3a-302f-a10e-bd894bc8397a",
                                        "glosses": [
                                            "The prophetic priestess presiding over the Apollonian Oracle at Cimmerium in Italy."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa67c950-e660-4984-b927-d4dd30df2da7",
                                                "sense_id": "75e7a966-c886-33e0-87e0-b94dedc5bdad",
                                                "text": "1867 to 1885, Lactantius (240–320 C.E.), Ante-Nicene Fathers, translated by William Fletcher\nVarro relates that there were ten Sibyls,—the first of the Persians, the second the Libyan, the third the Delphian, the fourth the Cimmerian..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cimmerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04eb1774-20db-3cae-8b25-24e9c178836b",
                                        "entry_id": "d501922a-586e-31a9-bad7-839a31c4a165",
                                        "glosses": [
                                            "Pertaining to the ancient Cimmerians."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8af2384f-0cf7-3c89-ac2c-db9d5d5959fe",
                                        "entry_id": "d501922a-586e-31a9-bad7-839a31c4a165",
                                        "glosses": [
                                            "Characteristic of Cimmeria; especially describing particularly dense darkness etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb8f34c-29cc-4683-86ce-5233efdbe0bf",
                                                "sense_id": "8af2384f-0cf7-3c89-ac2c-db9d5d5959fe",
                                                "text": "there it sleepeth, here it slumbreth: more or lesse they are ever darknesses, yea Cimmerian darknesses."
                                            },
                                            {
                                                "example_id": "7ef72a15-5ee3-4f10-a6c3-a21e85ee6368",
                                                "sense_id": "8af2384f-0cf7-3c89-ac2c-db9d5d5959fe",
                                                "text": "Tarzan slept until midnight, then he arose and crept into the Cimmerian blackness of the forest."
                                            },
                                            {
                                                "example_id": "703a6055-5825-457f-b9f2-6cad18ca71b6",
                                                "sense_id": "8af2384f-0cf7-3c89-ac2c-db9d5d5959fe",
                                                "text": "But the recent explosions had tapped just a fraction of Tambora’s compressed magma—the real paroxysm came five days later. Crawfurd, two islands away, was forced to conduct his daily affairs by candlelight as a gigantic ash cloud plunged the whole region into Cimmerian gloom."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cimmerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0f28d41-8772-3df3-a58f-771c9428cdc4",
                                        "entry_id": "713fb0c0-2f6c-3a02-80b4-5022389367ff",
                                        "glosses": [
                                            "the language of the Cimmerians, possibly belonging to the Iranian branch"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Cimmerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e86a3fa-2719-310d-ad90-61adc11cbc0d",
                                        "entry_id": "17793aa3-604e-34e9-bbe2-a00a5dbd01e3",
                                        "glosses": [
                                            "related to the prehistoric continent of Cimmeria"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
