                "senses": [
                    {
                        "sense_id": "ab2f49f0-122e-3eab-aa16-2e988bab0a91",
                        "entry_id": "84bb181f-f1e8-3798-9b8b-44c8fe8fad6f",
                        "glosses": [
                            "Danse ukrainienne et chant l’accompagnant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "270c064a-2238-422b-bfe7-d3fa788225a4",
                                "sense_id": "ab2f49f0-122e-3eab-aa16-2e988bab0a91",
                                "text": "Les dumki d’Ukraine, connues improprement sous le nom d’airs russes, peuvent se chanter sans accompagnement."
                            },
                            {
                                "example_id": "cd94f3c4-1552-4e61-9278-0bd93fb672fd",
                                "sense_id": "ab2f49f0-122e-3eab-aa16-2e988bab0a91",
                                "text": "La dumka ukrainienne a inspiré la deuxième Danse slave, en mi mineur. Complainte, chanson mélancolique, « dumka » est probablement un diminutif expressif du mot duma, signifiant à l’origine une chanson héroïco-méditative ukrainienne (XVIᵉ-XVIIᵉ siècle)."
                            },
                            {
                                "example_id": "2a835c80-733c-4172-b4c3-fb62ddc9a575",
                                "sense_id": "ab2f49f0-122e-3eab-aa16-2e988bab0a91",
                                "text": "Mais le compositeur tchèque amène ici le quintette vers d’autres contrées : en voyage au cœur de la Bohème, il puise dans le terreau fertile de la musique traditionnelle pour intégrer à son œuvre des dumkas, polkas et autres danses populaires des pays de l’Est."
                            }
                        ]
                    }
