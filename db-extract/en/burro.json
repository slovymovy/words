                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Packesel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae2e8b3-435e-3516-ad2e-8fcdd5742397",
                                        "entry_id": "23ff539a-4d57-35ff-8cb6-d91d656e70ff",
                                        "glosses": [
                                            "Hausesel, der vorwiegend für den Transport von schweren Lasten eingesetzt wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0149b5a1-952c-4b77-af01-9959948c82b4",
                                                "sense_id": "4ae2e8b3-435e-3516-ad2e-8fcdd5742397",
                                                "text": "Wie schön, dass wir nicht alles selbst hinaufschleppen mussten, wir hatten zwei Packesel, Joshua und Amy, die den größten Teil der Ausrüstung brav hochtrugen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08ec8229-e6a8-3036-9d97-33e9a7fec136",
                                        "entry_id": "23ff539a-4d57-35ff-8cb6-d91d656e70ff",
                                        "glosses": [
                                            "Person, der schwere Lasten/Aufgaben aufgebürdet werden"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a553f516-c5a7-48cd-a8e9-2ac7cd206adc",
                                                "sense_id": "08ec8229-e6a8-3036-9d97-33e9a7fec136",
                                                "text": "„Eine schreiende Ungerechtigkeit! Damit war's aber jetzt am Ende. Lange genug hatte man sich sagen lassen: Maul gehalten! Lange genug war man der Packesel gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
