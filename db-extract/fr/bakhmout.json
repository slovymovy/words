                                "target_senses": [
                                    {
                                        "sense_id": "c965923c-e888-3b98-b6d2-5494486faf71",
                                        "entry_id": "3051efaa-69e4-32fa-af07-557501198e8c",
                                        "glosses": [
                                            "eine Stadt in der Oblast Donezk im Osten der Ukraine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec44cb7e-9eeb-4526-87eb-90ec9c079fa0",
                                                "sense_id": "c965923c-e888-3b98-b6d2-5494486faf71",
                                                "text": "Bachmut ist ein Zentrum der ukrainischen Salzindustrie."
                                            },
                                            {
                                                "example_id": "4d542a48-9748-4a40-9a61-16aa25acbdd2",
                                                "sense_id": "c965923c-e888-3b98-b6d2-5494486faf71",
                                                "text": "Bachmut hat eine Städtepartnerschaft mit Omaha in den USA."
                                            },
                                            {
                                                "example_id": "30f09df6-b04b-4203-be14-577bfad35c79",
                                                "sense_id": "c965923c-e888-3b98-b6d2-5494486faf71",
                                                "text": "Russland will Bachmut erobern, ohne Rücksicht auf Verluste."
                                            },
                                            {
                                                "example_id": "c42b54d2-e880-4d25-9ee2-e89278856073",
                                                "sense_id": "c965923c-e888-3b98-b6d2-5494486faf71",
                                                "text": "Die Kämpfe um Bachmut binden eine Großzahl an russischen Kräften, Soldaten, die wiederum an anderer Stelle fehlen."
                                            },
                                            {
                                                "example_id": "bb3049a5-d688-4b23-b58d-9741eb4851ac",
                                                "sense_id": "c965923c-e888-3b98-b6d2-5494486faf71",
                                                "text": "Ukrainische Militäranalysten haben sich kritisch über das Festhalten der Armeeführung an der Schlacht um Bachmut geäußert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "870abbb1-dcaf-4fb0-bc24-51852b72640e",
                        "source_entry_id": "563f1870-5c88-3ef7-b0aa-01c45814f851",
                        "source_sense_id": "3a7d991a-cdc6-3990-8d09-861c8ea02082",
