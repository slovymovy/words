                                                "example_id": "774781d8-650b-4bc0-a3c4-a15b0afd6a5f",
                                                "sense_id": "44363682-de96-3e13-a916-361e98b8431a",
                                                "text": "His voice sounded kinda soy-ish but damn he has a god-like jawline."
                                            },
                                            {
                                                "example_id": "2af96c1e-6f3d-43c8-ab17-dab39acb1110",
                                                "sense_id": "44363682-de96-3e13-a916-361e98b8431a",
                                                "text": "Happy Monday to everyone except those who support vax mandates, aka soy people."
