                },
                {
                    "sense_id": "abaccb4c-ef1e-3a1f-918b-aad232b859d8",
                    "sense_definition": "Not active or busy, successful, or violent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Business is usually <w>slack</w> during the winter months.",
                            "target_lang_translations": {
                                "ru": "В зимние месяцы деловая активность обычно <w>затихает</w>.",
                                "cs": "Obchody jsou během zimních měsíců obvykle <w>slabé</w>."
                            }
                        },
                        {
                            "text": "We used the <w>slack</w> time to organize the office files.",
                            "target_lang_translations": {
                                "ru": "Мы использовали <w>затишье</w> в работе, чтобы упорядочить офисные файлы.",
                                "cs": "Využili jsme <w>klidnější</w> období k uspořádání kancelářských složek."
                            }
