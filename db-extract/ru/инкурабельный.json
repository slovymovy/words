                                                "sense_id": "f563739c-19b3-3a37-ac58-13a33ca8fa76",
                                                "text": "Kilka dni przed swym samobójstwem poeta dowiedział się, że jego choroba jest nieuleczalna."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
