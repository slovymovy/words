{
    "word_family": [
        "тамошний"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d8a16083-3a3e-3c07-b9e7-e9ba421de801",
                    "sense_definition": "В том месте, не здесь; указывает на пространство, удалённое от говорящего.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой друг живёт <w>там</w> уже много лет.",
                            "target_lang_translations": {
                                "en": "My friend has lived <w>there</w> for many years.",
                                "zh": "我的朋友在<w>那儿</w>已经住了很多年了。"
                            }
                        },
                        {
                            "text": "Кто <w>там</w> стоит у двери?",
                            "target_lang_translations": {
                                "en": "Who is standing <w>there</w> by the door?",
                                "zh": "谁站在门口<w>那儿</w>？"
                            }
                        }
                    ],
                    "antonyms": [
                        "тут",
                        "здесь"
                    ],
                    "common_phrases": [
                        "кто там",
                        "там и сям"
                    ],
                    "target_lang_definitions": {
                        "en": "In that place, not here; indicates a location distant from the speaker.",
                        "zh": "在那个地方，不在说话人所在处；指代距离说话人较远的空间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "there",
                                "target_lang_sense_clarification": "location"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那儿",
                                "target_lang_sense_clarification": "指代较远的地方"
                            },
                            {
                                "target_lang_word": "那里",
                                "target_lang_sense_clarification": "指代较远的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc6ae511-1245-3397-9e13-663949d1fa1f",
                    "sense_definition": "Потом, затем; в будущем (обычно при указании на последовательность действий).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сначала нужно закончить школу, а <w>там</w> видно будет.",
                            "target_lang_translations": {
                                "en": "First we need to finish school, and <w>then</w> we'll see.",
                                "zh": "首先得完成学业，<w>到时候</w>再看吧。"
                            }
                        },
                        {
                            "text": "Давай разберёмся с этой проблемой, а <w>там</w> и отдохнём.",
                            "target_lang_translations": {
                                "en": "Let's deal with this problem, and <w>then</w> we'll rest.",
                                "zh": "我们先解决这个问题，<w>然后</w>再去休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "потом",
                        "затем",
                        "впоследствии"
                    ],
                    "common_phrases": [
                        "а там посмотрим",
                        "а там видно будет"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Then, later; in the future (usually indicating a sequence of actions).",
                        "zh": "然后，之后；指代未来（通常用于表示动作的先后顺序）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "sequence of events"
                            },
                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "in the future"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "然后",
                                "target_lang_sense_clarification": "表示动作的先后顺序"
                            },
                            {
                                "target_lang_word": "到时候",
                                "target_lang_sense_clarification": "指代未来的某个时间点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dea66a1-e86e-36d5-bfaf-0101f1f4e224",
                    "sense_definition": "Употребляется как вводное слово или частица для заполнения паузы при поиске нужного слова или при приведении примеров.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы можем пойти в парк или, <w>там</w>, в кино.",
                            "target_lang_translations": {
                                "en": "We can go to the park or, <w>like</w>, to the movies.",
                                "zh": "我们可以去公园，或者<w>比如</w>去电影院。"
                            }
                        },
                        {
                            "text": "Купи что-нибудь к чаю, печенье <w>там</w> или конфеты.",
                            "target_lang_translations": {
                                "en": "Buy something for tea, cookies, <w>say</w>, or candy.",
                                "zh": "买点配茶的东西，<w>比如</w>饼干或者糖果。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "слово-паразит"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a filler word or particle to fill a pause when searching for the right word or giving examples.",
                        "zh": "用作填充词或语气词，用于寻找词汇时的停顿或列举例子。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "filler word"
                            },
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "for example"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "比如",
                                "target_lang_sense_clarification": "用于列举例子"
                            },
                            {
                                "target_lang_word": "什么的",
                                "target_lang_sense_clarification": "用于列举后的语气填充"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}