                                        "entry_id": "ddb8d56a-d7bb-381d-88fb-43bcc94aa970",
                                        "glosses": [
                                            "Teil des Plattenspielers, dient zum Führen des Tonabnehmers in der Rille einer Schallplatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3255dc-5933-41c2-97a3-d93bf1b8263b",
                                                "sense_id": "8f8ca4ff-3367-33c1-8cfc-0e12f1a5c7bb",
                                                "text": "„Er war nackt, und als er aufstand, um den Tonarm zurückzusetzen und den Song noch einmal zu hören, sah sie auch, wie kräftig er war.“"
                                            },
                                            {
                                                "example_id": "3bdadbff-9599-47e3-9166-c5a0ee584823",
                                                "sense_id": "8f8ca4ff-3367-33c1-8cfc-0e12f1a5c7bb",
                                                "text": "„Der Tonarm des Grammofons wirkte zerbrechlich in seinen kräftigen Händen.“"
                                            },
                                            {
                                                "example_id": "70caa54f-ddb5-4e5b-ae83-9ab973697c42",
                                                "sense_id": "8f8ca4ff-3367-33c1-8cfc-0e12f1a5c7bb",
                                                "text": "„Sie hob den Tonarm und brach die Musik rauh in der Mitte ab.“"
                                            }
                                        ],
