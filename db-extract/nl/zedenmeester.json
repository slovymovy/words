                    {
                        "sense_id": "a8babb4b-9b29-3ecc-a8cc-d84bc7686507",
                        "entry_id": "aa258fa1-a1c0-36cb-9d2c-afa4f7bb8e0e",
                        "glosses": [
                            "iemand die regelmatig/voortdurend zegt wat wel en niet zou mogen op zedelijk gebied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31484e3f-923f-47f2-9d3c-67d7face164f",
                                "sense_id": "a8babb4b-9b29-3ecc-a8cc-d84bc7686507",
                                "text": "Het blad, [de Hollandsche Spectator] en daarmee dus zijn redacteur Justus van Effen, fungeerde als een gezaghebbende zedenmeester, die de principes van de Verlichting (redelijkheid, tolerantie, sociabiliteit) vertaalde naar de burgers toe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14350603-8fed-4f73-82b0-097d1996806b",
                        "source_entry_id": "aa258fa1-a1c0-36cb-9d2c-afa4f7bb8e0e",
                        "source_sense_id": "a8babb4b-9b29-3ecc-a8cc-d84bc7686507",
