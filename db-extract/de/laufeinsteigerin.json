                ],
                "senses": [
                    {
                        "sense_id": "3adf5932-2a3b-3316-8d69-0f418255c959",
                        "entry_id": "f6a9e0c9-f387-35d6-b37d-eec387de47f6",
                        "glosses": [
                            "Frau/Mädchen, die neu beim Laufen ist und wenig bis keine Erfahrung damit hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "ad1c1f1a-2985-4c42-ac42-ba0ad5ce2974",
                                "sense_id": "3adf5932-2a3b-3316-8d69-0f418255c959",
                                "text": "„Mit qualitativ hochwertigen Inhalten, mit verständlichen und einfach umsetzbaren Trainingsplänen und der Motivation durch eine geniale Lauf-Community wirst du als LaufeinsteigerIn [sic] auf deinen ersten Schritten begleitet und zur DranbleiberIn [sic] gemacht.“"
                            },
                            {
                                "example_id": "94bb6ade-2e58-48f4-8662-67262fa1d81e",
                                "sense_id": "3adf5932-2a3b-3316-8d69-0f418255c959",
                                "text": "„Für Laufeinsteigerinnen eignet sich besonders das Fahrtspiel, weil es noch kein allzu striktes Tempotraining darstellt.“"
                            },
                            {
                                "example_id": "3e752008-319e-41bb-b762-a38b4f712ab6",
                                "sense_id": "3adf5932-2a3b-3316-8d69-0f418255c959",
                                "text": "„Vom Laufeinsteiger oder Laufeinsteigerin bis zum erfahrenen Läufer oder Läuferin – definitiv ein Schuh, der das Herz aller Läufer*innen [sic] höher schlagen lässt.“"
                            },
                            {
                                "example_id": "68d073c3-03f6-4cb2-80a3-f2aa8b98bc67",
                                "sense_id": "3adf5932-2a3b-3316-8d69-0f418255c959",
                                "text": "„Aber vor allem motiviere dir bekannte Laufeinsteigerinnen und Laufeinsteiger, dass sie den Genuss der Aktivität in den Vordergrund stellen.“"
                            },
                            {
                                "example_id": "5e2d0fbd-69e4-4af0-9131-f400a87e89dc",
                                "sense_id": "3adf5932-2a3b-3316-8d69-0f418255c959",
                                "text": "„Nico Russ, Gründer und Geschäftsführer des Unternehmens Infinite Running (Infos zum Experten siehe auch Infobox am Ende des Artikels), empfiehlt Laufeinsteigerinnen und Laufeinsteigern zu Beginn einen so genannten Natural Running Schuh oder Schuhe, die nach der Barfußtechnologie konstruiert sind:“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
