                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d5814ef7-3d0b-4a70-b7ec-f0d63ff1b936",
                        "entry_id": "b2913fcd-732b-3516-b2a1-0fcd057fc429",
                        "tags": [
                            "plural"
                        ],
                        "form": "smacks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b52920e-e066-32f5-bd71-ac5fd4ad3231",
                        "entry_id": "b2913fcd-732b-3516-b2a1-0fcd057fc429",
                        "glosses": [
                            "Navire caboteur anglais."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "578e64cb-f42e-472e-a69e-5bba0a60f993",
                                "sense_id": "2b52920e-e066-32f5-bd71-ac5fd4ad3231",
                                "text": "Les bâtimens de deuxième classe, connus sous le nom d'allèges, comprennent les heux, les smacks, les gribanes, les bisquines ou flambardes, etc. : ils appartiennent de plus près à la navigation de la Seine."
                            },
                            {
                                "example_id": "1ef8db5b-8fa3-4ff9-954f-1a207f6389e6",
                                "sense_id": "2b52920e-e066-32f5-bd71-ac5fd4ad3231",
                                "text": "Médaille décernée au sieur B… capitaine du smack anglais Prince-of-Orange, de Colchester."
                            },
                            {
                                "example_id": "30a539be-a061-401f-9acc-8ddf0ab2f96b",
                                "sense_id": "2b52920e-e066-32f5-bd71-ac5fd4ad3231",
                                "text": "Enfin, on a prétendu qu'en 1888, le patron d'un smack de Grimsby serait grimpé au sommet et aurait pris la hauteur totale du rocher avec une ligne de sonde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b4c9523-ab65-4614-8d4d-6cefe8a6f067",
                        "source_entry_id": "b2913fcd-732b-3516-b2a1-0fcd057fc429",
                        "source_sense_id": "2b52920e-e066-32f5-bd71-ac5fd4ad3231",
                        "source_sense_description": "voilier",
                        "target_lang_word": "smack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efbc3de2-6aa3-3873-9768-463a95702a81",
                                        "entry_id": "688226c7-c6c6-3d0f-bd67-04ff0899c0b1",
                                        "glosses": [
                                            "A distinct flavor, especially if slight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "940aae29-53ba-4432-ac39-ede5a1c26b40",
                                                "sense_id": "efbc3de2-6aa3-3873-9768-463a95702a81",
                                                "text": "rice pudding with a smack of cinnamon"
                                            },
                                            {
                                                "example_id": "81df9792-c9b1-4277-be8d-d16065ef0682",
                                                "sense_id": "efbc3de2-6aa3-3873-9768-463a95702a81",
                                                "text": "I did not call him fool, and vex my friend, / But quietly allowed experiment, / Encouraged him to dust his drink, and now / Grate lignum vitæ now bruise so-called grains / Of Paradise, and now, for perfume, pour / Distilment rare, the rose of Jericho, / Holy-thorn, passion-flower, and what know I? / Till beverage obtained the fancied smack."
                                            },
                                            {
                                                "example_id": "3d97a493-1430-4c5c-a1e7-cc75717b8568",
                                                "sense_id": "efbc3de2-6aa3-3873-9768-463a95702a81",
                                                "text": "But take it: if the smack is sour / The better for the embittered hour; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ab1305-e9f1-33f8-acaf-1b7aeb3f71c2",
                                        "entry_id": "688226c7-c6c6-3d0f-bd67-04ff0899c0b1",
                                        "glosses": [
                                            "A slight trace of something; a smattering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c581e9-c237-4262-8cc6-154c3b5140ff",
                                                "sense_id": "82ab1305-e9f1-33f8-acaf-1b7aeb3f71c2",
                                                "text": "He was not sailorly, and yet he had a smack of the sea about him too."
                                            },
                                            {
                                                "example_id": "d8531435-e9d8-4ecd-a00c-f491057f07fd",
                                                "sense_id": "82ab1305-e9f1-33f8-acaf-1b7aeb3f71c2",
                                                "text": "I like my cousins in Holland immensely, but I feel more sib to the Northerners. Your description of Lofoten is fine. I can see them. They must be enchanting in their way, cod's head and tails or no. There is a fine eau de Javelle smack about a Dutch canal, by the way, that takes[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66d9b67-2a90-3685-b686-27610c003614",
                                        "entry_id": "688226c7-c6c6-3d0f-bd67-04ff0899c0b1",
                                        "glosses": [
                                            "Heroin."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bef0dfd6-81f5-4913-aacb-5c5d75415fd7",
                                                "sense_id": "c66d9b67-2a90-3685-b686-27610c003614",
                                                "text": "Claude overdosed on smack in a Chicago flophouse three years later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0692eb8e-c840-36a9-8465-866b6424890a",
                                        "entry_id": "688226c7-c6c6-3d0f-bd67-04ff0899c0b1",
                                        "glosses": [
                                            "A form of fried potato; a scallop."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "smack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbbcdd1-eab2-3de3-ae82-ed05dcbe5f8d",
                                        "entry_id": "5629a66f-2915-37f5-8786-a291cbb47ecd",
                                        "glosses": [
                                            "To get the flavor of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a0703e-28cd-455c-a5f0-029128b36191",
                                                "sense_id": "cbbbcdd1-eab2-3de3-ae82-ed05dcbe5f8d",
                                                "text": "He soon smacked the taste of physic hidden in this sweetness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663c13c1-4657-3025-8cdd-d4df087638fa",
                                        "entry_id": "5629a66f-2915-37f5-8786-a291cbb47ecd",
                                        "glosses": [
                                            "To have a particular taste; used with of."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc5f1707-7f32-48ca-81fb-bcbcc988b410",
                                                "sense_id": "663c13c1-4657-3025-8cdd-d4df087638fa",
                                                "text": "1820-25, Charles Lamb, Essays of Elia\nHe had his tea and hot rolls in a morning, while we were battening upon our quarter-of-a-penny loaf — our crug — moistened with attenuated small beer, in wooden piggings, smacking of the pitched leathern jack it was poured from."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef4b51a-2cb7-3d22-94f5-eee3aa21fe5a",
                                        "entry_id": "5629a66f-2915-37f5-8786-a291cbb47ecd",
                                        "glosses": [
                                            "To indicate or suggest something; used with of."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf6badb-89e2-474f-8730-7e520c153f51",
                                                "sense_id": "fef4b51a-2cb7-3d22-94f5-eee3aa21fe5a",
                                                "text": "Her reckless behavior smacks of pride."
                                            },
                                            {
                                                "example_id": "8dff1e1e-06bd-4b9e-af19-4cf7858f41f8",
                                                "sense_id": "fef4b51a-2cb7-3d22-94f5-eee3aa21fe5a",
                                                "text": "All sects, all ages, smack of this vice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a1ffcd-99e4-3a3a-a5e3-24e2f1563c59",
                                        "entry_id": "40671f26-940f-331f-ae81-8cac6ad6427a",
                                        "glosses": [
                                            "A small sailing vessel, commonly rigged as a sloop, used chiefly in the coasting and fishing trade and often called a fishing smack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb9ead0-1804-418a-bcc4-f3df651ab543",
                                                "sense_id": "d6a1ffcd-99e4-3a3a-a5e3-24e2f1563c59",
                                                "text": "But without Union reinforcement, as many men as could be packed into a mere fishing smack could take the fort, Meigs wrote to Washington."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62755a9d-62f3-3753-823d-b8523035bbbe",
                                        "entry_id": "40671f26-940f-331f-ae81-8cac6ad6427a",
                                        "glosses": [
                                            "A group of jellyfish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "smack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26e4a379-debd-331f-b610-ac09f6578bde",
                                        "entry_id": "8a707092-156f-3f98-927c-60061386271e",
                                        "glosses": [
                                            "A sharp blow; a slap. See also: spank."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd75805a-c638-3596-a986-ff88a9fb23a5",
                                        "entry_id": "8a707092-156f-3f98-927c-60061386271e",
                                        "glosses": [
                                            "The sound of a loud kiss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded3f4dd-c594-49da-89ff-d1afd5bc1bbc",
                                                "sense_id": "fd75805a-c638-3596-a986-ff88a9fb23a5",
                                                "text": "he took the bride about the neck. And kissed her lips with such a clamorous smack."
                                            },
                                            {
                                                "example_id": "58a29b09-8765-4eed-9cf3-fded04fb7f7a",
                                                "sense_id": "fd75805a-c638-3596-a986-ff88a9fb23a5",
                                                "text": "Then he told them of the princess, how she came to him, and how much she had to kiss him to get the whistle, when nobody saw or heard it over in the wood - \"I must get on with these lies if the vat is to be full,\" said Ashiepattle, - so he told them about the queen, how stingy she was with the money and how liberal she was with kisses, that one could hear the smacks all over the wood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57e41cb-99bd-3f61-a8b8-ec033e3cf1a0",
                                        "entry_id": "8a707092-156f-3f98-927c-60061386271e",
                                        "glosses": [
                                            "A quick, sharp noise, as of the lips when suddenly separated, or of a whip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "smack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af3c4ed2-2513-3b69-bfd5-a4db7b7eb564",
                                        "entry_id": "2d76ea63-b9ed-3ec7-b1b7-5a75df085255",
                                        "glosses": [
                                            "To slap or hit someone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3853974-d607-3cae-86e5-fe6018af5c5f",
                                        "entry_id": "2d76ea63-b9ed-3ec7-b1b7-5a75df085255",
                                        "glosses": [
                                            "To make a smacking sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b8ea675-cbe6-4d95-900f-b6b57506c665",
                                                "sense_id": "c3853974-d607-3cae-86e5-fe6018af5c5f",
                                                "text": "A horse neighed, and a whip smacked, there was a whistle, and the sound of a cart wheel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6c487f-ad81-384b-91ed-b5d9268f064d",
                                        "entry_id": "2d76ea63-b9ed-3ec7-b1b7-5a75df085255",
                                        "glosses": [
                                            "To strike a child (usually on the buttocks) as a form of discipline. (normal U.S. and Canadian term spank)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9e5076b-5a49-3eea-af01-be9943c15f27",
                                        "entry_id": "2d76ea63-b9ed-3ec7-b1b7-5a75df085255",
                                        "glosses": [
                                            "To wetly separate the lips, making a noise, after tasting something or in expectation of a treat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b842e0b7-b3a2-4cc8-8ca2-6d64d545d19b",
                                                "sense_id": "b9e5076b-5a49-3eea-af01-be9943c15f27",
                                                "text": "But when, obedient to the mode / Of panegyric, courtly ode / The bard bestrides, his annual hack, / In vain I taste, and sip and smack, / I find no flavour of the Sack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749ed3c6-ff8a-3c88-8fb3-88a2f2260a4e",
                                        "entry_id": "2d76ea63-b9ed-3ec7-b1b7-5a75df085255",
                                        "glosses": [
                                            "To kiss with a close compression of the lips, so as to make a sound when they separate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "smack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7fcb469-877b-3625-a8ff-aeb5cc4a3f95",
                                        "entry_id": "b61803c0-27b8-35c2-83a2-7bccb4948bcf",
                                        "glosses": [
                                            "As if with a smack or slap; smartly; sharply."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b462363-a91a-4741-81d4-64071e7919ee",
                                                "sense_id": "a7fcb469-877b-3625-a8ff-aeb5cc4a3f95",
                                                "text": "Right smack in the middle."
                                            },
                                            {
                                                "example_id": "b4822550-57d3-4436-962b-7ad55c01d3ae",
                                                "sense_id": "a7fcb469-877b-3625-a8ff-aeb5cc4a3f95",
                                                "text": "After one early moment in their courtship, Franny expresses, \"That night I could feel my beauty standing up inside me for the first time in my life.\" These heightened scenes of discovery are offered smack amidst moods of vicious aggression and unresolvable separation, keeping Unusual Company rich with subtle twists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
