                                "target_senses": [
                                    {
                                        "sense_id": "7694ba9b-ea2a-3f16-a10d-f960348d5666",
                                        "entry_id": "129974ea-262c-303f-991e-6aeb904e38eb",
                                        "glosses": [
                                            "Anhängerin des Parsismus, einer auf dem Zoroastrismus basierenden monotheistischen Religion, die vornehmlich von einer ethnischen und religiösen Gemeinschaft in Indien ausgeübt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9caed0c5-ba58-48d5-bb10-2fd7a73f59b2",
                                                "sense_id": "7694ba9b-ea2a-3f16-a10d-f960348d5666",
                                                "text": "Daß ein Europäer eine Inderin heiratete, war sehr selten. Wenn, dann handelte es sich meist um eine Angloinderin, eine indische Christin oder eine Parsin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
