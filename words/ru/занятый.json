{
    "word_family": [
        "занять",
        "занятие",
        "занятость"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4b00444f-44dc-323a-8432-fec423d08f24",
                    "sense_definition": "имеющий много дел, не имеющий свободного времени",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "busy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я сейчас очень <w>занят</w>, позвоните позже.",
                            "target_lang_translations": {
                                "de": "Ich bin gerade sehr <w>beschäftigt</w>, rufen Sie später an."
                            }
                        },
                        {
                            "text": "Он всегда <w>занят</w> важными делами на работе.",
                            "target_lang_translations": {
                                "de": "Er ist immer mit wichtigen Aufgaben bei der Arbeit <w>beschäftigt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "занято́й"
                    ],
                    "common_phrases": [
                        "очень занят"
                    ],
                    "target_lang_definitions": {
                        "de": "jemand, der viel zu tun hat und keine freie Zeit besitzt"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beschäftigt",
                                "target_lang_sense_clarification": "jemand, der durch Arbeit oder Aufgaben zeitlich gebunden ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a65822e3-836f-3370-a9be-61fc80c45184",
                    "sense_definition": "используемый кем-то или чем-то, недоступный для использования",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "occupied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Э́то ме́сто <w>за́нято</w>?",
                            "target_lang_translations": {
                                "de": "Ist dieser Platz <w>besetzt</w>?"
                            }
                        },
                        {
                            "text": "Все столики в кафе были <w>заняты</w> посетителями.",
                            "target_lang_translations": {
                                "de": "Alle Tische im Café waren von Gästen <w>besetzt</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "место занято"
                    ],
                    "target_lang_definitions": {
                        "de": "von jemandem oder etwas in Gebrauch, nicht frei verfügbar"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "besetzt",
                                "target_lang_sense_clarification": "von einer Person benutzt oder belegt, nicht frei"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369720d3-64a1-3cb3-9fa4-f1b8c2d76c1f",
                    "sense_definition": "о телефонной линии, по которой в данный момент разговаривают",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "occupied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я пытался дозвониться, но номер был <w>занят</w>.",
                            "target_lang_translations": {
                                "de": "Ich habe versucht anzurufen, aber die Nummer war <w>besetzt</w>."
                            }
                        },
                        {
                            "text": "Снова слышны короткие гудки, телефон <w>занят</w>.",
                            "target_lang_translations": {
                                "de": "Wieder hört man kurze Signaltöne, das Telefon ist <w>besetzt</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "номер занят"
                    ],
                    "target_lang_definitions": {
                        "de": "eine Telefonleitung, über die gerade gesprochen wird"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "besetzt",
                                "target_lang_sense_clarification": "Telefonleitung, die nicht erreichbar ist, weil sie gerade benutzt wird"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03c9f657-cc66-356f-9691-8a77b8ecf8ad",
                    "sense_definition": "страдательное причастие прошедшего времени от глагола <w>занять</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Деньги, <w>занятые</w> у друга, нужно вернуть вовремя.",
                            "target_lang_translations": {
                                "de": "Geld, das man sich von einem Freund <w>geliehen</w> hat, muss man rechtzeitig zurückgeben."
                            }
                        },
                        {
                            "text": "Место, <w>занятое</w> победителем, было самым почетным.",
                            "target_lang_translations": {
                                "de": "Der Platz, der vom Gewinner <w>besetzt</w> wurde, war der ehrenvollste."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Perfekt des Verbs 'besetzen' oder 'leihen'"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "besetzt",
                                "target_lang_sense_clarification": "Partizip II von besetzen (eingenommen/belegt)"
                            },
                            {
                                "target_lang_word": "geliehen",
                                "target_lang_sense_clarification": "Partizip II von leihen (im Sinne von etwas ausleihen)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}