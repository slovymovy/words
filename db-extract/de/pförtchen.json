                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dae62dca-bd65-4283-a741-da18187df894",
                                "sense_id": "ad6a9b2e-ea36-3ad0-bf44-01e3b5e54c38",
                                "text": "„Dolochow kämpfte beim Durchgangspförtchen neben dem Hoftor, an dem er stehen geblieben war, mit dem Hausknecht, der das Pförtchen hinter Anatol hatte schliessen wollen.“"
                            },
                            {
                                "example_id": "10e17b0e-8004-42f5-a5c9-434a80391c7a",
                                "sense_id": "ad6a9b2e-ea36-3ad0-bf44-01e3b5e54c38",
                                "text": "„Zwei Schutzleute bewachten das schmale Pförtchen, aber sie ließen mich mit dem Hund passieren, als ich des Detektivs Namen nannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
