                "senses": [
                    {
                        "sense_id": "0384e889-c285-3320-b69e-899ec0772dbf",
                        "entry_id": "0971644f-1cb5-3a09-a347-39df094232e6",
                        "glosses": [
                            "obniżenie nastroju"
