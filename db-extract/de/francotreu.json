                    }
                ],
                "senses": [
                    {
                        "sense_id": "02619f8b-2510-3362-89d4-ef3546bea4e6",
                        "entry_id": "4f956cd1-bd34-3790-95ef-6032e249d558",
                        "glosses": [
                            "den Diktator Francisco Franco ^(→ WP) unterstützend, seine Politik befürwortend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f822b6-7c50-4dee-b50d-1ce98c4a4e07",
                                "sense_id": "02619f8b-2510-3362-89d4-ef3546bea4e6",
                                "text": "„Die Zeitgeschichtsschreibung, besonders die des Bürgerkriegs, stammte ausschließlich aus der Feder francotreuer Soldaten, Funktionäre oder Priester.“"
                            },
                            {
                                "example_id": "96f3f730-1701-4135-9f7d-733daf19c63f",
                                "sense_id": "02619f8b-2510-3362-89d4-ef3546bea4e6",
                                "text": "„Im Museum von Guernica hängt der francotreue Heraldo de Aragón vom 30. April 1937 […].“"
                            },
                            {
                                "example_id": "12c54fee-539c-4a2b-a5bb-3faece749859",
                                "sense_id": "02619f8b-2510-3362-89d4-ef3546bea4e6",
                                "text": "„Francotreue spanische Bischöfe wurden vom jungen kubanischen Klerus abgelöst.“"
                            },
                            {
                                "example_id": "f4d43de5-6edd-4131-a713-8303dad7f524",
                                "sense_id": "02619f8b-2510-3362-89d4-ef3546bea4e6",
                                "text": "„Diese Frage übertönt den Abgang eines Mannes, zu dessen großen Verdiensten es gehört, die extreme, francotreue Rechte aus den Parlamenten vertrieben zu haben – und der sich in der Putschnacht des Februar 1981 demonstrativ an die Seite der eingekesselten Parlamentarier stellte.“"
                            },
                            {
                                "example_id": "dd4d6a2d-e5b7-4420-a6a9-12f9bfb9521a",
                                "sense_id": "02619f8b-2510-3362-89d4-ef3546bea4e6",
                                "text": "„Damit fiel dem francotreuen Alifalangisten möglicherweise eine Schlüsselposition im Gerangel um die Macht nach Francos Ende zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
