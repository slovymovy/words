                    {
                        "translation_id": "330d922a-e896-4967-acb2-46cc65025881",
                        "source_entry_id": "ebee938c-0594-321e-a03e-289465dd60a2",
                        "source_sense_description": "a man who labours for wages",
                        "target_lang_word": "werkmens",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "werkmens",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6d292f4d-fbfc-3d9c-b9c1-477101b02cd9",
                                        "entry_id": "0a0f632a-f64e-38dd-b3b4-6723ef7513b8",
                                        "glosses": [
                                            "iemand die zijn (lage) inkomen krijgt door het verrichten van betaalde arbeid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f7b1bc1-ae13-4955-a446-2831daf4c196",
                                                "sense_id": "6d292f4d-fbfc-3d9c-b9c1-477101b02cd9",
                                                "text": "De vakbonden vrezen dat in de nieuwe structuur veel personeelsleden zullen worden geherlokaliseerd, waardoor ze grotere verplaatsingen moeten maken naar hun werk en hekelen de ‘structurele afbouw van tewerkstelling bij de “werkmens onderaan de ladder”’. Ook heerst er onduidelijkheid over werknemers met een job die in het nieuwe systeem verdwijnt of een andere focus krijgt."
                                            },
                                            {
                                                "example_id": "93b0b254-d9df-44f6-bc64-d6b388ddee3e",
                                                "sense_id": "6d292f4d-fbfc-3d9c-b9c1-477101b02cd9",
                                                "text": "De elite keek neer op de arbeidersklasse, zeker, maar tegelijkertijd begon er, ook onder druk van de socialisten, een besef te ontstaan dat je de werkmens, de gewone man, moet beschermen, rechten moet geven, en dat je zorgen die je over hem hebt moet vertalen in politiek en cultureel beleid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a0d83f-8edf-327e-8be5-32c424d25cfd",
                                        "entry_id": "0a0f632a-f64e-38dd-b3b4-6723ef7513b8",
                                        "glosses": [
                                            "een noeste werker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70112b00-8460-424a-a586-095e6cb00dbc",
                                                "sense_id": "05a0d83f-8edf-327e-8be5-32c424d25cfd",
                                                "text": "Nee, O’Hanlon heeft geen voorliefde voor fatale ondernemingen. Hij legde in zijn tv-serie bijvoorbeeld veel genegenheid aan de dag voor natuuronderzoeker en ‘werkmens’ Alfred Russel Wallace, die ook naar de Amazone trok, maar schipbreuken en malaria overleefde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06afa4c1-a044-419b-8cac-e8f484e45384",
                        "source_entry_id": "ebee938c-0594-321e-a03e-289465dd60a2",
                        "source_sense_description": "a man who labours for wages",
                        "target_lang_word": "ouvrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouvrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64fee2ff-bb91-3738-b6ba-1621146d5164",
                                        "entry_id": "918c43f8-7b39-3d56-8cf0-aa3f8a49aff5",
                                        "glosses": [
                                            "Qui travaille, œuvrant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372cba1c-fd95-4eb7-bf9f-f9c1620ff95b",
                                                "sense_id": "64fee2ff-bb91-3738-b6ba-1621146d5164",
                                                "text": "Les abeilles ouvrières, abeilles qui forment la plus grande partie de la ruche et y font tout l’ouvrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a026f7d5-5a31-335f-82f9-ae06b93a7509",
                                        "entry_id": "918c43f8-7b39-3d56-8cf0-aa3f8a49aff5",
                                        "glosses": [
                                            "Relatif aux travailleurs. Par définition, cette notion fait référence au statut du salariat et à l’exercice d’un travail manuel (ce qui exclut les employés de bureau)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8d702f-740c-465f-953b-07922e9e6112",
                                                "sense_id": "a026f7d5-5a31-335f-82f9-ae06b93a7509",
                                                "text": "— Je ne suis pas un gars de ville… Une ribote ne me met pas au lit, pas plus qu’elle ne change mes jours ouvriers…"
                                            },
                                            {
                                                "example_id": "5da0d01f-35b8-42a4-a4c3-2383068f0b77",
                                                "sense_id": "a026f7d5-5a31-335f-82f9-ae06b93a7509",
                                                "text": "Il semble que la tradition politique de la classe ouvrière européenne soit encore vivace dans certains pays, alors qu'elle est étouffée en Amérique, où pourtant aussi elle a existé."
                                            },
                                            {
                                                "example_id": "de1aac08-baae-4e09-8dbc-b1c9abe9ac8a",
                                                "sense_id": "a026f7d5-5a31-335f-82f9-ae06b93a7509",
                                                "text": "Population dégourdie, « dessalée » et qui, au point de vue des mœurs, diffère très peu des autres agglomérations ouvrières françaises."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ouvrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                        "entry_id": "34b694e1-53d0-3579-ab0d-be4aa2faa2db",
                                        "glosses": [
                                            "Personne qui, moyennant salaire, effectue un travail généralement manuel pour un employeur dans les domaines du bâtiment, de l’industrie ou de l’agriculture."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e147799d-1db0-41f3-bb26-4b543e15e93f",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "Soyez sûr, a dit un jour M. Brieux, que l'ouvrier parisien est inconnu..., ou du moins mal connu. Les bourgeois l’envisagent d’après les faits-divers et la \"Gazette des Tribunaux\", ou à travers une certaine littérature qui le calomnie. On admet communément que c’est une gouape ; qu’il est ivrogne, vicieux, dépourvu de moralité. Or, rien n’est moins véritable."
                                            },
                                            {
                                                "example_id": "855a4fe9-20a4-427e-97d1-00fb88f39d80",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "[…] car l'ouvrier n’achète pas pour sa subsistance des productions de haut prix & ne contribue donc pas, ainsi que fait le propriétaire, à entretenir la valeur & les revenus des bonnes terres qui ont la propriété de produire des denrées précieuses."
                                            },
                                            {
                                                "example_id": "6c3e0d14-913a-4d95-9f4b-35c964bfca24",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "Le compositeur particulièrement désigné comme homme de conscience doit être excellent ouvrier, minutieux, et d'une conduite régulière."
                                            },
                                            {
                                                "example_id": "b1d37d79-cc7e-48dd-b117-e10144be018b",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "Les ouvriers occupés à la fouille et à l’extraction des coquins bruts, travaillent à la tâche ; on les paye à raison de 33 centimes le mètre cube de minerai extrait. Les bons ouvriers gagnent 3 fr 50 par jour."
                                            },
                                            {
                                                "example_id": "e25ee885-646b-4ec1-9740-e61131d0a862",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "Si les ouvriers agricoles de l’Hérault avaient la sagesse de s’astreindre à la parcimonie des gens de l’Ariège ou de la Lozère, je ne doute pas qu’ils se trouveraient très heureux."
                                            },
                                            {
                                                "example_id": "ee5d9791-8156-41d6-b855-f38ddf0204d8",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "Pour tous les ouvriers et toutes les ouvrières du textile la condition empirait avec la hausse des prix."
                                            },
                                            {
                                                "example_id": "ef6bed5f-5e5e-433e-81f0-7eb8a8982763",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "Les inégalités ont par exemple augmenté chez les jeunes et chez les ouvrières."
                                            },
                                            {
                                                "example_id": "26b0da87-d8f1-4311-b778-1174a1168253",
                                                "sense_id": "cff7be2f-efe8-3caa-bb6c-a0347f2a5f91",
                                                "text": "[…] deux ouvriers recouvrent les poissons d’une pelletée de sel avant de les précipiter dans une fosse de conservation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2a0edf6-3d05-38fc-ae0a-e3491e45af52",
                                        "entry_id": "34b694e1-53d0-3579-ab0d-be4aa2faa2db",
                                        "glosses": [
                                            "Celui qui œuvre à une chose ; auteur ; artisan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8338fec0-b601-47d7-8345-e5cbd9a8188a",
                                                "sense_id": "a2a0edf6-3d05-38fc-ae0a-e3491e45af52",
                                                "text": "[…]; ces machinations avaient eu pour principal ouvrier un juge d’instruction, nommé Bertulus, dont le souvenir ne fait guère honneur à la magistrature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "807f6aee-fd1c-4356-b523-a101eac8a9cf",
                        "source_entry_id": "ebee938c-0594-321e-a03e-289465dd60a2",
                        "source_sense_description": "a man who labours for wages",
                        "target_lang_word": "Arbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c74f296f-23e8-3a37-95bf-4d2ab3143a1e",
                                        "entry_id": "8534b020-ffe9-31a6-b6ea-63794d1de069",
                                        "glosses": [
                                            "jemand, der zum Lohnerwerb standesgemäß einer (meist körperlichen) Tätigkeit nachgeht, zur Arbeiterklasse zählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc8fe1f-ea66-4fe6-ad53-d3f5690baa95",
                                                "sense_id": "c74f296f-23e8-3a37-95bf-4d2ab3143a1e",
                                                "text": "Der Arbeiter näht Hemden."
                                            },
                                            {
                                                "example_id": "2483c634-1cb0-4cb2-b587-c754ae797afa",
                                                "sense_id": "c74f296f-23e8-3a37-95bf-4d2ab3143a1e",
                                                "text": "Die Arbeiter organisierten sich in einer Gewerkschaft."
                                            },
                                            {
                                                "example_id": "1cb634ed-e71c-4aac-b7f4-70f7e00daa3f",
                                                "sense_id": "c74f296f-23e8-3a37-95bf-4d2ab3143a1e",
                                                "text": "„In Wöbbesse lebte ein Arbeiter Kiel, der als Freischütz bekannt war.“"
                                            },
                                            {
                                                "example_id": "abacd4e3-c5c2-473a-83ec-12ae11f5b8e2",
                                                "sense_id": "c74f296f-23e8-3a37-95bf-4d2ab3143a1e",
                                                "text": "„Schließlich hatte er gegen den brummenden Generator angeschrien, in der Hoffnung, dass irgendein Arbeiter der Lederfabrik ihn hörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "880755f4-e475-3729-a3fb-fcb213d2e7b0",
                                        "entry_id": "8534b020-ffe9-31a6-b6ea-63794d1de069",
                                        "glosses": [
                                            "jemand, der auf bestimmte Art arbeitet, jedoch nicht zur Arbeiterklasse wie unter ^([1]) zählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97787afb-5a0e-472f-944a-b3b2a1c83582",
                                                "sense_id": "880755f4-e475-3729-a3fb-fcb213d2e7b0",
                                                "text": "Er ist ein unermüdlicher Arbeiter und gibt sich nicht mit oberflächlichen Recherchen zufrieden."
                                            },
                                            {
                                                "example_id": "07e3487c-8041-4688-9e96-bc6b4e1cbafe",
                                                "sense_id": "880755f4-e475-3729-a3fb-fcb213d2e7b0",
                                                "text": "Der Diplomat war ein sehr gewissenhafter Arbeiter und widmete sich vor allem den schwierigen Aufgaben mit Hingabe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Arbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                        "entry_id": "676efaea-018d-30df-bd51-88826137d1ed",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18946d49-700d-4f09-986f-c615a470bc37",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "Frau Arbeiter ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "497faaed-32d9-4d50-863b-960e9f7c2436",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "Herr Arbeiter wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a62000b2-31ee-4b82-92de-c44f564f742d",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "Die Arbeiters kommen heute aus Basel."
                                            },
                                            {
                                                "example_id": "470f9f95-497c-4123-8cb1-9e20d746f313",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "Der Arbeiter trägt nie die Schals, die die Arbeiter ihm strickt."
                                            },
                                            {
                                                "example_id": "1f15d3e0-061e-4bf5-a71b-799e6ba64606",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Arbeiter kommt, geht der Herr Arbeiter.“"
                                            },
                                            {
                                                "example_id": "d7adb548-0c9d-415b-a75e-df07eb9d6512",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "Arbeiter kommt und geht."
                                            },
                                            {
                                                "example_id": "bf17f53d-e188-43de-bce0-e98233d3b725",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "Arbeiters kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "b69db02d-2315-49e8-9385-b45ad632ff69",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "An verregneten Herbsttagen ist Familie Arbeiters liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "3ea73bd1-ed51-4e1c-90c2-2a20367ec2fd",
                                                "sense_id": "cfe1d0a8-cb86-3b4a-b1a0-0aa61befbbb4",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Arbeiter das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
