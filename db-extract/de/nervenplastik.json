                "senses": [
                    {
                        "sense_id": "214aa19f-49ee-33e0-bfff-b02e64b1324b",
                        "entry_id": "7eaaa118-0e70-3202-8fb6-3dedd68f78a6",
                        "glosses": [
                            "operative Wiederherstellung und Wiederbelebung verloren gegangener Nerventeile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9956d412-e0b1-4b8d-8dc8-baefe545e9fb",
                                "sense_id": "214aa19f-49ee-33e0-bfff-b02e64b1324b",
                                "text": "„Was soll im einzelnen bedacht werden, um die beabsichtigte Nervenplastik zu einem möglichst guten Ergebnis zu führen? Zunächst zur Wahl des Spendernerven: […]“"
                            },
                            {
                                "example_id": "431f8175-3e7e-4207-a8dd-95d8c9b24654",
                                "sense_id": "214aa19f-49ee-33e0-bfff-b02e64b1324b",
                                "text": "„[…] In diesen Fällen ist deshalb oft eine Nervenplastik erforderlich.“"
                            },
                            {
                                "example_id": "a841538a-2102-497e-ae42-2fe4d0b3fb2f",
                                "sense_id": "214aa19f-49ee-33e0-bfff-b02e64b1324b",
                                "text": "„Während erstere in der Regel nur durch eine chirurgische Exploration und Nervennaht bzw. Nervenplastik behandelt werden kann, kann im zweiten Falle ein konservatives Vorgehen gerechtfertigt sein.“"
                            }
                        ],
