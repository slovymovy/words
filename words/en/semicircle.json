                    "frequency": "Low",
                    "semantic_group_id": "sports markings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All players except the kicker must remain outside the <w>semicircle</w> during a penalty kick."
                        },
                        {
                            "text": "The referee instructed the defenders to back away from the edge of the <w>semicircle</w>."
                        }
                    ],
                    "synonyms": [
                        "penalty arc",
                        "the D"
                    ]
                },
                {
                    "sense_id": "79af621d-a8c5-3068-ac5d-4e007efd0667",
                    "sense_definition": "A surveying instrument used for measuring angles; a graphometer.",
