                ],
                "senses": [
                    {
                        "sense_id": "46ad841a-845b-3f75-8c92-a40c3cc96cff",
                        "entry_id": "fd22ec7a-eb8c-35e1-ab22-acae72391022",
                        "glosses": [
                            "свидетельствующий об отсутствии патриотизма, не проникнутый духом патриотизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ade1628-3a55-4332-ac51-a1fdd20a89c6",
                                "sense_id": "46ad841a-845b-3f75-8c92-a40c3cc96cff",
                                "text": "Но в провластных телеграм-каналах «непатриотичное» интервью Пескова незамеченным не прошло."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ed342eb-673b-42fd-b18c-710705286707",
                        "source_entry_id": "fd22ec7a-eb8c-35e1-ab22-acae72391022",
                        "source_sense_id": "46ad841a-845b-3f75-8c92-a40c3cc96cff",
                        "target_lang_word": "unpatriotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unpatriotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c998e2f0-385b-3cf9-bfe3-4f318f418cbc",
                                        "entry_id": "538e0f9c-5d42-3f5f-b2a8-df178c8155cc",
                                        "glosses": [
                                            "Not patriotic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0837e9-2ad3-4cd9-a400-3a358a7dd486",
                                                "sense_id": "c998e2f0-385b-3cf9-bfe3-4f318f418cbc",
                                                "text": "What is a Christian's duty, when his country is bled and plundered and ground down to the dust under the iron heel of military despotism, when the political fabric of his native land is crumbling, and his countrymen are listless, selfish, sensual, unpatriotic, not unhappy so long as their bellies are filled and their backs covered?"
                                            },
                                            {
                                                "example_id": "e32879fe-c317-496f-819c-c6a370fb7e63",
                                                "sense_id": "c998e2f0-385b-3cf9-bfe3-4f318f418cbc",
                                                "text": "Millions of citizens are deeply disturbed that the military-industrial complex too often shapes national policy, but they do not want to be considered unpatriotic. Countless loyal Americans honestly feel that a world body such as the United Nations should include even Red China, but they fear being called Communist sympathizers."
                                            },
                                            {
                                                "example_id": "8c690266-dda3-4d7e-8453-7bb65c51e71e",
                                                "sense_id": "c998e2f0-385b-3cf9-bfe3-4f318f418cbc",
                                                "text": "Nigeria’s media regulator has directed all TV and radio stations to delete their Twitter accounts and described its use as unpatriotic[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
