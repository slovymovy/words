                ],
                "senses": [
                    {
                        "sense_id": "57a52878-7299-34e6-8be2-3c1849f95fd4",
                        "entry_id": "2f1bbc18-d36d-32ff-8476-2868e37cba8b",
                        "glosses": [
                            "не отличающийся интересом к чему-либо, лишённый любопытства, внимания, интереса"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "743a3ffe-d0f2-3711-b97f-0f0772abe890",
                        "entry_id": "2f1bbc18-d36d-32ff-8476-2868e37cba8b",
                        "glosses": [
                            "не преследующий выгоды, пользы, не имеющий корыстного интереса"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9afdaef8-6107-4670-95d5-b506c5ef79cd",
                        "source_entry_id": "2f1bbc18-d36d-32ff-8476-2868e37cba8b",
                        "source_sense_description": "не отличающийся интересом к чему-либо, заинтересованностью в чём-либо, лишённый любопытства, внимания, интереса",
                        "target_lang_word": "disinterested",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disinterested",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7354c94-8071-39a7-b790-f95a3d2b3da3",
                                        "entry_id": "53314e5b-8014-3403-8318-26badc20f9c3",
                                        "glosses": [
                                            "Having no stake or interest in the outcome, and no conflicts of interest; free of bias, impartial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f0ee8c-7ca8-4aae-bf39-2c226ddf0c9f",
                                                "sense_id": "b7354c94-8071-39a7-b790-f95a3d2b3da3",
                                                "text": "Sir, you have a right to that kind of respect, and are arguing for yourself. I am supporting the principle, and am disinterested in doing it, as I have no such right."
                                            },
                                            {
                                                "example_id": "a293806a-d196-4124-9fdb-a5b759d47372",
                                                "sense_id": "b7354c94-8071-39a7-b790-f95a3d2b3da3",
                                                "text": "With his disinterested passion for art, he had a real desire to call the attention of the wise to a talent which was in the highest degree original; [...]"
                                            },
                                            {
                                                "example_id": "5e023f35-95d3-487b-a058-a9a207103ee3",
                                                "sense_id": "b7354c94-8071-39a7-b790-f95a3d2b3da3",
                                                "text": "People are better off abjuring violence, if everyone else agrees to do so, and vesting authority in a disinterested third party."
                                            },
                                            {
                                                "example_id": "5afb90c6-b99f-4685-8684-bf6d62a15bd7",
                                                "sense_id": "b7354c94-8071-39a7-b790-f95a3d2b3da3",
                                                "text": "[P]hilosophers of the time [early 20th century] were primarily concerned with epistemology and the foundations of the sciences; they often spoke as if we were separated from the real world by a screen of \"representations\" or \"sense-data\"; they tended to regard our approach to the world as one of disinterested observation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea992807-f847-3aef-8777-437d51b381b7",
                                        "entry_id": "53314e5b-8014-3403-8318-26badc20f9c3",
                                        "glosses": [
                                            "Uninterested, lacking interest."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc12db0b-ae39-4818-9c01-e9fae0ba5280",
                                                "sense_id": "ea992807-f847-3aef-8777-437d51b381b7",
                                                "text": "How dis-interested are they in all Worldly matters, since they fling their Wealth and Riches into the Sea."
                                            },
                                            {
                                                "example_id": "3e1e3fdd-1f0f-4d20-b1b5-7adebb99a9e4",
                                                "sense_id": "ea992807-f847-3aef-8777-437d51b381b7",
                                                "text": "Robin took to wandering again, to intermittent travel from which she came back hours, days later, disinterested."
                                            },
                                            {
                                                "example_id": "8768d8c5-124e-4eaf-87ed-c3e91c3b0bbc",
                                                "sense_id": "ea992807-f847-3aef-8777-437d51b381b7",
                                                "text": "Those spotted are usually taught so slowly that they grow disinterested and quit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7d543cd-3b1a-450b-827e-89b1dd624368",
                        "source_entry_id": "2f1bbc18-d36d-32ff-8476-2868e37cba8b",
                        "source_sense_description": "не отличающийся интересом к чему-либо, заинтересованностью в чём-либо, лишённый любопытства, внимания, интереса",
                        "target_lang_word": "uninterested",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uninterested",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "928e25ec-f162-358e-bb8a-275303a0e0e9",
                                        "entry_id": "096b59a1-3eb1-3379-bb49-bae1d6c576c0",
                                        "glosses": [
                                            "Not interested; indifferent, not concerned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3165d4e4-143f-44d6-9d1a-70beb2455e2b",
                                                "sense_id": "928e25ec-f162-358e-bb8a-275303a0e0e9",
                                                "text": "I was uninterested in the TV program, so I read a book instead."
                                            },
                                            {
                                                "example_id": "8bfa61cc-c9bf-421b-8584-b0a66ac2273e",
                                                "sense_id": "928e25ec-f162-358e-bb8a-275303a0e0e9",
                                                "text": "Once the government had changed and we got a prime minister uninterested in - even hostile to - railways, the transition team was working in an atmosphere of uncertainty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6e203c3-dd98-3989-84c5-0bdc257be687",
                                        "entry_id": "096b59a1-3eb1-3379-bb49-bae1d6c576c0",
                                        "glosses": [
                                            "Unmotivated by personal interest; unbiased, disinterested."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d78ae5b-8dfb-4e2b-9777-44457cf5be18",
                                                "sense_id": "e6e203c3-dd98-3989-84c5-0bdc257be687",
                                                "text": "The judge was uninterested in the case."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
