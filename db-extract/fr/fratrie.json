                "senses": [
                    {
                        "sense_id": "a5cee333-eaf6-32c2-a050-829215519d68",
                        "entry_id": "773f39e9-6e44-3e88-840c-b65d37a1ffe4",
                        "glosses": [
                            "Division de la tribu à Athènes."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d3adc9ef-3810-399d-bc5c-cc54090ad11b",
                        "entry_id": "773f39e9-6e44-3e88-840c-b65d37a1ffe4",
                        "glosses": [
                            "Ensemble composé des enfants (frères et sœurs) d’une même famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1be9a22e-277c-4028-8653-2765be1fb97e",
                                "sense_id": "d3adc9ef-3810-399d-bc5c-cc54090ad11b",
                                "text": "Dans un bruit de fanfare, la fratrie quittait l’appartement de la rue de Maubeuge, descendait les cinq étages, traversait la rue Lamartine puis la rue de Rochechouart, avant d’entrer dans le square, triomphante et remarquable, car nul ne pouvait ignorer ces enfants que seulement quelques mois séparaient les uns des autres, leur blondeur qui confinait au blanc, leurs yeux clairs et leurs jeux bruyants."
                            },
                            {
                                "example_id": "6034458f-3b68-4c84-ac0f-ea282ba1b75e",
                                "sense_id": "d3adc9ef-3810-399d-bc5c-cc54090ad11b",
                                "text": "L’écolier, benjamin d’une fratrie de cinq enfants, a tenu à respecter la tradition sud-africaine et a insisté pour qu’une deuxième cérémonie officialise ce mariage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec8033d5-1e62-416c-b41b-bcd89ad7fd8e",
                        "source_entry_id": "773f39e9-6e44-3e88-840c-b65d37a1ffe4",
                        "target_lang_word": "Geschwister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschwister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "595aef70-5a51-3d7f-a6a7-fc4d5dbc8c96",
                                        "entry_id": "b94c13b0-78a1-34bf-be2c-77c7f90132fb",
                                        "glosses": [
                                            "Gesamtheit der Schwestern"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f219052-217a-3cc3-97df-a59a307d51c2",
                                        "entry_id": "b94c13b0-78a1-34bf-be2c-77c7f90132fb",
                                        "glosses": [
                                            "die Gesamtheit der Brüder und Schwestern einer Generation, Kinder derselben Eltern"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f234502-f181-4586-b1e8-b6aa0f521cb7",
                                                "sense_id": "7f219052-217a-3cc3-97df-a59a307d51c2",
                                                "text": "Meine Geschwister sind in alle Welt verstreut."
                                            },
                                            {
                                                "example_id": "d2fa0f92-fd17-43bf-903a-4b21867661b1",
                                                "sense_id": "7f219052-217a-3cc3-97df-a59a307d51c2",
                                                "text": "„Lenas ältere Geschwister verinnerlichten den auf Sicherheit und Solidität beruhenden familiären Lebensentwurf.“"
                                            },
                                            {
                                                "example_id": "3e182f8a-fb09-436f-920e-3ac92067cba9",
                                                "sense_id": "7f219052-217a-3cc3-97df-a59a307d51c2",
                                                "text": "„Auch den anderen Geschwistern gelang es nicht zusammenzubleiben.“"
                                            },
                                            {
                                                "example_id": "3fafc41a-65a1-4c58-a9ef-99d15b52b233",
                                                "sense_id": "7f219052-217a-3cc3-97df-a59a307d51c2",
                                                "text": "„Mit ihrer Haltung und ihrem Vertrauen in ihre Kinder haben meine Eltern meinen Geschwistern und mir ein Leben mit geradem Rücken geschenkt.“"
                                            },
                                            {
                                                "example_id": "5c72cde0-51d1-4492-b362-cdc1c3e4c2bc",
                                                "sense_id": "7f219052-217a-3cc3-97df-a59a307d51c2",
                                                "text": "„Die Geschwister des Junkers Magnús erlagen in jungen Jahren der Lungenschwindsucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f805b758-19b8-3e1c-9fdc-7020f2d9e808",
                                        "entry_id": "b94c13b0-78a1-34bf-be2c-77c7f90132fb",
                                        "glosses": [
                                            "eines der Geschwister [2]"
                                        ],
                                        "tags": [
                                            "jargon",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f39f8f8-e49f-43de-9353-13091c63b91d",
                                                "sense_id": "f805b758-19b8-3e1c-9fdc-7020f2d9e808",
                                                "text": "Familien mit einem behinderten Kind sind stark belastet, vor allem dann, wenn noch ein Geschwister ohne Behinderung da ist."
                                            },
                                            {
                                                "example_id": "638fb937-bb8e-4091-b115-bc6fc1497cd9",
                                                "sense_id": "f805b758-19b8-3e1c-9fdc-7020f2d9e808",
                                                "text": "„Ich bin ein Zwilling, zweitgeboren wie Jakob, aber genauer gesagt zweitgeboren nur als Zwilling: Denn bei meiner Geburt wartete auch schon ein knapp zweijähriger Bruder auf ein Geschwister.“"
                                            },
                                            {
                                                "example_id": "a2155778-d3a9-4a4a-84e0-177ff21a80f9",
                                                "sense_id": "f805b758-19b8-3e1c-9fdc-7020f2d9e808",
                                                "text": "„Was entsteht also daraus, wenn ein Geschwister dem andern nicht nachgeben will, wenn eines dem andern widerspricht, und eines alles besser wissen will, als das andere?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
