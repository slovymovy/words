        "fr-extract.jsonl": [
            {
                "entry_id": "8f1d9327-b7ad-3acd-b9ba-da697078c447",
                "word": "tracé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0603d3a2-7217-4686-bee7-6892bb6d7d17",
                        "entry_id": "8f1d9327-b7ad-3acd-b9ba-da697078c447",
                        "tags": [
                            "plural"
                        ],
                        "form": "tracés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dedea07-1f64-3500-a3ba-0475fe036e1c",
                        "entry_id": "8f1d9327-b7ad-3acd-b9ba-da697078c447",
                        "glosses": [
                            "Ensemble des lignes par lesquelles on indique un dessin, un plan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc240f8-afbc-4156-a916-c1eb7f618d87",
                                "sense_id": "9dedea07-1f64-3500-a3ba-0475fe036e1c",
                                "text": "Les outils de tracé et de contrôle sont l’équerre, la règle, la fausse équerre dite sauterelle, le biveau, le panneau ou gabarit, le compas, le fil à plomb et le niveau. Ces outils se retrouvent dessinés ou gravés sur de nombreux documents ou monumets de l'Antiquité à nos jours."
                            },
                            {
                                "example_id": "c9e7fdda-7160-4717-9dc3-de1b0a9617f2",
                                "sense_id": "9dedea07-1f64-3500-a3ba-0475fe036e1c",
                                "text": "Il paraît, nous a-t-on dit un jour, qu'il existe à Châteauneuf-le-Rouge un labyrinthe de buis si vaste que le jardinier a besoin de l'année entière pour le tailler : il commence à un bout, et, lorsqu'il arrive à la fin du tracé, recommence un nouveau circuit et une nouvelle année."
                            },
                            {
                                "example_id": "4321f5b7-770a-4918-997c-682fdd92ca52",
                                "sense_id": "9dedea07-1f64-3500-a3ba-0475fe036e1c",
                                "text": "(Lors d'une course de moto) Le tracé forme une boucle jusqu'à la bouée. C'est la seule règle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4e5a3ed-b093-3eac-bcf6-b5286d0e5696",
                        "entry_id": "8f1d9327-b7ad-3acd-b9ba-da697078c447",
                        "glosses": [
                            "Ligne que suit une voie de communication, un ouvrage de fortification, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44718017-700a-404e-86b3-d2b8dd128aeb",
                                "sense_id": "d4e5a3ed-b093-3eac-bcf6-b5286d0e5696",
                                "text": "Le tracé des égouts répercute, pour ainsi dire, le tracé des rues qui lui est superposé."
                            },
                            {
                                "example_id": "5315f805-06c3-4b0a-897e-511752529e1a",
                                "sense_id": "d4e5a3ed-b093-3eac-bcf6-b5286d0e5696",
                                "text": "Je jette un coup d’œil par le hublot. Peu à peu, la piste disparaît et se met à ressembler à un fil au-dessous de nous. Plus loin, le tracé du Nil coupe le désert en deux, et va se dispersant dans la mer avec une couleur merdâtre."
                            },
                            {
                                "example_id": "3f7fca4f-7ca9-48e3-a297-d08a7f4e5ce8",
                                "sense_id": "d4e5a3ed-b093-3eac-bcf6-b5286d0e5696",
                                "text": "Il avait trouvé sur une carte un ancien tracé de chemins qui reliait les bassins miniers de l’Oural aux basses terres de Sibérie occidentale et au fleuve Ienisseï, à travers les steppes du Kirghizistan."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "21f8ebb3-4770-3188-a3e1-c0e7468329d4",
                "word": "tracé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a2e2abb-6ad5-3dba-8fbd-386059592913",
                        "entry_id": "21f8ebb3-4770-3188-a3e1-c0e7468329d4",
                        "glosses": [
                            "Participe passé masculin singulier de tracer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "cd50f728-ef02-44a2-bbfd-fdfddb19f664",
                                "sense_id": "8a2e2abb-6ad5-3dba-8fbd-386059592913",
                                "text": "En 1897, à l’occasion de ses vingt-cinq ans d’existence, il a tracé « la traversée du massif des Vosges », un itinéraire de 430 km, de Wissembourg à Fesches-le-Châtel, qui sera labellisé GR^©5 dès 1947."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
