                        "glosses": [
                            "materiaal dat ontstaat en overblijft bij een activiteit die op een ander doel gericht is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffb3076e-3745-4f19-9504-b873d57cc9c5",
                                "sense_id": "9b2c24e3-c6e4-34ac-a871-c90109cb399d",
                                "text": "Granuliet is een afvalproduct dat overblijft na bewerking van graniet en zandsteen. Het wordt onder meer gebruikt bij de aanleg van asfalt en het minder diep maken van plassen."
                            },
                            {
                                "example_id": "4b334302-e7ea-4c39-b4f3-b696168f620c",
                                "sense_id": "9b2c24e3-c6e4-34ac-a871-c90109cb399d",
                                "text": "Wie graag geitenkaas eet, moet af en toe een bokje eten. Want om melk te geven moeten geiten lammeren. En bokjes zijn in onze moderne vee-industrie een afvalproduct."
                            },
                            {
                                "example_id": "e2f0813c-1b40-4525-9897-a29e2d636f51",
                                "sense_id": "9b2c24e3-c6e4-34ac-a871-c90109cb399d",
                                "text": "De hersenen produceren in de loop van de dag adenosine, een afvalproduct van je werkende brein."
                            }
                        ]
                    }
