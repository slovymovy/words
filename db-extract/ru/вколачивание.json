                    {
                        "translation_id": "f12e0f9b-3ceb-4289-89cf-255454c82680",
                        "source_entry_id": "64ea70e0-fe11-3df6-8ace-9d07b2a02158",
                        "source_sense_id": "5504cf4c-67d3-3824-a906-93e39a3f4434",
                        "target_lang_word": "Einschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "das Eintreffen eines Blitzes, Geschosses oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "093cca9a-0ec2-47f1-923d-f05522c4d859",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "Der Einschlag des Blitzes hinterließ ein gewaltiges Loch."
                                            },
                                            {
                                                "example_id": "9205da99-f6ed-4f94-8f8b-1aaa72b9911a",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "„Auf 700.000 Jahre nach dem Einschlag datieren die ältesten Belege für die nährstoffreiche Pflanzenfamilie der Hülsenfrüchtler.“"
                                            },
                                            {
                                                "example_id": "4a20f8ae-865f-4548-ba04-3f14455290fc",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "„Mein Vater hatte uns, schon bevor er 1941 zur Wehrmacht eingezogen wurde, mehrfach erklärt, dass die runde Form sicherer vor Einschlägen sei als ein eckiger Bau.“"
                                            },
                                            {
                                                "example_id": "ee820ec0-4cf9-45d6-86e4-712161f20ba4",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "„Ich aber, ganz elend von dem Transitgeflüster, ich staunte sehr, wenn ich derer gedachte, die in den Flammen der Bombardements und in den rasenden Einschlägen des Blitzkrieges zugrunde gegangen waren, zu Tausenden, zu Hunderttausenden, und viele waren daselbst auch zur Welt gekommen, ganz ohne Kenntnis der Konsuln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cc4e816-46e5-3bb2-8b51-a5185e28b1e4",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Spur, die ein Schlag hinterlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9f05688-089c-4b17-9207-1d18a82ea9c1",
                                                "sense_id": "5cc4e816-46e5-3bb2-8b51-a5185e28b1e4",
                                                "text": "Den Einschlag der Granate sah man auch nach Jahren noch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "afa02551-4055-32b7-b01c-42056c7f270d",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Beimischung völkischer Eigenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120a51db-72b3-4b41-a6f8-e15b1bfe747a",
                                                "sense_id": "afa02551-4055-32b7-b01c-42056c7f270d",
                                                "text": "Der Einschlag des Mongolischen war in den Gesichtern leicht zu erkennen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b1c121c1-43c4-3bf9-a119-e8318533cafd",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "planmäßige Baumfällung"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd24dc8e-614c-45b4-b17a-65361dc89473",
                                                "sense_id": "b1c121c1-43c4-3bf9-a119-e8318533cafd",
                                                "text": "Der Einschlag betraf vor allem windgeschädigte Bäume."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1e94aad5-91a3-3c81-a61e-3db6c28d3470",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Lenkung der Räder, Drehung am Lenkrad"
                                        ],
                                        "tags": [
                                            "Fahrzeug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095ff33a-6ff3-4ec0-81ee-dc32ccf3cf1c",
                                                "sense_id": "1e94aad5-91a3-3c81-a61e-3db6c28d3470",
                                                "text": "Der Einschlag der Räder war durch die Lenkradsperre begrenzt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7a3d5e47-297c-3569-9a98-c480cef79475",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Saum bei Kleidungsstücken"
                                        ],
                                        "tags": [
                                            "Schneiderei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545ccd74-ce78-46aa-b37c-a628dc8367b6",
                                                "sense_id": "7a3d5e47-297c-3569-9a98-c480cef79475",
                                                "text": "Der Einschlag am Knopflochsaum war schlecht vernäht."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "276b3010-0194-3fdd-8500-8fe54b07ab4a",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Abdeckung von Jungpflanzen mit Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dfa6654-7bde-4aa7-9b5d-c92f351627bd",
                                                "sense_id": "276b3010-0194-3fdd-8500-8fe54b07ab4a",
                                                "text": "Der Einschlag der Jungpflanzen wurde zusätzlich noch mit Gießwasser befeuchtet."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "d9f75e39-1206-32a4-be55-7e5ece40c03b",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "prozentuale Herabsetzung eines Werts"
                                        ],
                                        "tags": [
                                            "Steuerwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff6f06a7-671a-4403-b57a-ec656b9269e6",
                                                "sense_id": "d9f75e39-1206-32a4-be55-7e5ece40c03b",
                                                "text": "Bei der Bemessung des Einschlages sind im konkreten Einzelfall auch die Vermögensverhältnisse zu berücksichtigen."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Einschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f706040-168b-3c73-b242-8ceb1ffe3d3e",
                                        "entry_id": "2475865a-1428-3167-8b3a-b83395ae470b",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d34a0e-401a-4160-94fa-a0be2b018753",
                                                "sense_id": "2f706040-168b-3c73-b242-8ceb1ffe3d3e",
                                                "text": "„David Eduard Einschlag wird am 28. Februar 1879 in der Nürnberger Straße 30 als zweiter Sohn des Kaufmanns Joseph Einschlag (1849-1934) und dessen Ehefrau Dorothea geborene Armhaus (1847-1923) geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fed8440-d5af-46e5-8cef-11edc19a34ab",
                        "source_entry_id": "64ea70e0-fe11-3df6-8ace-9d07b2a02158",
                        "source_sense_id": "5504cf4c-67d3-3824-a906-93e39a3f4434",
                        "target_lang_word": "enfoncement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfoncement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0700be0e-9809-372a-8eed-3554d0b59715",
                                        "entry_id": "5f611aa4-265b-3065-8f39-561030ef3356",
                                        "glosses": [
                                            "Action d’enfoncer, de s’enfoncer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593f9aab-8a3a-4607-a8cd-27281311e40b",
                                                "sense_id": "0700be0e-9809-372a-8eed-3554d0b59715",
                                                "text": "L’enfoncement des pieds dans la boue."
                                            },
                                            {
                                                "example_id": "eb630ca6-58c4-469a-9bec-09f619718433",
                                                "sense_id": "0700be0e-9809-372a-8eed-3554d0b59715",
                                                "text": "Mais cette hausse du niveau des océans se conjugue à un autre phénomène : l’enfoncement graduel de la côte. ….\n … C'est ainsi que, petit à petit, les sédiments qui tiennent la terre en place ont été drainés vers le delta par ces canaux artificiels, de véritables aspirateurs d'alluvions, des autoroutes de limon.\n Petit à petit, c'est toute la structure du sous-sol de la côte qui s'est effritée, le squelette qui s’est désagrégé, causant ainsi l’affaissement des terres."
                                            },
                                            {
                                                "example_id": "1d727d24-a07e-47cf-850a-c9ab4cca6631",
                                                "sense_id": "0700be0e-9809-372a-8eed-3554d0b59715",
                                                "text": "On constate que la pédale de frein a été enfoncée de 16 mm. On peut supposer que cet enfoncement est consécutif à l’activation de l’AEBS, et non par une action du conducteur compte tenu de la rapidité de l’augmentation de pression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6f6e641-5d88-384e-85e9-1d9e4f12f8e4",
                                        "entry_id": "5f611aa4-265b-3065-8f39-561030ef3356",
                                        "glosses": [
                                            "Renfoncement, lieu qui n’est pas au niveau du reste et qui forme cavité."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d13b7f48-2c46-4303-b1a9-731ecae46002",
                                                "sense_id": "e6f6e641-5d88-384e-85e9-1d9e4f12f8e4",
                                                "text": "[…] il crut revoir le même individu qui l’avait devancé en hâtant le pas et qui cherchait à se dissimuler dans renfoncement d'une porte cochère."
                                            },
                                            {
                                                "example_id": "20b1e997-ede9-4152-903a-63b5d06c7eee",
                                                "sense_id": "e6f6e641-5d88-384e-85e9-1d9e4f12f8e4",
                                                "text": "Toutes les vieilleries dont ne voulait plus Mme Aubain, elle les prenait pour sa chambre. C’est ainsi qu’il y avait des fleurs artificielles au bord de la commode, et le portrait du comte d’Artois dans l’enfoncement de la lucarne."
                                            },
                                            {
                                                "example_id": "7b491c56-3cd3-4034-ae84-22e7c58c822b",
                                                "sense_id": "e6f6e641-5d88-384e-85e9-1d9e4f12f8e4",
                                                "text": "Je m’arrêtai pour l’attendre en me jetant dans l’enfoncement d’une allée, et je sifflai doucement, car nous ne pouvions pas voir au loin."
                                            },
                                            {
                                                "example_id": "5f38e9c0-5508-400d-9228-08eaf879d966",
                                                "sense_id": "e6f6e641-5d88-384e-85e9-1d9e4f12f8e4",
                                                "text": "Au bas d’une ruelle qui dégringole une pente caillouteuse coule une source claire contenue dans un bassin carré et abritée sous un enfoncement de la muraille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39a45fdd-22dd-31b2-a12c-1c5b2a311db3",
                                        "entry_id": "5f611aa4-265b-3065-8f39-561030ef3356",
                                        "glosses": [
                                            "Renfoncement, ce qu’il y a de plus enfoncé, ou de plus éloigné, de plus reculé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61bd1731-ff03-4d5d-a0f9-4c7285bd842d",
                                                "sense_id": "39a45fdd-22dd-31b2-a12c-1c5b2a311db3",
                                                "text": "Dans un enfoncement de la place on voit une petite maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68239f8-3eb4-3915-b108-c5327ab4abae",
                                        "entry_id": "5f611aa4-265b-3065-8f39-561030ef3356",
                                        "glosses": [
                                            "Action d’enfoncer, en brisant, en poussant, en pesant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a9f5baf-19ab-4671-8650-adea3bb386cd",
                                                "sense_id": "f68239f8-3eb4-3915-b108-c5327ab4abae",
                                                "text": "L’enfoncement d’une porte, d’une barricade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
