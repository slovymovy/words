                    "frequency": "Middle",
                    "semantic_group_id": "nastrój",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waldek od samego rana spoglądał na nią <w>pogodnie</w> i słał ukłony.",
                            "target_lang_translations": {
                                "ru": "Вальдек с самого утра <w>приветливо</w> поглядывал на неё и отвешивал поклоны."
                            }
                        },
                        {
                            "text": "Starsza pani uśmiechnęła się <w>pogodnie</w> i poczęstowała dzieci herbatnikami.",
                            "target_lang_translations": {
                                "ru": "Пожилая дама <w>безмятежно</w> улыбнулась и угостила детей печеньем."
                            }
                        }
