                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f827860-1f71-4887-a2f4-8f035ab1a838",
                                                "sense_id": "b7db6bb5-2d83-3b73-955b-92c9dbbfc07c",
                                                "text": "Since that set of articles is already fairly complete, they might serve as a good test bed for the different organizational systems we want to try."
                                            },
                                            {
                                                "example_id": "8766088b-362a-404e-9e05-cdf4fbe97269",
                                                "sense_id": "b7db6bb5-2d83-3b73-955b-92c9dbbfc07c",
                                                "text": "Although its wheel size and arrangement seem far from ideal for a high-powered modern motive power unit, No. GT3 is clearly intended as far more than just another travelling test-bed."
                                            },
                                            {
                                                "example_id": "0f45a3a2-8db5-4412-8df7-3d4bccae8184",
                                                "sense_id": "b7db6bb5-2d83-3b73-955b-92c9dbbfc07c",
                                                "text": "It was taken out of passenger service in early 2013, for conversion into a test bed for the commissioning of the European Rail Traffic Management System (ERTMS) on the Hertford Loop and elsewhere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
