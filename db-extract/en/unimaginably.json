                        "glosses": [
                            "To an extent or in a way that cannot be, or could not have been, imagined"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b676c7c-c7dd-4f87-8e74-d721bf416be2",
                                "sense_id": "af53655d-cf39-3654-88a3-0c1f1c46aec1",
                                "text": "As it prepares to inaugurate a new president, America is also trying to forge a fresh identity in a world unimaginably different from the one inherited by George W Bush only eight years ago."
                            }
                        ]
                    }
                ],
                "translations": [
