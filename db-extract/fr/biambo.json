                "senses": [
                    {
                        "sense_id": "0ebe1c47-ea63-3f92-a365-2bcfa18ac41a",
                        "entry_id": "576ef654-7de3-3456-a6ea-d7c4a9cd3296",
                        "glosses": [
                            "Guimbarde."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "fbb8e4f1-fa8c-4933-90de-d0aa49ef5da2",
                                "sense_id": "0ebe1c47-ea63-3f92-a365-2bcfa18ac41a",
                                "text": "La guimbarde est d’invention fort ancienne, on la trouve en Asie, où les Grecs de Smyrne l’appellent biambo, sorte d’onomatopée qui exprime assez exactement les sons qu’elle produit."
                            },
                            {
                                "example_id": "3bec060c-51ba-4532-9978-fcefe968ac14",
                                "sense_id": "0ebe1c47-ea63-3f92-a365-2bcfa18ac41a",
                                "text": "Pilato en préparait le programme, qui comportait : une ouverture pour guitare et mandoline, une fantaisie pour flûte à un sou, avec accompagnement de « bïambo »."
                            },
                            {
                                "example_id": "115cbc1f-a00b-4380-aa92-9c667049304a",
                                "sense_id": "0ebe1c47-ea63-3f92-a365-2bcfa18ac41a",
                                "text": "Manque sur la scène un instrument : le biambô, complément nécessaire de la tzibomba."
                            },
                            {
                                "example_id": "3f864d83-a8e9-4e44-8075-4c903c55dde4",
                                "sense_id": "0ebe1c47-ea63-3f92-a365-2bcfa18ac41a",
                                "text": "À cette occasion, on adjoindra à l’orchestre deux accordéons en ut, quatre sifflets en ré, six billambô en si bémol et une tsibomba solo."
                            },
                            {
                                "example_id": "c73398f3-db52-442a-959d-24d8f96cc95c",
                                "sense_id": "0ebe1c47-ea63-3f92-a365-2bcfa18ac41a",
                                "text": "Plus tard, Bocchi apprît le piano, le piston, la contrebasse, le violon, l’accordéon, le triangle, l’ocarina, le trombone, la grosse caisse et le billambo."
                            }
                        ]
                    }
                ],
