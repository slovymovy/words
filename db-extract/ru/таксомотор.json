                "senses": [
                    {
                        "sense_id": "90e8b828-c272-338e-baa4-8ded933ef023",
                        "entry_id": "e532aa56-88b4-3dad-a0ce-f788a885d66f",
                        "glosses": [
                            "устар. то же, что такси"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e74cb0-e1ac-4fe4-98de-0632ed927f0c",
                                "sense_id": "90e8b828-c272-338e-baa4-8ded933ef023",
                                "text": "Через несколько минут во двор влетел открытый таксомотор, в котором, стоя, летел Баквалин."
                            },
                            {
                                "example_id": "c4a9d3a9-70db-4755-a9d6-269d8c6149c0",
                                "sense_id": "90e8b828-c272-338e-baa4-8ded933ef023",
                                "text": "В текущем году получены 20 новых автобусов, 60 легковых таксомоторов и 20 грузотакси, предстоит получить ещё 25 автобусов и 5 грузовых таксомоторов."
                            }
                        ]
                    }
