                                        "sense_id": "6aa819ee-b91d-3243-afbb-d12daa81675d",
                                        "entry_id": "1724ec98-1507-32fb-9bae-802fe1d878f2",
                                        "glosses": [
                                            "The quality of being discreet."
                                        ],
                                        "tags": [
                                            "uncountable",
