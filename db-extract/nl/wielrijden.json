                                                "example_id": "4b39bb3a-31b1-41d6-88c6-5c840d0dd2d4",
                                                "sense_id": "cf60853a-936d-320e-a39b-5caecbe573f7",
                                                "text": "electoral cycle    menstrual cycle    news cycle"
