                                                "sense_id": "886f9b68-a4d8-3c1b-bdc0-f6b4f24bf9e6",
                                                "text": "„Der Frauenbund Falkenberg bereitet sich jedes Jahr auf das Weihnachtsfest und die Ankunft Jesu Christi mit einem feierlichen Rorate vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
