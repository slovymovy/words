                "senses": [
                    {
                        "sense_id": "1c67b079-ccb2-30d4-99da-39cfd72047c2",
                        "entry_id": "d1fbbdb3-ddea-341c-b335-2888724d2441",
                        "glosses": [
                            "Generally accepted as correct or true."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b241677-a236-43fd-9c56-3fcd824e0d30",
                                "sense_id": "1c67b079-ccb2-30d4-99da-39cfd72047c2",
                                "text": "And therefore as though there were any feriation in nature or justitiums imaginable in professions, whose subject is natural, and under no intermissive, but constant way of mutation, this season is commonly termed the physician's vacation, and stands so received by most men."
                            },
                            {
                                "example_id": "974e53a1-9b81-4319-856a-e28c2ebcd488",
                                "sense_id": "1c67b079-ccb2-30d4-99da-39cfd72047c2",
                                "text": "The old saying goes that we should not judge a man until we have walked a mile in his shoes. As with so much received wisdom – from judging books by their covers to the relative exchange rate for birds in hands and bushes – this is of course rubbish."
                            }
                        ]
                    }
