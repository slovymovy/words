                },
                {
                    "sense_id": "b5551886-b229-3bf7-bce4-898814591c2b",
                    "sense_definition": "Accaparement de marchandises par un ou plusieurs négociants dans le but de dominer le marché et d'augmenter les prix.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au dix-huitième siècle, les marchands organisaient un <w>monopole</w> pour faire grimper le prix du blé."
