                    {
                        "sense_id": "ac7e32ec-25f4-3d2b-bf13-44bfc50b39c1",
                        "entry_id": "e20d15c3-eddc-30c6-9b13-d78c8e49b7df",
                        "glosses": [
                            "Récipient pour le lait frais utilisé par les laitiers."
                        ],
                        "tags": [
