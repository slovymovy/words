            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23519358-cde6-3717-99a9-b798ba6323a8",
                    "sense_definition": "Испытывающий чувство страха, охваченный испугом.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "состояние_страха",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Испуганный</w> ребёнок крепко прижал к себе плюшевого мишку.",
                            "target_lang_translations": {
                                "en": "The <w>frightened</w> child tightly hugged his teddy bear."
                            }
                        },
                        {
                            "text": "В углу комнаты сидел <w>испуганный</w> котёнок, который боялся громких звуков.",
                            "target_lang_translations": {
                                "en": "A <w>frightened</w> kitten, who was afraid of loud noises, sat in the corner of the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "напуганный"
                    ],
                    "antonyms": [
                        "бесстрашный",
                        "смелый"
                    ],
                    "common_phrases": [
                        "испуганный ребёнок",
                        "испуганный вид"
                    ],
                    "target_lang_definitions": {
                        "en": "Experiencing a feeling of fear, gripped by fright."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frightened",
                                "target_lang_sense_clarification": "feeling fear or worry"
                            },
                            {
                                "target_lang_word": "scared",
                                "target_lang_sense_clarification": "afraid or frightened"
                            },
                            {
                                "target_lang_word": "terrified",
                                "target_lang_sense_clarification": "extremely frightened"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5949e7d3-d689-360e-9204-5b644758bf12",
                    "sense_definition": "Выражающий испуг, свидетельствующий о страхе (о взгляде, лице, голосе и т. п.).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "выражение_страха",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она посмотрела на меня через плечо, и её <w>испуганный</w> взгляд сразу выдал волнение.",
                            "target_lang_translations": {
                                "en": "She looked at me over her shoulder, and her <w>frightened</w> look immediately gave away her anxiety."
                            }
                        },
                        {
                            "text": "У него был крайне <w>испуганный</w> вид, когда он вошёл в кабинет директора.",
                            "target_lang_translations": {
                                "en": "He had an extremely <w>scared</w> look when he entered the principal's office."
                            }
                        }
                    ],
                    "synonyms": [
                        "напуганный"
                    ],
                    "antonyms": [
                        "уверенный",
                        "спокойный"
                    ],
                    "common_phrases": [
                        "испуганный взгляд",
                        "испуганный голос"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing fright, indicating fear (of a look, face, voice, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frightened",
                                "target_lang_sense_clarification": "showing fear in expression or voice"
                            },
                            {
                                "target_lang_word": "scared",
                                "target_lang_sense_clarification": "expressing fear"
                            },
                            {
                                "target_lang_word": "fearful",
                                "target_lang_sense_clarification": "showing or expressing fear"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db767ffc-0c54-3bb9-a85f-99e7e980e261",
                    "sense_definition": "Страдательное причастие прошедшего времени совершенного вида от глагола <w>испугать</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зверь, <w>испуганный</w> внезапным шумом шагов, мгновенно скрылся в густых кустах.",
                            "target_lang_translations": {
                                "en": "The beast, <w>frightened</w> by the sudden sound of footsteps, instantly disappeared into the thick bushes."
                            }
                        },
                        {
                            "text": "Мальчик, <w>испуганный</w> грозой, побежал прятаться в дом к родителям.",
                            "target_lang_translations": {
                                "en": "The boy, <w>scared</w> by the thunderstorm, ran to hide in the house with his parents."
                            }
                        }
                    ],
                    "synonyms": [
                        "напуганный"
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'испугать' (to frighten, scare)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frightened",
                                "target_lang_sense_clarification": "scared by something"
                            },
                            {
                                "target_lang_word": "scared",
                                "target_lang_sense_clarification": "made afraid by a sudden event"
                            },
                            {
                                "target_lang_word": "startled",
                                "target_lang_sense_clarification": "suddenly frightened or surprised"
                            }
                        ]
                    }
                }
            ]
        }
