                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "render",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f6dd13-bd5a-3734-a1a7-0ed32e018dc7",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To cause to become."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d094d037-5a49-4587-b5cb-044b3445b497",
                                                "sense_id": "a3f6dd13-bd5a-3734-a1a7-0ed32e018dc7",
                                                "text": "The shot rendered her immobile."
                                            },
                                            {
                                                "example_id": "4e4992cb-892b-48cc-95f5-3ea71cd194cd",
                                                "sense_id": "a3f6dd13-bd5a-3734-a1a7-0ed32e018dc7",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            },
                                            {
                                                "example_id": "24d6b8be-cc34-450d-89e5-1fe69b50ac7a",
                                                "sense_id": "a3f6dd13-bd5a-3734-a1a7-0ed32e018dc7",
                                                "text": "This service has suffered badly from Department for Transport-inspired cuts which reduced it from hourly to two-hourly. This, coupled with regular cancellations, has rendered the train service between the area's two biggest towns almost unusable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e50050d4-c2fc-3655-80b1-44200825272e",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To interpret, give an interpretation or rendition of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4664bd7a-671d-4a28-8e4e-72a8681fc3fc",
                                                "sense_id": "e50050d4-c2fc-3655-80b1-44200825272e",
                                                "text": "The pianist rendered the Beethoven sonata beautifully."
                                            },
                                            {
                                                "example_id": "fa96a756-0b37-461c-92c0-5ed233c931b8",
                                                "sense_id": "e50050d4-c2fc-3655-80b1-44200825272e",
                                                "text": "we may, at last, render our philosophy like that of Epictetus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8f038c-3212-377c-8406-503154844891",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To translate into another language."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36059b7-cf41-48f1-a00e-6d2f4181a71b",
                                                "sense_id": "0e8f038c-3212-377c-8406-503154844891",
                                                "text": "to render Latin into English"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437dcc84-9832-3992-8b65-2f8bc09c15d2",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To pass down."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f635d1-031d-4c21-ab19-f647e388e26c",
                                                "sense_id": "437dcc84-9832-3992-8b65-2f8bc09c15d2",
                                                "text": "render a verdict (i.e., deliver a judgment)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f43dee0-4eb7-3834-b974-22d0c66ae7bc",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To make over as a return."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1ac0d1e-2a31-448f-8fb3-3d1cfc48700f",
                                                "sense_id": "0f43dee0-4eb7-3834-b974-22d0c66ae7bc",
                                                "text": "They had to render the estate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcb9114-9647-34b1-83f4-7e019309b23b",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To give; to give back; to deliver."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eca8527-8adf-4219-8119-daa0f03c1549",
                                                "sense_id": "9fcb9114-9647-34b1-83f4-7e019309b23b",
                                                "text": "render aid; render money"
                                            },
                                            {
                                                "example_id": "23a67fb9-a8d8-43d3-acba-daae117275f9",
                                                "sense_id": "9fcb9114-9647-34b1-83f4-7e019309b23b",
                                                "text": "to render an account of what really happened"
                                            },
                                            {
                                                "example_id": "e6f2c71f-f398-4f5e-8137-465c2b6782fb",
                                                "sense_id": "9fcb9114-9647-34b1-83f4-7e019309b23b",
                                                "text": "Logic renders its daily service to wisdom and virtue."
                                            },
                                            {
                                                "example_id": "ab069769-9026-4bc0-9de8-23bf4522cd0b",
                                                "sense_id": "9fcb9114-9647-34b1-83f4-7e019309b23b",
                                                "text": "The first thing that greets you on entering the church is a notice asking you not to vex the goat, since it renders valuable service in keeping the churchyard tidy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "253ebf40-e9d8-3a10-802e-660a92a438aa",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To give up; to yield; to surrender."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397ad52f-2c97-4378-9aaf-f6f8ba152367",
                                                "sense_id": "253ebf40-e9d8-3a10-802e-660a92a438aa",
                                                "text": "I'll make her render up her page to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "940a2b99-448d-3957-8eff-20690305bb7c",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To transform (a model) into a display on the screen or other media."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e509252-4143-4109-9f4e-c02c34c8ee9b",
                                                "sense_id": "940a2b99-448d-3957-8eff-20690305bb7c",
                                                "text": "rendering images"
                                            },
                                            {
                                                "example_id": "7db621a0-bb4b-4764-ae67-d57256bea67c",
                                                "sense_id": "940a2b99-448d-3957-8eff-20690305bb7c",
                                                "text": "They will feature full-motion-video backgrounds that will behave as if rendered in 3-D—the Rabbids will duck behind and jump over real objects as if they were designed into the stage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f0fe30e-89b8-3a8c-9d87-efeea47db980",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To apply realistic coloring and shading."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3887990-cadf-3b7d-8355-eb990a0ad92f",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To capture and turn over to another country secretly and extrajudicially."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e445fae6-a46b-3ca5-ba02-8c780012aa54",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To convert waste animal tissue into a usable byproduct."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a0aee13-074d-4f94-84b2-a36759f3425a",
                                                "sense_id": "e445fae6-a46b-3ca5-ba02-8c780012aa54",
                                                "text": "rendering of fat into soap"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e5f9e6-9b0f-304a-bf2a-9fc975d96d22",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To have fat melt off meat from cooking."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cf6aa53-3e25-4892-b585-a500a79a4e67",
                                                "sense_id": "c4e5f9e6-9b0f-304a-bf2a-9fc975d96d22",
                                                "text": "Bacon is very fatty when raw; however, most of the fat will render during cooking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e454f1-5506-341d-98d5-227889e8a4da",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To cover a wall with a layer of plaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713d0fc5-c912-44f1-bc59-cfddb67f9828",
                                                "sense_id": "24e454f1-5506-341d-98d5-227889e8a4da",
                                                "text": "to render with stucco"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e87ed396-8cc8-3fa2-8e8b-9afd3041cc9e",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To pass; to run; said of the passage of a rope through a block, eyelet, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c1ce2d4-1707-4ff8-bab0-f86ca2a2d182",
                                                "sense_id": "e87ed396-8cc8-3fa2-8e8b-9afd3041cc9e",
                                                "text": "A rope renders well, that is, passes freely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2963404e-8d84-3475-b9a4-0067ca878c74",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To yield or give way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "914a7e88-7779-4510-8c7b-532114c47fe5",
                                                "sense_id": "2963404e-8d84-3475-b9a4-0067ca878c74",
                                                "text": "The rope of a laniard or tackle is said to render when, by pulling upon one part, each other part takes its share of the strain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07b7ac94-d9b6-301d-bb3b-feb91677f840",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To return; to pay back; to restore."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3746b3f0-8eef-4ab0-b104-788b9ae842f4",
                                                "sense_id": "07b7ac94-d9b6-301d-bb3b-feb91677f840",
                                                "text": "whose smallest minute lost, no riches render may"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b08822-a2fe-3383-b341-e69927d00d4b",
                                        "entry_id": "296bba2d-37c7-386c-8d0b-3d008c5514d7",
                                        "glosses": [
                                            "To inflict, as a retribution; to requite."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c45d448-26d9-42d0-8553-d9a58ae8c989",
                                                "sense_id": "a1b08822-a2fe-3383-b341-e69927d00d4b",
                                                "text": "I will render vengeance to mine enemies."
                                            }
                                        ]
                                    }
                                ]
                            },
