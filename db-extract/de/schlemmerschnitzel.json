                "senses": [
                    {
                        "sense_id": "3c5d1236-9baf-3d63-a5d6-48ec4324e9ff",
                        "entry_id": "5b3ebf08-35c3-3e5d-9bda-ab82f32c5efa",
                        "glosses": [
                            "Schnitzel, mit Soße, Füllung oder überbacken wie häufig in Imbissbuden angeboten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8603dd0c-6958-4534-8df4-dd1ec62caa8d",
                                "sense_id": "3c5d1236-9baf-3d63-a5d6-48ec4324e9ff",
                                "text": "Zwei halve Hahn und ein Schlemmerschnitzel, bitte!"
                            },
                            {
                                "example_id": "5e7bc6ba-81f6-472c-a817-1c00f7d20190",
                                "sense_id": "3c5d1236-9baf-3d63-a5d6-48ec4324e9ff",
                                "text": "„Schlemmerschnitzel anrichten, mit Majoran garnieren. Dazu schmecken Bratkartoffeln.”"
                            },
                            {
                                "example_id": "86646854-585a-4ae8-a80d-3c1ab37bc39c",
                                "sense_id": "3c5d1236-9baf-3d63-a5d6-48ec4324e9ff",
                                "text": "„Schlemmerschnitzel: Schnitzel mit Spargel und gekochtem Schinken in Sahnesoße dazu Rösti € 12,00“"
                            },
                            {
                                "example_id": "0ee14288-e92a-4441-9611-2c1ebf9c3b32",
                                "sense_id": "3c5d1236-9baf-3d63-a5d6-48ec4324e9ff",
                                "text": "„Schlemmerschnitzel paniert und mit Schinken, Käse und Spiegelei überbacken“"
                            },
                            {
                                "example_id": "d9e70f57-a8ee-4c9f-bb78-2f6157093ba0",
                                "sense_id": "3c5d1236-9baf-3d63-a5d6-48ec4324e9ff",
                                "text": "„Ihre ehemalige Lehrerin Frau Endraß, von der auch das Rezept für das Schlemmerschnitzel stammt, gab der heute 40-Jährigen eine glatte Eins.“"
                            },
                            {
                                "example_id": "96efcbc2-87ae-4c5a-b925-61493d8c4979",
                                "sense_id": "3c5d1236-9baf-3d63-a5d6-48ec4324e9ff",
                                "text": "„Entschlossen rufe ich dem Kellner zu: >>Herr Ober, ich hätte gerne auch das „Schlemmer-Schnitzel“ nach Art des Hauses …<<“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
