                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fca29f-5494-4b54-a712-f6054bc01caf",
                                "sense_id": "554a06f7-228d-3f7b-a9d5-bde6c0301b7f",
                                "text": "„Ein lauter Summer tönte.“"
                            },
                            {
                                "example_id": "7298e60d-0889-483b-88a6-bd944cb4e898",
                                "sense_id": "554a06f7-228d-3f7b-a9d5-bde6c0301b7f",
