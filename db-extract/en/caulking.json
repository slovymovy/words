                "senses": [
                    {
                        "sense_id": "fe84703b-52e1-3c42-a795-0e75474b1d38",
                        "entry_id": "5e61af70-74b5-3961-9696-c87003eb392a",
                        "glosses": [
                            "A sealing material used to seal joints between heterogeneous materials in many kinds of construction and manufacture."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "7358604f-c1b4-45aa-ad85-ed36f1155ede",
                                "sense_id": "fe84703b-52e1-3c42-a795-0e75474b1d38",
                                "text": "Oakum was used for the caulking of the hulls of wooden ships."
                            },
                            {
                                "example_id": "abce465d-b07c-482a-b059-c1c4fe27fd9e",
                                "sense_id": "fe84703b-52e1-3c42-a795-0e75474b1d38",
                                "text": "Marina's bedroom was a small charming room with small charming windows of aged glass, dating to the mid-1800s, windowpanes badly in need of caulking, overlooking St. Agnes Roman Catholic Church with its heraldic spire floating on the night sky, and its ancient bumpy churchyard."
                            },
                            {
                                "example_id": "4e42a369-96e8-4a7e-ad24-2418c2e9b5b8",
                                "sense_id": "fe84703b-52e1-3c42-a795-0e75474b1d38",
                                "text": "It might just be the caulking. This whole tub needs to be re-caulked. Did you take a bath or shower in the last couple of hours?"
                            }
                        ]
                    },
                    {
                        "sense_id": "36937fdd-7cca-3608-86aa-bd8f68aa05bd",
