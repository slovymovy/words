                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb816722-cd08-3f7e-8008-af708005ebac",
                        "entry_id": "d942dd65-abdc-3f28-99bf-f4cc4ee91db1",
                        "glosses": [
                            "Qui profite sans vergogne."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d3884745-64f7-4f9c-b435-4827e4b166ed",
                                "sense_id": "cb816722-cd08-3f7e-8008-af708005ebac",
                                "text": "Tous ces courtisans, profiteurs et forniqueurs dans les bureaux où les climatiseurs ne s'arrêtaient jamais de ronronner, trouvèrent au Président Bagabaga Daba des qualités telles que ses ancêtres durent se retourner dans leur tombe."
                            },
                            {
                                "example_id": "1ecc38f9-d45b-4722-99b5-48c3df19a467",
                                "sense_id": "cb816722-cd08-3f7e-8008-af708005ebac",
                                "text": "Je suis un spécimen athée, paresseux, assisté, profiteur et pourri, qui aime se reproduire comme des lapins. Je fais partie du Tiers-Con. Ma devise : Se lever pour une canette."
                            },
                            {
                                "example_id": "8ac0a6b7-1aa6-43b0-acc8-e5b6a033d286",
                                "sense_id": "cb816722-cd08-3f7e-8008-af708005ebac",
                                "text": "Un modèle de bourgeois d'État, comme il devait en exister, quelques années avant la Révolution française, ces bourgeois érudits qui souhaitaient, coûte que coûte, émanciper le pays de sa noblesse avachie et profiteuse."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                "word": "profiteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c26e2c7e-d207-44a7-9e67-0048bf9896dd",
                        "entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                        "tags": [
                            "plural"
                        ],
                        "form": "profiteurs"
                    },
                    {
                        "form_id": "5c057f75-bf8a-4cbc-8d34-792a407104f0",
                        "entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                        "tags": [
                            "feminine"
                        ],
                        "form": "profiteuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61694698-99f5-367d-b148-f8812233d6d3",
                        "entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                        "glosses": [
                            "Personne qui tire profit d'une chose ou d'une situation, de façon malhonnête."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2feae0eb-a1ff-4c81-8287-2d1fe55d9dd6",
                                "sense_id": "61694698-99f5-367d-b148-f8812233d6d3",
                                "text": "Au lieu du Décret pour la défense du royaume qui, en Angleterre, réglementait la répartition des denrées, poursuivait les défaitistes, les espions, les profiteurs, etc., nous voyons en Russie la Commission extraordinaire."
                            },
                            {
                                "example_id": "88f25287-e757-490d-bd06-0cdd31fbd9be",
                                "sense_id": "61694698-99f5-367d-b148-f8812233d6d3",
                                "text": "Les paysans qui estiment avoir bien « mérité de la patrie » ne sont pourtant pas jugés comme tels par les gens des villes. Comme le dit Michel Augé-Laribé […] le paysan est perçu comme un profiteur de guerre, comme le responsable de la « vie chère », comme un enrichi qui ne paie pas sa part d'impôt."
                            }
                        ]
                    },
                    {
                        "sense_id": "59132602-c15d-3c26-a775-efb6680e0793",
                        "entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                        "glosses": [
                            "Personne qui cherche à tirer profit d'un travail auquel elle ne participe pas ou peu ; personne qui abuse de la générosité ou des largesses d’autrui."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "33fb2c0a-e340-4826-8082-ec5536443d78",
                                "sense_id": "59132602-c15d-3c26-a775-efb6680e0793",
                                "text": "Le pauvre n’est plus tout à fait l’image du Christ sur terre mais un profiteur sans vergogne et paresseux, dont la paresse est fortement combattue ; une ordonnance de 1351 de Jean II condamne les vagabonds qui refusent de poursuivre une activité salariée."
                            }
                        ]
                    },
                    {
                        "sense_id": "857bc305-30c9-3a30-9908-2cc8ea9ba23d",
                        "entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                        "glosses": [
                            "Agent économique profitant d’un bien ou d’un avantage collectifs sans en supporter les frais, laissés à la charge des autres usagers."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6061c3de-bd1e-3eb4-b805-72fd2a76797f",
                        "entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                        "glosses": [
                            "Exemple d’utilisation manquant. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d401354f-61b3-4db8-8406-a438b5b6ef35",
                        "source_entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
                        "source_sense_id": "61694698-99f5-367d-b148-f8812233d6d3",
                        "target_lang_word": "Profiteur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Profiteur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f67c3416-53b0-3e0b-b9fa-fedef5bf588c",
                                        "entry_id": "fe93659f-f907-3bea-97de-c8c7933281b1",
                                        "glosses": [
                                            "jemand, der aus einer Sache oder Tätigkeit ohne größeren eigenen Aufwand materiellen Nutzen zieht"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a52a64-5d12-4e49-bc40-a3ebbc197cb0",
                                                "sense_id": "f67c3416-53b0-3e0b-b9fa-fedef5bf588c",
                                                "text": "Größter Profiteur der neuen EU-Regelung ist Kanada, wo die größten Mengen an Teersand vorkommen."
                                            },
                                            {
                                                "example_id": "e4e962b9-7830-4691-b4df-4df515f3fa03",
                                                "sense_id": "f67c3416-53b0-3e0b-b9fa-fedef5bf588c",
                                                "text": "Das Münchner Ifo Institut sieht die deutsche Bauwirtschaft als einen der Profiteure der andauernden Euro-Schuldenkrise."
                                            },
                                            {
                                                "example_id": "2c9bc168-ddaf-4c66-9981-4280535b3429",
                                                "sense_id": "f67c3416-53b0-3e0b-b9fa-fedef5bf588c",
                                                "text": "Vertreter dieser These argumentieren, dass Deutschland die größte Volkswirtschaft des Euroraums sei und schon deshalb der größte Profiteur der gemeinsamen Währung sein müsse."
                                            },
                                            {
                                                "example_id": "5c16276f-ea0b-4329-aef6-864016841a56",
                                                "sense_id": "f67c3416-53b0-3e0b-b9fa-fedef5bf588c",
                                                "text": "Deutschland liegt in der Rangliste der größten Profiteure hinter den starken Exportnationen Finnland, Dänemark und Japan auf Platz vier."
                                            },
                                            {
                                                "example_id": "e931541f-0487-4e7b-9c3b-d2fdfbd79270",
                                                "sense_id": "f67c3416-53b0-3e0b-b9fa-fedef5bf588c",
                                                "text": "Entscheidend ist, dass sich Stronach als Profiteur eines politischen Systems erwiesen hat, das in den vergangenen Jahren die Parteikassen auf Kosten des Landes aufgefüllt hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e45adf1-3726-4ff0-b0c1-1dcc28c0ce20",
                        "source_entry_id": "e14161fd-0e94-3190-993c-d9e843f6d358",
