                "senses": [
                    {
                        "sense_id": "ded2f5ff-2537-37d1-ac18-549059505069",
                        "entry_id": "258a3531-db3d-3f45-be91-db5f42864a9d",
                        "glosses": [
                            "stellvertretender Verwalter, Statthalter"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8e2d3bea-332a-41a0-8de2-34f0eb4fa977",
                                "sense_id": "ded2f5ff-2537-37d1-ac18-549059505069",
                                "text": "Ein Verweser ist jemand, der eine vakante Stelle vorübergehend verwaltet, bis wieder ein ordentlich gewählter Amtsinhaber eingesetzt wird."
                            },
                            {
                                "example_id": "a9372041-74c0-455d-942c-7350edf251fe",
                                "sense_id": "ded2f5ff-2537-37d1-ac18-549059505069",
                                "text": "Nach anfänglichem Zögern organisierte Rainer Rischer (CDU), Verweser des Bürgermeisteramts von Lauta, kurz vor Ende seiner Amtszeit schließlich eine Untersuchung der Verdachtsfläche."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfc5ef11-f7e1-3899-b97a-ab8c5efff251",
                        "entry_id": "258a3531-db3d-3f45-be91-db5f42864a9d",
                        "glosses": [
                            "nichtschulischer Lehrer"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "21c464f7-325c-4583-9063-d2afebf1e6bf",
                                "sense_id": "cfc5ef11-f7e1-3899-b97a-ab8c5efff251",
                                "text": "In derselben wird geltend gemacht, daß die Schule zu B. nur 21 Schüler zähle und bisher stets mit einem Verweser besetzt gewesen sei. (1874)"
                            },
                            {
                                "example_id": "468ff349-4f3c-4a79-b12c-c77998891f1d",
                                "sense_id": "cfc5ef11-f7e1-3899-b97a-ab8c5efff251",
                                "text": "Die gewählten Lehrer und Verweser der Volksschule, des Handarbeits- und des Haushaltungsunterrichts werden in folgende Besoldungskategorien eingeteilt:"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7632e7a6-6446-4a1f-9cf9-616234829d38",
