                "senses": [
                    {
                        "sense_id": "8aacd6dd-0ddc-3adf-97d0-cbbc59be4796",
                        "entry_id": "fc600d7f-c2bd-3c0b-a280-cce0154d83e3",
                        "glosses": [
                            "A large sofa, especially a formal one."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff431c3-e783-4260-82b7-b6a6675e96c7",
                                "sense_id": "8aacd6dd-0ddc-3adf-97d0-cbbc59be4796",
                                "text": "Holonym: furniture"
                            },
                            {
                                "example_id": "60aec578-0f2d-488d-b4bb-cade8ffeccc8",
                                "sense_id": "8aacd6dd-0ddc-3adf-97d0-cbbc59be4796",
                                "text": "He blundered into the living-room, lay on the davenport, hands behind his head."
                            },
                            {
                                "example_id": "408c3208-94e4-4d95-8787-c85802234abe",
                                "sense_id": "8aacd6dd-0ddc-3adf-97d0-cbbc59be4796",
                                "text": "Beezus felt a little better. She curled up on the davenport again with 202 Things to Do on a Rainy Afternoon and read about making Christmas tree ornaments out of cellophane straws, until she heard her aunt's car turn into the driveway."
                            }
                        ]
                    },
                    {
                        "sense_id": "026fa4dd-c485-3b1b-96e5-df419cad923c",
                        "entry_id": "fc600d7f-c2bd-3c0b-a280-cce0154d83e3",
                        "glosses": [
                            "A writing desk, especially a small one."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad720ad-c049-4e2a-a71a-6d2ed6535141",
                                "sense_id": "026fa4dd-c485-3b1b-96e5-df419cad923c",
                                "text": "Then she went into the house, and, sitting down at the davenport in the dining-room, got out a sheet of her best notepaper, and wrote a note to Pamela Dysart in her strong, commercially clear hand."
                            },
                            {
                                "example_id": "422972f1-18e5-4a48-aa57-2350fc020223",
                                "sense_id": "026fa4dd-c485-3b1b-96e5-df419cad923c",
                                "text": "He crosses to the davenport to get the policies from his briefcase,"
                            }
                        ]
                    }
                ],
