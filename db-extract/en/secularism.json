                "senses": [
                    {
                        "sense_id": "8ea8cbf1-108d-3b01-9c93-1fb550bdcd3e",
                        "entry_id": "a87e96a1-9ab4-3734-a40c-6a6b1831d3c9",
                        "glosses": [
                            "Neutrality towards all religions."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7163f654-77b2-4fa2-b03b-465b83abd2e6",
                                "sense_id": "8ea8cbf1-108d-3b01-9c93-1fb550bdcd3e",
                                "text": "state secularism"
                            },
                            {
                                "example_id": "9006e430-26f5-49a4-b6a1-8387172f52f2",
                                "sense_id": "8ea8cbf1-108d-3b01-9c93-1fb550bdcd3e",
                                "text": "The ancient quarians practiced ancestor worship. Even after abandoning faith for secularism, quarians continued to revere the wisdom of elders."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5a4409e-82d8-3ba6-a7a8-d27ac9129ad3",
                        "entry_id": "a87e96a1-9ab4-3734-a40c-6a6b1831d3c9",
                        "glosses": [
                            "The political belief in the separation of church and state, i.e. the position that religious belief should not influence public and governmental decisions."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "98ac8169-1c37-4fb3-a0e9-9782c2f7f5e4",
                                "sense_id": "c5a4409e-82d8-3ba6-a7a8-d27ac9129ad3",
                                "text": "And I have further to say, that I believe as much as Mr. Bradlaugh, or any other man in the room, in freethought; and I invite every Secularist to break off from him for ever the shackles that bind him in the superstition of his Secularism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "585a8393-7c1a-4439-85ec-b19dea9cbf22",
                        "source_entry_id": "a87e96a1-9ab4-3734-a40c-6a6b1831d3c9",
                        "source_sense_description": "neutrality towards all religions",
                        "target_lang_word": "secularisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secularisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "77eab31f-4b14-3051-b0ef-2c96dd47c0c7",
                                        "entry_id": "9172af91-a3fe-363e-8e29-eeff1ba03bd8",
                                        "glosses": [
                                            "de overtuiging dat religie en geloof geen invloed mogen uitoefenen op de maatschappij"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c1d4803-db26-42f7-80ad-988140239748",
                                                "sense_id": "77eab31f-4b14-3051-b0ef-2c96dd47c0c7",
                                                "text": "De kleine islamitische partijen waarin Erdogan eerst actief was, werden allemaal verboden omdat ze aan het geheiligde secularisme zouden morrelen."
                                            },
                                            {
                                                "example_id": "41d87bc6-431d-4e5d-9296-ea361e10f673",
                                                "sense_id": "77eab31f-4b14-3051-b0ef-2c96dd47c0c7",
                                                "text": "Hoofdredacteur Riss (Laurent Sourisseau), die zwaargewond raakte bij de aanslag, schreef een hoofdredactioneel stuk waarin hij het secularisme verdedigt en de fanatici die werden gebrainwasht door de Koran en de extremisten uit de andere religies veroordeelt."
                                            },
                                            {
                                                "example_id": "f6ab4f3f-538e-4436-a1b8-e5a2ace082d5",
                                                "sense_id": "77eab31f-4b14-3051-b0ef-2c96dd47c0c7",
                                                "text": "De burgemeester van de Franse badplaats Cannes heeft een strandverbod uitgeroepen op boerkini's, de lichaamsbedekkende badpakken die sommige moslima's dragen. In een verklaring noemt hij de religieuze uitstraling ervan in strijd met Frans secularisme, zo meldt persbureau AFP donderdag."
                                            },
                                            {
                                                "example_id": "ecc8d91c-c4fb-4551-a6ca-c7f04bbbb0a4",
                                                "sense_id": "77eab31f-4b14-3051-b0ef-2c96dd47c0c7",
                                                "text": "Het boek behandelt onze relatie met de nieuwsmedia, onze ideeën over liefde en seks, onze veronderstellingen over geld en onze carrières, onze houding ten opzichte van dieren en de natuur, onze bewondering voor wetenschap en technologie, ons geloof in individualisme en secularisme - en onze verhouding tot rust en eenzaamheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "836a7054-1115-4834-bf97-2d82b469ddf6",
                        "source_entry_id": "a87e96a1-9ab4-3734-a40c-6a6b1831d3c9",
                        "source_sense_description": "neutrality towards all religions",
                        "target_lang_word": "laïcité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laïcité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Principe de séparation entre l'État et les institutions religieuses, l’État n’exerçant aucun pouvoir religieux et les Églises aucun pouvoir politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2057300c-c4d5-4d0d-96dc-f0a1cc7e21e9",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "La laïcité est engagée dans une lutte âpre et décisive contre le cléricalisme. L'État se bat contre l'Église."
                                            },
                                            {
                                                "example_id": "406764cc-6257-4b7a-af2e-d8acf23ce564",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "Le terme d’islamophobie remplit plusieurs fonctions: nier pour mieux la légitimer la réalité d’une offensive intégriste en Europe, attaquer la laïcité en l’assimilant à un nouveau fondamentalisme."
                                            },
                                            {
                                                "example_id": "498de622-9f38-4183-a0b9-33efcd84a1d6",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "Nous sommes en chemin vers une affirmation paradoxale : plus je suis croyant, moins je devrais le montrer. La laïcité est anticléricale et non antireligieuse, comme l’actera la loi de décembre 1905."
                                            },
                                            {
                                                "example_id": "72af345c-7650-4eee-9fd1-4cfbb3df2153",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "Jésus avait pourtant créé la laïcité en déclarant « Rendez à César ce qui revient à César, à Dieu ce qui revient à Dieu » ou « Qui m'a établi pour vous juger ou régler vos partages? », or le contraire se développait : le religieux, loin de s’affranchir du politique, du militaire, de l’économique et du civil, s’y infiltrait, voire les préemptait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53bf2e0f-6fa9-3f59-89b6-edb958f7dbb1",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Caractère de neutralité religieuse, d’indépendance à l’égard de toutes Églises et confessions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3622191f-068d-48ba-b84b-fc9dec2befe0",
                                                "sense_id": "53bf2e0f-6fa9-3f59-89b6-edb958f7dbb1",
                                                "text": "À coup sûr, l’essence de la laïcité, mis à part la séparation de la religion et de l’État, est l’acceptation de la proposition selon laquelle il n’y a pas de finalité des formes, pas de possession exclusive de la vérité absolue et indivisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef045e6f-fcb3-34c3-9e88-93e2a2ccf3cb",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Absence d’emprise de la religion sur la société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadf95d3-d2ac-4852-b70e-082099d0547c",
                                                "sense_id": "ef045e6f-fcb3-34c3-9e88-93e2a2ccf3cb",
                                                "text": "D’un point de vue philosophique, la laïcité est une construction intellectuelle tendant à empêcher l’emprise de toute confession sur la société, ce qui a pour conséquence de proscrire l’imposition d’une religion civile par le politique tout en renvoyant les affaires spirituelles à la sphère privée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6813dcb5-f19e-36ca-9df4-f817e130fd2c",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Vision de la société préconisant l'exclusion de toute référence à la religion dans la sphère publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0b2d7b-4a32-437f-a55e-c2deb50f22cc",
                                                "sense_id": "6813dcb5-f19e-36ca-9df4-f817e130fd2c",
                                                "text": "Leur conception de la laïcité tend à exclure les religions de la sphère publique et, en particulier, de l'espace scolaire, y compris par la suppression de la culture religieuse, en affirmant que l'approche culturelle du religieux, proposant des connaissances sur les religions, relève essentiellement d'une démarche confessionnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0779ed20-2ff7-42e5-8bd8-afa85ee88ede",
                        "source_entry_id": "a87e96a1-9ab4-3734-a40c-6a6b1831d3c9",
