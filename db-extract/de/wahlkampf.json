                        "target_lang_word": "campagne électorale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campagne électorale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02aaf9a0-4738-3405-8f6f-9fc9ebf45cd8",
                                        "entry_id": "862f296a-cc60-3795-bbcf-43e43ee000d0",
                                        "glosses": [
                                            "Période précédant une élection, durant laquelle les candidats et leurs partis font leur promotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e57d0e2-d1c1-426a-a37d-1839f6c7edee",
                                                "sense_id": "02aaf9a0-4738-3405-8f6f-9fc9ebf45cd8",
                                                "text": "Au printemps 1995, après quatorze années de service, François Mitterrand quitte l'Élysée et laisse la place à un Jacques Chirac marqué par une campagne électorale dévastatrice pour la droite, le Premier ministre Édouard Balladur ayant décidé de se présenter malgré et contre le leader historique du RPR, causant une fracture profonde entre « balladuriens » et « chiraquiens »."
                                            },
                                            {
                                                "example_id": "e26dcab1-9c84-429c-b2c1-2d1ea885de60",
