                        "glosses": [
                            "Having an evil or harmful influence; baleful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5f7654-1f72-4827-815a-5dad5c2d9272",
                                "sense_id": "313fc723-97c0-3ba7-9181-4159d359c55b",
                                "text": "Wormwood [...] was associated with the rites of St. John's Eve, when a crown of the plant was made from its sprays for apotropaic purposes, to ward of malefic spirits."
                            },
                            {
                                "example_id": "ba4895e3-6d45-44f7-890c-45e0184173cd",
                                "sense_id": "313fc723-97c0-3ba7-9181-4159d359c55b",
                                "text": "I would have liked to know whether he thought this was due to the climate, the diet, or simply malefic djinns."
                            }
                        ]
                    }
                ],
