                        "entry_id": "300adc51-1bd0-342a-a9a0-793e2c49158f",
                        "glosses": [
                            "Qui est de la nature du goitre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea21f619-f9f2-4dc6-90fa-e052afa5ead0",
                                "sense_id": "6dc068b1-8ff5-3946-b0ab-e2ea1102bdb5",
                                "text": "Tumeur goitreuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcb5ad4c-93bb-373f-9eb5-e30db604a01c",
                        "entry_id": "300adc51-1bd0-342a-a9a0-793e2c49158f",
                        "glosses": [
                            "Qui a un goitre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa18df69-df72-4800-8a84-6a6b5446aa3d",
                                "sense_id": "fcb5ad4c-93bb-373f-9eb5-e30db604a01c",
                                "text": "Les habitants de cette vallée sont presque tous goitreux."
                            },
                            {
                                "example_id": "cefa1abc-34ed-4685-96eb-c57738062619",
                                "sense_id": "fcb5ad4c-93bb-373f-9eb5-e30db604a01c",
                                "text": "Un chien crevé gisait sur un tas d’ordures ; une femme goitreuse cherchait des poux dans la chevelure d’une petite fille."
                            },
                            {
                                "example_id": "ea177242-32ba-4faf-bdda-ca624ea7f1e7",
                                "sense_id": "fcb5ad4c-93bb-373f-9eb5-e30db604a01c",
                                "text": "Mais je ne peux pas laisser Nadine souffler seule dans les mirlitons de ces crétins goitreux, qui nous ont invités pour voir si j’ai vraiment les pieds fourchus."
                            }
                        ]
                    }
