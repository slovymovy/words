                    {
                        "sense_id": "f79a8bf8-09b3-3c25-bd9c-487d9aafa368",
                        "entry_id": "c69fb233-6d83-329e-afab-1c60456acce2",
                        "glosses": [
                            "Personne qui croit que l’embryon est formé dans la semence du mâle."
                        ],
                        "tags": [
                            "Histoire de la zoologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6680c88d-7167-3d81-b512-cb3dd550ed8e",
                        "entry_id": "c69fb233-6d83-329e-afab-1c60456acce2",
                        "glosses": [
                            "Personne qui défend les animaux pour eux-mêmes, considérations écologiques ou humanistes mises à part."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "f278c8ce-d479-45a5-bcf7-a3a8b4c9caad",
                                "sense_id": "6680c88d-7167-3d81-b512-cb3dd550ed8e",
                                "text": "Que se passerait-il si on mettait fin aux activités de chasse et de trappe? Du côté des animalistes, on en rêve, mais a-t-on jamais pensé à ce qui se passerait par la suite?"
                            },
                            {
                                "example_id": "58a8106b-e417-4f02-9715-051fdd2268a3",
                                "sense_id": "6680c88d-7167-3d81-b512-cb3dd550ed8e",
                                "text": "[…] les écologistes et les animalistes sont de nouveau fourrés dans le même sac, sans nuance, par le lobby de la faune."
                            }
                        ]
                    }
                ],
