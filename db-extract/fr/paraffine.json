                "entry_id": "5c10db31-4ffd-31b0-bfbe-261fd8dd635c",
                "word": "paraffine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e72cb7d8-fa0d-499d-b6d0-adac9c982027",
                        "entry_id": "5c10db31-4ffd-31b0-bfbe-261fd8dd635c",
                        "tags": [
