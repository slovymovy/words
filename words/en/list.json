                    "sense_definition": "To listen or pay attention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "listen_hear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>List</w> to the sound of the wind blowing through the trees.",
                            "target_lang_translations": {
                                "ru": "<w>Внимай</w> звуку ветра, дующего сквозь деревья.",
                                "zh": "<w>倾听</w>风吹过树林的声音。"
                            }
                        },
                        {
                            "text": "She bade the traveler <w>list</w> to her tale of woe.",
                            "target_lang_translations": {
                                "ru": "Она попросила путника <w>выслушать</w> ее печальную историю.",
                                "zh": "她请求那位旅行者<w>倾听</w>她悲伤的故事。"
                            }
                        }
