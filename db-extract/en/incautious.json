                "senses": [
                    {
                        "sense_id": "ba9bee66-6197-3dbd-9eef-f5f99ae51427",
                        "entry_id": "ca1378a3-6499-31a3-b2db-0024852944d7",
                        "glosses": [
                            "careless, reckless, not exercising proper caution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d26ce3-49dc-4962-a0ed-aad5fe0ac314",
                                "sense_id": "ba9bee66-6197-3dbd-9eef-f5f99ae51427",
                                "text": "\"You might have remained so still,\" replies Jones, \"if you had not been unfortunate, I will venture to say incautious, in the placing your affections."
                            },
                            {
                                "example_id": "97799b24-0337-4d95-9b4c-71b533f8304f",
                                "sense_id": "ba9bee66-6197-3dbd-9eef-f5f99ae51427",
                                "text": "\"Yes, let 'Sister' Davis have a whack at it too,\" urged George Bland. Tom Davis, who was Joe Matson's particular chum, was designated \"Sister\" because, in an incautious moment, when first coming to Excelsior Hall, he had shown a picture of his very pretty sister, Mabel."
                            },
                            {
                                "example_id": "3f94aa7b-0e5c-44a9-b6c9-fdf0f55cc673",
                                "sense_id": "ba9bee66-6197-3dbd-9eef-f5f99ae51427",
                                "text": "Pot-plants on spindle-legged stands lurked in wait for an incautious gesture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7868abf2-ee06-4f63-bf12-57d6a9af9071",
                        "source_entry_id": "ca1378a3-6499-31a3-b2db-0024852944d7",
                        "source_sense_id": "ba9bee66-6197-3dbd-9eef-f5f99ae51427",
