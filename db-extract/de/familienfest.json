                "senses": [
                    {
                        "sense_id": "b0c8d217-2e36-3cf7-8100-14529387b24d",
                        "entry_id": "5b0735b8-5169-3e72-a0db-86d2dc1823fb",
                        "glosses": [
                            "Fest, das aus einem familiären Anlass stattfindet und an dem vor allem Mitglieder einer Familie teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129cae91-4484-40ab-b6ed-ee564312b710",
                                "sense_id": "b0c8d217-2e36-3cf7-8100-14529387b24d",
                                "text": "„Auch der Ausrufung der Republik und der Loslösung von Spanien im Jahr 1640 kann nicht mehr, wie es der Tradition entspricht, mit Familienfesten und einer größeren Siesta gedacht werden.“"
                            },
                            {
                                "example_id": "4ad7a134-4d70-4087-a6dd-c1ebb1d01ce7",
                                "sense_id": "b0c8d217-2e36-3cf7-8100-14529387b24d",
                                "text": "„Der Saal wurde nur bei großen Familienfesten genutzt; in den Wochen vor der Flucht diente er dann als Vorrats- und Wirtschaftsraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
