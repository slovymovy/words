                ],
                "senses": [
                    {
                        "sense_id": "7cd9a4bc-1682-35a6-bf00-e8cfa3e47c7a",
                        "entry_id": "e9234aa4-66c5-3e80-bad4-267bf56b0af0",
                        "glosses": [
                            "ein Mitglied der Familie der Adenoviridae; Erreger von unter anderem Erkrankungen der Atemwege; unbehülltes DNA-Virus"
                        ],
                        "tags": [
                            "Virologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cf055320-d6b7-4389-916b-01bd5ea37ab8",
                                "sense_id": "7cd9a4bc-1682-35a6-bf00-e8cfa3e47c7a",
                                "text": "Man kann seinen Hund gegen respiratorische Erkrankungen impfen lassen, die durch das canine Adenovirus Typ 2 verursacht werden."
                            },
                            {
                                "example_id": "a6bc9cce-4659-4a11-8406-157f1652f8e1",
                                "sense_id": "7cd9a4bc-1682-35a6-bf00-e8cfa3e47c7a",
                                "text": "Die unbehüllten Adenoviren sind relativ resistent gegenüber Umwelteinflüssen, sterben aber bei 60°C ab."
                            },
                            {
                                "example_id": "0ae5479a-7660-4e56-a808-404f361f6a38",
                                "sense_id": "7cd9a4bc-1682-35a6-bf00-e8cfa3e47c7a",
                                "text": "„So wird der Impfstoff in zwei Dosen verabreicht, die sogenannte Adenoviren enthalten. Diese Viren dienen als Verpackung - man sagt auch Vektor - für Informationen über den eigentlichen Gegner, das Coronavirus.“"
                            },
                            {
                                "example_id": "9a864c6a-9734-406a-80ac-49d712907c19",
                                "sense_id": "7cd9a4bc-1682-35a6-bf00-e8cfa3e47c7a",
                                "text": "„Adenoviren sind eine Art von Viren, die eine Erkältung verursachen – sie sind also wegen ihres milden Infektionsverlaufs gut geeignet, um ein fremdes Protein in den Menschen zu transportieren.“"
                            },
                            {
                                "example_id": "264417c5-d803-4b44-b300-069815841b46",
                                "sense_id": "7cd9a4bc-1682-35a6-bf00-e8cfa3e47c7a",
                                "text": "Gegen humane Adenoviren haben viele Menschen bereits Antikörper entwickelt. Deshalb wird in Corona-Impfstoffen ein Schimpansen-Adenovirus als Vektor verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
