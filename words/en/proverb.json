                },
                {
                    "sense_id": "3a0d66b4-abf8-370e-a2b4-ae3b04779b7f",
                    "sense_definition": "To be mentioned or described in a common saying.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>proverbed</w> for his foolishness in every town.",
                            "target_lang_translations": {
                                "cs": "V každém městě se kvůli své pošetilosti <w>stal příslovím</w>."
                            }
                        },
                        {
                            "text": "The traitor was <w>proverbed</w> as a warning to others.",
                            "target_lang_translations": {
                                "cs": "Zrádce <w>vešel do přísloví</w> jako výstraha ostatním."
                            }
