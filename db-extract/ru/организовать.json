                "translations": [
                    {
                        "translation_id": "0693174a-dac8-4079-a7e6-32061a45a9a3",
                        "source_entry_id": "df781673-146d-378d-9d26-d491ff44d73d",
                        "source_sense_description": "создавать (создать), основывать",
                        "target_lang_word": "organize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cefa6e29-378c-395a-ae8e-bceeff502f75",
                                        "entry_id": "15611a5a-163e-3fae-911a-48e68f6f9625",
                                        "glosses": [
                                            "To arrange in working order."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d0c4ea7-71b4-4cf4-a2bc-b79773347e48",
                                                "sense_id": "cefa6e29-378c-395a-ae8e-bceeff502f75",
                                                "text": "Multiple bits moving in macroprocess join triplet macrounits which logically organize information networks encoding units in structures enclosing triplet code."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b732a84c-15a3-3537-b4ce-da7963d74fe9",
                                        "entry_id": "15611a5a-163e-3fae-911a-48e68f6f9625",
                                        "glosses": [
                                            "To constitute in parts, each having a special function, act, office, or relation; to systematize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "936daf05-0006-4e7e-943f-ae5d3f7bf721",
                                                "sense_id": "b732a84c-15a3-3537-b4ce-da7963d74fe9",
                                                "text": "This original and supreme will organizes the government."
                                            },
                                            {
                                                "example_id": "326b1cea-29e7-46c5-a4dc-f688933320e2",
                                                "sense_id": "b732a84c-15a3-3537-b4ce-da7963d74fe9",
                                                "text": "With Arthur it was clearly the Falklands factor writ large. Actions such as organizing and building the Wansdyke or Cadbury 11 (the refortification) would have strengthened the authority and extended the power of whichever king was the organizer."
                                            },
                                            {
                                                "example_id": "5da467e0-2bba-43cd-a15e-ae2bc9e6d9a4",
                                                "sense_id": "b732a84c-15a3-3537-b4ce-da7963d74fe9",
                                                "text": "Ms. Crabapple did a lot of posing in bikinis, and less, to pay her way through F.I.T.; in addition to showing in fine art galleries and drawing comics, she organizes events she calls Dr. Sketchy’s, a life drawing class that’s also a burlesque show with music, costumes and seminudity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb2ba42-b934-34b1-b558-a89716f703c4",
                                        "entry_id": "15611a5a-163e-3fae-911a-48e68f6f9625",
                                        "glosses": [
                                            "To furnish with organs; to give an organic structure to; to endow with capacity for the functions of life"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3806fa17-b8e0-401e-8060-28909f02857e",
                                                "sense_id": "0cb2ba42-b934-34b1-b558-a89716f703c4",
                                                "text": "an organized being"
                                            },
                                            {
                                                "example_id": "6324906a-1089-49b9-9c10-e5468c2443ed",
                                                "sense_id": "0cb2ba42-b934-34b1-b558-a89716f703c4",
                                                "text": "organized matter"
                                            },
                                            {
                                                "example_id": "92c75ca0-69b0-4e2d-819b-68a56ef9d84d",
                                                "sense_id": "0cb2ba42-b934-34b1-b558-a89716f703c4",
                                                "text": "These nobler faculties in the mind of man, […] matter organized could never produce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9194495b-aa91-33ae-a7ec-8b59c8da681e",
                                        "entry_id": "15611a5a-163e-3fae-911a-48e68f6f9625",
                                        "glosses": [
                                            "To sing in parts."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "304ae7ed-c329-45d5-953b-0bc542b95073",
                                                "sense_id": "9194495b-aa91-33ae-a7ec-8b59c8da681e",
                                                "text": "to organize an anthem"
                                            },
                                            {
                                                "example_id": "835ab8f5-4c24-4712-8087-fea77145229e",
                                                "sense_id": "9194495b-aa91-33ae-a7ec-8b59c8da681e",
                                                "text": "Formerly , those Catholic priests who sung in parts : so to sing , was to organize"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25030a35-a5f7-38ad-94f7-06d680df7e74",
                                        "entry_id": "15611a5a-163e-3fae-911a-48e68f6f9625",
                                        "glosses": [
                                            "To band together into a group or union that can bargain and act collectively; to unionize."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
