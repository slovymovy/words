            "senses": [
                {
                    "sense_id": "9bff92c4-8588-380f-8b51-890c828f50e5",
                    "sense_definition": "langwerpig, zakvormig net op hoepels om vissen of vogels mee te vangen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vangnet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser haalde 's ochtends vroeg zijn <w>fuik</w> uit het water vol met paling.",
                            "target_lang_translations": {
                                "en": "Early in the morning, the fisherman pulled his <w>fyke net</w> from the water, full of eels."
                            }
                        },
                        {
                            "text": "Ze hebben een grote <w>fuik</w> geplaatst bij de smalle doorgang van de rivier.",
                            "target_lang_translations": {
                                "en": "They placed a large <w>fish trap</w> at the narrow passage of the river."
                            }
                        }
                    ],
                    "synonyms": [
                        "puikel"
                    ],
                    "common_phrases": [
                        "in de fuik lopen"
                    ],
                    "target_lang_definitions": {
                        "en": "an elongated, bag-shaped net mounted on hoops used for catching fish or birds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fyke",
                                "target_lang_sense_clarification": "bag-shaped fish trap on hoops"
                            },
                            {
                                "target_lang_word": "fyke net",
                                "target_lang_sense_clarification": "fishing gear"
                            },
                            {
                                "target_lang_word": "fish trap",
                                "target_lang_sense_clarification": "general trap for fish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4b7f781-b0d5-3bf1-b4fb-10f9986c7e12",
                    "sense_definition": "situatie waaruit men niet meer kan ontsnappen; hinderlaag of controlefuik van de politie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "valstrik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie zette een <w>fuik</w> op langs de snelweg om beschonken automobilisten te controleren.",
                            "target_lang_translations": {
                                "en": "The police set up a <w>roadblock</w> along the highway to check for drunk drivers."
                            }
                        },
                        {
                            "text": "Door de onverwachte controle reed de verdachte regelrecht in de <w>fuik</w>.",
                            "target_lang_translations": {
                                "en": "Due to the unexpected checkpoint, the suspect drove straight into the <w>trap</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een fuik opzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "an inescapable trap or situation; a police roadblock or checkpoint designed to funnel traffic"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roadblock",
                                "target_lang_sense_clarification": "police checkpoint or bottleneck"
                            },
                            {
                                "target_lang_word": "trap",
                                "target_lang_sense_clarification": "inescapable situation or ambush"
                            },
                            {
                                "target_lang_word": "police trap",
                                "target_lang_sense_clarification": "checkpoint used to catch offenders"
                            }
                        ]
                    }
                }
            ]
        }
    ]
