    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47318fe7-2e5c-37b2-94df-752e532329c4",
                    "sense_definition": "The period of time during which a computer program is executing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application encountered a critical error during <w>runtime</w> and had to close immediately.",
                            "target_lang_translations": {
                                "ru": "Приложение столкнулось с критической ошибкой во <w>время выполнения</w> и было немедленно закрыто."
                            }
                        },
                        {
                            "text": "You can adjust the settings to improve the <w>runtime</w> performance of the software.",
                            "target_lang_translations": {
                                "ru": "Вы можете изменить настройки, чтобы улучшить производительность программного обеспечения в <w>рантайме</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "execution time"
                    ],
                    "antonyms": [
                        "compile time",
                        "downtime"
                    ],
                    "common_phrases": [
                        "runtime error",
                        "runtime environment",
                        "runtime performance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, в течение которого выполняется компьютерная программа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время выполнения",
                                "target_lang_sense_clarification": "период работы программы"
                            },
                            {
                                "target_lang_word": "рантайм",
                                "target_lang_sense_clarification": "профессиональный жаргонизм, обозначающий время исполнения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e2ceec9-65d9-3650-b36f-ea1843466be0",
                    "sense_definition": "Relating to the period of time when a program is running.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>runtime</w> environment must be properly configured before you can launch the application.",
                            "target_lang_translations": {
                                "ru": "<w>Среда выполнения</w> должна быть правильно настроена перед запуском приложения."
                            }
                        },
                        {
                            "text": "We need to handle <w>runtime</w> exceptions to prevent the system from crashing.",
                            "target_lang_translations": {
                                "ru": "Нам нужно обрабатывать исключения <w>времени выполнения</w>, чтобы предотвратить сбой системы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "runtime library",
                        "runtime check",
                        "runtime exception"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к периоду времени, когда программа запущена и работает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "времени выполнения",
                                "target_lang_sense_clarification": "происходящий во время работы"
                            },
                            {
                                "target_lang_word": "исполняемый",
                                "target_lang_sense_clarification": "относящийся к среде исполнения"
                            }
                        ]
                    }
                }
            ]
        }
