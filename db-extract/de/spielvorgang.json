                ],
                "senses": [
                    {
                        "sense_id": "375c7279-8ec0-3703-9633-08adda0a4212",
                        "entry_id": "3e2732ef-7a07-3963-b769-c725b2c77e38",
                        "glosses": [
                            "Ablauf, Prozess eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e91b0f8-60c6-4ef2-b708-4e4996892bd9",
                                "sense_id": "375c7279-8ec0-3703-9633-08adda0a4212",
                                "text": "„Wiederum real erscheint der Spielvorgang, bei dem der Spieler Tasten betätigt, auf Reize reagiert.“"
                            },
                            {
                                "example_id": "36d8dbba-86da-4b54-b6ce-c80adba44ed9",
                                "sense_id": "375c7279-8ec0-3703-9633-08adda0a4212",
                                "text": "„Jeder der Spieler kann durch Klopfen auf den Tisch den Spielvorgang stoppen und das Aufdecken der letzten Karte verlangen,“"
                            },
                            {
                                "example_id": "5e3aa26f-a130-4dd1-bf04-717c4adecbe2",
                                "sense_id": "375c7279-8ec0-3703-9633-08adda0a4212",
                                "text": "„Durch allerlei Varianten des antiken oder Elisabethanischen Theaters versuchten sie, den Spielvorgang in den Zuschauerraum vorzuziehen – bis zu dem äußersten Extrem eben des Mobiltheaters […], einer Halle mit nichts mehr als einer technifizierten Decke und einem Boden aus vielen, unabhängig voneinander beweglichen Podien, in der jede beliebige Zuordnung von Akteuren und Spektateuren […] herstellbar ist.“"
                            },
                            {
                                "example_id": "3870cd57-5e6f-45df-9b59-6e9b2d5f1b2c",
                                "sense_id": "375c7279-8ec0-3703-9633-08adda0a4212",
                                "text": "„Versucht man nämlich, Becketts Endspiel ohne metaphysischen Ballast, als Folge bloßer Spielvorgänge zu inszenieren, zählt nur noch eines: die Kraft der Details.“"
                            },
                            {
                                "example_id": "875a7b74-8eef-448d-a73f-a7eea88ef80d",
                                "sense_id": "375c7279-8ec0-3703-9633-08adda0a4212",
                                "text": "„Sie besagen, daß der Einsatz für je einen Spielvorgang zehn Pfennig, der Höchstgewinn neunzig Pfennig plus Einsatz beträgt, daß auf vier verlorene Spiele ein Gewinn kommen muß und für eine Mark Einsatz nicht weniger als sechzig Pfennig als Auszahlung in die Münzschale klimpern dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
