                                        "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                        "entry_id": "e8a171e6-e9aa-3218-8014-1be8ba5cde51",
                                        "glosses": [
                                            "A person who studies, professes or practices climatology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005c4aaa-1bab-4b52-8ffc-586eee8a9a9b",
                                                "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                                            },
                                            {
                                                "example_id": "a593e730-ae90-43c9-9390-af4e02535adc",
                                                "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                                "text": "“The lack of an agreement to phase out fossil fuels was devastating,” said Prof Michael Mann, a climatologist and geophysicist at the University of Pennsylvania in the US."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2981ecf0-c7fd-45c0-bb5a-2e8dbfb965be",
                        "source_entry_id": "d5c7eb70-8c4b-3901-9697-abda4190f32b",
                        "source_sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                        "source_sense_description": "Forscher, der sich mit den Gesetzmäßigkeiten des Klimas und seinen Veränderungen im Zeitverlauf beschäftigt",
                        "target_lang_word": "climatologue",
