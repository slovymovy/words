                        "glosses": [
                            "The state of being impolite; incivility; rudeness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c7f1d59-f56e-4039-afc1-50bb1f3bc68a",
                        "source_entry_id": "6817513e-ad1a-362e-b5b6-1090276778e5",
                        "source_sense_id": "179cb563-8de0-3f96-82f8-2cdd133aeaa1",
                        "source_sense_description": "state of being impolite",
                        "target_lang_word": "impolitesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impolitesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64e529e2-f9dd-37b7-a45a-9500a3604f62",
                                        "entry_id": "7aaa89fe-688d-3940-a75d-19df2c59964b",
                                        "glosses": [
                                            "Manque de politesse, ignorance ou mépris des règles de la politesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef4b413-579a-4825-9487-c22fc158e9c1",
                                                "sense_id": "64e529e2-f9dd-37b7-a45a-9500a3604f62",
                                                "text": "L’infatuation et le manque d’éducation sont les sources ordinaires de l’impolitesse."
                                            },
                                            {
                                                "example_id": "a5344b7d-1b17-4110-9dfb-3e8b1cd2f5d8",
                                                "sense_id": "64e529e2-f9dd-37b7-a45a-9500a3604f62",
                                                "text": "N’êtes- vous pas choqué de son impolitesse ? Cette réponse est d’une impolitesse grossière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c239db74-f955-34a7-aa3a-287f97d4bb58",
                                        "entry_id": "7aaa89fe-688d-3940-a75d-19df2c59964b",
                                        "glosses": [
                                            "Action, procédé contraire à la politesse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c08bdb-e4aa-4e3f-8018-867c11d386ec",
                                                "sense_id": "c239db74-f955-34a7-aa3a-287f97d4bb58",
                                                "text": "… ; il poussa même l’impolitesse jusqu'à planter là ces dames pour se mettre à la recherche de la maîtresse de maison et de sa fille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6137dd2-7404-47fd-9350-bbf517bbdf31",
                        "source_entry_id": "6817513e-ad1a-362e-b5b6-1090276778e5",
                        "source_sense_id": "179cb563-8de0-3f96-82f8-2cdd133aeaa1",
                        "source_sense_description": "state of being impolite",
                        "target_lang_word": "Unhöflichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unhöflichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54246925-5088-38f9-9903-3b41dfc2114b",
                                        "entry_id": "866df846-8b1e-3ab0-9544-66d10934914d",
                                        "glosses": [
                                            "ungesittetes, beleidigendes oder unangebrachtes Verhalten"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "221c2586-d6ed-41cc-9caf-cae17e2f1e08",
                                                "sense_id": "54246925-5088-38f9-9903-3b41dfc2114b",
                                                "text": "Seine Unhöflichkeit war ausschlaggebend für das Scheitern der Verträge."
                                            },
                                            {
                                                "example_id": "7112e57d-b197-4aa0-8b76-2bee12503f16",
                                                "sense_id": "54246925-5088-38f9-9903-3b41dfc2114b",
                                                "text": "„Wie bereits erwähnt, grenzt sich Unhöflichkeit von Aggression durch die fehlende oder zumindest nicht deutlich erkennbare Intention ab, dem Opfer Schaden zufügen zu wollen.“"
                                            },
                                            {
                                                "example_id": "440b3959-1f6a-45ab-8fb1-f053f4055424",
                                                "sense_id": "54246925-5088-38f9-9903-3b41dfc2114b",
                                                "text": "„So verstrich eine Weile, ohne daß er sich der Unhöflichkeit bewußt wurde, den Maler in dem Vorraum warten zu lassen, wo man ihm einen Hocker angewiesen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7fd4483c-0ccd-3176-8bc1-912eb4fe7cea",
                                        "entry_id": "866df846-8b1e-3ab0-9544-66d10934914d",
                                        "glosses": [
                                            "würdelose Handlung oder Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bff76d9b-de4b-4769-aa70-c308c51c1910",
                                                "sense_id": "7fd4483c-0ccd-3176-8bc1-912eb4fe7cea",
                                                "text": "„Unhöflichkeiten werden abgebogen, indem man nicht darauf reagiert.“"
                                            },
                                            {
                                                "example_id": "7391cec5-d181-48b5-88ec-798be78b7b90",
                                                "sense_id": "7fd4483c-0ccd-3176-8bc1-912eb4fe7cea",
                                                "text": "„Bevor ich mich zu weiteren Unhöflichkeiten hinreißen lassen konnte, verabschiedeten Kathrin und ich uns von Oma und zogen los.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
