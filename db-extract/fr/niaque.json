                                "target_senses": [
                                    {
                                        "sense_id": "7e7ff3e8-f96f-3a5d-8f61-1d67ab77563c",
                                        "entry_id": "15b5fd40-cff7-34c7-bacf-3114faaaad1e",
                                        "glosses": [
                                            "der Vorgang des Beißens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad8aba56-8bcd-4432-9186-900f88990a11",
                                                "sense_id": "7e7ff3e8-f96f-3a5d-8f61-1d67ab77563c",
                                                "text": "Der Biss des Hundes tat sehr weh."
                                            },
                                            {
                                                "example_id": "48e57b15-c49a-4524-972a-4a616ae831fe",
                                                "sense_id": "7e7ff3e8-f96f-3a5d-8f61-1d67ab77563c",
                                                "text": "„Bitte senden Sie mir eine Liste aller Ärzte in Australien, die Gegengift gegen den Biss von Klapperschlangen vorrätig haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d3883b9-1550-3ac0-ad8a-69bbd37fe6ff",
                                        "entry_id": "15b5fd40-cff7-34c7-bacf-3114faaaad1e",
                                        "glosses": [
                                            "Wundstelle, Wundmal, die durch das Beißen entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "043b5f03-b0cf-4882-a4a4-391a2c92b073",
                                                "sense_id": "9d3883b9-1550-3ac0-ad8a-69bbd37fe6ff",
                                                "text": "Hier kannst du den Biss immer noch gut sehen, obwohl er schon eine Woche alt ist."
                                            },
                                            {
                                                "example_id": "c7fa0722-8412-4afc-967b-fb4093f7facf",
                                                "sense_id": "9d3883b9-1550-3ac0-ad8a-69bbd37fe6ff",
                                                "text": "Der Biss hatte sich dann relativ schnell entzündet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d505b1e-62a8-345e-a333-191308d70123",
                                        "entry_id": "15b5fd40-cff7-34c7-bacf-3114faaaad1e",
                                        "glosses": [
                                            "ein stechender Schmerz"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aff332c-ab03-4afa-9894-738e1adfd383",
                                                "sense_id": "1d505b1e-62a8-345e-a333-191308d70123",
                                                "text": "Der Biss, den sie in ihrem Gewissen verspürte, brachte auch ein leichtes Ekelgefühl mit sich, das sich langsam in ihrem ganzen Körper ausbreitete."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "709f2019-8d56-3e8d-8508-d893d55c6bcf",
                                        "entry_id": "15b5fd40-cff7-34c7-bacf-3114faaaad1e",
                                        "glosses": [
                                            "direkte, zupackende Art oder Haltung, die auch verletzend wirken kann"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf1bc25-9518-4403-8148-94e24e681fb4",
                                                "sense_id": "709f2019-8d56-3e8d-8508-d893d55c6bcf",
                                                "text": "Der von ihm erzählte Witz hatte echt Biss! Ich verstehe, wenn sich jemand angegriffen fühlte."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2d525da8-ba4d-3ce5-b2a0-85393ea670fe",
                                        "entry_id": "15b5fd40-cff7-34c7-bacf-3114faaaad1e",
                                        "glosses": [
                                            "Bereitschaft zum vollen Einsatz"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1f59ca6-2ebb-41a6-a11d-c8421441c1db",
                                                "sense_id": "2d525da8-ba4d-3ce5-b2a0-85393ea670fe",
                                                "text": "Der Spieler ist kaum zu gebrauchen, denn er spielt ohne Biss."
                                            },
                                            {
                                                "example_id": "fbc387d7-f36c-4a92-8ef2-82461dd4508f",
                                                "sense_id": "2d525da8-ba4d-3ce5-b2a0-85393ea670fe",
                                                "text": "Der Junge hat einfach Biss, aus dem wird mal was, das ist schon jetzt klar."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aef74309-6f68-4061-a1f0-6b0bfecfb641",
                        "source_entry_id": "5cf166b8-9b82-39af-8f90-3c4c080a5693",
                        "source_sense_id": "4a07a01f-87a4-3d7a-a210-ca6a2308f084",
                        "source_sense_description": "umgangssprachlich: Biss, Kampfgeist, Siegeswille",
                        "target_lang_word": "Kampfgeist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kampfgeist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                        "entry_id": "bb8fa142-47c9-39b7-8d5f-7fab8faa082b",
                                        "glosses": [
                                            "Bereitschaft, zu kämpfen/sich zu wehren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c784d1-3789-40ea-96ec-f889d4e2342f",
                                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                                "text": "„Seit der große Fisch im seichten Wasser war, hatte er das letzte bißchen Kampfgeist verloren.“"
                                            },
                                            {
                                                "example_id": "bf86e80e-3230-4969-8da9-1d69d1b45675",
                                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                                "text": "„Mit einem eindringlichen Appell an den Kampfgeist seiner Partei hat Gerhard Schröder die SPD auf die heiße Phase des Wahlkampfs eingeschworen.“"
                                            },
                                            {
                                                "example_id": "9e729543-7f50-4619-b88e-46b9aa2ab9ab",
                                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                                "text": "„Wladimir Klitschko hat seinen Kampfgeist zurückgewonnen und eine Revanche gegen seinen Bezwinger Tyson Fury angekündigt.“"
                                            },
                                            {
                                                "example_id": "81b68358-8e98-4c0a-bc5f-0901ec221f4b",
                                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                                "text": "„Ohne Rücksicht auf seine eigene Sicherheit hat er sich einer überwältigenden Übermacht gestellt, und er hat aus reiner Willenskraft und aufgrund seines Kampfgeistes und Mutes gewonnen.“"
                                            },
                                            {
                                                "example_id": "bd3ee5eb-585c-4203-b4bc-80b9686c0b2a",
                                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                                "text": "„Er kämpfte am Platz um jeden Punkt und speziell am Sandplatz machte er mit seinem Kampfgeist die Gegner mürbe. Jeder Punkt musste gegen ihn zwei Mal gemacht werden. Er schaffte schon aussichtslose Spiele nach Rückstand von 2 Sätzen zu gewinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e84503b-3e66-4008-abd6-4034ae49e70d",
                        "source_entry_id": "5cf166b8-9b82-39af-8f90-3c4c080a5693",
