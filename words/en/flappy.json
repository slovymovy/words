                        "loose",
                        "floppy"
                    ],
                    "antonyms": [
                        "tight",
                        "fitted"
                    ],
                    "common_phrases": [
                        "flappy ears",
                        "flappy wings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный развеваться или свободно двигаться на ветру."
                    },
                    "translations": {
