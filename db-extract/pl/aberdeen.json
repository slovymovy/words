                                    {
                                        "sense_id": "6e0308c3-c775-3e97-b817-a391d9c360ab",
                                        "entry_id": "972f2c53-6e52-3b8f-a965-67cc76116544",
                                        "glosses": [
                                            "eine Stadt im Osten von Schottland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a9046e-b576-407e-bf92-3ce1a0e81dd8",
                                                "sense_id": "6e0308c3-c775-3e97-b817-a391d9c360ab",
                                                "text": "Viele Leute in Aberdeen arbeiten auf Bohrinseln in der Nordsee."
                                            },
                                            {
                                                "example_id": "7c65a058-0201-4159-9a15-7cb75498375a",
                                                "sense_id": "6e0308c3-c775-3e97-b817-a391d9c360ab",
                                                "text": "Aberdeen ist einer der am östlichsten gelegenen Städte in Schottland."
                                            },
                                            {
                                                "example_id": "b308b953-e587-4ac8-9ae1-03cba298faf0",
                                                "sense_id": "6e0308c3-c775-3e97-b817-a391d9c360ab",
                                                "text": "Westlich von Aberdeen befinden sich die Grampian Mountains."
                                            },
                                            {
                                                "example_id": "85318ef4-4f31-4258-beaf-5d1ce63d351d",
                                                "sense_id": "6e0308c3-c775-3e97-b817-a391d9c360ab",
                                                "text": "„Schon vor einigen Jahrzehnten vermutete die Fachwelt, dass die Holzfragmente in Aberdeen schlummern, doch das Universitätsmuseum konnte die Stücke nicht ausfindig machen.“"
                                            }
                                        ],
