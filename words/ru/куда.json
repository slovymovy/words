                        "zh": "男性名字。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Kuda",
                                "target_lang_sense_clarification": "person's name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "库达",
                                "target_lang_sense_clarification": "人名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}