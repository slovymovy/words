                        "examples": [
                            {
                                "example_id": "3ff91b9e-49c9-43d7-b874-9a6c46e5ca6f",
                                "sense_id": "fea4e26d-11b6-3440-b785-3b0dda1b7475",
                                "text": "„Ein für Elchbullen markantes Geweih hat das Tier nicht. Zudem deute der Körperbau auf eine Elchkuh hin.“"
                            },
                            {
                                "example_id": "969d114b-8ceb-4d81-8b6d-35f22164bab6",
                                "sense_id": "fea4e26d-11b6-3440-b785-3b0dda1b7475",
                                "text": "„Dann stellte sich die Elchkuh auf die Straße, gefolgt von ihren Kindern, eins davon ein großes Jungtier.“"
                            }
                        ],
