                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des milliers de <w>croyants</w> se rassemblent chaque année pour cette grande cérémonie.",
                            "target_lang_translations": {
                                "en": "Thousands of <w>believers</w> gather every year for this great ceremony.",
                                "ru": "Тысячи <w>верующих</w> собираются каждый год на эту большую церемонию.",
                                "de": "Jedes Jahr versammeln sich Tausende <w>Gläubige</w> zu dieser großen Zeremonie.",
                                "es": "Miles de <w>creyentes</w> se reúnen cada año en esta gran ceremonia.",
                                "zh": "每年都有成千上万名<w>信徒</w>前来参加这场盛大的仪式。"
                            }
                        },
                        {
                            "text": "Le guide spirituel a adressé un message de fraternité à tous les <w>croyants</w>.",
                            "target_lang_translations": {
                                "en": "The spiritual leader sent a message of brotherhood to all <w>believers</w>.",
                                "ru": "Духовный лидер обратился ко всем <w>верующим</w> с посланием о братстве.",
                                "de": "Der geistliche Führer hat sich mit einer Botschaft der Brüderlichkeit an alle <w>Gläubigen</w> gewandt.",
                                "es": "El guía espiritual dirigió un mensaje de fraternidad a todos los <w>creyentes</w>.",
                                "zh": "这位精神领袖向所有<w>信徒</w>发出了一条关于博爱的信息。"
                            }
                        }
                    ],
