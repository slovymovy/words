                "senses": [
                    {
                        "sense_id": "e87e9aab-203c-3d2b-b63d-47544580d824",
                        "entry_id": "342570f4-e83d-389c-9071-6ee89ddf46a6",
                        "glosses": [
                            "wissenschaftlicher Versuch an/mit einem Tier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0789ec-45c1-49fc-9097-a08dc9b187c0",
                                "sense_id": "e87e9aab-203c-3d2b-b63d-47544580d824",
                                "text": "„Im Tierexperiment mit Mäusen läßt sich tatsächlich nachweisen, daß bei moderater Belastung die Abwehrkraft gegen Viren gesteigert wird.“"
                            },
                            {
                                "example_id": "6b91ad73-35be-49c1-9291-b6aabca6c6dd",
                                "sense_id": "e87e9aab-203c-3d2b-b63d-47544580d824",
                                "text": "„US-Forschern ist es im Tierexperiment gelungen, Tinnitus zu heilen.“"
                            },
                            {
                                "example_id": "a240d482-e004-472c-a783-a473f2856e0c",
                                "sense_id": "e87e9aab-203c-3d2b-b63d-47544580d824",
                                "text": "„In der Wissenschaftsgemeinde spricht man gerne von einer ‚vernünftigen Tierversuchsnutzung‘, um klar zu machen, dass man die Zahl der nötigen Tierexperimente niedrig halten will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
