                        "entry_id": "4f7ce00e-0e90-3931-b2ad-168f06fe269d",
                        "glosses": [
                            "муз. записывать (записать), оформлять (оформить) для исполнения определённым составом инструментов, ансамблем, хором (о музыкальном произведении)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8c2ef6-bf10-4b7a-999c-012d70d517bd",
                                "sense_id": "d360b444-3c41-306a-811b-2c0c67eb2365",
                                "text": "Для концертов в Лондоне он инструментировал оркестровое сопровождение к балладе Уланда «Могила отцов»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db46ae8e-25d7-4e0a-aab4-b8c92ba68fef",
