                        "glosses": [
                            "Toxine sécrétée par un microorganisme et relâchée lors de la lyse cellulaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efca56bf-80f1-46bb-ae2c-49da54f3207b",
                                "sense_id": "46df21f1-4d5a-3e6f-b79f-25326c4b46a5",
                                "text": "L’exposition à des composants de la paroi cellulaire des bactéries gram négatif, tels que l’endotoxine, a été proposée pour expliquer le rôle protecteur des infections dans le développement de l’asthme et des allergies."
                            }
                        ]
                    }
                ],
