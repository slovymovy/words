{
    "word_family": [
        "cordage",
        "corded",
        "cording",
        "cordless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b414c3cf-510e-3aa2-a906-ce4822f0bd85",
                    "sense_definition": "A long, thin, flexible length of twisted strands of fiber, such as a rope or string.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "string_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The burglar tied up the victim with a <w>cord</w>.",
                            "target_lang_translations": {
                                "ru": "Грабитель связал жертву <w>веревкой</w>.",
                                "zh": "窃贼用一根<w>绳子</w>把受害者绑了起来。"
                            }
                        },
                        {
                            "text": "She used a strong nylon <w>cord</w> to secure the heavy package.",
                            "target_lang_translations": {
                                "ru": "Она использовала прочный нейлоновый <w>шнур</w>, чтобы закрепить тяжелую посылку.",
                                "zh": "她用一根结实的尼龙<w>绳</w>把沉重的包裹固定住了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cable",
                        "twine",
                        "cordage"
                    ],
                    "common_phrases": [
                        "nylon cord",
                        "strong cord",
                        "length of cord"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный, тонкий, гибкий отрезок скрученных волокон, такой как веревка или бечевка.",
                        "zh": "由纤维绞成的细长、柔软的一段绳状物，如绳子或线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шнур",
                                "target_lang_sense_clarification": "тонкая крученая веревка"
                            },
                            {
                                "target_lang_word": "веревка",
                                "target_lang_sense_clarification": "изделие из сплетенных волокон"
                            },
                            {
                                "target_lang_word": "шнурок",
                                "target_lang_sense_clarification": "тонкий шнур"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绳子",
                                "target_lang_sense_clarification": "细长而柔软的绳子"
                            },
                            {
                                "target_lang_word": "绳",
                                "target_lang_sense_clarification": "较细的绳或线"
                            },
                            {
                                "target_lang_word": "细绳",
                                "target_lang_sense_clarification": "细绳，常用于捆绑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d60f61c-ad32-35b5-978f-0948de03830c",
                    "sense_definition": "A flexible electrical wire or cable used to connect an appliance to a power supply.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "electrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pull the power <w>cord</w> out of the wall socket before cleaning the machine.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вытащите <w>шнур</w> питания из розетки перед чисткой машины.",
                                "zh": "清洁机器前，请先把电源<w>线</w>从墙上的插座里拔出来。"
                            }
                        },
                        {
                            "text": "The lamp has a very short <w>cord</w> so it must stay near the desk.",
                            "target_lang_translations": {
                                "ru": "У лампы очень короткий <w>провод</w>, поэтому она должна стоять рядом со столом.",
                                "zh": "这盏灯的<w>电线</w>很短，所以只能放在桌子附近。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cable",
                        "flex"
                    ],
                    "common_phrases": [
                        "power cord",
                        "extension cord",
                        "unplug the cord"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гибкий электрический провод или кабель, используемый для подключения прибора к источнику питания.",
                        "zh": "用于把电器连接到电源的柔性电线或电缆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шнур",
                                "target_lang_sense_clarification": "электрический провод в изоляции"
                            },
                            {
                                "target_lang_word": "провод",
                                "target_lang_sense_clarification": "электротехническое изделие для тока"
                            },
                            {
                                "target_lang_word": "кабель",
                                "target_lang_sense_clarification": "изолированные проводники в оболочке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电线",
                                "target_lang_sense_clarification": "连接电器与电源的线"
                            },
                            {
                                "target_lang_word": "电源线",
                                "target_lang_sense_clarification": "尤指设备的供电线"
                            },
                            {
                                "target_lang_word": "线",
                                "target_lang_sense_clarification": "较口语的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62e66051-513d-3a32-8b93-7b54ef6086b9",
                    "sense_definition": "An anatomical structure that resembles a rope, such as a tendon, nerve, or the spinal column.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that the spinal <w>cord</w> transmits signals between the brain and the body.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что спинной <w>мозг</w> передает сигналы между мозгом и телом.",
                                "zh": "医生解释说，<w>脊髓</w>负责在大脑和身体之间传递信号。"
                            }
                        },
                        {
                            "text": "The singer had to rest because her vocal <w>cords</w> were strained.",
                            "target_lang_translations": {
                                "ru": "Певице пришлось отдохнуть, потому что ее голосовые <w>связки</w> были перенапряжены.",
                                "zh": "那位歌手不得不休息，因为她的<w>声带</w>劳损了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spinal cord",
                        "vocal cords",
                        "umbilical cord"
                    ],
                    "target_lang_definitions": {
                        "ru": "Анатомическая структура, напоминающая веревку, такая как сухожилие, нерв или позвоночный столб.",
                        "zh": "一种像绳索的解剖结构，如脊髓、声带或脐带等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канатик",
                                "target_lang_sense_clarification": "анатомический тяж"
                            },
                            {
                                "target_lang_word": "связка",
                                "target_lang_sense_clarification": "голосовая связка"
                            },
                            {
                                "target_lang_word": "хорда",
                                "target_lang_sense_clarification": "анатомическая струна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脊髓",
                                "target_lang_sense_clarification": "spinal cord"
                            },
                            {
                                "target_lang_word": "声带",
                                "target_lang_sense_clarification": "vocal cords"
                            },
                            {
                                "target_lang_word": "脐带",
                                "target_lang_sense_clarification": "umbilical cord"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20556bc7-3671-32b6-aba8-8a4fc53f5aaa",
                    "sense_definition": "A metaphorical influence or emotional bond that holds or draws people together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_bond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thousand <w>cords</w> of memory and affection drew him back to his childhood home.",
                            "target_lang_translations": {
                                "ru": "Тысячи <w>нитей</w> памяти и привязанности тянули его обратно в дом детства.",
                                "zh": "无数记忆与情感的<w>丝线</w>把他牵回了童年的家。"
                            }
                        },
                        {
                            "text": "The <w>cords</w> of friendship remained strong even after many years apart.",
                            "target_lang_translations": {
                                "ru": "<w>Узы</w> дружбы оставались крепкими даже спустя много лет разлуки.",
                                "zh": "即使分开多年，友谊的<w>纽带</w>依然牢固。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cords of memory",
                        "cords of affection"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метафорическое влияние или эмоциональная связь, которая удерживает или сближает людей.",
                        "zh": "一种比喻性的影响或情感联系，把人维系在一起或吸引到一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узы",
                                "target_lang_sense_clarification": "эмоциональная связь"
                            },
                            {
                                "target_lang_word": "нити",
                                "target_lang_sense_clarification": "метафорическая связь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纽带",
                                "target_lang_sense_clarification": "把人联系在一起的抽象联系"
                            },
                            {
                                "target_lang_word": "丝线",
                                "target_lang_sense_clarification": "文学性说法，指牵系人的感情或记忆"
                            },
                            {
                                "target_lang_word": "牵绊",
                                "target_lang_sense_clarification": "较强调情感上的牵连"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83c9fe44-051a-3347-a064-ae4c188b89eb",
                    "sense_definition": "A unit of measurement for firewood, equal to 128 cubic feet, typically a stack four feet high and eight feet long.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a <w>cord</w> of wood to keep the fireplace burning all winter.",
                            "target_lang_translations": {
                                "ru": "Мы заказали <w>корд</w> дров, чтобы камин горел всю зиму.",
                                "zh": "我们订购了一<w>标准堆</w>木柴，好让壁炉整个冬天都能烧着。"
                            }
                        },
                        {
                            "text": "He spent the afternoon stacking a full <w>cord</w> of birch logs behind the shed.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, укладывая целый <w>корд</w> березовых поленьев за сараем.",
                                "zh": "他花了一下午，把整整一<w>标准堆</w>桦木原木码放在棚子后面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cord of wood",
                        "full cord",
                        "face cord"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения дров, равная 128 кубическим футам (около 3,62 куб. м).",
                        "zh": "柴火的体积单位，等于128立方英尺，通常指高4英尺、长8英尺的一堆木柴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корд",
                                "target_lang_sense_clarification": "мера объема дров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标准堆",
                                "target_lang_sense_clarification": "北美柴火体积单位，约3.62立方米"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d86edb5e-8b31-3416-b3fe-f9067ecc885a",
                    "sense_definition": "A dated spelling of <w>chord</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spelling_variant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some older texts, the musical term is written as <w>cord</w> instead of the modern spelling.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах музыкальный термин пишется как <w>cord</w> вместо современного написания.",
                                "zh": "在一些较早的文本中，这个音乐术语写作<w>cord</w>，而不是现代拼写 chord。"
                            }
                        },
                        {
                            "text": "The author used the archaic <w>cord</w> to refer to the harmony of the strings.",
                            "target_lang_translations": {
                                "ru": "Автор использовал архаичное <w>cord</w>, чтобы обозначить гармонию струн.",
                                "zh": "作者用古旧拼写<w>cord</w>来指弦乐的和声音响。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова chord (аккорд).",
                        "zh": "chord 的旧式拼写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккорд",
                                "target_lang_sense_clarification": "устаревшее написание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "cord",
                                "target_lang_sense_clarification": "旧时将 chord 拼作 cord"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1e77da7-1f98-37d7-b3ce-b52f6963b104",
                    "sense_definition": "To tie, bind, or fasten something using a cord.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers began to <w>cord</w> the bundles of newspapers for recycling.",
                            "target_lang_translations": {
                                "ru": "Рабочие начали <w>связывать</w> пачки газет для переработки.",
                                "zh": "工人们开始用绳子把成捆的报纸<w>捆起来</w>，以便回收。"
                            }
                        },
                        {
                            "text": "He carefully <w>corded</w> the trunk to the roof of the car.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>привязал</w> сундук к крыше машины.",
                                "zh": "他小心地用绳子把箱子<w>绑</w>在车顶上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cord together",
                        "cord tightly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связывать, обвязывать или закреплять что-либо с помощью шнура или веревки.",
                        "zh": "用绳子把某物绑住、系住或固定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "скреплять веревкой"
                            },
                            {
                                "target_lang_word": "обвязывать",
                                "target_lang_sense_clarification": "оборачивать шнуром"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绑",
                                "target_lang_sense_clarification": "用绳子系住或固定"
                            },
                            {
                                "target_lang_word": "捆起来",
                                "target_lang_sense_clarification": "把东西扎紧成束"
                            },
                            {
                                "target_lang_word": "系牢",
                                "target_lang_sense_clarification": "较正式，指用绳系牢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09561ecf-e2ae-32b2-87b5-3413356a8311",
                    "sense_definition": "To stack or arrange wood in piles for measurement by the cord.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wood_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lumberjacks spent the day <w>cording</w> the logs they had cut.",
                            "target_lang_translations": {
                                "ru": "Лесорубы провели день, <w>укладывая</w> в штабели срубленные бревна.",
                                "zh": "伐木工人花了一整天把砍下来的原木<w>码成标准堆</w>。"
                            }
                        },
                        {
                            "text": "It is easier to sell the timber once you <w>cord</w> it properly.",
                            "target_lang_translations": {
                                "ru": "Древесину легче продать, если ее правильно <w>сложить</w>.",
                                "zh": "把木材正确地<w>码成标准堆</w>后，就更容易出售了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cord wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Складывать или укладывать дрова в штабели для измерения в кордах.",
                        "zh": "把木柴堆放整齐，以便按 cord 这一单位计量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складывать в сажени",
                                "target_lang_sense_clarification": "укладывать дрова для замера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "码成标准堆",
                                "target_lang_sense_clarification": "把木柴按 cord 单位码放"
                            },
                            {
                                "target_lang_word": "码堆",
                                "target_lang_sense_clarification": "把木头整齐码放以便计量"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}