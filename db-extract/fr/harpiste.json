        "fr-extract.jsonl": [
            {
                "entry_id": "cc0f9c2a-8c6d-374c-ae68-f6f19ccdda36",
                "word": "harpiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b86cf2a-c80a-4482-a31b-f1a857113239",
                        "entry_id": "cc0f9c2a-8c6d-374c-ae68-f6f19ccdda36",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "harpistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                        "entry_id": "cc0f9c2a-8c6d-374c-ae68-f6f19ccdda36",
                        "glosses": [
                            "Musicien ou musicienne qui joue de la harpe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d67ac98d-f150-4d9c-b61c-bcac91b1893b",
                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                "text": "Les sons d’une harpe retentirent, elle voulut voir la musique ; et bientôt le joueur d’instrument, amené par la négresse, entra dans les Premières. […]. Enfin le harpiste rejeta ses longs cheveux derrière ses épaules, étendit les bras et se mit à jouer."
                            },
                            {
                                "example_id": "61cf45f4-b0d6-44a3-bbb2-ed55fe335ec4",
                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                "text": "Rendez-vous samedi 21 janvier à 16 h pour la lecture musicale du roman par la comédienne Solange Boulanger accompagnée par la harpiste Françoise de Maubus qui vous entraîneront dans l’histoire de Saint-Avit et Morhange."
                            },
                            {
                                "example_id": "9440b3db-31b9-4e99-8e57-85b875b01bd4",
                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                "text": "Quant à la harpiste elle-même, elle ne dépareillait pas en apparaissant dans une robe de concert fendue à mi-cuisse."
                            },
                            {
                                "example_id": "ea377faf-ddad-40bc-b838-eb8a2bce4119",
                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                "text": "Profitez aussi dès 19h30 d’un moment musical dans la Rotonde du musée avec le concert Les cordes de l’âme, donné par le duo de harpistes Véronique Ghesquière et Marta Power, en partenariat avec le conservatoire de Saint-Cloud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "176256a3-b443-42e0-badc-a52dff497600",
                        "source_entry_id": "cc0f9c2a-8c6d-374c-ae68-f6f19ccdda36",
                        "source_sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                        "target_lang_word": "Harfenistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harfenistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb81507c-cbdf-368c-9bff-492de1f38060",
                                        "entry_id": "c1beb34b-a177-3c30-8fff-2330efbaee6b",
                                        "glosses": [
                                            "weibliche Person, die Harfe spielt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4091376-ecc4-4812-be8a-3e4afa7c8d54",
                                                "sense_id": "cb81507c-cbdf-368c-9bff-492de1f38060",
                                                "text": "„Da fiel Sabina ein, daß Jay diese Geschichte kannte und wußte, daß dies von Lillian erzählt wurde; und Lillian hatte nicht als Harfenistin, sondern als Pianistin weitergespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "858e2742-f3df-42bc-a5b8-b42c59a7e40d",
                        "source_entry_id": "cc0f9c2a-8c6d-374c-ae68-f6f19ccdda36",
                        "source_sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                        "target_lang_word": "Harfenist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harfenist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32644bb1-13b4-3865-aeba-b776ff8511a7",
                                        "entry_id": "c4a1ff4f-df57-3e0f-be7c-8a4bc7538eb5",
                                        "glosses": [
                                            "(männliche^☆) Person, die Harfe spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "040a12b6-bed3-4ddc-813c-d263193769e4",
                                                "sense_id": "32644bb1-13b4-3865-aeba-b776ff8511a7",
                                                "text": "Er ist Harfenist bei den Berliner Philharmonikern."
                                            },
                                            {
                                                "example_id": "24213120-1bf2-4821-8638-5a8cf1dbb962",
                                                "sense_id": "32644bb1-13b4-3865-aeba-b776ff8511a7",
                                                "text": "„Georg Friedrich Händel hat zwar nur ein Konzert für Harfe geschrieben. Harfenist Xavier de Maistre widmet sich auf Händel (Sony) dennoch ausschließlich dem barocken Könner, der in London als Opernunternehmer auch einmal pleiteging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
