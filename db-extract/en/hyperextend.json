                "senses": [
                    {
                        "sense_id": "7c7e8c5f-0d1c-35f5-bb31-8bb6a3df866f",
                        "entry_id": "71fa81e8-f94a-3184-af3b-f69a042f889a",
                        "glosses": [
                            "To extend a joint beyond its normal position in a way that stresses the ligaments, often causing injury"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c6fbe6dd-4806-4ac9-a7ad-4c79e7a7da6a",
                                "sense_id": "7c7e8c5f-0d1c-35f5-bb31-8bb6a3df866f",
                                "text": "DELGADO OUT OF LINEUP The day after hyperextending his left knee as he tried to catch a foul ball, Carlos Delgado was held out of the starting lineup."
                            },
                            {
                                "example_id": "0367d868-b056-4f7f-b9c8-0f177183a87b",
                                "sense_id": "7c7e8c5f-0d1c-35f5-bb31-8bb6a3df866f",
                                "text": "The mix of ballet vocabulary, modern techniques and African steps is familiar, but the extent to which Mr. Rhoden packs — and overpacks — phrases, cultivates warp-speed delivery and hyperextends every possible hip jut and arabesque is, thank goodness, something special to Complexions."
                            },
                            {
                                "example_id": "e0079a0b-0214-4245-98ad-6c37aa66661f",
                                "sense_id": "7c7e8c5f-0d1c-35f5-bb31-8bb6a3df866f",
                                "text": "Every time you push off and hyperextend the toe, which happens when doing something as simple as taking a step or more strenuous like cutting and jumping, the MTP joint is involved."
                            }
                        ]
                    }
