                "senses": [
                    {
                        "sense_id": "2c442fc3-4392-3ec7-b7a3-df69c329ea39",
                        "entry_id": "1f2bc332-f640-3cca-b598-b43b7b68a4b2",
                        "glosses": [
                            "Donner un caractère pastel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494dbb77-ba59-477e-8b6d-4ef55210fc55",
                                "sense_id": "2c442fc3-4392-3ec7-b7a3-df69c329ea39",
                                "text": "Couleur porcelaine blanc à pastelliser, 8gr."
                            },
                            {
                                "example_id": "a6c4ad19-0346-4abc-9eb7-09a4402c1395",
                                "sense_id": "2c442fc3-4392-3ec7-b7a3-df69c329ea39",
                                "text": "Pour obtenir un bleu dense avec la chaux, qui a toujours tendance à \"pastelliser les teintes\", il faut passer plusieurs couches de chaux pigmentée."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef524500-d514-3122-9267-2e4e26f066f3",
                        "entry_id": "1f2bc332-f640-3cca-b598-b43b7b68a4b2",
                        "glosses": [
                            "Peindre au pastel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72666d58-5cb2-4826-b37c-641bbd1aed32",
                                "sense_id": "ef524500-d514-3122-9267-2e4e26f066f3",
                                "text": "Qu'est-ce que pastelliser sinon, sous les doigts de Coquillay, faire fleurir la lumière ?"
                            },
                            {
                                "example_id": "ab5f931f-1fdb-44cc-9b24-58a7c3ab8cfe",
                                "sense_id": "ef524500-d514-3122-9267-2e4e26f066f3",
                                "text": "Je me rappelle bien les longs instants que je passais seul, à dessiner et pastelliser des paysages hollandais, leurs canaux et leurs moulins à vent."
                            }
                        ]
                    }
