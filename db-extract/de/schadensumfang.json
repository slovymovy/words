                "senses": [
                    {
                        "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                        "entry_id": "1d7d8b1f-3aa8-37c4-9cbd-02226116d5ca",
                        "glosses": [
                            "Menge/Ausmaß/Größe eines Schadens/einer Beschädigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4dc41b-4c0a-4129-ad0f-214fb6651eac",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "Der Schadensumfang bei einem GAU eines deutschen Atomkraftwerkes wäre so groß, dass keine Versicherung der Welt ihn abdecken könnte."
                            },
                            {
                                "example_id": "3c6c0420-da27-4375-9e3f-240b41818e70",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "„Zur Ermittlung des genauen Schadensumfangs musste das Fahrzeug in eine Werkstatt gebracht werden.“"
                            },
                            {
                                "example_id": "262f4e82-862a-4a23-9cef-22727dd8797a",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "Bei einem KFZ-Unfall hängt es vom Schadensumfang ab, ob man seine Haftpflichtversicherung in Anspruch nimmt oder nicht."
                            },
                            {
                                "example_id": "b9f14e8f-6838-46f0-8bee-53812eb54788",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "„Seit dem 23. Juni 2016 ist die Weserbrücke wegen großflächigen Schäden an der Beton-Fahrbahnplatte für Fahrzeuge über 3,5 Tonnen gesperrt und wird von einem Ingenieurbüro zusammen mit dem Landesbetrieb Straßenbau NRW auf den genauen Schadensumfang der Brücke geprüft.“"
                            },
                            {
                                "example_id": "e42ad4d1-696d-41fd-8604-a3d6604a2a30",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "„Den Schadensumfang hat nun ein DEKRA-Gutachten ermittelt.“"
                            },
                            {
                                "example_id": "4de8c9c1-3d93-4ede-9d49-39e34ba07168",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "[Wegen eines Lecks in einer Leitung in der Shell-Raffinerie in Wesseling bei Köln 2012 gelangte Flugbenzin ins Grundwasser:] „Neben dem Schadensumfang, der am Mittwoch bekannt wurde, soll“ der TÜV-Rheinland „auch die Schadensursache, die grundsätzliche technische Beschaffenheit des Werks sowie Vorschläge zur Schadensbehebung liefern.“"
                            },
                            {
                                "example_id": "4a9398f6-9b17-4b94-a782-51274041e158",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "[Sanierung Hamburger Schulen:] „Würden die Schäden nicht beseitigt, würde der Schadensumfang jährlich im Durchschnitt um sechs Prozent, also rund 180 Millionen Euro steigen.“"
                            },
                            {
                                "example_id": "b1339e40-f622-4164-9794-e5fa2992d227",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "„Wie bereits erläutert, sind Unsicherheiten bei der Ermittlung von Eintrittshäufigkeiten und Schadensumfang unerwünschter Ereignisse unvermeidlich.“"
                            },
                            {
                                "example_id": "c57d398b-c2a5-4190-9f0b-2a95b521f7b1",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "[Brand einer Kirche:] „»Abhängig vom Schadensumfang kann die Sanierung mehrere Monate in Anspruch nehmen.«“"
                            },
                            {
                                "example_id": "b5b66cd9-bcc0-49ca-a40c-d6d5a2850471",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "[Erdbeben in der Türkei 1999:] „Der Schadensumfang hängt“ […] „auch mit der Bausubstanz der Häuser in der Erdbebenregion zusammen. In der Region seien viele Gebäude nicht erdbebensicher.“"
                            },
                            {
                                "example_id": "20611f8a-7c75-41d6-b75f-bf9005e34f86",
                                "sense_id": "3d3b832d-8fb6-313c-97ab-a95c2727602b",
                                "text": "[Veruntreuung:] „Strafrechtlich konnten nur noch die nach 2013 liegenden Taten mit einem Schadensumfang von rund 120.000 Euro zur Verurteilung herangezogen werden - was davor lag, gilt als verjährt und ist nur noch zivilrechtlich einzuklagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
