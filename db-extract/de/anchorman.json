                "senses": [
                    {
                        "sense_id": "620e2cf5-a5c7-3cec-b1ed-cbfada48a0ee",
                        "entry_id": "bfb3d99c-c47d-3b51-a28a-c0bea29b969e",
                        "glosses": [
                            "Moderator oder Redakteur im Fernsehstudio, der durch eine Nachrichtensendung führt und dabei Kommentare von Berichterstattern vor Ort oder Stellungnahmen von Interviewpartnern einholt"
                        ],
                        "tags": [
                            "Journalistik"
                        ],
                        "examples": [
                            {
                                "example_id": "18366c79-77b8-4219-b555-bf62374a8103",
                                "sense_id": "620e2cf5-a5c7-3cec-b1ed-cbfada48a0ee",
                                "text": "„Die Anchormen der Networks haben die sentimentale Aura großer Baseballspieler.“"
                            },
                            {
                                "example_id": "c5265417-c8b8-4b6d-b34b-4d3358afd85d",
                                "sense_id": "620e2cf5-a5c7-3cec-b1ed-cbfada48a0ee",
                                "text": "„In Berlin wird der Anchorman einer der wichtigsten Nachrichtensendungen zum Regierungssprecher, und die Verwunderung hält sich in Grenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
