                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f590fa4-a512-31af-a872-348ed9b828fc",
                                        "entry_id": "122d80e4-c28d-32b5-9bbc-ec67615ceeb4",
                                        "glosses": [
                                            "Autre nom de la blennorragie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35285d55-e435-4f69-9e19-688118f7dc05",
                                                "sense_id": "6f590fa4-a512-31af-a872-348ed9b828fc",
                                                "text": "La gonorrhée (ou blennorragie) est une infection sexuellement transmissible courante à travers le monde entier."
                                            },
                                            {
                                                "example_id": "2dab8a11-3088-4bca-8211-4de50ad21338",
                                                "sense_id": "6f590fa4-a512-31af-a872-348ed9b828fc",
                                                "text": "Lors de son dernier dépistage, la résultat est tombé : une chlamydiose et une gonorrhée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74ddd9d7-a02d-4a54-89aa-98abc00b9d0b",
                        "source_entry_id": "a3f5c00c-1cb8-33f2-b54a-da155a39cee1",
                        "source_sense_id": "6bc2e0c8-2904-3095-8c64-ec9199b403b0",
                        "source_sense_description": "STD",
                        "target_lang_word": "blennorragie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blennorragie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                                        "entry_id": "7c4519c7-70a5-38d1-b40e-125fd3b1416f",
                                        "glosses": [
                                            "Maladie inflammatoire et infectieuse de la muqueuse de l’urètre."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89d844ad-9c00-4468-8c7f-66d2e089393d",
                                                "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                                                "text": "En juin 1880, deux militaires tombent malades (chancres et blennorragie)."
                                            },
                                            {
                                                "example_id": "379b0b51-deca-4382-863d-c9925d8955ff",
                                                "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                                                "text": "En particulier, les chercheurs ont analysé la sensibilité des cas de blennorragie à une augmentation du prix de la bière due à une taxe."
                                            },
                                            {
                                                "example_id": "5d8184e0-af9e-42de-a270-06f6d5623d9a",
                                                "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                                                "text": "On avait inventé un nouveau médicament qui guérissait la blennorragie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b4da5c5-e5f2-4495-8b25-633684c00803",
                        "source_entry_id": "a3f5c00c-1cb8-33f2-b54a-da155a39cee1",
