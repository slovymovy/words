                "senses": [
                    {
                        "sense_id": "8b8b4813-db28-3fb7-a1fa-a7f0f044cc47",
                        "entry_id": "7d2effa4-b626-340c-9fb8-9dbd76a39e5d",
                        "glosses": [
                            "Trainingsgerät, das von Boxern und anderen Kampfsportlern zum Trainieren der Schlag- und Tritttechniken verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f2aad2-d1e2-4722-a9b1-60995ee71068",
                                "sense_id": "8b8b4813-db28-3fb7-a1fa-a7f0f044cc47",
                                "text": "„Inzwischen hatte sie ihren Rhythmus gefunden und bewegte sich mit gekonnten, flinken Schritten tänzelnd um den Boxsack herum.“"
                            },
                            {
                                "example_id": "b7cd12ff-8dc3-4293-8da9-953ec1ece7fc",
                                "sense_id": "8b8b4813-db28-3fb7-a1fa-a7f0f044cc47",
                                "text": "„Es gibt einen Sitzbereich mit schwarzen Ledersofas, drei Schreibtische mit großen Bildschirmen und einen Boxsack, der von der Decke hängt.“"
                            },
                            {
                                "example_id": "2fb06b22-caa3-4925-a9a8-d1384d7e9a02",
                                "sense_id": "8b8b4813-db28-3fb7-a1fa-a7f0f044cc47",
                                "text": "„Schweiß tropft mir von der Stirn, als ich wieder und wieder auf den schlaffen Boxsack einschlage, der vor mir von der Decke hängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
