{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "081bca1c-40ab-3236-a24e-e3cb7ed80fe7",
                    "sense_definition": "A flattened, usually round cake or portion of ground meat, seafood, or vegetarian alternative.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef placed the freshly grilled beef <w>patty</w> onto the warm bun.",
                            "target_lang_translations": {
                                "zh": "厨师把刚烤好的牛肉<w>肉饼</w>放到了温热的小圆面包上。"
                            }
                        },
                        {
                            "text": "She ordered a burger made with a black bean <w>patty</w> instead of meat.",
                            "target_lang_translations": {
                                "zh": "她点了一个用黑豆<w>饼</w>代替肉类的汉堡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "burger patty",
                        "meat patty",
                        "veggie patty"
                    ],
                    "target_lang_definitions": {
                        "zh": "（碎肉、海鲜或蔬菜做成的）肉饼，扁馅饼"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肉饼",
                                "target_lang_sense_clarification": "肉馅或代用食材做成的扁饼"
                            },
                            {
                                "target_lang_word": "饼",
                                "target_lang_sense_clarification": "汉堡等的扁形夹层肉饼或素饼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adb90ccf-e5d3-3ce3-98db-7a6aa96306df",
                    "sense_definition": "A small pastry filled with seasoned meat or vegetables and baked inside a flaky crust.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped at a local bakery to buy a warm, spicy beef <w>patty</w>.",
                            "target_lang_translations": {
                                "zh": "我们在当地一家烘焙店停下，买了一个热气腾腾的香辣牛肉<w>馅饼</w>。"
                            }
                        },
                        {
                            "text": "The flaky yellow crust is what makes a Jamaican <w>patty</w> so distinctive.",
                            "target_lang_translations": {
                                "zh": "层层酥脆的黄色外皮让牙买加<w>肉饼</w>格外与众不同。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "beef patty"
                    ],
                    "target_lang_definitions": {
                        "zh": "小馅饼，（牙买加）肉馅酥皮饼"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "馅饼",
                                "target_lang_sense_clarification": "带酥皮烘烤的肉馅或蔬菜小馅饼"
                            },
                            {
                                "target_lang_word": "酥饼",
                                "target_lang_sense_clarification": "多层酥皮包裹的馅饼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41e218d8-6f60-3543-b646-b7e32f7da997",
                    "sense_definition": "A foolish or stupid person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't act like such a complete <w>patty</w> in front of our guests.",
                            "target_lang_translations": {
                                "zh": "在客人面前别表现得像个十足的<w>傻瓜</w>。"
                            }
                        },
                        {
                            "text": "He felt like a <w>patty</w> after realizing he had forgotten his keys inside.",
                            "target_lang_translations": {
                                "zh": "意识到自己把钥匙忘在屋里后，他觉得自己像个<w>蠢蛋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "idiot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "傻瓜，蠢人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "愚蠢糊涂的人"
                            },
                            {
                                "target_lang_word": "蠢蛋",
                                "target_lang_sense_clarification": "口语，指愚笨的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e717f0e3-764e-3f02-99a7-feb001d17743",
                    "sense_definition": "A female given name, usually used as a diminutive of Patricia.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "given_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My aunt <w>Patty</w> brings homemade cookies every time she visits.",
                            "target_lang_translations": {
                                "zh": "我的<w>帕蒂</w>阿姨每次来访都会带自制饼干。"
                            }
                        },
                        {
                            "text": "Her full name is Patricia, but everyone calls her <w>Patty</w>.",
                            "target_lang_translations": {
                                "zh": "她的全名是帕特里夏，但大家都叫她<w>帕蒂</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "帕蒂（女子教名，通常是Patricia的昵称）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "帕蒂",
                                "target_lang_sense_clarification": "女子名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70f52e34-8551-383b-bf8e-7b78ec19e328",
                    "sense_definition": "A unisex given name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "given_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "They decided that <w>Patty</w> would be a charming name for their child.",
                            "target_lang_translations": {
                                "zh": "他们觉得给孩子起名叫<w>帕蒂</w>会很迷人。"
                            }
                        },
                        {
                            "text": "The name <w>Patty</w> can be given to either boys or girls.",
                            "target_lang_translations": {
                                "zh": "<w>帕蒂</w>这个名字男孩和女孩都可以用。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "帕蒂（中性教名，男女皆可用）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "帕蒂",
                                "target_lang_sense_clarification": "男女通用的教名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb02978b-1885-3a96-98ad-314fc3f1925c",
                    "sense_definition": "A male given name, traditionally a diminutive of Patrick.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "given_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Little <w>Patty</w> was named after his grandfather Patrick.",
                            "target_lang_translations": {
                                "zh": "小<w>帕蒂</w>是跟随他祖父帕特里克取的名字。"
                            }
                        },
                        {
                            "text": "He introduced himself as <w>Patty</w> when he arrived at the camp.",
                            "target_lang_translations": {
                                "zh": "他到达营地时自我介绍说叫<w>帕蒂</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "帕蒂（男子教名，通常是Patrick的昵称）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "帕蒂",
                                "target_lang_sense_clarification": "男子名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e96d99c-dffe-354c-aef2-c6c62a650675",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Patty</w> answered the door and welcomed us into his home.",
                            "target_lang_translations": {
                                "zh": "<w>帕蒂</w>先生开了门，热情欢迎我们进屋。"
                            }
                        },
                        {
                            "text": "The historical document was signed by a doctor named Thomas <w>Patty</w>.",
                            "target_lang_translations": {
                                "zh": "这份历史文献由一位名叫托马斯·<w>帕蒂</w>的医生签署。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "帕蒂（姓氏）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "帕蒂",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "35492601-8f7b-3bcd-aaed-cbbbed190918",
                    "sense_definition": "Alternative form of <w>patté</w>, referring to a heraldic cross with arms narrow at the center and broad at the ends.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shield was decorated with an ancient cross <w>patty</w> in gold.",
                            "target_lang_translations": {
                                "zh": "盾牌上装饰着一个古老的金色<w>展臂十字</w>。"
                            }
                        },
                        {
                            "text": "In heraldry, a cross <w>patty</w> features arms that expand toward the perimeter.",
                            "target_lang_translations": {
                                "zh": "在纹章学中，<w>展臂十字</w>的特征是四端向外扩张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pattee"
                    ],
                    "common_phrases": [
                        "cross patty"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（纹章学，修饰十字）展臂的，向外扩宽的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "展臂十字",
                                "target_lang_sense_clarification": "纹章学中四臂末端放宽的十字"
                            }
