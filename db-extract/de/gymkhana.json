                                    {
                                        "sense_id": "3c449658-5e54-3a95-9f6b-81038abacc5a",
                                        "entry_id": "a1144e33-0dad-3949-9ebf-58b4199b0782",
                                        "glosses": [
                                            "A competition where riders and horses display a range of skills and aptitudes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eab244d9-3f85-4c54-bc27-17b0e3001400",
                                                "sense_id": "3c449658-5e54-3a95-9f6b-81038abacc5a",
                                                "text": "In the afternoon the British held athletic sports, an impromptu military tournament, and a gymkhana, all of which caused much merriment and diversion, and the Boers profited by the cessation of the shell fire to shovel away at their trenches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c185e49b-0510-37be-89ee-666b50249d88",
                                        "entry_id": "a1144e33-0dad-3949-9ebf-58b4199b0782",
                                        "glosses": [
                                            "A place of public resort for athletic games, etc."
                                        ],
                                        "tags": [
                                            "India",
                                            "Myanmar",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "753e007d-a4d3-4e59-a5ce-cf794fe80f80",
                                                "sense_id": "c185e49b-0510-37be-89ee-666b50249d88",
                                                "text": "These privileged gentlemen have a fine club on the Fateh Maidan, a suburb of Hyderabad city, and they enjoy sports and races at the local gymkhana, in fact, they have a very good time, if one may judge by their appearance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f044fc8-0d5d-325c-867c-80291224e7e2",
                                        "entry_id": "a1144e33-0dad-3949-9ebf-58b4199b0782",
                                        "glosses": [
                                            "A meeting for such sports."
                                        ],
