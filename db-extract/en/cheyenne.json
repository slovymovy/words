                        "cross_references": [
                            {
                                "target_word": "Cheyenne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f46f5c1c-adfc-3712-af76-73fd600c78db",
                                        "entry_id": "ae7c54a8-cb7d-3feb-9d46-ae1f55db19cd",
                                        "glosses": [
                                            "Sprache des gleichnamigen Indianerstamms, die in Montana und Oklahoma (USA) gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d9c30c-487a-4b59-bb5c-c324f284bee4",
                                                "sense_id": "f46f5c1c-adfc-3712-af76-73fd600c78db",
                                                "text": "„Cheyenne wurde in den 1990er Jahren noch von 1720 Personen gesprochen, Arapaho von 1030, Shawnee von 230, Menominee von 65, Unami von 5.“"
                                            },
                                            {
                                                "example_id": "1dd7f1d8-6f0a-4bad-86a8-43a1e20ac93e",
                                                "sense_id": "f46f5c1c-adfc-3712-af76-73fd600c78db",
                                                "text": "„Als wir ihn vorigen Winter bekamen, konnte er noch nicht ordentlich zälen, jetzt zält er bereits schon Cheyenne und deutsch, addiert im Kopf und auf der Tafel.“"
                                            },
                                            {
                                                "example_id": "b0944beb-d051-4d54-9b87-e5d1b14e7fbd",
                                                "sense_id": "f46f5c1c-adfc-3712-af76-73fd600c78db",
                                                "text": "„Neuere Untersuchungen weisen zum Beispiel das Cheyenne aufgrund einer früheren räumlichen Nachbarschaft als nahen Verwandten des Menominee aus[…]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Cheyenne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7f146e-7ea8-3741-8701-90c6b8163098",
                                        "entry_id": "7c450378-ddc2-3ca7-a65e-6fab73cdd3db",
                                        "glosses": [
                                            "Angehöriger eines Indianervolks, das ursprünglich im Kulturgebiet der Großen Ebenen lebte, und heute noch in Montana und Oklahoma (USA) ansässig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a1f47a2-508b-4eaa-9702-18de8f02e510",
                                                "sense_id": "2e7f146e-7ea8-3741-8701-90c6b8163098",
                                                "text": "„Und es wurde gewettet , auch ich wettete mit einem jungen Cheyenne auf unseren Sieg , ich setzte ein Paar Mocassins , und sollte im Falle das ich gewinnen würde eine Messerscheide mit Messer von dem Cheyenne erhalten .“"
                                            },
                                            {
                                                "example_id": "7e1fedf7-7743-4815-bd94-f93d79d4271a",
                                                "sense_id": "2e7f146e-7ea8-3741-8701-90c6b8163098",
                                                "text": "„Der Indianer war ein Cheyenne, der vom Nachbardorf gehört hatte, das von den Blauen Soldaten zerstört wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
