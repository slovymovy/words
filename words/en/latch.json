                        "zh": "婴儿在母乳喂养时含住乳房的方式或状态。",
                        "cs": "Způsob, jakým se dítě přisává k prsu při kojení."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захват",
