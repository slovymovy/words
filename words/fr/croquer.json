                    "frequency": "Middle",
                    "semantic_group_id": "dessin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste s'est assis au café pour <w>croquer</w> les passants dans son carnet."
                        },
                        {
                            "text": "Elle a rapidement <w>croqué</w> la silhouette de son ami sur une feuille."
                        }
                    ],
                    "common_phrases": [
                        "croquer un portrait",
                        "croquer sur le vif"
                    ]
                },
                {
                    "sense_id": "e89f09b2-8010-395d-b235-46463f6f640f",
                    "sense_definition": "Dépenser ou dilapider rapidement de l'argent ou des biens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "depense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En quelques mois seulement, il a complètement <w>croqué</w> son héritage au casino."
                        },
                        {
                            "text": "Ils ont <w>croqué</w> toutes leurs économies lors de ce voyage somptueux."
                        }
                    ],
                    "common_phrases": [
                        "croquer un héritage",
                        "croquer sa fortune"
