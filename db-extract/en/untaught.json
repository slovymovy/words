                        "sense_id": "fd5bf453-c571-3da0-82e4-4d1747499e93",
                        "entry_id": "4ce3ac5b-c757-399f-a38d-d98e8e1b188d",
                        "glosses": [
                            "Not taught; uneducated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d627814-711e-49fd-a99e-29436449c384",
                                "sense_id": "fd5bf453-c571-3da0-82e4-4d1747499e93",
                                "text": "My ſcoles are not for unthriftes untaught,\nFor frantick faitours half mad and half ſtraught;\nBut my learning is of another degree"
                            },
                            {
                                "example_id": "2ec6a74f-8cd5-443a-8675-98ec1588bcfd",
                                "sense_id": "fd5bf453-c571-3da0-82e4-4d1747499e93",
                                "text": "The gazing, the spying, and the ability to divine the eternal in the vivid manifestations of nature, here attributed to the young child, seem to be realised in this relatively untaught child of the woods of Oregon."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b5ecedb-fd3d-387d-9b86-292e9ad4e1fc",
                        "entry_id": "4ce3ac5b-c757-399f-a38d-d98e8e1b188d",
                        "glosses": [
                            "Not taught; not conveyed by means of instruction."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9c54fee0-7f7f-4034-9bbb-5897a1f7d727",
                                "sense_id": "8b5ecedb-fd3d-387d-9b86-292e9ad4e1fc",
                                "text": "What they used to teach here\nNow goes untaught."
                            }
                        ]
                    }
                ],
