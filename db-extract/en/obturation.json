                        ]
                    },
                    {
                        "translation_id": "ff203790-09fa-492e-9967-541e5cbff645",
                        "source_entry_id": "f6b9e6c1-2628-3534-a477-ea72cfd0c77d",
                        "source_sense_id": "ef4bced1-d9cc-35c3-aeb1-cff367c536c6",
