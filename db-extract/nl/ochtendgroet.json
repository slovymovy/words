                        "examples": [
                            {
                                "example_id": "405b08cf-3dfe-47d6-ac60-8f4f31d7e8e0",
                                "sense_id": "7b1e5787-8007-3bae-acb7-f772e4ca3994",
                                "text": "Op de eerstvolgende sabbat merkte Mrs Gookin tijdens de ochtendgroet dat haar stem hoger begon te klinken en haar wangen rood werden toen hij haar uithoorde over de details."
                            },
                            {
                                "example_id": "f9e525a7-3ef9-44ab-b29a-fc466753b691",
                                "sense_id": "7b1e5787-8007-3bae-acb7-f772e4ca3994",
                                "text": "Desondanks gebeurde het op een keer dat Zijne ed. zijn ochtendgroet beantwoordde, hem aankeek en even glimlachte."
                            },
                            {
                                "example_id": "adcc807a-6bcc-4cb0-8123-a47fbb1d321b",
                                "sense_id": "7b1e5787-8007-3bae-acb7-f772e4ca3994",
                                "text": "Hi-de-Hi! was een komedieserie over de belevenissen op een fictief zomerkamp, begin jaren 60. De titel verwees naar de ochtendgroet waarmee de kamperende jongeren elke dag werden begroet. Madoc was verder vooral bekend vanwege haar theaterwerk en haar rol als de moeder van Daffyd Thomas in de satirische serie Little Britain."
                            }
                        ]
                    }
