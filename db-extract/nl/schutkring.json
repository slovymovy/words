                ],
                "senses": [
                    {
                        "sense_id": "55ed8efb-6865-3e0a-a25f-cc3e64d2d3ff",
                        "entry_id": "b9b8b344-b185-342e-b70d-2f395c33d78a",
                        "glosses": [
                            "zone rond een besmettingshaard waar maatregelen worden toegepast om verspreiding van een ziekte te voorkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc39d9e4-b02c-4cf1-9555-6d1309325c4d",
                                "sense_id": "55ed8efb-6865-3e0a-a25f-cc3e64d2d3ff",
                                "text": "De autoriteiten legden een schutkring aan rond het getroffen gebied."
                            },
                            {
                                "example_id": "4598cee2-4f01-4e8f-9ab2-4ae35b625ac5",
                                "sense_id": "55ed8efb-6865-3e0a-a25f-cc3e64d2d3ff",
                                "text": "Ik noem het een schutkring, zoals ze dat aanleggen rond gebieden waar de varkenspest is uitgebroken."
                            },
                            {
                                "example_id": "1f249939-9ac7-43f0-bd23-5adf1e721d37",
                                "sense_id": "55ed8efb-6865-3e0a-a25f-cc3e64d2d3ff",
                                "text": "[Art. 1] § 3. De schutkring omvat de ruimte welke de haar in een straal van driehonderd meter in vogelvlucht omringt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "790bd6ff-e799-42bc-8fd6-e9304c81f4aa",
                        "source_entry_id": "b9b8b344-b185-342e-b70d-2f395c33d78a",
                        "source_sense_id": "55ed8efb-6865-3e0a-a25f-cc3e64d2d3ff",
                        "source_sense_description": "zone rond een besmettingshaard waar maatregelen worden toegepast om verspreiding van een ziekte te voorkomen",
                        "target_lang_word": "cordon sanitaire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordon sanitaire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd43272-e819-3d41-8df4-725a9359ec54",
                                        "entry_id": "268f77fb-77f9-35fd-ac3a-f0513f17bc88",
                                        "glosses": [
                                            "A barrier (physical or administrative) to prevent the spread of disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561b2104-c0da-4949-8dd0-e740bc2758f4",
                                                "sense_id": "7dd43272-e819-3d41-8df4-725a9359ec54",
                                                "text": "In accordance with their recommendation, the French Ministry drew a cordon sanitaire round the Spanish frontier. The plague gradually died away with the colder weather of the winter; but the French Ministry did not withdraw the troops who composed the cordon sanitaire."
                                            },
                                            {
                                                "example_id": "ba3ed804-d9e1-43df-bc3a-73f5643c7e23",
                                                "sense_id": "7dd43272-e819-3d41-8df4-725a9359ec54",
                                                "text": "Bubonic plague had been in relative abeyance since the 1660s, and its explosion into Marseille and Provence in 1720 confirmed the ability of government, through quarantines and cordons sanitaires, to hem the disease in and prevent its diffusion across the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e656cc12-2485-3069-8c9c-3e3d9031f444",
                                        "entry_id": "268f77fb-77f9-35fd-ac3a-f0513f17bc88",
                                        "glosses": [
                                            "Any barrier to the spread of anything deemed undesirable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb0b851-84c4-4003-9e4c-8f70a917c438",
                                                "sense_id": "e656cc12-2485-3069-8c9c-3e3d9031f444",
                                                "text": "The alternative for such a policy was the isolation of Russia and the construction of a cordon sanitaire, in order to contain Bolshevism in the present area."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff68f5d1-000b-4a54-8840-154fc52a6bf8",
                        "source_entry_id": "b9b8b344-b185-342e-b70d-2f395c33d78a",
                        "source_sense_id": "55ed8efb-6865-3e0a-a25f-cc3e64d2d3ff",
                        "source_sense_description": "zone rond een besmettingshaard waar maatregelen worden toegepast om verspreiding van een ziekte te voorkomen",
                        "target_lang_word": "cordon sanitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordon sanitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68168268-0c2d-34be-bc45-31cd275249e3",
                                        "entry_id": "8f1408fb-6d86-31a8-94d0-4d9e17d237c6",
                                        "glosses": [
                                            "Espace contrôlé en vue de surveiller les accès à une zone où sévit une épidémie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20587c32-9073-41eb-b196-4249d0a01a41",
                                                "sense_id": "68168268-0c2d-34be-bc45-31cd275249e3",
                                                "text": "Quant aux salles \"spécialement équipées\", il les connaissait : deux pavillons hâtivement déménagés de leurs autres malades, leurs fenêtres calfeutrées, entourés d’un cordon sanitaire."
                                            },
                                            {
                                                "example_id": "36f26aa6-9e20-4e7b-9f12-657cc6839363",
                                                "sense_id": "68168268-0c2d-34be-bc45-31cd275249e3",
                                                "text": "La peste s’étant déclarée dans les provinces voisines, on établit un cordon sanitaire, pour empêcher les communications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e999dc2e-3f53-3ede-9ea9-3b9eea1582db",
                                        "entry_id": "8f1408fb-6d86-31a8-94d0-4d9e17d237c6",
                                        "glosses": [
                                            "Pays situés à l’ouest de la Russie soviétique, considérés après la Première Guerre mondiale comme une protection en isolant la Russie de l’Europe occidentale : Finlande, Pays baltes, Pologne et Roumanie (ou autre situation analogue)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700e54e7-38e9-4570-9e08-a127c3597b0e",
                                                "sense_id": "e999dc2e-3f53-3ede-9ea9-3b9eea1582db",
                                                "text": "« On devrait établir un cordon sanitaire autour des peuples balkaniques, et les laisser s’entr’égorger, une bonne fois, jusqu’à la disparition totale ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53135919-d768-3200-9ad4-4b0410356b17",
                                        "entry_id": "8f1408fb-6d86-31a8-94d0-4d9e17d237c6",
                                        "glosses": [
                                            "Pratique politique et doctrine consistant à ne pas s'allier un parti jugé infréquentable et dangereux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927c6a40-639c-4fe3-b29b-e3ba9d0646ad",
                                                "sense_id": "53135919-d768-3200-9ad4-4b0410356b17",
                                                "text": "M. Merz a répété à plusieurs reprises exclure tout scénario de coalition avec l’AfD après les élections, au nom de la doctrine du cordon sanitaire qui prévaut en Allemagne depuis l’après-guerre, selon laquelle aucun des partis respectant la démocratie parlementaire ne forme d’alliance avec l’extrême droite."
                                            },
                                            {
                                                "example_id": "423e8439-90d5-4832-9ee6-4b61793c26a1",
                                                "sense_id": "53135919-d768-3200-9ad4-4b0410356b17",
                                                "text": "L’opposition est déterminée à déloger les sociaux-démocrates, mais pour construire une majorité solide, il lui faudrait dynamiter le cordon sanitaire qui, jusqu’ici, tenait les démocrates de Suède à distance d’une influence politique directe."
                                            },
                                            {
                                                "example_id": "aa31752e-4422-494a-bf1d-159de5e6fac7",
                                                "sense_id": "53135919-d768-3200-9ad4-4b0410356b17",
                                                "text": "La droite a adopté jeudi au Parlement européen une résolution sur le Venezuela coécrite avec des groupes d’extrême droite, mettant en minorité gauches et libéraux. Une première pour le mandat qui s’ouvre, révélatrice de l’effritement du « cordon sanitaire »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
