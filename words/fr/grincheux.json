                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne fais pas attention à lui, c'est un <w>grincheux</w> qui n'apprécie jamais rien."
                        },
                        {
                            "text": "Ce vieux <w>grincheux</w> passe ses journées à râler contre le bruit de la rue."
