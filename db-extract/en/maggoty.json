                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f17200e-c5e7-302d-8204-a705b48b5a29",
                        "entry_id": "c5767647-53cc-3d6a-b757-259cae3bf306",
                        "glosses": [
                            "Infested with and/or partially eaten by maggots; flyblown."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "b132907e-2485-4602-b033-1fede61c7df3",
                                "sense_id": "9f17200e-c5e7-302d-8204-a705b48b5a29",
                                "text": "He pilots his disreputable father-in-law through the maggotier parts of the Big Apple, tries out unsuccessfully for a job as gorilla, pulls off an unconvincing fraud (surely Gothamites don’t hand over against an uncleared cheque?)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee974107-649a-33f0-841a-e2b65b35179f",
                        "entry_id": "c5767647-53cc-3d6a-b757-259cae3bf306",
                        "glosses": [
                            "Full of whims; capricious; freakish."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e2aa7c00-ad21-4ab4-af28-ba8b78f569c9",
                                "sense_id": "ee974107-649a-33f0-841a-e2b65b35179f",
                                "text": "the Maggoty Turn of Fortune's Wheel"
                            },
                            {
                                "example_id": "cb93658f-08f8-4ecf-9746-c69ccbcd1b7e",
                                "sense_id": "ee974107-649a-33f0-841a-e2b65b35179f",
                                "text": "In the book, what holds the sketchy characters, the narrative chunks, and the ideas together is West's maggoty wit—positioning himself halfway between contempt and fear, clinging to literary sophistication as if it were the Mother Church."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dac81e3-64ea-3c9a-bb3c-4c0ebc063e88",
                        "entry_id": "c5767647-53cc-3d6a-b757-259cae3bf306",
                        "glosses": [
                            "Unpleasant or bad-tempered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed7ab7dc-abae-4593-b521-b6b21c64f81a",
                                "sense_id": "5dac81e3-64ea-3c9a-bb3c-4c0ebc063e88",
                                "text": "I want you to know that I think you are a maggoty mother-fucking son of a bitch"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76fe059e-8222-44df-b158-fe7efad6e488",
                        "source_entry_id": "c5767647-53cc-3d6a-b757-259cae3bf306",
                        "source_sense_description": "infested with and/or partially eaten by maggots",
                        "target_lang_word": "wormstekig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wormstekig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a97de122-78cb-3c7c-a2d6-4949d9d6d0bf",
                                        "entry_id": "cc45138b-6b20-36a2-b08a-888791e61035",
                                        "glosses": [
                                            "door wormen aangevreten en bedorven (met name van hout en vruchten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97ca4517-47db-40ae-978e-0a61ac10564c",
                                                "sense_id": "a97de122-78cb-3c7c-a2d6-4949d9d6d0bf",
                                                "text": "Gelukkig stonden er in een achterafzaaltje, ver van alle nieuwe media, een paar luie, wormstekige jarenvijftigstoelen voor een dito televisiemeubel. Je kon er niets anders doen dan onderuit zakken in de tijd en een halve eeuw sporthoogtepunten bekijken. Gewoon, op een klein schermpje, met een koptelefoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d3c8f02-1b56-3e4b-8277-184f84a48776",
                                        "entry_id": "cc45138b-6b20-36a2-b08a-888791e61035",
                                        "glosses": [
                                            "oud en vergaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e7e4c5-edce-4d90-954d-b5dc928b056f",
                                                "sense_id": "4d3c8f02-1b56-3e4b-8277-184f84a48776",
                                                "text": "Pijnlijke zaak, nu Wagnerianen uit heel de wereld toestromen voor de Bayreuther Festspiele, de jaarlijkse hoogmis van de Wagneropera. Bondskanselier Angela Merkel schuifelt incognito rond. Tussen blote galajurken beweegt zich ook Beierse en Japanse klederdracht. In Bayreuth verzamelt zich de crème de la crème en om te voorkomen dat die een stuk puin op het hoofd krijgt, is de wormstekige façade voorlopig in de steigers gezet. Doek eromheen, print van het originele Beierse vakwerk erop - klaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26755f92-e77a-47d8-8dbe-893575408d13",
                        "source_entry_id": "c5767647-53cc-3d6a-b757-259cae3bf306",
                        "source_sense_description": "infested with and/or partially eaten by maggots",
                        "target_lang_word": "madig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07a51eaf-0418-3c6d-8bef-c9dff9fbc23f",
                                        "entry_id": "0538e490-930f-3197-957e-600ebf5d7055",
                                        "glosses": [
                                            "von Maden zerfressen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d3df19-fbe5-43c1-95ea-3bbe2baecb12",
                                                "sense_id": "07a51eaf-0418-3c6d-8bef-c9dff9fbc23f",
                                                "text": "Aber als sie reinbeißen, da sind die Äpfel madig, und es kommt ein alter, ehrwürdiger Mann mit einem langen Bart."
                                            },
                                            {
                                                "example_id": "dd189eae-6ddc-44dc-8ba3-e9b24971af8d",
                                                "sense_id": "07a51eaf-0418-3c6d-8bef-c9dff9fbc23f",
                                                "text": "Aber der Dicke schüttelte sein rundliches Haupt, daß die Kirschgehänge an seinen Ohren schwermassiv baumelten, und sagte nichts als: Madig!"
                                            },
                                            {
                                                "example_id": "92b3bea3-8340-40f7-8bfc-c6bf17b693cd",
                                                "sense_id": "07a51eaf-0418-3c6d-8bef-c9dff9fbc23f",
                                                "text": "Statt der bekannten Bauernhimbeere, wie man ihr noch jetzt begegnet, die Schattenseite hart, die Sonnenseite madig, gedieh hier eine Spezies, die, in Farbe, Größe und strotzender Fülle prunkend, aus Gegenden hierhergetragen schien, wo Sonne und Wasser eine südliche Brutkraft üben."
                                            },
                                            {
                                                "example_id": "312e4a7e-6004-4598-ace7-be2ff7a68ca7",
                                                "sense_id": "07a51eaf-0418-3c6d-8bef-c9dff9fbc23f",
                                                "text": "Man nehme ganz kleine, noch geschlossene Champignons, die nicht madig sind, schneide die Stiele ab, wasche sie unabgezogen in kaltem Wasser und lasse sie auf einem Tuche abtrocknen."
                                            },
                                            {
                                                "example_id": "686eb057-c97e-41fe-b0ef-439e14bf0ac9",
                                                "sense_id": "07a51eaf-0418-3c6d-8bef-c9dff9fbc23f",
                                                "text": "Se were e lange rasend wurden / unde madig asse e alt Zigen Kase."
                                            },
                                            {
                                                "example_id": "a9b901b6-7c85-43f4-b17c-929d443783cc",
                                                "sense_id": "07a51eaf-0418-3c6d-8bef-c9dff9fbc23f",
                                                "text": "Es stunde gerad am Bosch darinn ich lag / zwischen mir vnd dem Weeg den sie herhuncken / ein Baum voller madiger Kirschen / denen theils vor fäule bereits herunder zufallen begundten / vnder demselben præsentirte ihnen der schatten ein bequemme Ruhestatt: der Saphoyer legte sich zwar am ersten wiewol er noch unangesehen seines alters der frischeste vnder ihnen war / an statt das walt Gott / sagte er / als er die Augen übersich hub / vnd die halb faule Kirschen / deren jede mit einem oder zweyen lebendigen Würmlein gespickt war / auff dem Baum sahe / holl das Teuffel die Frantzos Krieg? hier iß besser Landen vor die arm Bettelman / als der Holland vor das Frantzos prave Soldat?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfc233f6-8652-301d-a967-ef792232cace",
                                        "entry_id": "0538e490-930f-3197-957e-600ebf5d7055",
                                        "glosses": [
                                            "schlecht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b782ef3c-f77d-454e-b7c1-1e86dffe26cc",
                                                "sense_id": "cfc233f6-8652-301d-a967-ef792232cace",
                                                "text": "Vieledler Priester aus dem alten Ägypten! Deine Phantasie ist sehr madig – ich danke!"
                                            },
                                            {
                                                "example_id": "713c07a4-ac36-4f36-a6b0-1306058b00e2",
                                                "sense_id": "cfc233f6-8652-301d-a967-ef792232cace",
                                                "text": "Doch ich will keiner ihr Glück madig machen, nur soviel weiß ich, einen wie meinen Karl haben sie Alle nicht."
                                            },
                                            {
                                                "example_id": "629440b3-bab0-4fe6-8508-be5afeea1f26",
                                                "sense_id": "cfc233f6-8652-301d-a967-ef792232cace",
                                                "text": "Und ewig wird der konkurrierende Nachbar hergenommen, angeödet, durchgebeutelt und madig gemacht; der Ulk ist entweder spielerische Nichtigkeit oder ausgeklügeltes Werbemittel gegen jemand anders, nirgendwo geistreiche Selbstkritik, robuste Ironisierung der eigenen Gebarung, übertreibende Herauskehrung des Lächerlichen in dem, was man liebt, Erprobung seiner Ideale im Reagenzglas der Groteske."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
