{
    "word_family": [
        "harvester",
        "postharvest",
        "unharvested"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41a955cc-829e-3464-966d-8a08e64eedfd",
                    "sense_definition": "The process or time of gathering ripened crops from the fields.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_agri_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant rain made the <w>harvest</w> a nightmare this year.",
                            "target_lang_translations": {
                                "ru": "Из-за постоянных дождей <w>уборка урожая</w> в этом году превратилась в кошмар.",
                                "zh": "持续的降雨让今年的<w>收割</w>工作变得极其艰难。"
                            }
                        },
                        {
                            "text": "Farmers work from sunrise to sunset during the <w>harvest</w>.",
                            "target_lang_translations": {
                                "ru": "Во время <w>жатвы</w> фермеры работают от рассвета до заката.",
                                "zh": "在<w>秋收</w>期间，农民们从日出忙到日落。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "harvest time",
                        "harvest festival",
                        "during the harvest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или время сбора созревшего урожая с полей.",
                        "zh": "从田间收集成熟农作物的过程或时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уборка урожая",
                                "target_lang_sense_clarification": "процесс сбора сельскохозяйственных культур"
                            },
                            {
                                "target_lang_word": "жатва",
                                "target_lang_sense_clarification": "сбор зерновых; время сбора урожая"
                            },
                            {
                                "target_lang_word": "сбор урожая",
                                "target_lang_sense_clarification": "общее название процесса"
                            },
                            {
                                "target_lang_word": "страда",
                                "target_lang_sense_clarification": "напряженная работа в сезон сбора урожая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收割",
                                "target_lang_sense_clarification": "指农作物成熟后的收割过程"
                            },
                            {
                                "target_lang_word": "秋收",
                                "target_lang_sense_clarification": "特指秋季的收获活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827b5156-b352-3667-ad79-9066ab169e74",
                    "sense_definition": "The amount of crops or fruit gathered in a season.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_agri_yield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This year's cotton <w>harvest</w> was great compared to the last one.",
                            "target_lang_translations": {
                                "ru": "<w>Урожай</w> хлопка в этом году был отличным по сравнению с прошлым.",
                                "zh": "与去年相比，今年的棉花<w>收成</w>非常好。"
                            }
                        },
                        {
                            "text": "We are expecting a bumper <w>harvest</w> thanks to the good weather.",
                            "target_lang_translations": {
                                "ru": "Благодаря хорошей погоде мы ожидаем небывалый <w>урожай</w>.",
                                "zh": "多亏了天气好，我们预计今年会有大<w>产量</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crop",
                        "yield",
                        "produce"
                    ],
                    "common_phrases": [
                        "bumper harvest",
                        "good harvest",
                        "poor harvest",
                        "grain harvest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество сельскохозяйственных культур или плодов, собранных за сезон.",
                        "zh": "一季中收集到的农作物或果实的总量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урожай",
                                "target_lang_sense_clarification": "собранное количество продукции"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "результат сбора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产量",
                                "target_lang_sense_clarification": "指农作物的产出数量"
                            },
                            {
                                "target_lang_word": "收成",
                                "target_lang_sense_clarification": "指收获的农作物成果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e98a29d-92fa-3886-871a-48b7be306c94",
                    "sense_definition": "The result, consequence, or reward of an action or effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveillance mission yielded a healthy <w>harvest</w> of intel.",
                            "target_lang_translations": {
                                "ru": "Разведывательная миссия принесла богатый <w>урожай</w> разведданных.",
                                "zh": "这次监视任务带来了丰富的<w>收获</w>，获取了大量情报。"
                            }
                        },
                        {
                            "text": "His long career produced a rich <w>harvest</w> of awards and accolades.",
                            "target_lang_translations": {
                                "ru": "Его долгая карьера принесла богатые <w>плоды</w> в виде наград и премий.",
                                "zh": "他漫长的职业生涯带来了丰硕的<w>成果</w>，获得了许多奖项和赞誉。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат, последствие или награда за действие или усилие.",
                        "zh": "行动或努力的结果、后果或回报。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плоды",
                                "target_lang_sense_clarification": "перен. результат усилий"
                            },
                            {
                                "target_lang_word": "урожай",
                                "target_lang_sense_clarification": "перен. большое количество чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成果",
                                "target_lang_sense_clarification": "指努力后获得的积极结果"
                            },
                            {
                                "target_lang_word": "收获",
                                "target_lang_sense_clarification": "比喻获得的经验、知识或成就"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb175e12-84b2-3a58-9668-31cb315fb12c",
                    "sense_definition": "The season of autumn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_season",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Harvest</w> is usually very damp and rainy in this region.",
                            "target_lang_translations": {
                                "ru": "<w>Осень</w> в этом регионе обычно очень сырая и дождливая.",
                                "zh": "这个地区的<w>秋天</w>通常非常潮湿多雨。"
                            }
                        },
                        {
                            "text": "The leaves turn brown and gold when <w>harvest</w> arrives.",
                            "target_lang_translations": {
                                "ru": "Листья становятся коричневыми и золотыми, когда наступает <w>осень</w>.",
                                "zh": "当<w>秋天</w>来临时，树叶变成了褐色和金色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "autumn",
                        "fall"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "standard English uses autumn or fall"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осенний сезон.",
                        "zh": "秋季。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осень",
                                "target_lang_sense_clarification": "время года"
                            },
                            {
                                "target_lang_word": "пора жатвы",
                                "target_lang_sense_clarification": "время сбора урожая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秋天",
                                "target_lang_sense_clarification": "指季节"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c7dae4f-302b-39e9-a435-dcdfced581af",
                    "sense_definition": "To gather crops from the fields.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_agri",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>harvested</w> the apples in September already.",
                            "target_lang_translations": {
                                "ru": "Мы <w>собрали</w> яблоки уже в сентябре.",
                                "zh": "我们九月份就已经<w>收割</w>了苹果。"
                            }
                        },
                        {
                            "text": "Machines are used to <w>harvest</w> the wheat quickly.",
                            "target_lang_translations": {
                                "ru": "Машины используются, чтобы быстро <w>убирать</w> пшеницу.",
                                "zh": "人们使用机器来快速<w>收割</w>小麦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gather"
                    ],
                    "common_phrases": [
                        "harvest crops",
                        "harvest grain",
                        "harvest grapes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать урожай с полей.",
                        "zh": "从田间收集农作物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать урожай",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "убирать",
                                "target_lang_sense_clarification": "сельскохозяйственный термин"
                            },
                            {
                                "target_lang_word": "жать",
                                "target_lang_sense_clarification": "срезать злаки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收割",
                                "target_lang_sense_clarification": "指收割庄稼"
                            },
                            {
                                "target_lang_word": "收获",
                                "target_lang_sense_clarification": "指采集农产品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e7dece2-dfd1-308b-a15b-d87f984ff75f",
                    "sense_definition": "To collect or extract cells, tissues, or organs for medical or scientific use; also used for hunting animals.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_bio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists <w>harvest</w> stem cells for research purposes.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>извлекают</w> стволовые клетки для исследовательских целей.",
                                "zh": "科学家们为了研究目的而<w>提取</w>干细胞。"
                            }
                        },
                        {
                            "text": "Hunters are permitted to <w>harvest</w> a specific number of deer each season.",
                            "target_lang_translations": {
                                "ru": "Охотникам разрешено <w>добывать</w> определенное количество оленей каждый сезон.",
                                "zh": "猎人们每个季节被允许<w>捕获</w>特定数量的鹿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "harvest organs",
                        "harvest timber"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать или извлекать клетки, ткани или органы для медицинского использования; также добывать животных на охоте.",
                        "zh": "为医疗或科学用途收集或提取细胞、组织或器官；也用于狩猎动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "биоматериал, клетки"
                            },
                            {
                                "target_lang_word": "забирать",
                                "target_lang_sense_clarification": "органы"
                            },
                            {
                                "target_lang_word": "добывать",
                                "target_lang_sense_clarification": "охотничий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提取",
                                "target_lang_sense_clarification": "指从生物体中获取细胞或组织"
                            },
                            {
                                "target_lang_word": "捕获",
                                "target_lang_sense_clarification": "指狩猎动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "599a93a9-a946-33b1-aa0a-88dc509e7619",
                    "sense_definition": "To win or achieve a gain as a result of effort.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rising star <w>harvested</w> well-deserved acclaim for her performance.",
                            "target_lang_translations": {
                                "ru": "Восходящая звезда <w>пожала</w> заслуженное признание за свое выступление.",
                                "zh": "这位冉冉升起的新星凭借她的表演<w>赢得</w>了应得的赞誉。"
                            }
                        },
                        {
                            "text": "The company <w>harvested</w> significant profits from the new investment.",
                            "target_lang_translations": {
                                "ru": "Компания <w>получила</w> значительную прибыль от новых инвестиций.",
                                "zh": "该公司从这项新投资中<w>获得</w>了可观的利润。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить выгоду или достижение в результате усилий.",
                        "zh": "通过努力获得收益或成就。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожинать",
                                "target_lang_sense_clarification": "получать результаты (плоды, лавры)"
                            },
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "прибыль, выгоду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "指取得成果或利润"
                            },
                            {
                                "target_lang_word": "赢得",
                                "target_lang_sense_clarification": "指通过努力获得赞誉或荣誉"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}