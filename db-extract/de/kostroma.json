                "senses": [
                    {
                        "sense_id": "c442478b-8982-38fa-b359-eb40b8d6d745",
                        "entry_id": "e99c6c84-ad5a-37e8-9d7d-6f35db526a7c",
                        "glosses": [
                            "rund 350 Kilometer langer Nebenfluss der Wolga in Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c92d14-9c56-4432-a60e-0266f89253d3",
                                "sense_id": "c442478b-8982-38fa-b359-eb40b8d6d745",
                                "text": "„Die Leinenfabrik an der Kostroma, einem Nebenfluss der Wolga, nach dem die Stadt [Kostroma] benannt ist, war Anfang des 19. Jahrhunderts die größte der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5587d4b-1faa-410f-9685-3dfad338c2eb",
                        "source_entry_id": "e99c6c84-ad5a-37e8-9d7d-6f35db526a7c",
                        "source_sense_id": "c442478b-8982-38fa-b359-eb40b8d6d745",
                        "target_lang_word": "Кострома",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Кострома",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f77787e0-1348-30da-887d-d55827a4af77",
                                        "entry_id": "2c562aa9-6f24-3c13-b0df-8ecba65395d9",
                                        "glosses": [
                                            "город в России, административный центр Костромской области, крупный порт на Волге"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd95767-c2c3-4731-9322-f25c90055d73",
                                                "sense_id": "f77787e0-1348-30da-887d-d55827a4af77",
                                                "text": "Петрушка пустил Григорию пыль в глаза тем, что он бывал в Костроме, Ярославле, Нижнем и даже в Москве."
                                            },
                                            {
                                                "example_id": "42c950e5-7b54-4567-9219-23eef75ccc75",
                                                "sense_id": "f77787e0-1348-30da-887d-d55827a4af77",
                                                "text": "В начале сентября мы ездили с ней в Кострому."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a81a320e-676d-3a9f-bb56-2a47bd6e22cb",
                                        "entry_id": "2c562aa9-6f24-3c13-b0df-8ecba65395d9",
                                        "glosses": [
                                            "река в европейской части России, левый приток реки Волга (устье в черте города Кострома)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2756df63-b73d-4b91-9fa3-802d257eb7be",
                                                "sense_id": "a81a320e-676d-3a9f-bb56-2a47bd6e22cb",
                                                "text": "Кострома — одна из многочисленных рек, протекающих по территории России."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55f090f8-58a6-372d-b8cf-336ab12b369c",
                                        "entry_id": "2c562aa9-6f24-3c13-b0df-8ecba65395d9",
                                        "glosses": [
                                            "село в России"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Кострома",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cd2fd930-688e-35dc-8c38-d7eafe3190ff",
                                        "entry_id": "d47a10d1-d529-3aae-83c8-e60da6f3cef8",
                                        "glosses": [
                                            "мифол. персонаж восточнославянской мифологии, воплощение весны и плодородия для (в древних обрядах проводов весны Кострому изображала молодая девушка, закутанная в белое, с дубовой веткой в руках, сопровождаемая хороводом)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d919446a-ff06-44b7-b057-e35ba514c592",
                                                "sense_id": "cd2fd930-688e-35dc-8c38-d7eafe3190ff",
                                                "text": "Особенностью облика Костромы являлось длинное белое одеяние, а основным атрибутом — зелёная ветвь дуба."
                                            },
                                            {
                                                "example_id": "d37f843f-1073-4610-a39e-8a9414282f86",
                                                "sense_id": "cd2fd930-688e-35dc-8c38-d7eafe3190ff",
                                                "text": "А в день Летнего солнцестояния, через 9 месяцев, у Семаргла и Купальницы рождаются дети — Кострома и Купало."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
