                "senses": [
                    {
                        "sense_id": "962ef7b1-b56f-31ff-a93e-ba9743593f35",
                        "entry_id": "08ec6efc-a4bd-3f62-a932-e9cc2b4a74aa",
                        "glosses": [
                            "Schulfach, das überwiegend in sitzender Stellung unterrichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4fa724-8033-42cf-af2d-218eaff5824a",
                                "sense_id": "962ef7b1-b56f-31ff-a93e-ba9743593f35",
                                "text": "„Im Verlauf dieser Arbeit spreche ich an mehreren Stellen vom Unterrichtsfach Sport auf der einen und von eher kognitiv orientierten Fächern auf der anderen Seite. Hiermit ist weder eine binäre Opposition angedeutet, noch gesagt, dass Kognition im Sportunterricht keine Rolle spielt. Vielmehr geht es darum, das Bewegungsfach Sport und Sitzfächer anhand ihrer zentralen Unterrichtsinhalte zu unterscheiden.“"
                            },
                            {
                                "example_id": "23d67d7b-5672-48ae-97ae-92c8befec5cc",
                                "sense_id": "962ef7b1-b56f-31ff-a93e-ba9743593f35",
                                "text": "„Diese sind in Sitzfächern eher kognitiv und in Fächern wie Sport oder Musik tendenziell eher praktisch orientiert.“"
                            },
                            {
                                "example_id": "261c867f-40d6-4439-8ef6-6985965f71bf",
                                "sense_id": "962ef7b1-b56f-31ff-a93e-ba9743593f35",
                                "text": "„Was der Sportlehrer mühsam auf hereintransportierter Tafel oder an improvisierten Modellen den ungeduldig auf das Ende der verbalen Ausführungen harrenden Schülern zu erläutern versucht, kann der Fachlehrer der Sitzfächer mit den ihm zur Verfügung stehenden Apparaturen und Anschauungsmaterialien selbstverständlicher und erfolgversprechender erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca47614f-9ef0-3f98-a0ee-8c8c26834731",
                        "entry_id": "08ec6efc-a4bd-3f62-a932-e9cc2b4a74aa",
                        "glosses": [
                            "Ablage, Stauraum an oder unter einer Sitzvorrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e81cca96-6fb2-44dc-936f-b33f79f249b8",
                                "sense_id": "ca47614f-9ef0-3f98-a0ee-8c8c26834731",
                                "text": "„Rana zieht einen zweischneidigen, gebogenen Säbel, der in einer abgewetzten Lederscheide steckt, aus dem Sitzfach des Gefährts.“"
                            },
                            {
                                "example_id": "ff59cf85-04cf-45dd-9a80-a9a26e17dd1d",
                                "sense_id": "ca47614f-9ef0-3f98-a0ee-8c8c26834731",
                                "text": "„Elvis fischte die Helme aus dem Sitzfach. Eigentlich war darin nur für einen einzigen Helm Platz, aber er beschränkte sich auf eine Art Topfdeckel mit Kinnriemen, weil sein Kopf die Dimensionen jedes normalen Helms sprengte. Glück für Tinne, dadurch passte ihrer auch noch in das Sitzfach.“"
                            },
                            {
                                "example_id": "3384b7d6-99b7-4a76-a75b-71cbbb908e62",
                                "sense_id": "ca47614f-9ef0-3f98-a0ee-8c8c26834731",
                                "text": "Unsere monatliche Bordzeitschrift […] finden Sie auf allen Flügen im Sitzfach vor Ihnen.“"
                            },
                            {
                                "example_id": "a8dc1e60-f267-4c21-b2bf-b04cde336fc0",
                                "sense_id": "ca47614f-9ef0-3f98-a0ee-8c8c26834731",
                                "text": "„Daher griff er ebenfalls nach dem Journal in dem Sitzfach vor ihm und wusste dank der abgedruckten Bilder wenigstens, wie herum er das Magazin halten musste.“"
                            },
                            {
                                "example_id": "ecb14df2-0142-4c4c-8a0b-00fa1c3918de",
                                "sense_id": "ca47614f-9ef0-3f98-a0ee-8c8c26834731",
                                "text": "„Hey, Cinderella, wir sind nicht hier, um einen Beautycontest zu gewinnen, witzelte Andrea und verstaute die beiden weißen Visierhelme im Sitzfach.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
