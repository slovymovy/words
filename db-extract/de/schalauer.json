                ],
                "senses": [
                    {
                        "sense_id": "533adaa0-500b-3da4-9916-1f7b8524450a",
                        "entry_id": "6e5443d7-6f8f-38ab-ad04-8be76620383f",
                        "glosses": [
                            "ein aus Schalauen stammender oder dort auf Dauer lebender Mensch, ein (baltischer) Pruße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d7baf1d-5ad8-4302-9234-7b9ada02a1cc",
                                "sense_id": "533adaa0-500b-3da4-9916-1f7b8524450a",
                                "text": "Nach Dusb. war Sarecka ein Schalauer."
                            },
                            {
                                "example_id": "a1205465-6088-452f-875c-4b8da17d1116",
                                "sense_id": "533adaa0-500b-3da4-9916-1f7b8524450a",
                                "text": "Von einem Verrat, bei dem 100 Christen den Tod fanden: Im Jahre des Herrn 1285 brüstete sich ein Schalauer mit Namen Girdilo, der ehemals vor seiner Bekehrung unter den Seinen in hohem Ansehen stand, daß er großartige Dinge gegen die Litauer vollbringen könne."
                            },
                            {
                                "example_id": "5ee1ebd0-02e3-4e73-b454-9e727dcb86af",
                                "sense_id": "533adaa0-500b-3da4-9916-1f7b8524450a",
                                "text": "Der Sitz der Schalauen, welche in ächten Handschriften vielleicht Slauanoi genannt werden, war vermöge einer genaueren Angabe der Charte des Agathodämons, zwischen dem Flusse Turuntus und den budinischen Bergen, […]"
                            },
                            {
                                "example_id": "501e35ed-9cfb-4140-86ef-caaff6bf1c68",
                                "sense_id": "533adaa0-500b-3da4-9916-1f7b8524450a",
                                "text": "Zwar die Samländer, für ihre Geiseln zitternd, duldeten und beteten auf vorgeschriebene Weise; allein ihre Nachbarn, die frommen Nadrauer, die wilden Schalauer, die muthigen Sudauer, knirschten, weil die mächtigen Samen für Freyheit und Götter nicht alles gewagt; […]"
                            },
                            {
                                "example_id": "15b775c1-5178-4486-b70f-a2a1f2a5a3d7",
                                "sense_id": "533adaa0-500b-3da4-9916-1f7b8524450a",
                                "text": "Die Preussen waren ebenfalls ein Küstenvolk […] und bestanden aus elf Völkerschaften: a) Schalauer, sie wohnten an den Mündungen des Niemen am kurischen Haf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
