            {
                "entry_id": "8f9c3298-1a9b-391d-a49f-f13642d2704f",
                "word": "Boli",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5bbf5a47-bfde-35e2-b2e9-2258e853fdef",
                        "entry_id": "8f9c3298-1a9b-391d-a49f-f13642d2704f",
                        "glosses": [
                            "A county of Qitaihe, Heilongjiang, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5223b456-1093-4ef5-a47b-6bf41db8d43c",
                                "sense_id": "5bbf5a47-bfde-35e2-b2e9-2258e853fdef",
                                "text": "The construction project of the (Taoshan) Reservoir, the largest one ever built in Heilungkiang, is under way. Located 10 kilometers east of the Chitaiho Municipality in Poli County, the reservoir will have a total water storage capacity of 648 million cubic meters."
                            },
                            {
                                "example_id": "a833d27d-11bf-4533-8727-7508b98395a4",
                                "sense_id": "5bbf5a47-bfde-35e2-b2e9-2258e853fdef",
                                "text": "In Heilongjiang Province alone, 14 graphite deposits are reported, with 1 occurrence near Jixi City reportedly containing 300 Mmt of surface-minable material (31) and another large deposit located in the Heling area of Boli County."
                            },
                            {
                                "example_id": "6ad14b6f-d36c-4d44-8d71-f141a90d6666",
                                "sense_id": "5bbf5a47-bfde-35e2-b2e9-2258e853fdef",
                                "text": "The upper part of the combo photo taken in 2008 shows Wang Xifa working at home in Hengtai Village of Boli County, northeast China's Heilongjiang Province."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
