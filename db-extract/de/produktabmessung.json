                "senses": [
                    {
                        "sense_id": "9349b53b-3018-3824-b778-07bc87806ff5",
                        "entry_id": "ec0a81a6-0c4b-3dd0-b976-851d8ab6f6e2",
                        "glosses": [
                            "Wert, der zum Beispiel die Länge, Breite oder Tiefe eines Produkts angibt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "ed6533db-0d32-4ef1-acbc-7da75d792ec1",
                                "sense_id": "9349b53b-3018-3824-b778-07bc87806ff5",
                                "text": "„Somit wird direkt offensichtlich, dass der Volumenanpassungsgrad stark von den Produktabmessungen abhängt.“"
                            },
                            {
                                "example_id": "2bab6cea-867d-4ec4-afaa-05741530158f",
                                "sense_id": "9349b53b-3018-3824-b778-07bc87806ff5",
                                "text": "„Problemstellungen in der Konstruktion umfassen häufig zahlreiche Flächen- und Volumenberechnungen zur Ermittlung der Produktabmessungen in der Überprüfung der Fertigungs- bzw. Kostengerechtheit des Designs.“"
                            },
                            {
                                "example_id": "16eb8b73-37a6-4843-9b5f-00813a7a3cf5",
                                "sense_id": "9349b53b-3018-3824-b778-07bc87806ff5",
                                "text": "„Die manuelle Montage von Großgeräten […] wird in ihrer Montagestruktur vorrangig durch das Produktgewicht, die Produktabmessung und die Produktionsrate bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
