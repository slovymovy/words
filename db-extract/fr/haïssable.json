                            "masculine",
                            "feminine"
                        ],
                        "form": "^((h aspiré))\\a.i.sabl\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb8124a6-aa80-3c83-b467-42dfe9dfb82e",
                        "entry_id": "52cc43c4-364e-36f8-ba61-04b7e88b4b81",
                        "glosses": [
                            "Qui mérite d’être haï, qu’on doit haïr, qui doit inspirer la haine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8c5b7b1-edf9-4cc2-bccb-88fc2ec28299",
                                "sense_id": "eb8124a6-aa80-3c83-b467-42dfe9dfb82e",
                                "text": "Mais en lui-même, il savait bien qu’il suffit de quelques fonctionnaires ignorants et brutaux pour rendre la France haïssable aux yeux de pauvres villageois illettrés et obscurs."
                            },
                            {
                                "example_id": "43351cdb-ada2-4a0d-9643-44d9bb789e2f",
                                "sense_id": "eb8124a6-aa80-3c83-b467-42dfe9dfb82e",
                                "text": "Ainsi, Nancy Pelosi est-elle accusée d’être une ivrogne haïssable et satanique qui s’acharnerait contre Trump, un homme modéré, qui ne chercherait plus qu’à obtenir une passation pacifique des pouvoirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "74bfc37a-9e1f-36d4-8f17-59aac77a6765",
                        "entry_id": "52cc43c4-364e-36f8-ba61-04b7e88b4b81",
                        "glosses": [
                            "Particulièrement irritant, insupportable."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "aee77b76-d316-4544-a3a8-e26ec5e26712",
                                "sense_id": "74bfc37a-9e1f-36d4-8f17-59aac77a6765",
                                "text": "La météo est haïssable ces derniers temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8fdf716-ebb2-3a8f-80e8-80e645b3d967",
                        "entry_id": "52cc43c4-364e-36f8-ba61-04b7e88b4b81",
                        "glosses": [
                            "Coquin, moqueur, farceur, espiègle."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "bd4d51bc-bf9d-4c65-8b08-4ba0e767bf94",
                                "sense_id": "d8fdf716-ebb2-3a8f-80e8-80e645b3d967",
                                "text": "Aimant la vitesse, espiègle, haïssable, André Viger avait tout du petit garçon ordinaire."
                            }
                        ]
                    }
                ],
