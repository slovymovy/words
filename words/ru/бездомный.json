{
    "word_family": [
        "дом",
        "домашний",
        "бездомность",
        "бездомник",
        "бездомовник",
        "одомашнить"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5f8d985-901f-343b-80fe-541acd722001",
                    "sense_definition": "Не имеющий постоянного жилья, крова или приюта.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "homelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В холодные зимние ночи <w>бездомные</w> люди часто ищут временный приют в специальных центрах.",
                            "target_lang_translations": {
                                "de": "In kalten Winternächten suchen <w>obdachlose</w> Menschen oft vorübergehend Zuflucht in speziellen Zentren."
                            }
                        },
                        {
                            "text": "Местные волонтёры регулярно раздают горячую еду и тёплую одежду тем, кто оказался <w>бездомным</w>.",
                            "target_lang_translations": {
                                "de": "Lokale Freiwillige verteilen regelmäßig warmes Essen und warme Kleidung an diejenigen, die <w>obdachlos</w> geworden sind."
                            }
                        }
                    ],
                    "synonyms": [
                        "бесхатный"
                    ],
                    "antonyms": [
                        "домашний"
                    ],
                    "common_phrases": [
                        "бездомные люди",
                        "остаться бездомным"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne feste Wohnung, Unterkunft oder Obdach (auf Menschen bezogen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "obdachlos",
                                "target_lang_sense_clarification": "ohne festen Wohnsitz"
                            },
                            {
                                "target_lang_word": "heimatlos",
                                "target_lang_sense_clarification": "ohne Heimat oder Zuhause"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "565ce26b-05b5-3cd8-9b24-e4bdbc117bda",
                    "sense_definition": "Не имеющий хозяина или постоянного места обитания (о животных).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "homelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она всегда подкармливает <w>бездомных</w> кошек во дворе своего дома.",
                            "target_lang_translations": {
                                "de": "Sie füttert immer die <w>herrenlosen</w> Katzen im Hof ihres Hauses."
                            }
                        },
                        {
                            "text": "В нашем городе открылся новый приют для <w>бездомных</w> собак.",
                            "target_lang_translations": {
                                "de": "In unserer Stadt hat ein neues Tierheim für <w>herrenlose</w> Hunde eröffnet."
                            }
                        }
                    ],
                    "synonyms": [
                        "бродячий"
                    ],
                    "antonyms": [
                        "домашний"
                    ],
                    "common_phrases": [
                        "бездомная собака",
                        "бездомные животные"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne Besitzer oder festen Lebensraum (auf Tiere bezogen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "herrenlos",
                                "target_lang_sense_clarification": "ohne Besitzer (z. B. Hunde, Katzen)"
                            },
                            {
                                "target_lang_word": "streunend",
                                "target_lang_sense_clarification": "umherstreunend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06510156-7c16-3f0d-9f72-c1aa5e983421",
                    "sense_definition": "Не имеющий семьи, собственного хозяйства; одинокий.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "homelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он жил как <w>бездомный</w> странник, не имея ни жены, ни детей, ни собственного угла.",
                            "target_lang_translations": {
                                "de": "Er lebte wie ein <w>heimatloser</w> Wanderer, ohne Frau, Kinder oder eine eigene Bleibe."
                            }
                        },
                        {
                            "text": "Всю свою жизнь этот одинокий человек оставался <w>бездомным</w> бобылём.",
                            "target_lang_translations": {
                                "de": "Sein ganzes Leben lang blieb dieser einsame Mann ein <w>entwurzelter</w> Junggeselle."
                            }
                        }
                    ],
                    "synonyms": [
                        "бессемейный",
                        "сирый"
                    ],
                    "antonyms": [
                        "семейный"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne Familie, eigenen Haushalt; einsam und entwurzelt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "heimatlos",
                                "target_lang_sense_clarification": "im übertragenen Sinne: einsam, ohne familiäre Bindung"
                            },
                            {
                                "target_lang_word": "entwurzelt",
                                "target_lang_sense_clarification": "ohne soziale Bindungen oder festen Halt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04f61fc6-530c-3c46-b970-068ac843b167",
                    "sense_definition": "Человек, который не имеет постоянного жилища, дома или пристанища.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "homelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый вечер этот <w>бездомный</w> приходил к вокзалу в поисках безопасного места для ночлега.",
                            "target_lang_translations": {
                                "de": "Jeden Abend kam dieser <w>Obdachlose</w> zum Bahnhof auf der Suche nach einem sicheren Schlafplatz."
                            }
                        },
                        {
                            "text": "Благотворительная организация помогает <w>бездомным</w> восстановить документы и найти работу.",
                            "target_lang_translations": {
                                "de": "Die Wohltätigkeitsorganisation hilft <w>Obdachlosen</w>, ihre Dokumente wiederzuerlangen und Arbeit zu finden."
                            }
                        }
                    ],
                    "synonyms": [
                        "бомж",
                        "бездомник",
                        "бездомовник"
                    ],
                    "common_phrases": [
                        "помощь бездомным"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die keine feste Wohnung oder Unterkunft hat."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "der Obdachlose",
                                "target_lang_sense_clarification": "männliche Person ohne festen Wohnsitz"
                            },
                            {
                                "target_lang_word": "die Obdachlose",
                                "target_lang_sense_clarification": "weibliche Person ohne festen Wohnsitz"
                            },
                            {
                                "target_lang_word": "der Wohnungslose",
                                "target_lang_sense_clarification": "Person ohne eigene Wohnung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}