                "translations": [
                    {
                        "translation_id": "b0d3dd47-4197-4f22-a257-bfc1cb3fef21",
                        "source_entry_id": "eb5ab876-0a36-362e-a2b0-31c2eb25ca89",
                        "source_sense_description": "city in Palestine",
                        "target_lang_word": "Hébron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hébron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62f6bba5-c01c-3b8f-ab0c-841928a77cee",
                                        "entry_id": "84a4f831-ccc5-3d06-8467-d2340805cee3",
                                        "glosses": [
                                            "Ville de la tribu de Juda où est né Jean-Baptiste ; ville actuelle de Cisjordanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b35b28-d6d6-44ba-a344-91dab8bd44ba",
                                                "sense_id": "62f6bba5-c01c-3b8f-ab0c-841928a77cee",
                                                "text": "Le premier des Makkabi vous a chassés d’Hébron, Hyrcan forcés à vous circoncire !"
                                            },
                                            {
                                                "example_id": "65c99e27-dcd7-4dc2-9108-a5b5028b04ed",
                                                "sense_id": "62f6bba5-c01c-3b8f-ab0c-841928a77cee",
                                                "text": "— Qui me réveille ainsi dans l’ombre sans issue\nOù j’ai dormi dix fois cent ans, roide et glacé ?\nEst-ce toi, premier cri de la mort, qu’a poussé\nLe Jeune Homme d’Hébron sous la lourde massue\nEt les débris fumants de l’autel renversé ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cba3f9c-5338-46f2-b7e0-ad19cafb3c7d",
                        "source_entry_id": "eb5ab876-0a36-362e-a2b0-31c2eb25ca89",
                        "source_sense_description": "city in Palestine",
                        "target_lang_word": "Hebron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hebron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3239600-1f5d-3316-8ff9-579fb27b73b6",
                                        "entry_id": "9709f79e-bde3-347d-897d-b7d3b6ed12bc",
                                        "glosses": [
                                            "Stadt im Westjordanland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4549ab-cde4-4485-82b3-32a55cdc7d02",
                                                "sense_id": "f3239600-1f5d-3316-8ff9-579fb27b73b6",
                                                "text": "„Salem, einer der Schaulustigen, wohnte nur wenige hundert Meter entfernt, sprach aber mit dem starken Akzent derer aus Hebron.“"
                                            },
                                            {
                                                "example_id": "0291956e-ab8b-45e4-8f1c-a6fbb36df4e3",
                                                "sense_id": "f3239600-1f5d-3316-8ff9-579fb27b73b6",
                                                "text": "„Einige stammten aus Hebron, andere aus Nablus.“"
                                            },
                                            {
                                                "example_id": "21d16011-c51a-48ea-b673-a31607c5c6ad",
                                                "sense_id": "f3239600-1f5d-3316-8ff9-579fb27b73b6",
                                                "text": "„Habib Jarada, der heute in Gaza lebt, erinnert sich, dass die Einwohner von Beersheba mit Waffengewalt nach Hebron vertrieben wurden.“"
                                            },
                                            {
                                                "example_id": "c777dec3-8c92-49b1-82b4-a45630353485",
                                                "sense_id": "f3239600-1f5d-3316-8ff9-579fb27b73b6",
                                                "text": "„So hatte im Februar 1994 der radikale Siedler Baruch Goldstein 29 betende Muslime in der Patriarchenhöhle bzw. Abrahamsmoschee in Hebron erschossen.“"
                                            },
                                            {
                                                "example_id": "13662958-d265-4aed-a2d3-10f47c28d323",
                                                "sense_id": "f3239600-1f5d-3316-8ff9-579fb27b73b6",
                                                "text": "„Meine Mutter wird nicht in ihr Haus in Hebron zurückkehren, in dem ihre Familie ermordet wurde; die Famile Zaken wird nicht in ihr Haus in Zaku, Kurdistan, zurückkehren; die Cohens werden nicht nach Kairo zurückkehren; die Shertoks nicht in ihr Haus in Ramallah ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
