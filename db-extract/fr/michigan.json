                                    {
                                        "sense_id": "5451343d-a693-3e5f-9c52-96a8d243766b",
                                        "entry_id": "f5935daf-8cbb-37f5-9fc3-f9d0c32ba6c5",
                                        "glosses": [
                                            "Bundesstaat im Norden der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb86f00-de99-4c1c-b494-12a39dd1c65b",
                                                "sense_id": "5451343d-a693-3e5f-9c52-96a8d243766b",
                                                "text": "Mit einer Fläche von 250 738 Quadratkilometern ist Michigan der elftgrößte Staat der USA."
                                            },
                                            {
                                                "example_id": "072412b8-bfdf-4fd0-8228-36431fc58ef7",
                                                "sense_id": "5451343d-a693-3e5f-9c52-96a8d243766b",
                                                "text": "Die Winter in Michigan sind lang und hart."
                                            },
                                            {
                                                "example_id": "40ac664b-baaa-47ec-8469-3c07cfde3710",
                                                "sense_id": "5451343d-a693-3e5f-9c52-96a8d243766b",
                                                "text": "Der US-Bundesstaat Michigan ist bekannt für seine zahlreichen Blaubeeren- und Kirschplantagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
