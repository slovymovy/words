{
    "word_family": [
        "work"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b760e82-aa21-323f-b393-2ee61717fd9d",
                    "sense_definition": "Somebody with whom one works.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "professional_relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>coworker</w> helped me finish the project on time.",
                            "target_lang_translations": {
                                "zh": "我的<w>同事</w>帮我按时完成了项目。"
                            }
                        },
                        {
                            "text": "I often have lunch with a <w>coworker</w> from the office.",
                            "target_lang_translations": {
                                "zh": "我经常和办公室的<w>同事</w>一起吃午饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colleague",
                        "workmate",
                        "associate"
                    ],
                    "common_phrases": [
                        "office coworker",
                        "helpful coworker"
                    ],
                    "target_lang_definitions": {
                        "zh": "在同一单位工作的人，同事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同事",
                                "target_lang_sense_clarification": "指在同一单位工作的人，最常用的称呼。"
                            },
                            {
                                "target_lang_word": "同僚",
                                "target_lang_sense_clarification": "较为正式的称呼，多用于职场或官场。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2902782-b858-3a81-9d58-04092b20fef6",
                    "sense_definition": "A person who is considered average or mainstream in their tastes and interests.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That show is just too <w>coworker</w> for my taste.",
                            "target_lang_translations": {
                                "zh": "那个节目对我来说太<w>大众化</w>了。"
                            }
                        },
                        {
                            "text": "He thinks he is unique but he is actually quite <w>coworker</w>.",
                            "target_lang_translations": {
                                "zh": "他自认为很独特，但实际上他相当<w>平庸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "normie"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used to describe someone or something as unoriginal or mainstream."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指品味或兴趣平庸、大众化的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "平庸的",
                                "target_lang_sense_clarification": "形容人或事物缺乏特色，非常普通。"
                            },
                            {
                                "target_lang_word": "大众化的",
                                "target_lang_sense_clarification": "指符合大多数人品味，缺乏个性的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}