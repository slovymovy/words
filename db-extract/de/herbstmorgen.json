                "senses": [
                    {
                        "sense_id": "685ad8bd-dab5-3f19-aaed-a615b0ff1fab",
                        "entry_id": "c5bba9f0-ebfd-3a57-ac4a-421c590287c4",
                        "glosses": [
                            "Morgen im Herbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5f78d83-5883-4f48-ae59-5d8ef3eb5181",
                                "sense_id": "685ad8bd-dab5-3f19-aaed-a615b0ff1fab",
                                "text": "„Es war ein schöner, frischer Herbstmorgen - ich glaube im Oktober -, und ich schälte Äpfel, um Apfelmus zu machen.“"
                            },
                            {
                                "example_id": "6f124e64-2561-40bb-8c00-9e5036801871",
                                "sense_id": "685ad8bd-dab5-3f19-aaed-a615b0ff1fab",
                                "text": "„An einem kühlen Herbstmorgen, nicht lange nach dem Ladendiebstahl ihrer Mutter, als Sylvia Beschreibungen zu den Notizen und Zeichnungen Whitmans verfasste und ihre Mutter und Myrsine Kunden bedienten, Bücher einsortierten und im Verkaufsbereich ein wenig aufräumten, kam Julie mit der kleinen Amélie auf dem Arm herein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
