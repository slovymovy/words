                        "source_sense_id": "bbbda673-526e-3e24-b84f-3200ad684187",
                        "source_sense_description": "(Mathématiques) Condition appliquée au début d’un calcul et permettant de valider le résultat d’une fonction mathématique.",
                        "target_lang_word": "precondition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precondition",
