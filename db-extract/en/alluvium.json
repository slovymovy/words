                    {
                        "translation_id": "801ffb8a-cf83-4c5b-a941-711553730fbe",
                        "source_entry_id": "cc664a66-2837-37bc-9d19-21118715a8ae",
                        "source_sense_id": "f7af478e-4e40-3af4-acb3-74b964753815",
                        "source_sense_description": "deposited material",
                        "target_lang_word": "Schwemmland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwemmland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4066e12-4cb0-3798-8ea0-228f060501c1",
                                        "entry_id": "9d96e6db-d2e4-3aea-97f7-7b5e1600da37",
                                        "glosses": [
                                            "angeschwemmtes, fruchtbares Land an der Küste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f587da7-b014-4419-bf39-1824c7161b3c",
                                                "sense_id": "d4066e12-4cb0-3798-8ea0-228f060501c1",
                                                "text": "„Das Tiefland um die Flüsse Ganges und Brahmputra herum ist fruchtbares Schwemmland und bietet Fläche für viele Flüsse, die quer durch das Land verlaufen.“"
                                            },
                                            {
                                                "example_id": "abbc506d-51e5-46c1-ae6a-a8faaaa26907",
                                                "sense_id": "d4066e12-4cb0-3798-8ea0-228f060501c1",
                                                "text": "„Ohne den Zustrom von Schlamm verschwindet das in Jahrtausenden aufgeschüttete Schwemmland in den Meeresfluten.“"
                                            },
                                            {
                                                "example_id": "6bd500ef-ddd1-4553-b701-75d05f3be5ff",
                                                "sense_id": "d4066e12-4cb0-3798-8ea0-228f060501c1",
                                                "text": "„Sie konnten schließlich das gewaltige Schwemmland des Indus erobern, der doppelt soviel Wasser führt wie der Nil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
