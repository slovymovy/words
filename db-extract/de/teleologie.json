                    {
                        "form_id": "fa9ad0a0-b201-4d71-a60f-5da69255194d",
                        "entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Teleologie"
                    },
                    {
                        "form_id": "416908ba-eb35-4f1e-8ca8-9aee2d6e8065",
                        "entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Teleologie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0aed6df-5028-325c-b7df-2c4efc918183",
                        "entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
                        "glosses": [
                            "die Lehre der Ziel- und Zweckbestimmtheit der Dinge, insbesondere von Abläufen sowie Lebewesen und deren Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a609838-d0d8-4be6-ad74-cd1a3d0d018d",
                                "sense_id": "a0aed6df-5028-325c-b7df-2c4efc918183",
                                "text": "„Wegen der Mehrdeutigkeit von schon bei Aristoteles gehört der Begriff der Teleologie, der im Englischen und Französischen nie ganz heimisch wurde, ‚zu den wenigst geklärten der gesamten Philosophie‘.“"
                            },
                            {
                                "example_id": "99eee701-f737-491a-9440-75a6b1857f40",
                                "sense_id": "a0aed6df-5028-325c-b7df-2c4efc918183",
                                "text": "„Diese Vorstellung einer Teleologie bedeutet einmal eine klare Wertung – das, was Zielpunkt ist, ist es auf Grund seiner Vorzüglichkeit – und erlaubt also zweitens, das Vorher/Nachher als Noch-nicht/Nicht-mehr darzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60d86ec7-e900-4a44-a6ca-ec037980b5a2",
                        "source_entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
                        "source_sense_id": "a0aed6df-5028-325c-b7df-2c4efc918183",
                        "target_lang_word": "teleology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teleology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b52ad35-9f1f-30d2-a2df-1130b6722fbe",
                                        "entry_id": "ad0136f6-727f-39c3-be79-1cfef710f22f",
                                        "glosses": [
                                            "The study of the purpose or design of natural occurrences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22cce5b-3713-4619-a9da-06fcc2e6aeac",
                                                "sense_id": "3b52ad35-9f1f-30d2-a2df-1130b6722fbe",
                                                "text": "The received intellectual tradition has it that, in the sixteenth and seventeenth centuries, revolutionary philosophers began to curtail and reject the teleology of the medieval and scholastic Aristotelians, abandoning final causes in favor of a purely mechanistic model of the Universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f2b9669-866c-345e-a384-af22b165d1e8",
                                        "entry_id": "ad0136f6-727f-39c3-be79-1cfef710f22f",
                                        "glosses": [
                                            "An instance of such a design or purpose, usually in natural phenomena."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8957566d-f2a6-46e8-8213-f30e79a61342",
                                                "sense_id": "6f2b9669-866c-345e-a384-af22b165d1e8",
                                                "text": "In short, what every student of biology knows – that within nature there is a teleology having to do with the survival of the species which underpins the distinction between the two sexes and produces between them a natural affinity for one another – no surgeon who knows what is good for him may now say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efadb11b-4a8f-3b5d-b8dc-6f229f7b156e",
                                        "entry_id": "ad0136f6-727f-39c3-be79-1cfef710f22f",
                                        "glosses": [
                                            "The use of a purpose or design rather than the laws of nature to explain an occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e7762ba-fb70-44a3-a6ea-4e51b57f1a05",
                        "source_entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
                        "source_sense_id": "a0aed6df-5028-325c-b7df-2c4efc918183",
                        "target_lang_word": "téléologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9a55f95-ef26-3fce-aadc-ed3dd630ff16",
                                        "entry_id": "482139b8-e66b-31a6-bcd4-e7376eb219b1",
                                        "glosses": [
                                            "Doctrine prônant une explication du monde fondée sur les causalités et les fins dernières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e588d7f-1b5a-47c3-a4c8-3d685d001f81",
                                                "sense_id": "a9a55f95-ef26-3fce-aadc-ed3dd630ff16",
                                                "text": "La téléologie apparente du vivant n'est qu'une illusion créée par la sélection naturelle."
                                            },
                                            {
                                                "example_id": "71fe50ad-3b0f-4b75-b8ad-90443a4fc402",
                                                "sense_id": "a9a55f95-ef26-3fce-aadc-ed3dd630ff16",
                                                "text": "Cette détermination intentionnelle paraît surtout évidente dans les êtres vivants qui forment un tout fini ; elle le paraît moins pour le physicien et le chimiste qui ne voient que des fragments des phénomènes généraux du grand tout. Aussi sont-ce ceux-ci qui ont combattu la téléologie comme fournissant des idées fausses et aujourd'hui les savants n'osent pas avouer qu'ils sont téléologistes parce que ce sont des choses qui ne se démontrent pas."
                                            },
                                            {
                                                "example_id": "8fef3dd7-ac6e-493e-b442-9907d9d2b241",
                                                "sense_id": "a9a55f95-ef26-3fce-aadc-ed3dd630ff16",
                                                "text": "La démocratie, les droits de l'Homme, si d'aucuns pensaient que c'était la téléologie de l'ordre international, les dernières semaines auront battu en brèche quelques évidences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebbd3cc0-f631-41b5-b841-aee1dc4d7c3f",
                        "source_entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
                        "source_sense_id": "a0aed6df-5028-325c-b7df-2c4efc918183",
                        "target_lang_word": "teleologia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teleologia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "44a08bde-df28-3e8d-a3a5-05731430d585",
                                        "entry_id": "8a9b7d20-f95e-3cde-86af-eab68ab24fc7",
                                        "glosses": [
                                            "dottrina filosofica del finalismo, che concepisce l'esistenza della finalità non solo nella comune attività volontaria dell'uomo razionale indirizzata alla realizzazione di uno scopo ma anche in quelle su azioni involontarie e inconsapevoli che tuttavia realizzano un fine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bdad959-4d16-46c5-aee4-ace0f8bd0239",
                                                "sense_id": "44a08bde-df28-3e8d-a3a5-05731430d585",
                                                "text": "la teleologia è la convinzione che ci sia una finalità tra gli esseri viventi, ossia che ogni specie sia nata con uno scopo ben preciso e non casualmente"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f74c3661-846f-4b2a-86f8-36e77b00fc22",
                        "source_entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
