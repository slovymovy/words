                {
                    "sense_id": "77df3a47-577a-3f96-8782-229ea3d2798f",
                    "sense_definition": "Advantage, utility, or service (used mainly in the phrase \"stand in good stead\").",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "standing_benefit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her years of experience will stand in good <w>stead</w> during this difficult project.",
                            "target_lang_translations": {
                                "tr": "Yılların deneyimi bu zorlu proje boyunca onun çok <w>işine yarayacak</w>."
                            }
                        },
                        {
                            "text": "Learning a second language early in life will stand you in good <w>stead</w>.",
                            "target_lang_translations": {
                                "tr": "Erken yaşta ikinci bir dil öğrenmek ileride <w>çok işinize yarayacaktır</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stand in good stead"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yarar, fayda veya hizmet (genellikle 'stand in good stead' deyiminde kullanılır)."
