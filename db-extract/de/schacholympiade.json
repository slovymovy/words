                        ],
                        "examples": [
                            {
                                "example_id": "44e1c5e0-b895-4f5b-8cb3-2454f40cb2e3",
                                "sense_id": "6471d987-f514-3010-93f3-c9edc5bd8d76",
                                "text": "Die Partien der 38. Schacholympiade in Dresden werden live im Internet übertragen."
                            },
                            {
                                "example_id": "3304b22f-6bd7-4795-92a4-01b196ce24c4",
                                "sense_id": "6471d987-f514-3010-93f3-c9edc5bd8d76",
                                "text": "„Gerade wurde die Schacholympiade 2014 nach Tromsö vergeben, alle Jubeljahre trifft der Weltschachbund auch gute Entscheidungen.“"
                            },
                            {
                                "example_id": "d9c44751-41e6-4c3f-8cbf-d9ccbd8a074f",
                                "sense_id": "6471d987-f514-3010-93f3-c9edc5bd8d76",
                                "text": "„Die erste Schacholympiade fand gleichzeitig mit den 8. Olympischen Sommerspielen in Paris statt und folgte den allgemeinen Olympischen Regeln, unter denen die bemerkenswerteste das Teilnahmeverbot professioneller Spieler war.“"
                            }
                        ],
