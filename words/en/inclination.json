{
    "word_family": [
        "incline",
        "inclinable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f37da97-baa9-3cf0-8a62-bbc195381587",
                    "sense_definition": "A slant or slope.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road up to the house had a steep <w>inclination</w>.",
                            "target_lang_translations": {
                                "ru": "Дорога к дому имела крутой <w>уклон</w>."
                            }
                        },
                        {
                            "text": "The path follows a gentle <w>inclination</w> toward the river.",
                            "target_lang_translations": {
                                "ru": "Тропа идёт под пологим <w>уклоном</w> к реке."
                            }
                        }
                    ],
                    "synonyms": [
                        "incline",
                        "steepness"
                    ],
                    "common_phrases": [
                        "steep inclination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покатая поверхность, склон или уклон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклон",
                                "target_lang_sense_clarification": "наклонная поверхность, угол спуска или подъёма"
                            },
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "покатая местность"
                            },
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "наклонное положение или поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "388bda1d-b86a-3cf3-8c49-ea9f8f0feda1",
                    "sense_definition": "A natural tendency or preference to act in a certain way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tendency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a natural <w>inclination</w> to help those in need.",
                            "target_lang_translations": {
                                "ru": "У него была врождённая <w>склонность</w> помогать нуждающимся."
                            }
                        },
                        {
                            "text": "She showed no <w>inclination</w> to change her mind about the project.",
                            "target_lang_translations": {
                                "ru": "Она не выказала никакого <w>желания</w> менять своё мнение о проекте."
                            }
                        }
                    ],
                    "synonyms": [
                        "leaning",
                        "proclivity",
                        "propensity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественная предрасположенность, склонность или предпочтение действовать определённым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонность",
                                "target_lang_sense_clarification": "предрасположенность, влечение"
                            },
                            {
                                "target_lang_word": "наклонность",
                                "target_lang_sense_clarification": "врождённое или привычное влечение"
                            },
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "охота или намерение что-либо делать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e63af07-0117-3481-867b-2d4b1d51dbd8",
                    "sense_definition": "A physical tilt or bend of a body part.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The slight <w>inclination</w> of his head suggested he was listening closely.",
                            "target_lang_translations": {
                                "ru": "Лёгкий <w>наклон</w> головы указывал на то, что он внимательно слушает."
                            }
                        },
                        {
                            "text": "She greeted him with a polite <w>inclination</w> of her head.",
                            "target_lang_translations": {
                                "ru": "Она поприветствовала его вежливым <w>наклоном</w> головы."
                            }
                        }
                    ],
                    "synonyms": [
                        "leaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический наклон или движение частью тела (головой, туловищем)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "движение головой или телом"
                            },
                            {
                                "target_lang_word": "наклонение",
                                "target_lang_sense_clarification": "действие по наклону головы или тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0202364e-096d-329c-9069-267b9f012094",
                    "sense_definition": "The angle of intersection between two planes or lines.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronomer calculated the <w>inclination</w> of the planet's orbit.",
                            "target_lang_translations": {
                                "ru": "Астроном рассчитал <w>наклонение</w> орбиты планеты."
                            }
                        },
                        {
                            "text": "Engineers must account for the <w>inclination</w> of the surface during construction.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны учитывать <w>угол наклона</w> поверхности во время строительства."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угол пересечения между двумя плоскостями или линиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонение",
                                "target_lang_sense_clarification": "угол наклона орбиты или плоскости в науке"
                            },
                            {
                                "target_lang_word": "угол наклона",
                                "target_lang_sense_clarification": "величина наклона в геометрии или технике"
                            },
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "положение под углом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdd0dcd-3059-387d-9b7d-fd33174fc18a",
                    "sense_definition": "A feeling of love or admiration for someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tendency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>inclination</w> toward the arts was evident from a very young age.",
                            "target_lang_translations": {
                                "ru": "Его <w>влечение</w> к искусству проявлялось с самого раннего возраста."
                            }
                        },
                        {
                            "text": "She expressed a strong <w>inclination</w> for classical music.",
                            "target_lang_translations": {
                                "ru": "Она выразила глубокую <w>склонность</w> к классической музыке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely dated in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство симпатии, привязанности или тяги к кому-либо или чему-либо (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонность",
                                "target_lang_sense_clarification": "симпатия, сердечное влечение"
                            },
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "благожелательное чувство, симпатия"
                            },
                            {
                                "target_lang_word": "влечение",
                                "target_lang_sense_clarification": "сильная тяга к чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}