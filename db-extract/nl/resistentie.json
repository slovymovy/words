                                    },
                                    {
                                        "sense_id": "b0878122-8ed4-3d71-848f-87b25c104afd",
                                        "entry_id": "6952b79b-5513-3b90-a3c3-c1c5e4f95505",
                                        "glosses": [
                                            "Grupo organizado que se resiste, abierta o clandestinamente, a un gobierno o fuerza de ocupación"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8f5642af-632d-33f0-921e-89040d2b68f3",
                                        "entry_id": "6952b79b-5513-3b90-a3c3-c1c5e4f95505",
                                        "glosses": [
