                            {
                                "example_id": "aecb1324-a0d9-4643-8f82-bb7840078337",
                                "sense_id": "7a40f6fb-39a0-3eb3-a4c0-7835a2e2e605",
                                "text": "They had not reached the point of differentiating divorces, but classed them indistinctively as disgraceful incidents, in which the woman was always to blame, but the man, though her innocent victim, was yet inevitably contaminated."
                            },
                            {
                                "example_id": "43cc9f80-0b28-4bd3-aff2-efdd6ceed269",
                                "sense_id": "7a40f6fb-39a0-3eb3-a4c0-7835a2e2e605",
                                "text": "It was as an unconscious and deep trance, through which something like a dream only faintly and indistinctively stirs."
                            }
                        ]
                    }
