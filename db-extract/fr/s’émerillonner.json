                "senses": [
                    {
                        "sense_id": "2914d2a0-915a-3f9f-bae5-5e77e7543314",
                        "entry_id": "a61c3d83-148d-3e30-b3b4-25a7e0f8e9de",
                        "glosses": [
                            "Prendre une humeur gaie et joviale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aaedd81-1238-4d00-a35b-5510fc6c1b9e",
                                "sense_id": "2914d2a0-915a-3f9f-bae5-5e77e7543314",
                                "text": "Qu'on s'imagine (...) de grands yeux bruns encore un peu timides, qui ne demandent qu’à s’émerillonner."
                            },
                            {
                                "example_id": "24b5f5b6-a430-46c9-a495-e43392fcf973",
                                "sense_id": "2914d2a0-915a-3f9f-bae5-5e77e7543314",
                                "text": "Il devient galant, égrillard ; son œil s’émerillonne… Il est heureux pour ma vertu que la haie me sépare de lui ; sans quoi, je suis sûre qu’il se jetterait sur moi… Octave Mirbeau, journal d'une femme de chambre, Chap. XIV (1900)"
                            }
                        ]
                    }
                ],
