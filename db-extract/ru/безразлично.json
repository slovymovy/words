                "senses": [
                    {
                        "sense_id": "27c5c3f9-25d2-3a5a-8cd0-75dbe4086fe7",
                        "entry_id": "4d01279c-3e35-3c98-a353-979d3873fcc5",
                        "glosses": [
                            "наречие к безразличный с безразличием, без интереса"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "f22035db-029f-4871-abe4-4a5c97b468cf",
                                "sense_id": "27c5c3f9-25d2-3a5a-8cd0-75dbe4086fe7",
                                "text": "Той яблоне, что вырастил ты сам, // Твое существованье безразлично."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d27945e-b2e3-34ac-8eed-11366b1df95c",
                        "entry_id": "4d01279c-3e35-3c98-a353-979d3873fcc5",
                        "glosses": [
                            "не важно, всё равно, не имеет значения"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "961ce629-4cc4-480a-9cb9-408aae134746",
                        "source_entry_id": "4d01279c-3e35-3c98-a353-979d3873fcc5",
                        "target_lang_word": "no matter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "no matter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e89cda3-a006-31d7-8e25-07685d039bbd",
                                        "entry_id": "e9c70d39-be09-39a4-9a81-5baa8131b89d",
                                        "glosses": [
                                            "It doesn't matter, it's unimportant, it doesn't make any difference."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e615a2-66cc-4e8a-9b51-e451a0108d45",
                                                "sense_id": "4e89cda3-a006-31d7-8e25-07685d039bbd",
                                                "text": "It seems that Doug's coat has gone missing. Oh, well, no matter: we can always buy a new one, now can't we?"
                                            },
                                            {
                                                "example_id": "206bdd61-f367-4f95-a0fe-d03303c0a39d",
                                                "sense_id": "4e89cda3-a006-31d7-8e25-07685d039bbd",
                                                "text": "\"Did you fail your exam?\" \"Yes, but no matter. I'll just study harder next time.\""
                                            },
                                            {
                                                "example_id": "bfa785b1-624e-477a-8f0d-1487599d6a66",
                                                "sense_id": "4e89cda3-a006-31d7-8e25-07685d039bbd",
                                                "text": "My Aunt Rachel brought Jane's dresses for me to wear/Perfectly Good Clothes/And I should've been glad to get them/Perfectly Good Clothes/No matter they didn't fit quite right"
                                            },
                                            {
                                                "example_id": "e4662e5f-615b-45d7-a5f8-27155b545a26",
                                                "sense_id": "4e89cda3-a006-31d7-8e25-07685d039bbd",
                                                "text": "Sadly, [Anna] Wintour did not control the weather, which was disappointingly inclement. But, no matter, because the event was awash with a “tsunami of love”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "no matter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e834576-98d2-3ecb-bbd8-57d961c057e1",
                                        "entry_id": "ce15f528-8a1e-3b65-b05e-5e3fd4271979",
                                        "glosses": [
                                            "Irrespective of, regardless of, in spite of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c83458a-de4d-4d7e-b509-d81dc0f46957",
                                                "sense_id": "9e834576-98d2-3ecb-bbd8-57d961c057e1",
                                                "text": "As an experienced geologist, he can identify any rock no matter where he finds it."
                                            },
                                            {
                                                "example_id": "ada8425a-4a08-437e-8fb0-edcb252d980b",
                                                "sense_id": "9e834576-98d2-3ecb-bbd8-57d961c057e1",
                                                "text": "No matter what the excuse, you must not be late."
                                            },
                                            {
                                                "example_id": "4f3d964a-4156-4858-8298-c1e938120cb4",
                                                "sense_id": "9e834576-98d2-3ecb-bbd8-57d961c057e1",
                                                "text": "We can fix your plumbing no matter the problem."
                                            },
                                            {
                                                "example_id": "8a9d41cb-aadc-45e3-82c8-175c657e7010",
                                                "sense_id": "9e834576-98d2-3ecb-bbd8-57d961c057e1",
                                                "text": "I'll pick you up at the airport on Friday no matter when your flight arrives."
                                            },
                                            {
                                                "example_id": "6ec83e22-7180-41d0-a276-0a40ae6c5c5a",
                                                "sense_id": "9e834576-98d2-3ecb-bbd8-57d961c057e1",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "591eed6e-0e1e-465f-8171-b633a77c9669",
                                                "sense_id": "9e834576-98d2-3ecb-bbd8-57d961c057e1",
                                                "text": "The result in Greece meant Tottenham could not progress, no matter how many goals they scored against Rovers but, after making nine changes to his starting line-up, Harry Redknapp will be pleased with the performance of his fringe players."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
