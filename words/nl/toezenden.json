            "senses": [
                {
                    "sense_id": "027a0db4-2af2-39d4-b217-9c176e52db2e",
                    "sense_definition": "Iets per post naar iemand versturen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkel zal het pakket morgen naar u <w>toezenden</w>.",
                            "target_lang_translations": {
                                "pl": "Sklep <w>prześle</w> Państwu paczkę jutro."
                            }
                        },
                        {
                            "text": "Vergeet niet om het ingevulde formulier tijdig naar de gemeente te <w>toezenden</w>.",
                            "target_lang_translations": {
                                "pl": "Proszę nie zapomnieć o terminowym <w>przesłaniu</w> wypełnionego formularza do urzędu gminy."
                            }
                        }
                    ],
                    "synonyms": [
                        "sturen",
                        "toesturen",
                        "zenden",
                        "opsturen",
                        "posten",
                        "verzenden"
                    ],
                    "common_phrases": [
                        "per post toezenden"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wysyłać coś do kogoś za pośrednictwem poczty lub kuriera."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przesłać",
                                "target_lang_sense_clarification": "wysłać coś do adresata, często w kontekście formalnym"
                            },
                            {
                                "target_lang_word": "wysłać",
                                "target_lang_sense_clarification": "ogólne określenie nadania przesyłki"
                            },
                            {
                                "target_lang_word": "dostarczyć",
                                "target_lang_sense_clarification": "skupienie się na dotarciu przesyłki do odbiorcy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc8ccfe6-702a-3e38-95c2-a93115422ce0",
                    "sense_definition": "Iets opsturen via een ander kanaal dan de post, bijvoorbeeld digitaal",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verzenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wetenschappers <w>toezenden</w> elkaar artikelen via een speciale website.",
                            "target_lang_translations": {
                                "pl": "Naukowcy <w>przesyłają</w> sobie nawzajem artykuły za pośrednictwem specjalnej strony internetowej."
                            }
                        },
                        {
                            "text": "De burgemeester wil de inwoner een bericht van steun <w>toezenden</w>.",
                            "target_lang_translations": {
                                "pl": "Burmistrz chce <w>przesłać</w> mieszkańcowi wiadomość ze słowami wsparcia."
                            }
                        }
                    ],
                    "synonyms": [
                        "sturen",
                        "toesturen",
                        "zenden",
                        "verzenden"
                    ],
                    "common_phrases": [
                        "digitaal toezenden"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wysyłać coś za pomocą innych kanałów niż poczta tradycyjna, np. drogą elektroniczną."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przesłać",
                                "target_lang_sense_clarification": "używane w kontekście cyfrowym, np. przesłać plik lub wiadomość"
                            },
                            {
                                "target_lang_word": "wysłać",
                                "target_lang_sense_clarification": "uniwersalne określenie przekazania informacji lub danych"
                            }
                        ]
                    }
                }
            ]
        }
