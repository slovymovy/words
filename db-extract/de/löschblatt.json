                ],
                "senses": [
                    {
                        "sense_id": "5c4ca254-1ec2-3fea-b2be-f35369b0e865",
                        "entry_id": "5ecf139d-e89f-3959-adaa-777abfe69f44",
                        "glosses": [
                            "ein Blatt aus saugfähigem Papier (= Löschpapier), das das Trocknen beschleunigen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b27c376e-559e-41ed-bc40-77ecba5af211",
                                "sense_id": "5c4ca254-1ec2-3fea-b2be-f35369b0e865",
                                "text": "Um schnellstmöglich weiter schreiben zu können, benutzte ich das Löschblatt, um die Tinte zu trocknen."
                            },
                            {
                                "example_id": "864cd191-99bb-489a-8fc5-b39bd31e5f49",
                                "sense_id": "5c4ca254-1ec2-3fea-b2be-f35369b0e865",
                                "text": "„Ich sehe die Hefte durch, streiche die Fehler an, lege die Löschblätter hinein und klappe sie zu.“"
                            },
                            {
                                "example_id": "0fd09e17-45df-4bad-9712-1dafa566cdf3",
                                "sense_id": "5c4ca254-1ec2-3fea-b2be-f35369b0e865",
                                "text": "„Die Kleckse, die er damit machte, stippte er mit einer Ecke des Löschblatts auf.“"
                            },
                            {
                                "example_id": "104bf235-d9d6-4d8a-ab23-99f0af495de7",
                                "sense_id": "5c4ca254-1ec2-3fea-b2be-f35369b0e865",
                                "text": "„Mein Vorsatz war, das vierte Schuljahr ohne Tintenflecken auf den Löschblättern zu überstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
