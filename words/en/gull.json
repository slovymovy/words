{
    "word_family": [
        "gullible",
        "gullibility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8af62f1-4186-35e2-ab52-fdf87fcc30a8",
                    "sense_definition": "A common white and grey seabird often found near the coast.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gulls</w> were flying over the beach looking for food.",
                            "target_lang_translations": {
                                "zh": "<w>海鸥</w>在海滩上空盘旋寻找食物。"
                            }
                        },
                        {
                            "text": "We heard the loud cries of the <w>gulls</w> near the harbor.",
                            "target_lang_translations": {
                                "zh": "我们在港口附近听到了<w>海鸥</w>响亮的叫声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seabird",
                        "seagull"
                    ],
                    "common_phrases": [
                        "crying gulls",
                        "feeding gulls"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种常见于海岸附近的白色和灰色海鸟。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "海鸥",
                                "target_lang_sense_clarification": "指代海边常见的鸥类鸟。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "896d5c2f-9f4b-3e42-9090-6322fc9d7fd0",
                    "sense_definition": "A person who is easily tricked or deceived.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The con artist looked for a <w>gull</w> among the tourists.",
                            "target_lang_translations": {
                                "zh": "骗子在游客中寻找<w>受骗者</w>。"
                            }
                        },
                        {
                            "text": "He was a naive <w>gull</w> who believed every lie he was told.",
                            "target_lang_translations": {
                                "zh": "他是个天真的<w>傻瓜</w>，对他听到的每一个谎言都深信不疑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "容易受骗或被欺瞒的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "指容易被欺骗的人。"
                            },
                            {
                                "target_lang_word": "受骗者",
                                "target_lang_sense_clarification": "指被欺骗的对象。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b31ac1d-3e14-385a-99ba-ce78e094da0d",
                    "sense_definition": "A type of butterfly belonging to the genus Cepora.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tropical garden was filled with the colorful <w>gull</w> butterfly.",
                            "target_lang_translations": {
                                "zh": "热带花园里到处都是色彩斑斓的<w>绢粉蝶</w>。"
                            }
                        },
                        {
                            "text": "Researchers identified the rare <w>gull</w> in the forest canopy.",
                            "target_lang_translations": {
                                "zh": "研究人员在森林树冠层中发现了这种稀有的<w>绢粉蝶</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种属于绢粉蝶属的蝴蝶。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绢粉蝶",
                                "target_lang_sense_clarification": "指Cepora属的蝴蝶。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8af680fe-15e1-33c0-a481-97b42b1c61c7",
                    "sense_definition": "To trick or deceive someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman tried to <w>gull</w> the customers into buying broken items.",
                            "target_lang_translations": {
                                "zh": "推销员试图<w>欺骗</w>顾客购买损坏的商品。"
                            }
                        },
                        {
                            "text": "They were <w>gulled</w> by his false promises of wealth.",
                            "target_lang_translations": {
                                "zh": "他们被他关于财富的虚假承诺所<w>哄骗</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This verb is not commonly used in contemporary speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "欺骗或蒙蔽某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "欺骗",
                                "target_lang_sense_clarification": "指用谎言或手段蒙蔽他人。"
                            },
                            {
                                "target_lang_word": "哄骗",
                                "target_lang_sense_clarification": "指通过诱导使人上当。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c2a2110c-2b09-3acc-99dc-ec83b1e111b6",
                    "sense_definition": "A family name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named Mr. <w>Gull</w>.",
                            "target_lang_translations": {
                                "zh": "这本书的作者名叫<w>格尔</w>先生。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Gull</w> at the conference.",
                            "target_lang_translations": {
                                "zh": "我在会议上遇到了一位名叫莎拉·<w>格尔</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "格尔",
                                "target_lang_sense_clarification": "作为姓氏的音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}