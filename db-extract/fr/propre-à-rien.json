                "senses": [
                    {
                        "sense_id": "436b74c0-baf4-35d2-896b-7832c39c538a",
                        "entry_id": "d1a2cad6-b771-3ad7-8318-6079ba3578bc",
                        "glosses": [
                            "Personne incapable de réussir quoi que ce soit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8005470f-c715-403f-8310-250e985d57e1",
                                "sense_id": "436b74c0-baf4-35d2-896b-7832c39c538a",
                                "text": "Que pouvait-il faire, n’étant plus qu’un ex-gendarme, un propre-à-rien dont l’Administration et l’Armée dédaignaient aujourd’hui le dévouement ?"
                            },
                            {
                                "example_id": "37bc6bba-c035-46e3-8547-4f23ddc81556",
                                "sense_id": "436b74c0-baf4-35d2-896b-7832c39c538a",
                                "text": "— Je l’ai toujours dit, il n’y aurait que de s’entendre contre les rois et les aristos, au lieu de se manger le nez et de se casser la gueule tout le temps comme des propres-à-rien."
                            },
                            {
                                "example_id": "b1497f31-8c19-42a2-9db0-29c0d595925e",
                                "sense_id": "436b74c0-baf4-35d2-896b-7832c39c538a",
                                "text": "Il s’agit bien de cela, s’écria ma femme. Tu vas te coucher, maintenant, propre-à-rien ! Et l’argent, tu sais qu’il me faut de l’argent demain, beaucoup d’argent ?"
                            },
                            {
                                "example_id": "5ec2e03c-4dab-406d-8e18-765ee644a575",
                                "sense_id": "436b74c0-baf4-35d2-896b-7832c39c538a",
                                "text": "— À qui la faute si ton frère et toi, vous êtes des propres-à-rien, si vous n’êtes pas capables de connaître les limites…"
                            }
                        ]
                    }
                ],
