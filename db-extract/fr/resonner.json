                ],
                "senses": [
                    {
                        "sense_id": "02871e8e-aa5a-3c87-9815-102235391955",
                        "entry_id": "cc8ea288-3a7e-3dc8-94ad-21f831d659b6",
                        "glosses": [
                            "Sonner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a76781-ec2d-4975-89c6-81b095f4ff4e",
                                "sense_id": "02871e8e-aa5a-3c87-9815-102235391955",
                                "text": "Après avoir calculé le temps nécessaire pour sortir de la cuisine et venir tirer le cordon placé sous la porte, il resonna encore de manière à produire un carillon très significatif."
                            },
                            {
                                "example_id": "39658b1d-8b6b-4878-b44d-dd7245f58ca8",
                                "sense_id": "02871e8e-aa5a-3c87-9815-102235391955",
                                "text": "Après avoir mangé, elle a eu un malaise ; j’ai sonné et resonné l’infirmière ; ce que je désirais se réalisait, elle expirait et j’en étais affolée. Un cachet l’a ranimée."
                            },
                            {
                                "example_id": "f069bb18-0548-49fc-8836-c50b62d050ee",
                                "sense_id": "02871e8e-aa5a-3c87-9815-102235391955",
                                "text": "Au point où il se trouvait, il n’avait plus à se soucier de précautions à prendre et il sonna, sonna, resonna, sans susciter le moindre bruit en réponse."
                            },
                            {
                                "example_id": "b178a787-7be1-4c18-8b3d-0e30c4120341",
                                "sense_id": "02871e8e-aa5a-3c87-9815-102235391955",
                                "text": "Je le laisse resonner, et resonner, et encore resonner… Pour finalement me lever à la dernière…"
                            }
                        ]
                    },
                    {
                        "sense_id": "366565b8-3077-3676-b96c-55ef32a5cb2d",
                        "entry_id": "cc8ea288-3a7e-3dc8-94ad-21f831d659b6",
                        "glosses": [
                            "Téléphoner à nouveau à."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "6354fa63-7990-4222-80f0-74389c633899",
                                "sense_id": "366565b8-3077-3676-b96c-55ef32a5cb2d",
                                "text": "Nadine m’a dit qu’elle resonnera Jean pour lui confirmer le rendez-vous."
                            },
                            {
                                "example_id": "4ba989dc-2087-4bc2-bb0a-1cd1d85f5b1b",
                                "sense_id": "366565b8-3077-3676-b96c-55ef32a5cb2d",
                                "text": "Fandor, déjà, s’apprêtait à resonner, soudain il eut un soupir de soulagement : une voix, à nouveau, lui parvenait, une voix familière, la voix de Juve !"
                            }
                        ]
                    }
                ],
