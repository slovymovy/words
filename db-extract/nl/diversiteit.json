                                    {
                                        "sense_id": "e051d842-697b-3051-9437-9c554b995206",
                                        "entry_id": "b3022460-356c-30be-a093-1998961b77d3",
                                        "glosses": [
                                            "Conjunto de cosas diversas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf30f07-61fb-4485-a7a3-a83a03eb90b5",
                                                "sense_id": "e051d842-697b-3051-9437-9c554b995206",
                                                "text": "En este taller se encuentra gran diversidad de marcas de autos."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7ebd766b-0750-32cb-9e70-6826eb0de6ad",
                                        "entry_id": "b3022460-356c-30be-a093-1998961b77d3",
                                        "glosses": [
                                            "Conjunto de personas diferentes en lo nacional, racial y/o cultural."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58068676-7b9a-4ea8-ac93-1c68672e9af0",
                                                "sense_id": "7ebd766b-0750-32cb-9e70-6826eb0de6ad",
                                                "text": "En esta escuela se encuentra gran diversidad de alumnos: nativos, bolivianos, peruanos, africanos, chinos y paraguayos."
                                            }
                                        ],
