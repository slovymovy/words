                        "tags": [],
                        "examples": [
                            {
                                "example_id": "679d0a6d-0afd-4b9c-98a4-8410ae08739e",
                                "sense_id": "00608501-4c68-38f8-9238-2fa9138b386d",
                                "text": "De drassige weilanden konden niet met een tractor worden bewerkt."
                            },
                            {
                                "example_id": "07878cab-aa35-4107-aa5d-3a44a0df87cc",
                                "sense_id": "00608501-4c68-38f8-9238-2fa9138b386d",
                                "text": "Pogue en ik vlogen vooruit en raakten verwikkeld in een wedstrijd wie het snelste door de drassige grond kon ploegen."
                            }
                        ]
                    }
