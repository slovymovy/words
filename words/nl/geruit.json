                },
                {
                    "sense_id": "2e3fbb76-5462-33ee-a592-d96372e9438d",
                    "sense_definition": "voorzien van glazen ruiten of vensterglas",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beglazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hagel sloeg alle <w>geruite</w> ramen van de oude kas in.",
                            "target_lang_translations": {
                                "en": "The hail smashed all the <w>paned</w> windows of the old greenhouse.",
                                "ru": "Град разбил все <w>остеклённые</w> рамы старой теплицы."
                            }
                        },
                        {
                            "text": "De <w>geruite</w> deuren gaven de kamer een klassieke uitstraling.",
                            "target_lang_translations": {
                                "en": "The <w>paned</w> doors gave the room a classic look.",
                                "ru": "Двери <w>со стеклянными вставками</w> придавали комнате классический вид."
                            }
                        }
                    ],
                    "target_lang_definitions": {
