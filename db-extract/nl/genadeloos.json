                    }
                ],
                "senses": [
                    {
                        "sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                        "entry_id": "6ff8c6bf-6421-3a48-b028-dbcecae0737b",
                        "glosses": [
                            "geen genade kennend, meedogenloos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08577f3b-01ec-45dd-bb83-828d0d1033d1",
                                "sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                                "text": "Het was inmiddels vier uur ’s middags, de zon was fel en scheen genadeloos op mij neer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4007037-4ac8-4f6a-b1c3-1e44529c6f4c",
                        "source_entry_id": "6ff8c6bf-6421-3a48-b028-dbcecae0737b",
                        "source_sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                        "target_lang_word": "gnadenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnadenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                        "entry_id": "a3bbf6c4-2d54-30be-a763-33743ea4a83d",
                                        "glosses": [
                                            "ohne Gnade, ohne Wohlwollen gegenüber einem Schwächeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5d193e-2ddc-4554-a13b-eeebb61eff46",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Der König galt als gnadenlos, wenn es um die Verfolgung seiner Feinde ging."
                                            },
                                            {
                                                "example_id": "dd590e49-eb30-432b-8f0c-2ebdb159ee15",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Wir beuten Tiere gnadenlos aus, man denke nur an die Massentierhaltung und unseren Fleischkonsum."
                                            },
                                            {
                                                "example_id": "9c8dbf01-50f7-4326-8d78-b04e6f68a169",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "In Italien, das mit großem Einsatz Migranten aufnimmt, werden dieselben Migranten gnadenlos ausgebeutet. Große Teile der Landwirtschaft leben von diesen Ausgebeuteten."
                                            },
                                            {
                                                "example_id": "347cd810-4213-4a05-8ed7-8d9ab67fd3b5",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Syrische Kampfflugzeuge bombardieren die Rebellengebiete mit gnadenloser Härte."
                                            },
                                            {
                                                "example_id": "8c7cb036-beb9-41f9-95d2-7c5359285158",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Oh, diese Vorstellung war wohl gnadenlos gut!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "873fa9d4-8986-4552-a78e-21847c504219",
                        "source_entry_id": "6ff8c6bf-6421-3a48-b028-dbcecae0737b",
                        "source_sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                        "target_lang_word": "schonungslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schonungslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                        "entry_id": "8ccbda86-9427-3ed2-befb-e6addf9ac056",
                                        "glosses": [
                                            "ohne Rücksicht, ohne Milde, ohne Schonung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6c9770-a727-4bf7-bf49-6462a14ec37b",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "Ohne die Erdatmosphäre, die uns schützt, wären wir und alles andere auf der Erde der kosmischen Strahlung und der Sonnenstrahlung schonungslos ausgesetzt."
                                            },
                                            {
                                                "example_id": "7ca36b37-7a22-4037-ab09-1a17219f32ac",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Das Wahlergebnis - 64,9 Prozent für die Bestätigung des Amtsinhabers – legt schonungslos offen, wie schmal [der] Rückhalt [vom Berliner SPD-Chef Michael Müller], wie gespalten die Partei ist.“"
                                            },
                                            {
                                                "example_id": "5c48cb02-5c15-40a6-849e-6dbb498dc902",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Der Bericht der Arbeitsgruppe ist schonungslos. Die Fehler und Versäumnisse werden benannt.“"
                                            },
                                            {
                                                "example_id": "2ab12a3f-53dc-40ed-bf46-9bbcbd4a2221",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Helmut Schleich analysiert das aktuelle Politgeschehen scharfsinnig, schonungslos und auf den Punkt.“"
                                            },
                                            {
                                                "example_id": "d58b7ec7-f34b-4307-a9ed-f6afae5013af",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Die Auseinandersetzungen im Reichstag in Stockholm werden [durch die Wahl der 'Schwedendemokraten'] härter und schonungsloser werden.“"
                                            },
                                            {
                                                "example_id": "491048ef-3e2e-4a2d-9b22-c6ea04aa7693",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "[Hessens Ministerpräsident Volker Bouffier]: „'[Rechtsradikale Vorgänge in der hessischen Polizei müssen] nun schonungslos aufgeklärt werden.'“"
                                            },
                                            {
                                                "example_id": "db721f56-10e1-47e1-af51-d5d63ec70852",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Ernst Barlachs 'Russische Bettlerinnen', Kriegskrüppel, Zwangsprostituierte, Kupplerinnen und Totengräber – schonungslos zeigen die 'Menschenbilder' im Kunsthaus Kaufbeuren die brutale Welt vom Beginn bis zur Mitte des 20. Jahrhunderts […].“"
                                            },
                                            {
                                                "example_id": "c4bddf8e-ac01-4bdc-a0c1-41f72f3eb3fd",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "[FC Zürich : Larnaca 1:2] „Schonungslos fiel auch [Ludovic] Magnins [Fußballtrainer] Analyse aus, der von einer «verdienten Niederlage» sprach“ […]."
                                            },
                                            {
                                                "example_id": "8bb9dda5-38e0-4436-8aa3-25bb41ccf427",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„[Der Fußballer Kerem] Demirbay ist […] in der Spielanalyse schonungslos: »Wenn du auswärts gegen Berlin drei Tore schießt, bei aller Liebe, dann darfst du keine zwei Punkte mehr hergeben.«“"
                                            },
                                            {
                                                "example_id": "fa3a49b0-044e-4675-838f-65662730088b",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "Schonungslos eröffnete sie das Gespräch: »Wir trennen uns. Sofort, du ziehst heute noch aus und ich behalte die Kinder!«"
                                            },
                                            {
                                                "example_id": "1f888c35-1a58-4c6d-8ff7-997585d87140",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„In 'Distant Lovers' […] rechnet Fitzsimmons schonungslos mit seiner Ehe ab und kommt zu der starken, wenn auch schmerzhaften Einsicht: Besser Freunde als entfremdete Geliebte.“"
                                            },
                                            {
                                                "example_id": "53be38c0-2ec7-47a0-8d77-c12559f862d0",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Schonungslos beschreibt [Esther Kinsky in ihrem Roman 'Sommerfrische'] das prekäre Sozialgefüge, in dem Perspektivlosigkeit den Alltag bestimmt.“"
                                            },
                                            {
                                                "example_id": "89163fb0-a20f-4c1a-9c02-b5163db7a452",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Sie stehlen, verkaufen ihre Körper und prügeln sich durch das Berlin der Dreißigerjahre. Ernst Haffners Roman ist ein schonungsloser Blick auf das Leben obdachloser Jugendlicher im Gewühl der Großstadt.“"
                                            },
                                            {
                                                "example_id": "f474519e-2ae7-41c6-8329-200d01030dc2",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Wojciech Smarzowski zeigt [im polnischen kirchenkritischen Film 'Kler' – oder 'Klerus' –] schonungslos die Abgründe in der katholischen Kirche in Polen – preisgekrönt, einer der meist gesehenen Filme seit 1989.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "374aeca2-afd7-4973-be57-647da6b4a2cc",
                        "source_entry_id": "6ff8c6bf-6421-3a48-b028-dbcecae0737b",
                        "source_sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                        "target_lang_word": "merciless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merciless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e848e83f-14f9-33e5-be5b-736664499341",
                                        "entry_id": "6ceb2353-2738-3f67-8721-14bcff1c52d2",
                                        "glosses": [
                                            "Showing no mercy; cruel and pitiless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c279b03-f3d5-445b-b0b8-a10dc9d293f8",
                                                "sense_id": "e848e83f-14f9-33e5-be5b-736664499341",
                                                "text": "The sun is merciless today, so please take care of yourself."
                                            },
                                            {
                                                "example_id": "13d09184-0d6c-47fb-8848-3062981d6759",
                                                "sense_id": "e848e83f-14f9-33e5-be5b-736664499341",
                                                "text": "But the ruthless cleaning up of those streets and merciless treatment of gang members have triggered outrage and concern among human rights organizations, which have condemned Cecot as inhumane and unacceptable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fb997d8-fc6e-4428-9fbc-aa001ecce1f9",
                        "source_entry_id": "6ff8c6bf-6421-3a48-b028-dbcecae0737b",
                        "source_sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                        "target_lang_word": "ruthless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruthless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07f8653c-08de-367c-90eb-de8792d00480",
                                        "entry_id": "fc5dbf07-bc9d-387f-abc0-00fed3b3b14c",
                                        "glosses": [
                                            "Without pity or compassion; cruel, pitiless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c46589b-b0dd-4ca8-ab80-e2151ef6852d",
                                                "sense_id": "07f8653c-08de-367c-90eb-de8792d00480",
                                                "text": "At length their rage the hoſtile Pow’rs reſtrain, / All but the ruthleſs Monarch of the Main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc8dcf62-fd9c-3434-b0ea-2e79339d0665",
                                        "entry_id": "fc5dbf07-bc9d-387f-abc0-00fed3b3b14c",
                                        "glosses": [
                                            "Uncompromising; unrelenting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd693ac-25e6-4e08-bca5-b045da51318a",
                                                "sense_id": "cc8dcf62-fd9c-3434-b0ea-2e79339d0665",
                                                "text": "Particular note, in this period, should be made of the actions of Joseph Denman, commander of the Northern Division of the Squadron, who went on an absolutely ruthless and systematic campaign along the African coast, burning so-called \"slaving factories\" to the ground and openly daring anyone who objected to try and stop him."
                                            },
                                            {
                                                "example_id": "e42b6044-1374-47b4-93c4-5d3ed798700a",
                                                "sense_id": "cc8dcf62-fd9c-3434-b0ea-2e79339d0665",
                                                "text": "But the ruthless cleaning up of those streets and merciless treatment of gang members have triggered outrage and concern among human rights organizations, which have condemned Cecot as inhumane and unacceptable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1815dc6-f46a-4dee-8809-c22022595793",
                        "source_entry_id": "6ff8c6bf-6421-3a48-b028-dbcecae0737b",
                        "source_sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                        "target_lang_word": "impitoyable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impitoyable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b93dce3e-02ee-3772-b51e-de87f7170a20",
                                        "entry_id": "a47059d6-a952-3f25-82fe-63d0b5542835",
                                        "glosses": [
                                            "Qui est insensible à la pitié, qui est sans pitié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed451d2f-c584-48be-91d3-5613a3911f80",
                                                "sense_id": "b93dce3e-02ee-3772-b51e-de87f7170a20",
                                                "text": "En trois jours, en trois arrivées totalement différentes, le patron du Tour a marqué les esprits : adroit et offensif sur les pavés, surpuissant dans un sprint en côte, ultra-déterminé et impitoyable après les 7 km d’ascension de la Planche."
                                            },
                                            {
                                                "example_id": "172bb213-a3d9-4140-a942-e83d92d2b76c",
                                                "sense_id": "b93dce3e-02ee-3772-b51e-de87f7170a20",
                                                "text": "Staline s'était signalé par des proscriptions impitoyables : découvertes de complots, exécutions d'agents de l'ennemi, épurations à coup de révolver."
                                            },
                                            {
                                                "example_id": "bb04c0b1-3517-4a82-b280-29e182e38fc5",
                                                "sense_id": "b93dce3e-02ee-3772-b51e-de87f7170a20",
                                                "text": "— Carmen est morte, l’innocente et plaintive Carmen. Mais la chanson est plus vivante que jamais, plus impitoyable que jamais, plus torturante que jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ffa5959-58bf-3c25-aef2-f1a3c2094982",
                                        "entry_id": "a47059d6-a952-3f25-82fe-63d0b5542835",
                                        "glosses": [
                                            "Qui est d’une excessive sévérité, qui ne fait grâce à rien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1a4a93-6ce6-4053-bafe-35470f6fa4a1",
                                                "sense_id": "5ffa5959-58bf-3c25-aef2-f1a3c2094982",
                                                "text": "Leur comptabilité impitoyable ne fait pas grâce d'un centime, et les mystères de l’anatocisme ont bien vite fait doubler la dette du nhaqué, sans qu'il puisse en soupçonner le mécanisme."
                                            },
                                            {
                                                "example_id": "a5c2670d-af57-4d8b-8952-a01cba17a9cc",
                                                "sense_id": "5ffa5959-58bf-3c25-aef2-f1a3c2094982",
                                                "text": "Son œil s'attarde pourtant sur la jauge d’essence. Impitoyable, l’aiguille marque zéro. Par quel miracle, le réservoir où Mr. Smith a versé de ses mains, au moment du départ, soixante-dix litres de supercarburant, a-t-il pu se vider subitement ?"
                                            },
                                            {
                                                "example_id": "3b95f83d-6269-4fe0-a4de-ec7402c69a68",
                                                "sense_id": "5ffa5959-58bf-3c25-aef2-f1a3c2094982",
                                                "text": "C'est la fille d'un vicaire que nous envoyions affronter un homme d'affaires très dur, impitoyable, qui était là pour obtenir le meilleur accord pour les Américains… Il y avait plus qu'un relent de misogynie», se souvient l'un de ses conseillers."
                                            },
                                            {
                                                "example_id": "eec55cda-cf5c-44f3-8b70-c31d7efed595",
                                                "sense_id": "5ffa5959-58bf-3c25-aef2-f1a3c2094982",
                                                "text": "A la moindre infraction, la sanction de l’administration américaine est impitoyable, allant jusqu’à une interdiction sur le marché étasunien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
