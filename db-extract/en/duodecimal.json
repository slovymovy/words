                        "entry_id": "4c7d2d3b-ac23-3d15-9960-4adfb3b55c84",
                        "glosses": [
                            "Of a number, expressed in base twelve."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "70cbb49d-fd94-4efe-ba55-ea7fcdfa1d2c",
                                "sense_id": "9fedeef9-a155-363d-9c49-24ae1f7c0882",
                                "text": "6B4 is the duodecimal notation for the decimal number 1000."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78137fd3-d452-415d-ad0a-744747c098e5",
