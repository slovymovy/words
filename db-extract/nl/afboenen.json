                        "glosses": [
                            "aan de buitenkant schoonmaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89831024-0f96-4db3-80d2-26b4f0cb49e8",
                                "sense_id": "d20a17b9-e89b-3eea-b85d-f7f877c2f00e",
                                "text": "Sinaasappels goed afboenen. Snij er één in mooi plakken. Pers de rest uit en bewaar 6 gave lege helften. Maak ze mooi schoon. Breng sinaasappelsap aan de kook en laat inkoken tot ½ dl."
                            },
                            {
                                "example_id": "a508866d-41a6-445a-a302-69a53e468df2",
                                "sense_id": "d20a17b9-e89b-3eea-b85d-f7f877c2f00e",
                                "text": "“Beste Felix, een lekkere, gezonde, vegetarische winterschotel voor 3-4 personen, die ook voor kinderen heerlijk is. Quorn in bak doen, daarover heen aardig wat ketjap, aanlengen met water. Regelmatig door roeren. Zoete aardappel flink afboenen, hoeft niet geschild te worden, in schijven snijden.\""
                            }
                        ]
                    }
