                    }
                ],
                "senses": [
                    {
                        "sense_id": "b34dd1ee-43ec-3df5-b2fd-23621cccd40d",
                        "entry_id": "802a3671-60bb-3026-930f-02271e605da4",
                        "glosses": [
                            "zu Venedig gehörig, aus Venedig stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9496c2c-3e07-468c-9db1-4b14559dac24",
                                "sense_id": "b34dd1ee-43ec-3df5-b2fd-23621cccd40d",
                                "text": "„Inmitten dieser reichen Architektur spielen, wie auf venetianischen Bildern, freundlich milde, ruhige Vorgänge sich ab.“"
                            },
                            {
                                "example_id": "e9380690-0537-4bb8-b931-616f4e524f80",
                                "sense_id": "b34dd1ee-43ec-3df5-b2fd-23621cccd40d",
                                "text": "„Es würde mir eine Ehre sein, gegen den Herrn, der hier fremd scheint, die venetianische Gastfreundschaft zu üben. “"
                            },
                            {
                                "example_id": "39876a20-78e2-48f0-b7bd-6dae705cc299",
                                "sense_id": "b34dd1ee-43ec-3df5-b2fd-23621cccd40d",
                                "text": "„Da stund ihr Spinnrad und Nähkasten, und ein blank venetianisch Spieglein, so sie scherzweise »Frau Neubegier« nannten, zeigte ihr alles, was auf dem Fluß und der Fleischbrücke vorging; denn ihr Haus war unweit derselbigen, dem Barfüßlerkloster gegenüber gelegen.“"
                            },
                            {
                                "example_id": "177e7498-ba97-49dd-abac-67dfb838a67c",
                                "sense_id": "b34dd1ee-43ec-3df5-b2fd-23621cccd40d",
                                "text": "„Innerhalb der venetianischen Kunst bedeutet Tizian das Centrum, wie in der mailändischen Leonardo, in der deutschen Dürer. “"
                            },
                            {
                                "example_id": "b68d65a0-6668-4fb9-9b3d-ea36081b446d",
                                "sense_id": "b34dd1ee-43ec-3df5-b2fd-23621cccd40d",
                                "text": "„Nun bewog der Stadtgovernator den venetianischen Gesandten, Antonio Giustiniani, sich in Person zum Herzog zu begeben, um wegen der Freiheit des Konklave mit ihm zu reden. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
