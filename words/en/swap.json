        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a32300b-ad6b-3b18-9d30-a2973979292b",
                    "sense_definition": "An act of giving one thing and receiving another comparable thing in return.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "exchange_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think trading my bike for your skateboard is a fair <w>swap</w>.",
                            "target_lang_translations": {
                                "ru": "Я думаю, что обмен моего велосипеда на твой скейтборд — это честный <w>обмен</w>.",
                                "tr": "Bisikletimi senin kaykayınla değiştirmemin adil bir <w>takas</w> olduğunu düşünüyorum."
                            }
                        },
                        {
                            "text": "They agreed to a <w>swap</w> of prisoners at the border.",
                            "target_lang_translations": {
                                "ru": "Они договорились об <w>обмене</w> заключенными на границе.",
                                "tr": "Sınırda mahkûm <w>takası</w> yapılması konusunda anlaştılar."
                            }
