                        "examples": [
                            {
                                "example_id": "18c07875-1129-42f7-b621-5dd7c01e0387",
                                "sense_id": "6b66f7df-abde-338e-9cac-84d2af45b1dc",
                                "text": "– Alors t’aimes pas danser ?\n– Admettons que ce soit ça !\n– Parce que t’as jamais dansé qu’avec de pauvres nases !"
                            },
                            {
                                "example_id": "0bd1b66a-7f20-4585-b06f-2e8e7c94a38d",
                                "sense_id": "6b66f7df-abde-338e-9cac-84d2af45b1dc",
                                "text": "Il fallait encore gagner du temps mais, cette fois, je perdis pied :\n– Hein, dis donc, hé ! au fait, le moine maudit, qu'est-ce qu'il glandait, ce nase, ce radis noir, ce foutu ratichon ?"
                            }
                        ]
                    }
