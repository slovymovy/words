                                                "sense_id": "6bcccd3c-03cd-369b-bca2-f1a5ad7d130d",
                                                "text": "Ik werd erdoor geagiteerd"
                                            },
                                            {
                                                "example_id": "0d0381f6-e552-40fc-b9fb-c318116a56db",
                                                "sense_id": "6bcccd3c-03cd-369b-bca2-f1a5ad7d130d",
                                                "text": "Hij raakte daar flink geagiteerd door."
                                            },
                                            {
