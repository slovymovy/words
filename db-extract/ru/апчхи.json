                        "target_lang_word": "atchoum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atchoum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80036b3b-904a-3561-830e-46aebfb989b9",
                                        "entry_id": "5d046e65-de8a-3f80-bf52-4a04c2c0b676",
                                        "glosses": [
                                            "Onomatopée imitant le bruit d’un éternuement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65e5e4f-5424-482f-9ad2-d7228ba1e900",
                                                "sense_id": "80036b3b-904a-3561-830e-46aebfb989b9",
                                                "text": "Le bruit de l'éternuement … est un bruit articulé, c'est un mot de deux syllabes que le vulgaire « Atchoum ! » traduit assez bien."
                                            },
                                            {
                                                "example_id": "cf1e5107-5277-4eb4-a8de-e334c36d8005",
                                                "sense_id": "80036b3b-904a-3561-830e-46aebfb989b9",
                                                "text": "Les Parisiens grelottants\nPassent de jujube à réglisse\nEt depuis six mois je n’entends\nQu’ « Atchoum ! » et que « Dieu vous bénisse ! »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "atchoum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "134d3d4d-98e9-3e47-b7d6-144ffe178419",
                                        "entry_id": "e35e529c-87d1-3b4f-8435-f24dadabc87c",
                                        "glosses": [
                                            "Bruit provoqué par un éternuement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d3b000-f6aa-4904-9493-7024adb6b318",
                                                "sense_id": "134d3d4d-98e9-3e47-b7d6-144ffe178419",
                                                "text": "Aloysius allait sortir quand, pris dans un fort courant d’air, il lança un atchoum tonitruant : – À vos souhaits, fit Romuald, jovial, vous voilà puni : il vous a transmis son coryza !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
