                                                "sense_id": "846d2b33-affd-34fc-9951-c176e8628975",
                                                "text": "Taucher können sich eines Schnorchels bedienen, wenn sie nicht allzu tief tauchen."
                                            },
                                            {
                                                "example_id": "ad89d224-da39-4749-834b-971b0bec6eed",
                                                "sense_id": "846d2b33-affd-34fc-9951-c176e8628975",
                                                "text": "Fahrzeuge, die sich tief im Wasser oder unter Wasser bewegen (z. B. Panzer, U-Boote), können mit Schnorcheln Luft für ihre Motoren ansaugen."
                                            },
                                            {
                                                "example_id": "a4201ce4-68a9-41ee-8d64-c14b22733410",
                                                "sense_id": "846d2b33-affd-34fc-9951-c176e8628975",
                                                "text": "„Jetzt haben wir zwei Schnorchel – aber die Booe, für die sie gedacht waren, sind längst draußen: ohneSchnorchel.“"
                                            }
                                        ],
