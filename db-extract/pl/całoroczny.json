                        "source_sense_id": "6785e422-5c1d-34ba-9c04-c8cdda112fd7",
                        "target_lang_word": "year-round",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "year-round",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e4e0f99-56a4-33bd-a63d-a265d39e674d",
                                        "entry_id": "56794adb-c56d-3541-bd9a-be956ce4a5ae",
                                        "glosses": [
                                            "Operating or continuing throughout the year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29bcaa95-411e-4dd3-bd9b-29dd0c1e64d3",
                                                "sense_id": "2e4e0f99-56a4-33bd-a63d-a265d39e674d",
                                                "text": "This is a year-round business, so we can't afford holidays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "year-round",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac98d089-10b8-3d44-8b4b-5273c1c43a2c",
                                        "entry_id": "e9ea68d2-fb20-39a2-a7d2-29106c197802",
                                        "glosses": [
                                            "Continuing throughout the year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc09ce50-1b0c-4396-b38d-f9d7fb12ff9f",
                                                "sense_id": "ac98d089-10b8-3d44-8b4b-5273c1c43a2c",
                                                "text": "They live year-round in Florida."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "034ecec6-7f76-4fcb-970c-5c4d4eaa8756",
                        "source_entry_id": "91d041f7-172b-3132-a9e0-c0edb2a22515",
                        "source_sense_id": "6785e422-5c1d-34ba-9c04-c8cdda112fd7",
                        "target_lang_word": "yearlong",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yearlong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4de61428-185f-31bc-80c7-a80eaadde090",
                                        "entry_id": "ab445e96-e768-3164-ab6b-9b703faec790",
                                        "glosses": [
                                            "Lasting one year; of a timespan of one year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8fab9f7-9175-4a2b-8c6d-371b0823e864",
                                                "sense_id": "4de61428-185f-31bc-80c7-a80eaadde090",
                                                "text": "Both are congruent with a yearlong periodicity, which is apparently neutralized in the main settlement."
                                            },
                                            {
                                                "example_id": "1cdac4c9-9961-4667-a9f8-353bb54f3f02",
                                                "sense_id": "4de61428-185f-31bc-80c7-a80eaadde090",
                                                "text": "By saving your entire file of daily and weekly lists, you will create your yearlong list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d41e98-153b-3f10-a946-32c065d5e503",
                                        "entry_id": "ab445e96-e768-3164-ab6b-9b703faec790",
                                        "glosses": [
                                            "Which lasts throughout every year; which is not seasonal"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9020d2b8-c82e-4573-9ebe-a6331b2d9f5d",
                                                "sense_id": "71d41e98-153b-3f10-a946-32c065d5e503",
                                                "text": "Yearlong manning is needed, although at a somewhat reduced level from the peak periods in the fall."
                                            },
                                            {
                                                "example_id": "f5fd9a8b-162c-46f9-b14e-f0aebc74d83b",
                                                "sense_id": "71d41e98-153b-3f10-a946-32c065d5e503",
                                                "text": "During interviews, teachers and/or principals in three of the four most effective schools cited a yearlong staff development effort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yearlong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f6471be-1c87-3950-8ff6-5716b74f5dae",
                                        "entry_id": "09329ace-b44d-3598-a394-0cc8e31aece4",
                                        "glosses": [
                                            "Per year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe3ae950-e4fe-40ec-baee-5fafaba0a9e8",
                                                "sense_id": "2f6471be-1c87-3950-8ff6-5716b74f5dae",
                                                "text": "The estimate of the number of sheep and cattle now using this range is equivalent to 250000 cattle units yearlong"
                                            },
                                            {
                                                "example_id": "b2f7d871-c372-4944-ba48-2c042518ef61",
                                                "sense_id": "2f6471be-1c87-3950-8ff6-5716b74f5dae",
                                                "text": "The carrying capacity of this area is 46 cattle yearlong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac2bf231-5da4-3534-989a-5fd84b1c9b86",
                                        "entry_id": "09329ace-b44d-3598-a394-0cc8e31aece4",
                                        "glosses": [
                                            "Throughout every year; not seasonally"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57401ec4-9c65-45c8-acbd-b68c073a35a0",
                                                "sense_id": "ac2bf231-5da4-3534-989a-5fd84b1c9b86",
                                                "text": "Over much of the Great Plains, water was not available yearlong for units of land as small as the customary ownership units"
                                            },
                                            {
                                                "example_id": "105c15bb-e9d3-414a-a5b6-05c55defbe07",
                                                "sense_id": "ac2bf231-5da4-3534-989a-5fd84b1c9b86",
                                                "text": "Black bear and mountain goats occur in the area yearlong."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c32bde0d-6fcb-40f8-aaef-feee922aa0ad",
                        "source_entry_id": "91d041f7-172b-3132-a9e0-c0edb2a22515",
