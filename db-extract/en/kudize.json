                        "sense_id": "4c162e18-20d6-3845-96d4-75c10df31345",
                        "entry_id": "f5956a8b-9e8e-36b1-94ba-4fb4ca980445",
                        "glosses": [
                            "To praise or extol."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6d08a362-dfd6-4337-913b-33ef62ec1579",
                                "sense_id": "4c162e18-20d6-3845-96d4-75c10df31345",
                                "text": "A gentleman \"kudized Louisa, who blushed when he compared her to Penthesilia\": we should think she did."
                            },
                            {
                                "example_id": "0ddeaaad-20f8-4c4c-98b4-393e76733fbe",
                                "sense_id": "4c162e18-20d6-3845-96d4-75c10df31345",
                                "text": "Homer wrote the Odyssey for fun in his youth, and the Iliad in his old age to kudize some stuck-up aristocratic families."
                            },
                            {
                                "example_id": "1ee77baa-c5d1-4594-8c23-c0285e71270f",
                                "sense_id": "4c162e18-20d6-3845-96d4-75c10df31345",
                                "text": "It's time to rise to the occasion. I need to kudize the Arab Springs."
                            }
                        ]
                    }
