                "translations": [
                    {
                        "translation_id": "98e5310a-70d9-492e-bf5d-abb24e04cd81",
                        "source_entry_id": "682d3d8d-39e4-3e03-855a-d35d46b452c4",
                        "source_sense_id": "502fffb0-240f-3010-bba5-05eb3edd4248",
                        "target_lang_word": "optimism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optimism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aab71f4-e6d2-3f5b-8171-68ed250ebcd8",
                                        "entry_id": "bba58851-0c95-3ad4-8c04-b546bbbdd849",
                                        "glosses": [
                                            "a tendency to expect the best, or at least, a favourable outcome"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af0e26a-40ae-4fbd-86d9-3ce1a1174f34",
                                                "sense_id": "1aab71f4-e6d2-3f5b-8171-68ed250ebcd8",
                                                "text": "I love her youth, her beauty and above all her optimism that everything will turn out fine."
                                            },
                                            {
                                                "example_id": "97e4bcce-29ba-4df6-b7f1-60fc86d723fc",
                                                "sense_id": "1aab71f4-e6d2-3f5b-8171-68ed250ebcd8",
                                                "text": "Hanks is known as being an avid reader of history and biography, and seems to seek out stories which offer a certain optimism and humanism. In other words, he plays – fundamentally – good people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edad9b99-f1e3-3d4e-9e06-3b6c0b69b71a",
                                        "entry_id": "bba58851-0c95-3ad4-8c04-b546bbbdd849",
                                        "glosses": [
                                            "the doctrine that this world is the best of all possible worlds"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "096f4571-6a8a-3f47-9c71-16b42351c749",
                                        "entry_id": "bba58851-0c95-3ad4-8c04-b546bbbdd849",
                                        "glosses": [
                                            "the belief that good will eventually triumph over evil"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cc2940a-4f65-475b-a722-e50903506177",
                        "source_entry_id": "682d3d8d-39e4-3e03-855a-d35d46b452c4",
                        "source_sense_id": "502fffb0-240f-3010-bba5-05eb3edd4248",
                        "target_lang_word": "optimisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optimisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83b6a215-5b1a-3500-8f20-1676fb31e1e6",
                                        "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                                        "glosses": [
                                            "Doctrine philosophique qui soutient que tout ce qui existe est le mieux possible."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fab5d9a-4417-34f0-8e89-e47b5e8749e6",
                                        "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                                        "glosses": [
                                            "Une certaine disposition à voir les choses en beau, à ne pas s’inquiéter des embarras présents et à bien augurer de l’avenir."
                                        ],
                                        "tags": [
                                            "Ordinairement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0b7d4c-b6ac-4fb0-9f15-9cdbc8236b50",
                                                "sense_id": "1fab5d9a-4417-34f0-8e89-e47b5e8749e6",
                                                "text": "Ses ouvrages […] contiennent nombre de pensées inspirées par ce vaillant optimisme matérialiste et orientées contre l’agnosticisme, le relativisme et d'autres variétés d'idéalisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e47363b7-aad8-329e-a072-61811fa3cbeb",
                                        "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                                        "glosses": [
                                            "Impression qu’on a, dans une circonstance particulière, de voir les choses prendre bonne tournure."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "548fb1f1-58c7-444e-b713-8fed49e4e49a",
                                                "sense_id": "e47363b7-aad8-329e-a072-61811fa3cbeb",
                                                "text": "Je sens mes intestins qui ronronnent légèrement. La digestion sans heurts est le plus grand facteur d’activité. Le cerveau s’emplit avec le ventre et l’optimisme a sa source dans la béatitude des tripes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c6d5138-2f07-4129-bb66-15038cbd456e",
