                    {
                        "translation_id": "d9eb256a-e485-484d-8d0c-935e51d93333",
                        "source_entry_id": "5c50a58d-b2a6-3162-8738-fe12260db7d1",
                        "source_sense_description": "very hot and dry",
                        "target_lang_word": "torride",
