                "senses": [
                    {
                        "sense_id": "036724f2-c98b-3658-8abf-30ebb1f0a7d7",
                        "entry_id": "7d22919c-c277-3aa2-8929-0909234334d9",
                        "glosses": [
                            "Aspiration von Lauten, das heißt Hervorbringen der Laute mit verstärktem Luftstrom"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "ceac177d-dce3-4dfb-95f5-4a5f93ffd2bb",
                                "sense_id": "036724f2-c98b-3658-8abf-30ebb1f0a7d7",
                                "text": "Im Deutschen weisen die stimmlosen Verschlusslaute vor Vokalen immer eine Behauchung auf. Also: [p] in „Peter“ hat eine starke Behauchung."
                            },
                            {
                                "example_id": "035ffe67-5744-4f93-b315-4d7b00298651",
                                "sense_id": "036724f2-c98b-3658-8abf-30ebb1f0a7d7",
                                "text": "„Vergleicht man die Aussprache der englischen Wörter ‚nitrate‘ (deutsch ‚Nitrat‘) und ‚nightrate‘ (deutsch ‚Nachttarif‘), so kann man beim Übergang von /t/ zu /r/ gewisse Unterschiede ausmachen, die den Grad der Aspiration, also der Behauchung, und der Lautdauer betreffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
