                "senses": [
                    {
                        "sense_id": "d019e3da-fb77-386f-bc40-1cf69cf76308",
                        "entry_id": "b9cfcd36-c173-3aa0-b509-7afacc9b7ba7",
                        "glosses": [
                            "Ensemble des plaques plus ou moins crevassées situées en surface de l'écorce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966eb54b-420e-4afc-8587-ea523cfeb4cc",
                                "sense_id": "d019e3da-fb77-386f-bc40-1cf69cf76308",
                                "text": "L'écorce, longtemps mince et de couleur orangée ou rose - saumonée, présente tardivement un rhytidome peu épais, à sillons peu profonds, séparant des plaques polygonales jointives, de teinte plus ou moins violacée."
                            },
                            {
                                "example_id": "d0550d10-2b10-4eba-96c5-e428ad820423",
                                "sense_id": "d019e3da-fb77-386f-bc40-1cf69cf76308",
                                "text": "Le tronc [de l'if], toujours trapu par rapport à la hauteur de l'arbre, est recouvert, comme les plus grosses branches, d'une écorce rougeâtre ; au fil des ans, le rhytidome se recroqueville et se détache par plaques ou par bande."
                            }
                        ]
                    }
                ],
