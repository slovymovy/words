                "senses": [
                    {
                        "sense_id": "3234cfb7-3718-361e-b13d-5c84e78ae52e",
                        "entry_id": "94813598-99af-3b6f-bc4d-bbc4d6c1bc64",
                        "glosses": [
                            "Qui ne peut pas être réclamé en retour ; qui n’est pas remboursable."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "62b52636-5266-4e86-bcb6-1dc23d319ec3",
                                "sense_id": "3234cfb7-3718-361e-b13d-5c84e78ae52e",
                                "text": "Ces sortes d'affaires s’instruisent sans huissiers ni défenseurs. Le ministère de ceux-ci est déclaré n’être pas obligatoire, et le surcroît de frais qu’il eût occasionné être irrépétible."
                            },
                            {
                                "example_id": "de7d8d86-3d77-44ef-919e-28b2539966b6",
                                "sense_id": "3234cfb7-3718-361e-b13d-5c84e78ae52e",
                                "text": "Dans l’hypothèse où le juge considérerait la demande fondée et suffisamment justifiée, la personne publique sera condamnée à payer une indemnité au titulaire, éventuellement augmentée d’intérêts moratoires et de frais irrépétibles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
