                    {
                        "sense_id": "c7134da7-7de5-3d36-a571-0421f9d1210f",
                        "entry_id": "0c517ce4-52d7-33ee-bb40-7cb118773672",
                        "glosses": [
                            "Alternative letter-case form of GIF."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8b1425a8-6583-40a7-a73e-90f077b8d4f5",
                                "sense_id": "c7134da7-7de5-3d36-a571-0421f9d1210f",
                                "text": "Naomi Osaka, a Japanese professional tennis player, also responded to the NHK post with a popular gif of “Family Feud” host Steve Harvey expressing bewilderment."
                            }
                        ]
                    }
