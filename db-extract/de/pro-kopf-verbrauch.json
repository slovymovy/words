                ],
                "senses": [
                    {
                        "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                        "entry_id": "295872a2-50ad-3efa-a19d-ca2aeeb2e5af",
                        "glosses": [
                            "Quotient, der den Verbrauch einer Ressource oder Ware auf eine Anzahl der verbrauchenden Personen in einem Zeitraum bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785c2a31-ce0f-4a37-b714-7d70fb953fe5",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "Wenn Kinder ausziehen, steigt fast automatisch der Pro-Kopf-Verbrauch an Heizöl oder Erdgas der zurückbleibenden Eltern, weil die Wohnung/das Haus weiter geheizt werden muss."
                            },
                            {
                                "example_id": "a3fbf807-62a2-4552-acb7-d91457d016c0",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Der Pro-Kopf-Verbrauch von Speisefrischkartoffeln ging um 3,7 Kilogramm zurück“"
                            },
                            {
                                "example_id": "98f3345f-24d8-4698-84c1-c46e683c4cf8",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„In der Schweiz lag der Pro-Kopf-Verbrauch von Frisch- und Lagergemüse im Jahr 2020 bei 86,7 Kilogramm.“"
                            },
                            {
                                "example_id": "7e4806cf-36be-4931-87d8-d7337b589731",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Im weltweiten Durchschnitt werden etwa 19,7 kg Fisch pro Person und Jahr verbraucht. Der jährliche Pro-Kopf-Verbrauch in Ozeanien liegt bei ca. 24,8 kg, in Nordamerika 21,4 kg und in Europa 22,2 kg (Quelle: State of world fisheries and aquaculture, FAO, 2016).“"
                            },
                            {
                                "example_id": "0c662094-2a98-4cef-b05b-f9b3f7332850",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Seit den 1960er-Jahren hat sich der weltweite Pro-Kopf-Verbrauch von Fisch nahezu verdoppelt.“"
                            },
                            {
                                "example_id": "4edaa219-92f4-43ac-8c16-6ce248f62228",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„30. Juni 1957 – Der Fleischverbrauch in der Bundesrepublik und in Berlin (West) lag im Wirtschaftsjahr 1956/57 bei 2,63 Millionen t. Der Pro-Kopf-Verbrauch stieg um 2,4 kg auf 49,7 kg.“"
                            },
                            {
                                "example_id": "0576f8a3-7cf8-4bd5-85c2-d12876f460ec",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Der globale Fleischkonsum hat in den vergangenen Jahrzehnten deutlich zugenommen. Laut Angaben der Ernährungs- und Landwirtschaftsorganisation der Vereinten Nationen (FAO) hat sich der Pro-Kopf-Verbrauch seit Anfang der 1960er-Jahre fast verdoppelt - von jährlich rund 23,1 Kilogramm (kg) auf 43,2 kg im Jahr 2019.“"
                            },
                            {
                                "example_id": "85f81758-48de-4d42-ba2b-8495a127e8d0",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Auf dem afrikanischen Kontinent hingegen liegt der durchschnittliche Pro-Kopf-Verbrauch bei 17 Kilogramm Fleisch im Jahr – und beträgt damit nur knapp ein Sechstel der Top-Verbraucher Australien und USA.“"
                            },
                            {
                                "example_id": "fe2a8fd7-2ebc-4493-952c-3bc4b2abdcfc",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Deutschland liegt laut WHO europaweit auf Platz vier, was den Pro-Kopf-Verbrauch an reinem Alkohol betrifft.“"
                            },
                            {
                                "example_id": "b34b4432-3335-411d-afd7-40a01e7b6ecb",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„In Deutschland werden Jahr für Jahr 10 Milliarden Liter Mineralwasser verbraucht, das entspricht einem Pro-Kopf-Verbrauch von 130 Litern.“"
                            },
                            {
                                "example_id": "fb7dda02-77d3-412e-bd50-09093480c49d",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Die Deutschen stehen im Pro-Kopf-Verbrauch bei Papier an vierter Stelle, Tendenz steigend.“"
                            },
                            {
                                "example_id": "da3427f1-968e-4ea7-8c16-8eb1757da21a",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„In Deutschland ist der Pro-Kopf-Verbrauch an Spenderblut höher als in jedem anderen Land der Welt, so fast doppelt so hoch wie etwa in den Niederlanden.“"
                            },
                            {
                                "example_id": "2ea68538-7978-4076-be03-7e76934e5952",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "[Wasserverbrauch:] „In den vergangenen 20 Jahren ist es gelungen, den Pro-Kopf-Verbrauch kontinuierlich nach unten zu schrauben.“"
                            },
                            {
                                "example_id": "60bf8c93-178a-413b-8feb-b24a922b271c",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "[…] „wir verbrauchen Wasser nicht nur direkt, sondern auch indirekt, indem wir Kleidung, Lebensmittel und andere Waren kaufen, für deren Produktion viel Wasser benötigt wird. Dieser indirekte Wasserverbrauch liegt um ein Vielfaches über dem durchschnittlichen, täglichen, direkten Pro-Kopf-Verbrauch von rund 130 Litern in Deutschland, nämlich bei rund 4.000 bis 5.000 Litern pro Kopf und Tag. So stecken etwa in einem einzigen Baumwoll-T-Shirt rund 2.000 Liter Wasser.“"
                            },
                            {
                                "example_id": "4643c545-bee5-45b4-94ce-f0ad13031aa7",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Heutzutage werden täglich in Europa 120 Millionen Streichholzschachteln hergestellt. Europas Pro-Kopf-Verbrauch beträgt 1600 Zündstäbe jährlich.“"
                            },
                            {
                                "example_id": "39ab712a-0973-4309-9bed-cac967e3e1f2",
                                "sense_id": "2a5e5f59-1c20-3aef-91c3-3374da73251a",
                                "text": "„Der Verbrauch von Primärenergie in Deutschland im Jahr 2018 von insgesamt 13.129 Petajoule (PJ) entspricht einem Pro-Kopf-Verbrauch von rund 43.929 kWh pro Einwohner (83,019 Mio. Einwohner).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
