    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe135eb7-d9ac-3ade-8358-2c8addbfff29",
                    "sense_definition": "Remplacer quelqu'un dans une tâche ou un poste pour lui succéder ou lui permettre de se reposer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "remplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux conducteurs se <w>relaient</w> régulièrement afin d'éviter l'endormissement sur l'autoroute."
                        },
                        {
                            "text": "Mon collègue vient me <w>relayer</w> à midi pour que je puisse enfin déjeuner."
                        }
                    ],
                    "synonyms": [
                        "remplacer",
                        "suppléer"
                    ],
                    "common_phrases": [
                        "se relayer au volant",
                        "relayer une équipe"
                    ]
                },
                {
                    "sense_id": "d73a54d1-1194-3253-afcf-2da03c71c563",
                    "sense_definition": "Diffuser largement une information, un appel ou un message pour accroître sa portée.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les médias ont largement <w>relayé</w> cette nouvelle dès le début de la matinée."
                        },
                        {
                            "text": "De nombreux internautes ont choisi de <w>relayer</w> cet appel à la solidarité sur les réseaux sociaux."
                        }
                    ],
                    "synonyms": [
                        "diffuser",
                        "propager",
                        "transmettre"
                    ],
                    "common_phrases": [
                        "relayer une information",
                        "relayer un appel",
                        "relayer un message"
                    ]
                },
                {
                    "sense_id": "d8954d11-15ab-39a5-8fd9-821a59d87d97",
                    "sense_definition": "Retransmettre un signal, des ondes ou un programme à l'aide d'un dispositif technique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette antenne permet de <w>relayer</w> le signal audiovisuel vers les villages isolés de la vallée."
                        },
                        {
                            "text": "La radio locale a <w>relayé</w> le concert en direct pour ses auditeurs."
                        }
                    ],
                    "synonyms": [
                        "retransmettre"
                    ],
                    "common_phrases": [
                        "relayer un signal",
                        "relayer une émission"
                    ]
                },
                {
                    "sense_id": "edb34551-5344-3686-8fa8-7e8deb3f73a5",
                    "sense_definition": "Changer les chevaux fatigués d'une voiture ou d'une diligence par des chevaux frais dans un relais.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La diligence devait s'arrêter dans cette bourgade pour <w>relayer</w> avant la traversée de la montagne."
                        },
                        {
                            "text": "Le messager s'arrêta quelques minutes à l'auberge pour <w>relayer</w> et repartit immédiatement."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Concerne les voitures à traction hippomobile"
                        }
                    ]
                }
            ]
