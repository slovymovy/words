                        "sense_id": "893966f9-e44c-310b-90c1-4e4adf216d1f",
                        "entry_id": "09956a6e-f0eb-3879-b7a7-0f4352f5789b",
                        "glosses": [
                            "eine Farbe im Kartenspiel (deutsches Blatt)"
