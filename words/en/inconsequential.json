{
    "word_family": [
        "consequence",
        "consequent",
        "consequential",
        "consequentially",
        "inconsequence",
        "inconsequentially"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f1c46a5-c5bf-3b4b-9040-d3258ab4be8b",
                    "sense_definition": "Having no significant effect or importance; trivial.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided that the small accounting error was completely <w>inconsequential</w> to the quarterly budget.",
                            "target_lang_translations": {
                                "nl": "De manager besloot dat de kleine boekhoudkundige fout volkomen <w>onbelangrijk</w> was voor het kwartaalbudget."
                            }
                        },
                        {
                            "text": "They spent hours arguing over <w>inconsequential</w> details instead of addressing the real problem.",
                            "target_lang_translations": {
                                "nl": "Ze waren urenlang aan het ruziën over <w>onbeduidende</w> details in plaats van het echte probleem aan te pakken."
                            }
                        }
                    ],
                    "synonyms": [
                        "unimportant",
                        "insignificant",
                        "negligible",
                        "trivial",
                        "immaterial"
                    ],
                    "antonyms": [
                        "consequential",
                        "significant",
                        "important"
                    ],
                    "common_phrases": [
                        "inconsequential details",
                        "seemingly inconsequential",
                        "inconsequential matter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geen wezenlijk effect of belang hebbend; onbelangrijk of triviaal."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onbelangrijk",
                                "target_lang_sense_clarification": "niet van gewicht of betekenis"
                            },
                            {
                                "target_lang_word": "onbeduidend",
                                "target_lang_sense_clarification": "zeer klein of van weinig waarde"
                            },
                            {
                                "target_lang_word": "futiel",
                                "target_lang_sense_clarification": "triviaal, nietszeggend"
                            },
                            {
                                "target_lang_word": "verwaarloosbaar",
                                "target_lang_sense_clarification": "zo gering dat men het kan negeren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cda5896-e0c7-347d-8896-e8e9c533a459",
                    "sense_definition": "Not following logically from the premises; lacking logical connection.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His explanation was so rambling and <w>inconsequential</w> that no one could follow the underlying argument.",
                            "target_lang_translations": {
                                "nl": "Zijn uitleg was zo langdradig en <w>onsamenhangend</w> dat niemand het achterliggende argument kon volgen."
                            }
                        },
                        {
                            "text": "The committee rejected the proposal because it relied on vague assumptions and <w>inconsequential</w> reasoning.",
                            "target_lang_translations": {
                                "nl": "De commissie wees het voorstel af omdat het steunde op vage aannames en een <w>inconsequente</w> redenering."
                            }
                        }
                    ],
                    "synonyms": [
                        "illogical",
                        "disconnected"
                    ],
                    "antonyms": [
                        "consequent",
                        "logical"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet logisch voortvloeiend uit de premissen; onsamenhangend of zonder logisch verband."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onsamenhangend",
                                "target_lang_sense_clarification": "zonder logisch verband"
                            },
                            {
                                "target_lang_word": "inconsequent",
                                "target_lang_sense_clarification": "niet logisch voortvloeiend"
                            },
                            {
                                "target_lang_word": "onlogisch",
                                "target_lang_sense_clarification": "in strijd met de logica"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b8ab168-a3f3-352a-a74b-20579180e0e3",
                    "sense_definition": "A thing or matter of little or no importance; a triviality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should focus on our primary objectives rather than wasting energy on such an <w>inconsequential</w>.",
                            "target_lang_translations": {
                                "nl": "We moeten ons richten op onze hoofddoelen in plaats van energie te verspillen aan zo'n <w>futiliteit</w>."
                            }
                        },
                        {
                            "text": "The daily conversation was mostly filled with pleasantries and minor <w>inconsequentials</w>.",
                            "target_lang_translations": {
                                "nl": "Het dagelijkse gesprek bestond voornamelijk uit beleefdheden en kleine <w>onbeduidendheden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "triviality",
                        "trifle"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een zaak of kwestie van weinig of geen betekenis; een futiliteit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "futiliteit",
                                "target_lang_sense_clarification": "onbelangrijke kleinigheid"
                            },
                            {
                                "target_lang_word": "kleinigheid",
                                "target_lang_sense_clarification": "iets van geringe betekenis"
                            },
                            {
                                "target_lang_word": "beuzelarij",
                                "target_lang_sense_clarification": "iets onbeduidends"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}