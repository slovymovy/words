                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "47434816-9b55-4ebe-9f4d-428f5fc6b443",
                        "entry_id": "d528cb71-cc60-3c00-b22f-c0d81541eea1",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "Bings"
                    },
                    {
                        "form_id": "b4f89ff0-a6c9-424f-a9be-85cfd31b9cea",
                        "entry_id": "d528cb71-cc60-3c00-b22f-c0d81541eea1",
                        "tags": [
