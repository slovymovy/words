                "senses": [
                    {
                        "sense_id": "b6bb0799-788e-3de5-a95f-a7c87ca44761",
                        "entry_id": "7e28ec52-8ef6-3458-8bcb-d2e19280a126",
                        "glosses": [
                            "Autopsie pratiquée sur un animal mort."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "6653ed4e-1443-4ae0-b617-d5fce48a7f90",
                                "sense_id": "b6bb0799-788e-3de5-a95f-a7c87ca44761",
                                "text": "Une chèvre de montagne a échappé aux griffes d’un grizzli dans les Rocheuses canadiennes en tuant le féroce prédateur grâce à ses cornes pointues, confirme une nécropsie menée par Parcs Canada."
                            },
                            {
                                "example_id": "850c0536-e4f3-477e-bf19-3d8a3241512f",
                                "sense_id": "b6bb0799-788e-3de5-a95f-a7c87ca44761",
                                "text": "Les services de protection des animaux se sont rendus à Marineland jeudi et vendredi pour déterminer si la conformité des normes de soins, dont l'obligation d'une nécropsie, avait été respectée par les professionnels présents au parc, a indiqué un porte-parole des services."
                            },
                            {
                                "example_id": "f8da265b-fdf2-4112-b401-04a3507ec821",
                                "sense_id": "b6bb0799-788e-3de5-a95f-a7c87ca44761",
                                "text": "Les enquêteurs ont laissé entendre qu'une maladie aurait pu jouer un rôle dans cette attaque brutale, bien que l'incident fasse toujours l'objet d'une enquête et qu'une nécropsie sera pratiquée sur l'animal."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5f495b5-247e-39a1-a498-ae0b8514eeba",
                        "entry_id": "7e28ec52-8ef6-3458-8bcb-d2e19280a126",
                        "glosses": [
                            "Autopsie, examen post-mortem."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7638c715-3230-4eb5-b34b-9956dd54d834",
                        "source_entry_id": "7e28ec52-8ef6-3458-8bcb-d2e19280a126",
                        "target_lang_word": "necropsy",
