                "senses": [
                    {
                        "sense_id": "34a1461a-d95f-3091-b81e-d1c930d4a8df",
                        "entry_id": "c54abf62-af11-3a70-bb3f-8e3cc7bbc9eb",
                        "glosses": [
                            "weibliche Person, die ein Pferd stiehlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a9c501-4703-4eb4-91d4-9d85299c215f",
                                "sense_id": "34a1461a-d95f-3091-b81e-d1c930d4a8df",
                                "text": "„Eine Pferdediebin hat ihren Hengst so abgerichtet, dass er Stuten anlockt, die sie dann an das Schlachthaus verkauft.“"
                            },
                            {
                                "example_id": "a1ecfe63-4bf8-4c5e-9c23-588ebc99589c",
                                "sense_id": "34a1461a-d95f-3091-b81e-d1c930d4a8df",
                                "text": "„Am 8. 7. 1746 wurde die 31-jährige Pferdediebin Catharina Dammann, Schustersfrau aus Hänigsen, durch Enthauptung hingerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
