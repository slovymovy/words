                        "glosses": [
                            "beeld dat men heeft over een al of niet gewenste toekomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61dcf263-d046-4d4a-afbf-1a7809e9ca8a",
                                "sense_id": "54f3a1e9-50c3-33c6-9495-bf0309493708",
                                "text": "Van een leven met Sonja had hij zich allang een toekomstbeeld gevormd en daarin was alles eenvoudig en duidelijk, juist omdat alles vooraf was uitgedacht en hij alles van Sonja wist; maar van een toekomst met freule Marja kon hij zich geen voorstelling maken, omdat hij haar niet begreep maar eenvoudig van haar hield."
                            },
                            {
                                "example_id": "bf143e4c-b60e-4b7f-8914-91df1a5f737a",
                                "sense_id": "54f3a1e9-50c3-33c6-9495-bf0309493708",
                                "text": "Dit was het toekomstbeeld dat de Nederlandse Spoorwegen in 2006 schetsten. Wat is daar anno 2020 van terechtgekomen?"
                            }
                        ]
                    }
