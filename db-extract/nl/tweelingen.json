                "senses": [
                    {
                        "sense_id": "5ed7b533-100e-3cf3-b3ff-0a8a74f62c06",
                        "entry_id": "7738db73-6bf3-300f-afae-727bf40fe00a",
                        "glosses": [
                            "sterrenbeeld van de dierenriem (tussen rechte klimming 5ᵘ57ᵐ en 8ᵘ06ᵐ en tussen declinatie +10° en +35°)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126ae3b9-9161-4f66-a237-6017795d0e1b",
                                "sense_id": "5ed7b533-100e-3cf3-b3ff-0a8a74f62c06",
                                "text": "Pollux smeekte zijn vader, de oppergod Zeus, om hem met Castor te laten sterven. Zeus beloonde deze broederliefde. Beiden mochten de ene helft van het jaar bij de goden wonen. De andere helft moesten ze samen in de onderwereld doorbrengen. Samen leven ze aan de hemel voort in het sterrenbeeld Tweelingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a016ca3-15ff-362e-8b2c-678290f16ae6",
                        "entry_id": "7738db73-6bf3-300f-afae-727bf40fe00a",
                        "glosses": [
                            "teken van de dierenriem waar de zon in staat van ca. 21 mei tot 21 juni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee894b91-c516-4ac7-8c7f-e9d0cf348fd8",
                                "sense_id": "1a016ca3-15ff-362e-8b2c-678290f16ae6",
                                "text": "Soms staat de raad die de ene dag aan Tweelingen werd toebedacht, een paar dagen later bij Ram."
                            }
                        ]
                    }
                ],
