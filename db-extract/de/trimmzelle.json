                "senses": [
                    {
                        "sense_id": "21aeae73-5790-3826-9fbe-9ea5ac1df767",
                        "entry_id": "606f6220-3c8e-3a6f-851c-a496a481ebcc",
                        "glosses": [
                            "Behälter/Tank, der mit Wasser oder Luft gefüllt werden kann, um die Lage eines U-Boots auszubalancieren"
                        ],
                        "tags": [
                            "U-Boot-Bau"
                        ],
                        "examples": [
                            {
                                "example_id": "9b932423-1dc5-41cf-b5e9-956ac6112d4f",
                                "sense_id": "21aeae73-5790-3826-9fbe-9ea5ac1df767",
                                "text": "„Die Trimmzellen halten das Boot dabei auf ebenem Kiel.“"
                            },
                            {
                                "example_id": "e769067a-cebc-4b2b-9e96-925e679f7d02",
                                "sense_id": "21aeae73-5790-3826-9fbe-9ea5ac1df767",
                                "text": "„Die Trimmzellen dienen zur Korrektur der Lage des getauchten Bootes.“"
                            },
                            {
                                "example_id": "831be10e-441d-4cae-9ff9-06a758f5d2d8",
                                "sense_id": "21aeae73-5790-3826-9fbe-9ea5ac1df767",
                                "text": "„Da das Boot, wie alle anderen Boote dieses Maßstabs, über zwei separate Trimmzellen verfügen (je eine im Heck- bzw. Bugbereich), ist es somit auch problemlos möglich, die Trimmung des Bootes zu verändern.“"
                            }
                        ],
