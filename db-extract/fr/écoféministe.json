                    },
                    {
                        "form_id": "046ba633-27ca-40fc-b0e5-f1f5a0f8139f",
                        "entry_id": "f7733b4c-02c7-318a-b11c-46a10ab3ff71",
                        "tags": [],
                        "form": "éco-féministe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c156180d-a99f-3a1a-a107-64983f93980f",
                        "entry_id": "f7733b4c-02c7-318a-b11c-46a10ab3ff71",
                        "glosses": [
                            "Partisan de l’écoféminisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2a9b65-de67-4216-aacf-b786dfb77896",
                                "sense_id": "c156180d-a99f-3a1a-a107-64983f93980f",
                                "text": "Les écoféministes sont aussi porteuses de fortes revendications contre la guerre et la militarisation, la paix étant une des préconditions à tout développement local."
                            },
                            {
                                "example_id": "6410f78b-3cb5-41e8-a58b-3af8ee1566ed",
                                "sense_id": "c156180d-a99f-3a1a-a107-64983f93980f",
                                "text": "Dorothy Hénaut se définit comme une \"écoféministe\" qui essaie de centrer ses projets cinématographiques autour de thèmes précis."
                            },
                            {
                                "example_id": "daad414f-13e6-4206-a6dd-3ee90e84f22a",
                                "sense_id": "c156180d-a99f-3a1a-a107-64983f93980f",
                                "text": "Si toutes les écoféministes ne sont pas d’accord quant à la forme que doit prendre la lutte, toutes s’entendent pour désigner le patriarcat comme l’origine commune de l’exploitation des femmes et de la nature."
                            }
                        ]
                    }
                ],
