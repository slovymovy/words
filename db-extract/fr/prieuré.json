            },
            {
                "entry_id": "6a6ae835-164a-3a72-b497-a6d7bd2071c4",
                "word": "prieuré",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f30d9d53-63fd-43e1-8b6c-259710e74164",
                        "entry_id": "6a6ae835-164a-3a72-b497-a6d7bd2071c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "prieurés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06f2f334-af8b-3713-b5e0-d2ed48e549ad",
                        "entry_id": "6a6ae835-164a-3a72-b497-a6d7bd2071c4",
                        "glosses": [
                            "Couvent dirigé par un prieur ou par une prieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb905af-fba0-48b4-8b83-3527a30c2d81",
                                "sense_id": "06f2f334-af8b-3713-b5e0-d2ed48e549ad",
                                "text": "Wary de Dommartin la rebâtit ; d’abord bénédictin au monastère de Saint-Epvre à Toul, puis prieur de Varangéville il céda ensuite son prieuré, moyennant redevance, à Jean de Nicolinis ; […]."
                            },
                            {
                                "example_id": "441b636a-da7a-4fa0-89e3-e7869245b26e",
                                "sense_id": "06f2f334-af8b-3713-b5e0-d2ed48e549ad",
                                "text": "[…] ; on remarque également que ces prieurés sont fondés comme à Bierbeek, Ham-les-Moines et Rumigny dans des zones de défrichement ; leur but est donc de donner à la population qui participe à la mise en valeur les cadres religieux inexistant auparavant."
                            },
                            {
                                "example_id": "448ba70b-d85d-4456-b6f7-1c20c91dde00",
                                "sense_id": "06f2f334-af8b-3713-b5e0-d2ed48e549ad",
                                "text": "Le prieuré est établi dans un hameau de la campagne sénonaise : Saint-Georges, dépendant de Villebougis, à 10 km à peine du siège archiépiscopal de Sens."
                            },
                            {
                                "example_id": "773445d5-4893-4036-a59d-5b2c1e5fd9d7",
                                "sense_id": "06f2f334-af8b-3713-b5e0-d2ed48e549ad",
                                "text": "En 1784 , le patrimoine du prieuré de Sail-sous-Couzan se composait des éléments suivants : Fort belle maison appelée le prieuré , grange , écurie , cuvage , cuves , pressoir , 3 cartonnées de jardin en deux pièces , 2 journalées de vigne , 60 cartonnées de bois taillis, 2 prés de la contenue de 27 cartonnées."
                            }
                        ]
                    },
                    {
                        "sense_id": "61fd0845-1f43-335e-925c-c32113a41007",
                        "entry_id": "6a6ae835-164a-3a72-b497-a6d7bd2071c4",
                        "glosses": [
                            "Église et bâtiments d’un couvent dirigé par un prieur ou une prieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70987e9-2354-4470-955f-0473d3fd23f3",
                                "sense_id": "61fd0845-1f43-335e-925c-c32113a41007",
                                "text": "Avant les découvertes des plates-tombes de l’abbaye Notre-Dame-du-Vœu, des fouilles de céramiques tombales importantes ont eu lieu au prieuré Saint-Martin de Deux-Jumeaux […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e9f9e75-4476-3f2f-a486-fcb59a7babe2",
                        "entry_id": "6a6ae835-164a-3a72-b497-a6d7bd2071c4",
                        "glosses": [
                            "Maison du prieur ou de la prieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfa7b06-830c-4de2-8cae-b5c87edc911c",
                                "sense_id": "6e9f9e75-4476-3f2f-a486-fcb59a7babe2",
                                "text": "Il était logé au prieuré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2df94005-abb4-4c71-b691-a13ebac6eb26",
                        "source_entry_id": "6a6ae835-164a-3a72-b497-a6d7bd2071c4",
