                    {
                        "sense_id": "62fb764a-0eb6-3e4c-a103-ee3dea6e4332",
                        "entry_id": "18c5cef3-3401-36ef-b1f8-7ef624ef8ebb",
                        "glosses": [
                            "Nom abrégé de la Coalition civique, une coalition politique polonaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ced4abf-c88a-4bee-9a21-f3269b56374a",
                                "sense_id": "62fb764a-0eb6-3e4c-a103-ee3dea6e4332",
                                "text": "Les trois partis d’opposition centriste, que sont la Coalition citoyenne (KO) de Donald Tusk, les chrétiens-démocrates de la Troisième voie et La Gauche, ont remporté ensemble 248 sièges dans le Parlement de 460 députés, contre 212 sièges pour le PiS et la Confédération (extrême droite)."
                            },
                            {
                                "example_id": "2f003fd1-cf9f-42be-be4d-7d07da8dcef8",
                                "sense_id": "62fb764a-0eb6-3e4c-a103-ee3dea6e4332",
                                "text": "Photo du chef de file de la Coalition civique (KO) Donald Tusk."
                            },
                            {
                                "example_id": "3637d815-1cff-4890-b464-16c6157498fe",
                                "sense_id": "62fb764a-0eb6-3e4c-a103-ee3dea6e4332",
                                "text": "Le président de KO, Donald Tusk, a promis de rétablir de bonnes relations avec l’Union européenne."
                            }
                        ]
                    }
                ],
