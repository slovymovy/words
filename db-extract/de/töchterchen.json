                ],
                "senses": [
                    {
                        "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                        "entry_id": "f47e5695-202a-3668-85b3-bfd07d3d4610",
                        "glosses": [
                            "kleine Tochter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dac790d3-64fd-4270-893a-73492f8f77f4",
                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                "text": "Meine Schwester bekam vor ein paar Wochen ein süßes Töchterchen."
                            },
                            {
                                "example_id": "731a5c95-7a9e-42f6-8ef9-be98f7058c42",
                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                "text": "„Ich lese, dass ein Jahr nach der Geburt von Klein-Gretchen, seinem ersten Kind, am 21. Mai ein weiteres Töchterchen geboren wurde.“"
                            },
                            {
                                "example_id": "b876be31-e135-463e-8fd0-cd15a1ce6f62",
                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                "text": "„Ich will meinem Töchterchen eine ganz, ganz winzige Atombombe schenken.“"
                            },
                            {
                                "example_id": "026f04fc-577e-495c-abfa-7c16f5a509c2",
                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                "text": "„Da Zwillinge sowieso nicht immer in große Verhältnisse hineingeboren werden, erkundigte sich ein kleiner Beamter tiefbekümmert beim Frauenarzt, weshalb in seiner jungen Ehe zuerst ein einziges Töchterchen ankam, danach ein Zwillingspärchen, und jetzt, im dritten Jahr, schon reguläre Drillinge.“"
                            },
                            {
                                "example_id": "e638f8b3-d582-435a-9bad-f5653f94d831",
                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                "text": "„Am 10. September holt Fallada seine Frau Suse und das sieben Wochen alte Töchterchen Lore von der Berliner Klinik ins Hotel »Deutsches Haus« in Feldberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
