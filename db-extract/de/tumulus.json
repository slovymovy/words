                "senses": [
                    {
                        "sense_id": "fe9c5e16-13b8-3da5-b9c7-521ee1abfe18",
                        "entry_id": "559035f6-5092-309f-a3f8-c60c899f4645",
                        "glosses": [
                            "hügelförmige Grabstelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b6c4d5-a3f6-4a50-87b9-6759d6c77693",
                                "sense_id": "fe9c5e16-13b8-3da5-b9c7-521ee1abfe18",
                                "text": "„Unweit seiner Schnucke, in einem inmitten des Sees aufgeschütteten Tumulus wurde er beigesetzt, später auch Lucies Leichnam dorthin umgebettet.“"
                            },
                            {
                                "example_id": "2aa0b79a-865f-41ce-a48e-f7cfe1d70fb1",
                                "sense_id": "fe9c5e16-13b8-3da5-b9c7-521ee1abfe18",
                                "text": "„Der Tumulus von Nickenich bei Mayen hatte einen Durchmesser von 7 m und war 2,5 m hoch.“"
                            },
                            {
                                "example_id": "00c6da6a-e987-4b62-bc09-f3ec0a097906",
                                "sense_id": "fe9c5e16-13b8-3da5-b9c7-521ee1abfe18",
                                "text": "„Vielleicht ist der Berg Faunus verschwunden, und vielleicht war es gar kein Hügel, sondern ein Tumulus? Was bedeuten die Tumuli?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a706906-d7b3-4795-9d2b-b5466ed6640a",
                        "source_entry_id": "559035f6-5092-309f-a3f8-c60c899f4645",
                        "source_sense_id": "fe9c5e16-13b8-3da5-b9c7-521ee1abfe18",
                        "source_sense_description": "hügelförmige Grabstelle",
                        "target_lang_word": "tumulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumulus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                        "entry_id": "a5015688-2b6f-3cab-87c9-5ddb78e24830",
                                        "glosses": [
                                            "A mound of earth, especially one placed over a prehistoric tomb; a barrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6714367-1008-4295-b7f9-3f26c5e71c95",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "They planted the cannon on the tumuli, sole elevations in this level country, and formed themselves into column and hollow square."
                                            },
                                            {
                                                "example_id": "de10fb13-0132-45cc-95fe-0cebb9279147",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "Near Smeinogorsk an octagonal tumulus has been found containing the corpse of a horse near a rectangular one with a human corpse, both within stone circles."
                                            },
                                            {
                                                "example_id": "6f94b876-29c9-427b-845d-0875d9a022cd",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "The delicate white body will be covered to-day,\nThe tumulus be reared, the green sod give way:\nAnd there, oh Cynvarch, thy son they will lay."
                                            },
                                            {
                                                "example_id": "4422d69b-30c3-45d3-beaf-8b8a75fd742a",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "The tumulus is one of mankind's oldest burial monuments, dating back to 4,000 to 5,000 years B.C. […] Examples of tumuli can be seen peppering the landscape all over Western Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
