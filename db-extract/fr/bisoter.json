                        "examples": [
                            {
                                "example_id": "d74a6c1a-2382-4f1e-ac2e-42d903fcd52a",
                                "sense_id": "54b86166-6def-3f6f-8103-dd3fe56e35c2",
                                "text": "J’adorerais être ton amie depuis assez longtemps pour te bisoter !"
                            },
                            {
                                "example_id": "a1c904ca-d75c-4f02-9731-813004f2e529",
                                "sense_id": "54b86166-6def-3f6f-8103-dd3fe56e35c2",
                                "text": "Après quoi, je me fis couler un bain tiède, je me fis savonner par mes belles, branloter par leurs mains et bisoter par leurs bouches, je m’infiltrai dans un costard blanc colonial et, mes filles au bras, roucoulantes, folles, je déambulai à travers Papeete !"
                            },
                            {
                                "example_id": "a7b0d359-3c8c-4776-9162-49d6c27c666d",
                                "sense_id": "54b86166-6def-3f6f-8103-dd3fe56e35c2",
                                "text": "Dès que le pasteur Vincent eut terminé son office, et prodigué tous les vœux de longévité au saint nœud qui nous unissait désormais, nous dûmes bisoter l’assistance toute entière, ce qui nous prit une petite heure."
                            }
                        ]
                    }
