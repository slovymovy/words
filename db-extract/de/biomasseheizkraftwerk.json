                        "sense_id": "0b20de0d-8604-39c4-9cb5-5e09577dd1fd",
                        "entry_id": "e5bc1e99-737b-35f3-87d3-5e4476236429",
                        "glosses": [
                            "Kraftwerk, in dem durch die Verbrennung von fester Biomasse elektrischer Strom und Wärme zum Heizen erzeugt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cbd0efb-5187-4269-8f58-323744159a1d",
                                "sense_id": "0b20de0d-8604-39c4-9cb5-5e09577dd1fd",
                                "text": "„Die Energieversorgung kommt vom gemeindeeigenen Biomasseheizkraftwerk sowie von der Photovoltaikanlage auf dem Dach des benachbarten Kindergartens.“"
                            },
                            {
                                "example_id": "724b1b57-85d1-43b8-beeb-ce22c55a5201",
                                "sense_id": "0b20de0d-8604-39c4-9cb5-5e09577dd1fd",
                                "text": "„Mit einem neuen Biomasseheizkraftwerk will der Pharmakonzern Boehringer Ingelheim an seinem Stammsitz künftig den CO2-Ausstoß in der betriebseigenen Energieerzeugung um 80 Prozent senken.“"
                            }
                        ],
