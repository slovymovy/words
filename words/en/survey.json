{
    "word_family": [
        "surveyor",
        "surveying",
        "resurvey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c265468a-796e-3643-afbb-7a9984dde3f5",
                    "sense_definition": "An examination of the opinions or experiences of a group of people, often conducted by asking questions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opinion_research",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local council conducted a <w>survey</w> of its residents to help it decide on the new waste service.",
                            "target_lang_translations": {
                                "ru": "Местный совет провел <w>опрос</w> жителей, чтобы принять решение о новой службе по утилизации отходов."
                            }
                        },
                        {
                            "text": "According to a recent <w>survey</w>, most people prefer working from home at least two days a week.",
                            "target_lang_translations": {
                                "ru": "Согласно недавнему <w>опросу</w>, большинство людей предпочитают работать из дома как минимум два дня в неделю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "conduct a survey",
                        "recent survey",
                        "online survey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изучение мнений или опыта группы людей, часто проводимое путем постановки вопросов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрос",
                                "target_lang_sense_clarification": "сбор мнений или информации"
                            },
                            {
                                "target_lang_word": "исследование",
                                "target_lang_sense_clarification": "систематическое изучение вопроса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a860f972-1fae-3bc0-8d2e-4de6c2b1040d",
                    "sense_definition": "A questionnaire or document used to collect data or opinions from a group of people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opinion_research",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take a moment to fill out this short <w>survey</w> about your shopping experience.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, уделите минуту, чтобы заполнить этот короткий <w>опросник</w> о вашем опыте покупок."
                            }
                        },
                        {
                            "text": "I just completed a <w>survey</w> on roadside waste pick-up that I received in my email.",
                            "target_lang_translations": {
                                "ru": "Я только что заполнил <w>анкету</w> о сборе мусора на обочинах дорог, которую получил по электронной почте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fill out a survey",
                        "complete a survey",
                        "customer satisfaction survey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Анкета или документ, используемый для сбора данных или мнений от группы людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анкета",
                                "target_lang_sense_clarification": "документ с вопросами"
                            },
                            {
                                "target_lang_word": "опросник",
                                "target_lang_sense_clarification": "перечень вопросов для заполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ce41324-0506-3db2-a369-bac409f53dba",
                    "sense_definition": "A detailed inspection or examination of something to determine its condition or value.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before buying the house, we had a professional <w>survey</w> done to check for structural issues.",
                            "target_lang_translations": {
                                "ru": "Перед покупкой дома мы заказали профессиональное <w>обследование</w>, чтобы проверить наличие структурных проблем."
                            }
                        },
                        {
                            "text": "The engineer carried out a thorough <w>survey</w> of the bridge to ensure it was safe for heavy traffic.",
                            "target_lang_translations": {
                                "ru": "Инженер провел тщательный <w>осмотр</w> моста, чтобы убедиться в его безопасности для движения тяжелого транспорта."
                            }
                        }
                    ],
                    "synonyms": [
                        "review",
                        "inspection",
                        "examination"
                    ],
                    "common_phrases": [
                        "building survey",
                        "structural survey",
                        "carry out a survey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детальный осмотр или проверка чего-либо для определения его состояния или стоимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обследование",
                                "target_lang_sense_clarification": "тщательная проверка состояния"
                            },
                            {
                                "target_lang_word": "осмотр",
                                "target_lang_sense_clarification": "визуальная проверка"
                            },
                            {
                                "target_lang_word": "инспектирование",
                                "target_lang_sense_clarification": "официальная проверка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c16ace76-0d39-3522-9514-5ff7c2c51aff",
                    "sense_definition": "The process of measuring and mapping an area of land, including its boundaries and elevations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "land_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government ordered a geological <w>survey</w> of the mountain range to look for mineral deposits.",
                            "target_lang_translations": {
                                "ru": "Правительство распорядилось провести геологические <w>изыскания</w> горного хребта для поиска месторождений полезных ископаемых."
                            }
                        },
                        {
                            "text": "A land <w>survey</w> was necessary to determine the exact boundaries between the two properties.",
                            "target_lang_translations": {
                                "ru": "Для определения точных границ между двумя владениями потребовалось <w>межевание</w> земель."
                            }
                        }
                    ],
                    "common_phrases": [
                        "land survey",
                        "geological survey",
                        "aerial survey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс измерения и картирования участка земли, включая его границы и высоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съёмка",
                                "target_lang_sense_clarification": "топографическая или геодезическая"
                            },
                            {
                                "target_lang_word": "межевание",
                                "target_lang_sense_clarification": "установление границ участков"
                            },
                            {
                                "target_lang_word": "изыскания",
                                "target_lang_sense_clarification": "инженерные или геологические работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8323c14-bcd2-3bbe-b75b-3ae9c450a5b5",
                    "sense_definition": "A general view or comprehensive look at a subject or landscape.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overview",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book provides a broad <w>survey</w> of European history from the Middle Ages to the present.",
                            "target_lang_translations": {
                                "ru": "Книга представляет собой широкий <w>обзор</w> европейской истории от Средневековья до наших дней."
                            }
                        },
                        {
                            "text": "From the top of the tower, he enjoyed a proud <w>survey</w> of the city lying below him.",
                            "target_lang_translations": {
                                "ru": "С вершины башни он наслаждался величественным <w>обозрением</w> города, лежащего под ним."
                            }
                        }
                    ],
                    "synonyms": [
                        "prospect"
                    ],
                    "common_phrases": [
                        "broad survey",
                        "historical survey",
                        "brief survey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий взгляд или всесторонний обзор предмета или ландшафта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обзор",
                                "target_lang_sense_clarification": "краткое изложение или вид"
                            },
                            {
                                "target_lang_word": "обозрение",
                                "target_lang_sense_clarification": "всесторонний взгляд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f37b33a-8301-31f6-8fa3-9fb6675e552a",
                    "sense_definition": "To ask a group of people questions to find out about their opinions or behavior.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opinion_research_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers <w>surveyed</w> over a thousand students to understand their study habits.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>опросили</w> более тысячи студентов, чтобы понять их привычки в учебе."
                            }
                        },
                        {
                            "text": "We plan to <w>survey</w> the local community before making any changes to the park.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>провести опрос</w> местного сообщества, прежде чем вносить какие-либо изменения в парк."
                            }
                        }
                    ],
                    "common_phrases": [
                        "survey the public",
                        "survey residents"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задавать вопросы группе людей, чтобы узнать их мнение или поведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрашивать",
                                "target_lang_sense_clarification": "проводить опрос"
                            },
                            {
                                "target_lang_word": "анкетировать",
                                "target_lang_sense_clarification": "предлагать заполнить анкету"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3136ffe-0232-3b07-9418-0c75f84c2064",
                    "sense_definition": "To look at or examine something carefully, especially from a distance or a high position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood on the balcony and <w>surveyed</w> the beautiful garden below.",
                            "target_lang_translations": {
                                "ru": "Он стоял на балконе и <w>обозревал</w> прекрасный сад внизу."
                            }
                        },
                        {
                            "text": "The general climbed the hill to <w>survey</w> the surrounding country and plan his next move.",
                            "target_lang_translations": {
                                "ru": "Генерал поднялся на холм, чтобы <w>осмотреть</w> окрестности и спланировать свой следующий шаг."
                            }
                        }
                    ],
                    "synonyms": [
                        "look over",
                        "observe",
                        "view"
                    ],
                    "common_phrases": [
                        "survey the scene",
                        "survey the landscape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внимательно смотреть на что-либо или изучать, особенно с расстояния или с высоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обозревать",
                                "target_lang_sense_clarification": "окидывать взором"
                            },
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "изучать взглядом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "789ad5aa-5db3-3f10-9875-3e4feea8c5ec",
                    "sense_definition": "To examine the condition or value of a building or piece of land.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "professional_inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was his job to <w>survey</w> buildings in order to determine their market value.",
                            "target_lang_translations": {
                                "ru": "В его обязанности входило <w>обследовать</w> здания для определения их рыночной стоимости."
                            }
                        },
                        {
                            "text": "The insurance company sent an expert to <w>survey</w> the damage after the storm.",
                            "target_lang_translations": {
                                "ru": "Страховая компания прислала эксперта, чтобы <w>оценить</w> ущерб после шторма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "survey a building",
                        "survey the damage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проверять состояние или стоимость здания или участка земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обследовать",
                                "target_lang_sense_clarification": "проводить технический осмотр"
                            },
                            {
                                "target_lang_word": "инспектировать",
                                "target_lang_sense_clarification": "проверять в официальном порядке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eef4f211-240d-3d8c-90ec-507a41d957bf",
                    "sense_definition": "To measure an area of land in order to make a map or plan of it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mapping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers have started <w>surveying</w> likely sites for the new highway construction.",
                            "target_lang_translations": {
                                "ru": "Инженеры начали <w>изучать</w> вероятные участки для строительства нового шоссе."
                            }
                        },
                        {
                            "text": "The team spent weeks <w>surveying</w> the coast to create a more accurate nautical chart.",
                            "target_lang_translations": {
                                "ru": "Команда провела недели, <w>производя съёмку</w> побережья для создания более точной навигационной карты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "survey land",
                        "survey the site"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерять участок земли для создания его карты или плана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производить съёмку",
                                "target_lang_sense_clarification": "делать замеры местности"
                            },
                            {
                                "target_lang_word": "межевать",
                                "target_lang_sense_clarification": "определять границы земли"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}