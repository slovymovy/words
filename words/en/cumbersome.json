{
    "word_family": [
        "cumber",
        "cumbersomely",
        "cumbersomeness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c3a6571e-ed88-36aa-83a3-7c93fbe1f741",
                    "sense_definition": "Difficult to carry, use, or manage because of size, weight, or shape; awkward or clumsy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_awkwardness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers struggled to carry the <w>cumbersome</w> equipment up the steep mountain trail.",
                            "target_lang_translations": {
                                "ru": "Туристы с трудом тащили <w>громоздкое</w> снаряжение по крутой горной тропе."
                            }
                        },
                        {
                            "text": "Using a <w>cumbersome</w> package to ship small items is both expensive and inefficient.",
                            "target_lang_translations": {
                                "ru": "Использование <w>громоздкой</w> упаковки для отправки мелких вещей — это и дорого, и неэффективно."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwieldy"
                    ],
                    "antonyms": [
                        "manageable",
                        "handy"
                    ],
                    "common_phrases": [
                        "cumbersome equipment",
                        "cumbersome package"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый, громоздкий или неудобный для переноски, использования или управления из-за своего размера, веса или формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громоздкий",
                                "target_lang_sense_clarification": "о вещах, предметах, оборудовании"
                            },
                            {
                                "target_lang_word": "неудобный",
                                "target_lang_sense_clarification": "для переноски или использования"
                            },
                            {
                                "target_lang_word": "объёмистый",
                                "target_lang_sense_clarification": "большой по размеру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28c8933d-d83d-3a8f-b616-d0c7fe721296",
                    "sense_definition": "Slow, complicated, or inefficient, especially of a process, system, or set of rules.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_inefficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to simplify its <w>cumbersome</w> procedure for requesting annual leave.",
                            "target_lang_translations": {
                                "ru": "Компания решила упростить свою <w>обременительную</w> процедуру запроса ежегодного отпуска."
                            }
                        },
                        {
                            "text": "Applying for a visa can be a <w>cumbersome</w> process that takes several months to complete.",
                            "target_lang_translations": {
                                "ru": "Подача документов на визу может быть <w>затяжным</w> процессом, который занимает несколько месяцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "cumbrous"
                    ],
                    "antonyms": [
                        "efficient",
                        "streamlined"
                    ],
                    "common_phrases": [
                        "cumbersome process",
                        "cumbersome procedure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленный, сложный или неэффективный (особенно о процессе, системе или правилах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обременительный",
                                "target_lang_sense_clarification": "о процессе, правилах или процедурах"
                            },
                            {
                                "target_lang_word": "громоздкий",
                                "target_lang_sense_clarification": "о сложной, неэффективной системе или процедуре"
                            },
                            {
                                "target_lang_word": "затруднительный",
                                "target_lang_sense_clarification": "вызывающий сложности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}