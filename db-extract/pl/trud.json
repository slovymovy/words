                "senses": [
                    {
                        "sense_id": "2c743a20-aaeb-3a36-8a9a-520b26acb966",
                        "entry_id": "327eb4f4-9308-3d04-89f0-99b372543c4f",
                        "glosses": [
                            "ciężka praca, duży wysiłek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "610247df-00f4-477a-9cdb-25b9501b1299",
                                "sense_id": "2c743a20-aaeb-3a36-8a9a-520b26acb966",
                                "text": "Postanowił nie żałować trudu i doprowadzić sprawę do końca."
                            },
                            {
                                "example_id": "7bafbcff-4715-49fc-bc9d-1fd1ad36045b",
                                "sense_id": "2c743a20-aaeb-3a36-8a9a-520b26acb966",
                                "text": "Nie złamie wolnych żadna klęska, / Nie strwoży śmiałych żaden trud — / Pójdziemy razem do zwycięstwa, / Gdy ramię w ramię stanie lud"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "316b4c6b-1a61-4713-b758-1d33acd29267",
                        "source_entry_id": "327eb4f4-9308-3d04-89f0-99b372543c4f",
                        "source_sense_id": "2c743a20-aaeb-3a36-8a9a-520b26acb966",
                        "target_lang_word": "toil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd11e06c-7010-3941-b35c-6897bb5847c0",
                                        "entry_id": "4168530d-27e1-3b1f-8e37-627404f0980e",
                                        "glosses": [
                                            "Labour, work, especially of a grueling nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b1b8c1-6a0b-422c-80c1-65ab3f93e173",
                                                "sense_id": "bd11e06c-7010-3941-b35c-6897bb5847c0",
                                                "text": "[…] he set to work again and made the snow fly in all directions around him. After some further toil his efforts were rewarded, and a very shabby door-mat lay exposed to view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470a89ec-3146-3cf5-90f7-dedc78f15674",
                                        "entry_id": "4168530d-27e1-3b1f-8e37-627404f0980e",
                                        "glosses": [
                                            "Trouble, strife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                        "entry_id": "4168530d-27e1-3b1f-8e37-627404f0980e",
                                        "glosses": [
                                            "A net or snare; any thread, web, or string spread for taking prey."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "549fbc00-ec9f-4de4-b8aa-e8d763f9d39f",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "Then toils for beasts, and lime for birds, were found."
                                            },
                                            {
                                                "example_id": "d75a8840-160f-4a4b-8bc8-00b4fe7c98b0",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "I was like a wild beast that had broken the toils, destroying the objects that obstructed me and ranging through the wood with a stag-like swiftness."
                                            },
                                            {
                                                "example_id": "b3c10d57-b630-41f0-9ed1-adbf37b5ea72",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "That I was going to sit still, and let you sulk, while mademoiselle walked blindfold into the toils?"
                                            },
                                            {
                                                "example_id": "ce45d6d8-e2e4-4821-9537-a9c4d5623e3d",
                                                "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                                                "text": "She had waited overlong, and now it was like that Ailie would escape her toils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0a7a53-56a3-39fe-9835-541d0ea9f4cf",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
                                            "To labour; work."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "638b5d34-706d-3dc0-860c-98398bf9e418",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
                                            "To struggle."
                                        ],
                                        "tags": [
