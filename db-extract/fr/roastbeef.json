                        "examples": [
                            {
                                "example_id": "b2c385e7-49c4-4c09-9bb5-9dac4a9a7713",
                                "sense_id": "c7e4133b-72d7-3225-9f72-d0a1fad23d4f",
                                "text": "Un Norvégien, un paysan du Lancaster n’a pas l’idée d’une pareille sensation ; au lieu de la grappe savoureuse et sucrée, il a, au mieux, la bière, l’eau-de-vie, le roastbeef, toutes sensations fortes, simples moyens de se remplir et de se réchauffer. Il ne peut pas concevoir le plaisir."
                            },
                            {
                                "example_id": "af21a050-57e2-4465-92b8-4e36dd8f25ec",
                                "sense_id": "c7e4133b-72d7-3225-9f72-d0a1fad23d4f",
                                "text": "Il baptise « roastbeef de veau » cette hideuse viande blanche à lisérés rouges."
                            },
                            {
                                "example_id": "c47a1365-0e71-4b65-b232-ea75eef72b54",
                                "sense_id": "c7e4133b-72d7-3225-9f72-d0a1fad23d4f",
                                "text": "Georges préparait une assiette anglaise, avec au milieu une belle tranche de roastbeef rose et des cornichons."
                            }
                        ]
                    }
