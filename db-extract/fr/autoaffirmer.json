                        "form": "s’autoaffirmer"
                    },
                    {
                        "form_id": "c79677b6-57a5-41c2-8e62-95526dbadb71",
                        "entry_id": "fb6fd9c8-e0f9-30ac-b1ab-95dc03bb4dc9",
                        "tags": [],
                        "form": "auto-affirmer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a39fbe2-cd7b-33bc-9264-cecbe682fe03",
                        "entry_id": "fb6fd9c8-e0f9-30ac-b1ab-95dc03bb4dc9",
                        "glosses": [
                            "Affirmer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31e8fdb-6797-4351-a7c7-0510805e02dc",
                                "sense_id": "8a39fbe2-cd7b-33bc-9264-cecbe682fe03",
                                "text": "Comme disent les linguistes, il faut distinguer l’indicatif qui constate et le performatif qui s’autoaffirme."
                            },
                            {
                                "example_id": "8ea4d73a-44e9-491d-9b2c-77e4f47ea32c",
                                "sense_id": "8a39fbe2-cd7b-33bc-9264-cecbe682fe03",
                                "text": "Ils souffrent d'une profonde insécurité existentielle parce que désormais ils ne peuvent plus s'autoaffirmer en niant et en anéantissant l'Autre."
                            },
                            {
                                "example_id": "7b9b0151-9721-4fa2-9798-266d3217b792",
                                "sense_id": "8a39fbe2-cd7b-33bc-9264-cecbe682fe03",
                                "text": "C'est à lui d'incarner cette peur dont l'Etat sécuritaire a besoin pour s'autoaffirmer."
                            }
                        ]
                    }
                ],
