                ],
                "senses": [
                    {
                        "sense_id": "1636e1fc-e5a4-30c0-bf1b-e70c762a2855",
                        "entry_id": "90441753-8ae8-37d1-9003-900d5b431ae6",
                        "glosses": [
                            "in Südostasien heimischer Baum, der besonders wertvolles und dauerhaftes Holz liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "685c8d21-a5f7-4792-84ee-9242394a90b9",
                                "sense_id": "1636e1fc-e5a4-30c0-bf1b-e70c762a2855",
                                "text": "„Dazu zählt der Teakbaum (Tectona grandis), dessen hoher gerader Stamm, große, feste Blätter und hartes, aber gut zu verarbeitendes Holz ihn zum profitabelsten Nutzbaum Myanmars machen.“"
                            },
                            {
                                "example_id": "091bbdac-09ed-407b-9666-941bc42b60ff",
                                "sense_id": "1636e1fc-e5a4-30c0-bf1b-e70c762a2855",
                                "text": "„Im überwiegend bewaldeten Park wachsen Teakbäume und asiatische Mammutbäume, darunter der wahrscheinlich zweitgrößte Teakbaum Thailands.“"
                            },
                            {
                                "example_id": "e5b53866-ce22-479c-be95-e325f2241df5",
                                "sense_id": "1636e1fc-e5a4-30c0-bf1b-e70c762a2855",
                                "text": "„In der immerfeuchten Zone im Südwesten ist Tropischer Regenwald vorherrschend, mit dichtem Unterholz und hohen Hartholzbäumen, darunter Ebenholz und Teakbaum.“"
                            },
                            {
                                "example_id": "9785afb5-1799-4c70-a105-8ed33d4f25bd",
                                "sense_id": "1636e1fc-e5a4-30c0-bf1b-e70c762a2855",
                                "text": "„So fehlen im dornigen Gebüsch der trocknen Hügel die folgenden Arten , die mit dem Teakbaume vorkommen: […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
