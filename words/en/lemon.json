                            {
                                "target_lang_word": "лимон",
                                "target_lang_sense_clarification": "в контексте добавления сока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb8f7877-4825-3daf-b6a8-0e05a712544b",
                    "sense_definition": "A vehicle or other consumer product that is found to be defective after it has been bought.",
