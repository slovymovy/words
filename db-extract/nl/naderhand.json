                ],
                "translations": [
                    {
                        "translation_id": "395292bd-642f-47cb-9501-3b27f6369e06",
                        "source_entry_id": "9ed3cbf6-8adf-38eb-9530-567ee5b50995",
                        "source_sense_id": "0453db45-64e3-3d67-bb27-446ba7d5d6f4",
                        "source_sense_description": "in de tijd erna",
                        "target_lang_word": "afterwards",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afterwards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c15f2325-5775-3f0b-8967-ad80a354da7f",
                                        "entry_id": "ecb016ed-27f0-37e1-8298-52f53feb9f22",
                                        "glosses": [
                                            "At a later or succeeding time; after that;"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "009ac6a8-4797-4585-a397-b144090d83e8",
                                                "sense_id": "c15f2325-5775-3f0b-8967-ad80a354da7f",
                                                "text": "Another Karadeniz cross led to Cudicini's first save of the night, with the Spurs keeper making up for a weak punch by brilliantly pushing away Christian Noboa's snap-shot.\nTwo more top-class stops followed quickly afterwards, first from Natcho's rasping shot which was heading into the top corner, and then to deny Ryazantsev at his near post."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b79accef-29f2-4aa9-bfc2-e3dbf9938dc8",
                        "source_entry_id": "9ed3cbf6-8adf-38eb-9530-567ee5b50995",
                        "source_sense_id": "0453db45-64e3-3d67-bb27-446ba7d5d6f4",
                        "source_sense_description": "in de tijd erna",
                        "target_lang_word": "next",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "next",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44b4049b-7190-3015-9135-20c7e22f4d91",
                                        "entry_id": "5c8b686b-cb00-3399-9ce8-35a3894c0c38",
                                        "glosses": [
                                            "Nearest in place or position, having nothing similar intervening; adjoining."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ecad39-71cd-4f6b-b386-67dd555ec995",
                                                "sense_id": "44b4049b-7190-3015-9135-20c7e22f4d91",
                                                "text": "The man in the next bunk kept me awake all night with his snoring."
                                            },
                                            {
                                                "example_id": "170383c8-1a52-4ab1-a2a7-6d1eeaf72377",
                                                "sense_id": "44b4049b-7190-3015-9135-20c7e22f4d91",
                                                "text": "She lives a mile or two away, in the next village."
                                            },
                                            {
                                                "example_id": "55a4d968-4342-4ba5-ad35-d460edb3525d",
                                                "sense_id": "44b4049b-7190-3015-9135-20c7e22f4d91",
                                                "text": "I live in the next house to the Grand Hotel."
                                            },
                                            {
                                                "example_id": "fa115577-2ef9-4712-9af1-36a68c4533b7",
                                                "sense_id": "44b4049b-7190-3015-9135-20c7e22f4d91",
                                                "text": "Philander went into the next room, which was just a lean-to hitched on to the end of the shanty, and came back with a salt mackerel that dripped brine like a rainstorm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6fec75f-2864-345a-94d1-edbf2ec511f2",
                                        "entry_id": "5c8b686b-cb00-3399-9ce8-35a3894c0c38",
                                        "glosses": [
                                            "Nearest in place or position, having nothing similar intervening; adjoining.",
                                            "Most direct, or shortest or nearest in distance or time."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ef78395-dd31-441a-83e8-35600709590d",
                                                "sense_id": "a6fec75f-2864-345a-94d1-edbf2ec511f2",
                                                "text": "A prophet I, Madam; and I speak the truth the next way: […]"
                                            },
                                            {
                                                "example_id": "f06421d7-5aff-4060-9e5f-4c89219b9caf",
                                                "sense_id": "a6fec75f-2864-345a-94d1-edbf2ec511f2",
                                                "text": "The road to resolution, lies by doubt:\n\"The next way home's the farthest way about.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7b88080-5bda-384f-957f-bdc7dce46de2",
                                        "entry_id": "5c8b686b-cb00-3399-9ce8-35a3894c0c38",
                                        "glosses": [
                                            "Nearest in order, succession, or rank; immediately following (or sometimes preceding) in order."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4498a23-e1c6-432d-bc77-735e448d65ba",
                                                "sense_id": "f7b88080-5bda-384f-957f-bdc7dce46de2",
                                                "text": "Please turn to the next page."
                                            },
                                            {
                                                "example_id": "f482ea85-0bc2-45c7-8f1c-5062a058c4b3",
                                                "sense_id": "f7b88080-5bda-384f-957f-bdc7dce46de2",
                                                "text": "On Wednesday next, I'm going to Spain."
                                            },
                                            {
                                                "example_id": "9335323f-c95d-4076-94b1-90666d492239",
                                                "sense_id": "f7b88080-5bda-384f-957f-bdc7dce46de2",
                                                "text": "the next chapter; the next week; the Sunday next before Easter"
                                            },
                                            {
                                                "example_id": "8e1bc1c1-0b0e-4510-80ec-7f9f3571cb5b",
                                                "sense_id": "f7b88080-5bda-384f-957f-bdc7dce46de2",
                                                "text": "The man was driven by his love for money and his desire to become the next Bill Gates."
                                            },
                                            {
                                                "example_id": "a3d1386b-4465-4a2d-8c5b-cb0687d8d2b0",
                                                "sense_id": "f7b88080-5bda-384f-957f-bdc7dce46de2",
                                                "text": "\"[…]You patriotic?\" / \"I guess so, as much as the next guy,\" I said, wondering how the hell I could shake him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c47e25-eedc-3d95-a9a1-6089541af69d",
                                        "entry_id": "5c8b686b-cb00-3399-9ce8-35a3894c0c38",
                                        "glosses": [
                                            "Nearest in relationship. (See also next of kin.)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032a22c4-b18e-42c0-b631-2c05a0894b13",
                                                "sense_id": "59c47e25-eedc-3d95-a9a1-6089541af69d",
                                                "text": "next friend"
                                            },
                                            {
                                                "example_id": "d7edce74-0b11-40fd-8c21-a069b1394732",
                                                "sense_id": "59c47e25-eedc-3d95-a9a1-6089541af69d",
                                                "text": "And if a man purchase land in fee simple and die without issue, he which is his next cousin collaterall of the whole blood, how farre so ever he be from him in degree, (de quel pluis long degree qu'il soit), may inherite and have the land ..."
                                            },
                                            {
                                                "example_id": "9c1e176b-d61c-48bb-bb99-47153b106949",
                                                "sense_id": "59c47e25-eedc-3d95-a9a1-6089541af69d",
                                                "text": "Thomas Humphrey Doleman died the 30th of August 1712, an infant, intestate and without issue; Lewis the next nephew died the 17th of April 1716, an infant about sixteen years old, having left his mother Mary Webb, ..."
                                            },
                                            {
                                                "example_id": "25e2c285-b2d7-4ed5-abe9-143f2e9acff1",
                                                "sense_id": "59c47e25-eedc-3d95-a9a1-6089541af69d",
                                                "text": "If it be a property, it is a new species, unknown to the civil law, the common law, and the statute law; there is no medium, it must be, if it goes to her next kin, because it is absolute property in her. There can be no distribution of personal property ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "next",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e21666d9-91f5-3618-9a1c-3faf797f93af",
                                        "entry_id": "447c0718-b326-3abb-9acb-213386523de0",
                                        "glosses": [
                                            "Denotes the one immediately following the current or most recent one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885e1c27-d54b-496b-8c04-514ed38fbdbb",
                                                "sense_id": "e21666d9-91f5-3618-9a1c-3faf797f93af",
                                                "text": "Next week would be a good time to meet."
                                            },
                                            {
                                                "example_id": "4b098ab2-d5c4-487f-98da-545e1f87f54d",
                                                "sense_id": "e21666d9-91f5-3618-9a1c-3faf797f93af",
                                                "text": "I'll know better next time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b889e5a6-808c-3d7e-ba94-fbab11c9a936",
                                        "entry_id": "447c0718-b326-3abb-9acb-213386523de0",
                                        "glosses": [
                                            "Closest in the future, or closest but one if the closest is very soon; of days, sometimes thought to specifically refer to the instance closest to seven days (one week) in the future."
                                        ],
                                        "tags": [
                                            "of days of the week or months of the year"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1811a20-c714-46b0-bb01-2f419a08fcd3",
                                                "sense_id": "b889e5a6-808c-3d7e-ba94-fbab11c9a936",
                                                "text": "The party is next Tuesday; that is, not tomorrow, but eight days from now."
                                            },
                                            {
                                                "example_id": "3ead50f3-ba2f-4dc7-ac69-29a1a0ede195",
                                                "sense_id": "b889e5a6-808c-3d7e-ba94-fbab11c9a936",
                                                "text": "When you say next Thursday, do you mean Thursday this week or Thursday next week?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "next",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9410a9c-d7ce-3fc7-8ab7-52d95994f816",
                                        "entry_id": "e2305fce-30c8-39b5-ac52-fad352eae03b",
                                        "glosses": [
                                            "In a time, place, rank or sequence closest or following."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f6b9c62-9bdf-4d4f-9b9e-87d373a8e4e3",
                                                "sense_id": "a9410a9c-d7ce-3fc7-8ab7-52d95994f816",
                                                "text": "They live in the next closest house."
                                            },
                                            {
                                                "example_id": "0071d93a-3432-4b84-93bb-1c6db304a387",
                                                "sense_id": "a9410a9c-d7ce-3fc7-8ab7-52d95994f816",
                                                "text": "It's the next best thing to ice cream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62227e13-e320-3aa7-bb78-a04264bb0dba",
                                        "entry_id": "e2305fce-30c8-39b5-ac52-fad352eae03b",
                                        "glosses": [
                                            "In a time, place, rank or sequence closest or following.",
                                            "So as to follow in time or sequence something previously mentioned."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5810e1-16c6-4391-a5e3-a56c583a4450",
                                                "sense_id": "62227e13-e320-3aa7-bb78-a04264bb0dba",
                                                "text": "First we removed all the handles; next, we stripped off the old paint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee678f3-343e-31fd-9ef0-4cb4e615415a",
                                        "entry_id": "e2305fce-30c8-39b5-ac52-fad352eae03b",
                                        "glosses": [
                                            "On the first subsequent occasion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c31d48-0cc4-48c6-9752-467fb80be248",
                                                "sense_id": "1ee678f3-343e-31fd-9ef0-4cb4e615415a",
                                                "text": "Financial panic, earthquakes, oil spills, riots. What comes next?"
                                            },
                                            {
                                                "example_id": "8d510861-ba05-406e-b1c6-d75a67ffb49c",
                                                "sense_id": "1ee678f3-343e-31fd-9ef0-4cb4e615415a",
                                                "text": "When we next meet, you'll be married."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "next",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72392af2-2a38-3bcc-9dfb-ed0760175c17",
                                        "entry_id": "d12e1023-b343-367f-b8f0-6824d6c58f34",
                                        "glosses": [
                                            "On the side of; nearest or adjacent to; next to."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b13f23-4d76-48a8-857a-58e1284bba15",
                                                "sense_id": "72392af2-2a38-3bcc-9dfb-ed0760175c17",
                                                "text": "D is so dainty a letter, that she admits no other consonant next her but R:[…]"
                                            },
                                            {
                                                "example_id": "013659f0-5107-4049-96db-c8b26f54dc49",
                                                "sense_id": "72392af2-2a38-3bcc-9dfb-ed0760175c17",
                                                "text": "All persons, in walking the streets, whose right sides are next the wall, are intitled to take the wall."
                                            },
                                            {
                                                "example_id": "58d157aa-e7ca-4ccd-b9a6-3537105b47f6",
                                                "sense_id": "72392af2-2a38-3bcc-9dfb-ed0760175c17",
                                                "text": "The fact that the line cannot be original is patent from the fact that Aias in the rest of the Iliad is not encamped next the Athenians […] ."
                                            },
                                            {
                                                "example_id": "e242a52c-5665-4850-bda8-5165ca9daab6",
                                                "sense_id": "72392af2-2a38-3bcc-9dfb-ed0760175c17",
                                                "text": "Photographs indicate that the southern terminals of the ditch system next the west gate may be in echelon, whilst those marginal to the east gate may be slightly inturned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "next",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4afd711-006e-33f6-a5d2-89157c214fae",
                                        "entry_id": "41418775-6502-3ecc-af1a-7925a42802db",
                                        "glosses": [
                                            "The one that follows after this one."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d295972f-6e48-45b5-83e5-1ad3e039461e",
                                                "sense_id": "a4afd711-006e-33f6-a5d2-89157c214fae",
                                                "text": "Next, please, don't hold up the queue!"
                                            },
                                            {
                                                "example_id": "b6e88b93-4d8d-457c-85f9-73c5fbc23ed1",
                                                "sense_id": "a4afd711-006e-33f6-a5d2-89157c214fae",
                                                "text": "There is no time for lunch, hauling myself from one place to the next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "995f7892-4110-3ad7-8138-78ae804cf3ec",
                                        "entry_id": "41418775-6502-3ecc-af1a-7925a42802db",
                                        "glosses": [
                                            "Next match"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a495c5e9-188d-4a40-9135-e63e6919d881",
                                                "sense_id": "995f7892-4110-3ad7-8138-78ae804cf3ec",
                                                "text": "gg team, Wanna play next?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f9fe87e-2e4c-4ab4-acde-1fe5214b0542",
                        "source_entry_id": "9ed3cbf6-8adf-38eb-9530-567ee5b50995",
                        "source_sense_id": "0453db45-64e3-3d67-bb27-446ba7d5d6f4",
                        "source_sense_description": "in de tijd erna",
                        "target_lang_word": "subsequently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subsequently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                        "entry_id": "21cb8174-e395-3990-b181-22b37018172b",
                                        "glosses": [
                                            "Following, afterwards in either time or place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b35cf6b-7386-47b2-970d-f7a0e45d8d8c",
                                                "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                                "text": "It will be recollected that the ill-fated Halloway...distinctly stated the voice of the individual who had approached his post...to have been that of a female, and that the language in which they subsequently conversed was that of the Ottawa Indians."
                                            },
                                            {
                                                "example_id": "6c45b930-05ac-4489-ab60-626e50a43df0",
                                                "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5065abe8-213b-3ca0-9efe-698508679f10",
                                        "entry_id": "21cb8174-e395-3990-b181-22b37018172b",
                                        "glosses": [
