                        "glosses": [
                            "plaats waar men de grens kan passeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9622164-5f24-4a1e-9f10-401ddcfe115d",
                                "sense_id": "a619501d-4fb0-3cf3-997f-9beddb110520",
                                "text": "De grenspassage bij Helmstedt ging sneller dan ooit. Voorheen duurde het uren, met paspoorten die over een lopende band moesten voor een stempel en grondige inspectie van de auto's. De doortocht naar het oosten was ineens hoogst eenvoudig, met die Trabi-file in tegengestelde richting."
                            }
                        ]
