                                "target_senses": [
                                    {
                                        "sense_id": "39801bb2-c28a-377c-a7c4-6fa7e921cca8",
                                        "entry_id": "8d1590ad-3aa4-348b-8293-dee56e6b823d",
                                        "glosses": [
                                            "To prolong; to make longer (in time)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40ec9b9b-2737-4daa-9437-6536a1646af3",
                                                "sense_id": "39801bb2-c28a-377c-a7c4-6fa7e921cca8",
                                                "text": "After Ashby summit it was difficult to spin out the more than ample schedule allowance."
                                            },
                                            {
                                                "example_id": "a69dfbb6-bb18-4ad8-b476-fcf0b092a561",
                                                "sense_id": "39801bb2-c28a-377c-a7c4-6fa7e921cca8",
                                                "text": "Here we were nearly 8 min. early, and was now a matter of spinning out time, as indeed we did—losing 3 min. from Penrith to Carlisle!—in order not to run into Carlisle more than 5 min. early."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599f2d5c-ea9b-3f50-8e7f-66a5b7ccda31",
                                        "entry_id": "8d1590ad-3aa4-348b-8293-dee56e6b823d",
                                        "glosses": [
                                            "To rotate about the yaw axis while skidding, such that the vehicle's longitudinal axis is no longer aligned with its direction of linear motion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
