                    },
                    {
                        "translation_id": "325b3a65-080b-44ab-9920-c3e0d9dbf003",
                        "source_entry_id": "e62559cd-516c-35ac-8cb6-0d150bccf01c",
                        "source_sense_id": "2cb5a915-fbe4-315f-b026-2151204c61a2",
