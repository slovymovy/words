                "senses": [
                    {
                        "sense_id": "9a1bd8fa-b2eb-3e3a-ae13-e86e73938df3",
                        "entry_id": "04678eb0-c3ce-33ab-a6cf-ca43277bf16e",
                        "glosses": [
                            "Stoff, der durch Ionenbindung zusammengehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1518c87-a63a-43ea-930c-0b3949706b92",
                                "sense_id": "9a1bd8fa-b2eb-3e3a-ae13-e86e73938df3",
                                "text": "„Ionenverbindungen haben meist hohe Schmelz- und Siedetemperaturen.“"
                            },
                            {
                                "example_id": "284dd987-90aa-4625-952a-32403a924743",
                                "sense_id": "9a1bd8fa-b2eb-3e3a-ae13-e86e73938df3",
                                "text": "„Als Formelmasse (früher Formelgewicht) bezeichnet man bei einer Ionenverbindung die Summe der Atommassen der verhältnismäßig am Aufbau beteiligten Atome.“"
                            },
                            {
                                "example_id": "a1083bf2-dc73-4ac0-9be4-0ae5895ed544",
                                "sense_id": "9a1bd8fa-b2eb-3e3a-ae13-e86e73938df3",
                                "text": "„Natriumhydrid (NaH) ist das Hydrid des Natriums, also eine Ionenverbindung, in der Wasserstoff negativ geladen ist und Natrium positiv.“"
                            },
                            {
                                "example_id": "d9a26ff4-3804-49b4-a8b5-35e169b0088a",
                                "sense_id": "9a1bd8fa-b2eb-3e3a-ae13-e86e73938df3",
                                "text": "„In festem Zustand leiten Ionenverbindungen den elektrischen Strom nicht. […] Schmelzen oder wässrige Lösungen von Ionenverbindungen leiten den elektrischen Strom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
