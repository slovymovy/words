                                    {
                                        "sense_id": "3f028d95-576a-3b3d-8a1f-b2a406878fc3",
                                        "entry_id": "d76ba988-eea6-38e2-b97d-9a2af45bc1a8",
                                        "glosses": [
                                            "A cod (or similar fish) having been cut open and cured in the open air without salt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e43561d-ea32-47b8-b121-de048303f823",
                                                "sense_id": "3f028d95-576a-3b3d-8a1f-b2a406878fc3",
                                                "text": "So the Prior of Saint Botolph’s hobbled back again into the refectory, to preside over the stockfish and ale, which was just serving out for the friars’ breakfast."
                                            },
                                            {
                                                "example_id": "b6bd069f-4070-45f2-bf3d-325b2a4cecb9",
                                                "sense_id": "3f028d95-576a-3b3d-8a1f-b2a406878fc3",
                                                "text": "We saw the codfish here in all the stages of preparation for the table and the market; the stockfish, dried in the open air, without salt; crapefish, salted and pressed"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stockfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb205973-7236-3891-b471-be6c97bdabea",
                                        "entry_id": "8f89a282-195a-382d-989c-cc82507c4185",
                                        "glosses": [
                                            "The shallow-water Cape hake (Merluccius capensis)"
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fffbb56-17e5-485e-aace-d7cb510677b4",
                        "source_entry_id": "1565d4f2-653f-3587-9336-4ec0e35cde71",
                        "source_sense_description": "poisson séché",
                        "target_lang_word": "stokvis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stokvis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef06773-f611-3714-8d09-d32c483dd8c8",
                                        "entry_id": "8ef00acc-c296-338e-83a9-1268c055d4d8",
                                        "glosses": [
                                            "gedroogde kabeljauw of kabeljauwachtige (orde Gadiformes) vis, zoals heek, leng, lom, schelvis en koolvis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91040100-e297-4ae3-a226-052ffb46475b",
                                                "sense_id": "5ef06773-f611-3714-8d09-d32c483dd8c8",
                                                "text": "Heb je de stokvis al gebeukt?"
                                            },
                                            {
                                                "example_id": "92f23751-9fd2-43b8-80d6-a975b3536190",
                                                "sense_id": "5ef06773-f611-3714-8d09-d32c483dd8c8",
                                                "text": "Advocaatje ging op reis, tiereliereliere...\nStokvis kreeg hij bij 't ontbijt, tierelierelom...\n't Graatje schoot hem in zijn keel, tiereliereliere, etc"
                                            },
                                            {
                                                "example_id": "0aaf0020-966e-4a16-bf57-66f666c3df73",
                                                "sense_id": "5ef06773-f611-3714-8d09-d32c483dd8c8",
                                                "text": "Alleen al het inkopen doen voor de kerstmaaltijd. En het je herinneren hoe het zat met dadels en speculaas, het dopen van stukjes brood in hambouillon, varkenspootjes, stokvis met piment en witte saus op Zweedse wijze of spek in eigen vet, mosterd en doperwtenpuree op Noorse wijze, welke soorten noten verplicht waren — en op het laatste moment op kerstavond zelf notenkrakers aanschaffen —, rolham, haring en rijstebrij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
