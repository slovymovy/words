                "translations": [
                    {
                        "translation_id": "85abc22b-2b7c-4c26-bad6-f0cf32645d1c",
                        "source_entry_id": "5224e322-cc9b-3500-a260-d00aa8425b26",
                        "source_sense_id": "03017cde-7211-389c-aa7c-a1d5d0243704",
                        "source_sense_description": "niet overeenstemmend",
                        "target_lang_word": "widersprüchlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widersprüchlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6fee14e-7bfb-3e61-be97-c1e4b18cc4a8",
                                        "entry_id": "7a6ed10d-1fbe-3232-a7d3-5983021a4fc1",
                                        "glosses": [
                                            "auf eine Art und Weise nicht übereinstimmend, dass offenbar nur eines wahr sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93fb2bc-1544-47b4-82a2-75dcacb87507",
                                                "sense_id": "f6fee14e-7bfb-3e61-be97-c1e4b18cc4a8",
                                                "text": "Die Zeugenaussagen waren widersprüchlich."
                                            },
                                            {
                                                "example_id": "b17a6a88-80b6-47ee-970e-ea7bc5b234e3",
                                                "sense_id": "f6fee14e-7bfb-3e61-be97-c1e4b18cc4a8",
                                                "text": "Die Probanden erhielten vor dem Test eine widersprüchliche Information."
                                            },
                                            {
                                                "example_id": "47e85e7b-7a84-4d5b-943c-8c654944af2e",
                                                "sense_id": "f6fee14e-7bfb-3e61-be97-c1e4b18cc4a8",
                                                "text": "Am widersprüchlichsten fand ich dann doch die Bemerkungen zur Chancengleichheit."
                                            },
                                            {
                                                "example_id": "dceab523-7583-42d9-80ad-f6563e9ac2a9",
                                                "sense_id": "f6fee14e-7bfb-3e61-be97-c1e4b18cc4a8",
                                                "text": "Hartnäckige Fragen geben den [Asyl-]Bewerbern oft das Gefühl, in einem Verhör zu sitzen. Marei Pelzer, Mitarbeiterin der Flüchtlingsorganisation Pro Asyl, erklärt: \"Manche Befragungen werden fast schon dahin gesteuert, dass der Bewerber widersprüchliche Aussagen trifft.\""
                                            },
                                            {
                                                "example_id": "8e760c8d-ef6b-4081-b009-ad5ea09893a4",
                                                "sense_id": "f6fee14e-7bfb-3e61-be97-c1e4b18cc4a8",
                                                "text": "\"Kaiser Wilhelm II. war ein widersprüchlicher Charakter\", sagt der Historiker Ewald Frie. \"Er war unfähig, ein politisches Konzept zu entwickeln und beizubehalten. Seine politischen Strategien waren kurzlebig.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0379be46-8ed6-44f7-b20e-603f8984e5c5",
                        "source_entry_id": "5224e322-cc9b-3500-a260-d00aa8425b26",
                        "source_sense_id": "03017cde-7211-389c-aa7c-a1d5d0243704",
                        "source_sense_description": "niet overeenstemmend",
                        "target_lang_word": "widerspruchsvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e8a4cdaa-4731-4dd1-9738-24189efb2aca",
                        "source_entry_id": "5224e322-cc9b-3500-a260-d00aa8425b26",
                        "source_sense_id": "03017cde-7211-389c-aa7c-a1d5d0243704",
                        "source_sense_description": "niet overeenstemmend",
                        "target_lang_word": "contradictory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contradictory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e3907a-a10d-35c0-9bb7-598afcf94106",
                                        "entry_id": "cb19f1a9-357e-39d7-8181-f17c0436c7b4",
                                        "glosses": [
                                            "That contradicts something, such as an argument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ed5615-e950-461a-a173-764d265a2476",
                                                "sense_id": "c2e3907a-a10d-35c0-9bb7-598afcf94106",
                                                "text": "This wide variety of genuinely contradictory holy sutras generated a serious problem in later Chinese and Japanese Buddhism. In the early period the Chinese and Japanese did not know that there were so many schools of Buddhism which disagreed with one another. Chinese and Japanese Buddhists assumed that every single Buddhist sutra was the actual words of the Buddha himself. As a result, Chinese Buddhists had to come up with some kind of explanation for the contradictory claims and assertions apparently made by the same holy person. The Chinese T’ien-t’ai school decided that the texts were spoken by the Buddha but tailored to different audiences of vastly different capabilities and insight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df96a0fb-7238-306a-8b70-de8f88b5f888",
                                        "entry_id": "cb19f1a9-357e-39d7-8181-f17c0436c7b4",
                                        "glosses": [
                                            "That is itself a contradiction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920286ce-345e-4e72-8872-e950b0d5a1f4",
                                                "sense_id": "df96a0fb-7238-306a-8b70-de8f88b5f888",
                                                "text": "Our attitudes toward sharks are contradictory. We fear them and yet we seek them out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d922bd14-ac0f-3dea-8454-bfb7e5850d48",
                                        "entry_id": "cb19f1a9-357e-39d7-8181-f17c0436c7b4",
                                        "glosses": [
                                            "That is diametrically opposed to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb449924-3c49-422c-bb71-c8f6ee46058c",
                                                "sense_id": "d922bd14-ac0f-3dea-8454-bfb7e5850d48",
                                                "text": "Schemes […] contradictory to common sense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ffef9b9-8fd6-3864-a04d-129f371d7e14",
                                        "entry_id": "cb19f1a9-357e-39d7-8181-f17c0436c7b4",
                                        "glosses": [
                                            "Mutually exclusive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a015ef6-3d76-4ec3-bb76-b7b69436dd31",
                                                "sense_id": "6ffef9b9-8fd6-3864-a04d-129f371d7e14",
                                                "text": "[White House deputy chief of policy Stephen] Miller has offered contradictory versions of Trump administration statements and court rulings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68ab5ebd-679e-3910-9b6c-6a92f1f9c1f7",
                                        "entry_id": "cb19f1a9-357e-39d7-8181-f17c0436c7b4",
                                        "glosses": [
                                            "Tending to contradict or oppose, contrarious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "contradictory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d363f458-abde-34ca-91bb-014beb6f701e",
                                        "entry_id": "ae6926ca-9d6f-3b3e-8856-5d226e7c00f0",
                                        "glosses": [
                                            "Either of a pair of propositions, that cannot both be true or both be false."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3664e57d-72ac-42a2-9f0a-864bae15b5de",
                                                "sense_id": "d363f458-abde-34ca-91bb-014beb6f701e",
                                                "text": "If one proposition is the negation of another, it follows trivially from the definition that the two propositions are contradictories. The converse does not hold. Two propositions can be contradictories without either being the negation of the other. For example:\n 3) John is more than six feet tall\nand\n 4) John is either exactly six feet tall or else less than six feet tall\n are contradictories, but neither is the negation of the other. Negation is one way, but not the only way, of forming a contradictory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94889fab-26c5-4871-97a8-9df767b518f7",
                        "source_entry_id": "5224e322-cc9b-3500-a260-d00aa8425b26",
                        "source_sense_id": "03017cde-7211-389c-aa7c-a1d5d0243704",
                        "source_sense_description": "niet overeenstemmend",
                        "target_lang_word": "contradictoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contradictoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97643abe-8259-37e4-ab42-e134779de2aa",
                                        "entry_id": "72d8532b-fce2-3e7a-8099-14b564699f7a",
                                        "glosses": [
                                            "Qui implique contradiction; incohérent; de deux ou plusieurs choses, qui ne peuvent pas toutes deux être vraies, qui se nient l'une l'autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc0663d-c7be-479a-a69e-5bd3891dc8c7",
                                                "sense_id": "97643abe-8259-37e4-ab42-e134779de2aa",
                                                "text": "Ces jugements contradictoires font écho à la complexité du personnage, à la fois batailleur, cupide, aveuglé par des chimères “ moyennageuses ” et pourtant d’une lucidité désespérée, rêvant de noblesse et se prêtant à des vilenies, contradictoire au point de finir sa vie dans un état semidélirant."
                                            },
                                            {
                                                "example_id": "7a072c3e-721b-46f6-92b4-ac87bf0903b7",
                                                "sense_id": "97643abe-8259-37e4-ab42-e134779de2aa",
                                                "text": "Ces deux affirmations sont contradictoires. - \"Oui\" et \"non\" sont des termes contradictoires. - Des nouvelles contradictoires. - Son discours était 'contradictoire.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2ef7bf-76fa-3c7c-81a1-00e3fe73cb5d",
                                        "entry_id": "72d8532b-fce2-3e7a-8099-14b564699f7a",
                                        "glosses": [
                                            "Qualifie un jugement, un arrêt rendu après que les parties ont été entendues ou après qu’elles ont produit, ou un système où les jugements sont rendus suite l'audition des arguments de parties adverses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b9314c-d971-428d-9eea-abc0c1e42e51",
                                                "sense_id": "ae2ef7bf-76fa-3c7c-81a1-00e3fe73cb5d",
                                                "text": "Jugement contradictoire. - Arrêt contradictoire."
                                            },
                                            {
                                                "example_id": "d1c12866-3500-42f7-ac1f-58004a2e842f",
                                                "sense_id": "ae2ef7bf-76fa-3c7c-81a1-00e3fe73cb5d",
                                                "text": "L’avocat de la défense à l’obligation de défendre vigoureusement les droits de son client et une « section de la défense forte et indépendante au sein du barreau » est essentiel dans notre système de justice contradictoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc501c81-4e40-34e9-9a93-2c273d6eada8",
                                        "entry_id": "72d8532b-fce2-3e7a-8099-14b564699f7a",
                                        "glosses": [
                                            "Qualifie tout acte de procédure fait en présence des parties."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dc33db7-b653-48cd-b911-10c51e4d876c",
                                                "sense_id": "cc501c81-4e40-34e9-9a93-2c273d6eada8",
                                                "text": "Procès- verbal contradictoire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contradictoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf6d9343-5260-3364-ac4c-29885ca1e952",
                                        "entry_id": "a98093ca-e1f0-37c8-a43e-5a0f12c86ce8",
                                        "glosses": [
                                            "Ce qui est en contradiction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fb543a-cf53-4979-8056-9dda47d2251c",
                                                "sense_id": "bf6d9343-5260-3364-ac4c-29885ca1e952",
                                                "text": "Cette affirmation est la contradictoire de telle autre."
                                            },
                                            {
                                                "example_id": "2bf108a7-987e-4c47-b728-a3473e398f36",
                                                "sense_id": "bf6d9343-5260-3364-ac4c-29885ca1e952",
                                                "text": "Dans un livre divin, en effet, tout est vrai, et, deux contradictoires ne pouvant être vraies à la fois, il ne doit s’y trouver aucune contradiction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10e2759-0e41-30de-b630-e29a7672fcbf",
                                        "entry_id": "a98093ca-e1f0-37c8-a43e-5a0f12c86ce8",
                                        "glosses": [
                                            "Ayant permis aux parties d’intervenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3aea416-9509-4ca8-8142-8becae7a979a",
                                                "sense_id": "b10e2759-0e41-30de-b630-e29a7672fcbf",
                                                "text": "Il est pourtant évident que le respect du contradictoire n’a de sens que s’il est par ailleurs garanti par un expert indépendant et impartial."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
