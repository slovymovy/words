                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0348edc4-5906-4e9e-9ec7-334723eca1b8",
                                "sense_id": "6cb5568e-6381-3719-ba25-338a83961e13",
                                "text": "Słońce jeszcze nie zaszło, gdy karawan z białym całunem i czarnym krzyżem wtoczył się w aleję cmentarza Vaugirard."
                            }
