    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da09cbe2-59d5-3b0c-9b1e-404e6540794b",
                    "sense_definition": "voorzien van lijnen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een <w>gelijnd</w> schrift gekocht voor mijn aantekeningen.",
                            "target_lang_translations": {
                                "ru": "Я купил тетрадь <w>в линейку</w> для своих записей."
                            }
                        },
                        {
                            "text": "Schrijf je liever op <w>gelijnd</w> papier of op blanco papier?",
                            "target_lang_translations": {
                                "ru": "Ты предпочитаешь писать на <w>линованной</w> бумаге или на чистой?"
                            }
                        }
                    ],
                    "synonyms": [
                        "gelinieerd"
                    ],
                    "antonyms": [
                        "ongelijnd"
                    ],
                    "common_phrases": [
                        "gelijnd papier"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий линии, разлинованный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линованный",
                                "target_lang_sense_clarification": "о бумаге или тетради с нанесенными линиями"
                            },
                            {
                                "target_lang_word": "в линейку",
                                "target_lang_sense_clarification": "о типе бумаги для письма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97f88318-a9e3-3465-90e7-e0ea690afa5e",
                    "sense_definition": "met een specifieke vorm of omtrek",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ontwerper presenteerde een prachtig <w>gelijnde</w> sportwagen.",
                            "target_lang_translations": {
                                "ru": "Дизайнер представил спортивный автомобиль с <w>прекрасными контурами</w>."
                            }
                        },
                        {
                            "text": "Het jacht heeft een zeer strak <w>gelijnde</w> romp.",
                            "target_lang_translations": {
                                "ru": "У яхты очень <w>обтекаемый</w> корпус."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий определенную форму или контур"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с четкими контурами",
                                "target_lang_sense_clarification": "о дизайне или форме объекта"
                            },
                            {
                                "target_lang_word": "обтекаемый",
                                "target_lang_sense_clarification": "о форме автомобиля или судна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0368d17-f7d2-31f6-810e-70bd7d920775",
                    "sense_definition": "voltooid deelwoord van <w>lijnen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het papier is door de machine <w>gelijnd</w>.",
                            "target_lang_translations": {
                                "ru": "Бумага была <w>разлинована</w> машиной."
                            }
                        },
                        {
                            "text": "Alle pagina's zijn netjes <w>gelijnd</w> voor het schrijven.",
                            "target_lang_translations": {
                                "ru": "Все страницы аккуратно <w>разлинованы</w> для письма."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammaticale vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие прошедшего времени от глагола «проводить линии»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разлинованный",
                                "target_lang_sense_clarification": "о процессе нанесения линий на бумагу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05cb168d-2eeb-3dca-95d8-ead4645b0f40",
                    "sense_definition": "voltooid deelwoord van <w>lijnen</w> (op dieet zijn)",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft maandenlang <w>gelijnd</w> om af te vallen.",
                            "target_lang_translations": {
                                "ru": "Она месяцами <w>сидела на диете</w>, чтобы похудеть."
                            }
                        },
                        {
                            "text": "Er wordt in die kringen veel <w>gelijnd</w> om slank te blijven.",
                            "target_lang_translations": {
                                "ru": "В тех кругах многие <w>сидят на диете</w>, чтобы оставаться стройными."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammaticale vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие прошедшего времени от глагола «сидеть на диете»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сидевший на диете",
                                "target_lang_sense_clarification": "о процессе ограничения питания для похудения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
