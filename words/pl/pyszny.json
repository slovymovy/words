                {
                    "sense_id": "f5eb639f-22af-36a0-9736-ea6995c0eec8",
                    "sense_definition": "Pełen pychy, mający o sobie zbyt wysokie mniemanie; zarozumiały.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>pyszny</w> człowiek nigdy nie słucha rad innych ludzi.",
                            "target_lang_translations": {
                                "ru": "Этот <w>высокомерный</w> человек никогда не слушает советов других людей.",
                                "en": "This <w>arrogant</w> man never listens to other people's advice.",
                                "nl": "Die <w>arrogante</w> man luistert nooit naar het advies van anderen.",
                                "de": "Dieser <w>hochmütige</w> Mensch hört nie auf den Rat anderer Leute.",
                                "fr": "Cet homme <w>arrogant</w> n'écoute jamais les conseils des autres.",
                                "it": "Quell'uomo <w>superbo</w> non ascolta mai i consigli degli altri.",
                                "cs": "Ten <w>namyšlený</w> člověk nikdy neposlouchá rady jiných lidí.",
                                "tr": "Bu <w>kibirli</w> adam başkalarının tavsiyelerini asla dinlemez.",
                                "es": "Ese hombre tan <w>soberbio</w> nunca escucha los consejos de los demás.",
                                "zh": "那个<w>傲慢</w>的人从不听别人的建议。"
                            }
                        },
                        {
                            "text": "Król był tak <w>pyszny</w>, że uważał się za równego bogom.",
                            "target_lang_translations": {
                                "ru": "Король был так <w>высокомерен</w>, что считал себя равным богам.",
                                "en": "The king was so <w>haughty</w> that he considered himself equal to the gods.",
                                "nl": "De koning was zo <w>hoogmoedig</w> dat hij zichzelf gelijkwaardig aan de goden beschouwde.",
                                "de": "Der König war so <w>überheblich</w>, dass er sich den Göttern ebenbürtig fühlte.",
                                "fr": "Le roi était si <w>orgueilleux</w> qu'il se considérait l'égal des dieux.",
                                "it": "Il re era così <w>arrogante</w> che si considerava pari agli dei.",
                                "cs": "Král byl tak <w>pyšný</w>, že se považoval za rovného bohům.",
                                "tr": "Kral o kadar <w>kibirliydi</w> ki kendini tanrılara eşit görüyordu.",
                                "es": "El rey era tan <w>altivo</w> que se consideraba igual a los dioses.",
                                "zh": "国王极其<w>自大</w>，甚至自认为能与神明平起平坐。"
                            }
