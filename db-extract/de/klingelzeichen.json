                        "glosses": [
                            "Zeichen für etwas, das durch Klingeln gegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd689ce7-cc72-43eb-9a42-06455891b108",
                                "sense_id": "42cf5978-483a-301f-9c9e-27e3a2fd03a1",
                                "text": "„Klingelzeichen ertönten, die Vorstandsmitglieder stürzten zum Eingang, und die in den verschiedenen Räumen zerstreuten Gäste drängten sich auf einen Haufen zusammen – es erinnerte an das Zusammenrinnen der Roggenkörner auf der Worfschaufel – und blieben im grossen Salon an der Saaltür stehen.“"
                            },
                            {
                                "example_id": "04734097-c58a-481e-85d9-90b77024c53f",
                                "sense_id": "42cf5978-483a-301f-9c9e-27e3a2fd03a1",
                                "text": "„Als habe man nur auf ihn gewartet, fuhr der Wagen mit einem kurzen Klingelzeichen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
