                "senses": [
                    {
                        "sense_id": "c4a300f4-bc7d-38e3-9da9-ad4d31323c99",
                        "entry_id": "32718727-bba9-3615-bd8f-dd855293bd4f",
                        "glosses": [
                            "female equivalent of курье́р (kurʹjér): female courier"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3f4d50a3-f5c8-43ea-b295-69ef2d266522",
                                "sense_id": "c4a300f4-bc7d-38e3-9da9-ad4d31323c99",
                                "text": "В пе́рвое вре́мя Со́фья Петро́вна никого́ в изда́тельстве не зна́ла, кро́ме свои́х машини́сток, да ещё курье́рши, разноси́вшей бума́ги.",
                                "translation": "At first Sofia Petrovna knew no one at the publishing house except her own typists and the messenger woman who carried the documents.",
                                "english": "At first Sofia Petrovna knew no one at the publishing house except her own typists and the messenger woman who carried the documents."
                            }
                        ]
                    }
