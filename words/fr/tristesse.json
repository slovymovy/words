                {
                    "sense_id": "7670c4ea-e295-3c5a-83be-4add7a74c074",
                    "sense_definition": "Caractère morne, lugubre ou mélancolique de ce qui inspire de la peine ou de l'ennui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ambiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie continue ajoutait à la <w>tristesse</w> de ce paysage d'hiver.",
                            "target_lang_translations": {
                                "en": "The continuing rain added to the <w>bleakness</w> of this winter landscape.",
                                "ru": "Непрекращающийся дождь усиливал <w>унылость</w> этого зимнего пейзажа.",
                                "nl": "De aanhoudende regen droeg bij aan de <w>troosteloosheid</w> van dit winterlandschap.",
                                "de": "Der anhaltende Regen verstärkte die <w>Trostlosigkeit</w> dieser Winterlandschaft.",
                                "pl": "Nieustający deszcz dodawał <w>ponurości</w> temu zimowemu krajobrazowi.",
                                "it": "La pioggia incessante aggiungeva <w>tetraggine</w> a quel paesaggio invernale.",
                                "cs": "Neustálý déšť ještě přidával na <w>ponurosti</w> této zimní krajiny.",
                                "tr": "Bitmek bilmeyen yağmur, bu kış manzarasının <w>kasvetini</w> daha da artırıyordu.",
                                "es": "La lluvia continua aumentaba la <w>tristeza</w> de aquel paisaje invernal.",
                                "zh": "连绵的雨给这片冬日景色增添了几分<w>凄凉</w>。"
                            }
                        },
                        {
                            "text": "La <w>tristesse</w> de cette pièce sans fenêtres rendait l'atmosphère très pesante.",
                            "target_lang_translations": {
                                "en": "The <w>gloom</w> of this windowless room made the atmosphere very oppressive.",
                                "ru": "<w>Мрачность</w> этой комнаты без окон делала атмосферу очень гнетущей.",
                                "nl": "De <w>somberheid</w> van deze kamer zonder ramen maakte de sfeer erg drukkend.",
                                "de": "Die <w>Düsternis</w> dieses fensterlosen Raumes machte die Atmosphäre sehr bedrückend.",
                                "pl": "<w>Posępność</w> tego bezokiennego pokoju sprawiała, że atmosfera była bardzo ciężka.",
                                "it": "La <w>cupezza</w> di questa stanza senza finestre rendeva l'atmosfera molto pesante.",
                                "cs": "<w>Bezútěšnost</w> této místnosti bez oken dělala atmosféru velmi tísnivou.",
                                "tr": "Pencere olmayan bu odanın <w>kasveti</w> ortamı çok boğucu hâle getiriyordu.",
                                "es": "La <w>tristeza</w> de esta habitación sin ventanas hacía muy opresivo el ambiente.",
                                "zh": "这间没有窗户的房间里弥漫着一股<w>阴郁</w>，让整个气氛变得十分压抑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tristesse du paysage"
                    ],
                    "target_lang_definitions": {
                        "en": "The gloomy, dismal quality of something that evokes sorrow or boredom.",
                        "ru": "Мрачный, унылый или тоскливый характер чего-либо, навевающего печаль или скуку.",
                        "nl": "Sombere, troosteloze of melancholieke eigenschap van iets dat verdriet of verveling oproept.",
                        "de": "Düsterer, trostloser Charakter von etwas, das Schwermut oder Langeweile hervorruft.",
                        "pl": "Ponury, przygnębiający charakter czegoś, co budzi smutek lub znudzenie.",
                        "it": "Carattere cupo, lugubre o malinconico di ciò che suscita pena o noia.",
                        "cs": "Pochmurný, ponurý nebo tísnivý ráz něčeho, co vyvolává smutek nebo nudu.",
                        "tr": "Bir yerin ya da ortamın üzüntü ve can sıkıntısı uyandıran, kasvetli ve iç karartıcı hâli.",
                        "es": "Carácter sombrío, lúgubre o melancólico de algo que causa pena o aburrimiento.",
                        "zh": "阴暗、凄凉、令人压抑或烦闷的特质，多用于环境、景色或氛围。"
                    },
