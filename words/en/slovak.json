    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33716dd4-9ec5-3b6e-9fd8-7982d41132dc",
                    "sense_definition": "Relating to Slovakia, its people, or its language.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Slovakia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed eating traditional <w>Slovak</w> food during our trip to Bratislava.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки в Братиславу нам очень понравилось есть традиционную <w>словацкую</w> еду."
                            }
                        },
                        {
                            "text": "The <w>Slovak</w> culture is rich with beautiful folk music and dance.",
                            "target_lang_translations": {
                                "ru": "<w>Словацкая</w> культура богата прекрасной народной музыкой и танцами."
                            }
                        }
                    ],
                    "synonyms": [
                        "Slovakian"
                    ],
                    "common_phrases": [
                        "Slovak culture",
                        "Slovak history",
                        "Slovak border"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Словакии, её народу или языку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словацкий",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f6059582-d567-3601-851a-304dff61fec8",
                    "sense_definition": "The West Slavic language spoken primarily in Slovakia.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Slovakia",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He is learning to speak <w>Slovak</w> because his grandparents are from Europe.",
                            "target_lang_translations": {
                                "ru": "Он учится говорить по-<w>словацки</w>, потому что его бабушка и дедушка из Европы."
                            }
                        },
                        {
                            "text": "It is helpful to know some <w>Slovak</w> phrases when traveling through the country.",
                            "target_lang_translations": {
                                "ru": "Путешествуя по стране, полезно знать несколько фраз на <w>словацком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Slovakian",
                        "Slovakish"
                    ],
                    "common_phrases": [
                        "speak Slovak",
                        "Slovak phrases",
                        "fluent in Slovak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Западнославянский язык, на котором говорят преимущественно в Словакии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словацкий язык",
                                "target_lang_sense_clarification": "название языка"
                            },
                            {
                                "target_lang_word": "словацкий",
                                "target_lang_sense_clarification": "язык"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56f9b4c0-e385-37fe-8657-06b0e4f20601",
                    "sense_definition": "A person from Slovakia or someone of Slovak descent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Slovakia",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The famous scientist was a proud <w>Slovak</w> who lived in the United States.",
                            "target_lang_translations": {
                                "ru": "Знаменитый учёный был гордым <w>словаком</w>, жившим в Соединённых Штатах."
                            }
                        },
                        {
                            "text": "Many <w>Slovaks</w> live in neighboring countries like Czechia and Hungary.",
                            "target_lang_translations": {
                                "ru": "Многие <w>словаки</w> живут в соседних странах, таких как Чехия и Венгрия."
                            }
                        }
                    ],
                    "synonyms": [
                        "Slovakian"
                    ],
                    "common_phrases": [
                        "native Slovak",
                        "proud Slovak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек из Словакии или словацкого происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словак",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "словачка",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ]
                    }
                }
            ]
        }
    ]
