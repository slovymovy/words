                "senses": [
                    {
                        "sense_id": "1dcefb94-e431-3310-9ca7-0167bb2b3b30",
                        "entry_id": "627ba855-6118-3eba-9c7c-5cb5e86d608e",
                        "glosses": [
                            "Rakete zur Bekämpfung von Luftzielen von der Erdoberfläche (der Wasseroberfläche) aus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ded07b-a875-4972-bf7a-351577e26ea1",
                                "sense_id": "1dcefb94-e431-3310-9ca7-0167bb2b3b30",
                                "text": "Das in den Luftraum eingedrungene feindliche Flugzeug wurde von einer Luftabwehrrakete zerstört."
                            },
                            {
                                "example_id": "6911fe68-5329-458e-86c1-a57e0b77b505",
                                "sense_id": "1dcefb94-e431-3310-9ca7-0167bb2b3b30",
                                "text": "„Die Sowjets hofften, die IDF würden eine Hawk-Luftabwehrrakete abfeuern, damit man ihre Eigenschaften erkunden könnte.“"
                            },
                            {
                                "example_id": "01bf71d0-19f3-4e61-8a6e-2417b0fc48da",
                                "sense_id": "1dcefb94-e431-3310-9ca7-0167bb2b3b30",
                                "text": "„Dazu kommt das schwierige Dossier MH17, das Passagierflugzeug, das von einer russischen Luftabwehrrakete über der Ukraine abgeschossen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
