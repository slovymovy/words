                ],
                "senses": [
                    {
                        "sense_id": "d051c343-eecb-3a0c-8665-a0e9926e8dba",
                        "entry_id": "e42b5199-44e0-3a98-bd58-e366494b6eaf",
                        "glosses": [
                            "zo veel als in een hand past"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46f2061-1c6d-4064-a5b9-05a3efa4ee73",
                                "sense_id": "d051c343-eecb-3a0c-8665-a0e9926e8dba",
                                "text": "Een handvol zaad is genoeg voor een tuin vol bloemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f31580b6-544e-3c61-9dd5-412b45066d30",
                        "entry_id": "e42b5199-44e0-3a98-bd58-e366494b6eaf",
                        "glosses": [
                            "klein aantal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a3da17-799b-4cac-8a22-c98f631d9214",
                                "sense_id": "f31580b6-544e-3c61-9dd5-412b45066d30",
                                "text": "In het begin waren het er een handvol, nu tientallen."
                            },
                            {
                                "example_id": "767246d9-30a7-4d6f-a60d-2f1121351e35",
                                "sense_id": "f31580b6-544e-3c61-9dd5-412b45066d30",
                                "text": "De politie heeft een handvol tips ontvangen."
                            },
                            {
                                "example_id": "ee76ccdc-e909-40b1-89cc-9668360e42c7",
                                "sense_id": "f31580b6-544e-3c61-9dd5-412b45066d30",
                                "text": "Er is minder dan een handvol haarspeldbochten, maar de hellingsgraden slopen de eerste reserves uit de benen."
                            },
                            {
                                "example_id": "c6c79001-80d3-4d37-b426-ef928bfb46a4",
                                "sense_id": "f31580b6-544e-3c61-9dd5-412b45066d30",
                                "text": "Eerder zei de politie Amsterdam dat de melding van Nathalie de enige was. Na nieuw contact bevestigt de politie nu dat er \"een handvol meldingen\" bekend zijn. Meer politiebureaus bevestigen dat het probleem mogelijk groter is dan nu bekend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d167c25a-c8b4-4f68-94cb-bec32253f2df",
                        "source_entry_id": "e42b5199-44e0-3a98-bd58-e366494b6eaf",
                        "source_sense_id": "f31580b6-544e-3c61-9dd5-412b45066d30",
                        "source_sense_description": "klein aantal",
                        "target_lang_word": "handful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3bfd68a-18cc-3ce6-9e26-3821c395c99f",
                                        "entry_id": "dc0fbabb-ced5-353a-a963-5558d7196813",
                                        "glosses": [
                                            "The amount that a hand will grasp or contain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554eb19f-7027-4a55-8303-5eb7b572ac24",
                                                "sense_id": "b3bfd68a-18cc-3ce6-9e26-3821c395c99f",
                                                "text": "I put two or three corns in my mouth, liked it, stole a handful, went into my chamber, chewed it, and for two months after never failed taking toll of every pennyworth of oatmeal that came into the house: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33ec2ede-0612-323c-880e-db0b91b3c3d0",
                                        "entry_id": "dc0fbabb-ced5-353a-a963-5558d7196813",
                                        "glosses": [
                                            "A hand's breadth; four inches."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da290aec-75e1-4891-b5e8-cae4a0f39f56",
                                                "sense_id": "33ec2ede-0612-323c-880e-db0b91b3c3d0",
                                                "text": "Knap the tongs together about a handful from the bottom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21cd8b90-1345-3a0e-9927-0ec90a6d3f31",
                                        "entry_id": "dc0fbabb-ced5-353a-a963-5558d7196813",
                                        "glosses": [
                                            "A small number, usually approximately five."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2602109a-e928-49d0-86e6-7d441ba7cdc2",
                                                "sense_id": "21cd8b90-1345-3a0e-9927-0ec90a6d3f31",
                                                "text": "This handful of men were tied to very hard duty."
                                            },
                                            {
                                                "example_id": "a5b03e0f-e0a7-45a3-883f-4ef5d981db8b",
                                                "sense_id": "21cd8b90-1345-3a0e-9927-0ec90a6d3f31",
                                                "text": "The names of a number of the most famous North American railroads could be found in the north-east; Pennsylvania, New York Central, Baltimore & Ohio, Chesapeake & Ohio, and the Norfolk & Western, to name but a handful."
                                            },
                                            {
                                                "example_id": "f4317364-65dd-4ae8-961e-b4cdd5e47404",
                                                "sense_id": "21cd8b90-1345-3a0e-9927-0ec90a6d3f31",
                                                "text": "Was it deliberate that the first week of October 1961 was chosen to conduct a national survey of passenger usage? Why October of all months, when the holiday season was over and families back at work and at school? Was this a fiddling of the figures to make an unfair case against rail-dependent resorts such as those in the West Country, Norfolk, Lincolnshire and East Yorkshire, where previously overloaded summer services would now only have a handful of locals on board?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56651023-76bc-3974-a58e-e797dad63074",
                                        "entry_id": "dc0fbabb-ced5-353a-a963-5558d7196813",
                                        "glosses": [
                                            "A group or number of things; a bunch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d31ef40d-89a5-4ca8-8166-da4023be20db",
                                                "sense_id": "56651023-76bc-3974-a58e-e797dad63074",
                                                "text": "But, aunt, she must have had some kind of education, her accent was so pure, her English so unfaulty. The other girl dropped her h's by handfuls, and made some very wild confusion in her native etymology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50f6e12a-d75f-3f5b-840a-5728faa2d3b0",
                                        "entry_id": "dc0fbabb-ced5-353a-a963-5558d7196813",
                                        "glosses": [
                                            "Something which can only be managed with difficulty."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f782c0-a303-435b-9b62-ce9280a29dd9",
                                                "sense_id": "50f6e12a-d75f-3f5b-840a-5728faa2d3b0",
                                                "text": "Those twins are a real handful to look after."
                                            },
                                            {
                                                "example_id": "fc1b65d4-9a1d-415f-92b0-9131db29516e",
                                                "sense_id": "50f6e12a-d75f-3f5b-840a-5728faa2d3b0",
                                                "text": "The Southern acquired them because the little Class \"B4\" 0-4-0 tanks were finding heavy modern rolling stock more and more of a handful, and at war's end the railway had nothing of suitable power but short wheelbase on its books to take their place on the more tortuous of the dock lines."
                                            },
                                            {
                                                "example_id": "77afb431-d5a0-46c7-ae2e-ba9f77a9906a",
                                                "sense_id": "50f6e12a-d75f-3f5b-840a-5728faa2d3b0",
                                                "text": "Many times dogs are surrendered for reasons such as changes in the family unit, a death in the family, no time to care for a dog, or because that cute little puppy is now a 100 lb untrained handful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "212b8446-92d5-336a-ab62-3aa49dcf5bd1",
                                        "entry_id": "dc0fbabb-ced5-353a-a963-5558d7196813",
                                        "glosses": [
                                            "A five-year prison sentence."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bda7049-91e8-4564-8869-632f6d7d7a60",
                        "source_entry_id": "e42b5199-44e0-3a98-bd58-e366494b6eaf",
