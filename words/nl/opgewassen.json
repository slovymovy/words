                    "sense_definition": "in staat zijn om weerstand te bieden aan of om te gaan met iets of iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was niet <w>opgewassen</w> tegen de zware druk van zijn nieuwe baan.",
                            "target_lang_translations": {
                                "fr": "Il n'était pas <w>de taille</w> face à la forte pression de son nouvel emploi."
                            }
                        },
                        {
                            "text": "Onze verdediging bleek uiteindelijk goed <w>opgewassen</w> tegen de snelle aanvallers.",
                            "target_lang_translations": {
