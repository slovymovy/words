                "senses": [
                    {
                        "sense_id": "1721d61d-dbf1-3f3a-9f16-44aa9ef61b2a",
                        "entry_id": "c6c3cfcf-6dae-38d9-a427-527e36fa8507",
                        "glosses": [
                            "Faire perdre son caractère chamboulé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8795e44-a052-4a79-96ee-833e0034ec5d",
                                "sense_id": "1721d61d-dbf1-3f3a-9f16-44aa9ef61b2a",
                                "text": "Ça part très bien mais lorsque Montréal arrive, on vient tout déchambouler."
                            },
                            {
                                "example_id": "15731f35-bcb8-419f-9eae-7c5e7ad9dbc1",
                                "sense_id": "1721d61d-dbf1-3f3a-9f16-44aa9ef61b2a",
                                "text": "En son honneur et par mon devoir de maman, je dois réussir la transition, déchambouler le chamboulement."
                            },
                            {
                                "example_id": "94f0f821-c934-4dc0-8fff-d957b0503255",
                                "sense_id": "1721d61d-dbf1-3f3a-9f16-44aa9ef61b2a",
                                "text": "Aussi, pour cette fois, je préfère rester coi et vous laisser vous déchambouler tout seul."
                            }
                        ]
                    }
