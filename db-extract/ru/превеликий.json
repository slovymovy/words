                "senses": [
                    {
                        "sense_id": "b24f73a1-ce98-310e-acfb-884787d73e47",
                        "entry_id": "5dfc4474-d4db-3eee-9113-66945f03c129",
                        "glosses": [
                            "great, significant"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "2ca5ae31-1d27-4762-b004-25864902eea9",
                                "sense_id": "b24f73a1-ce98-310e-acfb-884787d73e47",
                                "text": "с превели́ким удово́льствием",
                                "translation": "with great pleasure",
                                "english": "with great pleasure"
                            },
                            {
                                "example_id": "7d14a978-06b5-4548-8da9-2a181196408a",
                                "sense_id": "b24f73a1-ce98-310e-acfb-884787d73e47",
                                "text": "Весь день пробы́ли мы у них в превели́кой ску́ке.",
                                "translation": "We spent the whole day with them in great boredom.",
                                "english": "We spent the whole day with them in great boredom."
                            }
                        ]
                    },
                    {
                        "sense_id": "58a9288e-da91-387c-806e-b8aff4114b6f",
                        "entry_id": "5dfc4474-d4db-3eee-9113-66945f03c129",
                        "glosses": [
                            "outstanding (standing out in a certain quality)"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b597216e-4e3e-4d53-bf16-e16d3fa5a071",
                                "sense_id": "58a9288e-da91-387c-806e-b8aff4114b6f",
                                "text": "Журнали́ст, поэ́т-шестидеся́тник. И превели́кий гре́шник! Вот я его́ гре́хи, наве́рно, и зама́ливаю.",
                                "translation": "Journalist, poet of the sixties. And a great sinner! So I probably atone for his sins.",
                                "english": "Journalist, poet of the sixties. And a great sinner! So I probably atone for his sins."
                            }
                        ]
                    }
                ],
