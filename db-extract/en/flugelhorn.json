                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d27ff561-76b3-44d8-807b-a5ca88439674",
                                                "sense_id": "e0828fe6-b6e7-3383-a1a6-c42ade997635",
                                                "text": "Il allait à la chasse en habit vert pomme, en bottes rousses, un bugle en sautoir comme un conducteur des Messageries royales."
                                            }
                                        ]
                                    }
