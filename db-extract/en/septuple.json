                ],
                "senses": [
                    {
                        "sense_id": "985bf0c6-653f-3ecd-ba39-4bfb07d4f725",
                        "entry_id": "239e6af8-f4d6-30a6-9050-75e57641fdb9",
                        "glosses": [
                            "To multiply by seven."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "63407867-860f-488e-b929-d6bd15003ebb",
                                "sense_id": "985bf0c6-653f-3ecd-ba39-4bfb07d4f725",
                                "text": "[…] hee is rid of the Deuill. Now he that is quit of so bad a Guest, shall septuple his owne woes by his re-entertainment."
                            },
                            {
                                "example_id": "c6daf9af-71d4-4215-b4b3-dd7c4ea47b6e",
                                "sense_id": "985bf0c6-653f-3ecd-ba39-4bfb07d4f725",
                                "text": "The intensity of solar radiation is nearly seven times greater on Mercury than on the earth, and on Uranus 330 times less; the proportion between the two extremes being that of upwards of 2000 to one. Let any one figure to himself the condition of our globe, were the sun to be septupled, to say nothing of the greater ratio!"
                            }
                        ]
                    },
                    {
                        "sense_id": "b03ebc1d-f58c-37f9-88cb-f4f4538696b2",
                        "entry_id": "239e6af8-f4d6-30a6-9050-75e57641fdb9",
                        "glosses": [
                            "To increase by a factor of seven."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "257aa138-836c-49f4-bef6-729ecbd403e9",
                                "sense_id": "b03ebc1d-f58c-37f9-88cb-f4f4538696b2",
                                "text": "[…] Levi Strauss had caught a wave. Between 1962 and 1970, its sales and net profits grew fivefold and between 1970 and 1977 its sales again quintupled while profits almost septupled."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f28795f8-9968-45bc-a2fe-a887e257c38e",
                        "source_entry_id": "239e6af8-f4d6-30a6-9050-75e57641fdb9",
                        "source_sense_description": "multiply by seven",
                        "target_lang_word": "versiebenfachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versiebenfachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cdc494d-054c-3709-ab9e-411150e96ea8",
                                        "entry_id": "4570e4c2-773b-3852-99ce-b8ba2610c8c8",
                                        "glosses": [
                                            "auf die siebenfache Anzahl bringen, in seiner Summe siebenmal so groß machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d9c83a8-150e-4a2a-9d66-7c9fe5d93ff2",
                                                "sense_id": "3cdc494d-054c-3709-ab9e-411150e96ea8",
                                                "text": "„[…] Berechnung, Mäßigkeit und Fleiß – das sind die drei zuverlässigsten Karten, die mein Vermögen verdreifachen, versiebenfachen und mir Ruhe und Unabhängigkeit verschaffen werden!“"
                                            },
                                            {
                                                "example_id": "d6e05005-87be-42a6-948a-8de8ce32a020",
                                                "sense_id": "3cdc494d-054c-3709-ab9e-411150e96ea8",
                                                "text": "„Was den Schmerz ungluͤcklicher Eheleute verſiebenfachen muß, iſt die Geſellſchaft ſelbſt, wovon der Eheſtand das Vereinigungsband ausmacht.“ [1787]"
                                            },
                                            {
                                                "example_id": "b4412516-4627-418c-8cf3-deb8930fe126",
                                                "sense_id": "3cdc494d-054c-3709-ab9e-411150e96ea8",
                                                "text": "„Mit einem auf Vorschlag [George W.] Bushs vom Kongress verabschiedeten Gesetz verpflichteten sich die Vereinigten Staaten, bis 2022 den Anteil des verfügbaren Äthanols an Tankstellen zu versiebenfachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0492ab7-058a-394f-b79b-146de88835ad",
                                        "entry_id": "4570e4c2-773b-3852-99ce-b8ba2610c8c8",
                                        "glosses": [
                                            "sich auf die siebenfache Anzahl erhöhen beziehungsweise siebenfache Menge vergrößern"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4d02368-bcd0-4a40-9d43-6e90e517075f",
                                                "sense_id": "e0492ab7-058a-394f-b79b-146de88835ad",
                                                "text": "„Nach verschiedenen Berechnungen hat sich der Ressourcenverbrauch in den vergangenen 50 Jahren versiebenfacht, […] während sich die Weltbevölkerung ‚nur‘ verdoppelt hat.“"
                                            },
                                            {
                                                "example_id": "bbcce48b-a43b-4527-bf99-de0654e7b193",
                                                "sense_id": "e0492ab7-058a-394f-b79b-146de88835ad",
                                                "text": "„Nach Schätzungen des Internationalen Wirtschaftsforums Regenerative Energien wird sich in diesem Jahrzehnt die Windstromproduktion versiebenfachen, während die Solarstromproduktion sogar um das Zwanzigfache zunehmen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
