                "senses": [
                    {
                        "sense_id": "422002dc-25a3-3353-9c42-8c3787d8a51e",
                        "entry_id": "3189d3c5-00db-39c7-baa6-76fb01abea16",
                        "glosses": [
                            "The borders or limits of an area."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "e9b1cf96-24ea-4bc8-aefe-15cf7b742cca",
                                "sense_id": "422002dc-25a3-3353-9c42-8c3787d8a51e",
                                "text": "It has not been used for many years, and although it was impracticable to photograph the engine in the small confines of the shed it was possible to obtain a picture of the plate which it still carries showing the former ownership."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc47718d-89f1-348d-ac0c-afd0854fb9ff",
                        "entry_id": "3189d3c5-00db-39c7-baa6-76fb01abea16",
                        "glosses": [
                            "Elements that restrain someone."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "7bec7fe4-ccd0-4ee3-92e1-1edac947a904",
                                "sense_id": "fc47718d-89f1-348d-ac0c-afd0854fb9ff",
                                "text": "\"I think that there comes a point where people begin to get bored within their own confines, so there is definitely an opportunity to encourage travel - even though it will be a different sort of arrangement than we've been used to in the past."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca6372d4-d5bb-349f-a7ea-0178d9a8afae",
                        "entry_id": "3189d3c5-00db-39c7-baa6-76fb01abea16",
