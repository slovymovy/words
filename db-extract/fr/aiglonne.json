                        "entry_id": "8e32b0d5-c982-32c8-bef1-5a10683a3ba2",
                        "glosses": [
                            "Petite de l’aigle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca135225-8a7f-4eab-af42-490cba6b4ef7",
                                "sense_id": "2f5de304-6709-32e5-a28a-db5ca4f07d86",
                                "text": "L’aiglonne, quant à elle, se déplace sur l’aire 23 jours après la naissance."
                            },
                            {
                                "example_id": "2c239b65-8d52-45f0-a085-b8784aa82e6f",
                                "sense_id": "2f5de304-6709-32e5-a28a-db5ca4f07d86",
                                "text": "Si je plais à mon poète, s’il me plaît, le brillant édifice de notre amour sera bâti si haut, qu’il sera parfaitement inaccessible au malheur : je suis une aiglonne, et vous le verrez à mes yeux."
                            }
                        ]
                    }
                ],
