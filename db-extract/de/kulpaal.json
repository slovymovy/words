                "senses": [
                    {
                        "sense_id": "7044fd66-e669-3327-9455-8fd07ae85bde",
                        "entry_id": "ca3e149d-a402-3425-84b3-1eb131c15d53",
                        "glosses": [
                            "vor dem Räuchern enthäuteter Aal"
                        ],
                        "tags": [
                            "Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "bdbf8adf-0cd5-453d-a6ee-30443d4f35c1",
                                "sense_id": "7044fd66-e669-3327-9455-8fd07ae85bde",
                                "text": "„In Hamburg pflegt man erst den Aal abzuziehen, ihn alsdann mit Salz und Gewürzen einzureiben, hierauf die Haut wieder überzuziehen und ihn alsdann zu räuchern. Auf diese Art soll er vorzüglich lecker werden. Man nennt ihn alsdann Kulpaal."
                            },
                            {
                                "example_id": "6b6a1c28-2867-4bba-b81f-62288d31de65",
                                "sense_id": "7044fd66-e669-3327-9455-8fd07ae85bde",
                                "text": "„Am fettreichsten ist geräucherter Aal: Spickaal (mittelniederdeutsch spieken = räuchern) und Kulpaal (vorm Räuchern enthäutet).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
