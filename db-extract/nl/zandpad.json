                "translations": [
                    {
                        "translation_id": "65524954-ba2c-47c6-ba7f-018aa8d12a8a",
                        "source_entry_id": "35d38440-ae06-333c-983f-893ea9305b0f",
                        "source_sense_id": "544e579c-eecd-3405-962f-cda34d5d99d2",
                        "target_lang_word": "Sandweg",
