                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "26c83f98-8f12-3c39-8595-466577d016d4",
                        "entry_id": "d2fce43f-0e81-3fd4-94aa-9a1d351fc529",
                        "glosses": [
                            "Les épaules, et par extension le dos."
                        ],
                        "tags": [
                            "plural",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b87b9738-3157-4755-939a-c53527a06a95",
                                "sense_id": "26c83f98-8f12-3c39-8595-466577d016d4",
                                "text": "Ni un costume de soixante raides sur les endosses !"
                            },
                            {
                                "example_id": "6c79134d-211c-42ca-8d03-e885d6d9a92e",
                                "sense_id": "26c83f98-8f12-3c39-8595-466577d016d4",
                                "text": "Très joliment sapée, une étole de vison sur ses endosses mignonnes, avec, aux châsses, le feu de la femme heureuse."
                            },
                            {
                                "example_id": "0d82b2dc-53ef-4959-ad4f-955324155680",
                                "sense_id": "26c83f98-8f12-3c39-8595-466577d016d4",
                                "text": "Les femmes qui lavaient leur linge avaient de l’eau propre dans une bassine. Par-dessus la porte, flac, elles me l’ont balancée sur les endosses."
                            }
                        ]
                    }
                ],
