                        "glosses": [
                            "An organism that disperses something, such as seeds, in the environment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0acd25d3-ca22-4b0e-9b9c-0e87908361f6",
                                "sense_id": "136bdaf5-f59f-389f-895a-b00a2f801871",
                                "text": "Nesting data from dispersers and nondispersers came from the same set of colonies and were thus directly comparable."
                            },
                            {
                                "example_id": "5ba65807-a7d4-4275-8bd3-b15ac9c3ce72",
                                "sense_id": "136bdaf5-f59f-389f-895a-b00a2f801871",
                                "text": "Ants are integral components of terrestrial ecosystems, owing to their manifold interactions with other organisms. They serve as seed dispersers for plants (myrmecochory), mutualists with sap-sucking insects (trophobionts), and hosts for a wide range of associate organisms (myrmecophiles) and act as both predator and prey."
                            }
                        ]
