                "senses": [
                    {
                        "sense_id": "9a5d125b-4ea7-3088-ad39-072646b8adb5",
                        "entry_id": "f82b42d6-08a5-3fa5-9cff-7c14b62a8981",
                        "glosses": [
                            "ein Hilfsmittel zur Bewältigung von im Haushalt anfallenden Arbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66417e6-cb86-411a-b29a-73930b5905a4",
                                "sense_id": "9a5d125b-4ea7-3088-ad39-072646b8adb5",
                                "text": "„Smart-Speaker sollen eigentlich nur auf Zuruf Musik oder Podcasts spielen, im Internet suchen oder Hausgeräte steuern.“"
                            },
                            {
                                "example_id": "72224951-1f20-4eef-97e5-7850abefe7d5",
                                "sense_id": "9a5d125b-4ea7-3088-ad39-072646b8adb5",
                                "text": "„Das Wasser war voll von Trümmern und kroch schwarz und träge zwischen Balken und Hausgeräten umher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e35b610b-a65f-31d4-8ec6-be64833da467",
                        "entry_id": "f82b42d6-08a5-3fa5-9cff-7c14b62a8981",
                        "glosses": [
                            "Möbel und andere Dinge, die zu einem Haushalt gehören"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3d482a70-3b7b-40f0-80c2-fd658ffb0e71",
                                "sense_id": "e35b610b-a65f-31d4-8ec6-be64833da467",
                                "text": "„Das Wasser war voll von Trümmern und kroch schwarz und träge zwischen Balken und Hausgeräten umher.“"
                            },
                            {
                                "example_id": "90bfce69-d22e-4de1-ad97-98fcd2c6c06b",
                                "sense_id": "e35b610b-a65f-31d4-8ec6-be64833da467",
                                "text": "„Im nüchternen Morgenlicht kam ihm seine Wohnung, sein historisches Hausgerät, ja, seine eigene liebe Frau und die rotwangigen Kinder lange nicht mehr so herzerfreuend vor, wie bei dem nächtlichen Wiedersehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6d5927f-e6e2-4977-9dfb-89d72eb0b29d",
                        "source_entry_id": "f82b42d6-08a5-3fa5-9cff-7c14b62a8981",
                        "source_sense_id": "9a5d125b-4ea7-3088-ad39-072646b8adb5",
                        "source_sense_description": "ein Hilfsmittel zur Bewältigung von im Haushalt anfallenden Arbeiten",
                        "target_lang_word": "appareil ménager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appareil ménager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e176a65-db4e-3239-955f-fe11457d8efc",
                                        "entry_id": "4d07f8dc-edc3-34bb-b5e4-66e4b3775c8b",
                                        "glosses": [
                                            "Matériel utilisé pour préparer ou cuisiner des aliments ou pour l’entretien domestique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a87631-5e21-4a5f-9218-930aad52b3bf",
                                                "sense_id": "4e176a65-db4e-3239-955f-fe11457d8efc",
                                                "text": "Les femmes devraient, effectivement, pouvoir prendre en charge leur corps. Le connaître d’abord, puis le surveiller pour qu’il reste en forme. On entretient bien sa voiture ou ses appareils ménagers. Notre corps, c’est quand même ce qui nous permet d’exister !"
                                            },
                                            {
                                                "example_id": "8552a853-0de8-47dd-a5a3-82ef06261f76",
                                                "sense_id": "4e176a65-db4e-3239-955f-fe11457d8efc",
                                                "text": "Et quand je rentrai dans la maison, dans la cuisine éclairée comme en plein jour, avec ses appareils ménagers si utiles et rassurants, j'eus peur de la lumière."
                                            },
                                            {
                                                "example_id": "6d1fbc48-d550-4434-aeb0-d75db11027bb",
                                                "sense_id": "4e176a65-db4e-3239-955f-fe11457d8efc",
                                                "text": "Par contre, elle peut très bien pénétrer dans une maison en suivant un matériau conducteur d’électricité. Ne vous servez donc pas d’appareils ménagers pendant un orage et, autant que possible, ne touchez à aucun accessoire de plomberie. Il est également déconseillé de se servir du téléphone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
