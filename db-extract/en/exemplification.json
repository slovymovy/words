                    {
                        "translation_id": "22051ffd-be96-4c27-ad68-f0a003e1ffc6",
                        "source_entry_id": "91f433da-f910-3f7e-b1aa-680a2742e2d5",
                        "source_sense_description": "case in point; example",
                        "target_lang_word": "Exempel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exempel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a03ad354-59be-3325-b330-d11080561631",
                                        "entry_id": "fdd19db3-5f78-3c41-94a1-2fa92e61ef17",
                                        "glosses": [
                                            "lehrreiches Beispiel, das man als Vorbild nehmen kann"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a71f06a-746d-456e-943e-0a1b5ed4f9f8",
                                                "sense_id": "a03ad354-59be-3325-b330-d11080561631",
                                                "text": "Dabei ist es durchaus verlockend für die Politik, mit dem zu erwartenden Chaos in Griechenland, wie Bankenschließungen, Kapitalverkehrskontrollen und einem weiteren Einbruch der Wirtschaft ein Exempel zu statuieren."
                                            },
                                            {
                                                "example_id": "9e487a7d-b474-4ac5-b60c-1a45a8775957",
                                                "sense_id": "a03ad354-59be-3325-b330-d11080561631",
                                                "text": "„Dann wurden die Exempel begründet und die Anklagepunkte aufgezählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bfeeba4-0ff4-3d77-b0b6-cb0d3cff77cf",
                                        "entry_id": "fdd19db3-5f78-3c41-94a1-2fa92e61ef17",
                                        "glosses": [
                                            "Rechenaufgabe"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f912fe8-60ab-482a-bee4-d9ef944664a7",
                                                "sense_id": "1bfeeba4-0ff4-3d77-b0b6-cb0d3cff77cf",
                                                "text": "„Die ersten 25 Seiten bieten Exempel aus der einfachen und zusammengesetzten Regel-de-tri und der einfachen und zusammengesetzten Gesellschaftsrechnung, die nächsten 40 (bis Seite 65) solche aus der einfachen Procent- und aus der Zinsrechnung.“"
                                            },
                                            {
                                                "example_id": "c931e2be-d48e-4475-ad44-5dee7edb2159",
                                                "sense_id": "1bfeeba4-0ff4-3d77-b0b6-cb0d3cff77cf",
                                                "text": "Das Exempel wurde sowohl von der Addition wie von der Subtraction recht gerechnet."
                                            },
                                            {
                                                "example_id": "18619e49-768a-47a7-bbf5-adae6d985983",
                                                "sense_id": "1bfeeba4-0ff4-3d77-b0b6-cb0d3cff77cf",
                                                "text": "„Eine Rechnungsprobe ist, wenn man durch eine andere Rechnung untersucht, ob ein Exempel recht gerechnet worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
