                                        "examples": [
                                            {
                                                "example_id": "c42e59e6-fe82-4706-913c-0ab64a4a574e",
                                                "sense_id": "f166e720-c18d-37fe-97d5-17cb2cacfe98",
                                                "text": "consumerist society"
                                            },
                                            {
