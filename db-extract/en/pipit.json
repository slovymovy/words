                        "target_lang_word": "конёк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "конёк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d2368e00-e95f-35dd-8c3a-12caa05f144a",
                                        "entry_id": "ca65e916-bc2d-3c63-9395-63e97dbeb275",
                                        "glosses": [
                                            "разг. уменьш. к конь; маленький конь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aac73b08-65dc-4987-9c63-e5e0f97059cd",
                                                "sense_id": "d2368e00-e95f-35dd-8c3a-12caa05f144a",
                                                "text": "Тут конёк пред ним ложится; // На конька Иван садится, // Уши в загреби берёт, // Что есть мо́чушки ревёт."
                                            },
                                            {
                                                "example_id": "79510f34-dcea-4086-a414-d8ee247fa0b2",
                                                "sense_id": "d2368e00-e95f-35dd-8c3a-12caa05f144a",
                                                "text": "Как-то зашли во двор два парня в картузах, попросили позволения конька посмотреть, а если продадут, так и купить."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e51003f-17a8-316b-819d-2dfb98dcdc0e",
                                        "entry_id": "ca65e916-bc2d-3c63-9395-63e97dbeb275",
                                        "glosses": [
                                            "архит. резное украшение на конце центрального бруса крыши"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30dc785-ab89-4ef1-85d0-3b76417140d5",
                                                "sense_id": "6e51003f-17a8-316b-819d-2dfb98dcdc0e",
                                                "text": "Над каждой крышей высокий шест скворечницы; над каждым крылечком вырезной железный, крутогривый конёк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "187d8d70-4c91-362d-af85-19532c06ee85",
                                        "entry_id": "ca65e916-bc2d-3c63-9395-63e97dbeb275",
                                        "glosses": [
                                            "архит. часть конструкции двускатной крыши — брус, проходящий по гребню и соединяющий скаты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baac908c-1a0e-4781-8170-a08d7f2fb96f",
                                                "sense_id": "187d8d70-4c91-362d-af85-19532c06ee85",
                                                "text": "Зеленский отыскал в поставце и в печи кой-чего позавтракать; заложил накупленного корму коням и потом, запершись кругом, залез на сено под самый конёк кровли и заснул там сном богатырским."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea8929cd-6f3d-3e44-a5a6-f96e1d577bfb",
                                        "entry_id": "ca65e916-bc2d-3c63-9395-63e97dbeb275",
                                        "glosses": [
                                            "разг., ихтиол. то же, что морской конёк"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8ed5d7-fe8f-4975-8f12-31a3e2b0d637",
                                                "sense_id": "ea8929cd-6f3d-3e44-a5a6-f96e1d577bfb",
                                                "text": "В Японском море в российских водах живёт японский морской конёк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e055c28-7b17-3e1a-aa72-559dafe043eb",
                                        "entry_id": "ca65e916-bc2d-3c63-9395-63e97dbeb275",
                                        "glosses": [
                                            "перен. чья-либо любимая тема; излюбленный предмет обсуждения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e4e359b-f856-4df8-b4f9-861341508b0d",
                                                "sense_id": "4e055c28-7b17-3e1a-aa72-559dafe043eb",
                                                "text": "Какой нравственности нужно ещё, сверх вашей жизни, и последнее хрипение, с которым вы отдадите последний атом жизни, выслушивая утешения князя, который непременно дойдёт в своих христианских доказательствах до счастливой мысли, что, в сущности, оно даже и лучше, что вы умираете. (Такие, как он, христиане всегда доходят до этой идеи: это их любимый конёк)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9318769a-1a5c-3bfa-946c-588e5541e857",
                                        "entry_id": "ca65e916-bc2d-3c63-9395-63e97dbeb275",
                                        "glosses": [
                                            "перен. любимый предмет приложения усилий, занятие, которое кто-либо любит и хорошо умеет делать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f018f8c4-2544-4275-9a66-333c2dc21b4d",
                                                "sense_id": "9318769a-1a5c-3bfa-946c-588e5541e857",
                                                "text": "Этикет — её конёк. Что она жена князя — это её другой конёк. Катаясь на этих двух коньках, она вечно и ужасно пересаливает."
                                            },
                                            {
                                                "example_id": "c8363b99-7e90-44fa-b06f-7092d5ed7960",
                                                "sense_id": "9318769a-1a5c-3bfa-946c-588e5541e857",
                                                "text": "Конёк его был блестящие связи, которые он имел частию по родству моей матери, частию по своим товарищам молодости, на которых он в душе сердился за то, что они далеко ушли в чинах, а он навсегда остался отставным поручиком гвардии."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "конёк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "716ff215-c0a0-3c27-a623-209b824e9523",
                                        "entry_id": "2b1bed7b-c5cd-3ecf-9f2b-bb3bf01d5ede",
                                        "glosses": [
                                            "надеваемое на ногу приспособление с лезвиями для катания по льду"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81621652-2315-4d66-960c-ca9a9749b57b",
                                                "sense_id": "716ff215-c0a0-3c27-a623-209b824e9523",
                                                "text": "Мне так хочется посмотреть, как вы катаетесь. Надевайте же коньки, и давайте кататься вместе."
                                            },
                                            {
                                                "example_id": "ee4873f3-bb0b-434f-af47-b3a13ba48a49",
                                                "sense_id": "716ff215-c0a0-3c27-a623-209b824e9523",
                                                "text": "Выбрали широкую часть реки между рынком и архиерейским двором, огородили её канатом, ёлками и флагами и соорудили всё, что нужно для катанья на коньках, на санях и с гор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372d2867-38c3-3913-b342-6f2838294e33",
                                        "entry_id": "2b1bed7b-c5cd-3ecf-9f2b-bb3bf01d5ede",
                                        "glosses": [
                                            "то же, что роликовые коньки; подобное конькам [1] приспособление с колёсиками для катания по твёрдому ровному покрытию (например, по асфальту)"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe2c87b-fcce-40fe-bdb5-aa1cbb86bd76",
                                                "sense_id": "372d2867-38c3-3913-b342-6f2838294e33",
                                                "text": "По грунту эти коньки несутся едва ли не столь же легко, как и по асфальту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96436ccc-ec83-3ba0-b781-c3ec6283f9ce",
                                        "entry_id": "2b1bed7b-c5cd-3ecf-9f2b-bb3bf01d5ede",
                                        "glosses": [
                                            "мн. ч., разг. вид спорта, связанный с катанием на коньках [1] или [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d045d46a-8672-463f-adff-9e1640c3eab5",
                                                "sense_id": "96436ccc-ec83-3ba0-b781-c3ec6283f9ce",
                                                "text": "Заниматься коньками."
                                            },
                                            {
                                                "example_id": "295506a8-f68d-428f-9091-8435ebbcaefd",
                                                "sense_id": "96436ccc-ec83-3ba0-b781-c3ec6283f9ce",
                                                "text": "В коньках россияне получили золотую медаль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b3e446b-1170-343c-b255-92e7a2066b69",
                                        "entry_id": "2b1bed7b-c5cd-3ecf-9f2b-bb3bf01d5ede",
                                        "glosses": [
                                            "разг., спорт. то же, что коньковый ход (в лыжах)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
