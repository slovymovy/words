                "senses": [
                    {
                        "sense_id": "ad6069aa-e137-3910-8a99-f8b7322e7a43",
                        "entry_id": "2b70d4d2-0b85-3f9b-a414-52af6d058b3a",
                        "glosses": [
                            "weibliche Person, die durch ihr Verhalten andere herausfordert; die absichtlich für Unfrieden sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf55128-ce43-4b98-b03a-1e4236237563",
                                "sense_id": "ad6069aa-e137-3910-8a99-f8b7322e7a43",
                                "text": "„Beim Verhör auf dem Morzinplatz bewog er sie, um ihr eigenes und, wie sie meinte, auch sein Leben zu retten, auf den Antrag der Gestapo einzugehen, künftighin für die Gestapo als Provokateurin zu arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35efd440-341a-4a51-8fd9-efa57655afcc",
                        "source_entry_id": "2b70d4d2-0b85-3f9b-a414-52af6d058b3a",
                        "source_sense_id": "ad6069aa-e137-3910-8a99-f8b7322e7a43",
                        "source_sense_description": "weibliche Person, die durch ihr Verhalten andere herausfordert; die absichtlich für Unfrieden sorgt",
