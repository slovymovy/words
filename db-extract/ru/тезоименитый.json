                "senses": [
                    {
                        "sense_id": "8196b31e-5ac4-399d-84dc-3859ce391b8e",
                        "entry_id": "4534e33d-f9f4-390b-b66b-37284423cae7",
                        "glosses": [
                            "устар. имеющий одинаковое с кем-либо имя, являющийся тёзкой кому-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4198ba7-fe50-4974-bcf2-401762b69369",
                                "sense_id": "8196b31e-5ac4-399d-84dc-3859ce391b8e",
                                "text": "Первою заботою о новорожденном младенце со стороны родителей было снять с него «меру долготы и широты», и в эту меру заказать икону тезоименитого его ангела."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c21b491a-b46d-4f3d-a7c2-6e7b19c410cc",
                        "source_entry_id": "4534e33d-f9f4-390b-b66b-37284423cae7",
                        "source_sense_id": "8196b31e-5ac4-399d-84dc-3859ce391b8e",
                        "target_lang_word": "namesake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "namesake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "961e8c6e-fdf3-31eb-887b-1973425678c7",
                                        "entry_id": "310fc92f-65c1-3b4b-ba30-7a31b6e3af36",
                                        "glosses": [
                                            "An entity that lends its name to another entity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84cf7b23-b713-3017-9b8c-225801ed80f4",
                                        "entry_id": "310fc92f-65c1-3b4b-ba30-7a31b6e3af36",
                                        "glosses": [
                                            "An entity that lends its name to another entity.",
                                            "A person with the same name as another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a970ca-3471-41f0-b374-0bb39b3bb7bd",
                                                "sense_id": "84cf7b23-b713-3017-9b8c-225801ed80f4",
                                                "text": "The statesman Winston Churchill has a namesake, the American novelist Winston Churchill."
                                            },
                                            {
                                                "example_id": "69b48d84-04fc-4583-90d4-867e6c6ffa1c",
                                                "sense_id": "84cf7b23-b713-3017-9b8c-225801ed80f4",
                                                "text": "Chris Evans, British DJ and media manipulator extraordinaire, is not to be confused with Chris Evans, Australia's shadow minister for family services, nor with Chris Evans, the late train robber of the wilds of west California, or indeed potentially hundreds of other namesakes. One unquestionable aspect of this Chris Evans is that he is unique."
                                            },
                                            {
                                                "example_id": "e17e725a-7d8f-4f2e-9f81-eaefacef5bbc",
                                                "sense_id": "84cf7b23-b713-3017-9b8c-225801ed80f4",
                                                "text": "Look at our namesakes too. There's Tom, of course - a bit creepy now but he definitely had his moments. There's Davy Jones out of the Monkees. Led Zeppelin's John Paul Jones preferred Jones to his birth name Baldwin. And he's quite cool. There's an American brokerage firm called Edward Jones which perhaps isn't so cool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f3b957-8e8c-334b-898b-138abfa76cb6",
                                        "entry_id": "310fc92f-65c1-3b4b-ba30-7a31b6e3af36",
                                        "glosses": [
                                            "An entity that lends its name to another entity.",
                                            "A person with the same name as another.",
                                            "One who is named after another, often a child named after the parent or an ancestor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d70572f3-3450-44dc-b924-6d6e194d2e2b",
                                                "sense_id": "d6f3b957-8e8c-334b-898b-138abfa76cb6",
                                                "text": "Bill Sr's namesake, Bill Jr, is 30 years younger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f82237d-cdae-3947-8277-153064ef4ecc",
                                        "entry_id": "310fc92f-65c1-3b4b-ba30-7a31b6e3af36",
                                        "glosses": [
                                            "An entity that lends its name to another entity.",
                                            "A person with the same name as another.",
                                            "One for whom another is named, often the parent or ancestor who gave the name to a child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5508ddc3-43c9-4d41-8253-4dd0b85591d5",
                                                "sense_id": "1f82237d-cdae-3947-8277-153064ef4ecc",
                                                "text": "Bill Jr's namesake, Bill Sr, is 30 years older."
                                            },
                                            {
                                                "example_id": "70794613-5fbb-42d6-9d5b-4fd974a37f42",
                                                "sense_id": "1f82237d-cdae-3947-8277-153064ef4ecc",
                                                "text": "It is the only citation from 1902, and was clearly added to the manuscript at a late stage, being only one of two examples of the dictionary’s namesake actually discovered by Crooke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77fd61b6-9795-3e43-82d8-4b49e93f3d28",
                                        "entry_id": "310fc92f-65c1-3b4b-ba30-7a31b6e3af36",
                                        "glosses": [
                                            "Something (especially a ship, a building, or a medical condition, symptom, or sign) that is named after someone or something."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
