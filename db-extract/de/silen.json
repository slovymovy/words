                "senses": [
                    {
                        "sense_id": "91f9e900-a950-3771-9a12-a4599ae85ab5",
                        "entry_id": "c962cd2e-6c29-3af9-a1ed-f9d394b1209b",
                        "glosses": [
                            "dickbäuchiger, glatzköpfiger und stupsnasiger Dämon mit tierischen Körperteilen im Gefolge des Dionysos"
                        ],
                        "tags": [
                            "griechische"
                        ],
                        "examples": [
                            {
                                "example_id": "c1eeeeb6-78e9-4052-97ed-7e321695adbd",
                                "sense_id": "91f9e900-a950-3771-9a12-a4599ae85ab5",
                                "text": "König Midas befragte Silen über das menschliche Schicksal (Herodot 8, 138, 3), brachte ihn dann zu Dionysos zurück und hatte dafür einen Wunsch frei (* Midas)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c44ad008-24c8-3086-8d00-5950f9101016",
                        "entry_id": "c962cd2e-6c29-3af9-a1ed-f9d394b1209b",
                        "glosses": [
                            "Erzieher des Dionysos"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "20475541-d34c-44b5-ae3d-929d9c46b68f",
                                "sense_id": "c44ad008-24c8-3086-8d00-5950f9101016",
                                "text": "Der Silen selbst, von welchem diese Sagen berichten, wird bald in Nysa geboren bald der erste König von Nysa genannt, auch der Pflegevater und Erzieher des Dionysos, den er zu allerlei Kunst und Wissenschaft und den Erfindungen des Weinbaus und der Bienenzucht angeleitet habe, wie er ihm nachmals immer als treuer Freund gesellt geblieben sei."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba480806-47b1-46b8-8793-e6eeeeef9240",
