                    "frequency": "High",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She drew a small red <w>heart</w> at the bottom of the letter.",
                            "target_lang_translations": {
                                "ru": "Она нарисовала маленькое красное <w>сердечко</w> внизу письма."
                            }
                        },
                        {
                            "text": "The Valentine's Day card was covered in glittery <w>hearts</w>.",
                            "target_lang_translations": {
                                "ru": "Открытка ко Дню святого Валентина была покрыта блестящими <w>сердечками</w>."
                            }
