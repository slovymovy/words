                "entry_id": "fc784fab-d14c-30a5-a352-376319940bce",
                "word": "manganese",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "51b5b9b4-1e52-4877-92e7-3938f3ebc3dc",
