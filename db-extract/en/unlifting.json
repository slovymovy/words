                        "glosses": [
                            "That does not lift or abate."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6283ce57-2287-4da0-894b-53825fd59bc1",
                                "sense_id": "f6a2f41c-9ded-3b5f-a14d-160267e05a4d",
                                "text": "Do you know what pain treads the unlifting darkness with cleft hooves, with webbed feet?"
                            },
                            {
                                "example_id": "44b81750-79bd-481a-b660-0a3f6e51c1ab",
                                "sense_id": "f6a2f41c-9ded-3b5f-a14d-160267e05a4d",
                                "text": "For Faulkner, these years marry professional triumphs and personal disappointments: the Nobel Prize for Literature and an increasingly unlifting depression. For Joan, these years were a tempest of youth and a burgeoning literary career."
                            },
                            {
                                "example_id": "10394edc-d25a-4810-b556-cfdc63eb5248",
                                "sense_id": "f6a2f41c-9ded-3b5f-a14d-160267e05a4d",
                                "text": "There had been no collieries on this side of the line, and now that the murky atmosphere, which had been an unlifting blight upon the midland plain, was gone for ever, the fields showed as fairly as though no pollution had ever touched them."
                            }
                        ]
                    }
