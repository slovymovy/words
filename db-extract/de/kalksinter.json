                        "glosses": [
                            "Sinterablagerungen von Kalk an kalkhaltigen Quellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9102d68d-68e1-4980-9338-ebb0a8a1a512",
                                "sense_id": "b166b06d-644f-36be-ad02-c2e43ec51fa6",
                                "text": "„Alabaster, feinkörnige, durchscheinende Art des Gipses, meist von schneeweißer Farbe, benannt nach der Stadt Alabastron in Oberägypten; wird wie der Kalk-A., ein durchscheinender Kalksinter, zu Skulpturarbeiten benutzt.“"
                            },
                            {
                                "example_id": "8d7f9780-e11c-46a6-ba3d-360f7b8d2bbc",
                                "sense_id": "b166b06d-644f-36be-ad02-c2e43ec51fa6",
                                "text": "„An einer Gefällstufe bildete sich nun durch die Verwirbelung des Wassers eine luftige Kalkstruktur, die man Travertin oder Kalksinter nennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
