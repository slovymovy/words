                        "glosses": [
                            "Berceau suspendu, lit destiné à bercer un enfant."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6fac5c1f-2898-40bd-90f9-3c464a4ae094",
                                "sense_id": "57a4664f-9fb5-371e-ac19-0fa6a89e5061",
                                "text": "Marcelle prépare, la layette de l'enfant qui va compléter la famille. Sa barcelonnette est déjà à sa place, près de l'alcôve, avec ses rideaux de soie verte, sa courtepointe piquée, son petit oreiller bordé de dentelles."
                            },
                            {
                                "example_id": "b7191aa8-7db6-4f6e-9a31-d125acb07f4f",
                                "sense_id": "57a4664f-9fb5-371e-ac19-0fa6a89e5061",
                                "text": "Je gagerais mon salut éternel, que Modeste est pure comme elle l’était dans sa barcelonette, dit madame Dumay."
                            }
                        ]
                    }
