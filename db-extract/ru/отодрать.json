                        ],
                        "examples": [
                            {
                                "example_id": "feded43a-1f27-406e-a71b-a93cd34113a7",
                                "sense_id": "23c317de-6ef6-3126-b72a-4d1837f3ce08",
                                "text": "отодра́ть кого́-либо за у́ши",
                                "translation": "to pull someone's ears",
                                "english": "to pull someone's ears"
                            },
                            {
                                "example_id": "4c384558-6185-40c8-b6fc-a953d72539ee",
                                "sense_id": "23c317de-6ef6-3126-b72a-4d1837f3ce08",
                                "text": "Тут и другие придворные, видя, что левши дело выгорело, начали его целовать, а Платов ему сто рублей дал и говорит:\n— Прости меня, братец, что я тебя за волосья отодрал.",
                                "translation": "Here the other courtiers, seeing that Lefty’s case had come off well, began to kiss him, and Platov gave him a hundred roubles and said:\n“Forgive me, brother, for yanking your hair.”",
                                "english": "Here the other courtiers, seeing that Lefty’s case had come off well, began to kiss him, and Platov gave him a hundred roubles and said:\n“Forgive me, brother, for yanking your hair.”"
                            }
                        ]
