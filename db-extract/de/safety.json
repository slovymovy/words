                ],
                "senses": [
                    {
                        "sense_id": "0b286eda-6bc1-3485-82ef-fd4e60977099",
                        "entry_id": "2ada618d-d515-317e-b7a2-11a902ad53e2",
                        "glosses": [
                            "Spieler in der Verteidigung, der sich frei hinter der Defensive Line im Defensive Back bewegt"
                        ],
                        "tags": [
                            "American Football",
                            "Canadian Football"
                        ],
                        "examples": [
                            {
                                "example_id": "0b8df9b5-2b0a-4cbd-8ada-8783abc0b8d3",
                                "sense_id": "0b286eda-6bc1-3485-82ef-fd4e60977099",
                                "text": "„Der Safety spielte zuletzt bei den Chiefs eine hervorragende Saison und brachte es insgesamt auf 77 Tackles und vier Interceptions - einschließlich vier Touchdown-Returns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe5cae70-a205-3aaa-823f-938562796bba",
                        "entry_id": "2ada618d-d515-317e-b7a2-11a902ad53e2",
                        "glosses": [
                            "Situation, bei der der ballführende Spieler der angreifenden Mannschaft in der eigenen Endzone zu Boden gebracht oder ein Foul der angreifenden Mannschaft in der eigenen Endzone begangen wird, was zu einem Punktgewinn für die Verteidiger führt"
                        ],
                        "tags": [
                            "American Football",
                            "Canadian Football"
                        ],
                        "examples": [
                            {
                                "example_id": "112ea2c6-d104-491d-a12f-d2ca947b8169",
                                "sense_id": "fe5cae70-a205-3aaa-823f-938562796bba",
                                "text": "„Erst ein Safety durch einen geblockten Punkt und anschließend zwei Field Goals brachten sie mit 15:10 in Führung.“"
                            },
                            {
                                "example_id": "283293fc-97d0-4076-92d3-d44719e7f5a8",
                                "sense_id": "fe5cae70-a205-3aaa-823f-938562796bba",
                                "text": "„Im darauffolgenden Drive schaffte es Miami und Quarterback Ryan Tannehill nicht, sich aus ihrer misslichen Lage zu befreien und kassierten einen Safety.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "514e698f-9f23-4925-871c-7ca09739a9ad",
                        "source_entry_id": "2ada618d-d515-317e-b7a2-11a902ad53e2",
                        "source_sense_id": "0b286eda-6bc1-3485-82ef-fd4e60977099",
                        "target_lang_word": "safety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "safety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d9932a-c412-3360-bce1-f0da046f0b6f",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "The condition or feeling of being safe; security; certainty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9869a51-1ffb-498a-9f2e-a772966af25c",
                                                "sense_id": "a0d9932a-c412-3360-bce1-f0da046f0b6f",
                                                "text": "If you push it to the limit, safety is not guaranteed."
                                            },
                                            {
                                                "example_id": "f9b15937-cded-4dfd-9da5-b5807cdb22db",
                                                "sense_id": "a0d9932a-c412-3360-bce1-f0da046f0b6f",
                                                "text": "He managed to reach the border and escape to safety."
                                            },
                                            {
                                                "example_id": "26166aa4-103f-4bd5-950d-8bdf1452f912",
                                                "sense_id": "a0d9932a-c412-3360-bce1-f0da046f0b6f",
                                                "text": "Oh, oh! “Go to safety”! Why didn’t I think of that⁉ Here I am in danger when, really, I could simply be going to safety! I shouldn’t have wasted your time by calling in the first place!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15a87314-9e0b-3683-b266-291dc6ce2ae0",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "A safety lock or safety catch: a mechanism on a weapon or dangerous equipment designed to prevent accidental firing or operation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb296ae8-99cb-4ad7-b133-9c35dbc22bb6",
                                                "sense_id": "15a87314-9e0b-3683-b266-291dc6ce2ae0",
                                                "text": "Be sure that the safety is set before proceeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55ea681-7680-3ceb-bd29-c89586e4fb37",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "Preservation from escape; close custody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ea0569e-2691-499a-bb91-e384eb74458c",
                                                "sense_id": "f55ea681-7680-3ceb-bd29-c89586e4fb37",
                                                "text": "[…] imprison him, […] / Deliver him to safety; and return,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e72e3d8-259c-38c0-8584-6423e1a040a8",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "An instance of a player being sacked or tackled in the end zone, or stepping out of the end zone and off the field, resulting in two points to the opposite team."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b5fa4e4-8046-4d43-a30c-340e389fb477",
                                                "sense_id": "6e72e3d8-259c-38c0-8584-6423e1a040a8",
                                                "text": "He sacked the quarterback in the end zone for a safety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ca76d7-f7f4-39be-91d0-9a2f89f4f9ee",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "Any of the defensive players who are in position furthest from the line of scrimmage and whose responsibility is to defend against passes as well as to be the tacklers of last resort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6358bd-3578-4895-bba2-cba749afac02",
                                                "sense_id": "79ca76d7-f7f4-39be-91d0-9a2f89f4f9ee",
                                                "text": "The free safety made a game-saving tackle on the runner who had broken past the linebackers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c4aace-c669-33ea-96b9-04c92a0589ec",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "A safety squeeze."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a5dd1a-26bf-4976-b678-531f2fc162e6",
                                                "sense_id": "57c4aace-c669-33ea-96b9-04c92a0589ec",
                                                "text": "Boy wondered about that bunt. He had a notion Fowler would commit himself soon because time was on the go. But Fowler didn’t, making it another sweep of three Pirates. He had thus far given up only two safeties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b38f92cc-0919-3f91-93d9-d0b8a239ba8e",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "A safety shot or sequence of such shots."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e980a2e9-a3d3-47ee-894b-e840bfe14c8e",
                                                "sense_id": "b38f92cc-0919-3f91-93d9-d0b8a239ba8e",
                                                "text": "That was a poor safety from Higgins."
                                            },
                                            {
                                                "example_id": "2d1c1b5c-7831-44fd-b01a-1673de271844",
                                                "sense_id": "b38f92cc-0919-3f91-93d9-d0b8a239ba8e",
                                                "text": "After thirty minutes of safety, Selby finally potted a red, to ironic cheers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fa4f2c-00b0-3595-a895-480e13027adb",
                                        "entry_id": "d08efa2d-5bf1-3ed0-8741-4fc4cab3e373",
                                        "glosses": [
                                            "A safety bicycle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1c9de54-7c81-403e-a5c5-feffb56c4986",
                                                "sense_id": "61fa4f2c-00b0-3595-a895-480e13027adb",
                                                "text": "Many wheelmen and wheelwomen, riding safeties, tandems and tricycles, stopped there during the evening and we had good opportunity for comparing American and English bicycles […]"
                                            },
                                            {
                                                "example_id": "01f331a4-660c-4e29-b4a2-4666fc5e5719",
                                                "sense_id": "61fa4f2c-00b0-3595-a895-480e13027adb",
                                                "text": "There are cyclists, like Mr. F. T. Bidlake, who prefer a tricycle to a safety, and to such men a long ride on a tricycle is no more fatiguing than a safety bicycle ride of the same distance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "safety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5ba0198-d139-3cd6-9b8e-7409568d0829",
                                        "entry_id": "81df2a1c-f634-3790-b1c4-a01a8de7cba1",
                                        "glosses": [
                                            "To secure (a mechanical component, as in aviation) to keep it from becoming detached even under vibration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4a10311-01f6-38ce-8786-f74f8cf9b711",
                                        "entry_id": "81df2a1c-f634-3790-b1c4-a01a8de7cba1",
                                        "glosses": [
                                            "to secure a firing pin, as in guns, to keep the gun from firing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dc6a5f-b828-4ed1-8e4b-e590a63b6a86",
                                                "sense_id": "e4a10311-01f6-38ce-8786-f74f8cf9b711",
                                                "text": "Time went back to normal for him; he safetied his own weapon and dropped it, jumping forward."
                                            },
                                            {
                                                "example_id": "022b9653-fd74-4f47-a34f-369c09660fe0",
                                                "sense_id": "e4a10311-01f6-38ce-8786-f74f8cf9b711",
                                                "text": "Osborne lay propped up on one elbow, his pistol cocked, his aim wavering in the general direction the man had gone. Finally he safetied it, stuffed it in the holster on his right hip, and reached for his cell phone in his jacket pocket. But it was gone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
