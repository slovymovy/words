                        "entry_id": "22737623-ccbc-35d0-83d1-119a27ab4cca",
                        "glosses": [
                            "Pertaining to a group of individuals, possibly geographically separated from each other, that form temporary or recurring project teams."
                        ],
                        "tags": [
                            "neologism",
                            "not-comparable"
                        ],
                        "examples": [
                            {
