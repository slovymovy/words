                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7b1569-1141-449b-bdec-a5a538e2cbb8",
                                                "sense_id": "f6b3f903-cddb-3733-968a-b232af0431f2",
                                                "text": "With its pumped-up colors, a focus on everyday lives made heroic and its status as an essentially public artwork, “Departures” strongly suggests a new twist on the Los Angeles muralism of the 1970s, a movement born from the Chicano civil rights movement when Mexican-American artists like Judy Baca, David Rivas Botello and Willie Herrón adapted the Mexican muralist tradition for their own time."
                                            }
                                        ]
