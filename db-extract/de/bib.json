                                    },
                                    {
                                        "sense_id": "9b259dfc-2219-3233-9005-6a9c7829e895",
                                        "entry_id": "c9169fb6-4aad-340e-bc2c-f3e69acbc280",
                                        "glosses": [
                                            "Bibliothèque."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c35b589c-8af4-4804-8d82-445e217086f9",
                                                "sense_id": "9b259dfc-2219-3233-9005-6a9c7829e895",
                                                "text": "Pour ne rien vous cacher, mon bon ami, c’est là, c’était du moins, le registre de prêt des documents précieux de la bibli."
                                            },
                                            {
                                                "example_id": "f032fd85-1b31-4be2-ab39-e12f2b94f654",
                                                "sense_id": "9b259dfc-2219-3233-9005-6a9c7829e895",
                                                "text": "Ils allaient à la bibli ensemble, ils faisaient la teuf ensemble, ils baisouillaient un peu tous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
