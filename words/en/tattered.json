{
    "word_family": [
        "tatter",
        "tatters",
        "tatterdemalion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "15aded6d-c922-3e75-bc1c-91fa6b963f01",
                    "sense_definition": "Torn into shreds or hanging in rags; old and badly worn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worn_ragged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found an old box in the attic containing a <w>tattered</w> notebook.",
                            "target_lang_translations": {
                                "es": "Encontró una caja vieja en el ático que contenía un cuaderno <w>raído</w>.",
                                "nl": "Hij vond op zolder een oude doos met daarin een <w>beduimeld</w> notitieboekje."
                            }
                        },
                        {
                            "text": "The pirate ship sailed into the harbor with <w>tattered</w> sails fluttering in the wind.",
                            "target_lang_translations": {
                                "es": "El barco pirata entró al puerto con velas <w>hechas jirones</w> ondeando al viento.",
                                "nl": "Het piratenschip voer de haven binnen terwijl <w>aan flarden gescheurde</w> zeilen wapperden in de wind."
                            }
                        }
                    ],
                    "synonyms": [
                        "ragged",
                        "raggedy",
                        "worn-out",
                        "shabby"
                    ],
                    "antonyms": [
                        "pristine",
                        "neat"
                    ],
                    "common_phrases": [
                        "tattered clothes",
                        "tattered flag"
                    ],
                    "target_lang_definitions": {
                        "es": "Hecho trizas o hecho jirones; viejo y sumamente desgastado por el uso.",
                        "nl": "In flarden gescheurd of rafelig; oud en zwaar versleten."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desgarrado",
                                "target_lang_sense_clarification": "roto en pedazos o con rasgaduras"
                            },
                            {
                                "target_lang_word": "hecho jirones",
                                "target_lang_sense_clarification": "muy rasgado o roto"
                            },
                            {
                                "target_lang_word": "raído",
                                "target_lang_sense_clarification": "muy gastado por el uso"
                            },
                            {
                                "target_lang_word": "harrapiento",
                                "target_lang_sense_clarification": "dicho de ropa o telas, llena de harapos"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "rafelig",
                                "target_lang_sense_clarification": "met losse draden of rafels"
                            },
                            {
                                "target_lang_word": "versleten",
                                "target_lang_sense_clarification": "oud en door gebruik beschadigd"
                            },
                            {
                                "target_lang_word": "haveloos",
                                "target_lang_sense_clarification": "in slechte of gescheurde staat"
                            },
                            {
                                "target_lang_word": "aan flarden",
                                "target_lang_sense_clarification": "in stukken of stroken gescheurd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d97ba671-58e6-3b5e-ac08-d3279be65d53",
                    "sense_definition": "Wearing ragged, torn, or badly worn clothes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "worn_ragged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>tattered</w> traveler stood outside in the cold asking for shelter.",
                            "target_lang_translations": {
                                "es": "Un viajero <w>harapiento</w> estaba afuera en el frío pidiendo cobijo.",
                                "nl": "Een <w>haveloze</w> reiziger stond buiten in de kou en vroeg om onderdak."
                            }
                        },
                        {
                            "text": "The painter depicted <w>tattered</w> children playing among the ruins.",
                            "target_lang_translations": {
                                "es": "El pintor retrató a niños <w>andrajosos</w> jugando entre las ruinas.",
                                "nl": "De schilder beeldde <w>in lompen gehulde</w> kinderen af die tussen de ruïnes speelden."
                            }
                        }
                    ],
                    "synonyms": [
                        "ragged",
                        "shabby",
                        "bedraggled"
                    ],
                    "antonyms": [
                        "well-dressed"
                    ],
                    "target_lang_definitions": {
                        "es": "Que viste ropa rota, vieja o hecha harapos.",
                        "nl": "Gekleed in versleten, gescheurde kleren of vodden."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "harapiento",
                                "target_lang_sense_clarification": "cubierto de harapos"
                            },
                            {
                                "target_lang_word": "andrajoso",
                                "target_lang_sense_clarification": "con ropa rota y descuidada"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "haveloos",
                                "target_lang_sense_clarification": "armoedig en in versleten kleding"
                            },
                            {
                                "target_lang_word": "armoedig gekleed",
                                "target_lang_sense_clarification": "in lompen of oude kleren gestoken"
                            },
                            {
                                "target_lang_word": "in lompen gehuld",
                                "target_lang_sense_clarification": "in gescheurde vodden gekleed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87acfd54-8da3-3a54-a2d0-53df06f15fc2",
                    "sense_definition": "Dilapidated, decaying, or broken down; showing gaps and damage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fence was so <w>tattered</w> that stray animals easily wandered through.",
                            "target_lang_translations": {
                                "es": "La cerca estaba tan <w>deteriorada</w> que los animales callejeros pasaban fácilmente a través de ella.",
                                "nl": "Het hek was zo <w>bouwvallig</w> dat zwerfdieren er gemakkelijk doorheen liepen."
                            }
                        },
                        {
                            "text": "After months of scandal, the minister tried to rebuild his <w>tattered</w> reputation.",
                            "target_lang_translations": {
                                "es": "Tras meses de escándalo, el ministro intentó reconstruir su <w>maltrecha</w> reputación.",
                                "nl": "Na maanden van schandalen probeerde de minister zijn <w>gehavende</w> reputatie weer op te bouwen."
                            }
                        }
                    ],
                    "synonyms": [
                        "dilapidated",
                        "ramshackle",
                        "run-down"
                    ],
                    "common_phrases": [
                        "tattered reputation"
                    ],
                    "target_lang_definitions": {
                        "es": "Deteriorado, maltrecho o en decadencia; en mal estado o con daños evidentes.",
                        "nl": "Bouwvallig, vervallen of zwaar aangetast; zichtbaar beschadigd of gehavend."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "maltrecho",
                                "target_lang_sense_clarification": "en mal estado o dañado"
                            },
                            {
                                "target_lang_word": "deteriorado",
                                "target_lang_sense_clarification": "en estado de degradación o ruina"
                            },
                            {
                                "target_lang_word": "destartalado",
                                "target_lang_sense_clarification": "descompuesto o medio derruido"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gehavend",
                                "target_lang_sense_clarification": "zwaar beschadigd of aangetast"
                            },
                            {
                                "target_lang_word": "bouwvallig",
                                "target_lang_sense_clarification": "in vervallen staat van onderhoud"
                            },
                            {
                                "target_lang_word": "aangetast",
                                "target_lang_sense_clarification": "figuurlijk beschadigd, zoals een reputatie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeca9399-116d-3b37-a409-c1e103841f28",
                    "sense_definition": "simple past and past participle of <w>tatter</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fierce ocean winds had <w>tattered</w> the canvas awning during the night.",
                            "target_lang_translations": {
                                "es": "Los feroces vientos del océano habían <w>hecho jirones</w> el toldo de lona durante la noche.",
                                "nl": "Wilde zeewinden hadden de canvas luifel gedurende de nacht <w>aan flarden gescheurd</w>."
                            }
                        },
                        {
                            "text": "The dog grabbed the paper and <w>tattered</w> it into countless little pieces.",
                            "target_lang_translations": {
                                "es": "El perro agarró el papel y lo <w>desgarró</w> en incontables pedacitos.",
                                "nl": "De hond greep het papier en <w>verscheurde</w> het in talloze kleine stukjes."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio de tatter; romper o desgarrar en jirones o tiras.",
                        "nl": "Verleden tijd en voltooid deelwoord van tatter; aan flarden scheuren of doen rafelen."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hacer jirones",
                                "target_lang_sense_clarification": "desgarrar completamente"
                            },
                            {
                                "target_lang_word": "desgarrar",
                                "target_lang_sense_clarification": "romper en pedazos o tiras"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "aan flarden gescheurd",
                                "target_lang_sense_clarification": "in stukken gescheurd"
                            },
                            {
                                "target_lang_word": "verscheurd",
                                "target_lang_sense_clarification": "kapotgetrokken of verscheurd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}