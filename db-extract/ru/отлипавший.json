                        "sense_id": "40be107e-d315-3c1e-9cd5-4aff127b9678",
                        "entry_id": "a5a4b30c-8c1a-3b9a-ba7e-6fcacf1db50e",
                        "glosses": [
                            "перен., разг. отходивший, удалявшийся"
