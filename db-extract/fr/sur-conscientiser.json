                "senses": [
                    {
                        "sense_id": "9ab0147f-ab6e-3dee-a95a-5e9720e5707e",
                        "entry_id": "5fbf8c71-a669-3272-8bd3-4bf8a2a65e24",
                        "glosses": [
                            "Donner un caractère surconscient à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93869a6e-3204-4626-9353-d65134f7fd2d",
                                "sense_id": "9ab0147f-ab6e-3dee-a95a-5e9720e5707e",
                                "text": "Le film conte l’histoire d’une institutrice, dont un élève possède, à cinq ans, un don pour la poésie. Et se veut surtout, lui-même, film poétique, à travers ses plans minimalistes à la limite du dispositif d’art contemporain, ses travellings très appuyés et sa manière de sur-conscientiser la présence de la caméra."
                            },
                            {
                                "example_id": "4fde6a38-71ec-4102-9075-782c1818a556",
                                "sense_id": "9ab0147f-ab6e-3dee-a95a-5e9720e5707e",
                                "text": "Nous sommes juste barges et finalement inconscientes de la réalité à force de sur-conscientiser cette réalité, précisément, et de ne pas laisser ses chances à la vie de nous surprendre positivement."
                            }
                        ]
                    }
