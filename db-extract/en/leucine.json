                ],
                "senses": [
                    {
                        "sense_id": "45d386de-03a7-3dbd-a4b9-895eeaf99ae7",
                        "entry_id": "fc618f09-25c3-3894-ab1e-f00f93108691",
                        "glosses": [
                            "An essential amino acid, C₆H₁₃NO₂, isomeric with isoleucine, found in most animal proteins; it is essential for growth in children."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6ff7a96-d479-4121-83e7-02821b00819d",
                                "sense_id": "45d386de-03a7-3dbd-a4b9-895eeaf99ae7",
                                "text": "Thus, leucine is already being seen as a pharmaconutrient of great relevance for the supplementary feeding of malnourished and frail elderly and for specific subpopulations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e4c2eb-7369-4635-a4e9-f1c752adb8a9",
