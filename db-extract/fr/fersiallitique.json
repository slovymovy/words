                "senses": [
                    {
                        "sense_id": "4bc91a9c-280b-31e6-b266-d9a7ef015eaf",
                        "entry_id": "6b4e773f-9233-39ff-81dc-08fbda2ffece",
                        "glosses": [
                            "Qualifie un sol ou un horizon de nuance rouge, résultat d'une association stable entre de l'argile sous forme colloïdale et des oxydes de fer ; qualifie également le processus de formation d’un tel sol ou horizon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70b44f87-c1de-4dd8-a89f-58b9097d200d",
                                "sense_id": "4bc91a9c-280b-31e6-b266-d9a7ef015eaf",
                                "text": "Ils peuvent être alors rattachés aux fersialsols (sols fersiallitiques appelés aussi sols rouges méditerranéens)."
                            },
                            {
                                "example_id": "d2d1b882-709d-4eb0-b5c6-71b49162b04f",
                                "sense_id": "4bc91a9c-280b-31e6-b266-d9a7ef015eaf",
                                "text": "Le lessivage de l'argile intervient donc de façon presque constante : la présence de l'horizon B est un des caractères qui distingue le sol rouge fersiallitique du sol marron."
                            },
                            {
                                "example_id": "02269650-657e-4a4c-a820-5013b6c6bebc",
                                "sense_id": "4bc91a9c-280b-31e6-b266-d9a7ef015eaf",
                                "text": "L’altération fersiallitique confère aux horizons FS des constituants qui sont toujours de même nature, mais qui peuvent se trouver en proportions variables selon les roches dont sont issus les fersialsols."
                            }
                        ]
                    }
