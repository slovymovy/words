{
    "word_family": [
        "final",
        "finalize",
        "finality",
        "finalist",
        "finale"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "15585502-d934-3723-843e-72858195c54a",
                    "sense_definition": "After a long time, typically involving difficulty or delay.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train <w>finally</w> arrived at the station two hours late.",
                            "target_lang_translations": {
                                "ru": "Поезд <w>наконец</w> прибыл на станцию с двухчасовым опозданием.",
                                "zh": "火车<w>终于</w>晚点两个小时到达了车站。"
                            }
                        },
                        {
                            "text": "After months of searching, she <w>finally</w> found the perfect dress.",
                            "target_lang_translations": {
                                "ru": "После месяцев поисков она <w>наконец</w> нашла идеальное платье.",
                                "zh": "经过几个月的寻找，她<w>终于</w>找到了那件完美的裙子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eventually",
                        "at last",
                        "in the end",
                        "at length"
                    ],
                    "antonyms": [
                        "initially"
                    ],
                    "common_phrases": [
                        "finally arrived",
                        "finally happened",
                        "finally over",
                        "finally decided"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спустя долгое время, обычно после трудностей или задержек.",
                        "zh": "经过很长一段时间，通常指在经历困难或延迟之后。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наконец",
                                "target_lang_sense_clarification": "после долгого ожидания"
                            },
                            {
                                "target_lang_word": "в конце концов",
                                "target_lang_sense_clarification": "в итоге, после всего"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终于",
                                "target_lang_sense_clarification": "表示经过漫长等待或努力后达成"
                            },
                            {
                                "target_lang_word": "总算",
                                "target_lang_sense_clarification": "表示经过一番周折后达成，带有如释重负之意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                    "sense_definition": "Used to introduce the last item in a series of points, actions, or lists.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "First peel the potatoes, then boil them, and <w>finally</w> mash them with butter.",
                            "target_lang_translations": {
                                "ru": "Сначала почистите картофель, затем отварите его и, <w>наконец</w>, разомните с маслом.",
                                "zh": "先削掉土豆皮，然后煮熟，<w>最后</w>拌入黄油捣成泥。"
                            }
                        },
                        {
                            "text": "<w>Finally</w>, I would like to thank everyone for coming tonight.",
                            "target_lang_translations": {
                                "ru": "<w>В заключение</w> я хотел бы поблагодарить всех, кто пришел сегодня вечером.",
                                "zh": "<w>最后</w>，我想感谢今晚到场的每一位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lastly",
                        "last",
                        "in conclusion"
                    ],
                    "antonyms": [
                        "initially"
                    ],
                    "common_phrases": [
                        "and finally",
                        "finally I would like"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для обозначения последнего пункта в серии действий или списке.",
                        "zh": "用于引出系列要点、行动或列表中的最后一项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наконец",
                                "target_lang_sense_clarification": "при перечислении"
                            },
                            {
                                "target_lang_word": "в заключение",
                                "target_lang_sense_clarification": "подводя итог"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后",
                                "target_lang_sense_clarification": "用于列举事项的末尾"
                            },
                            {
                                "target_lang_word": "总之",
                                "target_lang_sense_clarification": "用于总结或结束发言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0af31ed-438a-3ab2-97d2-690363be8622",
                    "sense_definition": "In a way that is final and cannot be changed or argued against; definitively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "definitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dispute was <w>finally</w> settled in court yesterday.",
                            "target_lang_translations": {
                                "ru": "Спор был <w>окончательно</w> урегулирован в суде вчера.",
                                "zh": "这场纠纷昨天在法庭上<w>最终</w>得到了解决。"
                            }
                        },
                        {
                            "text": "He left the company <w>finally</w> and for good.",
                            "target_lang_translations": {
                                "ru": "Он ушел из компании <w>окончательно</w> и навсегда.",
                                "zh": "他<w>彻底</w>离开了这家公司，再也不会回来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "once and for all",
                        "for good",
                        "completely",
                        "definitively"
                    ],
                    "common_phrases": [
                        "finally settled",
                        "finally resolved",
                        "finally gone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончательным образом, который нельзя изменить или оспорить; безусловно.",
                        "zh": "以一种不可更改或不可争辩的方式；决定性地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окончательно",
                                "target_lang_sense_clarification": "бесповоротно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彻底",
                                "target_lang_sense_clarification": "表示完全、不留余地"
                            },
                            {
                                "target_lang_word": "最终",
                                "target_lang_sense_clarification": "表示事情的定局"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                    "sense_definition": "Ultimately; when everything is considered.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ultimate_truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is, <w>finally</w>, a matter of personal conscience rather than law.",
                            "target_lang_translations": {
                                "ru": "Это, <w>в конечном счете</w>, вопрос личной совести, а не закона.",
                                "zh": "这<w>归根结底</w>是个人良心的问题，而非法律问题。"
                            }
                        },
                        {
                            "text": "The novel is <w>finally</w> about the resilience of the human spirit.",
                            "target_lang_translations": {
                                "ru": "Этот роман, <w>в конечном счете</w>, повествует о стойкости человеческого духа.",
                                "zh": "这部小说<w>说到底</w>是在探讨人类精神的韧性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ultimately"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В конечном счете; если принять всё во внимание.",
                        "zh": "归根结底；综合考虑所有因素后。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в конечном счете",
                                "target_lang_sense_clarification": "по сути"
                            },
                            {
                                "target_lang_word": "в конце концов",
                                "target_lang_sense_clarification": "в итоге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归根结底",
                                "target_lang_sense_clarification": "强调事物的本质或最终结论"
                            },
                            {
                                "target_lang_word": "说到底",
                                "target_lang_sense_clarification": "用于分析后的最终判断"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}