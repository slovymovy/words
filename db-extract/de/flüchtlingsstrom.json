                ],
                "senses": [
                    {
                        "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                        "entry_id": "5d628931-16d8-30b9-a09e-9b9125f8f99c",
                        "glosses": [
                            "in ein bestimmtes Gebiet einherziehende, aus Flüchtlingen bestehende große Menschenmenge"
                        ],
                        "tags": [
                            "emotional"
                        ],
                        "examples": [
                            {
                                "example_id": "27aff6ac-5e4e-48d6-a44c-2153b5dee511",
                                "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                                "text": "„Indira Gandhi hatte Nixon gebeten, Pakistan zur Mäßigung zu raten und damit dem Flüchtlingsstrom nach Indien Einhalt zu gebieten.“"
                            },
                            {
                                "example_id": "5f702567-566b-4e7f-8e85-42926b767654",
                                "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                                "text": "„Im Konflikt um die Provinz Darfur sind bereits Hunderttausende ums Leben gekommen; große Flüchtlingsströme erreichten die Nachbarländer.“"
                            },
                            {
                                "example_id": "147405d8-9c46-42a4-9a6c-273e7572513a",
                                "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                                "text": "„Die Überschwemmungen sind nicht nur für Indien gefährlich mit seiner 7 500 Kilometer langen Küste - sie werden voraussichtlich Flüchtlingsströme aus Bangladesch und den Malediven mit sich bringen.“"
                            },
                            {
                                "example_id": "acddc5da-2353-4e74-9f9f-c7f7cfab2433",
                                "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                                "text": "„Aufnahmen von möglichen Truppenbewegungen, Übergriffen, brennenden Dörfern und Flüchtlingsströmen sollen von den Vereinten Nationen über UNOSAT gesammelt, analysiert und im Internet mit aktuellen Berichten zur Verfügung gestellt werden.“"
                            },
                            {
                                "example_id": "85899113-f17f-482f-90c2-20960319edab",
                                "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                                "text": "„Aber wir sind uns bewusst, dass die Ereignisse in Ägypten grössere Migrationsbewegungen bis hin zu Flüchtlingsströmen auslösen könnten.“"
                            },
                            {
                                "example_id": "761fb4b4-f753-463f-869d-537e487a2221",
                                "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                                "text": "„Der UNO-Hochkommissar für Flüchtlinge, António Guterres, hat am Sonntag auf Lampedusa die Arbeit der Behörden und Hilfsorganisationen bei der Bewältigung des Flüchtlingsstroms aus Nordafrika gelobt.“"
                            },
                            {
                                "example_id": "5e9eb160-2fd9-4a46-8359-cc4c0c3cc7b7",
                                "sense_id": "fe5df5af-94de-3c5b-83c1-997cb03aed7d",
                                "text": "„Die Soldaten versuchen offenbar, den Flüchtlingsstrom in die benachbarte Türkei zu unterbinden, wo bereits mehr als 10.000 Menschen Zuflucht vor den Kämpfen gesucht haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
