                        "entry_id": "3bb811c5-3ee3-3b9c-891e-bb7c98992317",
                        "glosses": [
                            "aus Sehne geflochtenes Fischernetz"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c51faacd-34f8-4783-b581-9d7213837955",
                                "sense_id": "e3ed6650-1be6-3bf6-b8d1-aa849a7170f3",
                                "text": "Das Netz ist das aus weiten Maschen bestehende Gestrick, mit dem wir die Fische fangen wollen."
                            }
