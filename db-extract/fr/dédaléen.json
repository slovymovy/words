                "senses": [
                    {
                        "sense_id": "77b2b9e2-39a5-347a-b51f-857560a9b3c9",
                        "entry_id": "99a7ba73-90cd-37ee-a617-6a578379ca16",
                        "glosses": [
                            "Qui tient du dédale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85371332-c80f-4295-8e99-9ca6cd8ab4b7",
                                "sense_id": "77b2b9e2-39a5-347a-b51f-857560a9b3c9",
                                "text": "Ces deux grandes voies, croisées avec les deux premières, formaient le canevas sur lequel reposait, noué et serré en tous sens, le réseau dédaléen des rues de Paris."
                            },
                            {
                                "example_id": "d37f7f7c-69cf-41f4-a5c6-22b8f2ef37db",
                                "sense_id": "77b2b9e2-39a5-347a-b51f-857560a9b3c9",
                                "text": "Là, sans doute, sous cet amas confus se cachaient encore des salles voûtées, vastes et sonores, longs corridors dédaléens, des réduits enfouis dans les entrailles du sol, tels qu’en possèdent encore les forteresses des anciens Magyars."
                            }
                        ]
                    }
