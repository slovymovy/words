            "senses": [
                {
                    "sense_id": "a9806f3a-ab5b-3ccb-908e-6aeb9fe774e8",
                    "sense_definition": "The hollow area under the arm where it joins the shoulder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied deodorant to her <w>armpit</w> before leaving the house.",
                            "target_lang_translations": {
                                "ru": "Она нанесла дезодорант на <w>подмышку</w> перед выходом из дома."
                            }
                        },
                        {
                            "text": "The doctor checked the lymph nodes in his <w>armpit</w>.",
                            "target_lang_translations": {
                                "ru": "Врач проверил лимфоузлы у него в <w>подмышке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "underarm",
                        "pit"
                    ],
                    "common_phrases": [
                        "hairy armpit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Углубление под рукой в месте её соединения с плечом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подмышка",
