                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "BAMF",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b77ce3b-8e42-3c8d-a170-4aaee64abb93",
                                        "entry_id": "56d18195-485d-33ea-ba6d-d68cdcc79699",
                                        "glosses": [
                                            "Acronym of bad-ass motherfucker, a very tough or formidably impressive person who is not to be trifled with."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3686c041-abb6-465d-a084-c3311e347f56",
                                                "sense_id": "3b77ce3b-8e42-3c8d-a170-4aaee64abb93",
                                                "text": "And -atttitude-^([sic]) is a big part of being a BAMF, too."
                                            },
                                            {
                                                "example_id": "1d2e4354-b738-4087-988e-e7509f5a2523",
                                                "sense_id": "3b77ce3b-8e42-3c8d-a170-4aaee64abb93",
                                                "text": "Yarborough took a beat, recovered a little, got back to being a BAMF. Telepath couldn't put him down, he boasted. He hadn't met the freak that could."
                                            },
                                            {
                                                "example_id": "bcd975c2-d129-4783-8a37-66fbb5faada2",
                                                "sense_id": "3b77ce3b-8e42-3c8d-a170-4aaee64abb93",
                                                "text": "Fast-forward to my thirty-fifth birthday and my brother and I decided it was time to fulfill my dream of being a BAMF."
                                            },
                                            {
                                                "example_id": "0797a84c-109a-4351-ba74-cea30d790c2a",
                                                "sense_id": "3b77ce3b-8e42-3c8d-a170-4aaee64abb93",
                                                "text": "The first thing we learned about humanityless Caroline is that her voice is down an octave (sultrier, digging it), and also that she is a total BAMF."
                                            },
                                            {
                                                "example_id": "e14e6106-6693-4540-ae7c-7a2ea48ab904",
                                                "sense_id": "3b77ce3b-8e42-3c8d-a170-4aaee64abb93",
                                                "text": "Ariana tweeted her little heart out and set the record straight for fans, while slamming the Grammys in the process. And because she's a BAMF, she won an award three days after her tweetstorm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
