{
    "word_family": [
        "consensual",
        "consensus"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd38ce0a-caa8-3f08-876e-6562ae445613",
                    "sense_definition": "Voluntary agreement or permission for something to happen or be done.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "permission_agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must obtain written <w>consent</w> from your parents before going on the school trip.",
                            "target_lang_translations": {
                                "ru": "Вы должны получить письменное <w>согласие</w> от родителей перед школьной поездкой.",
                                "tr": "Okul gezisine gitmeden önce ebeveynlerinizden yazılı <w>rıza</w> almalısınız."
                            }
                        },
                        {
                            "text": "The doctor cannot perform the surgery without the patient's informed <w>consent</w>.",
                            "target_lang_translations": {
                                "ru": "Врач не может выполнить операцию без информированного <w>согласия</w> пациента.",
                                "tr": "Doktor, hastanın bilgilendirilmiş <w>onamı</w> olmadan ameliyatı gerçekleştiremez."
                            }
                        }
                    ],
                    "synonyms": [
                        "permission",
                        "agreement",
                        "approval",
                        "assent"
                    ],
                    "antonyms": [
                        "refusal"
                    ],
                    "common_phrases": [
                        "give consent",
                        "written consent",
                        "age of consent",
                        "mutual consent",
                        "informed consent"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добровольное соглашение или разрешение на то, чтобы что-то произошло или было сделано.",
                        "tr": "Bir şeyin olmasına veya yapılmasına verilen gönüllü onay veya izin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласие",
                                "target_lang_sense_clarification": "утвердительный ответ, разрешение"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "право на совершение чего-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rıza",
                                "target_lang_sense_clarification": "bir şeyin yapılmasına onay verme, kabul etme"
                            },
                            {
                                "target_lang_word": "izin",
                                "target_lang_sense_clarification": "bir eylemi yapma yetkisi veya müsaadesi"
                            },
                            {
                                "target_lang_word": "onay",
                                "target_lang_sense_clarification": "uygun bulma, tasvip etme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c482274f-2b5b-35ed-8785-09e090a6b6a7",
                    "sense_definition": "Unity or agreement of opinion, sentiment, or inclination among a group of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unity_consensus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By common <w>consent</w>, she was considered the most talented musician in the orchestra.",
                            "target_lang_translations": {
                                "ru": "По общему <w>согласию</w>, она считалась самым талантливым музыкантом в оркестре.",
                                "tr": "Ortak <w>kabulle</w>, orkestradaki en yetenekli müzisyen olarak kabul ediliyordu."
                            }
                        },
                        {
                            "text": "The committee reached a decision by general <w>consent</w> rather than taking a formal vote.",
                            "target_lang_translations": {
                                "ru": "Комитет принял решение с общего <w>согласия</w>, а не путем формального голосования.",
                                "tr": "Komite, resmi bir oylama yapmak yerine genel <w>uzlaşı</w> ile bir karara vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "agreement"
                    ],
                    "antonyms": [
                        "disagreement",
                        "dissent"
                    ],
                    "common_phrases": [
                        "by common consent",
                        "by general consent"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единство или согласие во мнениях, чувствах или склонностях среди группы людей.",
                        "tr": "Bir grup insan arasında görüş, duygu veya eğilim birliği."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласие",
                                "target_lang_sense_clarification": "единство точек зрения, единодушие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "görüş birliği",
                                "target_lang_sense_clarification": "fikir ve anlayış uyumu"
                            },
                            {
                                "target_lang_word": "uzlaşı",
                                "target_lang_sense_clarification": "ortak karara varma durumu"
                            },
                            {
                                "target_lang_word": "fikir birliği",
                                "target_lang_sense_clarification": "ortak düşüncede buluşma"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69f9232a-fde0-3fe9-a633-891a02d7e081",
                    "sense_definition": "To express willingness or to give permission for something to happen.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "permission_agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The owner would not <w>consent</w> to having his property searched by the police.",
                            "target_lang_translations": {
                                "ru": "Владелец не <w>согласился</w> на обыск своей собственности полицией.",
                                "tr": "Mülk sahibi, mülkünün polis tarafından aranmasına <w>razı olmadı</w>."
                            }
                        },
                        {
                            "text": "After much persuasion, she finally <w>consented</w> to speak at the conference.",
                            "target_lang_translations": {
                                "ru": "После долгих уговоров она наконец <w>согласилась</w> выступить на конференции.",
                                "tr": "Uzun iknalardan sonra nihayet konferansta konuşmayı <w>kabul etti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "agree",
                        "assent",
                        "acquiesce",
                        "concur",
                        "approve"
                    ],
                    "antonyms": [
                        "dissent"
                    ],
                    "common_phrases": [
                        "consent to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать готовность или давать разрешение на то, чтобы что-то произошло.",
                        "tr": "Bir şeyin gerçekleşmesine istekli olduğunu belirtmek veya izin vermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соглашаться",
                                "target_lang_sense_clarification": "отвечать утвердительно, принимать предложение"
                            },
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "позволять что-либо сделать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "razı olmak",
                                "target_lang_sense_clarification": "kabul etmek, rıza göstermek"
                            },
                            {
                                "target_lang_word": "onay vermek",
                                "target_lang_sense_clarification": "izin vermek, kabul etmek"
                            },
                            {
                                "target_lang_word": "izin vermek",
                                "target_lang_sense_clarification": "müsaade etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b8de3c3-7b06-3deb-a527-0028930a23c1",
                    "sense_definition": "To administer and process a formal consent form for a patient or study participant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The research assistant <w>consented</w> the new participants before collecting any data.",
                            "target_lang_translations": {
                                "ru": "Ассистент исследователя <w>получил согласие</w> у новых участников перед сбором данных.",
                                "tr": "Araştırma asistanı, herhangi bir veri toplamadan önce yeni katılımcılardan <w>onam aldı</w>."
                            }
                        },
                        {
                            "text": "I need to be <w>consented</w> by the surgeon before the procedure can begin.",
                            "target_lang_translations": {
                                "ru": "Хирург должен <w>получить</w> мое <w>согласие</w> до начала процедуры.",
                                "tr": "İşlem başlamadan önce cerrah tarafından <w>bilgilendirilip onayımın alınması</w> gerekiyor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Администрировать и оформлять официальный бланк согласия для пациента или участника исследования.",
                        "tr": "Bir hasta veya araştırma katılımcısı için resmi rıza formunu yönetmek ve işlemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оформлять согласие",
                                "target_lang_sense_clarification": "оформлять бланк информированного согласия пациента/участника"
                            },
                            {
                                "target_lang_word": "получать согласие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rıza almak",
                                "target_lang_sense_clarification": "bilgilendirilmiş onam formunu imzalatmak veya onayını almak"
                            },
                            {
                                "target_lang_word": "onam almak",
                                "target_lang_sense_clarification": "tıbbi veya akademik prosedür için onay almak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}