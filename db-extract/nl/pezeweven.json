                        "glosses": [
                            "beuzelen over kleinigheden en de grote belangrijke zaken over het hoofd zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "885be484-2967-4177-99b1-03f76c825b07",
                                "sense_id": "2fda45fe-d848-3040-a0aa-d9ba19b3b68a",
                                "text": "‘Een reeks van felle oogenblikken in Ahasverus' brandende en verscheurde ziel, een groep van hevig aangrijpende momenten uit zijn bestaan, en enkele wazige volzinnen, die dit alles als in eeuwen baden; een aantal korte maar heftige uitstootingen van mijn sterke gevoel in mijn sterke kunst, en 't overige ter vlucht aangestreken... wél ja, wat zal ik in bijbeldikke boeken gaan pezeweven over wat de lezers er óók wel bij kunnen denken, als ik het Ahasverus-sentiment maar eerst met enkele kneuzende bladzijden in hun hoofden gehamerd heb!’ - zoo ongeveer moet Vermeylen gemeend hebben."
                            }
                        ]
                    }
