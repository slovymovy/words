                                        "sense_id": "222f0135-0a6d-30a8-b7f1-27eca50abc4c",
                                        "entry_id": "cf522505-e29a-345a-834a-897836ce79cf",
                                        "glosses": [
                                            "The state or quality of being homoerotic"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07985ef2-59b7-4671-9c05-887def737b50",
                                                "sense_id": "222f0135-0a6d-30a8-b7f1-27eca50abc4c",
                                                "text": "Masculine images in the ballet tend toward one of two poles: the homoeroticism of contemporary European choreographers […], and the men-drained-of-maleness we often see in Cunningham's dances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0da246bb-b5a7-4d90-b797-8fb0595a3518",
                        "source_entry_id": "982f8d65-217b-3ef4-b63c-4a416eb3d831",
