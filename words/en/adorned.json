    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6fbc8c28-7502-3d04-b3da-b3e8370dbe29",
                    "sense_definition": "Decorated or embellished with ornaments or other additions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were <w>adorned</w> with beautiful paintings from local artists.",
                            "target_lang_translations": {
                                "nl": "De muren waren <w>versierd</w> met prachtige schilderijen van lokale kunstenaars."
                            }
                        },
                        {
                            "text": "She wore a simple dress <w>adorned</w> with a single silver brooch.",
                            "target_lang_translations": {
                                "nl": "Ze droeg een eenvoudige jurk die <w>versierd</w> was met een enkele zilveren broche."
                            }
                        }
                    ],
                    "synonyms": [
                        "decorated",
                        "embellished",
                        "ornamented"
                    ],
                    "common_phrases": [
                        "richly adorned",
                        "heavily adorned"
                    ],
                    "target_lang_definitions": {
                        "nl": "Versierd of verfraaid met ornamenten of andere toevoegingen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "versierd",
                                "target_lang_sense_clarification": "algemene term voor iets dat mooier is gemaakt met decoraties"
                            },
                            {
                                "target_lang_word": "verfraaid",
                                "target_lang_sense_clarification": "iets dat esthetisch aantrekkelijker is gemaakt"
                            },
                            {
                                "target_lang_word": "opgesierd",
                                "target_lang_sense_clarification": "vaak gebruikt voor mensen of objecten die met extra details zijn uitgedost"
                            }
                        ]
                    }
                }
            ]
        },
        {
