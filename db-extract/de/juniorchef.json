                "senses": [
                    {
                        "sense_id": "9ce078fa-4a74-3153-ab96-925ea9b08d9f",
                        "entry_id": "d6674974-a88c-30d4-8255-1ef0727a13b7",
                        "glosses": [
                            "Sohn oder Nachfolger des Firmenchefs im Betrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c239da-cafa-487d-8ce7-9b464d11a181",
                                "sense_id": "9ce078fa-4a74-3153-ab96-925ea9b08d9f",
                                "text": "„Als sie bei einer Firma als Sekretärin anfängt, entpuppt sich der Juniorchef als Jerôme.“"
                            },
                            {
                                "example_id": "d80bd901-627f-40e2-8f6a-ba9dfa622eb8",
                                "sense_id": "9ce078fa-4a74-3153-ab96-925ea9b08d9f",
                                "text": "„Das vom Juniorchef eigens installierte Mikrophon klang, als nähme man die eigene Stimme mit einem Diktaphon auf und spielte sie dann über den Lautsprecher einer Bahnhofsanlage ab – und das alles unter Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
