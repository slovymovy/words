    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f47a7bf-3bb1-33aa-bdb3-4bc2c2de494e",
                    "sense_definition": "Expression du visage ou ensemble de gestes corporels qui traduisent une émotion ou une pensée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa <w>mimique</w> faciale laissait deviner toute sa surprise devant cette nouvelle tout à fait inattendue."
                        },
                        {
                            "text": "Le comédien utilise une <w>mimique</w> très expressive pour amuser son jeune public."
                        }
                    ],
                    "synonyms": [
                        "expression",
                        "physionomie"
                    ],
                    "common_phrases": [
                        "mimique expressive",
                        "mimique faciale"
                    ]
                },
                {
                    "sense_id": "67b264cd-5740-3648-8f70-552a131b3a95",
                    "sense_definition": "Mouvement particulier ou grimace des traits du visage exprimant un sentiment ou une réaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a fait une drôle de <w>mimique</w> après avoir goûté cette boisson acide."
                        },
                        {
                            "text": "En apprenant la nouvelle, elle ne put s'empêcher de faire une <w>mimique</w> amusée."
                        }
                    ],
                    "synonyms": [
                        "grimace",
                        "moue"
                    ],
                    "common_phrases": [
                        "faire une mimique"
                    ]
                },
                {
                    "sense_id": "328cbe23-efed-3508-bc6f-3302d26f7f74",
                    "sense_definition": "Art ou action d'exprimer des idées et des émotions uniquement par les gestes et le visage sans parler.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art_theatral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet acteur excelle dans l'art de la <w>mimique</w> et captive toute la salle silencieuse."
                        },
                        {
                            "text": "La <w>mimique</w> permettait aux comédiens du cinéma muet de transmettre de grandes émotions."
                        }
                    ],
                    "synonyms": [
                        "pantomime"
                    ],
                    "common_phrases": [
                        "art de la mimique"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                    "sense_definition": "Qui exprime ou imite par le geste ou par les traits du visage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "expressif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le langage <w>mimique</w> des acteurs comiques dépasse aisément la barrière de la langue."
                        },
                        {
                            "text": "Son jeu <w>mimique</w> a convaincu l'ensemble des critiques de théâtre présents ce soir-là."
                        }
                    ],
                    "synonyms": [
                        "gestuel"
