                "senses": [
                    {
                        "sense_id": "71d69167-2ada-3d42-834d-9c35529443c6",
                        "entry_id": "aded8feb-e498-3dd3-843d-36f49eadf04f",
                        "glosses": [
                            "Person, die gedanklich in einer Phantasiewelt lebt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "2358e1a6-764b-440b-8859-e24826e910f6",
                                "sense_id": "71d69167-2ada-3d42-834d-9c35529443c6",
                                "text": "Ein Reveur ist kein Tatmensch."
                            },
                            {
                                "example_id": "a4b71782-0bba-4021-829b-2113a4cabb76",
                                "sense_id": "71d69167-2ada-3d42-834d-9c35529443c6",
                                "text": "„Das will ich auch und der Dohna mit seinem Monsieur Reveur, und meine gnädige Frau Mutter mit der Gelehrsamkeit sollen mir Nichts anhaben! …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b637bfb9-270e-4420-a14a-0fcc02553c0d",
                        "source_entry_id": "aded8feb-e498-3dd3-843d-36f49eadf04f",
                        "source_sense_id": "71d69167-2ada-3d42-834d-9c35529443c6",
