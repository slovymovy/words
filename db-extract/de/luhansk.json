                "senses": [
                    {
                        "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                        "entry_id": "eeb5f4dd-0e8e-35d0-8c04-870f80ad6506",
                        "glosses": [
                            "Stadt im Osten der Ukraine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a89ebbe-8650-4857-a07a-44c38f295a34",
                                "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                                "text": "Luhansk hieß früher Woroschilowgrad."
                            },
                            {
                                "example_id": "e160a5df-8588-4295-922b-33c38b24ec36",
                                "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                                "text": "„Die Proteste verliefen zunächst friedlich, wurden aber schnell grösser und wichtige Verwaltungsgebäude, vor allem in den beiden südöstlichen Städten Donezk und Luhansk, wurden besetzt.“"
                            },
                            {
                                "example_id": "c4f5764f-d101-42f4-9a7b-48edda7d0e3a",
                                "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                                "text": "„Als 2014 der Krieg ausbricht und sich die Situation in Luhansk zuspitzt, möchte ihr Mann seine Stelle kündigen, der Chef des SBU in Luhansk verweigert ihm dies jedoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9014c41c-e047-3908-b6e5-17b20aa1940c",
                        "entry_id": "eeb5f4dd-0e8e-35d0-8c04-870f80ad6506",
                        "glosses": [
                            "gleichnamiger Oblast in der östlichen Ukraine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e8881a-8689-4469-8d20-9bf7da73c843",
                                "sense_id": "9014c41c-e047-3908-b6e5-17b20aa1940c",
                                "text": "„Relativ schnell erklärte sich die Krim zuerst unabhängig und trat dann der Russischen Föderation bei, während in den Oblasten Donetzk und Luhansk separatistische Bewegungen tätig wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "004420a3-b98d-43c4-acfc-7217871765df",
                        "source_entry_id": "eeb5f4dd-0e8e-35d0-8c04-870f80ad6506",
