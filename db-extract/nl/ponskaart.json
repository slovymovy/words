                                            {
                                                "example_id": "3a231c88-3f42-489d-80ca-f78f4b8a9cd1",
                                                "sense_id": "f1ab53fc-ad44-3cdf-a49b-1ea03ebab368",
                                                "text": "Avant l’apparition des supports magnétiques, les programmes d’ordinateur étaient stockés sur des cartes perforées."
                                            },
                                            {
                                                "example_id": "aa9c3978-4586-43bd-8c6b-2423b2614294",
                                                "sense_id": "f1ab53fc-ad44-3cdf-a49b-1ea03ebab368",
                                                "text": "Les deux machines lisaient des programmes sur cartes perforées et elles n’avaient ni écran graphique, ni souris, juste un clavier et des cartes perforée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fa5214c-fd92-34b1-ad4d-498ce76c58f6",
                                        "entry_id": "69af96ac-5cb5-3024-ad28-d423f6d21572",
                                        "glosses": [
                                            "Carte percée de trous, les cartes attachées les unes aux autres déterminent l’exécution du dessin sur un métier à tisser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3a6d52-2e43-4769-98f2-9fe3456638ea",
                                                "sense_id": "2fa5214c-fd92-34b1-ad4d-498ce76c58f6",
                                                "text": "Le métier mécanique de Cartwright a été la meilleure solution, en attendant que le métier français Jacquard permette le tissage de tissus aux dessins complexes, grâce à l’utilisation répétitive de cartes perforées."
                                            }
                                        ]
