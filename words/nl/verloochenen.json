{
    "word_family": [
        "loochenen",
        "verloochening"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e83fb0af-f5f8-3e5c-a1ca-9f457fbd9a4f",
                    "sense_definition": "Openlijk afstand nemen van, ontkennen te behoren tot, of ontkennen te staan achter iets of iemand (zoals geloof, afkomst of principes).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde zijn geloof niet <w>verloochenen</w>, zelfs niet onder grote druk. ",
                            "target_lang_translations": {
                                "en": "He did not want to <w>deny</w> his faith, even under great pressure."
                            }
                        },
                        {
                            "text": "In zijn nieuwe boek koos hij ervoor zijn afkomst te <w>verloochenen</w>.",
                            "target_lang_translations": {
                                "en": "In his new book, he chose to <w>disown</w> his background."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontkennen",
                        "afzweren",
                        "verwerpen"
                    ],
                    "antonyms": [
                        "erkennen",
                        "belijden"
                    ],
                    "common_phrases": [
                        "afkomst verloochenen",
                        "principes verloochenen"
                    ],
                    "target_lang_definitions": {
                        "en": "To publicly distance oneself from, deny belonging to, or refuse to support something or someone (such as a faith, heritage, or principles)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deny",
                                "target_lang_sense_clarification": "refuse to admit connection with faith, heritage, or principles"
                            },
                            {
                                "target_lang_word": "disown",
                                "target_lang_sense_clarification": "refuse to acknowledge or accept responsibility for"
                            },
                            {
                                "target_lang_word": "renounce",
                                "target_lang_sense_clarification": "formally reject or abandon a belief, claim, or allegiance"
                            },
                            {
                                "target_lang_word": "betray",
                                "target_lang_sense_clarification": "be disloyal to a cause, faith, or background"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a00556d8-a9a5-362f-a5b1-4fed696881c2",
                    "sense_definition": "Negeren of wegcijferen van eigen gevoelens, identiteit of de werkelijkheid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door altijd anderen te behagen, begon zij haar eigen gevoelens te <w>verloochenen</w>.",
                            "target_lang_translations": {
                                "en": "By always pleasing others, she began to <w>deny</w> her own feelings."
                            }
                        },
                        {
                            "text": "Je moet jezelf niet <w>verloochenen</w> om bij een groep te horen.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>betray</w> yourself just to belong to a group."
                            }
                        }
                    ],
                    "synonyms": [
                        "negeren",
                        "wegcijferen"
                    ],
                    "antonyms": [
                        "omarmen"
                    ],
                    "common_phrases": [
                        "jezelf verloochenen",
                        "eigen gevoelens verloochenen"
                    ],
                    "target_lang_definitions": {
                        "en": "To ignore, suppress, or betray one's own feelings, identity, or reality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deny",
                                "target_lang_sense_clarification": "suppress or refuse to recognize one's true feelings or self"
                            },
                            {
                                "target_lang_word": "betray",
                                "target_lang_sense_clarification": "act contrary to one's own true nature or values"
                            },
                            {
                                "target_lang_word": "suppress",
                                "target_lang_sense_clarification": "ignore or hide one's genuine identity or emotions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}