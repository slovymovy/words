                        "glosses": [
                            "rangorde van de landen naar het aantal gewonnen (gouden) medailles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430282a8-e6bd-4cad-af54-c4a8deecf735",
                                "sense_id": "3d9a082c-c3db-364f-a133-9ee721d36a3e",
                                "text": "De Nederlandse ploeg is na de vijfde dag van de Winterspelen van de tweede naar de vierde plaats gezakt in het medailleklassement. Nederland won vandaag geen medailles en blijft dus staan op drie gouden, drie zilveren en een bronzen plak."
                            },
                            {
                                "example_id": "d7a8125a-66fe-4172-9fd3-178c9dc195f1",
                                "sense_id": "3d9a082c-c3db-364f-a133-9ee721d36a3e",
                                "text": "Noorwegen eindigt als koploper in het medailleklassement in Peking met zestien gouden plakken. Hiervoor kwam Noorwegen niet verder dan veertien keer goud op één Winterspelen."
                            }
                        ]
                    }
