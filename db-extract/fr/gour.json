                    {
                        "sense_id": "e064941f-6517-386e-add1-dc6db0ffddcd",
                        "entry_id": "150f56ac-b9b5-33cd-9513-0c6f3d6fbe35",
                        "glosses": [
                            "an oxbow, especially along the Loire"
