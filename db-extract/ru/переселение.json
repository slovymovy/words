                                                "example_id": "41328fd5-0de6-46be-aaa0-3dbd0a5f4c9a",
                                                "sense_id": "daed6424-5f9a-322c-9179-11f77562ec41",
                                                "text": "Il faut pourvoir au relogement de cette famille expulsée de son foyer."
                                            },
                                            {
                                                "example_id": "189f8a9a-2d61-457e-a4ef-d3aa23169e5c",
                                                "sense_id": "daed6424-5f9a-322c-9179-11f77562ec41",
                                                "text": "On assiste souvent à un processus d’appauvrissement de la population déplacée et d’exclusion des habitants les plus démunis qui n'ont pas accès au relogement étatique."
                                            }
                                        ]
