                ],
                "senses": [
                    {
                        "sense_id": "8b49dd3c-ec81-3777-a91d-786910f3da16",
                        "entry_id": "8ca0c159-65c1-34de-be8f-0f94818277fd",
                        "glosses": [
                            "singular of Keds"
                        ],
                        "tags": [
                            "form-of",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "ada11279-85b1-4f76-8768-807e97b273b8",
                                "sense_id": "8b49dd3c-ec81-3777-a91d-786910f3da16",
                                "text": "Consequently he hadn’t been able to run well; his gym shoe threatening to fall off, he had surrendered at the appearance of the car. He had rather be caught than lose one Ked."
                            },
                            {
                                "example_id": "91c2de00-174f-4bd7-83bf-708c1f9eaaa6",
                                "sense_id": "8b49dd3c-ec81-3777-a91d-786910f3da16",
                                "text": "Meanwhile, I struggled to keep my composure and to keep my breathing steady as she ever so slightly would shift first one Ked, then the other, as she gently played with my foot."
                            },
                            {
                                "example_id": "89be186d-0343-4304-811e-aa881a8c96e1",
                                "sense_id": "8b49dd3c-ec81-3777-a91d-786910f3da16",
                                "text": "I put one Ked gingerly on the driveway to test for ice."
                            }
                        ]
                    }
                ],
