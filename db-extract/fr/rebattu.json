                                        "sense_id": "18a23b9a-999c-39af-9ab8-df66127ac894",
                                        "entry_id": "e9e0666f-3dc2-3ec1-b5d3-71675853c277",
                                        "glosses": [
                                            "Something, most often a phrase or expression, that is overused or used outside its original context, so that its original impact and meaning are lost. A trite saying; a platitude."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa90d4de-3f21-4eee-b347-6d3a7bddc6c1",
                                                "sense_id": "18a23b9a-999c-39af-9ab8-df66127ac894",
                                                "text": "The villain kidnapping the love interest in a film is a bit of a cliché."
                                            },
                                            {
                                                "example_id": "f3b253c0-3b9f-456c-9789-961376ddede2",
                                                "sense_id": "18a23b9a-999c-39af-9ab8-df66127ac894",
                                                "text": "I know it's a bit of a cliché, but love really does conquer all."
                                            },
                                            {
                                                "example_id": "73b14c14-8602-488b-bb67-8c29bbff55be",
                                                "sense_id": "18a23b9a-999c-39af-9ab8-df66127ac894",
                                                "text": "Clever got me this far\nThen tricky got me in\nEye on what I'm after\nI don't need another friend\nSmile and drop the cliche\nTill you think I'm listening\nTake just what I came for\nThen I'm out the door again"
                                            },
                                            {
                                                "example_id": "f25ce661-7ec2-4ec9-bd73-66cf1ab8e897",
                                                "sense_id": "18a23b9a-999c-39af-9ab8-df66127ac894",
                                                "text": "Don’t believe what they’re saying everything’s is gonna change How could it be ever the same? It’s just a cliché fading Till we go our separate ways"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e669c0ed-5aa4-33bc-8579-ad7e74fe897c",
                                        "entry_id": "e9e0666f-3dc2-3ec1-b5d3-71675853c277",
                                        "glosses": [
                                            "A stereotype (printing plate)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
