                            {
                                "example_id": "c0df2a5c-9c9d-4c86-bd30-97c0f8e71c54",
                                "sense_id": "140a8cdc-2b5d-3656-b989-8957ba135434",
                                "text": "The better quality was used for ordinary cloths, and the worst was made up into coarse cloth known as cogware and Kendal cloth, three quarters of a yard broad, and worth from 40d. to 5s. the piece. The term cogware seems to have sprung from its being sold to cogmen, the crews of the ships called cogs; but whether for their own use, or for export is not quite clear."
                            }
                        ]
                    },
