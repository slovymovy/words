                    {
                        "sense_id": "ff126cd4-b159-387e-b5eb-92b482f94cf7",
                        "entry_id": "473fca3a-3c90-38e6-9991-8785859561bd",
                        "glosses": [
                            "stuk natuursteen, meer in het bijzonder: een stuk vuursteen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e538f61-7e8c-4b5d-a56d-75a08bde6937",
                                "sense_id": "ff126cd4-b159-387e-b5eb-92b482f94cf7",
                                "text": "Ze lagen plat op een werktafeltje te drogen, bezwaard met stukken marmer; wanneer in het kwartdeel van het donkere ovaal, het doek niet gekleefd had, een bladder kon ontstaan, tilde meester een keisteen op."
                            }
                        ]
                    },
                    {
                        "sense_id": "d26b5135-1a96-34fd-9e3e-6e5f5f40f0cb",
                        "entry_id": "473fca3a-3c90-38e6-9991-8785859561bd",
                        "glosses": [
                            "soortnaam voor gesteente"
                        ],
                        "tags": [
                            "materiaalkunde",
                            "geen verkleinwoord of meervoud"
                        ],
                        "examples": [
                            {
                                "example_id": "aefb1d6e-53cb-4ad3-895d-d7e57aaeb6ef",
                                "sense_id": "d26b5135-1a96-34fd-9e3e-6e5f5f40f0cb",
                                "text": "Was eens alles diamant,\nwat thans keisteen is of zand,\nwie deed moeite om het te winnen?"
                            }
                        ]
                    }
