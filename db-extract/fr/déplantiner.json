                "senses": [
                    {
                        "sense_id": "b9bf0d3e-64f3-3438-92dd-8dbea4dbe343",
                        "entry_id": "393c5483-8a3d-3fa3-ba26-0aca026c0bf3",
                        "glosses": [
                            "Débarrasser un ensemble de graines des graines de plantain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6478ca3a-25a6-4620-a035-b08ed26a25d5",
                                "sense_id": "b9bf0d3e-64f3-3438-92dd-8dbea4dbe343",
                                "text": "Il est donc mauvais de battre tout dans une machine et vouloir décuscuter ou déplantiner ensuite; on enlève bien, de cette façon, les petites graines de cuscute et de plantain, tout en faisant souvent plus de 10% de déchet, mais on laisse dans la semence les grosses graines de cuscute et de plantain, en opérant ainsi une véritable sélection des plantes parasites dont on ne sème alors que les plus grosses graines."
                            },
                            {
                                "example_id": "fee6a746-688a-431c-8e57-26f2bb06562e",
                                "sense_id": "b9bf0d3e-64f3-3438-92dd-8dbea4dbe343",
                                "text": "Les graines ont très bel aspect et sont passées au trieur Teisset-Hose-Brault avec tamis spécial pour décuscuter et déplantiner."
                            }
                        ]
                    }
                ],
