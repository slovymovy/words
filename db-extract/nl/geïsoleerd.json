                "senses": [
                    {
                        "sense_id": "40fb0650-757f-3fd4-b770-e97c9560ed0b",
                        "entry_id": "e2d40924-5cbc-350b-9541-de3045ff5335",
                        "glosses": [
                            "afgezonderd van de omgeving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29253b2-3767-4be3-825f-c3a610e55e06",
                                "sense_id": "40fb0650-757f-3fd4-b770-e97c9560ed0b",
                                "text": "De besmettelijke patiënt moest in een geïsoleerde kamer worden behandeld."
                            },
                            {
                                "example_id": "a21bbecb-6b6a-402b-8e16-7308712d2f59",
                                "sense_id": "40fb0650-757f-3fd4-b770-e97c9560ed0b",
                                "text": "Het goed geïsoleerde huis was makkelijk te verwarmen."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcfa663c-3474-3f8d-8c65-6f6ebbed8a56",
                        "entry_id": "e2d40924-5cbc-350b-9541-de3045ff5335",
                        "glosses": [
                            "ver weg van alles en iedereen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74912434-503f-49c7-aa61-cb19c42ef9d4",
                                "sense_id": "dcfa663c-3474-3f8d-8c65-6f6ebbed8a56",
                                "text": "Hij woonde in een geïsoleerd dorpje in de bergen."
                            },
                            {
                                "example_id": "79df18d4-2598-4ae5-bb81-2e1d6e56d53e",
                                "sense_id": "dcfa663c-3474-3f8d-8c65-6f6ebbed8a56",
                                "text": "Deze conclusie, zijn verklaring van plichtsbesef en de resten van zijn garnalensoesje spoelde hij weg met een grote slok zoete witte wijn, terwijl ik bleef zitten met de vraag hoe hij vanuit dit geïsoleerde hotel, dat op honderden kilometers van zee lag, leiding gaf aan een intercontinentaal georiënteerd maritiem bedrijf, maar ik durfde het niet te vragen, want hij had alweer een nieuw roesje in zijn mond gestopt."
                            }
                        ]
                    }
