                "translations": [
                    {
                        "translation_id": "3762725a-47d5-4537-bced-9ea3ab1108fe",
                        "source_entry_id": "f8b310d8-60c9-3e1f-b0f1-875877e070ff",
                        "source_sense_id": "1efa9747-2c6b-3b15-a3c7-585abc6edd0b",
                        "target_lang_word": "football",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "football",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8014e4-dde4-3ffc-a890-e5afae286b7b",
                                        "entry_id": "50bce09e-0321-32b3-a697-41a43734f309",
                                        "glosses": [
                                            "A sport played on foot in which teams attempt to get a ball into a goal or zone defended by the other team."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "667c8a57-9d39-4f7e-a997-bb33c513fa5f",
                                                "sense_id": "0f8014e4-dde4-3ffc-a890-e5afae286b7b",
                                                "text": "Roman and medieval football matches were more violent than any modern type of football."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d413a46d-5609-3417-bf2a-20082b88ab4e",
                                        "entry_id": "50bce09e-0321-32b3-a697-41a43734f309",
                                        "glosses": [
                                            "The ball used in any game called \\\"football\\\"."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46848b7-886f-439d-a034-d6abd39bbb86",
                                                "sense_id": "d413a46d-5609-3417-bf2a-20082b88ab4e",
                                                "text": "The player kicked the football."
                                            },
                                            {
                                                "example_id": "9bcd3e08-db4c-402f-bf20-55a896f57bd4",
                                                "sense_id": "d413a46d-5609-3417-bf2a-20082b88ab4e",
                                                "text": "The league said the Super Bowl-bound New England Patriots used footballs that didn’t meet league specifications in the first half of the AFC championship game last Sunday."
                                            },
                                            {
                                                "example_id": "a818c003-22b9-4c78-967b-ba685dd4656b",
                                                "sense_id": "d413a46d-5609-3417-bf2a-20082b88ab4e",
                                                "text": "“The coroner and the pathologist described how badly damaged my dad’s brain was,” his daughter Dawn told CNN in 2019. “He found that there was considerable evidence of trauma to the brain which he said was similar to the brain of the boxer. And he said that the main candidate for the trauma was heading the footballs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88ceb3cc-a48f-31c2-afa8-6558bafdce76",
                                        "entry_id": "50bce09e-0321-32b3-a697-41a43734f309",
                                        "glosses": [
                                            "Association football, also called soccer: a game in which two teams each contend to get a round ball into the other team's goal primarily by kicking the ball."
                                        ],
                                        "tags": [
                                            "Africa",
                                            "Caribbean",
                                            "South-Asia",
                                            "UK",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414c1813-a7c1-42a8-a214-b665243ac86e",
                                                "sense_id": "88ceb3cc-a48f-31c2-afa8-6558bafdce76",
                                                "text": "Each team scored three goals when they played football."
                                            },
                                            {
                                                "example_id": "2a49fc4e-c788-4008-9647-405410cc5636",
                                                "sense_id": "88ceb3cc-a48f-31c2-afa8-6558bafdce76",
                                                "text": "“Our research has shown that heading is rare in youth football matches, so this guidance is a responsible development to our grassroots coaching without impacting the enjoyment that children of all ages take from playing the game.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6121deea-fac6-383d-b751-279a0985cadc",
                                        "entry_id": "50bce09e-0321-32b3-a697-41a43734f309",
                                        "glosses": [
                                            "American football: a game played on a field 100 yards long and 53 1/3 yards wide in which two teams of 11 players attempt to get an ovoid ball to the end of each other's territory."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f29ea74-b359-4985-a72e-3e650c496c8f",
                                                "sense_id": "6121deea-fac6-383d-b751-279a0985cadc",
                                                "text": "Each team scored two touchdowns when they played football."
                                            },
                                            {
                                                "example_id": "e016c475-1a62-4fdc-8ed7-aea47a667bd6",
                                                "sense_id": "6121deea-fac6-383d-b751-279a0985cadc",
                                                "text": "According to Newsday, he took the ball to his team’s equipment staff, which then informed head coach Chuck Pagano, who told general manager Ryan Grigson, who told NFL director of football operations Mike Kensil, who told the officials on the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c977dfbc-5e8e-3fcc-b66a-2afc38206e3d",
                                        "entry_id": "50bce09e-0321-32b3-a697-41a43734f309",
                                        "glosses": [
                                            "Canadian football: a game played on a field 110 yards long and 65 yards wide in which two teams of 12 players attempt to get an ovoid ball to the end of each other's territory."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af44ea2b-eb0e-42e2-8dc5-76c153a7785e",
                                                "sense_id": "c977dfbc-5e8e-3fcc-b66a-2afc38206e3d",
                                                "text": "They played football in the snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd178d8-d1af-39a0-afb9-dfff037869d5",
                                        "entry_id": "50bce09e-0321-32b3-a697-41a43734f309",
                                        "glosses": [
                                            "Australian rules football."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-South-Wales",
                                            "South",
                                            "Southern",
                                            "Tasmania",
                                            "Western",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cdec53-ca97-4fa1-b46f-29c9b44e4068",
                                                "sense_id": "bdd178d8-d1af-39a0-afb9-dfff037869d5",
                                                "text": "The weekend after AFL football chief Simon Lethlean made it clear players who jumper punched or punched opponents in the stomach would most likely be suspended, Jones was charged with striking Hawthorn’s Luke Breust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0f52518-66b8-3b37-b79c-8c278d2563c9",
                                        "entry_id": "50bce09e-0321-32b3-a697-41a43734f309",
                                        "glosses": [
                                            "Gaelic football: a field game played with similar rules to hurling, but using hands and feet rather than a stick, and a ball, similar to, yet smaller than a soccer ball."
                                        ],
