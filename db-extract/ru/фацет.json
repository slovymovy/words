                                            {
                                                "example_id": "ed8b09ca-8ff1-4b9a-b367-f2cd010f3b90",
                                                "sense_id": "496f80b5-eab8-3bd5-852f-bb3d8986179d",
                                                "text": "„Zäh verlief indes das vergangene Jahr, als er sich nach 14 Jahren von seiner Trainerin Ute Schinkitz trennte und die Sinnkrise in allen Facetten durchlebte.“"
                                            },
                                            {
                                                "example_id": "13649d3e-c70c-4236-b7cb-bcafdf0af9ef",
                                                "sense_id": "496f80b5-eab8-3bd5-852f-bb3d8986179d",
                                                "text": "„Das Leben in der Etappe hinter der Front hatte viele Facetten, und manchmal durchaus angenehme und unterhaltsame.“"
                                            },
                                            {
                                                "example_id": "df58c965-2758-4230-98c8-247317752910",
                                                "sense_id": "496f80b5-eab8-3bd5-852f-bb3d8986179d",
                                                "text": "„Es sind vor allem die Facetten der Machtausübung, die Canetti interessieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d19c1589-1444-319d-8ffc-375a53b5016c",
                                        "entry_id": "0404acca-840e-3b7f-8591-81398d20c8c4",
                                        "glosses": [
