                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60bda983-163c-47d2-8d44-09e39373a322",
                                "sense_id": "077912bb-0ee3-3303-b082-b720ae5c183e",
                                "text": "Die Wiedersehensfreude stand ihr ins Gesicht geschrieben."
                            },
                            {
                                "example_id": "b8f87c0f-0ae2-4a2e-b69f-9a8d0601cb8f",
                                "sense_id": "077912bb-0ee3-3303-b082-b720ae5c183e",
                                "text": "„Gestern hatten sie sich im Augenblick der ersten Wiedersehensfreude geküsst, jetzt hatten sie aber beide die Empfindung, dass das nicht angebracht war; Rostow fühlte, wie alle, Mutter und Schwestern, ihn fragend ansahen und gespannt darauf waren, für was für einen Verkehrston er sich Sonja gegenüber entscheiden würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
