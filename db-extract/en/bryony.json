                        "entry_id": "23a3e0b8-de97-3bc6-ba8f-9b795574d337",
                        "glosses": [
                            "A perennial herb of the genus Bryonia, especially the common wild species Bryonia dioica."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2fac6160-fe8f-4ac6-914f-9a9c03c0fdf4",
                                "sense_id": "6405a5c9-a59b-385e-97d9-a67ac6277d20",
                                "text": "On a sudden a low breath / Of tender air made tremble in the hedge / The fragil bindweed-bells and briony rings; […]"
                            },
                            {
                                "example_id": "3514be1b-60fd-417e-ad63-37930e43a9f7",
                                "sense_id": "6405a5c9-a59b-385e-97d9-a67ac6277d20",
                                "text": "I cycled the three miles each morning between hedges draped with spangled cobwebs and berried bryony."
                            }
                        ]
                    }
                ],
