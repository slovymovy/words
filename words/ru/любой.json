            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "6e0e9e04-172e-3e75-983a-a45f6c53df10",
                    "sense_definition": "Какой угодно, безразлично какой, всякий.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <любом> случае мы должны закончить эту работу сегодня.",
                            "target_lang_translations": {
                                "en": "In <w>any</w> case, we must finish this work today.",
                                "zh": "在<w>任何</w>情况下，我们今天都必须完成这项工作。"
                            }
                        },
                        {
                            "text": "Вы можете прийти к нам в гости в <любое> время.",
                            "target_lang_translations": {
                                "en": "You can come visit us at <w>any</w> time.",
                                "zh": "你们可以<w>任何</w>时间来我们家做客。"
                            }
                        }
                    ],
                    "synonyms": [
                        "всякий",
                        "каждый"
                    ],
                    "antonyms": [
                        "никакой",
                        "ни один"
                    ],
                    "common_phrases": [
                        "в любом случае",
                        "любой ценой",
                        "в любое время"
                    ],
                    "target_lang_definitions": {
                        "en": "Whichever one; no matter which; any kind of.",
                        "zh": "指代任何一个，无论哪一个；不加选择的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "any",
                                "target_lang_sense_clarification": "no matter which"
                            },
                            {
                                "target_lang_word": "every",
                                "target_lang_sense_clarification": "all members of a group"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何",
                                "target_lang_sense_clarification": "指代任何一个，不加限制"
                            },
                            {
                                "target_lang_word": "无论什么",
                                "target_lang_sense_clarification": "强调不加选择"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "bb07542a-2a12-3825-aefd-90b72d6d6881",
                    "sense_definition": "Всякий человек, кто угодно (субстантивированное значение).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Любой> может научиться играть на гитаре, если захочет.",
                            "target_lang_translations": {
                                "en": "<w>Anyone</w> can learn to play the guitar if they want to.",
                                "zh": "<w>任何人</w>只要想学，都能学会弹吉他。"
                            }
                        },
                        {
                            "text": "Это задание настолько простое, что <любой> с ним справится.",
                            "target_lang_translations": {
                                "en": "This task is so simple that <w>anyone</w> can handle it.",
                                "zh": "这项任务太简单了，<w>任何人</w>都能搞定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кто угодно",
                        "каждый"
                    ],
                    "antonyms": [
                        "никто"
                    ],
                    "common_phrases": [
                        "любой желающий"
                    ],
                    "target_lang_definitions": {
                        "en": "Any person; whoever.",
                        "zh": "指代任何人，无论谁。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anyone",
                                "target_lang_sense_clarification": "any person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何人",
                                "target_lang_sense_clarification": "指代任何一个人"
                            },
                            {
                                "target_lang_word": "谁都",
                                "target_lang_sense_clarification": "强调无论谁都可以"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b44e3189-9001-3482-96de-559c0ca2a37d",
