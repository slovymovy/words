                    {
                        "translation_id": "f346e0ab-a74d-4d24-acec-d1c11b77d25c",
                        "source_entry_id": "a35df563-df54-31c7-a105-02647e1edc7a",
                        "source_sense_id": "548307fa-16e4-3cdc-bd1f-1f2d772533eb",
