                        "translation_id": "9a5b1dfd-5220-4ffb-a5c8-3f1294e140b4",
                        "source_entry_id": "459cfd23-35ae-3597-9593-f56462fcf507",
                        "source_sense_id": "d0edef03-00a4-3a7d-a1e5-fff71f6bde9b",
                        "source_sense_description": "Werkzeug zum Schleifen oder Schärfen von Gegenständen",
                        "target_lang_word": "оселок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оселок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea768ea-67fa-3101-b929-743da03867ca",
                                        "entry_id": "7169d3ce-578c-39a8-bdd0-4e8dc43ca1fd",
                                        "glosses": [
                                            "точильный камень в виде бруска"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630074f0-8cd8-48b1-a92d-83cd7538c06c",
                                                "sense_id": "9ea768ea-67fa-3101-b929-743da03867ca",
                                                "text": ".. раскладаю по столу бритвы, а потом опущаю их в тёплую воду, а потом капну из пузырёчка оливкою на оселок, да правлю бритвы на оселочке, а потом вожу их по полотенечку, а потом зачинаю помалу и бриться."
                                            },
                                            {
                                                "example_id": "644f3d95-407a-4ad7-81d6-6b09dd4c5a3f",
                                                "sense_id": "9ea768ea-67fa-3101-b929-743da03867ca",
                                                "text": "В одной руке у неё посошок, в другой — коса-половинка, из кармана ватника торчит донельзя сточенный оселок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4da3fa9e-d3e1-3270-ac30-6de38ac6d4c8",
                                        "entry_id": "7169d3ce-578c-39a8-bdd0-4e8dc43ca1fd",
                                        "glosses": [
                                            "ювел. камень для пробирования драгоценных металлов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296ec2e9-92f0-4fcb-abe6-2d77373afd94",
                                                "sense_id": "4da3fa9e-d3e1-3270-ac30-6de38ac6d4c8",
                                                "text": "Чёрный оселок, весьма чистый шифер, употребляемый для пробы дорогих металлов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c49c78-e98f-3f8b-a1f5-71d399a47704",
                                        "entry_id": "7169d3ce-578c-39a8-bdd0-4e8dc43ca1fd",
                                        "glosses": [
                                            "перен. средство испытания, выявления, проверки каких-либо свойств, качеств и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c5ec2d-a850-4e61-ab7b-983b899f27d0",
                                                "sense_id": "14c49c78-e98f-3f8b-a1f5-71d399a47704",
                                                "text": "Ради бога, Николай, не делай дружбы моей оселком!"
                                            },
                                            {
                                                "example_id": "be8618ca-e0c7-494f-82c8-4587aaeb3c9b",
                                                "sense_id": "14c49c78-e98f-3f8b-a1f5-71d399a47704",
                                                "text": "Карточная игра в России есть часто оселок и мери́ло нравственного достоинства человека."
                                            },
                                            {
                                                "example_id": "b8198892-bb28-4a4e-9200-6553b798e141",
                                                "sense_id": "14c49c78-e98f-3f8b-a1f5-71d399a47704",
                                                "text": "Это ж какую отраву принимает человек, на каком безжалостном оселке проверяет себя на крепость, подводя постоянно к последней черте, если так мучает и корежит плоть, если душа в кромешной утробе морщинится от издевки, как грецкий орех."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
