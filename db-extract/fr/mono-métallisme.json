                    {
                        "sense_id": "38da0e6a-fedf-3582-934e-fbf8eb129985",
                        "entry_id": "a92d128d-fcc7-3af7-a8cf-771aeffd2f52",
                        "glosses": [
                            "Système monétaire d’après lequel un seul métal, l’or ou l’argent, sert d’étalon pour la monnaie."
                        ],
                        "tags": [
                            "Économie politique"
                        ],
                        "examples": [
                            {
                                "example_id": "adcc9a2d-e5e5-42ee-ac81-a06ea3e9e823",
                                "sense_id": "38da0e6a-fedf-3582-934e-fbf8eb129985",
                                "text": "En effet, dès la fin du XVIIIᵉ siècle, l’Angleterre a adopté le mono-métallisme de l’or."
                            },
                            {
                                "example_id": "30e9632b-4f31-4b50-91c1-f5220d47cf56",
                                "sense_id": "38da0e6a-fedf-3582-934e-fbf8eb129985",
                                "text": "Du bi-métallisme on est passé au mono-métallisme fondé sur le choix d’un seul métal-étalon bénéficiant, à l’exclusion de tout autre métal, de la frappe libre et d’un pouvoir libératoire illimité."
                            }
                        ]
                    }
                ],
