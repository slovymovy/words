                    {
                        "translation_id": "1cc77978-ab0b-4b6f-b582-1232b616aa20",
                        "source_entry_id": "42b6ee6f-0110-3ad2-91f8-5fb6e7744786",
                        "source_sense_description": "Greek god associate with time, the universe and the zodiac",
                        "target_lang_word": "Äon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63d1bf0c-025d-3109-bb14-5b04566b8285",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "Erdzeitalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447d31fe-5d7c-46e1-a587-89bffbbfff82",
                                                "sense_id": "63d1bf0c-025d-3109-bb14-5b04566b8285",
                                                "text": "Das Hadaikum ist der erste Äon in der Geologie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "sehr langer, nach menschlichem Ermessen unüberschaubarer, unendlich erscheinender Zeitraum"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63191cee-00ab-4f7d-9e74-7c0154b051f5",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Moor: Nein, nicht erschlagen! das Wort ist Beschönigung! - der Sohn hat den Vater tausendmal gerädert, gespießt, gefoltert, geschunden! die Worte sind mir zu menschlich - worüber die Sünde roth wird, worüber der Kannibale schaudert, worauf seit Äonen kein Teufel gekommen ist.“"
                                            },
                                            {
                                                "example_id": "f98ae1bc-a8f6-4b2a-bfe5-74310b6d7515",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Äonen, nachdem die Sonne zur roten Riesin geworden ist, werden im Sternennebel noch immer verstreute Funksignale aufgefangen.“"
                                            },
                                            {
                                                "example_id": "6aa6f460-b878-4170-ac80-726ca595e12d",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Als Jäger und Sammler hat sich der Mensch einst in Afrika entwickelt, und so hat er dort auch über Äonen gelebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "Zeitabschnitt der Weltgeschichte, Zeitalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4d7aa1-35f9-48c1-aea4-52f76364e32a",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„Der Kalte Krieg hatte lange genug gedauert, um damals beiden Seiten seine Vergeblichkeit zu beweisen. Ein neuer Äon kündigte sich an. Fantasien vom Ende der Geschichte versprachen ein Goldenes Zeitalter.“"
                                            },
                                            {
                                                "example_id": "3ca974b8-1ce2-4ba4-8ae7-9fa758adadfb",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„Jetzt, im mandarinen Äon, glauben die Menschen nur noch an die Kaufkraft.“"
                                            },
                                            {
                                                "example_id": "766c89a3-0ff4-4174-a4ff-bc051e9bf505",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„So trächtig schwärmten die Gedanken, daß sich die Menschen einbildeten, in der überstürzten Spanne von Jahrzehnten die Entwicklung eines Äons zu bewältigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
