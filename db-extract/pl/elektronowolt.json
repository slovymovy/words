                        ]
                    },
                    {
                        "translation_id": "c068658a-6649-438d-becf-f83f2dac0ed1",
                        "source_entry_id": "729aa72a-c4a9-3a7c-85b3-6e9f3a21fc92",
                        "source_sense_id": "973f0043-292a-3079-bf0e-40167019991d",
                        "target_lang_word": "électron-volt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électron-volt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6ba8aed-0751-3735-91a8-52e97c27273e",
                                        "entry_id": "35f5381b-aa3a-3d7c-8077-c004513870c8",
                                        "glosses": [
                                            "Variante orthographique de électronvolt."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4757a521-204a-4325-a1a2-26bbce272193",
                                                "sense_id": "f6ba8aed-0751-3735-91a8-52e97c27273e",
                                                "text": "Aujourd'hui les physiciens manient des synchrophasotrons de plusieurs milliards d’électrons-volts, pesant des milliers de tonnes et coûtant des sommes énormes."
                                            },
                                            {
                                                "example_id": "4fafad1e-5532-464d-97d0-b5aa083ff0da",
                                                "sense_id": "f6ba8aed-0751-3735-91a8-52e97c27273e",
                                                "text": "Les forces provocatrices sont celles que l'on doit mettre en jeu pour perturber la cohésion de l'atome. La perturbation de la structure atomique intervient d'abord au niveau des réactions chimiques où quelques électrons-volts (eV) suffisent pour modifier les liaisons électromagnétiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eb2c82c-0d48-4852-a6ae-d70feb38334b",
                        "source_entry_id": "729aa72a-c4a9-3a7c-85b3-6e9f3a21fc92",
                        "source_sense_id": "973f0043-292a-3079-bf0e-40167019991d",
                        "target_lang_word": "Elektronenvolt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektronenvolt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                                        "entry_id": "b98a19a3-d3d9-394b-b423-a79cfd3e69a9",
                                        "glosses": [
                                            "Maßeinheit der Energie, die häufig in der Atomphysik, Kernphysik und Teilchenphysik benutzt wird"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "725403fb-845e-4342-97fc-59127986d708",
                                                "sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                                                "text": "„Ein Elektronenvolt (eV) ist die Energie, die ein Elektron aufnimmt, wenn es ein elektrisches Feld der Spannung von 1 Volt durchläuft. Es entspricht etwa 1,6·10⁻¹⁹ J.“"
                                            },
                                            {
                                                "example_id": "79649381-e51e-4949-8053-493f912e169b",
                                                "sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                                                "text": "„Die Energieabstände zwischen elektronischen Zuständen sind am größten und liegen bei einigen Elektronenvolt, die zugehörige Strahlung liegt etwa im sichtbaren Bereich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c9c098-72bc-41eb-b4b5-6f916e98aed1",
                        "source_entry_id": "729aa72a-c4a9-3a7c-85b3-6e9f3a21fc92",
                        "source_sense_id": "973f0043-292a-3079-bf0e-40167019991d",
                        "target_lang_word": "Elektronvolt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektronvolt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "682c7ed9-5262-3123-aa55-222d5476a366",
                                        "entry_id": "152cbc67-d296-31fb-b6d9-3b2a563c75ae",
                                        "glosses": [
                                            "Maßeinheit der Energie, die häufig in der Atomphysik, Kernphysik und Teilchenphysik benutzt wird"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70a4604a-628a-4a18-a6ca-e5280550a1db",
                                                "sense_id": "682c7ed9-5262-3123-aa55-222d5476a366",
                                                "text": "„Ein Elektronvolt ist die Energie, die eine Elementarladung (z. B. ein Elektron) beim Durchlaufen einer Beschleunigungsspannung von 1 Volt erhält.“"
                                            },
                                            {
                                                "example_id": "0702e054-7200-4516-8739-20f855811e7d",
                                                "sense_id": "682c7ed9-5262-3123-aa55-222d5476a366",
                                                "text": "„So ist das Elektronvolt gleichzeitig auch die Einheit der Masse; dadurch wird die Äquivalenz von Masse und Energie besonders deutlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
