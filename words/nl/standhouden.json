                {
                    "sense_id": "1df576e0-b69d-3ea1-9149-baf535739efd",
                    "sense_definition": "weerstand bieden aan druk, aanvallen of moeilijke omstandigheden zonder te bezwijken of op te geven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weerstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude dijken konden tijdens de zware storm ternauwernood <w>standhouden</w> tegen het water.",
                            "target_lang_translations": {
                                "de": "Die alten Deiche konnten während des schweren Sturms dem Wasser kaum <w>standhalten</w>."
                            }
                        },
                        {
                            "text": "Ondanks hevige kritiek van de oppositie <w>hield</w> het kabinet toch <w>stand</w>.",
                            "target_lang_translations": {
                                "de": "Trotz heftiger Kritik der Opposition <w>hielt</w> das Kabinett dennoch <w>stand</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "volhouden",
                        "weerstaan",
                        "overleven"
                    ],
                    "antonyms": [
                        "bezwijken",
                        "opgeven",
                        "vallen"
                    ],
                    "common_phrases": [
                        "moedig standhouden",
                        "tegen de druk standhouden"
                    ],
                    "target_lang_definitions": {
                        "de": "Druck, Angriffen oder schwierigen Umständen trotzen, ohne nachzugeben oder aufzugeben"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "standhalten",
                                "target_lang_sense_clarification": "physischem oder politischem Druck widerstehen"
                            },
                            {
                                "target_lang_word": "durchhalten",
                                "target_lang_sense_clarification": "in einer schwierigen Lage ausharren"
                            },
                            {
                                "target_lang_word": "Widerstand leisten",
                                "target_lang_sense_clarification": "aktiv standhalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47969c56-def5-3dc5-a809-1966a71356ab",
                    "sense_definition": "een mening, theorie of verklaring blijven verdedigen of volhouden dat iets waar is",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte bleef tijdens het hele verhoor koppig <w>standhouden</w> dat hij onschuldig was.",
                            "target_lang_translations": {
                                "de": "Der Verdächtige <w>beharrte</w> während des gesamten Verhörs stur darauf, unschuldig zu sein."
                            }
                        },
                        {
                            "text": "Zij <w>hield</w> tot het einde <w>stand</w> dat haar oorspronkelijke theorie correct was.",
                            "target_lang_translations": {
                                "de": "Sie <w>hielt</w> bis zum Ende daran <w>fest</w>, dass ihre ursprüngliche Theorie korrekt war."
                            }
                        }
                    ],
                    "synonyms": [
                        "volhouden",
                        "bewapenen",
                        "vasthouden"
                    ],
                    "antonyms": [
                        "herroepen",
                        "intrekken"
                    ],
                    "common_phrases": [
                        "bij een mening standhouden"
                    ],
                    "target_lang_definitions": {
