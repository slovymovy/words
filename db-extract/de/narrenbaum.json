                ],
                "senses": [
                    {
                        "sense_id": "eb97cfeb-ca9e-3578-a861-28e129091f3d",
                        "entry_id": "64ab3924-080d-3bb6-8e9e-7674609e1556",
                        "glosses": [
                            "meist verzierter Nadelbaum als Herrschaftssymbol der Narren, welcher während der Zeit der schwäbisch-alemannischen Fasnet üblicherweise auf dem zentralen Platz eines Ortes steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4a766f-3f94-45f0-bffc-8cbb8e69fa4c",
                                "sense_id": "eb97cfeb-ca9e-3578-a861-28e129091f3d",
                                "text": "„Mit einer sehr gut besuchten Feier auf dem Kelterplatz wurde das Symbol der Hexen, der „Narrenbaum“, gestellt und auch ordentlich gefeiert.“"
                            },
                            {
                                "example_id": "e613d01f-d55a-405d-9884-49a3d8bcdd37",
                                "sense_id": "eb97cfeb-ca9e-3578-a861-28e129091f3d",
                                "text": "„Nachdem am Vormittag die Grundschüler befreit wurden, wurde am Nachmittag durch die Zimmerleute der Narrenbaum gestellt.“"
                            },
                            {
                                "example_id": "c99306d4-29f2-4071-8a87-9113aed41d07",
                                "sense_id": "eb97cfeb-ca9e-3578-a861-28e129091f3d",
                                "text": "„Mit lautem \"Schelle-Schelle\"-Rufen und zu den Klängen des Narrenmarsches wird dann von der Bauhofzunft der Narrenbaum umgelegt.“"
                            },
                            {
                                "example_id": "e7514723-79c8-4e7a-8c0b-c4fdf1f66457",
                                "sense_id": "eb97cfeb-ca9e-3578-a861-28e129091f3d",
                                "text": "„Deshalb haben wir uns entschlossen, den Narrenbaum wieder zu entfernen.“"
                            },
                            {
                                "example_id": "2f8b21f8-0c79-4912-ac94-3bf4ebbb9d7a",
                                "sense_id": "eb97cfeb-ca9e-3578-a861-28e129091f3d",
                                "text": "„Mit einem bunten Spektakel ist am Samstag der Narrenbaum auf dem Alten Markt in Lörrach gestellt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
