                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "734c437d-3b38-44fd-b84a-274b9a50f817",
                                "sense_id": "edcc0bd0-a4af-3cb8-ae1c-31b28bdf1dc1",
                                "text": "De helden doen mee aan een door Julius Caesar bedachte wedren die voert langs onder meer Monza, Parma, Venetië, Rome en Napels. De afgesproken winnaar is het Romeinse span van de gemaskerde wagenmenner Coronavirus."
                            },
                            {
                                "example_id": "216c6e66-e25a-48b6-bf75-608cd49534ed",
                                "sense_id": "edcc0bd0-a4af-3cb8-ae1c-31b28bdf1dc1",
                                "text": "Het dier trok een koets, waarop het meisje als wagenmenner op de bok zat. Toen het dier op hol sloeg werd zij van de koets geslingerd."
                            }
                        ]
                    }
