                                        "entry_id": "aefa4a67-cbab-3a56-93fc-3b36123c5588",
                                        "glosses": [
                                            "Remaining in the mind; not easily forgotten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de8c1812-ca55-45fa-8639-03655c8c2add",
                                                "sense_id": "b6a98bbf-2d41-357e-99dd-810e63a99b72",
                                                "text": "He had a haunting gaze."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haunting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63c1afe3-7415-367a-a927-d577a197b04b",
                                        "entry_id": "8429566e-4f09-3db4-a5dc-e357b187874c",
                                        "glosses": [
                                            "A particular instance of haunting; a ghostly habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baea3294-777c-4569-ac65-b62a48d02657",
                                                "sense_id": "63c1afe3-7415-367a-a927-d577a197b04b",
                                                "text": "During the haunting, strange voices and noises were heard and objects flew off tables."
                                            },
                                            {
                                                "example_id": "061c02e8-c328-4f97-a639-20e69e5c0e12",
                                                "sense_id": "63c1afe3-7415-367a-a927-d577a197b04b",
                                                "text": "They [most ghosts] prefer taking trips back to Earth. ... They go and try to assert their ownership of some house that once belonged to them: and then ye get what's called a Haunting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "012fd377-8dd2-4c73-8f65-228ce31b2f43",
                        "source_entry_id": "7a822999-112c-3305-bb95-6fdc1183dc3c",
