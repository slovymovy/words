                "translations": [
                    {
                        "translation_id": "a9143aa0-b3ba-4bf8-8130-385cd2112a1b",
                        "source_entry_id": "d75ca575-a490-3f17-b3a1-fbd55e13422a",
                        "source_sense_id": "68572f86-47b9-3959-9719-53b3005b73ce",
                        "source_sense_description": "österreichisch: weibliche Person, die eine Veranstaltung anschaut",
                        "target_lang_word": "spectator",
