                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kusten elkaar <w>hartstochtelijk</w> toen ze elkaar na jaren weer zagen.",
                            "target_lang_translations": {
