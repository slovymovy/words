                                        "entry_id": "85fe2675-65c9-3b4f-a14a-f762af654db8",
                                        "glosses": [
                                            "Verpackung für Schuhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e63cb66-e46f-435c-bcb4-bbb4d9e1d5b9",
                                                "sense_id": "0fe76dcd-0e93-3570-b214-8a97a46a5713",
                                                "text": "Sie verzichtete darauf, die Schuhschachtel aus dem Schuhladen mitzunehmen."
                                            },
                                            {
                                                "example_id": "f3ae2c9d-f089-4e87-8405-03a8ca315b1b",
                                                "sense_id": "0fe76dcd-0e93-3570-b214-8a97a46a5713",
                                                "text": "„Sie nahm die Schuhschachtel und öffnete sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "039280fa-3f97-461b-870a-5f60d4204d53",
                        "source_entry_id": "1e333ffe-32bd-36fc-9950-6e19be87e9d4",
                        "source_sense_description": "box in which shoes are sold",
                        "target_lang_word": "Schuhkarton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhkarton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                                        "entry_id": "10e4172d-13df-30b5-9a0f-9a2fb2c63539",
                                        "glosses": [
                                            "Verpackung für Schuhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d88562-e7a2-4fc3-a0ee-53d34854fc91",
                                                "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                                                "text": "Als sie vom Einkaufen zurückkamen, warf sie den Schuhkarton in den Müll."
                                            },
                                            {
                                                "example_id": "c86158e4-9692-4aca-a9fd-f7e8725555c3",
                                                "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                                                "text": "„Das Einzige, wovon ich mich seit Jahrzehnten nicht trennen kann, ist ein Schuhkarton mit Briefen, ein paar Fotos und Kirschkernen, die ich an einem heißen Nachmittag im Sommer mit Clara ausgespuckt hatte.“"
                                            },
                                            {
                                                "example_id": "a4a6ed7e-00a1-439a-91ea-b7f0c3c933a7",
                                                "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                                                "text": "„Sie warf ihre Handtasche auf den Stuhl, auf dem noch ein Schuhkarton von der Frau mit dem hellblauen Mantel lag – und die Frau mit dem hellblauen Mantel nahm kopfschüttelnd ihren Karton und ging hinter ihrem Mann her, der zwischen den Tischen stand und dem Serviermädchen die Zeche bezahlte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
