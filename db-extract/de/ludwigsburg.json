                ],
                "senses": [
                    {
                        "sense_id": "9f38a502-4783-3d64-98f6-fbd1ece4a0dd",
                        "entry_id": "d47a09ad-47d0-3893-90b1-9032ae00b73c",
                        "glosses": [
                            "Stadt in Baden-Württemberg, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f6d07d-9dd0-406b-95bd-af736dfc2bc7",
                                "sense_id": "9f38a502-4783-3d64-98f6-fbd1ece4a0dd",
                                "text": "„Der Umzug ins umtriebige Ludwigsburg mochte dem Knaben zunächst wie eine Vertreibung aus dem Paradies vorgekommen sein, doch das änderte sich.“"
                            },
                            {
                                "example_id": "c62a4018-93e0-43ed-bc16-110594830421",
                                "sense_id": "9f38a502-4783-3d64-98f6-fbd1ece4a0dd",
                                "text": "„Zahlreiche Funde aus dem Ludwigsburger Stadtgebiet und der näheren Umgebung sind aus der keltischen Siedlungszeit erhalten geblieben.“"
                            },
                            {
                                "example_id": "b222df85-18ce-462b-bf14-629466127e8a",
                                "sense_id": "9f38a502-4783-3d64-98f6-fbd1ece4a0dd",
                                "text": "„Im Residenzschloss in Ludwigsburg war das Bildnis noch knapp ein Jahrhundert nach seiner Entstehung zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
