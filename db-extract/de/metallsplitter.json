                "senses": [
                    {
                        "sense_id": "914b91ec-94b4-3744-8da4-2a520959037d",
                        "entry_id": "efd70910-7b0c-371c-b2c8-e47a7ea8b5e3",
                        "glosses": [
                            "Splitter aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c24ee1-57c0-4e06-b043-cce3c3c30337",
                                "sense_id": "914b91ec-94b4-3744-8da4-2a520959037d",
                                "text": "„Ein weiterer Mausklick brachte ein paar winzige Metallsplitter auf den Bildschirm.“"
                            },
                            {
                                "example_id": "cb54e48c-5d95-4f81-8991-453e09f26c93",
                                "sense_id": "914b91ec-94b4-3744-8da4-2a520959037d",
                                "text": "„Heiße Metallsplitter und rote Flammen sprühten in alle Richtungen.“"
                            },
                            {
                                "example_id": "e9acf285-b07f-4632-b7ae-1acb5a73707f",
                                "sense_id": "914b91ec-94b4-3744-8da4-2a520959037d",
                                "text": "„In den großen Städten arbeiten die Rechtsmediziner mit Fluoroskop oder Röntgengerät, um die kleinen Metallsplitter aufzuspüren, die die seltsamsten Wege nehmen können.“"
                            },
                            {
                                "example_id": "fbe60fc0-5485-43f3-963e-679e0cca5299",
                                "sense_id": "914b91ec-94b4-3744-8da4-2a520959037d",
                                "text": "„Fontänen aus Sand und Steinen und kleinen Metallsplittern stiegen von der Erde auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
