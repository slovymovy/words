                ],
                "senses": [
                    {
                        "sense_id": "901bbc6c-14f4-3937-beb5-1564b6b116a5",
                        "entry_id": "2ea9d900-4b4b-3b25-8430-032e8fed0112",
                        "glosses": [
                            "свойство или состояние по значению прилагательного непорочный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4b2f10-ca0d-40ef-86fc-d1a2353a2566",
                                "sense_id": "901bbc6c-14f4-3937-beb5-1564b6b116a5",
                                "text": "И тогда Бог послал своего первородного сына, Иисуса, чтобы тот научил людей истине о Боге, сохранив совершенную непорочность, показал людям пример, и пожертвовал свою жизнь, чтобы освободить человечество от греха и смерти."
                            }
                        ]
                    },
                    {
                        "sense_id": "181a1851-2d24-3ba7-8263-9319d7e36f22",
                        "entry_id": "2ea9d900-4b4b-3b25-8430-032e8fed0112",
                        "glosses": [
                            "девственность, целомудрие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584f823d-6f2e-427d-ac2d-2444e63ae9f3",
                                "sense_id": "181a1851-2d24-3ba7-8263-9319d7e36f22",
                                "text": "Она бросилась в его объятия — и в сей час надлежало погибнуть непорочности!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6493329d-c7e9-4b37-9cee-51901abf4c38",
                        "source_entry_id": "2ea9d900-4b4b-3b25-8430-032e8fed0112",
                        "source_sense_description": "девственность, целомудрие",
                        "target_lang_word": "chastity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chastity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6b30290-9622-3eef-83c1-2aa051d8cf20",
                                        "entry_id": "a0fdc1b1-63af-3178-809e-25b91fbcf619",
                                        "glosses": [
                                            "The quality of being chaste: the state of abstaining from any sexual activity considered immoral; avoidance of sexual sins."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36e32d67-f117-44a2-817a-3e227d210ab9",
                                                "sense_id": "a6b30290-9622-3eef-83c1-2aa051d8cf20",
                                                "text": "The monk took a vow of chastity."
                                            },
                                            {
                                                "example_id": "5d846943-0e12-44cc-9abd-8de0a04aeed0",
                                                "sense_id": "a6b30290-9622-3eef-83c1-2aa051d8cf20",
                                                "text": "vow of chastity"
                                            },
                                            {
                                                "example_id": "a70008b0-f8c9-46ad-95c3-41488dd9aa8c",
                                                "sense_id": "a6b30290-9622-3eef-83c1-2aa051d8cf20",
                                                "text": "virtue and chastity"
                                            },
                                            {
                                                "example_id": "147d0c82-2280-4afe-a2f5-108da095c4ef",
                                                "sense_id": "a6b30290-9622-3eef-83c1-2aa051d8cf20",
                                                "text": "In Catholic doctrine, the virtue of chastity is taken to be the principal foil to everyone's favourite deadly sin, lust."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
