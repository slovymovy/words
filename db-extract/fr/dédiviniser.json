                "senses": [
                    {
                        "sense_id": "0dc1143d-37d8-3a3c-87a6-0161e127ae30",
                        "entry_id": "c415b0bd-21ca-34ff-8834-bab2032db26b",
                        "glosses": [
                            "Faire perdre son caractère divin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1ec7a3-3b93-48d0-94e6-5e57c9184117",
                                "sense_id": "0dc1143d-37d8-3a3c-87a6-0161e127ae30",
                                "text": "Cette mentalité a évité de dédiviniser le temps."
                            },
                            {
                                "example_id": "bb8eba31-cca6-45fd-97ad-71314d70deca",
                                "sense_id": "0dc1143d-37d8-3a3c-87a6-0161e127ae30",
                                "text": "Mais Nietzsche, et surtout Freud, explique Rorty, ont mis en miettes cette image kantienne de l'être humain et sont parvenus à dédiviniser le soi."
                            },
                            {
                                "example_id": "ce74f897-c5f5-49d6-83d2-22f88d4515a5",
                                "sense_id": "0dc1143d-37d8-3a3c-87a6-0161e127ae30",
                                "text": "La philosophie va s’assimiler à l’homme et se dédiviniser."
                            }
                        ]
                    }
                ],
