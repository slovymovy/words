                "senses": [
                    {
                        "sense_id": "4738beaf-c0ec-39ab-87d0-018e2d4a93bb",
                        "entry_id": "2cb4e507-65d3-3bd1-91a3-35daa2d09987",
                        "glosses": [
                            "Donner un caractère asymptotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f685016-f645-4001-9e07-3b60570759ca",
                                "sense_id": "4738beaf-c0ec-39ab-87d0-018e2d4a93bb",
                                "text": "Il ne faut pas asymptotiser le débat sur la laïcité."
                            },
                            {
                                "example_id": "a8cbb1f0-00eb-47bd-8f37-b09a86e31a5a",
                                "sense_id": "4738beaf-c0ec-39ab-87d0-018e2d4a93bb",
                                "text": "De toute façon la hotline de Pinnacle France asymptotise le nul."
                            },
                            {
                                "example_id": "ab452303-027f-4b74-a4d0-6bba4ff8e1d1",
                                "sense_id": "4738beaf-c0ec-39ab-87d0-018e2d4a93bb",
                                "text": "Ce restant finit par s'asymptotiser, c'est un terme barbare pour dire que même si la conversion avance vite, il y a une limite à cela."
                            }
                        ]
                    }
