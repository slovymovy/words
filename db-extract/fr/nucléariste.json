                        "entry_id": "da7b7063-1db8-3f58-a405-fec6a66a793b",
                        "glosses": [
                            "Qui est pour l’utilisation de l’énergie ou de l’armement nucléaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e04d309-ebe3-4b93-b2ba-ffa075f5e73d",
                                "sense_id": "91c50f8e-ed16-3fe2-8a08-166ea91fe6d8",
                                "text": "Assez ouverte et crédible pour discuter avec les « anti », suffisamment pro-nucléaire pour rassurer un Parti socialiste majoritairement nucléariste."
                            }
                        ]
                    }
                ],
