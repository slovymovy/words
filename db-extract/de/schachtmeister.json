                    {
                        "sense_id": "162150f7-88cc-3784-ad7a-ef835dc94de8",
                        "entry_id": "b84db7c6-4f63-3273-b2c8-f0fdd24602dc",
                        "glosses": [
                            "Vorarbeiter in einer Arbeitsgruppe, die Ausschachtungen vornimmt, zum Beispiel Gruben aushebt"
                        ],
                        "tags": [
                            "Tiefbau"
                        ],
                        "examples": [
                            {
                                "example_id": "96f4507e-a79a-49b2-8901-23307a866b30",
                                "sense_id": "162150f7-88cc-3784-ad7a-ef835dc94de8",
                                "text": "„In der Regel werden die Arbeiten einem Schachtmeister übertragen, welcher sich die zur Ausführung erforderlichen Leute wählt und solche so anzustellen hat, dass eine den Vorschriften gemässe, gut von Statten gehende Arbeit erzielt wird.“ (1880)"
                            },
                            {
                                "example_id": "d2af7df4-ac0d-4273-8609-113fe229366e",
                                "sense_id": "162150f7-88cc-3784-ad7a-ef835dc94de8",
                                "text": "„Schachtmeister/innen im Straßenbau stellen sicher, dass die Arbeiten auf der Baustelle fachgerecht, betriebswirtschaftlich durchdacht und effizient ablaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
