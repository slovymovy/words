                "senses": [
                    {
                        "sense_id": "5a142917-fafb-3487-9bb9-376872d40666",
                        "entry_id": "d9979882-c5ae-32c9-9005-11d03bbfcbd9",
                        "glosses": [
                            "Handlungen/Tätigkeiten, die etwas entscheidend voranbringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e5f9d4-d6ac-4478-b852-c859da2b3813",
                                "sense_id": "5a142917-fafb-3487-9bb9-376872d40666",
                                "text": "„Am Institut für chemische Physik in Leningrad führten Julij B. Chariton und Jakow B. Seldowitsch (die nach dem Krieg gemeinsam mit Andrej Sacharow das sowjetische Projekt zum Bau der Wasserstoffbombe leiteten) Pionierarbeiten zur Untersuchung der Kettenreaktion in Natururan durch, die sie auch veröffentlichten.“"
                            },
                            {
                                "example_id": "3bc2a31a-4d59-4a7e-8048-03d9e2fb533b",
                                "sense_id": "5a142917-fafb-3487-9bb9-376872d40666",
                                "text": "„Wir haben mit Stern und Bühler auf zwei Kinderpsychologen hinweisen wollen, die Pionierarbeit geleistet haben, in den Übersichtsarbeiten aber nicht selten übergangen werden.“"
                            },
                            {
                                "example_id": "fcab2e3f-ba7c-4b85-a886-eb6ede263ec9",
                                "sense_id": "5a142917-fafb-3487-9bb9-376872d40666",
                                "text": "„Hier war allerdings Pionierarbeit zu leisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
