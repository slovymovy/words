                        ],
                        "form": "die Bienenvölker"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "768a74f8-76dd-39c1-b6aa-d0f2069c3acd",
                        "entry_id": "8d1b33ca-928a-3b42-bf5c-40b7e5166222",
                        "glosses": [
                            "organisierte Ansammlung von Bienen, mit einer eierlegenden Bienenkönigin und Arbeitsbienen, die für die Aufzucht des Nachwuchs, der Verteidigung der Anlage und für die Nahrung zuständig sind"
                        ],
                        "tags": [
                            "Imkerei"
                        ],
                        "examples": [
                            {
                                "example_id": "3e672497-584a-46c5-b6d2-62e8c7d6d64b",
                                "sense_id": "768a74f8-76dd-39c1-b6aa-d0f2069c3acd",
                                "text": "Allen Bienenvölkern ist gemein, die Königin legt die Eier."
                            },
                            {
                                "example_id": "6d293649-c722-43dd-8c0b-89bf76c281fa",
                                "sense_id": "768a74f8-76dd-39c1-b6aa-d0f2069c3acd",
                                "text": "„Die meiste Zeit des Jahres besteht das Bienenvolk nur aus weiblichen Bienen: aus der Königin und den Arbeiterinnen, die Honig sammeln, die Larven aufziehen und den Stock verteidigen.“"
                            },
                            {
                                "example_id": "8eca3112-c7b4-4aa7-b4bc-11104d03f3e6",
                                "sense_id": "768a74f8-76dd-39c1-b6aa-d0f2069c3acd",
                                "text": "„Wenn die Kiste schon länger in Betrieb war, oder wenn man unsicher ist über die Todesursache des Bienenvolkes, muss sie zusätzlich ausgeflammt werden.“"
                            },
                            {
                                "example_id": "95428eee-976c-4998-8a3a-a47e2d3017c9",
                                "sense_id": "768a74f8-76dd-39c1-b6aa-d0f2069c3acd",
                                "text": "„Die Grundbedürfnisse eines Bienenvolkes sind Wohnraum für den Wabenbau, eine ausreichende Futterversorgung und eine Wasserstelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2774e97-490a-4f9c-bde7-1f7a6ed9f86b",
                        "source_entry_id": "8d1b33ca-928a-3b42-bf5c-40b7e5166222",
                        "source_sense_id": "768a74f8-76dd-39c1-b6aa-d0f2069c3acd",
                        "source_sense_description": "organisierte Ansammlung von Bienen, mit einer eierlegenden Bienenkönigin und Arbeitsbienen",
                        "target_lang_word": "bee colony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4decd7cf-e0e7-41cc-8131-95c5f8a32db8",
                        "source_entry_id": "8d1b33ca-928a-3b42-bf5c-40b7e5166222",
                        "source_sense_id": "768a74f8-76dd-39c1-b6aa-d0f2069c3acd",
                        "source_sense_description": "organisierte Ansammlung von Bienen, mit einer eierlegenden Bienenkönigin und Arbeitsbienen",
                        "target_lang_word": "ruche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e658bdfb-1761-3f98-9a7b-cecaab35bfd7",
                                        "entry_id": "224b60c2-25a9-3ba9-9272-cd1b9c831d50",
                                        "glosses": [
                                            "Sorte de contenant où logent les abeilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b23af6-9ed4-493d-b637-220f8f705270",
                                                "sense_id": "e658bdfb-1761-3f98-9a7b-cecaab35bfd7",
                                                "text": "De cette façon, ils ne perdirent pas de vue les abeilles chargées et après une heure d’une poursuite des plus difficiles, ils les virent arriver à leur ruche pratiquée dans le creux d’un ébénier mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30502d52-f814-3c8b-865f-92d31533c6a7",
                                        "entry_id": "224b60c2-25a9-3ba9-9272-cd1b9c831d50",
                                        "glosses": [
                                            "Ce contenant, avec les abeilles qui sont dedans."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8faea38-3194-4e0d-bc3f-377b03928506",
                                                "sense_id": "30502d52-f814-3c8b-865f-92d31533c6a7",
                                                "text": "Tout contre le mur, à l’endroit où le toit de la maison touchait presque la terre, un rucher s’adossait, vermoulu, à demi effondré. Des pousses de coudrier l’étayaient, qui se couvraient en cette saison de chatons jaunâtres, pareils à des chenilles. Des ruches pourrissaient sur les rayons de bois : une pourtant, toute neuve, était pleine d’une rumeur bourdonnante."
                                            },
                                            {
                                                "example_id": "c6154c07-b9af-4716-8d9b-57a0f4d4feba",
                                                "sense_id": "30502d52-f814-3c8b-865f-92d31533c6a7",
                                                "text": "Le rucher se composait de 75 ruches avec 10 à 12 k. d’abeilles. La récolte se faisait sur une petite bruyère, dite la grelotteuse (Erica cinerea). Le miel récolté était si clair, que le fond du seau en était visible."
                                            },
                                            {
                                                "example_id": "a8db0e45-5fe8-4759-a3b2-c134b620175f",
                                                "sense_id": "30502d52-f814-3c8b-865f-92d31533c6a7",
                                                "text": "Malgré l’heure matinale, l’université bourdonnait comme une ruche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b10ee90-61b5-37fa-91ef-c704e27184cd",
                                        "entry_id": "224b60c2-25a9-3ba9-9272-cd1b9c831d50",
                                        "glosses": [
                                            "Bande plissée d’étoffe, de tulle ou de dentelle qui sert d’ornement à différents ajustements dans la toilette des femmes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf0089c7-e88c-4957-97cb-d459577c3b9c",
                                                "sense_id": "9b10ee90-61b5-37fa-91ef-c704e27184cd",
                                                "text": "Julie tendit son cou à son mari, qui s’avança pour l’embrasser ; mais la marquise se baissa de telle sorte que le baiser conjugal glissa sur la ruche de sa pèlerine."
                                            },
                                            {
                                                "example_id": "3e9e4983-54a8-4eea-b6fc-a9692bb50216",
                                                "sense_id": "9b10ee90-61b5-37fa-91ef-c704e27184cd",
                                                "text": "De l’autre côté de la rue, juste en face de ma fenêtre et au premier étage aussi, demeurait une bonne vieille fille appelée mademoiselle Victoire (avec de grands bonnets à ruche du temps passé et des lunettes rondes)."
                                            },
                                            {
                                                "example_id": "2cd6e8fa-34bd-4c1d-be80-70d42104975d",
                                                "sense_id": "9b10ee90-61b5-37fa-91ef-c704e27184cd",
                                                "text": "Elle garde son chapeau de jardin roussi par trois étés, à grands bords, à petit fond cravaté d’une ruche marron, et son tablier de jardinière, dont le bec busqué du sécateur a percé une poche."
                                            },
                                            {
                                                "example_id": "4f27d059-1e2b-45d4-9e7c-4f56552eb82f",
                                                "sense_id": "9b10ee90-61b5-37fa-91ef-c704e27184cd",
                                                "text": "Le dossier du lit d’acajou se détache sur les drapés du ciel de lit, avec, entrevu à gauche, un segment d’une autre couche toute pareille, soigneusement recouverte de sa courtepointe à ruches, et dans laquelle cette nuit-là personne assurément n’a dormi."
                                            },
                                            {
                                                "example_id": "f8423830-490d-4f0f-b055-4ac339a0586f",
                                                "sense_id": "9b10ee90-61b5-37fa-91ef-c704e27184cd",
                                                "text": "En robe grise et verte avec des ruches,\nUn jour de juin que j’étais soucieux,\nElle apparut souriante à mes yeux\nQui l’admiraient sans redouter d’embûches […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ce87930-a12c-3c80-824b-96f0c9fa036d",
                                        "entry_id": "224b60c2-25a9-3ba9-9272-cd1b9c831d50",
                                        "glosses": [
                                            "Foule de personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db66a2bf-0042-4eea-aa18-deafd1b2b33e",
                                                "sense_id": "7ce87930-a12c-3c80-824b-96f0c9fa036d",
                                                "text": "Ce matin-là, le centre névralgique du régime est une véritable ruche. Toutes les divisions du ministère de la Sécurité d’État sont sur la brèche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec9f4bee-d66c-33cc-aa2f-97ac5400ba88",
                                        "entry_id": "224b60c2-25a9-3ba9-9272-cd1b9c831d50",
                                        "glosses": [
                                            "Grande agglomération, centre habité par une population nombreuse et active."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b20ac085-da46-4c8e-b7f5-da2911187f71",
                                                "sense_id": "ec9f4bee-d66c-33cc-aa2f-97ac5400ba88",
                                                "text": "Joigny-sur-Meuse, petit village tranquille et coquet qui fait suite à Nouzon, n'est pas industriel. Il contraste agréablement au milieu de sa ceinture de rochers, avec les ruches ouvrières voisines, Nouzon et Braux, bruyantes et animées."
                                            },
                                            {
                                                "example_id": "10c011cb-d0b4-4e91-9521-ef7b9127ecd7",
                                                "sense_id": "ec9f4bee-d66c-33cc-aa2f-97ac5400ba88",
                                                "text": "L’Écosse l’attendait bouche bée. Il arriva à Glasgow vers une heure, et l’on raconte que le travail ne fut pas repris avant deux heures et demie dans les docks et les manufactures de cette ruche industrielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d243a26-7ec8-30f5-b211-fe6ad816eeac",
                                        "entry_id": "224b60c2-25a9-3ba9-9272-cd1b9c831d50",
                                        "glosses": [
                                            "Coiffure ruche, coiffure de femme qui ressemble à une ruche (cheveux longs et allongés)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ff8f7f3-5c3e-3170-8586-a98c6d095f1d",
                                        "entry_id": "224b60c2-25a9-3ba9-9272-cd1b9c831d50",
                                        "glosses": [
                                            "Paraphe compliqué généralement formé d’entrelacs et démontrant l’habilité du signataire à maîtriser l’écriture à la plume."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
