                                "example_id": "a415f125-d077-472a-a24c-abfec82fbf38",
                                "sense_id": "b25f89cb-9d8f-3865-b5d3-f7f4ce475bce",
                                "text": "Der US-amerikanische Bundesstaat Florida will die papierlosen elektronischen Wahlmaschinen abschaffen, berichtet die New York Times."
                            },
                            {
                                "example_id": "2f7ea6ac-bd25-4fa8-986f-1b549095cbed",
                                "sense_id": "b25f89cb-9d8f-3865-b5d3-f7f4ce475bce",
                                "text": "„Popsänger Timberlake war extra in seinen Heimatstaat Tennessee geflogen um seine Stimme abzugeben und wollte mit seinem Selfie an der Wahlmaschine offenbar dafür werben, zur Wahl zu gehen.“"
                            }
                        ],
