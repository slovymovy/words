{
    "word_family": [
        "stabber"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "faf11c67-0c8c-3ff0-bca1-525645f91c49",
                    "sense_definition": "To injure or kill someone by pushing a sharp, pointed object, such as a knife, into their body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective concluded that the victim had been <w>stabbed</w> with a kitchen knife.",
                            "target_lang_translations": {
                                "ru": "Детектив пришел к выводу, что жертву <w>закололи</w> кухонным ножом.",
                                "zh": "侦探断定受害者是被一把菜刀<w>刺伤</w>的。"
                            }
                        },
                        {
                            "text": "He threatened to <w>stab</w> anyone who tried to stop him from escaping.",
                            "target_lang_translations": {
                                "ru": "Он угрожал <w>пырнуть</w> любого, кто попытается помешать ему сбежать.",
                                "zh": "他威胁说要<w>捅</w>死任何试图阻止他逃跑的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pierce",
                        "gore",
                        "stick",
                        "puncture",
                        "knife",
                        "wound"
                    ],
                    "common_phrases": [
                        "stab to death",
                        "stab in the back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранить или убить кого-то, вонзая в тело острый предмет, например нож.",
                        "zh": "用刀等尖锐物体刺入身体，导致他人受伤或死亡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заколоть",
                                "target_lang_sense_clarification": "убить или тяжело ранить колющим оружием"
                            },
                            {
                                "target_lang_word": "пырнуть",
                                "target_lang_sense_clarification": "разг. нанести быстрый удар ножом или острым предметом"
                            },
                            {
                                "target_lang_word": "ударить ножом",
                                "target_lang_sense_clarification": "нанести ранение ножом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺伤",
                                "target_lang_sense_clarification": "用尖锐物体造成伤害"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "用尖锐物体猛力戳刺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "810e354c-d360-3f33-a2e5-a2b39ee76ad7",
                    "sense_definition": "To make a quick, forward thrusting motion towards someone or something with a pointed object or finger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motion_gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>stabbed</w> at the salad with her fork, trying to pick up a cherry tomato.",
                            "target_lang_translations": {
                                "ru": "Она <w>тыкала</w> вилкой в салат, пытаясь подцепить помидор черри.",
                                "zh": "她用叉子在沙拉里<w>戳</w>来戳去，试图叉起一颗圣女果。"
                            }
                        },
                        {
                            "text": "The angry man <w>stabbed</w> his finger at the map to show us where to go.",
                            "target_lang_translations": {
                                "ru": "Сердитый мужчина <w>ткнул</w> пальцем в карту, чтобы показать нам, куда идти.",
                                "zh": "那个愤怒的男人用手指<w>戳</w>着地图，告诉我们该往哪儿走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thrust",
                        "jab",
                        "poke",
                        "lunge"
                    ],
                    "common_phrases": [
                        "stab at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать быстрое, резкое движение в сторону кого-то или чего-то острым предметом или пальцем.",
                        "zh": "用尖锐物体或手指快速、用力地向某人或某物戳去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыкать",
                                "target_lang_sense_clarification": "совершать повторяющиеся резкие движения"
                            },
                            {
                                "target_lang_word": "ткнуть",
                                "target_lang_sense_clarification": "сделать однократное резкое движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "用手指或尖物触碰"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "用尖物向某处快速刺探"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28624b26-cb76-3838-8916-6f48392f7ac5",
                    "sense_definition": "To cause a sudden, sharp, and intense physical or emotional pain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden feeling of guilt <w>stabbed</w> at her conscience when she told the lie.",
                            "target_lang_translations": {
                                "ru": "Внезапное чувство вины <w>пронзило</w> её совесть, когда она солгала.",
                                "zh": "当她说谎时，一阵负罪感<w>刺痛</w>了她的良心。"
                            }
                        },
                        {
                            "text": "The icy wind <w>stabbed</w> my face as soon as I stepped out of the warm house.",
                            "target_lang_translations": {
                                "ru": "Ледяной ветер <w>заколол</w> мне лицо, как только я вышел из теплого дома.",
                                "zh": "我刚走出温暖的屋子，冰冷的风就如针般<w>刺</w>向我的脸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pierce"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically for emotions or weather"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять внезапную, острую физическую или душевную боль.",
                        "zh": "引起突然、尖锐的身体疼痛或强烈的情感冲击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронзить",
                                "target_lang_sense_clarification": "перен. о сильной боли или чувстве"
                            },
                            {
                                "target_lang_word": "колоть",
                                "target_lang_sense_clarification": "вызывать ощущение укола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺痛",
                                "target_lang_sense_clarification": "引起突然的剧烈疼痛"
                            },
                            {
                                "target_lang_word": "刺入",
                                "target_lang_sense_clarification": "比喻情感或感觉像针扎一样"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4f4b5d3-59c6-330b-a321-0eaa2df9640f",
                    "sense_definition": "A quick thrust or blow with a pointed object or weapon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a violent <w>stab</w> of his dagger, the villain cut the rope holding the bridge.",
                            "target_lang_translations": {
                                "ru": "Сильным <w>ударом</w> кинжала злодей перерезал веревку, удерживающую мост.",
                                "zh": "恶棍用匕首猛地一<w>刺</w>，割断了固定桥梁的绳子。"
                            }
                        },
                        {
                            "text": "The fencer made a quick <w>stab</w> at his opponent but missed the target.",
                            "target_lang_translations": {
                                "ru": "Фехтовальщик сделал быстрый <w>выпад</w> в сторону противника, но промахнулся.",
                                "zh": "击剑手向对手发起了一次快速<w>刺</w>击，但没击中目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thrust",
                        "jab",
                        "lunge",
                        "blow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый выпад или удар острым предметом или оружием.",
                        "zh": "用尖锐物体或武器进行的快速刺击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "резкое действие оружием"
                            },
                            {
                                "target_lang_word": "укол",
                                "target_lang_sense_clarification": "в фехтовании или при легком ранении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺",
                                "target_lang_sense_clarification": "用尖物猛力一击"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "快速的戳刺动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7966fae1-7bfa-37b6-9071-52cb0100b397",
                    "sense_definition": "A physical wound or injury caused by a sharp, pointed weapon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor treated the deep <w>stab</w> in the patient's shoulder immediately.",
                            "target_lang_translations": {
                                "ru": "Врач немедленно обработал глубокую <w>колотую рану</w> на плече пациента.",
                                "zh": "医生立即处理了病人肩膀上那道深深的<w>刺伤</w>。"
                            }
                        },
                        {
                            "text": "Police examined the <w>stab</w> on the victim's arm to determine the type of weapon used.",
                            "target_lang_translations": {
                                "ru": "Полиция осмотрела <w>рану</w> на руке жертвы, чтобы определить тип использованного оружия.",
                                "zh": "警方检查了受害者手臂上的<w>刺伤</w>，以确定所使用的武器类型。"
                            }
                        }
                    ],
                    "synonyms": [
                        "puncture",
                        "wound"
                    ],
                    "common_phrases": [
                        "stab wound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая рана или повреждение, нанесенное острым оружием.",
                        "zh": "由尖锐武器造成的身体伤口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колотая рана",
                                "target_lang_sense_clarification": "медицинский и криминалистический термин"
                            },
                            {
                                "target_lang_word": "рана",
                                "target_lang_sense_clarification": "общее название повреждения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺伤",
                                "target_lang_sense_clarification": "指代伤口本身"
                            },
                            {
                                "target_lang_word": "刀伤",
                                "target_lang_sense_clarification": "特指由刀具造成的伤口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7431c180-126c-3373-8151-91b7fb388588",
                    "sense_definition": "An attempt to do something, often something difficult or unfamiliar.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to have a <w>stab</w> at fixing the broken toaster myself.",
                            "target_lang_translations": {
                                "ru": "Я решил предпринять <w>попытку</w> починить сломанный тостер сам.",
                                "zh": "我决定自己<w>尝试</w>修理那个坏掉的烤面包机。"
                            }
                        },
                        {
                            "text": "Even though he didn't know the answer, he took a <w>stab</w> at guessing it.",
                            "target_lang_translations": {
                                "ru": "Хотя он и не знал ответа, он сделал <w>попытку</w> угадать.",
                                "zh": "尽管他不知道答案，他还是<w>尝试</w>猜了一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attempt",
                        "try",
                        "shot",
                        "go",
                        "crack"
                    ],
                    "common_phrases": [
                        "have a stab at",
                        "take a stab at"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal British and American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка сделать что-то, часто что-то сложное или незнакомое.",
                        "zh": "尝试做某事，通常指困难或不熟悉的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "действие с целью осуществления чего-либо"
                            },
                            {
                                "target_lang_word": "проба",
                                "target_lang_sense_clarification": "первичное испытание сил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尝试",
                                "target_lang_sense_clarification": "进行一次努力"
                            },
                            {
                                "target_lang_word": "试一试",
                                "target_lang_sense_clarification": "口语化的尝试"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86b74369-4f86-34e8-94b9-b907c3cce143",
                    "sense_definition": "A sudden, sharp feeling of pain or strong emotion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>stab</w> of jealousy when she saw her ex-boyfriend with someone else.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапный <w>укол</w> ревности, когда увидела своего бывшего парня с другой.",
                                "zh": "当看到前男友和别人在一起时，她感到<w>一阵</w>嫉妒。"
                            }
                        },
                        {
                            "text": "A sharp <w>stab</w> of pain shot through his lower back when he lifted the box.",
                            "target_lang_translations": {
                                "ru": "Острый <w>приступ</w> боли пронзил его поясницу, когда он поднял коробку.",
                                "zh": "他搬起箱子时，腰部传来<w>一阵</w>剧痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pang",
                        "twinge",
                        "prick"
                    ],
                    "common_phrases": [
                        "stab of pain",
                        "stab of guilt",
                        "stab of fear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, острое чувство боли или сильной эмоции.",
                        "zh": "突然、尖锐的疼痛感或强烈的情绪波动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укол",
                                "target_lang_sense_clarification": "перен. о внезапном чувстве (ревности, совести)"
                            },
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "резкое проявление боли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一阵",
                                "target_lang_sense_clarification": "用于形容突如其来的感觉"
                            },
                            {
                                "target_lang_word": "刺痛",
                                "target_lang_sense_clarification": "形容突发的剧烈感受"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}