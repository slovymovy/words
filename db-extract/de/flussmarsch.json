                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc1764d-34a0-4450-a39c-731bb8fb2617",
                                "sense_id": "dd52fa3a-6440-3a5b-aab4-8eea12466f7f",
                                "text": "„Der moorige Boden taugte wenig für die Ackerwirtschaft, man nutzte dafür die fetten Finger, die die Flussmarsch hier und da ins Moor streckte.“"
                            },
                            {
                                "example_id": "be42d6f8-5960-479d-8577-625df8c167ae",
                                "sense_id": "dd52fa3a-6440-3a5b-aab4-8eea12466f7f",
                                "text": "„Die Flussmarsch der Ems bot hier sehr günstige Voraussetzungen für die Entwicklung einer eigenständigen Backsteinproduktion, die eine Einfuhr von Natursteinen erübrigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
