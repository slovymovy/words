{
    "word_family": [
        "idiosyncratic",
        "idiosyncratically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba5a9d87-0f3f-371e-86e2-b008f4bfc849",
                    "sense_definition": "A behavior, habit, or way of thinking that is peculiar or characteristic of an individual.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personal_peculiarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One of his personal <w>idiosyncrasies</w> was that he always had to wear mismatched socks.",
                            "target_lang_translations": {
                                "de": "Eine seiner persönlichen <w>Eigenheiten</w> war, dass er immer ungleiche Socken tragen musste."
                            }
                        },
                        {
                            "text": "She tolerated her husband's little <w>idiosyncrasies</w> because she loved him dearly.",
                            "target_lang_translations": {
                                "de": "Sie tolerierte die kleinen <w>Marotten</w> ihres Mannes, weil sie ihn von Herzen liebte."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentricity",
                        "foible",
                        "mannerism",
                        "quirk",
                        "oddity"
                    ],
                    "common_phrases": [
                        "personal idiosyncrasies",
                        "charming idiosyncrasy"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Verhaltensweise, Angewohnheit oder Denkweise, die für eine Person eigentümlich oder charakteristisch ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Eigenheit",
                                "target_lang_sense_clarification": "persönliche Verhaltensweise oder Marotte"
                            },
                            {
                                "target_lang_word": "Eigenart",
                                "target_lang_sense_clarification": "individuelle Besonderheit"
                            },
                            {
                                "target_lang_word": "Marotte",
                                "target_lang_sense_clarification": "schrullige oder sonderbare Angewohnheit"
                            },
                            {
                                "target_lang_word": "Idiosynkrasie",
                                "target_lang_sense_clarification": "gehoben oder bildungssprachlich für eine ausgeprägte persönliche Eigenart"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44e0b795-2dfe-3157-be1a-e5dfa20f98d9",
                    "sense_definition": "A distinctive or peculiar feature of a system, language, or thing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "system_peculiarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He mastered the <w>idiosyncrasies</w> of English spelling and speech after years of study.",
                            "target_lang_translations": {
                                "de": "Nach jahrelangem Lernen beherrschte er die <w>Eigenheiten</w> der englischen Rechtschreibung und Aussprache."
                            }
                        },
                        {
                            "text": "Every programming language has its own <w>idiosyncrasies</w> that developers must learn to navigate.",
                            "target_lang_translations": {
                                "de": "Jede Programmiersprache hat ihre eigenen <w>Besonderheiten</w>, mit denen Entwickler umzugehen lernen müssen."
                            }
                        }
                    ],
                    "synonyms": [
                        "quirk",
                        "oddity"
                    ],
                    "common_phrases": [
                        "idiosyncrasies of the language",
                        "system idiosyncrasy"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kennzeichnendes oder eigentümliches Merkmal eines Systems, einer Sprache oder einer Sache."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Besonderheit",
                                "target_lang_sense_clarification": "spezifisches Merkmal eines Systems oder einer Sache"
                            },
                            {
                                "target_lang_word": "Eigenart",
                                "target_lang_sense_clarification": "charakteristische Eigentümlichkeit"
                            },
                            {
                                "target_lang_word": "Eigenheit",
                                "target_lang_sense_clarification": "spezifisches Merkmal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369c24da-5f4f-324e-85d9-9bd21e3b1c88",
                    "sense_definition": "An abnormal or peculiar physical reaction by an individual to a drug or chemical.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_peculiarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient's severe reaction to the mild sedative was diagnosed as a drug <w>idiosyncrasy</w>.",
                            "target_lang_translations": {
                                "de": "Die schwere Reaktion des Patienten auf das milde Beruhigungsmittel wurde als Arzneimittel-<w>Idiosynkrasie</w> diagnostiziert."
                            }
                        },
                        {
                            "text": "Doctors must monitor patients closely for any unexpected <w>idiosyncrasy</w> when administering new medication.",
                            "target_lang_translations": {
                                "de": "Ärzte müssen Patienten bei der Verabreichung neuer Medikamente genau auf unerwartete <w>Überempfindlichkeiten</w> hin überwachen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drug idiosyncrasy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical medical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine anormale oder eigentümliche körperliche Überempfindlichkeit bzw. Reaktion auf ein Medikament oder eine chemische Substanz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Idiosynkrasie",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff für angeborene Überempfindlichkeit"
                            },
                            {
                                "target_lang_word": "Überempfindlichkeit",
                                "target_lang_sense_clarification": "abnorme körperliche Reaktion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}