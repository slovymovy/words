                                        "entry_id": "0ce39b8c-6482-30b5-b2b6-f99ae2cfbef8",
                                        "glosses": [
                                            "An island of Greece, one of the Ionian Islands. The ancient name is Corcyra (Κόρκῡρα (Kórkūra), more often Κέρκῡρα (Kérkūra)), in Modern Greek Kérkira (Κέρκυρα (Kérkyra))."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8c5975-71d2-4870-b2bc-e21a122f10b3",
                                                "sense_id": "4ee258fc-08ea-38ce-9019-7f3565906087",
                                                "text": "Magazines kept aristocrats on the payroll to facilitate access to jet-set playgrounds like Corfu and Mustique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba38cea3-cd25-36fd-9de6-5d68ebb9ef53",
                                        "entry_id": "0ce39b8c-6482-30b5-b2b6-f99ae2cfbef8",
                                        "glosses": [
                                            "The capital of Corfu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
