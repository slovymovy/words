                "senses": [
                    {
                        "sense_id": "e5543ed2-fab3-3dd7-9612-aa31f2c4a428",
                        "entry_id": "b85de3e7-7c85-383a-af02-f6d90cb5325d",
                        "glosses": [
                            "Rendre moins dense, éclaircir (un texte, en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd03d3c-8867-443e-9610-febb3b3e3b9f",
                                "sense_id": "e5543ed2-fab3-3dd7-9612-aa31f2c4a428",
                                "text": "Je sais par avance que tu aimeras...et je pense à désétoffer mes écrits dans ce sens, aux fins de clarifier les idées qui me viennent"
                            },
                            {
                                "example_id": "cb194390-ef18-4646-b859-eea6e487ca45",
                                "sense_id": "e5543ed2-fab3-3dd7-9612-aa31f2c4a428",
                                "text": "Il faudrait qu'ils le 'désétoffent' au fur et à mesure et en fonction des spécificités de chaque langue aussi."
                            },
                            {
                                "example_id": "9388f167-0f35-41ab-a34a-ad3c76580a4e",
                                "sense_id": "e5543ed2-fab3-3dd7-9612-aa31f2c4a428",
                                "text": "c'est vrai qu'au bout de la journée les cils se \"désétoffent\", dommage!"
                            }
                        ]
