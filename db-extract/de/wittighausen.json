                "senses": [
                    {
                        "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                        "entry_id": "6eb07666-df4a-32ec-88a9-e0be9d27579c",
                        "glosses": [
                            "Gemeinde im Main-Tauber-Kreis im Nordosten Baden-Württembergs, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "266191e7-9aa9-4fa7-a13a-0b29f17ea832",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "Wittighausen liegt im nordöstlichsten Zipfel Baden-Württembergs."
                            },
                            {
                                "example_id": "7fee4556-57d1-4616-b6ed-d51e0991f647",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "Durch Wittighausen fließt der Wittigbach."
                            },
                            {
                                "example_id": "8c89844d-af72-47a3-aebf-8126a4210549",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "„Bei der Bürgermeisterwahl in Wittighausen (Main-Tauber-Kreis) ist Amtsinhaber Marcus Wessels einziger Kandidat.“"
                            },
                            {
                                "example_id": "5e1ab05a-7fa9-4de8-be4f-6207c27fc834",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "[Benefizkonzert gegen den russischen Krieg in der Ukraine:] „Friedenskonzerte gibt es auch in vielen anderen Orten in Heilbronn-Franken. In Crailsheim (Kreis Schwäbisch Hall) zum Beispiel spielt die Stadtkapelle im Hangar, in Grünsfeld (Main-Tauber-Kreis) die Musikkapelle mitten im Ort und in Wittighausen (Main-Tauber-Kreis) sind die Musikanten auf dem Dorfplatz zu hören.“"
                            },
                            {
                                "example_id": "44caf26e-5d92-4bd2-a714-5004ff17d0cd",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "„Wittighausen entstand 1971/1972 durch den Zusammenschluss der ehemals selbstständigen Gemeinden Oberwittighausen, Unterwittighausen, Poppenhausen und Vilchband.“"
                            },
                            {
                                "example_id": "84d4f30e-2d7e-44d9-8ca9-9373fefbca39",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "„Rund 450 000 Euro Schaden hat ein Brand in einem Wohnhaus in Wittighausen (Main-Tauber-Kreis) am Mittwoch verursacht.“"
                            },
                            {
                                "example_id": "8ecb71d3-46f1-4909-997d-f275d1199da0",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "„Nach dem Brand am NABU-Vereinshaus in Wittighausen (Main-Tauber-Kreis) am Dienstagvormittag sucht die Polizei jetzt Zeugen. Es liege der Verdacht nahe, dass das Feuer gelegt wurde, hieß es.“"
                            },
                            {
                                "example_id": "fb48033a-2353-4cc9-bfd5-edcb469c8b63",
                                "sense_id": "4b13f217-e8c7-31d1-9ea5-1990af67bb52",
                                "text": "„Ein 82 Jahre alter Radfahrer ist in Wittighausen (Main-Tauber Kreis) von einem Zug erfasst worden und gestorben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
