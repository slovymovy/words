                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meteorology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meteorologist explained that the <w>convergence</w> of wind flows would likely cause a storm.",
                            "target_lang_translations": {
