                                                "sense_id": "07e823e6-d2ad-31a3-8785-adf4c7ba1f9d",
                                                "text": "Mein neuer Slip ist noch nicht trocken."
                                            },
                                            {
                                                "example_id": "dc62b5dd-1c19-404a-8e69-27b7f9389e37",
                                                "sense_id": "07e823e6-d2ad-31a3-8785-adf4c7ba1f9d",
                                                "text": "„Bald trug sie nur noch Slip und BH.“"
                                            },
                                            {
                                                "example_id": "48f7d2cd-a9fa-4c90-b929-55d8be4e43f1",
                                                "sense_id": "07e823e6-d2ad-31a3-8785-adf4c7ba1f9d",
                                                "text": "„Nebenan rauschte die Spülung, und ich sah, wie die Frau ihren Slip hochzog.“"
                                            },
                                            {
                                                "example_id": "c7a8d005-5379-4771-b917-d8385026bb8f",
                                                "sense_id": "07e823e6-d2ad-31a3-8785-adf4c7ba1f9d",
                                                "text": "„Sie trug nur ein T-Shirt und einen Slip.“"
                                            },
                                            {
                                                "example_id": "9cc50c40-0f0e-41c8-9969-7182c685cc0a",
                                                "sense_id": "07e823e6-d2ad-31a3-8785-adf4c7ba1f9d",
