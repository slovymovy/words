                                        "entry_id": "3f6aa55f-3caa-379b-8005-5f1b40315734",
                                        "glosses": [
                                            "stickstoffhaltiges Polysaccharid, das den organischen Hauptbestandteil des Außenskelettes der Gliederfüßer bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d547fcd6-ed10-468e-ac94-9f880e1fbb88",
                                                "sense_id": "3efe7d22-ff40-3805-8bc6-4d1571e8f7ca",
                                                "text": "Chitin kommt auch in den Zellwänden von Pilzen vor."
                                            },
                                            {
                                                "example_id": "1481230e-c198-46e3-bf08-1978f5874a16",
                                                "sense_id": "3efe7d22-ff40-3805-8bc6-4d1571e8f7ca",
                                                "text": "[Pilze:] „Während die Zellwände von Pflanzen überwiegend aus Zellulose bestehen, enthalten Pilzzellwände Chitin, einen Stoff, der auch im Exoskelett von Insekten und Krebstieren vorkommt.“"
                                            }
                                        ],
