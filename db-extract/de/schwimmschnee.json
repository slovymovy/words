                    {
                        "translation_id": "2c0f6bf4-3f61-4345-9404-6c0e3737d44e",
                        "source_entry_id": "12fa6c94-dbf5-3928-8d67-52fc55018247",
                        "source_sense_id": "8cbb6c43-d968-38d4-9a9c-9495b2c6a8a4",
