                                        "entry_id": "2d542d30-808f-300b-8744-090a3457107d",
                                        "glosses": [
                                            "verbond van personen of organisaties met dezelfde belangen of opvattingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
