                "senses": [
                    {
                        "sense_id": "c6767721-56d2-333e-9186-2cd19dcb8bf1",
                        "entry_id": "b05b145b-a83f-3c4f-ae8f-8ccff1a27beb",
                        "glosses": [
                            "Ort in der Provinz Bizkaia im Baskenland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2800347e-f540-4a03-ad63-e9f3266b518c",
                                "sense_id": "c6767721-56d2-333e-9186-2cd19dcb8bf1",
                                "text": "Durango liegt ungefähr 20 km südöstlich von Bilbao."
                            },
                            {
                                "example_id": "13ca99cc-ceb2-483a-8a6e-d03305a4aef6",
                                "sense_id": "c6767721-56d2-333e-9186-2cd19dcb8bf1",
                                "text": "„Faschistische Flugzeuge bombardieren die nordspanische Ortschaft Durango.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "410bac27-559f-330b-aaa5-8e340e48b6d3",
                        "entry_id": "b05b145b-a83f-3c4f-ae8f-8ccff1a27beb",
                        "glosses": [
                            "Verwaltungssitz von La Plata County in Colorado, USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f012d6f3-3de9-4cd2-897b-7eb3fd49c6bf",
                                "sense_id": "410bac27-559f-330b-aaa5-8e340e48b6d3",
                                "text": "Durch Durango führt die auch als „Million Dollar Highway“ bezeichnete U.S. Route 550."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "553319a4-e2cd-3e10-92e4-5d6dbc9111bc",
                        "entry_id": "b05b145b-a83f-3c4f-ae8f-8ccff1a27beb",
                        "glosses": [
                            "mexikanischer Bundesstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afde781-2af8-4d03-a832-dac8cb9cc2d1",
                                "sense_id": "553319a4-e2cd-3e10-92e4-5d6dbc9111bc",
                                "text": "Durango ist der größte Bundesstaat ohne Ländergrenze oder Küste."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "559b8709-a2da-3cdb-822b-d15d10695f29",
                        "entry_id": "b05b145b-a83f-3c4f-ae8f-8ccff1a27beb",
                        "glosses": [
                            "Hauptstadt des gleichnamigen Bundesstaats in Mexiko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4b662e-cd3d-484b-b032-8f1b750a9986",
                                "sense_id": "559b8709-a2da-3cdb-822b-d15d10695f29",
                                "text": "„Der Aufstand in Mexiko gegen den diktatorisch regierenden Präsidenten Porfirio Díaz breitet sich auf die Orte Durango, Torreon, Barral, Gomez Palacio u. a. aus.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
