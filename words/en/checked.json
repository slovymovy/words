                    }
                },
                {
                    "sense_id": "49daaa28-88dd-3a16-a750-292166961b89",
                    "sense_definition": "Of a syllable, ending in a consonant rather than a vowel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist explained how a <w>checked</w> syllable affects vowel length.",
                            "target_lang_translations": {
                                "ru": "Лингвист объяснил, как <w>закрытый</w> слог влияет на долготу гласного."
                            }
                        },
                        {
                            "text": "In this language, <w>checked</w> vowels are usually pronounced shorter.",
                            "target_lang_translations": {
                                "ru": "В этом языке гласные в <w>закрытых</w> слогах обычно произносятся короче."
                            }
                        }
                    ],
                    "synonyms": [
                        "closed"
                    ],
                    "antonyms": [
                        "carry-on"
                    ],
                    "common_phrases": [
                        "checked syllable",
                        "checked vowel"
