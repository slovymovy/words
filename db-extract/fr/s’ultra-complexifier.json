                        "examples": [
                            {
                                "example_id": "a56d539f-c88b-4ed6-a50c-cbda0e0989b7",
                                "sense_id": "0cfe8e30-3694-3ced-b5b0-d38213198da0",
                                "text": "En conséquence, l’homme ne doit pas craindre a priori que l’humanité s’ultra-complexifie."
                            },
                            {
                                "example_id": "06da22aa-8482-49f2-ad49-cf08eb80b3b8",
                                "sense_id": "0cfe8e30-3694-3ced-b5b0-d38213198da0",
                                "text": "Nous ne croyons plus qu’en de la matière qui s’est ultra-complexifiée au cours de l’histoire du monde jusqu’à créer des puissances supérieures qui ont abouti à l’homme pour atteindre dans le futur le niveau d’une Humanité-dieu-super-man."
                            },
                            {
                                "example_id": "d003684f-33f7-4db8-a814-eaaf6999067e",
                                "sense_id": "0cfe8e30-3694-3ced-b5b0-d38213198da0",
                                "text": "On peut ainsi être assuré de collecter toute l’information désirée sans perdre de temps considérable à identifier anatomiquement et spécifiquement les innombrables débris divers laissés par le squelette ultra-complexifié des poissons."
                            }
                        ]
                    }
