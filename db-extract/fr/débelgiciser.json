                        "glosses": [
                            "Enlever son caractère belge à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8701fd5-6b4d-4a96-af22-2b331b97ec82",
                                "sense_id": "5db2d561-b1dc-3fcd-8087-8ee3e27e4c34",
                                "text": "Il n'a pas osé proposer que, tant qu'à faire, on en profite pour débelgiciser la Belgique : il y a des tâches trop dures, même pour un Maître du Monde...."
                            },
                            {
                                "example_id": "3eb4cdb7-5f50-4955-9862-a01a573367a7",
                                "sense_id": "5db2d561-b1dc-3fcd-8087-8ee3e27e4c34",
                                "text": "Quoi qu'il en soit, je n'ai jamais songé à me débelgiciser."
                            }
                        ]
                    }
