                                        "sense_id": "5ffee3d3-62ee-3a91-9d1e-ff00c354520f",
                                        "entry_id": "2d368ff1-7df4-3353-bb65-ac8904594f2a",
                                        "glosses": [
                                            "A person who is skilled at escaping from confinement, for example from prisons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9227600c-8af3-4b66-aca5-002165d803fa",
                                                "sense_id": "5ffee3d3-62ee-3a91-9d1e-ff00c354520f",
                                                "text": "Whether he is an escape artist, whether he is a known troublemaker and agitator, fights, and one thing or another. All these things are taken into consideration by the committee before a decision is made."
                                            },
                                            {
                                                "example_id": "93bd72f4-272c-446a-bab0-5ea2766997e1",
                                                "sense_id": "5ffee3d3-62ee-3a91-9d1e-ff00c354520f",
                                                "text": "They do not mention that if the dog is like Nero, it can be a regular escape artist, pulling out chains or breaking ropes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0ad4aa9-89d8-3157-94dc-9329dccc209c",
                                        "entry_id": "2d368ff1-7df4-3353-bb65-ac8904594f2a",
                                        "glosses": [
                                            "An entertainer who performs escapes from perilous situations such as cages, coffins, and straitjackets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
