                "senses": [
                    {
                        "sense_id": "773ddd2d-22ad-3e99-b426-984c045d94cc",
                        "entry_id": "7ad2081a-00b8-34e0-9c34-01adcef331a6",
                        "glosses": [
                            "устар. рассматривать через лорнет кого-либо, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "199da549-945e-49ee-a959-88d55fcd6172",
                                "sense_id": "773ddd2d-22ad-3e99-b426-984c045d94cc",
                                "text": "Ольга пристально лорнировала проезжавшую коляску."
                            },
                            {
                                "example_id": "0dcd8322-de93-4d1f-932c-715c84ea50cd",
                                "sense_id": "773ddd2d-22ad-3e99-b426-984c045d94cc",
                                "text": "Молодые поэты читали стихи друг другу, а добившись славы, выступали на вечерах «Зелёной лампы», и лорнировала их в лорнет Зинаида Гиппиус, которую за несносный нрав называли Зинаидой Ге-пе-ус, да ещё тонким фальцетом учил уму-разуму Мережковский."
                            }
                        ]
                    }
