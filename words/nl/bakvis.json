            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dabcdfd9-516c-3d58-a382-03bf404a390f",
                    "sense_definition": "Meisje in de puberteit dat zich nog wat onvolwassen, dromerig of giechelig gedraagt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "meisje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze gedroeg zich vroeger als een typische <w>bakvis</w> wanneer haar favoriete popster op televisie kwam.",
                            "target_lang_translations": {
                                "de": "Früher verhielt sie sich wie ein typischer <w>Backfisch</w>, wenn ihr Lieblingspopstar im Fernsehen auftrat."
                            }
                        },
                        {
                            "text": "Tijdens de vakantie giechelden de twee vriendinnen als een stel vrolijke <w>bakvissen</w>.",
                            "target_lang_translations": {
                                "de": "Während des Urlaubs kicherten die zwei Freundinnen wie ein paar ausgelassene <w>Backfische</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "puber",
                        "tienermeisje"
                    ],
                    "common_phrases": [
                        "typische bakvis",
                        "gedragen als een bakvis"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vaak gebruikt met een nostalgische of licht spottende ondertoon."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Heranwachsendes Mädchen im Teenageralter, das sich noch etwas kindisch, schwärmerisch oder kichernd verhält."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Backfisch",
                                "target_lang_sense_clarification": "veraltet für ein heranwachsendes Mädchen"
                            },
                            {
                                "target_lang_word": "Teenager-Mädchen",
                                "target_lang_sense_clarification": "modern"
                            },
                            {
                                "target_lang_word": "Halbwüchsige",
                                "target_lang_sense_clarification": "heranwachsende Jugendliche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d7f450d-7baa-3e7f-8448-1ae799fb3ef0",
                    "sense_definition": "Vis die geschikt is of klaargemaakt wordt om te bakken.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser bewaarde de kleinste vangst als <w>bakvis</w> voor het avondeten.",
                            "target_lang_translations": {
                                "de": "Der Fischer behielt den kleinsten Fang als <w>Bratfisch</w> fürs Abendessen."
                            }
                        },
                        {
                            "text": "In het oude kookboek staat een recept voor verse <w>bakvis</w> met kruidenboter.",
                            "target_lang_translations": {
                                "de": "In dem alten Kochbuch gibt es ein Rezept für frischen <w>Backfisch</w> mit Kräuterbutter."
                            }
                        }
                    ],
                    "antonyms": [
                        "kookvis"
                    ],
                    "common_phrases": [
                        "verse bakvis"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vooral in historische of culinaire contexten gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Fisch, der zum Braten oder Ausbacken geeignet ist oder zubereitet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Backfisch",
                                "target_lang_sense_clarification": "gebackener oder zum Braten bestimmter Fisch"
                            },
                            {
                                "target_lang_word": "Bratfisch",
                                "target_lang_sense_clarification": "gebratener oder zum Braten geeigneter Fisch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56ace38a-de2c-3246-b3d5-70e97d61d706",
                    "sense_definition": "Eerstejaarsstudent of groentje zonder ervaring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "student",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ouderejaars maakten graag grappen ten koste van de nieuwe <w>bakvis</w>.",
                            "target_lang_translations": {
                                "de": "Die älteren Semester machten gerne Witze auf Kosten des neuen <w>Fuchses</w>."
                            }
                        },
                        {
                            "text": "Als onervaren <w>bakvis</w> wist hij de weg in het corpsgebouw nog niet te vinden.",
                            "target_lang_translations": {
                                "de": "Als unerfahrener <w>Grünschnabel</w> fand er sich im Verbindungshaus noch nicht zurecht."
