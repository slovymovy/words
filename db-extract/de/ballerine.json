                        "examples": [
                            {
                                "example_id": "2000f62e-f6d2-420c-86a4-6b7cc8f4e972",
                                "sense_id": "e1c0f4b3-7db0-3774-8f90-a57d54f30761",
                                "text": "„Eine Ballerine tanzt für Carmen in der Schmugglerkneipe.“"
                            },
                            {
                                "example_id": "20e5d1e5-e7bf-4a30-8cbe-13cc9606740c",
                                "sense_id": "e1c0f4b3-7db0-3774-8f90-a57d54f30761",
                                "text": "„Möchte man, abgesehen von den ästhetischen Vorzügen einer Ballerine, sie nicht auch ethisch über einen Steuerzutreiber stellen?“"
                            },
                            {
                                "example_id": "a520f257-c3eb-4012-b58e-33156ba1c584",
                                "sense_id": "e1c0f4b3-7db0-3774-8f90-a57d54f30761",
                                "text": "„Ein richtiger Neidhammel beneidet auch eine erfolgreiche Ballerine, wenn er selbst Professor der Ethik ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
