                "senses": [
                    {
                        "sense_id": "1fd30010-e69f-301d-8a88-ce0168e67c54",
                        "entry_id": "fe9fbd2b-95d4-3376-8da4-6bc194ff1e23",
                        "glosses": [
                            "flexibler Behälter aus Papier, Kunststoff oder ähnlichen Materialien, in dem Müll gesammelt, transportiert und/oder entsorgt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d694248-3176-40a3-bda3-1ae03fac963d",
                                "sense_id": "1fd30010-e69f-301d-8a88-ce0168e67c54",
                                "text": "„Links von uns befand sich der Hamburger Bahnhof, ein Museum für zeitgenössische Kunst, ein Zauberraum, der imstande war, jede Mülltüte in Kunst zu verwandeln, sobald sie dort Eingang fand.“"
                            },
                            {
                                "example_id": "8a12ee46-fb54-493f-9532-5fa1ea0e988d",
                                "sense_id": "1fd30010-e69f-301d-8a88-ce0168e67c54",
                                "text": "„Sie hielt die graue Mülltüte in der Hand, die ich gerade in den Müllkeller gebracht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
