                "senses": [
                    {
                        "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                        "entry_id": "66ed1be2-2838-3b38-8c0a-d567802eaefd",
                        "glosses": [
                            "(großer) Unterschied bei der Verteilung von Vermögen und Einkommen"
                        ],
                        "tags": [
                            "Gesellschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "28845613-f362-4f0b-ac83-46090aff0855",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "„Die Bedingungen, unter denen Kinder und Jugendliche in den Vereinigten Staaten leben, sind durch ein schroffes Wohlstandsgefälle gekennzeichnet.“"
                            },
                            {
                                "example_id": "41f5fc18-d7cf-4072-87db-472899c5370f",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "„Zu den Ursachen der brutalen Gewalt könnte das bestehende Wohlstandsgefälle innerhalb der südafrikanischen Gesellschaft beigetragen haben.“"
                            },
                            {
                                "example_id": "c56a94b1-452e-48bf-9ee1-95c67d905eca",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "[Blutspenden:] „Das Wohlstandsgefälle erzeugt in vielen Fällen eine finanzielle Abhängigkeit, die dazu führt, dass Dauerspender womöglich Vorerkrankungen und gesundheitliche Beschwerden bei der Spende verheimlichen, um die Bonuszahlungen nicht zu verlieren.“"
                            },
                            {
                                "example_id": "9781fee9-bb20-42ba-bdca-3457120b0092",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "„Doch auf der anderen Seite ist das Wohlstandsgefälle zwischen Stadt und Land unter ihm noch größer geworden.“"
                            },
                            {
                                "example_id": "662919fe-fe43-44a1-bb1f-60b56b1d67b4",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "[DDR im Jahr 1953:] „Das Wohlstandsgefälle zu Westdeutschland vergrößerte sich durch die Mängel der Zentralverwaltungswirtschaft.“"
                            },
                            {
                                "example_id": "301a85b5-2f7d-48c8-8098-5a15de799f4f",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "[Deutschland:] „Das Wohlstandsgefälle zwischen Ost und West ist seit der Jahrtausendwende kleiner geworden, zwischen Nord und Süd haben die Einkommensunterschiede jedoch zugenommen.“"
                            },
                            {
                                "example_id": "1e83b298-0f28-414d-afbb-4d722f532d3f",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "„Vier von fünf Personen sagen dort, dass der Wohlstand in der Schweiz unfair verteilt und das Wohlstandsgefälle zwischen Reich und Arm zu gross sei.“"
                            },
                            {
                                "example_id": "03787e8c-0d58-4bb4-becd-ca19b48ce436",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "[Schlagzeile:] „Peking will Wohlstandsgefälle verringern“"
                            },
                            {
                                "example_id": "fd73b64b-4122-40dd-80e2-f1e1c7725d43",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "[Schlagzeile:] „Armut und Reichtum in München – Wie junge Leute das Wohlstandsgefälle erleben“"
                            },
                            {
                                "example_id": "bf157c04-9a70-4e03-a542-b2ca55633877",
                                "sense_id": "049415ee-d640-31d6-afa4-e1e16f81d387",
                                "text": "„Inzwischen ist die Europäische Union in mehreren Erweiterungsrunden auf 27 Mitgliedstaaten angewachsen. Zuletzt traten Bulgarien und Rumänien bei. Damit hat das Wohlstandsgefälle innerhalb der Union zugenommen, die politischen Vorstellungen sind vielfältiger und die Interessensgegensätze größer geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
