{
    "word_family": [
        "bear",
        "bearable",
        "unbearable",
        "forbear"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e820cd15-c558-3658-b8a0-162ff8f7dbde",
                    "sense_definition": "A person or thing that carries, holds, or possesses something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "carry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bearer</w> of this passport is entitled to travel without a visa.",
                            "target_lang_translations": {
                                "ru": "<w>Владелец</w> этого паспорта имеет право путешествовать без визы."
                            }
                        },
                        {
                            "text": "She was chosen as the flag <w>bearer</w> during the opening ceremony.",
                            "target_lang_translations": {
                                "ru": "Её выбрали <w>знаменосцем</w> на церемонии открытия."
                            }
                        }
                    ],
                    "synonyms": [
                        "carrier"
                    ],
                    "common_phrases": [
                        "bearer of bad news",
                        "passport bearer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или объект, который держит, несёт или обладает чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носитель",
                                "target_lang_sense_clarification": "человек, обладающий правами или несущий предмет/знамя"
                            },
                            {
                                "target_lang_word": "владелец",
                                "target_lang_sense_clarification": "обладатель документа или паспорта"
                            },
                            {
                                "target_lang_word": "знаменосец",
                                "target_lang_sense_clarification": "в сочетании flag bearer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bbc514b-cd12-34bf-b346-1bc38c0fd4a4",
                    "sense_definition": "A person who delivers a letter, message, or official document on behalf of someone else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "carry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letter was delivered safely by a trusted <w>bearer</w>.",
                            "target_lang_translations": {
                                "ru": "Письмо благополучно доставил надёжный <w>податель</w>."
                            }
                        },
                        {
                            "text": "Please give the package directly to the <w>bearer</w> of this message.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, передайте посылку прямо в руки <w>подателю</w> этой записки."
                            }
                        }
                    ],
                    "synonyms": [
                        "carrier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, доставляющий или передающий письмо, сообщение или документ от чьего-либо имени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "податель",
                                "target_lang_sense_clarification": "письма или записки"
                            },
                            {
                                "target_lang_word": "курьер",
                                "target_lang_sense_clarification": "доставщик сообщения"
                            },
                            {
                                "target_lang_word": "доставитель",
                                "target_lang_sense_clarification": "человек, доставивший послание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f5df4a8-5179-3185-a8fb-fd2e991a2a53",
                    "sense_definition": "A person who helps to carry the coffin in a funeral procession.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "carry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Six close friends served as the <w>bearers</w> at the funeral service.",
                            "target_lang_translations": {
                                "ru": "Шестеро близких друзей выступили в роли <w>носильщиков гроба</w> на похоронной службе."
                            }
                        },
                        {
                            "text": "The coffin was carefully lifted onto the shoulders of the <w>bearers</w>.",
                            "target_lang_translations": {
                                "ru": "Гроб аккуратно подняли на плечи <w>носильщиков</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pallbearer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, несущий гроб в похоронной процессии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носильщик гроба",
                                "target_lang_sense_clarification": "участник похоронной процессии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43e77fa2-f20a-38c6-86e9-907ed025223d",
                    "sense_definition": "A person who presents or holds a cheque, bond, or other commercial note payable on demand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The banknote states that it promises to pay the <w>bearer</w> on demand.",
                            "target_lang_translations": {
                                "ru": "На банкноте указано обещание выплатить сумму <w>предъявителю</w> по первому требованию."
                            }
                        },
                        {
                            "text": "This check is payable to the <w>bearer</w> rather than to a named individual.",
                            "target_lang_translations": {
                                "ru": "Этот чек подлежит оплате на <w>предъявителя</w>, а не на конкретное лицо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "payable to bearer",
                        "pay the bearer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, предъявляющее чек, облигацию или ценную бумагу, подлежащую оплате по требованию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предъявитель",
                                "target_lang_sense_clarification": "чека или ценной бумаги"
                            },
                            {
                                "target_lang_word": "держатель",
                                "target_lang_sense_clarification": "ценной бумаги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "966e9a2c-f438-3e7f-a202-996d21b206d2",
                    "sense_definition": "A person employed to carry heavy supplies and equipment on an expedition or journey.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "carry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expedition hired several local <w>bearers</w> to transport the heavy tents.",
                            "target_lang_translations": {
                                "ru": "Экспедиция наняла нескольких местных <w>носильщиков</w> для транспортировки тяжёлых палаток."
                            }
                        },
                        {
                            "text": "Each <w>bearer</w> carried up to twenty kilograms of food along the steep mountain path.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>носильщик</w> нёс до двадцати килограммов еды по крутой горной тропе."
                            }
                        }
                    ],
                    "synonyms": [
                        "carrier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для переноски грузов, снаряжения и припасов в экспедиции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носильщик",
                                "target_lang_sense_clarification": "снаряжения в походе или экспедиции"
                            },
                            {
                                "target_lang_word": "портер",
                                "target_lang_sense_clarification": "носильщик в горных экспедициях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "054ab532-e517-3ff5-9e6b-cd4147d246ac",
                    "sense_definition": "A person employed to carry a sedan chair, palanquin, or litter.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Four sturdy <w>bearers</w> carried the royal litter through the crowded city gates.",
                            "target_lang_translations": {
                                "ru": "Четверо крепких <w>носильщиков</w> пронесли королевские носилки через переполненные городские ворота."
                            }
                        },
                        {
                            "text": "The wealthy traveler relied on local <w>bearers</w> to convey him over rough terrain.",
                            "target_lang_translations": {
                                "ru": "Богатый путешественник полагался на местных <w>носильщиков</w>, чтобы передвигаться по пересечённой местности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для переноски паланкина, носилок или паланкина-седана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носильщик",
                                "target_lang_sense_clarification": "человек, несущий паланкин или носилки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d479380-47a2-36a2-9e48-f3f465b28242",
                    "sense_definition": "A tree, vine, or plant that yields a crop or fruit.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horticulture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This apple tree variety is a remarkably prolific <w>bearer</w> in late autumn.",
                            "target_lang_translations": {
                                "ru": "Этот сорт яблони — удивительно обильно <w>плодоносящее дерево</w> поздней осенью."
                            }
                        },
                        {
                            "text": "With proper pruning and sunlight, the young grape vine proved to be an excellent <w>bearer</w>.",
                            "target_lang_translations": {
                                "ru": "При правильной обрезке и солнечном свете молодая виноградная лоза оказалась прекрасным <w>источником урожая</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, дерево или лоза, дающие урожай или плоды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодоносящее растение",
                                "target_lang_sense_clarification": "дерево или кустарник, приносящий урожай"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f0ca66e-d140-3f7d-92d4-b4935ee6ee01",
                    "sense_definition": "A personal male domestic servant or valet, especially in South Asia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer instructed his <w>bearer</w> to prepare his uniform for dinner.",
                            "target_lang_translations": {
                                "ru": "Офицер приказал своему <w>слуге</w> подготовить мундир к обеду."
                            }
                        },
                        {
                            "text": "His personal <w>bearer</w> looked after all the domestic luggage during the voyage.",
                            "target_lang_translations": {
                                "ru": "Его личный <w>камердинер</w> присматривал за всем багажом во время путешествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "dressing-boy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Associated with colonial-era domestic service"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Used especially in South Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личный слуга-мужчина или камердинер, особенно в колониальной Южной Азии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слуга",
                                "target_lang_sense_clarification": "личный слуга-мужчина"
                            },
                            {
                                "target_lang_word": "камердинер",
                                "target_lang_sense_clarification": "личный помощник господина"
                            },
                            {
                                "target_lang_word": "бериер",
                                "target_lang_sense_clarification": "слуга в колониальной Индии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64f67f9a-91c5-3925-9a00-5ade4ab749a9",
                    "sense_definition": "A server or waiter in a hotel or restaurant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He motioned to the <w>bearer</w> to bring the check to their table.",
                            "target_lang_translations": {
                                "ru": "Он подозвал жестом <w>официанта</w>, чтобы тот принёс счёт к их столику."
                            }
                        },
                        {
                            "text": "The <w>bearer</w> promptly cleared the empty plates from the dining room.",
                            "target_lang_translations": {
                                "ru": "<w>Официант</w> быстро убрал пустые тарелки из обеденного зала."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Indian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официант в гостинице или ресторане (в индийском варианте английского языка)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официант",
                                "target_lang_sense_clarification": "работник ресторана или отеля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ef47423-33c1-32aa-a4e1-12c8cade1a19",
                    "sense_definition": "A strip or piece of furniture used in printing to bear off pressure from a blank margin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer adjusted the <w>bearer</w> to prevent ink smudges along the blank margin.",
                            "target_lang_translations": {
                                "ru": "Печатник отрегулировал <w>отбойную планку</w>, чтобы избежать смазывания краски по чистому полю."
                            }
                        },
                        {
                            "text": "Excess impression pressure was absorbed by placing a wooden <w>bearer</w> in the chase.",
                            "target_lang_translations": {
                                "ru": "Избыточное давление печати компенсировалось установкой деревянной <w>планки</w> в раму."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Планка или накладка в печатной форме, используемая для снятия избыточного давления с поля листа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальшмарка",
                                "target_lang_sense_clarification": "полиграфическая защитная планка"
                            },
                            {
                                "target_lang_word": "отбойная планка",
                                "target_lang_sense_clarification": "деталь для снятия давления при печати"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9155009-e1f9-3e56-9745-d972872502ac",
                    "sense_definition": "A type-high piece of metal used to support an electrotype or printing plate during shaving or finishing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A metal <w>bearer</w> was inserted to protect the delicate relief from bending.",
                            "target_lang_translations": {
                                "ru": "Была вставлена металлическая <w>опорная рейка</w>, чтобы защитить хрупкий рельеф от деформации."
                            }
                        },
                        {
                            "text": "Before shaving the plate, the technician positioned each <w>bearer</w> correctly.",
                            "target_lang_translations": {
                                "ru": "Перед строганием пластины техник правильно установил каждую <w>опорную планку</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическая полоса роста шрифта, служащая опорой для стереотипа или клише при отделке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опорная рейка",
                                "target_lang_sense_clarification": "опора для клише или стереотипа"
                            },
                            {
                                "target_lang_word": "поддерживающая планка",
                                "target_lang_sense_clarification": "металлическая планка в полиграфии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d7f7c59d-24b0-37bc-a467-06461bbf55dc",
                    "sense_definition": "An English surname of occupational origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Bearer</w> published several influential papers on historical linguistics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Берер</w> опубликовал несколько влиятельных работ по исторической лингвистике."
                            }
                        },
                        {
                            "text": "The library archives contain historical documents concerning the <w>Bearer</w> family.",
                            "target_lang_translations": {
                                "ru": "В библиотечных архивах хранятся исторические документы, относящиеся к семье <w>Берер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Occupational surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия профессионального происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Берер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}