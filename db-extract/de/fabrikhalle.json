                "senses": [
                    {
                        "sense_id": "23a321a9-87fb-36b7-bed6-4547e7ec5a0c",
                        "entry_id": "68dba8c6-327a-3b5c-a4b2-012a648348ab",
                        "glosses": [
                            "Halle, in der man etwas fabriziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99eccda3-55a6-4740-948d-8e5a8601d665",
                                "sense_id": "23a321a9-87fb-36b7-bed6-4547e7ec5a0c",
                                "text": "„Auf dem anderen Ufer ragten uns Baukräne und weitere gläserne Bürotürme entgegen, direkt vor uns ein rotes Backsteingebäude, das wie die moderne Version einer alten Fabrikhalle mit hohem Schornstein aussah.“"
                            },
                            {
                                "example_id": "b8842120-6e80-49ba-812e-2d849994d37d",
                                "sense_id": "23a321a9-87fb-36b7-bed6-4547e7ec5a0c",
                                "text": "In der Fabrikhalle ist es sehr laut."
                            },
                            {
                                "example_id": "8209e055-63fa-4cb4-94fa-54a92eaca813",
                                "sense_id": "23a321a9-87fb-36b7-bed6-4547e7ec5a0c",
                                "text": "Die Arbeiter strömen in die modern eingerichtete Fabrikhalle."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
