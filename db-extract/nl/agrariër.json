                    {
                        "translation_id": "ea0e6be0-4ffa-4f11-9f88-609b54085544",
                        "source_entry_id": "63ebe75d-c3e8-3af3-90ec-1bd29bde2aba",
                        "source_sense_id": "209ba19a-31d4-3205-a662-3aa9fd605ae1",
                        "target_lang_word": "agriculteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agriculteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7181cda6-1c70-37fd-9149-7a44bbc4d001",
                                        "entry_id": "0bd3711e-46f7-3c42-b578-e8618e20dacb",
                                        "glosses": [
                                            "Homme qui, à titre professionnel, cultive la terre ou élève des animaux destinés à être consommés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a563ad0-9804-4c9d-8bb1-f55805f14d59",
                                                "sense_id": "7181cda6-1c70-37fd-9149-7a44bbc4d001",
                                                "text": "Celui qui se dirige d’après les lois de l’agronomie, c’est l’agriculteur ; celui qui exécute matériellement les principes de l’agriculture, c’est le cultivateur."
                                            },
                                            {
                                                "example_id": "78a2f178-a266-4a88-a925-0ed413d1e4e4",
                                                "sense_id": "7181cda6-1c70-37fd-9149-7a44bbc4d001",
                                                "text": "M. Noris était agriculteur, c’est-à-dire qu’il avait passé sa vie à ne rien faire, car on ne saurait appeler « travail » la gérance de deux domaines."
                                            },
                                            {
                                                "example_id": "522e3d64-2715-4b61-98b2-64dec7584cf8",
                                                "sense_id": "7181cda6-1c70-37fd-9149-7a44bbc4d001",
                                                "text": "L’artiste, le poète et le touriste se réjouissent ici d’un pittoresque qui fait le désespoir de l’agriculteur."
                                            },
                                            {
                                                "example_id": "e2aa3a9b-447b-435f-87fd-17dfe546338e",
                                                "sense_id": "7181cda6-1c70-37fd-9149-7a44bbc4d001",
                                                "text": "Lorsque des agriculteurs étendent du lisier dans les champs, cette odeur nauséabonde se répand dans l’environnement à des kilomètres autour du champ d’épandage."
                                            },
                                            {
                                                "example_id": "cf790fe7-974e-4617-8a4d-a6a5a1d95fc4",
                                                "sense_id": "7181cda6-1c70-37fd-9149-7a44bbc4d001",
                                                "text": "Le métier le plus noble était celui d’agriculteur."
                                            },
                                            {
                                                "example_id": "57fa6104-a88f-49cb-b612-f7674ef540c7",
                                                "sense_id": "7181cda6-1c70-37fd-9149-7a44bbc4d001",
                                                "text": "Les agriculteurs ne décolèrent pas. En Isère, les points de blocage se multiplient. Pour soutenir les producteurs, les syndicats accompagnent le mouvement depuis une semaine. Parmi eux, les représentants départementaux de la FNSEA, premier syndicat agricole, face à la Confédération paysanne. Ces deux organisations affichent le même soutien à la mobilisation. Pas forcément avec les mêmes revendications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
