                        "sense_id": "3c13860a-cd4e-3eb1-9008-3eb34b304efb",
                        "entry_id": "d5be95a0-e6f1-377c-bc01-fc1ca8195d44",
                        "glosses": [
                            "A fan of the South Korean girl group Girls' Generation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8c2dd9-2ce0-41c1-b38a-4c3d15a36823",
                                "sense_id": "3c13860a-cd4e-3eb1-9008-3eb34b304efb",
                                "text": "The band is known as SNSD (acronym of Korean name So Nyuh Shi Dae). SNSD fans are called Sone^([sic]) and, yes, I am a Sone."
                            },
                            {
                                "example_id": "147a35b5-4cce-4ad2-80dd-794813969521",
                                "sense_id": "3c13860a-cd4e-3eb1-9008-3eb34b304efb",
                                "text": "Their six-track EP, 'Mr.Mr' comes packed with electro and R&B infused songs that SONEs (as SNSD Girls' Generation fans are lovingly called) can dance and sing along to."
                            },
                            {
                                "example_id": "1ac289de-54b3-4697-b9bb-61cbff28488a",
                                "sense_id": "3c13860a-cd4e-3eb1-9008-3eb34b304efb",
                                "text": "Way to go SONEs, the fan chants during the dance break was^([sic]) so rad!"
                            }
                        ]
                    }
