                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d5121a2-bf8d-3e6f-a3c9-0758290e2208",
                                        "entry_id": "5585ffc4-71f2-39fe-b151-da6b0c97c1c2",
                                        "glosses": [
                                            "To cook (food) on a grill; to barbecue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1fc0be4-8212-458f-9cdb-152590754df0",
                                                "sense_id": "5d5121a2-bf8d-3e6f-a3c9-0758290e2208",
                                                "text": "Why don't we get together Saturday and grill some burgers?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1458c0aa-fad3-371b-a572-6fb7bbfc7ddd",
                                        "entry_id": "5585ffc4-71f2-39fe-b151-da6b0c97c1c2",
                                        "glosses": [
                                            "To cook food under the element of a stove or only under the top element of an oven – (US) broil, (cooking) salamander."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185950ab-16ba-4edf-9768-ec9584739e78",
                                                "sense_id": "1458c0aa-fad3-371b-a572-6fb7bbfc7ddd",
                                                "text": "Bradly hung the fowl in a sugar-bag for to-morrow's dinner and set about grilling chops, with tomatoes stuffed with cheese and breadcrumbs in the pan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf26788a-6165-3498-9153-8a44fe8cd061",
                                        "entry_id": "5585ffc4-71f2-39fe-b151-da6b0c97c1c2",
                                        "glosses": [
                                            "To interrogate; to question aggressively or harshly."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f4d911-6f2d-4e53-94fb-e4973442159c",
                                                "sense_id": "cf26788a-6165-3498-9153-8a44fe8cd061",
                                                "text": "The police grilled him about his movements at the time of the crime."
                                            },
                                            {
                                                "example_id": "f3de5d17-d1dd-475e-ace9-b8ba1e703180",
                                                "sense_id": "cf26788a-6165-3498-9153-8a44fe8cd061",
                                                "text": "In stark opposition to what CBS editorial leadership told staff on Monday, Redstone said that she did not believe Dokoupil had violated the network’s editorial standards when he grilled Coates over the contents of his new book."
                                            },
                                            {
                                                "example_id": "204eb4b6-18a3-4572-881d-ed413f51276d",
                                                "sense_id": "cf26788a-6165-3498-9153-8a44fe8cd061",
                                                "text": "The white cop grilled me. He was tall, but had a stomach like a pregnant woman. The other two were brothers, and they looked like they just didn't wanna be standing there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26cc1480-ac6a-3f4f-9714-0eb9ce5d47b8",
                                        "entry_id": "5585ffc4-71f2-39fe-b151-da6b0c97c1c2",
                                        "glosses": [
                                            "To feel very hot; to swelter."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ef10f3-8e72-45c8-95ce-3b9cfd87605e",
                                                "sense_id": "26cc1480-ac6a-3f4f-9714-0eb9ce5d47b8",
                                                "text": "He had grilled in the heat, sweated in the rains, and shivered with fever under the rude thatch roof; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f740c1-495d-3f1e-b27d-be557a2f7dd0",
                                        "entry_id": "5585ffc4-71f2-39fe-b151-da6b0c97c1c2",
                                        "glosses": [
                                            "To stamp or mark with a grill."
