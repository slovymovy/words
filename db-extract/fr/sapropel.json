                    {
                        "sense_id": "688cd5ef-399f-3095-bda8-8e263ee4859b",
                        "entry_id": "8aafec83-656c-318a-ae40-49eb57c3d636",
                        "glosses": [
                            "Type de sédiment composé essentiellement de matières organiques, reconnaissable à sa couleur noire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "152efdb9-9006-49e2-af22-656bbfd79e7b",
                                "sense_id": "688cd5ef-399f-3095-bda8-8e263ee4859b",
                                "text": "La formation du pétrole par le métamorphisme du sapropel est due à la chaleur et à la pression, et, peut-être, à la pression seule : mais ce phénomène géologique doit encore être étudié."
                            },
                            {
                                "example_id": "04cf5a1e-ccb2-4e65-ae6c-c863343cfd8f",
                                "sense_id": "688cd5ef-399f-3095-bda8-8e263ee4859b",
                                "text": "Les hydrocarbures imprègnent les sables généralement disposés en lentilles, les argiles et les marnes jouent le rôle d’isolants enfermant les masses à l’intérieur desquelles s’est effectuée la fermentation du sapropel."
                            }
                        ]
                    },
                    {
                        "sense_id": "d137264e-46b2-35fa-81ae-1c0ba3d93574",
                        "entry_id": "8aafec83-656c-318a-ae40-49eb57c3d636",
                        "glosses": [
                            "Organisme, notamment protozoaire, adepte des eaux boueuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3d6d23-5d78-4834-acab-473159e45bf4",
                                "sense_id": "d137264e-46b2-35fa-81ae-1c0ba3d93574",
                                "text": "Le Trichospira est un sapropel typique d’eau douce (Alfred Kahl, 1931),"
                            }
                        ]
                    }
                ],
