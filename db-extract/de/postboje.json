                                "example_id": "ac4ed7e9-4181-43d7-9d8d-270ec9b14cc3",
                                "sense_id": "d7b78208-93ba-3568-a8ab-b70ff984fcaa",
                                "text": "„Eine der ältesten deutschen Postbojen dieser Art treibt seit 1964 in leuchtendem Gelb auf dem Steinhuder Meer in Niedersachsen.“"
                            },
