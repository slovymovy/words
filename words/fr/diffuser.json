    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c52f66fc-ae9d-3609-b658-df238861026e",
                    "sense_definition": "Transmettre au public un programme, un son ou une vidéo par la télévision, la radio ou Internet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette chaîne de télévision va <w>diffuser</w> le match de football en direct ce soir."
                        },
                        {
                            "text": "La radio a <w>diffusé</w> une interview passionnante d'un jeune chercheur ce matin."
                        }
                    ],
                    "synonyms": [
                        "émettre",
                        "retransmettre"
                    ],
                    "common_phrases": [
                        "diffuser en direct",
                        "diffuser une émission",
                        "diffuser un film",
                        "diffuser un reportage"
                    ]
                },
                {
                    "sense_id": "8f7700af-0334-35f5-a296-ede5dc71b8c4",
                    "sense_definition": "Répandre dans toutes les directions de la lumière, de la chaleur, une odeur ou des informations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lampe de chevet <w>diffuse</w> une lumière douce et agréable dans la chambre."
                        },
                        {
                            "text": "Le journal s'efforce de <w>diffuser</w> une information claire et vérifiée auprès des citoyens."
                        }
                    ],
                    "synonyms": [
                        "répandre",
                        "propager",
                        "disperser"
                    ],
                    "antonyms": [
                        "concentrer"
                    ],
                    "common_phrases": [
                        "diffuser de la lumière",
                        "diffuser une odeur",
                        "diffuser une information",
                        "diffuser des idées"
                    ]
                },
                {
                    "sense_id": "91abf38e-605d-312b-8dff-793b4d629c42",
                    "sense_definition": "Se propager ou s'étendre progressivement à travers une matière ou au sein d'un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gaz commence à <w>diffuser</w> lentement à travers la membrane protectrice."
                        },
                        {
                            "text": "Cette nouvelle coutume a fini par se <w>diffuser</w> dans l'ensemble de la société."
                        }
                    ],
                    "synonyms": [
                        "se propager",
                        "se répandre",
                        "circuler"
                    ],
                    "common_phrases": [
                        "se diffuser rapidement",
                        "se diffuser dans la société"
                    ]
                }
            ]
        }
    ]
}