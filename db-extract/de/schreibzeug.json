                        "target_lang_word": "utensilios de escritura",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aa68eb8a-a5be-4d69-ac19-06983572e41f",
                        "source_entry_id": "a9af6e63-c9ec-34d2-bcfd-7b713f2f8f7f",
                        "source_sense_id": "43f0ccc0-821a-36de-a036-f98cd7554102",
                        "target_lang_word": "inkstand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inkstand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                                        "entry_id": "a313daff-8f4b-3312-a7d8-b82a16bfa5bd",
                                        "glosses": [
                                            "A small tray containing pens and an inkwell; (by extension) a pot for holding ink, inkpot, inkwell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d41fe2-da43-4c33-8690-6346063b4e4c",
                                                "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                                                "text": "1765, Laurence Sterne, letter published in Original Letters of the Late Reverend Mr. Laurence Sterne, never before published, London: 1788, pp. 89-90,\n[…] if I thought any thing I might hereafter write would be within their reach, I would throw the Manuscript that is now before me into the fire, and never dip my pen into my Ink-stand again […]"
                                            },
                                            {
                                                "example_id": "123753d3-6886-4d28-aad5-1c58e8a27a68",
                                                "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                                                "text": "I beg your pardon for being here. I come to look for you, and after waiting a little while in hope of your coming in, was making use of your inkstand to explain my errand."
                                            },
                                            {
                                                "example_id": "a31626b0-fe9a-4524-9c71-3229c50508a6",
                                                "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                                                "text": "If you have no ink with you, the first time you go out, stop in at a stationer’s store, and buy a small sixpenny bottle that will stand steadily alone, and answer the purpose of an inkstand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
