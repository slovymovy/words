{
    "word_family": [
        "buggery",
        "buggered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25488efa-a34d-3ad1-a28d-2547b247ee50",
                    "sense_definition": "A person, typically a man, viewed with affection or familiarity; a chap.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How are you doing, you old <w>bugger</w>?",
                            "target_lang_translations": {
                                "ru": "Как поживаешь, <w>старик</w>?"
                            }
                        },
                        {
                            "text": "I am beginning to like the cantankerous old <w>bugger</w> despite his constant complaining.",
                            "target_lang_translations": {
                                "ru": "Мне начинает нравиться этот сварливый старый <w>чертяка</w>, несмотря на его постоянные жалобы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "old bugger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обычно мужчина, к которому относятся с дружеской теплотой или симпатией; малый, старик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старик",
                                "target_lang_sense_clarification": "дружеское обращение"
                            },
                            {
                                "target_lang_word": "чертяка",
                                "target_lang_sense_clarification": "выражение симпатии"
                            },
                            {
                                "target_lang_word": "малый",
                                "target_lang_sense_clarification": "парень, приятель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e840fac5-35b1-383a-b3cd-38b5717596a5",
                    "sense_definition": "A foolish, annoying, or worthless person or thing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a silly <w>bugger</w> for losing his keys again.",
                            "target_lang_translations": {
                                "ru": "Ну и <w>дурак</w> же он, что снова потерял ключи."
                            }
                        },
                        {
                            "text": "The <w>bugger</w> gave me the wrong change at the shop.",
                            "target_lang_translations": {
                                "ru": "Этот <w>засранец</w> в магазине дал мне неправильную сдачу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly bugger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, раздражающий или никчемный человек либо предмет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "гад",
                                "target_lang_sense_clarification": "неприятный человек"
                            },
                            {
                                "target_lang_word": "засранец",
                                "target_lang_sense_clarification": "раздражающий человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4b6595f-8302-3b70-9e27-b8233a4c1b7f",
                    "sense_definition": "A situation or thing that is aggravating, difficult, or causes dismay.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The next train back is not until Thursday, which is a bit of a <w>bugger</w>.",
                            "target_lang_translations": {
                                "ru": "Следующий поезд обратно только в четверг, а это уже небольшой <w>облом</w>."
                            }
                        },
                        {
                            "text": "Trying to fix this broken pipe is a real <w>bugger</w>.",
                            "target_lang_translations": {
                                "ru": "Попытка починить эту сломанную трубу — настоящий <w>геморрой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bit of a bugger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация или вещь, которая раздражает, вызывает трудности или разочарование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "геморрой",
                                "target_lang_sense_clarification": "сложная, раздражающая ситуация"
                            },
                            {
                                "target_lang_word": "облом",
                                "target_lang_sense_clarification": "разочарование, неудача"
                            },
                            {
                                "target_lang_word": "наказание",
                                "target_lang_sense_clarification": "мучение, трудность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2fb62ec-d283-3ce9-8be0-51eb0a9b8fb9",
                    "sense_definition": "A mischievous child; a whippersnapper or tyke.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What is that little <w>bugger</w> up to now in the garden?",
                            "target_lang_translations": {
                                "ru": "Что этот мелкий <w>сорванец</w> опять затеял в саду?"
                            }
                        },
                        {
                            "text": "The little <w>bugger</w> managed to climb over the safety gate.",
                            "target_lang_translations": {
                                "ru": "Маленькому <w>проказнику</w> удалось перелезть через защитные ворота."
                            }
                        }
                    ],
                    "common_phrases": [
                        "little bugger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Озорной ребенок; сорванец, проказник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорванец",
                                "target_lang_sense_clarification": "озорной ребенок"
                            },
                            {
                                "target_lang_word": "проказник",
                                "target_lang_sense_clarification": "непослушный ребенок"
                            },
                            {
                                "target_lang_word": "мелкий",
                                "target_lang_sense_clarification": "ребенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15ea6022-63e0-3714-9826-56812c4c8a9a",
                    "sense_definition": "A damn; anything at all (used in negative constructions to express complete indifference).",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "indifference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't give a <w>bugger</w> how important you think it is.",
                            "target_lang_translations": {
                                "ru": "Мне глубоко <w>наплевать</w>, насколько важным ты это считаешь."
                            }
                        },
                        {
                            "text": "He doesn't care a <w>bugger</w> about what they say behind his back.",
                            "target_lang_translations": {
                                "ru": "Ему совершенно <w>пофиг</w>, что они говорят у него за спиной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not give a bugger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хоть что-то, хоть капля (используется в отрицательных конструкциях для выражения полного безразличия)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наплевать",
                                "target_lang_sense_clarification": "выражение безразличия"
                            },
                            {
                                "target_lang_word": "пофиг",
                                "target_lang_sense_clarification": "полное равнодушие"
                            },
                            {
                                "target_lang_word": "до лампочки",
                                "target_lang_sense_clarification": "безразлично"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d07765b3-6ff6-3dad-8846-2362c36e097f",
                    "sense_definition": "Someone who is very fond of or has a strong habit of doing something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a <w>bugger</w> for Welsh cakes when they are fresh out of the oven.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>обожаю</w> валлийские лепешки, когда они только из печи."
                            }
                        },
                        {
                            "text": "He is a <w>bugger</w> for details and will check the report twice.",
                            "target_lang_translations": {
                                "ru": "Он жуткий <w>педант</w> в деталях и проверит отчет дважды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bugger for"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто очень любит что-то делать или имеет сильную привычку к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любитель",
                                "target_lang_sense_clarification": "страстный поклонник чего-либо"
                            },
                            {
                                "target_lang_word": "фанат",
                                "target_lang_sense_clarification": "человек с сильной привычкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "919ebb56-9e9c-3d95-ab54-1bbcbe327e7c",
                    "sense_definition": "Someone who commits buggery; a sodomite.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical document detailed the laws used to prosecute any <w>bugger</w> in the kingdom.",
                            "target_lang_translations": {
                                "ru": "В историческом документе подробно описывались законы, использовавшиеся для преследования любого <w>содомита</w> в королевстве."
                            }
                        },
                        {
                            "text": "He was accused of being a <w>bugger</w> under the old statutes.",
                            "target_lang_translations": {
                                "ru": "По старым законам его обвинили в том, что он <w>содомит</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often legal or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, совершающий мужеложство; содомит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содомит",
                                "target_lang_sense_clarification": "устаревшее, книжное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae45723f-1efa-3677-80d9-0bc40e9c5607",
                    "sense_definition": "One who sets a covert listening device (a bug).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy was an expert <w>bugger</w>, able to wire a room in minutes.",
                            "target_lang_translations": {
                                "ru": "Шпион был экспертом по <w>установке жучков</w> и мог оборудовать комнату прослушкой за считанные минуты."
                            }
                        },
                        {
                            "text": "They swept the office but found no trace of the <w>bugger</w> or their equipment.",
                            "target_lang_translations": {
                                "ru": "Они обыскали офис, но не нашли никаких следов <w>взломщика-слухача</w> или его оборудования."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто устанавливает скрытые подслушивающие устройства (жучки)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "установщик жучков",
                                "target_lang_sense_clarification": "специалист по прослушке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "402b7c18-bc03-3e4a-89a0-4851d189c84d",
                    "sense_definition": "A heretic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, anyone who opposed the church was branded a <w>bugger</w>.",
                            "target_lang_translations": {
                                "ru": "В средневековье любого, кто противостоял церкви, клеймили как <w>еретика</w>."
                            }
                        },
                        {
                            "text": "The sect was persecuted as a group of dangerous <w>buggers</w>.",
                            "target_lang_translations": {
                                "ru": "Секту преследовали как группу опасных <w>еретиков</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical religious usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Еретик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еретик",
                                "target_lang_sense_clarification": "историческое, религиозное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a3d9c35-6f55-38bf-9d98-e5c514cad4f7",
                    "sense_definition": "Expressing contemptuous dismissal or disregard of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh, <w>bugger</w> this! I am going out for a beer instead of working.",
                            "target_lang_translations": {
                                "ru": "Да <w>забей</w> на это! Пойду лучше выпью пива вместо работы."
                            }
                        },
                        {
                            "text": "He decided to <w>bugger</w> the rules and do it his own way.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>послать к черту</w> правила и сделать все по-своему."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bugger this"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение презрительного пренебрежения или игнорирования кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забить",
                                "target_lang_sense_clarification": "проигнорировать, бросить"
                            },
                            {
                                "target_lang_word": "послать к черту",
                                "target_lang_sense_clarification": "выразить пренебрежение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e81c165d-1bac-3076-a290-1efc0ef624fa",
                    "sense_definition": "To break, ruin, or spoil something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think I have <w>buggered</w> up the computer by pressing the wrong button.",
                            "target_lang_translations": {
                                "ru": "Кажется, я <w>испортил</w> компьютер, нажав не ту кнопку."
                            }
                        },
                        {
                            "text": "Don't let him touch the engine or he will <w>bugger</w> it completely.",
                            "target_lang_translations": {
                                "ru": "Не позволяй ему трогать двигатель, иначе он его окончательно <w>сломает</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bugger up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сломать, испортить или разрушить что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "сделать негодным"
                            },
                            {
                                "target_lang_word": "сломать",
                                "target_lang_sense_clarification": "привести в негодность"
                            },
                            {
                                "target_lang_word": "запороть",
                                "target_lang_sense_clarification": "испортить работу или вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b59b4dbe-a99c-3508-b1ff-15d4fdba16ee",
                    "sense_definition": "To sodomize; to have anal sex with.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical text described the harsh punishments for those who chose to <w>bugger</w> others.",
                            "target_lang_translations": {
                                "ru": "В историческом тексте описывались суровые наказания для тех, кто решал <w>содомизировать</w> других."
                            }
                        },
                        {
                            "text": "He was charged with attempting to <w>bugger</w> the victim.",
                            "target_lang_translations": {
                                "ru": "Ему было предъявлено обвинение в попытке <w>совершить содомию</w> над жертвой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often legal or vulgar context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать анальный секс с кем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содомизировать",
                                "target_lang_sense_clarification": "книжное, юридическое"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "dbfb5fc0-658f-360d-9bc9-ea6902d17caa",
                    "sense_definition": "An exclamation expressing annoyance, frustration, or displeasure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bugger</w>, I have missed the last bus home!",
                            "target_lang_translations": {
                                "ru": "<w>Черт возьми</w>, я опоздал на последний автобус домой!"
                            }
