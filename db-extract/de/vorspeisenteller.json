                "senses": [
                    {
                        "sense_id": "8347a7eb-dc72-3ed9-bf7b-a1fed8926889",
                        "entry_id": "30f2cbc4-48c6-3e58-b689-adaf31bc8f64",
                        "glosses": [
                            "auf einem Teller zusammengestellte kleine Gerichte (Vorspeisen) vor weiteren Gängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02b8cdd0-ca49-4508-bc64-85b690487735",
                                "sense_id": "8347a7eb-dc72-3ed9-bf7b-a1fed8926889",
                                "text": "„Auf dem Vorspeisenteller begegnen sich eine superleichte Tomatenterrine, wunderbar aromatische Zwiebeln und Wantans, mit Schafskäse gefüllte Teigbällchen-alles kross und herrlich leicht.“"
                            },
                            {
                                "example_id": "cd099fe2-1bd1-49ae-a08d-c7ab38a5224a",
                                "sense_id": "8347a7eb-dc72-3ed9-bf7b-a1fed8926889",
                                "text": "„Ein kleiner Vorspeisenteller mit Oliven, eingelegten Rüben, Gurken und Peperoni vervollständigt das Begrüßungs-Mahl.“"
                            },
                            {
                                "example_id": "15b9daac-a2d0-46ae-8936-dec053415d78",
                                "sense_id": "8347a7eb-dc72-3ed9-bf7b-a1fed8926889",
                                "text": "„Yam Curry aus Yamswurzel, südindische Thalis, Hühnercremesuppe und sogar ein extra südindischer Vorspeisenteller stehen auf der Karte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
