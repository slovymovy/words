                            }
                        ]
                    },
                    {
                        "translation_id": "a1c37c3e-e5a0-44db-8f99-426e808794d0",
                        "source_entry_id": "ff2e95f6-5408-3155-9c60-0fbacd2eaf3b",
                        "source_sense_id": "7476dbc1-2e73-3454-ac3c-a98a92282515",
