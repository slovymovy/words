                    {
                        "sense_id": "f7af54fb-77a9-3880-82ff-10923173cb41",
                        "entry_id": "82ea31b6-a234-3d52-87d2-b1b7ae786bdb",
                        "glosses": [
                            "gefährliche oder akrobatische Aktion, die besondere Geschicklichkeit, Aufwand und/oder Kenntnisse erfordert"
                        ],
                        "tags": [
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "a187188b-bada-4251-8c6d-72a775bc9e4a",
                                "sense_id": "f7af54fb-77a9-3880-82ff-10923173cb41",
                                "text": "Im Film gab es echt spektakuläre Stunts."
                            },
                            {
                                "example_id": "836e6975-022d-44db-89fd-12421bce0b57",
                                "sense_id": "f7af54fb-77a9-3880-82ff-10923173cb41",
                                "text": "„Monatelang hatte Wörle den Stunt vorbereitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c073f6f-848b-4adc-b280-9686db91ba8e",
                        "source_entry_id": "82ea31b6-a234-3d52-87d2-b1b7ae786bdb",
                        "source_sense_id": "f7af54fb-77a9-3880-82ff-10923173cb41",
                        "source_sense_description": "gefährliche oder akrobatische Aktion, die besondere Geschicklichkeit, Aufwand und/oder Kenntnisse erfordert",
                        "target_lang_word": "stunt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b684a13c-1d6d-304f-abb3-c46598347b96",
                                        "entry_id": "89e26118-9f3f-32c8-8ba2-78edd43e70b7",
                                        "glosses": [
                                            "A daring or dangerous feat, often involving the display of gymnastic skills."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d87cd307-5c63-4c82-8c41-71ab46ec96ae",
                                                "sense_id": "b684a13c-1d6d-304f-abb3-c46598347b96",
                                                "text": "He found ways to devise, stage, and film stunts that are like nothing anyone’s ever accomplished. He recorded stunning image after stunning image; practically every frame of Fury Road could be a painting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2252b52d-76b3-3b52-8065-1b35c33f32ca",
                                        "entry_id": "89e26118-9f3f-32c8-8ba2-78edd43e70b7",
                                        "glosses": [
                                            "An act or activity viewed as the outcome of a plan or scheme, often malicious or nefarious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3741813-bfc4-3bed-9dd9-d3cd278d5237",
                                        "entry_id": "89e26118-9f3f-32c8-8ba2-78edd43e70b7",
                                        "glosses": [
                                            "Ellipsis of publicity stunt."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfa26f12-0249-3835-a622-749dadddb3e9",
                                        "entry_id": "89e26118-9f3f-32c8-8ba2-78edd43e70b7",
                                        "glosses": [
                                            "A skill."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef344dff-03b6-4e74-99fe-0bb9bd02b06b",
                                                "sense_id": "cfa26f12-0249-3835-a622-749dadddb3e9",
                                                "text": "\"See if you can hit the barrel, Joe,\" urged George Bland. \"A lot of us have missed it, including Peaches, who seems to think his particular stunt is high throwing.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab1d560f-0918-35e7-8b19-26ad92b15eaa",
                                        "entry_id": "89e26118-9f3f-32c8-8ba2-78edd43e70b7",
                                        "glosses": [
                                            "A special means of rushing the quarterback done to confuse the opposing team's offensive line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db38d9f5-ca6d-3962-97c0-638a3b42fd8b",
                                        "entry_id": "69f222d6-0d00-3423-8d9a-7d57f9fcba02",
                                        "glosses": [
                                            "To perform a stunt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8f95c39-798e-3aec-86f0-e8aac638c952",
                                        "entry_id": "69f222d6-0d00-3423-8d9a-7d57f9fcba02",
                                        "glosses": [
                                            "To show off; to posture; to flaunt valuables."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a966756e-6348-427f-84ee-49341177b847",
                                                "sense_id": "a8f95c39-798e-3aec-86f0-e8aac638c952",
                                                "text": "Call me the juice and you know I'm a stunt."
                                            },
                                            {
                                                "example_id": "0bc31262-19bd-407e-9b0b-e1eb442d72a8",
                                                "sense_id": "a8f95c39-798e-3aec-86f0-e8aac638c952",
                                                "text": "I was that interested because I wanted the Z28, but I wasn't going another day with Sterling stunting on me with the Contour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33b1480c-5f82-3e77-96b6-258acf884787",
                                        "entry_id": "6c97aa99-6cfc-3624-9fff-3e7e276ee36e",
                                        "glosses": [
                                            "To check or hinder the growth or development of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfc8ce88-0733-4640-81a1-86716de4a897",
                                                "sense_id": "33b1480c-5f82-3e77-96b6-258acf884787",
                                                "text": "Some have said smoking stunts your growth."
                                            },
                                            {
                                                "example_id": "06226eaf-72ce-46d6-a576-b23f3b1e309d",
                                                "sense_id": "33b1480c-5f82-3e77-96b6-258acf884787",
                                                "text": "The politician timed his announcement to stunt any surge in the polls his opponent might gain from the convention."
                                            }
                                        ]
                                    }
