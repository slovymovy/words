                    {
                        "sense_id": "d34a30fc-8c65-3575-9025-3ec8b6993a20",
                        "entry_id": "ac3f2a01-a222-373b-b3d9-daf041a724b5",
                        "glosses": [
                            "Variante de hylémorphisme."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "2335c678-b975-431f-bed4-476da1021347",
                                "sense_id": "d34a30fc-8c65-3575-9025-3ec8b6993a20",
                                "text": "L’âme n’est ni angéliquement spirituelle, ni intrinsèquement dépendante de la matière : voilà les deux vérités sur lesquelles il faut se repérer, si l’on veut avancer sûrement dans l’étude de l’hylomorphisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d18a9a5-2f86-41a9-8ccb-1ef143f7a82a",
                        "source_entry_id": "ac3f2a01-a222-373b-b3d9-daf041a724b5",
                        "source_sense_id": "d34a30fc-8c65-3575-9025-3ec8b6993a20",
                        "target_lang_word": "Hylemorphismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hylemorphismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5e016f-5a9e-33dc-b4ba-237e6cff998c",
                                        "entry_id": "02d139ee-199a-3c7e-a815-e59b6348a442",
                                        "glosses": [
                                            "naturphilosophische Lehre des Aristoteles, nach der sich alle körperlichen Einzeldinge aus den beiden Prinzipien des Stoffes und der Form zusammensetzen"
                                        ],
                                        "tags": [
                                            "ὕλη (hylē^☆) ^(→ grc",
                                            "μορφή (morphē^☆) ^(→ grc"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb446260-8dce-4840-85f2-79935173addd",
                                                "sense_id": "dd5e016f-5a9e-33dc-b4ba-237e6cff998c",
                                                "text": "„Wenn aber Natur für Aristoteles der Inbegriff bewegter Körper ist, so fragt sich, woran und wie sich Bewegungen vollziehen. Hierfür prägt er das Begriffspaar von „Stoff (hylê)“ und „Form (morphê […])“, so dass diese Theorie später auch Hylemorphismus genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
