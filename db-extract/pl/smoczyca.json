                "senses": [
                    {
                        "sense_id": "5196603a-bb20-3bb5-b982-9004da8a5ae1",
                        "entry_id": "136021e3-7fac-34c2-8d52-e0455cf17dab",
                        "glosses": [
                            "samica smoka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52316a70-1e3d-461b-a98b-f05adb34ed49",
                                "sense_id": "5196603a-bb20-3bb5-b982-9004da8a5ae1",
                                "text": "Niania opowiedziała dzieciom bajkę o smoczycy zakochanej po uszy w ośle."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "005ad857-9aea-4d6a-adcd-b811c4bf6a16",
                        "source_entry_id": "136021e3-7fac-34c2-8d52-e0455cf17dab",
                        "source_sense_id": "5196603a-bb20-3bb5-b982-9004da8a5ae1",
                        "target_lang_word": "dragoness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragoness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "782e9f28-df34-3ba9-9a45-5b351d4ce4fa",
                                        "entry_id": "313de550-bda9-3a62-a122-00a2a0b7797d",
                                        "glosses": [
                                            "A female dragon."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46c94943-4471-433c-8afd-1a1a144e0a35",
                                                "sense_id": "782e9f28-df34-3ba9-9a45-5b351d4ce4fa",
                                                "text": "The King Apollo, with an arrow, freed / From his strong string, destroy’d the Dragoness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4058129-e6d4-38dc-aaef-8a5c12ac77eb",
                                        "entry_id": "313de550-bda9-3a62-a122-00a2a0b7797d",
                                        "glosses": [
                                            "A female dragon."
                                        ],
                                        "tags": [
                                            "especially",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea0ffa1-ddec-4c1f-a6f0-787d54170939",
                                                "sense_id": "f4058129-e6d4-38dc-aaef-8a5c12ac77eb",
                                                "text": "But what really catches my attention about this dragoness is her thick tail, which looks to be twice as thick as a normal dragon tail. And I really don't know how to say this, except to say that this dragoness is seriously luscious. Maybe that's a terrible thing to say because I'm dying and all, but there it is. This is one seriously juicy-looking dragonette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "790c6385-1bf5-47d0-8ef4-f0fa5a80d7e0",
                        "source_entry_id": "136021e3-7fac-34c2-8d52-e0455cf17dab",
                        "source_sense_id": "5196603a-bb20-3bb5-b982-9004da8a5ae1",
                        "target_lang_word": "dračice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dračice",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0d11fc2a-5f21-3734-bc73-bb864379a588",
                                        "entry_id": "9dfb916a-ea6a-35ed-84c5-017a00137fd7",
                                        "glosses": [
                                            "samice draka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "769b2a69-f21c-497e-a5d9-ba624ea0c57a",
                                                "sense_id": "0d11fc2a-5f21-3734-bc73-bb864379a588",
                                                "text": "A tu se za nimi hnala třetí dračice i rozevřela tlamu svou od země až do nebe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda4bb93-7e00-37bc-ab4d-dc614c252551",
                                        "entry_id": "9dfb916a-ea6a-35ed-84c5-017a00137fd7",
                                        "glosses": [
                                            "zlá, prudká žena"
                                        ],
                                        "tags": [
                                            "expressively",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8434ea-b6c3-454e-bd08-40732a83cb2e",
                                                "sense_id": "eda4bb93-7e00-37bc-ab4d-dc614c252551",
                                                "text": "‚Ach, doufal jsem,‘ pravil, ‚že si ženu beru, zatím mne však jenom divý vzal si čert! […] Žena dračice je — rozehnala mleče, kola zahálejí, hnije podlaha.‘"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cca037d6-52e4-49eb-b6cb-86b309dc0e6a",
                        "source_entry_id": "136021e3-7fac-34c2-8d52-e0455cf17dab",
                        "source_sense_id": "5196603a-bb20-3bb5-b982-9004da8a5ae1",
                        "target_lang_word": "dracène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dracène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97bb5e10-ead8-3772-bd31-eba3ecd36202",
                                        "entry_id": "9d0d822e-2d29-3fc9-ae79-2bcb8d3e9c7e",
                                        "glosses": [
                                            "Dragonne ; dragon femelle."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3019fe4-4637-48ea-b5b0-bfd49c109eec",
                                                "sense_id": "97bb5e10-ead8-3772-bd31-eba3ecd36202",
                                                "text": "Un poème du VIIᵉ siècle conte la venue du dieu à Pythô, l’Hymne homérique à Apollon : après sa naissance, le dieu cherche un sanctuaire digne de lui et se fixe à Delphes où il tue de ses flèches un dragon, ennemi de la lumière, ou plutôt une dracène, que la Terre a suscitée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dracène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab4966e-7dde-3f11-ba25-f0c41236ced7",
                                        "entry_id": "f50638b5-403f-366e-849d-e19731b93b59",
                                        "glosses": [
                                            "Genre de lézard américain, de nom scientifique Dracaena."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76ce81ba-2779-420c-8253-83eec519ff6d",
                                                "sense_id": "1ab4966e-7dde-3f11-ba25-f0c41236ced7",
                                                "text": "Le dracène reste peu connu des scientifiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c158821-c699-4325-8680-6826f5160f6a",
                        "source_entry_id": "136021e3-7fac-34c2-8d52-e0455cf17dab",
                        "source_sense_id": "5196603a-bb20-3bb5-b982-9004da8a5ae1",
                        "target_lang_word": "dragonne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be7b48b5-ddb8-35ab-b972-e682018ec244",
                                        "entry_id": "511d07c8-4903-3fc8-bdd8-cbd79766247a",
                                        "glosses": [
                                            "Dracène, dragon femelle."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef44ec76-71b9-41b5-9f16-627c3cfdbe93",
                                                "sense_id": "be7b48b5-ddb8-35ab-b972-e682018ec244",
                                                "text": "Et elle allait, comme une dragonne, au milieu des gibets, pour tirer les yeux aux pendus ; et, comme une paladine, à travers les cimetières, pour arracher les ongles des morts, à la belle heure de minuit."
                                            },
                                            {
                                                "example_id": "4134cc24-f969-479a-8a49-8b8bf14af643",
                                                "sense_id": "be7b48b5-ddb8-35ab-b972-e682018ec244",
                                                "text": "Sainte-Marthe a le pied sur la dragonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cf1cf6-cab4-32f8-bcb2-38a3f8f2c463",
                                        "entry_id": "511d07c8-4903-3fc8-bdd8-cbd79766247a",
                                        "glosses": [
                                            "Femme vive et acariâtre, dragon."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434d90ed-1765-4921-8d14-ffed2f4a4060",
                                                "sense_id": "c7cf1cf6-cab4-32f8-bcb2-38a3f8f2c463",
                                                "text": "Tu quittes le soin de ton négoce, et tu laisses aller tes affaires à l’abandon ; tu ne manges plus, tu ne bois presque plus, tu perds le repos de la nuit ; et tout cela, pour qui ? Pour une dragonne, franche dragonne ; une diablesse qui te rembarre, et se moque de tout ce que tu peux lui dire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7da9830-94db-3edf-b85e-e6395772af50",
                                        "entry_id": "511d07c8-4903-3fc8-bdd8-cbd79766247a",
                                        "glosses": [
                                            "Batterie de tambour particulière aux dragons."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde38a0e-cb34-414b-bc23-d3eb52fa763c",
                                                "sense_id": "c7da9830-94db-3edf-b85e-e6395772af50",
                                                "text": "A cette nouvelle, le comte de Broglie fait mettre ses troupes en bataille. […] Catinat fait battre la dragonne, à grands roulements de tambours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b7fe08-23e1-30b4-b78a-9f6448e86652",
                                        "entry_id": "511d07c8-4903-3fc8-bdd8-cbd79766247a",
                                        "glosses": [
                                            "Cordon ou galon d’or, d’argent, de laine, etc., qui est ordinairement terminé par un gland, et dont on garnit la poignée d’une épée ou d’un sabre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9506e35b-3e11-45e8-acf6-bb4c27235956",
                                                "sense_id": "27b7fe08-23e1-30b4-b78a-9f6448e86652",
                                                "text": "Cette partie, appelée passementerie d’or et d’argent, comprenait les épaulettes, les dragonnes, les aiguillettes, enfin cette immense quantité de choses brillantes qui scintillaient sur les riches uniformes de l’armée française et sur les habits civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff2884a9-5727-3e1f-985b-929b3414c9b9",
                                        "entry_id": "511d07c8-4903-3fc8-bdd8-cbd79766247a",
                                        "glosses": [
                                            "Cordon en forme d’anneau fixé à certains objets pour éviter leur chute accidentelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eae9c15-518b-4fc0-ab6b-d20a5fe7b778",
                                                "sense_id": "ff2884a9-5727-3e1f-985b-929b3414c9b9",
                                                "text": "Le douanier sénégalais, dépité, demanda à Romain son appareil photo, que celui-ci lui tendit sans en lâcher la dragonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dac53dcf-ddd7-3afc-bb17-4d6f8c50cd0e",
                                        "entry_id": "511d07c8-4903-3fc8-bdd8-cbd79766247a",
                                        "glosses": [
                                            "Lanière de bâton de ski."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc28d51e-f5e6-4195-9936-a4d28d786aba",
                                                "sense_id": "dac53dcf-ddd7-3afc-bb17-4d6f8c50cd0e",
                                                "text": "Luc Alphand, ancien champion de ski, a rendu visite à l’entreprise Janisset qui a notamment fabriqué ses dragonnes lorsqu’il skiait […]"
                                            }
                                        ]
                                    }
                                ]
                            },
