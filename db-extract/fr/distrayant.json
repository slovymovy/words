                        ],
                        "form": "distrayantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                        "entry_id": "8ad97cef-634a-35e1-ad04-f855a2faaa47",
                        "glosses": [
                            "Qui est propre à distraire, à délasser et divertir l'esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0deb86c-7a5f-4950-be50-bb24a4225207",
                                "sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                                "text": "Le libéralisme et l’expérimentation sexuelle ne sont que la partie la plus distrayante d'une transformation mentale plus vaste. Sans être obligatoirement la plus importante."
                            },
                            {
                                "example_id": "4f88239c-e4ed-472c-a815-05b41bc0fc29",
                                "sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                                "text": "[…] ; oui, je pars à Bamako toute la semaine et pour ne pas trop m'ennuyer dans ma piaule, je viens chercher un bouquin distrayant, qu'est-ce que tu aurais à me conseiller ? Tant qu'à faire, j'aimerais autant que ce soit un bouquin amusant et même pourquoi pas un bouquin de cul !"
                            },
                            {
                                "example_id": "dc2fb142-64b9-4d33-bdd4-17ecf43d8625",
                                "sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                                "text": "Le Magasin d’éducation et de récréation se présente comme un journal dont le but est de diffuser les connaissances au sein d'articles distrayants."
                            },
                            {
                                "example_id": "e11a0b6f-506d-435f-90bd-63ef41ecbf20",
                                "sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                                "text": "Conseiller économique de Fillon, le distrayant Éric Woerth allait partout clamer les mérites de ce « contre-choc fiscal », seul apte à redresser la France, courageux, réaliste, chiffré, solide, pas démago."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "114b2373-0ec1-46e4-abb6-902fa55bb409",
                        "source_entry_id": "8ad97cef-634a-35e1-ad04-f855a2faaa47",
                        "source_sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                        "target_lang_word": "unterhaltsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterhaltsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c7fd8e5-5218-379e-8c15-ce7a46d29d19",
                                        "entry_id": "6a47d0d4-ab6e-3479-923d-06a6f8ec88f8",
                                        "glosses": [
                                            "auf angenehme Weise die Zeit vertreibend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b35f26d0-5b92-40cc-8239-f457ab21a8b4",
                                                "sense_id": "0c7fd8e5-5218-379e-8c15-ce7a46d29d19",
                                                "text": "Der Moderator gestaltet die Show sehr unterhaltsam."
                                            },
                                            {
                                                "example_id": "8c94be9b-6d03-4fc4-a456-cf4eb41c7e1c",
                                                "sense_id": "0c7fd8e5-5218-379e-8c15-ce7a46d29d19",
                                                "text": "Ich finde Familienspielabende immer unterhaltsam."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a6f75f6-a728-4777-bb08-9c8b4108a534",
                        "source_entry_id": "8ad97cef-634a-35e1-ad04-f855a2faaa47",
                        "source_sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                        "target_lang_word": "kurzweilig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurzweilig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1551c62-017e-3405-bbdf-775ff05bba47",
                                        "entry_id": "011e9688-1497-3861-83a9-3766c7c9a63c",
                                        "glosses": [
                                            "unterhaltsam und interessant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26bd7fd0-5a5c-4b7e-8500-c376c0010029",
                                                "sense_id": "f1551c62-017e-3405-bbdf-775ff05bba47",
                                                "text": "Der Spaziergang entpuppte sich als kurzweilige Wanderung durch das alte Stadtzentrum."
                                            },
                                            {
                                                "example_id": "8b344a18-caf6-423b-bbcf-ebd0fb735a7a",
                                                "sense_id": "f1551c62-017e-3405-bbdf-775ff05bba47",
                                                "text": "Hast du das hier schon durchgeblättert? Es ist ein kurzweiliger Leitfaden zum Flirten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f83e0152-0b14-454c-bc0b-cda74d6bbc8e",
                        "source_entry_id": "8ad97cef-634a-35e1-ad04-f855a2faaa47",
                        "source_sense_id": "918323c2-24d5-304c-b2bf-67e98e71e780",
                        "target_lang_word": "amusing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d578877-ecef-3472-8b48-819b6b3d2de5",
                                        "entry_id": "0d01d279-10b7-3c8c-952a-10aa4dc07953",
                                        "glosses": [
                                            "present participle and gerund of amuse"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "amusing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                        "entry_id": "0e7befe2-b24e-3a14-8035-5b3972567b8b",
                                        "glosses": [
                                            "Entertaining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d53639-14d7-4c02-9f38-356a22bcab6f",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "The film has some amusing moments, but it is unlikely to make you laugh out loud."
                                            },
                                            {
                                                "example_id": "2faea8de-1561-413a-a52a-91e9257a8205",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "We don’t get amusinger as we get older, we grow prosy and repeat ourselves and talk about our complaints and selfish grievances: but our old friends bear up with our dullness for old times’ sake; […]"
                                            },
                                            {
                                                "example_id": "e11d9d9e-d0cc-4964-b2d8-3a23db37a84c",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "Never borrow money for my amusements. Now paying Mrs. McCrowder just at this present period would be an amusement. In fact when we consider the quality of the article she gives, I think that paying her on the nail would be about the amusingest little thing I could do."
                                            },
                                            {
                                                "example_id": "733c2dce-8524-4185-afae-05cebec78f3a",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            },
                                            {
                                                "example_id": "ff189bc1-ec96-468e-ba10-68036398783a",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "They seem amusing on the first day of Christmas, daft on the second, embarrassing on the third. By the twelfth they're in landfill. For 30 seconds of dubious entertainment, or a hedonic stimulus that lasts no longer than a nicotine hit, we commission the use of materials whose impacts will ramify for generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd842e1-90dd-3bf8-bbd2-7d6e8d3def25",
                                        "entry_id": "0e7befe2-b24e-3a14-8035-5b3972567b8b",
                                        "glosses": [
                                            "Funny, hilarious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd99026-da52-42c1-8520-99ffea3f0c05",
                                                "sense_id": "cbd842e1-90dd-3bf8-bbd2-7d6e8d3def25",
                                                "text": "An amusing incident on the first of these journeys was the checking by signal of the flyer about 3 miles out of Paris, with the result that it was overhauled by the 6.25 p.m. semi-fast from Paris to Montargis, to the unconcealed delight of passengers in the latter."
                                            },
                                            {
                                                "example_id": "a57d7f71-8f80-49b0-97c0-6b7e16ad6718",
                                                "sense_id": "cbd842e1-90dd-3bf8-bbd2-7d6e8d3def25",
                                                "text": "[T]hey’d had to call it something – i.e. something that differentiated this occasion from others where they might just go for a pint or a curry. So beer & sausages had somehow happily invented itself, […] The best thing, of course, the amusingest thing, was that no one ever brought beer and Jas had only actually done sausages once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
