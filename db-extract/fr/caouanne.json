                        ]
                    },
                    {
                        "translation_id": "e96fe376-8937-4ca9-a3ea-0ab1e4b442fe",
                        "source_entry_id": "429791d2-a17b-3027-b740-5a3d8d7611ff",
                        "source_sense_id": "427ba3aa-f1ca-3ea9-a9bd-39a0f99041af",
