                        "entry_id": "c9f9cfb3-4686-392e-a466-007d8e5db7de",
                        "tags": [
                            "plural"
                        ],
                        "form": "tiddlies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dda3a51b-5abd-3d13-a899-6cb9b185c004",
                        "entry_id": "c9f9cfb3-4686-392e-a466-007d8e5db7de",
                        "glosses": [
                            "An alcoholic beverage."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "34f6b0db-cc52-43f8-b711-9cc4230f27c6",
                                "sense_id": "dda3a51b-5abd-3d13-a899-6cb9b185c004",
                                "text": "As far as he could tell, except for her evening ‘tiddlies’, two rather hefty drinks taken ‘neat’ without the diluting benefit of water or ice, his mother had very nearly stopped her drinking."
                            },
                            {
                                "example_id": "b54d84c4-6486-4924-8259-601c58e52bbb",
                                "sense_id": "dda3a51b-5abd-3d13-a899-6cb9b185c004",
                                "text": "Well, hell, I figured we’d just save that money, get us a few tiddlies at Fat Ernst’s instead."
                            },
                            {
                                "example_id": "19de51d3-8ec9-45b6-a8dc-811bcc3573a6",
                                "sense_id": "dda3a51b-5abd-3d13-a899-6cb9b185c004",
                                "text": "JC heard him remark, “I need a bit of the tiddly my dear. It’s been a hard day.” Tiddly, hm, must be an English drink?"
                            }
                        ]
                    }
                ],
