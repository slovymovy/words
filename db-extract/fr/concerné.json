        "fr-extract.jsonl": [
            {
                "entry_id": "6743eb4d-82a8-304a-8c73-8016ddfaef97",
                "word": "concerné",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "35572901-d1d4-3d9d-912b-bd2c59ba0702",
                        "entry_id": "6743eb4d-82a8-304a-8c73-8016ddfaef97",
                        "glosses": [
                            "Participe passé masculin singulier de concerner."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "43e470b2-9101-4b4f-b4f8-c5d4d8687877",
                                "sense_id": "35572901-d1d4-3d9d-912b-bd2c59ba0702",
                                "text": "J'avais oublié que Suzic avait joué là-bas. Était-il encore un peu concerné par ce qui se passait sur le terrain?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8b2c910-9b6c-3b0c-ba67-58bd724f505f",
                        "entry_id": "6743eb4d-82a8-304a-8c73-8016ddfaef97",
                        "glosses": [
                            "Se dit d’une personne appartenant à un groupe minoritaire, concernée par une situation impliquant des discriminations."
                        ],
                        "tags": [
                            "Luttes sociales"
                        ],
                        "examples": [
                            {
                                "example_id": "c5f6d30c-7530-48ca-90e3-26c593a9db25",
                                "sense_id": "a8b2c910-9b6c-3b0c-ba67-58bd724f505f",
                                "text": "Les personnes concernées seront les mieux à même de qualifier leur situation."
                            },
                            {
                                "example_id": "b4c399aa-2162-4af0-934f-1d05ad181bba",
                                "sense_id": "a8b2c910-9b6c-3b0c-ba67-58bd724f505f",
                                "text": "Il nous apparaît primordial d’insister sur le fait que l’avis le plus important – et finalement peut-être le seul qui importe ? – est celui des personnes concernées, puisqu’elles sont les plus à même de comprendre les situations d’oppression auxquelles elles sont confrontées et donc le type d’appui dont elles ont besoin, quand et comment elles en ont besoin."
                            }
                        ]
                    }
                ],
