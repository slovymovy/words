                        "examples": [
                            {
                                "example_id": "479c226a-e685-4486-a47b-62c71c934475",
                                "sense_id": "6700e99a-d29f-37ef-8fbd-7df8315cc961",
                                "text": "‘We hebben 24 niveaus aan stellingen moeten afwandelen. Door de staat van de stellingen kwam daar zelfs een alpinist aan te pas’, zegt Vandesande. Uiteindelijke leverde het bureau twee modellen af: een van de huidige situatie met stellingen en één zonder stellingen. ‘De visualisatie van het steigerloze Justitiepaleis, maakt geen deel uit van de opdracht, maar we willen het publiek een blik gunnen op wat wij in onze data kunnen zien.’"
                            }
