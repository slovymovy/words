                            {
                                "example_id": "ecd6d04f-ab87-4940-a18e-d4d4626c29a4",
                                "sense_id": "38a10966-9284-34a2-ac41-3451a5eee8f4",
                                "text": "Crampton. Your name is Sophronia, girl: you were called after your aunt Sophronia, my sister: she gave you your first Bible with your name written in it."
                            },
                            {
                                "example_id": "af05a7de-28d3-401b-9448-ab046b4364bc",
                                "sense_id": "38a10966-9284-34a2-ac41-3451a5eee8f4",
                                "text": "After casting about for some time for a name which should be worthy of her, he decided in favour of Sophronia Sphynx, as being euphonious and genteel, and furthermore indicative of mystery."
                            }
                        ]
                    }
