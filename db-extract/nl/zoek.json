                        "source_sense_id": "fc9fe059-969d-34da-95fb-7136966d39ec",
                        "source_sense_description": "niet terug te vinden",
                        "target_lang_word": "abgängig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abgängig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45863761-109b-3494-af58-08fc57bb9800",
                                        "entry_id": "2f266f89-c37f-355e-ad17-668b10d676c2",
                                        "glosses": [
                                            "Amtssprache, besonders in Österreich und Liechtenstein: vermisst, verschwunden (Personen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e931522-beec-44bc-a3a9-c89c7f51c6f6",
                                                "sense_id": "45863761-109b-3494-af58-08fc57bb9800",
                                                "text": "„Suche nach Lebenszeichen – 160 Jugendliche in Österreich abgängig“"
                                            },
                                            {
                                                "example_id": "35c1fe1d-49e2-4e7c-a52e-3748080f0de4",
                                                "sense_id": "45863761-109b-3494-af58-08fc57bb9800",
                                                "text": "„Der Aufenthaltsort der als abgängig gemeldeten Personen muß festgestellt werden, denn der Rücktransport kann nur auf Grund sicherer Angaben erfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb9ec094-b48f-30ae-912c-2ea52886876c",
                                        "entry_id": "2f266f89-c37f-355e-ad17-668b10d676c2",
                                        "glosses": [
                                            "verbraucht, untauglich, überflüssig"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1afccc03-63c9-4140-927f-20c85d882b0d",
                                                "sense_id": "bb9ec094-b48f-30ae-912c-2ea52886876c",
                                                "text": "„Also, wo ausgewachsene oder abgängige Bäume in der jungen Klasse III wären, müßten sie zuerst gehauen werden, weil sonst erst nach sechszig bis neunzig Jahren, nämlich nach Fällung der Klassen I und II der Holzschlag an sie käme.“"
                                            },
                                            {
                                                "example_id": "b6f02a23-7510-466a-bc0a-9fa5f277be41",
                                                "sense_id": "bb9ec094-b48f-30ae-912c-2ea52886876c",
                                                "text": "„Eine inzwischen abgängige Bauinschrift (CIA II 91) berichtete, dass die Anlage 1386p von Asbugha ihn Halat, dem Superintendanten der beiden Haram von Jerusalem und Hebron, im Auftrag des Sultans al-Zahir Barquq erneuert und als gemeinnützige Stiftung (arab. Waqf) für den Haram eingebracht wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64a7da51-e555-46f8-9d73-982837d58176",
                        "source_entry_id": "cdbef96a-8ded-359f-b970-ccd2eac0268e",
