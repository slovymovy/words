                                                "sense_id": "3dc14663-8267-3102-85b4-c2742f361d70",
                                                "text": "„Erst Jahre später bemerkten wir, welcher Unernst sich dahinter verbarg, welche Großspurigkeit, hiner der sich meist Kleingeister verstecken.“"
                                            },
                                            {
                                                "example_id": "a5395150-ab3d-4d25-9568-e813e6101404",
                                                "sense_id": "3dc14663-8267-3102-85b4-c2742f361d70",
                                                "text": "„Plötzlich musste er über die Großspurigkeit seiner Behauptung lächeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
