        "nl-extract.jsonl": [
            {
                "entry_id": "c661b9b0-dff0-354c-ba59-846fbf3d8b9d",
                "word": "Helhond",
                "pos": "name",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7807ad97-19dd-414f-bf66-7dfec37b79b6",
                        "entry_id": "c661b9b0-dff0-354c-ba59-846fbf3d8b9d",
                        "tags": [
                            "possessive"
                        ],
                        "form": "Helhonds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc819f72-fdf2-34fc-a865-a55c90c1715f",
                        "entry_id": "c661b9b0-dff0-354c-ba59-846fbf3d8b9d",
                        "glosses": [
                            "driekoppige hond die in de Griekse en Romeinse mythologie de toegang tot de onderwereld bewaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dcc5390-c1c7-44cc-aabb-9e33d9bf853c",
                                "sense_id": "dc819f72-fdf2-34fc-a865-a55c90c1715f",
                                "text": "⧖ En zij meldden, dat, op het onverwachts, Herakles in Mykenae verschenen was, met, aan drie kettingen, den Helhond in toom, ontzettend bassenden Kerberos, gemuileband de drie muilen, en dat hij hem vertoond had aan den verbaasden volke en aan den vorst, die diep in zijn paleis was gevlucht van ontzetting, en, verscholen achter de zuilen, had uit geroepen, dat Herakles vrij was van slavernij en van boete, zoodra hij het monster weêr naar Hades terug had gevoerd…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b3732af-54f2-40a9-ae83-955680719c4a",
                        "source_entry_id": "c661b9b0-dff0-354c-ba59-846fbf3d8b9d",
                        "source_sense_id": "dc819f72-fdf2-34fc-a865-a55c90c1715f",
                        "source_sense_description": "mythologische hond",
                        "target_lang_word": "Höllenhund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höllenhund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                        "entry_id": "2e64fb50-de8b-3e84-a13a-2f0b08f3727d",
                                        "glosses": [
                                            "bösartiger, höllischer Hund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e1bbc76-af9a-496e-b642-567bda7a01a2",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Unter meiner Obhut verwandelte sich der Höllenhund, der er vorher war, in einen kleinen Welpen.“"
                                            },
                                            {
                                                "example_id": "e27641bd-d8c8-4d4d-aca2-25aab4dba8ef",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Sie kletterten abwärts; der runzlige Hexenmeister, der Höllenhund und der Mann Gottes stiegen in die Schwärze des Lochs hinab.“"
                                            },
                                            {
                                                "example_id": "5cc70fd9-a270-481d-9495-7239ce7cbcad",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„›Und Madison wusste, wenn sie ihre teuflische Mission totaler Verdammnis nicht konsequent zum Abschluss brächte, würden Satans Höllenhunde demnächst ihr hilfloses Kätzchen aufspüren und an seiner Haut Verträglichkeitstests für ein neues Damenhygienespray vornehmen!‹“"
                                            },
                                            {
                                                "example_id": "6d9e6a0a-174d-4a98-b9b4-d006dd91e012",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Aber die Höllenhunde passen auch durch das Öhr eines Rings.“"
                                            },
                                            {
                                                "example_id": "66ff04d0-45ac-44bc-96fd-8c3cfd2e9d23",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Sie sehen wie echte Höllenhunde aus, die niemand streicheln will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
