                ],
                "senses": [
                    {
                        "sense_id": "1f91ef7a-04f5-31d4-bc14-ad47c83eb784",
                        "entry_id": "829eed75-b1bd-371c-a805-1afdc2ab6cdb",
                        "glosses": [
                            "Rendre hyperfluide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "835c9d55-a2d1-4b90-9340-49ca021b09b7",
                                "sense_id": "1f91ef7a-04f5-31d4-bc14-ad47c83eb784",
                                "text": "Il ne s’agit donc pas d’hyper-fluidifier sa circulation sanguine mais de rester dans un sage entre-deux."
                            },
                            {
                                "example_id": "5d1c9d46-51c3-45f6-88a0-9dd2efdf488b",
                                "sense_id": "1f91ef7a-04f5-31d4-bc14-ad47c83eb784",
                                "text": "Si je me souviens bien, le principe de la mort-aux-rats est d’hyper-fluidifié ^([sic : hyper-fluidifier]) le sang, ce qui entraine des hémorragies internes, des dommages cérébraux, convulsions etc."
                            },
                            {
                                "example_id": "7485b24c-f09a-4c14-80a5-16b335a421c9",
                                "sense_id": "1f91ef7a-04f5-31d4-bc14-ad47c83eb784",
                                "text": "J’espère que c’est toujours possible de désactiver l’effet « vidéo illuminé hyper-fluidifié » sur ces télés modernes pour retrouver l’image d’origine, non ?"
                            }
                        ]
                    }
