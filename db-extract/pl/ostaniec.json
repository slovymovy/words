                    {
                        "translation_id": "89f07446-23a0-4c2a-a260-e4a84ab1a110",
                        "source_entry_id": "e6d1e30f-011b-3be7-bfdd-8ad3f73db4dd",
                        "source_sense_id": "c77c0bdd-365d-39fd-bf0b-25f62361f520",
                        "target_lang_word": "monadnock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monadnock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afafb64-d7b1-3a78-8e71-bf9300605984",
                                        "entry_id": "a1a8c0e7-c46c-3892-8581-b61e3ad56282",
                                        "glosses": [
                                            "A hill or mountain standing isolated above a predominantly flat plain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d25ebb81-fa06-4c64-b240-9992bf337eee",
                                                "sense_id": "6afafb64-d7b1-3a78-8e71-bf9300605984",
                                                "text": "Eastward from the White Mountains, the open sea of the upland country comes right to the monadnock shore, with hardly an outlying island; southward the upland is covered for miles by an archipelago of monadnock groups and peaks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "804d1cb3-c2b5-4f59-a1b6-47583a0c5096",
                        "source_entry_id": "e6d1e30f-011b-3be7-bfdd-8ad3f73db4dd",
                        "source_sense_id": "c77c0bdd-365d-39fd-bf0b-25f62361f520",
                        "target_lang_word": "outlier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outlier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8867620-59b2-3281-bc75-3a7811fda191",
                                        "entry_id": "7aeb9edf-c026-3ebd-a792-24a3f78c086d",
                                        "glosses": [
                                            "A person or thing situated away from the main body or outside its proper place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdecc23-bc32-41d7-b32e-e8aa3a985561",
                                                "sense_id": "f8867620-59b2-3281-bc75-3a7811fda191",
                                                "text": "Observing as an outlier from Scotland, Hynes sums up the industry problem: \"The conversation we've had for this article is really about creating an environment in which better decisions can be taken, isn't it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c52e05b-a25b-3464-9ad8-427bc6f0bfe0",
                                        "entry_id": "7aeb9edf-c026-3ebd-a792-24a3f78c086d",
                                        "glosses": [
                                            "An exception."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cac678d9-24f2-3f71-8c54-8487970fa45c",
                                        "entry_id": "7aeb9edf-c026-3ebd-a792-24a3f78c086d",
                                        "glosses": [
                                            "A part of a formation separated from the rest of the formation by erosion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "378512f7-a18f-3b5b-b786-5af395641032",
                                        "entry_id": "7aeb9edf-c026-3ebd-a792-24a3f78c086d",
                                        "glosses": [
                                            "A value in a statistical sample which does not fit a pattern that describes most other data points; specifically, a value that lies 1.5 IQR beyond the upper or lower quartile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f369cc03-51a0-4b27-8170-53bfa432e20e",
                        "source_entry_id": "e6d1e30f-011b-3be7-bfdd-8ad3f73db4dd",
                        "source_sense_id": "c77c0bdd-365d-39fd-bf0b-25f62361f520",
                        "target_lang_word": "inselberg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inselberg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18bc143b-3afe-332f-a2ef-ab4ca9e7bd50",
                                        "entry_id": "39427772-9f8b-37d2-b952-87f51d202085",
                                        "glosses": [
                                            "A monadnock (isolated mountain)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e7427a-0bed-4e41-b9fe-9ceb94abcf12",
                                                "sense_id": "18bc143b-3afe-332f-a2ef-ab4ca9e7bd50",
                                                "text": "Click: forest elephant, stern and alert. Click: humpback whale, breaching skyward like a frisky trout. Click: Gaboon viper, its big coppery head so close to the lens you could almost feel the flick of its tongue. Click: granite inselberg, like a great igneous gumdrop, protruding above forest canopy. Click: bulge-eyed hippopotamus, almost unrecognizably strange and serene, riding a wave along the Atlantic coast."
                                            },
                                            {
                                                "example_id": "db1637f5-5439-412b-b7c7-335d406b68ff",
                                                "sense_id": "18bc143b-3afe-332f-a2ef-ab4ca9e7bd50",
                                                "text": "From the north, the road into Nigeria’s purpose-built capital is strewn with inselbergs, vast monolithic stone outcrops that rise abruptly out of the lush savannah. At the centre of the country, the city became the seat of government in 1991 after Lagos had become too crowded and chaotic."
                                            },
                                            {
                                                "example_id": "02517854-e916-403c-8637-63888854bd9d",
                                                "sense_id": "18bc143b-3afe-332f-a2ef-ab4ca9e7bd50",
                                                "text": "Ground penetrating radar can map the foundation of Gulem menhir and establish its identity either as a natural geological oddity, a natural inselberg or a manmade menhir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbd9af8d-af0c-4cba-8924-dfabc4eb4704",
                        "source_entry_id": "e6d1e30f-011b-3be7-bfdd-8ad3f73db4dd",
                        "source_sense_id": "c77c0bdd-365d-39fd-bf0b-25f62361f520",
                        "target_lang_word": "cerro testigo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "56f97fe4-e84c-4d03-8f51-50fa707fe1b9",
                        "source_entry_id": "e6d1e30f-011b-3be7-bfdd-8ad3f73db4dd",
                        "source_sense_id": "c77c0bdd-365d-39fd-bf0b-25f62361f520",
                        "target_lang_word": "Zeugenberg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeugenberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b76bf8-b598-365d-8bf1-d6605807ce47",
                                        "entry_id": "3978cbce-134b-382e-9d68-57c2b20b8d09",
                                        "glosses": [
                                            "Einzelberg in einer Schichtstufenlandschaft, der durch Erosionsvorgänge vom Schichtstufenplateau, dem er ursprünglich angehörte, isoliert wurde"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c2c701f-47e3-4b13-b695-acf573fde639",
                                                "sense_id": "f6b76bf8-b598-365d-8bf1-d6605807ce47",
                                                "text": "Die Achalm ist ein klassischer Zeugenberg."
                                            },
                                            {
                                                "example_id": "3eed7414-ba03-40f9-84e8-d6eb7ae1c6db",
                                                "sense_id": "f6b76bf8-b598-365d-8bf1-d6605807ce47",
                                                "text": "„Der Staffelberg ist als isolierte Scholle ein sogenannter geologischer Zeugenberg des Jura im Obermaingraben.“"
                                            },
                                            {
                                                "example_id": "d6682670-9da5-4560-9ad5-4e917cedcd26",
                                                "sense_id": "f6b76bf8-b598-365d-8bf1-d6605807ce47",
                                                "text": "„Etwas links davon war auf einem Zeugenberg eine Ruine zu erkennen.“"
                                            },
                                            {
                                                "example_id": "31432dfa-31c4-4b53-80b5-a6cf9327cb0d",
                                                "sense_id": "f6b76bf8-b598-365d-8bf1-d6605807ce47",
                                                "text": "„Dann öffnet sich Waldrand eine herrliche Aussicht auf Kurzenaltheim, Meinheim, das Altmühltal sowie den bewaldeten Trommetsheimer Berg, einen Zeugenberg aus Eisensandstein und Opalinuston des Braunjuras.“"
                                            },
                                            {
                                                "example_id": "b0949735-62d9-44c9-8a7b-6f3f63fcdb8f",
                                                "sense_id": "f6b76bf8-b598-365d-8bf1-d6605807ce47",
                                                "text": "„Ein fast perfekter Kegel, aber kein Vulkan – der Ipf ist ein Zeugenberg der östlichen Schwäbischen Alb, der Bopfingen 200 Meter überragt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
