                                        "sense_id": "6ac7ed93-d964-331e-8c61-5ddb37c51d3e",
                                        "entry_id": "bf1e0afe-0cff-3430-8799-ee25c3cf5160",
                                        "glosses": [
                                            "Planches qui, portant les tuyaux d’orgue, servent de couverture au sommier, et où se fait la distribution du vent."
                                        ],
