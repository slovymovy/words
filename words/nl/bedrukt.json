                                "target_lang_sense_clarification": "specifically for fabrics or surfaces with a design"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "напечатанный",
                                "target_lang_sense_clarification": "общее значение для текста или изображений"
                            },
                            {
                                "target_lang_word": "с принтом",
