                ],
                "senses": [
                    {
                        "sense_id": "30718e94-680c-32de-886f-001b04eb1bac",
                        "entry_id": "ce356288-d01e-32cb-b862-a42689a3e22f",
                        "glosses": [
                            "Casser, briser, au préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b9ecc7b-56c2-48e3-ac92-31e12fe0bdd8",
                                "sense_id": "30718e94-680c-32de-886f-001b04eb1bac",
                                "text": "Nous ne pré-cassons pas les pattes, juste les morceaux difficiles comme les pinces, et ce qui se trouve sous la carapace du crabe."
                            },
                            {
                                "example_id": "ed806d1b-28f1-4f4f-b18f-cf2d39c58813",
                                "sense_id": "30718e94-680c-32de-886f-001b04eb1bac",
                                "text": "Pré-casser les pinces sans les décortiquer."
                            },
                            {
                                "example_id": "ea8337b8-d37c-4799-8e56-289cc11e4936",
                                "sense_id": "30718e94-680c-32de-886f-001b04eb1bac",
                                "text": "Profitant que vous soyez dans le couloir en pleine discussion avec un collègue en goguette dans votre secteur, ils s’empareront des boîtes de craie et leur donneront un coup sec de manière à les pré-casser discrètement."
                            }
                        ]
                    },
