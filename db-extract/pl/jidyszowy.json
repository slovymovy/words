                "senses": [
                    {
                        "sense_id": "034f1938-ae73-3b03-a611-31779ac78454",
                        "entry_id": "f9fbfb3f-4f57-3c87-bb3e-9110db0acfaa",
                        "glosses": [
                            "związany z jidysz, dotyczący jidysz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6496d4f-b54e-467b-a731-167d3b0fd4fa",
                                "sense_id": "034f1938-ae73-3b03-a611-31779ac78454",
                                "text": "W swojej monografii zajęła się porównaniem przysłów jidyszowych i polskich, wykorzystując obszerne ich zbiory oraz dostępne opracowania specjalistyczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b39ac8a-2acc-453b-80ef-e3d317d1b469",
                        "source_entry_id": "f9fbfb3f-4f57-3c87-bb3e-9110db0acfaa",
                        "source_sense_id": "034f1938-ae73-3b03-a611-31779ac78454",
                        "target_lang_word": "Yiddish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yiddish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28a25a43-4d88-3197-9ff0-d955f35b88ad",
                                        "entry_id": "cc54e6e9-3326-3cbd-9291-5fe5c02f3561",
                                        "glosses": [
                                            "Of or pertaining to the Yiddish language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a3a7430-53cb-4851-90f0-bceedcd1f6fd",
                                                "sense_id": "28a25a43-4d88-3197-9ff0-d955f35b88ad",
                                                "text": "“Many goyim are confused by the large number of Yiddish terms beginning with ‘schl’ or ‘schm’ (schlemiel, schlemazzle, schmeggegge, schlub, schlock, schlep, schmutz, schnook), and use them incorrectly or interchangeably,” he wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b95164-a629-3dd1-b749-4450fc830ed6",
                                        "entry_id": "cc54e6e9-3326-3cbd-9291-5fe5c02f3561",
                                        "glosses": [
                                            "Jewish; relating to Yiddishkeit."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6276713b-4782-4b38-9e21-559d8a83bd91",
                                                "sense_id": "49b95164-a629-3dd1-b749-4450fc830ed6",
                                                "text": "Yiddish cooking; Yiddish music"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Yiddish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f779759-a43f-3ce6-abba-696fcf2bae6d",
                                        "entry_id": "3a4b711a-a60b-3220-864c-1313805d38e6",
                                        "glosses": [
                                            "A West Germanic, or more specifically High German, language that developed from Middle High German dialects, with an admixture of vocabulary from multiple source languages including Hebrew-Aramaic, Romance, Slavic, English, etc., and mostly written in Hebrew characters which is used mainly among Ashkenazic Jews from central and eastern Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dea1f6-707b-4abc-87d1-286416a8eadf",
                                                "sense_id": "7f779759-a43f-3ce6-abba-696fcf2bae6d",
                                                "text": "Yiddish is a High German language [...] two varieties of Yiddish developed [...]"
                                            },
                                            {
                                                "example_id": "650747f9-76fd-48f8-ba87-9537d825e7ed",
                                                "sense_id": "7f779759-a43f-3ce6-abba-696fcf2bae6d",
                                                "text": "As a Yiddish proverb has it: Badarf men hunik ven tsuker iz zis? Who needs honey when sugar is sweet?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d43d7c1-f7a9-4f0f-83d0-d6300674a640",
                        "source_entry_id": "f9fbfb3f-4f57-3c87-bb3e-9110db0acfaa",
                        "source_sense_id": "034f1938-ae73-3b03-a611-31779ac78454",
                        "target_lang_word": "jidišský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "315e83d7-ca45-4cc5-9dcf-83a1b98b3ccc",
                        "source_entry_id": "f9fbfb3f-4f57-3c87-bb3e-9110db0acfaa",
                        "source_sense_id": "034f1938-ae73-3b03-a611-31779ac78454",
                        "target_lang_word": "jiddisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jiddisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86698d70-5368-3e5b-99c2-b8562e97a74c",
                                        "entry_id": "c7179f51-36cd-3032-8f16-4c52b2112998",
                                        "glosses": [
                                            "die jiddische Sprache betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a37917d-5e89-4218-a996-ee7cb3b5d83e",
                                                "sense_id": "86698d70-5368-3e5b-99c2-b8562e97a74c",
                                                "text": "„Entsprechendes läßt sich auch an ländlichen Mundarten beobachten, in die je nach Anteil der Juden an der Bevölkerung eine mehr oder minder große Zahl jiddischer Wörter entlehnt worden ist.“"
                                            },
                                            {
                                                "example_id": "9c4bf749-1729-4088-aaf1-cb5ed4f1d4df",
                                                "sense_id": "86698d70-5368-3e5b-99c2-b8562e97a74c",
                                                "text": "„Die neuere jiddische Literatur hat zahlreiche Wurzeln im jüdischen Schrifttum vergangener Jahrhunderte.“"
                                            },
                                            {
                                                "example_id": "1efe1fcf-2a49-42ed-ad2a-16711e54026f",
                                                "sense_id": "86698d70-5368-3e5b-99c2-b8562e97a74c",
                                                "text": "„In Wilna und Minsk waren Institute für die jiddische Sprache entstanden.“"
                                            },
                                            {
                                                "example_id": "56d4e770-e129-4bc5-a09a-5e6be14a3824",
                                                "sense_id": "86698d70-5368-3e5b-99c2-b8562e97a74c",
                                                "text": "„Wie kommt es also, dass den Menschen im Rheinland zwar der Mischcharakter ihrer Alltagssprache bewusst ist, die jiddische Komponente dabei aber ausgeklammert bleibt?“"
                                            },
                                            {
                                                "example_id": "2e82179d-c18d-4782-841f-30acd862bc05",
                                                "sense_id": "86698d70-5368-3e5b-99c2-b8562e97a74c",
                                                "text": "„Die jiddischen Zeitungen schrieben über Ozjel und seine kleine Schule auf der Ulica Ciepła und druckten Dankesbriefe ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
