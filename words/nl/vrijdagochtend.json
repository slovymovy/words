                    "frequency": "Middle",
                    "semantic_group_id": "vrijdagochtend_tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben die hele <w>vrijdagochtend</w> in het ziekenhuis doorgebracht.",
                            "target_lang_translations": {
                                "en": "We spent that entire <w>Friday morning</w> in the hospital."
                            }
                        },
                        {
                            "text": "Iedere <w>vrijdagochtend</w> drinken we samen koffie op kantoor.",
                            "target_lang_translations": {
                                "en": "Every <w>Friday morning</w> we drink coffee together at the office."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijdagmorgen"
                    ],
                    "common_phrases": [
                        "komende vrijdagochtend",
                        "hele vrijdagochtend"
                    ],
                    "target_lang_definitions": {
                        "en": "The morning of Friday; the hours between night and afternoon on a Friday."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Friday morning",
                                "target_lang_sense_clarification": "the morning of Friday"
                            }
