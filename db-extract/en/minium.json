                    }
                ],
                "senses": [
                    {
                        "sense_id": "775cd502-b112-38bd-8aad-9be8b7acee01",
                        "entry_id": "53738106-f597-3fb1-a3ca-cbd22802160d",
                        "glosses": [
                            "Cinnabar, especially when used as a pigment; vermilion."
                        ],
                        "tags": [
                            "historical",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ac386a82-e125-3303-ad89-afbf85559e15",
                        "entry_id": "53738106-f597-3fb1-a3ca-cbd22802160d",
                        "glosses": [
                            "Red lead."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a9f0fab8-6360-4ca8-8f6f-74f53c7519f1",
                                "sense_id": "ac386a82-e125-3303-ad89-afbf85559e15",
                                "text": "The compounds formed by the combination of the peroxide of lead with the protoxide have received the general name of miniums, and are known in commerce as red lead."
                            },
                            {
                                "example_id": "9e67badd-07f8-4eae-84dc-6ddd0071ebba",
                                "sense_id": "ac386a82-e125-3303-ad89-afbf85559e15",
                                "text": "[H]e was so overcome by suffering that his face, which had once been of oriental minium, now became like orpiment, and the hams of his lips turned into rancid lard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9de447d9-51b4-4859-a6c6-9163d1cf2c19",
                        "source_entry_id": "53738106-f597-3fb1-a3ca-cbd22802160d",
                        "source_sense_description": "red lead",
                        "target_lang_word": "suřík",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "eb136c37-d20e-4276-a805-ad06034e97a2",
                        "source_entry_id": "53738106-f597-3fb1-a3ca-cbd22802160d",
                        "source_sense_description": "red lead",
                        "target_lang_word": "minium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f6b23e-c706-3be3-af45-94dd01b07158",
                                        "entry_id": "8da2b698-1121-3efa-8584-56215ea20a76",
                                        "glosses": [
                                            "Oxyde de plomb de couleur rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94414ef7-b2cb-4104-8d10-7f4ba5e58938",
                                                "sense_id": "d5f6b23e-c706-3be3-af45-94dd01b07158",
                                                "text": "Le minium s’obtient par la calcination du plomb dans un four."
                                            },
                                            {
                                                "example_id": "7fc95fde-fe12-490f-8d78-2352ce1a5c8a",
                                                "sense_id": "d5f6b23e-c706-3be3-af45-94dd01b07158",
                                                "text": "Le minium (Pb₃O₄), utilisé comme peinture, servait aux Grecs à badigeonner leurs navires pour en protéger le bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                                        "entry_id": "8da2b698-1121-3efa-8584-56215ea20a76",
                                        "glosses": [
                                            "Couleur à l’huile, à base de minium."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1dabed7-22dc-4375-9000-e557dca7ce41",
                                                "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                                                "text": "On donne au fer une première couche de minium pour l’empêcher de rouiller."
                                            },
                                            {
                                                "example_id": "fa336fdc-dfe8-4d02-a962-2c9cee518b2b",
                                                "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                                                "text": "Emporte ce bidon de minium…"
                                            },
                                            {
                                                "example_id": "e15e16f3-15df-40f9-ae59-8ab864290240",
                                                "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                                                "text": "Un léger coup de lime pour enlever une bavure, un soupçon d’antirouille orangée que l’on nomme minium, deux petits pas de recul façon Vélasquez contemplant ses Ménines, les bruits des locos comme fond sonore, alors elle est pas belle la vie ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
