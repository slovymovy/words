        "fr-extract.jsonl": [
            {
                "entry_id": "27242cac-5b00-3302-a8e7-4ccaaa7e1a18",
                "word": "manutention",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "374722b9-3819-43d5-950a-d415d1bd9724",
                        "entry_id": "27242cac-5b00-3302-a8e7-4ccaaa7e1a18",
                        "tags": [
                            "plural"
                        ],
                        "form": "manutentions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "445a0ba4-cf3d-3220-9f66-951f66466626",
                        "entry_id": "27242cac-5b00-3302-a8e7-4ccaaa7e1a18",
                        "glosses": [
                            "Action de manipuler, de déplacer des marchandises, des colis à l’intérieur d’un entrepôt, d’une usine, d’un magasin."
                        ],
                        "tags": [
                            "Logistique"
                        ],
                        "examples": [
                            {
                                "example_id": "84e8d4b2-d0c2-40af-a034-0f4e41a164f7",
                                "sense_id": "445a0ba4-cf3d-3220-9f66-951f66466626",
                                "text": "La manutention d’objets lourds dans une halle industrielle nécessite souvent l’emploi d’engins spéciaux dits engins de manutention ou de levage."
                            },
                            {
                                "example_id": "2ffd8a46-80e2-4240-b46a-d626c53585b2",
                                "sense_id": "445a0ba4-cf3d-3220-9f66-951f66466626",
                                "text": "Il connaissait aussi toute sa famille, savait que son père était chef de la manutention aux Magasins Réunis, que sa mère était d'origine belge ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5271e45-675d-3d21-832f-705ef2fae158",
                        "entry_id": "27242cac-5b00-3302-a8e7-4ccaaa7e1a18",
                        "glosses": [
                            "Endroit réservé à ces manipulations de marchandises."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "ca57697a-6111-4080-a481-17835e5f1111",
                                "sense_id": "e5271e45-675d-3d21-832f-705ef2fae158",
                                "text": "Ces manutentions, en fonctionnement depuis deux ans et qui ont été terminées en 1929, présentent certainement l'ensemble industriel le plus complet et le plus homogène de France."
                            }
                        ]
                    },
                    {
                        "sense_id": "40aa9e7a-38c6-3925-948c-bf9d99019078",
                        "entry_id": "27242cac-5b00-3302-a8e7-4ccaaa7e1a18",
                        "glosses": [
                            "Lieu où l’on fabriquait le pain pour la troupe."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f7051126-0a7d-40ff-a993-3b5e063e84d8",
                                "sense_id": "40aa9e7a-38c6-3925-948c-bf9d99019078",
                                "text": "On conçoit donc que partout où l'on vise à fabriquer le pain économiquement on s'efforce de réduire le taux du blutage ; c'est ainsi que, dans les manutentions militaires, la farine de blé tendre est blutée à 15 p. 0/0 et celle de blé dur à 5 p. 0/0."
                            },
                            {
                                "example_id": "8e69b111-4a1e-46be-a7d1-6bc7db23cfec",
                                "sense_id": "40aa9e7a-38c6-3925-948c-bf9d99019078",
                                "text": "La boulangerie se compose de deux parties, une manutention où était produit le pain et une paneterie où le pain était stocké pendant trois jours avant d’être consommé.\nLa manutention possède un ou plusieurs fours pour la cuisson du pain, dont la taille varie en fonction du nombre de soldats à nourrir."
                            }
                        ]
                    }
                ],
