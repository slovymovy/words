                "senses": [
                    {
                        "sense_id": "3963da1b-bdc4-36bd-b745-711212ff3601",
                        "entry_id": "4d546404-8478-352d-9357-3052942f3b0e",
                        "glosses": [
                            "utopische Zukunftsvorstellung einer Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf37253-9282-4615-a5fd-9bd8f37ab869",
                                "sense_id": "3963da1b-bdc4-36bd-b745-711212ff3601",
                                "text": "„Das 1883 erschienene Werk ordnete die politischen Sozialutopien in einen Bereich ein, in dem auch der heutige Alltagsbegriff von Utopie anzusiedeln ist; der Utopie als Phantasterei und nicht zu realisierende Fiktion.“"
                            },
                            {
                                "example_id": "cac646ec-4d3e-4958-9c31-0314d1794c44",
                                "sense_id": "3963da1b-bdc4-36bd-b745-711212ff3601",
                                "text": "„Die Entwicklung des Sozialismus von der Utopie zur Wissenschaft (1883) schätzt Engels die Sozialutopien nach Morus als wichtige, aber durch die marxistische Wissenschaft überholte Phase des Sozialismus ein; vgl.“"
                            },
                            {
                                "example_id": "1dc28fb2-cd21-4f05-8b3f-4901f7955db0",
                                "sense_id": "3963da1b-bdc4-36bd-b745-711212ff3601",
                                "text": "„Die Sozialutopien stellen den kühnen und ganz unverzichtbaren Versuch dar, das in der Zivilisation Getrennte als synthetisierbar zu demonstrieren.“"
                            },
                            {
                                "example_id": "c74661b9-e6e6-4dee-96b3-0c04bdcb05ce",
                                "sense_id": "3963da1b-bdc4-36bd-b745-711212ff3601",
                                "text": "„Ein elementares Motiv der archistischen Sozialutopie in der Tradition Platons und Morus' stellte die sittliche Ordnung der Geschlechterbeziehung durch den Staat dar.“"
                            },
                            {
                                "example_id": "5b365b20-00d3-4bd1-bad5-e0a122f808fa",
                                "sense_id": "3963da1b-bdc4-36bd-b745-711212ff3601",
                                "text": "„Ernst Bloch zufolge zielen Sozialutopien negativ auf die Überwindung sozialer Misstände und positiv auf die Erfüllung von Glück.“"
                            },
                            {
                                "example_id": "17b2f52b-c56c-4dee-97df-b0d861d6590f",
                                "sense_id": "3963da1b-bdc4-36bd-b745-711212ff3601",
                                "text": "„Die Vorstellungen des Sozialismus basieren auf frühchristlichen Motiven, antiken Lehrmeinungen und früh-bürgerlichen Sozialutopien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
