                        "examples": [
                            {
                                "example_id": "8286082d-5332-4a14-8161-999375ef60a0",
                                "sense_id": "6c395e3b-81c0-3477-8eec-3e128df07338",
                                "text": "Bei jedem Regen läuft das Wasser aus einer Dachtraufe auf meinen Balkon. - Chaque fois qu’il pleut, l’eau coule d’une gouttière sur mon balcon."
                            }
