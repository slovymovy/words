                "senses": [
                    {
                        "sense_id": "3738178e-be4d-3481-a4ef-4dd7dd7e354d",
                        "entry_id": "ed7ea6ad-b31b-33a3-bb5e-c91f2bdfaefb",
                        "glosses": [
                            "Spiel, das in einer Kreisaufstellung der Spielenden gestaltet wird oder in Kreisform abläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c47c5a1-1a34-4dd4-ada7-97e7932969a2",
                                "sense_id": "3738178e-be4d-3481-a4ef-4dd7dd7e354d",
                                "text": "„Die Kinder haben in den Spielstunden oft den Wunsch, bei Kreisspielen neben dem Spielleiter oder sogar auf seinem Schoß zu sitzen.“"
                            },
                            {
                                "example_id": "a4391466-7eb1-45d7-9d82-debc66388bcf",
                                "sense_id": "3738178e-be4d-3481-a4ef-4dd7dd7e354d",
                                "text": "„Keine drei Meter trennen den Fußball-Nationalspieler im ‚Campo Sportivo‘ in Arco von dem munteren Kreisspiel von Ribéry, Robben und Co.“"
                            },
                            {
                                "example_id": "c4c7204c-41a9-4404-904e-d66477fb25de",
                                "sense_id": "3738178e-be4d-3481-a4ef-4dd7dd7e354d",
                                "text": "„Zum Beinevertreten und Abreagieren veranstalteten ein paar von uns ein Kreisspiel: Laurentia, liebe Laurentia mein…, wurden aber bald von einer Zollbeamtin auf sächsisch daran erinnert, daß dies eine Grenzkontrollstelle sei und kein Vergnügungspark.“"
                            },
                            {
                                "example_id": "e6841354-5621-4414-b3cd-6833ea710afe",
                                "sense_id": "3738178e-be4d-3481-a4ef-4dd7dd7e354d",
                                "text": "„Meine Mutter, die Assistentin der schwarzen Schwester, dispensiert sich vom Kreisspielen ihrer Hühneraugen wegen; dafür singt sie trillernd im Sitzen.“"
                            },
                            {
                                "example_id": "e01c8dad-1e5e-4ea5-bc47-93d274b19869",
                                "sense_id": "3738178e-be4d-3481-a4ef-4dd7dd7e354d",
                                "text": "„Für Knaben wählen wir ein bekanntes Laufspiel (Katze und Maus!) Die Mädchen machen Kreisspiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
