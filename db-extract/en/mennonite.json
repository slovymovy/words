                    },
                    {
                        "translation_id": "cefc039a-0bf6-483e-a5e4-72ad7c103a43",
                        "source_entry_id": "7518dbd0-aeef-3bec-98ec-8913cdd720d5",
                        "source_sense_id": "f0e7a0f5-b40e-3ba2-abda-8c62435c66d6",
                        "source_sense_description": "of or related to a Mennonite, Mennonites, their movement or church(es)",
                        "target_lang_word": "mennonite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mennonite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c3b3caf-f579-3bbf-a98a-24d6b33a0469",
                                        "entry_id": "18d1370e-e225-3b75-a059-da4dad50ef01",
                                        "glosses": [
                                            "Nom d’un mouvement parmi les anabaptistes qui repousse tout emploi de la force et de la violence et qui se donne à elle-même le titre de chrétiens sans défense ; ils n’administrent le baptême qu’aux adultes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f4dd1e7-68b4-466f-8f13-e0ccb1d6fba2",
                                                "sense_id": "3c3b3caf-f579-3bbf-a98a-24d6b33a0469",
                                                "text": "Faites donc un détour par La Crete, un village de mennonites, pour le plaisir de les entendre parler en plattdeutsch !"
                                            },
                                            {
                                                "example_id": "2073791e-51ba-4bf9-9d48-abbb8e1d429c",
                                                "sense_id": "3c3b3caf-f579-3bbf-a98a-24d6b33a0469",
                                                "text": "Comme cette femme est mennonite\nSes rosiers et ses vêtements n’ont pas de boutons\nIl en manque deux à mon veston\nLa dame et moi suivons presque le même rite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mennonite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5f320c5-cb7b-3591-b21b-8b95fd8a43fe",
                                        "entry_id": "348afc5f-3683-3d91-8209-c0ac774e6821",
                                        "glosses": [
                                            "Relatif à ce mouvement, à ses membres, à sa doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c1c7ae-c80c-4523-a635-7c40bf6a9cff",
                                                "sense_id": "a5f320c5-cb7b-3591-b21b-8b95fd8a43fe",
                                                "text": "Luther, Calvin et Zwingli combattirent ces dissidents avec une violence qui rappelle les procédés de Rome contre ses propres sectes. Mais ils ne purent ou ne voulurent pas les anéantir totalement : de nos jours, on retrouve çà et là des communautés mennonites mêlées d’élément russes — doukhobors et klystis — au canada et jusqu’au Paraguay."
                                            },
                                            {
                                                "example_id": "1e8bc4ff-4dc0-4a58-aac1-b8101c58411a",
                                                "sense_id": "a5f320c5-cb7b-3591-b21b-8b95fd8a43fe",
                                                "text": "[…], le refus de l'ostentation sont les traits qui marquent encore aujourd’hui le mouvement de la contre-réforme protestante, et plus particulièrement une de ses composantes marginalisées, les communautés amishes et mennonites ; elles ne survivent aujourd'hui, pratiquement, qu'aux États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
