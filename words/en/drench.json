{
    "word_family": [
        "drenching"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b60acbd-eea4-3778-ad79-f007816b2ad5",
                    "sense_definition": "To make someone or something completely wet by having liquid fall or be thrown on them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain began to <w>drench</w> the hikers before they could reach the shelter.",
                            "target_lang_translations": {
                                "cs": "Hustý déšť začal turisty <w>promáčet</w> dříve, než stihli dojít k přístřešku."
                            }
                        },
                        {
                            "text": "The firefighters had to <w>drench</w> the burning building with water to put out the flames.",
                            "target_lang_translations": {
                                "cs": "Hasiči museli hořící budovu <w>zmáčet</w> vodou, aby uhasili plameny."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drenched in rain",
                        "drenched in sweat"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že je někdo nebo něco úplně mokré tím, že na ně spadne nebo je na ně vylita tekutina."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "promočit",
                                "target_lang_sense_clarification": "úplně promáčet skrz naskrz"
                            },
                            {
                                "target_lang_word": "zmáčet",
                                "target_lang_sense_clarification": "namočit povrchově nebo silným deštěm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9ee3217-01dc-3848-98df-6b18c8a84c6a",
                    "sense_definition": "To provide someone with a drink, often in large quantities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host continued to <w>drench</w> his guests with expensive wine throughout the long evening.",
                            "target_lang_translations": {
                                "cs": "Hostitel po celý dlouhý večer své hosty <w>napájel</w> drahým vínem."
                            }
                        },
                        {
                            "text": "They were <w>drenched</w> with ale after the victory celebration began.",
                            "target_lang_translations": {
                                "cs": "Po zahájení oslav vítězství byli <w>politi</w> pivem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Poskytnout někomu nápoj, často ve velkém množství."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "napájet",
                                "target_lang_sense_clarification": "dávat pít (často ve velkém)"
                            },
                            {
                                "target_lang_word": "zavlažit",
                                "target_lang_sense_clarification": "přeneseně, bohatě pohostit nápojem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a26aa93-1af4-3c43-9972-ae33bdd32174",
                    "sense_definition": "To administer liquid medicine to an animal, often by force.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer had to <w>drench</w> the sick cow with medicine to treat its stomach infection.",
                            "target_lang_translations": {
                                "cs": "Farmář musel nemocné krávě <w>podat tekutý lék</w>, aby vyléčil její žaludeční infekci."
                            }
                        },
                        {
                            "text": "It is difficult to <w>drench</w> a stubborn horse without the proper equipment.",
                            "target_lang_translations": {
                                "cs": "Je těžké <w>podat lék</w> tvrdohlavému koni bez správného vybavení."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Podat zvířeti tekutý lék, často násilím."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podat lék",
                                "target_lang_sense_clarification": "aplikace tekutého léčiva zvířeti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48ca4670-c3ab-3720-8b51-48b503c7016a",
                    "sense_definition": "To drown someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drowning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rising tide threatened to <w>drench</w> the sailors who were trapped on the rocks.",
                            "target_lang_translations": {
                                "cs": "Stoupající příliv hrozil, že <w>utopí</w> námořníky, kteří uvízli na skalách."
                            }
                        },
                        {
                            "text": "Ancient legends tell of spirits that <w>drench</w> travelers in the deep river.",
                            "target_lang_translations": {
                                "cs": "Staré legendy vyprávějí o duchách, kteří <w>utápějí</w> cestovatele v hluboké řece."
                            }
                        }
                    ],
                    "synonyms": [
                        "indrench"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Utopit někoho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "utopit",
                                "target_lang_sense_clarification": "způsobit smrt utonutím"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d71df490-5491-3762-9baf-83d934e71407",
                    "sense_definition": "An act of making someone or something completely wet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>drench</w> from the sprinkler left everyone on the lawn soaking wet.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>zmáčení</w> z postřikovače nechalo všechny na trávníku úplně promočené."
                            }
                        },
                        {
                            "text": "After the storm, the garden needed a long time to recover from the heavy <w>drench</w>.",
                            "target_lang_translations": {
                                "cs": "Po bouřce zahrada dlouho potřebovala, aby se vzpamatovala z toho silného <w>promočení</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt úplného namočení někoho nebo něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "promočení",
                                "target_lang_sense_clarification": "stav nebo proces úplného namočení"
                            },
                            {
                                "target_lang_word": "zmáčení",
                                "target_lang_sense_clarification": "jednorázový akt polití nebo zmáčení deštěm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "106b721f-8418-3257-ac80-4d8e8f82e28d",
                    "sense_definition": "A dose of liquid medicine administered to an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian prepared a <w>drench</w> to help the sheep recover from parasites.",
                            "target_lang_translations": {
                                "cs": "Veterinář připravil <w>tekutý lék</w>, aby pomohl ovcím zotavit se z parazitů."
                            }
                        },
                        {
                            "text": "Administering the <w>drench</w> requires a steady hand to ensure the animal swallows it safely.",
                            "target_lang_translations": {
                                "cs": "Podání <w>tekutého léku</w> vyžaduje pevnou ruku, aby se zajistilo, že ho zvíře bezpečně spolkne."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dávka tekutého léku podávaná zvířeti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tekutý lék",
                                "target_lang_sense_clarification": "veterinární přípravek v tekuté formě"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}