{
    "word_family": [
        "varen",
        "geul",
        "vaarwater",
        "vaartuig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0dd0d22-86c9-3647-be80-99054f07123b",
                    "sense_definition": "Een relatief smalle strook in een groter water die diep genoeg is en geschikt is om te bevaren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waterweg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De botsing was ontstaan doordat het kleine schip de <w>vaargeul</w> niet had opgemerkt.",
                            "target_lang_translations": {
                                "en": "The collision occurred because the small ship had not noticed the <w>channel</w>."
                            }
                        },
                        {
                            "text": "Grote containerschepen moeten altijd binnen de gemarkeerde <w>vaargeul</w> blijven om niet vast te lopen.",
                            "target_lang_translations": {
                                "en": "Large container ships must always remain within the marked <w>channel</w> to avoid running aground."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaarwater",
                        "geul"
                    ],
                    "common_phrases": [
                        "de diepe vaargeul",
                        "binnen de vaargeul"
                    ],
                    "target_lang_definitions": {
                        "en": "A relatively narrow strip in a larger body of water that is deep enough and suitable for navigation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "channel",
                                "target_lang_sense_clarification": "navigable route in a body of water"
                            },
                            {
                                "target_lang_word": "fairway",
                                "target_lang_sense_clarification": "navigable part of a waterway"
                            },
                            {
                                "target_lang_word": "shipping channel",
                                "target_lang_sense_clarification": "designated route for ships"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d84c76fb-08a9-34ad-926b-b64a8378df3e",
                    "sense_definition": "Een strook bevaarbaar water tussen twee zandbanken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waterweg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij eb werd de <w>vaargeul</w> bijzonder smal, maar gelukkig waren de zandbanken goed zichtbaar.",
                            "target_lang_translations": {
                                "en": "At low tide, the <w>channel</w> became particularly narrow, but fortunately the sandbanks were clearly visible."
                            }
                        },
                        {
                            "text": "De schipper moest voorzichtig manoeuvreren om de smalle <w>vaargeul</w> tussen de zandbanken te volgen.",
                            "target_lang_translations": {
                                "en": "The skipper had to maneuver carefully to follow the narrow <w>channel</w> between the sandbanks."
                            }
                        }
                    ],
                    "synonyms": [
                        "geul"
                    ],
                    "common_phrases": [
                        "smalle vaargeul"
                    ],
                    "target_lang_definitions": {
                        "en": "A strip of navigable water between two sandbanks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "channel",
                                "target_lang_sense_clarification": "passage between sandbanks"
                            },
                            {
                                "target_lang_word": "gully",
                                "target_lang_sense_clarification": "water-worn channel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}