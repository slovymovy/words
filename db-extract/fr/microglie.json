                        "glosses": [
                            "Cellule gliale constituée de macrophages résidents du cerveau et de la moelle épinière formant ainsi la principale défense immunitaire active du système nerveux central."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24218254-c18c-47fa-9e00-da062f465a48",
                                "sense_id": "e398d3d9-e646-35fd-847a-b130b4d342b8",
                                "text": "Ces rôles physiologiques de la microglie intriguent les chercheurs."
                            },
                            {
                                "example_id": "c59e1eb0-acb3-4ed2-b3a1-ccca21a025a1",
                                "sense_id": "e398d3d9-e646-35fd-847a-b130b4d342b8",
                                "text": "Les astrocytes les soutiennent et leur procurent de la nourriture, les oligodendrocytes favorisent le passage de l’influx nerveux en fabriquant les gaines de myéline autour des axones et les microglies les protègent contre les germes en tout genre."
                            }
                        ]
