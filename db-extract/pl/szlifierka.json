                                        ]
                                    },
                                    {
                                        "sense_id": "57bacc05-1f3a-3f4c-9380-028c4f43ceff",
                                        "entry_id": "812b4e80-8463-3809-80f5-ad81e069140b",
                                        "glosses": [
                                            "A submarine sandwich, a sandwich made on a long, cylindrical roll.",
                                            "In particular, a submarine sandwich (hoagie) that is toasted or baked and typically does not contain lettuce."
