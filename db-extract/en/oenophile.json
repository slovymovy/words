                        "tags": [
                            "plural"
                        ],
                        "form": "oenophiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2052e74c-f51a-3546-b123-762adcb440f2",
                        "entry_id": "e5411331-d39b-301a-91f8-1c1f4e07e905",
                        "glosses": [
                            "A person who has a fondness or appreciation for wine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c5f757a-cb9e-4da7-85ca-4f9454f611ab",
                                "sense_id": "2052e74c-f51a-3546-b123-762adcb440f2",
                                "text": "The oenophile had a large wine cellar stocked with bottles from around the world."
                            },
                            {
                                "example_id": "a942648c-39c1-45e1-9904-5622115483ea",
                                "sense_id": "2052e74c-f51a-3546-b123-762adcb440f2",
                                "text": "With this kind of experience and depth in the wine cellar, the servers can offer exotic flights and other temptations for oenophiles that few Orange County restaurants can equal."
                            },
                            {
                                "example_id": "a0470b9f-f150-4b6c-a8bd-dfe8ea04f024",
                                "sense_id": "2052e74c-f51a-3546-b123-762adcb440f2",
                                "text": "Wines can be described with words like cigar box and “pencil lead,” or flinty or with hints of sandalwood — oenophiles can veer into what many might deem pretentiousness pretty quick."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1388ecc9-4212-489d-a2b2-99e9853bb767",
                        "source_entry_id": "e5411331-d39b-301a-91f8-1c1f4e07e905",
                        "source_sense_id": "2052e74c-f51a-3546-b123-762adcb440f2",
                        "source_sense_description": "wine-lover",
                        "target_lang_word": "œnophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
