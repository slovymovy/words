                "senses": [
                    {
                        "sense_id": "69cf1265-5123-3446-83d8-3d02d319878e",
                        "entry_id": "be89ebfb-0e5d-3ada-8cf9-95ef88bf1829",
                        "glosses": [
                            "Administrer de l’arsenic à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da649c7-6dc8-4c2a-97bb-05a25defc991",
                                "sense_id": "69cf1265-5123-3446-83d8-3d02d319878e",
                                "text": "dans les forêts de Médine, un jour, il avait dispersé les membres d’un cochon arsénisé, le lendemain elles furent jonchées de cadavres de lions, tigres et léopards."
                            },
                            {
                                "example_id": "96ae5d69-adc4-4e70-9f68-b6f6ad0111a2",
                                "sense_id": "69cf1265-5123-3446-83d8-3d02d319878e",
                                "text": "Voulant convaincre les incrédules de Médine de son habileté (continue Morande), quand le comte eût bien arsénisé la victime, il la fit égorger et ordonna qu’on en dispersât les membres dans les forêts voisines."
                            }
                        ]
                    },
                    {
                        "sense_id": "1df2c67a-439b-3b72-a9c3-f5a89a0cc2ac",
                        "entry_id": "be89ebfb-0e5d-3ada-8cf9-95ef88bf1829",
                        "glosses": [
                            "Donner un caractère arsénié à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb373be9-496e-4592-b1a0-4d6ac4ecfdb3",
                                "sense_id": "1df2c67a-439b-3b72-a9c3-f5a89a0cc2ac",
                                "text": "Le métal, cuivre arsénisé, est représenté par quatre alênes bipointes de section carrée."
                            }
                        ]
                    }
