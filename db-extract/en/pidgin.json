            {
                "entry_id": "9fb6f373-971f-324f-aefd-edf0390cf5dc",
                "word": "pidgin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "59e25737-925b-4fd1-86b3-21205f127345",
                        "entry_id": "9fb6f373-971f-324f-aefd-edf0390cf5dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "pidgins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3843f70a-e80d-3dea-8eb8-b3d6ac5ece5c",
                        "entry_id": "9fb6f373-971f-324f-aefd-edf0390cf5dc",
                        "glosses": [
                            "An amalgamation of two disparate languages, used by two populations having no common language as a lingua franca to communicate with each other, lacking formalized grammar and having a small, utilitarian vocabulary and no native speakers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "700e0fc2-97bb-40b6-b9b9-582413af6e75",
                                "sense_id": "3843f70a-e80d-3dea-8eb8-b3d6ac5ece5c",
                                "text": "‘I didnʼt know you can speak pidgin,’ he said and laughed."
                            }
                        ]
                    },
                    {
                        "sense_id": "27f3df07-8970-3382-ad41-b4f2fac975f6",
                        "entry_id": "9fb6f373-971f-324f-aefd-edf0390cf5dc",
                        "glosses": [
                            "A person's business, occupation, work, or trade (also spelt as pigeon)."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "idiomatic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a6795f76-1873-49e4-9eed-37e91f21cf1d",
                                "sense_id": "27f3df07-8970-3382-ad41-b4f2fac975f6",
                                "text": "Forget money. That's my pidgin."
                            },
                            {
                                "example_id": "f51b5046-c84c-4597-bf21-23f3f56bde2d",
                                "sense_id": "27f3df07-8970-3382-ad41-b4f2fac975f6",
                                "text": "It's up to the detective sergeant to ask his own questions, that's not my pidgin. But I did wonder if either of you gentlemen had an idea of the exact time of the shot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "927e6139-66a9-4bdf-85ac-f6465d21569e",
                        "source_entry_id": "9fb6f373-971f-324f-aefd-edf0390cf5dc",
                        "source_sense_description": "amalgamation of two languages having no native speakers",
                        "target_lang_word": "pidgin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pidgin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04377c94-137d-3ce9-afd8-d49ba7c09f54",
                                        "entry_id": "ca61fdea-fd2d-3f58-b500-71e364d83c01",
                                        "glosses": [
                                            "Langage d’origine mixte, rudimentaire et utilisé par des personnes de langues maternelles différentes."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f736c11-1fea-4ce5-bf00-130eea3516e4",
                                                "sense_id": "04377c94-137d-3ce9-afd8-d49ba7c09f54",
                                                "text": "On appelle généralement pidgin une langue simplifiée, créée à partir d’autres langues, et qui sert de langue véhiculaire pour des fins de commerce, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a02c2d-49d3-3529-9226-5c86c2699a3f",
                                        "entry_id": "ca61fdea-fd2d-3f58-b500-71e364d83c01",
                                        "glosses": [
                                            "Langage d’origine mixte, sans égards à son niveau de complexité ou l’existence de locuteurs natifs. Sens employé dans les noms de langages."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d93806e4-e668-4aa2-bdee-ef5db96ce3f3",
                                                "sense_id": "f5a02c2d-49d3-3529-9226-5c86c2699a3f",
                                                "text": "Aujourd’hui, le pidgin du Nigeria, le nigerian pidgin english, est parlé par des dizaines de millions de gens, et il continue de progresser, mais il est toujours considéré, par les autorités, les universités, etc., comme quelque chose de condamnable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d6c8561-9479-325c-8962-6beda192147f",
                                        "entry_id": "ca61fdea-fd2d-3f58-b500-71e364d83c01",
                                        "glosses": [
                                            "Un pidgin précis, indiqué par le contexte."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711f7b68-be88-429b-8dbe-02affaba0d08",
                                                "sense_id": "9d6c8561-9479-325c-8962-6beda192147f",
                                                "text": "Pas surprenant donc qu’un idiome commun ait émergé au fil du temps : le pidgin, un mélange d’anglais et de créole venus des Caraïbes et de portugais transmis par les navigateurs. — Il est juste question du pidgin du Nigéria. (AFP, Le pidgin, langue officieuse du Nigeria, 21 janvier 2014.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a062d87-8787-4396-a96e-75d5beaf966f",
                        "source_entry_id": "9fb6f373-971f-324f-aefd-edf0390cf5dc",
                        "source_sense_description": "amalgamation of two languages having no native speakers",
                        "target_lang_word": "créole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dae43725-8984-38ea-a3cd-962bf8fadbec",
                                        "entry_id": "7a017787-a420-36b2-be98-825400ca21dd",
                                        "glosses": [
                                            "Originellement, personne de famille européenne, née dans une des anciennes colonies des régions tropicales d'Amérique et de l'océan Indien, et plus particulièrement des Antilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d6864e6-3b03-401c-b767-65e9444dc938",
                                                "sense_id": "dae43725-8984-38ea-a3cd-962bf8fadbec",
                                                "text": "On ne peut nier que les créoles portaient quelque envie aux immenses richesses des Espagnols, qui, par la supériorité de leurs connaissances et le genre de vie aristocratique qu’ils avaient menée jusqu’alors, s’étaient attiré l’inimitié des classes inférieures."
                                            },
                                            {
                                                "example_id": "3f87ab7b-b4df-4959-b219-373410a7554a",
                                                "sense_id": "dae43725-8984-38ea-a3cd-962bf8fadbec",
                                                "text": "Après le dîner, les dames restèrent assises autour de la table dans un doux far-niente, s'entretenant, à la mode des créoles oisives, de tous les petits événements arrivés dans le pays."
                                            },
                                            {
                                                "example_id": "f55edb87-cb77-49d9-9e86-68e7aef4c2fc",
                                                "sense_id": "dae43725-8984-38ea-a3cd-962bf8fadbec",
                                                "text": "Les créoles détiennent la presque totalité des richesses et sont responsables de l’essor de la région de Caracas très marqué depuis le dernier tiers du XVIIIᵉ s."
                                            },
                                            {
                                                "example_id": "43a02ce1-494b-4cca-974f-f7d66be9c80d",
                                                "sense_id": "dae43725-8984-38ea-a3cd-962bf8fadbec",
                                                "text": "L'impératrice Joséphine était une créole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7074a9e-02a5-332e-a952-af4a9863d072",
                                        "entry_id": "7a017787-a420-36b2-be98-825400ca21dd",
                                        "glosses": [
                                            "Toute personne née dans ces régions quelle que soit son ascendance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "créole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6641d6b3-63b6-369b-8c79-469b5256f1ac",
                                        "entry_id": "1e10d675-67f9-386a-98bd-0cacaf8efd32",
                                        "glosses": [
                                            "Langue autonome née du contact d’une langue européenne avec des langues indigènes ou importées (Antilles), devenu langue maternelle et langue principale d’une communauté par opposition à un pidgin et un à sabir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776a9e04-337b-415e-9092-9d69d4a6594a",
                                                "sense_id": "6641d6b3-63b6-369b-8c79-469b5256f1ac",
                                                "text": "On a beau parler couramment une langue étrangère, c’est vers sa langue maternelle qu’on tend à se tourner pour nommer fruits et légumes. Bien que je sache parfaitement comment s’appelle tel fruit ou tel légume en anglais ou en français, c’est le créole que j’emploie pour en parler."
                                            },
                                            {
                                                "example_id": "07fe3e6b-1ae7-4ec7-a857-66c67601d404",
                                                "sense_id": "6641d6b3-63b6-369b-8c79-469b5256f1ac",
                                                "text": "Longtemps perçus comme des sous-langues appartenant à des sous-races, les créoles ont été rejeté du revers de la main comme étant des appauvrissements, voire des perversions de la langue. On sent ici tout le poids du colonialisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22e6965f-9a32-3405-8dbe-b41d43bcea7f",
                                        "entry_id": "1e10d675-67f9-386a-98bd-0cacaf8efd32",
                                        "glosses": [
                                            "Haïtien."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "créole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "125b1e52-212d-3761-8c54-cadd7c74e682",
                                        "entry_id": "f0de86a6-dda1-355b-8466-ae4158024df1",
                                        "glosses": [
                                            "Race à viande de petits taurins, originaires de France (Guadeloupe et Martinique), à robe fauve avec de nombreuses variantes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "créole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17c85db1-6d83-3623-b9ac-8b75eac45721",
                                        "entry_id": "15e8753b-34ba-3e1f-914d-063ce09e90b1",
                                        "glosses": [
                                            "Type de boucles d’oreilles en forme de grands anneaux portées à l’origine dans les Antilles et en Afrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fed5f7-e214-417a-aba6-5b0ca8db2d1e",
                                                "sense_id": "17c85db1-6d83-3623-b9ac-8b75eac45721",
                                                "text": "Les créoles, petits anneaux creux complètement fermés par une tige emboîtée, constituent le premier bijou offert aux petites filles à l’occasion du percement d’oreilles."
                                            },
                                            {
                                                "example_id": "9c9e7761-77da-40da-a253-7a6d5ddbc3a9",
                                                "sense_id": "17c85db1-6d83-3623-b9ac-8b75eac45721",
                                                "text": "Celle qui se décrit volontiers comme « hors des codes », portant ses cheveux lâchés, du vernis rouge et de grandes créoles, a su trouver les mots pour plaire à l’Élysée."
                                            },
                                            {
                                                "example_id": "c1ba5565-0e61-45e1-9b38-df99cae9948c",
                                                "sense_id": "17c85db1-6d83-3623-b9ac-8b75eac45721",
                                                "text": "Et tout ce temps, il ne fit que penser à cette fille qui se trouvait sur le bord avec deux copines, celle avec les créoles et la french manucure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "créole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9071418-a6fe-382e-8b35-0c73eb3e678e",
                                        "entry_id": "bf5efa0a-4bde-3af8-af12-15ba1bdb5f6f",
                                        "glosses": [
                                            "Relatif aux populations des anciennes colonies d'Amérique, des Antilles et de l'océan Indien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a70d4148-5fdd-4816-a8fe-eeb75fd59f3e",
                                                "sense_id": "a9071418-a6fe-382e-8b35-0c73eb3e678e",
                                                "text": "Au pays parfumé que le soleil caresse\nJ’ai connu, sous un dais d’arbres tout empourprés\nEt de palmiers d’où pleut sur les yeux la paresse,\nUne dame créole aux charmes ignorés."
                                            },
                                            {
                                                "example_id": "7dc1d095-b3f5-4858-92fc-ba8abfce7caa",
                                                "sense_id": "a9071418-a6fe-382e-8b35-0c73eb3e678e",
                                                "text": "Il était fort élégamment mis, en tenue légère, avec une cravate un peu lâche et des habits larges, tels qu’il aimait à les porter, surtout en été. Il avait cette démarche aisée, cette façon libre de se mouvoir dans des habits flottants qui lui donnaient à certains moments comme un air fort original de jeune homme étranger, soit anglais, soit créole."
                                            },
                                            {
                                                "example_id": "06a5cc93-0e73-4209-929b-1991d23f87fe",
                                                "sense_id": "a9071418-a6fe-382e-8b35-0c73eb3e678e",
                                                "text": "Viviane Larceau avait de gros yeux verts, ronds comme des groseilles, et une peau mate qui lui donnaient, à son avis, un air « créole ». Aussi s’efforçait-elle de paraître étrange, d’offir une énigme indéchiffrable par les humains ordinaires. Elle attendrait peut-être longtemps, dans la solitude, le prodigieux génie qui saurait décrypter son cœur."
                                            },
                                            {
                                                "example_id": "d090a05b-c476-410a-af57-a1f47210f760",
                                                "sense_id": "a9071418-a6fe-382e-8b35-0c73eb3e678e",
                                                "text": "Bolívar appartient à une grande famille créole dont le fondateur s’était installé en Amérique en 1588."
                                            },
                                            {
                                                "example_id": "163ec478-6ecd-4465-80fa-f0c1adc24989",
                                                "sense_id": "a9071418-a6fe-382e-8b35-0c73eb3e678e",
                                                "text": "La cuisine créole est une entité hybride. Elle est faite de toutes les cuisines. Il ne s’agit pas d’une fusion – […] –, mais d’une pratique sophistiquée mettant en dialogue les unes avec les autres des recettes venues de Chine, d’Inde, d’Europe, d’Afrique et de Madagascar, et qui, ensemble, donnent un texte dont la cuisine créole est la traduction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f8e7dcd-b920-441f-ab49-d02c9e612f11",
