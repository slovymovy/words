                                "target_senses": [
                                    {
                                        "sense_id": "dc7cc392-c54f-3754-b193-05a2c07b43cf",
                                        "entry_id": "d4411b11-d42a-3483-af49-0cfb2d492dba",
                                        "glosses": [
                                            "A financial instrument issued by a municipality."
                                        ],
                                        "tags": [],
                                        "examples": [
