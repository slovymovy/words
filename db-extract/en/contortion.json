                    },
                    {
                        "translation_id": "28da7899-a922-4600-bdef-9885a6f41f81",
                        "source_entry_id": "1372d2be-1bcf-3ace-ab5f-130950d2a8ae",
                        "source_sense_description": "the act of contorting",
                        "target_lang_word": "искривле́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "искривле́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "234863ae-9004-34e5-b961-5b2ed92b6832",
                                        "entry_id": "7077a01a-0090-370e-9d37-bdb25905ee1a",
                                        "glosses": [
                                            "действие по значению гл. искривлять, искривляться; изменение формы чего-либо с прямой на кривую, изогнутую"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1de2110-0f06-468e-997b-5db971764f48",
                                                "sense_id": "234863ae-9004-34e5-b961-5b2ed92b6832",
                                                "text": "Однако закалка больших стекол для панорамных окон ― процесс весьма проблематичный, поскольку существует большая вероятность искривления поверхности стекла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e36e43f-d23e-3e69-9c8f-1da8df13dd2c",
                                        "entry_id": "7077a01a-0090-370e-9d37-bdb25905ee1a",
                                        "glosses": [
                                            "результат такого действия; изгиб, кривизна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f6706d-7ed9-4712-a947-f50ca5d63022",
                                                "sense_id": "8e36e43f-d23e-3e69-9c8f-1da8df13dd2c",
                                                "text": "Так, девочка из сунгирского парного погребения обладала непривычной и редко встречаемой наследственной аномалией физиологического искривления диафизов бедренных костей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e015e75-ffa4-33f3-8a5c-4f9f04741e45",
                                        "entry_id": "7077a01a-0090-370e-9d37-bdb25905ee1a",
                                        "glosses": [
                                            "перен. отклонение, отступление от чего-либо правильного; нарушение нормы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4393a632-e3fe-4210-9767-4846642b4a8d",
                                                "sense_id": "6e015e75-ffa4-33f3-8a5c-4f9f04741e45",
                                                "text": "Мало кто обратил внимание на низкорослого горца ― лишь китайский полицейский, сосланный в этот Богом забытый край за искривление партийной линии, покосился в сторону юноши ― и тотчас заскучал."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
