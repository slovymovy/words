                                    {
                                        "sense_id": "8668b67a-70b1-3afd-a8ee-60bb96b904b2",
                                        "entry_id": "35bca1a8-1019-3168-9220-27f8f40e88e6",
                                        "glosses": [
                                            "een woord dat in onbruik geraakt is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5192ca9f-6e4d-4644-ac63-35f17d533cbc",
                                                "sense_id": "8668b67a-70b1-3afd-a8ee-60bb96b904b2",
                                                "text": "Zijn woordgebruik staat bol van de archaïsmen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad6da0a-fc93-30ff-a056-0fe4c7be5be2",
                                        "entry_id": "35bca1a8-1019-3168-9220-27f8f40e88e6",
