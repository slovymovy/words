                                                "example_id": "057176e9-e309-46d0-96b0-2b8d5a810e91",
                                                "sense_id": "09fe8f99-20d8-3a68-8c08-bb16b65cb877",
                                                "text": "„Und doch sitzt eine Teufelei dahinter.“"
                                            },
                                            {
                                                "example_id": "b6c8def6-7614-46c3-a1bb-e58e948479a2",
                                                "sense_id": "09fe8f99-20d8-3a68-8c08-bb16b65cb877",
                                                "text": "„Anscheinend steckte außer seiner sanften Liebe zu Büchern auch ein guter Schuss furchtloser Teufelei in ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "031ab8d9-4a33-4386-b0fa-632ddbdfb46e",
                        "source_entry_id": "2b225093-f94b-3202-bca9-44fc820db530",
                        "source_sense_description": "An act of such mischief, wickedness, cruelty or witchcraft",
                        "target_lang_word": "Unfug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                        "entry_id": "c8c2c686-0329-3073-a32c-3a56648c51b3",
                                        "glosses": [
                                            "unsinniger oder ungehöriger Zustand; unsinnige oder ungehörige Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c5bbcc-5011-427c-b59c-a7418682a95d",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Es ist ein Unfug, die Kinder zu erziehen, will sagen, ihnen zu befehlen, dafür aber den Erwachsenen zu gehorchen. Es ist schon deshalb ein Unfug, weil die Kindheit Stil hat und eine freimütige Vornehmheit, die man wohl zerstören, aber durch nichts ersetzen kann."
                                            },
                                            {
                                                "example_id": "fe620db1-9f39-49ce-a703-80d6c696168a",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Daniels Sohn hat sich mit ihm auch angefreundet, die beiden pokulieren und würfeln zusammen und treiben viel Unfug."
                                            },
                                            {
                                                "example_id": "a15e443c-5455-418b-97f9-9f7b7e934e4c",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Der Unfug mußte amtlich mit aller Strenge unterdrückt werden, denn man konnte darin ebensogut eine Verhöhnung der ehrsamen Schneiderzunft als des städtischen Polizeiwesens erblicken."
                                            },
                                            {
                                                "example_id": "247b0906-7bc3-4543-b8cc-eb420765590a",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "„Allerdings ist die Liste dessen, was man einst als unvermeidlich angesehen, später aber als Unfug erkannt hat, länger als unsere DNA.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6313f63-7deb-4be2-99da-9907da95f610",
                        "source_entry_id": "2b225093-f94b-3202-bca9-44fc820db530",
                        "source_sense_description": "An act of such mischief, wickedness, cruelty or witchcraft",
                        "target_lang_word": "Hexerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hexerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                        "entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                                        "glosses": [
                                            "Handlung einer Person, der unterstellt wird, über magische Kräfte zu verfügen und diese in der Regel zum Nachteil anderer einzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b476363-468a-4bff-8d72-dff40a9765c7",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Es gibt durchaus mehrere Theorien über den Ursprung des Hexenwahns und der daraus erwachsenen Verfolgung von Frauen, die der Hexerei beschuldigt worden sind.“"
                                            },
                                            {
                                                "example_id": "bc64f4bc-56d3-4c10-989f-131d1d9aff85",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Denn dieses Ausnahmeverfahren versagte jeder wegen Hexerei angeklagten Person das Recht auf eine ordnungsgemäße Verteidigung, die sonst allen anderen Angeklagten im ordentlichen Gerichtsverfahren zustand.“"
                                            },
                                            {
                                                "example_id": "f9f2511c-4c06-46dd-b114-5ccef688599d",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Der Roszkower Rabbi hatte erklärt, es sei verboten, bei so etwas mitzumachen, weil das Hexerei sei.“"
                                            },
                                            {
                                                "example_id": "633ad1eb-776f-4214-ba99-860eaeb4ceb4",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Er soll die letzten der Hexerei verdächtigen Frauen aus dem Kerker befreit haben, bevor es zu einem Prozess kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "695cec1e-60f2-3c85-86b6-19e071f8b999",
                                        "entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                                        "glosses": [
                                            "unerwartet/ungewöhnlich erfolgreiche Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b40a610-0e9a-40b8-9a51-07bb4d20719b",
                                                "sense_id": "695cec1e-60f2-3c85-86b6-19e071f8b999",
                                                "text": "Es grenzt an Hexerei, dass das Fest trotz der geringen Vorbereitungszeit noch organisiert werden konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
