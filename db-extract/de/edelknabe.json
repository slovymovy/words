                "senses": [
                    {
                        "sense_id": "40b9fbda-7bcd-3151-a0ad-c19b273937ac",
                        "entry_id": "5827f240-f25b-3700-928b-419e8115bbc4",
                        "glosses": [
                            "junger, adliger Knabe, der bei Hofe dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfbf3ea5-04e9-4aba-ba95-527ee84f9033",
                                "sense_id": "40b9fbda-7bcd-3151-a0ad-c19b273937ac",
                                "text": "„Reichgeschmückte Edelknaben reichten Wein und mit Blumen verdeckte Orangen und Früchte in silbernen Schalen umher.“ (Joseph von Eichendorff: Das Marmorbild)"
                            },
                            {
                                "example_id": "a17a166e-3d98-4f5e-847f-e1632559fd67",
                                "sense_id": "40b9fbda-7bcd-3151-a0ad-c19b273937ac",
                                "text": "„Franz von Vieilleville kam frühe als Edelknabe zu der Mutter Franz des Ersten, Regentin von Frankreich, einer Prinzessin von Savoyen; ein Zufall aber, der ihm da begegnete, trieb ihn schon nach einem vierjährigen Aufenthalte von dort weg.“ (Friedrich Schiller: Denkwürdigkeiten aus dem Leben des Marschalls von Vieilleville)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
