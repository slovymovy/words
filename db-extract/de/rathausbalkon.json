                ],
                "senses": [
                    {
                        "sense_id": "ec4b28a8-89e1-3189-b28d-3aaa183635bf",
                        "entry_id": "30d388ee-d7fb-31c6-bda9-a3aa53b1ddaf",
                        "glosses": [
                            "Balkon, Vorbau in einem oberen Stockwerk eines Rathauses im Freien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de814dd0-278d-4f25-99b6-d1720a323f55",
                                "sense_id": "ec4b28a8-89e1-3189-b28d-3aaa183635bf",
                                "text": "„Einen besonderen Empfang erhielten die Kicker der SpVgg Greuther Fürth 1997 nach dem Aufstieg in die 2. Bundesliga, sowie 2012 in die 1. Bundesliga, als sich vor dem Rathausbalkon Tausende versammelten, um den Spielern zuzujubeln.“"
                            },
                            {
                                "example_id": "b5dc649f-24d7-4f9d-a56b-b61871a4fe7c",
                                "sense_id": "ec4b28a8-89e1-3189-b28d-3aaa183635bf",
                                "text": "„Was hat diese Schale nicht schon alles mitgemacht? […] Sie hat wahrscheinlich mehr Rathausbalkone von oben und mehr Bierduschen von unten gesehen als jeder andere in diesem Land.“"
                            },
                            {
                                "example_id": "728e30b3-7c59-4128-9691-23445a9e8aad",
                                "sense_id": "ec4b28a8-89e1-3189-b28d-3aaa183635bf",
                                "text": "„Immerhin hat er schon viermal das deutsche Nationaltrikot mit dem Adler auf der Brust getragen, präsentierte drei Jahre hintereinander die Schale des deutschen Fußballmeisters auf dem Münchner Rathausbalkon am Marienplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
