                        "glosses": [
                            "The surface of a mine."
                        ],
                        "tags": [
                            "Cornwall"
                        ],
                        "examples": [
                            {
                                "example_id": "ba7c8edf-feae-4e91-a71d-6e2cc428adfa",
                                "sense_id": "5936063c-e2e6-3f13-b7e4-863da264f7fd",
                                "text": "The surface of the mine is called the bal, and every level and shaft has a name."
                            },
                            {
                                "example_id": "b05c614c-2b1e-472f-8279-d4961817a928",
                                "sense_id": "5936063c-e2e6-3f13-b7e4-863da264f7fd",
                                "text": "Penny arrived dressed for the day as a bal-maiden and told us all about the delights of a surface worker's life at a mine in Pendeen days, which was, she told us, what a bal-maiden did."
                            },
                            {
                                "example_id": "5f10cbce-604c-4ee0-8b0c-371b5e46818e",
                                "sense_id": "5936063c-e2e6-3f13-b7e4-863da264f7fd",
                                "text": "\"Oo will do un, maister?\" asked Jim.\n\"The bal authorities,\" said Hunt."
                            }
                        ]
                    }
