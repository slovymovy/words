                                    {
                                        "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                        "entry_id": "5a6dcc84-79fd-3bb9-9964-048f74938b3f",
                                        "glosses": [
                                            "eine Hoffnung, einen Wunsch oder eine Erwartung nicht erfüllen oder zerstören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aff02a4-bd6f-4864-b08f-72fa0c14fc71",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Juttas Unzuverlässigkeit enttäuscht mich maßlos."
                                            },
                                            {
                                                "example_id": "202e407b-2199-42ca-9f67-3b1cdafc82d8",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Torben hat mich bitter enttäuscht, ich war so sicher, er würde mich verteidigen, wenn die anderen wieder loslegen und auf mich schimpfen."
                                            },
                                            {
                                                "example_id": "92d1f4d0-62cc-479a-aa54-5aeb80344fe6",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Was soll ich sagen, ich bin enttäuscht und am Boden zerstört."
                                            },
                                            {
                                                "example_id": "ddc602b3-37a1-4c67-84e9-e7b0a0be1fd3",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Ich kann nicht sagen, dass es mich verwundert, aber enttäuschen tut es mich schon."
                                            },
                                            {
                                                "example_id": "928cc901-bbff-46f3-8d7a-6a105d89c0d8",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Die deutschen Hoffungen auf einen Oscar sind mal wieder enttäuscht worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
