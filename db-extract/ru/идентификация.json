                    },
                    {
                        "translation_id": "5cc3dfb2-f20d-4e50-995d-197aaa9f7196",
                        "source_entry_id": "31e8fa11-37c7-397e-aa74-5f56beba17fe",
                        "target_lang_word": "Identifizierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Identifizierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6530ad90-e1b0-3ada-a5eb-b8166a8b105f",
                                        "entry_id": "e2407e10-a5dc-33d5-9254-74599a9590f5",
                                        "glosses": [
                                            "die Identifikation von oder auch mit etwas (das Gleichsetzten), das Sichidentifizieren / das Identifiziertwerden; das Identifizieren (das Erkennen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9edc2e-85e8-4d57-b6db-93031ce14b63",
                                                "sense_id": "6530ad90-e1b0-3ada-a5eb-b8166a8b105f",
                                                "text": "„Unter Identifizierung versteht man einen Vorgang, der zum eindeutigen Erkennen einer Person oder eines Objektes dient. Die Identifizierung erfolgt anhand kennzeichnender Merkmale oder mit Hilfe eines Identifikators.“"
                                            },
                                            {
                                                "example_id": "2814baf9-5b08-489f-9864-7da2135e6715",
                                                "sense_id": "6530ad90-e1b0-3ada-a5eb-b8166a8b105f",
                                                "text": "„Ihre Identifizierung bleibt allerdings sozial und ethnisch vage.“"
                                            },
                                            {
                                                "example_id": "5c1f97c0-4df5-41d0-a435-4672bb04e0ab",
                                                "sense_id": "6530ad90-e1b0-3ada-a5eb-b8166a8b105f",
                                                "text": "„Die Identifizierung der Religion mit der Dunkelheit und diese Koppelung der Metaphysik des Lichts mit der mediterranen Sonne eröffnen das Farbenspiel, in dem das Blau einen hohen existenziellen Rang einnimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
