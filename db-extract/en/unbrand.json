                        "glosses": [
                            "To free from commercial branding."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ae9e031e-638f-4610-8450-0d03db3a6d8e",
                                "sense_id": "97b8d8bc-3013-377a-85a0-d46696a344b0",
                                "text": "Their modest aim is to “unbrand” America through a variety of “culture jamming” campaigns that will “topple existing power structures” and change the way information flows, the way institutions wield power, […]"
                            },
                            {
                                "example_id": "907d36e2-a012-4910-a9f4-142a751453a1",
                                "sense_id": "97b8d8bc-3013-377a-85a0-d46696a344b0",
                                "text": "To unbrand our daughters, we must pursue inner beauty and reclaim the biblical value of contentment. How we go about unbranding our girls must be done with great wisdom. You see, you can turn off the messages from influencers and peddlers, but that's only going to leave an empty space in your daughter's heart that craves affirmation of her beauty."
                            }
                        ]
                    }
