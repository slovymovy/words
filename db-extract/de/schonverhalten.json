                ],
                "senses": [
                    {
                        "sense_id": "407e2841-ae61-369d-9af2-248e6ffb90b1",
                        "entry_id": "8ee135f7-1770-3476-b0e0-5e136d765091",
                        "glosses": [
                            "vorsichtiges, zögerliches Handeln aus Angst vor etwas Negativem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a24189-4af5-423b-b56c-80a76cc073b6",
                                "sense_id": "407e2841-ae61-369d-9af2-248e6ffb90b1",
                                "text": "„Indem man das Schmerzerleben mit der Bewegung gleichsetzt, wird ein Schonverhalten erlernt.“"
                            },
                            {
                                "example_id": "713d91af-905f-4675-bb4f-28329be5ca5b",
                                "sense_id": "407e2841-ae61-369d-9af2-248e6ffb90b1",
                                "text": "„Aufgabe des Arztes in diesem Rahmen ist es, gemeinsam mit dem Patienten ein Verständnis dafür zu entwickeln, dass Schonverhalten auch gleichzeitig Schmerzverstärkung bedeuten kann.“"
                            },
                            {
                                "example_id": "c35115c5-2a39-4fc3-a26d-ecc517a2b816",
                                "sense_id": "407e2841-ae61-369d-9af2-248e6ffb90b1",
                                "text": "„Der Organismus schaltet dann um auf ein Schonverhalten, das sich in Appetitlosigkeit, Niedergeschlagenheit und dem Rückzug von der Welt zeigt.“"
                            },
                            {
                                "example_id": "89b614fa-fc9e-4705-873d-45ee9ebd02cb",
                                "sense_id": "407e2841-ae61-369d-9af2-248e6ffb90b1",
                                "text": "„Schonverhalten kann dazu führen, dass durch einen verminderten Trainingszustand bei Belastung häufiger körperliche Missempfindungen entstehen, die wiederum als krankhaft bewertet werden.“"
                            },
                            {
                                "example_id": "1595c7ba-6455-43f0-b606-a2436159cfe1",
                                "sense_id": "407e2841-ae61-369d-9af2-248e6ffb90b1",
                                "text": "„Die Beschwerden klingen nach einer Weile ab, sodass das Schonverhalten als wirksames Mittel zur Verbesserung des Befindens wahrgenommen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
