                        "sense_id": "84854408-fff6-3b49-864e-6fa8606bbb94",
                        "entry_id": "15e57e50-b3be-323d-90cd-2f58a6bb5409",
                        "glosses": [
                            "To outlast; to survive longer than: to outlive."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "567e9915-e55c-3f6d-8167-d324bbe311d0",
                        "entry_id": "15e57e50-b3be-323d-90cd-2f58a6bb5409",
                        "glosses": [
                            "To wear out."
                        ],
                        "tags": [
                            "nonstandard",
                            "transitive",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "3332c413-9c74-4a9a-8b7c-a7dbaf85efb7",
                                "sense_id": "567e9915-e55c-3f6d-8167-d324bbe311d0",
                                "text": "Crushed impotent beneath this reign of terror,\nDazed with mysteries of woe and error,\nThe soul is too outworn for wondering."
                            },
                            {
                                "example_id": "e0d8c608-0880-480d-b821-20876a85e78c",
                                "sense_id": "567e9915-e55c-3f6d-8167-d324bbe311d0",
                                "text": "According to the audio commentary on “Treehouse Of Horror III,” some of the creative folks at The Simpsons were concerned that the “Treehouse Of Horror” franchise had outworn its welcome and was rapidly running out of classic horror or science-fiction fodder to spoof."
                            }
                        ]
                    }
