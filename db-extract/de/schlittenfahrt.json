                "senses": [
                    {
                        "sense_id": "c33a24f8-ba5d-305f-a02a-c566b49e2016",
                        "entry_id": "8f8f8095-fe8f-3ecc-b32e-93a4005bd8eb",
                        "glosses": [
                            "Ausflug mit einem Schlitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e80d8677-f123-4830-9f03-cdaf48b0500a",
                                "sense_id": "c33a24f8-ba5d-305f-a02a-c566b49e2016",
                                "text": "Bei unserem letzten Urlaub in den Bergen haben wir am Tag vor Heiligabend eine Schlittenfahrt gemacht."
                            },
                            {
                                "example_id": "df6ef0a1-cfc8-4a81-b16e-dd93c455769e",
                                "sense_id": "c33a24f8-ba5d-305f-a02a-c566b49e2016",
                                "text": "„Meixners wollten mit ihren Freunden und privaten Gästen eine Schlittenfahrt durch die Landschaft machen.“"
                            },
                            {
                                "example_id": "b4278474-b803-4dbc-9e91-1682aab289a1",
                                "sense_id": "c33a24f8-ba5d-305f-a02a-c566b49e2016",
                                "text": "„Es gab keinen Ball, keine Schlittenfahrt, keine Theateraufführung, ohne dass Julie dabeigewesen wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
