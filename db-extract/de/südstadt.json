                        "examples": [
                            {
                                "example_id": "61ce839b-4704-4fa4-9f97-6b01d4072258",
                                "sense_id": "2afc4839-5479-3048-8046-f790d1ad58e9",
                                "text": "Das Amt befindet sich in der Südstadt."
                            },
                            {
                                "example_id": "1ec509f9-a353-4945-8caa-365143399430",
                                "sense_id": "2afc4839-5479-3048-8046-f790d1ad58e9",
                                "text": "Wenn sie durch die Südstadt kommen, grüßen sie Frau Meyer von mir."
                            },
                            {
                                "example_id": "347019e8-da87-4d02-8a14-cb3b56820aac",
                                "sense_id": "2afc4839-5479-3048-8046-f790d1ad58e9",
                                "text": "Ihre Kindheit und Jugend verbrachten die Kinder in der Südstadt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
