                "senses": [
                    {
                        "sense_id": "fc0e8517-a660-3187-8132-0f0b2e76b4f9",
                        "entry_id": "e188d528-a329-37f8-9616-99dfb3b1f0a7",
                        "glosses": [
                            "Abtransport und Lagerung, Verbrennung oder Verwertung von Abfällen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fccee8b-2925-43ad-be2b-bea00cf95381",
                                "sense_id": "fc0e8517-a660-3187-8132-0f0b2e76b4f9",
                                "text": "„Nach fünf Stunden lehnten die Minister die Vergabe von Aufträgen zur Müllentsorgung an mehrere Unternehmen wegen der hohen Preise ab und beauftragten eine Ministerkommission mit der Suche nach Alternativen.“"
                            },
                            {
                                "example_id": "e57505c4-09b9-44d7-adc1-f707fddf7848",
                                "sense_id": "fc0e8517-a660-3187-8132-0f0b2e76b4f9",
                                "text": "„Illegale Müllentsorgung war im London des 18. Jahrhunderts ein wachsendes Ärgernis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "588b2a62-9b82-3b05-94d5-12070d34a94d",
                        "entry_id": "e188d528-a329-37f8-9616-99dfb3b1f0a7",
                        "glosses": [
                            "kommunaler Betrieb oder private Firma, der beziehungsweise die für den Abtransport und die Entsorgung von Abfällen durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a2590f-1f68-44db-a7a3-f34b24559605",
                                "sense_id": "588b2a62-9b82-3b05-94d5-12070d34a94d",
                                "text": "„Dazu kommen die Privatisierungswellen bei Post, Müllentsorgung und Telefon, die Auslagerung früher beim Staat festangestellter Putzleute, Portiers oder Sicherheitskräfte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
