                "senses": [
                    {
                        "sense_id": "698ecbe1-394e-3ee2-b350-e423b52ff3c2",
                        "entry_id": "10d6cc7d-d4ba-3b6a-8743-ea255c19ba87",
                        "glosses": [
                            "A small, dark brown, hoofed buffalo, Bubalus mindorensis, found only in Mindoro in the Philippines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318549c3-3862-4ec1-9690-f8c1a3a2d3bb",
                                "sense_id": "698ecbe1-394e-3ee2-b350-e423b52ff3c2",
                                "text": "The habitat requirements of the tamaraw appear to be fairly flexible, and present habitat use reflects human pressures rather than the animal's preferences. In the past, tamaraw were found in virtually all parts of Mindoro, from sea level to mountain tops."
                            },
                            {
                                "example_id": "b4752ab9-4bf4-44a2-8f9a-98ed2ac7c6f6",
                                "sense_id": "698ecbe1-394e-3ee2-b350-e423b52ff3c2",
                                "text": "1994, Mary Emanoil, Encyclopedia of Endangered Species, Volume 1, International Union for Conservation of Nature and Natural Resources, page 364,\nIn the early 1900s, there were an estimated 10,000 tamaraws on Mindoro; because of excessive hunting and loss of habitat, the population had decreased to less than 150-200 animals by 1971."
                            },
                            {
                                "example_id": "bf222cbb-84c7-4e4a-bebc-5af7d59e8714",
                                "sense_id": "698ecbe1-394e-3ee2-b350-e423b52ff3c2",
                                "text": "If that person explains that a tamaraw is a bovine animal, brown in color, found in the Philippines, I can take tamaraw to designate something like my idea of a brown cow. As a matter of fact, though, tamaraw are actually more like small water buffalo."
                            }
                        ]
                    }
                ],
