                        "glosses": [
                            "Pluriel de pigeon."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "83cea8c0-e480-4d4f-8596-8589ce32ec3b",
                                "sense_id": "62e68e01-233c-345e-b96a-0606b5b77b63",
                                "text": "Il y eut une brève coupure dans le vacarme, un instant de silence inattendu : un vol de pigeons passa en froufroutant au ras de la barricade et une rafale de vent s’engouffra dans la ruelle."
                            },
                            {
                                "example_id": "8d9502b9-6bbd-4a40-937c-c4dbbd486484",
                                "sense_id": "62e68e01-233c-345e-b96a-0606b5b77b63",
                                "text": "Voici des ailes qui battent, des milliers d'ailes, dans un grand froissement. Les pigeons! « C'est nous qui sommes gris, gris, gris, c'est nous les princes de Paris! »"
                            }
                        ]
                    }
