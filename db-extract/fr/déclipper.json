                        "glosses": [
                            "Défaire (quelque chose qui avait été clippé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b3d45f-0db0-40e6-937a-4152176449a9",
                                "sense_id": "a11e9433-7ddd-3f17-a680-1d779e4a8556",
                                "text": "Gail sourit et embrassa la joue de sa fille avant de se pencher pour déclipper ma laisse."
                            },
                            {
                                "example_id": "cf453e50-2a59-474e-ba76-dfd985720b06",
                                "sense_id": "a11e9433-7ddd-3f17-a680-1d779e4a8556",
                                "text": "Il fallait seulement déclipper le boîtier."
                            },
                            {
                                "example_id": "8289b6a3-356d-4a6e-9dec-70edf4c483fe",
                                "sense_id": "a11e9433-7ddd-3f17-a680-1d779e4a8556",
                                "text": "Il suffit de « déclipper » Securafix pour revenir sur les pistes."
                            }
                        ]
