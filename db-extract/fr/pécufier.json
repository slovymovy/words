                        "entry_id": "ade7b497-66c9-3ad7-9bd4-6985fb45d6d9",
                        "glosses": [
                            "S'exprimer à la façon d'un long exposé pas très intéressant."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0f500657-20d1-4d5f-90c7-60b10698569d",
                                "sense_id": "7121f506-dafa-3f0b-9a92-7345cd73fa1f",
                                "text": "La nécessité de répondre à toute question possible en faisant l'économie de recherches approfondies impose le recours aux recettes et aux ruses de art de disserter qui permettent de « pécufier » à l'infini en masquant les lacunes et en donnant des airs d'originalité aux topiques les plus usés et les plus impérativement attendus ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee6c23f2-144a-3be7-b223-d4cc1f8dbee0",
                        "entry_id": "ade7b497-66c9-3ad7-9bd4-6985fb45d6d9",
                        "glosses": [
                            "Décorer de PQ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3e4d71a-529d-4654-91c8-f1f75ee2c97f",
                                "sense_id": "ee6c23f2-144a-3be7-b223-d4cc1f8dbee0",
                                "text": "Vexés d'avoir été collés par leur professeur d'art plastique, Cartman, Stan, Kyle et Kenny décident de pécufier sa maison."
                            }
                        ]
