                            {
                                "example_id": "0e091e05-ccc6-435a-9cfd-dc2fd5f85736",
                                "sense_id": "65235b37-d86c-30d7-bcb1-dbb7f4d7895f",
                                "text": "„Als Wohlmuth seine Meisterprüfung ablegte und einen Verurteilten mit einem einzigen Schwerthieb erfolgreich köpfte, war er gerade einmal 19 Jahre alt.“"
                            },
                            {
                                "example_id": "ebb58469-edd2-46dc-b196-b21d285d4a88",
                                "sense_id": "65235b37-d86c-30d7-bcb1-dbb7f4d7895f",
                                "text": "„Durchtrennte man mit einem Schwerthieb die Sehnen des Elefanten, dann war es um ihn und seine Besatzung geschehen.“"
                            }
                        ],
