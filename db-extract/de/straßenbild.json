                ],
                "senses": [
                    {
                        "sense_id": "6fb7f601-cb2e-31f4-939f-8dd6a32cc4e5",
                        "entry_id": "949cbb9b-6758-32cf-a35b-2a577b79e327",
                        "glosses": [
                            "Aussehen, Gesamteindruck einer Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f896ecdc-e5b8-4685-886f-b8b28a817da0",
                                "sense_id": "6fb7f601-cb2e-31f4-939f-8dd6a32cc4e5",
                                "text": "„Die Kirchen fielen im Straßenbild Moskaus nicht besonders auf, aber ich kannte eine neben der Metrostation Sokol in der Nähe meiner Theaterschule.“"
                            },
                            {
                                "example_id": "1076ac26-0212-43c8-aa2e-a6b5fbda3acb",
                                "sense_id": "6fb7f601-cb2e-31f4-939f-8dd6a32cc4e5",
                                "text": "„Aus der Zeit ab dem 16. Jahrhundert erbaute Fachwerkhäuser verschiedener Stilepochen schmücken das Straßenbild.“"
                            },
                            {
                                "example_id": "314dd86f-6ee6-4d9f-8ea3-17e5e0eec22b",
                                "sense_id": "6fb7f601-cb2e-31f4-939f-8dd6a32cc4e5",
                                "text": "„Betteln, die Schauseite der Armut, ist ins städtische Straßenbild der Wohlstandsgesellschaften hineingewachsen.“"
                            },
                            {
                                "example_id": "e4fc0654-80a1-42c4-b54a-cfb6197c3be4",
                                "sense_id": "6fb7f601-cb2e-31f4-939f-8dd6a32cc4e5",
                                "text": "„Bettler gehören zum Straßenbild deutscher Großstädte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
