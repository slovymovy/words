                "forms": [],
                "senses": [
                    {
                        "sense_id": "399fe0c5-0d04-3938-bd14-3e1221c0da6b",
                        "entry_id": "54be8922-3b86-3297-8e98-a62df1309373",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56fa94e7-b984-4b04-b56d-6e32e20393da",
                                "sense_id": "399fe0c5-0d04-3938-bd14-3e1221c0da6b",
                                "text": "Whisper her ear, and tell her, I and Ursula / Walk in the orchard, and our whole discourse / Is all of her;"
                            },
                            {
                                "example_id": "551d838c-c996-4617-9c17-f04bf379d431",
                                "sense_id": "399fe0c5-0d04-3938-bd14-3e1221c0da6b",
                                "text": "\"Is her name Ursula?\" And I called to mind the little girl who had tried to give some bread to the hungry John Halifax, and whose cry of pain we heard as the door shut upon her. Poor little lady! how sorry I was."
                            }
                        ]
                    }
                ],
