        "de-extract.jsonl": [
            {
                "entry_id": "28992441-97d9-34e2-8662-f08d42ab3458",
                "word": "abszytowy",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [
                    {
                        "form_id": "0771e2d8-3fba-49d4-872c-7bb0e18d300a",
                        "entry_id": "28992441-97d9-34e2-8662-f08d42ab3458",
                        "tags": [
                            "positive"
                        ],
                        "form": "abszytowy"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e915dde-24f7-3d15-963b-767d69766286",
                        "entry_id": "28992441-97d9-34e2-8662-f08d42ab3458",
                        "glosses": [
                            "Abschieds-, Entlassungs-, Verabschiedungs-"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05720b09-8e5b-4619-aa07-cf6eb97c18e0",
                        "source_entry_id": "28992441-97d9-34e2-8662-f08d42ab3458",
                        "source_sense_id": "0e915dde-24f7-3d15-963b-767d69766286",
                        "source_sense_description": "veraltet, meist Militär: Abschieds-, Entlassungs-, Verabschiedungs-",
                        "target_lang_word": "Abschied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e79a908a-4c97-347a-9e50-575e161ebb0e",
                                        "entry_id": "15fb1e94-4bc8-3d23-a5cc-6f5d188ba4a9",
                                        "glosses": [
                                            "Handlung, mit der man sich von jemandem oder etwas trennt (= verabschiedet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5647f567-a837-441c-8288-9a46329d7e80",
                                                "sense_id": "e79a908a-4c97-347a-9e50-575e161ebb0e",
                                                "text": "Es ist ein Abschied für immer."
                                            },
                                            {
                                                "example_id": "e252a18c-4068-4e14-a2aa-8d7eae698daa",
                                                "sense_id": "e79a908a-4c97-347a-9e50-575e161ebb0e",
                                                "text": "„Doch selbst für mutige Spitzenreiter wie ihn wird einmal die Zeit kommen, vom Risikosport Abschied zu nehmen.“"
                                            },
                                            {
                                                "example_id": "37bec904-240c-48bb-aa69-76cdca72b922",
                                                "sense_id": "e79a908a-4c97-347a-9e50-575e161ebb0e",
                                                "text": "Ich nehme heute Abschied von Dir."
                                            },
                                            {
                                                "example_id": "73f98c60-33fe-4e94-9d0a-cc01ba367d81",
                                                "sense_id": "e79a908a-4c97-347a-9e50-575e161ebb0e",
                                                "text": "„Es war ganz nach ihrer Art, die Sentimentalität eines Abschieds zu vermeiden.“"
                                            },
                                            {
                                                "example_id": "a6a622f0-bf74-45ce-ae97-6a596920f31b",
                                                "sense_id": "e79a908a-4c97-347a-9e50-575e161ebb0e",
                                                "text": "„Beim Abschied gaben wir ihm noch etwas Geld.“"
                                            },
                                            {
                                                "example_id": "f9ca42bb-513c-4f7e-b4aa-e01fa092cff9",
                                                "sense_id": "e79a908a-4c97-347a-9e50-575e161ebb0e",
                                                "text": "„Vor seiner Abreise hatte Fürst Andrej eine lange Aussprache mit dem Vater gehabt, und Prinzessin Marja hatte zwischen beiden beim Abschied eine gewisse Verstimmung wahrgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77b41a87-0a04-3852-ba7e-1826f04d3506",
                                        "entry_id": "15fb1e94-4bc8-3d23-a5cc-6f5d188ba4a9",
                                        "glosses": [
                                            "Entlassung aus dem Militärdienst oder aus dem Dienst als Beamter"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89be2273-5b56-4ddc-88a7-187df5ec333a",
                                                "sense_id": "77b41a87-0a04-3852-ba7e-1826f04d3506",
                                                "text": "Daraufhin nahm er seinen Abschied, er wurde also ehrenvoll aus dem Dienst entlassen."
                                            },
                                            {
                                                "example_id": "6d075ec5-0883-4a22-a2ca-da9f14bdee31",
                                                "sense_id": "77b41a87-0a04-3852-ba7e-1826f04d3506",
                                                "text": "„Noch vor Kriegsausbruch hatte Rostow von seinen Eltern einen Brief bekommen, in welchem sie ihm Nataschas Erkrankung und ihre Entlobung mitteilten – als Grund der Entlobung gaben sie ihm nur an, Natascha habe dem Fürsten Andrej abgeschrieben – und ihn erneut baten, seinen Abschied zu nehmen und nach Hause zurückzukehren.“"
                                            },
                                            {
                                                "example_id": "66d1b43d-23d7-4574-b8ec-cf8fdd9c1f62",
                                                "sense_id": "77b41a87-0a04-3852-ba7e-1826f04d3506",
                                                "text": "„Wenig mehr als ein Jahr vor Ausbruch des vierundsechziger Kriegs war ihm ein Sohn geboren worden, und kaum wieder in seine Garnison Brandenburg eingerückt, nahm er den Abschied, um sich auf sein seit dem Tode des Vaters halb verödetes Schloß Stechlin zurückzuziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce7452e4-aa45-4df8-9775-ceb0c423e19e",
                        "source_entry_id": "28992441-97d9-34e2-8662-f08d42ab3458",
                        "source_sense_id": "0e915dde-24f7-3d15-963b-767d69766286",
                        "source_sense_description": "veraltet, meist Militär: Abschieds-, Entlassungs-, Verabschiedungs-",
                        "target_lang_word": "Entlassung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entlassung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                        "entry_id": "3a3c1c99-4661-35d5-8915-69133ac7be3a",
                                        "glosses": [
                                            "Erlaubnis oder Zwang, einen Ort oder eine Institution (Arbeitsstelle, Gefängnis, Krankenhaus …) zu verlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96df38cf-26e1-4c7c-a855-a34ece3a7785",
                                                "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                                "text": "Es muss mit Entlassungen gerechnet werden."
                                            },
                                            {
                                                "example_id": "edb67edd-78a3-4853-bba8-d4c05711328b",
                                                "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                                "text": "„Er sollte siebzehn Jahre später, um einiges berühmter, an der Spanischen Grippe sterben, nachdem er im Ersten Weltkrieg im Jahr 1915 von einem Granatsplitter getroffen wurde und eine schwere Kopfverletzung erlitt, die zu seiner Entlassung aus dem Kriegsdienst geführt hatte.“"
                                            },
                                            {
                                                "example_id": "e60bc601-9e6c-46a7-9f56-1f5b12c057bb",
                                                "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                                "text": "„Seine Entlassung aus dem Kompanieführer-Lehrgang im Dienstrang eines Leutnants schilderte mein Vater immer als einen recht kuriosen Vorgang.“"
                                            },
                                            {
                                                "example_id": "d7cb9847-6f86-4528-a15e-9390b329a38c",
                                                "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                                "text": "„Nach der Entlassung von FDP-Chef Christian Lindner als Bundesfinanzminister soll der SPD-Politiker Jörg Kukies dieses Amt übernehmen.“"
                                            },
                                            {
                                                "example_id": "18af2c76-f325-4ff4-b07c-81aea267d04f",
                                                "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                                "text": "„Wenn es aber eine Entlassung gibt, mag sie ihn ebensogut gleich in den Westen führen.“"
                                            },
                                            {
                                                "example_id": "37a096ff-8ae3-4115-9270-64124f403260",
                                                "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                                "text": "„Über den Grund seiner Entlassung gab es verschiedene Versionen.“"
                                            },
                                            {
                                                "example_id": "85efd9dd-a6e2-45bf-8ec8-9c9ba58a80cb",
                                                "sense_id": "b5182e29-22e3-35e2-90e1-e364bce78d81",
                                                "text": "Weil wir eine bessere Wohnung gefunden hatten, baten wir unseren Vermieter um eine vorzeitige Entlassung aus dem Mietvertrag."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0f961c3-6e13-4782-8e87-db8eaad5d19f",
                        "source_entry_id": "28992441-97d9-34e2-8662-f08d42ab3458",
                        "source_sense_id": "0e915dde-24f7-3d15-963b-767d69766286",
                        "source_sense_description": "veraltet, meist Militär: Abschieds-, Entlassungs-, Verabschiedungs-",
                        "target_lang_word": "Verabschiedung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verabschiedung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Handlung, mit der man sich von jemandem verabschiedet oder mit der man verabschiedet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55abe9e5-617f-4f9c-80b5-5cfc52d3e392",
                                                "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                                "text": "Die Verabschiedung fiel ihm sehr schwer, doch er fasste sich kurz."
                                            },
                                            {
                                                "example_id": "d2e7d1fd-43ed-44bf-a5a4-73080ba8cc4b",
                                                "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                                "text": "Zur Verabschiedung gab ich meiner Frau eine Umarmung."
                                            },
                                            {
                                                "example_id": "c6b914f9-7c6e-4db4-a361-f8c6af18cbbc",
                                                "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                                "text": "„Bei der Verabschiedung am Abende steckte ihr Frau Mondtraut heimlich eine Unze Silber zu, schärfte ihr dabei aber ein, der Oberin nichts zu sagen und auf jeden Fall durch irgend einen geschickten Helfer das Zaubermittel herbeizuschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df4020df-87d1-3207-b7e4-e79da3093c29",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Begräbnis oder Trauerfeier"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e79ce897-1f40-4b49-8915-42d4925c31d4",
                                                "sense_id": "df4020df-87d1-3207-b7e4-e79da3093c29",
                                                "text": "Ihre Verabschiedung fand nur in engen Bekannten- und Familienkreisen auf dem Friedhof statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "250d0ac2-65c9-3867-af16-9fcb44465c41",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Beschluss eines Gesetzes durch ein Parlament oder sonstige gesetzgebende Organe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "538c001a-eac3-41cb-9495-48f424135ef0",
                                                "sense_id": "250d0ac2-65c9-3867-af16-9fcb44465c41",
                                                "text": "Nach der Verabschiedung des vom Bundestag paragraphierten Gesetzes, ist die Benutzung eines Handys ohne Freisprecheinrichtung während des Autofahrens verboten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "26042da8-e9cf-340f-af60-831060252afd",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Entlassung eines Beamten oder eines höhergestellten Angehörigen einer Streitkraft, meist als offizielle Feierlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b100b41a-f127-4804-a150-a4f97176cf75",
                                                "sense_id": "26042da8-e9cf-340f-af60-831060252afd",
                                                "text": "Er steht kurz vor seiner Verabschiedung aus der Haft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
