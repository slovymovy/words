                "senses": [
                    {
                        "sense_id": "d122f75e-3c35-3024-b9a6-059876506e4b",
                        "entry_id": "7bc6595d-ee76-39a4-947f-a2401a48c5c5",
                        "glosses": [
                            "Faculté ou action de saisir des objets, des proies ou autre avec la main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17df7bc2-6fd4-439d-ae41-509c5212df94",
                                "sense_id": "d122f75e-3c35-3024-b9a6-059876506e4b",
                                "text": "Chez l’homme, la préhension se trouve dans la main grâce au pouce qui, avec le reste de la main forme une pince et lui permet de saisir les objets."
                            },
                            {
                                "example_id": "dea18463-46ff-4156-b6e0-a83345fbb360",
                                "sense_id": "d122f75e-3c35-3024-b9a6-059876506e4b",
                                "text": "Tous étaient chaussés de gants de cuir souple, qui n’empêchaient pas la préhension."
                            }
                        ]
                    },
                    {
                        "sense_id": "89160ff9-06ee-3f07-bc1c-2ad025e466cb",
                        "entry_id": "7bc6595d-ee76-39a4-947f-a2401a48c5c5",
                        "glosses": [
                            "Capacité d’un organe quelconque à saisir des objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "383dd6cc-b300-4529-928c-76c366ecc089",
                                "sense_id": "89160ff9-06ee-3f07-bc1c-2ad025e466cb",
                                "text": "Dans de nouveaux exercices que l’aîné avait étudiés pour produire et mettre en scène « le petit gymnaste », Gianni, couché sur le dos, faisait tourbillonner Nello, saisi, lancé, ressaisi par ses pieds : des pieds qui ressemblaient, en ces moments, avoir des préhensions et le doigté de véritables mains."
                            }
                        ]
                    }
                ],
