                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cce0e023-799a-44c3-9fae-c26e72a666a3",
                                                "sense_id": "ae7a7dfc-4010-3f4b-9ac4-f7faf5fe51c6",
                                                "text": "It is awful, an old un like that telling such crams as she do."
                                            },
                                            {
                                                "example_id": "be5ec586-47d2-4cca-8953-3ce661d048f4",
                                                "sense_id": "ae7a7dfc-4010-3f4b-9ac4-f7faf5fe51c6",
                                                "text": "Shut up, and don't tell crams."
                                            }
                                        ]
