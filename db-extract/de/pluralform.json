                ],
                "senses": [
                    {
                        "sense_id": "23167e8b-d4ef-39bb-8c35-866b72b34feb",
                        "entry_id": "0d3c0725-69c6-3ee2-9685-a47e3fc2b493",
                        "glosses": [
                            "sprachliche Einheit, die Vielheit ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b0e5f59-a24b-4d7e-883a-81a35ef4f895",
                                "sense_id": "23167e8b-d4ef-39bb-8c35-866b72b34feb",
                                "text": "„In der darauf folgenden Verbalisierung ihrer Erinnerung greift Angela dann allerdings nicht zum zunächst erwartbaren Pronomen der ersten Person Singular, sondern sie wählt die entsprechende Pluralform mir (wir), womit sie sich als Mitglied einer Gruppe – hier ihrer Familie – identifiziert und als Vertreterin dieser erzählt.“"
                            },
                            {
                                "example_id": "9adbdf90-2436-4a32-b5d8-869ba63c5041",
                                "sense_id": "23167e8b-d4ef-39bb-8c35-866b72b34feb",
                                "text": "„Was die Morphologie betrifft, ist Deutsche Sprache = Schwere Sprache, denn jedes Kind muß die Wörter und ihre Pluralform lernen.“"
                            },
                            {
                                "example_id": "01571287-7014-49bc-8626-fab8333f967b",
                                "sense_id": "23167e8b-d4ef-39bb-8c35-866b72b34feb",
                                "text": "„Die Vielfalt der Pluralformen ist bei Wörtern, die auf -us enden, besonders groß.“"
                            },
                            {
                                "example_id": "490c98bd-c64e-4db4-871b-13b71bfac680",
                                "sense_id": "23167e8b-d4ef-39bb-8c35-866b72b34feb",
                                "text": "„Mit Ausnahme der nur verwiesenen Stichwörter hat jedes Substantiv grammatische Angaben, und zwar den Artikel, die Genitiv- und die Pluralform(en).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
