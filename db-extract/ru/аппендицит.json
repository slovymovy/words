                                        "sense_id": "91b93eed-c257-38d4-9eb7-ad93e9c39658",
                                        "entry_id": "4c406e17-8f65-3a99-a779-e015b3c16d30",
                                        "glosses": [
                                            "Entzündung des Wurmfortsatzes (Appendix) des Blinddarms"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f995e46f-fc43-41e9-9430-2a49b893dbea",
                                                "sense_id": "91b93eed-c257-38d4-9eb7-ad93e9c39658",
                                                "text": "Eine Blinddarmentzündung muss oft operiert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "544b187a-8e77-3d00-b092-bf924a4e8c7c",
                                        "entry_id": "4c406e17-8f65-3a99-a779-e015b3c16d30",
                                        "glosses": [
                                            "Entzündung des Blinddarms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cda66be3-786e-4c36-ae42-1458e20e987d",
                                                "sense_id": "544b187a-8e77-3d00-b092-bf924a4e8c7c",
                                                "text": "„Auf den Blinddarm als solchen beschränkte Krankheiten gibt es beim Menschen nicht, mit Ausnahme der Wurmfortsatzentzündung (Appendizitis). Letztere kann sich auf den eigentlichen Blinddarm ausdehnen und so zu einer Blinddarmentzündung (Typhlitis) führen.“"
                                            },
                                            {
                                                "example_id": "07c4989a-46d0-4e60-8ed6-8a7c19d13ee6",
                                                "sense_id": "544b187a-8e77-3d00-b092-bf924a4e8c7c",
                                                "text": "„Ein Patient wird mit einer akuten Blinddarmentzündung in die Klinik eingeliefert und liegt bereits auf dem Operationstisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
