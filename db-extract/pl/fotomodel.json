                                "target_senses": [
                                    {
                                        "sense_id": "0f249f45-f943-3833-bdb5-d3812b6d7076",
                                        "entry_id": "957fef79-f851-3616-8328-e27c679fb755",
                                        "glosses": [
                                            "Person, die sich gegen Bezahlung für Fotoaufnahmen zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74d0300c-8e95-4823-9c68-686c430e5d64",
                                                "sense_id": "0f249f45-f943-3833-bdb5-d3812b6d7076",
                                                "text": "„Ein freiberufliches Horror-Szenario: Was macht ein Fotograf, der für ein Fotoshooting eine Reise in die Karibik gebucht hat, wenn das Fotomodell krank wird und die Reise um eine Woche verschoben wird?“"
                                            },
                                            {
                                                "example_id": "8dfd26d4-9d99-417d-86f6-ddea7f1ae43b",
                                                "sense_id": "0f249f45-f943-3833-bdb5-d3812b6d7076",
                                                "text": "„Die schöne Domino hängte ihre Karriere als Fotomodell an den Nagel, um als Kopfgeldjägerin auf Verbrecherjagd zu gehen.“"
                                            },
                                            {
                                                "example_id": "02acca02-aca3-4e98-9344-dfe90195d5dc",
                                                "sense_id": "0f249f45-f943-3833-bdb5-d3812b6d7076",
                                                "text": "„Zu der Minderheit, die sich nicht irritieren ließ, zählte Frau Zacharias, eine abgewanderte Psychologiestudentin, die als Fotomodell Karriere gemacht hatte, dann aber mit einer jüngeren Freundin zusammenzog und als Sekretärin jobbte, wodurch sie endlich in Kleinschmidts Büro landete und den Laden schmiß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
