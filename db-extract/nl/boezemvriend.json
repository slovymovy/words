                "senses": [
                    {
                        "sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                        "entry_id": "38c5d391-e7fb-376c-bd70-83a4c8796694",
                        "glosses": [
                            "een persoon met wie men een diepe verwantschap ervaart op het gebied van vriendschap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9000fcc8-739e-4414-878e-1a67b93cd2a8",
                                "sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                                "text": "Zij was niet getrouwd met haar boezemvriend."
                            },
                            {
                                "example_id": "ece9a5fc-e94c-41be-bc24-94593d438a4f",
                                "sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                                "text": "Voor de zoveelste maal maakte hij een saluutgebaar naar Teun, die in acht dagen tijd van een volstrekt onbekende tot een boezemvriend was uitgegroeid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccd87571-dd51-4840-8cf8-0df76dd0f586",
                        "source_entry_id": "38c5d391-e7fb-376c-bd70-83a4c8796694",
                        "source_sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                        "target_lang_word": "Busenfreund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Busenfreund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                                        "entry_id": "fc02fc19-4b7e-3e05-b748-34b1e3634e18",
                                        "glosses": [
                                            "besonders enger Freund"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38865d2-1292-41fb-8cb0-64d64f3efcc1",
                                                "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                                                "text": "Jeden August schauen mein Busenfreund und ich nachts gemeinsam nach Sternschnuppen."
                                            },
                                            {
                                                "example_id": "8b805c62-7427-4bea-a51d-c47f7f45f432",
                                                "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                                                "text": "„Nein, lieber Freund, mein frommer Oheim hat neuerdings meine Schulden gezahlt, so dass ich seit der Einlösung meines letzten Wechsels keinen Busenfreund mehr habe, der Abraham heisst […].“"
                                            },
                                            {
                                                "example_id": "61a065b7-00b7-40c9-a247-064abda36b18",
                                                "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                                                "text": "„Er war mit dem Kommodore, der sein besonderer Busenfreund war, zum See gekommen und hatte sich an allen bisherigen Kämpfen und Feldzügen beteiligt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a644bcc8-1595-46fb-bc01-324393dc5c0d",
                        "source_entry_id": "38c5d391-e7fb-376c-bd70-83a4c8796694",
                        "source_sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                        "target_lang_word": "buddy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e844ac3d-2aab-355c-b14d-1d1089285e37",
                                        "entry_id": "c7e726a7-d4ca-312b-86c8-2a0a81cb7af2",
                                        "glosses": [
                                            "A friend or casual acquaintance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91044478-91a0-42d1-8f7b-e956513d44da",
                                                "sense_id": "e844ac3d-2aab-355c-b14d-1d1089285e37",
                                                "text": "They have been buddies since they were in school."
                                            },
                                            {
                                                "example_id": "cf9e7ba6-6f5b-4e58-8e8a-1c2460f2ef6e",
                                                "sense_id": "e844ac3d-2aab-355c-b14d-1d1089285e37",
                                                "text": "He told us we ought to think of Jesus as our buddy and all. He said he talked to Jesus all the time. Even when he was driving his car. That killed me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2447f35-7f2e-3fe8-bfb8-00bf2ff59389",
                                        "entry_id": "c7e726a7-d4ca-312b-86c8-2a0a81cb7af2",
                                        "glosses": [
                                            "A partner for a particular activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5288ea65-6990-409d-951d-49140ad4a9a0",
                                                "sense_id": "f2447f35-7f2e-3fe8-bfb8-00bf2ff59389",
                                                "text": "drinking buddies"
                                            },
                                            {
                                                "example_id": "3101de58-ab3f-479e-9320-6a16d20470f1",
                                                "sense_id": "f2447f35-7f2e-3fe8-bfb8-00bf2ff59389",
                                                "text": "training buddies [mentor/mentee]"
