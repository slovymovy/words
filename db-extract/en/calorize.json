                "senses": [
                    {
                        "sense_id": "8c7af876-e683-3000-b75e-96b3cb66df92",
                        "entry_id": "cb620729-db59-378d-9937-5cc8becae6d3",
                        "glosses": [
                            "To form a protective surface on (a ferrous metal) by coating with aluminum powder and then heating."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "755438be-e9ea-4deb-a1b1-a65ca308c218",
                                "sense_id": "8c7af876-e683-3000-b75e-96b3cb66df92",
                                "text": "He finds that materials that have been mechanically worked calorize better than cast material."
                            },
                            {
                                "example_id": "b39b17a3-1e75-491c-aa8f-60cefd705b2f",
                                "sense_id": "8c7af876-e683-3000-b75e-96b3cb66df92",
                                "text": "Forged, wrought, drawn, rolled or pressed metals calorize better than cast metals."
                            },
                            {
                                "example_id": "564d6fae-527a-435a-9afa-a5870a85dc85",
                                "sense_id": "8c7af876-e683-3000-b75e-96b3cb66df92",
                                "text": "The foundry at Barberton is also equipped to dip calorize (coating with aluminum) steel plates and castings."
                            }
                        ]
                    }
                ],
