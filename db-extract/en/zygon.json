                "senses": [
                    {
                        "sense_id": "e0d2dffb-eb7c-3c6c-8ed2-533315eed13a",
                        "entry_id": "cb8c81cc-5af2-3fc2-be5a-1b94d7d97a2b",
                        "glosses": [
                            "In the cerebrum, a short crossbar fissure that connects the two pairs of branches of a larger zygal (H-shaped) fissure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ae4e6a-f990-4da2-ba60-6abea1ccb8bf",
                                "sense_id": "e0d2dffb-eb7c-3c6c-8ed2-533315eed13a",
                                "text": "“The evidence is threefold: (1) as admitted by Ecker, the zygon always appears independently in the foetus;"
                            },
                            {
                                "example_id": "b173aa41-a888-4432-a089-b4a59e74acf2",
                                "sense_id": "e0d2dffb-eb7c-3c6c-8ed2-533315eed13a",
                                "text": "I am falling apart, the delicate zygon of my brain is opened."
                            }
                        ]
                    },
                    {
                        "sense_id": "69fdfecb-135c-3582-8559-38a522f4c9ab",
                        "entry_id": "cb8c81cc-5af2-3fc2-be5a-1b94d7d97a2b",
                        "glosses": [
                            "An affinity or connection in a piece of music between tones, chords, or phrases, such that one part appears to repeat, to imitate, or to derive from the other, especially when perceived as an organising principle in the music; a zygonic relationship."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405c584c-d056-499d-8743-7f0988bc9077",
                                "sense_id": "69fdfecb-135c-3582-8559-38a522f4c9ab",
                                "text": "Chopin's Prelude op. 28 no. 6 comprises 403 notes which give rise—in just one sub-domain (pitch class)—to around 13,000 potential primary zygons, 500 million potential secondary zygons, and 10¹⁸ potential tertiary zygons."
                            },
                            {
                                "example_id": "0bcd7bff-de1d-4757-ac4f-f773051168c5",
                                "sense_id": "69fdfecb-135c-3582-8559-38a522f4c9ab",
                                "text": "Zygonic relationships, or zygons, are depicted using the letter Z."
                            },
                            {
                                "example_id": "14ad08b7-e716-4b8c-b6e5-13a1d413178b",
                                "sense_id": "69fdfecb-135c-3582-8559-38a522f4c9ab",
                                "text": "Observe that the second melodic interval is deemed to exist in imitation of the first through the repetition of magnitude but not polarity through an \"inverse\" secondary zygon of pitch."
                            }
                        ]
                    }
                ],
