                    {
                        "sense_id": "7fcd485e-17b4-3139-8c61-9ee843ee7091",
                        "entry_id": "1a0faf04-4201-36e4-acfc-5a9f97d823d2",
                        "glosses": [
                            "Gerät zur Messung und Aufzeichnung von Bewegungen des Bodens, insbesondere bei Erdbeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1737008-0d09-4732-accc-4273b9516293",
                                "sense_id": "7fcd485e-17b4-3139-8c61-9ee843ee7091",
                                "text": "Viele Vulkane werden mit Seismometern überwacht."
                            },
                            {
                                "example_id": "74725fd8-cdab-4b32-a8ae-f26bb50e3692",
                                "sense_id": "7fcd485e-17b4-3139-8c61-9ee843ee7091",
                                "text": "Das verheerende Erdbeben wurde auch von Seismometern aufgezeichnet, die hunderte Kilometer entfernt waren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a939a3d1-6db7-4770-8d5c-e6db39c8c23e",
                        "source_entry_id": "1a0faf04-4201-36e4-acfc-5a9f97d823d2",
                        "source_sense_id": "7fcd485e-17b4-3139-8c61-9ee843ee7091",
