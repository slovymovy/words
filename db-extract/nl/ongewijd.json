                                        "entry_id": "d02b9ff8-94d2-3f9a-b193-fcdafa7634c5",
                                        "glosses": [
                                            "Not consecrated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586e3c9f-133f-46bd-8d2d-cfbbf2a13cef",
                                                "sense_id": "9e5b468d-4b45-3fe5-9937-d592af544b7c",
                                                "text": "One day, he decided to perform a funeral service for the unconsecrated souls he believed were imprisoned somewhere below in the hope of finally laying them to rest."
                                            }
