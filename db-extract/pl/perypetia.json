                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fb684ee0-c2f2-39ab-942e-3f076dc1e9da",
                        "entry_id": "a28584d5-e866-339b-85ab-06c679f4267e",
                        "glosses": [
                            "zmiana w losach bohaterów utworu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903c522d-096b-41a7-962c-fc2de3c926b2",
                                "sense_id": "fb684ee0-c2f2-39ab-942e-3f076dc1e9da",
                                "text": "Podyskutujmy chwilę o perypetiach Stasia i Nel w ziemi Mahdiego."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66370744-d7b2-42a1-9907-d6a0166b82ce",
                        "source_entry_id": "a28584d5-e866-339b-85ab-06c679f4267e",
                        "source_sense_id": "a7a35aac-936d-3bf1-8c00-48d4369c43f4",
                        "target_lang_word": "peripeteia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peripeteia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76285882-12a2-34fb-8270-89b3c061a99d",
                                        "entry_id": "30b1cacd-639c-3cbf-b7e4-bf8911de56b1",
                                        "glosses": [
                                            "A sudden reversal of fortune as a plot point in Classical tragedy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc295790-4e76-327c-8392-a9e98d5e8175",
                                        "entry_id": "30b1cacd-639c-3cbf-b7e4-bf8911de56b1",
                                        "glosses": [
                                            "Any sudden change in circumstances; a crisis."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24ccc81-9ad5-4593-b8c3-a92dd9100831",
                                                "sense_id": "dc295790-4e76-327c-8392-a9e98d5e8175",
                                                "text": "Once more I was a man in a myth, incapable of understanding it, but somehow aware that understanding it meant it must continue, however sinister its peripeteia."
                                            },
                                            {
                                                "example_id": "2a81d12b-6321-4b77-b25b-f5f3780aef57",
                                                "sense_id": "dc295790-4e76-327c-8392-a9e98d5e8175",
                                                "text": "They were to bestride the Algerian scene like demigods until the tragic peripeteia of 1961 […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f9ad3d-814a-3035-a6d5-f5e87aeb9da7",
                                        "entry_id": "30b1cacd-639c-3cbf-b7e4-bf8911de56b1",
                                        "glosses": [
                                            "A turning point in psychosocial development."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "021dd1f1-ba11-4224-a1a7-88dd8845a224",
                                                "sense_id": "e2f9ad3d-814a-3035-a6d5-f5e87aeb9da7",
                                                "text": "The visual moment whose consequences Freud began to ponder in the essay on the phallic stage has evolved into a peripeteia: \"Some day or other it happens that the child whose own penis is such a proud possession obtains a sight of the genital parts of a little girl; he must then become convinced of the absence of a penis in a creature so like himeself. With this, however, the loss of his own penis becomes imaginable, and the threat of castration achieves its delayed effect.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
