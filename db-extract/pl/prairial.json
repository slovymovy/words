                                    {
                                        "sense_id": "c79baf1d-652e-3dcf-a8c2-6cb6b39dfed9",
                                        "entry_id": "97442065-b2c5-3517-a514-1d72681154d4",
                                        "glosses": [
                                            "The ninth month of the French Republican Calendar, from May 20 or 21 to June 18 or 19."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
