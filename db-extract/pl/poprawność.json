                                                "sense_id": "d5c5168b-935c-3794-b3a9-87692d5be6e8",
                                                "text": "„Bald entschuldigte er sich, weil er in Gefangenschaft geraten war, bald schien er wieder der Meinung zu sein, er habe seine Vorgesetzten vor sich und suche seine militärische Korrektheit und seinen Diensteifer herauszustreichen.“"
                                            },
                                            {
                                                "example_id": "cb0dcc3b-f27a-4801-a730-bd0c3e30a12e",
                                                "sense_id": "d5c5168b-935c-3794-b3a9-87692d5be6e8",
                                                "text": "„Von äußerster Korrektheit war Thoma Lieven an der Börse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
