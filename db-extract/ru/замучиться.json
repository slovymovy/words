                "senses": [
                    {
                        "sense_id": "73ed5a7f-9808-3357-988a-227711148ae1",
                        "entry_id": "69c1ca33-9a5d-3dcd-9a0c-a8df8e83e4be",
                        "glosses": [
                            "to agonize, to be exhausted, to distress oneself, to be fed up, to be worn out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f646841a-caa1-49a6-89c9-97b1cda1c2bc",
                                "sense_id": "73ed5a7f-9808-3357-988a-227711148ae1",
                                "text": "Фе́льдшер, дрожа́ и всхли́пывая, дул на ладо́ни и весь ёжился, и де́лал вид, что он о́чень озя́б и заму́чился.",
                                "translation": "Yergunov, shivering and gasping, breathed on his hands, huddled up, and made a show of being very cold and exhausted.",
                                "english": "Yergunov, shivering and gasping, breathed on his hands, huddled up, and made a show of being very cold and exhausted."
                            }
                        ]
                    }
