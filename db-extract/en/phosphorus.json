                                "target_senses": [
                                    {
                                        "sense_id": "e1bd0f82-1fda-3022-817e-171823ada166",
                                        "entry_id": "a052ba2d-c8a4-377b-a560-f6f52e435369",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 15, das zu den Nichtmetallen gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f39d838-0e9d-45fa-80a8-2fdcf916fbc1",
                                                "sense_id": "e1bd0f82-1fda-3022-817e-171823ada166",
                                                "text": "Phosphor ist brennbar."
                                            },
                                            {
                                                "example_id": "22408257-663c-468d-8cec-8e960f3ff43e",
                                                "sense_id": "e1bd0f82-1fda-3022-817e-171823ada166",
                                                "text": "Alle biologischen Organismen benötigen Phosphor: Es ist Bestandteil der DNA- und RNA-Moleküle und ist für den Energiestoffwechsel der Zellen sehr wichtig."
                                            },
                                            {
                                                "example_id": "c9d15169-b246-4df5-98bf-c89eef00c86f",
                                                "sense_id": "e1bd0f82-1fda-3022-817e-171823ada166",
                                                "text": "„Als der flüssige Phosphor herüberleckte, immer näher kam, begannen Alf und seine Mutter zu kriechen, eine wurmhafte, schneckengleiche Fortbewegung, der wie auf Verabredung alle anderen folgten.“"
                                            },
                                            {
                                                "example_id": "50f9486f-25b9-404f-9de1-3ef3581b9ac1",
                                                "sense_id": "e1bd0f82-1fda-3022-817e-171823ada166",
                                                "text": "„Wenn zwischendurch auch noch der Phosphor-Gehalt unangenehm hoch wird, beginnen Bakterien, überschüssiges Phosphor auszuscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5abd97b-5a61-358d-9f8d-e4bfb04f19cf",
                                        "entry_id": "a052ba2d-c8a4-377b-a560-f6f52e435369",
                                        "glosses": [
                                            "Stoff, der in der Lage ist, gespeichertes Licht wieder abzugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
