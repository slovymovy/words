                        "glosses": [
                            "w sposób definitywny, ostateczny, zdecydowany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1b3879-5b6d-4a9f-8b00-42b84b388321",
                                "sense_id": "4b3bfbc2-e8be-3c7d-b22b-333b2630baca",
                                "text": "Ich związek, zawsze odległy od formy ustabilizowanej, został w końcu definitywnie zerwany."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a154344e-6fd8-4a77-b616-c607c89802d9",
                        "source_entry_id": "16d191c5-555c-3a44-ae76-ae4c525a99e9",
                        "source_sense_id": "4b3bfbc2-e8be-3c7d-b22b-333b2630baca",
                        "target_lang_word": "definitely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "definitely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                        "entry_id": "3a09d650-9e94-3015-b0e8-e1845b55f8ca",
                                        "glosses": [
                                            "Without question and beyond doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17663ba8-eeae-4fe3-9e67-4374926ada7f",
                                                "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                                "text": "Joe definitely doesn't know how to drive a tractor."
                                            },
                                            {
                                                "example_id": "35bac096-e678-43d3-8b69-e38e3bbec1d9",
                                                "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                                "text": "She said she wasn't coming, definitely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                        "entry_id": "3a09d650-9e94-3015-b0e8-e1845b55f8ca",
                                        "glosses": [
                                            "In a definite manner; decisively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8183e1b2-41c5-49da-ad93-89cff4ff9f2a",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "It was really impossible on board that ship to get away definitely from Almayer"
                                            },
                                            {
                                                "example_id": "64f95043-a2cb-43a6-811e-598be8b23344",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "And the Nose definitely turned away."
                                            },
                                            {
                                                "example_id": "b77493ff-1187-43e1-8a19-bdf51e9f198f",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "And these Elders were men of good standing in that community, and they swore definitely before the counsel that this lady committed this impropriety, and there was nobody to gainsay that, except the lady herself, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31f66a8e-620d-4bae-9a0a-f09434bfebbc",
                        "source_entry_id": "16d191c5-555c-3a44-ae76-ae4c525a99e9",
                        "source_sense_id": "4b3bfbc2-e8be-3c7d-b22b-333b2630baca",
                        "target_lang_word": "définitivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "définitivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                        "entry_id": "d289f49e-83dc-3405-bfcf-2f025e15ea2a",
                                        "glosses": [
                                            "D’une manière définitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60fd9f4-9a25-4df9-920d-474349ea549e",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Et quand elle se sentit définitivement seule et abandonnée, Yasmina se rendit chez ses deux amies qui l'accueillirent avec joie."
                                            },
                                            {
                                                "example_id": "d942812f-b007-4f25-831c-53ee085af493",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Elle enrageait de ne pas être sortie major. Elle l’aurait mérité pourtant, et cela aurait définitivement claqué le beignet à tous ces types qui ne la calculaient pas."
                                            },
                                            {
                                                "example_id": "f203e2b8-c9e7-4ee8-bb87-e33ae202088a",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Toutefois, si un magnanime sentiment de fraternité s'imposait sincèrement et définitivement, sans arrière-pensée, à tous les esprits européens, alors nous n'aurions pas à nous inquiéter du cosmopolitisme marseillais, intéressant embryon de la civilisation future."
                                            },
                                            {
                                                "example_id": "39da4482-c213-4f1d-bc2b-d8b63e62e232",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Ces messieurs me catalogueraient définitivement et toute démarche de ma part afin de me justifier ne servirait qu'à aggraver la situation."
                                            },
                                            {
                                                "example_id": "78325ce3-0990-49f1-a4ed-91e35fc9c17f",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Je me contentais depuis la veille de monter quelques instants dans la mâture ; à ce moment, je pris définitivement mon poste sur les barres du petit perroquet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1502d9e-5fc1-3ea5-92ae-df8283c508fe",
                                        "entry_id": "d289f49e-83dc-3405-bfcf-2f025e15ea2a",
                                        "glosses": [
                                            "Par jugement définitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10c7270-50ea-4a7d-ad97-8e291b8831f3",
                                                "sense_id": "a1502d9e-5fc1-3ea5-92ae-df8283c508fe",
                                                "text": "L’affaire a été jugée définitivement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653dd9bb-6a95-3fc6-89fc-628e2f4d96e4",
                                        "entry_id": "d289f49e-83dc-3405-bfcf-2f025e15ea2a",
                                        "glosses": [
                                            "(Usage critiqué) référence nécessaire (résoudre le problème) Assurément, comme on peut le conclure sans l’ombre d’un doute."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38069d26-c904-4888-9307-c544f35b0095",
                                                "sense_id": "653dd9bb-6a95-3fc6-89fc-628e2f4d96e4",
                                                "text": "Donc, oui, définitivement, le Parisien est ultra-sociable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "145d8cf4-60d1-44de-8f49-2133a0e34c2c",
                        "source_entry_id": "16d191c5-555c-3a44-ae76-ae4c525a99e9",
                        "source_sense_id": "4b3bfbc2-e8be-3c7d-b22b-333b2630baca",
                        "target_lang_word": "definitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "definitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8554742-2fea-3c44-b620-995458a4009c",
                                        "entry_id": "d5a73e3b-1385-3f02-ab6a-533fac4e6de9",
                                        "glosses": [
                                            "ohne Möglichkeit einer Veränderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "392e56be-a9ba-4d87-95fd-6f06cf731ab0",
                                                "sense_id": "d8554742-2fea-3c44-b620-995458a4009c",
                                                "text": "Die Angelegenheit ist definitiv beendet."
                                            },
                                            {
                                                "example_id": "ffa1d34c-e336-4acf-b013-adbd5b6619e8",
                                                "sense_id": "d8554742-2fea-3c44-b620-995458a4009c",
                                                "text": "„Indem jene in auswegloser Situation zum technischen Mittel der Lebensbeendigung raten, lösen sie die menschlichsten der Probleme nicht: nämlich die vielleicht doch grösste Ueberforderung an den Menschen, den schwierigsten und definitivsten Akt zu setzen; das Problem der Isolation, in das Sterben hineinführt, und das nicht Technik, sondern menschliche Wärme und Nähe erfordert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9a5fc45-087c-3bf4-bb09-4b07c5cf9cc6",
                                        "entry_id": "d5a73e3b-1385-3f02-ab6a-533fac4e6de9",
                                        "glosses": [
                                            "unkündbar (ein Beamtenstatus)"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f394c03-8762-4578-b0af-3c780412fe94",
                                                "sense_id": "f9a5fc45-087c-3bf4-bb09-4b07c5cf9cc6",
                                                "text": "„Das Dienstverhältnis ist definitiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
