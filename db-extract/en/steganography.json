                                        "glosses": [
                                            "de kennis van het op verborgen wijze overbrengen van informatie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ada611e-b2a1-48ab-ab10-76753527f3bd",
                                                "sense_id": "bce3db4b-db5a-3799-b50e-64b711c8b764",
                                                "text": "Door het gebruik van steganografie worden geheime boodschappen op onverdachte wijze getransporteerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8efea412-b07f-49c9-b5c0-58080de2c90e",
                        "source_entry_id": "f078377b-ea44-3c19-bf3d-027d565f9a9f",
                        "source_sense_description": "steganography",
