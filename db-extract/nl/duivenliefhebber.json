                            {
                                "example_id": "006adc00-eb22-433e-8473-5e1ba01e4a9c",
                                "sense_id": "7c3326e0-ab82-3102-a862-b8a4ac5c927b",
                                "text": "Jongetjes met duiven kijken u in het gezicht en trachten een duivenliefhebber in u te ontwaren."
                            },
                            {
                                "example_id": "aa7cf5da-8f86-41b8-9931-f78c8c3e4ca5",
                                "sense_id": "7c3326e0-ab82-3102-a862-b8a4ac5c927b",
                                "text": "Duivenmelkers vinden dat er onnatuurlijk veel roofvogels in Nederland zijn. Jaarlijks worden duizenden postduiven daardoor slachtoffer van moordlustige sperwers, haviken en slechtvalken. Duivenliefhebber Vincent Hoogerwerf wil daarom van de bescherming van de jagers af. Vogelliefhebber Kester Freriks vindt dat idee 'beschamend' en gaat in debat met de duivenbeschermheer."
                            }
                        ]
                    }
