                "senses": [
                    {
                        "sense_id": "99616f00-130a-3bfe-a403-03f3e855b286",
                        "entry_id": "e46a2d74-dbf5-3922-a6cb-7a0429ebf8c8",
                        "glosses": [
                            "Entretien téléphonique, appel téléphonique, coup de téléphone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e7367f-7697-4848-9ae2-b99bfb093995",
                                "sense_id": "99616f00-130a-3bfe-a403-03f3e855b286",
                                "text": "Mitten im Telefonat wurde die Verbindung unterbrochen.",
                                "translation": "Au milieu du coup de téléphone, la liaison s’est interrompue."
                            },
                            {
                                "example_id": "c7b502d7-192e-4c15-981a-49d3bd9fa1d4",
                                "sense_id": "99616f00-130a-3bfe-a403-03f3e855b286",
                                "text": "Jonas zwang sich, seine Aufmerksamkeit dem Telefonat zuzuwenden. Die Kollegin gab ihm eine Adresse durch, schnell tippte er sie in sein Navigationsgerät ein. Er sagte: »Ja, okay. Bin schon unterwegs.«",
                                "translation": "Jonas se força à reporter son attention sur le coup de fil. Sa collègue lui donna une adresse qu’il entra rapidement dans son navigateur GPS. — Oui, O.K., dit-il. Je suis parti."
                            }
                        ]
                    }
                ],
