                "senses": [
                    {
                        "sense_id": "721867a6-5165-345a-a548-ed845b4f4fae",
                        "entry_id": "deab8b2e-c435-312e-ae94-2559ed245f55",
                        "glosses": [
                            "Spore fongique caractéristique des urédinées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc96cc9-2b03-4e86-a875-dc6482472ad8",
                                "sense_id": "721867a6-5165-345a-a548-ed845b4f4fae",
                                "text": "L’Uromyces Betae vit sur les feuilles de la Betterave ; il se prête bien à l’étude de l’urédospore."
                            },
                            {
                                "example_id": "f6df61ee-a2c8-410f-ae8f-00c8a3bb3a3d",
                                "sense_id": "721867a6-5165-345a-a548-ed845b4f4fae",
                                "text": "Du printemps à l’automne, la contamination par les urédospores se déroulent de façon presque continue, pouvant ainsi étendre la maladie à l’ensemble de la culture."
                            },
                            {
                                "example_id": "ffc37f39-a349-4247-8ed3-926420e0c6fb",
                                "sense_id": "721867a6-5165-345a-a548-ed845b4f4fae",
                                "text": "Les urédospores et les téliospores sont des spores fongiques qui propagent des maladies fongiques sur les plantes."
                            }
                        ]
                    }
                ],
