                    "sense_definition": "Orde in een verzameling aanbrengen door soort bij soort te leggen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eieren worden zorgvuldig naar gewicht <w>gesorteerd</w>.",
                            "target_lang_translations": {
                                "it": "Le uova vengono accuratamente <w>selezionate</w> in base al peso."
                            }
                        },
                        {
                            "text": "We moeten eerst het afval <w>sorteren</w> voordat we het weggooien.",
                            "target_lang_translations": {
                                "it": "Dobbiamo prima <w>differenziare</w> i rifiuti prima di gettarli via."
                            }
                        }
                    ],
                    "synonyms": [
                        "ordenen",
                        "rangschikken"
                    ],
                    "common_phrases": [
                        "afval sorteren",
                        "post sorteren"
                    ],
                    "target_lang_definitions": {
                        "it": "Mettere in ordine una collezione raggruppando gli elementi simili."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "smistare",
                                "target_lang_sense_clarification": "per posta, merci o oggetti"
                            },
                            {
                                "target_lang_word": "differenziare",
                                "target_lang_sense_clarification": "riferito ai rifiuti"
                            },
                            {
                                "target_lang_word": "selezionare",
                                "target_lang_sense_clarification": "scegliere in base a criteri di qualità o peso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1e35ced-3db4-33f8-87b6-a16905871277",
                    "sense_definition": "Het in een bepaalde volgorde zetten van de elementen van een lijst.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de lijst met namen alfabetisch <w>sorteren</w>.",
                            "target_lang_translations": {
                                "it": "Puoi <w>ordinare</w> l'elenco dei nomi in ordine alfabetico."
                            }
                        },
                        {
                            "text": "Het is handig om de bestanden op datum te <w>sorteren</w>.",
                            "target_lang_translations": {
