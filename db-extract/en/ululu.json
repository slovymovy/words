            {
                "entry_id": "35934e1b-6b39-3e5c-a8e0-b91cdaf017ee",
                "word": "ululu",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a895c67-9732-30a3-bf3b-b783ebc5ea46",
                        "entry_id": "35934e1b-6b39-3e5c-a8e0-b91cdaf017ee",
                        "glosses": [
                            "An auspicious cry uttered by Indian women on festive occasions."
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5c1ee46f-49b7-43ec-889f-18e36c0f7157",
                                "sense_id": "2a895c67-9732-30a3-bf3b-b783ebc5ea46",
                                "text": "The use of Ululu […] as an auspicious sound is not only made by the women of Bengal, but also by the women of Orissa till to-day on festive occasions."
                            },
                            {
                                "example_id": "8612f595-4c64-4c98-a227-9ef0604b1d88",
                                "sense_id": "2a895c67-9732-30a3-bf3b-b783ebc5ea46",
                                "text": "The women Rākṣasa gave out auspicious calls of ululu which, when joined with ululations, rose into the skies."
                            },
                            {
                                "example_id": "70be0340-277e-412a-807f-70532d0538d0",
                                "sense_id": "2a895c67-9732-30a3-bf3b-b783ebc5ea46",
                                "text": "The women of the household utter a blood-curdling cry, onomatopoeically called the ululu, during the ārati. Bengali women utter this cry during all the high points of the Durga Pfija ritual."
                            }
                        ]
                    }
                ],
