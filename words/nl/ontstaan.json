                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ontstane</w> wanorde was enorm na het grote feest in de stad.",
                            "target_lang_translations": {
                                "en": "The <w>resulting</w> disorder was enormous after the big party in the city.",
                                "ru": "<w>Возникший</w> беспорядок после большого праздника в городе был огромным.",
                                "fr": "Le désordre <w>créé</w> était énorme après la grande fête dans la ville.",
                                "it": "Il disordine <w>risultante</w> è stato enorme dopo la grande festa in città."
                            }
                        },
                        {
                            "text": "De politie probeerde de <w>ontstane</w> situatie zo snel mogelijk op te lossen.",
                            "target_lang_translations": {
                                "en": "The police tried to resolve the <w>arisen</w> situation as quickly as possible.",
                                "ru": "Полиция пыталась как можно быстрее разрешить <w>сложившуюся</w> ситуацию.",
                                "fr": "La police a essayé de résoudre la situation <w>survenue</w> le plus rapidement possible.",
                                "it": "La polizia ha cercato di risolvere la situazione <w>sorta</w> il più rapidamente possibile."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de ontstane situatie",
                        "de ontstane schade"
                    ],
                    "target_lang_definitions": {
                        "en": "formed or developed as a result of a specific process",
                        "ru": "то, что сформировалось или развилось в результате определенного процесса",
                        "fr": "Qui s'est formé ou développé à la suite d'un processus particulier",
                        "it": "Ciò che si è formato o sviluppato come risultato di un processo specifico."
                    },
