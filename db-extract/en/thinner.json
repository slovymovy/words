                    {
                        "sense_id": "0ae7767b-5625-3aed-8a42-df954879ef1c",
                        "entry_id": "db80d381-d64d-367a-ab29-6958fe666e08",
                        "glosses": [
                            "A liquid substance used to thin the consistency of another liquid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0dd563f-b082-40f0-8537-1d55325d3024",
                                "sense_id": "0ae7767b-5625-3aed-8a42-df954879ef1c",
                                "text": "Turpentine or mineral spirits can be used as a thinner for oil-based paints."
                            }
                        ]
                    },
                    {
                        "sense_id": "85f5796b-cd73-3d90-8275-94b9b173584d",
                        "entry_id": "db80d381-d64d-367a-ab29-6958fe666e08",
                        "glosses": [
                            "Something that thins or thins out (another thing)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "403201f6-5bcf-47c9-bc7f-de00ede56969",
                                "sense_id": "85f5796b-cd73-3d90-8275-94b9b173584d",
                                "text": "Pomegranate juice and exercise are great natural blood thinners."
                            },
                            {
                                "example_id": "ea6a307a-fc47-45fe-b444-a55788857a44",
                                "sense_id": "85f5796b-cd73-3d90-8275-94b9b173584d",
                                "text": "The new type of mechanical thinner allowed thinning of peach blossoms to be completed earlier."
                            },
                            {
                                "example_id": "63104628-e07d-43b1-b66b-0ac1a7202585",
                                "sense_id": "85f5796b-cd73-3d90-8275-94b9b173584d",
                                "text": "A solid mane thinner is indispensable in finishing the looks of your horse."
                            }
                        ]
                    }
                ],
