                    }
                ],
                "senses": [
                    {
                        "sense_id": "551e0080-0569-34d9-ad46-24a27d9baf14",
                        "entry_id": "a84db23f-00c1-3b5a-a301-4057ac4efcc7",
                        "glosses": [
                            "Se conduire tout seul (en parlant d’un véhicule)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e133aec9-89fe-484e-92e3-a1d3065d74cb",
                                "sense_id": "551e0080-0569-34d9-ad46-24a27d9baf14",
                                "text": "Pour General Motors, une voiture qui peut s’autoconduire peut aussi enseigner ce qu’elle sait à un conducteur humain."
                            },
                            {
                                "example_id": "5e3b1525-5b59-4c4a-bee8-c7e2c395807f",
                                "sense_id": "551e0080-0569-34d9-ad46-24a27d9baf14",
                                "text": "Son ambition est de concevoir une voiture qui n’aura pas besoin d’être piloté par un chauffeur, mais qui sera capable de s’autoconduire."
                            },
                            {
                                "example_id": "5ced6059-8582-477a-955c-f5679cdc9a1e",
                                "sense_id": "551e0080-0569-34d9-ad46-24a27d9baf14",
                                "text": "Ce système, qui permet au véhicule de s’autoconduire ou d’effectuer seul des manœuvres, était activé lors de l’accident, survenu le 7 mai sur une route de Floride."
                            }
                        ]
                    }
