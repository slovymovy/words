                                        "examples": [
                                            {
                                                "example_id": "1e31fcbc-24c2-47c5-ad36-e96c6716e1c3",
                                                "sense_id": "29caca54-6a57-3824-b997-7ae837eaa507",
                                                "text": "Er hat sich mit seinen rhetorischen Mitteln gut aus der Affaire gezogen."
                                            },
                                            {
                                                "example_id": "d3139bef-d628-4b89-97eb-ba13dab967dc",
                                                "sense_id": "29caca54-6a57-3824-b997-7ae837eaa507",
                                                "text": "„Nach der rhetorischen Glanzleistung des Präsidenten folgte ein Schwall blecherner patriotischer Phrasen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c446575-6554-344c-acc7-50b754da3740",
                                        "entry_id": "89e5b931-7da2-3aec-95ad-0bec4dedaeec",
                                        "glosses": [
                                            "auf die Rhetorik bezogen"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de1f285-3c9c-4121-a44d-c420ebe9eb4d",
                                                "sense_id": "2c446575-6554-344c-acc7-50b754da3740",
                                                "text": "Die Klimax ist ein rhetorisches Mittel, um Zuhörer zu beeinflussen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "822eb898-5796-3a5e-958b-5362e4e2edab",
                                        "entry_id": "89e5b931-7da2-3aec-95ad-0bec4dedaeec",
                                        "glosses": [
                                            "in der Verbindung rhetorische Frage: nicht ernst gemeint"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa053da5-b3f4-493b-9404-560d49005c44",
                                                "sense_id": "822eb898-5796-3a5e-958b-5362e4e2edab",
                                                "text": "Eine Frage wird dann als rhetorisch aufgefasst, wenn man unterstellt, dass sie nicht wirklich als Frage gemeint war."
                                            },
                                            {
                                                "example_id": "f5b03d4c-7bfd-4888-b036-b4306cb435e6",
                                                "sense_id": "822eb898-5796-3a5e-958b-5362e4e2edab",
                                                "text": "Ich nehme mal an, das war jetzt eine rein rhetorische Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
