                                        "glosses": [
                                            "A person who subscribes to a publication or a service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c864b42-4d14-47eb-b042-01aae853e48b",
                                                "sense_id": "3b23d137-08c8-390e-957a-86c1c7e53c2c",
                                                "text": "Our magazine has over ten thousand subscribers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b274dc8c-48d3-315d-87b1-aaa0dd428f5a",
                                        "entry_id": "3c28b4e3-58d0-3916-9a20-486221e6a7c7",
                                        "glosses": [
                                            "A system or component that subscribes to something, such as an event, made available by a publisher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce97097-90b8-403a-8669-23828dfaf486",
                                                "sense_id": "b274dc8c-48d3-315d-87b1-aaa0dd428f5a",
                                                "text": "An event aggregator facilitates a fire-and-forget model of communication. The object triggering the event doesn't care if there are any subscribers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
