                "senses": [
                    {
                        "sense_id": "014980cc-d06e-3ba5-8024-a5ac96385b64",
                        "entry_id": "da52d41a-3c8a-3a66-82bc-7dad06af98d4",
                        "glosses": [
                            "Beförderung des Postguts mit von Katapulten gestarteten Flugzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d69a43-daa3-44a8-b52d-7d222b8a1a08",
                                "sense_id": "014980cc-d06e-3ba5-8024-a5ac96385b64",
                                "text": "„Die Ära der Katapultpost währte allerdings nur kurz: Bereits sechs Jahre nach Aufnahme der Katapultflüge wurde diese Art der Postbeförderung über dem Nordatlantik wieder eingestellt; auf der Südatlantikstrecke existierte sie immerhin zehn Jahre.“"
                            },
                            {
                                "example_id": "b072e978-8fba-4359-954e-01b842db69dc",
                                "sense_id": "014980cc-d06e-3ba5-8024-a5ac96385b64",
                                "text": "„Katapultpost, später amtlich Schleuderflugpost genannt, erfreut sich bis heute wegen der schönen Frankaturen und vor allem wegen der Vielzahl der attraktiven werbewirksamen Flugbestätigungsstempel bei Sammlern großer Beliebtheit.“"
                            }
                        ],
