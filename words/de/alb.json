                    "frequency": "Low",
                    "semantic_group_id": "gewaesser",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Der kleine Pfad führt direkt am Ufer der <w>Alb</w> entlang durch das wildromantische Tal."
