    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1f3e4003-51f6-37d7-a575-9ea268f36321",
                "word": "immunology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3f86f1ec-b70a-4429-a699-83d3ba7748ca",
                        "entry_id": "1f3e4003-51f6-37d7-a575-9ea268f36321",
                        "tags": [
                            "plural"
                        ],
                        "form": "immunologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73dd3f34-f664-351c-832e-3fefd31a703d",
                        "entry_id": "1f3e4003-51f6-37d7-a575-9ea268f36321",
                        "glosses": [
                            "The branch of medicine that concerns the body's immune system."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ce1029c3-0628-4c1d-ba27-615cd44b624b",
                                "sense_id": "73dd3f34-f664-351c-832e-3fefd31a703d",
                                "text": "Obviously, licentiates to practice medicine should receive instruction of a definite and practical nature in this important branch of modern medicine, or immunology should receive a place in the classification of specialties, a fact which the importance of the subject may command."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0db4a7e5-b456-484e-9e2f-c60df2be3b10",
                        "source_entry_id": "1f3e4003-51f6-37d7-a575-9ea268f36321",
                        "source_sense_id": "73dd3f34-f664-351c-832e-3fefd31a703d",
