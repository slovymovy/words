            {
                "entry_id": "46b5517e-e287-3610-90da-0f95ff859555",
                "word": "pneumatophore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94b92926-91ad-40ce-ab4f-729fa6fab4fa",
                        "entry_id": "46b5517e-e287-3610-90da-0f95ff859555",
                        "tags": [
                            "plural"
                        ],
                        "form": "pneumatophores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c71602a5-cdcb-3da4-b6ab-fa658abc2245",
                        "entry_id": "46b5517e-e287-3610-90da-0f95ff859555",
                        "glosses": [
                            "Excroissance aérienne des racines de certains arbres vivant dans des zones humides (marais, marécage, mangrove, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32fff0b6-a3b1-4dcf-b9f4-125acc15d50a",
                                "sense_id": "c71602a5-cdcb-3da4-b6ab-fa658abc2245",
                                "text": "Le cyprès chauve émet, vers l'âge de 30 ans, des protubérances coniques en forme de genou, qui croissent verticalement sur les racines jusqu’à 1,5 mètre de hauteur, dépassent le niveau des plus hautes eaux et assurent ainsi la respiration radiculaire. D’où leur qualification de pneumatophore."
                            },
                            {
                                "example_id": "f9d7f119-eca7-4275-a3cc-c06e016c66b1",
                                "sense_id": "c71602a5-cdcb-3da4-b6ab-fa658abc2245",
                                "text": "L’excès d’eau provoque un manque d’oxygène qui fait obstacle à la respiration. Ainsi dans les mangroves (végétation développée sur le littoral tropical), les arbres possèdent des racines aériennes (les pneumatophores) qui leur permettent de respirer."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d4e98c4-ba7c-3f88-a1d5-bb54c067c4b7",
                        "entry_id": "46b5517e-e287-3610-90da-0f95ff859555",
                        "glosses": [
                            "Organe rempli d’air et servant souvent de flotteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cbf62ae-a49d-445f-bc46-c5855359f306",
                                "sense_id": "2d4e98c4-ba7c-3f88-a1d5-bb54c067c4b7",
                                "text": "Les organismes de l’ordre des Siphonophorae comme la physalie flottent à l’aide d’un pneumatophore."
                            }
                        ]
                    }
                ],
