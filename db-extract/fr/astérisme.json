        "fr-extract.jsonl": [
            {
                "entry_id": "3acf2b54-690d-3af5-b65e-59aee84f641f",
                "word": "astérisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e95dddf5-3ccc-4b53-a6a2-914b8aa4f4b0",
                        "entry_id": "3acf2b54-690d-3af5-b65e-59aee84f641f",
                        "tags": [
                            "plural"
                        ],
                        "form": "astérismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7f124c7-8f5b-309e-8689-6969d26d169e",
                        "entry_id": "3acf2b54-690d-3af5-b65e-59aee84f641f",
                        "glosses": [
                            "Constellation, figure dessinée par plusieurs étoiles."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f718b514-f786-47cd-b742-95ca18d025a5",
                                "sense_id": "f7f124c7-8f5b-309e-8689-6969d26d169e",
                                "text": "Les astérismes sont marqués sur le globe céleste."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1a96cea-2f28-3588-a9c4-a08f62e04d43",
                        "entry_id": "3acf2b54-690d-3af5-b65e-59aee84f641f",
                        "glosses": [
                            "Phénomène optique en forme d'étoile à 4 ou 6 branches nommée aussi astérie, que l’on observe dans certains minéraux (tel le grenat, le saphir, etc.) par diffraction de la lumière."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a22cc127-e764-3135-a594-6cdc8b9b843f",
                        "entry_id": "3acf2b54-690d-3af5-b65e-59aee84f641f",
                        "glosses": [
                            "Signe typographique formé de trois astérisques disposés en triangle (⁂). Il permet d’attirer l’attention sur un passage ou bien de séparer les sous-chapitres d’un livre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95150096-811e-4572-8767-b3bd0c278d8b",
                        "source_entry_id": "3acf2b54-690d-3af5-b65e-59aee84f641f",
                        "source_sense_description": "Figure dessinée par plusieurs étoiles",
                        "target_lang_word": "asterism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asterism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e363f77-37ec-39d1-9cec-775fd62f213e",
                                        "entry_id": "bdba50b1-4fab-3466-8e14-6272e57cdc99",
                                        "glosses": [
                                            "An unofficial constellation (small group of stars that forms a visible pattern)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0681cf4-837a-4fff-ace0-7a05c85a8dcb",
                                                "sense_id": "7e363f77-37ec-39d1-9cec-775fd62f213e",
                                                "text": "The Big Dipper, Summer Triangle, and Orion's Belt are asterisms."
                                            },
                                            {
                                                "example_id": "42851a1f-9d4d-4850-a7cd-5070822532a4",
                                                "sense_id": "7e363f77-37ec-39d1-9cec-775fd62f213e",
                                                "text": "Of the constellations, or asterisms. [...] It therefore became necessary to adopt a more general method of distinguishing them. This was accomplished by portioning out the heavens into imaginary figures, of men, birds, fishes, &c. called Constellations or Asterisms."
                                            },
                                            {
                                                "example_id": "e762a732-c824-4790-a0e5-0be22eca8ff1",
                                                "sense_id": "7e363f77-37ec-39d1-9cec-775fd62f213e",
                                                "text": "Like Pisces and Capricorn, Aquarius is located in that part of the sky known as \"Astral Sea,\" a region inhabited by water asterisms such as Eridanus, Cetus (the Whale), and the Dolphin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33bac7a7-0fee-3736-a4e4-7712ef5bc1e6",
                                        "entry_id": "bdba50b1-4fab-3466-8e14-6272e57cdc99",
                                        "glosses": [
                                            "A rarely used typographical symbol of three asterisks arranged in a triangle, ⁂, used to call attention to a passage or to separate subchapters in a book. Distinct from a dinkus which also uses asterisks to separate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6f33e9a-850c-38d9-a820-16b0f5c5e1b2",
                                        "entry_id": "bdba50b1-4fab-3466-8e14-6272e57cdc99",
                                        "glosses": [
                                            "A star-shaped figure exhibited by some crystals by reflected light (as in a star sapphire) or by transmitted light (as in some mica)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2017c830-0129-419e-a997-b5e49b918229",
                        "source_entry_id": "3acf2b54-690d-3af5-b65e-59aee84f641f",
                        "source_sense_description": "Figure dessinée par plusieurs étoiles",
                        "target_lang_word": "asterismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asterismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7e114b8f-a055-3841-965b-f116885fbefc",
                                        "entry_id": "42a1b29f-1acd-3fdc-901d-d0e1c01a6920",
                                        "glosses": [
                                            "Grupo de estrellas, generalmente el que resalta o resulta conspicuo dentro una constelación mayor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8703f998-36d5-4e07-a3a5-71a437ef10f6",
                                                "sense_id": "7e114b8f-a055-3841-965b-f116885fbefc",
                                                "text": "Dos asterismos fácilmente reconocibles son las Pléyades y el Cinturón de Orión."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1578e277-658b-3386-8862-013a08b8dfac",
                                        "entry_id": "42a1b29f-1acd-3fdc-901d-d0e1c01a6920",
                                        "glosses": [
                                            "fenómeno óptico que se observa en algunos rubíes, zafiros y otras gemas sobre un área reflectante en forma de una estrella sobre la superficie de un corte de cabujón de una piedra."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
