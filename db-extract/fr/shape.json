                            {
                                "target_word": "shape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24556f74-910e-3727-8b0b-ba23dd16cece",
                                        "entry_id": "f46184a1-ba0c-3adf-b2b0-0dd77062dfc8",
                                        "glosses": [
                                            "To create or make."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7787a5c6-8d30-4c21-8ba5-8bf2e8d9cd76",
                                                "sense_id": "24556f74-910e-3727-8b0b-ba23dd16cece",
                                                "text": "1685, Satan's Invisible World Discoveredː\nWhich the mighty God of heaven shope."
                                            },
                                            {
                                                "example_id": "15896afe-39f1-40f1-913e-799356d965d3",
                                                "sense_id": "24556f74-910e-3727-8b0b-ba23dd16cece",
                                                "text": "Earth was shapen by God for God's folk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ca907b4-599e-3da0-800a-e8faece2f4f8",
                                        "entry_id": "f46184a1-ba0c-3adf-b2b0-0dd77062dfc8",
                                        "glosses": [
                                            "To give something a shape and definition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baed8c35-c96a-4353-b8f1-3f2d232d75b4",
                                                "sense_id": "4ca907b4-599e-3da0-800a-e8faece2f4f8",
                                                "text": "Shape the dough into a pretzel. For my art project, I plan to shape my clay lump into a bowl."
                                            },
                                            {
                                                "example_id": "70246a76-b18f-4fa3-a95c-55d8f22c41f5",
                                                "sense_id": "4ca907b4-599e-3da0-800a-e8faece2f4f8",
                                                "text": "The professor never pretended to the academic prerogative of forcing his students into his own channels of reasoning; he entered into and helped shape the discussion but above all he made his men learn to think for themselves and rely upon their own intellectual judgments."
                                            },
                                            {
                                                "example_id": "5fd12d94-50e1-42b5-b432-6959031b962d",
                                                "sense_id": "4ca907b4-599e-3da0-800a-e8faece2f4f8",
                                                "text": "Think of banking today and the image is of grey-suited men in towering skyscrapers. Its future, however, is being shaped in converted warehouses and funky offices in San Francisco, New York and London, where bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "926ab4a5-2852-350e-b3cb-695c1fea7246",
                                        "entry_id": "f46184a1-ba0c-3adf-b2b0-0dd77062dfc8",
                                        "glosses": [
                                            "To form or manipulate something into a certain shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b98310-63ab-4336-81d4-2ee07fa395b6",
                                                "sense_id": "926ab4a5-2852-350e-b3cb-695c1fea7246",
                                                "text": "Mature the Virgin was of Egypt's Race: / Grace ſhap'd her Limbs; and Beauty deck'd her Face: […]"
                                            },
                                            {
                                                "example_id": "8508e85f-dd12-4f76-ad03-511db59d360d",
                                                "sense_id": "926ab4a5-2852-350e-b3cb-695c1fea7246",
                                                "text": "Bendtner's goal-bound shot was well saved by goalkeeper Ali Al Habsi but fell to Arsahvin on the edge of the area and the Russian swivelled, shaped his body and angled a sumptuous volley into the corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ea28a13-5e68-3d09-b9e3-1b5e64e5f756",
                                        "entry_id": "f46184a1-ba0c-3adf-b2b0-0dd77062dfc8",
                                        "glosses": [
                                            "To give influence to."
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1189d88d-f744-3c2f-ac13-d6156eacb0b8",
                                        "entry_id": "f46184a1-ba0c-3adf-b2b0-0dd77062dfc8",
                                        "glosses": [
                                            "To suit; to be adjusted or conformable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2986d927-5e51-4a1c-83e7-05c8a29ef954",
                                                "sense_id": "1189d88d-f744-3c2f-ac13-d6156eacb0b8",
                                                "text": "The more of you 'twas felt, the more it shap'd / Unto my end of stealing them"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "093c640f-65aa-36cb-8ee5-7bed2e3196cb",
                                        "entry_id": "f46184a1-ba0c-3adf-b2b0-0dd77062dfc8",
                                        "glosses": [
                                            "To imagine; to conceive."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9feab2-4ade-455d-8e46-664c72653a51",
                                                "sense_id": "093c640f-65aa-36cb-8ee5-7bed2e3196cb",
                                                "text": "Oft my jealousy / Shapes faults that are not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
