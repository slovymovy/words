                        "examples": [
                            {
                                "example_id": "c55ce288-f51e-44f0-83a6-c0650424585f",
                                "sense_id": "bbdef01e-5ad0-3fff-af91-de20897734cb",
                                "text": "Misrata is de enige stad in het westen van Libië die in handen is van de opstandelingen. Gisteren zinspeelde de regering al op een vertrek van het leger. Viceminister Kaim van Buitenlandse Zaken zei dat de regering de strijd in Misrata vermoedelijk overlaat aan lokale stammen die trouw zijn aan kolonel Kadhafi."
                            },
                            {
                                "example_id": "f0650859-0af6-44ca-be6a-71af1c8d40f8",
                                "sense_id": "bbdef01e-5ad0-3fff-af91-de20897734cb",
                                "text": "De viceminister van Cultuur vond de zoen ongepast. \"De Iraanse vrouw is het symbool van kuisheid en onschuld\", aldus Hossein Noushabadi. Hij wil niet dat Iraanse vrouwen in het buitenland een slechte naam krijgen."
                            }
                        ]
