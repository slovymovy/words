        "fr-extract.jsonl": [
            {
                "entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                "word": "illégitime",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e6248fb-3d99-4fe6-864d-6cd31af7c7b6",
                        "entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "illégitimes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "167e4141-7738-3ee1-aafa-5781d1a6341e",
                        "entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "glosses": [
                            "Qui n’est pas légitime, qui n'a pas de légitimité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e509636e-f15a-4fdf-a9f4-acc4e0d925bb",
                                "sense_id": "167e4141-7738-3ee1-aafa-5781d1a6341e",
                                "text": "Les musulmans, guidés par leurs ulémas, rejetaient purement et simplement comme illégitime un pouvoir temporel très présent pour eux."
                            }
                        ]
                    },
                    {
                        "sense_id": "453fcbc5-a482-3ff6-bdf0-77518fffd528",
                        "entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "glosses": [
                            "Qualifie un gouvernement qui n'émane pas de la nation."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "05b69b46-e9e7-3faf-85a3-749aadab6730",
                        "entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "glosses": [
                            "Qualifiait un couple qui n'était pas consacré par le mariage."
                        ],
                        "tags": [
                            "dated",
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "78048c2e-da15-3921-8347-fbf7ace7a6d9",
                        "entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "glosses": [
                            "Qualifiait la naissance d'un enfant hors du mariage et cet enfant lui-même."
                        ],
                        "tags": [
                            "dated",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "780e1a74-4219-4462-8e3f-e4ec64e68d49",
                                "sense_id": "78048c2e-da15-3921-8347-fbf7ace7a6d9",
                                "text": "Que le nombre important de naissances illégitimes soit une marque d'immoralité, je le veux bien ; encore est-il qu'il faut faire des distinctions et examiner si ce n'est pas plutôt un signe d'irrégularité que d'immoralité."
                            },
                            {
                                "example_id": "8d6d6aa3-f153-478a-a1a7-cd413bafbfea",
                                "sense_id": "78048c2e-da15-3921-8347-fbf7ace7a6d9",
                                "text": "Non contente d'être une laissée-pour-compte et une cossarde frayant avec des personnages douteux, la fille illégitime du candidat au Sénat Laurence Jeffries était aussi une traînée."
                            }
                        ]
                    },
                    {
                        "sense_id": "aad5d833-c545-3589-a183-cf85dbffc075",
                        "entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "glosses": [
                            "Qui est injuste, déraisonnable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad02f21b-5463-4826-bb9a-8a6ce6674919",
                                "sense_id": "aad5d833-c545-3589-a183-cf85dbffc075",
                                "text": "Désirs illégitimes. - Prétention illégitime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "748ae3e0-53f6-4aff-a554-84c8a8bb19a3",
                        "source_entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "target_lang_word": "unehelich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unehelich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1af47525-7960-33f6-88f2-4508c827487b",
                                        "entry_id": "aee76de2-dd45-306f-87e6-fb0a5ed39e67",
                                        "glosses": [
                                            "nicht aus einer gültigen Ehe stammend (Nachkommen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cbb3a50-f431-4300-95aa-45907d66a2b4",
                                                "sense_id": "1af47525-7960-33f6-88f2-4508c827487b",
                                                "text": "„Sie ist die uneheliche Tochter einer Schauspielerin, sie sagt, das sei eine Schande.“"
                                            },
                                            {
                                                "example_id": "8693c3ef-dd36-46a2-9f98-7d819f816d48",
                                                "sense_id": "1af47525-7960-33f6-88f2-4508c827487b",
                                                "text": "„Ihre Mutter, die sich als Linotypistin durchschlug, hatte das uneheliche Kind vorzeitig aus der Schule genommen, damit es zum Lebensunterhalt beitrage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f78b7ec-3a6a-39f2-9142-45e473d19575",
                                        "entry_id": "aee76de2-dd45-306f-87e6-fb0a5ed39e67",
                                        "glosses": [
                                            "nicht auf die Ehe bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b74a1c24-52a3-43b3-973f-f160fc1dc77c",
                        "source_entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "target_lang_word": "unrechtmäßig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrechtmäßig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92286a92-01fa-3680-b2bd-4c0ea3955bd7",
                                        "entry_id": "1795a0c7-dd69-360f-aa5e-79c2a1d2350b",
                                        "glosses": [
                                            "nicht dem Recht entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d839d8de-64d6-49fc-a92a-365f1ea4e8eb",
                                                "sense_id": "92286a92-01fa-3680-b2bd-4c0ea3955bd7",
                                                "text": "Der Konsum von Cannabis ist unrechtmäßig, wird jedoch nicht bestraft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5309c5fe-844b-4601-8304-8633541c3a28",
                        "source_entry_id": "bdb837dc-de1c-3374-a998-33b4c37bc989",
                        "target_lang_word": "illegitimate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illegitimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47f8b4cf-4e9f-3fe1-b619-e35292ba213b",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Not conforming to known principles, or established or accepted rules or standards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d600ff-2742-4d8a-a95e-885dc070630f",
                                                "sense_id": "47f8b4cf-4e9f-3fe1-b619-e35292ba213b",
                                                "text": "[…] it may be impossible to convince them that the illegitimate power which they obtain, by degrading themselves, is a curse […]"
                                            },
                                            {
                                                "example_id": "78ea22c9-a3b4-4fe6-be30-d3104d0973f6",
                                                "sense_id": "47f8b4cf-4e9f-3fe1-b619-e35292ba213b",
                                                "text": "The so-called interstellar space […] has not the properties of ordinary space. It will not conduct sound, nor can a human being move through it. It is therefore illegitimate to measure it in miles."
                                            },
                                            {
                                                "example_id": "68b150bf-15fb-4893-bed0-59979586f378",
                                                "sense_id": "47f8b4cf-4e9f-3fe1-b619-e35292ba213b",
                                                "text": "Our attitude was that, to put it briefly, our presence there [in South Africa] was legal but illegitimate. We had an abstract right to be there, a birthright, but the basis of that right was fraudulent. Our presence was grounded in a crime, namely colonial conquest, perpetuated by apartheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b54983-deed-3d8a-85c7-5503ab609be0",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Not in accordance with the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d26ede-c0ed-4fb7-b0c8-0625de991b7b",
                                                "sense_id": "35b54983-deed-3d8a-85c7-5503ab609be0",
                                                "text": "[…] if things went on at this rate it would be doubtful soon whether ever again he would be able to win another election by methods legitimate or illegitimate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0362d1-63a3-3349-b110-7d62619ce05b",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Not sanctioned by marriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcc042f2-8e79-449c-b837-d23e17e3104b",
                                                "sense_id": "1e0362d1-63a3-3349-b110-7d62619ce05b",
                                                "text": "If we credit the scandal of the former [i.e. his enemies], Artaxerxes sprang from the illegitimate commerce of a tanner’s wife with a common soldier."
                                            },
                                            {
                                                "example_id": "f938d6eb-b39a-4d88-bdd8-fa8430bd0cb0",
                                                "sense_id": "1e0362d1-63a3-3349-b110-7d62619ce05b",
                                                "text": "His illegitimate birth deprived him of the influence of a father until perhaps his fifth year […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9912376d-f464-3124-84a0-5661f321c8d9",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Not sanctioned by marriage.",
                                            "Born to unmarried parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f266d8a3-05da-44df-889e-c1de6d9fece7",
                                                "sense_id": "9912376d-f464-3124-84a0-5661f321c8d9",
                                                "text": "an illegitimate child"
                                            },
                                            {
                                                "example_id": "c5ba0556-7722-4cd5-a4da-39ebb6a2960b",
                                                "sense_id": "9912376d-f464-3124-84a0-5661f321c8d9",
                                                "text": "I am a bastard begot, bastard instructed, bastard in mind, bastard in valour, in every thing illegitimate."
                                            },
                                            {
                                                "example_id": "443ddb4a-1f94-4b1e-8f94-4122b9ea4ae8",
                                                "sense_id": "9912376d-f464-3124-84a0-5661f321c8d9",
                                                "text": "‘This child,’ said Mr. Brownlow, drawing Oliver to him, and laying his hand upon his head, ‘is your half-brother; the illegitimate son of your father […]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da55b69b-3d37-3133-be81-14f19c6df5aa",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Not sanctioned by marriage.",
                                            "Having a child or children with a person to whom one is not married."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b365f4a5-c53a-4219-a1a2-c8ee6d60e4e4",
                                                "sense_id": "da55b69b-3d37-3133-be81-14f19c6df5aa",
                                                "text": "She had only to collect her memories, which proved to her that “anybody” regarded the illegitimate children as more rightfully to be looked shy on and deprived of social advantages than illegitimate fathers."
                                            },
                                            {
                                                "example_id": "9a4ac5c2-8c93-4d1b-9354-e7805c8af3e1",
                                                "sense_id": "da55b69b-3d37-3133-be81-14f19c6df5aa",
                                                "text": "I heard last night that a what-do-you-call it?—claimant?—has arrived who says Pat Wayne is his illegitimate father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71fbce76-4a32-38ee-a652-600324b703a4",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Not correctly deduced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65eabada-802d-420c-8660-3239054308a5",
                                                "sense_id": "71fbce76-4a32-38ee-a652-600324b703a4",
                                                "text": "an illegitimate inference"
                                            },
                                            {
                                                "example_id": "cab2a092-4e15-48e4-a240-9b6c9ca2a932",
                                                "sense_id": "71fbce76-4a32-38ee-a652-600324b703a4",
                                                "text": "[…] in natural things we must have recourse […] to experience. And all reasoning that is not supported so, ought to be repudiated, or at least suspected to be illegitimate."
                                            },
                                            {
                                                "example_id": "1bb877ea-6891-407b-93ea-79e3438db653",
                                                "sense_id": "71fbce76-4a32-38ee-a652-600324b703a4",
                                                "text": "[…] it is illegitimate to reduce an Equation, by subducting from one Side a Quantity when it is not to be destroyed, or when an equal Quantity is not subducted from the other Side of the Equation:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "178f11bc-f275-396d-94fa-9eda60716f8d",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Not authorized by good usage; not genuine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc6fd96-e7a1-4880-96a9-7718bbce0810",
                                                "sense_id": "178f11bc-f275-396d-94fa-9eda60716f8d",
                                                "text": "an illegitimate word"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b704df-065d-3646-a623-5f15cf9a266f",
                                        "entry_id": "56efd416-d79f-383d-b715-214c436d6f72",
                                        "glosses": [
                                            "Involving the fertilization of pistils by stamens not of their own length, in heterogonously dimorphic and trimorphic flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e8db4a1-baf4-4660-a3c9-12712f00294c",
                                                "sense_id": "35b704df-065d-3646-a623-5f15cf9a266f",
                                                "text": "illegitimate union; illegitimate fertilization"
                                            },
                                            {
                                                "example_id": "01a5002a-8470-4ce4-b4b3-e15346b7767c",
                                                "sense_id": "35b704df-065d-3646-a623-5f15cf9a266f",
                                                "text": "[…] the legitimate unions between the two forms of the above nine species of Primula are much more fertile than the illegitimate unions; although in the latter case pollen was always taken from a distinct plant of the same form."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "illegitimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a77879a-ae77-35e4-9aec-04861d605c77",
                                        "entry_id": "320b7179-a5f7-31a2-8d1f-58437ffaba9b",
                                        "glosses": [
                                            "A person born to unmarried parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e279bda8-860e-43fd-8a83-bc8e05c8d44c",
                                                "sense_id": "4a77879a-ae77-35e4-9aec-04861d605c77",
                                                "text": "Her father and mine was a shameless man and of all his illegitimates I am the most unfortunate and poverty stricken."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "illegitimate",
                                "target_lang_code": "en",
