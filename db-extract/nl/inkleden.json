                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d612bab4-066a-36d5-bf42-b6de3511dd62",
                                        "entry_id": "6dd3f008-2cc9-36ee-9ef4-7befb597b484",
                                        "glosses": [
                                            "To put into a clear and definite form of statement or expression."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "233eb03f-59be-4f30-8c37-5be866054479",
                                                "sense_id": "d612bab4-066a-36d5-bf42-b6de3511dd62",
                                                "text": "He failed to formulate his ideas more clearly."
                                            },
                                            {
                                                "example_id": "3b47bf47-a699-4f18-84f4-bb4149713d0b",
                                                "sense_id": "d612bab4-066a-36d5-bf42-b6de3511dd62",
                                                "text": "The Assembly then formulated its demands, which were thirty in number, including the removal of all Huguenot temples built near churches"
                                            },
                                            {
                                                "example_id": "0a8f96f3-fb06-465a-a10e-f84f22e59f67",
                                                "sense_id": "d612bab4-066a-36d5-bf42-b6de3511dd62",
                                                "text": "Another source of evidence supporting the conclusion that children learn language by formulating a set of rules comes from the errors that they produce. A case in point are overgeneralized past tense forms like comed, goed, seed, buyed, bringed, etc. frequently used by young children."
                                            },
                                            {
                                                "example_id": "9033a442-c475-4236-a882-073e02af66ea",
                                                "sense_id": "d612bab4-066a-36d5-bf42-b6de3511dd62",
                                                "text": "Look closely at the pretty seashell print on these blouses. They’re actually formulated from mathematical equations!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
