                        "examples": [
                            {
                                "example_id": "a4964bef-c253-4157-8bd4-51bf996a4146",
                                "sense_id": "b2d8f3e6-f329-39e7-a406-358d3a1428fe",
                                "text": "After WW2, various institutions of higher education were monotonously integrated into homogeneous universities.",
                                "translation": "第二次大戦後に、多種類の高等教育機関が、一律に統合されて同質の大学になった。"
                            },
                            {
                                "example_id": "544fedfd-fcd4-4d75-94f6-dc79c0d0c5f1",
                                "sense_id": "b2d8f3e6-f329-39e7-a406-358d3a1428fe",
                                "text": "Units of the metric system are monotonously based on decimal system, so if the number is indivisible by three, it will remain to be so in any conversion.",
                                "translation": "メートル法の単位は、機械的に十倍を繰り返し、三で割り切れないようにしてある。"
                            }
                        ]
