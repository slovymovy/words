                        "glosses": [
                            "Nematoda Rudolphi, pasożyt o wydłużonym, obłym ciele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0df9ec-0bea-4d4d-9701-198e5d0cd404",
                                "sense_id": "5028e05e-29bc-3df4-bd73-9ab8ba7da8e2",
                                "text": "Na kilka godzin przed ukazaniem się nicienia pod skórą występują zawroty głowy, silne duszności, napady przypominające astmę, niekiedy wymioty i biegunka, a zawsze dokuczliwe swędzenie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
