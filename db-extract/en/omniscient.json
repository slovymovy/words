                        "target_lang_word": "alwetend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alwetend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "413feba4-cc50-3c72-a2ad-6e372d5a9f2d",
                                        "entry_id": "83867c59-950f-3ad7-87f0-98c454eff12e",
                                        "glosses": [
                                            "dat iemand of iets alles weet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f12382-b9df-4a7f-8cbb-7de4dc15007d",
                                                "sense_id": "413feba4-cc50-3c72-a2ad-6e372d5a9f2d",
                                                "text": "Alleen god is alwetend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                                        "entry_id": "83867c59-950f-3ad7-87f0-98c454eff12e",
                                        "glosses": [
                                            "van mensen die wel heel erg veel weten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6947aa84-a31d-4633-b428-18bbe7fd8bbc",
                                                "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                                                "text": "Voor het alwetend oog van moeder blijft niets verborgen."
                                            },
                                            {
                                                "example_id": "2ee18083-26ff-47e7-8b3c-178ebdbfe508",
                                                "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                                                "text": "In veel proza komt een alwetende verteller voor."
                                            },
                                            {
                                                "example_id": "dab26556-c4e1-4971-866c-163e3f68ab6a",
                                                "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                                                "text": "In zijn ogen stond nu de alwetende blik van een wereldreiziger te lezen die al wat noemenswaardig was minstens twee keer had beleefd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16176608-2171-4dc0-82b8-95f0f4f456cd",
                        "source_entry_id": "e498161d-7791-30a6-b4f1-732cb4a4d38f",
                        "source_sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                        "source_sense_description": "having total knowledge",
                        "target_lang_word": "omniscient",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omniscient",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bebadc8-6c71-362d-940a-fb6fcebb7b51",
                                        "entry_id": "d56d91bf-ca47-33ca-bc61-7002c473f88e",
                                        "glosses": [
                                            "Qui sait tout, ou paraît tout savoir."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b83982-6a41-44b4-9045-4812838d76a3",
                                                "sense_id": "0bebadc8-6c71-362d-940a-fb6fcebb7b51",
                                                "text": "– Nous avons, par sincérité, par faiblesse, renoncé à tenir devant nos enfants le rôle de parents omniscients, omnipotents et quasi divins ! Voilà le résultat !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0065d42d-63d7-386e-9373-c77e8a8b9021",
                                        "entry_id": "d56d91bf-ca47-33ca-bc61-7002c473f88e",
                                        "glosses": [
                                            "(En parlant d'un narrateur) Qui sait toutes les pensées, les événements et chaque chose en rapport avec le récit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0fbd548-9836-4634-9991-5a329509cc4b",
                        "source_entry_id": "e498161d-7791-30a6-b4f1-732cb4a4d38f",
                        "source_sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
