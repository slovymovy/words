                    "frequency": "High",
                    "semantic_group_id": "dietary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>lite</w> dinner consisted of crackers, some broccoli and a salad with <w>lite</w> ranch dressing.",
                            "target_lang_translations": {
