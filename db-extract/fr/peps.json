                                "target_senses": [
                                    {
                                        "sense_id": "badce13e-fd92-3edb-a471-513fd40e825c",
                                        "entry_id": "e56abec6-740f-3a40-986c-d933aef8cde2",
                                        "glosses": [
                                            "Strength, power, passion or effectiveness; clout."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae3db08-5e67-4e15-9920-9dd8210badb4",
                                                "sense_id": "badce13e-fd92-3edb-a471-513fd40e825c",
                                                "text": "Use a mild cleanser, but pick something with enough oomph to do the job."
                                            },
                                            {
                                                "example_id": "867db7e8-bfd2-4cba-99d1-63ea5a9cddc0",
                                                "sense_id": "badce13e-fd92-3edb-a471-513fd40e825c",
                                                "text": "\"Yes, well they're finding it difficult, sir. They are afflicted with a certain lassitude. They're just finding it hard to get behind the job. They lack oomph.\""
                                            },
                                            {
                                                "example_id": "37710b06-a72d-4e6e-96a6-274db4e65d9f",
                                                "sense_id": "badce13e-fd92-3edb-a471-513fd40e825c",
                                                "text": "Adding layers of texture to a cookie by folding in ground-down bits of goodness is one of our favorite ways to pack a big punch, but you need to choose your fighter wisely. If you pick something too smooth, your cookie won't gain any oomph, and if you choose something too flavorful, your cookie may end up overwhelming (sorry, Flamin' Hot Cheetos)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d0bc47a-d9e3-35ad-98d2-2c795525831f",
                                        "entry_id": "e56abec6-740f-3a40-986c-d933aef8cde2",
                                        "glosses": [
                                            "Sex appeal."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f31960d-ee54-46a8-b826-f5969f200db6",
                                                "sense_id": "7d0bc47a-d9e3-35ad-98d2-2c795525831f",
                                                "text": "'Come to think of it, the girl looked a bit like Ann,' Jerry reflected. 'Foxy, know what I mean? Garbo eyes, lots of oomph.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b5ed4ff-c36d-3d50-863c-eee35e382db3",
