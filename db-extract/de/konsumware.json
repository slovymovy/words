                "senses": [
                    {
                        "sense_id": "dfd555ee-1dce-3a7a-beca-1440bba8b0dc",
                        "entry_id": "e5520fb7-32c1-37e6-98bc-507e4df8fe49",
                        "glosses": [
                            "Gut, welches für den privaten Verbrauch und Gebrauch, den Konsum hergestellt und gehandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d590f091-494c-4d4b-ae8b-97e9421a6119",
                                "sense_id": "dfd555ee-1dce-3a7a-beca-1440bba8b0dc",
                                "text": "„Erst seit der industriellen Revolution ist Alkohol zur Massen- und Konsumware degeneriert, werden Milliarden an Gewinnen mit dem Stoff erzielt.“"
                            },
                            {
                                "example_id": "0fcf0ed7-8e02-413e-893f-cfb98fc0c0d1",
                                "sense_id": "dfd555ee-1dce-3a7a-beca-1440bba8b0dc",
                                "text": "„In diesem Jahrhundert werden die meisten Dinge durch den spezifischen Charakter als industrielle Konsumware bestimmt.“"
                            },
                            {
                                "example_id": "4216dda0-48fd-4ef4-9795-726ac3107135",
                                "sense_id": "dfd555ee-1dce-3a7a-beca-1440bba8b0dc",
                                "text": "„In einer spätkapitalistischen Gesellschaft, in der die Individuenauf maximalen Konsum konditioniert werden, wird das Bedürfnis nach Aufmerksamkeit als Konsumware nun repressiv verstärkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
