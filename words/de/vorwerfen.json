                    "frequency": "Low",
                    "semantic_group_id": "werfen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Weitsprung muss der Sportler bei der Landung die Beine kraftvoll <w>vorwerfen</w>."
                        },
                        {
                            "text": "Als er unerwartet stolperte, <w>warf</w> er blitzschnell beide Hände zum Schutz <w>vor</w>."
