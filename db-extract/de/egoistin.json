                                                "sense_id": "d1f39ce4-176b-3282-bac6-4980715a3e89",
                                                "text": "è proprio un egoista ostinato!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9555882a-cee2-382d-80f9-dd8072eff2c1",
                                        "entry_id": "55b6243d-638b-3236-af94-337a53eec020",
