                "senses": [
                    {
                        "sense_id": "ebccea27-cf64-305b-9a5e-927a1e6bf5cd",
                        "entry_id": "4fccd537-d6b6-35f4-9b0e-1f7095beb3a7",
                        "glosses": [
                            "Luftströmung, die für Druckausgleich und Zirkulation sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bef9f1a-de44-431e-a77d-89a3c5faf73b",
                                "sense_id": "ebccea27-cf64-305b-9a5e-927a1e6bf5cd",
                                "text": "„Einen manuellen Lüftungsausgleich führt man beim Tanken selbst durch.“"
                            },
                            {
                                "example_id": "9d29ce8f-7ffb-45df-b0bc-16b3f440299c",
                                "sense_id": "ebccea27-cf64-305b-9a5e-927a1e6bf5cd",
                                "text": "„Durch die Fugen zwischen Rahmen und Flügel konnte auch bei geschlossenem Fenster kontinuierlich ein Lüftungsausgleich erfolgen.“"
                            },
                            {
                                "example_id": "443c2382-5acc-41d1-9c60-3ca4d47f92f6",
                                "sense_id": "ebccea27-cf64-305b-9a5e-927a1e6bf5cd",
                                "text": "„So entsteht zwischen der Raumluft und dem Rand des alten Dielenbodens (von dem die alte Sockelleiste entfernt wurde und somit wieder ein Spalt zur Wand vorhanden ist) ein Lüftungsausgleich.“"
                            },
                            {
                                "example_id": "07c485f8-1207-4cf7-bc9e-4bcc422a05d2",
                                "sense_id": "ebccea27-cf64-305b-9a5e-927a1e6bf5cd",
                                "text": "„Mit der Verringerung des unkontrollierten Lüftungsaustauschs, beispielsweise durch dichtschliessende Fenster und keinem ausreichenden Lüftungsausgleich, können sich Schimmelpilzkulturen auch an anderen Bauteilen ansiedeln, die bisher nicht betroffen waren.“"
                            },
                            {
                                "example_id": "cb307fd8-6c9a-43e9-8bfa-623cb105b16c",
                                "sense_id": "ebccea27-cf64-305b-9a5e-927a1e6bf5cd",
                                "text": "„Durch die Fugen zwischen Rahmen und Flügel konnte auch bei geschlossenem Fenster kontinuierlich ein Lüftungsausgleich erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
