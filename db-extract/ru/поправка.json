                    },
                    {
                        "translation_id": "89562523-8204-4d70-99ff-770f9a321d8f",
                        "source_entry_id": "b88b6229-f45e-3508-bca6-1ec1a38b810c",
                        "source_sense_description": "действие по значению гл. поправить, поправлять",
                        "target_lang_word": "Korrektur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korrektur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b121b09f-ce7f-3509-8ec5-467f227f3796",
                                        "entry_id": "68d4f714-b6ad-3762-b574-7eca73eb49ec",
                                        "glosses": [
                                            "orthografische und grammatikalische Berichtigung eines Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0d8b75-47d9-48b0-8c58-c30861aa642c",
                                                "sense_id": "b121b09f-ce7f-3509-8ec5-467f227f3796",
                                                "text": "Die Korrekturen musst du nochmals machen; sie sind nicht sorgfältig genug durchgeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9305b2ef-c66a-3260-bce0-05ef3410a357",
                                        "entry_id": "68d4f714-b6ad-3762-b574-7eca73eb49ec",
                                        "glosses": [
                                            "Gesamtheit der Berichtigungen oder Verbesserungen bei Texten oder Druckwerken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8573066-1d86-46ff-97d5-ae01d71b4043",
                                                "sense_id": "9305b2ef-c66a-3260-bce0-05ef3410a357",
                                                "text": "Die Korrektur des Manuskripts dauert noch ein paar Tage."
                                            },
                                            {
                                                "example_id": "010272f0-a1c5-4bba-959e-cfc218bd66fc",
                                                "sense_id": "9305b2ef-c66a-3260-bce0-05ef3410a357",
                                                "text": "„Handschriftliche Korrekturen konnten vielleicht einen wichtigen Hinweis geben auf die Identität des Verfassers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1403420d-36ae-39f0-8a45-3f80902a5d89",
                                        "entry_id": "68d4f714-b6ad-3762-b574-7eca73eb49ec",
                                        "glosses": [
                                            "Bewertung einer schriftlichen Prüfung, zum Beispiel durch einen Lehrer"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78c790c3-76a6-4184-b977-21c07d7cbcf6",
                                                "sense_id": "1403420d-36ae-39f0-8a45-3f80902a5d89",
                                                "text": "„Eine derartige Betrachtungsweise bedarf dringend der Korrektur und die Frage, wem Segelfliegen was bedeutet, der Klärung.“"
                                            },
                                            {
                                                "example_id": "d80ff8af-523f-4763-8aa7-61a1e345770a",
                                                "sense_id": "1403420d-36ae-39f0-8a45-3f80902a5d89",
                                                "text": "Die Korrekturen machen einem Lehrer viel Arbeit."
                                            },
                                            {
                                                "example_id": "1d85d658-ef8e-40b8-9e30-b93b2aa0f483",
                                                "sense_id": "1403420d-36ae-39f0-8a45-3f80902a5d89",
                                                "text": "„Der Stiefbruder beendete mit Worten der Erleichterung seine Korrekturen und beobachtete mit der Schwägerin, was Rotermund aus der Tüte alles zum Vorschein brachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8217512a-0f23-3a50-9c8a-e49643ba68e6",
                                        "entry_id": "68d4f714-b6ad-3762-b574-7eca73eb49ec",
                                        "glosses": [
                                            "das Retuschieren von Bildern"
                                        ],
                                        "tags": [
                                            "Bildbearbeitung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88dbfb94-81ba-411e-bed7-ea5705d48470",
                                                "sense_id": "8217512a-0f23-3a50-9c8a-e49643ba68e6",
                                                "text": "Es waren nur wenig Korrekturen nötig, um die Leberflecke unsichtbar zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fc05e4e3-98d5-3f94-946a-8383f7593efa",
                                        "entry_id": "68d4f714-b6ad-3762-b574-7eca73eb49ec",
                                        "glosses": [
