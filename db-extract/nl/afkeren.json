                        ],
                        "examples": [
                            {
                                "example_id": "37de00ee-71d1-4a9f-96a3-411bfdb68a05",
                                "sense_id": "e8bacf12-2f4e-353a-8685-dcd804ac1b42",
                                "text": "Hij keerde zich af van het vreselijke tafereel.",
                                "translation": "He turned away from the terrible scene.",
                                "english": "He turned away from the terrible scene."
                            },
                            {
                                "example_id": "d4e24965-f1d7-40f5-a6a0-841588c72533",
                                "sense_id": "e8bacf12-2f4e-353a-8685-dcd804ac1b42",
                                "text": "De sekteleden hebben zich afgekeerd van de maatschappij.",
                                "translation": "The cult members have turned away from society.",
                                "english": "The cult members have turned away from society."
                            }
                        ]
                    }
