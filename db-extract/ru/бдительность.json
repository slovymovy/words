                    },
                    {
                        "translation_id": "c36eb770-3561-4324-9eb7-7d9b93ea2704",
                        "source_entry_id": "e2afef12-f80f-3e8b-9cc9-c71b20e5e6d3",
                        "source_sense_id": "051f02e5-fd5f-3c70-aca0-b009f876bb96",
                        "target_lang_word": "Wachsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wachsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                        "entry_id": "50794a6d-8723-339c-98c7-5c020b882447",
                                        "glosses": [
                                            "Einstellung/Verhalten, Geschehnisse aufmerksam zu verfolgen, wachsam zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ef812e-f49e-4b4c-98ff-60b0ca92920a",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "„In der Nacht, als wir uns vor Kap Trafalgar befanden, kam der Kapitän während der Mittelwache an Deck, rief das Vordeck an und befahl größte Wachsamkeit, da wir durch Lord Collingwoods Flotte segeln mussten.“"
                                            },
                                            {
                                                "example_id": "98eac034-8ad7-4756-9e3d-ed0ae8e817b5",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "[COVID-19-Pandemie:] „Nach weiteren Corona-Fällen gilt fortan ‚erhöhte Wachsamkeit‘ im Main-Kinzig-Kreis in Nachbarschaft Frankfurts.“"
                                            },
                                            {
                                                "example_id": "c92fca6a-44c5-4db3-a463-cafbada718f8",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "„Weil der Löwe der ägyptischen Mythologie zufolge die Augen immer offen hat, ist er die Verkörperung der Wachsamkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be9eda29-6abc-4395-a6e4-0f14003ea49f",
                        "source_entry_id": "e2afef12-f80f-3e8b-9cc9-c71b20e5e6d3",
                        "source_sense_id": "051f02e5-fd5f-3c70-aca0-b009f876bb96",
                        "target_lang_word": "vigilance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigilance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c818c22-5387-3285-9a78-c8de32426fa3",
                                        "entry_id": "027b63b1-2424-31b2-baf0-93cd9bfa2e66",
                                        "glosses": [
                                            "Attention que l’on porte avec diligence, avec activité, sur quelque chose ou sur quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52687b52-e1b5-4015-967c-e5fe082c78de",
                                                "sense_id": "4c818c22-5387-3285-9a78-c8de32426fa3",
                                                "text": "Manquer de vigilance. Se reposer sur la vigilance d’autrui. Tromper la vigilance de quelqu’un."
                                            },
                                            {
                                                "example_id": "41909720-18c7-45f8-9cc3-ea053976ca89",
                                                "sense_id": "4c818c22-5387-3285-9a78-c8de32426fa3",
                                                "text": "C’est cette vigilance qui va permettre d’être réactif face à l’imprévu, ne serait-ce que par le gain de temps de ne pas avoir à collecter des informations sur ce qui est en train de se passer."
                                            },
                                            {
                                                "example_id": "71ab2946-5e07-4846-b624-07255a2e2936",
                                                "sense_id": "4c818c22-5387-3285-9a78-c8de32426fa3",
                                                "text": "Les vigilances des risques sanitaires sont des dispositifs réglementaires visant le repérage d’événements indésirables ou de dysfonctionnements du système de santé."
                                            },
                                            {
                                                "example_id": "e7243a56-0281-49cd-85ef-ecda8989de83",
                                                "sense_id": "4c818c22-5387-3285-9a78-c8de32426fa3",
                                                "text": "Plus encore, par son style et sa défense du langage, le satiriste nous met en garde contre un phénomène qui requiert toute notre vigilance : « le fait que les soumissions et les conformismes ordinaires des situations ordinaires annoncent les soumissions extraordinaires des situations extraordinaires » (Bourdieu)."
                                            },
                                            {
                                                "example_id": "1d0e8ab3-cced-4e77-8e7b-d3542b72a18b",
                                                "sense_id": "4c818c22-5387-3285-9a78-c8de32426fa3",
                                                "text": "Un somnifère, destiné à améliorer le sommeil, peut par exemple affaiblir la vigilance et les aptitudes motrices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7194b68e-c5e1-3428-a53b-d2ef9b57578d",
                                        "entry_id": "027b63b1-2424-31b2-baf0-93cd9bfa2e66",
                                        "glosses": [
                                            "Nom donné à la pierre sphérique que tient dans sa patte la grue dans sa représentation ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc874d42-b9a7-4a1a-9d65-0d1f5de59854",
                                                "sense_id": "7194b68e-c5e1-3428-a53b-d2ef9b57578d",
                                                "text": "D’or à trois grues de sable tenant chacune dans sa griffe une vigilance de gueules. → voir illustration « grues avec vigilance »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da0d9d95-bdec-49d3-a50d-9fa70cf78002",
                        "source_entry_id": "e2afef12-f80f-3e8b-9cc9-c71b20e5e6d3",
                        "source_sense_id": "051f02e5-fd5f-3c70-aca0-b009f876bb96",
