                        "glosses": [
                            "Boulette de viande hachée et assaisonnée."
                        ],
                        "tags": [
                            "Wallonie",
                            "Ardennes"
                        ],
                        "examples": [
                            {
                                "example_id": "d02e8960-88a6-43e0-9b55-d628db12ac5f",
                                "sense_id": "0435ee59-0072-3ccc-a4c6-12f09437abfc",
                                "text": "Les gens ne voulaient pas entendre parler de poissons. Il ne leur fallait que du bœuf, des carbonades et des vitolets."
                            },
                            {
                                "example_id": "635e81a6-a91f-46cf-a3cb-8cb65b46ed99",
                                "sense_id": "0435ee59-0072-3ccc-a4c6-12f09437abfc",
                                "text": "Nous ne saurions trop vous conseiller de participer au repas organisé le soir par le restaurant Robinson. Elle sera en quelque sorte un hommage à notre regretté ami charcutier de Haybes, Maurice Roffidal, qui avait perpétué la tradition des vitolets. Ce sera d’ailleurs sa recette que l’on pourra déguster."
                            }
                        ]
                    }
