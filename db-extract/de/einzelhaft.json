                "senses": [
                    {
                        "sense_id": "a8d024a3-f19b-357b-a901-ec8a16af6d27",
                        "entry_id": "be2bc069-f6e2-3909-8d21-c9e4eff2e0bf",
                        "glosses": [
                            "Gefängnisaufenthalt in einer Einzelzelle, ohne Mitgefangene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fe802e-08d3-4e7d-8645-49dbf79187ad",
                                "sense_id": "a8d024a3-f19b-357b-a901-ec8a16af6d27",
                                "text": "Für den äußerst gewalttätigen Häftling wurde Einzelhaft angeordnet."
                            },
                            {
                                "example_id": "ee63ef67-4123-4fb1-bef1-7da383b6f415",
                                "sense_id": "a8d024a3-f19b-357b-a901-ec8a16af6d27",
                                "text": "„Sie sollten in Einzelhaft und bei karger Kost bis zu den Junisitzungen weiter darüber nachdenken.“"
                            },
                            {
                                "example_id": "9e4953fb-87fb-4ffc-95b8-ae08f71c7939",
                                "sense_id": "a8d024a3-f19b-357b-a901-ec8a16af6d27",
                                "text": "„Sie geben die Meldung zu, ich verfüge Einzelhaft bis auf weiteres, drei Tage Bettentzug, Hofentzug, Schreibverbot und die üblichen Nebenstrafen.“"
                            },
                            {
                                "example_id": "54f21974-326c-4b27-b236-0278ab31216a",
                                "sense_id": "a8d024a3-f19b-357b-a901-ec8a16af6d27",
                                "text": "„Die Gefangenen werden in Einzelhaft, Zellenhaft und Gemeinschaftshaft untergebracht.“"
                            },
                            {
                                "example_id": "6945a06b-c7ca-4fcc-b35b-f94cd0168937",
                                "sense_id": "a8d024a3-f19b-357b-a901-ec8a16af6d27",
                                "text": "„Wir wurden zurück auf die Insel geschickt und kamen erneut in Einzelhaft, diesmal allerdings zwanzig Tage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
