                "senses": [
                    {
                        "sense_id": "81739ff9-7588-3bac-9623-09ae8f5a7e53",
                        "entry_id": "497e5599-bef6-35ca-9723-8c78cb7dadd6",
                        "glosses": [
                            "Wissenschaft der Geschichte des Rechts"
                        ],
                        "tags": [
