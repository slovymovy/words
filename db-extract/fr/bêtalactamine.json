                    {
                        "sense_id": "4401505c-462b-349e-9090-6830301f3904",
                        "entry_id": "e0349f4b-b2d4-3e6c-9d26-a2fb1a0a6925",
                        "glosses": [
                            "Classe d’antibiotiques contenant un noyau bêta-lactame (β-lactame) dans sa structure moléculaire, comme les dérivés de la pénicilline, les céphalosporines, les monobactames, les carbapénèmes et les inhibiteurs de la bêtalactamase."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "facbcd94-9619-43f3-b6c5-32a22a60ea42",
                                "sense_id": "4401505c-462b-349e-9090-6830301f3904",
                                "text": "Les infections à Pseudomonas sont traitées par voie intraveineuse par une association bêtalactamine aminoside. Le choix de la bêtalactamine dépend des phénotype de résistance et de la gravité de la maladie."
                            }
                        ]
                    }
