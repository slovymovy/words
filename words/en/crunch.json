{
    "word_family": [
        "crunchy",
        "crunchiness",
        "cruncher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7989dfbd-ad12-3155-a313-2c2ce9daf7e4",
                    "sense_definition": "A loud, crackling noise made when something hard is crushed, broken, or walked upon.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sound_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard the loud <w>crunch</w> of dry leaves under my boots.",
                            "target_lang_translations": {
                                "ru": "Я услышал громкий <w>хруст</w> сухих листьев под своими сапогами.",
                                "zh": "我听见靴子下干树叶发出的<w>嘎吱声</w>。"
                            }
                        },
                        {
                            "text": "The car hit the wall with a sickening <w>crunch</w>.",
                            "target_lang_translations": {
                                "ru": "Машина врезалась в стену с тошнотворным <w>скрежетом</w>.",
                                "zh": "汽车撞上墙壁时发出了一声令人毛骨悚然的<w>碎裂声</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "loud crunch",
                        "sickening crunch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий трескучий звук, возникающий, когда что-то твердое раздавливают, ломают или наступают на него.",
                        "zh": "指坚硬物体被压碎、折断或踩踏时发出的响亮、碎裂的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хруст",
                                "target_lang_sense_clarification": "звук"
                            },
                            {
                                "target_lang_word": "скрежет",
                                "target_lang_sense_clarification": "звук трения или разрушения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘎吱声",
                                "target_lang_sense_clarification": "物体受压发出的声音"
                            },
                            {
                                "target_lang_word": "碎裂声",
                                "target_lang_sense_clarification": "物体破碎的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "224f3a1f-83e8-361e-9742-ae98688be67e",
                    "sense_definition": "A physical exercise designed to strengthen the abdominal muscles, similar to a sit-up but without lifting the lower back.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She does fifty <w>crunches</w> every morning to stay in shape.",
                            "target_lang_translations": {
                                "ru": "Она делает пятьдесят <w>скручиваний</w> каждое утро, чтобы оставаться в форме.",
                                "zh": "她每天早上做五十个<w>卷腹</w>来保持身材。"
                            }
                        },
                        {
                            "text": "My trainer told me to focus on my breathing while doing <w>crunches</w>.",
                            "target_lang_translations": {
                                "ru": "Мой тренер сказал мне следить за дыханием во время выполнения <w>скручиваний</w>.",
                                "zh": "教练告诉我做<w>卷腹</w>时要专注于呼吸。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do crunches",
                        "abdominal crunches"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое упражнение для укрепления мышц брюшного пресса, похожее на подъемы туловища, но без отрыва поясницы.",
                        "zh": "一种旨在增强腹部肌肉的体育锻炼，类似于仰卧起坐，但下背部不离开地面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скручивание",
                                "target_lang_sense_clarification": "упражнение"
                            },
                            {
                                "target_lang_word": "кранч",
                                "target_lang_sense_clarification": "сленг, фитнес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卷腹",
                                "target_lang_sense_clarification": "健身运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e378e6-ebe8-3a38-8c8a-0060c2581d4e",
                    "sense_definition": "A difficult situation caused by a lack of money, supplies, or time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "crisis_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recent credit <w>crunch</w> has made it difficult for small businesses to get loans.",
                            "target_lang_translations": {
                                "ru": "Недавний кредитный <w>кризис</w> затруднил получение займов для малого бизнеса.",
                                "zh": "近期的信贷<w>危机</w>使得小企业很难获得贷款。"
                            }
                        },
                        {
                            "text": "We are facing a severe housing <w>crunch</w> in the city center.",
                            "target_lang_translations": {
                                "ru": "Мы столкнулись с острой <w>нехваткой</w> жилья в центре города.",
                                "zh": "我们正面临市中心住房严重<w>短缺</w>的问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "credit crunch",
                        "budget crunch",
                        "energy crunch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная ситуация, вызванная нехваткой денег, ресурсов или времени.",
                        "zh": "因缺乏资金、物资或时间而导致的困难局面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кризис",
                                "target_lang_sense_clarification": "финансовый"
                            },
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "дефицит ресурсов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "危机",
                                "target_lang_sense_clarification": "金融或资源匮乏"
                            },
                            {
                                "target_lang_word": "短缺",
                                "target_lang_sense_clarification": "资源不足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5766c95f-e35f-34ec-ba1c-43de12c5fdd7",
                    "sense_definition": "A critical moment or event when a decision must be made or action taken.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "crisis_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When it comes to the <w>crunch</w>, he always supports his friends.",
                            "target_lang_translations": {
                                "ru": "Когда наступает <w>решающий момент</w>, он всегда поддерживает своих друзей.",
                                "zh": "到了<w>关键时刻</w>，他总是支持他的朋友。"
                            }
                        },
                        {
                            "text": "The team played well, but they failed when the <w>crunch</w> came in the final minutes.",
                            "target_lang_translations": {
                                "ru": "Команда играла хорошо, но они потерпели неудачу, когда в последние минуты наступил <w>переломный момент</w>.",
                                "zh": "球队表现不错，但在最后几分钟的<w>紧要关头</w>还是失败了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "comes to the crunch",
                        "crunch time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решающий момент или событие, когда необходимо принять важное решение.",
                        "zh": "必须做出决定或采取行动的关键时刻或事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решающий момент",
                                "target_lang_sense_clarification": "ситуация"
                            },
                            {
                                "target_lang_word": "переломный момент",
                                "target_lang_sense_clarification": "ситуация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关键时刻",
                                "target_lang_sense_clarification": "决定性时刻"
                            },
                            {
                                "target_lang_word": "紧要关头",
                                "target_lang_sense_clarification": "紧急或重要时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22bdc529-6827-31f7-b514-241084f8e237",
                    "sense_definition": "A period of intense overtime work required to finish a project before a deadline.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developers are in <w>crunch</w> mode to get the game ready for release.",
                            "target_lang_translations": {
                                "ru": "Разработчики работают в режиме <w>кранча</w>, чтобы подготовить игру к выпуску.",
                                "zh": "开发人员正在进行<w>突击工作</w>，以便让游戏如期发布。"
                            }
                        },
                        {
                            "text": "Management promised to avoid <w>crunch</w> by planning the schedule better.",
                            "target_lang_translations": {
                                "ru": "Руководство пообещало избежать <w>авралов</w> за счет лучшего планирования графика.",
                                "zh": "管理层承诺通过更好的日程规划来避免<w>赶工期</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crunch time",
                        "crunch mode"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in software development or business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период интенсивной сверхурочной работы, необходимой для завершения проекта к сроку.",
                        "zh": "为在截止日期前完成项目而进行的紧张加班时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аврал",
                                "target_lang_sense_clarification": "работа"
                            },
                            {
                                "target_lang_word": "кранч",
                                "target_lang_sense_clarification": "сленг разработчиков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突击工作",
                                "target_lang_sense_clarification": "高强度加班"
                            },
                            {
                                "target_lang_word": "赶工期",
                                "target_lang_sense_clarification": "项目冲刺阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef05294e-c37e-3f45-a978-beab6cac89dc",
                    "sense_definition": "A dessert consisting of cooked fruit covered with a rough, crumbly mixture.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dessert, we served a warm apple <w>crunch</w> with vanilla ice cream.",
                            "target_lang_translations": {
                                "ru": "На десерт мы подали теплый яблочный <w>кранч</w> с ванильным мороженым.",
                                "zh": "作为甜点，我们供应了温热的香草冰淇淋配<w>酥粒苹果派</w>。"
                            }
                        },
                        {
                            "text": "She baked a delicious peach <w>crunch</w> for the picnic.",
                            "target_lang_translations": {
                                "ru": "Она испекла вкусный персиковый <w>десерт с хрустящей крошкой</w> для пикника.",
                                "zh": "她为野餐烤了一个美味的<w>酥粒桃子派</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crisp",
                        "crumble"
                    ],
                    "common_phrases": [
                        "apple crunch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Десерт, состоящий из запеченных фруктов, покрытых хрустящей крошкой.",
                        "zh": "一种由煮熟的水果和粗糙、酥脆的混合物覆盖而成的甜点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кранч",
                                "target_lang_sense_clarification": "десерт"
                            },
                            {
                                "target_lang_word": "десерт с крошкой",
                                "target_lang_sense_clarification": "кулинария"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酥粒水果派",
                                "target_lang_sense_clarification": "甜点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac5e0ede-fe64-34aa-b23e-594fe07d6b4d",
                    "sense_definition": "The symbol #, often used in computing and telecommunications.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some programming languages, the <w>crunch</w> is used to start a comment.",
                            "target_lang_translations": {
                                "ru": "В некоторых языках программирования <w>решётка</w> используется для начала комментария.",
                                "zh": "在某些编程语言中，<w>井号</w>用于开始注释。"
                            }
                        },
                        {
                            "text": "Please press the <w>crunch</w> key after entering your account number.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, нажмите клавишу <w>решётка</w> после ввода номера вашего счета.",
                                "zh": "输入账号后，请按<w>井号</w>键。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hashtag",
                        "number sign",
                        "pound sign"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical or computing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ #, часто используемый в информатике и телекоммуникациях.",
                        "zh": "符号 #，常用于计算机和电信领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решётка",
                                "target_lang_sense_clarification": "символ"
                            },
                            {
                                "target_lang_word": "знак решётки",
                                "target_lang_sense_clarification": "символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "井号",
                                "target_lang_sense_clarification": "符号"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "455bfb7c-4131-3dcc-9846-981ce6470571",
                    "sense_definition": "To bite, chew, or crush something hard with a loud, crackling noise.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat on the sofa, <w>crunching</w> on a fresh apple.",
                            "target_lang_translations": {
                                "ru": "Она сидела на диване, <w>хрустя</w> свежим яблоком.",
                                "zh": "她坐在沙发上，<w>嘎吱嘎吱地嚼</w>着一个新鲜苹果。"
                            }
                        },
                        {
                            "text": "The dog happily <w>crunched</w> the bone we gave him.",
                            "target_lang_translations": {
                                "ru": "Собака с радостью <w>сгрызла</w> кость, которую мы ей дали.",
                                "zh": "那只狗开心地<w>咬碎</w>了我们给它的骨头。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crunch on",
                        "crunch ice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусать, жевать или раздавливать что-то твердое с громким треском.",
                        "zh": "用牙齿咬、咀嚼或压碎坚硬的东西，并发出响亮的碎裂声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрустеть",
                                "target_lang_sense_clarification": "есть с шумом"
                            },
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "разгрызать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘎吱嘎吱地嚼",
                                "target_lang_sense_clarification": "吃东西的声音"
                            },
                            {
                                "target_lang_word": "咬碎",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "396793c8-1bc8-306b-b571-939bf3f57301",
                    "sense_definition": "To make a loud, crackling noise when moving or being pressed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fresh snow <w>crunched</w> under our boots as we walked.",
                            "target_lang_translations": {
                                "ru": "Свежий снег <w>хрустел</w> у нас под сапогами, когда мы шли.",
                                "zh": "我们走过时，新鲜的积雪在靴子下<w>发出嘎吱声</w>。"
                            }
                        },
                        {
                            "text": "Gravel <w>crunched</w> beneath the tires as the car pulled into the driveway.",
                            "target_lang_translations": {
                                "ru": "Гравий <w>хрустел</w> под шинами, когда машина въезжала на подъездную дорожку.",
                                "zh": "汽车驶入车道时，轮胎下的碎石<w>发出嘎吱声</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crunch underfoot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий трескучий звук при движении или надавливании.",
                        "zh": "在移动或被挤压时发出响亮的碎裂声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрустеть",
                                "target_lang_sense_clarification": "издавать звук"
                            },
                            {
                                "target_lang_word": "скрипеть",
                                "target_lang_sense_clarification": "издавать звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发出嘎吱声",
                                "target_lang_sense_clarification": "声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6db38cf4-33ea-3c67-bb14-850c93fc822f",
                    "sense_definition": "To process large amounts of information or perform calculations.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer needs a few minutes to <w>crunch</w> the data.",
                            "target_lang_translations": {
                                "ru": "Компьютеру нужно несколько минут, чтобы <w>обработать</w> данные.",
                                "zh": "电脑需要几分钟来<w>处理</w>这些数据。"
                            }
                        },
                        {
                            "text": "We need to <w>crunch</w> the numbers before we can make a final decision.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>подсчитать</w> цифры, прежде чем мы сможем принять окончательное решение.",
                                "zh": "在做出最终决定前，我们需要<w>计算</w>一下数字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crunch numbers",
                        "crunch data"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать большие объемы информации или выполнять сложные вычисления.",
                        "zh": "处理大量信息或进行复杂计算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "данные"
                            },
                            {
                                "target_lang_word": "перемалывать",
                                "target_lang_sense_clarification": "разг. данные"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处理",
                                "target_lang_sense_clarification": "数据"
                            },
                            {
                                "target_lang_word": "计算",
                                "target_lang_sense_clarification": "数字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cacdc73-dc0f-3546-80a5-294d78a958c4",
                    "sense_definition": "To compress digital data into a smaller format.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This software can <w>crunch</w> large video files without losing much quality.",
