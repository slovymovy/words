    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                    "sense_definition": "Acting in a dishonest or deceptive way to achieve a goal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deceptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They played a <w>sneaky</w> trick on us to win the game.",
                            "target_lang_translations": {
                                "ru": "Они сыграли с нами в <w>подлую</w> шутку, чтобы выиграть игру."
                            }
                        },
                        {
                            "text": "I do not like his <w>sneaky</w> behavior when he thinks no one is watching.",
                            "target_lang_translations": {
                                "ru": "Мне не нравится его <w>скрытное</w> поведение, когда он думает, что за ним никто не наблюдает."
                            }
                        }
                    ],
                    "synonyms": [
                        "dodgy"
                    ],
                    "antonyms": [
                        "honest",
                        "straightforward",
                        "open"
                    ],
                    "common_phrases": [
                        "sneaky trick",
                        "sneaky behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий нечестным или обманным путем для достижения цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "бесчестный и низкий"
                            },
                            {
                                "target_lang_word": "хитрый",
                                "target_lang_sense_clarification": "скрывающий истинные намерения"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "действующий скрытно и злонамеренно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                    "sense_definition": "Moving or acting in a quiet, secretive way to avoid being noticed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stealthy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat was very <w>sneaky</w> as it crawled through the tall grass.",
                            "target_lang_translations": {
                                "ru": "Кот вел себя очень <w>скрытно</w>, когда пробирался сквозь высокую траву."
                            }
                        },
                        {
                            "text": "You have to be <w>sneaky</w> if you want to surprise him for his birthday.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно действовать <w>тайно</w>, если хочешь устроить ему сюрприз на день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "slippery",
                        "evasive"
                    ],
                    "antonyms": [
                        "obvious",
                        "conspicuous"
                    ],
                    "common_phrases": [
                        "sneaky look",
                        "sneaky peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий тихо и скрытно, чтобы остаться незамеченным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрытный",
                                "target_lang_sense_clarification": "действующий незаметно"
                            },
                            {
                                "target_lang_word": "тайный",
                                "target_lang_sense_clarification": "совершаемый в секрете"
                            },
                            {
                                "target_lang_word": "незаметный",
                                "target_lang_sense_clarification": "не привлекающий внимания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12832282-5676-3b1e-be5f-1a709b2dfc3b",
                    "sense_definition": "A small electronic device used for secret surveillance or spying.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surveillance_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intelligence agency used travellers to plant <w>sneakies</w> in the embassy.",
                            "target_lang_translations": {
                                "ru": "Разведка использовала путешественников, чтобы установить <w>жучки</w> в посольстве."
                            }
                        },
                        {
                            "text": "They found several <w>sneakies</w> hidden inside the office walls during the sweep.",
                            "target_lang_translations": {
                                "ru": "Во время проверки они обнаружили несколько <w>шпионских устройств</w>, спрятанных в стенах офиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plant sneakies"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "intelligence community jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое электронное устройство, используемое для скрытого наблюдения или шпионажа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жучок",
                                "target_lang_sense_clarification": "скрытое подслушивающее устройство"
                            },
                            {
                                "target_lang_word": "шпионская штучка",
                                "target_lang_sense_clarification": "сленг для устройств слежения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}