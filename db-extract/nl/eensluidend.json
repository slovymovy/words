                                        "examples": [
                                            {
                                                "example_id": "79b9444e-8cec-4bab-b11b-43ac770790b3",
                                                "sense_id": "2f0d0904-7c35-3c52-8cd7-651ef7ae7e54",
                                                "text": "Fraternal twins are boy-girl pairs as often as of the same sex, while identicals are necessarily of the same sex, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6b643f9-acb1-3e43-845c-3315ceb371ea",
                                        "entry_id": "ff18c8d6-11b9-3e99-98a5-fd1c2485c4c3",
                                        "glosses": [
                                            "A rhyme on the same syllable, such as \\\"leave\\\" and \\\"believe\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c3b969c-d1ff-4140-a88d-ef04b0e94469",
                                                "sense_id": "e6b643f9-acb1-3e43-845c-3315ceb371ea",
                                                "text": "The strictest construction of the rule requires complete and unvarying repetition of end-words, but some license is granted in the use of identicals."
                                            }
