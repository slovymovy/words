                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29739d99-bd15-4038-9cf1-b7d938086f4a",
                                "sense_id": "a750f855-16eb-3741-bbac-9d4f3c47368c",
                                "text": "Iedere maand gaan wij naar het cabaret om te lachen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e22fb74e-b1a7-41b5-9829-63a69cc94d47",
                        "source_entry_id": "da017d0a-afc7-3f6a-8a51-f309da75dbda",
                        "source_sense_id": "04a0ad1a-f612-3e29-8734-5430a55eb15f",
                        "source_sense_description": "een kleinkunst, vermaak met toneel, zang, dans, en voordracht",
                        "target_lang_word": "Kabarett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kabarett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5316aa04-df75-3579-a6a5-d2ff62686994",
                                        "entry_id": "e1747121-670b-3294-8437-06df80ff8270",
                                        "glosses": [
                                            "Bühne für kleine zeitkritische Darbietungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923217ea-16f8-44a7-bb5f-08fa8ccee97c",
                                                "sense_id": "5316aa04-df75-3579-a6a5-d2ff62686994",
                                                "text": "„… Er befaßte sich seit langem mit eigener Dichtung. Es waren Couplets für die bunten Paare in Bars und Kabaretts und Tingeltangel. Sie waren nicht phantastisch, sondern urberlinerisch, von kräftiger Sprache und mokantem Witz. …“"
                                            },
                                            {
                                                "example_id": "651734fe-6b8b-409c-a8c9-5243fb9ca91d",
                                                "sense_id": "5316aa04-df75-3579-a6a5-d2ff62686994",
                                                "text": "„Vor dem Kabarett parkten viele Privatautos.“"
                                            },
                                            {
                                                "example_id": "82058946-962c-40bb-a72c-0a0855d5338f",
                                                "sense_id": "5316aa04-df75-3579-a6a5-d2ff62686994",
                                                "text": "„Abends gingen sie weiter in die dahinter liegende Welt der großen und kleinen Theater, Musiksäle, Kabaretts und volkstümlichen Vaudevilles.“"
                                            },
                                            {
                                                "example_id": "b7a4c409-3095-4d5f-b00d-7153d0c47a46",
                                                "sense_id": "5316aa04-df75-3579-a6a5-d2ff62686994",
                                                "text": "„Die meisten Kabaretts in Deutschland werden auf der Ebene reiner Unterhaltung ohne ernsthafte Ambitionen unterhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5716673b-87be-33bd-bedf-608630f348b2",
                                        "entry_id": "e1747121-670b-3294-8437-06df80ff8270",
                                        "glosses": [
                                            "politisch-satirische Aufführungen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "b14d5ce7-bb69-341d-b8d7-35f7e3a608b3",
                                        "entry_id": "e1747121-670b-3294-8437-06df80ff8270",
                                        "glosses": [
                                            "literarische Aufführungen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "058a27e9-cea5-30e7-8291-8383122d2302",
                                        "entry_id": "e1747121-670b-3294-8437-06df80ff8270",
                                        "glosses": [
                                            "in Fächer gegliederte (meist drehbare) Speiseplatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5912b6a-8056-4797-b325-b497709a6a6c",
                                                "sense_id": "058a27e9-cea5-30e7-8291-8383122d2302",
                                                "text": "Mit diesem Kabarett-Teller aus hochwertigem Glas können Sie von Antipasti, über Snacks bis hin zu Saucen alles wirkungsvoll auf Ihrer Tafel anrichten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
