                                        "glosses": [
                                            "konstrukce (obvykle s vodorovným madlem ve výšce umožňující přidržení) sloužící jako zábrana proti pádu z výšky nebo oddělující prostory"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f4b9a5-d9f5-4e80-af32-172775a690ca",
                                                "sense_id": "f5759096-46ef-36bb-83d4-85038f0d7a74",
