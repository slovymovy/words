                                        "entry_id": "13bbb2a1-974b-3b82-a7ad-87a8ea8673f7",
                                        "glosses": [
                                            "sich gefühlsmäßig in jemand anderen hineinversetzen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da7899e-3f0f-488c-8b53-54a7555ec112",
                                                "sense_id": "ca59d597-ed90-3732-81bd-18d1e6137c68",
                                                "text": "Er fühlte mit ihr mit, als sie sich der Prüfung stellen musste."
                                            },
                                            {
                                                "example_id": "1f870148-be55-42a3-8f1d-5298b39eb46f",
                                                "sense_id": "ca59d597-ed90-3732-81bd-18d1e6137c68",
                                                "text": "Die Schwester hatte eine liebevolle und mitfühlende Art, den Patienten zu begegnen."
                                            },
                                            {
                                                "example_id": "19feef51-335e-4951-a01a-57c71f094c98",
                                                "sense_id": "ca59d597-ed90-3732-81bd-18d1e6137c68",
                                                "text": "Der Film ist richtig gut gemacht, ein Film, bei dem man mit dem Helden mitfiebern und mitfühlen kann."
                                            },
                                            {
                                                "example_id": "e25b6576-e866-4d98-b832-35dfbccbbe48",
                                                "sense_id": "ca59d597-ed90-3732-81bd-18d1e6137c68",
                                                "text": "„Wenn wir dagegen die Schmerzen der anderen sehen und mit ihnen mitfühlen würden, könnten wir viele Verbrechen gar nicht begehen, weil uns der Preis zu hoch wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
