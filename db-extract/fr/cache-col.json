                                        "entry_id": "75e9922c-cffe-3f35-aa76-0d7f60a407e4",
                                        "glosses": [
                                            "A neckcloth or cravat."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6903782b-c9bf-319b-bb73-0abf198ae3e4",
                                        "entry_id": "45c9925d-c5dc-3556-bdd6-e582d61e5db3",
                                        "glosses": [
                                            "To throw on loosely; to put on like a scarf."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dec2cf8-a521-47f3-9e3c-d9d9b57dfbcb",
                                                "sense_id": "6903782b-c9bf-319b-bb73-0abf198ae3e4",
                                                "text": "Vp from my Cabin, / My ſea-gowne scarft about me in the darke / Gropt I to find out them, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "748994cb-9fb5-3576-af68-f088050d082c",
                                        "entry_id": "45c9925d-c5dc-3556-bdd6-e582d61e5db3",
                                        "glosses": [
                                            "To dress with a scarf, or as with a scarf; to cover with a loose wrapping."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec29c893-803f-408e-aba9-3d4f73f46305",
                                                "sense_id": "748994cb-9fb5-3576-af68-f088050d082c",
                                                "text": "She scarfed her head."
                                            },
                                            {
                                                "example_id": "d284f24c-65b8-4159-bf1e-680d2ec3bcd3",
                                                "sense_id": "748994cb-9fb5-3576-af68-f088050d082c",
                                                "text": "The back of her tan trenchcoat swished from left to right as she scarfed her head and disappeared into the dusk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feb11b3a-8f83-3ac4-aab5-a0b366d5502e",
                                        "entry_id": "45c9925d-c5dc-3556-bdd6-e582d61e5db3",
                                        "glosses": [
                                            "To cover as or like a scarf."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e30aed8c-3d52-4307-96dd-f733a005c625",
                                                "sense_id": "feb11b3a-8f83-3ac4-aab5-a0b366d5502e",
                                                "text": "A cowl scarfed her shoulders."
                                            },
                                            {
                                                "example_id": "6df6b146-4bf3-4620-8112-a0305fc1ec13",
                                                "sense_id": "feb11b3a-8f83-3ac4-aab5-a0b366d5502e",
                                                "text": "She was trying to keep the silken veil scarfing her shoulders in order."
                                            },
                                            {
                                                "example_id": "7e55a761-4685-4035-87ea-4797c2697277",
                                                "sense_id": "feb11b3a-8f83-3ac4-aab5-a0b366d5502e",
                                                "text": "Transfixed on the smaller branches, intensely black against the moon, were organs harvested from the body cavity – heart, spleen, kidneys and liver. […] A length of slippery bowel scarfed my neck."
                                            },
                                            {
                                                "example_id": "8e4efac1-59bf-40c1-95b9-9a979c5f247b",
                                                "sense_id": "feb11b3a-8f83-3ac4-aab5-a0b366d5502e",
                                                "text": "A large red ribbon scarfed her neck and seemed to have its own strange glow of the same hue."
                                            }
                                        ]
                                    }
                                ]
                            },
