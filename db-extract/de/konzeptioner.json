                "senses": [
                    {
                        "sense_id": "89307538-0c5c-36fe-b738-fc926a8205ba",
                        "entry_id": "34fb8a94-6cdc-3ad4-8f26-e67259277e7e",
                        "glosses": [
                            "Person, die ein Konzept, einen Entwurf zu etwas entwickelt, insbesondere in der Werbebranche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b85ebd5d-c528-4804-b4ad-5879c3b9285f",
                                "sense_id": "89307538-0c5c-36fe-b738-fc926a8205ba",
                                "text": "„Deshalb sollte der Konzeptioner ein Gespür für Dramaturgie und Emotion haben, damit das Konzept vermittelt, was die Gäste des Events erleben werden.“"
                            },
                            {
                                "example_id": "805b397a-a29b-4c3b-a009-d78826d2d9bc",
                                "sense_id": "89307538-0c5c-36fe-b738-fc926a8205ba",
                                "text": "„Der Konzeptioner Klaus Schmidbauer bringt hierzu ein praktisches Werkzeug ins Spiel: den Faktenspiegel.“"
                            },
                            {
                                "example_id": "66b936a0-bbb0-4674-8fba-ed64c4a0a0ef",
                                "sense_id": "89307538-0c5c-36fe-b738-fc926a8205ba",
                                "text": "„Zum Zweiten sollte der Klient dem Konzeptioner soweit trauen, dass er es diesem überlässt, für seine Organisation wichtige Ziele zu verfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
