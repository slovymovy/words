                "senses": [
                    {
                        "sense_id": "36cef7fe-bdfe-3bdc-9472-5c60e5744aae",
                        "entry_id": "094d9499-c06f-32f5-a5fb-55edd769a903",
                        "glosses": [
                            "Tasche, die man über die Schulter gehängt tragen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e639d627-2b53-45bc-9300-8eadaa25ca91",
                                "sense_id": "36cef7fe-bdfe-3bdc-9472-5c60e5744aae",
                                "text": "„Stefan war gerade dabei, den Reißverschluss seiner Umhängetasche zu öffnen, Elisabeth hielt mitten im Schritt inne.“"
                            },
                            {
                                "example_id": "6e27b856-eb1b-4f1e-af81-6d30fb962aea",
                                "sense_id": "36cef7fe-bdfe-3bdc-9472-5c60e5744aae",
                                "text": "„Einer war laut Polizei mit einer hellbraunen Wollhaube und einem Schal maskiert, der andere trug eine dunkle Jacke und eine schwarze Umhängetasche.“"
                            },
                            {
                                "example_id": "4ddf1def-5fde-4653-b0c7-ce64e7056f8c",
                                "sense_id": "36cef7fe-bdfe-3bdc-9472-5c60e5744aae",
                                "text": "„Die hatte sich aber schon in Richtung Haus in Bewegung gesetzt und suchte mit gesenktem Kopf in ihrer kleinen Umhängetasche wohl bereits nach ihrem Schlüssel.“"
                            },
                            {
                                "example_id": "1f7e2889-c674-43f4-b59b-763c339a25d8",
                                "sense_id": "36cef7fe-bdfe-3bdc-9472-5c60e5744aae",
                                "text": "„Aus seiner Umhängetasche kramte er einen Studentenausweis hervor und reichte ihn ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
