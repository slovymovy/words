                ],
                "senses": [
                    {
                        "sense_id": "f48510b5-da9b-35e3-82d4-2df175276f32",
                        "entry_id": "bd6ca918-dccd-37a9-945c-ecc6ac96a894",
                        "glosses": [
                            "Mobiliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f88b131-4f79-4618-b2d3-b642e37a3b63",
                                "sense_id": "f48510b5-da9b-35e3-82d4-2df175276f32",
                                "text": "De même, dans le travail de re-médiation, l’enseignant va effectuer à nouveau (« re- ») une médiation permettant au sujet de re-mobiliser ses compétences et de ré-investir le projet."
                            },
                            {
                                "example_id": "4b6ec4de-09b4-42f2-9b27-d1dccdb7ccb4",
                                "sense_id": "f48510b5-da9b-35e3-82d4-2df175276f32",
                                "text": "Autrement dit, la reconnaissance que chaque être humain porte en lui des savoirs implicites non utilisés qu’il convient de re-mobiliser pour lui redonner une place sur l’échiquier social."
                            },
                            {
                                "example_id": "5bb21f56-a50f-44fe-a89d-71562592d003",
                                "sense_id": "f48510b5-da9b-35e3-82d4-2df175276f32",
                                "text": "L’enfant découvre là quelque chose de savoureux qui lui permet de lutter contre sa dépression profonde et de se re-mobiliser psychiquement."
                            }
                        ]
                    }
                ],
