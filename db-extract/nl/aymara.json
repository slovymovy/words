                                "sense_id": "5d5acf8c-cb30-3503-ad02-21dfd3f2f7bf",
                                "text": "Hoe zegt men dat in het Aymara?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb68cdf8-4816-46b2-a79a-1649ea4df97c",
