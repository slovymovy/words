                "senses": [
                    {
                        "sense_id": "df987203-c159-31e9-a3a2-76983fe69300",
                        "entry_id": "8d1c1371-8728-38a7-9e36-a0444bcd3e59",
                        "glosses": [
                            "A guttural or “throaty” consonant, i.e. one produced deep in the mouth: a uvular, pharyngeal, or glottal."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "9a5242a0-9ee7-497c-bd06-574646ffeb59",
                                "sense_id": "df987203-c159-31e9-a3a2-76983fe69300",
                                "text": "Das Deutsche kennt vier Kehllaute: [χ], [ʁ], [ʔ], [h]. Das Arabische kennt zusätzlich noch [q], [ħ], [ʕ].",
                                "translation": "German has four throaty consonants: [χ], [ʁ], [ʔ], [h]. Arabic has [q], [ħ], [ʕ] additionally.",
                                "english": "German has four throaty consonants: [χ], [ʁ], [ʔ], [h]. Arabic has [q], [ħ], [ʕ] additionally."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1976148-a13d-32aa-8f14-f945adbd8dc2",
                        "entry_id": "8d1c1371-8728-38a7-9e36-a0444bcd3e59",
                        "glosses": [
                            "synonym of Glottal or Kehlkopflaut (“glottal”)"
                        ],
