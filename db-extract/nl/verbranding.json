                "translations": [
                    {
                        "translation_id": "d7250737-3598-4a7c-b144-af19c793bc5c",
                        "source_entry_id": "1899f1b8-dbe0-307d-a4d1-7317ffbc0d17",
                        "target_lang_word": "Verbrennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbrennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a0f3768-2880-37a2-bf3b-a881d802b985",
                                        "entry_id": "a4fa0cfe-f975-32cb-a983-ac9db53a9336",
                                        "glosses": [
                                            "Vernichtung von Gegenständen durch Feuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3066e2-9f71-4cec-a8e3-9d824e8b1dbb",
                                                "sense_id": "1a0f3768-2880-37a2-bf3b-a881d802b985",
                                                "text": "Die Verbrennung von Gartenabfällen führt zu großer Rauchentwicklung."
                                            },
                                            {
                                                "example_id": "bf3a59fc-580b-4ca2-a238-f1c2a0f4152c",
                                                "sense_id": "1a0f3768-2880-37a2-bf3b-a881d802b985",
                                                "text": "„Erich Kästner hat nach 1945 versichert, am Berliner Opernplatz der Verbrennung seiner Bücher zugesehen zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56372a6c-5a9b-300b-a044-43c4ecb17dee",
                                        "entry_id": "a4fa0cfe-f975-32cb-a983-ac9db53a9336",
                                        "glosses": [
                                            "Verletzung der Haut durch Feuer, heiße Materialien oder Gifte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d50f8c-78b1-46d8-8dad-a4da47538f39",
                                                "sense_id": "56372a6c-5a9b-300b-a044-43c4ecb17dee",
                                                "text": "Verbrennungen können unter Sonneneinwirkung durch das Gift des Bärenklaus entstehen."
                                            },
                                            {
                                                "example_id": "adba939b-2182-4532-802f-73e00bfbf4b2",
                                                "sense_id": "56372a6c-5a9b-300b-a044-43c4ecb17dee",
                                                "text": "Großflächige Verbrennungen der Haut können zum Tode führen."
                                            },
                                            {
                                                "example_id": "d2014eb8-d3f5-44a3-8c81-30975a6fd1ba",
                                                "sense_id": "56372a6c-5a9b-300b-a044-43c4ecb17dee",
                                                "text": "„Er stammt nicht von den Toten, sondern von den Verbrennungen der Lebenden.“"
                                            },
                                            {
                                                "example_id": "360c5f6f-03e4-4931-8c49-a0d82da9cb23",
                                                "sense_id": "56372a6c-5a9b-300b-a044-43c4ecb17dee",
                                                "text": "„Verbrennungen gehören zu den häufigen Unfällen im Haushalt.“"
                                            },
                                            {
                                                "example_id": "7373932a-0147-4015-8037-2cedf6b353c1",
                                                "sense_id": "56372a6c-5a9b-300b-a044-43c4ecb17dee",
                                                "text": "„Bei akuten Verbrennungen ist das wichtigste Gegenmittel kaltes Leitungswasser.“"
                                            },
                                            {
                                                "example_id": "80c855cd-62dc-4aad-959b-c016f7c9cf00",
                                                "sense_id": "56372a6c-5a9b-300b-a044-43c4ecb17dee",
                                                "text": "„Streichen Sie auf Verbrennungen keine Cremen oder Hausmittel wie etwa Mehl oder Melkfett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "165a0eb4-0312-3f2b-a767-201aa10ceca3",
                                        "entry_id": "a4fa0cfe-f975-32cb-a983-ac9db53a9336",
                                        "glosses": [
                                            "Reaktion mit Sauerstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8017ab0f-b328-4692-b55a-0e9b8d28c381",
                                                "sense_id": "165a0eb4-0312-3f2b-a767-201aa10ceca3",
                                                "text": "Die Verbrennung im Reagenzglas lief kontrolliert ab."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "38eca968-d5d9-3edc-8d67-4334a2e6b50c",
                                        "entry_id": "a4fa0cfe-f975-32cb-a983-ac9db53a9336",
                                        "glosses": [
                                            "Einäscherung, eine Bestattungsform, bei der die Leiche des Verstorbenen verbrannt und/oder eingeäschert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ce0c33e-ba01-4342-a83c-7d7c596d4d14",
                                                "sense_id": "38eca968-d5d9-3edc-8d67-4334a2e6b50c",
                                                "text": "Die Verbrennung im Krematorium ist nicht öffentlich zugänglich."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f185c943-e014-3ca1-98d8-704d7d61a113",
                                        "entry_id": "a4fa0cfe-f975-32cb-a983-ac9db53a9336",
                                        "glosses": [
                                            "eine in der Zeit der Inquisitionen häufig angewandte Methode zur Ermordung angeblicher Hexen und Zauberer auf dem Scheiterhaufen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a856720-3e7c-4842-9202-4a9561606999",
                                                "sense_id": "f185c943-e014-3ca1-98d8-704d7d61a113",
                                                "text": "Die Inquisition führte häufig zur Verbrennung von Frauen, die für Hexen gehalten wurden."
                                            },
                                            {
                                                "example_id": "6bcd8b0e-0816-443b-8865-78ce7dc8eb42",
                                                "sense_id": "f185c943-e014-3ca1-98d8-704d7d61a113",
                                                "text": "„Ebenfalls 1542 wurde vor dem Amtsgericht Zwickau ein ›Kettenprozess‹, wie die Rechtshistoriker sagen, gegen mehrere Angeklagte geführt, die sich gegenseitig belasteten, 1546 im Amt Glauchau eine Todesstrafe wegen Zauberei in die Ausweisung umgewandelt, 1549 wegen Zauberei mit Bilsensamen eine Verbrennung vollstreckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c89fc001-9ff0-3290-bfcf-063785c6ac5d",
                                        "entry_id": "a4fa0cfe-f975-32cb-a983-ac9db53a9336",
                                        "glosses": [
                                            "Umsetzung von Treibstoff in Energie in einem Motor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba92c7b-06b0-48b2-843d-7cc24edfc398",
                                                "sense_id": "c89fc001-9ff0-3290-bfcf-063785c6ac5d",
                                                "text": "Die Verbrennung sollte nach Möglichkeit weiter optimiert werden."
                                            },
                                            {
                                                "example_id": "2eaaaa83-394a-4282-bfbb-6937a829a8cd",
                                                "sense_id": "c89fc001-9ff0-3290-bfcf-063785c6ac5d",
                                                "text": "„Fliegen schadet dem Klima nicht nur aufgrund der direkten CO₂-Emissionen aus der Verbrennung von Kerosin, sondern auch, weil Flugzeuge Kondensstreifen am Himmel hinterlassen, die als starke Treibhausgase wirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69092cf7-e5bc-4137-87d0-277f3f65ca5e",
                        "source_entry_id": "1899f1b8-dbe0-307d-a4d1-7317ffbc0d17",
                        "target_lang_word": "combustion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "combustion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c70f3395-63b7-30a6-8599-8e8ae0c39ea0",
                                        "entry_id": "6caecc57-3a4c-3787-8a7e-96383dfdd846",
                                        "glosses": [
                                            "The act or process of burning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cff399b9-ca41-3ec6-ad78-a9181ea0a2b9",
                                        "entry_id": "6caecc57-3a4c-3787-8a7e-96383dfdd846",
                                        "glosses": [
                                            "A process whereby two chemicals are combined to produce heat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55a253d3-305d-3d70-a5e5-378ca9dcb0ed",
                                        "entry_id": "6caecc57-3a4c-3787-8a7e-96383dfdd846",
                                        "glosses": [
                                            "A process wherein a fuel is combined with oxygen, usually at high temperature, releasing heat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e19dbe37-6027-308e-939d-561afa1d7340",
                                        "entry_id": "6caecc57-3a4c-3787-8a7e-96383dfdd846",
                                        "glosses": [
                                            "Violent agitation, tumult."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54fa4aa9-dc6c-476b-9135-0c57fb24946d",
                                                "sense_id": "e19dbe37-6027-308e-939d-561afa1d7340",
                                                "text": "But say from whence this new combustion springs."
                                            },
                                            {
                                                "example_id": "563b7368-4958-41fd-aba9-47004a14823e",
                                                "sense_id": "e19dbe37-6027-308e-939d-561afa1d7340",
                                                "text": "From this ground, with a kind of loose scorn, he continues the French Correspondence, and secretly contriveth a continuance of the Scotish Rebellion. He omits no Act of Contempt against the antient Nobility, that they might in the sence of their disgrace be, or at least dayly threaten some new Combustion."
                                            },
                                            {
                                                "example_id": "47b108bb-0ccc-409e-b45e-0e98129020ad",
                                                "sense_id": "e19dbe37-6027-308e-939d-561afa1d7340",
                                                "text": "There [were] great combustions and divisions among the heads of the university."
                                            },
                                            {
                                                "example_id": "22951503-9777-422b-aff0-d994a1167c4a",
                                                "sense_id": "e19dbe37-6027-308e-939d-561afa1d7340",
                                                "text": "Him the Almighty Power / Hurld headlong flaming from th' Etherial Skie / With hideous Ruine and combustion down / To bottomless perdition, there to dwell / In Adamantine Chains and penal Fire, / Who durst defie th' Omnipotent to Arms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25b1560a-e4a9-49b4-82aa-78cf1ff03a3b",
                        "source_entry_id": "1899f1b8-dbe0-307d-a4d1-7317ffbc0d17",
                        "target_lang_word": "combustion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "combustion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14939289-1525-3886-868b-7bbb8291c5c7",
                                        "entry_id": "2d71ce94-5a3a-3f5f-8237-5dfe07ad4bf5",
                                        "glosses": [
                                            "Action de brûler entièrement, de l’entière décomposition d’une chose par l’action du feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b930273a-97ba-4adf-99f3-627ad1572ed0",
                                                "sense_id": "14939289-1525-3886-868b-7bbb8291c5c7",
                                                "text": "Si donc, dans ces conditions, on veut mécher le tonneau, celui-ci ne contenant plus assez d’oxygène dans l'air qu'il renferme, ne pourra entretenir la combustion du soufre, et la mèche s’éteindra dès qu'elle sera introduite."
                                            },
                                            {
                                                "example_id": "e2eb715f-8916-4202-9992-6786a855986b",
                                                "sense_id": "14939289-1525-3886-868b-7bbb8291c5c7",
                                                "text": "L’aérage est une condition de première nécessité, car la respiration des ouvriers, la combustion des lumières et le tirage des coups de mine ne tarderaient pas à vicier l'air."
                                            },
                                            {
                                                "example_id": "c80ad5a3-8197-4e07-8729-c980ec127579",
                                                "sense_id": "14939289-1525-3886-868b-7bbb8291c5c7",
                                                "text": "La difficulté peut être tournée en ayant recours à la lumière résultant de la combustion des poudres-éclair. Cette combustion étant instantanée, il en résulte ce grand avantage que l'opération photographique ne peut causer aucune fatigue au malade."
                                            },
                                            {
                                                "example_id": "a85b40cb-4a55-4bee-aea7-c0bf6a2a4b4d",
                                                "sense_id": "14939289-1525-3886-868b-7bbb8291c5c7",
                                                "text": "Le carbone imbrûlé dépend de la nature du combustible et de la mise en œuvre de la combustion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7bfe272-9f9c-3604-802f-695ad49a0348",
                                        "entry_id": "2d71ce94-5a3a-3f5f-8237-5dfe07ad4bf5",
                                        "glosses": [
                                            "Réaction chimique exothermique entre un corps réducteur et le dioxygène ou un autre corps oxydant."
                                        ],
                                        "tags": [
                                            "Thermique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15bb2778-0803-457a-bfba-1ac50d77a36f",
                                                "sense_id": "a7bfe272-9f9c-3604-802f-695ad49a0348",
                                                "text": "L’oxygène de l’air est nécessaire à la combustion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e41e3548-6700-31b8-a96d-2361966e5ac8",
                                        "entry_id": "2d71ce94-5a3a-3f5f-8237-5dfe07ad4bf5",
                                        "glosses": [
                                            "Réaction chimique exothermique entre un combustible et un comburant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00a4043-5a72-4dc5-81dd-2be0f9f1604c",
                                                "sense_id": "e41e3548-6700-31b8-a96d-2361966e5ac8",
                                                "text": "Les produits de combustion peuvent alors contenir du combustible imbrûlé ou des corps comme le C, le H₂, le CO ou le OH."
                                            },
                                            {
                                                "example_id": "c5301274-36e4-4fc9-817c-8b43dcc91665",
                                                "sense_id": "e41e3548-6700-31b8-a96d-2361966e5ac8",
                                                "text": "La législation impose un minimum de rendement à la combustion par les brûleurs des chaudières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6c270fb-9aa1-3e15-889f-6ad86435da01",
                                        "entry_id": "2d71ce94-5a3a-3f5f-8237-5dfe07ad4bf5",
                                        "glosses": [
                                            "Grand désordre, grand tumulte qui s’élève soudainement dans une, nation, dans une assemblée, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21665f41-1fd8-41a1-9d69-638f25fdc3d2",
                                                "sense_id": "f6c270fb-9aa1-3e15-889f-6ad86435da01",
                                                "text": "Il espérait faire aisément surgir un vaste empire grec à la faveur d’une combustion générale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34f741db-afeb-4209-ae28-842f881cd743",
                        "source_entry_id": "1899f1b8-dbe0-307d-a4d1-7317ffbc0d17",
