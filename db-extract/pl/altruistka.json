                        "translation_id": "920d3a98-3516-4c13-93ff-ba2ceeb71545",
                        "source_entry_id": "4335669e-bc7b-3967-aaab-a45fe8c15435",
                        "source_sense_id": "107ad786-0245-3504-9239-308a668a32a1",
                        "target_lang_word": "altruista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                        "entry_id": "e48118d6-0b8a-39d6-a225-337753fc09eb",
                                        "glosses": [
                                            "Que profesa el altruismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa515b0b-edad-4f41-9b36-7c36c731c4e2",
                                                "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                                "text": "«En las grandes capitales, como se vive al día y como las angustias de uno son las angustias de todos, hay cierta humanitaria comunicación, cierto desprendimiento altruista, que en el fondo es un avance para obligar a reciprocidad futura»."
                                            },
                                            {
                                                "example_id": "f1008e45-7823-46c2-824d-f5fd05329031",
                                                "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                                "text": "«—Un sincero altruista como tú sabes; el bien de nuestros semejantes es nuestro bien»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a0d4a28-8a68-4263-ae19-7516dff65ad5",
                        "source_entry_id": "4335669e-bc7b-3967-aaab-a45fe8c15435",
                        "source_sense_id": "107ad786-0245-3504-9239-308a668a32a1",
                        "target_lang_word": "Altruistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altruistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "196086d2-d097-3717-b866-13cc69a81e51",
                                        "entry_id": "49bc51f4-ade4-3702-815f-ae5446117f29",
                                        "glosses": [
                                            "auf das Wohl anderer bedachte Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f96420-959b-467d-b6e7-366f5bc7a074",
                                                "sense_id": "196086d2-d097-3717-b866-13cc69a81e51",
                                                "text": "„Zwei Paare treten zur dramatischen Quadrille an, nicht wie das Leben sie zusammenführt, sondern wie ein Dichter sie zu kontrastieren liebt. Ein Egoist und ein Altruist; eine Egoistin und eine Altruistin. Der Altruist opfert sich für die Egoistin und wird von ihr aufgeopfert; die Altruistin opfert sich für den Egoisten und wird von ihm aufgeopfert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
