                "senses": [
                    {
                        "sense_id": "4e370f36-2f90-3c66-9d53-5739f39939e9",
                        "entry_id": "8ebb2aa4-0807-344b-889f-b6c0e0dba826",
                        "glosses": [
                            "van een persoon: het op een ongecontroleerde, wilde manier boos zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee0e820-9176-4713-a07c-9b57ef3bb8cc",
                                "sense_id": "4e370f36-2f90-3c66-9d53-5739f39939e9",
                                "text": "Zuidhoek koestert een geromantiseerd beeld van veel van zijn hoofdpersonen. In het hoofdstuk over Pier Gerlofs Donia staat: „Vrijwel alle hier behandelde hoofdpersonen kunnen worden getypeerd door een duister brok woestheid in hun natuur.” Dat leidt tot conclusies als die over de watergeus Willem Lumey: „Bezat Willem van Oranje maar iets van het drieste karakter van Lumey, (…), dan was er geen sprake geweest van een Nederland én een België (…) maar van één natie: De Nederlanden.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9c06db30-8fad-3725-a1b1-3eefd5215a80",
                        "entry_id": "8ebb2aa4-0807-344b-889f-b6c0e0dba826",
                        "glosses": [
                            "van een landschap: dat er geen of weinig menselijke invloed te zien is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b22200d4-f65d-4efc-a9f9-fbd9197264d6",
                                "sense_id": "9c06db30-8fad-3725-a1b1-3eefd5215a80",
                                "text": "De harde weersomstandigheden en de woestheid van het gebied leidden ertoe dat de Bàrdenas nooit echt bewoonbaar waren. De weinige tekenen van leven zijn de vervallen hutten die gebruikt worden door schaapherders in de wintermaanden."
                            }
                        ]
                    }
                ],
