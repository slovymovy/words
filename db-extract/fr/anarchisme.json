        "fr-extract.jsonl": [
            {
                "entry_id": "0830bc2f-d533-31de-9ae0-0d6938d1acb6",
                "word": "anarchisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7e287466-51e2-410c-bd8d-cb70bfc3a977",
                        "entry_id": "0830bc2f-d533-31de-9ae0-0d6938d1acb6",
                        "tags": [
                            "plural"
                        ],
                        "form": "anarchismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d92d490c-1683-3dea-9c50-e42cfabff16b",
                        "entry_id": "0830bc2f-d533-31de-9ae0-0d6938d1acb6",
                        "glosses": [
                            "Doctrine politique qui érige en principe de gouvernement l’absence de toute autorité centralisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53c4855-9f7a-479d-b3d0-35bc6e8814a5",
                                "sense_id": "d92d490c-1683-3dea-9c50-e42cfabff16b",
                                "text": "L’anarchisme n’admet, de façon générale et selon la formule consacrée, ni Dieu ni maître."
                            },
                            {
                                "example_id": "71f50f16-e694-47e4-9eab-8c8e7ee9f5d7",
                                "sense_id": "d92d490c-1683-3dea-9c50-e42cfabff16b",
                                "text": "Mais l’anarchisme conserve son caractère romantique, quasi chimérique, et le côté irréaliste des grandes grèves démontre cette faiblesse atavique."
                            },
                            {
                                "example_id": "d7b730d4-d8c1-4981-8679-b4a400937898",
                                "sense_id": "d92d490c-1683-3dea-9c50-e42cfabff16b",
                                "text": "L’anarchisme s’est surtout manifesté par des grèves dures, conduites dans les secteurs les plus sensibles de l’économie d’exportation : bananeraies de Colombie, compagnies pétrolières du Mexique, […]."
                            },
                            {
                                "example_id": "faa6c268-f04b-47c8-b342-d277eecd1e84",
                                "sense_id": "d92d490c-1683-3dea-9c50-e42cfabff16b",
                                "text": "Dès la fin des années 1880, en effet, des « bandits » se prévalent de l’anarchisme pour opérer non des vols ou des cambriolages, mais des « reprises individuelles »."
                            },
                            {
                                "example_id": "b7bc501f-8789-42c6-87ef-d3adabb688c2",
                                "sense_id": "d92d490c-1683-3dea-9c50-e42cfabff16b",
                                "text": "Sans avoir eu le temps de connaître l’âge d’or de l’anarchisme international, ni avoir bénéficié de la reconnaissance qu’elle méritait, fût-ce de manière posthume, elle a permis de construire les bases théoriques du mouvement qui prit son essor dans les années 1920."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c1a0a0a-f54b-33e5-b8be-10c4ae94e36a",
                        "entry_id": "0830bc2f-d533-31de-9ae0-0d6938d1acb6",
                        "glosses": [
                            "Refus de toute autorité, de toute règle et contrainte."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "94549c3c-0ab5-4a43-a387-014d8fb92e99",
                                "sense_id": "8c1a0a0a-f54b-33e5-b8be-10c4ae94e36a",
                                "text": "L’obsession d’efficacité entraîne Malraux à analyser les moyens techniques de la guerre : désormais, l’aviation est prépondérante, et l’anarchisme des comportements doit se plier à la discipline."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32b7012e-8325-4b10-a7a5-d60dfcc7896a",
                        "source_entry_id": "0830bc2f-d533-31de-9ae0-0d6938d1acb6",
                        "target_lang_word": "Anarchismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anarchismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                        "entry_id": "c8d5ca7e-3aed-37bc-a3cc-c11d29d44989",
                                        "glosses": [
                                            "Anschauung, die jede Herrschaft über Menschen ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf1840d-5622-4e6d-b7ae-b5a0fbdf4412",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "\"Sie berührt, in einem kaum verhohlenen Anarchismus, den Muttergrund der Dinge, die Welt des ewigen Wahns; jene proteische Welt, in der sich jederzeit alles in alles verwandeln kann.\""
                                            },
                                            {
                                                "example_id": "1033aabd-a6d4-4b88-9e5d-89ef6674c9d8",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "Der Anarchismus geht vom Grundsatz aus, dass niemand das Recht habe, Menschen zu regieren."
                                            },
                                            {
                                                "example_id": "922eb11b-c4f1-43f1-b1ee-7569106b7466",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "Anarchismus steht in einer Konfrontation zum Konservativismus wegen seines Hanges zu Neuerungen; mit dem Liberalismus weil man die Ausbeutung nicht annehmen kann und mit dem Sozialismus, weil der Staat nicht anerkannt wird."
                                            },
                                            {
                                                "example_id": "0668d7e3-075d-4225-b44b-fc64965194db",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "„Anarchismus war nur eine logische Reaktion darauf.“"
                                            },
                                            {
                                                "example_id": "452ce104-e677-4c57-8a10-25c7327e26ac",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "„Während der Haft schrieb Mühsam einen Großteil seines literarischen und politischen Werkes, dessen Anarchismus noch heute mit Terrorismus gleichgesetzt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3646e7d1-2619-4bf5-bb32-ef404ce27bb4",
                        "source_entry_id": "0830bc2f-d533-31de-9ae0-0d6938d1acb6",
                        "target_lang_word": "Staatsfeindlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7fc6bc0c-8874-429c-9014-c30a5a9b1095",
                        "source_entry_id": "0830bc2f-d533-31de-9ae0-0d6938d1acb6",
                        "target_lang_word": "anarchism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anarchism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63aa5f28-223a-36ca-ba87-1c55c6268190",
                                        "entry_id": "cb1b6345-a994-379c-9ff1-242ffe204e94",
                                        "glosses": [
                                            "A political and philosophical belief that all forms of government are undesirable, unnecessary, or unethical, and as such that society would function without a state."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60e96a87-67ac-4a65-9dae-d076d4ac782b",
                                                "sense_id": "63aa5f28-223a-36ca-ba87-1c55c6268190",
                                                "text": "Der Anarchismus ist die rechtsphilosophische Verneinung des Staates, das heisst diejenige Art der rechtsphilotopbischen Staatslehren, welche den Staat verneint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e9188b-7bb1-31ee-a5fa-e28fc1ae118d",
                                        "entry_id": "cb1b6345-a994-379c-9ff1-242ffe204e94",
                                        "glosses": [
                                            "A political and philosophical belief that proposes the establishment of a stateless society as well as the abolition of authority and hierarchy in most or all forms."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a2facaa-c237-4a77-af55-12e01f5f6764",
                                                "sense_id": "34e9188b-7bb1-31ee-a5fa-e28fc1ae118d",
                                                "text": "Opposed as it is to authority and hierarchy, anarchism is typically associated with chaos and disorder, and thus often connected with violence and terror. The means by which to achieve a nonhierarchical society animate debates within anarchism."
                                            },
                                            {
                                                "example_id": "9751ad91-a5b1-4e8b-b3e7-476d21a2c1e7",
                                                "sense_id": "34e9188b-7bb1-31ee-a5fa-e28fc1ae118d",
                                                "text": "Anarchism is skepticism toward authority. Its unifying position is that not all forms of authority are justified, and we should refrain from any acceptance of them prior to their satisfactory justification. One form of authority that anarchists consider unjustified is the political authority of the state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbd887e7-9e15-345e-b030-602e8a557b7f",
                                        "entry_id": "cb1b6345-a994-379c-9ff1-242ffe204e94",
                                        "glosses": [
                                            "The state of a society being without authorities or an authoritative governing body."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba015529-6731-4b2e-891c-117f701f4455",
                                                "sense_id": "fbd887e7-9e15-345e-b030-602e8a557b7f",
                                                "text": "By now the evils of the governments born of twentieth-century revolutions have been documented. And so anarchism – the absence of government, the direct administration by people of their own lives – is still intact as an ideal, for it has never been tried."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
