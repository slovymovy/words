                        "entry_id": "36c536c2-78f3-3d42-bbc7-b23e11a7a02f",
                        "glosses": [
                            "bij windmolens en zeilschepen: strook van het zeiloppervlak dat tijdelijk kan worden opgevouwen of opgerold"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "7c3ff15d-3886-476b-8703-d8a428224480",
                                "sense_id": "d376fbad-5f77-34de-8b7b-1b0295201aa9",
                                "text": "De wind is te sterk, we zullen een reef, of misschien wel twee, moeten steken."
                            }
                        ]
                    },
                    {
                        "sense_id": "74936e6c-c876-3037-9950-1889fe6a1393",
                        "entry_id": "36c536c2-78f3-3d42-bbc7-b23e11a7a02f",
                        "glosses": [
                            "golf, baar, uitlopende golfslag, waterrimpeling"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "98e652a3-6a4f-41ad-9c38-1161c95c29da",
                                "sense_id": "74936e6c-c876-3037-9950-1889fe6a1393",
                                "text": "Maar in zijn rand verbrak de zee in reven\nTelkens en telkens weer, er boven dreven\nAls gouden bijen wolken in het blauw,"
                            }
                        ]
                    }
                ],
