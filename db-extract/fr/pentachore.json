                            {
                                "target_word": "pentachoron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b926f45-b973-303e-be89-9ba0d7cdd59f",
                                        "entry_id": "ff4d9a03-cde3-315b-bc78-13f19d7cf25d",
                                        "glosses": [
                                            "A four-dimensional object analogous to a tetrahedron, constructed out of five tetrahedra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c3e724f-c427-477c-97db-12c5986ed18f",
                                                "sense_id": "7b926f45-b973-303e-be89-9ba0d7cdd59f",
                                                "text": "A triangle becomes a tetrahedron (a type of pyramid), then a pentachoron (a hyperpyramid)."
                                            },
                                            {
                                                "example_id": "a7fd76a7-5d8e-4a4d-857b-ea4e3a29cbb1",
                                                "sense_id": "7b926f45-b973-303e-be89-9ba0d7cdd59f",
                                                "text": "Geometrically, K₃ relates to a triangle, K₄ a tetrahedron, K₅ a pentachoron, etc."
                                            },
                                            {
                                                "example_id": "1c5b8ce0-e72d-4113-b2b4-0a43954ed595",
                                                "sense_id": "7b926f45-b973-303e-be89-9ba0d7cdd59f",
                                                "text": "The tetrahedron is a 3-simplex whose 4-simplex analog is the pentachoron, a four-dimensional body which can be orphographically ^([sic]) projected onto a quincrux (as well as a pentagram and other shapes)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
