                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5ba971b-a8fb-33b0-b8f1-94ad2fcdbd8b",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "A measured plan and description of any portion of country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd0cf6a0-eae9-4adb-9205-a9050302fc0e",
                                                "sense_id": "c5ba971b-a8fb-33b0-b8f1-94ad2fcdbd8b",
                                                "text": "The owners of the adjoining plots had conflicting surveys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c265468a-796e-3643-afbb-7a9984dde3f5",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "An examination of the opinions of a group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a60df33-979c-4b5e-84f2-00cb2b28f0cb",
                                                "sense_id": "c265468a-796e-3643-afbb-7a9984dde3f5",
                                                "text": "The local council conducted a survey of its residents to help it decide whether to go ahead with the roadside waste collection service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a860f972-1fae-3bc0-8d2e-4de6c2b1040d",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "A questionnaire or similar instrument used for examining the opinions of a group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c5e38e-31ae-4109-846b-db83291b7f27",
                                                "sense_id": "a860f972-1fae-3bc0-8d2e-4de6c2b1040d",
                                                "text": "I just filled out that survey on roadside waste pick-up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0583583b-e38b-3775-bd66-3f7bbb1226e0",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
