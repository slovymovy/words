                "senses": [
                    {
                        "sense_id": "50d29993-7002-337a-926a-5a8696ca200c",
                        "entry_id": "a325882d-d8bf-30a6-a764-778a91e05ced",
                        "glosses": [
                            "eines der Modelle für den Sprachwandel: Es steht für die Hypothese, dass die Verwandtschaftsverhältnisse historisch verwandter Sprachen (d.h. der Sprachen einer Sprachfamilie) sich in Form eines Stammbaums angemessen darstellen lassen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b398f64-1cb3-47f0-aa39-532850236bf9",
                                "sense_id": "50d29993-7002-337a-926a-5a8696ca200c",
                                "text": "Die Stammbaumtheorie ist nur ein Modell unter mehreren für Sprachwandel und Verwandtschaftsverhältnisse zwischen Sprachen."
                            },
                            {
                                "example_id": "463d9256-8165-41bc-9d38-a9552e9f301c",
                                "sense_id": "50d29993-7002-337a-926a-5a8696ca200c",
                                "text": "„Mit Schleicher soll der Einfluß der Naturwissenschaften auf die Linguistik seinen Höhepunkt erreicht haben, wofür seine Stammbaumtheorie schon ein äußerliches Zeichen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
