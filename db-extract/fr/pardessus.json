                    {
                        "translation_id": "000b17b8-7dc5-44a3-bb5e-1f74cf3d1894",
                        "source_entry_id": "fe4222d7-d3e5-3d3e-96f7-d05e9cb01d7f",
                        "source_sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                        "target_lang_word": "пальто",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пальто",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6bd7d117-d40f-3cd5-910e-63563ea6ff3b",
                                        "entry_id": "8c0d46f3-99cd-3b8c-9dd6-5a30aa891867",
                                        "glosses": [
                                            "верхняя одежда, однобортная или двубортная, обычно с длинными по́лами, отложным воротником и лацканами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb37b8e-609e-45d7-aacb-4b9853236c1d",
                                                "sense_id": "6bd7d117-d40f-3cd5-910e-63563ea6ff3b",
                                                "text": "Чуха с откидными рукавами, украшенная галуном, цветные шаровары, высокие, нечернёные сапоги и персидская баранья шапка лучше шли к ружью за спиной и к сабле при бедре, чем цилиндр и пальто, хотя бы самого вычурного покроя."
                                            },
                                            {
                                                "example_id": "9365ed7f-ab64-4bc5-96e8-a3d59e44cceb",
                                                "sense_id": "6bd7d117-d40f-3cd5-910e-63563ea6ff3b",
                                                "text": "[Маланья:] Асаф Наумыч, нужны тебе бумаги-то, что ли, так говори! [Корпелов:] Ничего мне не нужно. Какие бумаги? [Маланья:] А вчера ты хмельненек пришёл, так из пальта выронил."
                                            },
                                            {
                                                "example_id": "8adac022-2e22-4427-a186-d6b1594eb4b6",
                                                "sense_id": "6bd7d117-d40f-3cd5-910e-63563ea6ff3b",
                                                "text": "Мы очень смеялись, вместо простыни постлали рубашку, а вместо подушки сложили пальто."
                                            },
                                            {
                                                "example_id": "33f4e8b2-bdaa-4aba-a885-2d8e4cde67bb",
                                                "sense_id": "6bd7d117-d40f-3cd5-910e-63563ea6ff3b",
                                                "text": "Одетый в прекраснейшее драповое пальто с превосходнейшим бобровым воротником, хотя апрель месяц уже близился к концу, он поразил всех — Нежданова, Паклина, даже Машурину… даже Остродумова!"
                                            },
                                            {
                                                "example_id": "f7bb8c64-b793-4008-856d-2a2881467ef3",
                                                "sense_id": "6bd7d117-d40f-3cd5-910e-63563ea6ff3b",
                                                "text": "Я с утра пылесосила шторы, // нафталинила польта, манто, // протирала рояль, на котором, // не играл в этом доме никто."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
