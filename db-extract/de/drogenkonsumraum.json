                "senses": [
                    {
                        "sense_id": "8f633dbf-1944-398e-b84c-587de75eadbf",
                        "entry_id": "d48e9478-f319-3536-a5e8-a296c6816800",
                        "glosses": [
                            "von einem öffentlichen Träger oder Ähnlichem bereitgestellter Raum, in dem Drogenabhängige unter medizinischer Aufsicht Drogen konsumieren können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba07968-51af-45ab-ad6b-db838a1d7031",
                                "sense_id": "8f633dbf-1944-398e-b84c-587de75eadbf",
                                "text": "„In der Münstergasse im Herzen von Bern eröffnete die Drogenberatungsstelle Contact den ersten Drogenkonsumraum der Welt.“"
                            },
                            {
                                "example_id": "bae082b9-0928-437a-a2ef-d7dc2288282d",
                                "sense_id": "8f633dbf-1944-398e-b84c-587de75eadbf",
                                "text": "„In Drogenkonsumräumen können Menschen mitgebrachte Drogen sicher konsumieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
