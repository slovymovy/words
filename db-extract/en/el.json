                        ],
                        "examples": [
                            {
                                "example_id": "e5ca0a1b-c2fa-48c7-91be-a9ae7a800017",
                                "sense_id": "05df28b8-dd3b-3667-91b8-9661059e481b",
                                "text": "The Washington Street El was torn down in 1987."
                            },
                            {
                                "example_id": "5e98901a-b70c-42c6-90bc-362689d6dbef",
                                "sense_id": "05df28b8-dd3b-3667-91b8-9661059e481b",
                                "text": "Known colloquially as the \"El,\" the elevated lines constituted the earliest attempt to remove urban passenger traffic from the streets."
                            }
                        ]
