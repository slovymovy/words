                                        "glosses": [
                                            "funkcjonariusz milicji – instytucji odpowiedzialnej za ochronę bezpieczeństwa publicznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f121a586-9dfa-45b3-956d-5de636fa238a",
                                                "sense_id": "3c31586f-79ef-3f78-82e8-9ccdfe852b41",
                                                "text": "Każdy lekarz miał obowiązek natychmiastowego zgłaszania milicji wszystkich ran postrzałowych, a on wcale nie miał ochoty tłumaczyć jakiemuś milicjantowi, skąd się wzięła kula w jego łapie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
