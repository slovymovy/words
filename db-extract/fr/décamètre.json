                        "examples": []
                    },
                    {
                        "sense_id": "1d299bbc-f835-3ae2-978a-b33e524fac74",
                        "entry_id": "54aa0b12-1dd1-3e55-b64b-7e1483bc4c27",
                        "glosses": [
                            "Outil servant à prendre des mesures sur de grandes longueurs et constitué d’un ruban de plastique ou de métal gradué de dix mètres de long."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ac8e13-0279-4cc8-86f3-757c8812e693",
                                "sense_id": "1d299bbc-f835-3ae2-978a-b33e524fac74",
                                "text": "Le géomètre utilise le décamètre pour mesurer certaines distances lors de ses travaux de topographie."
                            },
                            {
                                "example_id": "d28b8049-14a8-4c4b-bdd6-e7001757f7c5",
                                "sense_id": "1d299bbc-f835-3ae2-978a-b33e524fac74",
                                "text": "Il s’envole, retombe même debout, sans s’affaisser dans le sable et... on mesure, avec un décamètre, car l’installation électronique n’avait pas prévu une telle distance : 8m90 !"
                            }
                        ]
                    }
