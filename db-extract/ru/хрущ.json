                    {
                        "translation_id": "5845ec92-3d23-4ed6-82f7-1e43c773fc81",
                        "source_entry_id": "62728ac3-ad8e-36b4-844b-17df414c05ab",
                        "source_sense_id": "ba8c5890-7c52-35da-996e-2bf3e0b44054",
                        "target_lang_word": "cockchafer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cockchafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                        "entry_id": "96c6fdc6-35c1-3252-95b2-0cd29676a9f8",
                                        "glosses": [
                                            "Any of the large European beetles from the genus Melolontha that are destructive to vegetation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6798926-f36b-49b9-b320-d633e8f08bbf",
                                                "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                                "text": "To the person who shall discover to the Society an effectual method, verified by repeated and satisfactory trials, of destroying the Grub of the Cockchafer, so destructive to the roots of all sorts of Corn, Pease, Beans, and Turneps, the gold medal."
                                            },
                                            {
                                                "example_id": "b101c15f-759b-4d0e-a66c-2e6776d7aee4",
                                                "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                                "text": "His impassioned words buzzed about my ears like cockchafers round the top of the lime-trees."
                                            },
                                            {
                                                "example_id": "a7aa9df4-82bc-43d8-b196-dde73b1f9003",
                                                "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                                "text": "With regard to the playing of the female part by the weaker rats it is interesting to observe that Féré found among insects that the passive part in homosexual relations is favored by fatigue; among cockchafers it was the male just separated from the female who would take the passive part (on the rare occasions when homosexual relations occurred) with a fresh male."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "292e3506-1555-32c5-8686-7fb5702f014f",
                                        "entry_id": "96c6fdc6-35c1-3252-95b2-0cd29676a9f8",
                                        "glosses": [
                                            "Any of various other similar beetles, such as of the genera Acrossidius, Cyphochilus, Rhopaea, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
