                                "target_lang_sense_clarification": "persona de gran atractivo físico, coloquial en España"
                            },
                            {
                                "target_lang_word": "bomba",
                                "target_lang_sense_clarification": "mujer despampanante o sensual"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeb83257-10c6-37e9-92ea-e7da40b8697a",
                    "sense_definition": "A hollow metal object containing an explosive charge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical museum displayed an old <w>bombshell</w> found on the battlefield.",
                            "target_lang_translations": {
                                "es": "El museo histórico exhibía una vieja <w>bomba</w> hallada en el campo de batalla."
                            }
                        },
                        {
                            "text": "The soldiers carefully moved the unexploded <w>bombshell</w> to a safe location.",
                            "target_lang_translations": {
                                "es": "Los soldados trasladaron con cuidado el <w>obús</w> sin detonar a un lugar seguro."
                            }
