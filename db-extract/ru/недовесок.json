                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45d4f569-b38d-3da7-85f7-42d7f91063c4",
                                        "entry_id": "c7845e50-97eb-366b-8c63-f7faa9c38836",
                                        "glosses": [
                                            "To invest in less than conventional wisdom would dictate."
                                        ],
