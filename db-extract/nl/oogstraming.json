                        "glosses": [
                            "schatting van wat men bij de volgende oogst zal oogsten aan landbouwproducten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b6ad93-d6b8-4bc9-9b70-4bd95cfc593e",
                                "sense_id": "7b54a7a2-6411-33c2-8898-767ca67f8f89",
                                "text": "Er hangen meer appels maar minder peren aan de fruitbomen. Volgens de oogstramingen van brancheorganisaties GroentenFruit Huis en de Nederlandse Fruittelers Organisatie (NFO) bedraagt de Nederlandse appeloogst zo'n 285 miljoen kilo, 7 procent meer dan vorig jaar. De perenoogst valt met 379 miljoen kilo 6 procent lager uit."
                            },
                            {
                                "example_id": "be021d1e-fc9f-42e5-b325-5d7bded43415",
                                "sense_id": "7b54a7a2-6411-33c2-8898-767ca67f8f89",
                                "text": "Door de langdurige droogte van deze zomer moeten aardappel-, uien- en bietentelers vrezen voor flink lagere oogstopbrengsten. Dat verwacht het CBS in de jaarlijkse Oogstraming."
                            }
                        ]
