{
    "word_family": [
        "solicit",
        "solicitor",
        "solicitation",
        "solicitous",
        "solicitously"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b722820-b56e-35ac-89c5-6583e582e342",
                    "sense_definition": "present participle and gerund of <w>solicit</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>soliciting</w> feedback from all its employees regarding the new office policy.",
                            "target_lang_translations": {
                                "pl": "Firma <w>zabiega o</w> opinie od wszystkich swoich pracowników w sprawie nowej polityki biurowej."
                            }
                        },
                        {
                            "text": "He was arrested for <w>soliciting</w> money from pedestrians on the busy street corner.",
                            "target_lang_translations": {
                                "pl": "Został aresztowany za <w>nagabywanie</w> przechodniów o pieniądze na ruchliwym rogu ulicy."
                            }
                        }
                    ],
                    "synonyms": [
                        "requesting",
                        "asking",
                        "seeking"
                    ],
                    "common_phrases": [
                        "soliciting feedback",
                        "soliciting donations"
                    ],
                    "target_lang_definitions": {
                        "pl": "Prośba o coś, zabieganie o coś lub aktywne poszukiwanie czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zabieganie",
                                "target_lang_sense_clarification": "aktywne staranie się o uzyskanie czegoś"
                            },
                            {
                                "target_lang_word": "prośba",
                                "target_lang_sense_clarification": "formalne lub bezpośrednie zwrócenie się o coś"
                            },
                            {
                                "target_lang_word": "nagabywanie",
                                "target_lang_sense_clarification": "uporczywe zwracanie się do kogoś, często w kontekście pieniędzy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0bbb2177-89a1-3dba-9eb5-fc4916e30d3c",
                    "sense_definition": "The act of asking for something in a persistent or urgent way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite her constant <w>soliciting</w>, the committee refused to change their final decision.",
                            "target_lang_translations": {
                                "pl": "Pomimo jej ciągłego <w>nalegania</w>, komisja odmówiła zmiany swojej ostatecznej decyzji."
                            }
                        },
                        {
                            "text": "His persistent <w>soliciting</w> for donations eventually became quite annoying to his neighbors.",
                            "target_lang_translations": {
                                "pl": "Jego uporczywe <w>zabieganie</w> o darowizny stało się w końcu dość irytujące dla sąsiadów."
                            }
                        }
                    ],
                    "synonyms": [
                        "entreaty",
                        "petitioning",
                        "importuning"
                    ],
                    "common_phrases": [
                        "constant soliciting"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uporczywe lub naglące domaganie się czegoś od innych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nagabywanie",
                                "target_lang_sense_clarification": "uporczywe domaganie się czegoś"
                            },
                            {
                                "target_lang_word": "naleganie",
                                "target_lang_sense_clarification": "wywieranie presji w celu uzyskania czegoś"
                            },
                            {
                                "target_lang_word": "żebranie",
                                "target_lang_sense_clarification": "uporczywe proszenie o pieniądze lub wsparcie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}