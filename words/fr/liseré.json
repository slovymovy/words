            "senses": [
                {
                    "sense_id": "9ddf6753-a2d3-3f4d-925d-162d74547757",
                    "sense_definition": "Bande ou filet étroit qui borde un tissu, un objet ou une surface, souvent d'une couleur contrastante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bordure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle portait une veste noire élégante soulignée d'un fin <w>liseré</w> blanc autour du col."
                        },
                        {
                            "text": "Les assiettes en porcelaine étaient décorées d'un délicat <w>liseré</w> doré sur leur pourtour."
                        }
                    ],
                    "synonyms": [
                        "bordure",
                        "filet"
                    ],
                    "common_phrases": [
                        "liseré doré"
                    ]
                },
                {
                    "sense_id": "e482adf0-9d46-37bf-9f77-db9ad06c56c0",
                    "sense_definition": "Ruban ou tresse très étroite servant à border ou orner un vêtement, notamment un uniforme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bordure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'uniforme de cérémonie des officiers comporte des <w>liserés</w> rouges le long des coutures."
                        },
                        {
                            "text": "Le tailleur a cousu un petit <w>liseré</w> de satin pour cacher les finitions de la manche."
                        }
                    ],
                    "synonyms": [
                        "galon",
                        "passepoil"
                    ],
                    "common_phrases": [
                        "liseré de satin",
                        "liseré rouge"
                    ]
                },
                {
                    "sense_id": "2cb9c8cc-fd5a-3926-97c6-d60664f74c6d",
                    "sense_definition": "Bande étroite ou filet graphique tracé le long d'une ligne pour la mettre en valeur sur une carte ou un dessin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "graphisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cartographe a ajouté un <w>liseré</w> bleu pour faire ressortir le tracé du fleuve."
                        },
                        {
                            "text": "Sur ce plan cadastral, chaque parcelle est entourée d'un léger <w>liseré</w> gris."
