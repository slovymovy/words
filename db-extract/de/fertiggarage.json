                        "tags": [],
                        "examples": [
                            {
                                "example_id": "200a4da9-f316-4aba-a1b6-50b5f594b4b1",
                                "sense_id": "5ce24fbd-d2f0-33f7-b6ec-74243cec2a55",
                                "text": "Die Fertiggarage wurde mit einem Lkw angeliefert und vom Kran auf die vorbereiteten Streifenfundament gesetzt."
                            },
                            {
                                "example_id": "6142a527-3dfd-4c2a-b875-1cc151e8fe2f",
                                "sense_id": "5ce24fbd-d2f0-33f7-b6ec-74243cec2a55",
                                "text": "„Diese Richtlinie soll dem Planer und Bauherrn eine Beschreibung von Bauart, Ausführung und Ausstattung von Fertiggaragen aus Stahlbeton liefern und somit helfen, eine Beurteilung von unterschiedlichen Bauweisen zu ermöglichen.“"
                            }
