        "fr-extract.jsonl": [
            {
                "entry_id": "b8183cac-409c-3a27-ac5e-b6f077c94803",
                "word": "potentat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d0ba189-a9e3-44b4-ab9c-46a831823906",
                        "entry_id": "b8183cac-409c-3a27-ac5e-b6f077c94803",
                        "tags": [
                            "plural"
                        ],
                        "form": "potentats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c745022-5b54-3379-8158-b0820f13b571",
                        "entry_id": "b8183cac-409c-3a27-ac5e-b6f077c94803",
                        "glosses": [
                            "Personne qui a la puissance souveraine dans un grand État."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "8f0896ed-33bd-49d9-b5ae-d21bae397d14",
                                "sense_id": "3c745022-5b54-3379-8158-b0820f13b571",
                                "text": "Le Sénat décidait, mais derrière ses décisions nous saisissons l’action de ces potentats de la finance qui tenaient les fils dans l’ombre et faisaient mouvoir les acteurs du premier plan."
                            },
                            {
                                "example_id": "a270745b-5551-4620-ab39-23c916156ee5",
                                "sense_id": "3c745022-5b54-3379-8158-b0820f13b571",
                                "text": "Dans bien des cas, la coutume régionale et la pratique traditionnelle préislamique, combiné à la volonté arbitraire du potentat régnant, sont devenues la base légale du gouvernement."
                            }
                        ]
                    },
                    {
                        "sense_id": "42874abb-33d7-36eb-8ce6-831b18433acc",
                        "entry_id": "b8183cac-409c-3a27-ac5e-b6f077c94803",
                        "glosses": [
                            "Personnage qui possède un pouvoir excessif par sa situation économique, hiérarchique ou sociale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb83b056-b75c-4ee7-8047-b183973128c5",
                                "sense_id": "42874abb-33d7-36eb-8ce6-831b18433acc",
                                "text": "Ces deux cent mille francs que son père gagnait chaque année dans les soieries lui valaient le respect et les saluts des gens de son quartier, et faisaient des siens les potentats de leur village, dans le département de la Loire."
                            },
                            {
                                "example_id": "28002946-d143-4276-90a6-dc6456f477ca",
                                "sense_id": "42874abb-33d7-36eb-8ce6-831b18433acc",
                                "text": "Le seul Arsène André, l’instituteur des Hautes Héez, ne craint pas le potentat, et M. Hector a échoué pour l’amener à plus de révérence […]"
                            },
                            {
                                "example_id": "c6be5313-e789-48ea-83ce-1c40bc9338c7",
                                "sense_id": "42874abb-33d7-36eb-8ce6-831b18433acc",
                                "text": "Des potentats locaux concentraient tous les pouvoirs religieux, militaires et civils."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1fa6bb1-8905-45fd-819b-3f4abc5c3b94",
                        "source_entry_id": "b8183cac-409c-3a27-ac5e-b6f077c94803",
                        "target_lang_word": "Machthaber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machthaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                        "entry_id": "4ad6eaad-b60e-3059-b1dc-a1806749373a",
                                        "glosses": [
                                            "Person, die Macht und/oder Regierungsgewalt innehat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdad82a9-be4e-49d4-86b8-b19d9d767bb9",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Doch statt für die braunen Machthaber zu werben, protzte der Korsar in eigener Sache.“"
                                            },
                                            {
                                                "example_id": "a62217e4-2c74-42d2-a632-00a34288f1b1",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Ein Militärgouverneur ist der Machthaber in einem von fremden Truppen besetzten, annektierten oder sonst wie nicht unter Eigen-, sondern fremder Militärregierung stehenden Land.“"
                                            },
                                            {
                                                "example_id": "9e455d7c-4551-4ff7-8f7d-daee2dad6477",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Für mehr als ein Jahr nach dem Ende der Kampfhandlungen blieben die Militärs die alleinigen Machthaber auf diesem Territorium.“"
                                            },
                                            {
                                                "example_id": "70446563-2eff-43ed-9fbc-5bf602780da3",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Als Machthaber der Insel gaben die Deutschen auch Briefmarken heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db5e327-8c40-40bd-87f5-7685395c6185",
                        "source_entry_id": "b8183cac-409c-3a27-ac5e-b6f077c94803",
                        "target_lang_word": "potentate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potentate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "A powerful leader; a monarch; a ruler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e5610e-3e5a-4677-93f7-ef85e261c71a",
                                                "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                                "text": "But Kings and mightieſt Potentates muſt die,\nFor that's the end of humane miſerie."
                                            },
                                            {
                                                "example_id": "6793baa4-5a27-4f33-8a89-db272b9aa169",
                                                "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                                "text": "She was now one of a group of oriental beauties who, in the second act of the comic opera, were paraded by the vizier before the new potentate as the treasures of his harem."
                                            },
                                            {
                                                "example_id": "4f6ab288-0717-4c5c-9054-29d277f1d6ab",
                                                "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                                "text": "Life for ordinary barons in Outremer Jerusalem was probably better than for kings in Europe, where even potentates wore unlaundered wool and lived in bare-stone draughty keeps with rough furniture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81feaab4-9769-39ee-bc2b-b6b53931e794",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "A powerful polity or institution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "860fe4f4-f463-35c9-9f6c-b826e3cf3918",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "A self-important person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95709c64-8abf-3377-81f9-b101ac51c7c6",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "Someone acting in an important role."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a56f11cb-667b-4718-a4fe-b7fd177f5c0b",
                                                "sense_id": "95709c64-8abf-3377-81f9-b101ac51c7c6",
                                                "text": "\"Those foreigners,\" thought the female potentate of the Sun, \"won't know what to order; but I'll show them what a good supper is.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "potentate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8818c5c2-a696-3e9f-9844-8204f5e6abaa",
