{
    "word_family": [
        "mortal",
        "immortal",
        "mortally",
        "immortality",
        "immortalize",
        "post-mortem"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e3c6944-1233-36c3-a827-91b50c8d7db0",
                    "sense_definition": "The number of deaths in a given period or among a specific group of people, often expressed as a rate.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "death_statistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mortality</w> rate among infants has decreased significantly due to better healthcare.",
                            "target_lang_translations": {
                                "ru": "Уровень <w>смертности</w> среди младенцев значительно снизился благодаря улучшению медицинского обслуживания."
                            }
                        },
                        {
                            "text": "Researchers are studying the high <w>mortality</w> in the barracks compared to the civilian population.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучают высокую <w>смертность</w> в казармах по сравнению с гражданским населением."
                            }
                        }
                    ],
                    "synonyms": [
                        "death rate",
                        "mortality rate"
                    ],
                    "common_phrases": [
                        "mortality rate",
                        "infant mortality",
                        "high mortality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество смертей за определенный период или среди определенной группы людей, часто выражаемое в виде коэффициента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертность",
                                "target_lang_sense_clarification": "статистический показатель"
                            },
                            {
                                "target_lang_word": "уровень смертности",
                                "target_lang_sense_clarification": "коэффициент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64279822-e250-351f-8642-c0f3cc29087b",
                    "sense_definition": "The state of being subject to death or the quality of being mortal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mortal_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden illness of his friend forced him to confront his own <w>mortality</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапная болезнь друга заставила его осознать собственную <w>смертность</w>."
                            }
                        },
                        {
                            "text": "Philosophers often reflect on human <w>mortality</w> and the meaning of life.",
                            "target_lang_translations": {
                                "ru": "Философы часто размышляют о человеческой <w>смертности</w> и смысле жизни."
                            }
                        }
                    ],
                    "antonyms": [
                        "immortality"
                    ],
                    "common_phrases": [
                        "human mortality",
                        "confront mortality",
                        "sense of mortality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние подверженности смерти или качество смертного существа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертность",
                                "target_lang_sense_clarification": "природа живого существа"
                            },
                            {
                                "target_lang_word": "бренность",
                                "target_lang_sense_clarification": "философский контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f9209bc-995e-36da-8c97-70cd8bb63274",
                    "sense_definition": "Deaths resulting from a specific event such as a war, disaster, or epidemic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "death_statistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mortality</w> among sheep was enormous during the severe winter frost.",
                            "target_lang_translations": {
                                "ru": "<w>Смертность</w> среди овец была огромной во время сильных зимних морозов."
                            }
                        },
                        {
                            "text": "Doctors were shocked by the swift <w>mortality</w> caused by the new virus.",
                            "target_lang_translations": {
                                "ru": "Врачи были потрясены быстрой <w>смертностью</w>, вызванной новым вирусом."
                            }
                        }
                    ],
                    "synonyms": [
                        "fatality",
                        "casualty rate"
                    ],
                    "common_phrases": [
                        "swift mortality",
                        "enormous mortality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случаи гибели в результате конкретного события, такого как война, катастрофа или эпидемия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертность",
                                "target_lang_sense_clarification": "в результате бедствия"
                            },
                            {
                                "target_lang_word": "гибель",
                                "target_lang_sense_clarification": "массовая смерть"
                            },
                            {
                                "target_lang_word": "летальность",
                                "target_lang_sense_clarification": "медицинский контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8a364eb-5386-3499-b8b2-bffb1c17d20b",
                    "sense_definition": "The act or state of dying; death itself.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mortal_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house was filled with the moldy odor of <w>mortality</w> and decay.",
                            "target_lang_translations": {
                                "ru": "Старый дом был наполнен затхлым запахом <w>смерти</w> и разложения."
                            }
                        },
                        {
                            "text": "He spoke of <w>mortality</w> as a release from the pains of the world.",
                            "target_lang_translations": {
                                "ru": "Он говорил о <w>смерти</w> как об освобождении от мирских страданий."
                            }
                        }
                    ],
                    "synonyms": [
                        "death",
                        "demise",
                        "decease"
                    ],
                    "common_phrases": [
                        "odor of mortality"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или состояние умирания; сама смерть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смерть",
                                "target_lang_sense_clarification": "факт кончины"
                            },
                            {
                                "target_lang_word": "тлен",
                                "target_lang_sense_clarification": "литературно о разложении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca7fa5d1-2952-3557-ba30-951e6344d250",
                    "sense_definition": "Human beings considered collectively as subject to death.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "humanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not for all <w>mortality</w> to know the secrets of the universe.",
                            "target_lang_translations": {
                                "ru": "Не всем <w>смертным</w> дано знать тайны вселенной."
                            }
                        },
                        {
                            "text": "The poet addressed his verses to all <w>mortality</w> who might listen.",
                            "target_lang_translations": {
                                "ru": "Поэт обратил свои стихи ко всему <w>человечеству</w>, которое могло бы его услышать."
                            }
                        }
                    ],
                    "synonyms": [
                        "humanity",
                        "mankind",
                        "humankind"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человечество, рассматриваемое как совокупность смертных существ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертные",
                                "target_lang_sense_clarification": "люди как род"
                            },
                            {
                                "target_lang_word": "человечество",
                                "target_lang_sense_clarification": "в архаичном смысле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}