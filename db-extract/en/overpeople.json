                    {
                        "sense_id": "bdd14bb7-2829-3b85-a5e1-e113f679a394",
                        "entry_id": "c7327b7d-1e62-3911-a520-68fcfadf6985",
                        "glosses": [
                            "To people too densely; overpopulate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cb18e7ea-af96-4f12-aaa9-a1ceefa43955",
                                "sense_id": "bdd14bb7-2829-3b85-a5e1-e113f679a394",
                                "text": "The drones are killed at the end of summer, but the queen and great part of the workers remain ; and when, in the summer, they increase so much as to overpeople the hive, colonies are sent forth with young queens, in search of another habitation."
                            },
                            {
                                "example_id": "c532e3c2-0f1f-4d35-b7b6-428b4cbc3c0a",
                                "sense_id": "bdd14bb7-2829-3b85-a5e1-e113f679a394",
                                "text": "At breakfast James made request to his father that he might be allowed to make of a certain little-used loft a room for Isy and himself, so as not to overpeople the house."
                            }
                        ]
                    }
                ],
