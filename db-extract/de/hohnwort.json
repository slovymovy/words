                "senses": [
                    {
                        "sense_id": "4154a656-b069-3c95-9422-24347f93bc82",
                        "entry_id": "07114000-9011-3f94-ae3a-88ca5d92ab4f",
                        "glosses": [
                            "Wort, mit dem die angesprochene Sache oder Person als unangemessen angeprangert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49076d0-90b9-42ea-a7e1-d5c9adc00f9d",
                                "sense_id": "4154a656-b069-3c95-9422-24347f93bc82",
                                "text": "Ladendorf (1906) nennt „Kuhhandel“ als Hohnwort: „Kuhhandel, seit den neunziger Jahren des 19. Jahrhunderts ein vielgeliebtes Hohnwort für politische Abmachungen…“"
                            },
                            {
                                "example_id": "8e375b31-2058-4a5e-8539-07422aa939d3",
                                "sense_id": "4154a656-b069-3c95-9422-24347f93bc82",
                                "text": "Ein modernes Hohnwort gleicher Qualität wäre der Vorwurf der „Mafiamethoden“."
                            },
                            {
                                "example_id": "0700f0a0-03ad-4927-b0c3-a2aa0330ffc3",
                                "sense_id": "4154a656-b069-3c95-9422-24347f93bc82",
                                "text": "Hohnwort ist bis heute ein gelegentlich verwendeter Ausdruck, sowohl für einzelne Wörter wie für Aussagen, wie man leicht im Internet nachvollziehen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
