                    {
                        "sense_id": "48ba9a05-fe9f-39c8-96e4-3f548554f45b",
                        "entry_id": "e8fb9dc8-e4a7-3c5c-8826-0437d35740a5",
                        "glosses": [
                            "ograniczenie praw"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "decd1a78-26e4-4cb4-9c2d-37e31308210e",
                                "sense_id": "48ba9a05-fe9f-39c8-96e4-3f548554f45b",
                                "text": "Okupant wprowadził restrykcje znacznie ograniczające swobody obywatelskie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf32d383-8cad-4ab3-87cd-537f2457ec60",
                        "source_entry_id": "e8fb9dc8-e4a7-3c5c-8826-0437d35740a5",
                        "source_sense_id": "48ba9a05-fe9f-39c8-96e4-3f548554f45b",
                        "target_lang_word": "restriction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restriction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d29225b-144b-3681-b9d5-d73c116d0097",
                                        "entry_id": "e3384978-7c60-3e48-856b-493f4ab5afcc",
                                        "glosses": [
                                            "The act of restricting, or the state of being restricted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10a094f8-9ef7-3304-b6e9-05c6d2f1695e",
                                        "entry_id": "e3384978-7c60-3e48-856b-493f4ab5afcc",
                                        "glosses": [
                                            "A regulation or limitation that restricts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa5b77b-48df-4059-aaa0-8637c68a32f4",
                                                "sense_id": "10a094f8-9ef7-3304-b6e9-05c6d2f1695e",
                                                "text": "In the year 1819, Sir Robert Peel brought in a bill, and which finally passed both houses, and received the royal assent on the 2nd July, for continuing the restrictions contained in several acts of parliament, on payments in cash by the bank of England, until the 1st day of May, 1823, and to provide for the gradual resumption of cash payments: [...] VIII. After the first day of May, 1822, the bank of England, if they shall think fit, may pay or exchange the lawful coin of the realm, for any of their own notes, payable on demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c6d7e5-c523-36c1-9fce-dba82335d392",
                                        "entry_id": "e3384978-7c60-3e48-856b-493f4ab5afcc",
                                        "glosses": [
                                            "The mechanism by which a cell degrades foreign DNA material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd527ec-2dc4-4094-990f-adf91199961a",
                                                "sense_id": "26c6d7e5-c523-36c1-9fce-dba82335d392",
                                                "text": "Echinorhagata is likewise supported by typical echinoderid autapomorphies, inclusive the number of trichoscalids that is reduced from 14 to 6; restriction of lateral accessory spines to females only; and an apparent restriction of the middorsal spines to appear only on segments 4 to 8."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c21bfadb-1c48-4b09-8d0f-89dabb855240",
                        "source_entry_id": "e8fb9dc8-e4a7-3c5c-8826-0437d35740a5",
                        "source_sense_id": "48ba9a05-fe9f-39c8-96e4-3f548554f45b",
                        "target_lang_word": "restriction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restriction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                        "entry_id": "25302fec-b21b-3795-b3d3-0ec0dc0b385f",
                                        "glosses": [
                                            "Condition qui restreint, modification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acaeaa4f-046c-476a-9843-41d712fc36ea",
                                                "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                                "text": "Michel avait douze ans, plus ou moins, quand leurs parents, qui pratiquaient la restriction des naissances, non de peur d’encombrer le monde, problème auquel ils ne pensaient guère, mais pour éviter d’avoir à diviser en trop de parts l’héritage, décidèrent de donner une remplaçante ou un remplaçant à leur aînée, morte à quatorze ans écrasée par un charroi sur la pente du Mont-Noir."
                                            },
                                            {
                                                "example_id": "4973ce3e-df34-4af6-a1fd-5f543f960737",
                                                "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                                "text": "Malgré les restrictions en vigueur, il n’a donc jamais été aussi important de bouger et les options demeurent nombreuses alors que l’hiver s’est installé pour de bon en vue des semaines à venir."
                                            },
                                            {
                                                "example_id": "d70b30cb-5bdb-479e-993a-f0daf9df3821",
                                                "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                                "text": "Mettre, apporter quelques restrictions."
                                            },
                                            {
                                                "example_id": "b43a3559-787f-4241-9e15-18d98732bb02",
                                                "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                                "text": "Cette mesure fut adoptée sans restriction."
                                            },
                                            {
                                                "example_id": "6ad894d7-bee6-4f72-81e3-aebf4893e1aa",
                                                "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                                "text": "Cette clause porte restriction."
                                            },
                                            {
                                                "example_id": "dd787a03-27d9-402e-8aff-5d7c735e6166",
                                                "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                                "text": "Se soumettre sans restriction et sans réserve."
                                            },
                                            {
                                                "example_id": "42d3e687-4c2d-4409-8749-9fcd46033327",
                                                "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                                                "text": "Restriction mentale, réserve, omission volontaire d’un détail, d’une circonstance essentielle susceptible d’induire en erreur ceux à qui on parle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66c4531-7b5b-32bf-acb8-1094d1b5fead",
                                        "entry_id": "25302fec-b21b-3795-b3d3-0ec0dc0b385f",
                                        "glosses": [
                                            "Mesures de diminution des dépenses privées ou publiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2651a21a-11f5-4e9a-bd33-7cf76102e63c",
                                                "sense_id": "f66c4531-7b5b-32bf-acb8-1094d1b5fead",
                                                "text": "S’imposer des restrictions."
                                            },
                                            {
                                                "example_id": "1eeef990-02c5-4433-8ae3-e4894dc431d0",
                                                "sense_id": "f66c4531-7b5b-32bf-acb8-1094d1b5fead",
                                                "text": "Nous sommes dans une période de restrictions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000cd4bf-ccc8-395f-80af-77e928cfbb88",
                                        "entry_id": "25302fec-b21b-3795-b3d3-0ec0dc0b385f",
                                        "glosses": [
