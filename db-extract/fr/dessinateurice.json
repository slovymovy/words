                "senses": [
                    {
                        "sense_id": "4801c28d-80f3-3877-a5fe-2071cddaf427",
                        "entry_id": "2babc02f-ad9d-30b6-a4a8-95ad8790ef80",
                        "glosses": [
                            "Personne non-binaire qui dessine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9bb6dd7-7447-46ce-897f-51634837bbf1",
                                "sense_id": "4801c28d-80f3-3877-a5fe-2071cddaf427",
                                "text": "Madison Bycroft est interprète, scénographe, dessinateurice industriel·le, sculpteurice, écrivain·e, joueureuse de tours, auteurice de limericks, orchestrateurice de medleys et instigateurice de rencontres, entre autres talents."
                            }
                        ]
                    },
                    {
                        "sense_id": "50fa2c55-142b-38fd-8cf5-7a90f45cbca2",
                        "entry_id": "2babc02f-ad9d-30b6-a4a8-95ad8790ef80",
                        "glosses": [
                            "Personne sans détermination de son genre qui dessine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ed1b1c-b7e5-48a9-9a91-0d46653dc218",
                                "sense_id": "50fa2c55-142b-38fd-8cf5-7a90f45cbca2",
                                "text": "Si vous voulez me faire plaisir, dessinez ce que vous avez entendu dans mes histoires, et envoyez-les moi (en me précisant si je peux les diffuser publiquement, et si oui, si je peux citer le prénom du ou de la dessinateurice)"
                            },
                            {
                                "example_id": "9725f1a8-470c-4382-a569-88fb952bae6e",
                                "sense_id": "50fa2c55-142b-38fd-8cf5-7a90f45cbca2",
                                "text": "J'ai vu passer ce questionnaire pour dessinateurice."
                            },
                            {
                                "example_id": "e3378443-726d-4eeb-8735-738aa6473d74",
                                "sense_id": "50fa2c55-142b-38fd-8cf5-7a90f45cbca2",
                                "text": "On imite Benzema dans la cour de récré quand on tire dans un ballon, on fait du playback devant son miroir comme Aya et on imite Pénélope Bagieu quand on dessine lorsqu’on veut devenir dessinateurice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99bbead7-e230-48f3-85d8-7842b1fd9cfe",
                        "source_entry_id": "2babc02f-ad9d-30b6-a4a8-95ad8790ef80",
                        "target_lang_word": "designer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "designer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd30b647-94ac-36ec-bb69-63e622827b46",
                                        "entry_id": "71cd0925-e35e-3a27-af05-5ddeefaf1194",
                                        "glosses": [
                                            "A person who designs something, or who designs things as a profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5299f0f-d90e-438c-9d4e-5ff249ba07b7",
                                                "sense_id": "fd30b647-94ac-36ec-bb69-63e622827b46",
                                                "text": "While the thought of a home urinal may seem vaguely “Animal House,” Mr. Scherer’s interior designer, Ashley Astleford, wasn’t surprised by his request. This was the second time in the last few months that she was asked to install a urinal in a luxury residential project, and she said she knows many other designers and architects who have been specifying home urinals in their projects."
                                            },
                                            {
                                                "example_id": "9188585e-0bef-40f3-8989-a28ab6269522",
                                                "sense_id": "fd30b647-94ac-36ec-bb69-63e622827b46",
                                                "text": "The ­festival, held every two years, showcases work by more than 180 designers across disciplines including textiles, homeware and more. […] “For us, it’s about getting design and creativity out into communities across the city. With the festival, we want to build capacity, grow skills, employ people and create opportunities to make a living from being a designer here.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8acb9737-be67-3ea0-ad82-5a4c8ad15ffa",
                                        "entry_id": "71cd0925-e35e-3a27-af05-5ddeefaf1194",
                                        "glosses": [
                                            "A plotter or schemer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "229f7a55-c562-354a-9795-a0e6e4b68bc6",
                                        "entry_id": "71cd0925-e35e-3a27-af05-5ddeefaf1194",
                                        "glosses": [
                                            "A software tool for designing things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8123108c-b97f-4c08-a8d3-8ed938b38573",
                                                "sense_id": "229f7a55-c562-354a-9795-a0e6e4b68bc6",
                                                "text": "a font designer"
                                            },
                                            {
                                                "example_id": "671d5f07-39b7-499d-b731-55a953dbefc6",
                                                "sense_id": "229f7a55-c562-354a-9795-a0e6e4b68bc6",
                                                "text": "a level designer for a video game"
                                            }
