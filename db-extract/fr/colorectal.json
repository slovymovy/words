                    {
                        "sense_id": "84522225-82bc-31f7-9aff-39021312b862",
                        "entry_id": "6e2209a0-d48c-3698-8f79-569009c5c000",
                        "glosses": [
                            "Relatif au côlon et au rectum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0e3444-5d9f-49ad-9a68-0ae673e49e3d",
                                "sense_id": "84522225-82bc-31f7-9aff-39021312b862",
                                "text": "Il est donc logique que plus la viande est riche en hème, en nitrites et plus elle est oxydée, plus les agents cancérigènes peuvent apparaître et agir sur la muqueuse colorectale."
                            },
                            {
                                "example_id": "4cbb32f5-58bb-4254-85f4-980ec7035a21",
                                "sense_id": "84522225-82bc-31f7-9aff-39021312b862",
                                "text": "Les effets sont plus rapides sur les cancers de l’œsophage, du pancréas, du cerveau et du poumon que sur ceux de l’estomac, de la prostate ou sur les cancers colorectaux."
                            },
                            {
                                "example_id": "48490bc7-efd9-4c74-aa3b-c67d52686c10",
                                "sense_id": "84522225-82bc-31f7-9aff-39021312b862",
                                "text": "Vous voyez, le cancer colorectal n’a même pas son propre ruban."
                            }
                        ]
                    }
                ],
