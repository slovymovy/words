                "senses": [
                    {
                        "sense_id": "591feb5f-098d-3371-83ab-69b54dbc9be5",
                        "entry_id": "99ecfd2c-ca68-3928-bc23-0d6599962cef",
                        "glosses": [
                            "Relatif à l’oreille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74da24a7-ba91-47af-b072-51ed865a9f77",
                                "sense_id": "591feb5f-098d-3371-83ab-69b54dbc9be5",
                                "text": "Vers la fin de la troisième semaine, un épaississement de l’ectoderme superficiel, appelé placode otique ou disque otique, apparaît près de la région de chaque pli neural du rhombencéphale (cerveau postérieur)."
                            },
                            {
                                "example_id": "150adcf3-0f90-421d-90cd-dd2eb994df56",
                                "sense_id": "591feb5f-098d-3371-83ab-69b54dbc9be5",
                                "text": "Cependant il paraît rejeter la communication entre le ganglion otique et le nerf acoustique par l’intermédiaire du nerf facial, ainsi que la communication du ganglion otique avec le grand-sympathique, par les rameaux nerveux de l’artère-épineuse."
                            },
                            {
                                "example_id": "14625ba9-b0c4-4971-ae0b-5cdc53ac2391",
                                "sense_id": "591feb5f-098d-3371-83ab-69b54dbc9be5",
                                "text": "Un barrotraumatisme otique est une lésion de l’oreille provoquée par un déséquilibre de pression entre l’air ambiant et l’air présent dans l’oreille moyenne."
                            }
                        ]
                    }
                ],
