                        ],
                        "examples": [
                            {
                                "example_id": "7663ac34-c30f-41b5-a7fb-06f4dec07cca",
                                "sense_id": "a12ce1d7-cb56-31f7-810a-1e3cd57015f3",
                                "text": "Il gribouillait parfois des cédules et les jetait en tas sur sa table, ou il les laissait tomber distraitement à terre, autour de son fauteuil."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9e60ee6-f8cd-356f-a217-c4535bd58317",
                        "entry_id": "5bf1bb52-9b19-38e0-bd47-e30795c0f92f",
                        "glosses": [
                            "Écrit portant citation devant un tribunal."
                        ],
                        "tags": [],
                        "examples": [
                            {
