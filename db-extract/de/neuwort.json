                ],
                "senses": [
                    {
                        "sense_id": "5e682361-5d1e-3942-b69f-9e5a005e28f1",
                        "entry_id": "240f397b-cf7e-3add-9aa6-594ca997d043",
                        "glosses": [
                            "Wort, das in der Sprache neu ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "461ebee8-34b7-4590-8a2e-c43a18f222b2",
                                "sense_id": "5e682361-5d1e-3942-b69f-9e5a005e28f1",
                                "text": "„Eine besondere Gruppe unter den Neuwörtern bilden die Lehnübersetzungen, also die Neuwörter, welche das Fremdwort wörtlich übersetzen […].“"
                            },
                            {
                                "example_id": "afe08ad0-8eb5-4e9a-bd72-de2a519e1a91",
                                "sense_id": "5e682361-5d1e-3942-b69f-9e5a005e28f1",
                                "text": "„In der Gefahr, dieser Regel zu widerstreben, stehen vor allem zwei Wortgruppen: die ‚Neologismen‘ (Neuwörter) und die ‚Archaismen‘ (veraltete Wörter).“"
                            },
                            {
                                "example_id": "c3bbfb12-c6a4-4a7c-b492-437e4b110dcd",
                                "sense_id": "5e682361-5d1e-3942-b69f-9e5a005e28f1",
                                "text": "„In dem Bestand der 6640 Neuwörter heben sich einige Wortgruppen deutlicher ab […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
