                            }
                        },
                        {
                            "text": "Elk jaar <w>tooi</w> ik de kerstboom met handgemaakte ornamenten.",
                            "target_lang_translations": {
                                "en": "Every year I <w>decorate</w> the Christmas tree with handmade ornaments."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'tooien' (to adorn, decorate)."
                    },
                    "translations": {
