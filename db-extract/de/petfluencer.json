                "senses": [
                    {
                        "sense_id": "a9a122c8-4772-3002-b2c4-f280a0efc384",
                        "entry_id": "5ffd4b60-cd1e-36ee-a219-e5d7a682d176",
                        "glosses": [
                            "Haustier, das von seinem Besitzer für die sozialen Medien fotografiert und/oder gefilmt wird und meist über einen eigenen Account verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52702b72-0501-4c80-8159-93f7f188d569",
                                "sense_id": "a9a122c8-4772-3002-b2c4-f280a0efc384",
                                "text": "„Es gibt sogar Petfluencer, die es geschafft haben, mit fantastischen Bildern ihrer Tiere unglaublich viele Follower zu gewinnen.“"
                            },
                            {
                                "example_id": "cb6f42ad-f21b-452c-a22e-6c83e60fc1c8",
                                "sense_id": "a9a122c8-4772-3002-b2c4-f280a0efc384",
                                "text": "„Die Inszenierung von Haustieren auf Social Media als sogenannte Petfluencer diene der menschlichen Selbstdarstellung, sagt Birgit Richard, Professorin für Neue Medien in Frankfurt: ‚Das kann auch punktuell als Machtmissbrauch gegenüber einem Lebewesen gedeutet werden.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5e6c2b6-e57b-47df-a724-90208f179d21",
                        "source_entry_id": "5ffd4b60-cd1e-36ee-a219-e5d7a682d176",
                        "source_sense_id": "a9a122c8-4772-3002-b2c4-f280a0efc384",
                        "source_sense_description": "Haustier, das von seinem Besitzer für die sozialen Medien fotografiert und/oder gefilmt wird",
                        "target_lang_word": "petfluencer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petfluencer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e117b6f-fc77-3121-84a8-9d40a8c61761",
                                        "entry_id": "d0f26253-263c-33c7-b3ab-6848236f5560",
                                        "glosses": [
                                            "An animal used as an influencer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d6bb28-4e52-40fb-8a8f-821b635ddbbf",
                                                "sense_id": "4e117b6f-fc77-3121-84a8-9d40a8c61761",
                                                "text": "That is why there are so many cat videos on the internet, creating cat celebrities and “petfluencers,” animals that help to sell products online."
                                            },
                                            {
                                                "example_id": "d76408a2-25f7-47f9-b1c4-951a1cda02aa",
                                                "sense_id": "4e117b6f-fc77-3121-84a8-9d40a8c61761",
                                                "text": "[…] And as you all know, petfluencers are increasingly attractive to film companies.' 'Wasn't there a hairless cat in an Austin Powers film once?' someone asks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eaa40a3-718c-34a7-ba2d-d4249b94ba8e",
                                        "entry_id": "d0f26253-263c-33c7-b3ab-6848236f5560",
                                        "glosses": [
                                            "A human influencer who uses an animal for this purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a93f88c1-68d0-46b1-b936-8e11e64d4f79",
                                                "sense_id": "2eaa40a3-718c-34a7-ba2d-d4249b94ba8e",
                                                "text": "You see, it's too late for me to become one of those 'petfluencers' – a tastemaker, babbling on about the latest trends in sundresses for coonhounds or why you should be using jewel-encrusted poop bags."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
