                        "examples": [
                            {
                                "example_id": "ee9eed50-2f53-4623-89eb-537c5c943b32",
                                "sense_id": "da8fb674-53db-3dce-ba67-ed7f0d2588df",
                                "text": "Peut-être dans celui de Mme de Guermantes pourrais-je voir de vraies fusées de pollen projetées par les fleurs anémophiles."
                            },
                            {
                                "example_id": "c873e68c-c876-4e1b-b6c9-b1e68d1dc4ed",
                                "sense_id": "da8fb674-53db-3dce-ba67-ed7f0d2588df",
                                "text": "[…] le peuplier qui confie son pollen au vent est anémophile."
                            },
                            {
                                "example_id": "f69bcc03-5b24-4221-8e38-505f360e377a",
                                "sense_id": "da8fb674-53db-3dce-ba67-ed7f0d2588df",
                                "text": "Essentiellement anémophile, la betterave est, qui plus est, une plante bisannuelle récoltée en fin de première année."
                            }
                        ]
                    }
