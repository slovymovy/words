                                        "entry_id": "5a3d4b84-e40b-3919-94da-be6760c1c35f",
                                        "glosses": [
                                            "Pieza cilíndrica de los aparatos de radio y televisión."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a73f78-ed59-4b65-a8d2-c4bf8a951667",
                                                "sense_id": "ffe48291-9560-3e57-b6f2-e571a2c928a3",
                                                "text": "Mi padre está reparando la radio porque el tubo está estropeado."
