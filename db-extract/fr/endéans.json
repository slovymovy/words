                                                "sense_id": "89e7dacb-ca76-3867-a816-d8d11ecb2095",
                                                "text": "within her studio"
                                            },
                                            {
                                                "example_id": "441ac616-db24-4ca7-9913-e266fd6df8e6",
                                                "sense_id": "89e7dacb-ca76-3867-a816-d8d11ecb2095",
                                                "text": "O God! can I not save / One from the pitiless wave? / Is all that we see or seem / But a dream within a dream?"
                                            },
                                            {
                                                "example_id": "76c08898-cce1-419d-8901-88224ff1d00f",
                                                "sense_id": "89e7dacb-ca76-3867-a816-d8d11ecb2095",
                                                "text": "The Rat[…] lightly stepped into a little boat which the Mole had not observed. It was painted blue outside and white within, and was just the size for two animals; and the Mole's whole heart went out to it at once[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47a53b48-bc13-3efe-8a76-9348124f987f",
                                        "entry_id": "91923abb-093b-3035-b4c6-0e9515bfa747",
                                        "glosses": [
