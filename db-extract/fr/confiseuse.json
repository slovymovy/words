                                    {
                                        "sense_id": "97bd8037-1baf-371b-bd05-126016a20d70",
                                        "entry_id": "71930e73-b7b7-391b-9488-825d8aaed72d",
                                        "glosses": [
                                            "Handwerkerin, die Süßgebäck, Konfekt, Speiseeis und Ähnliches herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e5e52a-e33d-40f9-9aed-78565bd83c28",
                                                "sense_id": "97bd8037-1baf-371b-bd05-126016a20d70",
                                                "text": "Mit ihrer neusten Kreation hat die junge Konditorin schon mehrere Preise gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
