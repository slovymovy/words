                "senses": [
                    {
                        "sense_id": "11f71916-6819-3953-8bcd-f9dc2dbef02a",
                        "entry_id": "b617518a-095e-38ee-8efc-a0dc735db0a0",
                        "glosses": [
                            "Secouer."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "215c5e75-1567-4334-84b4-3464922cde6a",
                                "sense_id": "11f71916-6819-3953-8bcd-f9dc2dbef02a",
                                "text": "Tu sais, Mimì, j’ai été gangassé, toute cette agitation, cette bousculade, je n’ai pas pinsé à t’avertir."
                            },
                            {
                                "example_id": "87fd10e8-e2fe-4fc2-a718-cbc6e1be4811",
                                "sense_id": "11f71916-6819-3953-8bcd-f9dc2dbef02a",
                                "text": "Dites, vous n'avez pas envie de le secouer, Ferri, de le gangasser?"
                            },
                            {
                                "example_id": "7f3a1d6d-49e7-4173-92d9-c6a2d43570a0",
                                "sense_id": "11f71916-6819-3953-8bcd-f9dc2dbef02a",
                                "text": "On arrive après s'être fait bien gangasser et on gare la méhari."
                            }
                        ]
                    }
