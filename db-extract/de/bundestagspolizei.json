                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b48dd8c5-aa6e-41db-8c62-1f407abba03e",
                                "sense_id": "abbc1632-768a-39b3-b751-1c4b92b7196d",
                                "text": "„Nach einem Gespräch mit Vertretern des Bundeskriminalamts, der Berliner Polizei und der Bundestagspolizei am vergangenen Freitag wurden die Sicherheitsmaßnahmen für die betroffenen Abgeordneten erhöht.“"
                            },
                            {
                                "example_id": "1c66a997-1435-4ddd-b6a9-5b37a5cd0fca",
                                "sense_id": "abbc1632-768a-39b3-b751-1c4b92b7196d",
                                "text": "„Für die Sicherheit innerhalb des Parlamentsgebäudes ist in Berlin die hauseigene Bundestagspolizei mit rund 180 Beamten zuständig.“"
                            }
                        ],
