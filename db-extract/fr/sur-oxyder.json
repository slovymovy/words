                "senses": [
                    {
                        "sense_id": "902b5eee-d25a-33a8-b00e-5888314bf47e",
                        "entry_id": "b8ffa75c-319a-3b45-8b30-ba6f2f0fef04",
                        "glosses": [
                            "Porter au plus haut degré d’oxydation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87f47b6-7682-4511-be1c-4fc72286d92b",
                                "sense_id": "902b5eee-d25a-33a8-b00e-5888314bf47e",
                                "text": "nᵒ 2 Qu’il peut être remplacé avantageusement par le carbonate ferreux donné en suspension et en solution dans l’eau, ou bien en pilules avec du miel, de manière à ne pouvoir se sur-oxyder, conformément à la prescription du docteur Vullet ;"
                            },
                            {
                                "example_id": "978aeef0-49ee-4cbb-addd-485ea2fa2506",
                                "sense_id": "902b5eee-d25a-33a8-b00e-5888314bf47e",
                                "text": "Cet acide analogue aux tannins a une grande propension à se sur-oxyder;"
                            },
                            {
                                "example_id": "ea699180-7a94-4d6d-9a0d-ac16d46ab103",
                                "sense_id": "902b5eee-d25a-33a8-b00e-5888314bf47e",
                                "text": "On grille aussi des oxydes pour leur ajouter de l’oxygène, les sur-oxyder, les per-oxyder, c’est-à-dire porter au maximum d’oxidation, ainsi qu’on en verra des exemples."
                            }
                        ]
                    }
