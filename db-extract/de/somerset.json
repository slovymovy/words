                            {
                                "example_id": "77abda53-a086-42b7-a66b-7d79e21be8c9",
                                "sense_id": "3e56eea3-40b1-3f80-9de3-c75e0138ce82",
                                "text": "„Zu jener Zeit hatten meine Vorfahren unter der Herrschaft Heinrichs VIII. als wohlhabende Landbesitzer und Männer von Stand in Somerset und Devon gelebt.“"
                            },
                            {
                                "example_id": "b548c07b-d9b7-43fb-ab4f-eceffe0b3196",
                                "sense_id": "3e56eea3-40b1-3f80-9de3-c75e0138ce82",
                                "text": "„1860 fuhr Inspector Jonathan Whicher vom Scotland Yard in den kleinen Ort Frome in Somerset, um wegen des Mordes an einem Baby namens Francis Kent aus einer prominenten Familie der Gegend zu ermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
