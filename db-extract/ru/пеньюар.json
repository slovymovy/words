                    },
                    {
                        "translation_id": "0e8f4543-d34b-4c79-a7bc-8fc33564ff12",
                        "source_entry_id": "e6887905-8f02-3bd4-ab9b-3ec6c6192050",
                        "target_lang_word": "peignoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peignoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Sorte de vêtement de dessus que l’on jette sur ses épaules, quand on fait sa toilette, quand on se peigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5d4651-e233-4e79-b04d-e3c0e3cc2c2b",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Liane s’était contentée d’un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s’appelle une canipette."
                                            },
                                            {
                                                "example_id": "f94020f8-3601-4738-80b1-356ad5080177",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Arlette a promis de décorer la table avec des fleurs. Aussi, le lendemain, dès l’aube, est-elle dans le jardin, en peignoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement à peu près semblable qu’on met en sortant du bain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492cd3ba-48df-45f4-9f73-4374d6e34c0a",
                                                "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                                "text": "J’attrapai un peignoir et décrochai le combiné fixé au mur, à côté des W-C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement d’intérieur ; déshabillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492ffe98-6b5b-4192-affa-d10375e828fc",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Une Liménienne déjeûne le matin, avec son mari en petit peignoir à la française, ses cheveux retroussés absolument comme nos dames de Paris."
                                            },
                                            {
                                                "example_id": "497a42e8-d545-448d-b9ef-8553e6aea31e",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Quand elle achetait soit des corsets, soit des peignoirs, soit des pantalons, elle voulait toujours que ce fût moi qui passasse avec elle dans la chambre au fond et qui les lui essayasse."
                                            },
                                            {
                                                "example_id": "0e0f74eb-dd6c-4d5d-8c39-d440ff18764c",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "[…] : pour peu qu’il y eût de l’électricité dans l’air ou que Och eût joué des parties du Vaisseau Fantôme, les Teutes s’assombrissaient, d’autres tentaient de s’aller coucher et chassées par l’insomnie revenaient en peignoir dans le petit salon des veillées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
