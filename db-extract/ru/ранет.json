                    },
                    {
                        "translation_id": "8a0c69ff-03c3-478a-96f4-ce1d09f36a06",
                        "source_entry_id": "53d4d027-84c4-3451-a18f-d0946256d578",
                        "target_lang_word": "renetta",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b41f9097-e7a9-41cb-ba5e-152ec648c977",
                        "source_entry_id": "53d4d027-84c4-3451-a18f-d0946256d578",
                        "target_lang_word": "reinette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reinette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                        "entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                                        "glosses": [
                                            "Pomme à peau tachetée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b830d21a-286f-4f16-8d43-1448f7b893c0",
                                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                                "text": "Dans le nombre des pommes, les seules bonnes à garder pour l’hiver sont : […] ; mais celles qui doivent avoir la préférence sur toutes les autres, ce sont les reinettes d’Angleterre dorées, les reinettes blanches, les reinettes du Canada, les reinettes franches, reinettes grises, reinettes grises de Ranville, qui résistent aux plus grands froids."
                                            },
                                            {
                                                "example_id": "89dfa48a-c620-4dfe-acb6-98c7ba750a81",
                                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                                "text": "elles étaient de peaux différentes, les pommes d’api au berceau, les rambourgs avachies, les calvilles en robe blanche, les canadas sanguines, les châtaigniers couperosées, les reinettes blondes, piquées de rousseur."
                                            },
                                            {
                                                "example_id": "da610a66-fb82-41f3-9363-65c7a05b6fec",
                                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                                "text": "Sa petite figure à poils rares et blonds, ridée et racornie comme une pomme de reinette, disparaissait sous un chapeau de toile cirée doublé de feutre ;"
                                            },
                                            {
                                                "example_id": "5368301d-6927-4f89-be95-03869d5566a9",
                                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                                "text": "Parfois la porte de l’école s’entrebâillait sur Mme Lévêque, douce et déjà ridée comme une reinette de décembre."
                                            },
                                            {
                                                "example_id": "a3db64fc-12f0-49ad-bf40-d192d77b6a4e",
                                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                                "text": "Reinette blanche, grise"
                                            },
                                            {
                                                "example_id": "64a1c98f-849a-4c94-bd32-8de433999266",
                                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                                "text": "Reinette d’Angleterre, du Canada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa3a3cf5-2dc5-3b4d-9725-eca0d379d516",
                                        "entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                                        "glosses": [
                                            "Une des espèces de petites grenouilles vertes (ou d'autres couleurs), souvent arboricoles, de la famille des hylidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c1dcb5e-95c0-4dc6-9817-47b2432ea10c",
                                                "sense_id": "aa3a3cf5-2dc5-3b4d-9725-eca0d379d516",
                                                "text": "Tout autour, le chant des reinettes emplissait la nuit d’une seule note liquide qui ne s’interrompait jamais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7480f34b-5a67-4c0b-89af-833d3c5c18cb",
                        "source_entry_id": "53d4d027-84c4-3451-a18f-d0946256d578",
                        "target_lang_word": "rainette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rainette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d60f7ba-bf20-3b36-842c-e078b2be5d7d",
                                        "entry_id": "f52fae7d-9d96-3ad1-b2fd-39a9804e55ee",
                                        "glosses": [
                                            "Une des espèces de petites grenouilles vertes (ou d'autres couleurs), souvent arboricoles, de la famille des Hylidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32b58690-4e08-4b65-9185-0a26db5dc3e5",
                                                "sense_id": "9d60f7ba-bf20-3b36-842c-e078b2be5d7d",
                                                "text": "Nous suivions le bord d’un canal où l’eau des pluies nourrissait les rainettes."
                                            },
                                            {
                                                "example_id": "6a22fd74-0d7b-45d0-b03d-bd0d7eea0470",
                                                "sense_id": "9d60f7ba-bf20-3b36-842c-e078b2be5d7d",
                                                "text": "J'effraye Michal comme on effraye une cousine en Normandie, avec l'aide d'une rainette, d'une araignée."
                                            },
                                            {
                                                "example_id": "88e28bd7-358a-4fb8-b46a-e8f0f3a7e987",
                                                "sense_id": "9d60f7ba-bf20-3b36-842c-e078b2be5d7d",
                                                "text": "Du jardin, les œillets de bordure envoyèrent une odeur très douce ; un chant de rossignol entra ; puis, du côté de l’étang, les rainettes commencèrent à se faire entendre et, bientôt, leurs voix innombrables furent partout."
                                            },
                                            {
                                                "example_id": "d7e46b14-0e2c-4f14-af4f-d6fa88cd7e41",
                                                "sense_id": "9d60f7ba-bf20-3b36-842c-e078b2be5d7d",
                                                "text": "Bientôt, en effet, les six gosses arrivés devant les roseaux de la rive et écarquillant les yeux, ne virent que l’eau ensoleillée, mais point de rainettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e81431a-8d2b-3112-8ea8-ab02ba252bb6",
                                        "entry_id": "f52fae7d-9d96-3ad1-b2fd-39a9804e55ee",
                                        "glosses": [
                                            "Outil de charpentier à pointe recourbée pour tracer des lignes ou encore pour redonner de la voie aux dents de scies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a3db18d-272a-4817-a4f0-0d7ed1526557",
                                                "sense_id": "3e81431a-8d2b-3112-8ea8-ab02ba252bb6",
                                                "text": "Si la piqûre de la zone antérieure a entamé l’os du pied, on enlève toutes les parties décollées de la sole, puis on rugine l’os avec une rainette et on panse avec de l'alcool phéniqué."
                                            },
                                            {
                                                "example_id": "11854b18-7b24-44c9-999d-32cb043c64f0",
                                                "sense_id": "3e81431a-8d2b-3112-8ea8-ab02ba252bb6",
                                                "text": "Lorsque sur l'épure on a marqué les axes (...); au moyen d'une série de signes conventionnels, on marque les renseignements secondaires, les vides, les coupes, les arasements, les assemblages, les portées, les étages, les faces, et tous ces signes sont tracés sur les parements avec le ciseau, la bisaiguë ou la rainette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55c581c-8fbe-36ae-af55-d099acc01bde",
                                        "entry_id": "f52fae7d-9d96-3ad1-b2fd-39a9804e55ee",
                                        "glosses": [
                                            "Nom populaire de différentes variétés de pommes d’hiver à peau grisâtre ou tachetée."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e33de8f-b80e-460a-b74c-d2b18763b210",
                                                "sense_id": "f55c581c-8fbe-36ae-af55-d099acc01bde",
                                                "text": "Rainette du Canada, rainette du Mans, rainette d’Angleterre..."
                                            },
                                            {
                                                "example_id": "4b885d40-4417-4357-a0d2-674d26d1c4ed",
                                                "sense_id": "f55c581c-8fbe-36ae-af55-d099acc01bde",
                                                "text": "À ne considérer que son visage, elle m’aurait plutôt rappelé une pomme de rainette conservée pendant l’hiver dans le grenier d’une sage ménagère."
                                            }
                                        ]
                                    }
                                ]
                            },
