                "senses": [
                    {
                        "sense_id": "501f6834-25aa-38e8-9877-01a0581e5178",
                        "entry_id": "64519c8d-f81c-3218-8cc4-01938b258ed8",
                        "glosses": [
                            "Licher, boire, à petits coups."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c1e208-dad9-46ed-a719-824c7d0535e1",
                                "sense_id": "501f6834-25aa-38e8-9877-01a0581e5178",
                                "text": "Bébé qui lichote, qui lichaille, qui lichecaille, qui lichetrogne, dans une confusion radieuse, un contentement inépuisable."
                            },
                            {
                                "example_id": "9bd92f8d-4db8-4c06-b4a0-ef55bd22d8e8",
                                "sense_id": "501f6834-25aa-38e8-9877-01a0581e5178",
                                "text": "On va trimballer sa blonde, mon vieux ; nous irons lichoter un rigolboche à la place Pinel, puis dame, après cela, nous verrons."
                            }
                        ]
                    }
