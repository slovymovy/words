                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce jeu de société, une pièce dorée <w>vaut</w> dix pièces en argent."
                        },
                        {
                            "text": "Le silence du directeur <w>vaut</w> accord pour lancer notre projet."
                        }
                    ],
                    "synonyms": [
