                ],
                "senses": [
                    {
                        "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                        "entry_id": "bcaaceb6-f7fc-36cd-85cc-53fcef0f3e75",
                        "glosses": [
                            "Produkt, das der Säuberung oder Pflege des menschlichen Körpers dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aef2ddd-a9bb-46ec-83d7-2a56c19e3407",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "[COVID-19-Pandemie in Deutschland, 2020 und 2021:] „Hygieneartikel wie Toilettenpapier waren äußerst stark nachgefragt und vielerorts ausverkauft.“"
                            },
                            {
                                "example_id": "467f4fba-5c87-4a43-9522-5b33848cf311",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Angesichts der Versorgungskrise in Kuba will die sozialistische Regierung künftig Lebensmittel und Hygieneartikel begrenzen.“"
                            },
                            {
                                "example_id": "cd7196d3-36e7-4286-90d4-cd3c3cdeb373",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Wie andere Hygieneartikel können Tampons Verstopfungen im Abwassersystem verursachen, da sie sich nicht zersetzen, daher sollten sie nicht über die Toilette entsorgt werden.“"
                            },
                            {
                                "example_id": "6893ba0e-e95c-4e7d-8b31-5d845a637038",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "[Binden, Tampons:] „Hinzu kommt, dass für die Herstellung der kommerziellen Hygieneartikel chemische Inhaltsstoffe wie zum Beispiel Duft- und Farbstoffe verwendet werden, auf die viele Frauen allergisch reagieren.“"
                            },
                            {
                                "example_id": "a92f91bd-dd90-485f-abb9-71e61bafff93",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Vielerorts wird bereits seit einiger Zeit über kostenlose Hygieneartikel an Schulen diskutiert.“"
                            },
                            {
                                "example_id": "92c969b6-c730-428c-baf3-69d758fe2a81",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Im Vereinigten Königreich lebt rund ein Fünftel aller Menschen in Armut. Gemäss einer Untersuchung von «Plan International» hat jedes zehnte Mädchen nicht genügend Geld für die monatlichen Hygieneartikel.“"
                            },
                            {
                                "example_id": "f6c3581c-d67f-45c4-9f86-fbf73868dc44",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Während in Schottland kostenlose Hygieneartikel längst Standard sind, bleiben sie in Deutschland die Ausnahme.“"
                            },
                            {
                                "example_id": "7f5453bd-a0f9-4b27-b3df-38720cb73c2d",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Einzelne Städte und Kantone stellen bereits heute in Schulen gratis Hygieneartikel zur Verfügung. Zum Beispiel die Städte Zürich, Basel und Genf oder die Westschweizer Kantone Waadt und Jura.“"
                            },
                            {
                                "example_id": "071caa40-afb8-4f4a-ae44-4664066a53d3",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Leipzig hat bereits 74 Schulen mit kostenlosen Hygieneartikeln ausgestattet.“"
                            },
                            {
                                "example_id": "582aa838-4520-4016-bcb2-43ed1dec373a",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„»Jede menstruierende Person benötigt Periodenprodukte. Aber nicht jede kann sich diese Hygieneartikel - insbesondere nachhaltige und daher oft hochpreisige Produkte - leisten«, erklärt Lena Schützle, die stellvertretende Frauenbeauftragte der Hochschule.“"
                            },
                            {
                                "example_id": "49131482-c9bc-4161-885a-8c2575774e9a",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„In Großbritannien feiert David Cameron sich aktuell für die komplette Aufhebung der Mehrwehrtsteuer auf Hygieneartikel.“"
                            },
                            {
                                "example_id": "e1311090-3e42-48d5-ab43-00f8eac51ef9",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„In anderen Ländern wie Indien, Irland, Kenia oder Kanada entfallen zumindest keine Steuern mehr auf die grundlegenden Hygieneartikel.“"
                            },
                            {
                                "example_id": "fd8f1b3c-c02d-47fd-8f45-0c6095257be9",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "[29.8/.2024: Nach Plänen der Regierung sollen Migranten künftig] „weder Geld noch eine Geldkarte erhalten, sondern nur das Nötigste wie Unterkunft, Verpflegung und Hygieneartikel.“"
                            },
                            {
                                "example_id": "fda41846-5aee-4fec-8a9d-3a1ec7856c0b",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Eine warme Mahlzeit, Kleidung, Hygieneartikel: All das wird regelmäßig von Vereinen und Initiativen am Hamburger Hauptbahnhof an Bedürftige verteilt.“"
                            },
                            {
                                "example_id": "2b46c1e6-f8bd-4def-8382-3ead40690df1",
                                "sense_id": "e4190de3-e395-35bc-856e-73f9591d7ced",
                                "text": "„Sie leben in schmutzigen undichten Hütten ohne jeglichen Zugang zu Hygieneartikeln oder Medizin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
