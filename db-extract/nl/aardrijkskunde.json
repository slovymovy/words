                                        ]
                                    },
                                    {
                                        "sense_id": "8b382bd4-3b75-3fbe-b5e1-2738e37a3895",
                                        "entry_id": "ca220a5b-2d77-3da0-abba-bea1ee64364c",
                                        "glosses": [
