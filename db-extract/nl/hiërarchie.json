                    },
                    {
                        "form_id": "8f5ba357-3500-48cc-ab05-1f89d65916c3",
                        "entry_id": "3d4c15e6-0773-3560-b0d1-831ef5ea5975",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "hiërarchietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24a96662-cb83-3a91-84c3-4d36e5c9ecdd",
                        "entry_id": "3d4c15e6-0773-3560-b0d1-831ef5ea5975",
                        "glosses": [
                            "rangorde (van waardigheidsbekleders)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "792ffedf-8759-4f79-aedb-76f69aebe003",
                                "sense_id": "24a96662-cb83-3a91-84c3-4d36e5c9ecdd",
                                "text": "Daardoor kwam de verantwoordelijkheid voor het huis en het land ook grotendeels neer op de schouders van de kamerheer. Geoffrey Poke had zich al stevig geïnstalleerd aan de top van de hiërarchie van de bedienden toen Emont lord werd, en de combinatie van Geoffreys zucht naar macht en Emonts desinteresse gaf hem de gelegenheid om zijn positie verder uit te breiden."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc14bc82-9a9b-3776-a73a-3751096b4952",
                        "entry_id": "3d4c15e6-0773-3560-b0d1-831ef5ea5975",
                        "glosses": [
                            "indeling in volgorde van belangrijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49be1576-b09e-4c33-a884-39f82599eed0",
                                "sense_id": "dc14bc82-9a9b-3776-a73a-3751096b4952",
                                "text": "een hiërarchie kan worden weergegeven met een structuur die lijkt op een boomstructuur"
                            },
                            {
                                "example_id": "78eb397c-5a1f-4a35-bbce-31235fea7077",
                                "sense_id": "dc14bc82-9a9b-3776-a73a-3751096b4952",
                                "text": "Die overdreven voorliefde voor het gezag had ze van haar vader, adjunct van het plaatsvervangend afdelingshoofd bij het ministerie van Posterijen, die de hiërarchie binnen zijn ministerie zag als een metafoor voor het universum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4983628e-f214-4c2f-b292-a8ea3552c31f",
                        "source_entry_id": "3d4c15e6-0773-3560-b0d1-831ef5ea5975",
                        "source_sense_id": "24a96662-cb83-3a91-84c3-4d36e5c9ecdd",
                        "source_sense_description": "rangorde",
                        "target_lang_word": "Hierarchie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hierarchie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "016f454a-6597-3cf1-ade5-a197e5b7151a",
                                        "entry_id": "76b5f2e7-69a7-341e-a69a-ab7fd3910eae",
                                        "glosses": [
                                            "System von Über- und Unterordnung; strenge Rangordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561dc8f8-819c-49d1-a5ed-01158bcfa28a",
                                                "sense_id": "016f454a-6597-3cf1-ade5-a197e5b7151a",
                                                "text": "Die Bundeskanzlerin steht in der politischen Hierarchie ganz oben."
                                            },
                                            {
                                                "example_id": "f5eb9f75-026a-4c1b-9d21-ce1fea6c9836",
                                                "sense_id": "016f454a-6597-3cf1-ade5-a197e5b7151a",
                                                "text": "„Ihre Hierarchie ist fester als die eines Generalstabs.“"
                                            },
                                            {
                                                "example_id": "d7f1c867-e160-435f-9e3c-12de241b8eb4",
                                                "sense_id": "016f454a-6597-3cf1-ade5-a197e5b7151a",
                                                "text": "„Die Markierung von Hierarchie in der Anrede ist in der Kongregation kaum ausgebildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95e5f56d-375a-490b-97a2-15019e6a5871",
                        "source_entry_id": "3d4c15e6-0773-3560-b0d1-831ef5ea5975",
                        "source_sense_id": "24a96662-cb83-3a91-84c3-4d36e5c9ecdd",
                        "source_sense_description": "rangorde",
                        "target_lang_word": "hierarchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hierarchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "421d80c3-9ca0-324f-ac8c-86377b81d273",
                                        "entry_id": "7fffa9c8-1813-373f-8912-4dc490cbe41e",
                                        "glosses": [
                                            "A body of authoritative officials organized in nested ranks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24af331-a4ae-4c5d-9264-378e4abb4826",
                                                "sense_id": "421d80c3-9ca0-324f-ac8c-86377b81d273",
                                                "text": "Gay men and bisexuals were blamed for the [AIDS] epidemic for much the same reason that the church hierarchy in the Middle Ages accused Jewish people of creating bubonic plague by \"poisoning the wells.\""
                                            },
                                            {
                                                "example_id": "2bb11d8a-5cfc-4c12-8a3c-3c02b1cae9c3",
                                                "sense_id": "421d80c3-9ca0-324f-ac8c-86377b81d273",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baf237b0-63c4-347a-8b2d-0280fd3ccd8c",
                                        "entry_id": "7fffa9c8-1813-373f-8912-4dc490cbe41e",
                                        "glosses": [
                                            "A social, religious, economic or political system or organization in which people or groups of people are ranked with some superior to others based on their status, authority or some other trait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b2242d-8aec-4666-bb88-794c4d1b4000",
                                                "sense_id": "baf237b0-63c4-347a-8b2d-0280fd3ccd8c",
                                                "text": "Social defeat arises in strict social hierarchies in which the few dominate the many. Overcrowding exacerbates the many ills of social defeat within these social hierarchies based on dominance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39c61e6f-ef7f-312e-86fb-f4daaf84d2a4",
                                        "entry_id": "7fffa9c8-1813-373f-8912-4dc490cbe41e",
                                        "glosses": [
                                            "Any group of objects ranked so that every one but the topmost is subordinate to a specified one above it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b43778a-11c6-4469-8e4a-6f281b7442cd",
                                                "sense_id": "39c61e6f-ef7f-312e-86fb-f4daaf84d2a4",
                                                "text": "... the surviving portions provide enough detail to outline its principal features: the hierarchy of beings to whom his liturgy was to be addressed (we previously considered Plethon's hierarchy of gods in our examination of his Summary[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08a0a21f-6e11-4f11-9256-b070eddbc81b",
                        "source_entry_id": "3d4c15e6-0773-3560-b0d1-831ef5ea5975",
                        "source_sense_id": "24a96662-cb83-3a91-84c3-4d36e5c9ecdd",
                        "source_sense_description": "rangorde",
                        "target_lang_word": "hiérarchie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiérarchie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "146c356c-0403-3ada-91aa-c84b34f54d01",
                                        "entry_id": "cca6ba37-d81d-3255-bb8d-6a423ce27272",
                                        "glosses": [
                                            "Organisation qui précise les relations ascendantes de pouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5186959-7330-4c6c-96da-61c19dae399d",
                                                "sense_id": "146c356c-0403-3ada-91aa-c84b34f54d01",
                                                "text": "Au milieu du siècle dernier, on traitait de songe-creux et de lunatiques ceux qui prétendaient aplanir les hiérarchies traditionnelles et renverser même la personne du Roi."
                                            },
                                            {
                                                "example_id": "9e6a7064-a7b0-418d-91e7-5adb612e49bc",
                                                "sense_id": "146c356c-0403-3ada-91aa-c84b34f54d01",
                                                "text": "Les Bureaux arabes ont sous leur direction une hiérarchie administrative d'agents locaux à leur solde : 8 khalifas ,8 bachagas, 34 aghas et 656 caïds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "423c1312-e208-370b-8477-2f46b4493997",
                                        "entry_id": "cca6ba37-d81d-3255-bb8d-6a423ce27272",
                                        "glosses": [
                                            "Ordonnancement d’un ensemble grâce à une relation d’ordre dans laquelle chaque élément est supérieur au suivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ecd2469-f39a-460b-8a26-76d7133611d0",
                                                "sense_id": "423c1312-e208-370b-8477-2f46b4493997",
                                                "text": "La hiérarchie des valeurs ou des sentiments."
                                            },
                                            {
                                                "example_id": "512f9913-52b2-402a-bf6c-5a278b2c3708",
                                                "sense_id": "423c1312-e208-370b-8477-2f46b4493997",
                                                "text": "Le général est le sommet de la hiérarchie des grades militaires."
                                            },
                                            {
                                                "example_id": "db6d3781-c8d3-41b3-b618-51cc08f78512",
                                                "sense_id": "423c1312-e208-370b-8477-2f46b4493997",
                                                "text": "Même quand la besogne agricole est extrêmement lucrative, beaucoup de Français, lâchant la proie pour l'ombre, ont tendance à la fuir, croyant ainsi monter dans la hiérarchie sociale."
                                            },
                                            {
                                                "example_id": "8a07cd63-7c4e-4f3a-9f75-8e1ab698fe64",
                                                "sense_id": "423c1312-e208-370b-8477-2f46b4493997",
                                                "text": "Nous n’aimons guère ce mot de hiérarchie : nous y lisons un inégalité de fait. Louis Dumont fait comprendre que non seulement il n’y a pas de vie sociale sans hiérarchie, mais qu’il n’y a pas de vie intellectuelle qui n’appelle une hiérarchie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a92266d-e1ef-3721-a7d5-08d24bc1d8b8",
                                        "entry_id": "cca6ba37-d81d-3255-bb8d-6a423ce27272",
                                        "glosses": [
                                            "Ordre et subordination des neuf chœurs des anges, qui constituent l'ensemble des purs esprits."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6194326e-40be-41f1-9f7e-6c9984111880",
                                                "sense_id": "0a92266d-e1ef-3721-a7d5-08d24bc1d8b8",
                                                "text": "Afin d’en finir avec cette orfèvrerie symbolique, disons encore que la série des pierres servit à commémorer chacune des hiérarchies des Anges."
                                            },
                                            {
                                                "example_id": "ffe69d97-af2b-4e53-9b62-68d0f3c7a03b",
                                                "sense_id": "0a92266d-e1ef-3721-a7d5-08d24bc1d8b8",
                                                "text": "Les catholiques ne se sont jamais découragés au milieu des épreuves les plus dures, parce qu'ils se représentaient l'histoire de l'Église comme étant une suite de batailles engagées entre Satan et la hiérarchie soutenue par le Christ."
                                            },
                                            {
                                                "example_id": "e4b63390-939a-4b4a-9a94-f6e08d58488b",
                                                "sense_id": "0a92266d-e1ef-3721-a7d5-08d24bc1d8b8",
                                                "text": "Dès le principe donc, c'est la négation du cosmos avicennien. Les conséquences vont de soi : la multiplication des êtres célestes et de leurs hiérarchies n'a plus de raison d'être « nécessaire »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8717393f-c77b-3a7a-ac43-007f6c9e03c4",
                                        "entry_id": "cca6ba37-d81d-3255-bb8d-6a423ce27272",
                                        "glosses": [
                                            "Ordre et subordination des divers degrés de l’état ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c62e2f2-3eb8-4920-9f22-fb2999273453",
                                                "sense_id": "8717393f-c77b-3a7a-ac43-007f6c9e03c4",
                                                "text": "Le pape est le sommet de la hiérarchie de l’église catholique romaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b940dc4b-ab1e-3e5e-bdeb-57d7787d52d4",
                                        "entry_id": "cca6ba37-d81d-3255-bb8d-6a423ce27272",
                                        "glosses": [
                                            "Ensemble des personnes dotées d’une autorité au sein d’une société."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
