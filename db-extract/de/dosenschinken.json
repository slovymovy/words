                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91b7d504-d64b-4c95-be84-e48e24497a74",
                                "sense_id": "16cfb9f4-35b7-3347-a78c-267aa5747cff",
                                "text": "„Unter dem Geschenkpapier kam eine Packung Dosenschinken zum Vorschein.“"
                            },
                            {
                                "example_id": "0549d9c9-876f-4066-9300-a6c4ae0e9940",
                                "sense_id": "16cfb9f4-35b7-3347-a78c-267aa5747cff",
                                "text": "„Während ich den Dosenschinken mampfte und mich gelegentlich mit heißem Tee aus der Thermoskanne stärkte, denn wir uns jeden Morgen beim Frühstück zubereiteten, hantierte ich unsicher mit den Hebeln.“"
                            },
                            {
                                "example_id": "e3d333fc-1516-4e4d-95de-d6aaac93be80",
                                "sense_id": "16cfb9f4-35b7-3347-a78c-267aa5747cff",
                                "text": "„Kiste auf Kiste mit Konserven. Tomaten, Pfirsiche, Bohnen, Aprikosen. Dosenschinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
