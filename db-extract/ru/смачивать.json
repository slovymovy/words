                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7554a3-59b2-4c63-a64b-d5eafa23152c",
                                "sense_id": "93b320b0-4c05-37c3-9b87-01b60409f0b8",
                                "text": "Кроме того, палубу смачивали водой и над головой растягивали тент."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0550dfc7-a73b-4acd-9c12-2efa0f1f9ed7",
                        "source_entry_id": "b43d8323-2d3d-3a86-af52-8aecaea3d9f8",
                        "source_sense_id": "93b320b0-4c05-37c3-9b87-01b60409f0b8",
                        "target_lang_word": "humidifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humidifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                        "entry_id": "33b852e4-cde0-3c28-8432-c6c9ae67a1ac",
                                        "glosses": [
                                            "Rendre humide, ou plus humide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f69490e8-d813-4a17-9fee-cfa0877c002c",
                                                "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                                "text": "Je pris l'habitude, à l'imitation des goumiers et des bellahs, d'aller pisser accroupi, à flanc de dune, pour parer au risque de m’humidifier le saroual par vent tourbillonnant et parce qu'en terre d'Islam, ce besoin est à satisfaire discrètement."
                                            },
                                            {
                                                "example_id": "dc6cc5a1-d483-409a-8c44-5845ded5bbf0",
                                                "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                                "text": "En glissant vers le sud, ces vents se tropicalisent et s’humidifient sur la mer de Chine méridionale entraînant de fortes pluies sur les côtes est et nord de l’ensemble régional."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "498585dd-ab46-4377-a006-a3933df2ba0c",
                        "source_entry_id": "b43d8323-2d3d-3a86-af52-8aecaea3d9f8",
                        "source_sense_id": "93b320b0-4c05-37c3-9b87-01b60409f0b8",
                        "target_lang_word": "mouiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mouiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c4ff11-f264-3ab1-8671-94f989c39f5c",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Rendre humide, imbiber un objet de liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "530fae7a-3bff-4d0c-9809-dafa1e00f727",
                                                "sense_id": "a8c4ff11-f264-3ab1-8671-94f989c39f5c",
                                                "text": "Attablé, il expliqua à ses commensaux qu'il avait mouillé ses souliers en cheyant dans un fossé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8c18dc-37b6-3e61-9ebe-a5d59855dbbb",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Ajouter du liquide (comme de l’eau, du lait ou du bouillon) à une sauce, ou à un plat qui a commencé à cuire sans eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420aa149-6fa5-4686-a0a7-27dcc8053be7",
                                                "sense_id": "cb8c18dc-37b6-3e61-9ebe-a5d59855dbbb",
                                                "text": "Je les fais revenir dans un sautoir avec du beurre, puis je les mouille avec le bouillon des cosses."
                                            },
                                            {
                                                "example_id": "f7488ca3-2038-42eb-a8fb-d7d7286764f6",
                                                "sense_id": "cb8c18dc-37b6-3e61-9ebe-a5d59855dbbb",
                                                "text": "Au bout de 5 min, déglacez au vinaigre de cidre, puis mouillez votre bouillon en ajoutant un L d’eau (idéalement 1 L de bouillon végétal, réalisé au préalable avec les épluchures des légumes pour avoir un goût plus profond."
                                            },
                                            {
                                                "example_id": "9f765df1-23ba-4496-9179-dd37153d1c40",
                                                "sense_id": "cb8c18dc-37b6-3e61-9ebe-a5d59855dbbb",
                                                "text": "D’ailleurs, aucun raffinement, du vin au litre, que les convives mouillaient beaucoup, par discrétion, pour ne pas pousser à la dépense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "299cef48-876d-3c43-ab9c-07835a0c9a74",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Mettre à l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbeac95-ab8f-4229-ad28-c5fb9603cb3f",
                                                "sense_id": "299cef48-876d-3c43-ab9c-07835a0c9a74",
                                                "text": "Le bateau raidissant sa chaîne cassa ses bosses ; le frein du guindeau se rompit ; il fallu mouiller la seconde ancre pour pouvoir le réparer."
                                            },
                                            {
                                                "example_id": "67b93450-81df-4719-8300-436fc81f9ff1",
                                                "sense_id": "299cef48-876d-3c43-ab9c-07835a0c9a74",
                                                "text": "Derrière la jetée je mouillais mes ancres, ayant couvert, en trente-trois jours, les dix-huit cents milles qui me séparaient des îles Bermudes."
                                            },
                                            {
                                                "example_id": "10747d3e-f958-4bc2-8f36-ea1401a4f4dc",
                                                "sense_id": "299cef48-876d-3c43-ab9c-07835a0c9a74",
                                                "text": "Mouiller une mine, mouiller une ligne pour pêcher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912341e0-a587-32ac-935f-cfa033c38f86",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Compromettre, mettre en cause, impliquer (parfois contre sa volonté)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fbce46d-90dc-4943-bc40-fc4291de4f0e",
                                                "sense_id": "912341e0-a587-32ac-935f-cfa033c38f86",
                                                "text": "On l’a mouillé dans une sale affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13e52e46-e958-3771-9beb-1571fa70e86c",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Palataliser, en parlant d'une consonne."
                                        ],
                                        "tags": [
                                            "Phonétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d228e48-905a-4df4-8f07-ec13df3f2d69",
                                                "sense_id": "13e52e46-e958-3771-9beb-1571fa70e86c",
                                                "text": "Il affirme tout simplement qu'on disait paller, mellan, Challot, etc. ; d'où je conclus que l redoublée ne se mouillait pas toujours."
                                            },
                                            {
                                                "example_id": "4799412b-2bc2-42c5-8434-6b035fe6fdb6",
                                                "sense_id": "13e52e46-e958-3771-9beb-1571fa70e86c",
                                                "text": "Elle s'exprimait avec un accent qui mouillait les consonnes et la faisait sourire comme si elle cherchait à se faire pardonner ses maladresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ffa7008-84d3-34aa-a93e-065f9864448a",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Jeter l’ancre, s’arrêter ou être ancré par opposition à être en déplacement."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31864f53-df7b-418d-930e-33ab7ad1c142",
                                                "sense_id": "9ffa7008-84d3-34aa-a93e-065f9864448a",
                                                "text": "Le 10 février 1606, il fit mouiller un brigantin dans un de ses ports."
                                            },
                                            {
                                                "example_id": "b4c368f1-8c0c-4153-9c52-dd3e2aa1a1a7",
                                                "sense_id": "9ffa7008-84d3-34aa-a93e-065f9864448a",
                                                "text": "L’anse où nous mouillons est évidemment un ancien cratère dans l’intérieur duquel la mer a fait irruption."
                                            },
                                            {
                                                "example_id": "0dda0d55-0841-4eaa-9019-c363f1c93730",
                                                "sense_id": "9ffa7008-84d3-34aa-a93e-065f9864448a",
                                                "text": "La rade de Casablanca — nous l'avons vu déjà — n'est pas idéale; tant s'en faut. Les vapeurs y mouillent à un mille ou un mille et demi, les voiliers, à plus de deux milles de terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e866a4ba-192e-301b-9fe5-baca9dd3b08c",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Pleuvoir. (Note : dans ce cas le verbe est défectif comme pleuvoir.)"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d22d03ac-09b9-4cfb-9744-a6c363d89830",
                                                "sense_id": "e866a4ba-192e-301b-9fe5-baca9dd3b08c",
                                                "text": "Miss Météo dit qu'y va mouiller toute la fin de semaine."
                                            },
                                            {
                                                "example_id": "0ded5ecd-a444-48fc-a0e6-adb46916ecb2",
                                                "sense_id": "e866a4ba-192e-301b-9fe5-baca9dd3b08c",
                                                "text": "— Le vent tourne au sudet. Blasphème ! Il va mouiller encore, c’est clair, disait Edwige Légaré d’un air sombre."
                                            },
                                            {
                                                "example_id": "d9d58b8a-f2d6-489b-a536-9355d24dd05e",
                                                "sense_id": "e866a4ba-192e-301b-9fe5-baca9dd3b08c",
                                                "text": "Qu'il tombe des cordes ou qu'll bruine, qu'il drache ou qu'il gouttine, ça mouille !"
                                            },
                                            {
                                                "example_id": "60d302f2-041a-4a60-b10b-75d4a32c5fb7",
                                                "sense_id": "e866a4ba-192e-301b-9fe5-baca9dd3b08c",
                                                "text": "Il pleut il mouille,\nc'est la fête à la grenouille"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2165637-12f9-3f5a-842d-7a41074aa8c6",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "Avoir peur, par allusion à l’incontinence qui accompagne les grandes frayeurs."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ddc172-1300-4441-814d-a9bc2c3687ac",
                                                "sense_id": "b2165637-12f9-3f5a-842d-7a41074aa8c6",
                                                "text": "Il n’ose pas lui dire, il mouille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a7131a-dd58-3460-9c1a-b90b6501e419",
                                        "entry_id": "7e636114-ca2a-3cd4-b870-c6e6c1006471",
                                        "glosses": [
                                            "En parlant d’une femme, humecter la vulve avec des sécrétions vaginales lubrifiantes provoquées par l’excitation sexuelle ; en parlant d’un homme : secréter du liquide séminal à la suite de l’excitation sexuelle."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c293decb-ada4-4c08-bf55-633b0db0941d",
                                                "sense_id": "f2a7131a-dd58-3460-9c1a-b90b6501e419",
                                                "text": "Le plus beau con de la famille, c’est le sien ; et je mouille pour elle quand elle ôte sa chemise, moi qui ne suis pas gousse, moi qui aime la queue."
                                            },
                                            {
                                                "example_id": "d19c2a4b-043d-4f1a-9881-ddbbe75f78b5",
                                                "sense_id": "f2a7131a-dd58-3460-9c1a-b90b6501e419",
                                                "text": "Adèle mouille d’amour et de désir, elle veut maintenant son élixir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
