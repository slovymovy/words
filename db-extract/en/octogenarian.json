                                        "examples": [
                                            {
                                                "example_id": "b9acf987-f7f1-4950-8a78-1ebf38249846",
                                                "sense_id": "24ff28d3-f0e7-32ee-b08e-090137040d54",
                                                "text": "Die achtzigjährigen Bauarbeiten sind immer noch nicht abgeschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
