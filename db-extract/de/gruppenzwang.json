                        "source_sense_description": "Zwang, der von einer Gruppe ausgeht; von oder durch eine Gruppe ausgelöst wird",
                        "target_lang_word": "peer pressure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peer pressure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df492350-17fe-39a9-a348-6d5f48d0c184",
                                        "entry_id": "2abdff2f-0c1b-3728-853b-4578b4f9fb65",
                                        "glosses": [
                                            "Inducement or influence by one's peers."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde57214-7f2f-4b31-a207-e63cc4d2b089",
                                                "sense_id": "df492350-17fe-39a9-a348-6d5f48d0c184",
                                                "text": "She vowed to give up drinking during the exam period, but eventually succumbed to peer pressure and was out drinking with her friends within a week of the resolution."
                                            },
                                            {
                                                "example_id": "ae1fe98d-23e0-406d-b34b-2ee86e133767",
                                                "sense_id": "df492350-17fe-39a9-a348-6d5f48d0c184",
                                                "text": "A successful response uses social forces such as peer pressure and altruism to help people adapt to changing circumstances. It delivers messages and support that promote self-reliance rather than encourage people to fall back on stressed state support."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peer pressure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
