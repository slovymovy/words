                "senses": [
                    {
                        "sense_id": "51214a1d-fb71-3d5c-9d7b-6322206dbdfd",
                        "entry_id": "b50d8511-45f9-30bf-b278-c0c84a3eeac3",
                        "glosses": [
                            "Employé du téléphone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "886dc2c8-f059-4a69-a4a5-7cb95ef71f20",
                                "sense_id": "51214a1d-fb71-3d5c-9d7b-6322206dbdfd",
                                "text": "À six heures nous rejoignons au jardin du couvent les téléphonistes."
                            },
                            {
                                "example_id": "221df3e4-3de4-4442-8927-808a6fe0bb7b",
                                "sense_id": "51214a1d-fb71-3d5c-9d7b-6322206dbdfd",
                                "text": "Notre esprit est toujours comme à la merci d’un téléphoniste farceur, —de préférence, il est vrai, une demoiselle du téléphone,— qui lui branche la communication avec n’importe qui, n’importe quoi […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a45cb2bd-cc08-3813-94bf-3e773f3c9835",
                        "entry_id": "b50d8511-45f9-30bf-b278-c0c84a3eeac3",
                        "glosses": [
                            "Premier répondant à un appel téléphonique, lors d’une communication avec une entreprise ou une institution."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "aa7ce077-7f69-49c7-a063-704476ea4916",
                                "sense_id": "a45cb2bd-cc08-3813-94bf-3e773f3c9835",
                                "text": "Une belle grosse structure reluisante, avec ses fonctionnaires, ses téléphonistes et son budget!"
                            }
                        ]
                    }
                ],
