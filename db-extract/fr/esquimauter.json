                ],
                "senses": [
                    {
                        "sense_id": "9f3a7642-a53e-3f47-aabb-dd661dd2618e",
                        "entry_id": "b7dfbec0-c8b9-3622-8679-45d0aeb9adb8",
                        "glosses": [
                            "Remettre son bateau retourné à l'endroit (sans le quitter)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9fc4678-ff3e-4a49-956c-d14c6d4d377b",
                                "sense_id": "9f3a7642-a53e-3f47-aabb-dd661dd2618e",
                                "text": "Pas facile, mon vieux Carrière, d'esquimauter avec un kayak de mer rempli de bagages."
                            },
                            {
                                "example_id": "d716799a-2102-4d14-8e48-7afecea782f6",
                                "sense_id": "9f3a7642-a53e-3f47-aabb-dd661dd2618e",
                                "text": "Seule des embarcations de ce genre, le kayak, qui est fait pour la mer, peut servir pour la pêche à condition que le kayakiste sache esquimauter."
                            },
                            {
                                "example_id": "1b43a93d-c67b-49d1-acba-c3fe5a698688",
                                "sense_id": "9f3a7642-a53e-3f47-aabb-dd661dd2618e",
                                "text": "On dit que ce bateau peut rouler impunément jusqu'à montrer sa quille, et même esquimauter selon le rapport du capitaine Voss en qui j'ai toute confiance."
                            }
                        ]
                    }
                ],
