        "fr-extract.jsonl": [
            {
                "entry_id": "7c7652e1-0ebe-38c4-b158-cc6fbd103bf8",
                "word": "instinctivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                        "entry_id": "7c7652e1-0ebe-38c4-b158-cc6fbd103bf8",
                        "glosses": [
                            "Par instinct."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ce16c27-981f-425f-9608-4f1e6de255aa",
                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                "text": "Tous deux demeurèrent quelques instants en silence, et leurs regards se portèrent instinctivement vers l’endroit où était apparu le chevalier, le jour de son combat avec Gérard."
                            },
                            {
                                "example_id": "d0f83a8d-7044-44ff-8602-16d263e86e5b",
                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                "text": "Mais il était modeste au logis, il y sentait instinctivement la supériorité de sa femme, quelque jeune qu'elle fût ; […]."
                            },
                            {
                                "example_id": "81c238b2-7572-449a-ad46-850a37202a92",
                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                "text": "C'est notre première bataille, mais nous ébauchons instinctivement tous les gestes et les pensées que nous aurons une fois guerriers."
                            },
                            {
                                "example_id": "8da0c314-8656-45c6-8109-3d34a1707019",
                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                "text": "Ce n'est pas par raison qu'un pilote agit avec mesure: il le fait instinctivement, avec d'autant plus de naturel qu'il a de l'expérience et de ce fait, une tendance à ne rien risquer."
                            },
                            {
                                "example_id": "d33debf3-29c5-4462-bbf0-3fd2c81df5db",
                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                "text": "Instinctivement Éric esquive le coup, bascule en arrière en entraînant l’homme dans sa chute et l’envoie bouler à quelques mètres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa8c684b-2003-4008-8113-329731f46cd7",
                        "source_entry_id": "7c7652e1-0ebe-38c4-b158-cc6fbd103bf8",
                        "source_sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                        "target_lang_word": "instinctively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinctively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                        "entry_id": "6c9c7bfa-e058-32fc-ac27-b858feb8ffef",
                                        "glosses": [
                                            "Innately; by instinct; without being taught."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1a41bd-7287-46be-b68a-78833a68cc7c",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "Fish instinctively know how to swim; most humans don't."
                                            },
                                            {
                                                "example_id": "bb1c246e-5588-4e3b-b287-2c7ee252ebff",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "She loved him so passionately, and he was so godlike in her eyes; and being, though untrained, instinctively refined, her nature cried for his tutelary guidance."
                                            },
                                            {
                                                "example_id": "6e88c3bd-70a3-42ad-a92e-69393d3081c4",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "'I am, perhaps, overgreedy, but I sense a good cook instinctively.'"
                                            },
                                            {
                                                "example_id": "0fc6fc8b-ddd6-46a4-9ee8-d6e18263dfdb",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "While Conservative and Labour MPs instinctively had deep political differences, they were united in the cold view that at the end of the 1950s, Britain's railways were friendless and almost finished."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d41b3144-f7b4-4b0e-8687-0b22578328b4",
                        "source_entry_id": "7c7652e1-0ebe-38c4-b158-cc6fbd103bf8",
                        "source_sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                        "target_lang_word": "involuntarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "involuntarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                        "entry_id": "1315d253-080d-3acb-bf02-852c79a2b310",
                                        "glosses": [
                                            "In an involuntary manner; done without conscious thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a5c59d-651c-446a-a797-4ad0070ff0bf",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "Her leg twitched involuntarily."
                                            },
                                            {
                                                "example_id": "59581903-2382-4bd1-98f8-559a0112b0b8",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "He involuntarily overheard the conversation."
                                            },
                                            {
                                                "example_id": "a5559fe0-e6d3-4289-824a-c0569ed162ad",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "His eyes filled with tears, as he took up the glittering lengths. Their pale gold was lovely as ever; but there was something in the touch from which he involuntarily recoiled."
                                            },
                                            {
                                                "example_id": "0d204e97-0f65-433a-8d57-b5f9f95f53f1",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "Kennedy’s vocal rasp is not caused by an infection or respiratory condition. Instead, he has spasmodic dysphonia, a rare neurological condition in which the muscles that open and close his vocal cords spasm involuntarily, creating a strained or strangled quality to his speech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7e0e09d-8f51-44f0-9a82-e8e355eac639",
                        "source_entry_id": "7c7652e1-0ebe-38c4-b158-cc6fbd103bf8",
                        "source_sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                        "target_lang_word": "from the hip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "from the hip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90808990-c9ac-397a-911d-057f93c32a92",
                                        "entry_id": "dcdfea6f-475e-3425-bd96-dcb99dc1021c",
                                        "glosses": [
                                            "Instinctively; without planning ahead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3c93b51-330d-4087-938e-62484fbda2ea",
                                                "sense_id": "90808990-c9ac-397a-911d-057f93c32a92",
                                                "text": "Hasluck tells the story at a rapid pace and with racy charm. There is some refreshingly Australian talking from the hip. \"When a company's being milked, you don't look for a bucket under its tits. You look up its arse.\""
                                            },
                                            {
                                                "example_id": "4b409a57-f240-4e51-b888-3027bbf38592",
                                                "sense_id": "90808990-c9ac-397a-911d-057f93c32a92",
                                                "text": "By necessity, then, most of us were teaching from the hip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "589e1cb5-9c99-4c8e-b982-78a220f4306a",
