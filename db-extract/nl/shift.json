                                "sense_id": "d55e7338-b3c7-3bce-bfd8-f64357b7eac6",
                                "text": "Druk op de shift."
                            }
                        ]
                    },
                    {
                        "sense_id": "99ddc8ff-6635-3347-9884-6f369e24f1f4",
                        "entry_id": "e6bde76a-4e74-382f-8b95-6fdffb603841",
                        "glosses": [
                            "verandering of verplaatsing van de ene naar de andere plaats of toestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7801b41-2f8f-4bbb-8830-da61cb5ee0a5",
                                "sense_id": "99ddc8ff-6635-3347-9884-6f369e24f1f4",
                                "text": "In een brief aan de Europese Commissie waarschuwde de ACEA vorig jaar al voor extra CO2-uitstoot als gevolg van de verschuiving van diesel naar benzine, ook toen zonder één enkele verwijzing naar de eigen verantwoordelijkheid voor die shift."
                            }
                        ]
