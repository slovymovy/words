                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94115ff3-dba4-47df-9a1e-53f4a05b4931",
                                "sense_id": "9fd57229-2051-31be-900f-08caaa264bfd",
                                "text": "Ему стало холодно, и он пошел в избу, где мать только что вынула хлеб из печки и теперь пекла для него кокоры."
                            },
                            {
                                "example_id": "6062db69-1cc4-459d-98b0-322220015e91",
                                "sense_id": "9fd57229-2051-31be-900f-08caaa264bfd",
                                "text": "Слушай, не мешай, малец, а кушай кокору."
                            }
                        ]
                    }
                ],
