                "senses": [
                    {
                        "sense_id": "cbfc51fb-596b-3110-8303-c691549baddc",
                        "entry_id": "799c3e61-0f00-3632-b2b9-53cb6cf51e6f",
                        "glosses": [
                            "ein Gemisch aus mittleren und höheren Alkoholen, das als Nebenprodukt bei der alkoholischen Gärung entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f4d813f-68cf-4067-944e-0d2aac625396",
                                "sense_id": "cbfc51fb-596b-3110-8303-c691549baddc",
                                "text": "Fuselöle erkennt man an ihrem unangenehmen Geruch und an ihrem scharf brennendem Geschmack."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c35fbf1-f2bb-4a0d-b4ba-eef85857d2b7",
                        "source_entry_id": "799c3e61-0f00-3632-b2b9-53cb6cf51e6f",
                        "source_sense_id": "cbfc51fb-596b-3110-8303-c691549baddc",
                        "target_lang_word": "fusel oil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fusel oil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd755a76-1b47-38a0-9044-158454f4a9ab",
                                        "entry_id": "ce1988ec-d604-3721-8079-caaf0b3fb6ec",
                                        "glosses": [
                                            "A mixture of several higher-order alcohols (having more than two carbon atoms) formed as byproduct in the normal fermentation process, captured as part of the tailings in distillation. An excessive concentration, as in low-quality moonshine, causes unpleasant taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a64975-6e54-40ae-a87e-e895a4e0bf1d",
                                                "sense_id": "fd755a76-1b47-38a0-9044-158454f4a9ab",
                                                "text": "As for drinking, I am something of a chemist and I have yet to find a liquor that is free from traces of a number of poisons, some of them deadly, such as fusel oil, acetic acid, ethylacetate, acetaldehyde and furfurol."
                                            },
                                            {
                                                "example_id": "3b5cacd9-e6d5-4c79-a065-41e3ce193d22",
                                                "sense_id": "fd755a76-1b47-38a0-9044-158454f4a9ab",
                                                "text": "[…] and many simply blamed on the Doosra's known enthusiasms for opium, ganja, and any number of local fusel oils, singly or combined, named and nameless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
