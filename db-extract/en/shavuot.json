    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e055a8c5-7a44-3d38-ba31-55ee5f667660",
                "word": "Shavuot",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c702d40-2ae4-3366-ab1c-5029701a764b",
                        "entry_id": "e055a8c5-7a44-3d38-ba31-55ee5f667660",
                        "glosses": [
                            "A Jewish harvest festival which falls on the sixth day of Sivan in the spring, fifty days after the second day of the Passover when the omer (“sheaf of barley”) is offered."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "37d573f4-b2cc-4448-bff2-218113610d53",
                                "sense_id": "8c702d40-2ae4-3366-ab1c-5029701a764b",
                                "text": "Major Jewish holidays such as Rosh Hashanah, Yom Kippur, Simchat Torah, Succoth, Chanukah, Passover and Shavuot have been celebrated with Hebrew prayers and songs."
                            },
                            {
                                "example_id": "a312c1cb-e8e5-4f17-8347-42bd5ba00be2",
                                "sense_id": "8c702d40-2ae4-3366-ab1c-5029701a764b",
                                "text": "On the first day of Shavuot the Ten Commandments were explained to the people homiletically in the vernacular."
                            }
                        ]
                    },
                    {
                        "sense_id": "e16d32a3-7f44-35a7-892e-7ea2a4e898b5",
                        "entry_id": "e055a8c5-7a44-3d38-ba31-55ee5f667660",
                        "glosses": [
                            "A ceremony held on that day to commemorate the giving of the Torah (“first five books of the Hebrew scriptures”) to Moses and the Israelites on Mount Sinai."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": []
                    }
                ],
