{
    "word_family": [
        "krabbel",
        "gekrabbel",
        "krabben",
        "opkrabbelen",
        "krabbelaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5582af64-df21-32cc-85d0-1607c9bdf676",
                    "sense_definition": "iets haastig, slordig of zonder veel aandacht schrijven of tekenen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "schrijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>krabbel</w> je nog gauw dit kaartje voordat de postbode komt.",
                            "target_lang_translations": {
                                "en": "I'll quickly <w>scribble</w> you this card before the mailman arrives."
                            }
                        },
                        {
                            "text": "Hij zat tijdens de saaie vergadering wat poppetjes te <w>krabbelen</w> in zijn schrift.",
                            "target_lang_translations": {
                                "en": "He was <w>doodling</w> some little figures in his notebook during the boring meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "krassen",
                        "kliederen",
                        "kladderen"
                    ],
                    "common_phrases": [
                        "een briefje krabbelen",
                        "wat poppetjes krabbelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To write or draw something hastily, sloppily, or without much attention."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to scribble",
                                "target_lang_sense_clarification": "writing or drawing quickly and messily"
                            },
                            {
                                "target_lang_word": "to scrawl",
                                "target_lang_sense_clarification": "writing in a hurried, awkward way"
                            },
                            {
                                "target_lang_word": "to doodle",
                                "target_lang_sense_clarification": "drawing aimlessly while preoccupied"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82a65810-d413-353d-b515-fcfdd06f9f87",
                    "sense_definition": "herhaaldelijk of lichtjes met de nagels over de huid wrijven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanraken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond vond het heerlijk wat achter de oren <w>gekrabbeld</w> te worden.",
                            "target_lang_translations": {
                                "en": "The dog loved being <w>scratched</w> behind the ears a bit."
                            }
                        },
                        {
                            "text": "Zij begon zachtjes op haar arm te <w>krabbelen</w> omdat ze een muggenbult had.",
                            "target_lang_translations": {
                                "en": "She started to gently <w>scratch</w> her arm because she had a mosquito bite."
                            }
                        }
                    ],
                    "synonyms": [
                        "krabben",
                        "jeuken"
                    ],
                    "common_phrases": [
                        "achter de oren krabbelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To rub the skin repeatedly or lightly with the fingernails."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to scratch",
                                "target_lang_sense_clarification": "rubbing skin with nails to relieve an itch"
                            },
                            {
                                "target_lang_word": "to claw",
                                "target_lang_sense_clarification": "using nails or claws on a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffd626fe-84b4-3832-a70d-b526b2dd9577",
                    "sense_definition": "zich met moeite of onbeholpen bewegingen verplaatsen of omhoog werken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Telkens als hij viel, <w>krabbelde</w> hij weer moeizaam overeind.",
                            "target_lang_translations": {
                                "en": "Every time he fell, he <w>scrambled</w> back up with difficulty."
                            }
                        },
                        {
                            "text": "De baby probeerde tegen de bank op te <w>krabbelen</w> om te gaan staan.",
                            "target_lang_translations": {
                                "en": "The baby tried to <w>clamber</w> up against the couch to stand up."
                            }
                        }
                    ],
                    "synonyms": [
                        "klauteren"
                    ],
                    "common_phrases": [
                        "weer overeind krabbelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move or work one's way up with difficulty or awkward movements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to scramble",
                                "target_lang_sense_clarification": "moving or climbing quickly and awkwardly"
                            },
                            {
                                "target_lang_word": "to clamber",
                                "target_lang_sense_clarification": "climbing with difficulty using hands and feet"
                            },
                            {
                                "target_lang_word": "to pick oneself up",
                                "target_lang_sense_clarification": "getting back on one's feet after a fall"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
