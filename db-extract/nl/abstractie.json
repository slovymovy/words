                "senses": [
                    {
                        "sense_id": "9e24ce6d-0be5-3253-b807-5b1913b3fa90",
                        "entry_id": "0a41ff25-af25-3094-ad4e-05d7163d64ce",
                        "glosses": [
                            "een begrip dat los staat van de dagelijkse werkelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cadb44e2-e687-4dc4-87bf-a1056a305f4f",
                                "sense_id": "9e24ce6d-0be5-3253-b807-5b1913b3fa90",
                                "text": "Wiskunde is opgebouwd uit abstracties."
                            },
                            {
                                "example_id": "64e1b4aa-8593-4518-a93e-e66d80a63f2f",
                                "sense_id": "9e24ce6d-0be5-3253-b807-5b1913b3fa90",
                                "text": "Toen hij terugkeerde bij de tafel was Gertrude er niet en de nu kalmere discussie had, begreep hij al na een paar zinnen, een niveau van abstractie bereikt waaraan hij nog minder had toe te voegen dan daarvoor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5cc2962-2474-4d7b-be4a-42bbe63ace49",
                        "source_entry_id": "0a41ff25-af25-3094-ad4e-05d7163d64ce",
                        "source_sense_id": "9e24ce6d-0be5-3253-b807-5b1913b3fa90",
                        "source_sense_description": "een begrip dat los staat van de dagelijkse werkelijkheid",
                        "target_lang_word": "Abstraktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstraktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72cfbd43-9783-31dd-b071-3c719c239b09",
                                        "entry_id": "d92aaf59-6e13-300d-bb2f-3e744a595da6",
                                        "glosses": [
                                            "aus einem höheren Blickwinkel betrachtet, Verallgemeinerung, Generalisierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd77c7de-4cef-4214-a969-86a4e7f0fab6",
                                                "sense_id": "72cfbd43-9783-31dd-b071-3c719c239b09",
                                                "text": "„Es beginnt ein Kampf zwischen Abstraktion und Gegenständlichkeit.“"
                                            },
                                            {
                                                "example_id": "2091fd3f-4110-445d-814d-f55ed04d7253",
                                                "sense_id": "72cfbd43-9783-31dd-b071-3c719c239b09",
                                                "text": "Superierung ist die Fähigkeit, Einzelheiten zu einem Ganzen zusammenfassen zu können. Dadurch entsteht eine Abstraktion komplexer Sachverhalte."
                                            },
                                            {
                                                "example_id": "2acb1479-cac9-402b-a737-a038af315c39",
                                                "sense_id": "72cfbd43-9783-31dd-b071-3c719c239b09",
                                                "text": "„Die entstandenen Skulpturen sind elegant, stets reduziert, oft an der Grenze zur Abstraktion.“"
                                            },
                                            {
                                                "example_id": "4896d18d-2b33-4522-b6d9-2c667472c037",
                                                "sense_id": "72cfbd43-9783-31dd-b071-3c719c239b09",
                                                "text": "„Der aber ergibt sich nie aus Abstraktionen und Verallgemeinerungen.“"
                                            },
                                            {
                                                "example_id": "3e2fb0f9-38a0-495b-915a-ef2a22e0c24a",
                                                "sense_id": "72cfbd43-9783-31dd-b071-3c719c239b09",
                                                "text": "„Nicht, wer die Menschheit, wer die Partei oder sonst eine Abstraktion, nicht, wer allein die Madonna oder ein anderes Numinosum liebt, ist kultiviert, sondern wer erst einmal einen Menschen lieben kann, durch alle Spannungen ambivalenter Erlebnisse hindurch, die er mit ihm haben wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
