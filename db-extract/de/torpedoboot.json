                ],
                "senses": [
                    {
                        "sense_id": "5d0b9186-19e4-3b1f-b69a-8b00c03b541b",
                        "entry_id": "f271808c-692d-3715-8ed0-136c402e73e0",
                        "glosses": [
                            "relativ kleines Kriegsschiff, dessen Bewaffnung hauptsächlich aus Torpedos besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd033707-dd0b-4453-be4a-ef32df436734",
                                "sense_id": "5d0b9186-19e4-3b1f-b69a-8b00c03b541b",
                                "text": "„Ein englisches U-Boot hatte eins von unseren Torpedobooten beschossen.“"
                            },
                            {
                                "example_id": "4dd8579d-ac10-4c71-bfa5-a18497d74810",
                                "sense_id": "5d0b9186-19e4-3b1f-b69a-8b00c03b541b",
                                "text": "„Schon drehte das Torpedoboot wieder ab.“"
                            },
                            {
                                "example_id": "35d2c7dd-e69d-4af7-8550-1a69a2bfa6d8",
                                "sense_id": "5d0b9186-19e4-3b1f-b69a-8b00c03b541b",
                                "text": "„Es war das Torpedoboot, das mit gedrosselter Maschinenleistung Position hielt und von dessen umlaufender Reling aus mit Fangleinen Lebende und Tote, die im Wasser trieben, aufgefischt wurden.“"
                            },
                            {
                                "example_id": "1d856776-3953-4a86-afd1-5caecffc0a64",
                                "sense_id": "5d0b9186-19e4-3b1f-b69a-8b00c03b541b",
                                "text": "„Diese Mütze ist ziemlich schäbig und salzverkrustet, aber ich habe sie vom Kommandanten eines Torpedobootes, auf dem ich während des Krieges von Dover losgefahren war - ein nobler Gentleman und ein Mörder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
