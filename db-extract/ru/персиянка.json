                "senses": [
                    {
                        "sense_id": "6c7bdf5a-c944-318b-8d8e-5934603c846f",
                        "entry_id": "f4ee910b-fccc-3d7b-b578-dd481d4d9030",
                        "glosses": [
                            "устар. представительница народа составляющего основное население Ирана (прежде называвшегося Персией)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89febd7c-e1b9-43b3-8f7a-7fdadfc01ad0",
                                "sense_id": "6c7bdf5a-c944-318b-8d8e-5934603c846f",
                                "text": "Этот ропот и насмешки // Слышит грозный атаман, // И он мощною рукою // Обнял персиянки стан."
                            },
                            {
                                "example_id": "f62680d8-c350-4e90-9503-025eccd04cd5",
                                "sense_id": "6c7bdf5a-c944-318b-8d8e-5934603c846f",
                                "text": "— Здесь персидский квартал, но персиянок не встретите на улице: они взаперти, по домам сидят…"
                            }
                        ]
                    }
                ],
