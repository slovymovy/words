                                    {
                                        "sense_id": "e647b1dc-3e2e-3007-88af-a95452311d0f",
                                        "entry_id": "00952bc8-d028-383e-a8f6-cd070ac5a86f",
                                        "glosses": [
                                            "eine Kritik offen aussprechen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e7d8c94-ef65-499d-a8e5-80058fb65c18",
                                                "sense_id": "e647b1dc-3e2e-3007-88af-a95452311d0f",
                                                "text": "Ich monierte einen Mangel des Schrankes."
                                            },
                                            {
                                                "example_id": "1c7a252e-d848-4329-9411-284a3a00ed8d",
                                                "sense_id": "e647b1dc-3e2e-3007-88af-a95452311d0f",
                                                "text": "Du monierst die Fehler, die ich in meiner Arbeit gemacht habe."
                                            },
                                            {
                                                "example_id": "74241823-f297-43ed-a15f-8df3664d041c",
                                                "sense_id": "e647b1dc-3e2e-3007-88af-a95452311d0f",
                                                "text": "„Die von den Wirten zur Abtrennung errichteten Glastüren stehen meist offen, um die Arbeit des Personals zu erleichtern, und ebenso oft sind Nichtraucher gezwungen, durch den Raucherbereich zu gehen, um etwa zu den Toiletten oder überhaupt erst zum Nichtraucherbereich zu gelangen – was der Verwaltungsgerichtshof bereits 2013 als nicht gesetzeskonform moniert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
