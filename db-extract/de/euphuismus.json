                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "a2181d6a-c9b1-4ef8-9b6e-ba70674e53f1",
                                "sense_id": "d88fda16-0863-3336-903e-a2ccbc9f6768",
                                "text": "Der Euphuismus zeichnet sich durch sehr lange Sätze, eigenartige Vergleiche und ein besonderes Pathos aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
