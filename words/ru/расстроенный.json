                                "target_lang_sense_clarification": "interrupted or thrown into confusion"
                            },
                            {
                                "target_lang_word": "ruined",
                                "target_lang_sense_clarification": "spoiled or destroyed"
                            },
                            {
                                "target_lang_word": "upset",
                                "target_lang_sense_clarification": "disrupted or adversely altered"
                            }
                        ]
