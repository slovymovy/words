                        "examples": [
                            {
                                "example_id": "43304abb-af7e-49db-9120-064bbb71c69d",
                                "sense_id": "58ed3815-c32c-3420-a690-006f46a7855c",
                                "text": "Het keukenfornuis verspreidde een behaaglijke warmte en aangezien mijn ouders weer eens op reis waren, heerste er een vredige sfeer van rust en geborgenheid."
                            },
                            {
                                "example_id": "4fc5ca15-dce9-4c8a-a2de-42763a5451e8",
                                "sense_id": "58ed3815-c32c-3420-a690-006f46a7855c",
                                "text": "Het lek ontstond aan de gastoevoer van het keukenfornuis en veroorzaakte een kleine brand. Een honderdtal leerlingen werd onmiddellijk geëvacueerd terwijl de brand geblust werd. De schade aan de keuken bleef uiteindelijk beperkt en er vielen geen slachtoffers, aldus de politie."
                            }
                        ]
                    }
