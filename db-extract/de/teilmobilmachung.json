                ],
                "senses": [
                    {
                        "sense_id": "f05880ea-acaf-3c6f-b403-ccfea15c9e89",
                        "entry_id": "77308ded-6873-31e6-a9a8-d68c01babfea",
                        "glosses": [
                            "Vorbereitung / Mobilisierung einiger Streitkräfte eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1289a142-a5fc-4bc5-b933-bd63be9191df",
                                "sense_id": "f05880ea-acaf-3c6f-b403-ccfea15c9e89",
                                "text": "„Am 25. Juli brach Wien die diplomatischen Beziehungen zu Belgrad ab, nachdem der österreichische Gesandte Giesl die serbische Antwortnote für ungenügend gehalten hatte. Gleichzeitig erging der Befehl zur österreichischen Teilmobilmachung.“"
                            },
                            {
                                "example_id": "4b83d2c9-670c-4a37-bf55-a6c4c4374077",
                                "sense_id": "f05880ea-acaf-3c6f-b403-ccfea15c9e89",
                                "text": "„Seit Beginn der Teilmobilmachung in Russland sind viele Männer im wehrfähigen Alter ins Ausland geflohen, damit sie nicht zum Krieg gegen die Ukraine einberufen werden.“"
                            },
                            {
                                "example_id": "f03c0a92-7fbc-4766-9f59-46bed269b7f8",
                                "sense_id": "f05880ea-acaf-3c6f-b403-ccfea15c9e89",
                                "text": "„Doch als die Teilmobilmachung begann, bekam Daria Angst um ihren Ehemann Alexei.“"
                            },
                            {
                                "example_id": "74d180ad-80c9-4fbe-be64-cd091bc7f114",
                                "sense_id": "f05880ea-acaf-3c6f-b403-ccfea15c9e89",
                                "text": "„Mit Beginn der Teilmobilmachung beschlossen sie und ihr Mann, dass er und ihr gemeinsamer Sohn nach Armenien fliehen sollten.“"
                            },
                            {
                                "example_id": "eb171440-6e6b-412a-b339-0ae5503f880f",
                                "sense_id": "f05880ea-acaf-3c6f-b403-ccfea15c9e89",
                                "text": "„In der vierten Woche der Teilmobilmachung, die am 21. September begonnen hat, kündigte der russische Präsident Wladimir Putin an, dass diese bald abgeschlossen sein werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
