                "senses": [
                    {
                        "sense_id": "0702035c-acfe-3b80-99a3-74663a7456cf",
                        "entry_id": "cf0551df-5788-3013-b8dd-a5c0aa2ca094",
                        "glosses": [
                            "Gotteshaus zu Ehren des Apostels Andreas ^(→ WP) das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568abe3c-d8da-46ae-88d0-ed8e24694bd9",
                                "sense_id": "0702035c-acfe-3b80-99a3-74663a7456cf",
                                "text": "„Die Kröppelstraße verläuft direkt südlich der Andreaskirche in Ost-West-Richtung und verbindet die Reichsstraße im Osten mit dem Wollmarkt im Westen.“"
                            },
                            {
                                "example_id": "e7ce90ff-2153-4c16-9ce4-5ec05bc79cb1",
                                "sense_id": "0702035c-acfe-3b80-99a3-74663a7456cf",
                                "text": "„Zusammen mit seinem Apostelbruder, dem hl. Petrus, hat er unter den „Zwölf Boten“ stets die größte Verehrung erfahren. Zahlreiche, in das 8. Jahrhundert zurückreichende Andreaskirchen belegen seinen Kult.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
