                        "glosses": [
                            "Qui n’est pas accompagné d’un sentiment de sécurité."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c18b13af-66b0-4bc3-958f-84253d5393dd",
                                "sense_id": "f806affb-938d-3667-b2f0-b6856a2768e0",
                                "text": "Sa page Wikipédia est typique des gens insécures, qui la rédigent eux-mêmes, en perdant la décence de vue"
                            },
                            {
                                "example_id": "4c5d2f84-06b2-4678-9f49-0549a5278632",
                                "sense_id": "f806affb-938d-3667-b2f0-b6856a2768e0",
                                "text": "Elle me touche et m'émeut, sans que je sache pourquoi. La tristesse dans ses yeux. La façon insécure qu'elle a de se mouvoir, s'accrochant au caddie comme les vieux à leur canne."
                            }
                        ]
                    }
