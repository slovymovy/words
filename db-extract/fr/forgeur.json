                    }
                ],
                "senses": [
                    {
                        "sense_id": "3645ca75-238a-30f8-a18b-5324c31fc249",
                        "entry_id": "2eb64ebc-1670-3771-9478-8f4acda422bd",
                        "glosses": [
                            "Celui qui est employé aux travaux de la forge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628fd43f-d8a2-434e-8676-2ff9c06c62e0",
                                "sense_id": "3645ca75-238a-30f8-a18b-5324c31fc249",
                                "text": "Forgeur d’épées, de couteaux, de ciseaux, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "74e3d225-3ae4-374b-9ac6-a03c22d948a6",
                        "entry_id": "2eb64ebc-1670-3771-9478-8f4acda422bd",
                        "glosses": [
                            "Celui qui invente, qui crée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2361e89a-ee81-4b56-88bd-454c26b458f1",
                                "sense_id": "74e3d225-3ae4-374b-9ac6-a03c22d948a6",
                                "text": "Ceci réclame de la part du chef un réel sens didactique. Et suffit à établir une réputation de forgeur d’orchestre."
                            },
                            {
                                "example_id": "479db1fb-9115-4c7e-abce-c31f02bbc669",
                                "sense_id": "74e3d225-3ae4-374b-9ac6-a03c22d948a6",
                                "text": "Très peu, au contraire, peuvent s’imaginer poète ou forgeur de phrases."
                            }
                        ]
                    },
                    {
                        "sense_id": "39a8734f-6669-36dd-9d07-029907a411db",
                        "entry_id": "2eb64ebc-1670-3771-9478-8f4acda422bd",
                        "glosses": [
                            "Celui qui invente quelque fausseté ou fabrique des faux documents des faux en écriture."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2404b495-ea64-46c4-9b73-ac440ea4c5a3",
                                "sense_id": "39a8734f-6669-36dd-9d07-029907a411db",
                                "text": "C’est un forgeur de contes, un forgeur de calomnies."
                            }
                        ]
                    }
                ],
