                        "examples": [
                            {
                                "example_id": "b3be8132-6cb7-477a-8cd6-f1f075b0a700",
                                "sense_id": "5f220ec4-2972-3bc7-80e9-b3a42d879676",
                                "text": "If you have never had it, and you are devoid of an interest in what is truly beautiful, then you will belong to the unartistic group of people."
                            },
                            {
                                "example_id": "36ecc201-f111-4217-843b-fff5b1423cd4",
                                "sense_id": "5f220ec4-2972-3bc7-80e9-b3a42d879676",
                                "text": "If such works—altered by ritual use, incorporating the most “unartistic” materials from the traditional Western viewpoint, and as far from illusionistic in style as Picasso could ever have seen—can appear “reasonable” to a Western artist, that artist has performed an almost magical act of projection and inversion of the ordinary meaning of the work as “rational.”"
                            },
                            {
                                "example_id": "297bc025-fedc-49e3-aa5d-9876aee945e8",
                                "sense_id": "5f220ec4-2972-3bc7-80e9-b3a42d879676",
                                "text": "They've gotten their foot up that high, and they want to show it off. Well, that's an unartistic idea about dancing. It's a plebeian, low-class idea."
                            }
                        ]
                    }
