                "senses": [
                    {
                        "sense_id": "f96ad73e-67bd-36ba-b7c5-7ec6f742c14e",
                        "entry_id": "ebb14aad-dfff-3e6c-83ab-1d7024967f3e",
                        "glosses": [
                            "действие по значению гл. царапать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad2cf46-343d-4206-abeb-87560bacbe40",
                                "sense_id": "f96ad73e-67bd-36ba-b7c5-7ec6f742c14e",
                                "text": "Страшный шум от крыл и от царапанья когтей наполнил всю церковь."
                            },
                            {
                                "example_id": "5bacec13-44dd-409f-b4c4-121d302c2cc9",
                                "sense_id": "f96ad73e-67bd-36ba-b7c5-7ec6f742c14e",
                                "text": "Стук повторился вместе с лёгким царапаньем у двери."
                            },
                            {
                                "example_id": "d9576839-325d-4049-a42a-11f9db54f2e2",
                                "sense_id": "f96ad73e-67bd-36ba-b7c5-7ec6f742c14e",
                                "text": "Однако мысль о том, что если уж не побить, так хоть нос откусить своей «натуральной супруге» и тем отомстить ей за все её царапанья и обиды, крепко засела ему в голову."
                            }
                        ]
                    }
