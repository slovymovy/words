                                "target_lang_sense_clarification": "in zufriedenstellender Menge"
                            },
                            {
                                "target_lang_word": "hinreichend",
                                "target_lang_sense_clarification": "das rechte Maß erfüllend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "219388f3-53d1-309d-9760-3658e2211943",
                    "sense_definition": "Possessing adequate talents or abilities; qualified or fit for a task.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not feel <w>sufficient</w> to lead the expedition on his own.",
                            "target_lang_translations": {
                                "ru": "Он не чувствовал себя <w>достаточно компетентным</w>, чтобы возглавить экспедицию самостоятельно.",
                                "de": "Er fühlte sich nicht <w>fähig</w> genug, die Expedition allein zu leiten."
                            }
                        },
                        {
                            "text": "They proved <w>sufficient</w> to maintain their independence despite the pressure.",
                            "target_lang_translations": {
                                "ru": "Они оказались <w>способными</w> сохранить свою независимость, несмотря на давление.",
                                "de": "Sie erwiesen sich als <w>fähig</w> genug, ihre Unabhängigkeit trotz des Drucks zu bewahren."
                            }
                        }
                    ],
                    "synonyms": [
                        "competent",
                        "capable"
                    ],
                    "antonyms": [
                        "insufficient"
                    ],
                    "common_phrases": [
                        "feel sufficient"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий необходимыми талантами или способностями; квалифицированный для выполнения задачи.",
                        "de": "Über angemessene Talente oder Fähigkeiten verfügend; qualifiziert oder geeignet für eine Aufgabe."
                    },
                    "translations": {
