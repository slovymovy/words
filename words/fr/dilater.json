                    "frequency": "Middle",
                    "semantic_group_id": "elargissement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ophtalmologue utilise des gouttes pour <w>dilater</w> les pupilles du patient avant l'examen."
                        },
                        {
                            "text": "Ce médicament permet de <w>dilater</w> efficacement les artères coronaires."
                        }
                    ],
                    "synonyms": [
