{
    "word_family": [
        "proctorial",
        "proctorship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac096bcd-1ffb-3f6c-9f4a-28cdffea6657",
                    "sense_definition": "A person who supervises students during an examination to prevent cheating",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_supervision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>proctor</w> walked quietly between the rows of desks to ensure no one was talking.",
                            "target_lang_translations": {
                                "ru": "<w>Наблюдатель</w> тихо ходил между рядами парт, чтобы убедиться, что никто не разговаривает."
                            }
                        },
                        {
                            "text": "If you have a question during the test, please raise your hand for the <w>exam</w> <w>proctor</w>.",
                            "target_lang_translations": {
                                "ru": "Если у вас возникнет вопрос во время теста, пожалуйста, поднимите руку, чтобы позвать <w>наблюдателя</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "invigilator"
                    ],
                    "common_phrases": [
                        "exam proctor",
                        "test proctor",
                        "university proctor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который следит за студентами во время экзамена, чтобы предотвратить списывание"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдатель",
                                "target_lang_sense_clarification": "на экзамене"
                            },
                            {
                                "target_lang_word": "проктор",
                                "target_lang_sense_clarification": "в контексте онлайн-экзаменов или международных тестов"
                            },
                            {
                                "target_lang_word": "дежурный",
                                "target_lang_sense_clarification": "в аудитории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c41957ca-c65d-325c-aba7-6706846b4e2d",
                    "sense_definition": "An official at certain older universities, such as Oxford or Cambridge, responsible for discipline",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "academic_supervision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university <w>proctor</w> is responsible for maintaining student discipline outside of the classroom.",
                            "target_lang_translations": {
                                "ru": "Университетский <w>проктор</w> отвечает за поддержание дисциплины среди студентов вне учебных аудиторий."
                            }
                        },
                        {
                            "text": "In some traditional institutions, the <w>proctor</w> still wears formal academic dress while performing duties.",
                            "target_lang_translations": {
                                "ru": "В некоторых традиционных учебных заведениях <w>проктор</w> до сих пор носит официальную академическую одежду при исполнении своих обязанностей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "senior proctor",
                        "junior proctor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо в старейших университетах (например, Оксфорде или Кембридже), отвечающее за дисциплину"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проктор",
                                "target_lang_sense_clarification": "университетский надзиратель"
                            },
                            {
                                "target_lang_word": "инспектор",
                                "target_lang_sense_clarification": "по делам студентов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1de0d954-e718-324b-a42b-2efe555dad1e",
                    "sense_definition": "A legal practitioner or representative in ecclesiastical or admiralty courts",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_representative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historically, a <w>proctor</w> performed duties in church courts similar to those of a solicitor.",
                            "target_lang_translations": {
                                "ru": "Исторически сложилось так, что <w>проктор</w> выполнял в церковных судах обязанности, схожие с обязанностями стряпчего или адвоката."
                            }
                        },
                        {
                            "text": "The <w>proctor</w> submitted the necessary documents to the ecclesiastical judge on behalf of his client.",
                            "target_lang_translations": {
                                "ru": "<w>Проктор</w> подал необходимые документы церковному судье от имени своего клиента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "queens proctor",
                        "kings proctor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юрист или представитель в церковных судах или судах адмиралтейства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проктор",
                                "target_lang_sense_clarification": "церковный адвокат"
                            },
                            {
                                "target_lang_word": "поверенный",
                                "target_lang_sense_clarification": "в церковном суде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86a62752-6194-3b84-a18c-393c6fcaf640",
                    "sense_definition": "To supervise an examination or test",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supervise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Graduate students are often required to <w>proctor</w> undergraduate exams during finals week.",
                            "target_lang_translations": {
                                "ru": "Аспирантов часто просят <w>наблюдать</w> за экзаменами бакалавров во время сессии."
                            }
                        },
                        {
                            "text": "The professor asked his assistant to <w>proctor</w> <w>an</w> <w>exam</w> while he attended a conference.",
                            "target_lang_translations": {
                                "ru": "Профессор попросил своего ассистента <w>провести</w> экзамен, пока он был на конференции."
                            }
                        }
                    ],
                    "synonyms": [
                        "invigilator"
                    ],
                    "common_phrases": [
                        "proctor an exam",
                        "proctor a test"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Контролировать проведение экзамена или теста"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдать",
                                "target_lang_sense_clarification": "на экзамене"
                            },
                            {
                                "target_lang_word": "проводить прокторинг",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "контролировать",
                                "target_lang_sense_clarification": "ход тестирования"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1888051-31e1-33a3-9733-85e91f279b28",
                    "sense_definition": "Relating to the Proctor test, which measures the moisture-density relationship of soil in construction",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers calculated the <w>Proctor</w> density to determine if the soil was compacted enough for the foundation.",
                            "target_lang_translations": {
                                "ru": "Инженеры рассчитали плотность по <w>Проктору</w>, чтобы определить, достаточно ли уплотнена почва для фундамента."
                            }
                        },
                        {
                            "text": "A standard <w>Proctor</w> value is essential for ensuring the stability of the new roadbed.",
                            "target_lang_translations": {
                                "ru": "Стандартный показатель <w>Проктора</w> необходим для обеспечения устойчивости нового дорожного полотна."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proctor density",
                        "proctor value",
                        "proctor test"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical engineering term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к тесту Проктора, который определяет плотность и влажность почвы в строительстве"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Проктора",
                                "target_lang_sense_clarification": "в названии метода или прибора"
                            },
                            {
                                "target_lang_word": "по Проктору",
                                "target_lang_sense_clarification": "метод испытания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4d301fd9-05a4-3a67-bcc8-0e553cce5486",
                    "sense_definition": "An English surname derived from the occupation of being a proctor",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous author's last name was <w>Proctor</w>.",
                            "target_lang_translations": {
                                "ru": "Фамилия знаменитого автора была <w>Проктор</w>."
                            }
                        },
                        {
                            "text": "Many families with the surname <w>Proctor</w> can trace their roots back to northern England.",
                            "target_lang_translations": {
                                "ru": "Многие семьи с фамилией <w>Проктор</w> могут проследить свои корни до северной Англии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "occupational origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от названия профессии проктора"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Проктор",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ad85e4e-c2b2-3138-be04-d4090b93f542",
                    "sense_definition": "A town in Vermont, United States",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "us_places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The town of <w>Proctor</w> is known for its historical marble industry.",
                            "target_lang_translations": {
                                "ru": "Город <w>Проктор</w> известен своей исторической мраморной промышленностью."
                            }
                        },
                        {
                            "text": "We drove through <w>Proctor</w> on our way to the Green Mountains.",
                            "target_lang_translations": {
                                "ru": "Мы проезжали через <w>Проктор</w> по пути к Зелёным горам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в штате Вермонт, США"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Проктор",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}