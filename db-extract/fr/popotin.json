                "senses": [
                    {
                        "sense_id": "275f1728-f9e8-3675-aa73-1a8fe3373843",
                        "entry_id": "dfbcabe1-3c2a-3384-8f94-073c92efd8d7",
                        "glosses": [
                            "Postérieur, derrière d’une personne (spécialement d’une femme)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "681bf980-074b-41cb-9742-70089cfc3c85",
                                "sense_id": "275f1728-f9e8-3675-aa73-1a8fe3373843",
                                "text": "Au menu des festivités, 400 photos de popotins - de préférence à l'air et gironds - signées Jean-Paul Goude, Terry Richardson ou Richard Kern."
                            },
                            {
                                "example_id": "eec5915a-73d6-4d4e-b581-9c5d54a41613",
                                "sense_id": "275f1728-f9e8-3675-aa73-1a8fe3373843",
                                "text": "C’est sur cette commode que se passe mon premier souvenir avec ma mère : j’ai la fièvre, elle me met un « bonbon-la-fesse » dans le popotin."
                            },
                            {
                                "example_id": "2b9bdfb3-01e2-473e-89a3-da35fe44c589",
                                "sense_id": "275f1728-f9e8-3675-aa73-1a8fe3373843",
                                "text": "Se dessina au fil de son imagination une galerie de fesses à la blancheur douteuse, de trous de balle hémorroïdaires, de derches de fiotes, de popotins pratiques, de croupes rétives, de derrières voluptueux, de raies au parfum de crevettes avariées."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
