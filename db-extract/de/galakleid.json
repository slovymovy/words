                "senses": [
                    {
                        "sense_id": "b2e0706a-d707-3039-9560-58beb0f2a54a",
                        "entry_id": "95afd652-15ed-305e-a7c1-51a4749c91fe",
                        "glosses": [
                            "langes Kleid, das zu einem festlichen häufig auch offiziellen Anlass (einer Gala) getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd4c595e-8e0e-4ec9-89f9-8bb4ea61504b",
                                "sense_id": "b2e0706a-d707-3039-9560-58beb0f2a54a",
                                "text": "Galina zieht heute Abend ein Galakleid an."
                            },
                            {
                                "example_id": "4aca6bc9-1b02-430e-afe5-72c95e3a00f8",
                                "sense_id": "b2e0706a-d707-3039-9560-58beb0f2a54a",
                                "text": "Das ehemalige Model [Michelle Monaghan] strahlt einfach immer, bezaubert in Jogginghosen gleichermaßen wie im Galakleid […]"
                            },
                            {
                                "example_id": "d4f664d8-7a3a-4cb2-9b9a-44087ea7c0df",
                                "sense_id": "b2e0706a-d707-3039-9560-58beb0f2a54a",
                                "text": "„Der große Auftritt im Galakleid gehört bei einer Preisverleihung dazu. Aber nicht jeder Dame gelingt dies […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c357d60-201a-34b7-ae0f-7cfb05523f2b",
                        "entry_id": "95afd652-15ed-305e-a7c1-51a4749c91fe",
                        "glosses": [
                            "Kurzform für Galakleidung: besonders festliche Kleidung (für Frauen und Männer)"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "4520fdfb-3708-4ed2-aaa9-45791dcb1c76",
                                "sense_id": "7c357d60-201a-34b7-ae0f-7cfb05523f2b",
                                "text": "„Kaum angekommen, stellt sich der junge Edelmann im Galakleid bei Hofe vor.“"
                            },
                            {
                                "example_id": "4ec6a3f1-bc55-4cc8-9bf6-ef161bcc35d0",
                                "sense_id": "7c357d60-201a-34b7-ae0f-7cfb05523f2b",
                                "text": "„Alles fuhr und ging in Galakleidern, so daß man zuletzt nur die ganz goldenen Anzüge bemerkenswert fand.“"
                            },
                            {
                                "example_id": "e8a1bc40-81bb-4c12-9a6e-d6f812f1d8de",
                                "sense_id": "7c357d60-201a-34b7-ae0f-7cfb05523f2b",
                                "text": "„Es waren Erbstücke ihrer Ahnen und vom Vater auf den Sohn übergegangen; die meisten waren dem Maß ihrer Ahnen zugeschnitten worden, und das Gold war so abgenutzt, daß man es nicht mehr erkennen konnte; dennoch waren dies ihre Galakleider, und sie dünkten sich in diesen antiken Lumpen zum mindesten ebenso imposant wie der Kaiser in der Tracht Karls des Großen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
