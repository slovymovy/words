                                "target_senses": [
                                    {
                                        "sense_id": "6646fa07-84ca-3867-8057-a7ae054f0203",
                                        "entry_id": "e28ba569-d913-3642-9aa7-58f5417ff268",
                                        "glosses": [
                                            "Variété cryptocristalline colloforme d’uraninite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bfae923-e4ed-409b-a251-463218726434",
                                                "sense_id": "6646fa07-84ca-3867-8057-a7ae054f0203",
                                                "text": "Je possède aussi un exemplaire tiré de la mine de Neujahr, proche la même ville; la Pechblende s’y trouve engagée entre les couches alternatives d’une mine de fer brune."
                                            },
                                            {
                                                "example_id": "7fe58d52-c22a-4800-a74f-82d062d0cbca",
                                                "sense_id": "6646fa07-84ca-3867-8057-a7ae054f0203",
                                                "text": "Le radium se trouve, comme l’uranium, dans la pechblende, mais en quantité infinitésimale."
                                            },
                                            {
                                                "example_id": "de573c0e-36b2-4fe3-aa6a-16d9d124dbe9",
                                                "sense_id": "6646fa07-84ca-3867-8057-a7ae054f0203",
                                                "text": "Des cailloux jaunes et noirs, Joliot-Curie vient d’en commander cinq tonnes à l’Union minière du Haut-Katanga : la pechblende. Avec un e, mais ici on prononce \"blinde\"."
                                            },
                                            {
                                                "example_id": "c807dd34-0b13-4e89-b296-3fe672fd2d3f",
                                                "sense_id": "6646fa07-84ca-3867-8057-a7ae054f0203",
                                                "text": "Cette broche – le bolo stricto sensu – consiste ici en un triangle de résine transparente abritant un scorpion mort et monté sur une base de pechblende polie (U-235) en forme de pointe de flèche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
