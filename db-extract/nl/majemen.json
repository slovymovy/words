                        ],
                        "examples": [
                            {
                                "example_id": "c0f7cd0d-4c7e-4fce-9ba2-bda1bc81d4ea",
                                "sense_id": "f7b16d9d-104e-3c58-9642-4710eea621dd",
                                "text": "1978 September, 'Béhá' (prob. pseud. of B. Haasbeek), \"„Pasar Malam”\", De Kennemer Klapper, vol. 3, no. 11, page 4.\nOp zo'n luizige buitenpost stond ik 's avonds om 'n uur of tien op wacht, 't majemde as de pest en harstikke donker en ik herkende 'm an z'n stem omdat ie nog wat tegen een maat riep en jawel hoor, naar de poepdoos.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "8a4d5c2b-b3d7-4efb-a094-b800c821b582",
                                "sense_id": "f7b16d9d-104e-3c58-9642-4710eea621dd",
                                "text": "Als het nou weer drie dagen majemt kan je dat ding wat mij betreft verkopen."
                            }
                        ]
                    }
                ],
