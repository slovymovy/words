                                    {
                                        "sense_id": "2d7dca4e-a537-3af6-a5c7-84bff95ac6f4",
                                        "entry_id": "004e876b-31ca-38d7-8070-23c1a53b2fd4",
                                        "glosses": [
                                            "Zustand, in dem man kein Bewusstsein mehr hat; bewusstlos sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18382e62-e4b1-4f5b-9cef-dc55d0502a77",
                                                "sense_id": "2d7dca4e-a537-3af6-a5c7-84bff95ac6f4",
                                                "text": "Eine Bewusstlosigkeit konnte zum Glück verhindert werden."
                                            },
                                            {
                                                "example_id": "eee0e15e-3a4d-40a0-a4d4-422775d7b17a",
                                                "sense_id": "2d7dca4e-a537-3af6-a5c7-84bff95ac6f4",
                                                "text": "„Papa nickte schwach, er schien sich an der Grenze zur Bewusstlosigkeit zu befinden, Sara wusste nicht, ob er erfasst hatte, was sie sagte.“"
                                            }
