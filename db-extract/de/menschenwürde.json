                    {
                        "form_id": "b7786860-2aed-4e08-854e-e10bc7c6c8f5",
                        "entry_id": "b2950f2b-096d-36c4-991d-f07e5639889f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Menschenwürde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40bdc328-fc3e-3c74-bd02-112999884147",
                        "entry_id": "b2950f2b-096d-36c4-991d-f07e5639889f",
                        "glosses": [
                            "das den Menschen im Unterschied zu allen anderen Lebewesen angeborene, nicht erworbene, nicht zusprechbare und nicht aberkennbare Merkmal, das die Menschenrechte fundiert (nach christlicher Lehre die Gottebenbildlichkeit, nach Kant die Autonomie, also die Fähigkeit sich selbst ein Gesetz geben zu können und sich selbst unter dieses Gesetz zu stellen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f5dc257-488c-4e0d-9bc5-faa57f3c98f8",
                                "sense_id": "40bdc328-fc3e-3c74-bd02-112999884147",
                                "text": "„Der Begriff der Menschenwürde ist im 20. Jahrhundert zu einem vielzitierten Bezugspunkt in der Normenbegründung geworden.“"
                            },
                            {
                                "example_id": "95602006-7d5e-4a78-9d9b-50ede5253313",
                                "sense_id": "40bdc328-fc3e-3c74-bd02-112999884147",
                                "text": "Jede Person hat einen Anspruch auf Achtung ihrer Menschenwürde."
                            },
                            {
                                "example_id": "3dfe722c-f4b9-489a-a7eb-ff652ab247f9",
                                "sense_id": "40bdc328-fc3e-3c74-bd02-112999884147",
                                "text": "[Begriff \"Menschenwürde\"] „Laut der AfD-Definition des Begriffes ist es absolut mit der Menschenwürde vereinbar, sich für Menschen aus dem Ausland immer wieder neue herabsetzende Bezeichnungen auszudenken, oder Leute ertrinken zu lassen. Wer da widerspricht beschränkt, ganz klar, Menschenwürde und Meinungsfreiheit von AfD-Politikern.“"
                            },
                            {
                                "example_id": "3d0fe89f-31bc-47ce-bda2-ddc0e550a13e",
                                "sense_id": "40bdc328-fc3e-3c74-bd02-112999884147",
                                "text": "„Aber immer ist es die Minderheit, die der Mehrheitsgesellschaft das Gesicht der Menschenwürde gibt, bewahrt und dort, wo diese Menschenwürde verloren gegangen ist, erkämpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "04291751-4202-315f-9349-3cc66d38adbc",
                        "entry_id": "b2950f2b-096d-36c4-991d-f07e5639889f",
