                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the main power grid failed, they had to resort to the <w>expedient</w> of using emergency generators."
                        },
                        {
                            "text": "He would never let her know that he was aware of the strange <w>expedient</w> to which she had been driven."
