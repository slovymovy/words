                },
                {
                    "sense_id": "e76cd354-7bb0-35ea-9c99-f06d86975719",
                    "sense_definition": "een proces of methode waarbij iets kleins steeds groter wordt door anderen te betrekken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De marketingcampagne werkte als een <w>sneeuwbal</w> en bereikte miljoenen mensen in een week.",
                            "target_lang_translations": {
                                "en": "The marketing campaign worked like a <w>snowball</w> and reached millions of people in a week."
                            }
                        },
                        {
                            "text": "Zijn kleine leugen werd een <w>sneeuwbal</w> die uiteindelijk zijn hele carrière verwoestte.",
                            "target_lang_translations": {
                                "en": "His small lie became a <w>snowball</w> that eventually destroyed his entire career."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sneeuwbal effect"
                    ],
                    "target_lang_definitions": {
                        "en": "a process or method where something small becomes increasingly larger by involving others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snowball",
                                "target_lang_sense_clarification": "something that grows rapidly out of control"
                            },
                            {
                                "target_lang_word": "snowball effect",
                                "target_lang_sense_clarification": "a process that intensifies itself"
                            }
                        ]
                    }
                },
                {
