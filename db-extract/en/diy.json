                                    },
                                    {
                                        "sense_id": "be3eb943-927b-3530-9a91-d9d836d36bc6",
                                        "entry_id": "fd88ed34-26f7-32f9-a3f3-92b5cc0caf7b",
                                        "glosses": [
                                            "Faire toute sorte de petites besognes."
