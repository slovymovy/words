                                "target_senses": [
                                    {
                                        "sense_id": "aa24fdf8-b7e9-3829-93a2-51a825951220",
                                        "entry_id": "52c906f6-2dcd-32ae-998f-c0ec07448f77",
                                        "glosses": [
                                            "An election held every four years to elect members of Congress in years the president is not also elected."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e61be39-f2a4-4a3d-b705-0fcf7c8107b7",
                                                "sense_id": "aa24fdf8-b7e9-3829-93a2-51a825951220",
                                                "text": "Most of the rational world . . . foresaw a smooth ride to victory for Democrats. They had, after all, the wind at their backs from the 2006 midterm elections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
