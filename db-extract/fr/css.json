                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14617b6-57b1-4590-9e75-2770a9d11cfa",
                                                "sense_id": "e4082f92-d5a7-3c73-a81a-b8bc0fb97d5c",
                                                "text": "The CSS has found its most productive use in DVDs containing motion pictures, and the movie industry invested heavily in the technology employed to produce CSSs in order to avoid the kind of mass copying that became prevalent with regard to music CDs in the late 1990s."
                                            }
                                        ]
                                    },
