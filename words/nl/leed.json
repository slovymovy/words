    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                    "sense_definition": "geestelijke of lichamelijke pijn en verdriet",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotionele pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is hem in zijn leven behoorlijk wat <w>leed</w> aangedaan.",
                            "target_lang_translations": {
                                "en": "He has been caused a considerable amount of <w>suffering</w> in his life.",
                                "ru": "В жизни ему причинили немало <w>страданий</w>."
                            }
                        },
                        {
                            "text": "Zij kon het grote <w>leed</w> van haar dochter niet langer verdragen.",
                            "target_lang_translations": {
                                "en": "She could no longer bear her daughter's great <w>grief</w>.",
                                "ru": "Она больше не могла выносить великое <w>горе</w> своей дочери."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leed aandoen",
                        "groot leed"
                    ],
                    "target_lang_definitions": {
                        "en": "mental or physical pain and sorrow",
                        "ru": "душевная или физическая боль и горе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffering",
                                "target_lang_sense_clarification": "general physical or mental pain"
                            },
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "deep sorrow, especially caused by loss"
                            },
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "distress caused by loss or disappointment"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "страдание",
                                "target_lang_sense_clarification": "общая физическая или душевная боль"
                            },
                            {
                                "target_lang_word": "горе",
                                "target_lang_sense_clarification": "глубокая печаль, вызванная утратой"
                            },
                            {
                                "target_lang_word": "скорбь",
                                "target_lang_sense_clarification": "сильная печаль или горесть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e702db1d-98d8-33b5-ba38-f8bb5ff0167e",
                    "sense_definition": "schade of onrecht dat iemand wordt toegebracht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De storm heeft veel <w>leed</w> veroorzaakt onder de lokale bevolking.",
                            "target_lang_translations": {
                                "en": "The storm caused much <w>suffering</w> among the local population.",
                                "ru": "Шторм принес много <w>бед</w> местному населению."
                            }
                        },
                        {
                            "text": "Zij probeerden het <w>leed</w> te verzachten na de vreselijke gebeurtenis.",
                            "target_lang_translations": {
                                "en": "They tried to ease the <w>misery</w> after the terrible event.",
                                "ru": "Они пытались смягчить <w>горечь</w> после ужасного события."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leed verzachten"
                    ],
                    "target_lang_definitions": {
                        "en": "harm or injustice inflicted upon someone",
                        "ru": "вред или несправедливость, причиненные кому-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffering",
                                "target_lang_sense_clarification": "hardship or distress caused by events"
                            },
                            {
                                "target_lang_word": "misery",
                                "target_lang_sense_clarification": "great distress or discomfort"
                            },
                            {
                                "target_lang_word": "harm",
                                "target_lang_sense_clarification": "damage or injury"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "несчастье или тяжелое событие"
                            },
                            {
                                "target_lang_word": "невзгоды",
                                "target_lang_sense_clarification": "тяжелые жизненные обстоятельства"
                            },
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "вред, нанесенный обстоятельствами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37e8ee45-07c4-3b26-acaf-cac563d3bd9e",
                    "sense_definition": "enkelvoud verleden tijd van <w>lijden</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>leed</w> jarenlang aan een ernstige ziekte.",
                            "target_lang_translations": {
                                "en": "He <w>suffered</w> from a serious illness for years.",
                                "ru": "Он годами <w>страдал</w> от серьезной болезни."
                            }
                        },
                        {
                            "text": "De organisatie <w>leed</w> onder een gebrek aan goede leiding.",
                            "target_lang_translations": {
                                "en": "The organization <w>suffered</w> from a lack of good leadership.",
                                "ru": "Организация <w>страдала</w> от отсутствия хорошего руководства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leed aan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "singular past tense of 'to suffer'",
                        "ru": "форма прошедшего времени единственного числа глагола 'lijden' (страдать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffered",
                                "target_lang_sense_clarification": "past tense of experiencing pain or hardship"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "страдал",
                                "target_lang_sense_clarification": "прошедшее время от испытывать боль или трудности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c7480293-af3f-3b99-b69c-9b3a9f219a24",
                    "sense_definition": "onaangenaam of pijnlijk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onaangenaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was hem <w>leed</w> dat hij niet aanwezig kon zijn.",
                            "target_lang_translations": {
                                "en": "He was <w>sorry</w> that he could not be present.",
                                "ru": "Ему было <w>жаль</w>, что он не смог присутствовать."
                            }
                        },
                        {
                            "text": "Tot mijn <w>lede</w> wezen moet ik u dit slechte nieuws vertellen.",
                            "target_lang_translations": {
                                "en": "To my <w>regret</w>, I must tell you this bad news.",
                                "ru": "К моему глубокому <w>сожалению</w>, я должен сообщить вам эту плохую новость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand leed zijn"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in fixed expressions"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "unpleasant or painful",
                        "ru": "неприятный или болезненный (обычно в устойчивых выражениях)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sorry",
                                "target_lang_sense_clarification": "feeling regret or sadness"
                            },
                            {
                                "target_lang_word": "regretful",
                                "target_lang_sense_clarification": "feeling or showing regret"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жаль",
                                "target_lang_sense_clarification": "чувство сожаления"
                            },
                            {
                                "target_lang_word": "прискорбно",
                                "target_lang_sense_clarification": "вызывающий сожаление или печаль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0ca3437-7776-3d63-a07e-ba790389ce30",
                    "sense_definition": "boos of verbolgen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boosheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek met een <w>lede</w> blik naar de verwoesting.",
                            "target_lang_translations": {
                                "en": "He looked at the destruction with a <w>resentful</w> gaze.",
                                "ru": "Он смотрел на разрушения <w>озлобленным</w> взглядом."
                            }
                        },
                        {
                            "text": "Zij was zeer <w>leed</w> over de gang van zaken.",
                            "target_lang_translations": {
                                "en": "She was very <w>aggrieved</w> about the way things were going.",
                                "ru": "Она была крайне <w>возмущена</w> тем, как шли дела."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern Dutch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "angry or indignant",
                        "ru": "сердитый или возмущенный (архаизм)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resentful",
                                "target_lang_sense_clarification": "feeling bitterness at having been treated unfairly"
                            },
                            {
                                "target_lang_word": "aggrieved",
                                "target_lang_sense_clarification": "feeling resentment at having been unfairly treated"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "озлобленный",
                                "target_lang_sense_clarification": "чувствующий горечь или обиду"
                            },
                            {
                                "target_lang_word": "разгневанный",
                                "target_lang_sense_clarification": "сильно рассерженный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
