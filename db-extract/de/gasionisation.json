                "senses": [
                    {
                        "sense_id": "e8268551-9ee3-3af1-ac2a-65fcdb523a43",
                        "entry_id": "368eb997-8a60-330e-b5f5-505ee504202f",
                        "glosses": [
                            "die Entfernung eines oder mehrerer Elektronen aus einem Gas-Atom oder -Molekül durch Energiezufuhr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0690c01-cea9-4142-88f4-4a87c2229ab3",
                                "sense_id": "e8268551-9ee3-3af1-ac2a-65fcdb523a43",
                                "text": "„Über Lichtaussendung bei Gasionisation handelten seine ersten 3 Veröffentlichungen noch vor seiner Dissertation 1906.“"
                            },
                            {
                                "example_id": "92a1b305-6956-47e9-a8d3-a98aa83431df",
                                "sense_id": "e8268551-9ee3-3af1-ac2a-65fcdb523a43",
                                "text": "„In diesem Bereich ist die Leitfähigkeit des Restgases aufgrund der Gasionisation maximal.“"
                            },
                            {
                                "example_id": "4e4ea7de-ebd5-4fa0-bdb6-9522c7d218c3",
                                "sense_id": "e8268551-9ee3-3af1-ac2a-65fcdb523a43",
                                "text": "„Ein auf Gasionisation basierender Spurdetektor ist die Zeitprojektionskammer (oder TPC von engl. Time Projection Chamber), mit der sich eine sehr gute Impulsauflösung erreichen lässt.“"
                            },
                            {
                                "example_id": "175f3f66-7cc7-4d15-bc0e-e30daab9ed6d",
                                "sense_id": "e8268551-9ee3-3af1-ac2a-65fcdb523a43",
                                "text": "„Werden diese anschließend beschleunigt, findet die Gasionisation durch einen Elektronenstoßprozess statt.“"
                            },
                            {
                                "example_id": "cc587a40-d146-478a-ac2e-d7612df8626c",
                                "sense_id": "e8268551-9ee3-3af1-ac2a-65fcdb523a43",
                                "text": "„Das Ziel dieser Arbeit war die Entwicklung eines universellen chemischen Sensors, der den ePID für die Gasionisation nutzt.“"
                            },
                            {
                                "example_id": "b62167fa-fabc-4922-9085-ceb59df2c56d",
                                "sense_id": "e8268551-9ee3-3af1-ac2a-65fcdb523a43",
                                "text": "„Nach der Durchquerung dieses Bereiches besitzen die Elektronen eine Energie, die es gestattet, daß effektive Gasionisation auftritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
