        "fr-extract.jsonl": [
            {
                "entry_id": "72ee8ea4-4e0e-3941-9aaf-f270381d6cf2",
                "word": "argenterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "62ceea8a-4519-4533-b8d8-100077b71eb8",
                        "entry_id": "72ee8ea4-4e0e-3941-9aaf-f270381d6cf2",
                        "tags": [
                            "plural"
                        ],
                        "form": "argenteries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b4fef11-76f7-32a6-bf8e-912e1b9272fd",
                        "entry_id": "72ee8ea4-4e0e-3941-9aaf-f270381d6cf2",
                        "glosses": [
                            "Vaisselle et ustensiles d’argent ou en métal (généralement du laiton) recouvert d'argent (métal argenté)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6acb2f-5ffc-47ee-9259-e9cf01e12e10",
                                "sense_id": "5b4fef11-76f7-32a6-bf8e-912e1b9272fd",
                                "text": "Il avait trouvé pour le Sacre, un hymne qui lui valut un service d’argenterie."
                            },
                            {
                                "example_id": "fdf33a3b-64b6-4bba-bcad-6bed2cd4975a",
                                "sense_id": "5b4fef11-76f7-32a6-bf8e-912e1b9272fd",
                                "text": "Les conversations reprirent ; pendant les moments de silence, on entendait, derrière les murs, des bruits légers de vaisselle et d’argenterie."
                            },
                            {
                                "example_id": "b29d444c-f19e-460e-b70f-0d076b86fc29",
                                "sense_id": "5b4fef11-76f7-32a6-bf8e-912e1b9272fd",
                                "text": "— Ma sœur Jeanne, s’écrie Telcide, nous monterons cette nuit l’argenterie dans notre chambre. Ces brigands sont très capables d’enfoncer les portes pour voler nos douze couverts dans le tiroir du buffet…"
                            },
                            {
                                "example_id": "e945315e-d9ac-427b-8335-2ef32598f482",
                                "sense_id": "5b4fef11-76f7-32a6-bf8e-912e1b9272fd",
                                "text": "« Ils ont tous une auto, un piano, de l’argenterie, des ameublements modernes, un appareil de T.S.F.… »"
                            }
                        ]
                    },
                    {
                        "sense_id": "f02735ab-e09b-3d1b-b14a-b899f31da15b",
                        "entry_id": "72ee8ea4-4e0e-3941-9aaf-f270381d6cf2",
                        "glosses": [
                            "Croix, du bénitier, des chandeliers et de tous les vases d’argent qui servent pour les cérémonies du culte."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d2dace5c-2053-4c01-8b9b-8f9eb6c1e782",
                                "sense_id": "f02735ab-e09b-3d1b-b14a-b899f31da15b",
                                "text": "L’argenterie d’une paroisse."
                            }
                        ]
                    },
                    {
                        "sense_id": "acdc8138-d359-39d8-937e-15e0814a9a49",
                        "entry_id": "72ee8ea4-4e0e-3941-9aaf-f270381d6cf2",
                        "glosses": [
                            "Fonds annuel qui était consacré à certaines dépenses extraordinaires du roi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38460d0f-f734-403f-b299-b0e74267b2fb",
                                "sense_id": "acdc8138-d359-39d8-937e-15e0814a9a49",
                                "text": "Trésorier et contrôleur de l’argenterie."
                            }
                        ]
                    }
