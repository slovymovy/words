                        "glosses": [
                            "S’absoudre soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a22a10d-0a05-426d-aa93-d15f5fc58cc2",
                                "sense_id": "775be340-9e2e-3623-94b0-c07281a4326d",
                                "text": "S'il revenait à lui de juger, il aurait la faculté de s'autoabsoudre : et, au contraire, lui aussi sera jugé."
                            },
                            {
                                "example_id": "aebd9a28-6ff2-4e26-8e7a-a23ae808b4d0",
                                "sense_id": "775be340-9e2e-3623-94b0-c07281a4326d",
                                "text": "Le pédophile minimise l'importance et la nocivité de ses actes, non seulement vis-à-vis de l'extérieur si on arrive à les connaître, mais à son propre égard. Au bout du compte, il s'autoabsout."
                            }
                        ]
                    }
