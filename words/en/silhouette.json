                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark <w>silhouette</w> of the castle was visible against the evening sky."
                        },
                        {
                            "text": "She saw the <w>silhouette</w> of a man standing in the doorway."
                        }
                    ],
                    "synonyms": [
                        "outline",
                        "profile",
                        "shadow"
                    ],
                    "common_phrases": [
