                    {
                        "translation_id": "33f93fd3-5ebe-4066-958f-5964caa33c66",
                        "source_entry_id": "0193bf81-a386-30c0-b000-242604567e5b",
                        "target_lang_word": "madrepore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madrepore",
