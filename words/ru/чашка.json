{
    "word_family": [
        "чаша",
        "чашечка",
        "чашечный",
        "чашеобразный",
        "чашкообразный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "992f6ac0-9596-37d7-ae8c-2e4d1cd36668",
                    "sense_definition": "Небольшой сосуд округлой формы, обычно с ручкой, предназначенный для питья чая, кофе или других напитков.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "посуда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро он выпивает горячую <w>чашку</w> черного кофе без сахара.",
                            "target_lang_translations": {
                                "en": "Every morning he drinks a hot <w>cup</w> of black coffee without sugar."
                            }
                        },
                        {
                            "text": "На кухонном столе стояла красивая фарфоровая <w>чашка</w> с тонким золотым узором.",
                            "target_lang_translations": {
                                "en": "On the kitchen table stood a beautiful porcelain <w>cup</w> with a delicate gold pattern."
                            }
                        }
                    ],
                    "synonyms": [
                        "чашечка"
                    ],
                    "common_phrases": [
                        "чашка чая",
                        "чашка кофе",
                        "фарфоровая чашка"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, rounded drinking vessel, usually with a handle, used for drinking tea, coffee, or other beverages."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cup",
                                "target_lang_sense_clarification": "drinking vessel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27ce8596-9b70-39ae-8e74-b8eeae6e0ccb",
                    "sense_definition": "Количество вещества или жидкости, вмещающееся в такой сосуд, используемое как мера объема.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "мера",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для приготовления этого простого пирога вам понадобится одна <w>чашка</w> белой муки.",
                            "target_lang_translations": {
                                "en": "To make this simple pie, you will need one <w>cup</w> of white flour."
                            }
                        },
                        {
                            "text": "Он насыпал в кастрюлю две полные <w>чашки</w> риса и залил их холодной водой.",
                            "target_lang_translations": {
                                "en": "He poured two full <w>cups</w> of rice into the pot and covered them with cold water."
                            }
                        }
                    ],
                    "common_phrases": [
                        "чашка муки",
                        "чашка риса"
                    ],
                    "target_lang_definitions": {
                        "en": "The amount of a substance or liquid that fits into such a vessel, used as a unit of measurement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cup",
                                "target_lang_sense_clarification": "unit of volume or capacity"
                            },
                            {
                                "target_lang_word": "cupful",
                                "target_lang_sense_clarification": "amount a cup can hold"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0636c779-3fcb-357c-b8e2-359301720598",
                    "sense_definition": "Круглая тарелка или плоский диск рычажных весов, на который кладут взвешиваемый груз или гири.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "весы",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Продавец положил спелые яблоки на правую <w>чашку</w> старых механических весов.",
                            "target_lang_translations": {
                                "en": "The seller placed the ripe apples onto the right <w>pan</w> of the old mechanical scales."
                            }
                        },
                        {
                            "text": "Когда гирю убрали, левая <w>чашка</w> весов мгновенно поднялась высоко вверх.",
                            "target_lang_translations": {
                                "en": "When the weight was removed, the left <w>pan</w> of the scale instantly rose high up."
                            }
                        }
                    ],
                    "synonyms": [
                        "чаша"
                    ],
                    "common_phrases": [
                        "чашка весов"
                    ],
                    "target_lang_definitions": {
                        "en": "A round plate or dish of a beam balance on which items or weights are placed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pan",
                                "target_lang_sense_clarification": "of a balance or scales"
                            },
                            {
                                "target_lang_word": "scale",
                                "target_lang_sense_clarification": "pan of a balance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09fe81e0-1e84-3e5a-8776-0d31eef29836",
                    "sense_definition": "Округлая кость, расположенная в передней части коленного сустава человека.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "анатомия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После неудачного падения на твердый лед спортсмен сильно повредил коленную <w>чашку</w>.",
                            "target_lang_translations": {
                                "en": "After an awkward fall onto the hard ice, the athlete severely injured his <w>kneecap</w>."
                            }
                        },
                        {
                            "text": "Врач осторожно ощупал правую <w>чашку</w> колена пациента и назначил рентген.",
                            "target_lang_translations": {
                                "en": "The doctor gently palpated the patient's right <w>kneecap</w> and ordered an X-ray."
                            }
                        }
                    ],
                    "synonyms": [
                        "чашечка"
                    ],
                    "common_phrases": [
                        "коленная чашка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное обозначение надколенника"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The rounded bone situated at the front of the human knee joint; kneecap."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kneecap",
                                "target_lang_sense_clarification": "patella bone"
                            },
                            {
                                "target_lang_word": "patella",
                                "target_lang_sense_clarification": "anatomical term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f9fb3e0-99fd-377f-95bb-0ec8c007fdb7",
                    "sense_definition": "Деталь механизма или прибора, имеющая форму полого полушария либо круглого углубления.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "техника",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер аккуратно очистил металлическую <w>чашку</w> подшипника от старой засохшей смазки.",
                            "target_lang_translations": {
                                "en": "The mechanic carefully cleaned the old, dried grease from the metal bearing <w>cup</w>."
                            }
                        },
                        {
                            "text": "Внутренняя стальная <w>чашка</w> шарнира заметно стерлась из-за постоянного трения деталей.",
                            "target_lang_translations": {
                                "en": "The inner steel <w>cup</w> of the joint had worn down noticeably due to constant friction between parts."
                            }
                        }
                    ],
                    "common_phrases": [
                        "чашка подшипника"
                    ],
                    "target_lang_definitions": {
                        "en": "A mechanical component shaped like a hollow hemisphere or round recess."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cup",
                                "target_lang_sense_clarification": "bearing or socket cup"
                            },
                            {
                                "target_lang_word": "socket",
                                "target_lang_sense_clarification": "mechanical joint or bearing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "533314ab-bfba-372f-8766-6fbf2fc3505f",
                    "sense_definition": "Уменьшительное к <w>чаша</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "посуда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старинном музее была выставлена небольшая ритуальная <w>чашка</w> из чистейшего серебра.",
                            "target_lang_translations": {
                                "en": "In the ancient museum, a small ritual <w>bowl</w> made of pure silver was on display."
                            }
                        },
                        {
                            "text": "Она бережно держала в ладонях маленькую деревянную <w>чашку</w> с прозрачной родниковой водой.",
                            "target_lang_translations": {
                                "en": "She carefully held a small wooden <w>bowl</w> with clear spring water in her palms."
                            }
                        }
                    ],
                    "synonyms": [
                        "чашечка"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "уменьшительная форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A diminutive of bowl, chalice, or goblet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "small bowl",
                                "target_lang_sense_clarification": "diminutive of chalice or bowl"
                            },
                            {
                                "target_lang_word": "chalice",
                                "target_lang_sense_clarification": "small ritual cup or bowl"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}