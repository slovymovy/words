                                "sense_id": "4f48b925-0c48-3218-bc5e-820d3f0597e7",
                                "text": "пусти́ться в подро́бности",
                                "translation": "to go into detail(s)/particulars",
                                "english": "to go into detail(s)/particulars"
                            },
                            {
                                "example_id": "7c7e734d-c944-4e63-9412-70c3ed37b2fc",
                                "sense_id": "4f48b925-0c48-3218-bc5e-820d3f0597e7",
                                "text": "пусти́ться в простра́нные объясне́ния",
                                "translation": "to start lengthy explanations",
