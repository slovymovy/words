                    "frequency": "VeryLow",
                    "semantic_group_id": "romantic_distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her newspaper column offered sympathetic guidance to every troubled <w>lovelorn</w> in the city."
                        },
                        {
                            "text": "The advice author listened patiently to each heartbroken <w>lovelorn</w> seeking solace."
