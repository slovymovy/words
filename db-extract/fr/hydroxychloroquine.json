                    },
                    {
                        "translation_id": "758aacc3-a36e-4c02-9316-2bd3273494cc",
                        "source_entry_id": "db522e5e-356c-3090-baa8-e7f8e92a4e04",
                        "source_sense_id": "471952fa-b18c-379e-876d-33ffcbe04e3d",
                        "target_lang_word": "hydroxychloroquine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydroxychloroquine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e6c46a7-65e8-3568-8224-5c7b6a80d187",
                                        "entry_id": "37d1779a-6de1-38ba-a185-385ff793d9ed",
                                        "glosses": [
                                            "A drug derived from quinolone that is taken orally in the form of its sulfate C₁₈H₂₆ClN₃O·H₂SO₄ to treat malaria, rheumatoid arthritis, and lupus erythematosus."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23ede0b5-a927-4343-b285-fc3af0f21c8e",
                                                "sense_id": "1e6c46a7-65e8-3568-8224-5c7b6a80d187",
                                                "text": "More on Malaria: Sterling-Winthrop Research Institute reports a new, effective antimalarial. Called hydroxychloroquine, its activity (with experimental animals) is equal to that of chloroquine, but it is much safer in large doses. Hydroxychloroquine can be taken orally or by injection and is retained in the blood for a longer period of time than chloroquine."
                                            },
                                            {
                                                "example_id": "73f77b0c-f632-4b6b-acd6-df39893bef88",
                                                "sense_id": "1e6c46a7-65e8-3568-8224-5c7b6a80d187",
                                                "text": "Seventy-five patients suffering from P. falciparum malaria were treated at Gressier, Haiti, with a single oral dose of hydroxychloroquine, which has the chemical structure 7-chloro-4 (4'-(N-ethyl-N-B-hydroxyethylamino)-1-methylbutylamino)-quinoline diphosphate."
                                            },
                                            {
                                                "example_id": "8d6f7807-15f7-40a9-bdeb-bc68de645ae0",
                                                "sense_id": "1e6c46a7-65e8-3568-8224-5c7b6a80d187",
                                                "text": "It is the purpose of our report to describe the effects of hydroxychloroquine sulfate in patients with active rheumatoid arthritis, and to compare these effects with those in a similar group of patients who received chloroquine phosphate for 18 months."
                                            },
                                            {
                                                "example_id": "58cc2eab-7fb1-46b0-a6f9-5fac0f922824",
                                                "sense_id": "1e6c46a7-65e8-3568-8224-5c7b6a80d187",
                                                "text": "Mr. [Donald] Trump’s recommendation of hydroxychloroquine, for the second day in a row at a White House briefing, was a striking example of his brazen willingness to distort and outright defy expert opinion and scientific evidence when it does not suit his agenda."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
