        "ru-extract.jsonl": [
            {
                "entry_id": "18c66f89-1c29-34f5-868e-2d7f3835af2c",
                "word": "впопыхах",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3dcd0af7-e265-3219-b29c-4cafea721baa",
                        "entry_id": "18c66f89-1c29-34f5-868e-2d7f3835af2c",
                        "glosses": [
                            "разг. торопливо, задыхаясь от поспешности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d53eae5-ba16-47ad-8250-4cb362a92431",
                                "sense_id": "3dcd0af7-e265-3219-b29c-4cafea721baa",
                                "text": "Слуги бегали впопыхах взад и вперед."
                            },
                            {
                                "example_id": "47afd3a3-64fa-4cef-812c-66fd32969b87",
                                "sense_id": "3dcd0af7-e265-3219-b29c-4cafea721baa",
                                "text": "Работник впопыхах вбежал к нему с криком: «Пожар! пожар!»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "990e656a-05b1-4620-b843-9be39b1b0be6",
                        "source_entry_id": "18c66f89-1c29-34f5-868e-2d7f3835af2c",
                        "source_sense_id": "3dcd0af7-e265-3219-b29c-4cafea721baa",
                        "target_lang_word": "à la hâte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la hâte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                        "entry_id": "f0ec86ce-51e8-32c1-863a-6475d02b7224",
                                        "glosses": [
                                            "En se dépêchant ; sans perdre de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb942e6e-f950-47b6-b0b4-63d4b37c40e2",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "— Je me jette aussi aux pieds de Votre Majesté pour qu’elle veuille m’accorder la révocation d’une rigueur que j’ai provoquée (je l’avoue publiquement), et que je regardai peut-être trop à la hâte comme utile au repos de l’État."
                                            },
                                            {
                                                "example_id": "d5795fec-0957-4abe-bdb2-f741a5955775",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "L’édition de 1885, très incomplète, avait été composée à la hâte, en l’espace de quelques mois, dans le but de donner satisfaction à la demande de MM. de Renzis et Bodio, en présentant la nouvelle méthode au Congrès pénitentiaire international de Rome."
                                            },
                                            {
                                                "example_id": "e8022831-a04e-4f93-9ee5-7a3651179a99",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "Un oratoire (msalla), simple mur en maçonnerie blanchi à la chaux, avait été construit à la hâte sur une colline voisine, toute blanche de pâquerettes."
                                            },
                                            {
                                                "example_id": "bd82c2e2-605f-4d51-9cf3-718e7ea88204",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "Je ne crois pas au temps record pour la reconstruction. Je crois au bon moment, nous devons le faire rapidement mais pas à la hâte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b692df68-6f8c-4263-ad5a-0f6ecb3e3f5b",
                        "source_entry_id": "18c66f89-1c29-34f5-868e-2d7f3835af2c",
                        "source_sense_id": "3dcd0af7-e265-3219-b29c-4cafea721baa",
                        "target_lang_word": "précipitamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précipitamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                        "entry_id": "b3913b7a-f61d-3564-b753-e0243001780c",
                                        "glosses": [
                                            "Avec précipitation ; à la hâte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d85616-be44-474a-bf85-1bba1a9044a2",
                                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                                "text": "L’invasion de la Belgique et du nord de la France par les Allemands disperse la famille Mermoz. Les grands-parents maternels de Jean choisissent la prudence et quittent précipitamment Mainbressy pour se réfugier à Aurillac, […]."
                                            },
                                            {
                                                "example_id": "52c14063-fd3e-4800-bb76-be656138ea14",
                                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                                "text": "Un mourant qui comptait plus de cent ans de vie, Se plaignait à la mort que précipitamment Elle le contraignait de partir tout à l’heure,"
                                            },
                                            {
                                                "example_id": "88018eda-de8a-41b2-8edb-0a818e4e107f",
                                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                                "text": "Cette impatience téméraire de la plupart des jeunes gens qui se dispensent de l’ordre du temps et de la raison, pour monter précipitamment aux premiers tribunaux du royaume,"
                                            },
                                            {
                                                "example_id": "2388cdb0-e120-41ca-b169-a30546fc1d74",
                                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                                "text": "Les Étoliens se réfugièrent précipitamment dans la citadelle,"
                                            },
                                            {
                                                "example_id": "0b7c2344-e425-4365-8ae0-479fa9c8b493",
                                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                                "text": "Ô que ceux qui jugent si précipitamment les enfants sont sujets à se tromper ! ils sont souvent plus enfants qu’eux,"
                                            },
                                            {
                                                "example_id": "9c6ce450-a79b-418d-8d3b-2c0335c20a5c",
                                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                                "text": "Les passagers embarquaient escortés d’une foule d’amis, affluaient sur le pont éclairé par la pâle clarté de la lune et s’engouffraient précipitamment dans les profondeurs du navire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
