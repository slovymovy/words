                                    },
                                    {
                                        "sense_id": "2ffc8130-ee35-3ddf-b635-0e904f4d3641",
                                        "entry_id": "8e733b14-49d6-34ba-a8a0-4fc614cc1211",
                                        "glosses": [
                                            "ein Geständnis machen, etwas verraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb57c34-37af-4c02-b730-c39ca45e6208",
                                                "sense_id": "2ffc8130-ee35-3ddf-b635-0e904f4d3641",
                                                "text": "Wenn er im Zeugenstand richtig auspackt, wird es noch weitere Anklagen geben."
                                            },
                                            {
                                                "example_id": "23248615-af81-432c-8cb3-2704e471d42c",
                                                "sense_id": "2ffc8130-ee35-3ddf-b635-0e904f4d3641",
                                                "text": "Nun pack schon aus! Wie war es gestern Abend? Habt ihr euch geküsst?"
                                            }
