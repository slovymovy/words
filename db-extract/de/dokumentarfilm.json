                ],
                "senses": [
                    {
                        "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                        "entry_id": "02b40c27-71a1-3f24-9d9e-97fc10c44197",
                        "glosses": [
                            "Film, der gedreht wurde, um ein bestimmtes Thema wirklichkeitsgetreu darzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f98829a-8837-48e2-a2dc-1c032da05106",
                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                "text": "„Einem polnischen Regisseur, der ihn auf Teneriffa besuchen wollte, um einen weiteren Dokumentarfilm über ihn zu drehen, ließ er ausrichten, er sei nicht mehr am Leben.“"
                            },
                            {
                                "example_id": "34d1424b-f01c-4961-9492-52788491eb37",
                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                "text": "„Ärrälä steht am Steg und berichtet von dieser untergehenden Kultur, über die er einen Dokumentarfilm plant.“"
                            },
                            {
                                "example_id": "59b21f8a-755f-4b15-9946-565da1f268d6",
                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                "text": "„Ein Bericht über die Vorführung dieser Dokumentarfilme und die Reaktion verschiedener deutscher Kultusminister findet sich ebenfalls in der Anlage zu diesem Bericht.“"
                            },
                            {
                                "example_id": "3b128052-1160-45db-9de5-f475cd69c5fe",
                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                "text": "„In Serien, Nachrichten-Beiträgen und Dokumentarfilmen guckt immer jemand weidwund in die Kamera, die Violinen spielen, es regnet, und man weiß sofort: Irgendwem ist Unrecht widerfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9024cb71-d7c2-441a-bce0-5c0dd3065bf5",
                        "source_entry_id": "02b40c27-71a1-3f24-9d9e-97fc10c44197",
                        "source_sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                        "source_sense_description": "Film, der gedreht wurde, um ein bestimmtes Thema wirklichkeitsgetreu darzustellen",
                        "target_lang_word": "documentary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "documentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "885c35f8-6473-3506-89a8-07dba106d956",
                                        "entry_id": "b31c9154-d2e1-3e5c-b965-d0c752af58ad",
                                        "glosses": [
                                            "A film, TV program, publication etc. which presents a social, political, scientific or historical subject in a factual or informative manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996acefc-a757-4636-861f-cd778c8815d1",
                                                "sense_id": "885c35f8-6473-3506-89a8-07dba106d956",
                                                "text": "Fifteen documentaries are in sharp-elbowed competition to be among the five Oscar nominees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91be00ec-6f50-34ad-8602-9442a64d136f",
                                        "entry_id": "b31c9154-d2e1-3e5c-b965-d0c752af58ad",
                                        "glosses": [
                                            "Such works collectively, as a genre."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db4eb5fc-197c-49e1-af50-9c97097bc358",
                                                "sense_id": "91be00ec-6f50-34ad-8602-9442a64d136f",
                                                "text": "Such sequences draw attention to the affective appeals that environmental documentary typically makes, precisely by absenting those appeals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "documentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "995422d3-2b96-3a1d-b2ec-62c44f53e336",
                                        "entry_id": "5d5552e4-c011-37b2-9e51-1a8d4d5af074",
                                        "glosses": [
                                            "Of, related to, or based on documents."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b9fb0b8-5f6f-3791-90f5-8927a49abeb7",
                                        "entry_id": "5d5552e4-c011-37b2-9e51-1a8d4d5af074",
                                        "glosses": [
                                            "Which serves to document (record or illustrate) a subject."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "323f327c-1e6f-3e76-9ca4-fc0048bea47e",
                                        "entry_id": "5d5552e4-c011-37b2-9e51-1a8d4d5af074",
                                        "glosses": [
                                            "Presented objectively without the insertion of fictional matter."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed813fa4-ca13-495a-bcc9-3012f25400a0",
                                                "sense_id": "323f327c-1e6f-3e76-9ca4-fc0048bea47e",
                                                "text": "a documentary film"
                                            },
                                            {
                                                "example_id": "3817b98d-4853-4fe1-b192-6dc9c19c80ab",
                                                "sense_id": "323f327c-1e6f-3e76-9ca4-fc0048bea47e",
                                                "text": "Just as there is a tradition of history painting, so there is one of history photographs — which of course are not documentary. They're posed as the world was supposed to be."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1363dc18-bf37-4ffd-b049-250a895afb84",
                        "source_entry_id": "02b40c27-71a1-3f24-9d9e-97fc10c44197",
                        "source_sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                        "source_sense_description": "Film, der gedreht wurde, um ein bestimmtes Thema wirklichkeitsgetreu darzustellen",
                        "target_lang_word": "documentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "documentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f345693-bdfc-322d-ab72-381022b410b0",
                                        "entry_id": "fe4b37d2-ed9e-310e-b7aa-483f9c52d11b",
                                        "glosses": [
                                            "Qui a le caractère d’un document ; qui contient des documents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fdda06b-0fb2-4323-a856-83fc7752980c",
                                                "sense_id": "9f345693-bdfc-322d-ab72-381022b410b0",
                                                "text": "À titre documentaire, nous donnons ci-dessous l’inventaire de deux noues en voie d'assèchement : […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "documentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfc7b7b6-8c20-38ef-b688-2f7beeeec657",
                                        "entry_id": "8a277708-06a4-3850-a018-60e38a8a0f1a",
                                        "glosses": [
                                            "Émission de radio ou de télévision, ou film de cinéma, qui a le caractère d’un document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d6cb83-31fe-40cc-af3c-bf1bd689bb25",
                                                "sense_id": "cfc7b7b6-8c20-38ef-b688-2f7beeeec657",
                                                "text": "Un documentaire en compétition au festival du cinéma indépendant de Sundance s'attache à démontrer que la guerre menée contre la drogue depuis 40 ans par les Etats-Unis cache en réalité une guerre sociale."
                                            },
                                            {
                                                "example_id": "8777588e-fc48-4eea-8463-1330ad1bbdeb",
                                                "sense_id": "cfc7b7b6-8c20-38ef-b688-2f7beeeec657",
                                                "text": "[…], pour le reste c'est bien un étage du centre, comme dans mes souvenirs : fonctionnel, scientifique, sympathique comme un documentaire sur les mygales."
                                            },
                                            {
                                                "example_id": "c33dfa9b-1ebc-4384-9de4-17927fe74633",
                                                "sense_id": "cfc7b7b6-8c20-38ef-b688-2f7beeeec657",
                                                "text": "Connu pour des documentaires comme J’veux du soleil ou Debout les femmes ! (coréalisés avec François Ruffin), le cinéaste s’essaie, pour la première fois, à la fiction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76352462-c93e-4b7a-8d2c-b3faf2027ebb",
                        "source_entry_id": "02b40c27-71a1-3f24-9d9e-97fc10c44197",
