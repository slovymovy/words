                "senses": [
                    {
                        "sense_id": "392466cd-2ae0-31d7-a8db-021b48c8f982",
                        "entry_id": "7e04e5b6-3973-3298-a2a3-95251c5b812e",
                        "glosses": [
                            "Angehöriger eines slawischen Volkes, das im ehemaligen Jugoslawien (vor allem in Bosnien und Herzegowina und im serbischen Sandschak) und in weltweiter Diaspora lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990fd193-86a7-475b-a8e4-7d779d89db05",
                                "sense_id": "392466cd-2ae0-31d7-a8db-021b48c8f982",
                                "text": "Die Bosniaken bekennen sich größtenteils zum Islam."
                            },
                            {
                                "example_id": "4c29ba72-f570-44d0-b369-e377972495bf",
                                "sense_id": "392466cd-2ae0-31d7-a8db-021b48c8f982",
                                "text": "Neben Kroaten und Serben sind die Bosniaken das dritte verfassungsmäßig konstitutive Volk in Bosnien und Herzegowina."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
