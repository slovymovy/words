        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                "word": "fluorescence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4035652d-9cdb-40fa-acca-b779cc277a32",
                        "entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                        "tags": [
                            "plural"
                        ],
                        "form": "fluorescences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4d7ef82-7d6e-3162-9427-2e5742b465d9",
                        "entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                        "glosses": [
                            "The emission of light (or other electromagnetic radiation) by a material when stimulated by the absorption of radiation or of a subatomic particle."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9c1b1d87-ca34-44a5-9d6d-3e3f0f9843f4",
                                "sense_id": "c4d7ef82-7d6e-3162-9427-2e5742b465d9",
                                "text": "A multi-institution US research team has combined some creative chemistry, fluorescence microscopy and laser-driven microballistics to gain a clearer view of just what happens in a high-strain-rate impact, and to tease out the relative contribution of different kinds of energy dissipation within the target (Nat. Commun., doi: 10.1038/s41467-024-52663-1)."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc025b5f-ce1d-3b55-8541-d4d4d6adf79a",
                        "entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                        "glosses": [
                            "The light so emitted."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a4b86a0-859c-495d-8f2d-d0dcc68f3d73",
                        "source_entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                        "source_sense_description": "emission of light",
                        "target_lang_word": "fluorescence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fluorescence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2e5ea7-87d2-3894-aee4-15365dc13175",
                                        "entry_id": "a7c8b2bb-f0e7-3317-9abb-18b220bc6d50",
                                        "glosses": [
                                            "Propriété d’un corps fluorescent, qui brille par électro-magnétisme, par opposition à la radiescence (par radio-activité) ou la phosphorescence (par réaction chimique)."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a339ac-8d24-418e-8fcd-154de27b8c63",
                                                "sense_id": "3d2e5ea7-87d2-3894-aee4-15365dc13175",
                                                "text": "De nombreux jaunes, par exemple, qu'ils soient d'origine naturelle (flavoniques) ou artificielle (azoïques) présentent une fluorescence non négligeable."
                                            },
                                            {
                                                "example_id": "eee284ad-2073-4039-9307-ba6d860cc627",
                                                "sense_id": "3d2e5ea7-87d2-3894-aee4-15365dc13175",
                                                "text": "Aucun phénomène de fluorescence n’avait encore été observé chez un amphibien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce2157f1-a8c1-4b87-84b2-fe5fef7ee407",
                        "source_entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                        "source_sense_description": "emission of light",
                        "target_lang_word": "Fluoreszenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fluoreszenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34d11588-e5fa-382e-b052-ef0c1a896e76",
                                        "entry_id": "201cb970-07b5-3688-a6b7-f9db58d5803d",
                                        "glosses": [
                                            "Leuchterscheinung bei bestimmten Stoffen, die während der Einwirkung durch Lichtstrahlen, Röntgenstrahlen oder Kathodenstrahlen hervorgerufen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "004faa0f-6ed2-4b61-8fc2-5024d0098597",
                                                "sense_id": "34d11588-e5fa-382e-b052-ef0c1a896e76",
                                                "text": "Fluoreszenz wird technisch eingesetzt, um z.B. Geldscheine und Briefmarken fälschungssicherer zu machen, findet aber auch verbreiteten Einsatz zur Analyse in weiten Bereichen der Naturwissenschaft wie Biochemie, Medizin, Geologie. In Diskotheken werden sie als \"unsichtbare\" Eintrittsstempel verteilt."
                                            },
                                            {
                                                "example_id": "3243ecfd-95df-437f-9b01-c9bf4156df08",
                                                "sense_id": "34d11588-e5fa-382e-b052-ef0c1a896e76",
                                                "text": "[…] Ernst Dorfi (Astronomie, Uni Wien): \"Es sind keine Strahlen, es sind ionisierte Teilchen, Protonen und Atomkerne.\" Die schießen von irgendwo in die Atmosphäre, man kann den Effekt sehen und messen: Er zeigt sich in Fluoreszenz und einem kilometerlangen Teilchenschauer."
                                            },
                                            {
                                                "example_id": "5f282949-a360-4f6b-ac5b-40fc09d875b0",
                                                "sense_id": "34d11588-e5fa-382e-b052-ef0c1a896e76",
                                                "text": "Durch den technisch recht einfachen Nachweis der Fluoreszenz konnten die Wissenschaftler beweisen, dass der Gentransfer tatsächlich geglückt und das Affenbaby Träger der betreffenden DNS-Sequenz ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fb1f127-fc53-4968-835e-5b44143e2e58",
