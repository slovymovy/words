                        "nourrir des soupçons"
                    ]
                },
                {
                    "sense_id": "fa7d81bd-c93a-3705-b27d-1a7644d602cd",
                    "sense_definition": "Alimenter ou enrichir une chose pour la faire durer, croître ou progresser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "developpement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent violent a continué de <w>nourrir</w> l'incendie toute la nuit."
                        },
                        {
                            "text": "Ces lectures variées aident à <w>nourrir</w> la créativité et la curiosité des élèves."
