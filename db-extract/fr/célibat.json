                                        "entry_id": "3de6baae-ce09-357a-a22e-e2f5ce98917b",
                                        "glosses": [
                                            "der Zustand, ehelos/unverheiratet zu sein; die Lebensweise, nicht durch eine Ehe gebunden zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b203c102-5d27-458a-b036-95963465cdf8",
                                                "sense_id": "ffa19b12-e0c9-30e2-9eee-2c859c7e40c5",
                                                "text": "Prof. Dr. Dietfried von Gnanderstein hält einen Vortag über Ehelosigkeit."
                                            },
                                            {
                                                "example_id": "859c3ff6-aed2-44d1-b2d7-ad77c39e0b88",
                                                "sense_id": "ffa19b12-e0c9-30e2-9eee-2c859c7e40c5",
                                                "text": "„Er war eingefleischter Junggeselle, ein begeisterter Verfechter der Ehelosigkeit, ein Verehrer des schönen Geschlechts, ein Freund und Gönner aller Freigeister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
