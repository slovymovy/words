                        "glosses": [
                            "vraagstuk rond de besteding van de tijd dat men niet hoeft te werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de1c190-e9c8-4349-8e15-551cc9045e52",
                                "sense_id": "d0b224fa-8bf1-36b7-8268-03490ca898ac",
                                "text": "Sociologe Iteke Weeda zei in Delft: 'We rennen de berg op en we rennen de berg weer af, maar we hebben niet eens de tijd genomen om van het uitzicht te genieten.'Als vrije tijd een probleem is, dan komt dat doordat mensen handelen vanuit een extern referentiekader. Het intern referentiekader wordt verwaarloosd en dat leidt tot stress. Kortom, er is geen vrijetijdsprobleem, maar een zingevingsprobleem.'"
                            },
                            {
                                "example_id": "577585ed-f437-49f3-b29a-7daceb70fd1f",
                                "sense_id": "d0b224fa-8bf1-36b7-8268-03490ca898ac",
                                "text": "Jongeren organiseren protesten, demonstraties en ludieke acties. Er zijn sit-ins, teach-ins en love-ins, politieke bijeenkomsten en rellen. De jongerenopstand wordt op dat moment door de autoriteiten vooral beschouwd als een vrijetijdsprobleem."
                            }
                        ]
                    }
