                },
                {
                    "sense_id": "b0fa1f15-f761-3ee0-8e12-b4637cf7abd1",
                    "sense_definition": "Prawo lub możliwość wypowiedzenia się w jakiejś sprawie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przewodniczący udzielił <w>słowa</w> ostatniemu z zaproszonych gości.",
                            "target_lang_translations": {
                                "ru": "Председатель предоставил <w>слово</w> последнему из приглашенных гостей."
                            }
