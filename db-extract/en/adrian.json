                    },
                    {
                        "translation_id": "d068d327-0849-44fa-b4dd-52e41359313e",
                        "source_entry_id": "7f7d765f-71c2-3c4f-8ba6-7f98d535ea76",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Adrien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adrien",
