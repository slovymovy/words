                                            {
                                                "example_id": "4920f0ee-85c7-4f18-904f-032ab37377ec",
                                                "sense_id": "b71cbe32-a72e-3655-bf7b-531c2422a55d",
                                                "text": "„Wir kennen eine Menge Beispiele von rudimentären Organen bei unseren Culturerzeugnissen, wie den Schwanzstummel in ungeschwänzten Rassen, den Ohrstummel in ohrlosen Rassen bei Schafen, das Wiedererscheinen kleiner nur in der Haut hängender Hörner bei ungehörnten Rinderrassen […] und den Zustand der ganzen Blüthe im Blumenkohl.“ [1876]"
                                            },
                                            {
                                                "example_id": "b087acea-10a8-4497-8afd-5130c416baa4",
                                                "sense_id": "b71cbe32-a72e-3655-bf7b-531c2422a55d",
                                                "text": "„Bei der Paarung von ohrlosen und normalohrigen Schafen hat die gesamte F₁-Generation Ohren von etwa halber Normalgröße.“"
                                            },
                                            {
                                                "example_id": "e816b1fe-cc24-400c-b0ba-06d28249330f",
                                                "sense_id": "b71cbe32-a72e-3655-bf7b-531c2422a55d",
                                                "text": "„In Fukushima erreicht die Strahlung [nach der Atomkatastrophe] Rekordwerte. Ein Youtube-Film zeigt […] ein ohrloses Kaninchen, das dort geboren worden sein soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
