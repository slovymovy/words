    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ade2089d-bc4c-3034-ab40-e656e29dea5e",
                    "sense_definition": "Bulletin ou prévisions des conditions atmosphériques diffusés dans les médias.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "previsions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je regarde toujours la <w>météo</w> avant de sortir le matin."
                        },
                        {
                            "text": "La <w>météo</w> annonce de la pluie pour toute la fin de semaine."
                        }
                    ],
                    "common_phrases": [
                        "bulletin météo",
                        "consulter la météo",
                        "présentateur météo"
                    ]
                },
                {
                    "sense_id": "f87653dc-c2f0-3b8d-8900-1eead5b516a5",
                    "sense_definition": "État de l'atmosphère à un moment et en un lieu donnés ; temps qu'il fait.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>météo</w> est favorable pour organiser une longue promenade en forêt."
                        },
                        {
                            "text": "Le départ du bateau a été reporté à cause d'une mauvaise <w>météo</w>."
                        }
                    ],
                    "synonyms": [
                        "temps"
                    ],
                    "common_phrases": [
                        "mauvaise météo",
                        "météo capricieuse",
                        "météo clémente"
                    ]
                },
                {
                    "sense_id": "c79c8424-4865-3eb1-aa03-15ce6548acd5",
                    "sense_definition": "Organisme ou service officiel chargé de surveiller l'atmosphère et de prévoir le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère a trouvé un travail d'ingénieur à la <w>météo</w> nationale."
                        },
                        {
                            "text": "Les prévisionnistes de la <w>météo</w> surveillent attentivement cette violente tempête hivernale."
                        }
                    ],
                    "common_phrases": [
                        "travailler à la météo"
                    ]
                },
                {
                    "sense_id": "aad75018-bfaa-340f-b7b3-f3f95963f684",
                    "sense_definition": "Science qui étudie les phénomènes atmosphériques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet étudiant s'intéresse à la <w>météo</w> et aux phénomènes climatiques extrêmes."
                        },
                        {
                            "text": "Les principes de base de la <w>météo</w> reposent sur la thermodynamique."
                        }
                    ],
                    "synonyms": [
                        "météorologie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "forme abrégée"
                        }
                    ]
                }
            ]
        }
