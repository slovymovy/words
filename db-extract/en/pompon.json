                                                "sense_id": "3891f32d-49e1-3e41-8ebb-6c4d15b3cc9a",
                                                "text": "„Der Pompon wird das Tamtam und das Tamtam der Pompon.“"
                                            },
                                            {
                                                "example_id": "8b09e9ba-3318-4a72-8a56-6d5c5a3c807a",
                                                "sense_id": "3891f32d-49e1-3e41-8ebb-6c4d15b3cc9a",
                                                "text": "„Einer der Pantoffeln ist mit einem Pompon geschmückt; beim andern ist er abgerissen.“"
                                            },
                                            {
                                                "example_id": "7ad888ec-a453-4bcd-974c-79fb8a7b7ac0",
                                                "sense_id": "3891f32d-49e1-3e41-8ebb-6c4d15b3cc9a",
                                                "text": "„Im Zimmer gab es ein Himmelbett und große Kleiderschränke mit Pompons an den Handgriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
