                "senses": [
                    {
                        "sense_id": "fcf385f9-b8be-3378-b041-0d87768b01d8",
                        "entry_id": "22b91dde-1b68-373e-af8b-d6a9616b051f",
                        "glosses": [
                            "Central Intelligence Agency (CIA), der US-amerikanische Auslandsnachrichtendienst"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "17c31c7c-9866-4031-a06b-f4798703cb96",
                                "sense_id": "fcf385f9-b8be-3378-b041-0d87768b01d8",
                                "text": "„Die Agency und eine rasch wachsende amerikanische Gruppe von Militärberatern sorgten für die Ausrüstung und Ausbildung des thailändischen Militärs, […].“"
                            },
                            {
                                "example_id": "23b29b79-b577-48dc-a241-e3d4d271a473",
                                "sense_id": "fcf385f9-b8be-3378-b041-0d87768b01d8",
                                "text": "„Wir ... na ja, hauptsächlich die Agency hat bedeutende Fortschritte beim Töten ihrer hochrangigen Zielpersonen erzielt, also der Anführer und wichtigen Militärs.“"
                            },
                            {
                                "example_id": "531617f7-789c-4bdc-abac-b9d7b61cf69f",
                                "sense_id": "fcf385f9-b8be-3378-b041-0d87768b01d8",
                                "text": "„Acht Mitarbeiter der Agency wurden bei dem Anschlag getötet und die Nahost-Sektion empfindlich dezimiert.“"
                            },
                            {
                                "example_id": "44993cef-a2ba-4ff9-8e00-f8fa55e72732",
                                "sense_id": "fcf385f9-b8be-3378-b041-0d87768b01d8",
                                "text": "„›Dann bleibt uns weniger als eine Stunde, um ein Team zu Szabo zu schicken, damit der Job erledigt ist, bevor die Jungs von der Agency eintrudeln.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
