                                                "example_id": "5b8c85ff-1934-4fef-ae2a-4d44b998a24f",
                                                "sense_id": "a3410760-e414-3418-bd1b-cee74166a093",
                                                "text": "Thisbé se bouche le nez devant Pyrame et dit : Pouah !"
                                            },
                                            {
                                                "example_id": "2e3bf5f4-1c7c-40c8-aaf8-2cfed6a2aaec",
                                                "sense_id": "a3410760-e414-3418-bd1b-cee74166a093",
                                                "text": "Ce contempteur de la ruse ment. Ce flétrisseur de la lâcheté use et mésuse de petits papiers. Pouah !"
                                            },
                                            {
                                                "example_id": "4bb8490b-e07d-494c-ae4c-051fe1efc75d",
                                                "sense_id": "a3410760-e414-3418-bd1b-cee74166a093",
                                                "text": "– Pouah ! fit Cary. Vous n’avez que de la bière et, par-dessus le marché, elle est chaude."
                                            },
                                            {
                                                "example_id": "ff7b47df-d9fa-4c7c-8fd1-6269a11220b3",
                                                "sense_id": "a3410760-e414-3418-bd1b-cee74166a093",
                                                "text": "– Pouah ! fit Aude en marquant son dégoût."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
