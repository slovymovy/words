                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fcd6383-5222-3bf4-974c-03e7584b7c1f",
                        "entry_id": "6f0d9dce-705d-3334-992c-df26acbd5aef",
                        "glosses": [
                            "узнать, получить ясное представление о чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d893a35-e5f0-4f20-a575-8bed643be14c",
                                "sense_id": "7fcd6383-5222-3bf4-974c-03e7584b7c1f",
                                "text": "Накануне вечером Женька даже не смог выяснить, детерминистка Ли или нет."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcfe4fec-8f0b-3230-9487-3e7f9a87534d",
                        "entry_id": "6f0d9dce-705d-3334-992c-df26acbd5aef",
                        "glosses": [
                            "устар., разг., о прояснении неба, о наступлении ясной погоды"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b12ee13-5dd9-45b7-a76e-20035972ce25",
                        "source_entry_id": "6f0d9dce-705d-3334-992c-df26acbd5aef",
                        "source_sense_description": "узнать, внести ясность",
                        "target_lang_word": "find out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "find out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover, as by asking or investigating."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d41972-c2be-429a-8700-fb5fbc415413",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I don't know who the twenty-first president of the United States was, but it should be very easy to find out."
                                            },
                                            {
                                                "example_id": "17479836-6c47-456a-882d-d626c2402730",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "\"Why shouldn't somethin' new and wonderful lie in such a country? And why shouldn't we be the men to find it out?\""
                                            },
                                            {
                                                "example_id": "2698d7f2-9c46-4811-99a8-452e180fa116",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "Somethin' happens when everybody finds out\nSee the vultures circling, dark clouds"
                                            },
                                            {
                                                "example_id": "b5779327-7631-4b2d-8526-b5842c554fbe",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover or expose (someone) as disobedient, dishonest, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168f191d-6882-4262-a319-40a2b21fd1cf",
                                                "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                                "text": "He had been fiddling the books for years, but finally he was found out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To uncover a weakness in (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7a0f06-075b-446e-90ad-f31d91d112dd",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "He may cope with the multiple choice questions, but the written exam will find him out."
                                            },
                                            {
                                                "example_id": "7f7cf588-e8e4-4a32-8946-dad5dd8b0b78",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "If you don't try, you do not find it out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810bfa98-4168-3a61-9601-b446cfb557a3",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover (something), as by perceiving or coming upon it."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To receive the consequences of one's actions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf557d0e-8915-420a-a72e-49f603f56375",
                                                "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                                "text": "With the way he behaved, it's no wonder he found out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55e897a8-6c6a-4ba7-888e-e3ce8ec94dae",
                        "source_entry_id": "6f0d9dce-705d-3334-992c-df26acbd5aef",
                        "source_sense_description": "узнать, внести ясность",
                        "target_lang_word": "ascertain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascertain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82624a19-792f-316e-88a3-cd9fd2785785",
                                        "entry_id": "275638da-7cba-384c-b6a6-391205ad8f12",
                                        "glosses": [
                                            "To find out definitely; to discover or establish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a38080a-1879-4791-9a87-d9ef31081fa7",
                                                "sense_id": "82624a19-792f-316e-88a3-cd9fd2785785",
                                                "text": "As soon as we ascertain what the situation is, we can plan how to proceed."
                                            },
                                            {
                                                "example_id": "b93bb522-3eda-4059-8e73-61fa61ca5ac6",
                                                "sense_id": "82624a19-792f-316e-88a3-cd9fd2785785",
                                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom.[…]”"
                                            },
                                            {
                                                "example_id": "dbf266b0-e599-4681-997a-2810e44a5e52",
                                                "sense_id": "82624a19-792f-316e-88a3-cd9fd2785785",
                                                "text": "Walk the dog in the pounding rain / Looking for a way out of my brain, trapped in it / But I cannot ascertain that I'm trapped in it / Or that the traps even real so I remain trapped in this chambers"
                                            },
                                            {
                                                "example_id": "331e903a-96ba-4ea3-8067-33ffbe666300",
                                                "sense_id": "82624a19-792f-316e-88a3-cd9fd2785785",
                                                "text": "\"[…] On the 18th of October, 1841, a very intense magnetic disturbance was recorded, and amongst other curious facts mentioned is that of the detention of the 10:05pm express train at Exeter for 16 minutes, as from the magnetic disturbance affecting the needles so powerfully, it was impossible to ascertain if the line was clear at Starcross. The superintendent at Exeter reported the next morning that someone was playing tricks with the instruments, and would not let them work.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4ca95d-58e7-3f0d-98f0-279877bda69e",
                                        "entry_id": "275638da-7cba-384c-b6a6-391205ad8f12",
                                        "glosses": [
                                            "To make (someone) certain or confident about something; to inform."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2f7eaa-7714-47b7-a1c8-56a5a05e562b",
                                                "sense_id": "1a4ca95d-58e7-3f0d-98f0-279877bda69e",
                                                "text": "Therfore the saide cõmissioners shall mowe say that nowe late during the parlement the King ascertaigned of the saide maliciouse pʳpose of his enemys, willed and desired the lords being then present to shewe their̃ good willes aide and helpe for the saide rescues[…]"
                                            },
                                            {
                                                "example_id": "ad753183-d29d-4940-81c3-468c23856387",
                                                "sense_id": "1a4ca95d-58e7-3f0d-98f0-279877bda69e",
                                                "text": "We would most gladly ye came yourself if that ye may […] praying you to ascertain us of your News."
                                            },
                                            {
                                                "example_id": "7d989f5a-a41c-492c-8ba9-6371cb901ed3",
                                                "sense_id": "1a4ca95d-58e7-3f0d-98f0-279877bda69e",
                                                "text": "Muncer Assured them, that the design was approved of by Heaven, and that the Almighty had in a dream ascertained him of its success."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a44943f-f612-3746-9cc4-032bd677fb3f",
                                        "entry_id": "275638da-7cba-384c-b6a6-391205ad8f12",
                                        "glosses": [
                                            "To look for something lost."
                                        ],
                                        "tags": [
                                            "Yorkshire",
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "523171d7-bed0-3905-bcb3-a43724eb5e4d",
                                        "entry_id": "275638da-7cba-384c-b6a6-391205ad8f12",
                                        "glosses": [
                                            "To establish, to prove."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b649a26a-fb59-4c21-b8a1-5fd57a0a58c3",
                                                "sense_id": "523171d7-bed0-3905-bcb3-a43724eb5e4d",
                                                "text": "The two firſt lines of the following book ſeem to aſcertain the true meaning of the concluſion of this, and to prove ſufficiently that by Ωκεανός here, Homer could not poſſibly intend any other than a river."
                                            },
                                            {
                                                "example_id": "4610f067-a9b0-4736-8181-fcfb569f67d8",
                                                "sense_id": "523171d7-bed0-3905-bcb3-a43724eb5e4d",
                                                "text": "In 1695 he [Walter Moyle] was chosen to represent the borough of Saltash in parliament ; a circumstance which ascertains the piece before us to have been written subsequent to that period."
                                            },
                                            {
                                                "example_id": "1caba9a2-12f2-406e-8e15-8befac700ba5",
                                                "sense_id": "523171d7-bed0-3905-bcb3-a43724eb5e4d",
                                                "text": "We must look somewhat deeper would we learn why a book which now tries our patience was not undeserving of those multiplied editions which have ascertained its popularity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91a1c53-05cc-31ca-964a-c592bf9a3b1f",
                                        "entry_id": "275638da-7cba-384c-b6a6-391205ad8f12",
                                        "glosses": [
                                            "To ensure or effect."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b10e52-b625-40d1-8f5d-b2c3f5e7f520",
                                                "sense_id": "c91a1c53-05cc-31ca-964a-c592bf9a3b1f",
                                                "text": "It is true, that no diligence can aſcertain ſucceſs ; death may intercept the ſwifteſt career ; but he who is cut off in the execution of an honeſt undertaking, has at leaſt the honour of falling in his rank, and has fought the battle, though he miſſed the victory."
                                            },
                                            {
                                                "example_id": "ca38cea3-4820-496c-99bd-d616dc96d408",
                                                "sense_id": "c91a1c53-05cc-31ca-964a-c592bf9a3b1f",
                                                "text": "The ministry, in order to ascertain a majority in the house of lords, persuaded the queen to take a measure which nothing but necessity could justify."
                                            },
                                            {
                                                "example_id": "dfd07252-0c98-4046-abb5-87b786e0fa46",
                                                "sense_id": "c91a1c53-05cc-31ca-964a-c592bf9a3b1f",
                                                "text": "On the contrary, the Squire’s influence as a man of family and property, in the immediate neighbourhood, who actually kept greyhounds, and at least talked of hunters and races, ascertained him the support of the whole class of bucks, half and whole bred, from the three next counties ; and if more inducements were wanting, he could grant his favourites the privilege of shooting over his moors, which is enough to turn the head of a young Scotchman at any time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
