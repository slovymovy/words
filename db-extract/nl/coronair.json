                                        "sense_id": "c68203d3-c0a7-3b3d-b7ec-ab534891313b",
                                        "entry_id": "44afa477-e47d-360c-9ade-69851b963e8d",
                                        "glosses": [
                                            "Pertaining to a crown or garland."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ca5944-667f-4bbf-882d-3cc3a77a8295",
                                                "sense_id": "c68203d3-c0a7-3b3d-b7ec-ab534891313b",
                                                "text": "The coronary thorns did not only express the scorn of the imposers by that figure into which they were contrived, but did also pierce his tender and sacred temples to a multiplicity of pains, by their numerous acuminations."
                                            },
                                            {
                                                "example_id": "fa707a5a-54eb-466a-854d-c6b5924019ca",
                                                "sense_id": "c68203d3-c0a7-3b3d-b7ec-ab534891313b",
                                                "text": "The catalogue of coronary plants is not large in Theophrastus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97996785-a7b3-3698-a203-ee676ab306a3",
                                        "entry_id": "44afa477-e47d-360c-9ade-69851b963e8d",
                                        "glosses": [
                                            "Encircling something (like a crown), especially with regard to the arteries or veins of the heart."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "coronary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "325a92f7-7fd5-3a60-a10f-07082b7adaa1",
                                        "entry_id": "50496652-2b0f-3982-9bee-2ecb241b88e2",
                                        "glosses": [
                                            "Any of the coronary vessels; a coronary artery or coronary vein."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56514c75-996d-3731-9b78-a6cfde2b35db",
                                        "entry_id": "50496652-2b0f-3982-9bee-2ecb241b88e2",
                                        "glosses": [
                                            "Ellipsis of coronary thrombosis."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5362eb87-6097-43e9-ad70-96c02066cdd5",
                                                "sense_id": "56514c75-996d-3731-9b78-a6cfde2b35db",
                                                "text": "Manny had a coronary last week, followed by a triple bypass."
                                            },
                                            {
                                                "example_id": "15499b31-af93-4530-a68b-2a20a5ca2973",
                                                "sense_id": "56514c75-996d-3731-9b78-a6cfde2b35db",
                                                "text": "Before each crisis I mentioned, we first experienced what could be called a “mild” heart attack, alerting us that we had gone to extremes and stripped away buffers that had protected us from catastrophic failure. In each case, though, we did not take that warning seriously enough — and in each case the result was a full global coronary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0c3d5d-ea46-39fd-9b1d-5f6fc1daa9b1",
                                        "entry_id": "50496652-2b0f-3982-9bee-2ecb241b88e2",
                                        "glosses": [
                                            "A small bone in the foot of a horse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cebf28b-8047-4875-aea3-aa35da92c91d",
                        "source_entry_id": "f1042b77-975b-3199-9373-65061c8c5208",
