        "nl-extract.jsonl": [
            {
                "entry_id": "0dcb6c42-7ef6-3e11-a5aa-622473e3c181",
                "word": "geklepper",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d6c9d72-d2f4-347d-94b3-13354458d885",
                        "entry_id": "0dcb6c42-7ef6-3e11-a5aa-622473e3c181",
                        "glosses": [
                            "het aanhoudend klepperen; het voortdurend geluid van twee harde voorwerpen die tegen elkaar slaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb89cf7-89a4-42d1-9e4d-700979e67c34",
                                "sense_id": "8d6c9d72-d2f4-347d-94b3-13354458d885",
                                "text": "Het zijn, in lijn met de YouTube-cultuur, korte nummers die qua stijl alle kanten opgaan. ‘Hands up’ refereert met audioclips aan politiegeweld tegen zwarte tieners. Het vrolijke ‘Best to you’ is met zijn woodblock-geklepper de absolute hit. Juist die tegenstelling tussen licht en zwaar, blij en beladen maken het album zo aantrekkelijk."
                            },
                            {
                                "example_id": "531416a0-cab2-4072-a529-d7f130b0f3d6",
                                "sense_id": "8d6c9d72-d2f4-347d-94b3-13354458d885",
                                "text": "Wie zich in de expositieruimte bevindt, hoort buiten het geklepper van de ooievaars die broeden op het stadhuis van Gennep."
                            },
                            {
                                "example_id": "035aa86b-8b18-4888-a2b1-031d2a9cf7b9",
                                "sense_id": "8d6c9d72-d2f4-347d-94b3-13354458d885",
                                "text": "Buiten waren kreten en politiefluitjes te horen en het geluid van houwende machetes die ijzer of mensen raakten, er kwamen steeds meer politiefluitjes bij en in de verte was het geklepper van paardenhoeven te horen."
                            }
                        ]
                    }
                ],
