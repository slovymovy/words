    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                    "sense_definition": "Qui a un attachement excessif à l'argent et répugne à faire la moindre dépense.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon oncle est tellement <w>avare</w> qu'il refuse d'allumer le chauffage en plein hiver.",
                            "target_lang_translations": {
                                "en": "My uncle is so <w>stingy</w> that he refuses to turn on the heating in the middle of winter.",
                                "ru": "Мой дядя такой <w>скупой</w>, что отказывается включать отопление посреди зимы.",
                                "de": "Mein Onkel ist so <w>geizig</w>, dass er sich weigert, mitten im Winter die Heizung anzuschalten.",
                                "es": "Mi tío es tan <w>tacaño</w> que se niega a encender la calefacción en pleno invierno.",
                                "zh": "我叔叔<w>吝啬</w>到连大冬天都不肯开暖气。"
                            }
                        },
                        {
                            "text": "Elle n'est pas pauvre mais reste très <w>avare</w> envers les membres de sa famille.",
                            "target_lang_translations": {
                                "en": "She isn't poor, but she remains very <w>stingy</w> towards the members of her family.",
                                "ru": "Она не бедная, но остаётся очень <w>скупая</w> с членами своей семьи.",
                                "de": "Sie ist nicht arm, bleibt aber gegenüber ihren Familienmitgliedern sehr <w>geizig</w>.",
                                "es": "No es pobre, pero sigue siendo muy <w>tacaña</w> con los miembros de su familia.",
                                "zh": "她并不穷，但对家里人仍然非常<w>吝啬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "radin",
                        "pingre",
                        "parcimonieux",
                        "regardant"
                    ],
                    "antonyms": [
                        "généreux",
                        "dépensier"
                    ],
                    "target_lang_definitions": {
                        "en": "Having an excessive attachment to money and being reluctant to spend even a little.",
                        "ru": "Чрезмерно дорожащий деньгами и неохотно тратящий даже мелкие суммы.",
                        "de": "Jemand, der übermäßig an Geld hängt und ungern auch nur geringe Summen ausgibt.",
                        "es": "Que siente un apego excesivo por el dinero y se resiste a gastar, incluso poco.",
                        "zh": "对钱财有过分的执着，舍不得花一点钱。"
                    },
                    "translations": {
