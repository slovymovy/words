                        "examples": [
                            {
                                "example_id": "4f67e798-2409-45e4-a4e3-2c8f142a6dc5",
                                "sense_id": "dc8cfb11-3509-3bda-a665-b85bd3272722",
                                "text": "They cross the chasmy torrent's foam-lit bed, / Rocked on the dizzy larch's narrow tread; […]"
                            },
                            {
                                "example_id": "dc655d1d-987c-48cb-a25d-3dd2f884efa2",
                                "sense_id": "dc8cfb11-3509-3bda-a665-b85bd3272722",
                                "text": "North-eastward, at the extreme right, or Elbe point of it, where Grüne and the Austrians stand, it has grown so chasmy, we judge that Grüne can neither advance nor be advanced upon: so we leave him standing there,—which he did all day, in a purely meditative posture."
                            }
                        ]
                    }
