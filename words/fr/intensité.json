            "senses": [
                {
                    "sense_id": "1d454ca3-cb70-36d8-841b-754c2813f97b",
                    "sense_definition": "Degré d'activité, de force ou de puissance qui caractérise un phénomène ou une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>intensité</w> de la tempête a surpris tous les habitants de la région."
                        },
                        {
                            "text": "L'entraînement physique a augmenté en <w>intensité</w> au fil des semaines."
                        }
                    ],
                    "common_phrases": [
                        "gagner en intensité",
                        "perdre en intensité"
                    ]
                },
                {
                    "sense_id": "8448d939-2758-3070-b9a7-73cf109438bd",
                    "sense_definition": "Force et profondeur d'un sentiment, d'une émotion ou d'une expression.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a exprimé sa gratitude avec une vive <w>intensité</w> lors de son discours."
                        },
                        {
