    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "eb8b1526-9819-36e3-a0f1-5f573c2c6d6a",
                "word": "molybdomancy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2bc76598-2224-3e11-bedd-ca1f772339c9",
                        "entry_id": "eb8b1526-9819-36e3-a0f1-5f573c2c6d6a",
                        "glosses": [
                            "divination by interpreting shapes formed when molten metal, typically lead or tin, is dropped into water."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "edd362ff-4705-46ed-b768-5c4f60a74fbf",
                                "sense_id": "2bc76598-2224-3e11-bedd-ca1f772339c9",
                                "text": "1727, Bailey, The Universal Etym. Eng. Dict.\nMOLUBDOMANCY [molybdomanteia of molybdos Lead, and manteia Divination, Gr.] a divining, an observing the motions, Figures, &c. of melted Lead."
                            },
                            {
                                "example_id": "92a7aef0-6d66-44f5-8209-efdba78b6b10",
                                "sense_id": "2bc76598-2224-3e11-bedd-ca1f772339c9",
                                "text": "1931, de Givry, Lock tr., Picture Museum of Sorcery\nMolybdomancy was divination by melted lead; drops of it were allowed to fall into water, and the resulting noises and hissings listened to."
                            },
                            {
                                "example_id": "e51b8f35-25e8-44ab-ab09-dd904d8749e8",
                                "sense_id": "2bc76598-2224-3e11-bedd-ca1f772339c9",
                                "text": "The place of molybdomancy is also to be located in the uncertain border area between spontaneous and solicited projection."
                            },
                            {
                                "example_id": "695f746b-ae73-438b-891b-8ce1d50add36",
                                "sense_id": "2bc76598-2224-3e11-bedd-ca1f772339c9",
                                "text": "There was a happy group in Tallahassee swapping wives on the basis of molybdomancy."
                            },
                            {
                                "example_id": "f71c105a-0bda-4a7e-b4fd-72828e29981e",
                                "sense_id": "2bc76598-2224-3e11-bedd-ca1f772339c9",
                                "text": "Dropping hot lead or tin into water was another method occasionally employed by the Etruscans in a version of molybdomancy, much like ceromancy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d5afe4b-0aad-43e3-8bac-3a749f8dcd10",
                        "source_entry_id": "eb8b1526-9819-36e3-a0f1-5f573c2c6d6a",
                        "source_sense_id": "2bc76598-2224-3e11-bedd-ca1f772339c9",
                        "source_sense_description": "divination by molten metal dropped in water",
                        "target_lang_word": "molybdomancie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molybdomancie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c6188a-4315-3735-9e0a-8d82b36cd5e0",
                                        "entry_id": "6937954d-a323-3221-a0f1-e09af6f81b49",
                                        "glosses": [
                                            "Méthode de divination utilisant le plomb fondu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9541717-0d62-4e62-a598-e99499e04e14",
                                                "sense_id": "f8c6188a-4315-3735-9e0a-8d82b36cd5e0",
                                                "text": "Une coutume qui s'est perpétuée jusqu’à nos jours dans la Suisse allemande est la pratique de la molybdomancie; elle consiste à verser du plomb fondu sur une table unie et mouillée ou dans un baquet d'eau. En se solidifiant, le métal forme une foule de signes qu’on interprète comme des présages. Les filles y cherchent encore l’annonce d’un prochain mariage."
                                            },
                                            {
                                                "example_id": "bfcf19ba-341e-446b-9992-93b957525b85",
                                                "sense_id": "f8c6188a-4315-3735-9e0a-8d82b36cd5e0",
                                                "text": "La molybdomancie est un procédé divinatoire, dont Pierre de Lancre nous dit en 1622 qu’il consiste à tirer des présages du plomb fondu en fonction du nombre, de la forme ou du mouvement des gouttelettes qui se forment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
