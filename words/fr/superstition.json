                {
                    "sense_id": "89a0c1b3-b188-3796-8a8c-583ea7888597",
                    "sense_definition": "Croyance irrationnelle qui attribue un caractère surnaturel, magique ou sacré à certains faits ou objets.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "croyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse catégoriquement de passer sous une échelle par simple <w>superstition</w>."
                        },
                        {
                            "text": "La <w>superstition</w> pousse certaines personnes à craindre particulièrement le vendredi treize."
                        }
                    ],
                    "synonyms": [
                        "irrationalisme"
                    ],
                    "antonyms": [
                        "raison",
                        "rationalisme"
                    ],
                    "common_phrases": [
                        "par superstition"
                    ]
                },
                {
                    "sense_id": "f08c9a71-38df-367a-a3a6-d6244feaa63e",
                    "sense_definition": "Pratique, rite ou préjugé inspiré par une croyance magique ou irrationnelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "croyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce village isolé conserve de nombreuses <w>superstitions</w> transmises de génération en génération."
                        },
                        {
                            "text": "Les marins respectent souvent d'anciennes <w>superstitions</w> populaires pour éviter le mauvais sort."
                        }
                    ],
                    "common_phrases": [
                        "superstitions populaires"
                    ]
                },
                {
                    "sense_id": "7ab3cc92-3fcf-3d44-b9c6-88f1dce01616",
                    "sense_definition": "Attachement excessif et scrupuleux à une règle, une habitude ou un détail.",
