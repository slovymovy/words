                        "бывать в гостях"
                    ]
                },
                {
                    "sense_id": "24f75194-ef9e-3845-8603-b5ded2deb54d",
                    "sense_definition": "Происходить, случаться время от времени или регулярно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Такие ошибки <w>бывают</w> у всех начинающих учеников."
                        },
                        {
                            "text": "В этом регионе часто <w>бывают</w> сильные дожди осенью."
                        }
                    ],
                    "common_phrases": [
