        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ce527bd-1819-3ff5-b463-fa84576d5efe",
                    "sense_definition": "A sudden, strong pull.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>tug</w> on her bag while standing in the crowded train.",
                            "target_lang_translations": {
                                "ru": "Она ощутила внезапный <w>рывок</w> своей сумки, стоя в переполненном поезде.",
                                "zh": "站在拥挤的火车上时，她感觉到包被<w>猛拉</w>了一下。",
                                "pl": "Stojąc w zatłoczonym pociągu, poczuła nagłe <w>szarpnięcie</w> za torbę.",
                                "cs": "Když stála v přeplněném vlaku, ucítila náhlé <w>škubnutí</w> za tašku."
                            }
                        },
                        {
                            "text": "With a quick <w>tug</w>, he managed to free the stuck rope.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>рывком</w> ему удалось освободить застрявшую веревку.",
                                "zh": "他<w>拽动</w>了一下，成功解开了卡住的绳子。",
                                "pl": "Szybkim <w>pociągnięciem</w> udało mu się uwolnić zaklinowaną linę.",
                                "cs": "Rychlým <w>trhnutím</w> se mu podařilo uvolnit zaseknuté lano."
                            }
                        }
                    ],
                    "synonyms": [
                        "jerk",
                        "yank",
                        "pull"
                    ],
                    "antonyms": [
                        "push"
                    ],
                    "common_phrases": [
                        "sharp tug",
                        "quick tug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, резкое или сильное движение на себя; рывок.",
                        "zh": "突然而强烈的拉力。",
                        "pl": "Nagłe, silne pociągnięcie.",
                        "cs": "Náhlé, prudké nebo silné zatáhnutí."
                    },
