                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdc0e7b0-ab12-4dda-bf2c-b6033f378dfe",
                        "source_entry_id": "68115489-8fad-3cda-9cb0-4e341acda03d",
                        "source_sense_id": "637d0c62-7db5-3daf-a0f4-a74f927b1d06",
                        "source_sense_description": "bericht of mededeling over de toestand van het weer",
                        "target_lang_word": "Wetterbericht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wetterbericht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49e183e0-d40d-3154-b35d-6680b31acdcd",
                                        "entry_id": "39006981-dd6c-3f69-9e0d-40f0331d1077",
                                        "glosses": [
                                            "öffentlicher Bericht über die Wetterlage und die voraussichtliche Entwicklung des Wetters in einem angegebenen Zeitraum (Wetterprognose)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7020b2c-f5b3-4f3c-bca8-54cec91bf9a2",
                                                "sense_id": "49e183e0-d40d-3154-b35d-6680b31acdcd",
                                                "text": "Der Wetterbericht sagt Sonnenschein fürs Wochenende voraus."
                                            },
                                            {
                                                "example_id": "e945ceb9-da8f-4f2f-91ae-693c19cfc361",
                                                "sense_id": "49e183e0-d40d-3154-b35d-6680b31acdcd",
                                                "text": "„Ein paar Arbeiter diskutierten über Rennpferde in Nizza, zwei Postschaffner studierten den Wetterbericht aus Paris, und ein Kutscher renommierte mit seinen Zeiten als Trabrennfahrer.“"
                                            },
                                            {
                                                "example_id": "bd7dc8bb-3ecd-4c46-9886-0b41e7becf0f",
                                                "sense_id": "49e183e0-d40d-3154-b35d-6680b31acdcd",
                                                "text": "„Noch nie hatte er einen Wetterbericht mit soviel Aufmerksamkeit verfolgt.“"
                                            },
                                            {
                                                "example_id": "fbc02ccf-23d7-4d66-b9e9-e88db0168866",
                                                "sense_id": "49e183e0-d40d-3154-b35d-6680b31acdcd",
                                                "text": "„Den Wetterberichten zufolge herrscht aber überall, wohin du möchtest, dasselbe Sauwetter.“"
                                            },
                                            {
                                                "example_id": "c939a209-8a35-4f94-8f7c-3586f667c1de",
                                                "sense_id": "49e183e0-d40d-3154-b35d-6680b31acdcd",
                                                "text": "„Das Interessanteste war noch der Wetterbericht, der für die Woche nach Ostern schlechtes Wetter im Norden vorhersagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9534b7fd-db4e-4416-9161-c7842dd295df",
                        "source_entry_id": "68115489-8fad-3cda-9cb0-4e341acda03d",
                        "source_sense_id": "637d0c62-7db5-3daf-a0f4-a74f927b1d06",
                        "source_sense_description": "bericht of mededeling over de toestand van het weer",
                        "target_lang_word": "Wettervorhersage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wettervorhersage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                        "entry_id": "167169a0-77df-3e8b-9fd5-35b2ab12991f",
                                        "glosses": [
                                            "eine Aussage über den angenommenen Verlauf des Wetters in der nächsten Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8a1164-6257-4106-9072-c67b19c47105",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "Laut Wettervorhersage soll es am Wochenende regnen."
                                            },
                                            {
                                                "example_id": "9c7ab53d-09e1-456c-873f-9184da29cdae",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "Die Wettervorhersage ist nur kurzfristig präzise."
                                            },
                                            {
                                                "example_id": "0c6923e1-236e-4a97-ba7c-4c5ed057d246",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "Weiterhin teilte der Direktor des National Satellite Meteorological Centre, Yang Jun, mit, dass man zwei Wettersatelliten zur Wettervorhersage noch vor den Olympischen Sommerspielen 2008 in Peking starten will."
                                            },
                                            {
                                                "example_id": "b2a69b2d-24a1-478a-925d-88d04e927ac0",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "„Der Einsatz der zweiten Atombombe war für den 11. August anberaumt, aber die Wettervorhersage für diesen Tag war schlecht.“"
                                            },
                                            {
                                                "example_id": "9af164f1-1d94-4e04-8d18-e4733d6fd055",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "„Flutwarnungen kommen mit der Wettervorhersage, also nicht viel früher als wenige Tage.“"
                                            },
                                            {
                                                "example_id": "54fc3eba-3f59-4e9d-befb-43eff95884d4",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "„Wie immer hatte ich mich genau an die Einladung gehalten, nicht wie Katinka, die sich nach Lust und Laune anzog, die nicht einmal die Wettervorhersage checkte, ehe sie sich für ein Outfit entschied.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "714398aa-5b9e-4e78-b8a3-cf798c58ef67",
                        "source_entry_id": "68115489-8fad-3cda-9cb0-4e341acda03d",
                        "source_sense_id": "637d0c62-7db5-3daf-a0f4-a74f927b1d06",
                        "source_sense_description": "bericht of mededeling over de toestand van het weer",
                        "target_lang_word": "weather forecast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weather forecast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa6abd3-bbab-30f5-9304-5e9e2e63bc10",
                                        "entry_id": "078fae9b-dc3c-3a35-bef3-f9a3c65a17fa",
                                        "glosses": [
                                            "A prediction of future weather, often for a specific locality, in a newspaper or on the radio or television."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc848cd-8d49-4bd5-a708-2d75f69a95ac",
                                                "sense_id": "6aa6abd3-bbab-30f5-9304-5e9e2e63bc10",
                                                "text": "Near-synonym: weather report"
                                            },
                                            {
                                                "example_id": "6bcae90d-0bf8-4dbb-bff0-d521f1a01229",
                                                "sense_id": "6aa6abd3-bbab-30f5-9304-5e9e2e63bc10",
                                                "text": "It may be sunny today, but the weather forecast is predicting rain for tomorrow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42a07acb-a6fc-4d79-b49e-9c17b1db7fd2",
                        "source_entry_id": "68115489-8fad-3cda-9cb0-4e341acda03d",
                        "source_sense_id": "637d0c62-7db5-3daf-a0f4-a74f927b1d06",
                        "source_sense_description": "bericht of mededeling over de toestand van het weer",
                        "target_lang_word": "prévision météorologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "624b5152-cf54-4021-b8df-3337e1d4573f",
                        "source_entry_id": "68115489-8fad-3cda-9cb0-4e341acda03d",
                        "source_sense_id": "637d0c62-7db5-3daf-a0f4-a74f927b1d06",
                        "source_sense_description": "bericht of mededeling over de toestand van het weer",
                        "target_lang_word": "météo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "météo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f87653dc-c2f0-3b8d-8900-1eead5b516a5",
                                        "entry_id": "36b5b92a-3bbe-3939-96b0-2d8b3c8ce25d",
                                        "glosses": [
                                            "Temps (conditions météorologiques)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba2aefff-9da8-4149-a363-e038ec1209ff",
                                                "sense_id": "f87653dc-c2f0-3b8d-8900-1eead5b516a5",
                                                "text": "Pâques tombe assez tard cette année et la météo est favorable au bon déroulement des festivités traditionnelles de notre ville."
                                            },
                                            {
                                                "example_id": "cb57db74-553b-4449-8d5f-d35e2224b47e",
                                                "sense_id": "f87653dc-c2f0-3b8d-8900-1eead5b516a5",
                                                "text": "Le convoi approche maintenant d’Aix-en-Provence. La nuit est sombre et un froid mistral ratisse violemment la contrée, par rafales convulsives. Une météo sévère très dissuasive pour un émeutier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade2089d-bc4c-3034-ab40-e656e29dea5e",
                                        "entry_id": "36b5b92a-3bbe-3939-96b0-2d8b3c8ce25d",
                                        "glosses": [
                                            "Bulletin des prévisions météorologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf3e632-664f-4b5b-9f04-6dc22f1586d5",
                                                "sense_id": "ade2089d-bc4c-3034-ab40-e656e29dea5e",
                                                "text": "Tu as écouté la météo ?"
                                            },
                                            {
                                                "example_id": "bda153b2-f94d-449a-9e2c-3c3b06481056",
                                                "sense_id": "ade2089d-bc4c-3034-ab40-e656e29dea5e",
                                                "text": "La grande majorité des gens consultent quotidiennement la météo pour connaître le temps qu’il fera."
                                            },
                                            {
                                                "example_id": "16bc806e-d0df-4929-a693-ade30e1e69ef",
                                                "sense_id": "ade2089d-bc4c-3034-ab40-e656e29dea5e",
                                                "text": "La météo n’est plus le baromètre de l’âme mais le thermomètre de la déraison humaine, elle est devenue une science de l'alerte et même de l'm’alarme. Pas de répit ni de repos : radieux ou pluvieux, le temps souligne la menace qui point, par un processus inexorable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79c8424-4865-3eb1-aa03-15ce6548acd5",
                                        "entry_id": "36b5b92a-3bbe-3939-96b0-2d8b3c8ce25d",
                                        "glosses": [
                                            "Organisme qui est chargé des études météorologiques."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1876c25-6e4e-4677-8baf-75210fdfb524",
                                                "sense_id": "c79c8424-4865-3eb1-aa03-15ce6548acd5",
                                                "text": "Ma fille travaille à la météo."
                                            },
                                            {
                                                "example_id": "0f63e8dc-81d8-44b5-871f-ef3108333f3b",
                                                "sense_id": "c79c8424-4865-3eb1-aa03-15ce6548acd5",
                                                "text": "– Mais la pluie c’est que pour vendredi. Et puis, la météo, c’est que des trompettes. Ils prédisent le temps en se mettant un doigt dans le cul. Moi je vous dis que, si ça se trouve, il fera même pas une goutte, vendredi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad75018-bfaa-340f-b7b3-f3f95963f684",
                                        "entry_id": "36b5b92a-3bbe-3939-96b0-2d8b3c8ce25d",
                                        "glosses": [
                                            "Météorologie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
