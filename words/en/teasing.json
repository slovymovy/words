                            {
                                "target_lang_word": "кокетливый",
                                "target_lang_sense_clarification": "игривый, направленный на привлечение внимания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d64ef308-aab7-3902-bc11-91c90424db80",
                    "sense_definition": "The act of harassing someone playfully or maliciously, especially by ridicule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "teasing_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant <w>teasing</w> can be seen as a kind of workplace abuse.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>дразнение</w> можно рассматривать как форму притеснения на рабочем месте."
                            }
