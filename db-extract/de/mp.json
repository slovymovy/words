        "de-extract.jsonl": [
            {
                "entry_id": "34a0f15a-520a-3405-9761-e9469f66573a",
                "word": "MP",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76bca3c8-4b08-36e1-8a24-d60b210e89ea",
                        "entry_id": "34a0f15a-520a-3405-9761-e9469f66573a",
                        "glosses": [
                            "Maschinenpistole"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502693ea-8892-4efe-a7f7-819be1e9c063",
                                "sense_id": "76bca3c8-4b08-36e1-8a24-d60b210e89ea",
                                "text": "Für den Militäreinsatz hatte er seine MP dabei."
                            },
                            {
                                "example_id": "ac705e53-ecbd-4ab8-88b0-21649a1d0974",
                                "sense_id": "76bca3c8-4b08-36e1-8a24-d60b210e89ea",
                                "text": "„Diese Hanswurste, die mit ihren MPs über den Bildschirm zappelten, waren für Tschetschenen doch etwas zu dunkel.“"
                            },
                            {
                                "example_id": "96e54efa-72fd-4c01-a39a-eadf932be4d4",
                                "sense_id": "76bca3c8-4b08-36e1-8a24-d60b210e89ea",
                                "text": "„Der Verkäufer brachte ihm die Waffe an die Tür, und Moss bezahlte ihn in bar. Er drehte die MP in der Hand.“"
                            },
                            {
                                "example_id": "a6627c2d-0d21-4fe4-b38b-70d1144eab88",
                                "sense_id": "76bca3c8-4b08-36e1-8a24-d60b210e89ea",
                                "text": "„Meine MP ist noch gespannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e723e200-f334-3af5-a966-a096b9c647f6",
                        "entry_id": "34a0f15a-520a-3405-9761-e9469f66573a",
                        "glosses": [
                            "Militärpolizei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48154c5-af6d-421b-a462-48c303c845c3",
                                "sense_id": "e723e200-f334-3af5-a966-a096b9c647f6",
                                "text": "Die MP versuchte den Einbruch am Kasernengelände aufzuklären."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd4d586c-4c2b-4433-b9bb-9ecc6aa4106c",
                        "source_entry_id": "34a0f15a-520a-3405-9761-e9469f66573a",
                        "source_sense_id": "76bca3c8-4b08-36e1-8a24-d60b210e89ea",
