                                "sense_id": "80266832-d807-312d-ae1c-996de6c0e12f",
                                "text": "knit in nice intertexture"
                            },
                            {
                                "example_id": "9619526f-f4ee-450f-89cd-4745cd9210ea",
                                "sense_id": "80266832-d807-312d-ae1c-996de6c0e12f",
                                "text": "skirted thick with intertexture firm / Of thorny boughs"
                            },
                            {
                                "example_id": "58975a2c-3b09-4eec-9926-696abdd52d74",
                                "sense_id": "80266832-d807-312d-ae1c-996de6c0e12f",
                                "text": "Now the co-presence of something regular, something to which the mind has been accustomed when in an unexcited or a less excited state, cannot but have great efficacy in tempering and restraining the passion by an intertexture of ordinary feeling"
                            },
                            {
                                "example_id": "8c146aaa-dfc5-4243-8e63-51bc91e96651",
                                "sense_id": "80266832-d807-312d-ae1c-996de6c0e12f",
                                "text": "At length, after walking a long way in the woods, we arrived at another thicket, through the intertexture of which was glimmering a pale rosy light."
                            }
                        ]
