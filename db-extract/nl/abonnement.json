                    {
                        "sense_id": "dfc5e82a-6fdb-37fa-976c-30f8f2296c70",
                        "entry_id": "3a60f539-8eb1-3ddc-90c4-58ef0cb35cfb",
                        "glosses": [
                            "overeenkomst waarbij een persoon op geregelde tijden (bijvoorbeeld wekelijks of maandelijks) een tijdschrift of dergelijke ontvangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b66f7cd5-d38c-47ae-aa71-47a52a46fd25",
                                "sense_id": "dfc5e82a-6fdb-37fa-976c-30f8f2296c70",
                                "text": "Wij hebben een abonnement op de krant."
                            },
                            {
                                "example_id": "b3b11c96-b2bf-44f2-8041-271f8d61e353",
                                "sense_id": "dfc5e82a-6fdb-37fa-976c-30f8f2296c70",
                                "text": "Mijn vrouw had vroeger een abonnement op de Vrekkenkrant, een tijdschrift dat een eenvoudige en zuinige levenswijze wilde promoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "edc1e311-2983-3c01-8209-b1388b40ebb2",
                        "entry_id": "3a60f539-8eb1-3ddc-90c4-58ef0cb35cfb",
                        "glosses": [
                            "regeling, waarbij een eenmalige of periodieke betaling wordt gedaan, welke recht geeft op een gedurende een bepaalde periode onbeperkte gebruikmaking van een bepaalde service"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e25fc251-510c-4ce7-9ce6-0cf0d6507e66",
                                "sense_id": "edc1e311-2983-3c01-8209-b1388b40ebb2",
                                "text": "Hij heeft een abonnement op het zwembad."
                            },
                            {
                                "example_id": "e6737e63-933f-4de6-8732-5a24c42d5a18",
                                "sense_id": "edc1e311-2983-3c01-8209-b1388b40ebb2",
                                "text": "Deze hel houdt hij, ondanks alles, vol door een oude gewoonte op te pakken: hij neemt weer een abonnement bij de openbare bibliotheek en leent een bonte verzameling historische romans die hij binnen een paar dagen verslindt alsof zijn leven ervan afhangt - tot op zekere hoogte is dat ook wel waar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "245617a0-73d8-43ce-93bb-8de2a25f3f44",
                        "source_entry_id": "3a60f539-8eb1-3ddc-90c4-58ef0cb35cfb",
                        "target_lang_word": "Abonnement",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abonnement",
