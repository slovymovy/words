                        "examples": [
                            {
                                "example_id": "319d4a2d-53ca-4d41-b8ba-a77dcba00690",
                                "sense_id": "898142f5-b7d6-39f7-87e3-21ad0cbb243a",
                                "text": "In de vestibule was niemand, overal lagen lege flessen, jassen en overschoenen; er hing een dranklucht en hij hoorde in de verte gepraat en geschreeuw."
                            },
                            {
                                "example_id": "9185ba80-d967-4eca-93e5-6a6429b01fb4",
                                "sense_id": "898142f5-b7d6-39f7-87e3-21ad0cbb243a",
                                "text": "De man was voor de auto gaan staan omdat hij de jongen, die geen rijbewijs heeft, gevaarlijk vond rijden en een dranklucht rook. Hij wilde de bestuurder zo verhinderen verder te rijden."
                            }
                        ]
                    }
