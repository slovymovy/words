                    {
                        "sense_id": "05a498ca-7402-359b-a86c-d7ef6b11a0f8",
                        "entry_id": "fea8099d-6900-30b4-9ea7-d4dfdff25f17",
                        "glosses": [
                            "verandering van (rij)richting om een botsing te voorkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34f24707-bdc1-499d-b5e1-0a864f36bf9a",
                                "sense_id": "05a498ca-7402-359b-a86c-d7ef6b11a0f8",
                                "text": "De helikopterpiloot die in november vorig jaar met zijn Apache tegen een zogeheten bliksemdraad vloog bij het Gelderse Zoelmond, zag deze over het hoofd tijdens een uitwijkmanoeuvre."
                            },
                            {
                                "example_id": "fe13bffc-2319-46be-91d7-3e24fbe9bacb",
                                "sense_id": "05a498ca-7402-359b-a86c-d7ef6b11a0f8",
                                "text": "Het Openbaar Ministerie eist voor het veroorzaken van een bizar en fataal verkeersongeluk een boete van zevenhonderd euro tegen een automobilist zonder rijbewijs. De man reed in Amsterdam een paal omver bij een onnodige uitwijkmanoeuvre. Een voetganger kreeg een aan de paal geplaatst verkeersbord op zijn hoofd en overleed aan ernstig hoofdletsel."
                            },
                            {
                                "example_id": "6ed21d32-5e07-4bd2-a364-e593c45deca0",
                                "sense_id": "05a498ca-7402-359b-a86c-d7ef6b11a0f8",
                                "text": "Vier auto's hadden vrijdagavond flinke schade opgelopen bij een aanrijding op de Deurningerstraat in Enschede. Dit alles was het gevolg van een uitwijkmanoeuvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "973c4724-7bbd-3276-a174-46a1a777cb87",
                        "entry_id": "fea8099d-6900-30b4-9ea7-d4dfdff25f17",
                        "glosses": [
                            "handeling bedoeld om een conflict of probleem te omzeilen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "86502269-f802-4834-9b6c-4dbe4b3e4985",
                                "sense_id": "973c4724-7bbd-3276-a174-46a1a777cb87",
                                "text": "De weerlegging van dit gevaarlijke argument, dat ook Turing al zorgen had gebaard, kost Hofstadter veel hoofdbrekens. Ondertussen maakt hij een uitwijkmanoeuvre naar de vreemde streken die de genetische code met het DNA uithaalt, zodat genotypische gegevens in de wonderlijkste fenotypen kunnen verkeren."
                            }
                        ]
                    }
