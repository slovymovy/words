                    },
                    {
                        "sense_id": "52ea0100-f71a-3f63-b170-1c4fc3b5370e",
                        "entry_id": "3f370785-e876-3551-bea9-aa757a38e301",
                        "glosses": [
                            "niezgodny z poczuciem honoru"
                        ],
                        "tags": [],
