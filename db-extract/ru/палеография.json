                                        "sense_id": "9cdb481e-431a-3a09-ac71-014fdcbda113",
                                        "entry_id": "fa863e3c-f113-3d41-8fe8-41834bb8cb80",
                                        "glosses": [
                                            "Alternative form of paleography."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05fb954c-6c76-4060-a0dd-400eec1771b0",
                                                "sense_id": "9cdb481e-431a-3a09-ac71-014fdcbda113",
                                                "text": "Regarding the ranges of these palaeographic areas, the terms mentioned might again be misleading to a nonadept, who, for example, has to know that the Delta is mostly uncharted territory in regard to Demotic palaeography (due to the lack of sources from this area)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebcaf913-75ba-4faa-b3b6-bda45b1c42a0",
