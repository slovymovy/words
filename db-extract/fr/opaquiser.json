                "senses": [
                    {
                        "sense_id": "c9d58448-c5ac-3739-b096-d63ac45eba2c",
                        "entry_id": "fdc83bf5-fb62-30eb-a297-366aef2c12f1",
                        "glosses": [
                            "Rendre opaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e598a67-5a8f-4d70-b2b1-533205334c19",
                                "sense_id": "c9d58448-c5ac-3739-b096-d63ac45eba2c",
                                "text": "Ah oui, bonne astuce également, j'ai pris aussi une sorte de nuisette noire à mettre dessous la tunique, pour \"l'opaquiser\" (astuce piquée ici)."
                            },
                            {
                                "example_id": "db13ee91-6f2a-40db-994e-2caec34e2470",
                                "sense_id": "c9d58448-c5ac-3739-b096-d63ac45eba2c",
                                "text": "Donc est-ce possible d'opaquiser une fenêtre lorsqu'on déclenche un popup?"
                            },
                            {
                                "example_id": "44112546-8b95-4475-a6ac-cc56c8a7e7bb",
                                "sense_id": "c9d58448-c5ac-3739-b096-d63ac45eba2c",
                                "text": "Si on a poudré le visage avant, se brosser les sourcils pour enlever la poudre, sans quoi elle se déposera sur la brosse du produit et ira opaquiser le produit."
                            }
                        ]
                    }
