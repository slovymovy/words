{
    "word_family": [
        "Indonesia"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "464ec6f8-4399-3dd0-a4f3-b843c170857b",
                    "sense_definition": "Relating to the country of Indonesia, its people, or its culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indonesia_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a delicious dinner at a local <w>Indonesian</w> restaurant last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы насладились вкусным ужином в местном <w>индонезийском</w> ресторане.",
                                "zh": "昨晚我们在一家当地的<w>印尼</w>餐厅享用了美味的晚餐。"
                            }
                        },
                        {
                            "text": "The <w>Indonesian</w> archipelago consists of thousands of beautiful tropical islands.",
                            "target_lang_translations": {
                                "ru": "<w>Индонезийский</w> архипелаг состоит из тысяч прекрасных тропических островов.",
                                "zh": "<w>印度尼西亚</w>群岛由数千个美丽的热带岛屿组成。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Индонезии, её народу или культуре.",
                        "zh": "与印度尼西亚这个国家、其人民或其文化相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индонезийский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印度尼西亚的",
                                "target_lang_sense_clarification": "形容词，指代国家或文化"
                            },
                            {
                                "target_lang_word": "印尼的",
                                "target_lang_sense_clarification": "形容词，常用简称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26a498f0-a432-3581-bfb1-fdc988dda771",
                    "sense_definition": "The official language of Indonesia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She is learning to speak <w>Indonesian</w> before her trip to Bali.",
                            "target_lang_translations": {
                                "ru": "Она учится говорить по-<w>индонезийски</w> перед своей поездкой на Бали.",
                                "zh": "她在去巴厘岛旅行前正在学习说<w>印尼语</w>。"
                            }
                        },
                        {
                            "text": "Many people find that <w>Indonesian</w> is a relatively easy language to start learning.",
                            "target_lang_translations": {
                                "ru": "Многие считают, что <w>индонезийский</w> — это относительно простой язык для начала изучения.",
                                "zh": "许多人发现<w>印度尼西亚语</w>是一门相对容易入门的语言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Bahasa Indonesia"
                    ],
                    "common_phrases": [
                        "speak indonesian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный язык Индонезии.",
                        "zh": "印度尼西亚的官方语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индонезийский",
                                "target_lang_sense_clarification": "язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印度尼西亚语",
                                "target_lang_sense_clarification": "语言名称"
                            },
                            {
                                "target_lang_word": "印尼语",
                                "target_lang_sense_clarification": "语言名称的常用简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15aba581-ed1d-35a2-ae99-f9b79ded1e78",
                    "sense_definition": "A person from Indonesia or of Indonesian descent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Indonesians</w> living in this neighborhood organized a wonderful cultural festival.",
                            "target_lang_translations": {
                                "ru": "<w>Индонезийцы</w>, живущие в этом районе, организовали замечательный культурный фестиваль.",
                                "zh": "住在这个社区的<w>印尼人</w>组织了一场精彩的文化节。"
                            }
                        },
                        {
                            "text": "As an <w>Indonesian</w> living abroad, he misses the spicy food from his hometown.",
                            "target_lang_translations": {
                                "ru": "Как <w>индонезиец</w>, живущий за границей, он скучает по острой еде из своего родного города.",
                                "zh": "作为一名旅居海外的<w>印尼人</w>，他很怀念家乡的辛辣食物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "native indonesian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек из Индонезии или индонезийского происхождения.",
                        "zh": "来自印度尼西亚的人或具有印度尼西亚血统的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индонезиец",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "индонезийка",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印度尼西亚人",
                                "target_lang_sense_clarification": "指代该国国民或族群"
                            },
                            {
                                "target_lang_word": "印尼人",
                                "target_lang_sense_clarification": "指代该国国民或族群的常用简称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}