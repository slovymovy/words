                        ],
                        "form": "dem Seelenfrieden"
                    },
                    {
                        "form_id": "cc403ce6-121f-4d39-9fef-b1fb2d9782af",
                        "entry_id": "3a40d493-09f2-3a0a-9113-7b5bd1386eea",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Seelenfrieden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33671c8f-57f9-333b-a19e-8df61910a1c3",
                        "entry_id": "3a40d493-09f2-3a0a-9113-7b5bd1386eea",
                        "glosses": [
                            "innere Ruhe, innere Ausgeglichenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8719f81f-ecc8-4b27-bcb0-1e7dbc7e5e32",
                                "sense_id": "33671c8f-57f9-333b-a19e-8df61910a1c3",
                                "text": "„Valenti hatte seinen Seelenfrieden wiedergefunden.“"
                            },
                            {
                                "example_id": "d03ba0fd-addf-42ee-b129-ce99850a23e1",
                                "sense_id": "33671c8f-57f9-333b-a19e-8df61910a1c3",
                                "text": "„Wir sehen den autoritären Menschen, der durch seine Lehre seinen Gläubigen die Widersprüche aufhebt, damit ihre Zweifel beendet und ihnen (zumindest für einige Zeit) einen gewissen Seelenfrieden schenkt.“"
                            },
                            {
                                "example_id": "ccb23686-ad2c-4f87-ace6-2ce399e24110",
                                "sense_id": "33671c8f-57f9-333b-a19e-8df61910a1c3",
                                "text": "„Ich versuche meinen Seelenfrieden zu finden, indem ich das aufschreibe, was bis heute öffentlich nicht gesagt werden durfte oder nur hinter vorgehaltener Hand kolportiert wurde.“"
                            },
                            {
                                "example_id": "ab41a58d-fdfa-484c-9105-8de389905e13",
                                "sense_id": "33671c8f-57f9-333b-a19e-8df61910a1c3",
                                "text": "„Beim ersten Strahl der Morgenröte kreischten der mächtige Schlüssel und der Riegel, und Signora Orio öffnete die Tür, um sich ihren nötigen Seelenfrieden für den Tag zu holen.“"
                            },
                            {
                                "example_id": "6f4578c6-ab33-4486-8fe6-f7d3ff53e1a8",
                                "sense_id": "33671c8f-57f9-333b-a19e-8df61910a1c3",
                                "text": "„Es gab nichts, was einem so viel Seelenfrieden verschafft, wie morgens aufzuwachen und nicht entscheiden zu müssen, wer man ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c78feb28-b39d-458c-aeda-2a6fb15d70b0",
                        "source_entry_id": "3a40d493-09f2-3a0a-9113-7b5bd1386eea",
                        "source_sense_id": "33671c8f-57f9-333b-a19e-8df61910a1c3",
                        "source_sense_description": "innere Ruhe, innere Ausgeglichenheit",
                        "target_lang_word": "peace of mind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peace of mind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                        "entry_id": "bcd204c1-8ff5-3fe2-8417-c1c003dab37f",
                                        "glosses": [
                                            "The absence of mental turmoil or anxiety."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b89b58-311e-4858-9eb8-6dc54b8d2be2",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "These people are under continual disquietudes, never enjoying a minute's peace of mind."
                                            },
                                            {
                                                "example_id": "630ca214-6b05-4a9e-be39-5fe40080fcb5",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "Who can describe the pleasure and delight, the peace of mind and soft tranquillity, the sickly boy felt in the balmy air, and among the green hills and rich woods, of an inland village!"
                                            },
                                            {
                                                "example_id": "5e14d2e6-a461-43c0-b45e-9841eaf7b47f",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "Genevieve was tall and blonde, a destroyer of masculine peace of mind."
                                            },
                                            {
                                                "example_id": "58a99652-6e29-40ec-a31b-b0d5704460cc",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "In between, what I find is pleasing and I'm feeling fine / Love is so confusing, there's no peace of mind"
                                            },
                                            {
                                                "example_id": "9857c14b-7ca4-418d-90a8-40215d7e66e8",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "Peace of mind is good for health, good for community, good for family, and also for physical growth."
                                            },
                                            {
                                                "example_id": "ad8e6847-7615-4908-80ca-1f072748d673",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "The basic toilet has quite a heavy door, which then bleeps to remind you to lock it - with a nice, peace of mind, manual lock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
