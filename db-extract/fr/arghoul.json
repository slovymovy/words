                "senses": [
                    {
                        "sense_id": "e370b8dc-717c-3749-973e-d38e970a75ef",
                        "entry_id": "340c0f7e-1078-34f1-88d4-6e5bfa14d7ee",
                        "glosses": [
                            "Instrument de musique égyptien à vent et à anche simple, chalumeau ressemblant à une clarinette à double corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbeaaf41-27e9-4403-a251-3cb80a7dbae2",
                                "sense_id": "e370b8dc-717c-3749-973e-d38e970a75ef",
                                "text": "L’arghoul el-soghayr, qui est l’arghoul moyen, n’est composé que de huit pièces ; conséquemment, il n’a que deux rallonges."
                            },
                            {
                                "example_id": "8456d97b-efe1-49c2-a836-3eb8955c1e30",
                                "sense_id": "e370b8dc-717c-3749-973e-d38e970a75ef",
                                "text": "On distingue trois variétés de l’arghoul, lesquelles diffèrent par la taille et par le nombre d’allonges faites au bourdon."
                            },
                            {
                                "example_id": "80a284f5-66b0-49e6-824a-202a4a21dac0",
                                "sense_id": "e370b8dc-717c-3749-973e-d38e970a75ef",
                                "text": "L’arghoul est le nom de l’instrument ressemblant à une clarinette double avec des flûtes de longueurs différentes, parallèles et attachées ensemble."
                            }
                        ]
                    }
                ],
