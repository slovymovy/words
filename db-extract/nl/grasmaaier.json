                "senses": [
                    {
                        "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                        "entry_id": "c5017415-3241-3ad8-8e37-d17c278b4f89",
                        "glosses": [
                            "een machine om het gras te maaien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45fc148d-0af2-48ce-a40a-a710ebb3d9a7",
                                "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                                "text": "De grasmaaier werd niet vaak gebruikt door dat gezin."
                            },
                            {
                                "example_id": "6dfc1ec9-4e5d-47a1-a7b5-c38d9eba4805",
                                "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                                "text": "Het is één grote chaos op Sint-Maarten. De verwoestingen zijn enorm. Alsof iemand met een grasmaaier vanuit de hemel over het eiland is gegaan, typeerde een ooggetuige de verwoestingen door orkaan Irma."
                            },
                            {
                                "example_id": "1583e353-1b6f-4c15-99f0-5979e6bd9438",
                                "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                                "text": "Een bezoekje aan het eerste voetbalstadion van Qatar voelt, gevoelsmatig ver weg van de commercie, fijn aan. Terwijl een man met een grote grasmaaier over de middenstip sjeest, is bij de goal een gastarbeider bezig met een kruiwagen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d472f544-ba20-3f51-98fc-ce07c6c9f119",
                        "entry_id": "c5017415-3241-3ad8-8e37-d17c278b4f89",
                        "glosses": [
                            "iemand die het gras maait"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "ad8160d3-5262-4ce5-a8ff-1cfb1289a4dd",
                                "sense_id": "d472f544-ba20-3f51-98fc-ce07c6c9f119",
                                "text": "Hoewel mijn vrouw het meeste werk verricht in de tuin, ben ik de grasmaaier van de familie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c7be08e-d805-445b-86d2-b157943d39c5",
                        "source_entry_id": "c5017415-3241-3ad8-8e37-d17c278b4f89",
                        "target_lang_word": "Rasenmäher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rasenmäher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                        "entry_id": "62bffe78-3c24-3570-b131-061384bcf54e",
                                        "glosses": [
                                            "(meist motorgetriebenes) Gerät, das mit rotierenden Messern den Rasen kürzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5352799e-6aff-4d5e-97e4-065e38f574cb",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "Neben den Rasenmähern mit Motor gibt es auch solche mit einer rotierenden Messerwalze, die mechanisch in Rotation versetzt wird. Diese heißen Spindelmäher."
                                            },
                                            {
                                                "example_id": "625b5443-c190-4e8c-9e43-61d17454afee",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "„Warum sie sich keinen Rasenmäher, dafür aber eine Scheibtruhe leisten konnte, erfuhr Wojciech Czaja.“"
                                            },
                                            {
                                                "example_id": "258b9b52-e291-4ec4-93c7-de1780578c05",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "„Du bist stolz auf deinen eigenen Rasenmäher.“"
                                            },
                                            {
                                                "example_id": "e832c1df-f78d-4865-9da1-bf2c5cf892e5",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "„Wegen seiner maßlosen Langeweile mähte Bundschuh jedes Wochenende mit dem gemeindeeigenen Rasenmäher die Schulwiese vor dem Haus, die als Wäschetrockenplatz benutzt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b994603-ec67-4723-9128-ecba70d03947",
                        "source_entry_id": "c5017415-3241-3ad8-8e37-d17c278b4f89",
                        "target_lang_word": "lawn mower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
