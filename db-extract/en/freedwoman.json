                        "entry_id": "f3561ef2-c540-3a65-ae9d-f74b1a03d548",
                        "glosses": [
                            "A woman who has been released from a condition of slavery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e207cd-61a9-4cad-a4af-d66f7ca2c24b",
                                "sense_id": "57a59367-0f3b-35ab-bbd1-92acb0cbd349",
                                "text": "Education was a high priority for Appalachian freedmen and freedwomen just as it was for blacks throughout the Reconstruction South."
                            }
                        ]
                    }
                ],
