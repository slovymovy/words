                "senses": [
                    {
                        "sense_id": "e4051c4c-5071-3199-a164-dec44f00dba9",
                        "entry_id": "9376e419-f61f-397f-85f8-867df2b3805a",
                        "glosses": [
                            "bon vivant"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "0c7ee71d-6a9f-47a8-beae-8bca22d806ae",
                                "sense_id": "e4051c4c-5071-3199-a164-dec44f00dba9",
                                "text": "[…]sein Schwiegersohn, ein eleganter Lebemann, der sich von Christian in der Stadt umher und in den Klub führen ließ, und Gerda verteilten sich in den überflüssigen Räumen zu ebener Erde, bei der Säulenhalle, im ersten Stock …"
                            },
                            {
                                "example_id": "79f23c7f-6c3c-4dfb-9980-1fe475f5288d",
                                "sense_id": "e4051c4c-5071-3199-a164-dec44f00dba9",
                                "text": "Wie, Herr Dramatiker, und du, Publikum, welches das Leben kennt, wie, wenn er verschollen wäre, dieser beliebte Lebemann oder dieser anmaßende junge Mensch, der in allen Ehen schließt wie ein Nachschlüssel?",
                                "translation": "The Notebooks of Malte Laurids Brigge",
                                "english": "The Notebooks of Malte Laurids Brigge"
                            },
                            {
                                "example_id": "ae04f145-f1ba-4810-82ea-a5241dfffe91",
                                "sense_id": "e4051c4c-5071-3199-a164-dec44f00dba9",
                                "text": "Es sind ja auch immer solche Leute wie der heilige Augustin, die zu Sehern werden. Der war vorher auch ein Genießer und Lebemann."
                            }
                        ]
                    },
                    {
                        "sense_id": "b995d3e5-54d2-37b7-a3d8-0d48d1290eaf",
