                                        "sense_id": "f145fff2-9b05-338f-80bd-e769259fceb9",
                                        "entry_id": "be490f6d-3672-3b59-94d8-fa761793d53b",
                                        "glosses": [
                                            "drift, boosheid, woedeaanval, zonder geduld"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10ce75e2-62a8-3125-a888-8f9f0082acac",
                                        "entry_id": "be490f6d-3672-3b59-94d8-fa761793d53b",
                                        "glosses": [
                                            "de emotie die men ondervindt als men ongewild ergens op moet wachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1009572f-191e-4261-b213-22531f8515d0",
                                                "sense_id": "10ce75e2-62a8-3125-a888-8f9f0082acac",
                                                "text": "Veel mensen wachtten vol ongeduld op hun postdozen die door de bosbranden veel vertraging hadden opgelopen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5c59dc0-ae2c-4dfd-8628-a2df9b6c281b",
                        "source_entry_id": "ddc92c05-f0ad-3e7c-8c54-13fd2a7b61bb",
                        "source_sense_id": "30bc94f2-4db0-3265-b148-f94fe669ff20",
                        "target_lang_word": "Ungeduld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungeduld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                        "entry_id": "05c04a11-073a-3d5c-8d72-5e41dd8b8035",
                                        "glosses": [
                                            "Mangel an Ausdauer, auf etwas zu warten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab7880c-9b39-47ea-b0c4-c02d097158a9",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "Sie wartete mit großer Ungeduld, bis sie endlich an der Reihe war."
                                            },
                                            {
                                                "example_id": "bc5294fc-de1a-47fe-8796-ea3741adc69f",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Hagen versuchte seine Ungeduld zu verbergen.“"
                                            },
                                            {
                                                "example_id": "271392c5-791c-4e17-905d-8a7b834d00bd",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Er wandte sich ab und wartete mit Ungeduld auf die Rückkehr des Fürsten Andrej.“"
                                            },
                                            {
                                                "example_id": "d9c221cc-b896-4eb4-85f4-85e410d2ddcf",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Die Liebe wird nur in der Ungedult des Verlangens unvorsichtig; aber wenn es darum geht, die Wiederkehr eines Glücks zu betreiben, dem widrige Umstände Hindernisse in den Weg legen, wird die Liebe alles mit größtem Scharfsinn sehen und voraussehen.“"
                                            },
                                            {
                                                "example_id": "4d8f9d81-1e0f-4db9-aab2-fbd9c3fe7fc2",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Der Pflanzer hatte beide mit Ungeduld angehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
