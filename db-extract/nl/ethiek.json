                                        "entry_id": "fbd74117-6010-3f08-b575-cb31baa06851",
                                        "glosses": [
                                            "eine Teilrichtung der Philosophie und Studienfach, die sich mit dem (richtigen) menschlichen Handeln befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c6dee8-9201-4585-bbc8-57e0a7968089",
                                                "sense_id": "ca8465cb-bcd0-3e34-90a0-de55b8950b27",
                                                "text": "Immanuel Kant befasste sich mit der Ethik."
                                            },
                                            {
                                                "example_id": "783a9031-117f-4d29-9239-1de0dd49d950",
                                                "sense_id": "ca8465cb-bcd0-3e34-90a0-de55b8950b27",
                                                "text": "„Ein Blick in die Geschichte der Ethik zeigt uns, daß sittliche Freiheit nicht Unbestimmtheit, sondern deren Gegensatz, nämlich Bestimmtheit bedeutet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86398878-fa00-364c-8b4b-092c3beb6ffa",
                                        "entry_id": "fbd74117-6010-3f08-b575-cb31baa06851",
                                        "glosses": [
                                            "ein Schulfach in einem Teil der deutschen Bundesländer, welches sich mit ^([1]) befasst"
                                        ],
                                        "tags": [
