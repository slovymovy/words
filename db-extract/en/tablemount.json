                        "glosses": [
                            "A seamount with a flat top; synonym of guyot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4b8451-9deb-4704-b92c-7c602742f70a",
                                "sense_id": "cdcba988-ef30-366b-9fe6-557b94370df8",
                                "text": "The theory that the tablemounts were decapitated by great oscillations of sea level, owing to water becoming locked up in ice caps or to some other cause, seems to be definitely ruled out, since the peaks are not concordant."
                            },
                            {
                                "example_id": "821ac3cb-4140-4173-9add-8a89bb515be4",
                                "sense_id": "cdcba988-ef30-366b-9fe6-557b94370df8",
                                "text": "This study recommended establishment as preserves an abyssal trench, an underseas tablemount, and an atoll."
                            },
                            {
                                "example_id": "cf26e05f-3f02-4bbf-a592-d2f018def34e",
                                "sense_id": "cdcba988-ef30-366b-9fe6-557b94370df8",
                                "text": "Frequently, tops of tablemounts contain evidence of shallow-water conditions (such as ancient coaral reeef deposits) that were carried with it into deeper water."
                            }
                        ]
                    }
