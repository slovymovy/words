                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd929983-2d14-4223-b955-b5debec4f806",
                                "sense_id": "b2cacf69-bbc9-3b17-82d9-2cf45c970f97",
                                "text": "Ja sama, choć gotką nie jestem i nie będę, lubię się wystroić tylko po to, żeby się powyginać do swojego odbicia w lustrze, a ciuchy często kupuję pod wpływem chwili"
                            },
                            {
                                "example_id": "9fbbfc52-4100-4ecd-8738-1fc373f81eef",
                                "sense_id": "b2cacf69-bbc9-3b17-82d9-2cf45c970f97",
                                "text": "Od zawsze zazdrościłam gotkom ich pięknych czarnych sukni"
                            }
                        ],
