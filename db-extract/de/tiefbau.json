                "senses": [
                    {
                        "sense_id": "0f0d621c-ee25-39d2-9cc2-5cb6a1279072",
                        "entry_id": "2e92d990-1eab-38c8-ae36-46ed76fcab06",
                        "glosses": [
                            "Teilbereich des Bauwesens, der sich mit Bauwerken befasst, die zu ebener Erde und unterhalb der Geländelinie liegen (also überwiegend Bauwerke des Erd-, Verkehrs- und Wasserbaus sowie Gründungen und Versorgungsnetze. Als Teil der Verkehrsinfrastruktur werden ausnahmsweise auch Hochbauten wie Brücken hierzu gezählt.)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "cde5cc0f-f884-4164-a5e5-b3c3833cf66c",
                                "sense_id": "0f0d621c-ee25-39d2-9cc2-5cb6a1279072",
                                "text": "Das Anlegen von Kanalisationen, Straßen oder Tiefgaragen gehört in den Bereich des Tiefbaus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8466cafb-7015-3824-a574-4dbdd8afc5a8",
                        "entry_id": "2e92d990-1eab-38c8-ae36-46ed76fcab06",
                        "glosses": [
                            "Gebäude, das ganz oder größtenteils unter der Geländelinie liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d51b28-6f16-4e37-8bfb-20ff42d96add",
                                "sense_id": "8466cafb-7015-3824-a574-4dbdd8afc5a8",
                                "text": "Der Tiefbau für die neue U-Bahn soll 2014 fertig sein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "26d62d73-837d-3bc1-8aab-50b192afd0bb",
                        "entry_id": "2e92d990-1eab-38c8-ae36-46ed76fcab06",
                        "glosses": [
                            "Bergwerk oder Stelle des Abbaus unterhalb der Erdoberfläche (im Gegensatz zu Tagebauten)"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "c931b5e0-dc68-491b-af17-24abd4a0c1ed",
                                "sense_id": "26d62d73-837d-3bc1-8aab-50b192afd0bb",
                                "text": "In dem heute stillgelegten Bergwerk gab es damals den Tagebau Hermine und den Tiefbau Hedwig."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
