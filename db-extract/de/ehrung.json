                            {
                                "example_id": "45d7d8e5-a018-4cc6-afda-baa0d093167d",
                                "sense_id": "9d4c3657-a781-3fcd-9be9-428bc25bc054",
                                "text": "„Ist der Verstorbene wegen erheblicher Verfehlungen einer Ehrung nicht würdig, so unterbleibt die Ehrung.“"
                            },
                            {
                                "example_id": "bcfba713-30fc-4f0e-ab03-72f334bc8915",
                                "sense_id": "9d4c3657-a781-3fcd-9be9-428bc25bc054",
                                "text": "Die Ehrung der Eltern ist die Pflicht der Kinder, sagte man früher."
                            },
                            {
                                "example_id": "027dfdc2-678d-4225-9a1b-e29f218d1d5a",
                                "sense_id": "9d4c3657-a781-3fcd-9be9-428bc25bc054",
                                "text": "Die Künstlerin war von der öffentlichen Ehrung gerührt."
