                                                "example_id": "6ea41b78-48f0-46ab-a79d-e55e18402a22",
                                                "sense_id": "06720d8f-a831-3251-8108-6ac1d663abd3",
                                                "text": "Supposons que nous étudiions la diffusion d’un méson pseudoscalaire par un baryon."
                                            },
