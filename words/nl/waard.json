        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45efa71f-2c7b-3950-9533-b989e15c47b1",
                    "sense_definition": "Een bepaalde financiële waarde hebbend; in geld uit te drukken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "value_financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat oude horloge is veel geld <w>waard</w>.",
                            "target_lang_translations": {
                                "ru": "Эти старые часы <w>стоят</w> больших денег.",
                                "en": "That old watch is <w>worth</w> a lot of money.",
                                "it": "Quell'orologio antico <w>vale</w> molti soldi."
                            }
                        },
                        {
                            "text": "Ik vraag me af hoeveel dit schilderij tegenwoordig <w>waard</w> is.",
                            "target_lang_translations": {
                                "ru": "Интересно, сколько сейчас <w>стоит</w> эта картина.",
                                "en": "I wonder how much this painting is <w>worth</w> nowadays.",
                                "it": "Mi chiedo quanto <w>valga</w> questo quadro al giorno d'oggi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geld waard zijn",
                        "niets waard",
                        "goud waard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенную финансовую стоимость; оцениваемый в деньгах.",
                        "en": "Having a specific financial value; expressible in money.",
                        "it": "Avente un determinato valore finanziario; esprimibile in denaro."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стоящий",
                                "target_lang_sense_clarification": "имеющий цену"
                            },
                            {
                                "target_lang_word": "ценный",
                                "target_lang_sense_clarification": "дорогостоящий"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "worth",
                                "target_lang_sense_clarification": "financial value"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "valere",
                                "target_lang_sense_clarification": "avere un valore monetario"
                            },
                            {
                                "target_lang_word": "di valore",
                                "target_lang_sense_clarification": "costoso o prezioso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4acc6f-3094-3f7c-acf4-508c595e1083",
                    "sense_definition": "Nuttig, belangrijk of goed genoeg om tijd of moeite aan te besteden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "value_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is zeker de moeite <w>waard</w> om dat museum te bezoeken.",
                            "target_lang_translations": {
                                "ru": "Определенно <w>стоит</w> посетить этот музей.",
                                "en": "It is certainly <w>worth</w> the effort to visit that museum.",
                                "it": "<w>Vale</w> sicuramente la pena visitare quel museo."
                            }
                        },
                        {
                            "text": "Zijn advies bleek uiteindelijk niets <w>waard</w> te zijn.",
                            "target_lang_translations": {
                                "ru": "Его совет в итоге оказался ничего не <w>стоящим</w>.",
                                "en": "His advice turned out to be <w>worth</w> nothing in the end.",
                                "it": "Il suo consiglio si è rivelato non <w>valere</w> nulla alla fine."
                            }
                        }
                    ],
                    "antonyms": [
                        "onwaard"
                    ],
                    "common_phrases": [
                        "de moeite waard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полезный, важный или заслуживающий затрат времени или усилий.",
                        "en": "Useful, important, or deserving of time or effort.",
                        "it": "Utile, importante o abbastanza buono da meritarne il tempo o l'impegno."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стоящий",
