                                        "glosses": [
                                            "the act of eating invasive species as a method of population control"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf5d87ba-533b-426c-8270-fd608bd2eb27",
                                                "sense_id": "75674635-374e-36c4-84a1-6c2b80a306a7",
                                                "text": "They willingly made the leap into invasivorism."
                                            },
                                            {
                                                "example_id": "ff398596-95eb-426e-b9c8-a678d8afba79",
                                                "sense_id": "75674635-374e-36c4-84a1-6c2b80a306a7",
                                                "text": "The current regulation on invasive species fails to address invasivorism as a pest control and food safety concern because, on the one hand, current federal invasive species regulation is fragmented, convoluted, and misguided."
                                            },
                                            {
                                                "example_id": "5c8e7218-4b05-4432-8dd7-3ac8e5774ba8",
                                                "sense_id": "75674635-374e-36c4-84a1-6c2b80a306a7",
                                                "text": "He has been considering the benefits of invasivorism since the early twenty-first century."
                                            }
                                        ]
