                        "glosses": [
                            "Animal imaginaire de la province de Medelpad, en Suède, assemblage d’un lièvre et d’un grand tétras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc82c72-d49e-4560-a20b-104b9c9b742d",
                                "sense_id": "7fbae2f1-f679-38b7-9624-2334317d7142",
                                "text": "Le skvader est mentionné pour la première fois en 1874, par un chasseur nommé Håkan Dahlmark qui raconta au cours d’un dîner entre amis, avoir tué un tel animal."
                            },
                            {
                                "example_id": "5404ebd9-b981-4bb4-971b-d7d944d4bd52",
                                "sense_id": "7fbae2f1-f679-38b7-9624-2334317d7142",
                                "text": "Une espèce apparentée au jackalope, « skvader », vivait à la même époque en Suède."
                            },
                            {
                                "example_id": "1e8374f6-a0af-426b-989b-46b3d0e08565",
                                "sense_id": "7fbae2f1-f679-38b7-9624-2334317d7142",
                                "text": "Un référendum amusant a fait connaître le Skvader, animal fictif de Medelpad."
                            }
                        ]
