                ],
                "senses": [
                    {
                        "sense_id": "3fdc5e4a-ac8b-36d8-abc2-45bd5eaabd16",
                        "entry_id": "d1643dde-9171-32bb-94ab-e5f1a029f9e1",
                        "glosses": [
                            "durch das FSME-Virus ausgelöste, vor allem im (Früh-)Sommer auftretende grippeähnliche Erkrankung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0424cf-5a76-4328-8a81-0bbafdf75753",
                                "sense_id": "3fdc5e4a-ac8b-36d8-abc2-45bd5eaabd16",
                                "text": "„Zu den beiden am häufigsten durch Zecken übertragenen Krankheiten zählt neben der Lyme-Borreliose die Frühsommer-Meningoenzephalitis (FSME).“"
                            },
                            {
                                "example_id": "eb881c3c-a46a-4e00-ae3a-3d412804d94f",
                                "sense_id": "3fdc5e4a-ac8b-36d8-abc2-45bd5eaabd16",
                                "text": "„FSME (Frühsommer-Meningoenzephalitis) ist eine zum Teil schwer verlaufende Virusinfektion des Gehirns und des Rückenmarks, die durch Zecken übertragen wird.“"
                            },
                            {
                                "example_id": "7821eebe-8d93-4541-a1de-77ed143ce247",
                                "sense_id": "3fdc5e4a-ac8b-36d8-abc2-45bd5eaabd16",
                                "text": "„Die Frühsommer-Meningoenzephalitis (FSME) wird durch ein Virus des Genus Flavivirus in der Familie der Flaviviridae verursacht, der weitere humanpathogene Viren wie das Dengue-, das Gelbfieber- sowie das West-Nil-Virus angehören.“"
                            },
                            {
                                "example_id": "226acfc8-ee88-4cb4-9ea3-4f4dfd0ea3e4",
                                "sense_id": "3fdc5e4a-ac8b-36d8-abc2-45bd5eaabd16",
                                "text": "„Gegen Frühsommer-Meningoenzephalitis (FSME) gibt es keine ursächliche Behandlung. Es sind keine Medikamente bekannt, die gegen das Virus helfen.“"
                            },
                            {
                                "example_id": "5f14c4f4-2ae2-4f06-a18f-08b11cea617d",
                                "sense_id": "3fdc5e4a-ac8b-36d8-abc2-45bd5eaabd16",
                                "text": "„Bei einem Prozent aller Erkrankten, die eine Beteiligung des Zentralnervensystems aufweisen, endet die Frühsommer-Meningoenzephalitis tödlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
