                    },
                    {
                        "form_id": "dc2da68e-75d9-496a-9049-e8da5f18c627",
                        "entry_id": "57b52a95-ce11-37cc-8eb9-c925fde1633b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zankäpfel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                        "entry_id": "57b52a95-ce11-37cc-8eb9-c925fde1633b",
                        "glosses": [
                            "Gegenstand, um den gestritten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75510f12-abfd-4035-9c05-eaf6a2d12c94",
                                "sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                                "text": "Die Krankenversicherung wird vermutlich immer ein Zankapfel bleiben."
                            },
                            {
                                "example_id": "56f168cd-c2b6-41f8-acf4-ccac3b3d818a",
                                "sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                                "text": "„Sie war der Zankapfel der verschiedenen Protagonisten, die sich bis zum letzten Tropfen Schweiß bekriegten.“"
                            },
                            {
                                "example_id": "14a81599-0a43-4304-ac76-d093d1eff49d",
                                "sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                                "text": "Als Zankapfel bezeichnet man im Deutschen eine Sache, bei der es immer zu Streit kommt. „Geld ist zwischen Jonas und Elif ein ewiger Zankapfel\", heißt es zum Beispiel."
                            },
                            {
                                "example_id": "27093988-701e-4551-b184-c5f4fc5b0a5a",
                                "sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                                "text": "„Der Zankapfel war das Münchner Abkommen.“"
                            },
                            {
                                "example_id": "9d498c9d-5aef-4e24-83e6-49ee8ade5dc1",
                                "sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                                "text": "„Die verordnete künstlerische Gestaltung gehört seit Jahrzehnten zu den Zankäpfeln, mit denen sich Architekten, Stadtverwaltungen, Künstler und Bürger mit demokratischer Vielstimmigkeit befassen.“"
                            },
                            {
                                "example_id": "db2b287f-2fe1-49a1-8543-570e499a3a0b",
                                "sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                                "text": "„Kandahar stellte einen ständigen Zankapfel zwischen den Safawiden und den Moguln dar und wurde erst 1649 endgültig dem Safawidenreich einverleibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dc8c9cc-a0f7-491f-97ce-9cef42bbf906",
                        "source_entry_id": "57b52a95-ce11-37cc-8eb9-c925fde1633b",
                        "source_sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                        "source_sense_description": "Gegenstand, um den gestritten wird",
                        "target_lang_word": "bone of contention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bone of contention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f666f0c-88ef-379e-9e71-70156616c096",
                                        "entry_id": "5e7dd3fb-4ff7-3999-9e54-7c8dba87a4bb",
                                        "glosses": [
                                            "Something that continues to be disputed; something on which no agreement can be reached."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ea1a2f-c83a-45f6-80d4-e5db0042c0fe",
                                                "sense_id": "7f666f0c-88ef-379e-9e71-70156616c096",
                                                "text": "It is still a bone of contention whether to go ahead with the original plan in light of the new evidence."
                                            },
                                            {
                                                "example_id": "741437a1-8f85-4b34-a62f-7522e5c96433",
                                                "sense_id": "7f666f0c-88ef-379e-9e71-70156616c096",
                                                "text": "England's \"Football Coming Home\" anthem became a serious bone of contention at the World Cup - with Croatia using it as a sign of arrogance from their opponents in the build up to the semi-final."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5669e1e9-f0e0-4c4b-ab2e-6a7a23eba41f",
                        "source_entry_id": "57b52a95-ce11-37cc-8eb9-c925fde1633b",
                        "source_sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                        "source_sense_description": "Gegenstand, um den gestritten wird",
                        "target_lang_word": "apple of discord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apple of discord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                        "entry_id": "d7d2a12c-33e0-3784-bcb3-66521ef82a86",
                                        "glosses": [
                                            "An object or topic which sows anger and dissension; something which causes argument, rivalry, or strife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddbad97f-8d14-4d2c-b49a-cc1527ae4e88",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "He has determined to enter the cabinet surrounded with creatures only, and, as to the Parliament, to trust to his dexterity and strength in throwing the apple of discord, occasions for doing which will, he imagines, soon and frequently occur."
                                            },
                                            {
                                                "example_id": "537bc2fd-a5c5-4fef-a3cb-1eb0b9b46d30",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "He [Pope Pius VII] had hardly regained Rome when a domestic incident in the Bonaparte family became the immediate cause of that struggle between Pope and Emperor which only ended with the downfall of Napoleon's power. This apple of discord was the outraged honour of a Protestant girl, which the Holy Father maintained in the face of her angered Imperial brother-in-law."
                                            },
                                            {
                                                "example_id": "af88d489-c741-4128-8a07-56dc1fc8c3d6",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "The apportionment of U.S. military assistance to Turkey and Greece has become an apple of discord almost as bitterly disputed by the recipients as the one Aphrodite received from Paris, which touched off the Trojan Wars."
                                            },
                                            {
                                                "example_id": "b73c789c-60a8-4f64-b270-7bed0baf21d4",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "As in the old days when the tribes were fighting each other over hunting grounds, territories and agricultural land, today DRC [the Democratic Republic of the Congo] is prone to many internal conflicts. Especially in the eastern part of the country today's apples of discord appear to be the much-coveted minerals such as gold, diamonds, coltan, and uranium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74227e2e-8212-4747-a1ca-0c02124e5295",
                        "source_entry_id": "57b52a95-ce11-37cc-8eb9-c925fde1633b",
                        "source_sense_id": "2c26f52a-3e46-3b88-9586-c37519abe46b",
                        "source_sense_description": "Gegenstand, um den gestritten wird",
                        "target_lang_word": "pomme de discorde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pomme de discorde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4606e3a-ce0f-3176-a4d7-523ab1503798",
                                        "entry_id": "6a487dcc-d715-3980-bbe0-02e039c2fa73",
                                        "glosses": [
                                            "Sujet de division entre des personnes qui étaient bien ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdec6de-a975-4df0-b720-f31fce99429f",
                                                "sense_id": "c4606e3a-ce0f-3176-a4d7-523ab1503798",
                                                "text": "Ainsi naît un couple sur un malentendu, comme souvent. Plus tard, dans tous les autres albums, l’alcoolisme du capitaine Haddock sera traité avec humour – une pomme de discorde comme en ont tous les vieux couples."
                                            },
                                            {
                                                "example_id": "39814446-a012-473f-a763-b1651dcd6291",
                                                "sense_id": "c4606e3a-ce0f-3176-a4d7-523ab1503798",
                                                "text": "Autre pomme de discorde, la suppression de la taxation réduite sur le gazole non routier utilisé par les engins de chantier contre laquelle des opérations escargot ont été menées lundi en Champagne-Ardenne."
