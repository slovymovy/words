                        "glosses": [
                            "eine meist dreischiffiger Kirchenbau, dessen Gewölbeansätze im Gegensatz zur Basilika alle in gleicher Höhe liegen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e413982-3cac-4260-b3bd-2b3c1b0f6b38",
                                "sense_id": "3e5d9bdc-6ea4-3c7d-a66a-04f450897613",
                                "text": "Das Mittelschiff einer Hallenkirche empfängt sein Licht indirekt über die Fenster der Seitenschiffe."
                            }
                        ],
