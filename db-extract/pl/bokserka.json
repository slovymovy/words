                "translations": [
                    {
                        "translation_id": "c6d6fd48-0c68-4a94-8bf9-582e6d9d3a80",
                        "source_entry_id": "d65512ef-21e3-38a8-b99f-ec7149e84897",
                        "source_sense_id": "e05b4f7c-4547-3fb8-a16a-26d7788eed33",
                        "target_lang_word": "tank top",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tank top",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1bdb8ae-958b-3809-b0f9-99bbf8db92c2",
                                        "entry_id": "4969202b-8062-3079-9de8-1b1db59d19c4",
                                        "glosses": [
                                            "An item of casual clothing: a top with no sleeves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5317cf13-6cca-4caf-a2ab-d9b5db373d40",
                                                "sense_id": "c1bdb8ae-958b-3809-b0f9-99bbf8db92c2",
                                                "text": "The service makes available, during limited weekend hours, a handful of the company's items – cargo shorts, tank tops, and the like – to the Hamptons house guest who discovers that he can't make it to Monday without purchasing one of those weird madras patchwork blazers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a85bde-c49d-3e55-a5ec-52565ffe0fd7",
                                        "entry_id": "4969202b-8062-3079-9de8-1b1db59d19c4",
                                        "glosses": [
                                            "The top of a ship's bilge tank, usually the lowest horizontal surface on board."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f107c0fd-90c5-4bf1-b5fa-06c2ac788389",
                        "source_entry_id": "d65512ef-21e3-38a8-b99f-ec7149e84897",
                        "source_sense_id": "e05b4f7c-4547-3fb8-a16a-26d7788eed33",
                        "target_lang_word": "singlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "singlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7835ad0b-8bd1-31fa-8199-37632c9e3eb8",
                                        "entry_id": "170ddf98-074e-3ab9-b524-312c2ad22b38",
                                        "glosses": [
                                            "A set of one, an item not part of a larger set",
                                            "A multiplet having a single member, especially a single spectroscopic peak."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61d27cdf-9476-3a7f-806f-bada01d5fe30",
                                        "entry_id": "170ddf98-074e-3ab9-b524-312c2ad22b38",
                                        "glosses": [
                                            "A set of one, an item not part of a larger set",
                                            "A quantum state having zero spin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd12261-d28f-4b69-a99b-99c2d008d3fd",
                                                "sense_id": "61d27cdf-9476-3a7f-806f-bada01d5fe30",
                                                "text": "2003, Timothy M. Cox, 90: Protoporphyria, Karl M. Kadish, Kevin M. Smith, Roger Guilard, (editors), The Porphyrin Handbook, Volume 14: Medical Aspects of Porphyrins, page 132,\nWhen a ground state molecule absorbs a photon, the values of the electron spins are not altered and thus the primary excited state is the singlet state."
                                            },
                                            {
                                                "example_id": "6124dc32-d695-4a7a-9889-fffd8340d021",
                                                "sense_id": "61d27cdf-9476-3a7f-806f-bada01d5fe30",
                                                "text": "However, even if it were possible to supply benzophenone with radiation of the appropriate wavelength to produce the second excited singlet state of the molecule, this singlet would rapidly convert to the lowest singlet state (S1)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37875d9-bcdc-3adf-b564-626c4ff2cefb",
                                        "entry_id": "170ddf98-074e-3ab9-b524-312c2ad22b38",
                                        "glosses": [
                                            "A set of one, an item not part of a larger set",
                                            "A person who does not have a form of multiplicity; a single self or personality occupying one human body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf5a6747-50c9-446f-94f6-58fc08563831",
                                                "sense_id": "a37875d9-bcdc-3adf-b564-626c4ff2cefb",
                                                "text": "Singlet and monocultural identity is so normalized that many voice hearers and plurals don’t share their experiences with anyone, living in isolation (and sometimes in poverty) and spending considerable inner resources to manage postures and performances of ‘mental health’."
                                            },
                                            {
                                                "example_id": "aa4d20cb-3d96-4a57-a328-2375fc4ec359",
                                                "sense_id": "a37875d9-bcdc-3adf-b564-626c4ff2cefb",
                                                "text": "Her system started when she was 17 years old: “We were not created by trauma. It started from being a singlet (one body, one person), but then, we lost our sense of self. […]"
                                            },
                                            {
                                                "example_id": "28034486-e666-434d-b1a3-dca24879c71f",
                                                "sense_id": "a37875d9-bcdc-3adf-b564-626c4ff2cefb",
                                                "text": "More strongly, respect might require that singlets themselves accept, in the context of interacting with plurals, that people are truly distinct people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f2512b-47c6-340a-94ba-15ad577dddc8",
                                        "entry_id": "170ddf98-074e-3ab9-b524-312c2ad22b38",
                                        "glosses": [
                                            "A single piece of clothing",
                                            "A sleeveless buttonless shirt with a low-cut neck."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
                                            "Nigeria",
                                            "Singapore",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90201bd2-c26d-422e-b0f3-f979ae004abc",
                                                "sense_id": "29f2512b-47c6-340a-94ba-15ad577dddc8",
                                                "text": "Winston wrenched his body out of bed — naked, for a member of the Outer Party received only 3,000 clothing coupons annually, and a suit of pyjamas was 600 — and seized a dingy singlet and a pair of shorts that were lying across a chair."
                                            },
                                            {
                                                "example_id": "242ffa57-b7de-455b-9a7a-198187631da6",
                                                "sense_id": "29f2512b-47c6-340a-94ba-15ad577dddc8",
                                                "text": "2000, Nicole Matthews, Kitsch on the Fringe: Suburbia in Recent Australian Comedy Film, Roger Webster, Expanding Suburbia: Reviewing Suburban Narratives, page 176,\nThe semiotics of the singlet - immediately identifiable in Australia, especially in its usual shade of blue, with male manual labourers¹⁶ - underlines the contrast between the effete fakery of ballroom costumes and real masculinity to be found underneath or in the world of folk dancing."
                                            },
                                            {
                                                "example_id": "5fb0c2ec-0faa-4531-8f55-fd8d87dd07b7",
                                                "sense_id": "29f2512b-47c6-340a-94ba-15ad577dddc8",
                                                "text": "However, even in the latter he wears a blue singlet to help remind the audience of his working-class roots."
                                            },
                                            {
                                                "example_id": "14fce864-34f9-4353-a48f-1e2af0a4a8b3",
                                                "sense_id": "29f2512b-47c6-340a-94ba-15ad577dddc8",
                                                "text": "2009, Deborah Penrith, Live & Work in: Australia, Crimson Publishing, UK, page 192,\nWomen wear dresses, cropped trousers and vests with lightweight linen jackets and you will find men in anything from a business suit to a pair of stubbies (very short shorts) and a singlet top (white vest) or knee-length cargo trousers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57528f39-0dbf-3fb6-8718-0fffc327a7ea",
                                        "entry_id": "170ddf98-074e-3ab9-b524-312c2ad22b38",
                                        "glosses": [
                                            "A single piece of clothing",
                                            "A one-piece, tight-fitting uniform, usually made of spandex or nylon, required in wrestling and powerlifting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
