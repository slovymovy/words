                                            {
                                                "example_id": "18369049-3536-4c74-b0b0-b697ca1b7b45",
                                                "sense_id": "b806d523-deb0-3b85-9a89-8820de6a7ca6",
                                                "text": "Euer andauerndes Gemecker über das Essen mag ich nicht mehr hören."
                                            },
                                            {
                                                "example_id": "7c7893cb-3760-470f-9bdc-c11026882321",
                                                "sense_id": "b806d523-deb0-3b85-9a89-8820de6a7ca6",
                                                "text": "Wie schön, dass andauernd die Sonne scheint."
                                            },
                                            {
                                                "example_id": "342963cc-4847-4290-885b-c72e2de8803d",
                                                "sense_id": "b806d523-deb0-3b85-9a89-8820de6a7ca6",
                                                "text": "Andauernd kommt er mit den gleichen alten Geschichten daher."
                                            }
