{
    "word_family": [
        "clumsily",
        "clumsiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b68cf3b4-4ad0-381a-9c9d-3a87781603ec",
                    "sense_definition": "Awkward, lacking physical coordination, or not graceful.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lack_of_grace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is very <w>clumsy</w> and constantly drops glasses in the kitchen.",
                            "target_lang_translations": {
                                "it": "È molto <w>maldestro</w> e fa cadere continuamente bicchieri in cucina.",
                                "tr": "O çok <w>sakardır</w> ve mutfakta sürekli bardak düşürür."
                            }
                        },
                        {
                            "text": "I felt like a <w>clumsy</w> dancer next to the professionals on stage.",
                            "target_lang_translations": {
                                "it": "Mi sentivo una ballerina <w>goffa</w> accanto ai professionisti sul palco.",
                                "tr": "Sahnedeki profesyonellerin yanında kendimi <w>hantal</w> bir dansçı gibi hissettim."
                            }
                        }
                    ],
                    "antonyms": [
                        "graceful",
                        "dextrous"
                    ],
                    "common_phrases": [
                        "clumsy person",
                        "clumsy hands",
                        "clumsy feet"
                    ],
                    "target_lang_definitions": {
                        "it": "Maldestro, privo di coordinazione fisica o di grazia nei movimenti.",
                        "tr": "Fiziksel koordinasyonu zayıf, zarif olmayan veya hareketlerinde beceriksiz."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "maldestro",
                                "target_lang_sense_clarification": "che manca di abilità o precisione nei movimenti"
                            },
                            {
                                "target_lang_word": "goffo",
                                "target_lang_sense_clarification": "privo di grazia o eleganza, impacciato"
                            },
                            {
                                "target_lang_word": "impacciato",
                                "target_lang_sense_clarification": "poco sciolto o bloccato nei movimenti"
                            },
                            {
                                "target_lang_word": "sgraziato",
                                "target_lang_sense_clarification": "senza armonia o leggiadria fisica"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sakar",
                                "target_lang_sense_clarification": "sürekli bir şeyleri düşüren ya da deviren kimse"
                            },
                            {
                                "target_lang_word": "beceriksiz",
                                "target_lang_sense_clarification": "elinden iş gelmeyen, fiziksel olarak hünersiz"
                            },
                            {
                                "target_lang_word": "hantal",
                                "target_lang_sense_clarification": "hareketleri kaba, ağır ve zarafetten yoksun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a61a2e6-9ac9-3f72-a1f7-51f4543ed9f8",
                    "sense_definition": "Lacking skill, tact, or subtlety; not elegant or well-planned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lack_of_tact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician made a <w>clumsy</w> attempt to hide his mistake from the press.",
                            "target_lang_translations": {
                                "it": "Il politico ha fatto un <w>maldestro</w> tentativo di nascondere il suo errore alla stampa.",
                                "tr": "Siyasetçi, hatasını basından gizlemek için <w>beceriksizce</w> bir girişimde bulundu."
                            }
                        },
                        {
                            "text": "His <w>clumsy</w> apology only made her feel more offended.",
                            "target_lang_translations": {
                                "it": "Le sue scuse <w>goffe</w> l'hanno fatta sentire solo più offesa.",
                                "tr": "Onun <w>patavatsız</w> özrü, kadının yalnızca daha çok kırılmasına neden oldu."
                            }
                        }
                    ],
                    "antonyms": [
                        "tactful",
                        "diplomatic"
                    ],
                    "common_phrases": [
                        "clumsy attempt",
                        "clumsy apology",
                        "clumsy remark"
                    ],
                    "target_lang_definitions": {
                        "it": "Privo di tatto, finezza o abilità; poco delicato o poco accorto.",
                        "tr": "İncelikten, nezaketten veya ustalıktan yoksun; düşüncesizce ya da beceriksizce yapılmış."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "maldestro",
                                "target_lang_sense_clarification": "fatto malamente, non opportuno o poco abile"
                            },
                            {
                                "target_lang_word": "goffo",
                                "target_lang_sense_clarification": "senza delicatezza, poco opportuno o ridicolo"
                            },
                            {
                                "target_lang_word": "grossolano",
                                "target_lang_sense_clarification": "privo di finezza o sensibilità"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "beceriksizce",
                                "target_lang_sense_clarification": "ustalık ve incelikten uzak bir şekilde yapılan"
                            },
                            {
                                "target_lang_word": "patavatsız",
                                "target_lang_sense_clarification": "taktik ve incelikten yoksun, pot kıran"
                            },
                            {
                                "target_lang_word": "kaba",
                                "target_lang_sense_clarification": "incelik ve zarafet barındırmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847694db-abe7-3491-91d6-5209a01dc6b2",
                    "sense_definition": "Awkward or inefficient in design or construction; difficult to handle or manage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "awkward_design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This software interface is <w>clumsy</w> and difficult for new users to navigate.",
                            "target_lang_translations": {
                                "it": "L'interfaccia di questo software è <w>scomoda</w> e difficile da navigare per i nuovi utenti.",
                                "tr": "Bu yazılım arayüzü <w>kullanışsız</w> ve yeni kullanıcıların gezinmesi için oldukça zor."
                            }
                        },
                        {
                            "text": "The machine had a <w>clumsy</w> design that took up far too much space.",
                            "target_lang_translations": {
                                "it": "La macchina aveva un design <w>grossolano</w> che occupava troppo spazio.",
                                "tr": "Makinenin çok fazla yer kaplayan <w>hantal</w> bir tasarımı vardı."
                            }
                        }
                    ],
                    "antonyms": [
                        "handy",
                        "elegant"
                    ],
                    "common_phrases": [
                        "clumsy design",
                        "clumsy tool"
                    ],
                    "target_lang_definitions": {
                        "it": "Poco funzionale, mal progettato o difficile da maneggiare o usare.",
                        "tr": "Tasarımı veya yapısı kullanışsız, kaba; kullanımı veya idaresi zor."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scomodo",
                                "target_lang_sense_clarification": "poco pratico da usare o gestire"
                            },
                            {
                                "target_lang_word": "malfatto",
                                "target_lang_sense_clarification": "costruito o progettato male"
                            },
                            {
                                "target_lang_word": "grossolano",
                                "target_lang_sense_clarification": "rudimentale, rozzo o poco rifinito"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kullanışsız",
                                "target_lang_sense_clarification": "rahat kullanılamayan, pratik olmayan tasarım"
                            },
                            {
                                "target_lang_word": "hantal",
                                "target_lang_sense_clarification": "fazla yer kaplayan, ağır ve pratiklikten uzak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a1a5c42-8ff1-30d7-b200-1872dd33fbf0",
                    "sense_definition": "A clumsy or awkward person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lack_of_grace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Watch your step, you silly <w>clumsy</w>, before you break another vase!",
                            "target_lang_translations": {
                                "it": "Guarda dove metti i piedi, razza di <w>imbranato</w>, prima di rompere un altro vaso!",
                                "tr": "Başka bir vazo kırmadan önce önüne bak, seni şapşal <w>sakar</w>!"
                            }
                        },
                        {
                            "text": "He called his younger brother a <w>clumsy</w> after the boy spilled his juice.",
                            "target_lang_translations": {
                                "it": "Ha dato dell'<w>imbranato</w> a suo fratello minore dopo che il ragazzino ha rovesciato il succo.",
                                "tr": "Çocuk meyve suyunu döktükten sonra, küçük kardeşine <w>beceriksiz</w> dedi."
                            }
                        }
                    ],
                    "synonyms": [
                        "butterfingers",
                        "galoot",
                        "klutz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage as a noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Persona maldestra, impacciata o sbadica.",
                        "tr": "Sakar, eli ayağına dolaşan kimse."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "imbranato",
                                "target_lang_sense_clarification": "colloquiale per persona goffa o maldestra"
                            },
                            {
                                "target_lang_word": "maldestro",
                                "target_lang_sense_clarification": "usato come sostantivo per persona sgraziata"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sakar",
                                "target_lang_sense_clarification": "sürekli küçük kazalar yapan kişi"
                            },
                            {
                                "target_lang_word": "beceriksiz",
                                "target_lang_sense_clarification": "işleri eline yüzüne bulaştıran kişi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}