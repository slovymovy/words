                    {
                        "sense_id": "67b96969-086c-3e57-9c8b-0a49fb851921",
                        "entry_id": "14a4e7b7-1046-39f3-97ba-4e4224befa3f",
                        "glosses": [
                            "misericord (medieval dagger used to deliver mercy strokes)"
                        ],
                        "tags": [
                            "feminine",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5d217c09-604e-40a1-9948-b702e77d73fe",
                                "sense_id": "67b96969-086c-3e57-9c8b-0a49fb851921",
                                "text": "Lecz Czech wnet wydostał się na wierzch, przez chwilę tłumił jeszcze rozpaczliwe ruchy przeciwnika, wreszcie przycisnął kolanem żelazną siatkę pokrywającą jego brzuch i wydobył z za pasa krótką, trójgranną mizerykordyę.",
                                "translation": "But Czech suddenly got out on top, and desperately watched his opponent's moves, finally stamped the iron net that was covering his stomach with his knee and took out his short, trihedronal misericord.",
                                "english": "But Czech suddenly got out on top, and desperately watched his opponent's moves, finally stamped the iron net that was covering his stomach with his knee and took out his short, trihedronal misericord."
                            }
                        ]
                    }
