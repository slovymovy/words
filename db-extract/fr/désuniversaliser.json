                "senses": [
                    {
                        "sense_id": "9a20e364-8c3e-3f39-8747-6ab19055a544",
                        "entry_id": "9bcec9c8-49cf-310c-a090-6e1d470d2178",
                        "glosses": [
                            "Faire perdre son caractère universel à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "358477aa-31fd-4056-a79d-d0f7a2d18e3c",
                                "sense_id": "9a20e364-8c3e-3f39-8747-6ab19055a544",
                                "text": "Historiciser, c’est toujours déjà désuniversaliser, mais c’est le seul chemin humain pour ouvrir à l’universel."
                            },
                            {
                                "example_id": "43640536-6b75-49bf-9362-a6c8fd3ba8ad",
                                "sense_id": "9a20e364-8c3e-3f39-8747-6ab19055a544",
                                "text": "En d’autres termes, la perception pendant la Seconde Guerre mondiale du déclin des puissances qui composent l’Europe permet de désuniversaliser et d’européaniser le discours des Européens."
                            }
                        ]
                    }
