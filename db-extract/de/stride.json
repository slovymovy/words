                                    {
                                        "sense_id": "4e6a1cf8-44d1-3282-b605-e0dae550b961",
                                        "entry_id": "fed06d56-7a55-3c1a-9a3b-6713e7d71fe6",
                                        "glosses": [
                                            "Trousers."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "plural",
                                            "plural-only",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e32b0cc5-165e-49f5-9ad8-d173eff18bf5",
                                                "sense_id": "4e6a1cf8-44d1-3282-b605-e0dae550b961",
                                                "text": "2004, Marion Houldsworth, Red Dust Rising: The Story of Ray Fryer of Urapunga, Central Queensland University Press, 2011, Boolarong Press, page 97,\nSo he gave him one boot. I said, ‘One boot′s no bloody good! Give him two boot[s]!’ So he chucks over another boot, and a pair of strides."
                                            },
                                            {
                                                "example_id": "00bce2c5-9901-438c-808d-c1ed1865641a",
                                                "sense_id": "4e6a1cf8-44d1-3282-b605-e0dae550b961",
                                                "text": "He went upstairs and changed into a fresh pair of strides, nipped into the bathroom and gave his hands and face a quick rinse and threw on a clean pullover."
                                            },
                                            {
                                                "example_id": "d437332d-c930-4e26-a4a2-673c20215b6c",
                                                "sense_id": "4e6a1cf8-44d1-3282-b605-e0dae550b961",
                                                "text": "His mother used to have to buy two pair of strides for him, cut the legs off one and sew them onto the other."
                                            },
                                            {
                                                "example_id": "38ba2e68-ed61-4c62-8dbb-a86d311fc1ec",
                                                "sense_id": "4e6a1cf8-44d1-3282-b605-e0dae550b961",
                                                "text": "I thought of Des and May′s daughters, then of Gleaves, and resolved to borrow a pair of strides from Cliff, to keep the tie-wearing penile-challenged toss-bag oaf ma case."
                                            }
                                        ]
                                    }
                                ]
