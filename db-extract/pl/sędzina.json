                    {
                        "translation_id": "95434c24-75c6-4f87-a63d-49bc85e06203",
                        "source_entry_id": "e2547127-ef04-3651-9c86-81bf717a8846",
                        "source_sense_id": "da32a279-649a-3f64-9ced-f6e1fcdb6400",
                        "target_lang_word": "Richterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Richterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb7b3c0-305d-3923-9adf-6706425603b1",
                                        "entry_id": "69d63db9-2d31-3c30-a0bb-0bd256f131cc",
                                        "glosses": [
                                            "Inhaberin eines öffentlichen Amtes bei einem Gericht, die Aufgaben der Judikatur (Rechtsprechung) wahrnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d29bfe-e1e1-4a40-a0c7-a454860e0775",
                                                "sense_id": "2eb7b3c0-305d-3923-9adf-6706425603b1",
                                                "text": "Die Richterin verkündete das Urteil."
                                            },
                                            {
                                                "example_id": "eae67a93-0cca-438a-94b3-941db2a61918",
                                                "sense_id": "2eb7b3c0-305d-3923-9adf-6706425603b1",
                                                "text": "„Die Richterin dankt Staatsanwaltschaft und Verteidigung - und vertagt auf den 11. September 2014. Dann wird Richterin Masipa ihr Urteil über die Schuld des Angeklagten bekannt geben.“"
                                            },
                                            {
                                                "example_id": "915ee246-0465-4e17-832d-047d6ed29b4a",
                                                "sense_id": "2eb7b3c0-305d-3923-9adf-6706425603b1",
                                                "text": "„Richterin Masipa stellt Staatsanwalt Nel ein paar Fragen - zu den neuen Fotos, den Telefondaten und der Zeitschiene, dann überlässt sie ihm das Wort.“"
                                            },
                                            {
                                                "example_id": "afd1b45d-8c11-4b99-920f-fe6e39e84fb2",
                                                "sense_id": "2eb7b3c0-305d-3923-9adf-6706425603b1",
                                                "text": "„Richterin Masipa lauscht aufmerksam den Ausführungen von Barry Roux.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
