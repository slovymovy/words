{
    "word_family": [
        "hemming",
        "hemline",
        "hemstitch",
        "hemmer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32bec69d-f591-37f0-844f-d295948ca757",
                    "sense_definition": "The edge of a piece of cloth or clothing that has been folded back and sewn down to prevent fraying.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to shorten the dress by raising the <w>hem</w> two inches.",
                            "target_lang_translations": {
                                "ru": "Она решила укоротить платье, подняв <w>подо́л</w> на два дюйма.",
                                "it": "Decise di accorciare il vestito alzando l'<w>orlo</w> di due pollici."
                            }
                        },
                        {
                            "text": "The <w>hem</w> of his jeans was wet and muddy after walking through the rain.",
                            "target_lang_translations": {
                                "ru": "<w>Край</w> его джинсов был мокрым и грязным после прогулки под дождем.",
                                "it": "L'<w>orlo</w> dei suoi jeans era bagnato e infangato dopo aver camminato sotto la pioggia."
                            }
                        }
                    ],
                    "common_phrases": [
                        "let down the hem",
                        "take up the hem",
                        "frayed hem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Край ткани или одежды, который был подогнут и подшит для предотвращения осыпания.",
                        "it": "Il bordo di un capo di abbigliamento o di un tessuto piegato e cucito per evitare che si sfilacci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подги́бка",
                                "target_lang_sense_clarification": "швейный термин; подогнутый край"
                            },
                            {
                                "target_lang_word": "подо́л",
                                "target_lang_sense_clarification": "нижний край платья, юбки или пальто"
                            },
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "общая граница или обрез ткани"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "orlo",
                                "target_lang_sense_clarification": "bordo ripiegato e cucito di un vestito o tessuto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d98fbea-900f-39df-9c4b-de9d1929d950",
                    "sense_definition": "A rim, margin, or outer boundary of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They built a small cottage on the <w>hem</w> of the forest.",
                            "target_lang_translations": {
                                "ru": "Они построили маленький коттедж на <w>кро́мке</w> леса.",
                                "it": "Costruirono un piccolo cottage al <w>margine</w> della foresta."
                            }
                        },
                        {
                            "text": "We walked along the <w>hem</w> of the river bank watching the water flow.",
                            "target_lang_translations": {
                                "ru": "Мы шли по <w>кро́мке</w> речного берега, наблюдая за течением воды.",
                                "it": "Camminammo lungo l'<w>orlo</w> della riva del fiume guardando scorrere l'acqua."
                            }
                        }
                    ],
                    "synonyms": [
                        "margin",
                        "rim",
                        "edge",
                        "fringe"
                    ],
                    "antonyms": [
                        "center"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ободок, край или внешняя граница чего-либо.",
                        "it": "Bordo, estremità o limite esterno di qualcosa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кро́мка",
                                "target_lang_sense_clarification": "край леса, льда или материала"
                            },
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "граница, предел"
                            },
                            {
                                "target_lang_word": "кайма́",
                                "target_lang_sense_clarification": "декоративная полоса по краю"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "orlo",
                                "target_lang_sense_clarification": "limite o estremità"
                            },
                            {
                                "target_lang_word": "margine",
                                "target_lang_sense_clarification": "bordo, limite esterno"
                            },
                            {
                                "target_lang_word": "lembo",
                                "target_lang_sense_clarification": "estremità o striscia marginale"
                            },
                            {
                                "target_lang_word": "bordo",
                                "target_lang_sense_clarification": "estremità di una superficie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30a19af5-ea24-3659-8c0f-3f92a14afb47",
                    "sense_definition": "To fold back and sew down the edge of a piece of cloth or clothing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sewing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>hem</w> these trousers because they are too long for me.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>подши́ть</w> эти брюки, потому что они мне слишком длинны.",
                                "it": "Devo <w>fare l'orlo a</w> questi pantaloni perché sono troppo lunghi per me."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>hemming</w> the curtains for the living room.",
                            "target_lang_translations": {
                                "ru": "Она провела день, <w>подшива́я</w> шторы для гостиной.",
                                "it": "Passò il pomeriggio a <w>orlare</w> le tende per il soggiorno."
                            }
                        }
                    ],
                    "synonyms": [
                        "sew",
                        "stitch"
                    ],
                    "common_phrases": [
                        "hem a skirt",
                        "hem the pants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подгибать и подшивать край ткани или одежды.",
                        "it": "Ripiegare e cucire il bordo di un capo d'abbigliamento o tessuto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подшива́ть",
                                "target_lang_sense_clarification": "шитьем закреплять подогнутый край"
                            },
                            {
                                "target_lang_word": "подруба́ть",
                                "target_lang_sense_clarification": "обрабатывать край швом"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "orlare",
                                "target_lang_sense_clarification": "fare l'orlo a un capo o tessuto"
                            },
                            {
                                "target_lang_word": "fare l'orlo a",
                                "target_lang_sense_clarification": "cucire e rifinire il bordo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af774f69-1811-3b00-8ebf-1161832c5891",
                    "sense_definition": "To surround someone or something closely and restrict their movement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "enclose_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The troops were <w>hemmed</w> in on all sides by the opposing army.",
                            "target_lang_translations": {
                                "ru": "Войска были <w>окружены́</w> со всех сторон армией противника.",
                                "it": "Le truppe furono <w>accerchiate</w> da ogni lato dall'esercito nemico."
                            }
                        },
                        {
                            "text": "I felt <w>hemmed</w> in by the large crowd at the concert.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя <w>зажа́тым</w> в большой толпе на концерте.",
                                "it": "Mi sentivo <w>intrappolato</w> dalla grande folla al concerto."
                            }
                        }
                    ],
                    "synonyms": [
                        "enclose",
                        "confine",
                        "surround",
                        "trap"
                    ],
                    "antonyms": [
                        "release",
                        "free"
                    ],
                    "common_phrases": [
                        "hem in",
                        "hemmed in by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесно окружать кого-либо или что-либо, ограничивая движения.",
                        "it": "Circondare da vicino qualcuno o qualcosa limitandone i movimenti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружа́ть",
                                "target_lang_sense_clarification": "брать в кольцо"
                            },
                            {
                                "target_lang_word": "зажима́ть",
                                "target_lang_sense_clarification": "стеснять, ограничивать свободу"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "accerchiare",
                                "target_lang_sense_clarification": "chiudere in una morsa o cerchio"
                            },
                            {
                                "target_lang_word": "circondare",
                                "target_lang_sense_clarification": "chiudere intorno"
                            },
                            {
                                "target_lang_word": "intrappolare",
                                "target_lang_sense_clarification": "restringere e bloccare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4b781a8-2602-3e10-b804-23c96eb38a0b",
                    "sense_definition": "To hesitate in speech, often making a throat-clearing sound to fill a pause.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started to <w>hem</w> and haw when the teacher asked for his homework.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>мя́млить</w>, когда учитель спросил про домашнее задание.",
                                "it": "Cominciò a <w>tentennare</w> e tergiversare quando l'insegnante gli chiese i compiti."
                            }
                        },
                        {
                            "text": "Stop <w>hemming</w> and just give me a straight answer.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>мя́млить</w> и просто дай мне прямой ответ.",
                                "it": "Smettila di <w>esitare</w> e dammi semplicemente una risposta diretta."
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitate",
                        "falter"
                    ],
                    "common_phrases": [
                        "hem and haw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запинаться в речи, часто издавая звуки для заполнения паузы.",
                        "it": "Esitare nel parlare, spesso schiarendosi la voce per riempire una pausa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мя́млить",
                                "target_lang_sense_clarification": "говорить невнятно, неуверенно"
                            },
                            {
                                "target_lang_word": "запина́ться",
                                "target_lang_sense_clarification": "делать паузы в речи"
                            },
                            {
                                "target_lang_word": "хмы́кать",
                                "target_lang_sense_clarification": "издавать звук «хм»"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "tentennare",
                                "target_lang_sense_clarification": "mostrare esitazione nel parlare"
                            },
                            {
                                "target_lang_word": "esitare",
                                "target_lang_sense_clarification": "indugiare prima di rispondere"
                            },
                            {
                                "target_lang_word": "balbettare",
                                "target_lang_sense_clarification": "parlare con insicurezza o fare versi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4d8dbeab-5fcf-39f0-a4b9-52fadc56ee27",
                    "sense_definition": "Used to fill a pause in speech or to attract attention, similar to a throat-clearing sound.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hem</w>, I believe it is my turn to speak now.",
                            "target_lang_translations": {
                                "ru": "<w>Кхм</w>, я полагаю, теперь моя очередь говорить.",
                                "it": "<w>Ehm</w>, credo che ora tocchi a me parlare."
                            }
                        },
                        {
                            "text": "The speaker said <w>hem</w> several times while looking for his notes.",
                            "target_lang_translations": {
                                "ru": "Оратор несколько раз произнес «<w>кхм</w>», пока искал свои записи.",
                                "it": "L'oratore disse «<w>ehm</w>» diverse volte mentre cercava i suoi appunti."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahem",
                        "um",
                        "er"
                    ],
                    "target_lang_definitions": {
                        "ru": "Междометие, используемое для заполнения паузы или привлечения внимания (звук покашливания).",
                        "it": "Interiezione usata per riempire una pausa o per attirare l'attenzione, simile a un colpo di tosse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кхм",
                                "target_lang_sense_clarification": "звук покашливания"
                            },
                            {
                                "target_lang_word": "гм",
                                "target_lang_sense_clarification": "выражение сомнения или паузы"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ehm",
                                "target_lang_sense_clarification": "interiezione per prendere tempo o attirare attenzione"
                            },
                            {
                                "target_lang_word": "coff",
                                "target_lang_sense_clarification": "suono per schiarirsi la voce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "3ea99fa5-c4e8-33fa-aec8-9aca535db1f5",
                    "sense_definition": "An obsolete form of the pronoun 'them'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text instructed the knight to guide <w>hem</w> to safety.",
                            "target_lang_translations": {
                                "ru": "Древний текст наставлял рыцаря привести <w>их</w> в безопасное место.",
                                "it": "L'antico testo ordinava al cavaliere di condur<w>li</w> in salvo."
                            }
                        },
                        {
                            "text": "He gathered the apples and placed <w>hem</w> in the basket.",
                            "target_lang_translations": {
                                "ru": "Он собрал яблоки и положил <w>их</w> в корзину.",
                                "it": "Raccolse le mele e <w>le</w> mise nel cestino."
                            }
                        }
                    ],
                    "synonyms": [
                        "them",
                        "'em"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "found in Middle English texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма местоимения «them» (их).",
                        "it": "Forma arcaica del pronome inglese 'them' (loro, essi)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "их",
                                "target_lang_sense_clarification": "местоимение 3-го лица мн. ч."
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "loro",
                                "target_lang_sense_clarification": "pronome personale di terza persona plurale"
                            },
                            {
                                "target_lang_word": "li",
                                "target_lang_sense_clarification": "pronome complemento oggetto maschile plurale"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1f16736a-aac6-3e33-aad9-e453d8f1f4c8",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hem</w> arrived late to the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хем</w> опоздал на встречу.",
                                "it": "Il signor <w>Hem</w> è arrivato in ritardo alla riunione."
                            }
                        },
                        {
                            "text": "We are looking for a file under the name <w>Hem</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем файл под именем <w>Хем</w>.",
                                "it": "Stiamo cercando un fascicolo a nome <w>Hem</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "it": "Un cognome."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хем",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "Hem",
                                "target_lang_sense_clarification": "cognome"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}