                                    {
                                        "sense_id": "c76edf0a-a29d-3b24-b712-d5c83a6c93ff",
                                        "entry_id": "73d73aac-31b7-3812-8886-fe8b363e44bb",
                                        "glosses": [
                                            "Théorie scientifique qui combine la supersymétrie et la relativité générale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5f7211-0580-424c-9f45-4e5c495d8664",
                                                "sense_id": "c76edf0a-a29d-3b24-b712-d5c83a6c93ff",
                                                "text": "Les théories de supergravité ont été introduites à l'origine comme théories candidates à l'unification de la mécanique quantique avec la relativité générale."
                                            },
                                            {
                                                "example_id": "b4818245-5da6-4437-aada-6f63c48bf900",
                                                "sense_id": "c76edf0a-a29d-3b24-b712-d5c83a6c93ff",
                                                "text": "Bien qu'elle ne fasse pas intervenir des théories exotiques comme la supergravité ou la théorie de Kaluza-Klein avec des dimensions spatiales supplémentaires, elle suggère l'apparition d'un effet inattendu en chromodynamique quantique."
                                            }
                                        ]
                                    }
                                ]
                            }
