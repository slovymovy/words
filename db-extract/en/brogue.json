                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5404b552-07c6-423e-a4dc-00c51d7f2481",
                        "source_entry_id": "fe5641c8-5ee4-3927-8e3d-d0405f6af6b9",
                        "source_sense_description": "A strong dialectal accent",
                        "target_lang_word": "Dialekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dialekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                        "entry_id": "272f1dba-8cc3-3edd-a821-0ed8f5f160c0",
                                        "glosses": [
                                            "die ursprüngliche, landschaftlich verschiedene Redeweise einer Region im Gegensatz zur dort geltenden Schrift- und Umgangssprache (Hochsprache)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2e0ef1-d98f-4116-bcc5-a8a9cb59f477",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "Du sprichst aber einen sehr starken Dialekt."
                                            },
                                            {
                                                "example_id": "be415af7-8a1f-47a2-9287-19e8999ca183",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "Hessisch ist ein mitteldeutscher Dialekt."
                                            },
                                            {
                                                "example_id": "d280f197-73a3-4735-941e-9da5a66b1ffb",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "Dialekte gehören zum Diasystem einer Sprache."
                                            },
                                            {
                                                "example_id": "3ef19791-152c-4b94-855a-e4890283fab4",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "Der Wortschatz von Dialekt und Hochsprache stimmt oft weitgehend überein, wird aber im Dialekt leicht bis für Auswärtige unkenntlich abgewandelt ausgesprochen."
                                            },
                                            {
                                                "example_id": "7204a6e9-ba69-403e-bd24-8c11a30ba510",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "„Der Rückgang des Dialekts bei den mittleren Jahrgängen hängt mit dem Berufsleben zusammen…“"
                                            },
                                            {
                                                "example_id": "cce72444-6c88-4c7e-a36e-a828654f72f3",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "„Im Vergleich mit anderen Sprachvarietäten können Dialekte als recht eigenständige Varietäten angesehen werden.“"
                                            },
                                            {
                                                "example_id": "185c9d0b-5405-4e10-bc43-da82c3458fe9",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "„Auch wenn die Juden die mittelhochdeutschen Dialekte ihrer christlichen Nachbarn spätestens im 11. Jahrhundert als Umgangssprache untereinander übernahmen, fanden sie im Deutschen für ihre von der jüdischen Religion geprägten Lebensbereiche keine entsprechenden Ausdrücke vor, sondern mussten sie erst bilden.“"
                                            },
                                            {
                                                "example_id": "92f7a9aa-6760-46ea-ad8e-dc3cb46ea60e",
                                                "sense_id": "a77ae083-2454-36e0-b298-a80a40951eaa",
                                                "text": "„Er sprach einen góralischen Dialekt, der sich wie Hundebellen anhört; die Polen können ihn nicht leiden, er ist ihnen zu primitiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
