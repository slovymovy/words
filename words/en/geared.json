{
    "word_family": [
        "gear",
        "gearing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f270e73-be3b-36cc-aed7-aaf33941df4b",
                    "sense_definition": "Equipped with a specific type or number of gears.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain bike is <w>geared</w> for climbing steep hills.",
                            "target_lang_translations": {
                                "ru": "Этот горный велосипед <w>оборудован передачами</w> для подъема на крутые холмы."
                            }
                        },
                        {
                            "text": "This machine is <w>geared</w> to handle heavy industrial tasks.",
                            "target_lang_translations": {
                                "ru": "Эта машина <w>настроена</w> на выполнение тяжелых промышленных задач."
                            }
                        }
                    ],
                    "synonyms": [
                        "equipped"
                    ],
                    "common_phrases": [
                        "geared for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащенный определенным типом или количеством передач, либо настроенный на выполнение конкретной задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборудованный",
                                "target_lang_sense_clarification": "имеющий необходимое оснащение"
                            },
                            {
                                "target_lang_word": "настроенный",
                                "target_lang_sense_clarification": "подготовленный для определенной цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58cd169c-12d3-364a-a513-a8403ceda07a",
                    "sense_definition": "Linked to a motor or engine through a system of gears.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The propeller is <w>geared</w> directly to the main engine.",
                            "target_lang_translations": {
                                "ru": "Винт <w>соединен через передачу</w> напрямую с главным двигателем."
                            }
                        },
                        {
                            "text": "The pump is <w>geared</w> to the motor for consistent speed.",
                            "target_lang_translations": {
                                "ru": "Насос <w>соединен с двигателем</w> для поддержания постоянной скорости."
                            }
                        }
                    ],
                    "synonyms": [
                        "connected"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединенный с двигателем или мотором через систему зубчатых передач."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединенный через передачу",
                                "target_lang_sense_clarification": "механическая связь посредством шестерен"
                            },
                            {
                                "target_lang_word": "приводной",
                                "target_lang_sense_clarification": "связанный с приводом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89722701-5519-3f63-b3c6-b713e86c0eee",
                    "sense_definition": "Simple past and past participle of <w>gear</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>geared</w> its marketing strategy toward younger customers.",
                            "target_lang_translations": {
                                "ru": "Компания <w>направила</w> свою маркетинговую стратегию на более молодых клиентов."
                            }
                        },
                        {
                            "text": "They have <w>geared</w> up for the busy holiday season.",
                            "target_lang_translations": {
                                "ru": "Они <w>подготовились</w> к напряженному праздничному сезону."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geared up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of gear"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола gear (направлять, подготавливать, приспосабливать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направил",
                                "target_lang_sense_clarification": "в контексте стратегии или усилий"
                            },
                            {
                                "target_lang_word": "подготовил",
                                "target_lang_sense_clarification": "в контексте подготовки к событию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}