                "senses": [
                    {
                        "sense_id": "96a00c10-7ba4-3e36-b39d-81cceb8975f5",
                        "entry_id": "4bbd086e-9389-3477-b55e-61588f9c5543",
                        "glosses": [
                            "Eigenschaft (in einem bestimmten Zusammenhang) unwichtig, unbedeutsam zu sein"
                        ],
                        "tags": [
                            "formal",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4fd5f310-a74f-421f-b9fc-8d074868ee94",
                                "sense_id": "96a00c10-7ba4-3e36-b39d-81cceb8975f5",
                                "text": "Diese Bemerkung möchte ich einmal wegen Irrelevanz zurückweisen."
                            },
                            {
                                "example_id": "179c94b9-d448-4885-bd13-ea0905056bda",
                                "sense_id": "96a00c10-7ba4-3e36-b39d-81cceb8975f5",
                                "text": "Irrelevanz würde ich als Grund noch nicht einmal anführen mögen. Das ist schon relevant, aber eben irreführend."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37f9cf96-f302-393a-8765-abba02b13fc5",
                        "entry_id": "4bbd086e-9389-3477-b55e-61588f9c5543",
                        "glosses": [
                            "unwichtige Aussage, Bemerkung oder Ähnliches"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71e4546b-a191-4360-b564-ef019e19d492",
                        "source_entry_id": "4bbd086e-9389-3477-b55e-61588f9c5543",
                        "source_sense_id": "96a00c10-7ba4-3e36-b39d-81cceb8975f5",
                        "target_lang_word": "irrelevance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrelevance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c60e053-acc6-3ebd-9d6f-5da6772edec1",
                                        "entry_id": "d2e8c137-5366-32f4-a24d-52dea3981f60",
                                        "glosses": [
                                            "Lack of relationship with the topic at hand; lack of importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "770da031-08b0-4646-859f-b4bdc0d9a808",
                                                "sense_id": "0c60e053-acc6-3ebd-9d6f-5da6772edec1",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: […]; […]; or perhaps to muse on the irrelevance of the borders that separate nation states and keep people from understanding their shared environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51d32ef0-977c-40d7-8ed0-e61ca41d7d26",
                        "source_entry_id": "4bbd086e-9389-3477-b55e-61588f9c5543",
                        "source_sense_id": "96a00c10-7ba4-3e36-b39d-81cceb8975f5",
                        "target_lang_word": "irrelevancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrelevancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3bcdd97-513c-3167-970f-8c174ccf5d04",
                                        "entry_id": "31451397-37b8-3403-8ae8-5ecd2df0954a",
                                        "glosses": [
                                            "The quality of being irrelevant or inapplicable; lack of pertinence or connection."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f471d50c-0596-3f36-873f-9a3e1751d265",
                                        "entry_id": "31451397-37b8-3403-8ae8-5ecd2df0954a",
                                        "glosses": [
                                            "A thing that is irrelevant—having no bearing on the subject of discussion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a9e8349-6fa0-43ea-9e70-d938f868f1fe",
                                                "sense_id": "f471d50c-0596-3f36-873f-9a3e1751d265",
                                                "text": "To believe that such talk really ever came out of people's mouths would be to believe that there was a time when time was of no value to a person who thought he had something to say; when it was the custom to spread a two-minute remark out to ten; when a man's mouth was a rolling-mill, and busied itself all day long in turning four-foot pigs of thought into thirty-foot bars of conversational railroad iron by attenuation; when subjects were seldom faithfully stuck to, but the talk wandered all around and arrived nowhere; when conversations consisted mainly of irrelevancies, with here and there a relevancy, a relevancy with an embarrassed look, as not being able to explain how it got there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28f11db2-7a60-4886-9c74-93c770d83ba1",
                        "source_entry_id": "4bbd086e-9389-3477-b55e-61588f9c5543",
                        "source_sense_id": "96a00c10-7ba4-3e36-b39d-81cceb8975f5",
                        "target_lang_word": "non-pertinence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b0a232ce-f5f7-49df-9f4d-dc3c73e88061",
                        "source_entry_id": "4bbd086e-9389-3477-b55e-61588f9c5543",
                        "source_sense_id": "96a00c10-7ba4-3e36-b39d-81cceb8975f5",
                        "target_lang_word": "insignifiance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insignifiance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05bf50f6-21f1-3ee3-9419-3ac5c90c045b",
                                        "entry_id": "8f8db805-51ff-3f36-b7af-b6d06d0dbb5f",
                                        "glosses": [
                                            "Qualité de ce qui est insignifiant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffd43f7-2bf6-4c75-b450-01eb4044abe4",
                                                "sense_id": "05bf50f6-21f1-3ee3-9419-3ac5c90c045b",
                                                "text": "D’une absolue insignifiance d’esprit, d’un cœur tendre, bien qu’il semblât indifférent à tout ce qui n’était pas ses vanités locales et les intérêts de son étude, prodigue de conseils, aimant à rendre service, conservateur, bien portant et gai, mon père jouissait, en toute justice, de l’universel respect."
                                            },
                                            {
                                                "example_id": "5c2f8ae5-6159-4e10-aceb-77ea7741f9ad",
                                                "sense_id": "05bf50f6-21f1-3ee3-9419-3ac5c90c045b",
                                                "text": "Parmi ces colosses de l’air et ces hauts personnages, il se sentait écrasé par la certitude de son insignifiance ; la vie était trop vaste pour lui, elle le dépassait de partout."
                                            },
                                            {
                                                "example_id": "ec5b0724-c0c6-4076-9eda-0b152c747a4e",
                                                "sense_id": "05bf50f6-21f1-3ee3-9419-3ac5c90c045b",
                                                "text": "Le jardin est si dépouillé que rien ne cache plus l’insignifiance de ce qui est, ici, concédé à l'agrément : les carcasses des charmilles, les bosquets maigres grelottent sous la pluie éternelle."
                                            },
                                            {
                                                "example_id": "a0a4d199-7ab5-4ce2-8eda-f7e94d767557",
                                                "sense_id": "05bf50f6-21f1-3ee3-9419-3ac5c90c045b",
                                                "text": "Il est des moments, heureusement assez rares dans une vie, où le sort s’amuse à nous faire toucher du doigt l’insignifiance de notre condition. C’en était un."
                                            },
                                            {
                                                "example_id": "04524866-69a3-495a-8fb3-d27c4c19086c",
                                                "sense_id": "05bf50f6-21f1-3ee3-9419-3ac5c90c045b",
                                                "text": "Si cette invitation partait d’une bonne intention, elle fut loin d’être décisive, sinon par son insignifiance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
