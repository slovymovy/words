                                                "example_id": "37f54b39-bbbe-426f-9af7-023f87b627c5",
                                                "sense_id": "1a3e5e21-d603-3b0a-a41a-b598f028edf9",
                                                "text": "Взвалили мы «пустышку» на «галошу» и поставили её на попа, чтобы не каталась."
                                            },
                                            {
                                                "example_id": "d78da73c-b756-4171-a81e-fb82ff267fbd",
                                                "sense_id": "1a3e5e21-d603-3b0a-a41a-b598f028edf9",
                                                "text": "Из анализа таблицы следует, что детали 1–4 не могут ни встать «на попа», ни лечь поперёк."
                                            }
                                        ]
                                    }
