                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29df34e7-1155-4b7d-9ae3-861846443ae7",
                                "sense_id": "b0799d4d-ad50-3884-8795-6f84a7b7f6ec",
                                "text": "„Worden hatte Hunderte von Ermittlungen durchgeführt – Bankraub, Überfälle auf Geldtransporter und Läden in der Innenstadt, Hehler.“"
                            },
                            {
                                "example_id": "67c0b4bb-188d-4677-a825-2219c43bd895",
                                "sense_id": "b0799d4d-ad50-3884-8795-6f84a7b7f6ec",
                                "text": "„›So sieht mein verdammtes Leben aus. Schon als kleiner Junge habe ich zu meiner Mutter gesagt, dass ich Polizist werden wollte. Sie hat sich die Finger wund gearbeitet, damit ich die höhere Schule abschließen und zur Polizei gehen konnte. Und keinen verdammten Geldtransporter fahren muss.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
