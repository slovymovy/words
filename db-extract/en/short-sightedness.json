                        "glosses": [
                            "Myopia: impairment of vision's acuity for distant objects."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2ea25bdb-f9af-3f2d-add7-df7418ed173c",
                        "entry_id": "1fffb571-c069-3c95-b747-969c98f72277",
                        "glosses": [
                            "The propensity of a person to ignore long-term goals in favor of short-term gains."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "526a3139-11c3-4a6c-96d0-c8caaf5d1d95",
                        "source_entry_id": "1fffb571-c069-3c95-b747-969c98f72277",
                        "source_sense_description": "the propensity of a person to ignore long-term goals in favor of short-term gains",
                        "target_lang_word": "Kurzsichtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurzsichtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                        "entry_id": "748ccaef-ebe3-3d9d-b29e-d764050a98ac",
                                        "glosses": [
                                            "häufiger Sehfehler, bei dem nur Objekte in der Nähe scharf gesehen werden können, weiter entfernte Objekte werden verschwommen wahrgenommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17681ed6-b287-440c-9895-e04636b77dce",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "Kurzsichtigkeit lässt sich durch eine Brille leicht ausgleichen."
                                            },
                                            {
                                                "example_id": "9e47feaa-ca50-42e7-bb77-92be78ede5d9",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "„Emma Bertini ließ sich dank ihrer Kurzsichtigkeit durch die wilde Bewegung nicht stören.“"
                                            },
                                            {
                                                "example_id": "257080f3-30da-4dc0-aa41-a9ea104afc5a",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "„Wegen starker Kurzsichtigkeit von der Bundeswehr befreit, hatte er die Hälfte seines Chemiestudiums schon hinter sich und war seinen Studienkollegen weit voraus, eben weil er seine Freizeit kaum anders als in der Universität verbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                        "entry_id": "748ccaef-ebe3-3d9d-b29e-d764050a98ac",
                                        "glosses": [
                                            "Mangel an Weitblick, Unfähigkeit spätere Konsequenzen seines Handelns abschätzen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4b4692-62ec-4da8-aa2a-3417fb08d4a1",
                                                "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                                "text": "Die Beschlüsse der Regierung sind an Kurzsichtigkeit nicht zu überbieten."
                                            },
                                            {
                                                "example_id": "3d38d3e5-453f-4a72-9473-0bb137db4eee",
                                                "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                                "text": "„Dieser Fehler spiegelt nicht nur die Kurzsichtigkeit des Literaturkritikers wider, mit der er sich selbst zum Gespött der französischen Literaturwelt machte, sondern auch, wie mühelos sich das Buch ohne diesen Buchstaben liest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd430d21-aede-40bf-8603-3875950a8e07",
                        "source_entry_id": "1fffb571-c069-3c95-b747-969c98f72277",
                        "source_sense_description": "the propensity of a person to ignore long-term goals in favor of short-term gains",
                        "target_lang_word": "cortoplacismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cortoplacismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d7d560eb-7c3d-32bf-88b6-775bf49de357",
                                        "entry_id": "259983db-7acd-3d80-b238-2cd092bd82a7",
                                        "glosses": [
                                            "Tendencia a priorizar los beneficios en el corto plazo en detrimento de los beneficios en el largo plazo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f746f90e-037f-43a4-bbbf-8c6f428c2801",
                                                "sense_id": "d7d560eb-7c3d-32bf-88b6-775bf49de357",
                                                "text": "En otras palabras, a la casta no le importa el futuro. Que las generaciones venideras se las arreglen como puedan. A medida que la política fue apriendiendo a quemar el futuro de los argentinos para su propio beneficio, gran parte de la sociedad se fue acostumbrando a la misma dinámica. Forzada por el cortoplacismo impuesto desde arriba, no vio otra salida que intercambiar su voto por beneficios cada vez más inmediatos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
