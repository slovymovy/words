                "senses": [
                    {
                        "sense_id": "9a526525-5316-3800-9f72-aeabc7bfb945",
                        "entry_id": "d987a821-2f2b-3c39-ab89-a53633f59b3c",
                        "glosses": [
                            "Piger à nouveau, reprendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2570878-182d-419a-ba36-4d5a98b9f2dc",
                                "sense_id": "9a526525-5316-3800-9f72-aeabc7bfb945",
                                "text": "Tout s’expliquera quand la police aura repigé le mari."
                            },
                            {
                                "example_id": "0495b3f5-3e68-4b31-945a-3119eae7eec9",
                                "sense_id": "9a526525-5316-3800-9f72-aeabc7bfb945",
                                "text": "MIKE TYSON REPIGE POUR « VERY BAD TRIP 3 »."
                            }
                        ]
                    },
                    {
                        "sense_id": "17ef5a10-d3b6-30a6-a42b-add765c66076",
                        "entry_id": "d987a821-2f2b-3c39-ab89-a53633f59b3c",
                        "glosses": [
                            "Rattraper, reprendre."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "70873749-f8e6-436f-af1c-aea22874d40f",
                                "sense_id": "17ef5a10-d3b6-30a6-a42b-add765c66076",
                                "text": "Je te repigerai."
                            },
                            {
                                "example_id": "ba275768-85ca-4e30-b80b-af3d72e63f1a",
                                "sense_id": "17ef5a10-d3b6-30a6-a42b-add765c66076",
                                "text": "Il comprenait à quel point il était utile pour lui de démontrer aux nihilistes, chaque jour plus nombreux et plus hardis, qu’alors même qu’ils parviendraient à s’échapper de la Russie ils seraient parfaitement repigés dans tous les autres pays."
                            }
                        ]
                    }
