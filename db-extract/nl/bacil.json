                        ],
                        "form": "bacilletjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7c7cee1-fa89-3731-9fb9-c162e381e138",
                        "entry_id": "1faee3b8-6bfd-31af-9aef-4a2571e63e0d",
                        "glosses": [
                            "benaming voor soorten uit de klasse Bacilli die de vorm van een staafje of een komma hebben"
                        ],
                        "tags": [
                            "bacteriën"
                        ],
                        "examples": [
                            {
                                "example_id": "f0741dae-35a1-4663-8015-a5f50f8a1104",
                                "sense_id": "e7c7cee1-fa89-3731-9fb9-c162e381e138",
                                "text": "Staphylococcen zijn staafvormige bacillen."
                            },
                            {
                                "example_id": "4fc09fd5-ea4e-4fb0-aefe-4f4ad0075ad5",
                                "sense_id": "e7c7cee1-fa89-3731-9fb9-c162e381e138",
                                "text": "Toen in 1883 bleek dat cholera werd veroorzaakt door een bacil (dat via uitwerpselen van zieken het drinkwater besmette) was de miasma-theorie niet meer houdbaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed0d7593-892d-3657-97a9-75245e4b73ce",
                        "entry_id": "1faee3b8-6bfd-31af-9aef-4a2571e63e0d",
                        "glosses": [
                            "gebruikt als algemene aanduiding voor besmettelijke microbe"
                        ],
                        "tags": [
                            "bij uitbreiding"
                        ],
                        "examples": [
                            {
                                "example_id": "32986063-3359-4adb-a2bd-fb797b88e777",
                                "sense_id": "ed0d7593-892d-3657-97a9-75245e4b73ce",
                                "text": "Daar worden we ziek van elkaars vieze toetsenborden, kunnen we met elke bacil tweehonderd collega’s tegelijk besmetten en is je belabberd voelen een stuk lastiger geworden, omdat iedereen boven op elkaar zit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b832e97-2a43-451c-8782-ef9379ac14ca",
                        "source_entry_id": "1faee3b8-6bfd-31af-9aef-4a2571e63e0d",
                        "source_sense_id": "e7c7cee1-fa89-3731-9fb9-c162e381e138",
                        "source_sense_description": "benaming voor soorten uit de klasse Bacilli",
                        "target_lang_word": "Bazillus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bazillus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca136a10-caee-3745-97ef-4a27eb91ccab",
                                        "entry_id": "41ad17c9-4d05-3fb3-9bbb-11d49b34676b",
                                        "glosses": [
                                            "stäbchenförmiges, grampositives Bakterium aus der Gattung Bacillus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dd16c1d-3353-4f7a-a8e7-0b1bb60586ee",
                                                "sense_id": "ca136a10-caee-3745-97ef-4a27eb91ccab",
                                                "text": "Der erste Bazillus wurde 1835 entdeckt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "769414d6-bbfb-38c0-a587-8597bdac1643",
                                        "entry_id": "41ad17c9-4d05-3fb3-9bbb-11d49b34676b",
                                        "glosses": [
                                            "krankheitserregender Mikroorganismus"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97bd1c5f-f5e0-47d0-a9a0-94851edb76ac",
                                                "sense_id": "769414d6-bbfb-38c0-a587-8597bdac1643",
                                                "text": "Öffentliche Toiletten sind Brutstätten für alle möglichen Bazillen!"
                                            },
                                            {
                                                "example_id": "b01baea9-eb7f-4f9f-aa3a-40614a48deb0",
                                                "sense_id": "769414d6-bbfb-38c0-a587-8597bdac1643",
                                                "text": "„Nur besonders aufdringliche Zeitgenossen zeigen, wie furchtlos sie selbst Bazillen und Viren gegenüberstehen und schütteln trotzdem – oder erst recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b89c6e8d-79af-493f-81cb-a660c8d6dedb",
                        "source_entry_id": "1faee3b8-6bfd-31af-9aef-4a2571e63e0d",
                        "source_sense_id": "e7c7cee1-fa89-3731-9fb9-c162e381e138",
                        "source_sense_description": "benaming voor soorten uit de klasse Bacilli",
                        "target_lang_word": "bacillus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bacillus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Any of various rod-shaped, spore-forming aerobic bacteria in the genus Bacillus, some of which cause disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a02569c-af85-4bd8-9246-6cf42b93dd29",
                                                "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                                "text": "'This again,' said the Bacteriologist, slipping a glass slide under the microscope, 'is a preparation of the celebrated Bacillus of cholera - the cholera germ.'"
                                            },
                                            {
                                                "example_id": "68dd02c2-2e0c-433e-8821-bbc9361e38b1",
                                                "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                                "text": "\"You will conceive a bunch of grapes,\" said he, \"which are covered by some infinitesimal but noxious bacillus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c2b6d5c-13c0-37b9-bab1-14b156ed13bd",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Any bacilliform (rod-shaped) bacterium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0814ad19-bdbc-398b-ad11-847e35841ac3",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Something which spreads like bacterial infection."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd968b0-9b42-4d3a-a30e-aad34322cffb",
                                                "sense_id": "0814ad19-bdbc-398b-ad11-847e35841ac3",
                                                "text": "The “bacillus of boom or depression,” he wrote, travels freely “from country to country.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a89f0ba0-b66e-4f3c-801e-37c2ea3d5ba8",
                        "source_entry_id": "1faee3b8-6bfd-31af-9aef-4a2571e63e0d",
