                                                "sense_id": "0a83672c-9f8a-3ab1-9998-e19ac3121658",
                                                "text": "Gleich wird Ebbe zu einer Wattwanderung aufbrechen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8786659a-8da7-4ef0-bc2d-7facefb69b98",
