                        "entry_id": "a0ed6bc5-9f26-3bd6-adba-dde804087ed6",
                        "glosses": [
                            "A female monster who, along with Typhon, mothered the vast majority of the famous monsters and creatures of Greek mythology."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "440550d2-0b6b-4a45-bc4a-795a0a0ea240",
                                "sense_id": "3ed576b5-ccd6-3080-94b9-9a96d38b4971",
                                "text": "Horrible, hideous, and of hellish race, / Borne of the brooding of Echidna base, / Or other like infernall furies kinde […]."
                            }
                        ]
                    }
                ],
