                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de zenuwen begon hij helemaal te <w>papieren</w> toen hij het nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "Because of his nerves, he started to <w>shake</w> all over when he heard the news.",
                                "ru": "От нервов он начал весь <w>трястись</w>, когда услышал новости.",
                                "pl": "Z nerwów zaczął cały <w>drżeć</w>, gdy usłyszał te wieści.",
                                "de": "Vor Nervosität fing er am ganzen Körper an zu <w>zittern</w>, als er die Nachrichten hörte.",
                                "fr": "À cause de ses nerfs, il s'est mis à <w>trembler</w> de tout son corps en apprenant la nouvelle.",
                                "it": "Per il nervosismo ha iniziato a <w>tremare</w> tutto quando ha sentito la notizia.",
                                "cs": "Kvůli nervům se začal celý <w>třást</w>, když uslyšel tu zprávu.",
                                "tr": "Haberi duyduğunda sinirden her yeri <w>titremeye</w> başladı.",
                                "es": "Debido a los nervios, empezó a <w>temblar</w> por completo cuando escuchó la noticia.",
                                "zh": "听到这个消息时，他紧张得全身<w>发抖</w>。"
                            }
                        },
                        {
                            "text": "Ze stond te <w>papieren</w> op haar benen van de schrik.",
                            "target_lang_translations": {
                                "en": "She stood <w>trembling</w> on her legs from the shock.",
                                "ru": "Она стояла и <w>тряслась</w> от испуга.",
                                "pl": "Stała i <w>trzęsła się</w> na nogach ze strachu.",
                                "de": "Sie stand vor Schreck <w>zitternd</w> auf ihren Beinen.",
                                "fr": "Elle <w>tremblait</w> sur ses jambes sous le coup de la peur.",
                                "it": "Stava lì a <w>tremare</w> sulle gambe per lo spavento.",
                                "cs": "Hrůzou se jí <w>třásly</w> nohy.",
                                "tr": "Korkudan bacakları <w>titreyerek</w> ayakta duruyordu.",
                                "es": "Estaba de pie <w>temblando</w> de las piernas por el susto.",
