                    {
                        "translation_id": "71842ada-f056-4c25-b105-3da5ef68ce3c",
                        "source_entry_id": "3324ecb9-fdd5-3ee6-9a55-f8feec021f73",
                        "source_sense_id": "5471e75e-171b-3174-9925-a7d69471252c",
                        "target_lang_word": "Qinghai",
