{
    "word_family": [
        "spectral",
        "spectrally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "452a2411-2eaa-341c-8751-8c1cdb4b5261",
                    "sense_definition": "A ghostly apparition or phantom",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house was said to be visited by a <w>specter</w> every night.",
                            "target_lang_translations": {
                                "pl": "Mówiono, że stary dom każdej nocy odwiedza <w>widmo</w>."
                            }
                        },
                        {
                            "text": "The villagers were terrified by the <w>specter</w> that appeared in the woods.",
                            "target_lang_translations": {
                                "pl": "Mieszkańcy wioski byli przerażeni <w>zjawą</w>, która pojawiła się w lesie."
                            }
                        }
                    ],
                    "synonyms": [
                        "wraith",
                        "spook"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niematerialna postać, duch lub zjawa."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "widmo",
                                "target_lang_sense_clarification": "duch lub niematerialna postać"
                            },
                            {
                                "target_lang_word": "zjawa",
                                "target_lang_sense_clarification": "duch osoby zmarłej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8328cda2-b3de-3ad7-8897-089529f7682f",
                    "sense_definition": "A threatening or unpleasant future possibility",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>specter</w> of economic collapse worried the entire nation.",
                            "target_lang_translations": {
                                "pl": "<w>Widmo</w> załamania gospodarczego niepokoiło cały naród."
                            }
                        },
                        {
                            "text": "They feared the <w>specter</w> of war returning to their peaceful borders.",
                            "target_lang_translations": {
                                "pl": "Obawiali się <w>widma</w> wojny powracającej do ich spokojnych granic."
                            }
                        }
                    ],
                    "common_phrases": [
                        "specter of war",
                        "specter of poverty"
                    ],
                    "target_lang_definitions": {
                        "pl": "Perspektywa czegoś złego lub groźnego, co może nastąpić w przyszłości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "widmo",
                                "target_lang_sense_clarification": "zagrożenie lub niebezpieczna perspektywa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15db9d25-6492-36df-8238-ac4e126bb92b",
                    "sense_definition": "A type of dragonfly belonging to the genus Boyeria",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rare <w>specter</w> dragonfly was spotted near the quiet pond.",
                            "target_lang_translations": {
                                "pl": "Rzadka <w>ważka</w> z rodzaju Boyeria została zauważona w pobliżu cichego stawu."
                            }
                        },
                        {
                            "text": "Biologists studied the flight patterns of the <w>specter</w> in the marsh.",
                            "target_lang_translations": {
                                "pl": "Biolodzy badali wzorce lotu tej <w>ważki</w> na bagnach."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rodzaj ważki z rodzaju Boyeria."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ważka",
                                "target_lang_sense_clarification": "ważka z rodzaju Boyeria; brak ustalonej nazwy polskiej"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}