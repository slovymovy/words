                                "target_senses": [
                                    {
                                        "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                        "entry_id": "8bcca08e-4707-3e5a-9468-8cd97899320a",
                                        "glosses": [
                                            "Celui qui est chargé d’enseigner aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e24aa6-849d-407e-b2ab-5eb7273ff1d0",
                                                "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                                "text": "Après avoir occupé un poste d’enseignant pendant huit ans, il postula pour devenir directeur."
                                            },
                                            {
                                                "example_id": "14fc85a5-67e5-4970-900a-0a494b4aadc8",
                                                "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                                "text": "Par malheur, l’enseignant remplacé a recours à de l’argent scolaire pour récompenser ses élèves, alors que vous avez de la peine à respecter votre budget."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enseignant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4e8c29-3475-31af-a4d3-f396203dc6bb",
                                        "entry_id": "8e4e0ad2-3e1f-3217-97c4-bcda1c9d3424",
                                        "glosses": [
                                            "Qui contient un enseignement, une leçon."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7be7edd8-dd5f-4454-b53f-2d398948f6a5",
                                                "sense_id": "2c4e8c29-3475-31af-a4d3-f396203dc6bb",
                                                "text": "Après quoi, je me suis longuement penché sur le Bottin Mondain. Une lecture des plus enseignantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0e9cd5-c83f-3a19-9fe1-8237b44b965e",
