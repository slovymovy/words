                                        "entry_id": "970f00c1-0c39-336f-a20e-d5cdb92b6145",
                                        "glosses": [
                                            "übertrieben vornehm und dabei ohne Inhalt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd1f4ff-e848-489e-ba7d-be6b34c77868",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "Dieses hochtrabende Gerede hätte er sich sparen können."
                                            },
                                            {
                                                "example_id": "3b48daf7-c3f2-4eb2-b624-ac14321b0003",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "„Unter solchen Umständen können auch die hochtrabendsten Redensarten von Höhe und Tiefe der Kunst, von den großen Aufgaben der Gegenwart und den strengsten Anforderungen an ihre Leistungen kein sonderliches Vertrauen erwecken.“"
                                            },
                                            {
                                                "example_id": "edfdfec4-a862-4529-8d1a-493a3c41d7cf",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "„Die Affichen sind mit hochtrabenden Namen unterfertigt, »Hochschule für geheime Wissenschaften«, »Gelehrte Gesellschaft für okkultes Wissen« und so weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
