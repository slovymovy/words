                    },
                    {
                        "translation_id": "1e44362b-4d98-419b-b12a-4b04722e0c5f",
                        "source_entry_id": "534ee340-7143-39f4-812e-5409495cdd92",
                        "source_sense_id": "9b226cce-0df9-37cf-b31f-a38467216880",
