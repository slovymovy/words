                        "form_id": "4e24604d-6400-4f40-8ef0-b06b15f3f631",
                        "entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
                        "tags": [],
                        "form": "bouzeux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d7ef671-bd82-3490-9c9d-fb87df1c2b6e",
                        "entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
                        "glosses": [
                            "Paysan, cul-terreux."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6d832ab2-aac1-4e51-8167-f251b4b360d5",
                                "sense_id": "9d7ef671-bd82-3490-9c9d-fb87df1c2b6e",
                                "text": "Au départ, l’homme n’avait pas grand-chose pour lui : un physique passe-partout, un accent de bouseux galiléen, et surtout il venait de Nazareth, le trou du cul du monde."
                            },
                            {
                                "example_id": "4018b848-0920-4a0f-9d84-5e557209c3ed",
                                "sense_id": "9d7ef671-bd82-3490-9c9d-fb87df1c2b6e",
                                "text": "Un dimanche matin, j'étais à l'affût de quelque chose à chaparder quand un redneck s'est approché de moi. Comme tous les bouseux, il parlait fort, roulait des mécaniques et s'exprimait avec un accent du Sud à couper au couteau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62bc509b-1666-4127-a00e-c74c56166372",
                        "source_entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
                        "source_sense_id": "9d7ef671-bd82-3490-9c9d-fb87df1c2b6e",
                        "target_lang_word": "Bauerntrampel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauerntrampel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75ac3dc8-5ae9-333b-a52a-c222b88c56c1",
                                        "entry_id": "a928bfbb-de01-3de7-917e-e505e833b868",
                                        "glosses": [
                                            "dümmliche, hinterwäldlerische Person"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74217413-cce5-4358-8365-7b93c60ff69b",
                                                "sense_id": "75ac3dc8-5ae9-333b-a52a-c222b88c56c1",
                                                "text": "„Diese Hinterwäldler und Bauerntrampel mit ihren stupiden Arme-Sünder-Mienen, sie täuschten Respekt vor, und sie heuchelten Bewunderung für diese erhabenen Regierungsgebäude und die erhabenen Potentaten, die von dort aus ihr Leben lenkten.“"
                                            },
                                            {
                                                "example_id": "a4cb084b-89be-4d95-8f79-bd1dafe2a037",
                                                "sense_id": "75ac3dc8-5ae9-333b-a52a-c222b88c56c1",
                                                "text": "„Er solle endlich erwachsen werden, hatte Ruth gesagt, wenn er jemals etwas anderes als ein dummer Bauerntrampel sein wollte.“"
                                            },
                                            {
                                                "example_id": "5386e19f-2e78-4330-bb95-33e71df22f57",
                                                "sense_id": "75ac3dc8-5ae9-333b-a52a-c222b88c56c1",
                                                "text": "„Der Mann taxierte Randall und Lisa, als wären sie zwei Bauerntrampel, die zusammen nicht mal zwei Cent hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e59425b-9ff9-487b-a227-333e626defcd",
                        "source_entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
                        "source_sense_id": "9d7ef671-bd82-3490-9c9d-fb87df1c2b6e",
                        "target_lang_word": "Bauerntölpel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauerntölpel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa856137-4f41-3e22-9bc1-5acc30c1d09c",
                                        "entry_id": "5df13952-2e2c-3049-aa74-a662b845f229",
                                        "glosses": [
                                            "jemand, der als einfältig und begriffsstutzig erachtet wird (und so dem Stereotyp der als ungebildet geltenden Landbevölkerung entspricht)"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd7a0c2-faa9-487b-8596-0b27432e4858",
                                                "sense_id": "aa856137-4f41-3e22-9bc1-5acc30c1d09c",
                                                "text": "„Handball galt als Sport für Bauerntölpel oder als brutale Freizeitbeschäftigung für Grobmotoriker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae244899-ce88-4663-932d-eca309bc76bc",
                        "source_entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
                        "source_sense_id": "9d7ef671-bd82-3490-9c9d-fb87df1c2b6e",
                        "target_lang_word": "yokel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yokel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                        "entry_id": "6a64a1a4-8b6d-3f2d-8ce3-c65fef9652d1",
                                        "glosses": [
                                            "A person from or living in the countryside, viewed as being unsophisticated or naive."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "241ee8e0-5d79-48c2-928e-2588de644e27",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "They love the scenery near their summer home, but have no desire to mix with the local yokels."
                                            },
                                            {
                                                "example_id": "5f059c18-1f33-4976-862b-494f98db9310",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "“[…] my opinion at once is […] that this [robbery] wasn’t done by a yokel―eh, Duff?”\n“Certainly not,” replied Duff.\n“And, translating the word yokel, for the benefit of the ladies, I apprehend your meaning to be that this attempt was not made by a countryman?” said Mr. Losberne with a smile."
                                            },
                                            {
                                                "example_id": "93d3e60a-dc1d-4fb9-8f90-f0ab634323c0",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "[…] and yokels looking up at the tinselled dancers and poor old rouged tumblers, while the light-fingered folk are operating upon their pockets behind."
                                            },
                                            {
                                                "example_id": "3aa769e0-87c8-4671-ba41-f01a0c459378",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "He eyed the story-teller with unspeakable wonder. His mouth was agape in yokel fashion."
                                            },
                                            {
                                                "example_id": "64f3c5cf-b2a3-4105-a29c-5855f9bce9ec",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "\"God damn and blast all you hamfisted yokels!\" he was saying. \"And you, sir, down there. Take that grin off your face and be more careful, or I'll have you clapped under hatches to sail with us today. Easy, there, easy! Christ, rum at seven guineas an anker isn't meant to be dropped like pig iron!\""
                                            },
                                            {
                                                "example_id": "48e445bf-8265-4fa9-98f6-6671a8e8b99b",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "I went to New York and bought myself a secondhand stretch limousine twenty-eight feet long, calculated to reduce the most blasé country-club sophisticates to bug-eyed yokels."
                                            },
                                            {
                                                "example_id": "62179335-a3ef-4668-99ab-366fb63e72ea",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "You may think that because you live in Brahmpur you have seen the world―or more of the world than we poor yokels see. But some of us yokels have also seen the world―and not just the world of Brahmpur, but of Bombay. […]"
                                            },
                                            {
                                                "example_id": "2bd7b1e2-0b32-412a-bed8-03006433c17a",
                                                "sense_id": "bd05ab03-c4f4-3337-971c-219e37bad38b",
                                                "text": "Some folk'll never eat a skunk, but then again some folk'll, like Cletus, the slack-jawed yokel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aa19c55-a4c1-410b-9df1-5ca80b4bb6a7",
                        "source_entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
