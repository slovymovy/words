                ],
                "senses": [
                    {
                        "sense_id": "444933cf-33c6-3566-b5c5-d9c4b7a21395",
                        "entry_id": "82ca5946-5841-35ac-ad5b-4d42d0f27fe7",
                        "glosses": [
                            "besonders hohe Temperaturen, die entstehen, wenn die Sonne im Sommer ihren höchsten Stand im Jahreslauf hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c6f2c5-67c7-4598-ac19-d9e9dc3a0469",
                                "sense_id": "444933cf-33c6-3566-b5c5-d9c4b7a21395",
                                "text": "„Am meisten litten die Europäer indes unter der indischen Sommerhitze sowie unter Krankheiten wie der Cholera.“"
                            },
                            {
                                "example_id": "e6fe7a56-4286-4b55-b263-a216ce81292f",
                                "sense_id": "444933cf-33c6-3566-b5c5-d9c4b7a21395",
                                "text": "„In der Sommerhitze erfahre ich am FKK-Strand am Wannsee sehr viel darüber, wie die Deutschen zu ihrem Körper, zur Erotik, zur Freiheit stehen.“"
                            },
                            {
                                "example_id": "473cf3fa-0582-4e1e-9447-980be95fd833",
                                "sense_id": "444933cf-33c6-3566-b5c5-d9c4b7a21395",
                                "text": "„Aber der sonnige September lässt die aus Holz erbaute, von der Sommerhitze ausgedörrte Stadt leicht Feuer fangen.“"
                            },
                            {
                                "example_id": "d001656c-f679-4b5f-8221-b72c328f8df8",
                                "sense_id": "444933cf-33c6-3566-b5c5-d9c4b7a21395",
                                "text": "„Während der schlimmsten Sommerhitze wichen viele Bewohner von Weequahic nach Bradley Beach aus, einem Außenposten des Viertels an der Küste von New Jersey.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
