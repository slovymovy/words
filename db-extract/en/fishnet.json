{
    "word": "fishnet",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                "word": "fishnet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5017deae-5647-46f7-baeb-9882584abf96",
                        "entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                        "tags": [
                            "plural"
                        ],
                        "form": "fishnets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86302079-917e-35c1-977f-e9cbf4701781",
                        "entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                        "glosses": [
                            "A net used to catch fish."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e405610-0a8d-4992-97c6-6f705e34bb9a",
                                "sense_id": "86302079-917e-35c1-977f-e9cbf4701781",
                                "text": "The fishnets were hung over bushes to dry."
                            }
                        ]
                    },
                    {
                        "sense_id": "4629a86d-c117-3277-8eb0-b11e4d02170a",
                        "entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                        "glosses": [
                            "A fabric mesh with an open diamond-shaped structure."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d4f37ebc-fc23-4954-ad5e-ecbd4d7a92ba",
                                "sense_id": "4629a86d-c117-3277-8eb0-b11e4d02170a",
                                "text": "All the little minnows which were not caught for bait this spring may well give thanks to the women of the U. S. who have adopted fishnet turbans, scarfs, belts and skirts as items in their sports outfits."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e0e0e8d-b3d0-364c-8d63-4de9b9f81ed9",
                        "entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                        "glosses": [
                            "Stockings made of fishnet fabric."
                        ],
                        "tags": [
                            "countable",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "2ce32c6a-0ab1-4c4e-8499-551e5d79923d",
                                "sense_id": "6e0e0e8d-b3d0-364c-8d63-4de9b9f81ed9",
                                "text": "Fishnets are for catching men."
                            },
                            {
                                "example_id": "015b18ef-8a0f-4f6e-8a3e-e536460338c2",
                                "sense_id": "6e0e0e8d-b3d0-364c-8d63-4de9b9f81ed9",
                                "text": "I don't see people walking around in the fishnets, heels and make-up, but I do see alot^([sic]) of guys with the short bleached blonde hair, the baggy sweats, and other Eminemesque fashions..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f301e096-e172-4186-b6c5-55ad625fc080",
                        "source_entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                        "source_sense_description": "mesh fabric",
                        "target_lang_word": "résille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a95d3492-1619-3124-b13f-63c0f1ccc995",
                                        "entry_id": "1b528eef-c3c4-3ae4-bbd9-9865b1b3dd25",
                                        "glosses": [
                                            "Sorte de filet, de réseau, qui enveloppe les cheveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeee613a-7523-48ba-9d2a-f62d1cb1a7b6",
                                                "sense_id": "a95d3492-1619-3124-b13f-63c0f1ccc995",
                                                "text": "Une épaisse chevelure châtain, dont les boucles étaient retenues par une légère résille d’argent, ondoyait sur ses épaules."
                                            },
                                            {
                                                "example_id": "e62775bb-a738-4716-adf2-078af09abafb",
                                                "sense_id": "a95d3492-1619-3124-b13f-63c0f1ccc995",
                                                "text": "En Espagne, les femmes portent la résille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b28c90-118e-35ea-9b1b-cd23194e5583",
                                        "entry_id": "1b528eef-c3c4-3ae4-bbd9-9865b1b3dd25",
                                        "glosses": [
                                            "Filet, réseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d1f11d1-2b99-4dc3-b4c6-28c8d1d65b84",
                                                "sense_id": "14b28c90-118e-35ea-9b1b-cd23194e5583",
                                                "text": "La fine résille de traboules s’étend sous les maisons, compliquée comme un système d’égouts et à peu de chose près aussi sale et puante."
                                            },
                                            {
                                                "example_id": "c74dcbea-cc88-4401-827e-fb5ea493ab2e",
                                                "sense_id": "14b28c90-118e-35ea-9b1b-cd23194e5583",
                                                "text": "Deux cents ans dʼabandon avaient peint ses façades de cette couleur blonde que mûrissait le soleil. On savait, par les grands marronniers noirs qui le masquaient de leur résille, quʼil sʼagissait dʼune maison à secrets."
                                            },
                                            {
                                                "example_id": "855e4ad1-0aba-4102-9d14-198f6dd4b7fb",
                                                "sense_id": "14b28c90-118e-35ea-9b1b-cd23194e5583",
                                                "text": "Au-dessous de lui, s’étendait une vallée comblée par des cheminées et des toits fumants qui couvraient d’une résille bleuâtre ce sommet de ville."
                                            },
                                            {
                                                "example_id": "e5a1dcc5-304f-4020-b067-22ac9c6d8191",
                                                "sense_id": "14b28c90-118e-35ea-9b1b-cd23194e5583",
                                                "text": "C’était l’automne, par où s’accomplissaient cinq mois de sécheresse. Et bien que le matin fût tout jeune encore, la poussière des roues, des pieds, des sabots, des pattes sans nombre, flottait déjà en trames fines, voiles mobiles et légers, tourbillons ténus où le soleil jouait comme il le fait ailleurs, à son réveil, avec la résille des brumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f4bc583-5dcd-3c7b-8bbc-8a25f19a99e0",
                                        "entry_id": "1b528eef-c3c4-3ae4-bbd9-9865b1b3dd25",
                                        "glosses": [
                                            "Réseau constitué des plombs d’un vitrail."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a21e1d-c6f4-44b1-a27c-ddd3ebcb38e6",
                                                "sense_id": "5f4bc583-5dcd-3c7b-8bbc-8a25f19a99e0",
                                                "text": "Les vitraux poussiéreux qui grelottent dans leur résille de plomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90ecf50-3823-399e-a7da-41a2157ed531",
                                        "entry_id": "1b528eef-c3c4-3ae4-bbd9-9865b1b3dd25",
                                        "glosses": [
                                            "Parures de perles tubulaires funéraires."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b9ed0a-7b35-4966-b5c6-26bb2854ef24",
                                                "sense_id": "c90ecf50-3823-399e-a7da-41a2157ed531",
                                                "text": "Certaines résilles, apparues entre les VIIᵉ et Vᵉ siècles a.C., renforcent la signification en adjoignant à hauteur de l’abdomen les figures des quatre \"Fils d’Horus\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9bd792f-8ad3-334f-8905-40d6ed82b508",
                                        "entry_id": "1b528eef-c3c4-3ae4-bbd9-9865b1b3dd25",
                                        "glosses": [
                                            "Ensemble de l’armature en plomb servant à maintenir ensemble les verres d’un vitrail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6292d71a-c821-4af3-9eb5-b7987077e3fc",
                                                "sense_id": "a9bd792f-8ad3-334f-8905-40d6ed82b508",
                                                "text": "Lors d’une restauration des vitraux de la cathédrale de Sens en 1942, on a conservé les plombs anciens en «dépiquant» les verres et on s’est aperçu que cette résille toute ténue constituait par elle-même une œuvre d'art de grande valeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
