                            {
                                "example_id": "ee1ab7de-8655-45a9-9571-00b90c6a0720",
                                "sense_id": "a55648ba-e5f9-3497-87b1-78f93ad0e515",
                                "text": "„Ein Vorzug von DSM ist die Standardisierung der einzelnen Merkmale, ein Vorteil von ICD ist die internationale Ausrichtung.“"
