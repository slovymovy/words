                "senses": [
                    {
                        "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                        "entry_id": "d1f130ca-d2b9-3f29-be97-2f95443a31a9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b8ce9f-45bf-43e5-b042-e5611a1f9791",
                                "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                                "text": "Frau Heimle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "279d772e-33ed-4014-bca7-4608309b31fe",
                                "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                                "text": "Herr Heimle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "eb1dc2e0-4643-4a44-a267-c2310cf1a0c8",
                                "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                                "text": "Die Heimles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "98168590-0d99-441f-b017-59cbcbad85c6",
                                "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                                "text": "Der Heimle trägt nie die Schals, die die Heimle ihm strickt."
                            },
                            {
                                "example_id": "fd46d6bf-2575-48eb-a8c8-777bf43950e1",
                                "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heimle kommt, geht der Herr Heimle.“"
                            },
                            {
                                "example_id": "d8f5b414-c672-4c69-8b92-79f74a9c49e3",
                                "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                                "text": "Heimle kommt und geht."
                            },
                            {
                                "example_id": "62a48d1c-f712-44c5-9fb8-0b8bdc532100",
                                "sense_id": "1005ebda-80ec-3971-b878-60d1baeafd62",
                                "text": "Heimles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
