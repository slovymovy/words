                        "glosses": [
                            "Donner un caractère mystique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78407f14-1089-4ae0-8b94-493a4ee6cc26",
                                "sense_id": "635e587c-847f-3128-a0c6-4ef759f5f9c2",
                                "text": "Et chacune de ces nombreuses catégories de haute vertu fournit au moine de l'Ordre de Fontevrault matière à subtiliser, à analyser, à paraphraser, à mysticiser;"
                            }
                        ]
                    },
                    {
                        "sense_id": "c0176bfc-6762-3104-b1f1-26bc71bdcf8e",
                        "entry_id": "5a6f667e-a71a-3f12-a57c-dc5a1e5f5c33",
                        "glosses": [
                            "Prendre un caractère mystique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "9a673772-a0a5-4139-82d3-7847cad6df27",
                                "sense_id": "c0176bfc-6762-3104-b1f1-26bc71bdcf8e",
                                "text": "Plus l'identité se ferme, plus elle devient intéressante, se mysticise, et plus elle attire."
                            }
                        ]
                    }
