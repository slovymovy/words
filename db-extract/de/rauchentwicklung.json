                        "examples": [
                            {
                                "example_id": "f5241aa2-2771-452f-89f2-e41455d5b430",
                                "sense_id": "6375b3e2-b37b-3f70-b71f-e47057dc2777",
                                "text": "Wenn man eine Rauchentwicklung feststellt, sollte man nicht nach der Ursache forschen, sondern die Feuerwehr alarmieren."
                            },
                            {
                                "example_id": "72497b65-d209-4c5f-bdcd-a8a765257385",
                                "sense_id": "6375b3e2-b37b-3f70-b71f-e47057dc2777",
                                "text": "„Der Ingenieur beobachtete aufmerksam die Rauchentwicklung und horchte nach unterirdischen Geräuschen.“"
                            },
                            {
                                "example_id": "86c1ddc8-c57d-476d-b1ac-cd0197b0c45a",
                                "sense_id": "6375b3e2-b37b-3f70-b71f-e47057dc2777",
                                "text": "„Wegen Rauchentwicklung ist ein Flugzeug auf dem Weg von Stockholm nach Amsterdam in Hamburg gelandet.“"
                            }
                        ],
