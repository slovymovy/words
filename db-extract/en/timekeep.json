                "senses": [
                    {
                        "sense_id": "d798cd9e-9a2b-3347-9f72-be842ba3e76a",
                        "entry_id": "ba1e2aa0-be91-386f-a70d-fffd75651082",
                        "glosses": [
                            "To keep track of and/or enforce any restrictions on the time; keep time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f9cb923-d1fc-4697-9d66-25960b276b1a",
                                "sense_id": "d798cd9e-9a2b-3347-9f72-be842ba3e76a",
                                "text": "Thus, the difficulty retarded persons experience with focusing and/or maintaining their attention toward a relevant stimulus dimension (Fisher & Zeaman, 1973) may well hinder their ability to timekeep and predict temporal intervals."
                            },
                            {
                                "example_id": "562f0193-a2ac-46e4-a7c8-8ef8b181685d",
                                "sense_id": "d798cd9e-9a2b-3347-9f72-be842ba3e76a",
                                "text": "This exercise takes about forty-five minutes. Arrange for someone to timekeep."
                            },
                            {
                                "example_id": "f42cb2e0-99e8-4c7b-a73b-8af146ac700f",
                                "sense_id": "d798cd9e-9a2b-3347-9f72-be842ba3e76a",
                                "text": "Timekeeping is very important, so it is advisable to appoint a responsible and reliable person whose only job is to timekeep."
                            },
                            {
                                "example_id": "b8c64d01-dd5b-4098-80c6-47dc3364fb1e",
                                "sense_id": "d798cd9e-9a2b-3347-9f72-be842ba3e76a",
                                "text": "I broke my watch on the first day and so was obliged to timekeep according to the sun;"
                            }
                        ]
                    }
                ],
