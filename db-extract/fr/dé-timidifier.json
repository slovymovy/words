                ],
                "senses": [
                    {
                        "sense_id": "354d253f-3f03-327d-85d3-c42d4590442c",
                        "entry_id": "0fd3035b-a3af-33f5-8a48-99eb8bf0bdaf",
                        "glosses": [
                            "Faire cesser d’être timide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "359e10ea-b9a7-4375-9b9b-e596b3e4def5",
                                "sense_id": "354d253f-3f03-327d-85d3-c42d4590442c",
                                "text": "Un spectacle très divertissant, le groupe réussit à nous emporter avec des airs d'autrefois et parviens à dé-timidifier le public dans une très bonne ambiance !"
                            },
                            {
                                "example_id": "8de799d3-9288-454e-8b7c-3466a3219ad6",
                                "sense_id": "354d253f-3f03-327d-85d3-c42d4590442c",
                                "text": "On va donc entreprendre de te dé-timidifier (*aime les néologismes*)..."
                            },
                            {
                                "example_id": "c63f28f3-fe8c-4034-be29-6f6e5e59c132",
                                "sense_id": "354d253f-3f03-327d-85d3-c42d4590442c",
                                "text": "tu as quel âge ? souvent le fait de bosser, être intégrée à une équipe, participer à des réunions, etc. ça aide à se \"dé-timidifier\"."
                            }
                        ]
                    }
                ],
