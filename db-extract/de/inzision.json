                "senses": [
                    {
                        "sense_id": "574f8263-328b-39dc-9e91-4d1a6b3e5fbc",
                        "entry_id": "a644d21f-1b51-39f3-8e2b-54a64e4edb3a",
                        "glosses": [
                            "das Durchtrennen von Haut und Weichgeweben bei operativen Eingriffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4abb2dea-af8e-408b-a172-75a0f8c316fe",
                                "sense_id": "574f8263-328b-39dc-9e91-4d1a6b3e5fbc",
                                "text": "„Dr. Kellner machte die Inzision mit der nachtwandlerischen Sicherheit eines Billardmeisters.“"
                            },
                            {
                                "example_id": "6aa9c5d2-77b1-4a60-946c-fd405a9dab12",
                                "sense_id": "574f8263-328b-39dc-9e91-4d1a6b3e5fbc",
                                "text": "Bei ihrem Kaiserschnitt wurde der Bauchraum durch die Inzision nach Pfannenstiel geöffnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "92f55b94-495b-38b3-aaae-7f8275493576",
                        "entry_id": "a644d21f-1b51-39f3-8e2b-54a64e4edb3a",
                        "glosses": [
                            "Einschnitt der Vorhaut des Penis"
                        ],
                        "tags": [
                            "Völkerkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "d85f5e73-c4fb-48a4-8968-c45191888199",
                                "sense_id": "92f55b94-495b-38b3-aaae-7f8275493576",
                                "text": "„Bei den Sakai im östlichen Sumatra ist der Beschneidungstag ( Inzision ) der größte Festtag.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c8f02372-b91b-334a-8250-07ef135d53ec",
                        "entry_id": "a644d21f-1b51-39f3-8e2b-54a64e4edb3a",
                        "glosses": [
                            "Einschnitt in den Versfuß oder den Takt, der durch eine Wortgrenze markiert ist"
                        ],
                        "tags": [
                            "Verslehre",
                            "besonders bei Pentametern"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "aeceb1f2-8cdd-33d3-9bb4-cbf2df4461af",
                        "entry_id": "a644d21f-1b51-39f3-8e2b-54a64e4edb3a",
                        "glosses": [
                            "Einkerbung in der Gehäusewand eines fossilen Schneckenhauses"
                        ],
                        "tags": [],
