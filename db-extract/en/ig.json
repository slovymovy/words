                    {
                        "sense_id": "e5195499-fd08-3863-abd3-7660e6e0efdb",
                        "entry_id": "de69888d-a665-34ea-82c6-842843e7fd09",
                        "glosses": [
                            "Abbreviation of Instagram."
                        ],
                        "tags": [
