                "senses": [
                    {
                        "sense_id": "4f2dc063-db62-3e1a-8953-c9eb94adbcc5",
                        "entry_id": "1f208b6d-2bd7-3a82-a149-e4bd73073289",
                        "glosses": [
                            "A courtyard behind a housing block or tenement building."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "17829dcb-5bf6-493d-991b-b22cdbc659c6",
                                "sense_id": "4f2dc063-db62-3e1a-8953-c9eb94adbcc5",
                                "text": "Some backcourts had wee outside buildings. They had caved-in roofs and tile chimneys broke off and all smashed windows."
                            },
                            {
                                "example_id": "1102b5de-01e4-47da-847e-1d8cc4810ac6",
                                "sense_id": "4f2dc063-db62-3e1a-8953-c9eb94adbcc5",
                                "text": "Each unique backcourt was an adventure playground with walls to be climbed, chasms to be leaped and dustbins to be raked through and pillaged."
                            },
                            {
                                "example_id": "06f87c56-7e5f-4ff7-8253-5890e3d4e7e0",
                                "sense_id": "4f2dc063-db62-3e1a-8953-c9eb94adbcc5",
                                "text": "'The locus is Crawford Street?' 'One of the backcourts sir, as far as I understand.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "b01df813-f902-3e9b-ba67-68cd313a2ed1",
                        "entry_id": "1f208b6d-2bd7-3a82-a149-e4bd73073289",
                        "glosses": [
                            "A team's defensive half of the court; the part of the court where the other team's basket is located, or the guards playing in that area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e80c2f41-a0c7-4ea6-88a1-b82c2d9595f8",
                                "sense_id": "b01df813-f902-3e9b-ba67-68cd313a2ed1",
                                "text": "So the Knicks, who began the season with a depleted frontcourt, have muddled through the last six weeks with a depleted backcourt as well."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
