                "senses": [
                    {
                        "sense_id": "469f8744-b07f-3ef5-9267-5245e909a141",
                        "entry_id": "ac592f6c-e52b-3d1b-b14e-596ce8aa3382",
                        "glosses": [
                            "устар. приспособленный для плавания по воде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49aac46-14ba-40b1-a4cd-6e36fb5ee4d7",
                                "sense_id": "469f8744-b07f-3ef5-9267-5245e909a141",
                                "text": "Когда же недостало денег, то наложили оброк на продажу вина, взяли в казну продажу соли и железа, отлили серебряную монету, ввели в употребление кожаные кредитные билеты; даже наложили пошлину на телеги, водоходные суда и весь домашний скот."
                            }
                        ]
                    },
                    {
                        "sense_id": "ada79858-34aa-3207-a06d-c547cace5372",
                        "entry_id": "ac592f6c-e52b-3d1b-b14e-596ce8aa3382",
                        "glosses": [
                            "устар. относящийся к водоходству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e763127e-e358-4625-865b-a4bb2853f8c5",
                                "sense_id": "ada79858-34aa-3207-a06d-c547cace5372",
                                "text": "Водоходное училище состоитъ изъ четырёхъ классовъ."
                            }
                        ]
                    }
