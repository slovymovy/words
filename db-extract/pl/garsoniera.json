                "translations": [
                    {
                        "translation_id": "c6ca2161-5cf8-4d23-8733-e7f435869865",
                        "source_entry_id": "beb23d33-8ef8-3b2e-b303-2bcf6325882c",
                        "source_sense_id": "6987aa4a-f8f9-31ba-a829-f556d0ae1312",
                        "target_lang_word": "garsoniéra",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "685a64bb-3a7d-4013-8ffb-3e42d9ee2c32",
                        "source_entry_id": "beb23d33-8ef8-3b2e-b303-2bcf6325882c",
                        "source_sense_id": "6987aa4a-f8f9-31ba-a829-f556d0ae1312",
                        "target_lang_word": "garçonnière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garçonnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "beaa7daf-87ce-324e-9672-ba809f1538a6",
                                        "entry_id": "2a3e0c7d-f046-3bf6-9965-adb476464ed2",
                                        "glosses": [
                                            "Petit appartement pour célibataire masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecee17f2-f17e-4e86-89a5-49e63721dbb8",
                                                "sense_id": "beaa7daf-87ce-324e-9672-ba809f1538a6",
                                                "text": "Je retournais dans ma garçonnière qui infestait le tabac à cause des mégots de mon grand escogriffe de colocataire."
                                            },
                                            {
                                                "example_id": "de9539ca-17cb-4f68-a680-638336189e46",
                                                "sense_id": "beaa7daf-87ce-324e-9672-ba809f1538a6",
                                                "text": "Elle va pouvoir pénétrer dans la tanière du loup. La garçonnière, comme il dit. N'est-il pas célibataire depuis plus de dix ans?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d874272-6c7f-3585-9604-10756c4ffc0f",
                                        "entry_id": "2a3e0c7d-f046-3bf6-9965-adb476464ed2",
                                        "glosses": [
                                            "Un tel logement pour une jeune fille."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df49b62-9fcc-4d7d-a9ac-59bdeb0b4049",
                                                "sense_id": "1d874272-6c7f-3585-9604-10756c4ffc0f",
                                                "text": "Mais elle a voulu sa garçonnière, s'il vous plaît, du côté de l'Étoile. C'est là qu'on livre ses robes et ses manteaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc238705-027f-334c-9689-59b5b51ceb86",
                                        "entry_id": "2a3e0c7d-f046-3bf6-9965-adb476464ed2",
                                        "glosses": [
                                            "Baisodrome, petit logement où mener une vie de célibataire, qu'on le soit ou non."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30e8f12-36eb-491e-a157-e10f1e8c9f61",
                                                "sense_id": "bc238705-027f-334c-9689-59b5b51ceb86",
                                                "text": "Son petit appartement sert de garçonnière à ses supérieurs."
                                            },
                                            {
                                                "example_id": "aec0d7c2-8f85-4684-afd8-caf1e4f18d00",
                                                "sense_id": "bc238705-027f-334c-9689-59b5b51ceb86",
                                                "text": "Quinze jours après, ce dompteur de mon cœur me recevait mystérieusement dans une petite garçonnière aussi élégante et parfumée que celle-ci…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9513d05b-cf0f-3749-bfcc-29148fafb9a4",
                                        "entry_id": "2a3e0c7d-f046-3bf6-9965-adb476464ed2",
                                        "glosses": [
                                            "Jeune fille débauchée, qui aime fréquenter les garçons."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88aedc83-3d54-4a6e-9b61-25f14b09ce8b",
                                                "sense_id": "9513d05b-cf0f-3749-bfcc-29148fafb9a4",
                                                "text": "Détestable fausseté ! s'écria mon oncle, la garçonnière ! elle aurait aimé le petit Rousseau, qui sûrement l'a bouchonnée ; et à présent, elle essaierait du petit Denêvres… tout en attendant un troisième, qu'elle essaiera encore. , Bibliothèque de la Pléiade, tome 1, page 229."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garçonnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb97c35-b042-336d-a061-3019dbdeff83",
                                        "entry_id": "cbbef669-2509-35e8-a51e-932d5f4f6ab5",
                                        "glosses": [
                                            "Féminin singulier de garçonnier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdb6014-7e53-4a29-8070-b108822ce6b5",
                                                "sense_id": "cdb97c35-b042-336d-a061-3019dbdeff83",
                                                "text": "… le désir que m'inspire ces longues jambes musclées et garçonnières animées d'un imperceptible frémissement, …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
