                        ],
                        "form": "basswoods"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c932652-657a-3a2a-a569-16ad37bd4eba",
                        "entry_id": "2fe970d3-dc58-39b8-af46-e59bb5277a97",
                        "glosses": [
                            "Any of several trees of the genus Tilia; the lindens, especially Tilia americana, the American basswood."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24e07ad2-c989-4bdd-87dc-8593ec04a084",
                        "source_entry_id": "2fe970d3-dc58-39b8-af46-e59bb5277a97",
                        "source_sense_id": "3c932652-657a-3a2a-a569-16ad37bd4eba",
                        "source_sense_description": "linden tree",
                        "target_lang_word": "Linde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                        "entry_id": "a8eddb52-cfae-3306-8884-9095188526e2",
                                        "glosses": [
                                            "Laubbaum der Gattung Tilia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9fc227-979a-4824-ad1f-f5daf9511b31",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "Auf dem Dorfplatz steht eine große Linde."
                                            },
                                            {
                                                "example_id": "c4f679bc-e1e6-4466-b63d-f1c50b075359",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„Einmal stand eine Gruppe von Menschen hinter der Gaststätte unter einer alten Linde im Kreis, alle hatten die Köpfe nach unten gerichtet und umarmten sich.“"
                                            },
                                            {
                                                "example_id": "77caeb76-8e0e-442d-9b68-870c73556a56",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„Während wir durch das Parktor rollen, unter dem dichten Schirm uralter Linden aufs Gutshaus zu, entfaltet sich, in einem Anhauch von Wind, hoch über dem Dach die alte Wappenfahne der Krockows.“"
                                            },
                                            {
                                                "example_id": "a104aba5-2a8a-4627-9244-27fa3dc9d448",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„Hinter den Linden begann der Vollmond aufzusteigen.“"
                                            },
                                            {
                                                "example_id": "8431e8f0-77da-41ed-8f5e-3025a15b14f4",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„An dem Staket aber trockneten Netze, wähend eine Sichel an der alten Linde hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64720018-5787-343b-8c63-e0fc454f141a",
                                        "entry_id": "a8eddb52-cfae-3306-8884-9095188526e2",
                                        "glosses": [
                                            "Holzart von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf30d028-68d0-4eb6-b3c7-b94c08d49324",
                                                "sense_id": "64720018-5787-343b-8c63-e0fc454f141a",
                                                "text": "Heute benutzen wir Linde für den Ofen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b53a4652-8294-4065-b639-bcb9c750ab8c",
                        "source_entry_id": "2fe970d3-dc58-39b8-af46-e59bb5277a97",
                        "source_sense_id": "3c932652-657a-3a2a-a569-16ad37bd4eba",
                        "source_sense_description": "linden tree",
                        "target_lang_word": "lipa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lipa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9fdabc84-0ec2-3326-b249-14620179569c",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "Tilia L., drzewo liściaste z podrodziny lipowatych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0204b5-b4bc-4edb-b65f-4b2431dd8dd6",
                                                "sense_id": "9fdabc84-0ec2-3326-b249-14620179569c",
                                                "text": "A wieczorkiem, po zachodzie słońca, gdy już wszelkie roboty będą skończone, chciałbym sobie tutaj siadywać albo tam pod lipami, patrzeć na tę wodę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d16f4794-1e53-3646-a093-48dd679a7b8a",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "drewno lipowe"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "9d297ba4-336a-3fd9-9ffa-0fdcb70db027",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "kwiat lipowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74fc1dd2-8ffd-4e0e-9862-0dc45ff102f8",
                                                "sense_id": "9d297ba4-336a-3fd9-9ffa-0fdcb70db027",
                                                "text": "Napar z lipy jest skutecznym środkiem w leczeniu grypy i przeziębienia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "80dbd08a-427b-37bf-ad97-1d54375ee18c",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "kłamstwo, oszustwo"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a653f86a-79f4-47a2-83de-f39f85fc0aa0",
                                                "sense_id": "80dbd08a-427b-37bf-ad97-1d54375ee18c",
                                                "text": "Ten katalog to jakaś lipa, nie kupuj nic w tym sklepie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "ff4f0d31-75ac-3e5c-987c-d0d723ecd9b1",
