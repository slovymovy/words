                        "glosses": [
                            "unterste Hülle der Atmosphäre eines Sterns (besonders der Sonne), die das sichtbare Licht abstrahlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74845285-3b89-470c-ba6d-5273ff1db32b",
                                "sense_id": "fe4f3a17-860f-3e0d-8e06-a3ce597efcbf",
                                "text": "Die Sonne hat ein relativ kühle Fotosphäre von 5700 K und eine mehrere Millionen Kelvin heissen Korona."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
