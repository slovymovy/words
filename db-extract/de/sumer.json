                "senses": [
                    {
                        "sense_id": "4707d316-c964-342c-aeda-03378a922043",
                        "entry_id": "760046ea-15da-30b0-9cdc-b6b495930507",
                        "glosses": [
                            "Landschaft, in der die Sumerer lebten (südliches Mesopotamien beziehungsweise der Süden des späteren Babylonien)"
                        ],
                        "tags": [
                            "Altertum",
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "cf58539b-c215-4beb-8ceb-af77336b5306",
                                "sense_id": "4707d316-c964-342c-aeda-03378a922043",
                                "text": "„Das Reich von Sumer und Akkad umfaßt ein Jahrhundert der Blüte unter kräftigen Herrschern und mehr als zwei Jahrhunderte der Zersetzung und langsamen Dahinsiechens, verbunden mit verheerenden Invasionen von außen.“"
                            },
                            {
                                "example_id": "bd751ba2-3400-493a-84f1-e705425c378d",
                                "sense_id": "4707d316-c964-342c-aeda-03378a922043",
                                "text": "Das aus der Bibel bekannte Ur war eine wichtige Stadt in Sumer."
                            },
                            {
                                "example_id": "0659da9e-07da-40d1-a147-3b7083cb92e4",
                                "sense_id": "4707d316-c964-342c-aeda-03378a922043",
                                "text": "Der assyrische König Assarhaddon nannte sich auch König von Sumer und Akkad."
                            },
                            {
                                "example_id": "ba3d111f-399f-4425-9427-c3a37657cd8a",
                                "sense_id": "4707d316-c964-342c-aeda-03378a922043",
                                "text": "In Sumer wurde die Keilschrift entwickelt."
                            },
                            {
                                "example_id": "115710da-8932-4b59-b1a0-87ffc3d2fe50",
                                "sense_id": "4707d316-c964-342c-aeda-03378a922043",
                                "text": "Die Geschichte Sumers ist im Wesentlichen eine Geschichte der Stadtstaaten."
                            },
                            {
                                "example_id": "dd684fea-3fc0-4a67-ba2b-10d2a62cdfe6",
                                "sense_id": "4707d316-c964-342c-aeda-03378a922043",
                                "text": "Die Landschaft Sumers entstand als Schwemmland von Euphrat und Tigris."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
