                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28cec71-6c97-4a93-be96-d41ac2d43a10",
                                "sense_id": "24779038-8a9f-3ae8-9223-63fabcfa412b",
                                "text": "Maar wat houdt dit breed wettelijk moratorium nu eigenlijk in en wat betekent het voor dagelijkse praktijk van schuldhulpverleners en medewerkers van een debiteurenadministratie?"
                            }
                        ]
                    },
                    {
                        "sense_id": "67b794dc-c01a-36e5-ad32-98c4760c6ce7",
                        "entry_id": "cf27f66e-901b-3de6-805a-33623bc3e197",
                        "glosses": [
                            "het 'bevriezen' van de huidige situatie"
                        ],
                        "tags": [
                            "overdrachtelijk"
                        ],
                        "examples": [
                            {
                                "example_id": "a9b7b427-6c67-463e-b221-326d4d1292da",
                                "sense_id": "67b794dc-c01a-36e5-ad32-98c4760c6ce7",
                                "text": "Maar in de top van de Congolese regering zijn er genoeg mensen die van dit moratorium af willen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ec4129b-a836-4192-9084-cdf1e60a1239",
