                ],
                "translations": [
                    {
                        "translation_id": "407a1ca9-ffb1-416f-808e-f639c49ec609",
                        "source_entry_id": "7effaff3-e529-3b04-9e68-5016be47cadb",
                        "source_sense_id": "2e159d3d-8df4-328a-bf62-5fec4eb866f3",
                        "target_lang_word": "Durchschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d03d1f5-f511-39d2-9579-2cf39258e66e",
                                        "entry_id": "907c58af-9720-3205-a206-3fbc16c55645",
                                        "glosses": [
                                            "Kopie beim Schreiben mit der Hand oder mit der Schreibmaschine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d0308d-bfee-4b7f-ae2c-2f8f97089234",
                                                "sense_id": "3d03d1f5-f511-39d2-9579-2cf39258e66e",
                                                "text": "Sie fertigte für die Besprechung einen Text mit mehreren Durchschlägen an."
                                            },
                                            {
                                                "example_id": "867afa3a-5483-4bee-87c5-69a34067cea7",
                                                "sense_id": "3d03d1f5-f511-39d2-9579-2cf39258e66e",
                                                "text": "„Sie nimmt einen Durchschlag, sieht ihn leidend an, seufzt, locht ihn.“"
                                            },
                                            {
                                                "example_id": "f187a4b8-3135-4e00-bc64-b08ac546a7ed",
                                                "sense_id": "3d03d1f5-f511-39d2-9579-2cf39258e66e",
                                                "text": "„Sogar Herr Sprondel, der Superintendent aus Stargard, der eigens geladen wurde, weil er als Pastor mich vor Jahren eingesegnet hat, erhält einen Durchschlag, damit er seine Predigt nur ja nicht überdehnt.“"
                                            },
                                            {
                                                "example_id": "02df6164-7f85-4a62-a355-ae3cd59a120c",
                                                "sense_id": "3d03d1f5-f511-39d2-9579-2cf39258e66e",
                                                "text": "„Auf dem Tisch liegt ein gelber Aktendeckel mit Gedichten, die ich auf der Erika-Schreibmaschine in drei Durchschlägen getippt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7229b58-d0c9-3968-b966-a2e97abaf23c",
                                        "entry_id": "907c58af-9720-3205-a206-3fbc16c55645",
                                        "glosses": [
                                            "groblöchriges Sieb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3fd783b-6876-466f-b7b0-65e6282c6ec1",
                                                "sense_id": "d7229b58-d0c9-3968-b966-a2e97abaf23c",
                                                "text": "Sie seihte das Kochwasser der Nudeln mit einem Durchschlag ab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "152ee36b-bb4d-3a00-beb4-fff62948aca5",
                                        "entry_id": "907c58af-9720-3205-a206-3fbc16c55645",
                                        "glosses": [
                                            "Vorgang bei Überspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f0264c-edeb-4b50-ab00-7a793146f5d4",
                                                "sense_id": "152ee36b-bb4d-3a00-beb4-fff62948aca5",
                                                "text": "Der Kunststoff wurde durch den Durchschlag verkohlt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0f4a77ab-1997-36f0-845a-e922ae3e5c2e",
                                        "entry_id": "907c58af-9720-3205-a206-3fbc16c55645",
                                        "glosses": [
                                            "Herstellung von Verbindungen mehrerer Stollen"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1867dbff-b119-4259-bdf6-2f4c0f5b6461",
                                                "sense_id": "0f4a77ab-1997-36f0-845a-e922ae3e5c2e",
                                                "text": "Für die nächste Woche planten sie einen Durchschlag mithilfe von Sprengstoff."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4d2fd99-541e-4d01-b828-b2708f8b6854",
                        "source_entry_id": "7effaff3-e529-3b04-9e68-5016be47cadb",
                        "source_sense_id": "2e159d3d-8df4-328a-bf62-5fec4eb866f3",
                        "target_lang_word": "nail set",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nail set",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f907b945-872d-3ce1-9b6f-d0df2ecb967e",
                                        "entry_id": "3d7b5a42-b514-3678-ab68-c85ff525ccdb",
                                        "glosses": [
                                            "A punch that drives in a nail so that its head is level with or below the surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4035dd-8b7f-4311-ac29-cd0398e7468e",
                                                "sense_id": "f907b945-872d-3ce1-9b6f-d0df2ecb967e",
                                                "text": "In an emergency a nail set can be made in a few minutes from a tenpenny or other large nail. Cut off the point with hack saw or grinding wheel, clamp the nail in the vise, indent the end by tapping it with a center punch, and taper or bevel the end on the grinding wheel as shown."
                                            },
                                            {
                                                "example_id": "ec800254-d572-4412-ba39-6f9198a5f701",
                                                "sense_id": "f907b945-872d-3ce1-9b6f-d0df2ecb967e",
                                                "text": "Throw away a damaged nail set. It's cheap enough to replace, and there's no reason to destroy a piece of molding with a damaged nail set that slips off the mark."
                                            },
                                            {
                                                "example_id": "8affde7d-88d1-4e71-afa9-8254133e3d3f",
                                                "sense_id": "f907b945-872d-3ce1-9b6f-d0df2ecb967e",
                                                "text": "The tool to do this is a nail set, which is essentially a pointy steel rod."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee9d6ffb-4096-4eed-baf6-b80509f4dec4",
                        "source_entry_id": "7effaff3-e529-3b04-9e68-5016be47cadb",
                        "source_sense_id": "2e159d3d-8df4-328a-bf62-5fec4eb866f3",
                        "target_lang_word": "poinçon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poinçon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c11a54a6-ff77-3973-ab63-6f5de059ba29",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Instrument métallique, généralement d’acier, qui a une pointe pour percer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5de16a9-69ca-4274-8a71-ce5392d3c043",
                                                "sense_id": "c11a54a6-ff77-3973-ab63-6f5de059ba29",
                                                "text": "Le motard découvrit ce qu’il cherchait dans l’une des poches pratiquées dans le capitonnage des portières et, sans se donner la peine de procéder à une vérification, il dégonfla les pneus de la traction de quatre coups de poinçon, ramassa le couteau, réenfourcha sa machine et fila."
                                            },
                                            {
                                                "example_id": "ea26b1ac-ac04-4806-ac27-9c8ac10e8235",
                                                "sense_id": "c11a54a6-ff77-3973-ab63-6f5de059ba29",
                                                "text": "Sois oublieux de toutes choses.\nAvec un poinçon acéré tu t’occuperas à tuer patiemment tes souvenirs comme l’ancien empereur tuait les mouches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed5c5a4-0882-33c4-be79-7c0d264a4f8c",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Outil qui découpe, par pression transversale, au milieu d'une feuille de matériau solide, une partie à silhouette déterminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6761c46-8920-4833-b502-e6b571140d38",
                                                "sense_id": "aed5c5a4-0882-33c4-be79-7c0d264a4f8c",
                                                "text": "Les trous carrés dans cette plaque sont faits au poinçon, tous au même moment."
                                            },
                                            {
                                                "example_id": "9b1f28f1-ec8e-474d-bcda-c559f28cd9de",
                                                "sense_id": "aed5c5a4-0882-33c4-be79-7c0d264a4f8c",
                                                "text": "Les trous d’une ceinture découpés au poinçon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d073eecb-1763-3077-9add-01ccae702ad9",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Morceau d’acier gravé en relief, avec lequel on frappe les coins des monnaies et des médailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296c87b7-d661-45db-b909-66194fb41d81",
                                                "sense_id": "d073eecb-1763-3077-9add-01ccae702ad9",
                                                "text": "– Mon mari portait deux bagues, avec des dates, des initiales, sans parler de cette petite tête d’aigle qui est le poinçon de contrôle de l’or, en France."
                                            },
                                            {
                                                "example_id": "f2c9e418-a535-47d9-885f-79c7631e46d7",
                                                "sense_id": "d073eecb-1763-3077-9add-01ccae702ad9",
                                                "text": "La céramique confirme et précise les données de la numismatique. Les fouilles du sanctuaire de Jublains ont livré des céramiques décorées au poinçon."
                                            },
                                            {
                                                "example_id": "2115c90e-078a-424c-b2c1-df6662d37ae5",
                                                "sense_id": "d073eecb-1763-3077-9add-01ccae702ad9",
                                                "text": "Parfois, les éditeurs lui confiaient les poinçons gravés par d'autres ; il les champlevait, les trempait et les enfonçait pour obtenir la matrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bce7df5-e294-3311-ba65-16e697b4eb9b",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Instrument dont on se sert pour marquer les ouvrages d’or ou d’argent."
                                        ],
                                        "tags": [
                                            "Orfèvrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2f25449-f833-4ac3-a713-c3a5c4d64060",
                                                "sense_id": "9bce7df5-e294-3311-ba65-16e697b4eb9b",
                                                "text": "Le poinçon de l’état indique à la fois le titre et le paiement des droits."
                                            },
                                            {
                                                "example_id": "c69dd371-549f-4e7f-8550-0c7b7a2c74de",
                                                "sense_id": "9bce7df5-e294-3311-ba65-16e697b4eb9b",
                                                "text": "Un poinçon d’orfèvre."
                                            },
                                            {
                                                "example_id": "1c9961ee-2448-4def-b61b-0c6b88d34a81",
                                                "sense_id": "9bce7df5-e294-3311-ba65-16e697b4eb9b",
                                                "text": "De l’argenterie ancienne marquée au poinçon de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ed3d72c-cc00-32e0-bf75-48364c640323",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Morceau d’acier où les lettres sont gravées en relief et avec lequel on frappe les matrices qui servent à fondre les caractères d’imprimerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70cc07a4-c57f-4d00-b15b-3b157c1d48db",
                                                "sense_id": "4ed3d72c-cc00-32e0-bf75-48364c640323",
                                                "text": "Il fabriqua, en 1621, des poinçons pour former des caractères hébreux, chaldaïques, syriaques, arabes, grecs et allemands, et pour les lettres fleuries, les notes de musique, les vignettes et les fleurons, et rendit public, durant cette année, un cahier d'épreuves de ces caractères, qu'il avait gravés."
                                            },
                                            {
                                                "example_id": "14eb4011-f6a1-47c8-bf3a-98d2659cfc9a",
                                                "sense_id": "4ed3d72c-cc00-32e0-bf75-48364c640323",
                                                "text": "Voici, par exemple, l'anglais Baskerville (1706-1775) qui, après avoir été maître d'écriture et graveur de pierres tombales, commence en 1750 à s'occuper de typographie, passe deux ans à dessiner ses caractères et à faire graver ses poinçons et met en même temps au point un procédé de fabrication de papier satiné sans vergeûres — le papier vélin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97945061-81e5-3c87-9f8d-5b54f99c48bb",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Petite pièce de métal ou partie d’un objet métallique résultant du marquage par un poinçon (l’instrument)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efcc37e0-bb2e-31f1-b623-726a99091152",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Morceau de bois taillé en pointe, ou armé d’une pointe de fer, dont les maîtres de manège se servaient autrefois pour piquer la croupe des sauteurs qu’ils montaient et pour les exciter à détacher la ruade."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80184179-d6db-4dc9-8c25-0657c1b078f0",
                                                "sense_id": "efcc37e0-bb2e-31f1-b623-726a99091152",
                                                "text": "Les habiles écuyers ont toujours blâmé l’usage du poinçon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "027f79ef-59e2-391b-989c-df189cc2e94c",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Pièce de bois qui, dans une charpente, s’appuie perpendiculairement sur le milieu de l’entrait et sur le haut de laquelle s’assemblent les arbalétriers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc4412b-63f1-4c59-9239-78363e9b357f",
                                                "sense_id": "027f79ef-59e2-391b-989c-df189cc2e94c",
                                                "text": "Ces entraits, en se croisant à mi-bois entre chaque pièce, moisent aussi le poinçon qui monte dans la lanterne et s'élève jusque dans la flèche pyramidale qui la surmonte; […]."
                                            },
                                            {
                                                "example_id": "e12cb942-640f-4a5c-be8d-ce8ae7714e84",
                                                "sense_id": "027f79ef-59e2-391b-989c-df189cc2e94c",
                                                "text": "Si l'on énumère les parties principales d'une de ces fermes, on trouve quatre grands arbalétriers, chacun d'environ 10 mètres en longueur, deux cours de doubles moises de 14 mètres et de 18 mètres, un poinçon et deux contrefiches, sans mentionner les petits arbalétriers qui forment le contour polygonal auquel sont cloués les vaux taillés en courbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2315226a-0cad-34cf-8a58-a95bf401d18d",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Arbre vertical sur lequel tourne une machine."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c89d66f7-0a29-3241-b9f2-da44a50fcd8a",
                                        "entry_id": "21232561-4519-3d5e-b077-daee5f33cc15",
                                        "glosses": [
                                            "Tonneau contenant environ les deux tiers d'un muid. (Littré)."
                                        ],
                                        "tags": [
                                            "Touraine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c477ddcd-bb88-4d7d-b87a-bacce4a3b32e",
                                                "sense_id": "c89d66f7-0a29-3241-b9f2-da44a50fcd8a",
                                                "text": "Il voulait toujours avoir un sac de farine au logis, et garder deux pièces de vin de sa récolte, sans permettre qu’on touchât à la farine ni au vin. Mais quand venait le mois de juin, il s’inquiétait de la vente du sac et des deux-pièces de vin avec toute la sollicitude d’un fou. Presque toujours madame Margaritis lui disait alors avoir vendu les deux poinçons à un prix exorbitant, et lui en remettait l’argent qu’il cachait, sans que ni sa femme, ni sa servante eussent pu, même en le guettant, découvrir où était la cachette."
                                            },
                                            {
                                                "example_id": "b1bdebe2-316c-409e-985e-12c82ff21c86",
                                                "sense_id": "c89d66f7-0a29-3241-b9f2-da44a50fcd8a",
                                                "text": "Il exploitait cent arpents de vignes, qui , dans les années plantureuses, lui donnaient sept à huit cents poinçons de vin."
                                            },
                                            {
                                                "example_id": "62d07118-0d64-422b-a0f4-0856efc8f4f2",
                                                "sense_id": "c89d66f7-0a29-3241-b9f2-da44a50fcd8a",
                                                "text": "Quel prodigieux amas de victuailles, combien de troupeaux de bœufs, de muids de farine, de poinçons de vin il faut pour nourrir tout ce monde amoncelé sur le même point, tandis qu’en nos landes on rencontre à peine un habitant de loin en loin ! »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poinçon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f27e632-e8d5-35a3-b716-4fda0de1889e",
                                        "entry_id": "226f0601-9eeb-34bb-ba88-62891b5293f7",
                                        "glosses": [
                                            "Sorte de tonneau servant à mettre du vin ou d’autres liquides, il contenait environ les 2/3 d'un muid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d819ee61-768f-4d09-ae62-00e314f50809",
                                                "sense_id": "6f27e632-e8d5-35a3-b716-4fda0de1889e",
                                                "text": "Poinçon de vin."
                                            },
                                            {
                                                "example_id": "3d8c9879-72d7-46e1-847d-0261686bea91",
                                                "sense_id": "6f27e632-e8d5-35a3-b716-4fda0de1889e",
                                                "text": "Poinçon de cidre."
                                            },
                                            {
                                                "example_id": "ceaf13a5-ae86-484a-93d5-f233363513b7",
                                                "sense_id": "6f27e632-e8d5-35a3-b716-4fda0de1889e",
                                                "text": "Il exploitait cent arpents de vignes, qui, dans les années plantureuses, lui donnaient sept à huit cents poinçons de vin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
