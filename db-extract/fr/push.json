                                    },
                                    {
                                        "sense_id": "96745013-ff44-3b13-afa6-555ed00f497b",
                                        "entry_id": "fee167eb-8b0a-3ca7-bef9-e01b91785e4b",
                                        "glosses": [
                                            "A great effort (to do something)."
