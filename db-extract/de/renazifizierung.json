                "senses": [
                    {
                        "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                        "entry_id": "4b3c536b-ba91-33cb-8bf7-4a969e8452bf",
                        "glosses": [
                            "Wiedererstarken von Ideen des Nationalsozialismus (beispielsweise der Ausgrenzung, Sanktionierung und Entrechtung von Minderheiten und Andersdenkenden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de016262-2d07-4b84-8ab1-9fbf2b6c1b10",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Wer hat Angst vor der Renazifizierung?“"
                            },
                            {
                                "example_id": "5a653909-0fab-4460-8a6a-3d4fceffe7e5",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Viele Deutsche, die im Nationalsozialismus verfolgt oder diskriminiert worden waren, teilten die Sorge vor einer Renazifizierung.“"
                            },
                            {
                                "example_id": "4cb5754c-12fc-4739-ae7b-ab190e445fca",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Das gesellschaftliche Klima in den 1950er-Jahren war geprägt von einer Renazifizierung bzw. einer unzureichenden Entnazifizierung.“"
                            },
                            {
                                "example_id": "7a5a1827-41fc-4a15-83fc-40486359f2bb",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Die Denazifizierung wandelte sich vielerorts zur Renazifizierung.“"
                            },
                            {
                                "example_id": "8c23d87c-d6fd-4fd7-a770-89b3bc498052",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Wie bedrohlich die Tendenzen einer \"Renazifizierung\" waren, wurde 1965 in der Affäre Borodajkewycz evident.“"
                            },
                            {
                                "example_id": "409be5cc-c164-4acb-bd03-c543c2f5189c",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "[Paul Pagel, 1951:] „Der CDU-Politiker war damals der einzige Minister der Landesregierung von Schleswig-Holstein ohne NS-Vergangenheit, beim Blick in die Runde stellte er gar eine „Renazifizierung“ fest.“"
                            },
                            {
                                "example_id": "0cce7af8-a500-4b2f-9549-ec52312ee59b",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Roessler befürchtete außerdem eine Remilitarisierung und Renazifizierung Deutschlands unter amerikanischer Duldung.“"
                            },
                            {
                                "example_id": "78b42d9d-3ef6-4c33-aff6-a8df21055346",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Als Symbol der »Renazifizierung« der jungen Republik galt der Jurist Dr. Hans Globke, den der Antinazi Konrad Adenauer bereits 1949 ins Kanzleramt holte, wo er von 1953 bis 1963 als Staatssekretär und einflußreicher Berater des Kanzlers diente.“"
                            },
                            {
                                "example_id": "3eb932bf-2690-41bd-bc37-c863ea805e22",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Titel auf Titel häuften die einschlägig tätigen Verlage seit Nachkriegstagen, Auflage über Auflage machten manche zu Standardwerken einer stillen Renazifizierung.“"
                            },
                            {
                                "example_id": "7f28bf06-3080-4498-807c-d8d667d51472",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„Die Renazifizierung von Straßennamen begann in Bruck 1961, als unter Bürgermeister Fritz Bauer (FW), einem ehemaligen NSDAP-Mitglied, der völkische Schriftsteller Peter Rosegger eine Straße bekam.“"
                            },
                            {
                                "example_id": "b5dd9fee-cc23-4d91-b500-10b9af3793ba",
                                "sense_id": "6ca8adab-4c1d-3f35-b24b-af36e110a575",
                                "text": "„»Mit dem Chipperfield-Projekt«, sagte Nerdinger, »wird die äußere und innere Renazifizierung des Hauses der Kunst zum Programm gemacht«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
