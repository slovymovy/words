                "senses": [
                    {
                        "sense_id": "202defcb-db7b-32d5-8b46-a80761e84c7b",
                        "entry_id": "e3f7ddbd-8bd8-347b-aee7-86ecb38df481",
                        "glosses": [
                            "Relier par lien interwiki."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "96498a0e-b4f4-4281-a465-2076dbccabb2",
                                "sense_id": "202defcb-db7b-32d5-8b46-a80761e84c7b",
                                "text": "Et le dernier objectif serait alors d’interwikifier' convenablement l’ensemble des articles, ajouter des photos/représentations pour agrémenter les articles et créer un portail lorsque l’ensemble du contenu sera suffisamment consistant."
                            },
                            {
                                "example_id": "16521409-7486-4761-aaf5-2954bcae12d6",
                                "sense_id": "202defcb-db7b-32d5-8b46-a80761e84c7b",
                                "text": "Il n’y a pas que la licence : ne pas intégrer les notes, ne pas catégoriser, ne pas interwikifier, ne pas résumer de manière cohérente dans l’article cohérente dans l’article source est un souverain mépris de l’encyclopédie."
                            },
                            {
                                "example_id": "ea78cecd-403e-4aed-b6f8-912fa9c08022",
                                "sense_id": "202defcb-db7b-32d5-8b46-a80761e84c7b",
                                "text": "L’ensemble des articles a été interwikifié."
                            }
                        ]
                    }
                ],
