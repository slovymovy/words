                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d48fad2a-c4f7-4cdc-8557-f32cd07dfd22",
                                "sense_id": "6b4fabf0-e2c3-3506-8b11-1be8e30072e4",
                                "text": "Mais cet ensemble inchangeable et réglé semblait, comme l’univers nécessaire de Kant, suspendu à un acte suprême de liberté."
                            },
                            {
                                "example_id": "1a933bcf-13bb-4fc0-94b9-b9e6523d16cf",
                                "sense_id": "6b4fabf0-e2c3-3506-8b11-1be8e30072e4",
                                "text": "Malgré la domination des joueurs de Nouhoum Diané, le score restera inchangeable jusqu’au coup du sifflet final du référé central Ousmane Sidibé."
                            },
                            {
                                "example_id": "6e580c00-88d2-4f13-afa6-3ff35aa9875f",
                                "sense_id": "6b4fabf0-e2c3-3506-8b11-1be8e30072e4",
                                "text": "La constitution du Canada est pratiquement inchangeable."
                            }
                        ]
                    }
