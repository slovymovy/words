                                    {
                                        "sense_id": "afccda8a-b6db-3d70-a18c-e3eaff047d84",
                                        "entry_id": "ba6f50fc-daff-3459-8add-3bec455c7a2e",
                                        "glosses": [
                                            "Synonym of Disneyfication."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7543e82-2310-45fa-960d-48f2f2b4c19a",
                                                "sense_id": "afccda8a-b6db-3d70-a18c-e3eaff047d84",
                                                "text": "The sentimentalizing and the inflating, the scouring away of Lassie's social context, the Disneyization of her in books and on television have left us with Super-Collie—the brain of Herman Kahn grafted onto the body of the Hound of Heaven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
