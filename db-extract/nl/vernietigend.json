                "senses": [
                    {
                        "sense_id": "d01c1ab7-e4ce-3054-b9fb-04abf858b4b3",
                        "entry_id": "22a31cb8-6d81-30e4-b887-ce259afaac0f",
                        "glosses": [
                            "zeer slecht, slopend, afkeurend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d00fb3d9-4690-493b-8dd1-3fed56c5e5a4",
                                "sense_id": "d01c1ab7-e4ce-3054-b9fb-04abf858b4b3",
                                "text": "Er was een vernietigende recensie over het nieuwe boek van de beroemde schrijver."
                            },
                            {
                                "example_id": "f3a00da4-f994-49e1-bd1b-f7527da17eea",
                                "sense_id": "d01c1ab7-e4ce-3054-b9fb-04abf858b4b3",
                                "text": "De Onderwijsinspectie hoeft een vernietigend rapport over het Cornelius Haga Lyceum niet in te trekken. Het gerechtshof in Den Haag wil zich in hoger beroep niet uitspreken over de rechtmatigheid van het document."
                            },
                            {
                                "example_id": "e127a8ba-8c2c-4cf7-8f6f-9a240f4dd3f8",
                                "sense_id": "d01c1ab7-e4ce-3054-b9fb-04abf858b4b3",
                                "text": "De waarschuwing redde de landsheer, die zich nu kon voorbereiden op wat anders een vernietigende aanval zou zijn geweest, als een donderslag bij heldere hemel."
                            }
                        ]
                    }
