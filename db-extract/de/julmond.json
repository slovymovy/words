                ],
                "senses": [
                    {
                        "sense_id": "7c12a428-a503-3740-8e69-8358cc297fd1",
                        "entry_id": "4dd99674-faf8-31a0-bd6c-6634a028025c",
                        "glosses": [
                            "für den Monat Dezember"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "3b072456-3dda-4ab0-ab6e-ae0ea0a5853c",
                                "sense_id": "7c12a428-a503-3740-8e69-8358cc297fd1",
                                "text": "Der Julmond ist der dunkelste Monat."
                            },
                            {
                                "example_id": "7e1ecd13-6a94-4f9b-8a53-cb59d637085a",
                                "sense_id": "7c12a428-a503-3740-8e69-8358cc297fd1",
                                "text": "„Sie lebten nun so hin wie Bruder und Schwester, der Bauer und das Mädchen, und erst im Julmond kam es in Engensen zur Löft und Ehestiftung; aber obzwar sie damit schon vor der ganzen Freundschaft nach dem alten Brauche als Eheleute galten, die Ehedönze beschritten sie erst, als der Prediger sie zusammengegeben hatte, denn das hatte er sich als Kuppelpelz ausbedungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "111905ee-7b23-362c-a9b4-4c455ae32e97",
                        "entry_id": "4dd99674-faf8-31a0-bd6c-6634a028025c",
                        "glosses": [
                            "letzter Vollmond des Jahres"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9880457e-1a3e-43ab-80d3-d45b3fdc9617",
                                "sense_id": "111905ee-7b23-362c-a9b4-4c455ae32e97",
                                "text": "„Bereits früh am Morgen scheint uns am 8. Dezember der Vollmond. Dabei handelt es sich um den Julmond, der da die Morgenstunden erhellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
