                                        "examples": [
                                            {
                                                "example_id": "a10abc92-c24a-48a0-85dd-904babed0d21",
                                                "sense_id": "a7d68469-9547-3ab6-9972-9db5d11a3402",
                                                "text": "Auf dem Jahrmarkt herrscht reger Betrieb."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84e06df4-28a9-3525-ae8c-e5f0cf96a1e8",
                                        "entry_id": "20bec346-c6d4-3b68-aee3-a21170bd2182",
                                        "glosses": [
                                            "Ort, Gesellschaft, Firma, Produktionsstätte, wo man produktive Tätigkeit ausführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c344243-9a1a-48d4-b851-f97bae7f0674",
                                                "sense_id": "84e06df4-28a9-3525-ae8c-e5f0cf96a1e8",
                                                "text": "Der Betrieb ist geschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "05825ef3-ceb9-3148-990e-d9d16a7a8206",
                                        "entry_id": "20bec346-c6d4-3b68-aee3-a21170bd2182",
                                        "glosses": [
                                            "die Phase von der Inbetriebnahme bis zur Stilllegung einer Anlage"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90955694-56ec-4623-8c3e-b395b01719ec",
                                                "sense_id": "05825ef3-ceb9-3148-990e-d9d16a7a8206",
                                                "text": "Der Fahrstuhl ist außer Betrieb."
                                            },
                                            {
                                                "example_id": "23e7ce11-6108-4b38-bac5-28bd50728ff1",
                                                "sense_id": "05825ef3-ceb9-3148-990e-d9d16a7a8206",
                                                "text": "„Allerdings braucht die Wärmepumpe für ihren Betrieb in der Regel Strom.“"
                                            },
                                            {
                                                "example_id": "f656afbc-d5e8-4129-83a4-f06a235a83d3",
                                                "sense_id": "05825ef3-ceb9-3148-990e-d9d16a7a8206",
                                                "text": "[2025:] „[…] Die Zukunft gehört dem Elektroauto. Es stößt im Betrieb kein CO2 aus und ist über seinen gesamten Lebenszyklus deutlich klimafreundlicher als ein Verbrenner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a43a5c16-bd26-39bf-950b-5bf8e9a8842a",
                                        "entry_id": "20bec346-c6d4-3b68-aee3-a21170bd2182",
                                        "glosses": [
                                            "Betriebsamkeit, Aktivität, Handlung"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9806b2-3a94-4ef9-95e2-984be5ca163a",
                                                "sense_id": "a43a5c16-bd26-39bf-950b-5bf8e9a8842a",
                                                "text": "Nun mach aber endlich Betrieb, wir wollen fertig werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c070398e-27d2-4bd6-8044-5dac04dc2f73",
                        "source_entry_id": "24a32fb7-72d7-3189-980f-a2ac57b46ddb",
