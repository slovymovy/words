                        "examples": [
                            {
                                "example_id": "68264b63-d8a2-44cc-ac1a-1225a6cf9de5",
                                "sense_id": "0bbd1707-9707-3099-8197-f0ec2611360b",
                                "text": "Ik heb een Schengenvisum gekregen op de Duitse ambassade in Tasjkent. Kan ik hiermee naar Griekenland reizen?",
                                "translation": "Я получила шенгенскую визу в посольстве Германии в Ташкенте. Могу ли я выехать в Грецию с этой?"
                            }
                        ]
                    }
                ],
