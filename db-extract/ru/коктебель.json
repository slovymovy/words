                "senses": [
                    {
                        "sense_id": "4e671510-fe8d-3c5c-967f-0ecc35a3c405",
                        "entry_id": "c9815a1a-e1c3-3cdf-8fbb-a0803447f02a",
                        "glosses": [
                            "посёлок городского типа на востоке Крыма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f93fdf3-21c5-446b-ab35-68cf7c49eba4",
                                "sense_id": "4e671510-fe8d-3c5c-967f-0ecc35a3c405",
                                "text": "Н. Толстой проживающий в настоящее время в Коктебеле, пробудет там да сентября месяца."
                            },
                            {
                                "example_id": "e534bac7-bb66-4f0a-bf99-4366e1aa6c79",
                                "sense_id": "4e671510-fe8d-3c5c-967f-0ecc35a3c405",
                                "text": "Обокрав весной весь дом и оставленная мной в кормилицах, она, приехав в Коктебель ― было очень холодно, безумные ветра, начало весны, ― она писала домой родителям."
                            }
                        ]
                    }
                ],
