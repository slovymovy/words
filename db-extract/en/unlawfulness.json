                    }
                ],
                "senses": [
                    {
                        "sense_id": "4aeac07a-f96a-3ddd-96f7-f9cfa83cbfab",
                        "entry_id": "3302bb81-0fde-3013-ac79-f9b868a1ddbd",
                        "glosses": [
                            "The state of being unlawful."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "533959a3-8691-4b01-94f3-6636ace86ec4",
                                "sense_id": "4aeac07a-f96a-3ddd-96f7-f9cfa83cbfab",
                                "text": "Near-synonyms: criminality, feloniousness, illicitness"
                            },
                            {
                                "example_id": "80edc0dd-3c2c-47a1-8132-c91a9ba0e3d9",
                                "sense_id": "4aeac07a-f96a-3ddd-96f7-f9cfa83cbfab",
                                "text": "They plead against the inconvenience, not the unlawfulness, […] of ceremonies in burial."
                            },
                            {
                                "example_id": "68d9b53b-c00b-4d90-9681-733527511570",
                                "sense_id": "4aeac07a-f96a-3ddd-96f7-f9cfa83cbfab",
                                "text": "After all, Cave speaks about orders being so manifestly illegal that the person carrying them out must or ought to have been aware of their unlawfulness. From this alone, one can draw the conclusion that, if the executant of the order actually knows of its unlawfulness, he ought to be convicted, no matter whether the order is or, as in John Doe's case, is not manifestly illegal."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a47a075-5ead-3a00-b3d9-c3438b4a7f4f",
                        "entry_id": "3302bb81-0fde-3013-ac79-f9b868a1ddbd",
                        "glosses": [
                            "An unlawful act."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "71ac348f-6d3f-4e36-b031-11f49707b5b8",
                                "sense_id": "9a47a075-5ead-3a00-b3d9-c3438b4a7f4f",
                                "text": "Near-synonyms: offense; outrage"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6013a28-03d5-4e53-a14a-312e55427269",
                        "source_entry_id": "3302bb81-0fde-3013-ac79-f9b868a1ddbd",
                        "source_sense_description": "state of being unlawful",
