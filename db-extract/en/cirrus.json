                    {
                        "sense_id": "fc7ff3f2-6049-3c01-997b-7655a2d27adc",
                        "entry_id": "dd00b9a0-d649-3778-9a75-ae31720e1550",
                        "glosses": [
                            "A principal high-level cloud type, typically composed of thin, delicate, white filaments, wisps, or narrow bands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa30930a-f00c-4d58-ba93-2cfc3360db55",
                                "sense_id": "fc7ff3f2-6049-3c01-997b-7655a2d27adc",
                                "text": "He looked at the sky and saw the white cumulus built like friendly piles of ice cream and high above where the thin feathers of the cirrus against the high September sky."
                            },
                            {
                                "example_id": "7db22b80-e5be-42ac-a0fd-19a11d34315f",
                                "sense_id": "fc7ff3f2-6049-3c01-997b-7655a2d27adc",
                                "text": "The blue sky is glossy and fat with heat, a few thin cirri sheared to blown strands like hair at the rims."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5509ca7-0134-4076-b999-fda0735559e6",
