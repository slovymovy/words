                "senses": [
                    {
                        "sense_id": "79b3b7c8-81e2-35cb-a437-8fec4eb3018d",
                        "entry_id": "fc6d9fa7-7d4c-3ae1-8a07-db591412935a",
                        "glosses": [
                            "Variante orthographique désuète de vomir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b0bbf9-57ab-4a9a-9b86-51ab990ea988",
                                "sense_id": "79b3b7c8-81e2-35cb-a437-8fec4eb3018d",
                                "text": "Le cinquième & le sixième jour, elle restoit à-peu-près dans le même état; même toux, mêmes efforts pour vômir, mêmes vômissemens de la bouillie qu'elle avaloit, & quelquefois d'une écume blanche;"
                            },
                            {
                                "example_id": "ff27e69d-4b4a-4a6b-bb2e-3b2329d0f060",
                                "sense_id": "79b3b7c8-81e2-35cb-a437-8fec4eb3018d",
                                "text": "On sait que ces montagnes redoutables jettent plus de feu en certaines années que dans d'autres, & qu'elles sont quelquefois un tems considérable sans en vômir."
                            }
                        ]
                    }
                ],
