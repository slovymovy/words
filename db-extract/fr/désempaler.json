                ],
                "senses": [
                    {
                        "sense_id": "0dfc350f-115f-3c36-850a-6dac91c74689",
                        "entry_id": "01d3ec31-80f2-3706-9e0b-d17fa10fe4b7",
                        "glosses": [
                            "Enlever du pal (quelqu’un qui avait été empalé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded5822c-6084-4c8f-9bc4-37e27656355d",
                                "sense_id": "0dfc350f-115f-3c36-850a-6dac91c74689",
                                "text": "Monsieur, bien que ma philosophie condamne absolument l’action, ce qu’a fait Monsieur Ubu étant trop indigne, je vais vous désempaler."
                            },
                            {
                                "example_id": "87ed2c12-1cfb-4860-99f7-d0388b38058e",
                                "sense_id": "0dfc350f-115f-3c36-850a-6dac91c74689",
                                "text": "Enfin, la gaieté de la demoiselle s'est calmée, et elle vient me retirer de ma chaise comme on désempale un mannequin qui garde, un moment encore, quelque chose de raide et de presque indécent."
                            }
                        ]
                    }
                ],
