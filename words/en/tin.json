{
    "word_family": [
        "tinny",
        "tinner",
        "tinware"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f9377d4-9ee5-345d-91ce-1c7fbada5520",
                    "sense_definition": "An airtight container, usually made of metal, used to preserve food or hold liquids.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sem_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She opened a <w>tin</w> of soup for her lunch.",
                            "target_lang_translations": {
                                "ru": "Она открыла <w>консервную банку</w> супа на обед.",
                                "zh": "她午饭打开了一<w>罐</w>汤。",
                                "de": "Sie öffnete eine <w>Konservendose</w> Suppe für ihr Mittagessen.",
                                "pl": "Otworzyła <w>puszkę</w> zupy na lunch."
                            }
                        },
                        {
                            "text": "We need to buy a <w>tin</w> of paint to finish the walls.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить <w>банку</w> краски, чтобы закончить стены.",
                                "zh": "我们得买一<w>罐</w>油漆来刷完这些墙。",
                                "de": "Wir müssen eine <w>Dose</w> Farbe kaufen, um die Wände fertig zu streichen.",
                                "pl": "Musimy kupić <w>puszkę</w> farby, żeby dokończyć ściany."
                            }
                        }
                    ],
                    "synonyms": [
                        "can",
                        "tin can"
                    ],
                    "common_phrases": [
                        "tin of beans",
                        "biscuit tin",
                        "tin opener"
                    ],
                    "target_lang_definitions": {
                        "ru": "Герметичный контейнер, обычно металлический, используемый для хранения еды или жидкостей.",
                        "zh": "密封的容器，通常由金属制成，用来保存食物或盛放液体。",
                        "de": "Ein luftdichter Behälter, meist aus Metall, der zur Aufbewahrung von Lebensmitteln oder Flüssigkeiten dient.",
                        "pl": "Hermetyczny pojemnik, zazwyczaj metalowy, służący do przechowywania żywności lub płynów."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервная банка",
                                "target_lang_sense_clarification": "для еды"
                            },
                            {
                                "target_lang_word": "банка",
                                "target_lang_sense_clarification": "для краски, жидкостей"
                            },
                            {
                                "target_lang_word": "жестянка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罐头",
                                "target_lang_sense_clarification": "食品罐装容器，也可指罐头本身"
                            },
                            {
                                "target_lang_word": "罐",
                                "target_lang_sense_clarification": "一般指金属罐、油漆罐等容器"
                            },
                            {
                                "target_lang_word": "铁罐",
                                "target_lang_sense_clarification": "强调材质是金属"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Konservendose",
                                "target_lang_sense_clarification": "für Lebensmittel"
                            },
                            {
                                "target_lang_word": "Dose",
                                "target_lang_sense_clarification": "allgemeiner Begriff für Metallbehälter"
                            },
                            {
                                "target_lang_word": "Blechbüchse",
                                "target_lang_sense_clarification": "umgangssprachlich für Metallbehälter"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "puszka",
                                "target_lang_sense_clarification": "metalowy pojemnik na żywność lub napoje"
                            },
                            {
                                "target_lang_word": "konserwa",
                                "target_lang_sense_clarification": "żywność w metalowym opakowaniu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f27ebeca-d02b-3455-8689-b29e8a457b27",
                    "sense_definition": "A metal pan used for baking or roasting food in an oven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour the cake batter into a greased baking <w>tin</w>.",
                            "target_lang_translations": {
                                "ru": "Вылейте тесто для торта в смазанную маслом <w>форму</w> для выпечки.",
                                "zh": "把蛋糕面糊倒进抹了油的烘焙<w>模具</w>里。",
                                "de": "Gießen Sie den Kuchenteig in eine gefettete <w>Backform</w>.",
                                "pl": "Wlej ciasto do wysmarowanej tłuszczem <w>blachy</w> do pieczenia."
                            }
                        },
                        {
                            "text": "He carefully removed the roasting <w>tin</w> from the hot oven.",
                            "target_lang_translations": {
                                "ru": "Он осторожно достал <w>противень</w> из горячей духовки.",
                                "zh": "他小心地把烤<w>盘</w>从热烘箱里取了出来。",
                                "de": "Er nahm die <w>Bratform</w> vorsichtig aus dem heißen Ofen.",
                                "pl": "Ostrożnie wyjął <w>blachę</w> do pieczenia z gorącego piekarnika."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baking tin",
                        "roasting tin",
                        "muffin tin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическая форма, используемая для выпечки или запекания еды в духовке.",
                        "zh": "用于在烤箱中烘烤或烤制食物的金属模具或盘子。",
                        "de": "Eine Metallform, die zum Backen oder Braten von Speisen im Ofen verwendet wird.",
                        "pl": "Metalowa forma lub naczynie używane do pieczenia lub pieczenia mięsa w piekarniku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форма для выпечки",
                                "target_lang_sense_clarification": "для тортов, хлеба"
                            },
                            {
                                "target_lang_word": "противень",
                                "target_lang_sense_clarification": "для запекания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烘焙模具",
                                "target_lang_sense_clarification": "烤蛋糕、面包等用的模具"
                            },
                            {
                                "target_lang_word": "烤盘",
                                "target_lang_sense_clarification": "放进烤箱里烤制食物的金属盘"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Backform",
                                "target_lang_sense_clarification": "allgemein für Kuchen oder Brot"
                            },
                            {
                                "target_lang_word": "Kuchenform",
                                "target_lang_sense_clarification": "speziell für Kuchen"
                            },
                            {
                                "target_lang_word": "Kastenform",
                                "target_lang_sense_clarification": "rechteckige Backform"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "blacha",
                                "target_lang_sense_clarification": "metalowe naczynie do pieczenia"
                            },
                            {
                                "target_lang_word": "forma do pieczenia",
                                "target_lang_sense_clarification": "naczynie do ciast lub chleba"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a69f00-58bc-3fca-b496-d99091061ddc",
                    "sense_definition": "A soft, silver-white metallic chemical element that is resistant to corrosion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bronze is a strong alloy made from copper and <w>tin</w>.",
                            "target_lang_translations": {
                                "ru": "Бронза — это прочный сплав меди и <w>олова</w>.",
                                "zh": "青铜是由铜和<w>锡</w>制成的坚固合金。",
                                "de": "Bronze ist eine starke Legierung aus Kupfer und <w>Zinn</w>.",
                                "pl": "Brąz to wytrzymały stop miedzi i <w>cyny</w>."
                            }
                        },
                        {
                            "text": "The old roof was covered in sheets of corrugated <w>tin</w>.",
                            "target_lang_translations": {
                                "ru": "Старая крыша была покрыта листами рифленой <w>жести</w>.",
                                "zh": "那座老屋顶铺着一片片波纹<w>铁皮</w>。",
                                "de": "Das alte Dach war mit Wellblechplatten aus <w>Zinn</w> bedeckt.",
                                "pl": "Stary dach był pokryty arkuszami falistej <w>blachy</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "made of tin",
                        "tin mine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий серебристо-белый металлический химический элемент, устойчивый к коррозии.",
                        "zh": "一种柔软的银白色金属化学元素，耐腐蚀。",
                        "de": "Ein weiches, silberweißes chemisches Element, das korrosionsbeständig ist.",
                        "pl": "Miękki, srebrzystobiały metaliczny pierwiastek chemiczny, odporny na korozję."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "олово",
                                "target_lang_sense_clarification": "химический элемент"
                            },
                            {
                                "target_lang_word": "жесть",
                                "target_lang_sense_clarification": "листовой материал (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锡",
                                "target_lang_sense_clarification": "化学元素"
                            },
                            {
                                "target_lang_word": "铁皮",
                                "target_lang_sense_clarification": "英语中有时泛指镀锡薄板或类似金属板材"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zinn",
                                "target_lang_sense_clarification": "chemisches Element"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "cyna",
                                "target_lang_sense_clarification": "pierwiastek chemiczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a304b05e-ce1a-3b1d-9f5e-65208ddb0ca0",
                    "sense_definition": "An abbreviation for Taxpayer Identification Number.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must provide your <w>TIN</w> when you file your taxes.",
                            "target_lang_translations": {
                                "ru": "Вы должны предоставить свой <w>ИНН</w> при подаче налоговой декларации.",
                                "zh": "报税时你必须提供你的<w>纳税人识别号</w>。",
                                "de": "Sie müssen bei der Steuererklärung Ihre <w>Steuernummer</w> angeben.",
                                "pl": "Musisz podać swój <w>NIP</w> przy składaniu deklaracji podatkowej."
                            }
                        },
                        {
                            "text": "The bank requires a valid <w>TIN</w> to open a new business account.",
                            "target_lang_translations": {
                                "ru": "Банку требуется действующий <w>ИНН</w> для открытия нового бизнес-счета.",
                                "zh": "银行要求提供有效的<w>税号</w>才能开设新的企业账户。",
                                "de": "Die Bank benötigt eine gültige <w>Steuernummer</w>, um ein neues Geschäftskonto zu eröffnen.",
                                "pl": "Bank wymaga ważnego <w>NIP-u</w> do otwarcia nowego konta firmowego."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для Идентификационного номера налогоплательщика.",
                        "zh": "“纳税人识别号”的缩写。",
                        "de": "Eine Abkürzung für die Steuernummer oder Identifikationsnummer des Steuerzahlers.",
                        "pl": "Skrót od numeru identyfikacji podatkowej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ИНН",
                                "target_lang_sense_clarification": "налоговый номер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纳税人识别号",
                                "target_lang_sense_clarification": "正式说法"
                            },
                            {
                                "target_lang_word": "税号",
                                "target_lang_sense_clarification": "常用简称"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Steuernummer",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung"
                            },
                            {
                                "target_lang_word": "Steuer-Identifikationsnummer",
                                "target_lang_sense_clarification": "offizielle Bezeichnung in Deutschland"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "NIP",
                                "target_lang_sense_clarification": "Numer Identyfikacji Podatkowej"
                            },
                            {
                                "target_lang_word": "numer podatkowy",
                                "target_lang_sense_clarification": "ogólne określenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b9da3ab-055e-3136-95da-f5b69c5d00c0",
                    "sense_definition": "Money, especially silver coins.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has plenty of <w>tin</w> to spend on expensive cars.",
                            "target_lang_translations": {
                                "ru": "У него куча <w>денег</w>, чтобы тратить их на дорогие машины.",
                                "zh": "他有的是<w>钱</w>买昂贵的汽车。",
                                "de": "Er hat jede Menge <w>Knete</w>, um sie für teure Autos auszugeben.",
                                "pl": "Ma mnóstwo <w>kasy</w> na drogie samochody."
                            }
                        },
                        {
                            "text": "I cannot go out tonight because I am completely out of <w>tin</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу пойти гулять сегодня вечером, потому что я совершенно без <w>денег</w>.",
                                "zh": "我今晚不能出门了，因为我一点<w>钱</w>都没有。",
                                "de": "Ich kann heute Abend nicht ausgehen, weil ich absolut keine <w>Knete</w> mehr habe.",
                                "pl": "Nie mogę dziś wyjść, bo jestem kompletnie bez <w>grosza</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, особенно серебряные монеты.",
                        "zh": "钱，尤指银币。",
                        "de": "Geld, insbesondere Münzen (veraltet oder umgangssprachlich).",
                        "pl": "Pieniądze, zwłaszcza monety (przestarzałe lub slangowe)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деньги",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "гроши",
                                "target_lang_sense_clarification": "монеты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钱",
                                "target_lang_sense_clarification": "俚语，指钱"
                            },
                            {
                                "target_lang_word": "银钱",
                                "target_lang_sense_clarification": "旧时说法，尤指硬币现金"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Knete",
                                "target_lang_sense_clarification": "umgangssprachlich für Geld"
                            },
                            {
                                "target_lang_word": "Moneten",
                                "target_lang_sense_clarification": "umgangssprachlich für Geld"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kasa",
                                "target_lang_sense_clarification": "potoczne określenie pieniędzy"
                            },
                            {
                                "target_lang_word": "grosz",
                                "target_lang_sense_clarification": "potocznie o pieniądzach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc9a02c4-24e1-3de8-af13-64adaa6e76ee",
                    "sense_definition": "Made of the metal tin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child played with a small <w>tin</w> soldier on the floor.",
                            "target_lang_translations": {
                                "ru": "Ребенок играл с маленьким <w>оловянным</w> солдатиком на полу.",
                                "zh": "那个孩子在地板上玩一个小<w>锡制</w>士兵。",
                                "de": "Das Kind spielte mit einem kleinen <w>zinnenen</w> Soldaten auf dem Boden.",
                                "pl": "Dziecko bawiło się na podłodze małym <w>cynowym</w> żołnierzykiem."
                            }
                        },
                        {
                            "text": "She wrapped the leftover food in <w>tin</w> foil to keep it fresh.",
                            "target_lang_translations": {
                                "ru": "Она завернула остатки еды в <w>фольгу</w>, чтобы сохранить их свежими.",
                                "zh": "她把剩饭菜用<w>锡</w>箔包起来保鲜。",
                                "de": "Sie wickelte die Essensreste in <w>Alufolie</w>, um sie frisch zu halten.",
                                "pl": "Zawinęła resztki jedzenia w folię <w>aluminiową</w>, żeby zachować świeżość."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tin foil",
                        "tin soldier",
                        "tin whistle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из олова или жести.",
                        "zh": "由锡制成的。",
                        "de": "Aus Zinn hergestellt oder mit Zinn beschichtet.",
                        "pl": "Wykonany z cyny lub pokryty cyną."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оловянный",
                                "target_lang_sense_clarification": "из олова"
                            },
                            {
                                "target_lang_word": "жестяной",
                                "target_lang_sense_clarification": "из жести"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锡制的",
                                "target_lang_sense_clarification": "由锡制成"
                            },
                            {
                                "target_lang_word": "铁皮的",
                                "target_lang_sense_clarification": "指薄金属片制成时常用"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zinnen",
                                "target_lang_sense_clarification": "aus Zinn bestehend"
                            },
                            {
                                "target_lang_word": "Zinn-",
                                "target_lang_sense_clarification": "als Vorsilbe für Materialien"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "cynowy",
                                "target_lang_sense_clarification": "zrobiony z cyny"
                            },
                            {
                                "target_lang_word": "blaszany",
                                "target_lang_sense_clarification": "zrobiony z blachy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02ac74d5-4b21-3dd9-8cf5-2258280debb7",
                    "sense_definition": "To preserve food by sealing it in a metal container.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>tins</w> sardines for export to other countries.",
                            "target_lang_translations": {
                                "ru": "Фабрика <w>консервирует</w> сардины для экспорта в другие страны.",
                                "zh": "这家工厂把沙丁鱼<w>装罐</w>后出口到其他国家。",
                                "de": "Die Fabrik <w>dost</w> Sardinen für den Export in andere Länder ein.",
                                "pl": "Fabryka <w>puszkuje</w> sardynki na eksport do innych krajów."
                            }
                        },
                        {
                            "text": "My grandmother used to <w>tin</w> peaches from her garden every summer.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка обычно <w>консервировала</w> персики из своего сада каждое лето.",
                                "zh": "我祖母过去每到夏天都会把自家园子的桃子<w>制成罐头</w>。",
                                "de": "Meine Großmutter hat früher jeden Sommer Pfirsiche aus ihrem Garten <w>eingedost</w>.",
                                "pl": "Moja babcia co lato <w>konserwowała</w> brzoskwinie ze swojego ogrodu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tinned food",
                        "tinned fruit"
                    ],
