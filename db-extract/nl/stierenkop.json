                        "examples": [
                            {
                                "example_id": "3b1a6344-15d9-43b3-ab84-361c37ff7f28",
                                "sense_id": "6e9462d3-60a0-3cbd-a644-057e77c4da8e",
                                "text": "Het was een bizarre actie van de supporters van Dynamo Dresden op 20 augustus voorafgaand aan de bekerwedstrijd tegen RB Leipzig. Om hun afkeer van de tegenstander kracht bij te zetten gooiden de Dresden-fans een stierenkop richting het veld. Die actie is de club nu ook nog eens duur komen te staan."
                            },
                            {
                                "example_id": "e7ef7473-8507-4e7b-a7b7-46c42c16ca65",
                                "sense_id": "6e9462d3-60a0-3cbd-a644-057e77c4da8e",
                                "text": "Het gaat om de werken Palet en stierenkop en Zittende vrouw in grijze jurk die voor respectievelijk bijna 1,2 en 3,3 miljoen euro van eigenaar wisselden. De 62-jarige Marina Picasso verkocht de werken van haar opa omdat ze met het geld internationale hulpprojecten voor kinderen en jongeren wil steunen."
                            }
                        ]
                    }
