                "senses": [
                    {
                        "sense_id": "7a71c1f1-351c-3e42-a61c-87e65cf5a1aa",
                        "entry_id": "23b88433-65f0-3f72-a4c4-1028e7e5c52b",
                        "glosses": [
                            "nach den 2. Weltkrieg Bezeichnung für die amerikanische und britische Besatzungszone, besonders für die Phase gemeinsamer Verwaltung ab 1947"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bf975d0-308d-4611-b7c9-533ead56c70a",
                                "sense_id": "7a71c1f1-351c-3e42-a61c-87e65cf5a1aa",
                                "text": "In der Bizone gab es 1945-1949 unter anderem gemeinsame Briefmarkenausgaben."
                            },
                            {
                                "example_id": "deca4225-0fa1-4505-b3fb-add897c28dee",
                                "sense_id": "7a71c1f1-351c-3e42-a61c-87e65cf5a1aa",
                                "text": "„Der Ökonom [gemeint: Ludwig Erhard], damals Wirtschaftsdirektor der Bizone, beauftragte das gerade gegründete Allensbacher Institut für Demoskopie mit einer Umfrage.“"
                            },
                            {
                                "example_id": "9646c9c4-7e01-4410-8b2a-3cce5b90b763",
                                "sense_id": "7a71c1f1-351c-3e42-a61c-87e65cf5a1aa",
                                "text": "„Hier zeichneten sich die ersten Ansätze einer zonalen Aufsplitterung ab: Bizone, Trizone, am Ende die Ost-West-Teilung des Landes.“"
                            },
                            {
                                "example_id": "5d81b88a-f86c-4547-86d1-43afbdb05922",
                                "sense_id": "7a71c1f1-351c-3e42-a61c-87e65cf5a1aa",
                                "text": "„Damit startete in den von Alliierten besetzten deutschen Gebieten in und um Aachen ein noch lokal begrenzter, aber zuverlässiger Postdienst, der später das ganze Besatzungsgebiet der Briten und US-Amerikaner, die Bizone, umfassen sollte.“"
                            },
                            {
                                "example_id": "fae5ce51-5855-4c70-81a4-e60029178158",
                                "sense_id": "7a71c1f1-351c-3e42-a61c-87e65cf5a1aa",
                                "text": "„In der Bizone wurde der Postdienst auf der Grundlage der früheren deutschen Postverwaltungen weiter aufgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
