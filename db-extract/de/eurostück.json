                "senses": [
                    {
                        "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                        "entry_id": "3db48f92-87ea-3cb9-8f70-c66ac40a3187",
                        "glosses": [
                            "Münze mit dem Wert von einem Euro"
                        ],
                        "tags": [
                            "Währung"
                        ],
                        "examples": [
                            {
                                "example_id": "478ab2be-7905-4d6e-a63a-5b41ef531901",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "„Sabine steckte ein Eurostück in einen Automaten, und die Absperrung wurde durch eine einfache Mechanik frei gegeben.“"
                            },
                            {
                                "example_id": "66985b9a-dc95-4303-af49-74d445bb0b35",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "Wenn du einen Einkaufswagen im Supermarkt nutzen willst, brauchst du ein Eurostück."
                            },
                            {
                                "example_id": "944ff740-75a6-426d-919e-0687ec8ad004",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "[Drohnen:] […] „es geht noch kleiner: Forscher aus Harvard haben RoboBee gebaut, eine mechanische Biene kaum größer als ein Eurostück.“"
                            },
                            {
                                "example_id": "62833e16-84b1-45b0-8eb6-165eb6b276ff",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "„Landwirt Wolfgang Offenbeck befürchtete das Schlimmste, als er am Pfingstmontag unter einem Vordach seiner Scheune Unterschlupf fand und das Niederprasseln der Hagelkörner - groß wie ein Eurostück - auf seine Beerenfelder beobachtete.“"
                            },
                            {
                                "example_id": "17bec902-93f5-44ff-b886-4d86cefa5024",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "„In der Hand hält er drei Eurostücke.“"
                            },
                            {
                                "example_id": "525080f9-65df-486b-ade1-b9bb3a38eb04",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "[…] „»Ich habe ihm die 21 Euro gegeben, einen Zwanziger-Schein und ein Eurostück, das weiß ich genau.«“"
                            },
                            {
                                "example_id": "5090fa74-6b81-4d31-82f7-ce5512e37d15",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "„Auf dem Gartentisch unter einem großen Sonnenschirm reiht sie einige Türmchen von Cent- und Eurostücken.“"
                            },
                            {
                                "example_id": "2f8c72d2-6bf4-4f93-8fdd-1473edc209ff",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "[In der Spielhalle konnte er sich wie in einer Höhle vor seinen Problemen verstecken.] „Dass die mit jedem Eurostück, dass er in den silbernen Schlitz des Automaten steckte, größer wurden, wollte Ahmed nicht sehen.“"
                            },
                            {
                                "example_id": "9b9fdf8b-fefd-4100-8f5c-fcb2b9b77157",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "„Eine halbe Stunde später wühlte ich vorm Kaiser’s in der Barnimstraße in meiner Hosentasche nach einem Eurostück, als eine freundliche alte Dame, die schon neben dem Eingang gewartet zu haben schien, mit einem Einkaufswagen auf mich zurollte und fragte, ob ich einen Wagen brauche.“"
                            },
                            {
                                "example_id": "75fbc228-c2b4-4c9e-ac80-73bae3c6b9b5",
                                "sense_id": "1e1c5b0c-7a86-387d-8a67-c7b5a78258ce",
                                "text": "„Das Besondere an diesen Molekülen: Sie türmen sich von selbst zu Stapeln übereinander, wie Eurostücke in einer Rolle Münzgeld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
