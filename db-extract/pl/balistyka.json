                                    },
                                    {
                                        "sense_id": "acde28aa-20a3-348a-9e5b-7166ce918737",
                                        "entry_id": "4c9bfbbe-4647-392c-a27c-b2f199994d4b",
                                        "glosses": [
                                            "Of or relating to projectiles moving under their own momentum, aerodynamic drag, gravity, and sometimes rocket power, without significant lift."
                                        ],
