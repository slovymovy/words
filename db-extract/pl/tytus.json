                                    },
                                    {
                                        "sense_id": "f248130d-ef3d-35a9-a20f-80b27512b6e0",
                                        "entry_id": "918115c8-7d46-31d5-8e41-3d2098b4f934",
                                        "glosses": [
                                            "Nom francisé de l'empereur Titus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c082652-9416-4d33-9bfa-18ee628342df",
                                                "sense_id": "f248130d-ef3d-35a9-a20f-80b27512b6e0",
                                                "text": "Je ne puis aimer Tite, ou n’aimer pas son frère ;\nEt malgré cet amour, je ne puis m’arrêter\nQu’au degré le plus haut où je puisse monter."
                                            },
                                            {
                                                "example_id": "f1d9c421-5076-47e9-9d19-61f3724bc5a8",
                                                "sense_id": "f248130d-ef3d-35a9-a20f-80b27512b6e0",
                                                "text": "Je ne suis pas heureusement comme Tite, ce fainéant, ce Romain qui geignait toujours qu’il avait perdu son temps. Je ne perds rien, je suis content de ma journée, je l’ai gagnée."
                                            }
                                        ]
                                    }
                                ]
                            }
