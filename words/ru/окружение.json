                            {
                                "target_lang_word": "surroundings",
                                "target_lang_sense_clarification": "physical area around something"
                            },
                            {
                                "target_lang_word": "environment",
                                "target_lang_sense_clarification": "conditions or atmosphere"
                            },
                            {
                                "target_lang_word": "setting",
                                "target_lang_sense_clarification": "scenic context or location"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "otoczenie",
                                "target_lang_sense_clarification": "obszar fizyczny wokół czegoś"
                            },
                            {
                                "target_lang_word": "środowisko",
                                "target_lang_sense_clarification": "warunki lub atmosfera"
                            },
