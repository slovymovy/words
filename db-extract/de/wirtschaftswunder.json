                    },
                    {
                        "form_id": "42a4c6f0-eae7-43e4-ad60-fa2062c101a9",
                        "entry_id": "6779d9ff-2c44-3112-9e40-693e1431130d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wirtschaftswunder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "299bd31b-9441-3e7f-8525-640febd4733c",
                        "entry_id": "6779d9ff-2c44-3112-9e40-693e1431130d",
                        "glosses": [
                            "unerwarteter, großer Aufschwung der Wirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e1ae9a-29a7-428b-ac79-645b3474f413",
                                "sense_id": "299bd31b-9441-3e7f-8525-640febd4733c",
                                "text": "„Früher war Modi Regierungschef des Bundesstaats Gujarat, wo er ein Wirtschaftswunder vollbrachte.“"
                            },
                            {
                                "example_id": "8185df39-65ba-46f1-a289-b510e3b73fef",
                                "sense_id": "299bd31b-9441-3e7f-8525-640febd4733c",
                                "text": "„Erst im Wirtschaftswunder der späten fünfziger Jahre – an dem die »Neubürger« ihren gehörigen Anteil hatten – schliffen sich die Gegensätze ab.“"
                            },
                            {
                                "example_id": "de73fff2-254a-4918-a72c-fb1816b13704",
                                "sense_id": "299bd31b-9441-3e7f-8525-640febd4733c",
                                "text": "„Er spielt in den frühen fünfziger Jahren, als in Deutschland das Wirtschaftswunder eingesetzt hat und die Restauration allerorts den politischen Alltag bestimmt.“"
                            },
                            {
                                "example_id": "9e66ca1e-60e8-48f8-bb00-35cb1bebf82c",
                                "sense_id": "299bd31b-9441-3e7f-8525-640febd4733c",
                                "text": "„Die Leute im Zug sind entweder auf der Plus-Seite des damaligen Wirtschaftswunders zu Hause, oder es sind doch welche, die immerhin noch Hoffnung haben, an den Segnungen der Fabrikzivilisation teilnehmen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
