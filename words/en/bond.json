{
    "word_family": [
        "bondage",
        "bonded",
        "bonding",
        "bondholder",
        "unbonded"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0285e8c-75a7-3d38-8242-144a11d38d3b",
                    "sense_definition": "An emotional link, connection or union; that which holds two or more people together, as in a friendship; a tie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shared experience of the long journey created a strong <w>bond</w> between the travelers.",
                            "target_lang_translations": {
                                "ru": "Общий опыт долгого путешествия создал крепкую <w>связь</w> между путешественниками.",
                                "zh": "长途旅行的共同经历在旅客之间建立了一种深厚的<w>纽带</w>。"
                            }
                        },
                        {
                            "text": "There is a special <w>bond</w> between a mother and her child.",
                            "target_lang_translations": {
                                "ru": "Между матерью и ребёнком существует особая <w>связь</w>.",
                                "zh": "母亲和孩子之间存在着一种特殊的<w>联系</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "estrangement",
                        "division"
                    ],
                    "common_phrases": [
                        "bond of friendship",
                        "common bond",
                        "strong bond"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональная связь, соединение или союз; то, что удерживает двух или более людей вместе, например, в дружбе; привязанность.",
                        "zh": "人与人之间情感上的联系、纽带或结合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связь",
                                "target_lang_sense_clarification": "эмоциональная или социальная"
                            },
                            {
                                "target_lang_word": "узы",
                                "target_lang_sense_clarification": "крепкая связь, часто семейная или дружеская"
                            },
                            {
                                "target_lang_word": "единение",
                                "target_lang_sense_clarification": "состояние близости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纽带",
                                "target_lang_sense_clarification": "比喻人与人之间的联系"
                            },
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "人际关系"
                            },
                            {
                                "target_lang_word": "情谊",
                                "target_lang_sense_clarification": "深厚的感情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "088a4c64-ae9c-322d-922f-5531be4dce55",
                    "sense_definition": "A documentary obligation to pay a sum or to perform a contract; a financial instrument representing a debt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many say that government and corporate <w>bonds</w> are a good investment to balance against a portfolio consisting primarily of stocks.",
                            "target_lang_translations": {
                                "ru": "Многие говорят, что государственные и корпоративные <w>облигации</w> — это хорошая инвестиция для балансировки портфеля, состоящего в основном из акций.",
                                "zh": "许多人认为，政府和企业<w>债券</w>是平衡以股票为主的投资组合的良好选择。"
                            }
                        },
                        {
                            "text": "The city issued a municipal <w>bond</w> to fund the construction of the new library.",
                            "target_lang_translations": {
                                "ru": "Город выпустил муниципальную <w>облигацию</w> для финансирования строительства новой библиотеки.",
                                "zh": "该市发行了市政<w>债券</w>来资助新图书馆的建设。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "government bond",
                        "corporate bond",
                        "bond market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документальное обязательство выплатить сумму или выполнить контракт; финансовый инструмент, представляющий собой долг.",
                        "zh": "一种金融工具，代表发行人对持有人的债务，通常承诺在特定日期偿还本金并支付利息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облигация",
                                "target_lang_sense_clarification": "ценная бумага"
                            },
                            {
                                "target_lang_word": "бонд",
                                "target_lang_sense_clarification": "финансовый термин"
                            },
                            {
                                "target_lang_word": "долговое обязательство",
                                "target_lang_sense_clarification": "юридический документ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "债券",
                                "target_lang_sense_clarification": "金融投资工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18dc496f-05b7-3d9c-98e2-4ec77cb82e13",
                    "sense_definition": "A link or force between neighbouring atoms in a molecule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Organic chemistry primarily consists of the study of carbon <w>bonds</w>, in their many variations.",
                            "target_lang_translations": {
                                "ru": "Органическая химия в основном состоит из изучения углеродных <w>связей</w> в их многочисленных вариациях.",
                                "zh": "有机化学主要研究碳原子之间多种多样的<w>化学键</w>。"
                            }
                        },
                        {
                            "text": "The chemical <w>bond</w> between the hydrogen and oxygen atoms is very difficult to break.",
                            "target_lang_translations": {
                                "ru": "Химическую <w>связь</w> между атомами водорода и кислорода очень трудно разорвать.",
                                "zh": "氢原子和氧原子之间的<w>化学键</w>非常难以断裂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical bond",
                        "covalent bond",
                        "carbon bond"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связь или сила между соседними атомами в молекуле.",
                        "zh": "分子中相邻原子之间的化学作用力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связь",
                                "target_lang_sense_clarification": "химическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "化学键",
                                "target_lang_sense_clarification": "科学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3c1e9e8-04f9-3d11-8d9e-25f414137537",
                    "sense_definition": "A physical connection which binds, a band.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was brought before the tribunal in iron <w>bonds</w>.",
                            "target_lang_translations": {
                                "ru": "Пленника привели в трибунал в железных <w>оковах</w>.",
                                "zh": "囚犯被戴着铁<w>枷锁</w>带到了法庭。"
                            }
                        },
                        {
                            "text": "He struggled to break the <w>bonds</w> that held his hands together behind his back.",
                            "target_lang_translations": {
                                "ru": "Он изо всех сил пытался разорвать <w>путы</w>, стягивавшие его руки за спиной.",
                                "zh": "他挣扎着想要挣脱<w>束缚</w>住他背后双手的绳索。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "iron bonds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое соединение, которое связывает; путы или оковы.",
                        "zh": "用于束缚身体的物理连接物，如锁链或绳索。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оковы",
                                "target_lang_sense_clarification": "металлические изделия для связывания"
                            },
                            {
                                "target_lang_word": "узы",
                                "target_lang_sense_clarification": "цепи или путы"
                            },
                            {
                                "target_lang_word": "путы",
                                "target_lang_sense_clarification": "то, что мешает движению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "枷锁",
                                "target_lang_sense_clarification": "束缚身体的器具"
                            },
                            {
                                "target_lang_word": "束缚",
                                "target_lang_sense_clarification": "限制行动的物理连接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93bdacb0-a624-37c7-9a0b-927976f7b7af",
                    "sense_definition": "A bail bond; money paid as a guarantee that a released prisoner will return for trial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bailiff released the prisoner as soon as the <w>bond</w> was posted.",
                            "target_lang_translations": {
                                "ru": "Судебный пристав освободил заключенного, как только был внесен <w>залог</w>.",
                                "zh": "法警在<w>保释金</w>缴纳后立即释放了囚犯。"
                            }
                        },
                        {
                            "text": "The judge set a high <w>bond</w> because the defendant was considered a flight risk.",
                            "target_lang_translations": {
                                "ru": "Судья установил высокий <w>залог</w>, так как подсудимый считался склонным к побегу.",
                                "zh": "由于被告被认为有潜逃风险，法官设定了高额的<w>保释金</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bail bond",
                        "post bond",
                        "out on bond"
                    ],
                    "target_lang_definitions": {
                        "ru": "Залог; деньги, выплачиваемые в качестве гарантии того, что освобожденный заключенный вернется в суд.",
                        "zh": "为确保被释放的被告人按时出庭而缴纳的保证金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "залог",
                                "target_lang_sense_clarification": "денежное обеспечение"
                            },
                            {
                                "target_lang_word": "поручительство",
                                "target_lang_sense_clarification": "гарантия явки в суд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保释金",
                                "target_lang_sense_clarification": "法律保证金"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f3ba52a-7dc6-3a9c-bee9-f79aa92e2ed0",
                    "sense_definition": "A binding agreement, a covenant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You could rely on him because his word was his <w>bond</w>.",
                            "target_lang_translations": {
                                "ru": "На него можно было положиться, потому что его слово было его <w>обязательством</w>.",
                                "zh": "你可以信任他，因为他一言九鼎，信守<w>承诺</w>。"
                            }
                        },
                        {
                            "text": "Herbert resented his wife for subjecting him to the <w>bonds</w> of matrimony.",
                            "target_lang_translations": {
                                "ru": "Герберт обижался на жену за то, что она связала его <w>узами</w> брака.",
                                "zh": "赫伯特怨恨他的妻子，因为她用婚姻的<w>枷锁</w>束缚了他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "word is bond",
                        "bonds of matrimony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обязательное соглашение, договор.",
                        "zh": "具有法律约束力的协议或承诺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязательство",
                                "target_lang_sense_clarification": "обещание или долг"
                            },
                            {
                                "target_lang_word": "соглашение",
                                "target_lang_sense_clarification": "договорённость"
                            },
                            {
                                "target_lang_word": "узы",
                                "target_lang_sense_clarification": "например, брачные"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "契约",
                                "target_lang_sense_clarification": "正式协议"
                            },
                            {
                                "target_lang_word": "约束",
                                "target_lang_sense_clarification": "承诺带来的限制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc6ab61a-bc47-396d-97b1-be940403af74",
                    "sense_definition": "In building, a specific pattern of bricklaying, based on overlapping rows or layers to give strength.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason used a traditional Flemish <w>bond</w> to ensure the wall was both strong and decorative.",
                            "target_lang_translations": {
                                "ru": "Каменщик использовал традиционную фламандскую <w>перевязку</w>, чтобы стена была одновременно прочной и декоративной.",
                                "zh": "泥瓦匠使用了传统的佛兰芒式<w>砌合方式</w>，以确保墙体既坚固又美观。"
                            }
                        },
                        {
                            "text": "The strength of the brick wall depends heavily on the type of <w>bond</w> used during construction.",
                            "target_lang_translations": {
                                "ru": "Прочность кирпичной стены во многом зависит от типа <w>связки</w>, использованной при строительстве.",
                                "zh": "砖墙的强度很大程度上取决于施工时所采用的<w>砌合方式</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bondwork"
                    ],
                    "common_phrases": [
                        "brick bond",
                        "flemish bond"
                    ],
                    "target_lang_definitions": {
                        "ru": "В строительстве: определенный тип кирпичной кладки, основанный на перекрытии рядов для прочности.",
                        "zh": "建筑中砖块的砌筑方式，通过交错排列以增加墙体强度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевязка",
                                "target_lang_sense_clarification": "способ укладки кирпича"
                            },
                            {
                                "target_lang_word": "связка",
                                "target_lang_sense_clarification": "соединение элементов кладки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "砌合方式",
                                "target_lang_sense_clarification": "建筑术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "224f203f-6f7d-35ec-a512-d2f0af9ec712",
                    "sense_definition": "To form a friendship or emotional connection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team members began to <w>bond</w> during the weekend retreat in the mountains.",
                            "target_lang_translations": {
                                "ru": "Члены команды начали <w>сближаться</w> во время выездного мероприятия в горах на выходных.",
                                "zh": "团队成员在周末的山区度假中开始<w>建立感情</w>。"
                            }
                        },
                        {
                            "text": "The men had <w>bonded</w> while serving together in Vietnam.",
                            "target_lang_translations": {
                                "ru": "Мужчины <w>сплотились</w> во время совместной службы во Вьетнаме.",
                                "zh": "这些人在越南共同服役期间<w>结下了深厚情谊</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bond with",
                        "bonding time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формировать дружбу или эмоциональную связь.",
                        "zh": "建立友谊或情感上的亲密联系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сближаться",
                                "target_lang_sense_clarification": "устанавливать тесную связь"
                            },
                            {
                                "target_lang_word": "налаживать связь",
                                "target_lang_sense_clarification": "находить общий язык"
                            },
                            {
                                "target_lang_word": "сплотиться",
                                "target_lang_sense_clarification": "стать единым целым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建立感情",
                                "target_lang_sense_clarification": "增进亲密感"
                            },
                            {
                                "target_lang_word": "打成一片",
                                "target_lang_sense_clarification": "变得亲密"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bb6a85f-d2fc-3d60-81e8-bd874cde65f6",
                    "sense_definition": "To cause to adhere (one material with another).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>bonded</w> their snapshots to the scrapbook pages with mucilage.",
                            "target_lang_translations": {
                                "ru": "Дети <w>приклеили</w> свои снимки к страницам альбома с помощью клея.",
                                "zh": "孩子们用胶水把快照<w>粘合</w>在剪贴簿的页面上。"
                            }
                        },
                        {
                            "text": "You need a special adhesive to <w>bond</w> plastic to metal surfaces effectively.",
                            "target_lang_translations": {
                                "ru": "Вам понадобится специальный клей, чтобы эффективно <w>соединить</w> пластик с металлическими поверхностями.",
                                "zh": "你需要一种特殊的粘合剂才能有效地将塑料与金属表面<w>粘合</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stick",
                        "adhere",
                        "glue",
                        "fasten."
                    ],
                    "antonyms": [
                        "separate",
                        "detach"
                    ],
                    "common_phrases": [
                        "bond together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склеивать или соединять один материал с другим.",
                        "zh": "使两种材料粘合在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склеивать",
                                "target_lang_sense_clarification": "соединять клеем"
                            },
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "скреплять поверхности"
                            },
                            {
                                "target_lang_word": "сцеплять",
                                "target_lang_sense_clarification": "обеспечивать адгезию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粘合",
                                "target_lang_sense_clarification": "使物体连接"
                            },
                            {
                                "target_lang_word": "胶合",
                                "target_lang_sense_clarification": "用胶水连接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ed146ea-f71a-3ffb-a8a8-5fb27ad60e8c",
                    "sense_definition": "To form a chemical compound with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under unusual conditions, even gold can be made to <w>bond</w> with other elements.",
                            "target_lang_translations": {
                                "ru": "В необычных условиях даже золото можно заставить <w>связываться</w> с другими элементами.",
                                "zh": "在特殊条件下，即使是黄金也能与其他元素<w>化合</w>。"
                            }
                        },
                        {
                            "text": "Carbon atoms can <w>bond</w> with each other to form long, stable chains.",
                            "target_lang_translations": {
                                "ru": "Атомы углерода могут <w>соединяться</w> друг с другом, образуя длинные стабильные цепи.",
                                "zh": "碳原子可以相互<w>结合</w>，形成长而稳定的链。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bond with"
                    ],
                    "traits": [
                        {
