                                        "entry_id": "1facd5d5-992b-3c85-bd56-d3753b5023c1",
                                        "glosses": [
                                            "mehrere verschiedene größere Raubvögel, Greifvögel aus der Familie der Habichtartigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e6bc6b-84b0-4a2a-98ce-58509f1fa447",
                                                "sense_id": "d3d7382b-d071-3cd9-a14a-0465790cabf0",
                                                "text": "Der junge Adler erhebt sich in die Lüfte."
                                            },
                                            {
                                                "example_id": "8c16cc65-f9cf-4fa9-ab1b-1363933e86ad",
                                                "sense_id": "d3d7382b-d071-3cd9-a14a-0465790cabf0",
                                                "text": "Der Adler, das Symbol der Kühnheit und der Macht, steht auch für den Apostel Johannes."
                                            },
                                            {
                                                "example_id": "582cc7a9-7e76-4a49-ba0e-213ac55f47e6",
                                                "sense_id": "d3d7382b-d071-3cd9-a14a-0465790cabf0",
                                                "text": "„Vielleicht leben die Dorfbewohner mit dem Adler und dem Maulwurf in Symbiose und nutzen sie als Spione.“"
                                            },
                                            {
                                                "example_id": "0af79001-5dcc-4695-84e6-d57dcccbaa3a",
                                                "sense_id": "d3d7382b-d071-3cd9-a14a-0465790cabf0",
                                                "text": "„Vielleicht stehen sie der Adler wegen so unbeweglich da und täuschen eine Geröllhalde vor.“"
                                            },
                                            {
                                                "example_id": "3538eaa3-1dc8-492b-8739-0daf835faf94",
                                                "sense_id": "d3d7382b-d071-3cd9-a14a-0465790cabf0",
                                                "text": "„Der Flieger tauscht die Sicht eines Wurms mit der eines Adlers.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0e4ba73-edb3-3d66-bb48-af156bc08a5e",
                                        "entry_id": "1facd5d5-992b-3c85-bd56-d3753b5023c1",
                                        "glosses": [
                                            "ein Wappentier, und Symbol auf verschiedenen Abzeichen und Münzen"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28c06d0b-a455-49fc-adfd-449630b9cdf0",
                                                "sense_id": "e0e4ba73-edb3-3d66-bb48-af156bc08a5e",
                                                "text": "Das Wappen Brandenburgs trägt in Silber einen goldbewehrten roten Adler."
                                            },
                                            {
                                                "example_id": "f0521623-4e0f-48e4-b616-f8cf473db692",
                                                "sense_id": "e0e4ba73-edb3-3d66-bb48-af156bc08a5e",
                                                "text": "„Ich unterschied einen Adler auf einem Gestrüpp von Kakteen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12c51048-ea71-324e-88c6-229c5d0e4052",
                                        "entry_id": "1facd5d5-992b-3c85-bd56-d3753b5023c1",
                                        "glosses": [
                                            "ein markantes Sternbild des nördlichen Sommer- und Herbsthimmels"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0613330c-f474-4eca-bdd4-fd08f69e3dc8",
                                                "sense_id": "12c51048-ea71-324e-88c6-229c5d0e4052",
                                                "text": "Atair im Adler bildet zusammen mit Wega in der Leier und Deneb im Schwan das „Sommerdreieck“."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ac4db26a-a4dc-3669-b207-cd4ba62fdd16",
                                        "entry_id": "1facd5d5-992b-3c85-bd56-d3753b5023c1",
                                        "glosses": [
                                            "der Titel einer Propagandaillustrierten"
                                        ],
                                        "tags": [
                                            "Journalismus",
                                            "NS-Jargon"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Adler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b80ba3d-39ed-3f73-b086-eb3065b0eced",
                                        "entry_id": "57e7a50d-6637-3dec-a649-9e952708c09e",
                                        "glosses": [
                                            "drei Flüsse in Tschechien (Adler, Stille und Wilde Adler)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13810d8-534e-4b84-8978-c50497a02e93",
                                                "sense_id": "9b80ba3d-39ed-3f73-b086-eb3065b0eced",
                                                "text": "Wir fahren an die Adler."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Adler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75a2b1fb-972a-3839-9fca-6405d874d9eb",
                                        "entry_id": "2d5a759e-ba89-3c39-9195-b153b5f43060",
                                        "glosses": [
                                            "eine russische Kleinstadt im Kaukasus am Schwarzen Meer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "568f049f-6efb-4b3a-bef7-f004992f2f76",
                                                "sense_id": "75a2b1fb-972a-3839-9fca-6405d874d9eb",
                                                "text": "Adler liegt an der georgischen Grenze."
                                            },
                                            {
                                                "example_id": "4955a0a8-1135-425d-b6d8-1077844846b0",
                                                "sense_id": "75a2b1fb-972a-3839-9fca-6405d874d9eb",
                                                "text": "„In Adler befindet sich auch der internationale Flughafen Sotschi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Adler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "331eec34-83a5-3ecb-bc2f-cb094553d46f",
                                        "entry_id": "7c98ab4a-7de3-3ddd-84be-0ead1089c298",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b76854-f419-4621-a741-64abe04758fa",
                                                "sense_id": "331eec34-83a5-3ecb-bc2f-cb094553d46f",
                                                "text": "Frau Adler ist nett."
                                            },
                                            {
                                                "example_id": "5e63a194-be10-406e-97bd-02132dae47f3",
                                                "sense_id": "331eec34-83a5-3ecb-bc2f-cb094553d46f",
                                                "text": "Wir sind heute Abend bei den Adlers eingeladen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
