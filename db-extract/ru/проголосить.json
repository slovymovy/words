                "senses": [
                    {
                        "sense_id": "6ef3269f-cf7e-3f90-8228-c8f8f1e040e7",
                        "entry_id": "c02b3962-09e1-3e49-b0f2-662761ae464d",
                        "glosses": [
                            "вывести голосом, протяжно пропеть, прозвучать, прокричать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e532dbca-3fdb-4816-989d-1c3affa00d5a",
                                "sense_id": "6ef3269f-cf7e-3f90-8228-c8f8f1e040e7",
                                "text": "В свое время проголосил проповедь, выходил на молебен, у Владыки закусывал и в трапезе обедал."
                            },
                            {
                                "example_id": "5de0f625-ac85-471c-b6df-6d6115dd9535",
                                "sense_id": "6ef3269f-cf7e-3f90-8228-c8f8f1e040e7",
                                "text": "Зычный рог, зычный: уставься на небо и голоси, и проголоси."
                            },
                            {
                                "example_id": "6f90f5e7-8d4b-49d0-9aa1-098ddf4de190",
                                "sense_id": "6ef3269f-cf7e-3f90-8228-c8f8f1e040e7",
                                "text": "― Здорово, кумушка! ― проголосили женщины и остановились."
                            },
                            {
                                "example_id": "efad4480-d666-4391-8d39-cbacef44653b",
                                "sense_id": "6ef3269f-cf7e-3f90-8228-c8f8f1e040e7",
                                "text": "Где-то проголосил петух."
                            }
                        ]
                    },
