{
    "word_family": [
        "philanthropic",
        "philanthropically",
        "philanthropist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2051db0b-424f-33b7-a669-32e7cb769da4",
                    "sense_definition": "The practice of donating money, resources, or time to charitable causes.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "charity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new museum wing was built entirely through private <w>philanthropy</w>.",
                            "target_lang_translations": {
                                "cs": "Nové křídlo muzea bylo postaveno výhradně díky soukromé <w>filantropii</w>."
                            }
                        },
                        {
                            "text": "Many wealthy business leaders devote their later years to corporate <w>philanthropy</w>.",
                            "target_lang_translations": {
                                "cs": "Mnoho bohatých podnikatelů se ve stáří věnuje firemní <w>dobročinnosti</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corporate philanthropy",
                        "private philanthropy"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost spočívající v darování peněz, zdrojů nebo času na dobročinné účely."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "filantropie",
                                "target_lang_sense_clarification": "dárcovství a dobročinná činnost"
                            },
                            {
                                "target_lang_word": "dobročinnost",
                                "target_lang_sense_clarification": "poskytování pomoci a darů"
                            },
                            {
                                "target_lang_word": "charita",
                                "target_lang_sense_clarification": "pomoc potřebným"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "103c2ff2-22d8-3296-a951-7d84705950fb",
                    "sense_definition": "A benevolent desire to improve the well-being and happiness of humankind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "charity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His lifelong work with the homeless was driven by genuine <w>philanthropy</w>.",
                            "target_lang_translations": {
                                "cs": "Jeho celoživotní práce s lidmi bez domova byla poháněna opravdovou <w>lidumilností</w>."
                            }
                        },
                        {
                            "text": "The founder believed that true <w>philanthropy</w> requires personal sacrifice and empathy.",
                            "target_lang_translations": {
                                "cs": "Zakladatel věřil, že skutečná <w>filantropie</w> vyžaduje osobní oběť a empatii."
                            }
                        }
                    ],
                    "synonyms": [
                        "philanthropism"
                    ],
                    "antonyms": [
                        "misanthropy"
                    ],
                    "target_lang_definitions": {
                        "cs": "Láska k lidem a nezištná touha zlepšovat životní podmínky a štěstí lidstva."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "filantropie",
                                "target_lang_sense_clarification": "lidumilnost, láska k člověku"
                            },
                            {
                                "target_lang_word": "lidumilnost",
                                "target_lang_sense_clarification": "vřelý a soucitný vztah k lidem"
                            },
                            {
                                "target_lang_word": "lidumilství",
                                "target_lang_sense_clarification": "snaha prospívat lidstvu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b736f36-5532-339f-b713-a063d6385e19",
                    "sense_definition": "An organization or foundation dedicated to charitable work and funding good causes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several major <w>philanthropies</w> joined forces to finance the global health project.",
                            "target_lang_translations": {
                                "cs": "Několik významných <w>charitativních organizací</w> spojilo své síly, aby financovalo tento globální zdravotnický projekt."
                            }
                        },
                        {
                            "text": "He managed a family <w>philanthropy</w> that supported local schools and libraries.",
                            "target_lang_translations": {
                                "cs": "Řídil rodinnou <w>nadaci</w>, která podporovala místní školy a knihovny."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Organizace nebo nadace věnující se dobročinné činnosti a financování prospěšných projektů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "charitativní organizace",
                                "target_lang_sense_clarification": "nezisková dobročinná organizace"
                            },
                            {
                                "target_lang_word": "nadace",
                                "target_lang_sense_clarification": "instituce spravující a rozdělující finanční dary"
                            },
                            {
                                "target_lang_word": "dobročinná organizace",
                                "target_lang_sense_clarification": "instituce pomáhající potřebným"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50d77793-7366-3430-a366-32ddf50c3830",
                    "sense_definition": "A specific act of charity or generous giving.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "charity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her quiet <w>philanthropies</w> provided food and medicine to struggling families each winter.",
                            "target_lang_translations": {
                                "cs": "Její nenápadné <w>dobročinné skutky</w> zajišťovaly potřebným rodinám každou zimu jídlo a léky."
                            }
                        },
                        {
                            "text": "The mayor praised the industrialist for his many <w>philanthropies</w> toward the city.",
                            "target_lang_translations": {
                                "cs": "Starosta ocenil tohoto průmyslníka za jeho četné <w>dary</w> městu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Jednotlivý dobročinný skutek nebo projev štědrosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dobročinný skutek",
                                "target_lang_sense_clarification": "jednotlivý projev pomoci či daru"
                            },
                            {
                                "target_lang_word": "dar",
                                "target_lang_sense_clarification": "finanční nebo materiální příspěvek"
                            },
                            {
                                "target_lang_word": "příspěvek",
                                "target_lang_sense_clarification": "charitativní finanční podpora"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}