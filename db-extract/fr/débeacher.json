                "senses": [
                    {
                        "sense_id": "8764f5b2-4e22-33da-82d6-492629ee3de2",
                        "entry_id": "e630b13c-57da-3954-9dd0-b2fceeef96a1",
                        "glosses": [
                            "Remettre à l’eau (un bateau échoué sur la plage)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a05fdf3-d030-475f-a53d-703cffef7ef5",
                                "sense_id": "8764f5b2-4e22-33da-82d6-492629ee3de2",
                                "text": "Cela m’est arrivé une fois en opération : quand j’ai voulu débeacher, je suis resté collé à la vase, la marée ayant baissé."
                            },
                            {
                                "example_id": "68a1ec04-832e-4d2b-8ac4-e089ffbfd792",
                                "sense_id": "8764f5b2-4e22-33da-82d6-492629ee3de2",
                                "text": "Nous apprenons qu’il n’en a pas été de même du côté de Phat Diem, où les derniers engins ont dû débeacher sous le feu des Viets, (…)"
                            }
                        ]
                    }
