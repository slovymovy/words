    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7abad8a8-e94d-356c-a248-badb17c058ad",
                    "sense_definition": "Rassembler des personnes ou des troupes dispersées.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'attaque surprise, l'officier a réussi à <w>rallier</w> les troupes dispersées dans la forêt."
                        },
                        {
                            "text": "Le guide a sifflé fort pour <w>rallier</w> les marcheurs distraits qui s'écartaient du sentier."
                        }
                    ],
                    "synonyms": [
                        "rassembler",
                        "regrouper",
                        "réunir"
                    ],
                    "antonyms": [
                        "disperser",
                        "éparpiller"
                    ],
                    "common_phrases": [
                        "rallier les troupes",
                        "rallier ses partisans"
                    ]
                },
                {
                    "sense_id": "bb8a8f4d-2338-3ab4-bc20-f05857b470b8",
                    "sense_definition": "Amener des personnes à partager une opinion ou à donner leur adhésion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet novateur a rapidement su <w>rallier</w> les suffrages de tous les membres du comité."
                        },
                        {
                            "text": "Son discours particulièrement convaincant a permis de <w>rallier</w> les plus indécis de l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "convaincre",
                        "séduire"
                    ],
                    "common_phrases": [
                        "rallier les suffrages",
                        "rallier une majorité"
                    ]
                },
                {
                    "sense_id": "0fec244e-d254-35dd-a90f-9db6340f830b",
                    "sense_definition": "Adhérer à un avis, à un parti ou à une proposition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues délibérations, le groupe a décidé de se <w>rallier</w> à votre avis."
                        },
                        {
                            "text": "Plusieurs personnalités influentes ont choisi de se <w>rallier</w> à cette noble cause."
                        }
                    ],
                    "synonyms": [
                        "adhérer",
                        "souscrire"
                    ],
                    "antonyms": [
                        "s'opposer",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "se rallier à un avis",
                        "se rallier à une cause"
                    ]
                },
                {
                    "sense_id": "89ee3c23-30e2-3027-a432-fe85f1d8ace6",
                    "sense_definition": "Parvenir à atteindre un lieu ou à rejoindre un groupe après un déplacement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la mer démontée, le navire en détresse a pu <w>rallier</w> le port en toute sécurité."
                        },
                        {
                            "text": "Les coureurs épuisés ont dû faire de gros efforts pour <w>rallier</w> l'arrivée avant la tombée du jour."
                        }
                    ],
                    "synonyms": [
                        "rejoindre",
                        "atteindre"
                    ],
                    "antonyms": [
                        "quitter"
                    ],
                    "common_phrases": [
                        "rallier le port",
                        "rallier la côte"
                    ]
                }
            ]
        }
    ]
}