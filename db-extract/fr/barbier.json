                                        ],
                                        "examples": [
                                            {
                                                "example_id": "914e457e-b1cf-41b0-96a5-c9d84be2f64a",
                                                "sense_id": "0bf9a009-3306-373d-b188-3804340e915c",
                                                "text": "Spotkany jeździec był rzeczywiście golarzem, skrobał brody w dwóch wsiach sąsiednich i teraz właśnie jechał z jednej wsi do drugiej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b57e6344-f17a-4409-94f5-98f426c02777",
                        "source_entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "target_lang_word": "парикмахер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "парикмахер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b96fb997-77a1-37af-a14c-9235eddd8763",
                                        "entry_id": "a6ebbc17-97cd-3f9e-a563-16ee089dadd1",
                                        "glosses": [
                                            "человек, стригущий другим волосы, делающий причёски"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e888dc9-abc9-4b13-ad22-91c307851e4d",
                                                "sense_id": "b96fb997-77a1-37af-a14c-9235eddd8763",
                                                "text": "Парикмахер, совсем ещё мальчик, меня подстриг и начал готовить бритвы, но я отказался."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0ecf060-6f6c-4a09-9752-9d332b170d2a",
                        "source_entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "target_lang_word": "цирюльник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цирюльник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                        "entry_id": "f5956900-18dc-3327-ab1c-d479e395f2c5",
                                        "glosses": [
                                            "устар. парикмахер (часто владевший также элементарными приёмами врачевания)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f35db31b-6fc3-46df-94f7-0d4077baea5a",
                                                "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                                "text": "Те же парикмахеры были цирюльниками, фельдшерами, брили бороду, пускали кровь разными манерами, а подчас выдёргивали и зубы."
                                            },
                                            {
                                                "example_id": "142fddf3-8862-4163-9f63-46083986b0ca",
                                                "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                                "text": "Меня лечил полковой цирюльник, ибо в крепости другого лекаря не было, и, слава богу, не умничал."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
