                                "target_lang_word": "打扮",
                                "target_lang_sense_clarification": "指精心装扮"
                            },
                            {
                                "target_lang_word": "盛装",
                                "target_lang_sense_clarification": "指穿得华丽"
                            }
                        ]
                    }
