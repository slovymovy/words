                ],
                "senses": [
                    {
                        "sense_id": "83bbe5ac-0f8b-3d71-b0f3-26450bd5a112",
                        "entry_id": "2db897db-e070-3335-a0c5-f9619aede85f",
                        "glosses": [
                            "Typ des Einflusses, dem das Wetter unterliegt, zyklonal geprägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef4a629-8a4c-4c99-ae3b-ec3a70216489",
                                "sense_id": "83bbe5ac-0f8b-3d71-b0f3-26450bd5a112",
                                "text": "„Die in den Wetterkarten (Höhenanalysen) den Bereich von Höhentrögen kennzeichnenden Isohypsen sind zyklonal gekrümmt. Diese Zyklonalität unterstützt das Auftreten konvektiver Bewölkung, die unter Umständen mit Schauern und/oder Gewittern verbunden sein kann.“"
                            },
                            {
                                "example_id": "b6302480-9674-4e70-95b6-167c3516eb51",
                                "sense_id": "83bbe5ac-0f8b-3d71-b0f3-26450bd5a112",
                                "text": "„Aus der Bewertung (z.B. trocken/feucht beim Feuchteindex) und der Kombination der Indizes (Wind, Zyklonalität, Feuchte) ergibt sich dann die jeweilige Wetterlagenklasse.“"
                            },
                            {
                                "example_id": "138205fe-0a10-4e5b-a11d-672c7417629a",
                                "sense_id": "83bbe5ac-0f8b-3d71-b0f3-26450bd5a112",
                                "text": "„Diese Tendenz zu bestimmten Eigenschaften bezüglich der Feuchte und der Zyklonalität kann schließlich auch eine geringere Variabilität der Wasserhaushaltsgrößen bewirken.“"
                            },
                            {
                                "example_id": "c09e1f73-8b96-4ba0-ad9b-2a8b4067479a",
                                "sense_id": "83bbe5ac-0f8b-3d71-b0f3-26450bd5a112",
                                "text": "„Als meteorologische Kriterien werden Windrichtung, Zyklonalität und Feuchtigkeit der Atmosphäre verwendet (Bissolli und Dittmann, 2001).“"
                            },
                            {
                                "example_id": "84b8ad71-83af-4b9c-a217-60d98c38e362",
                                "sense_id": "83bbe5ac-0f8b-3d71-b0f3-26450bd5a112",
                                "text": "„Die winterliche Zyklonalität nahm besonders im westlichen, mittleren und südlichen Europa stark zu und die ‚Hochdruckbrücke‘ Azoren-Alpen-Ukraine schwächte sich weitgehend ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
