                        "glosses": [
                            "Crécerelle d’Amérique (espèce de faucon, de nom scientifique Falco sparverius)."
                        ],
                        "tags": [
                            "Guadeloupe"
                        ],
                        "examples": [
                            {
                                "example_id": "95ba3a50-3611-42cd-a5d8-453046174056",
                                "sense_id": "36989dfb-adec-369b-99d3-bb1798be3c67",
                                "text": "Si tu ne veux pas manger de saletés, tu ne vas pas à la noce du gligli (sorte d’épervier peu délicat sur la nourriture)."
                            },
                            {
                                "example_id": "106a3ac4-7f26-48d5-a9e3-d7c8e5ddcf1e",
                                "sense_id": "36989dfb-adec-369b-99d3-bb1798be3c67",
                                "text": "Grande Anse, nous assistons à la parade d'un gligli qui pose du haut de sa branche pour nous!"
                            },
                            {
                                "example_id": "4a61440b-3790-46da-b40d-fb4d1c1acc5d",
                                "sense_id": "36989dfb-adec-369b-99d3-bb1798be3c67",
                                "text": "Là-haut, un faucon crécerelle, un Gligli, nous surveille."
                            },
                            {
                                "example_id": "a8f8fa06-ce3e-48e8-ac1a-57c21b235404",
                                "sense_id": "36989dfb-adec-369b-99d3-bb1798be3c67",
                                "text": "Il était surmonté d'un oiseau de proie empaillé représentant pour les bonapartistes un aigle et pour les royalistes un gligli."
                            }
                        ]
                    }
