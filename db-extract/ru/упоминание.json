                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25d882db-74a2-3804-8ef6-71832b00a8a6",
                                        "entry_id": "0073923c-8f12-3e1b-a66a-8e51344e6aae",
                                        "glosses": [
                                            "present participle and gerund of mention"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
