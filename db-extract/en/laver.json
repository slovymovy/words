                        "entry_id": "798300e1-b895-3e9e-a481-40099a1774bf",
                        "glosses": [
                            "Where one laves, a washroom, particularly a lavatorium, the washing area in a monastery."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b2e24cb-b1bc-3cea-bbae-912da6a61581",
                        "entry_id": "798300e1-b895-3e9e-a481-40099a1774bf",
                        "glosses": [
                            "That which laves, particularly a washbasin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4968fbd-e873-4af4-80d9-9f49ccfbb628",
                                "sense_id": "2b2e24cb-b1bc-3cea-bbae-912da6a61581",
                                "text": "Infinit streames continually did well / Out of this fountaine, sweet and faire to see, / The which into an ample lauer fell […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1050c23d-5237-4f1e-8b92-5c1bafc763dd",
                        "source_entry_id": "798300e1-b895-3e9e-a481-40099a1774bf",
                        "source_sense_description": "a washroom; lavatorium",
                        "target_lang_word": "Waschraum",
                        "target_lang_code": "de",
                        "note": "general term",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                        "entry_id": "df56888c-3fac-3cee-8540-d2d152e8257c",
                                        "glosses": [
                                            "ein Raum mit Waschstellen; Raum, in dem Personen sich waschen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857aa2c3-2c11-445b-bc35-80336e0aaa42",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Der Waschraum ist vier Baracken von unserer entfernt, aber die Wasserleitung ist vorläufig eingefroren.“"
                                            },
                                            {
                                                "example_id": "dc601177-e405-4aa1-9fd7-1842e28fc134",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Alf kam aus dem Waschraum hervor, lärmend, düster, geladen.“"
                                            },
                                            {
                                                "example_id": "33ab97bd-7124-4dd3-8519-40380776bf80",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Dann ging ich in den Waschraum und schüttete das kühle Wasser über mich.“"
                                            },
                                            {
                                                "example_id": "96849622-ced6-4af3-b9b6-9e1c3c0e14e2",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Reidel war so überrascht gewesen, daß er sich umgedreht und den Waschraum verlassen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d7025a2-c589-46d2-953c-86d8656ed059",
