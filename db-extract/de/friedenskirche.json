                        "glosses": [
                            "Im Westfälischen Frieden den Protestanten vor allem in Schlesien zugestandene Kirchengebäude z. B. in Glogau, Schweidnitz und Jauer"
                        ],
                        "tags": [
                            "Gebäude"
                        ],
