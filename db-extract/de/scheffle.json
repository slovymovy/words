                ],
                "senses": [
                    {
                        "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                        "entry_id": "6b94223a-91e1-3e0a-9034-d52a4c12e302",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ad5cb87-fe09-43a3-9211-515cb9b451c4",
                                "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                                "text": "Frau Scheffle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e74ce783-4d49-43e1-bd25-eba497737ed2",
                                "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                                "text": "Herr Scheffle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "96ec8ca1-c9b4-44cc-b25c-62600edc8ac9",
                                "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                                "text": "Die Scheffles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "727a7905-88a6-43ce-ab66-05464969796e",
                                "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                                "text": "Der Scheffle trägt nie die Schals, die die Scheffle ihm strickt."
                            },
                            {
                                "example_id": "6d54d620-8dd2-4cbe-ad63-120208dd3bc4",
                                "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheffle kommt, geht der Herr Scheffle.“"
                            },
                            {
                                "example_id": "ec029fde-653c-40d2-8b27-835326aa67dd",
                                "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                                "text": "Scheffle kommt und geht."
                            },
                            {
                                "example_id": "637ed949-dae4-484d-a855-46185f5f32f1",
                                "sense_id": "4dc621e6-4c3d-30b4-b39b-0d42a52e9654",
                                "text": "Scheffles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
