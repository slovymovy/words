                    },
                    {
                        "translation_id": "8fbfcf20-29b8-4e54-9e5c-dbc449f25a83",
                        "source_entry_id": "0828beda-3c42-3e4e-8db6-ba15fb8777f1",
                        "source_sense_id": "e42791b4-ad6f-350c-a80e-67cd5717f54b",
                        "target_lang_word": "saharský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saharský",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5a342969-3c12-3b71-98ea-71e0c304b66b",
                                        "entry_id": "1bd87194-a254-3183-a023-5bc29fea4b48",
                                        "glosses": [
                                            "související se Saharou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a056fb-0efe-4927-9b2e-87fb7b8ed0be",
                                                "sense_id": "5a342969-3c12-3b71-98ea-71e0c304b66b",
                                                "text": "Jako poutník bloudící po poušti saharské s toužebností hledí, kdy zelený trávník uvidí, tak hledím i já, kdy sníh roztaje a kvítí se probudí, abych své ubohé dítě na boží světlo poslala a sama též okřála."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f33dadf-ad36-41db-b4ed-f50745d18fde",
                        "source_entry_id": "0828beda-3c42-3e4e-8db6-ba15fb8777f1",
                        "source_sense_id": "e42791b4-ad6f-350c-a80e-67cd5717f54b",
                        "target_lang_word": "saharien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saharien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99403cea-a51b-3332-8085-0f7e8a891333",
                                        "entry_id": "d612b61b-47d9-3305-960c-f2946f8be3e7",
                                        "glosses": [
                                            "Relatif au Sahara et à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0832cf0-ef9c-42c4-b6ce-167b3f019718",
                                                "sense_id": "99403cea-a51b-3332-8085-0f7e8a891333",
                                                "text": "Ses plages s’étendent sans aucune courbure, droites, infinies, et les brisants de la mer, arrêtés par rien, aussi majestueux qu’à la côte saharienne, y déroulent, sur des lieues de longueur, avec de grands bruits, leur tristes volutes blanches."
                                            },
                                            {
                                                "example_id": "66c15849-ed7f-4362-8179-3ab655f7a151",
                                                "sense_id": "99403cea-a51b-3332-8085-0f7e8a891333",
                                                "text": "A Beduaram il entre dans cette vaste et monotone plaine saharienne, sans végétation et où l’empreinte même de l'animal ne laisse qu'une trace insensible que le moindre vent efface."
                                            },
                                            {
                                                "example_id": "d3354738-0cee-4154-8b6b-279cb60db756",
                                                "sense_id": "99403cea-a51b-3332-8085-0f7e8a891333",
                                                "text": "Et Yasmina s’en revenait en chantant une complainte saharienne, apprise de son frère Slimène qui était venu en congé un an auparavant, et qu'elle aimait beaucoup."
                                            },
                                            {
                                                "example_id": "51c90e37-2366-4998-9b22-72859a4a26f5",
                                                "sense_id": "99403cea-a51b-3332-8085-0f7e8a891333",
                                                "text": "Travaillé à mes dialogues par une température saharienne (je dis bien saharienne, car on nous apprend qu’à El Goléa, il fait deux degrés de moins qu’à Paris !)."
                                            },
                                            {
                                                "example_id": "0264e1e9-8d7d-414a-ba24-9979718f35e0",
                                                "sense_id": "99403cea-a51b-3332-8085-0f7e8a891333",
                                                "text": "Le réseau saharien draine l’ensemble des esclaves razziés ou achetés en Afrique de l’Ouest…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
