                        ],
                        "examples": [
                            {
                                "example_id": "a66e5e57-f4c9-4cc1-bb93-25def89db5b4",
                                "sense_id": "c4185130-23b2-3aba-a307-d0fa4c1f7a32",
                                "text": "Ils sont les figures de proue d'un mouvement diffus d'anti-féministes de tous poils qui a trouvé, par la Toile, un exutoire à ses frustrations: la manosphère, contraction de «man» et de «blogosphère».",
                                "translation": "They are leading figures in a diffuse movement of anti-feminists who have found, in the Web, an outlet for their frustrations: the manosphere, a contraction of \"man\" and \"blogosphere\".",
                                "english": "They are leading figures in a diffuse movement of anti-feminists who have found, in the Web, an outlet for their frustrations: the manosphere, a contraction of \"man\" and \"blogosphere\"."
                            }
                        ]
