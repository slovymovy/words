                                "example_id": "fbeea0ed-c71c-4b5d-badf-d0bd2376f436",
                                "sense_id": "2fa2abf9-7e79-3d60-b701-333cd595e1e5",
                                "text": "Pour frapper le lecteur désarroyé par tant de renseignements d'importance différente, il a bien fallu lui signaler les événements les plus graves ou les faits les plus notoires."
                            },
                            {
                                "example_id": "ce2563f6-16c0-4713-a900-10cfe401d0a6",
                                "sense_id": "2fa2abf9-7e79-3d60-b701-333cd595e1e5",
                                "text": "La tragédie régénérait sa flamme. À la fois désarroyé et transpercé de plaisir, le Zèbre se sentait un acteur entrant en scène."
                            },
                            {
                                "example_id": "64e62610-7bec-4866-9d8e-e668a7fbff4b",
                                "sense_id": "2fa2abf9-7e79-3d60-b701-333cd595e1e5",
                                "text": "Il avait surgi de l’abîme, le cœur désarroyé."
                            }
                        ]
