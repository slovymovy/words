                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student <w>furtively</w> glanced at his notes during the exam.",
                            "target_lang_translations": {
                                "nl": "De student wierp tijdens het examen <w>stiekem</w> een blik op zijn aantekeningen."
                            }
                        },
                        {
                            "text": "She <w>furtively</w> looked around to ensure no one was watching her.",
                            "target_lang_translations": {
                                "nl": "Ze keek <w>heimelijk</w> om zich heen om te controleren of niemand naar haar keek."
                            }
                        }
                    ],
                    "synonyms": [
                        "secretively",
                        "surreptitiously"
                    ],
                    "common_phrases": [
                        "glance furtively",
                        "look furtively"
                    ],
