                        "entry_id": "65ffda1b-4961-3ea1-9aee-c66c6c8cf283",
                        "glosses": [
                            "Donner un caractère physique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9a12797-d152-407f-a519-bdcaaf33d2a2",
                                "sense_id": "545b663d-197f-3905-8e9a-e7086fe84c64",
                                "text": "Après avoir matérialisé le psychique statique (la mémoire) par le langage et l’écriture, voilà le moyen de matérialiser et de physiciser le processus lui-même (le psychique dynamique, la pensée et ses mécanismes intimes)."
                            },
                            {
                                "example_id": "9c8d2341-520d-49a3-8f65-82a8bcf66183",
                                "sense_id": "545b663d-197f-3905-8e9a-e7086fe84c64",
                                "text": "Saint-Simon ne souhaite ni « physiciser » ni « biologiser » l’ordre social."
                            }
                        ]
                    }
