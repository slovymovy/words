                "senses": [
                    {
                        "sense_id": "05179ee7-3d5f-3c9d-8655-2d044a175515",
                        "entry_id": "e0110c0a-25e5-373c-94c2-c8827d12ef26",
                        "glosses": [
                            "eine Lampe, die über die eingesetzte Energie fluoreszierende Beläge oder Gase zum Leuchten bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45227825-297a-4939-8b5c-6697d323818d",
                                "sense_id": "05179ee7-3d5f-3c9d-8655-2d044a175515",
                                "text": "Leuchtstofflampen weisen eine bessere Lichtausbeute als Glühlampen auf."
                            },
                            {
                                "example_id": "04160541-47f0-44df-ac31-f37e2031d09c",
                                "sense_id": "05179ee7-3d5f-3c9d-8655-2d044a175515",
                                "text": "Leuchtstofflampen stellen nur eine Brückentechnologie auf dem Weg zur LED-Beleuchtungstechnik dar."
                            },
                            {
                                "example_id": "a8e57644-c30a-437c-b3b8-c4f5a53ac6e7",
                                "sense_id": "05179ee7-3d5f-3c9d-8655-2d044a175515",
                                "text": "Das Quecksilber in Leuchtstofflampen ist giftig für Mensch und Umwelt."
                            },
                            {
                                "example_id": "f18329a9-3f9f-441e-846d-a6775f12018e",
                                "sense_id": "05179ee7-3d5f-3c9d-8655-2d044a175515",
                                "text": "Leuchtstofflampen dürfen nur mit einer Drossel oder einem Vorwiderstand betrieben werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
