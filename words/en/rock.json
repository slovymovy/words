                                "target_lang_sense_clarification": "выставлять напоказ стильную вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35cac051-ca62-374b-b7bb-c11ba1799df2",
                    "sense_definition": "To disturb the emotional equilibrium of; to distress; to greatly impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the accident <w>rocked</w> the entire community.",
                            "target_lang_translations": {
                                "ru": "Новости об аварии <w>потрясли</w> все сообщество."
                            }
                        },
                        {
                            "text": "She <w>rocked</w> my world when she told me the truth.",
                            "target_lang_translations": {
                                "ru": "Она <w>перевернула</w> мой мир, когда рассказала мне правду."
                            }
                        }
