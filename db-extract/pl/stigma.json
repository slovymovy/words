                    },
                    {
                        "translation_id": "b519812d-7bb1-434f-8157-e7e97ea0499e",
                        "source_entry_id": "c6ab9438-4173-377f-9712-3bcf2ad339cf",
                        "source_sense_id": "22a6d479-c8aa-3a2d-a1c8-a7e107f3a350",
                        "target_lang_word": "stigma",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stigma",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9e3524-1466-3331-9620-2863dd6e9f49",
                                        "entry_id": "a78eb07e-889c-32ec-8f3d-47de5d595cea",
                                        "glosses": [
                                            "ϛ, Ϛ, ancienne ligature de l’alphabet grec notant le groupe στ (sigma-tau), qui ne s’est conservée dans l’écriture actuelle que pour la numération alphabétique milésienne où elle vaut 6."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71de7a93-7720-402d-b6c4-2f282adef321",
                                                "sense_id": "3a9e3524-1466-3331-9620-2863dd6e9f49",
                                                "text": "Un caillot sanguin, pas plus gros qu’un rubis coagulait sur son articulation, tout autour d’un stigma blafard, au contour ovoïdal, marquant l’incrustation du Zahir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stigma",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f04937-3bc1-34da-8d48-d61679483b53",
                                        "entry_id": "05abd2e9-7105-3ada-936b-580885d5edd0",
                                        "glosses": [
                                            "Ancienne unité de mesure de longueur, équivalent du picomètre, proposée mais presque pas usitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "577fead5-9d8b-438e-952b-7a001e260bc9",
                                                "sense_id": "f1f04937-3bc1-34da-8d48-d61679483b53",
                                                "text": "Un système plus cohérent et plus souple pourrait être obtenu en adoptant deux unités secondaires nouvelles, respectivement égales à 10¹² et 10⁻¹² mètres, et en leur adjoignant lès préfixes usuels. Nous proposons d’attribuer à ces unités les noms de spat (spatium = espace) et de stigma (στιγμα = point)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2b7b838-9ab1-4e58-8b21-895717c0701c",
                        "source_entry_id": "c6ab9438-4173-377f-9712-3bcf2ad339cf",
                        "source_sense_id": "22a6d479-c8aa-3a2d-a1c8-a7e107f3a350",
