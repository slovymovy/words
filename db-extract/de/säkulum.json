                                "target_senses": [
                                    {
                                        "sense_id": "9d3de282-730b-31a3-a060-c988915d466a",
                                        "entry_id": "a34c9c8f-7515-3ab9-9d8b-07147aa63220",
                                        "glosses": [
                                            "een periode van 100 jaar"
                                        ],
                                        "tags": [
                                            "tijdrekening"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67b761ce-1ba6-4c32-94fe-78c1bb16ef24",
                                                "sense_id": "9d3de282-730b-31a3-a060-c988915d466a",
                                                "text": "Op 1 januari 2001 begon de 21e eeuw."
                                            },
                                            {
                                                "example_id": "7b0343b8-f2b3-4391-9d5b-0d7f31126b37",
                                                "sense_id": "9d3de282-730b-31a3-a060-c988915d466a",
                                                "text": "Ze zou net als haar voorgangers uit de 17de eeuw ook wel een frisse duik willen nemen, maar voorlopig volstaan gulzige slokken uit haar bidon."
                                            },
                                            {
                                                "example_id": "5a6c8f51-0eef-4b1a-ad04-193c99f7a93a",
                                                "sense_id": "9d3de282-730b-31a3-a060-c988915d466a",
                                                "text": "In de vorige eeuw waren er twee wereldoorlogen. Een oorlog heet een wereldoorlog als er heel veel landen aan meedoen. Aan de Eerste Wereldoorlog deed Nederland niet mee. Maar aan de Tweede Wereldoorlog wel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41da4923-509e-359d-9a31-08978027bc80",
                                        "entry_id": "a34c9c8f-7515-3ab9-9d8b-07147aa63220",
                                        "glosses": [
                                            "iets wat zeer lang duurt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9387e15e-6ab8-4e8c-862a-0bb7c6cc8cf5",
                                                "sense_id": "41da4923-509e-359d-9a31-08978027bc80",
                                                "text": "Het duurde eeuwen voordat de vrouwen eindelijk klaar waren met het telefoongesprek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a9419c9-4556-4f03-b256-d74a31544ef4",
                        "source_entry_id": "80ac2c72-e88a-3df7-bc2d-76f5bb96eb75",
                        "source_sense_id": "b9b5f44a-29da-37bb-b7f8-d561f6605a96",
