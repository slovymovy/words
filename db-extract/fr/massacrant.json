                "senses": [
                    {
                        "sense_id": "40c40b60-8753-3999-b4c6-bfbdc6786886",
                        "entry_id": "8683ca77-6ff4-3571-a6a5-4e0d4923076f",
                        "glosses": [
                            "Qui semble vouloir tout massacrer, qui est bourru, grondeur."
                        ],
                        "tags": [],
                        "note": "Il ne s’emploie guère que dans le langage familier avec le mot humeur",
                        "examples": [
                            {
                                "example_id": "4cc055c9-afba-40e6-b466-432ca2f282be",
                                "sense_id": "40c40b60-8753-3999-b4c6-bfbdc6786886",
                                "text": "Messire Robert d’Estouteville s’était éveillé le matin du 7 janvier 1482 fort bourru et de massacrante humeur."
                            },
                            {
                                "example_id": "22d6bca1-b524-457b-bdbc-3f6ffe25ab6b",
                                "sense_id": "40c40b60-8753-3999-b4c6-bfbdc6786886",
                                "text": "Ce jour-là, M. Toutin-Laroche, d’ordinaire très désagréable pour ses collègues, était d’une humeur plus massacrante encore que de coutume."
                            },
                            {
                                "example_id": "43457723-1e3b-426b-89d5-1629c093d9fc",
                                "sense_id": "40c40b60-8753-3999-b4c6-bfbdc6786886",
                                "text": "« Papa a mauvais caractère. Papa se fâche pour rien. Papa est souvent d’une humeur massacrante. »"
                            }
                        ]
                    }
                ],
