                ],
                "senses": [
                    {
                        "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                        "entry_id": "a40661f7-5edd-30ce-a739-3ece0973b4da",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname; zweithäufigster Nachname in Österreich; häufig in Bayern und Baden-Württemberg, aber in ganz Deutschland und auch in fast ganz Europa vertreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce3e825f-245a-4463-a7e0-7f0758783d29",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Der Huber trägt nie die Pullover, die die Huber ihm strickt."
                            },
                            {
                                "example_id": "1ac8bd78-2ee3-4377-b78a-e773a6292b5f",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Huber kommt, geht der Herr Huber.“"
                            },
                            {
                                "example_id": "c1a4aa76-db8e-49b3-bcdf-4eb44a75bc12",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Huber kommt und geht."
                            },
                            {
                                "example_id": "6869903f-fbb1-4854-afe8-f466e0b4b759",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                            },
                            {
                                "example_id": "f0787707-5109-42ac-9e31-fac39b41820c",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Frau Huber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "32a806fb-2afd-437a-955a-ab536dc89a2d",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Herr Huber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "da3f94b7-23f0-4ec7-840b-4d88b61964fc",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Die Hubers fliegen heute nach Punta Arenas."
                            },
                            {
                                "example_id": "95a86ae3-0c47-44fc-a333-e33abae7e02f",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Hubers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "adc6d2a3-44b9-4782-9a59-05ea8883e486",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "Die meisten Huber im Ort hießen Huber."
                            },
                            {
                                "example_id": "b15bdc37-99c7-4cde-a727-d442182d0e29",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "An verregneten Herbsttagen ist Familie Hubers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "c2b84a5b-b607-4673-8a1e-51d551df65f2",
                                "sense_id": "d1638258-96a2-304b-ac08-8fbf40669006",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Huber das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
