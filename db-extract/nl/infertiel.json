                        "source_sense_id": "4e8c61bc-dc4d-371d-9093-e31b1e3f4235",
                        "source_sense_description": "het zich niet kunnen voortplanten bij dieren en planten",
                        "target_lang_word": "infértil",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infértil",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6d82b68e-b273-309f-8e24-167c19dfede8",
                                        "entry_id": "c26b01ac-f06e-3017-8260-3389a26edfec",
                                        "glosses": [
                                            "Dicho de un terreno, que no produce cosecha o fruto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad876dd3-cb0d-4b1e-9937-f350ce486975",
                                                "sense_id": "6d82b68e-b273-309f-8e24-167c19dfede8",
                                                "text": "Tal vez seguía en el infierno, la diferencia era que ahora ella me había enseñado a vivir en él. A ver que aún en un lugar tan despiadado se puede ser feliz, a ver que incluso en suelo infértil pueden crecer algunas flores"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0e3e290-0215-38f5-9767-dd41df147bf7",
                                        "entry_id": "c26b01ac-f06e-3017-8260-3389a26edfec",
                                        "glosses": [
                                            "Que no se puede reproducir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcaf37da-a614-4761-b824-856f536439d5",
                                                "sense_id": "b0e3e290-0215-38f5-9767-dd41df147bf7",
                                                "text": "Y sabíamos que había algunas ovejas que no habían tenido crías que se llamaban las machorras: entonces la machona era para nosotros un símbolo de mujer infértil"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
