                "senses": [
                    {
                        "sense_id": "f15096c2-9285-31fc-8dd1-637c07ea2abd",
                        "entry_id": "fd9ecc7a-c424-3c54-b90c-2e5f56491948",
                        "glosses": [
                            "deutsche Bezeichnung für Autosemantikum: Bezeichnung für Wörter, die eine eigenständige, lexikalische Bedeutung haben."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee5b863-6027-4cb0-9afc-aa5021599b50",
                                "sense_id": "f15096c2-9285-31fc-8dd1-637c07ea2abd",
                                "text": "Wörter mit eigenständiger, lexikalischer Bedeutung wie \"Haus\", \"Tier\", \"Wolke\" sind Inhaltswörter."
                            },
                            {
                                "example_id": "0b1910ee-a33a-45d0-92b7-ae19eb313559",
                                "sense_id": "f15096c2-9285-31fc-8dd1-637c07ea2abd",
                                "text": "Substantive, Verben, Adjektive und Adverbien sind Inhaltswörter."
                            },
                            {
                                "example_id": "f639aca9-e479-43c8-93ed-6d3d60a3c076",
                                "sense_id": "f15096c2-9285-31fc-8dd1-637c07ea2abd",
                                "text": "„Mental werden ihrer Ansicht nach zumindest Funktions- von Inhaltswörtern unterschieden…“"
                            },
                            {
                                "example_id": "1ebd0dc3-1091-43ce-b449-8f558fead9c7",
                                "sense_id": "f15096c2-9285-31fc-8dd1-637c07ea2abd",
                                "text": "„Kommen wir zum Schluss auf die Adverbien, deren Zuordnung zu Funktionswörtern oder Inhaltswörtern etwas schwankend ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
