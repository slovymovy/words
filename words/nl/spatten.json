                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistofbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De defecte kraan bleef maar alle kanten op <w>spatten</w>.",
                            "target_lang_translations": {
