                        "glosses": [
                            "Gruppe von Wölfen, die gemeinsam ein Rudel bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a6e15f-19ed-45c8-adcf-ce4776a4847b",
                                "sense_id": "f598e42c-a366-323c-952b-e4fd4bc35396",
                                "text": "„Wie im Wolfsrudel gehört der beste Bissen dem Leittier.“"
                            },
                            {
                                "example_id": "33cef4a4-7d5c-4a62-9331-9103fd3ec951",
                                "sense_id": "f598e42c-a366-323c-952b-e4fd4bc35396",
                                "text": "„Ein Wolfsrudel begleitete des Heereszug in sicherem Abstand schon mehrere Tage, wohl in der Hoffnung, es müsste etwas Nahrung abfallen: ein totes Pferd, die Reste geschlachteten Geflügels.“"
                            }
                        ],
