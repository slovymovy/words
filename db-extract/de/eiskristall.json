                                        "sense_id": "dc052f98-05b9-33c4-a57a-5ee068dbd049",
                                        "entry_id": "7e5246b2-d10d-3ea6-b51d-67245c3bbe9c",
                                        "glosses": [
                                            "Figuradamente, falta de afecto o interés entre dos personas."
                                        ],
