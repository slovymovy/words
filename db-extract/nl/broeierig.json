                "senses": [
                    {
                        "sense_id": "263e9068-d3ee-3d55-b7a3-fe4a9091f85f",
                        "entry_id": "36b6dcc4-2e20-3d90-97fd-3cf3c54453f2",
                        "glosses": [
                            "drukkend, verstikkend, benauwd heet bijv. vlak voordat onweer ptreedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242cfed0-e373-4012-a603-ba599abcf770",
                                "sense_id": "263e9068-d3ee-3d55-b7a3-fe4a9091f85f",
                                "text": "Voorafgaand aan deze buien uit wordt het morgen eerst nog broeierig warm. De temperatuur loopt op naar 25 tot 33 graden. In de loop van de dag trekken de zware onweersbuien vervolgens vanuit het zuiden over het land."
                            }
                        ]
                    },
                    {
                        "sense_id": "7377bb02-dd8f-3c35-8730-cb1bf9f3a4fc",
                        "entry_id": "36b6dcc4-2e20-3d90-97fd-3cf3c54453f2",
                        "glosses": [
                            "erotisch, zwoel, wellustig, wulps"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796c71b2-8146-41bd-bbac-aaa07332fd8f",
                                "sense_id": "7377bb02-dd8f-3c35-8730-cb1bf9f3a4fc",
                                "text": "Bij tangodansen is men welhaast verplicht om broeierige blikken te werpen!"
                            }
                        ]
                    },
                    {
                        "sense_id": "b16c56fb-6ff9-39c2-a16f-1f04bd207bff",
                        "entry_id": "36b6dcc4-2e20-3d90-97fd-3cf3c54453f2",
                        "glosses": [
                            "wat droevig, depressief of gepijnigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "168c56a9-df62-44cd-bc67-83a26f8b693d",
                                "sense_id": "b16c56fb-6ff9-39c2-a16f-1f04bd207bff",
                                "text": "Nog zo'n typerende zwart-wit-foto is een groepsportret van een stel muzikanten uit Assen. Samen stonden ze bekend als de Showboot, een soort revuegezelschap waarmee ze langs feestzalen gingen. Harry Muskee staat in het midden in zwart kostuum. Hij heeft een grote bas voor zich, de handen op de snaren. Hij kijkt broeierig, hij heeft de blues. Het was op de drempel van de sixties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf39e29d-3987-4df4-9beb-77573cd65209",
                        "source_entry_id": "36b6dcc4-2e20-3d90-97fd-3cf3c54453f2",
                        "source_sense_id": "263e9068-d3ee-3d55-b7a3-fe4a9091f85f",
                        "source_sense_description": "drukkend heet, met onweer dreigend",
                        "target_lang_word": "airless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e73ef64d-cc65-3bcb-b003-93298c6f62b5",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Lacking or being without air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54e85dd4-2307-315c-8236-437fcdb4bbc6",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Lacking air circulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288afef7-ce80-4180-b58a-dccfdc877bff",
                                                "sense_id": "54e85dd4-2307-315c-8236-437fcdb4bbc6",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2894c1ea-f597-3169-8815-4a795e9af6e7",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "With air that is stale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89aafd11-65f8-3872-8e53-a893eb7e87a7",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Suffering from asphyxia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6432f82-5321-33b8-91c3-286592b44d56",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Stifling; dead; lacking vitality or excitement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a32c0bab-9f7b-4df2-8787-b75ecba742a2",
                                                "sense_id": "b6432f82-5321-33b8-91c3-286592b44d56",
                                                "text": "The worst that can—and has—been said about Memento is that it’s an airless gimmick, visually undistinguished, and not even all that sophisticated when the puzzle pieces are finally put together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30275e4b-da3b-450b-9d86-fa817254d9f8",
                        "source_entry_id": "36b6dcc4-2e20-3d90-97fd-3cf3c54453f2",
                        "source_sense_id": "263e9068-d3ee-3d55-b7a3-fe4a9091f85f",
                        "source_sense_description": "drukkend heet, met onweer dreigend",
                        "target_lang_word": "oppressive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppressive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef9e49dd-9e6b-3635-b983-a38bd7f6ebbf",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Burdensome or difficult to bear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097fb18a-cc00-4571-b23c-103880609e0e",
                                                "sense_id": "ef9e49dd-9e6b-3635-b983-a38bd7f6ebbf",
                                                "text": "The oppressive tax laws made it difficult to start a small company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ecbacf-dad2-3cfb-a38f-63aa433bfb89",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Tyrannical or exercising unjust power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d550405-8a96-4a7c-bece-0947214ad95a",
                                                "sense_id": "b1ecbacf-dad2-3cfb-a38f-63aa433bfb89",
                                                "text": "The oppressive land-owners kept a grip on the labourers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Weighing heavily on the spirit; being quite intense, excessive or overwhelming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd76d23-fbef-4788-b436-2479cb59a75b",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Will the oppressive heat of summer never end?"
                                            },
                                            {
                                                "example_id": "82898cec-122d-4482-8ebd-bf0e75521d10",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Without being slaves in fact, their condition is little better than vassalage in its most oppressive form."
                                            },
                                            {
                                                "example_id": "1aaecdc3-4255-4957-a835-9d20b57ecb78",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "The class of noblemen, who, at this particular epoch, had lost nothing of their primitive vigour, saw with pleasure the influence of the French depressed; but they suffered scarcely less from the absolute and oppressive influence which the Spaniards had acquired over them."
                                            },
                                            {
                                                "example_id": "de7f4e25-1faf-423e-9a24-651bb86e6c49",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Their mantle was for a while worn unconsciously by him who showed to us Macbeth: and here again, in the deepening gloom of this tragic tale, we feel the oppressive influence of this invisible power, from the time we hear the prophetic rhymes, the spell has begun its work, and the clouds of misfortune blacken round us; and the fated course moves solemnly onward, irresistible and unerring as the progress of the sun, and soon to end in a night of horror."
                                            },
                                            {
                                                "example_id": "1f5e8c07-f7a1-4a72-9634-038a21e0b279",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "With startling and oppressive force of illustration, he brings before us the fact, that in that grandest city of the earth, “if all the churches, chapels and buildings devoted to public worship, were filled to their last seat, there would be still left outside the buildings as many people as the whole population—men, women and children—in the cities of Leeds, Bristol, Sheffield and Birmingham.”"
                                            },
                                            {
                                                "example_id": "1c02f9ed-1526-44cf-91c3-fa1e98950037",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "It had been one of those unnaturally still and oppressive days when scarcely a leaf quivers, and every breath of air seems charged with electricity. Suddenly the thunder began to growl. Before many minutes eveiy pine-needle was shaking with a fierce chill wind, and a torrent of rain swept down the valley and drenched us through to the skin."
                                            },
                                            {
                                                "example_id": "b87edafb-7c32-4072-9fde-870169ca428d",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "He defines it as belief in exalted spiritual powers by whose help human weakness is supplemented in its struggle with the oppressive forces of the natural world."
                                            },
                                            {
                                                "example_id": "ae76728c-285a-4e8a-ad40-ef7b3120e562",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Mr. Wardlaw had left the castle: so also had Charlotte, by her own wish, her residence there having been found too oppressive to herself to be continued for the present."
                                            },
                                            {
                                                "example_id": "c59ed678-89b0-431e-90a2-8e0030fa962e",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "The possibility that women are not very sensitive to odours is often suggested to men by the perfumes of oppressive strength which women frequently use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c5d09a-0b65-3bc0-bc6e-278edc67f546",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Hot and humid."
                                        ],
                                        "tags": [
                                            "of the weather"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29ec7684-9b9b-4f90-8317-9e5b56152e7f",
                        "source_entry_id": "36b6dcc4-2e20-3d90-97fd-3cf3c54453f2",
                        "source_sense_id": "263e9068-d3ee-3d55-b7a3-fe4a9091f85f",
                        "source_sense_description": "drukkend heet, met onweer dreigend",
                        "target_lang_word": "stiffling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "25d2a429-e0a6-44d4-bd6b-ea50d84117f4",
                        "source_entry_id": "36b6dcc4-2e20-3d90-97fd-3cf3c54453f2",
                        "source_sense_id": "263e9068-d3ee-3d55-b7a3-fe4a9091f85f",
                        "source_sense_description": "drukkend heet, met onweer dreigend",
                        "target_lang_word": "sultry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sultry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                        "entry_id": "7263bb18-2520-3725-a683-77a22b0b4db6",
                                        "glosses": [
                                            "Hot and humid; sweltering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2d51999-7fe2-466f-b4d0-f545981af457",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "Other ſignes of the Hiues fullneſſe and readineſſe to ſwarm are at the Hiue-doore, […] Fourthly, their firſt lying forth in foggy and ſultrie mornings & euenings, & going in again when the aire is cleere."
                                            },
                                            {
                                                "example_id": "2a260872-58b4-4e4f-aa54-ee303fa9a68a",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "On recollecting myself, I diſcovered that I had almoſt reached the entrance of the lagoon, and determined to venture in, if poſſible, to take a few fiſh, […] I ſoon caught more trout than I had preſent occaſion for, and the air was too hot and ſultry to admit of their being kept for many hours, even though ſalted or barbecued."
                                            },
                                            {
                                                "example_id": "8e2ba3a5-fb47-4110-aaaf-e402697ed441",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "Here in the sultriest season let him rest, / Fresh is the green beneath those aged trees; / Here winds of gentlest wing will fan his breast, / From heaven itself he may inhale the breeze: […]"
                                            },
                                            {
                                                "example_id": "d05ac4bf-b991-43ec-8886-b84c11e96808",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "The detachment of Tancred, fifty spears and their armed retinue, which amounted fully to five hundred men, after having taken a short and hasty refreshment, were in arms and mounted before the sultry hour of noon."
                                            },
                                            {
                                                "example_id": "4276f638-8f5b-4166-98da-039362b488c7",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "The heat had been painfully oppressive all day; and it was now a close and sultry night."
                                            },
                                            {
                                                "example_id": "3da7d0bb-4c1a-4ba1-89b0-01741f317de3",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "The weather of the summer of 1863 was, if we include the above four months, not remarkable; but June and September had exceedingly fine weather, while July and August were very unhealthy, being warmer than usual and much damper—that is, sultry."
                                            },
                                            {
                                                "example_id": "d6d741f2-ac9a-43ee-a0a3-89825fb08f06",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "The storm-center gathered slowly around the peaks; low rumble and bowl of thunder increased in frequence; slowly the light shaded as smoky clouds rolled up; the air grew sultrier, and the exasperating breeze puffed a few times and then failed."
                                            },
                                            {
                                                "example_id": "17cc59d5-30fd-43f6-b606-990ff346f97f",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "The soldiers in charge of the English, puzzled apparently how to secure them, conceived the barbarous idea of diving the whole number into a cell which would have been overcrowded with ten captives during the sultry heat of a Bengal midsummer night. The hundred and forty-six unfortunate prisoners were crushed into the narrow space."
                                            },
                                            {
                                                "example_id": "d2a5e9ef-9881-4c1c-92a0-065faa69336d",
                                                "sense_id": "d9abe08b-a0e0-392f-a16d-0104201b0b57",
                                                "text": "The Champions League has brought suffering to City and Guardiola - especially when they lost to Premier League rivals Chelsea in the 2021 final - but all the pain disappeared just before midnight on a sultry night in Istanbul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b65052e-9def-33ea-9830-8168e067f3ed",
                                        "entry_id": "7263bb18-2520-3725-a683-77a22b0b4db6",
                                        "glosses": [
                                            "Emitting great heat."
                                        ],
                                        "tags": [
                                            "of the sun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0473b798-b5f6-4f1e-a5c4-155cd9edb270",
                                                "sense_id": "1b65052e-9def-33ea-9830-8168e067f3ed",
                                                "text": "The battlefield—an undulating, parched, and dusty expanse—is lying under the sultry sun of a July afternoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4de06e9-fbed-3a0a-869e-a72b8ef797b7",
                                        "entry_id": "7263bb18-2520-3725-a683-77a22b0b4db6",
                                        "glosses": [
                                            "Sexually enthralling."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e44ffd-fb0c-420b-b99c-664eba9c582b",
                                                "sense_id": "a4de06e9-fbed-3a0a-869e-a72b8ef797b7",
                                                "text": "When Chicanos think about us at all, they perpetuate the stereotypes. Gabacho depiction of us as emotionally unchecked, sultry women lusting after pale bodies is just an extension of the fantasy they have about all women. Such dishonest portrayals are why Chicanas are \"breaking the silence,\" as Rita Sánchez calls it."
                                            },
                                            {
                                                "example_id": "92fb4ba8-267a-4726-8aa8-04058e12b077",
                                                "sense_id": "a4de06e9-fbed-3a0a-869e-a72b8ef797b7",
                                                "text": "Geeta Dutt was the wife of Guru Dutt and largely sang for the heroines in his films. Her voice was sultrier than the others, often recognisable by a slightly erotic quality felt through a distinctive quivering in the voice as heard in the song ‘Na Jao Saiyan Chuda Ke Baiyan’ (‘Don’t let go of my wrist my love’) from Sahib Bibi Aur Ghulam (Abrar Alvi, 1962) […]"
                                            },
                                            {
                                                "example_id": "669981a5-1a1e-4931-a90b-3098fec45eae",
                                                "sense_id": "a4de06e9-fbed-3a0a-869e-a72b8ef797b7",
                                                "text": "The claim by [Scarlett] Johansson, who played a sultry virtual AI assistant in the 2013 movie “Her,” seemed to be bolstered by a cryptic tweet Altman posted to greet a demo of the product. The tweet said, simply, “her.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
