                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967eb2fb-6fc6-41cd-8e48-dba608f1c8c2",
                                "sense_id": "86b43473-7476-316a-97aa-0305adf2838c",
                                "text": "Вы бы укрылись чем-нибудь!",
                                "translation": "Bedekt u het maar met iets!"
                            }
