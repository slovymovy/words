                "senses": [
                    {
                        "sense_id": "0742666e-638c-3c70-8a93-f6d83076b7cd",
                        "entry_id": "2b6a841e-c02a-37c3-8729-e51e45420732",
                        "glosses": [
                            "vorübergehende, häufige Verwendung bestimmter Witzarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc32e7e7-3f9c-4066-b9a3-ef1861fc80eb",
                                "sense_id": "0742666e-638c-3c70-8a93-f6d83076b7cd",
                                "text": "„Neue Witzmoden sind vielmehr zumeist internationale Erscheinungen.“"
                            },
                            {
                                "example_id": "f069857f-2e8b-4ca4-b2e4-379a78ec689e",
                                "sense_id": "0742666e-638c-3c70-8a93-f6d83076b7cd",
                                "text": "„Zudem gibt es, betrachtet man den Witz geschichtlich, zu bestimmten Zeiten ganz bestimmte Witzmoden, in der Bundesrepublik der siebziger, achtziger und neunziger Jahre beispielsweise die Mantafahrer-Witze, die Ostfriesen-Witze und die Blondinen-Witze.“"
                            },
                            {
                                "example_id": "75d3a1ef-852d-4419-ab32-3879497b96e7",
                                "sense_id": "0742666e-638c-3c70-8a93-f6d83076b7cd",
                                "text": "„Eine der ältesten Witzmoden ist der Schottenwitz.“"
                            },
                            {
                                "example_id": "d8d2a08c-b6f2-4a7e-9299-c785203e5e01",
                                "sense_id": "0742666e-638c-3c70-8a93-f6d83076b7cd",
                                "text": "„Mit den Radio-Eriwan-Witzen machte man sich über den Alltag in der Sowjetunion lustig und auch in der DDR gab es politische Witzmoden, die bestraft wurden.“"
                            },
                            {
                                "example_id": "f8234067-1eb0-4c65-bbd8-58e945a0374a",
                                "sense_id": "0742666e-638c-3c70-8a93-f6d83076b7cd",
                                "text": "„Hat es ähnliche Witzmoden in Deutschland gegeben?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
