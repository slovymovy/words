                                "nl": "Denk <w>eerst</w> na en antwoord dan pas.",
                                "pl": "<w>Najpierw</w> pomyśl, a dopiero potem odpowiadaj.",
                                "de": "Denke <w>zuerst</w> nach und antworte erst dann.",
                                "fr": "Réfléchis <w>d'abord</w>, et réponds ensuite.",
                                "it": "<w>Prima</w> pensa, e solo dopo rispondi.",
                                "cs": "<w>Nejdříve</w> přemýšlej a teprve potom odpovídej.",
                                "tr": "<w>Önce</w> düşün, sonra cevap ver.",
                                "es": "<w>Antes</w> piensa, y solo entonces responde."
                            }
                        },
                        {
                            "text": "Нужно <w>прежде</w> закончить работу, чтобы отдыхать.",
                            "target_lang_translations": {
                                "en": "You need to finish work <w>first</w> to rest.",
                                "zh": "需要<w>先</w>完成工作才能休息。",
                                "nl": "Je moet <w>eerst</w> het werk afmaken om te kunnen rusten.",
                                "pl": "Trzeba <w>najpierw</w> skończyć pracę, żeby odpocząć.",
                                "de": "Man muss <w>zuerst</w> die Arbeit beenden, um sich auszuruhen.",
                                "fr": "Il faut finir le travail <w>au préalable</w> pour pouvoir se reposer.",
                                "it": "Bisogna <w>prima</w> finire il lavoro per potersi riposare.",
                                "cs": "Je třeba <w>nejdříve</w> dokončit práci, aby bylo možné odpočívat.",
                                "tr": "Dinlenmek için <w>önce</w> işi bitirmek gerekir.",
                                "es": "Necesitas terminar el trabajo <w>antes</w> para poder descansar."
                            }
