                                        "sense_id": "d52e57ec-2e42-330c-98ae-07236d6b6aad",
                                        "entry_id": "7a04ce93-46e1-35be-a9d0-728f8c7a2bae",
                                        "glosses": [
                                            "A sex act in which multiple people ejaculate on another person."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92d88cc4-dc15-48a3-8d61-fa59d463ab7c",
                                                "sense_id": "d52e57ec-2e42-330c-98ae-07236d6b6aad",
                                                "text": "When the phone on his desk buzzed with a rude chirp, Brian Babylon picked up the receiver in one smooth movement as he continued browsing the Internet for fresh Bukkake web sites."
                                            },
                                            {
                                                "example_id": "1f1c02a3-81e4-43c7-9abf-5f18540e8432",
                                                "sense_id": "d52e57ec-2e42-330c-98ae-07236d6b6aad",
                                                "text": "Tuesdays she drives to a warehouse across town to star in bukkake videos. Seventy-five men cum on her face and in her hair during a shoot."
                                            },
                                            {
                                                "example_id": "12380ee5-d8c6-4ce9-9d76-1b5d5eaa4274",
                                                "sense_id": "d52e57ec-2e42-330c-98ae-07236d6b6aad",
                                                "text": "This was a role she was well acquainted with, but it had changed and she longed for the simple days not long ago, terse formalized meetings she watched in a cage suspended from the ceiling, ending with ritual bukkake."
                                            },
                                            {
                                                "example_id": "ba551861-d2a5-4474-9fd8-7fbecb31569f",
                                                "sense_id": "d52e57ec-2e42-330c-98ae-07236d6b6aad",
                                                "text": "When a friend tells me she's going to get a facial, I immediately think bukkake."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bukkake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59540e10-00eb-3f23-bba1-02607ece2b28",
                                        "entry_id": "9c793c9b-3fe6-39d4-8f57-13977470ac4d",
                                        "glosses": [
                                            "To ejaculate on (one person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3db7897a-0632-48f4-9510-85715de5dfdf",
                                                "sense_id": "59540e10-00eb-3f23-bba1-02607ece2b28",
                                                "text": "Finally I would take her to an RIT Star Trek club meeting where I would let the masses of geeks bukkake her. She would then roll around in the mess they made as I videotaped it."
                                            }
                                        ]
