                                "example_id": "1ce4d9b6-6826-4120-bdef-3b7df1a2fe7d",
                                "sense_id": "633aab71-0473-355f-95ba-d548bcb61c78",
                                "text": "„Kaum scheiden sich Dialektregionen an einer bestimmten Linie.“"
                            },
                            {
                                "example_id": "a50f902a-5dc6-40a8-a12a-6770c7a00198",
                                "sense_id": "633aab71-0473-355f-95ba-d548bcb61c78",
                                "text": "„Eine Gemeinsamkeit dieser Dialektregionen ist der fehlende Einfluss der arabischen Hochsprache in der Sprachentwicklung.“"
                            },
                            {
                                "example_id": "506dce0f-21c8-4650-9903-6c00f1a85887",
                                "sense_id": "633aab71-0473-355f-95ba-d548bcb61c78",
                                "text": "„Die kulturellen Grenzen lassen sich recht gut an den unterschiedlichen Dialektregionen ausmachen.“"
                            }
