                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bd03fa8-a381-4de0-aabc-916a3063b003",
                        "source_entry_id": "87fc7380-ac0f-32ef-a1a3-ff4f23404bea",
