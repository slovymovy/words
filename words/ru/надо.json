        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "7ae3bf66-c6a6-3934-b5b7-d777fdfa2c51",
                    "sense_definition": "Вариант предлога «над», употребляемый для благозвучия перед словами, начинающимися с определённых сочетаний согласных (обычно «мн», «лб», «рв»).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Голубое небо сияло <надо> мной.",
                            "target_lang_translations": {
                                "en": "The blue sky shone <above> me.",
                                "nl": "De blauwe lucht straalde <boven> mij.",
                                "pl": "Błękitne niebo świeciło <w>nad</w>e mną.",
                                "de": "Der blaue Himmel strahlte <über> mir.",
                                "fr": "Le ciel bleu brillait <au-dessus> de moi.",
                                "it": "Il cielo azzurro splendeva <w>sopra</w> di me.",
                                "cs": "Modré nebe zářilo <nad> mnou.",
                                "tr": "Mavi gökyüzü <üzerimde> parlıyordu.",
                                "es": "El cielo azul brillaba <sobre> mí.",
                                "zh": "蓝天在<w>我</w>上方闪耀。"
                            }
                        },
                        {
                            "text": "Ветки деревьев склонились низко <надо> лбом.",
                            "target_lang_translations": {
                                "en": "The tree branches bent low <over> the forehead.",
                                "nl": "De takken van de bomen bogen laag <over> het voorhoofd.",
                                "pl": "Gałęzie drzew pochyliły się nisko <w>nad</w> czołem.",
                                "de": "Die Äste der Bäume bogen sich tief <über> die Stirn.",
                                "fr": "Les branches des arbres se penchaient bas <au-dessus> du front.",
                                "it": "I rami degli alberi si sono piegati bassi <w>sopra</w> la fronte.",
                                "cs": "Větve stromů se sklonily nízko <nad> čelo.",
                                "tr": "Ağaç dalları alnımın <üzerine> kadar eğilmişti.",
                                "es": "Las ramas de los árboles se inclinaron bajo <w>sobre</w> la frente.",
                                "zh": "树枝低垂在额头<w>上方</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "выше",
                        "поверх"
                    ],
                    "antonyms": [
                        "под",
                        "подо"
                    ],
                    "common_phrases": [
                        "надо мной"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "фонетический вариант предлога «над»"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A variant of the preposition 'over' or 'above', used for easier pronunciation before words beginning with certain consonant clusters.",
                        "nl": "Een variant van het voorzetsel 'boven' of 'over', gebruikt voor een betere uitspraak voor woorden die beginnen met bepaalde medeklinkercombinaties.",
                        "pl": "Wariant przyimka 'nad', używany dla ułatwienia wymowy przed niektórymi zbitkami spółgłoskowymi.",
                        "de": "Eine Variante der Präposition 'über', die aus phonetischen Gründen vor bestimmten Konsonantenverbindungen verwendet wird.",
                        "fr": "Variante de la préposition 'au-dessus de' ou 'sur', utilisée pour faciliter la prononciation devant certains groupes de consonnes.",
                        "it": "Variante della preposizione 'sopra' o 'su', usata per facilitare la pronuncia davanti a determinati gruppi consonantici.",
                        "cs": "Fonetická varianta předložky 'nad', používaná pro snazší výslovnost před určitými shluky souhlásek.",
                        "tr": "Belirli ünsüz gruplarıyla başlayan kelimelerin önünde telaffuz kolaylığı sağlamak için kullanılan 'üzerinde' veya 'üstünde' anlamındaki edatın fonetik bir varyantı.",
                        "es": "Una variante de la preposición 'sobre' o 'encima de', utilizada para facilitar la pronunciación antes de ciertas combinaciones de consonantes.",
                        "zh": "介词“在……之上”的变体，用于特定辅音组合前。"
                    },
                    "translations": {
