                                "example_id": "f1e96402-50fe-41f0-ac40-f562bda79a68",
                                "sense_id": "056f0455-8e93-3e67-8026-46091ba90b46",
                                "text": "It was a scorching summer, and the ice-cream sellers plied a roaring trade."
                            }
                        ]
                    },
                    {
                        "sense_id": "7634f89e-22d9-33e9-af4b-662784936b73",
                        "entry_id": "a2a50766-5c22-3aca-9296-a6b547f73da3",
                        "glosses": [
                            "Bitterly sarcastic; scathing; withering."
