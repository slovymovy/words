                ],
                "senses": [
                    {
                        "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                        "entry_id": "36480fc4-e495-35c5-a0a8-4e2da607b47c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69afc9bd-2fa9-4307-af53-f57286e97a7b",
                                "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                                "text": "Frau Michel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "62c5a826-a55f-4bf3-afc5-f705df2ea714",
                                "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                                "text": "Herr Michel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c3ccad09-591a-4cb7-82d5-8a3d354868f9",
                                "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                                "text": "Die Michels fliegen heute nach Kanada."
                            },
                            {
                                "example_id": "e4f3e3a1-d474-4ab0-b0b8-3417478c5559",
                                "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                                "text": "Der Michel trägt nie die Pullover, die die Müller ihm strickt."
                            },
                            {
                                "example_id": "e8bff91f-ab69-4efd-b0fc-e666d82de910",
                                "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Michel kommt, geht der Herr Michel.“"
                            },
                            {
                                "example_id": "cdfbb9a8-1726-4967-b079-49790f4d970e",
                                "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                                "text": "Michel kommt und geht."
                            },
                            {
                                "example_id": "0e8058cb-65ea-4d8d-9bee-f5196052ed6d",
                                "sense_id": "cb6b5f71-1eef-3253-883f-4930ada35bac",
                                "text": "Michels kamen, sahen und siegten."
                            }
                        ],
