                    },
                    {
                        "translation_id": "1d5a7032-f8f1-4b59-9f3c-78fd24d77f81",
                        "source_entry_id": "a006d1f7-9f5c-31bf-9db1-6c3dd5dc47b3",
                        "source_sense_description": "Sacré",
                        "target_lang_word": "inviolable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inviolable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                        "entry_id": "e7abce9b-d023-3e95-8a8f-0ee665a4b160",
                                        "glosses": [
                                            "Not violable; not to be infringed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a744102c-5f67-4cb4-aba0-0af430e93363",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "But come, for thou, be ſure, ſhalt give account / To him who ſent us, whoſe charge is to keep / This place inviolable, and therefore theſe from harm."
                                            },
                                            {
                                                "example_id": "031fa211-d941-4f2c-9fff-453951826e9c",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "But honeſt men’s words are Stygian oaths, and promiſes inviolable."
                                            },
                                            {
                                                "example_id": "5f6a08d8-8a62-400b-8017-54cf08093cf3",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "One more request, and I am lost, / If you its earnest prayer deny ; / It is, that you preserve the most / Inviolable secrecy / As to my plan."
                                            },
                                            {
                                                "example_id": "d865255d-dae8-4067-86b2-2ca6ce6857b2",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "\"Now, Mr. Jones, having obtained your promise of inviolable secrecy, I come down to the essential point.\""
                                            },
                                            {
                                                "example_id": "baa25ec1-3bb0-434f-b8f9-03f6a77dc239",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "\"As defined by the first founders of Aya, this world and all who live on it agree to abide by the laws, customs, and regulations of a civilized society that has existed for centuries on other worlds. These rules of conduct ensure a voice for each family within our society and gives them certain inviolable rights...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97afe238-c8e0-3e5a-a5ff-6c55d7dc05e8",
                                        "entry_id": "e7abce9b-d023-3e95-8a8f-0ee665a4b160",
                                        "glosses": [
                                            "Not susceptible to violence, or of being profaned, corrupted, or dishonoured."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6295fa87-77ae-30d8-88c1-b919666ca8a6",
                                        "entry_id": "e7abce9b-d023-3e95-8a8f-0ee665a4b160",
                                        "glosses": [
                                            "Incapable of being injured or invaded; indestructible."
