                "translations": [
                    {
                        "translation_id": "b4311348-c427-42e3-ade6-f1582b04eae2",
                        "source_entry_id": "13020097-35a2-3f0b-aad2-e406c1cf15e6",
                        "source_sense_id": "1e4fafa4-1f35-30a8-bce6-f5110fe94b4c",
                        "target_lang_word": "Gibraltarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gibraltarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f40b8f26-d462-3313-9a6b-83d1ab50fe02",
                                        "entry_id": "0cd3ce1a-68b9-3a14-aa5e-3d7dfd27ff6b",
                                        "glosses": [
                                            "Of or pertaining to Gibraltar or its people"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dc1361a-6c06-4730-9280-f8ba2a5f6df4",
                                                "sense_id": "f40b8f26-d462-3313-9a6b-83d1ab50fe02",
                                                "text": "The curse has been Spanish ineptitude feeding Gibraltarian intransigence. Border hold-ups are counterproductive to winning hearts and minds, as were blundering Argentinian landings on the outer Falklands."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Gibraltarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dca8505a-8db6-301c-a48e-05242c143245",
                                        "entry_id": "28107f38-0db0-3ccd-9b7f-6722a44c5b58",
                                        "glosses": [
                                            "A native or inhabitant of Gibraltar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ddfada4-9da0-45ee-bcb0-b509fcc367ad",
                                                "sense_id": "dca8505a-8db6-301c-a48e-05242c143245",
                                                "text": "The idea of a British warship supposedly menacing Spain is ludicrous. Is it meant to bomb Cadiz? Will its guns lift a rush-hour tailback in a colony that most Britons regard as awash with tax dodgers, drug dealers and right-wing whingers? The Gibraltarians have rights, but why British taxpayers should send warships to enforce them, even if just \"on exercise\", is a mystery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Gibraltarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0581b549-867b-364c-86c9-5f073272dcff",
                                        "entry_id": "726a1a93-07bf-38a0-b897-90ca8ff81cb0",
                                        "glosses": [
                                            "The dialect spoken in Gibraltar, a mix of British English and Andalusian Spanish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
