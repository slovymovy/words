                "senses": [
                    {
                        "sense_id": "8ac09d0d-7416-345e-8c9b-dce7ac768672",
                        "entry_id": "0345caf0-aa77-33ee-84f2-e305264fa211",
                        "glosses": [
                            "männlicher Tanzpartner des Tanzmariechens"
                        ],
                        "tags": [
                            "Karneval",
                            "Fasching",
                            "Fastnacht"
                        ],
                        "examples": [
                            {
                                "example_id": "dfa89343-89c8-4eac-b55d-ed6975970a14",
                                "sense_id": "8ac09d0d-7416-345e-8c9b-dce7ac768672",
                                "text": "„Mit fünf von derzeit insgesamt 27 aktiven Mitgliedern bilden die Tanzoffiziere nicht einmal ein Fünftel der Garde.“"
                            },
                            {
                                "example_id": "313432bb-b7e7-4759-9ed8-8fc0f7d332b3",
                                "sense_id": "8ac09d0d-7416-345e-8c9b-dce7ac768672",
                                "text": "„Und dabei strahlen Tanzoffizier und Tanzmarie eine Freude und Leichtigkeit der Bewegungen aus, die ihresgleichen sucht.“"
                            },
                            {
                                "example_id": "26a0eac9-ecad-4bda-b371-cf6f32769cb3",
                                "sense_id": "8ac09d0d-7416-345e-8c9b-dce7ac768672",
                                "text": "„Ein Tanzoffizier hat bei der Probe eine Tänzerin vor einem Sturz bewahrt, sich dabei aber selbst schwer verletzt.“"
                            },
                            {
                                "example_id": "de35436a-deaf-4c55-bf27-e8f6e937b839",
                                "sense_id": "8ac09d0d-7416-345e-8c9b-dce7ac768672",
                                "text": "„Die waren dann auch auf der Bühne und brachten den neuen Tanzoffizier mit, der anschließend feierlich vereidigt wurde.“"
                            },
                            {
                                "example_id": "c94b9678-d6ea-42ae-883c-f8dfec1c29d2",
                                "sense_id": "8ac09d0d-7416-345e-8c9b-dce7ac768672",
                                "text": "„Für viele ist es der Traum, einmal Funkemariechen oder Tanzoffizier im rheinischen Karneval zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
