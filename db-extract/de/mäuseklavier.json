                "senses": [
                    {
                        "sense_id": "c346fb59-5104-3d7e-bf8d-f939287ac1ff",
                        "entry_id": "eaeb3c8a-648b-3489-8947-fcfd1df95061",
                        "glosses": [
                            "sehr kleine Hebel und Taster an einem Schalter"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "67d6a14e-01bc-4dfe-830f-33c4cc32bb9f",
                                "sense_id": "c346fb59-5104-3d7e-bf8d-f939287ac1ff",
                                "text": "Denn unter dem großen Bildschirm des Android-Telefons – dort, wo Smartphones für Geschäftskunden üblicherweise das Mäuseklavier einer Mikro-Schreibmaschinentastatur verbergen – besitzt das „Play“ das vollwertige Tastenset eines klassischen Game-Controllers."
                            },
                            {
                                "example_id": "73132014-2f45-46ba-8e9c-4c618034b968",
                                "sense_id": "c346fb59-5104-3d7e-bf8d-f939287ac1ff",
                                "text": "Zumindest die Tandem-Lösung überzeugt dafür aber durch ein hohes Maß an Bequemlichkeit, zumal dann längere Texteingaben nicht mehr mit dem \"Mäuseklavier\" vieler Blackberry-Smartphones geschrieben werden müssen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "791c983a-5895-37e3-8b4d-4c708eadad04",
                        "entry_id": "eaeb3c8a-648b-3489-8947-fcfd1df95061",
                        "glosses": [
                            "sehr kleine Tasten an technischen Geräten, unter anderem an Mobiltelefonen"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "1a27b3d1-0cb5-4ea5-921b-44a496d0bc32",
                                "sense_id": "791c983a-5895-37e3-8b4d-4c708eadad04",
                                "text": "Bei alten Druckern muss man die Schriftart am Mäuseklavier einstellen."
                            },
                            {
                                "example_id": "633f533a-919a-49d7-8b0b-be3a9dc32743",
                                "sense_id": "791c983a-5895-37e3-8b4d-4c708eadad04",
                                "text": "Schalter in Kleinstbauweise zu Konfigurationszwecken, baulich als gesteckter DIP-Baustein mit winzigen Kipp- oder Schiebeschaltern; auch „Mäuseklavier“ genannt."
                            },
                            {
                                "example_id": "db1210b4-a2d2-448f-9d0b-b1b34f57e745",
                                "sense_id": "791c983a-5895-37e3-8b4d-4c708eadad04",
                                "text": "Neuere Decoder ohne Mäuseklavier werden \"online programmiert\". Ältere Märklin Decoder haben einen DIP-Schalter, an dem die Adresse eingestellt wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
