                        ],
                        "examples": [
                            {
                                "example_id": "2e2e0779-e1e1-4fd6-baf5-788d2b72fb93",
                                "sense_id": "709118a4-2d6e-3d4d-ba36-0ac6c114f1b0",
                                "text": "That is because the huissier cannot lead anyone in to see the President of France without first passing through the adjacent office of Jacques Attali."
                            },
                            {
                                "example_id": "7c54f36b-d1d6-4734-a880-15fbf08d7160",
                                "sense_id": "709118a4-2d6e-3d4d-ba36-0ac6c114f1b0",
                                "text": "A chorus of five huissiers, or ushers, line up in a row, like sleek crows cawing out comments on the machinations of their masters."
                            }
                        ]
                    },
