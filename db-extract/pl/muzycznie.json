                                    {
                                        "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                        "entry_id": "e182cc98-338e-32ad-9607-410731a03e80",
                                        "glosses": [
                                            "In a musical manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e82bf195-008e-4079-a3c6-fe54d9e5ccb4",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "The wind chimes tinkled musically in the breeze."
                                            },
                                            {
                                                "example_id": "8807fc57-f6ec-441e-a6b5-aa14c1158df6",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "Something might alſo be ſaid of the choice of Words, in our refined Engliſh Tongue; which are to be liked and approved according to their tone, and the ſweetneſs of their cadence, that is, as they run muſically in the Ear."
                                            },
                                            {
                                                "example_id": "2cf2c1c3-95b2-48cd-bb8b-a1015ee26473",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "[…] with accents muſically ſweet\nA tender voice his wondring ear allur'd."
                                            },
                                            {
                                                "example_id": "1038eb1c-01c2-47f4-8800-97e08c139019",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "A gentle breeze fills the huge sail of our dhow, and draws us through the water that ripples musically against her sides."
                                            },
                                            {
                                                "example_id": "94799692-345d-4893-bd42-2547f5d5c449",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "Prill laughed musically[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                        "entry_id": "e182cc98-338e-32ad-9607-410731a03e80",
                                        "glosses": [
                                            "In terms of music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d851ff1d-41a3-49e9-b3a1-01f42de12534",
                                                "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                                "text": "The film looked good, but was musically lacking."
                                            },
                                            {
                                                "example_id": "6648f021-e2c8-428e-a9a1-25a1cfba7c57",
                                                "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                                "text": "He's alſo muſically given, and ſo light of Heel, that there are few People can out-walk him."
                                            },
                                            {
                                                "example_id": "00d6020e-7e15-4ebc-81a8-c09d1ab5b081",
                                                "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                                "text": "Each sings the tune and words independently of his predecessor and follower, and their blending, though a collision of three sets of words and three sets of notes, is musically coherent."
                                            }
                                        ]
                                    }
                                ]
                            }
