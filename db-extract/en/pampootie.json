                        "glosses": [
                            "A traditional shoe, formerly made and worn on the Aran Islands of County Galway, Ireland, consisting of a single piece of untanned hide folded around the foot and stitched with twine or a leather strap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c84b30b-010c-49f6-8547-fbabe631629c",
                                "sense_id": "d3e4fddf-6591-3758-97e4-11bf97bccfc9",
                                "text": "[T]hey showed me holes in their own pampooties, or cowskin sandals, and asked me the price of new ones."
                            },
                            {
                                "example_id": "8c1ec88f-491a-4f47-ae2b-7419d0a9449a",
                                "sense_id": "d3e4fddf-6591-3758-97e4-11bf97bccfc9",
                                "text": "Quickly, warningfully Buck Mulligan bent down […] \"He heard you pissed on his halldoor in Glasthule. He's out in pampooties to murder you.\""
                            },
                            {
                                "example_id": "5299d06d-9491-44d8-af90-5ed8217e36d0",
                                "sense_id": "d3e4fddf-6591-3758-97e4-11bf97bccfc9",
                                "text": "Sebastian sat on the window sill. Tony leaning against the stove, grinning over his folded arms, a pair of pampooties on his crossed feet."
                            }
                        ]
                    }
