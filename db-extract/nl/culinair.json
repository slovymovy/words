                ],
                "senses": [
                    {
                        "sense_id": "c08dcb45-7908-36de-8599-7841e6c594c5",
                        "entry_id": "26f63c07-04e9-33ca-9bb3-25f938c6002b",
                        "glosses": [
                            "met betrekking tot de kookkunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99ddcdc-d3eb-403e-b8e0-bd630a869cd4",
                                "sense_id": "c08dcb45-7908-36de-8599-7841e6c594c5",
                                "text": "Deze thuiskok maakt altijd culinaire hoogstandjes in zijn keuken."
                            },
                            {
                                "example_id": "fa06fa48-f3ae-4413-8772-dc10e78a010a",
                                "sense_id": "c08dcb45-7908-36de-8599-7841e6c594c5",
                                "text": "'Wij willen een mooie geschiedenis voortzetten', zegt Patrick Henriroux van sterrenrestaurant La Pyramide in Vienne. Zijn zaak werd in 1923 geopend door Fernand Point, een culinaire legende die Paul Bocuse en andere topkoks opleidde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66d25415-514a-40d6-a9a4-636e350d1a08",
                        "source_entry_id": "26f63c07-04e9-33ca-9bb3-25f938c6002b",
                        "source_sense_id": "c08dcb45-7908-36de-8599-7841e6c594c5",
                        "source_sense_description": "met betrekking tot de kookkunst",
                        "target_lang_word": "kulinarisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kulinarisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5efb7e50-2b47-3173-8d7c-6fb23cb2ca75",
                                        "entry_id": "11c6636f-1745-304b-9b9a-577d054795c2",
                                        "glosses": [
                                            "die Kochkunst betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61d4d8ed-276b-493b-9c7e-8d14eeb407d6",
                                                "sense_id": "5efb7e50-2b47-3173-8d7c-6fb23cb2ca75",
                                                "text": "Der kulinarische Ruf des Hauses ist nicht der beste."
                                            },
                                            {
                                                "example_id": "a6b00d2b-3ce6-4085-ae90-85cf2f98a2fa",
                                                "sense_id": "5efb7e50-2b47-3173-8d7c-6fb23cb2ca75",
                                                "text": "„Und es gibt kaum ein größeres kulinarisches Desaster als eine schlechte Pizza, was noch dadurch verschlimmert wird, dass die meisten Pizzas auf der Welt schlecht sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "501af552-72e6-3ac7-8646-140f6351235c",
                                        "entry_id": "11c6636f-1745-304b-9b9a-577d054795c2",
                                        "glosses": [
                                            "hohen Ansprüchen genügend, was den Genuss betrifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9dd352-4e82-4544-9f8b-cc2beb9ca673",
                                                "sense_id": "501af552-72e6-3ac7-8646-140f6351235c",
                                                "text": "Bei ihm gibt es immer kulinarische Genüsse der Extraklasse."
                                            },
                                            {
                                                "example_id": "e48c856f-ae85-477c-a478-5059625186c8",
                                                "sense_id": "501af552-72e6-3ac7-8646-140f6351235c",
                                                "text": "»Dieses Buch macht nicht nur kulinarisch zufrieden, sondern auch ein bißchen weiser.« Eva Gesine Baur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
