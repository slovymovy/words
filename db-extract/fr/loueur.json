                        "form": "loueurs"
                    },
                    {
                        "form_id": "e8e3f84b-bfef-4840-a9b7-71c8ccf4dbb5",
                        "entry_id": "b5e660b8-6881-3f04-8f93-e53b743167fe",
                        "tags": [
                            "feminine"
                        ],
                        "form": "loueuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b1c6d2b-96bf-39f6-b4c7-d8cda93eada4",
                        "entry_id": "b5e660b8-6881-3f04-8f93-e53b743167fe",
                        "glosses": [
                            "Celui qui fait métier de donner quelque chose à louage ou à loyer."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "c2a4588d-25ca-4697-8a70-5f510fd002d1",
                                "sense_id": "0b1c6d2b-96bf-39f6-b4c7-d8cda93eada4",
                                "text": "Deux autres voyageurs se trouvant logés à la même enseigne que moi, nous allons trouver un loueur de voitures qui se charge de nous transporter à notre destination pour la somme de 13 pesetas; et, quelques minutes plus tard, nous sommes confortablement installés dans un léger véhicule attelé de deux bons chevaux qui ne tardent pas à rattraper et à dépasser le coche public."
                            },
                            {
                                "example_id": "aed01345-a717-4b3a-8be2-7659a329c0f0",
                                "sense_id": "0b1c6d2b-96bf-39f6-b4c7-d8cda93eada4",
                                "text": "[…] et ils sont bien assez malins pour lui avoir demandé son numéro de livret de Caisse d’épargne avant. Loueur de voitures, c'est comme marchand de bêtes, c'est des métiers d’arcandier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9336a11-bc9c-32a6-81d0-4221463b2fd8",
                        "entry_id": "b5e660b8-6881-3f04-8f93-e53b743167fe",
                        "glosses": [
                            "Celui qui fait métier de donner quelque chose à louage ou à loyer.",
                            "En particulier sorte de bailleur"
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "bf29a0c8-03c5-44aa-8374-cda9930bb89a",
                                "sense_id": "f9336a11-bc9c-32a6-81d0-4221463b2fd8",
                                "text": "Depuis le 1er mars 2023, cette réglementation impose aux loueurs, en zones dites « tendues » (24 communes, dont Biarritz), d’obtenir une autorisation de « changement d’usage » et de respecter le principe de compensation."
                            }
                        ]
                    }
                ],
