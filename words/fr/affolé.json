    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "54bed1ae-7814-3890-a44f-39c3455d9d9b",
                    "sense_definition": "Pris de panique ou de terreur au point de perdre la raison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin <w>affolé</w> n'arrivait plus à expliquer clairement ce qu'il venait de voir.",
                            "target_lang_translations": {
                                "en": "The witness, <w>distraught</w>, could no longer clearly explain what he had just seen.",
                                "ru": "<w>Перепуганный</w> свидетель уже не мог внятно объяснить, что он только что видел.",
                                "de": "Der <w>verstörte</w> Zeuge konnte nicht mehr klar erklären, was er gerade gesehen hatte.",
                                "es": "El testigo, <w>aterrado</w>, ya no lograba explicar con claridad lo que acababa de ver.",
                                "zh": "那个<w>惊慌失措</w>的证人已经无法清楚地解释他刚才看到的一切。"
                            }
                        },
                        {
                            "text": "Dès les premières secousses du séisme, les habitants ont fui l'immeuble d'un air <w>affolé</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the first tremors of the earthquake struck, residents fled the building with a <w>panicked</w> look.",
                                "ru": "Как только начались первые толчки землетрясения, жильцы выбежали из дома с <w>перепуганным</w> видом.",
                                "de": "Schon bei den ersten Erdstößen flohen die Bewohner mit <w>panischer</w> Miene aus dem Gebäude.",
                                "es": "En cuanto se produjeron las primeras sacudidas del terremoto, los vecinos huyeron del edificio con aire <w>aterrorizado</w>.",
                                "zh": "地震的头几次震动一来，居民们就带着<w>惊慌</w>的神色逃出了楼房。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paniqué",
                        "terrorisé",
                        "angoissé"
                    ],
                    "antonyms": [
                        "calme",
                        "serein",
                        "rassuré"
                    ],
                    "common_phrases": [
                        "air affolé",
                        "regard affolé"
                    ],
                    "target_lang_definitions": {
                        "en": "Overcome with panic or terror to the point of losing one's reason.",
                        "ru": "Охваченный паникой или ужасом до такой степени, что теряет рассудок.",
                        "de": "Vor Panik oder Schrecken so außer sich, dass man die Fassung verliert.",
                        "es": "Dominado por el pánico o el terror hasta el punto de perder la razón.",
                        "zh": "因极度恐惧而慌乱，以致失去理智。"
                    },
                    "translations": {
