                    {
                        "translation_id": "de5a939b-d972-496b-b6a1-63f31c009b8f",
                        "source_entry_id": "c8b7ee5d-feb8-3826-b0ca-69e349d96493",
                        "source_sense_id": "5c000863-a809-3c10-9fd2-55ced04e1892",
