                                        "glosses": [
                                            "strumentazione medica: apparecchiature tecniche per le differenti cure o terapie ed i \\\"canonici\\\" strumenti per operare"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "medico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "58991252-9ed0-3945-a0d1-c8e06e90c8d7",
                                        "entry_id": "fa5f7a74-d3b2-3a33-afeb-96b49382a851",
                                        "glosses": [
                                            "professionista laureato in medicina, abilitato a riconoscere, curare e prevenire alterazioni di salute"
                                        ],
                                        "tags": [
                                            "professione"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82bb945a-37cd-4cad-9ec2-124e0ea2bea7",
                                                "sense_id": "58991252-9ed0-3945-a0d1-c8e06e90c8d7",
                                                "text": "quel medico gli salvò la vita"
                                            },
                                            {
                                                "example_id": "434593f3-2761-4efb-95d3-a9bba5233d9d",
                                                "sense_id": "58991252-9ed0-3945-a0d1-c8e06e90c8d7",
                                                "text": "il bambino ha fiducia nel suo medico perché è protettivo"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "medico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "8588d7ee-673e-3063-a5a7-dbb603b487f1",
                                        "entry_id": "213b4f8f-8938-30e7-8716-39db2592aa10",
                                        "glosses": [
                                            "prima persona singolare dell'indicativo presente di medicare"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f5e87c-4dac-42d6-8344-b557ed908259",
                                                "sense_id": "8588d7ee-673e-3063-a5a7-dbb603b487f1",
                                                "text": "Ti sei fatta male. Aspetta che ti medico"
                                            },
                                            {
                                                "example_id": "6813b813-4ad8-411d-9a10-0080c5b2472c",
                                                "sense_id": "8588d7ee-673e-3063-a5a7-dbb603b487f1",
