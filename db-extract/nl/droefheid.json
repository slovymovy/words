                        "sense_id": "ec46d59b-5a8d-3830-8bdc-093996fbe3ff",
                        "entry_id": "9b5cf958-5145-3d00-a969-4e86347922b2",
                        "glosses": [
                            "de mate van droef zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70851e2-4203-4556-8d2d-351894226783",
                                "sense_id": "ec46d59b-5a8d-3830-8bdc-093996fbe3ff",
                                "text": "De droefheid was groot toen onze hond overleed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b46916f9-99df-49c5-896d-9fdb78028b9c",
                        "source_entry_id": "9b5cf958-5145-3d00-a969-4e86347922b2",
                        "source_sense_id": "ec46d59b-5a8d-3830-8bdc-093996fbe3ff",
                        "source_sense_description": "de mate van droef zijn",
                        "target_lang_word": "Traurigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Traurigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3183ef1-eb78-3409-b181-bc9b263eb678",
                                        "entry_id": "e4b5ff86-911b-3d8b-bc27-363e0a28bdb9",
                                        "glosses": [
                                            "die Emotion, die man empfindet, wenn man traurig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1965e344-28ff-4016-b17b-eb041c2456b1",
                                                "sense_id": "a3183ef1-eb78-3409-b181-bc9b263eb678",
                                                "text": "„Und so war sein letztes Statement bei diesem Turnier von einer typisch portugiesischen Traurigkeit geprägt, die ansteckend wirkte: Das Schicksal hat es wieder einmal allzu schlecht gemeint mit dem geschundenen, kleinen Land. Fado.“"
                                            },
                                            {
                                                "example_id": "a697c8ce-10d6-462d-82bf-f8f16076ea23",
                                                "sense_id": "a3183ef1-eb78-3409-b181-bc9b263eb678",
                                                "text": "„Diese Traurigkeit war schlimmer als Wut.“"
                                            },
                                            {
                                                "example_id": "8a7ddd45-84d5-48c4-b287-a811c7b92aba",
                                                "sense_id": "a3183ef1-eb78-3409-b181-bc9b263eb678",
                                                "text": "„Dann sah sie Prinzessin Marjas traurigen Gesichtsausdruck, erfasste sofort die Ursache ihrer Traurigkeit und brach plötzlich in Tränen aus.“"
                                            },
                                            {
                                                "example_id": "79ad250b-304c-44d0-aec1-0f31b1802c5e",
                                                "sense_id": "a3183ef1-eb78-3409-b181-bc9b263eb678",
                                                "text": "„Ich reiste also mit Poinsinet ab, der mich in seiner Traurigkeit mit den drolligsten Einfällen unterhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa481b64-f966-4b74-ba4d-6bc4a71388bd",
                        "source_entry_id": "9b5cf958-5145-3d00-a969-4e86347922b2",
                        "source_sense_id": "ec46d59b-5a8d-3830-8bdc-093996fbe3ff",
                        "source_sense_description": "de mate van droef zijn",
                        "target_lang_word": "sadness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                        "entry_id": "ac15c272-5d49-3adb-8727-49cfa74d24de",
                                        "glosses": [
                                            "The state or emotion of being sad."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07580aa-a47f-4349-b65a-abc674ac5ece",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "But sorrow that is couch'd in seeming gladness\nIs like that mirth fate turns to sudden sadness."
                                            },
                                            {
                                                "example_id": "635136ab-677a-4e81-92dc-c659f2196f40",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "I mean not then under the name of Sadneſs to defend effeminate Bewailings and Lamentations; let them that ſubject themſelves to this weakeſt Impatience, be alſo ſubject to the Lycian Law, that bound theſe kind of Lamenters to be array'd like Women: […]"
                                            },
                                            {
                                                "example_id": "b210ade1-7964-4c4f-9e08-9bcef0103b4a",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "The survey found increasing mental health challenges, experiences of violence, and suicidal thoughts and behavior among all teens. More than 40% of high school students said that feelings of sadness or hopelessness prevented them from engaging in their regular activities for at least two weeks of the year."
                                            },
                                            {
                                                "example_id": "edb94245-8cde-40f7-8baa-6fa207e904ad",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "The compassion to yourself comes in validating the feelings your inner child is having –– the stress, fear, anger or sadness — and make adult decisions about the best way to move forward, Lev said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e926c19d-a8e5-331a-ae79-fa68c061dd32",
                                        "entry_id": "ac15c272-5d49-3adb-8727-49cfa74d24de",
                                        "glosses": [
                                            "An event in one's life that causes sadness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "737b3017-46d7-48bf-b3e5-0f26066559ff",
                                                "sense_id": "e926c19d-a8e5-331a-ae79-fa68c061dd32",
                                                "text": "She has experienced many sadnesses in her forty years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
