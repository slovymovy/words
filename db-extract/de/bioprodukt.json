                "senses": [
                    {
                        "sense_id": "1471d160-c8d7-3064-b890-c6d5b83e6e1f",
                        "entry_id": "a196211a-a00b-363e-8683-3322f4a95e2c",
                        "glosses": [
                            "Ware, die aus ökologischer und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3fe12c3-05de-4d72-ac3e-e3f8a69b2699",
                                "sense_id": "1471d160-c8d7-3064-b890-c6d5b83e6e1f",
                                "text": "„Bioprodukte können zwar für uns Menschen gesund sein, aber trotzdem unter umweltschädigenden und unmenschlichen Bedingungen hergestellt worden sein.“"
                            },
                            {
                                "example_id": "8cb7636c-6f0c-4c3f-b897-4213f35edc1a",
                                "sense_id": "1471d160-c8d7-3064-b890-c6d5b83e6e1f",
                                "text": "„Sehr widersprüchlich natürlich, wenn man ein hochwertiges Bioprodukt aus der Region in eine Plastikverpackung packt.“"
                            },
                            {
                                "example_id": "f80480e0-9ac8-4c74-ada6-cc4fea754acb",
                                "sense_id": "1471d160-c8d7-3064-b890-c6d5b83e6e1f",
                                "text": "„Schön wäre, wenn den Konsumenten die Bioprodukte mehr wert wären, weil sie wissen, wo diese herkommen und dass jeder Biobauer auch überwacht wird.“"
                            },
                            {
                                "example_id": "3b5553fb-35cd-4ec7-8d7b-499a64d66446",
                                "sense_id": "1471d160-c8d7-3064-b890-c6d5b83e6e1f",
                                "text": "„Wichtig ist zu beachten, dass Bioprodukte nicht immer die ökologisch bessere Alternative darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
