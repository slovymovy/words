                ],
                "senses": [
                    {
                        "sense_id": "fe5b8deb-7d24-303b-a938-15bf134ee3f2",
                        "entry_id": "70722a87-25fb-34aa-bc5b-c0eb19053a5d",
                        "glosses": [
                            "bestimmte Töne, die ein laufender Motor erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0434e648-87c4-46b6-8a96-9639e0fd4113",
                                "sense_id": "fe5b8deb-7d24-303b-a938-15bf134ee3f2",
                                "text": "„Lärmvermeidung bei Produkten erhält zunehmende Bedeutung, z.B. Fahrgeräusche (außen und innen) von Fahrzeugen, Maschinen und Motorengeräusche im Leerlauf und unter Belastung.“"
                            },
                            {
                                "example_id": "e164f2a9-152b-45ff-ba9d-96adccf3df87",
                                "sense_id": "fe5b8deb-7d24-303b-a938-15bf134ee3f2",
                                "text": "„Das Motorengeräusch ist ein rauhes Röhren.“"
                            },
                            {
                                "example_id": "53d80731-132a-4141-b882-d68cf4cfc2a7",
                                "sense_id": "fe5b8deb-7d24-303b-a938-15bf134ee3f2",
                                "text": "„Auf einmal hörten sie näher kommende Motorengeräusche, und gut zweihundert Meter vor ihnen tauchten Scheinwerfer auf.“"
                            },
                            {
                                "example_id": "a0fcdb08-4802-4a2a-a2a0-493b50932770",
                                "sense_id": "fe5b8deb-7d24-303b-a938-15bf134ee3f2",
                                "text": "„Bond hörte den Peugeot anspringen, und kurze Zeit später verschwand das Motorengeräusch auf der nach Royale führenden Straße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
