                    "frequency": "Low",
                    "semantic_group_id": "biological_attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Barnacles are <w>sessile</w> organisms that remain anchored to rocks for their entire adult lives."
                        },
                        {
                            "text": "Unlike motile marine creatures, many corals live as <w>sessile</w> colonies on the ocean floor."
                        }
                    ],
                    "synonyms": [
                        "immobile",
                        "immotile",
                        "attached",
                        "fixed"
                    ],
