                        "glosses": [
                            "miara zakrzywienia linii, powierzchni lub przestrzeni; wielkość określająca, jak silnie dana figura odbiega od prostoliniowości lub płaskości"
                        ],
                        "tags": [],
                        "examples": [
                            {
