                    "sense_id": "5dfda8ed-3d63-3fa2-a04f-6052ff1cd788",
                    "sense_definition": "Qui fait preuve de calme, de réflexion et de sérieux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'exprime toujours d'un ton <w>posé</w> pendant les réunions importantes.",
                            "target_lang_translations": {
                                "en": "He always speaks in a <w>calm</w> tone during important meetings.",
                                "ru": "Он всегда говорит <w>спокойным</w> тоном на важных совещаниях.",
                                "de": "Bei wichtigen Besprechungen spricht er immer in einem <w>ruhigen</w> Ton.",
                                "es": "Siempre habla con un tono <w>sereno</w> en las reuniones importantes.",
                                "zh": "在重要的会议上，他说话总是用<w>沉稳</w>的语气。"
                            }
                        },
                        {
                            "text": "Elle garde un tempérament <w>posé</w> même face aux situations les plus stressantes.",
                            "target_lang_translations": {
                                "en": "She keeps a <w>composed</w> temperament even in the most stressful situations.",
                                "ru": "Она сохраняет <w>уравновешенный</w> характер даже в самых напряжённых ситуациях.",
                                "de": "Auch in den stressigsten Situationen bewahrt sie ein <w>gelassenes</w> Wesen.",
                                "es": "Mantiene un carácter <w>sereno</w> incluso ante las situaciones más estresantes.",
                                "zh": "即使面对压力最大的情况，她依然保持着<w>沉稳</w>的性情。"
                            }
                        }
