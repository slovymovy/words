                "senses": [
                    {
                        "sense_id": "5466db4c-cf7b-3520-b7c2-9fb5315148d7",
                        "entry_id": "df6779ff-8c64-3f3a-8288-3fb8b40d6e8d",
                        "glosses": [
                            "Messgerät/Messfühler, der biologisches Material enthält und physikalisch-chemische Messungen durchführt"
                        ],
                        "tags": [
                            "Analytik",
                            "Bioanalytik",
                            "Umweltanalytik"
                        ],
                        "examples": [
                            {
                                "example_id": "4833ffd6-4c74-4e59-a5f5-01e1bbea4376",
                                "sense_id": "5466db4c-cf7b-3520-b7c2-9fb5315148d7",
                                "text": "„Die Empfindlichkeit und Selektivität bezieht ein Biosensor aus dem verwendeten biologischen System.“"
                            },
                            {
                                "example_id": "83b16c62-4edc-4a6d-9b6e-8dded458bfd6",
                                "sense_id": "5466db4c-cf7b-3520-b7c2-9fb5315148d7",
                                "text": "„Ein Biosensor wird üblicherweise definiert als ein Sensor, der eine biologische molekulare Erkennungskomponente mit einem Meßwandler (dem sogenannten Transducer) verbindet, dessen elektrisches Ausgangssignal eine Funktion der zu detektierenden Analytkonzentration ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
