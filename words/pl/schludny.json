            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1824551-5dd2-312b-971c-d162b874ca01",
                    "sense_definition": "taki, który dba o czystość i porządek",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "porządek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To bardzo <w>schludny</w> człowiek, który zawsze dba o swoje ubrania.",
                            "target_lang_translations": {
                                "ru": "Это очень <w>опрятный</w> человек, который всегда следит за своей одеждой."
                            }
                        },
                        {
                            "text": "Mój <w>schludny</w> sąsiad codziennie sprząta przed swoim domem.",
                            "target_lang_translations": {
                                "ru": "Мой <w>аккуратный</w> сосед каждый день убирается перед своим домом."
                            }
                        }
                    ],
                    "synonyms": [
                        "porządny",
                        "zadbany"
                    ],
                    "antonyms": [
                        "niechlujny"
                    ],
                    "common_phrases": [
                        "schludny wygląd",
                        "schludny człowiek"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который следит за чистотой и порядком, аккуратный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрятный",
                                "target_lang_sense_clarification": "о человеке, который соблюдает чистоту и порядок"
                            },
                            {
                                "target_lang_word": "аккуратный",
                                "target_lang_sense_clarification": "о человеке, который следит за своим внешним видом и вещами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6441777-8cfa-3874-a2e3-a332b4164305",
                    "sense_definition": "taki, który utrzymywany jest w czystości, porządku lub ładzie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "porządek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jej pokoju zawsze panuje <w>schludny</w> porządek.",
                            "target_lang_translations": {
                                "ru": "В её комнате всегда царит <w>опрятный</w> порядок."
                            }
                        },
                        {
                            "text": "Mieszkanie wyglądało na bardzo <w>schludne</w> i przytulne.",
                            "target_lang_translations": {
                                "ru": "Квартира выглядела очень <w>опрятной</w> и уютной."
                            }
                        }
                    ],
                    "synonyms": [
                        "czysty",
                        "zadbany"
                    ],
                    "antonyms": [
                        "brudny"
                    ],
                    "common_phrases": [
                        "schludny pokój",
                        "schludne mieszkanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "то, что содержится в чистоте, порядке или аккуратности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрятный",
                                "target_lang_sense_clarification": "о предметах или помещениях, которые выглядят чистыми и ухоженными"
                            },
                            {
                                "target_lang_word": "аккуратный",
                                "target_lang_sense_clarification": "о вещах, которые содержатся в порядке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
