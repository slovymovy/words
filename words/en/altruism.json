{
    "word_family": [
        "altruist",
        "altruistic",
        "altruistically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00750718-062b-3a59-b5ed-8481d8e84f58",
                    "sense_definition": "Unselfish regard for or devotion to the welfare and interests of others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "altruism_concern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many volunteers are motivated purely by <w>altruism</w> rather than personal gain.",
                            "target_lang_translations": {
                                "zh": "许多志愿者纯粹是出于<w>利他主义</w>，而不是为了个人私利。"
                            }
                        },
                        {
                            "text": "Her decision to donate a kidney was an incredible act of <w>altruism</w>.",
                            "target_lang_translations": {
                                "zh": "她捐献肾脏的决定是一次了不起的<w>利他行为</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "selflessness",
                        "philanthropy"
                    ],
                    "antonyms": [
                        "egoism",
                        "selfishness",
                        "misanthropy"
                    ],
                    "common_phrases": [
                        "act of altruism",
                        "pure altruism"
                    ],
                    "target_lang_definitions": {
                        "zh": "无私关怀或奉献于他人的福祉和利益的行为或精神；利他主义。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "利他主义",
                                "target_lang_sense_clarification": "指把他人利益放在首位的道德原则或精神"
                            },
                            {
                                "target_lang_word": "利他行为",
                                "target_lang_sense_clarification": "无私帮助他人的举动"
                            },
                            {
                                "target_lang_word": "无私",
                                "target_lang_sense_clarification": "不求个人私利、一心为人的品质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0316776-b335-39a7-92db-995c13b43d08",
                    "sense_definition": "Behavior by an animal or individual that benefits another at a cost to itself.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "altruism_biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biologists study reciprocal <w>altruism</w> in animals that share food with non-relatives.",
                            "target_lang_translations": {
                                "zh": "生物学家在与非亲属分享食物的动物身上研究互惠<w>利他行为</w>。"
                            }
                        },
                        {
                            "text": "Warning calls in meerkat colonies are a classic example of biological <w>altruism</w>.",
                            "target_lang_translations": {
                                "zh": "狐獴群落中的报警叫声是生物学上<w>利他行为</w>的经典例子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "selflessness"
                    ],
                    "antonyms": [
                        "selfishness"
                    ],
                    "common_phrases": [
                        "reciprocal altruism",
                        "biological altruism"
                    ],
                    "target_lang_definitions": {
                        "zh": "动物或个体以自身付出代价为代价来使他人获益的生物学行为；利他行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "利他行为",
                                "target_lang_sense_clarification": "生物学中不利于自身生存或繁殖却有利于他者的行为"
                            },
                            {
                                "target_lang_word": "利他性",
                                "target_lang_sense_clarification": "生物体表现出的利他特征或倾向"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}