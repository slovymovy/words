                "senses": [
                    {
                        "sense_id": "91028285-cf6c-38f9-a89c-e49b0eb9ae3c",
                        "entry_id": "db6407ab-33ea-3e07-a182-b86006e7dc02",
                        "glosses": [
                            "Ensemble des voyelles d’une langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e929b5da-8db2-46c3-9418-a2d19ed5d547",
                                "sense_id": "91028285-cf6c-38f9-a89c-e49b0eb9ae3c",
                                "text": "Le vocalisme du français est riche."
                            },
                            {
                                "example_id": "e3436817-d09a-4c99-b2d2-01afe178bc90",
                                "sense_id": "91028285-cf6c-38f9-a89c-e49b0eb9ae3c",
                                "text": "La richesse du vocalisme médiéval était encore accrue par une floraison de diphtongues dont il ne reste plus rien en dehors des parlers régionaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d48f47c-f606-48d9-912f-fcd3963ffad3",
                        "source_entry_id": "db6407ab-33ea-3e07-a182-b86006e7dc02",
                        "source_sense_id": "91028285-cf6c-38f9-a89c-e49b0eb9ae3c",
                        "target_lang_word": "Vokalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vokalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d51ada-eec8-3201-aea9-81e6594d6b05",
                                        "entry_id": "e1136f25-5664-3733-aa0d-7d78c86b94ce",
                                        "glosses": [
                                            "Menge oder System der Vokale einer Sprache oder einer sprachlichen Einheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81644772-5316-4f36-a139-61b0329726a4",
                                                "sense_id": "d4d51ada-eec8-3201-aea9-81e6594d6b05",
                                                "text": "„Den Gesamtbestand der Vokale einer Sprache, auch den Vokalbestand eines Wortes, nennt man häufig Vokalismus; entsprechend verwendet wird Konsonantismus.“"
                                            },
                                            {
                                                "example_id": "d792ec5e-c74b-4424-b2a5-97611f0273a6",
                                                "sense_id": "d4d51ada-eec8-3201-aea9-81e6594d6b05",
                                                "text": "„Im Bereich des Vokalismus sind - nach der schriftlichen Überlieferung und in jedem Fall in raum-zeitlich sehr uneinheitlicher Belegung - die folgenden Veränderungen für die Geschichte des neuhochdeutschen Standards konstitutiv…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
