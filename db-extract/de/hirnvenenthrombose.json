                "senses": [
                    {
                        "sense_id": "e0fc979d-ae7c-3d96-b9c2-6bdc1162ca8c",
                        "entry_id": "19b8781c-6152-30b6-9eee-47cecfa70b7b",
                        "glosses": [
                            "Thrombose (Gerinnsel), die in den venöses Blut führenden Adern des Gehirns auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8c9a82-d275-404b-b6c0-9f503cde0f90",
                                "sense_id": "e0fc979d-ae7c-3d96-b9c2-6bdc1162ca8c",
                                "text": "Eine Hirnvenenthrombose ist ein thrombotischer Prozess in einer der hirnversorgenden Venen. Die Sinusthrombose hingegen benennt speziell eine Thrombose des Hirnsinus."
                            },
                            {
                                "example_id": "c012304b-87ca-42ed-93b1-a12ded9efada",
                                "sense_id": "e0fc979d-ae7c-3d96-b9c2-6bdc1162ca8c",
                                "text": "Hirnvenenenthrombosen sind eine seltene Komplikation, bei der ein Blutgerinnsel eine Hirnvene verstopft, so dass das Blut nicht mehr aus dem Gehirn abfließen kann."
                            },
                            {
                                "example_id": "3b37f7b6-cae3-4c6c-9ada-e4e1e6ae2efa",
                                "sense_id": "e0fc979d-ae7c-3d96-b9c2-6bdc1162ca8c",
                                "text": "„Hirnvenenthrombosen sind oftmals die Folge einer Sinusthrombose, einer Thrombose der Sinus durae matris der Gehirnhaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
