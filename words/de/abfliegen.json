                    "frequency": "High",
                    "semantic_group_id": "abfliegen_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Flugzeug nach Mallorca <w>fliegt</w> heute ganz pünktlich um zehn Uhr morgens <w>ab</w>."
                        },
                        {
                            "text": "Wir mussten uns sehr beeilen, denn unsere Maschine sollte in dreißig Minuten <w>abfliegen</w>."
                        }
                    ],
                    "synonyms": [
                        "starten",
                        "abreisen",
