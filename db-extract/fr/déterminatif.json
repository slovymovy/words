                                "target_senses": [
                                    {
                                        "sense_id": "0cc9d572-4f3d-374c-a56e-8926c3a9703c",
                                        "entry_id": "c220d6b5-a487-3c5e-a74d-f3fc1d8130e8",
                                        "glosses": [
                                            "An ideogram used to mark semantic categories of words in logographic scripts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff7d56a3-745a-39f7-8ddb-148b09f7733f",
                                        "entry_id": "c220d6b5-a487-3c5e-a74d-f3fc1d8130e8",
                                        "glosses": [
                                            "A member of a class of words functioning in a noun phrase to identify or distinguish a referent without describing or modifying it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "determinative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc41272f-5b5f-3ef1-851b-82fb680f1e6a",
                                        "entry_id": "5158f2c0-ba83-339e-b4a8-93ca00a6fc64",
                                        "glosses": [
                                            "That determines something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1239d14-a381-3c86-bea0-13288daf20a1",
                                        "entry_id": "5158f2c0-ba83-339e-b4a8-93ca00a6fc64",
                                        "glosses": [
                                            "Sufficient to decide something (such as a question of fact or of law)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a892a27-2efe-41bb-861e-8a52fb7d5824",
                                                "sense_id": "b1239d14-a381-3c86-bea0-13288daf20a1",
                                                "text": "When assigning custody, the preference of the child will be considered, but it is not determinative."
                                            },
                                            {
                                                "example_id": "37386163-0a7c-4a4d-ad3f-a6464d7c3c56",
                                                "sense_id": "b1239d14-a381-3c86-bea0-13288daf20a1",
                                                "text": "This proceeding, though not presenting questions difficult of determination, or points of law that are novel, is unusual in many of its features, and is important as determinative of the disposition and welfare of a number of little children, ignorant of the contest that is being carried on in regard to them."
                                            },
                                            {
                                                "example_id": "4f31d4aa-1bf9-4c1c-a047-67e20a91238c",
                                                "sense_id": "b1239d14-a381-3c86-bea0-13288daf20a1",
                                                "text": "It is therefore clear that, even in adoption cases where it might play a more important role, race is not a determinative factor and its importance will depend greatly on the facts."
                                            },
                                            {
                                                "example_id": "6f43ebbf-9350-4857-bd15-1a3b45ff28c4",
                                                "sense_id": "b1239d14-a381-3c86-bea0-13288daf20a1",
                                                "text": "An entity does not automatically conclude that any observed transaction price is determinative of fair value."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
