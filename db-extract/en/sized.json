                    {
                        "sense_id": "3e77dab1-0263-356e-a2d4-3d83a227a9d0",
                        "entry_id": "cffc9287-c6d4-3bda-83be-7b949be378ad",
                        "glosses": [
                            "Having a certain size. Usually used in combination with an adverb or a noun."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c5df9993-eaca-440a-a112-8325c34f781d",
                                "sense_id": "3e77dab1-0263-356e-a2d4-3d83a227a9d0",
                                "text": "A badly-sized pair of shoes."
                            },
                            {
                                "example_id": "f387ff0e-bd7a-428c-9524-87fd52fe9e31",
                                "sense_id": "3e77dab1-0263-356e-a2d4-3d83a227a9d0",
                                "text": "A pea-sized creature."
                            },
                            {
                                "example_id": "7541de24-ab6e-4dca-8fcb-f0312a0922c4",
                                "sense_id": "3e77dab1-0263-356e-a2d4-3d83a227a9d0",
                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                            },
                            {
                                "example_id": "60aa2253-e85f-4997-9afb-b708808f3486",
                                "sense_id": "3e77dab1-0263-356e-a2d4-3d83a227a9d0",
                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                            }
                        ]
                    }
