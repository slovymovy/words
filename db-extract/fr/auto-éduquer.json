                        "glosses": [
                            "Faire en sorte que quelqu’un s’éduque soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "519ec81d-b560-4edc-925f-eefba8f46d35",
                                "sense_id": "ebf2e5db-66a4-3479-8cfe-3de45cb685f0",
                                "text": "Toutes les professions artistiques sont associées à un objectif des plus difficiles : auto-éduquer le public."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a034d23-0124-31d1-bf4f-4fe3fd2ad01a",
                        "entry_id": "2e117310-7560-330a-8873-cdd92135669c",
                        "glosses": [
                            "S’éduquer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "15fb34eb-575f-446d-9659-5e4a9ed4e946",
                                "sense_id": "6a034d23-0124-31d1-bf4f-4fe3fd2ad01a",
                                "text": "Il est dit en fait que les jeunes voudraient s'auto-éduquer."
                            },
                            {
                                "example_id": "22076788-8c7e-4743-a820-bf256d028f2a",
                                "sense_id": "6a034d23-0124-31d1-bf4f-4fe3fd2ad01a",
                                "text": "S'auto-éduquer, prendre soin de soi ou apprendre à prendre soin de l'autre passe par la reprise en main du récit de soi."
                            }
                        ]
