                                    {
                                        "sense_id": "bbc3672a-ad79-3cf5-baa7-997d4d87cc9a",
                                        "entry_id": "76270e62-df99-3ec8-afc1-43130897cc62",
                                        "glosses": [
                                            "Vêtement souvent bleu qui couvre entièrement la tête et le corps, une grille au niveau des yeux permettant de voir sans être vu."
                                        ],
                                        "tags": [
                                            "Afghanistan"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6f2f83b-b6e2-3528-b874-317318ed77e0",
                                        "entry_id": "76270e62-df99-3ec8-afc1-43130897cc62",
                                        "glosses": [
                                            "Voile fixé sur la tête, par-dessus un hijab, et qui couvre la tête avec une fente permettant de voir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b088e0-1850-4c5b-88a9-b9fc27fa76f3",
                                                "sense_id": "a6f2f83b-b6e2-3528-b874-317318ed77e0",
                                                "text": "Des députés ouvrent le débat sur le port de la burqa."
                                            },
                                            {
                                                "example_id": "73da251a-86c6-4e0d-9625-1183668cfa67",
                                                "sense_id": "a6f2f83b-b6e2-3528-b874-317318ed77e0",
                                                "text": "Associer l’islam politique aux libéraux de Justin Trudeau n’est pas sans rappeler une des stratégies électorales du Bloc en 2015. Sa publicité sur la burqa avait réussi à torpiller la campagne du NPD et de son chef Thomas Mulcair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3207b698-2828-4875-8552-cf1dabe4495c",
                        "source_entry_id": "2158c474-9cf6-32ed-9319-33a06af5c6f7",
                        "source_sense_description": "female garment that covers the whole body",
                        "target_lang_word": "voile intégral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
