                                                "sense_id": "f253daf4-49f5-3685-988e-4ec16b762bb4",
                                                "text": "Durch die meterdicken Mauern galt die Festung als uneinnehmbar."
                                            },
                                            {
                                                "example_id": "4a99c9ac-0c63-4281-a9a4-b0d98d34273f",
                                                "sense_id": "f253daf4-49f5-3685-988e-4ec16b762bb4",
