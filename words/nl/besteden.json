                    "sense_definition": "Geld, tijd, moeite of aandacht gebruiken voor een bepaald doel",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>besteden</w> veel tijd aan het leren van nieuwe talen.",
                            "target_lang_translations": {
                                "ru": "Мы <w>тратим</w> много времени на изучение новых языков.",
                                "en": "We <w>spend</w> a lot of time learning new languages.",
                                "fr": "Nous <w>consacrons</w> beaucoup de temps à l'apprentissage de nouvelles langues."
                            }
                        },
                        {
                            "text": "Je moet niet al je zakgeld in één keer aan snoep <w>besteden</w>.",
                            "target_lang_translations": {
                                "ru": "Ты не должен <w>тратить</w> все свои карманные деньги на сладости за один раз.",
                                "en": "You shouldn't <w>spend</w> all your pocket money on candy at once.",
                                "fr": "Tu ne dois pas <w>dépenser</w> tout ton argent de poche en bonbons d'un coup."
                            }
                        },
                        {
                            "text": "De leraar vindt dat we meer aandacht aan de grammatica moeten <w>besteden</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель считает, что мы должны <w>уделять</w> больше внимания грамматике.",
                                "en": "The teacher thinks we should <w>pay</w> more attention to grammar.",
                                "fr": "L'enseignant pense que nous devrions <w>accorder</w> plus d'attention à la grammaire."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitgeven",
                        "spenderen",
                        "gebruiken"
                    ],
                    "antonyms": [
                        "besparen",
                        "oppotten"
                    ],
                    "common_phrases": [
                        "aandacht besteden aan",
