                        ],
                        "form": "more abeam"
                    },
                    {
                        "form_id": "0e4c0c3b-0921-4790-ac80-fbc6f4765e95",
                        "entry_id": "3b8c7056-8228-32bd-b4ec-1b04b26dec8e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most abeam"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                        "entry_id": "3b8c7056-8228-32bd-b4ec-1b04b26dec8e",
                        "glosses": [
                            "Alongside or abreast; opposite the center of the side of the ship or aircraft."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5732d4-74ee-42cc-928c-9c2c9706dc72",
                                "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                                "text": "The island was directly abeam of us."
                            },
                            {
                                "example_id": "c1ad895a-37c5-4d2f-ad3b-8034a5231985",
                                "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                                "text": "The sound shifted its place markedly, but without coming nearer. It even grew a little more distant right abeam of the lighter, and then ceased again."
                            },
                            {
                                "example_id": "0df4cbd5-c4a6-44bb-ae69-a623cf35c2a1",
                                "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                                "text": "The attack on the abeam ship, Louisville, killed Commander Cruiser Division Four […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "44bc12d9-9e77-3d22-bf1b-7792e541f8f9",
                "word": "abeam",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                        "entry_id": "44bc12d9-9e77-3d22-bf1b-7792e541f8f9",
                        "glosses": [
                            "Beaming, shining (especially with reference to a person's face or eyes)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dad68bdd-a757-4bcc-921b-8296d7462b78",
                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                "text": "1876, William Davidson, Sermons on the Parables, Cincinnati: Western Tract Society, Sermon 1, p. 41,\n[…] the hearts of the saints [will] be all attention and their faces all abeam for the consolation;"
                            },
                            {
                                "example_id": "c5861dc3-6078-48e4-9d33-f9c25cb3abc9",
                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                "text": "[…] the waiters fly about abeam with good will and on excellent terms with those they serve […]"
                            },
                            {
                                "example_id": "0b75ece1-9bb8-4563-8f9e-55f360eab0c1",
                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                "text": "[…] since he refused to be intimidated, stage two of their introduction consisted of Sheba sitting round in attitudes of beleaguered desperation while Seeley, his face abeam with adulation, sat determinedly beside her."
                            },
                            {
                                "example_id": "e2c77c4d-e709-4223-b380-8dda972e3b03",
                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                "text": "When we met for another lunch […] he was all abeam with pride as he handed me a newly minted paperback reissue of Wodehouse […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
