                    "synonyms": [
                        "handshaking"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon often referred to as handshaking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, посредством которого два модема или устройства обмениваются сигналами для определения протокола и скорости связи.",
                        "tr": "İki modem veya cihazın iletişim için protokol ve hızı belirlemek üzere sinyal tealleşmesi süreci.",
                        "zh": "两个调制解调器或设备交换信号以确定通信协议和速度的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласование",
                                "target_lang_sense_clarification": "технический процесс установления связи"
