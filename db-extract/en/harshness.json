                        "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                        "entry_id": "ebbe658f-30fb-345e-8d26-f3cb8c06bfcc",
                        "glosses": [
                            "The quality of being harsh."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "36c88f5d-ea3c-4336-bc89-80716edac67b",
                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                "text": "And yet these harshnesses are tenderness itself when compared with the universal harshness out of which they grow; the harshness of the position towards the temperament, of the means towards the aims, of to-day towards yesterday, of hereafter towards to-day."
                            },
                            {
                                "example_id": "d06d9a76-a1af-47b3-b315-51a21e681c54",
                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                            }
                        ]
                    }
                ],
