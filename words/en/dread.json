                            "comment": "Often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильный страх; ужасный или пугающий.",
                        "de": "Große Angst verursachend; extrem schrecklich.",
                        "zh": "引起极大恐惧的；极其可怕的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "вызывающий ужас"
