                "translations": [
                    {
                        "translation_id": "2e27bf1b-7ae3-4e5b-bc58-4f1536df2ad3",
                        "source_entry_id": "cd37bba1-2ea4-35e0-bb90-852e72af49d7",
                        "source_sense_id": "2ea428cf-41d1-3509-ace4-6b2ae4d4a61a",
                        "source_sense_description": "Trinkgelage, Zechgelage",
                        "target_lang_word": "Trinkgelage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trinkgelage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                        "entry_id": "2f67b57b-1280-36cc-9f04-860b9dd81b9b",
                                        "glosses": [
                                            "meist veraltet oder verächtlich: gesellschaftliches Ereignis mit dem Zweck, möglichst viel Alkohol zu konsumieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243d3230-7e48-41d5-adef-a9cd2d831568",
                                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                                "text": "Sie konnte seine nächtlichen Trinkgelage nicht mehr ertragen und verließ ihn schließlich."
                                            },
                                            {
                                                "example_id": "90251ef3-d301-424d-87df-d6fbc78db7c7",
                                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                                "text": "„Außerdem eignete sich die Hauptstadt besser für fürstliche Lebensweise, Trinkgelage und großes Gehabe.“"
                                            },
                                            {
                                                "example_id": "bdb75273-d329-4a63-bc45-0622f6e05136",
                                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                                "text": "„Anatol versäumte kein Trinkgelage bei Danilow und anderen Moskauer Zechbrüdern, trank ganze Nächte durch, bis alle anderen unter dem Tisch lagen, und zeigte sich auf allen Soireen und Bällen der ganzen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "881d5bf7-ddef-429a-9244-c1dc719fc588",
                                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                                "text": "„Der Maler beurlaubte sich, um sich in dem alten Empfangssaal, der früher einmal Trinkgelagen diente, aber seit langem nicht mehr benutzt wurde, mit den Fresken zu beschäftigen.“"
                                            },
                                            {
                                                "example_id": "29db432e-bc0c-4901-86a6-93b67e937082",
                                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                                "text": "„Er ist mit der Arbeit unzufrieden, weiß nur zu genau, daß er durch die vielen Reisen und die nächtlichen Trinkgelage mit zu großen Unterbrechungen und wenig konzentriert am Schreibtisch sitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd1d5fc8-a430-400f-9f17-039a01536a78",
                        "source_entry_id": "cd37bba1-2ea4-35e0-bb90-852e72af49d7",
                        "source_sense_id": "2ea428cf-41d1-3509-ace4-6b2ae4d4a61a",
                        "source_sense_description": "Trinkgelage, Zechgelage",
                        "target_lang_word": "Zechgelage",
                        "target_lang_code": "de",
