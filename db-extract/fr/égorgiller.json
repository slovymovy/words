                ],
                "senses": [
                    {
                        "sense_id": "889d5075-26ce-3ed8-bf34-d9b276b1ffeb",
                        "entry_id": "2f091601-bd19-393c-8962-e2b74a226ffd",
                        "glosses": [
                            "Prendre à la gorge, égorger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3780e3e-bebe-4a1e-b22a-4302fa60d687",
                                "sense_id": "889d5075-26ce-3ed8-bf34-d9b276b1ffeb",
                                "text": "Or, je ne sais pas d'humeur à me laisser égorgiller."
                            },
                            {
                                "example_id": "ea8d29a3-8afa-421e-941e-ca9a18e47ce8",
                                "sense_id": "889d5075-26ce-3ed8-bf34-d9b276b1ffeb",
                                "text": "S’il est douteux que Vallombreuse soit à Paris, ses émissaires, du moins, l’y remplacent, puisque cette nuit même, si vous n’aviez pas veillé sous les armes, ému d’un juste soupçon, ils vous auraient gentiment égorgillé en votre chambrette."
                            },
                            {
                                "example_id": "dace1bf3-6737-403c-8542-aebadaca8324",
                                "sense_id": "889d5075-26ce-3ed8-bf34-d9b276b1ffeb",
                                "text": "Et ils viendront nous égorgiller cette nuit, soyez en sûre."
                            },
                            {
                                "example_id": "9295caa2-9cfb-4880-851d-d7b10d1146bd",
                                "sense_id": "889d5075-26ce-3ed8-bf34-d9b276b1ffeb",
                                "text": "Les deux partis, tout en gardant des apparences amicales, cherchent à s'égorgiller le plus doucettement du monde."
                            }
                        ]
                    }
                ],
