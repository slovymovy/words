                ],
                "senses": [
                    {
                        "sense_id": "ef28b581-1b81-36dc-8f74-0d95ebbc76ad",
                        "entry_id": "4e42a5eb-5ba1-3311-8d53-5bd1ab3163af",
                        "glosses": [
                            "To turn into a demon."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e8a79fcd-fb0a-30ce-9a79-1a620bfad896",
                        "entry_id": "4e42a5eb-5ba1-3311-8d53-5bd1ab3163af",
                        "glosses": [
                            "To describe or represent as evil or diabolic, usually falsely."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5245d316-26cb-4db6-976f-42e158cb313f",
                                "sense_id": "e8a79fcd-fb0a-30ce-9a79-1a620bfad896",
                                "text": "President Trump has seized on the response in the streets to police brutality against Black men and women to bolster his re-election campaign, employing provocative and sometimes incendiary language and images to incite his followers, demonize his opponents or both."
                            },
                            {
                                "example_id": "409b47c5-9d34-4dfe-924d-7efb09e431e0",
                                "sense_id": "e8a79fcd-fb0a-30ce-9a79-1a620bfad896",
                                "text": "He calls for a “massive, urgent recruitment effort,” which is a fine idea, but one that’s likely to be futile unless we stop demonizing teachers and start paying them fairly."
                            },
                            {
                                "example_id": "99223fd2-04d6-4d64-98f6-6826b21b15f4",
                                "sense_id": "e8a79fcd-fb0a-30ce-9a79-1a620bfad896",
                                "text": "Many people disagree with several things society has normalized, some of which are even demonized. Frustratingly, attaching a stigma to perfectly reasonable things makes people feel attacked when they publicly do them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e228a2a2-b0d6-4c96-9bc3-ac104b63d18b",
                        "source_entry_id": "4e42a5eb-5ba1-3311-8d53-5bd1ab3163af",
                        "source_sense_description": "turn into a demon",
                        "target_lang_word": "diaboliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diaboliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17c09669-5de5-314b-a4ec-32a71245b5ce",
                                        "entry_id": "18054245-0141-3c69-aa21-fd920aed8989",
                                        "glosses": [
                                            "Prêter un rôle, des comportements ou des intentions diaboliques ou pernicieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0548b56-77b0-4f5e-a079-7dec719d3ee5",
                                                "sense_id": "17c09669-5de5-314b-a4ec-32a71245b5ce",
                                                "text": "Honni par le Talmud et le Coran, diabolisé par les chrétiens comme symbole de luxure et de gourmandise, le cochon est tout aussi triquard dans la société laïque, obligatoire, gonadoclaste et de surcroît xyloglotte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77211018-3901-4eed-b55d-2c24c397d23f",
                        "source_entry_id": "4e42a5eb-5ba1-3311-8d53-5bd1ab3163af",
                        "source_sense_description": "turn into a demon",
                        "target_lang_word": "démoniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démoniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb56235a-6e08-3f29-ad73-e59504b37005",
                                        "entry_id": "c1579149-317c-3086-8752-8a47d858976b",
                                        "glosses": [
                                            "Diaboliser."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ae0f3e-3f53-404f-b4d9-57ecac254a45",
                                                "sense_id": "cb56235a-6e08-3f29-ad73-e59504b37005",
                                                "text": "Leur image maléfique n’étant rien d’autre que le fruit de la manipulation des hommes, ceux-ci n’hésitant pas à les démoniser pour en justifier la purification par le bûcher sous le prétexte que toute femme sans homme est forcément la putain du démon."
                                            },
                                            {
                                                "example_id": "e0dd0834-d350-4751-b156-287fb8a6e5a9",
                                                "sense_id": "cb56235a-6e08-3f29-ad73-e59504b37005",
                                                "text": "La Grande Peste de 1346-1352, attribuée aux juifs, déclencha à son tour de nombreux massacres. Les juifs se virent accusés non seulement des fléaux qui frappaient la chrétienté, comme les épidémies de peste et de choléra, mais aussi de sacrilèges horribles […]. Ils furent non seulement avilis, mais aussi démonisés."
                                            },
                                            {
                                                "example_id": "63930cd2-ac36-4f3c-b5e1-093335f0570e",
                                                "sense_id": "cb56235a-6e08-3f29-ad73-e59504b37005",
                                                "text": "Tant que la gauche progressiste se complaira à les démoniser plutôt que de les comprendre, tant que CNN va les ridiculiser plutôt que de les écouter, les Donald Trump de ce monde auront une chance de mettre en péril la démocratie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b8ba4ea-1ddf-40b5-a40f-8937aeb63523",
                        "source_entry_id": "4e42a5eb-5ba1-3311-8d53-5bd1ab3163af",
                        "source_sense_description": "turn into a demon",
                        "target_lang_word": "dämonisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dämonisieren",
