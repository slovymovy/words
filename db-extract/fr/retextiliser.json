                "senses": [
                    {
                        "sense_id": "72468ada-454f-34bb-8486-ccf3ce424517",
                        "entry_id": "d8c9069e-b4bf-38b3-a4d5-861ec9a041ac",
                        "glosses": [
                            "Textiliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690f39e9-850e-4515-acf5-07fe2f19018a",
                                "sense_id": "72468ada-454f-34bb-8486-ccf3ce424517",
                                "text": "Nous sommes comme toi; nous préférons aller en village naturiste et passer des vacances naturistes que d'aller que sur une plage pour la journée et se retextiliser le soir venu."
                            },
                            {
                                "example_id": "1922f0e5-b4a2-4a8c-8773-8a62b8f02b5f",
                                "sense_id": "72468ada-454f-34bb-8486-ccf3ce424517",
                                "text": "Mais, au moins pour qu'on n'oblige pas à se retextiliser à 100% les familles qui ne peuvent pas être naturistes à 100%, je trouve bon qu'il y ait aussi des centres de vacances où on ait le choix."
                            }
                        ]
                    }
