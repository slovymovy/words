                                        "glosses": [
                                            "A traditional headscarf worn by Muslim women, covering the hair and neck."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "384e4b89-8af1-3911-b7a5-b2282405750f",
                                        "entry_id": "d8bd3109-b54e-32ec-b4b4-509c0420f08d",
                                        "glosses": [
                                            "The practice, among Muslim women, of covering the body after the age of puberty in front of non-related (non-family) adult males."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7c80fa-7d5f-45f3-a559-a44a5c0a2ec0",
                                                "sense_id": "384e4b89-8af1-3911-b7a5-b2282405750f",
                                                "text": "The belief that Muslim females observe hijab because men force them to do so insults some Muslim females who have based their decision on their understanding of Islam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
