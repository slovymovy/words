                    {
                        "translation_id": "8608eb51-ae3e-48ef-88aa-0e1e8a30879e",
                        "source_entry_id": "0e9a0506-22d9-3583-8c51-492c1fafa7d5",
                        "source_sense_id": "2145e3fd-4c0d-374f-af83-878c297cda51",
                        "target_lang_word": "уютно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "уютно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d6fd8c9b-28c4-3cde-8503-0c247411c433",
                                        "entry_id": "30ac10da-3ead-3227-8e77-b58d188fd2a4",
                                        "glosses": [
                                            "изящно и удобно устроенный, обладающий уютом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e73d41bb-1f99-420f-9eab-87740bb5a1a3",
                                                "sense_id": "d6fd8c9b-28c4-3cde-8503-0c247411c433",
                                                "text": "Я уж не говорю о тех практиках, которые погружаются в навоз, находя, что там уютно и тепло, но есть практики честные, которые действительно приходят с намерением сделать нечто доброе…"
                                            },
                                            {
                                                "example_id": "0c415709-5667-4503-9925-716715fe8feb",
                                                "sense_id": "d6fd8c9b-28c4-3cde-8503-0c247411c433",
                                                "text": "В юрте горел небольшой костёр, было тепло и уютно."
                                            },
                                            {
                                                "example_id": "62ff967d-fb69-4c46-89e1-e0acbfca995f",
                                                "sense_id": "d6fd8c9b-28c4-3cde-8503-0c247411c433",
                                                "text": "Керн не солгал: комната действительно была очень хороша — светлая, просторная и уютно обставленная."
                                            },
                                            {
                                                "example_id": "693dbe8e-25d7-485a-9b04-453d64e7b376",
                                                "sense_id": "d6fd8c9b-28c4-3cde-8503-0c247411c433",
                                                "text": "Получив нетривиальный результат, они шарахаются от него, поспешно объясняют его нечистотой эксперимента и фактически уходят от нового, потому что слишком сжились со старым, уютно уложенным в пределы авторитетной теории…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17fb22f-a53c-36db-94f5-ce3f33bd58b2",
                                        "entry_id": "30ac10da-3ead-3227-8e77-b58d188fd2a4",
                                        "glosses": [
                                            "перен. испытывая душевный покой и комфорт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d92d12d-0bcb-4188-8663-e3daf5bb2b3f",
                                                "sense_id": "c17fb22f-a53c-36db-94f5-ce3f33bd58b2",
                                                "text": "В общем, чувствовал я себя рядом с ним не совсем уютно."
                                            },
                                            {
                                                "example_id": "bc07cefc-e937-4537-8578-1aa3ed19a360",
                                                "sense_id": "c17fb22f-a53c-36db-94f5-ce3f33bd58b2",
                                                "text": "Он уютно облокотился на стол, закинул ногу на ногу — видно было, что ему здесь хорошо."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
