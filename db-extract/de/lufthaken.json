                "senses": [
                    {
                        "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                        "entry_id": "ba48166f-c22d-371f-816d-6b0451a46d33",
                        "glosses": [
                            "als Witz: ein fiktiver Haken, der ohne ein Halt gebendes Objekt wie eine Wand angebracht werden kann, so dass man damit Gegenstände „in der Luft“ aufhängen kann"
                        ],
                        "tags": [
                            "als",
                            "Witz"
                        ],
                        "examples": [
                            {
                                "example_id": "6136da6a-942d-4fcc-b9cd-cbb6ff34fbb0",
                                "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                                "text": "Da wäre der Klassiker \"Siemens Lufthaken\" zur Befestigung von Teilen ohne Befestigungsmöglichkeit."
                            },
                            {
                                "example_id": "d50a84c7-2f69-4053-876d-d55fe34586bc",
                                "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                                "text": "„Ein ziemlich ungewöhnliches Gerät ist der Lufthaken.“"
                            },
                            {
                                "example_id": "4f40418a-a592-4742-9559-80733e9695b1",
                                "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                                "text": "„Hol uns mal ein Kilo Lufthaken, bitte.“"
                            },
                            {
                                "example_id": "38278f25-ccf3-4960-806b-d0d84c755e1b",
                                "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                                "text": "„Opa sagte zu ihm: »Bestelle dem Schmied einen schönen Gruß und sage ihm, wir brauchen dringend einen Lufthaken für den Backofen.«“"
                            },
                            {
                                "example_id": "e14b203e-eaf1-4a4b-a1a2-cb587f67379d",
                                "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                                "text": "„Da schickt man zum Beispiel Maurerlehrlinge los, um Gewichte für die Wasserwaage zu holen oder Getriebesand oder Lufthaken, irgendwas, das es nicht gibt.“"
                            },
                            {
                                "example_id": "775d1b7b-41a8-4620-ad45-7e7570c9778c",
                                "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                                "text": "„Der Pfiffikus suchte dann stundenlang vergeblich nach Getriebesand und Siemens-Lufthaken, bis er mit leeren Händen unter Hohngelächter zurückkehrte.“"
                            },
                            {
                                "example_id": "c11592cc-6f54-4fd7-a9d0-68819a6b3b7e",
                                "sense_id": "56aba50f-7242-3bcf-a740-f89aafb262e5",
                                "text": "„Er griff mit der rechten Hand in die Luft, als könnte er dort einen »Lufthaken« finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
