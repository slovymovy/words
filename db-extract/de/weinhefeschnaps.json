                ],
                "senses": [
                    {
                        "sense_id": "0308580a-f161-3c05-a15f-e9c4c1feb14f",
                        "entry_id": "214b7149-ffb5-37f1-b241-f5920f1d998f",
                        "glosses": [
                            "ein Brand oder Schnaps, der aus Weinhefe gebrannt worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa7831c7-24d8-4259-9c52-55490ce947d9",
                                "sense_id": "0308580a-f161-3c05-a15f-e9c4c1feb14f",
                                "text": "„Die Güte dieser feinen Weinhefeschnäpse wird von Faktoren wie Weinanteil, der Weinqualität, der Traubensorte und von der Frische des Hefezustands bestimmt. Es wird hierbei nicht wie beim Tresterbrand der Traubentrester vergoren, sondern die während des alkoholischen Gärprozesses abgesetzten Schwebstoffe und Rückständen der Hefe am Boden des Weinfasses.“"
                            },
                            {
                                "example_id": "6163aa86-bc5f-4fe1-88ff-e35f9dd6f8a9",
                                "sense_id": "0308580a-f161-3c05-a15f-e9c4c1feb14f",
                                "text": "„Auch Trester sowie Weinhefeschnaps munden.“"
                            },
                            {
                                "example_id": "1124c99f-5f8a-48b7-9d1a-9b8ea7732266",
                                "sense_id": "0308580a-f161-3c05-a15f-e9c4c1feb14f",
                                "text": "„Auch dem Branntweintrinken auf dem Hunsrück im 18. und 19. Jahrhundert hat der Autor eine Studie gewidmet. Schnaps - damals Weinhefeschnaps oder Trester wurde zu jeder Gelegenheit getrunken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
