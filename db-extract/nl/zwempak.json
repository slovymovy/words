                        "examples": [
                            {
                                "example_id": "62dd653a-7715-498a-b852-af7bbab563f9",
                                "sense_id": "f0b038b5-5891-35cf-9ec9-476cae2ef406",
                                "text": "Mijn moeder trok haar zwempak aan en ging naast me op de rand van het zwembad zitten en samen lieten we onze voeten in het water bungelen, terwijl we naar de andere kinderen keken die de technieken uitvoerden die ze hadden geleerd."
                            },
                            {
                                "example_id": "19c9d86b-b6f4-4acf-a62b-110add1fef35",
                                "sense_id": "f0b038b5-5891-35cf-9ec9-476cae2ef406",
                                "text": "Hij heeft geen blik voor de meisjes in het dorp die in zwempak zijn naam roepen."
                            }
                        ]
                    }
                ],
