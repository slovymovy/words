                "senses": [
                    {
                        "sense_id": "f3c41efd-2426-35f0-bf95-d94a7c5ffa13",
                        "entry_id": "818607d4-ca80-369e-9ba0-1f4f0792b415",
                        "glosses": [
                            "bis 30 Zentimeter langer Dorn, oft aus Metall, den man benutzt, um einen festsitzenden Knoten aufzubrechen oder zu spleißen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbd73a7c-fc78-4de2-8602-2b73002378ca",
                                "sense_id": "f3c41efd-2426-35f0-bf95-d94a7c5ffa13",
                                "text": "Sie bekam zum Geburtstag ein Seglertaschenmesser mit Marlspieker und Schäkelöffner geschenkt."
                            },
                            {
                                "example_id": "e30916e7-0a50-4306-b625-91c8dc019e3c",
                                "sense_id": "f3c41efd-2426-35f0-bf95-d94a7c5ffa13",
                                "text": "„Der Marlspieker, ein starker eiserner Dorn mit oder ohne Holzgriff, ist ein unerläßliches Universalwerkzeug: zum Spleißen, Aufbrechen festgezogener Knoten und Aufdrehen festgefressener Schäkelbolzen.“"
                            },
                            {
                                "example_id": "e15e1bc2-f2f4-4d35-bc41-cdd3332595f6",
                                "sense_id": "f3c41efd-2426-35f0-bf95-d94a7c5ffa13",
                                "text": "„Marlspieker zum Spleißen von Drahttauwerk haben eine Hohlkehle, in die man die einzelnen Kardeele beim Durchstecken einführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf055dc1-731d-404d-b94b-c6b7c3ef76d9",
                        "source_entry_id": "818607d4-ca80-369e-9ba0-1f4f0792b415",
                        "source_sense_id": "f3c41efd-2426-35f0-bf95-d94a7c5ffa13",
                        "target_lang_word": "marlinspike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marlinspike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c437bce7-96c6-3ed7-9da6-a1bed88e58fc",
                                        "entry_id": "b6a6e7e0-bb95-303d-be47-4f1d8f1d93a1",
                                        "glosses": [
                                            "A tool, consisting of a pointed metal spike, used to manipulate the strands of rope or cable when knotting and splicing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb295a3-7e96-4356-b221-ac1a9d4e4a39",
                                                "sense_id": "c437bce7-96c6-3ed7-9da6-a1bed88e58fc",
                                                "text": "[…] the afterguard, of whom they have but a sorry opinion, chiefly landsmen, never going aloft except to reef or furl the mainsail and in no wise competent to handle a marlinspike or turn in a dead-eye, say."
                                            },
                                            {
                                                "example_id": "eab58e36-3d7b-4766-b607-c1020c1db284",
                                                "sense_id": "c437bce7-96c6-3ed7-9da6-a1bed88e58fc",
                                                "text": "There was / that interval of moonless calm filled only / with the water's and the rigging's usual sounds, / then sudden movement, blows and snarling cries / and they had fallen on us with machete / and marlinspike."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
