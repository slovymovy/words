                                "example_id": "24bc604f-6be1-4a2d-98eb-e87cb4af9102",
                                "sense_id": "43028016-b3d9-3d82-9b0d-298a43f2587b",
                                "text": "De prijzen van de zuivelproducten staan door de prijzenoorlog sterk onder druk."
