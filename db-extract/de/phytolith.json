                "senses": [
                    {
                        "sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                        "entry_id": "bf1e5e32-82f3-3d25-907d-0e4344b8a120",
                        "glosses": [
                            "kalkiges, kieseliges oder brennbares Sedimentgestein, das vorwiegend aus Pflanzenresten entstanden ist"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9ee5e6b0-67bc-47f2-8e55-a70e12859dbd",
                                "sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                                "text": "Wann auch immer rund um den Malawi-See Pflanzen zugrunde gegangen sind – Regenwasser und Flüsse haben stets einen Teil der Phytolithen in den See gespült, wo sie auf den Grund des Sees gerieselt sind."
                            },
                            {
                                "example_id": "881394d3-1808-4261-8e32-0c91063f8539",
                                "sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                                "text": "„In einem Kubikzentimeter Seesediment finden sich 10 000 bis 1 000 000 Phytolithen“, sagt Yost."
                            },
                            {
                                "example_id": "d91bdc2d-9339-477c-a600-6dca018a9d7f",
                                "sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                                "text": "Durch die Analyse von Phytolithen konnte Denhams Team nachweisen, dass die Bananenarten Musa ingens und Musa acuminata im 5. Jahrtausend v. Chr. in der Region Kuk erstmals kultiviert wurden."
                            },
                            {
                                "example_id": "1474dd16-896e-412c-a153-e4938a9ac1bb",
                                "sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                                "text": "Zusammen mit der Lignifizierung der Schale führt die Produktion von Phytolithen zu einem erhöhten mechanischen Schutz für die Frucht."
                            },
                            {
                                "example_id": "467255a3-0367-44b4-b092-d2e8e6836910",
                                "sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                                "text": "Wenn nach dem Tod einer Pflanze das organische Gewebe verschwunden ist, bleiben die Phytolithen zurück."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b558d138-879a-4b65-a3ce-fd1b1c9704a6",
                        "source_entry_id": "bf1e5e32-82f3-3d25-907d-0e4344b8a120",
                        "source_sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                        "target_lang_word": "phytolith",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phytolith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2382762f-d96a-3436-aeb9-7ecd4fed6c5d",
                                        "entry_id": "5c64f5ad-058d-3737-a65f-001d0273ac09",
                                        "glosses": [
                                            "A small particle of silica or mineral that occurs in many plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf46072-ea80-4bf2-9cf8-7d438e7bfac4",
                                                "sense_id": "2382762f-d96a-3436-aeb9-7ecd4fed6c5d",
                                                "text": "Environmental archaeologist Monica Ramsey, at the University of Toronto, Canada, and her colleagues studied phytoliths – microscopic silica crystals that form in plant tissues – from the site."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ce08bec-73e7-41ab-9234-6caf4425993a",
                        "source_entry_id": "bf1e5e32-82f3-3d25-907d-0e4344b8a120",
                        "source_sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                        "target_lang_word": "phytolithe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phytolithe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc097f1-6eb4-362d-a943-08a0a339239b",
                                        "entry_id": "6b7ea627-a44c-3783-9a78-31a0080b6234",
                                        "glosses": [
                                            "Végétal fossile ou pétrifié, pierre qui porte l’empreinte de quelque plante."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e2a533-767b-4be1-96df-f4ecd974b3c8",
                                                "sense_id": "4fc097f1-6eb4-362d-a943-08a0a339239b",
                                                "text": "Ils signifient qu’une forme de phytolithe peut être produite par différentes espèces de plantes (redondance) et aussi qu’une même espèce de plante peut produire différentes formes de phytolithes au sein d'un même tissu (multiplicité)."
                                            },
                                            {
                                                "example_id": "32bb5004-cc7b-4746-af4c-9aef4ee235ab",
                                                "sense_id": "4fc097f1-6eb4-362d-a943-08a0a339239b",
                                                "text": "Toutefois les irruptions diluviennes successives ont laissé sur la terreles débris des corps organisés qu'elle nourrissoit à sa surface et dans le sein des ondes ; tels sont ces précieux restes de coquillages, d'ichthyolithes et d'autres zoolithes qui se rencontrent avec tant de décombres de phytolithes, éparses et jonchées sur la faces des continens, ou enfouies sous des couches diluviennes. Telle est peut-être encore la cause de ces immenses salines de muriate de soude gemme que les eaux ont laissé cristalliser, en s'évaporant peu-à-peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c00705-c1ac-304e-9e27-313e3254de55",
                                        "entry_id": "6b7ea627-a44c-3783-9a78-31a0080b6234",
                                        "glosses": [
                                            "Concrétion siliceuse produite par les cellules végétales, qui perdure dans le sol et permet l'identification univoque d'un végétal même très longtemps après sa disparition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54b12306-4ec7-4fee-a41e-db70549969a0",
                                                "sense_id": "06c00705-c1ac-304e-9e27-313e3254de55",
                                                "text": "Le laboratoire de phytolithologie du Cépam, fondé en 1997, est équipé pour l’extraction chimique des phytolithes à partir du sédiment des sites archéologiques ou des plantes vivantes."
                                            },
                                            {
                                                "example_id": "3a1b0bef-0286-40b7-ba32-a3671ebc7342",
                                                "sense_id": "06c00705-c1ac-304e-9e27-313e3254de55",
                                                "text": "Avant de recenser quelques-uns des pinsons qui porteront son nom et qui l'ont inspiré pour développer la théorie de la sélection naturelle, Darwin a été l'un des premiers scientifiques à s'intéresser à de microscopiques concrétions de silice aujourd'hui nommées phytolithes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed7c46ea-d1c8-4f51-b80f-aabd42f6eafb",
                        "source_entry_id": "bf1e5e32-82f3-3d25-907d-0e4344b8a120",
                        "source_sense_id": "9be4f9ff-a763-3680-a969-51805f809377",
                        "target_lang_word": "φυτόλιθος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "φυτόλιθος",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "8e267954-bf64-3e4d-a1ca-a98d3c6d42df",
                                        "entry_id": "4bcdc3df-1198-30fe-a028-b532747a33bd",
                                        "glosses": [
                                            "μικροσκοπικό φυτικό κατάλοιπο, που αποτελείται από διοξείδιο του πυριτίου η οξαλικό ασβέστιο (calcium oxalates) και αναπτύχθηκε στο κυτταρικό σύστημα των φυτών"
                                        ],
                                        "tags": [
                                            "αρχαιολογία",
                                            "βοτανική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d1c4294-6658-4aaf-896e-0d1e06f1e7b9",
                                                "sense_id": "8e267954-bf64-3e4d-a1ca-a98d3c6d42df",
                                                "text": "※ H συμβολή των φυτολίθων στην αναγνώριση της χρήσης του χώρου στην προϊστορία: συγκριτική μελέτη ενός εθνογραφικού παραδείγματος και μιας νεολιθικής θέσης (didaktorika.gr)"
                                            },
                                            {
                                                "example_id": "b5adf2ba-12c4-496d-830e-ddeba9538f7b",
                                                "sense_id": "8e267954-bf64-3e4d-a1ca-a98d3c6d42df",
                                                "text": "※ Ο τρόπος που σχηματίζονται οι φυτόλιθοι είναι ο ακόλουθος. Πρόκειται για το αποτέλεσμα μιας διεργασίας, κατά την οποία τα φυτά απορροφούν με τις ρίζες τους το μονοξείδιο του πυριτίου (H4SiO4) που εμπεριέχεται στο νερό του εδάφους (διαλυτό πυρίτιο) και στη συνέχεια το μεταφέρουν μέσω του αγγειακού τους συστήματος στο υπόλοιπο σώμα (μίσχος, φύλλα, άνθη). (pdf@ikee.lib.auth.gr)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
