                                        ]
                                    },
                                    {
                                        "sense_id": "86672e71-ddbb-3d2c-944b-71a32befdc2b",
                                        "entry_id": "b0276bf2-c66c-363d-a2bc-f31e3b97f293",
                                        "glosses": [
                                            "niet voor verandering of argumenten vatbaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40581b4d-ae55-4539-bb26-a841286b439a",
                                                "sense_id": "86672e71-ddbb-3d2c-944b-71a32befdc2b",
                                                "text": "De kinderen vinden hun vader maar ouderwets en dogmatisch omdat hij vindt dat mannen nooit de afwas hoeven te doen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a81eb49c-de7a-4094-91d5-a0eaf49e65d9",
                        "source_entry_id": "04952277-330c-363d-a3c5-cc8786b9904b",
                        "source_sense_description": "asserting beliefs in an arrogant way",
                        "target_lang_word": "dogmatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dogmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                                        "entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                                        "glosses": [
                                            "Qui appartient au dogme ; qui concerne le dogme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bace0f79-d322-4185-98e3-d7a481bcce9b",
                                                "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                                                "text": "Une autre source qui a fait couler tant de sang a été la fureur dogmatique ; elle a bouleversé plus d'un État, depuis les massacres des Albigeois au XIIIᵉ siècle, jusqu'à la petite guerre des Cévennes au commencement du XVIIIᵉ."
                                            },
                                            {
                                                "example_id": "e6014822-09eb-4ebc-99d5-3e02b5697ea8",
                                                "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                                                "text": "Telle est, par exemple, la théologie dogmatique, qui n'a pu déposer, au moyen-âge, son enveloppe, son écorce latine."
                                            },
                                            {
                                                "example_id": "79efed2e-73e0-48fe-a26f-b17b2cff767a",
                                                "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                                                "text": "Le cas de la société tibétaine d’avant 1950 illustre de façon tragique les lacunes d’une idéologie dogmatique bouddhiste gérée par de faillibles humains. Elle a conduit à une société féodale esclavagiste basée sur l’oppression de presque toute la population par les hiérarchies religieuse et aristocratique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6412697-e943-3029-84df-25b6083e1dbe",
                                        "entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                                        "glosses": [
                                            "Qui est consacré, usité dans une école de pensée."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "common"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                                        "entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                                        "glosses": [
                                            "Qui dogmatise, qui exprime ses opinions d’une manière impérieuse et tranchante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328a38fe-fe18-4d27-af25-485f5703df21",
                                                "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                                                "text": "C’est un esprit dogmatique."
                                            },
                                            {
                                                "example_id": "16176464-3d7e-4077-8f04-6c65e78ee09d",
                                                "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                                                "text": "Il est très dogmatique."
                                            },
                                            {
                                                "example_id": "e4596502-9c22-44bb-b279-66141cb55d30",
                                                "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                                                "text": "Ton dogmatique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dogmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ab5fa11-c592-367a-84b1-d9a5fb4e39af",
                                        "entry_id": "d23a4bec-d3bd-3410-acd6-7e77b652f018",
                                        "glosses": [
                                            "Philosophe ou penseur dogmatique"
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22a172d-a5e0-4821-8c51-24d039c1a287",
                                                "sense_id": "4ab5fa11-c592-367a-84b1-d9a5fb4e39af",
                                                "text": "À Rome, tout à côté du gouvernement central de l'Église, il était resté en marge, il avait fondé l’oratorio, foyer de ferveur et de joie, loin des vétilleux, des dogmatiques, des inquisiteurs-nés, des scribes et des pharisiens de son époque."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dogmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4688c4f3-d0cc-3063-aa15-a57f236fa4f4",
                                        "entry_id": "dfa7510c-0703-3ce1-9871-ddff872a41aa",
                                        "glosses": [
                                            "Science des vérités du dogme."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49facc31-7159-491b-bf1c-d760868c147c",
                                                "sense_id": "4688c4f3-d0cc-3063-aa15-a57f236fa4f4",
                                                "text": "[…], c'est la philosophie empiriste anglaise qui ruine définitivement l'ontologie d'Aristote à laquelle la dogmatique chrétienne est intimement inféodée."
                                            },
                                            {
                                                "example_id": "f7495ed3-fe70-447e-966b-56b1e463fb32",
                                                "sense_id": "4688c4f3-d0cc-3063-aa15-a57f236fa4f4",
                                                "text": "Rhétorique ambiguë par excellence : une dogmatique manichéenne y compose des symboles d'attrait sexuel."
                                            },
                                            {
                                                "example_id": "90594420-6f82-4588-baa7-c69208e869fe",
                                                "sense_id": "4688c4f3-d0cc-3063-aa15-a57f236fa4f4",
                                                "text": "Bernstein, échappé de la dogmatique marxiste, raisonnait parfois à la manière des épistémologues de son temps, lesquels étaient néopositivistes et néokantiens. Mais, il n'était pas passé du marxisme au néokantisme par une apostasie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
