                "senses": [
                    {
                        "sense_id": "6c096df9-0c2b-3d3c-b4f2-b6ee441cc182",
                        "entry_id": "6a875ca4-3dd8-31c6-a106-88cfe2931429",
                        "glosses": [
                            "Donner un caractère troglodyte à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e2315e-c971-4ad9-b3de-b22277651226",
                                "sense_id": "6c096df9-0c2b-3d3c-b4f2-b6ee441cc182",
                                "text": "Les droits de l’homme au Liban se limitent au seul droit du promoteur immobilier dont les réalisations seront à leur tour «troglodytisées», et ainsi de suite, de sorte que la presque totalité des Beyrouthins ou des Tripolitains seront réduits à vivre comprimés de toutes parts."
                            },
                            {
                                "example_id": "4b25a2cc-d738-4bc4-af4a-4ed8cb40aa2c",
                                "sense_id": "6c096df9-0c2b-3d3c-b4f2-b6ee441cc182",
                                "text": "Un jour… les espaces de vie au Japon pourraient bien se troglodytiser, c’est-à-dire, s’enfoncer sous terre."
                            },
                            {
                                "example_id": "6b22872d-8abe-49f4-8f70-c8b0e8c2c401",
                                "sense_id": "6c096df9-0c2b-3d3c-b4f2-b6ee441cc182",
                                "text": "En sortant de chez moi, ce matin, j’ai remarqué que ma maison s’était troglodytisée pendant la nuit!"
                            }
                        ]
                    }
                ],
