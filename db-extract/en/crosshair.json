                                "example_id": "e77c09e3-1ce7-4950-a331-70abeed37f15",
                                "sense_id": "766aa1bc-f77c-3c2e-8757-15422e8b2ff1",
                                "text": "My kinfolks had crosshaired in on the truth of the world."
                            },
