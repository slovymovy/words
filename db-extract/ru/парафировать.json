                                    {
                                        "sense_id": "e26c32ef-514b-3abe-97aa-18e1d3f565af",
                                        "entry_id": "190ada89-c09a-3be6-bf72-2c27447f5eca",
                                        "glosses": [
                                            "mit der Paraphe (Namenszug, Namenszeichen) versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c27cac8-dc6d-425e-aae9-48d062e1ea27",
                                                "sense_id": "e26c32ef-514b-3abe-97aa-18e1d3f565af",
                                                "text": "Um nachträgliche Manipulationen durch ein Austauschen einzelner Seiten zu verhindern, werden sehr wichtige Verträge oft auf jeder einzelnen Seite von den Vertragspartnern paraphiert, in dem sie ihre Namenskürzel in die untere Ecke schreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2a45db0-25b1-3f46-85fb-7e44fc4a7797",
                                        "entry_id": "190ada89-c09a-3be6-bf72-2c27447f5eca",
                                        "glosses": [
                                            "einen Vertrag, Vertragsentwurf oder ein Verhandlungsprotokoll als Bevollmächtigter vorläufig unterzeichnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfafa889-74a1-48b2-b202-8ee78c8a8d59",
                                                "sense_id": "b2a45db0-25b1-3f46-85fb-7e44fc4a7797",
                                                "text": "Der Vertrag war bereits im Oktober 1991 paraphiert worden. Noch in Prag bestritt Kohl wider besseres Wissen, er habe die Unterzeichnung immer wieder hinausgeschoben."
                                            },
                                            {
                                                "example_id": "74221ea6-6dc2-411a-8cb9-52665549bfd6",
                                                "sense_id": "b2a45db0-25b1-3f46-85fb-7e44fc4a7797",
                                                "text": "Clement sagte nach der elften Verhandlungsrunde vor Journalisten, SPD und Grüne wollten wie geplant ihren Koalitionsvertrag am Dienstag nach Pfingsten paraphieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
