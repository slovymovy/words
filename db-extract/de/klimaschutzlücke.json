                ],
                "senses": [
                    {
                        "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                        "entry_id": "0282a4b0-c5fb-37df-b60a-2fe7e0558bb7",
                        "glosses": [
                            "Verfehlung der Ziele der Minderung des Ausstoßes von klimaschädlichen Treibhausgasen"
                        ],
                        "tags": [
                            "Umwelt",
                            "meist im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "9394655b-4183-4e0a-ac87-0d8aa7bb0457",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "[Am Projektionsbericht] „lässt sich ablesen, ob und inwieweit die Klimaschutzpolitik hilft, die Emissionsmengen zu reduzieren und wie groß die Klimaschutzlücke noch ist.“"
                            },
                            {
                                "example_id": "a6cb1cfe-3a18-4001-af1b-0d37e912fe7e",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„Wie und wann will die Bundesregierung die Klimaschutzlücke schließen?“"
                            },
                            {
                                "example_id": "9e2c91cb-af33-46cb-bfdf-8d85bd801666",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„»Aber was nicht geht, ist, im Verkehr, wo wir eine riesige Klimaschutzlücke haben, jetzt erst mal alle Autobahnen schneller zu bauen.«“"
                            },
                            {
                                "example_id": "fc728180-a7af-421a-953e-a355f3821d6f",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„Beim Verkehr klafft eine riesige Klimaschutzlücke: Die Ampel-Parteien schaffen es nicht, sich auf Maßnahmen zu einigen, mit denen das deutsche Verkehrswesen die gesetzlich vorgeschriebenen Grenzen für Treibhausgas-Emissionen auch nur annähernd einhält.“"
                            },
                            {
                                "example_id": "b7154e8e-12ca-4776-8c7a-13135099bf96",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "[Schlagzeile:] „Umweltschützer verklagen Bundesregierung wegen Klimaschutzlücken“"
                            },
                            {
                                "example_id": "0b3a6d59-9404-4d84-8ada-4dfccfc2e5be",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„Bau- und Verkehrsministerium legten Sofortprogramme zur Behebung der Klimaschutzlücke vor, die der Rat im Sommer prüfte.“"
                            },
                            {
                                "example_id": "24b483dd-6a67-4c80-b363-d73ce4ca8435",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„»Nach unseren Abschätzungen bleibt eine Klimaschutzlücke von 20 bis 30 Millionen Tonnen Treibhausgasen«, sagt Behördenchefin Maria Krautzberger.“"
                            },
                            {
                                "example_id": "cce32509-bca2-4f87-a0d9-ddbc8178e523",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„Neue Berechnungen der Deutschen Umwelthilfe: Tempo 100 auf Autobahnen könnte ein Drittel der Klimaschutzlücke im Verkehr schließen“"
                            },
                            {
                                "example_id": "5a9fdc9e-b480-462c-86a8-f392bf30337b",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„Die jährlichen Zielverfehlungen summieren sich im Verkehr bis 2030 auf 271 Millionen Tonnen CO2-Äquivalente. Die Tempolimits \"könnten diese Klimaschutzlücke zwischen dem derzeit erwarteten Emissionsverlauf und den verbindlichen Zielen um rund ein Sechstel schließen\".“"
                            },
                            {
                                "example_id": "b6146775-b761-4950-b1d4-285e2cb70771",
                                "sense_id": "e9600163-6b3b-3589-97f0-21ddc4d0d942",
                                "text": "„Als Ergebnis der unter Führung von Fidschi und Polen durchgeführten Bestandsaufnahme wird angestrebt, die Vertragsstaaten zu ehrgeizigerem Handeln zu motivieren, um die globale Klimaschutzlücke zu schließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
