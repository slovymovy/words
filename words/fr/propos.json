                {
                    "sense_id": "bb2ad1ec-fd2e-3c7b-969c-20464e119815",
                    "sense_definition": "Sujet dont il s'agit, thème ou objet principal de ce que l'on dit ou écrit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sujet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette remarque intéressante est pourtant tout à fait hors de notre <w>propos</w> aujourd'hui.",
                            "target_lang_translations": {
                                "en": "Yet this interesting remark has nothing to do with our <w>topic</w> today.",
                                "ru": "Это интересное замечание, однако, совершенно не по <w>теме</w> нашего сегодняшнего обсуждения.",
                                "nl": "Deze interessante opmerking valt echter helemaal buiten ons <w>onderwerp</w> van vandaag.",
                                "de": "Diese interessante Bemerkung hat mit unserem heutigen <w>Thema</w> allerdings überhaupt nichts zu tun.",
                                "pl": "Ta interesująca uwaga jednak zupełnie nie ma związku z dzisiejszym <w>tematem</w>.",
                                "it": "Questa osservazione interessante, però, non c'entra affatto con il nostro <w>argomento</w> di oggi.",
                                "cs": "Tato zajímavá poznámka však s naším dnešním <w>tématem</w> vůbec nesouvisí.",
                                "tr": "Bu ilginç açıklama yine de bugünkü <w>konumuzla</w> tamamen alakasız.",
                                "es": "Sin embargo, esta interesante observación no tiene nada que ver en absoluto con nuestro <w>tema</w> de hoy.",
                                "zh": "这个有趣的评论，却与我们今天的<w>话题</w>完全无关。"
                            }
                        },
                        {
                            "text": "Le <w>propos</w> de cet article est de faire réfléchir sur les changements climatiques.",
                            "target_lang_translations": {
                                "en": "The <w>theme</w> of this article is to get readers to reflect on climate change.",
                                "ru": "<w>Тема</w> этой статьи — заставить читателей задуматься о климатических изменениях.",
                                "nl": "Het <w>thema</w> van dit artikel is om lezers te laten nadenken over de klimaatverandering.",
                                "de": "Das <w>Thema</w> dieses Artikels ist, die Leser zum Nachdenken über den Klimawandel anzuregen.",
                                "pl": "<w>Tematem</w> tego artykułu jest zachęcenie czytelników do refleksji nad zmianami klimatycznymi.",
                                "it": "Il <w>tema</w> di questo articolo è far riflettere sui cambiamenti climatici.",
                                "cs": "<w>Tématem</w> tohoto článku je přimět čtenáře k zamyšlení nad klimatickými změnami.",
                                "tr": "Bu makalenin <w>konusu</w>, okuyucuları iklim değişikliği üzerine düşündürmektir.",
                                "es": "El <w>tema</w> de este artículo es hacer reflexionar sobre los cambios climáticos.",
                                "zh": "这篇文章的<w>主题</w>是促使读者思考气候变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sujet",
                        "thème",
                        "objet"
