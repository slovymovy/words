                        "translation_id": "fead0261-a9bb-41a9-a42f-6b03fbe445df",
                        "source_entry_id": "3eb5bf15-a40f-329e-baa0-e02043c6a657",
                        "source_sense_id": "e16452ee-bd20-3917-a5e3-31e8d392d747",
                        "source_sense_description": "Duitse wijn uit de Rijnstreek",
                        "target_lang_word": "Rheinwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rheinwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce00f001-890c-3381-bc62-f3a4aeae5bb6",
                                        "entry_id": "b388b2d1-0b30-3284-aa2e-db30b875be7b",
                                        "glosses": [
                                            "ein Wein, der am Rhein gewachsen und hergestellt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65450444-24a0-45aa-9854-b406746263d9",
                                                "sense_id": "ce00f001-890c-3381-bc62-f3a4aeae5bb6",
                                                "text": "Der Rheinwein ist durch seine Popularität im Ausland „zum Begriff für leichte, fruchtige Weine geworden. Daher bezeichnet man einheimische Weine dieser Art in den USA, Australien und Südafrika als Rhine Wine.“"
                                            },
                                            {
                                                "example_id": "70d42c71-5a00-476b-b1c3-e7310889774e",
                                                "sense_id": "ce00f001-890c-3381-bc62-f3a4aeae5bb6",
                                                "text": "„Ja dann, so sollte man eigentlich fortfahren, wäre der Rheinwein samt allen seinen Zechern wohl längst und mit Recht in Verruf geraten.“"
                                            },
                                            {
                                                "example_id": "58812c03-41c7-4a47-96e7-97f87e722b79",
                                                "sense_id": "ce00f001-890c-3381-bc62-f3a4aeae5bb6",
                                                "text": "„Es war der größte Philosoph des 19. Jahrhunderts, der das sagte, als wir, sechs Mann hoch, zu Bacharach am Rheine in grüner Laube saßen und Rheinwein tranken, soviel wir bezahlen konnten und noch mehr.“"
                                            },
                                            {
                                                "example_id": "f764ef6a-92fe-44d2-b4f8-9ce2168901ed",
                                                "sense_id": "ce00f001-890c-3381-bc62-f3a4aeae5bb6",
                                                "text": "„Wenn der schwere Rheinwein wie flüssiges Gold in den Adern rollt und pocht, wenn er den Trinker beansprucht bis zu einem Glückstaumel und Rausch, in dem er stumm vor dem Glase sitzt und sich und die Welt vergißt, vertauscht der Moselwein nicht heimlich zu seinen Gunsten die Gegenwart mit einer anderen Welt.“"
                                            },
                                            {
                                                "example_id": "0494267d-6cc4-45ae-b8bc-b1da2f7bd0a5",
                                                "sense_id": "ce00f001-890c-3381-bc62-f3a4aeae5bb6",
                                                "text": "„Gering geachtet setzte man den Moselwein dem Kutscher vor, derweil am Rheinwein oder Pfälzer die Herrschaft stillvergnügt sich labte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
