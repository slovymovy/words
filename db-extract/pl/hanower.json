                                "target_senses": [
                                    {
                                        "sense_id": "d01267a0-82fb-393a-b5f4-5a22a4ee0bd7",
                                        "entry_id": "78c2385e-f598-39fa-8d96-1a75575af3f3",
                                        "glosses": [
                                            "Île de la province de Última Esperanza au sud du Chili, elle est inhabitée, fait une superficie de 812 km² et a un point culminant à 744 mètres."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0df2369a-6d86-4d53-a304-f07763c2d914",
                                                "sense_id": "d01267a0-82fb-393a-b5f4-5a22a4ee0bd7",
                                                "text": "L'île Chairman^((dans le roman de J. Vernes)), alias l'île Hanovre, se trouve située à 51° de latitude,…."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19b87534-78a9-4a45-90d1-0e302ebf9a61",
                        "source_entry_id": "634d0a1a-8264-3be2-b31f-bc3c2e6338bd",
                        "source_sense_id": "bef5b463-3bfd-307e-92bf-e542374412da",
                        "target_lang_word": "Hannover",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hannover",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                        "entry_id": "1f607df6-b97d-3bd3-91ae-7c1e9cd31fc7",
                                        "glosses": [
                                            "Stadt in Deutschland, Hauptstadt von Niedersachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91fc5328-ef5d-4a97-9d4d-132cca277029",
                                                "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                                "text": "Hannover liegt an der Leine."
                                            },
                                            {
                                                "example_id": "eb22c106-c7b8-4632-b606-7a0265bc81da",
                                                "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                                "text": "„Alle hatten bereits erfahren, ich weiß nicht wie, daß sie von Wesel bis Hannover mit mir gefahren war.“"
                                            },
                                            {
                                                "example_id": "add8e764-3495-405b-8b96-ccef43771c07",
                                                "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                                "text": "„Neulich las ich gar von einer Frau, die sich den Innenstadtplan von Hannover auf ihren Rücken hat tätowieren lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9b4fd25-ba2d-38de-8561-57be76774cc2",
