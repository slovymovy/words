                        "glosses": [
                            "женск. к шантажист"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be20f264-0b4f-4216-8c09-a6c053e896b8",
                                "sense_id": "1c0b5443-05f3-3232-be7e-e384da2e1b88",
                                "text": "Маме было не жалко тарелки киселя, она, между прочим, посылала начинку больным в другие дома, но тут она видела перед собой нахалку, шантажистку, уголовницу, дай ей палец ― отхватит руку, и мама прогнала её."
                            }
                        ]
                    }
