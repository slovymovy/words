                        "examples": [
                            {
                                "example_id": "bfa4659c-0659-43fd-90b6-aa1bb2b91f19",
                                "sense_id": "9b17ba53-954e-3ba7-bc96-e2812c30b1e0",
                                "text": "[C]riminals are purposefully recruiting young, middle-class university students to do their dirty work “because they know they’re honest” and can be trusted to pass on the stolen cash rather than pocketing it all. Plus, students are cash hungry, as lockdown restrictions have squeezed any income from part-time jobs."
                            }
