                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est dangereux de <w>rouler</w> trop vite sur une route mouillée."
                        },
                        {
                            "text": "Nous aimons <w>rouler</w> à vélo le long du canal le dimanche matin."
                        }
                    ],
                    "synonyms": [
                        "circuler",
                        "conduire"
                    ],
                    "common_phrases": [
