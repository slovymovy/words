                "senses": [
                    {
                        "sense_id": "92927243-1fbe-3efa-a3f6-8d0ac350be40",
                        "entry_id": "37368921-07f4-3450-8a24-3ca4d14118bd",
                        "glosses": [
                            "Relatif aux Tchouktches ou à la langue tchouktche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb8ea74-78cf-40b8-861a-9614c986e27a",
                                "sense_id": "92927243-1fbe-3efa-a3f6-8d0ac350be40",
                                "text": "Pourquoi avoir choisi cette péninsule comme point de comparaison à mon terrain alaskien plutôt que le territoire tchouktche, par exemple, séparé de l’Alaska par les seuls cinquante petits kilomètres du désormais maritime détroit de Béring ?"
                            },
                            {
                                "example_id": "fb20a369-30f9-4ec8-8f96-3c82616a3da2",
                                "sense_id": "92927243-1fbe-3efa-a3f6-8d0ac350be40",
                                "text": "Mais je dois confesser que jamais je n’ai pu obtenir du Parti d’être autorisé à dormir, résider dans une maison tchouktche, partageant la vie d’une famille."
                            }
                        ]
                    }
                ],
