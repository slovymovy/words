                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5aaad0d-d3c0-41ed-86fe-6df01ef17aae",
                                "sense_id": "966c631d-1ba7-3ad6-8d84-5c948e9eef52",
                                "text": "„Die Zahl anonymer Informanten, die sich an die Bundesanstalt für Finanzdienstleistungsaufsicht (BaFin) in Deutschland wenden, ist zu Jahresbeginn deutlich gestiegen.“"
                            },
                            {
                                "example_id": "776650f4-84cc-4065-8cc4-84a5f3818508",
                                "sense_id": "966c631d-1ba7-3ad6-8d84-5c948e9eef52",
                                "text": "\"Wir erleben in Deutschland einen Angriff in unvorstellbarem Ausmaß\", sagte BKA-Präsident Jörg Ziercke auf einer gemeinsamen Pressekonferenz mit der Finanzaufsicht BaFin."
                            },
                            {
                                "example_id": "db099973-f223-4fdd-9f02-71305b2f6aff",
                                "sense_id": "966c631d-1ba7-3ad6-8d84-5c948e9eef52",
                                "text": "„Die Bundesanstalt für Finanzdienstleistungs-Aufsicht (BaFin) teilte am Donnerstag mit, sie habe einen Antrag auf Eröffnung eines Insolvenzverfahrens über das Vermögen des Unternehmens gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
