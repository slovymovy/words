                    }
                ],
                "senses": [
                    {
                        "sense_id": "23914c24-a902-320a-99cc-099b5670e4c2",
                        "entry_id": "908dfa3d-6e2d-329f-b5f0-c6fe52c2b5a4",
                        "glosses": [
                            "Qu’on ne peut pas traduire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e50142-0c4d-466c-8e5a-912c850ebbc0",
                                "sense_id": "23914c24-a902-320a-99cc-099b5670e4c2",
                                "text": "Le mot yagan « mamihlapinatapai » est intraduisible en un seul mot français."
                            },
                            {
                                "example_id": "bc38dc68-e991-4e49-a1e6-6cc4c1002ca6",
                                "sense_id": "23914c24-a902-320a-99cc-099b5670e4c2",
                                "text": "Madame Firmiani vint interrompre ce monologue dont les mille pensées contradictoires, inachevées, confuses, sont intraduisibles."
                            },
                            {
                                "example_id": "fb4ca351-6782-45bd-b080-6bf8d6da3eb5",
                                "sense_id": "23914c24-a902-320a-99cc-099b5670e4c2",
                                "text": "L’intraduisible espace est hanté de poèmes"
                            },
                            {
                                "example_id": "8b8875da-5f01-4fdd-a995-a64731ea57e4",
                                "sense_id": "23914c24-a902-320a-99cc-099b5670e4c2",
                                "text": "Elle passait toutes ses journées, dans le silence menaçant de la plaine sans soucis, sans pensées, poursuivant des rêveries vagues, indéfinissables, intraduisibles en aucune langue humaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ecd548f-7bd6-409f-89c2-98fdca4fbcd0",
                        "source_entry_id": "908dfa3d-6e2d-329f-b5f0-c6fe52c2b5a4",
                        "source_sense_id": "23914c24-a902-320a-99cc-099b5670e4c2",
