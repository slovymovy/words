                        "sense_id": "4f2a65a8-7709-32b2-ae88-eabbc3af6d35",
                        "entry_id": "0ce9ed5e-b80f-3c45-a6d9-ccb7ac2f853a",
                        "glosses": [
                            "soft-boiled"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3db764e-4e54-40ab-b43e-4d1639664ed9",
                                "sense_id": "4f2a65a8-7709-32b2-ae88-eabbc3af6d35",
                                "text": "яйцо́ всмя́тку",
                                "translation": "soft-boiled egg",
                                "english": "soft-boiled egg"
                            },
                            {
                                "example_id": "937fd677-0fe6-4436-b170-c0708c3ceffd",
                                "sense_id": "4f2a65a8-7709-32b2-ae88-eabbc3af6d35",
                                "text": "Наибо́лее распространё́нный и просто́й спо́соб приготовле́ния яи́ц – ва́рка их в скорлупе́ всмя́тку, в мешо́чек, вкруту́ю."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6dafac3-04b8-31fc-9405-3b86fd04afb8",
                        "entry_id": "0ce9ed5e-b80f-3c45-a6d9-ccb7ac2f853a",
