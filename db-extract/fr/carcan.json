        "fr-extract.jsonl": [
            {
                "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                "word": "carcan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "306ebfd7-c4fa-428c-96d9-b4f724ee20fd",
                        "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                        "tags": [
                            "plural"
                        ],
                        "form": "carcans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "051506df-79f2-3072-93ac-864589ed634d",
                        "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                        "glosses": [
                            "Cercle de fer ou plaque en bois avec des trous pour le cou et les poignets avec lequel on attachait par le cou à un poteau certains criminels condamnés au pilori."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f7cf45-58ba-4e3e-876e-32f680d9e3df",
                                "sense_id": "051506df-79f2-3072-93ac-864589ed634d",
                                "text": "Arrêt de la Cour du Parlement, qui condamne une quidane, connue sous le nom de la femme des Ormes, à être attachée au carcan à la place Saint-Michel, et au bannissement pendant neuf ans, pour avoir escroqué différentes marchandises chez une lingère. (Du 24 janvier 1775.)"
                            },
                            {
                                "example_id": "a310b475-266a-482c-be74-635b1376e0e4",
                                "sense_id": "051506df-79f2-3072-93ac-864589ed634d",
                                "text": "Dans le cercle d’un de ces carcans de fer, il restait encore deux os poudreux qui paraissaient avoir appartenu autrefois à une jambe humaine, comme si le prisonnier, après y avoir péri, avait, toujours enchaîné, passé à l’état de squelette."
                            },
                            {
                                "example_id": "864afa0c-5e34-429c-ab78-ec5a48ece49f",
                                "sense_id": "051506df-79f2-3072-93ac-864589ed634d",
                                "text": "La rigidité du corps auquel il appartenait, se mariant avec une sévérité innée, l'emprisonnait dans un carcan de dogmatisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d087eec-cb8c-3ac5-882e-659d0482193d",
                        "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                        "glosses": [
                            "Cercle de fer ou plaque en bois avec des trous pour le cou et les poignets avec lequel on attachait par le cou à un poteau certains criminels condamnés au pilori.",
                            "Chaine de fer, collier, souvent fixé à un poteau ou au sol, que l'on mettait aux galériens pour qu'ils ne s'échappent pas."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ffef100c-3575-3976-9461-6652379d7d03",
                        "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                        "glosses": [
                            "Cercle de fer ou plaque en bois avec des trous pour le cou et les poignets avec lequel on attachait par le cou à un poteau certains criminels condamnés au pilori.",
                            "Collier de bois que l’on mettait aux animaux pour les empêcher de traverser les haies."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e67aa352-e1ac-3791-aa2a-31fada573a10",
                        "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                        "glosses": [
                            "Cercle de fer ou plaque en bois avec des trous pour le cou et les poignets avec lequel on attachait par le cou à un poteau certains criminels condamnés au pilori.",
                            "Joug, ce qui emprisonne."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6f919dff-e4aa-3c07-b122-4c67fbeb500a",
                        "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                        "glosses": [
                            "Chaine ou collier d’or, de perles ou de pierreries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d766c3bc-a12b-4694-85a0-7edd22473e10",
                                "sense_id": "6f919dff-e4aa-3c07-b122-4c67fbeb500a",
                                "text": "Ces riches carcans, ces colliers\nEt cette pompe enchanteresse\nNe valent pas un des baisers\nQue tu donnais dans ta jeunesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "f976134c-5041-3789-bee0-33e3db3f8176",
                        "entry_id": "5320a97e-0e4b-3ddc-b57b-9ac699a7b568",
                        "glosses": [
                            "Contrainte."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f36137e0-0754-4795-b89f-8b37339d79af",
                                "sense_id": "f976134c-5041-3789-bee0-33e3db3f8176",
                                "text": "Je vois tant de gens tristes autour de moi, tant de pauvres êtres qui souffrent, étranglés dans ce que des écrivains peu convenables appellent le carcan de fer du mariage, que je m’étonne bien souvent de ce constant bonheur qui m’accompagne."
                            },
                            {
                                "example_id": "1efdc8cb-0801-441e-95e4-f1f4f158d02d",
                                "sense_id": "f976134c-5041-3789-bee0-33e3db3f8176",
                                "text": "Dès qu’elle le peut, la civilisation nous passe son carcan au cou. Nous n’avons plus qu’à marcher droit. Bon gré mal gré, nous sommes à ses ordres, nous ne grandissons que pour la servir."
                            },
                            {
                                "example_id": "4f797493-7b7b-421c-a8b8-0e5f1ca01563",
                                "sense_id": "f976134c-5041-3789-bee0-33e3db3f8176",
                                "text": "De rappeler qu’un jour, la vie reviendra. Que nous pourrons cesser d’être pris dans ce carcan et serrer de nouveau nos proches dans nos bras."
                            },
                            {
                                "example_id": "e9d0df9b-2a35-4ff9-9deb-30026fdcae79",
                                "sense_id": "f976134c-5041-3789-bee0-33e3db3f8176",
                                "text": "La Ville a dû abandonner le trambus pour respecter le carcan budgétaire dans lequel la CAQ inscrit le projet. Les coûts du tramway avaient explosé, mais l’offre s’avérait aussi trop capacitaire pour la demande dans le secteur."
                            }
                        ]
                    }
                ],
