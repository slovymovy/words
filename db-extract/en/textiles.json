                        "target_lang_word": "Textilwesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Textilwesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2ec2f2-779d-3207-9615-7258a7f8fe11",
                                        "entry_id": "da91c40e-c31c-3e4c-9a9f-641fc619f0be",
                                        "glosses": [
                                            "Gesamtheit der infrastrukturellen und organisatorischen Einrichtungen, die mit der Textilverarbeitung in Zusammenhang stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac7e22d8-75ea-4cd9-9c94-0bc56c91e2a2",
                                                "sense_id": "3e2ec2f2-779d-3207-9615-7258a7f8fe11",
                                                "text": "„Solche Wortverbindungen finden sich noch für die Sammelbezeichnung der verschiedenen Arbeitsmaschinen der Textilindustrie als Textilmaschinen und der Arbeiten der Warenherstellung als Textiltechnik, wie man auch das ganze Wissensgebiet unter dem Hauptbegriff Textilwesen zusammenfaßt.“"
                                            },
                                            {
                                                "example_id": "fbadb25e-5043-4777-baf6-07fddbf8d7a9",
                                                "sense_id": "3e2ec2f2-779d-3207-9615-7258a7f8fe11",
                                                "text": "„Und doch wird es vielleicht möglich sein, aus den für das Textilwesen von Baden-Württemberg vorliegenden Zahlen gewisse Schlüsse auf wirtschaftliche Vorgänge im jüdischen Sektor zumindest andeutend aufzuzeigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
