                        "sense_id": "b047379c-c8dc-3abc-a9b5-5fb8a968883d",
                        "entry_id": "4f5b80fd-4995-3c07-8030-1a1733698bd5",
                        "glosses": [
                            "Qui a subi une dénaturation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8d93887-ac55-47b5-831e-989e78dbd635",
                                "sense_id": "b047379c-c8dc-3abc-a9b5-5fb8a968883d",
                                "text": "alcool dénaturé."
                            },
                            {
                                "example_id": "5b00f011-d9d0-414b-b25b-0f4a710fc949",
                                "sense_id": "b047379c-c8dc-3abc-a9b5-5fb8a968883d",
                                "text": "ADN dénaturé."
                            }
                        ]
                    },
                    {
                        "sense_id": "de620ea7-f013-38b3-b8fe-f38e86df5a14",
                        "entry_id": "4f5b80fd-4995-3c07-8030-1a1733698bd5",
                        "glosses": [
                            "Qui a été altéré dans sa nature ou dans ses qualités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d54d6745-9d2e-410d-9a31-610c43ecdcdb",
                                "sense_id": "de620ea7-f013-38b3-b8fe-f38e86df5a14",
                                "text": "Romulus et Jupiter avaient donné des marques d’un cœur dénaturé ; l’un par le meurtre de son frère, et l’autre par celui de son père. — (Hugo Grotius, Traité de la vérité de la religion chrétienne, 1692)"
                            }
                        ]
                    },
                    {
                        "sense_id": "99614eb3-bf82-32d2-97e8-16e5a6ac0c47",
                        "entry_id": "4f5b80fd-4995-3c07-8030-1a1733698bd5",
                        "glosses": [
                            "Qui n’a plus pour les siens l’affection naturelle qu’il devrait avoir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "888d088e-5c57-4f52-bda8-b44bbeecc494",
                                "sense_id": "99614eb3-bf82-32d2-97e8-16e5a6ac0c47",
                                "text": "Père dénaturé. - Mère dénaturée. - Fils dénaturé."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7289d1a-9ee3-367b-a721-4665a60a59b7",
                        "entry_id": "4f5b80fd-4995-3c07-8030-1a1733698bd5",
                        "glosses": [
                            "Qui ne se conduit pas de façon naturelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01960922-1354-4bed-9b91-141e20342993",
                                "sense_id": "f7289d1a-9ee3-367b-a721-4665a60a59b7",
                                "text": "De dessous son hangar, Frédéric II voyait pourtant cet homme dénaturé adossé contre le tronc du hêtre dans une attitude fort paisible, même abandonnée ; dans une sorte de contentement manifeste : comme s’il chauffait ses guêtres à quelque cheminée de cuisine."
                            }
                        ]
                    }
                ],
