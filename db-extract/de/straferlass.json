                "translations": [
                    {
                        "translation_id": "ded2a302-db7b-4e55-8f24-2ac6870fc9cc",
                        "source_entry_id": "7106bd21-846b-34ec-8e9c-3a041b3b9a9f",
                        "source_sense_id": "09cce179-f89b-3bc3-9cb5-b7adc9abfe01",
                        "source_sense_description": "Verzicht auf die Abdienung einer Sanktion (Strafe)",
                        "target_lang_word": "remission of punishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "99f2e419-3b16-4086-8c0b-bb199487c090",
                        "source_entry_id": "7106bd21-846b-34ec-8e9c-3a041b3b9a9f",
                        "source_sense_id": "09cce179-f89b-3bc3-9cb5-b7adc9abfe01",
                        "source_sense_description": "Verzicht auf die Abdienung einer Sanktion (Strafe)",
                        "target_lang_word": "amnesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amnesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b406ee95-3293-3645-a2df-1891de8ff003",
                                        "entry_id": "7fe0c455-4097-33ce-b5f1-6469a9e56750",
                                        "glosses": [
                                            "Forgetfulness; cessation of remembrance of wrong; oblivion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8d26f8d-dcd8-3e86-b262-59325b8af06a",
                                        "entry_id": "7fe0c455-4097-33ce-b5f1-6469a9e56750",
                                        "glosses": [
                                            "An act of the sovereign power granting oblivion, or a general pardon, for a past offense, as to subjects concerned in an insurrection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d074aa5f-a98f-4b93-be51-d38640710a19",
                                                "sense_id": "a8d26f8d-dcd8-3e86-b262-59325b8af06a",
                                                "text": "Argentina has seen few legal issues as contentiously debated as these two laws of amnesty during the last two decades. […] Pursuant to the Convention on Forced Disappearance, amnesties may not contemplate a statutory limitation period less than that corresponding to the gravest crime punishable by domestic laws, provided there is a pre-existing domestic norm of “fundamental character” requiring that limitation."
                                            },
                                            {
                                                "example_id": "de63abf3-d995-447b-8b63-f9b3d5eeb717",
                                                "sense_id": "a8d26f8d-dcd8-3e86-b262-59325b8af06a",
                                                "text": "Russian lawmakers backed a sweeping amnesty law Wednesday that could see jailed members of the Pussy Riot punk protest band released early and arrested Greenpeace activists avoiding prison, the state-run RIA Novosti news agency reported."
                                            },
                                            {
                                                "example_id": "78499824-324c-4c05-903c-36564751cea6",
                                                "sense_id": "a8d26f8d-dcd8-3e86-b262-59325b8af06a",
                                                "text": "He said building amnesties were “a huge issue.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amnesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dac037f8-2e95-349e-991f-551933e87b58",
                                        "entry_id": "b798e828-f5f6-3975-a7b7-2b6073dee456",
                                        "glosses": [
                                            "To grant a pardon (to a group)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69fadc00-6f47-4ba5-af37-fbb0bfac9b7b",
                                                "sense_id": "dac037f8-2e95-349e-991f-551933e87b58",
                                                "text": "Shortly after the end of military rule in 1983, the Argentinean National Congress passed legislation that effectively amnestied many persons who allegedly committed human rights violations such as torture, extra-judicial killing, and forced disappearance. […] In other words, a government may be justified in amnestying military actions because the alternative would result in the destruction of the democratic state."
                                            },
                                            {
                                                "example_id": "2dcce121-0443-4d14-87ad-d71e559a2bf1",
                                                "sense_id": "dac037f8-2e95-349e-991f-551933e87b58",
                                                "text": "“100 miles of border wall in exchange for amnestying millions of illegals. So if we grant citizenship to a BILLION foreigners, maybe we can finally get a full border wall,” Coulter wrote in another tweet."
                                            },
                                            {
                                                "example_id": "ed6f7236-cd9a-4d4b-969e-743f8dab8324",
                                                "sense_id": "dac037f8-2e95-349e-991f-551933e87b58",
                                                "text": "“This is such immoral selectivity,” he added. “Anyone who amnesties Russia and who artificially creates a such informational context where some attacks by terrorists are supposedly justified or supposedly understandable cannot fail to understand that, in doing so, they are helping the terrorists.”"
                                            },
                                            {
                                                "example_id": "5980b702-0c10-471d-81ed-623aaab88ebc",
                                                "sense_id": "dac037f8-2e95-349e-991f-551933e87b58",
                                                "text": "“The number of people that will be amnestied when I’m president is zero,” DeSantis said, when asked if he would allow any of the 10 million to stay in the US."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cb43e91-07ca-4e72-b4eb-20bf406462c5",
                        "source_entry_id": "7106bd21-846b-34ec-8e9c-3a041b3b9a9f",
                        "source_sense_id": "09cce179-f89b-3bc3-9cb5-b7adc9abfe01",
                        "source_sense_description": "Verzicht auf die Abdienung einer Sanktion (Strafe)",
                        "target_lang_word": "pardon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pardon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24165fbf-9e9b-39ae-a4c3-03df02fe9448",
                                        "entry_id": "c4b5a6ef-b68d-3662-8fc4-5f3feb1ec297",
                                        "glosses": [
                                            "Forgiveness for an offence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29da9954-e023-4850-adea-872cb34b011a",
                                                "sense_id": "24165fbf-9e9b-39ae-a4c3-03df02fe9448",
                                                "text": "[…] a step, that could not be taken with the least hope of ever obtaining pardon from or reconciliation with any of my friends; […]"
                                            },
                                            {
                                                "example_id": "99789f96-5c77-4ded-8317-15639ef2d78c",
                                                "sense_id": "24165fbf-9e9b-39ae-a4c3-03df02fe9448",
                                                "text": "According to this logic, the pardons Balteira gained on her pilgrimage should have revirginated her, and would have if she had an 'iron box', or a firm dedication to her Christian faith, with which to guard her chastity.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eae2f318-83ac-310c-8d07-7212e982e0cf",
                                        "entry_id": "c4b5a6ef-b68d-3662-8fc4-5f3feb1ec297",
                                        "glosses": [
                                            "An order that releases a convicted criminal without further punishment, prevents future punishment, or (in some jurisdictions) removes an offence from a person's criminal record, as if it had never been committed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd037c1c-d803-49ac-927d-ac86068e08b3",
                                                "sense_id": "eae2f318-83ac-310c-8d07-7212e982e0cf",
                                                "text": "The President[…]shall have Power to grant Reprieves and Pardons for Offences against the United States, except in Cases of Impeachment."
                                            },
                                            {
                                                "example_id": "7c188104-f219-4dad-96e2-844c56d2c83b",
                                                "sense_id": "eae2f318-83ac-310c-8d07-7212e982e0cf",
                                                "text": "NOW, THEREFORE, I, Gerald R. Ford, President of the United States, pursuant to the pardon power conferred upon me by Article II, Section 2, of the Constitution, have granted and by these presents do grant a full, free, and absolute pardon unto Richard Nixon for all offenses against the United States which he, Richard Nixon, has committed or may have committed or taken part in during the period from July^([sic – meaning January]) 20, 1969 through August 9, 1974."
                                            },
                                            {
                                                "example_id": "3ab738a6-f856-44a7-b869-da6d84b0b125",
                                                "sense_id": "eae2f318-83ac-310c-8d07-7212e982e0cf",
                                                "text": "But the president's most irreversible, almost God-like power is the authority granted to him under Article II, Section 2, of the United States Constitution, \"to grant Reprieves and Pardons for Offenses Against the United States. . . .\"\nThe power is absolute-even a serial killer could be pardoned-and utterly unreviewable. It cannot be rescinded by the next president. The president may grant a pardon before a trial, after a trial, or without a trial. Once granted, a pardon can never be taken away."
                                            },
                                            {
                                                "example_id": "cd9993c9-7d2d-44a6-9442-4079c172680e",
                                                "sense_id": "eae2f318-83ac-310c-8d07-7212e982e0cf",
                                                "text": "A source familiar with Trump legal strategy says his team believes Biden’s pardon of his son Hunter has set a new precedent for presidents to issue expansive pardons to their children – and this could be something Trump chooses to do before he leaves office."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pardon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b75e65fc-c7a8-329b-9ba6-1b9352c218b4",
                                        "entry_id": "6b97b014-271a-3fee-a8d5-b0f6b88184cb",
                                        "glosses": [
                                            "To forgive (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b9aece-db83-4b1b-8650-fdb02cc0d085",
                                                "sense_id": "b75e65fc-c7a8-329b-9ba6-1b9352c218b4",
                                                "text": "O, pardon me, thou bleeding piece of earth, / That I am meek and gentle with these butchers!"
                                            },
                                            {
                                                "example_id": "56c679dd-e4c2-407f-b342-5578209fb040",
                                                "sense_id": "b75e65fc-c7a8-329b-9ba6-1b9352c218b4",
                                                "text": "I hope you will not find he has outstepped the truth more than may be pardoned, in consideration of the motive."
                                            },
                                            {
                                                "example_id": "3384bf78-d77d-4663-a23b-56ec24e24b66",
                                                "sense_id": "b75e65fc-c7a8-329b-9ba6-1b9352c218b4",
                                                "text": "Well! the King of France died pardoning & pitying all those who had tortured his Soul & Body, a great Pattern for us all."
                                            },
                                            {
                                                "example_id": "dfd44e3a-acef-4bbd-a76d-b871196176be",
                                                "sense_id": "b75e65fc-c7a8-329b-9ba6-1b9352c218b4",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b951a5fb-5356-31f0-80ad-b3eae3953560",
                                        "entry_id": "6b97b014-271a-3fee-a8d5-b0f6b88184cb",
                                        "glosses": [
                                            "To refrain from exacting as a penalty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357316c4-c04a-4942-8aed-6f23dcb6d84d",
                                                "sense_id": "b951a5fb-5356-31f0-80ad-b3eae3953560",
                                                "text": "I pardon thee thy life before thou ask it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef1baa5a-7e83-38cd-83a1-592963d781d2",
                                        "entry_id": "6b97b014-271a-3fee-a8d5-b0f6b88184cb",
                                        "glosses": [
                                            "To grant an official pardon for a crime."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbd6fb57-6a3c-4adc-bb6d-277b0749645b",
                                                "sense_id": "ef1baa5a-7e83-38cd-83a1-592963d781d2",
                                                "text": "The murderer, he recalled, had been tried and sentenced to imprisonment for life, but was pardoned by a merciful governor after serving a year of his sentence."
                                            },
                                            {
                                                "example_id": "f214dfba-9834-4eba-a38a-a3e7f6819b26",
                                                "sense_id": "ef1baa5a-7e83-38cd-83a1-592963d781d2",
                                                "text": "In that situation, that memo would include a list of individuals that Biden might consider pardoning preemptively, the context about any prior legal precedent, and a discussion of the wide range of potential ramifications if the president does move forward with these pardons."
                                            },
                                            {
                                                "example_id": "4ddd8057-391f-4866-8158-7218cf2ff66e",
                                                "sense_id": "ef1baa5a-7e83-38cd-83a1-592963d781d2",
                                                "text": "President Donald Trump says he pardoned Trevor Milton, the CEO of now-defunct hydrogen and electric truck firm Nikola, in part because he believed Milton was persecuted for supporting Trump’s political ambitions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pardon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfdceb36-9f34-3194-94ed-6f6a866585bd",
                                        "entry_id": "75b91803-8f9e-3b7b-aaaa-ad3f13116647",
                                        "glosses": [
                                            "Often used when someone does not understand what another person says."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
