                },
                {
                    "sense_id": "300d768d-b424-3707-a89a-3827ed9ea1ce",
                    "sense_definition": "een voertuig op wielen dat wordt getrokken door dieren of een ander voertuig",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "voertuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer laadde het hooi op de houten <w>wagen</w> achter het paard.",
                            "target_lang_translations": {
                                "en": "The farmer loaded the hay onto the wooden <w>wagon</w> behind the horse."
                            }
                        },
                        {
                            "text": "In het museum staat een oude <w>wagen</w> die vroeger door ossen werd getrokken.",
                            "target_lang_translations": {
                                "en": "In the museum stands an old <w>cart</w> that used to be pulled by oxen."
                            }
