                        "glosses": [
                            "Plante dicotylédone de l’ordre des brassicales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027675eb-114e-4eb4-b330-ef6b4a3e01a2",
                                "sense_id": "cb35848e-0e45-3767-9fda-1664a62ecc69",
                                "text": "Ses occupants consomment d’abord une nourriture variée, avec des céréales, mais ensuite cuisinent essentiellement des brassicacées (Brassicaceae, famille des choux, navets, etc.)."
                            },
                            {
                                "example_id": "fa91dd86-b5f9-4f43-808a-fb1a9ab653b1",
                                "sense_id": "cb35848e-0e45-3767-9fda-1664a62ecc69",
                                "text": "La ravenelle (Raphanus raphanistrum), une cousine sauvage du radis, est une brassicacée caractéristique, avec sa fleur à quatre pétales en forme de croix."
                            }
                        ]
                    }
