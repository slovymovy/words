                        "entry_id": "6abf597c-f4ae-3aee-953b-d544f1eb68b4",
                        "glosses": [
                            "Opération chirurgicale consistant en lʼablation totale ou partielle du larynx."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17eb7e1f-54de-4623-993f-680898071ea5",
                                "sense_id": "a8ba4bef-2da8-3edc-b195-14fcb89527fd",
                                "text": "Certains patients développent une chondrite ou une sténose; dans quelques cas, une laryngectomie est nécessaire."
                            },
                            {
                                "example_id": "4333ba49-e574-486b-bcf9-e1f5b0f9e3fb",
                                "sense_id": "a8ba4bef-2da8-3edc-b195-14fcb89527fd",
                                "text": "Certains cancers du larynx sont traités aujourdʼhui par laryngectomie partielle alors que la laryngectomie totale était il y a dix ans le seul traitement chirurgical envisageable."
                            }
                        ]
                    }
