                        "glosses": [
                            "of iets naar eigen wens (of ideologie) kan worden ingericht, vervaardigd of gevormd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70e16049-fd55-4bd3-aaf2-4acc0cc071b0",
                                "sense_id": "6f2bb17a-1190-37ec-a707-ece2b19d338f",
                                "text": "In zijn vertellingen maakt hij gehakt van ideeën die in de 21ste eeuw nog steeds veel navolging hebben. Dat het bestaan bijvoorbeeld maakbaar is of dat de mens voor elk probleem wel een redelijke en vooral pijnloze oplossing kan bedenken."
                            }
                        ]
                    }
