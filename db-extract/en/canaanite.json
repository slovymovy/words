                                        "sense_id": "cd0e7a02-41af-301a-8c1e-c3b3ad4f73fa",
                                        "entry_id": "6a282e17-a7a5-3347-9988-7f885485ea31",
                                        "glosses": [
                                            "Einwohner der Region Kanaan"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44779a12-6725-4c99-817c-c39721c43a82",
                                                "sense_id": "cd0e7a02-41af-301a-8c1e-c3b3ad4f73fa",
                                                "text": "„Das Volk der Kanaanäer war von semitischer Herkunft und siedelte seit dem 3. vorchristlichen Jahrtausend im heutigen Palästina.“"
                                            },
                                            {
                                                "example_id": "b3ef124c-a247-48a8-941c-870975e6681d",
                                                "sense_id": "cd0e7a02-41af-301a-8c1e-c3b3ad4f73fa",
                                                "text": "„Die Zeichen der Kanaanäer lehnten sich an die Bildhaftigkeit der ägyptischen Hieroglyphen an, abstrahierten diese jedoch radikal in der Form und trugen nie deren Bedeutung.“"
                                            },
                                            {
                                                "example_id": "04215150-82ee-47ba-90d6-bb6e4ea2810c",
                                                "sense_id": "cd0e7a02-41af-301a-8c1e-c3b3ad4f73fa",
                                                "text": "„Bei den Kanaanäern blühten die uralten weitverbreiteten Kulte einer großen, Fruchtbarkeit spendenden Muttergöttin, auf kanaanäischem Boden weithin Astharthe genannt, und eines die jährlich aufblühende und absterbende Vegetation repräsentierenden jugendlichen Gottes […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
