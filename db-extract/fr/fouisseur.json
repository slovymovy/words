                ],
                "senses": [
                    {
                        "sense_id": "6bb7cd96-7d82-3bdc-9fe5-a4ee9bb953e2",
                        "entry_id": "a218df28-eca9-374e-92c8-90f76b956365",
                        "glosses": [
                            "Animal capable de creuser le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e20932-68b9-4a15-959c-b414b440c07d",
                                "sense_id": "6bb7cd96-7d82-3bdc-9fe5-a4ee9bb953e2",
                                "text": "La courtilière et le grillon sont des fouisseurs au même titre que la taupe ou le blaireau."
                            },
                            {
                                "example_id": "08a797cc-1348-4623-8b17-5099a2d3e7a7",
                                "sense_id": "6bb7cd96-7d82-3bdc-9fe5-a4ee9bb953e2",
                                "text": "Le campagnol terrestre (Arvicola terrestris) est un fouisseur qui creuse un réseau très ramifié de galeries, signalées çà et là par de petits monticules de terre fine (il creuse en effet à l’aide de ses dents), contrairement à la taupe."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcd2e699-4d85-3e61-b131-082e0bd23101",
                        "entry_id": "a218df28-eca9-374e-92c8-90f76b956365",
                        "glosses": [
                            "Personne qui cherche quelque chose, qui fouine."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "4d524365-e69d-460b-adeb-77d464641a32",
                                "sense_id": "bcd2e699-4d85-3e61-b131-082e0bd23101",
                                "text": "Le brouhaha est assourdissant : des bonimenteurs vantent les mérites de leurs produits, des fouisseurs au regard mystérieux attirent les chalands en proposant de découvrir les antiques richesses arrachées au sous-sol (…)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeb8cd02-f6b6-4b5d-ba62-18edf5510e21",
