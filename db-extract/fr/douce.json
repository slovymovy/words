                    {
                        "sense_id": "4d8523d5-34a3-3c3a-b583-eeaf0a51ad52",
                        "entry_id": "27daba90-22a5-338b-9596-f3171e9e35d0",
                        "glosses": [
                            "Féminin singulier de doux."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "5c116dd3-aa71-4de5-b3ff-ddb73b851d96",
                                "sense_id": "4d8523d5-34a3-3c3a-b583-eeaf0a51ad52",
                                "text": "La voix du courlieu, douce et triste, semble une note sortie d’une flûte; la grande bécassine ventriloquise son chant en volant d’une façon désordonnée au-dessus de son nid."
                            },
                            {
                                "example_id": "004cd87c-e5dc-462d-a76a-624a70d44ea5",
                                "sense_id": "4d8523d5-34a3-3c3a-b583-eeaf0a51ad52",
                                "text": "J’ai quitté ma maison douce, sur le coteau ; elle dort maintenant délaissée."
                            },
                            {
                                "example_id": "e10ff100-1171-4f05-972f-b5a1b50809d6",
                                "sense_id": "4d8523d5-34a3-3c3a-b583-eeaf0a51ad52",
                                "text": "La fatalité est une sorte d’habit que l’on endosse avec une douce soumission."
                            }
                        ]
                    }
                ],
