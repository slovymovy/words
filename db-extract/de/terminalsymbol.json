                "senses": [
                    {
                        "sense_id": "54aa1eca-85a2-304e-afce-e40ce33ae216",
                        "entry_id": "c7e5e496-ad07-353c-913f-fd810ffa2355",
                        "glosses": [
                            "Theoretische Informatik, Theorie formaler Sprachen: Ein Symbol, das Teil der von einer formalen Sprache erzeugten Konstrukte sein kann. Symbol des Alphabetes der von einer formalen Sprache erzeugten Konstrukte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11177b3-6ba0-4f7c-9e7e-39acf9775f97",
                                "sense_id": "54aa1eca-85a2-304e-afce-e40ce33ae216",
                                "text": "Die Terminalsymbole für eine formale Sprache, die alle möglichen Sätze der deutschen Schrift beschreiben sollte, bestünde gerade aus allen einschlägigen Buchstaben, Ziffern, Satzzeichen usw. Sollte die betrachtete formale Sprache dagegen die Lautäußerungen der deutschen Sprache beschreiben, würden die Lautzeichen aller im Deutschen auftretenden Laute das Terminalzeichen-Alphabet bilden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
