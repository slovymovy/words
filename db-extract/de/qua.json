                                "sense_id": "c75e595f-43e8-319e-b195-9998ee1e69eb",
                                "text": "Die Höhe der Betriebsrente berechnet sich qua Betriebszugehörigkeitsdauer."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
