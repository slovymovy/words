                "senses": [
                    {
                        "sense_id": "d5629f8e-b3a3-3048-9213-7472308fe873",
                        "entry_id": "54f2b0e5-bd21-3ef6-aff3-1fb6806dd498",
                        "glosses": [
                            "церк. находящаяся на возвышении перед алтарём площадка в христианском храме, используемая для произнесения проповедей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded2b7db-0eb1-4ca1-8ccf-ed2400128afb",
                                "sense_id": "d5629f8e-b3a3-3048-9213-7472308fe873",
                                "text": "Амвонные ступени."
                            },
                            {
                                "example_id": "0df95a77-2ca2-4bae-aa47-c5eaad454e58",
                                "sense_id": "d5629f8e-b3a3-3048-9213-7472308fe873",
                                "text": "Мужиков набралось в церковь — вона! от притвора до амвона."
                            },
                            {
                                "example_id": "debb1c2d-e5af-44b5-b41c-1be1eb73319a",
                                "sense_id": "d5629f8e-b3a3-3048-9213-7472308fe873",
                                "text": "Когда на греческий амвон, // Когда на римскую трибуну // Оратор восходил…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e336b139-7355-317b-bcb3-8176bb1a8684",
                        "entry_id": "54f2b0e5-bd21-3ef6-aff3-1fb6806dd498",
                        "glosses": [
                            "устар. возвышение, подмостки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe32f1a-695b-4e96-87fc-51895e0ccd26",
                                "sense_id": "e336b139-7355-317b-bcb3-8176bb1a8684",
                                "text": "Проворными шагами взобрался он на особенно устроенный амвон — и подал знак, что желает произнести стихотворение."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2dadb98-b159-44cd-a220-f9fd9acccfff",
                        "source_entry_id": "54f2b0e5-bd21-3ef6-aff3-1fb6806dd498",
                        "target_lang_word": "ambo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a7221b-1f9e-3835-a1c8-43c8122b23ed",
                                        "entry_id": "2231eff5-f82b-349e-a6b6-b05997561f73",
                                        "glosses": [
                                            "A raised platform in an early Christian church, as well as in the Eastern Orthodox, Oriental Orthodox, and Eastern Catholic churches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8287c5-4471-4358-8ace-dc6952304aff",
                                                "sense_id": "d2a7221b-1f9e-3835-a1c8-43c8122b23ed",
                                                "text": "‘It will get better somehow,’ he thought, and went to the ambo. On going up the steps and turning to the right he saw the priest."
                                            },
                                            {
                                                "example_id": "dd15b394-662d-4772-90ad-202f99fd20ee",
                                                "sense_id": "d2a7221b-1f9e-3835-a1c8-43c8122b23ed",
                                                "text": "the Emperor arrived and instead of moving directly to his seat climbed to the top level of the ambo, the great three-decker pulpit of polychrome marble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4596fa4b-bbc3-3bdc-8c7b-ba6fe69f0c01",
                                        "entry_id": "2231eff5-f82b-349e-a6b6-b05997561f73",
                                        "glosses": [
                                            "A stationary podium used for readings and homilies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc692389-bfea-49c5-803b-172ca3fe84eb",
                                                "sense_id": "4596fa4b-bbc3-3bdc-8c7b-ba6fe69f0c01",
                                                "text": "The dignity of the Word of God requires that in the church there be a suitable place from which it may be proclaimed and toward which the attention of the faithful naturally turns during the Liturgy of the Word. It is appropriate that generally this place be a stationary ambo and not simply a movable lectern."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ambo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae59c49e-bd13-36a3-90c9-652d23baaa47",
                                        "entry_id": "f4c0f951-e40f-3238-aa7d-9cbaa7a22dc6",
                                        "glosses": [
                                            "An ambulance driver."
                                        ],
