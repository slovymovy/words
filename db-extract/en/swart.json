    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3bdd4de2-1962-3489-a670-96a3c177f4b9",
                "word": "swart",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5960c749-14b7-416f-ba9e-44c5547e35ee",
                        "entry_id": "3bdd4de2-1962-3489-a670-96a3c177f4b9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "swarter"
                    },
                    {
                        "form_id": "30727466-99a7-456c-bf66-7b37431b29eb",
                        "entry_id": "3bdd4de2-1962-3489-a670-96a3c177f4b9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "swartest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                        "entry_id": "3bdd4de2-1962-3489-a670-96a3c177f4b9",
                        "glosses": [
                            "Of a dark hue; moderately black; swarthy; tawny."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc25717-b13f-496e-b822-7fd4d9cebb06",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "1400s: Thomas Occleve, Hymns to the Virgin\nMen schalle then sone se / Att mydday hytt shalle swarte be"
                            },
                            {
                                "example_id": "07dd690f-500d-4de2-a64a-52f6298802f7",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "A nation strange, with visage swart"
                            },
                            {
                                "example_id": "9d44fbe6-b8e6-47c0-bcf4-271959bdbdb2",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "Lame, foolish, crooked, swart, prodigious,"
                            },
                            {
                                "example_id": "94dc4fde-02a9-4c95-94a4-4ec2a74432c5",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "Of shades , and wanton winds , and gushing brooks ,\nOn whose fresh lap the swart - star sparely looks"
                            },
                            {
                                "example_id": "94ddc1df-a935-4091-b04c-639563ec33ee",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "I'll choose a gaoler, whose swart monstrous face\nShall be a hell to look upon […]"
                            },
                            {
                                "example_id": "b033ef4e-db05-4535-b4e9-23ebc1c1cd24",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "The merry soldiers footing it with the swart savage maids"
                            },
                            {
                                "example_id": "62058b26-0aad-4ed8-83f0-42838ae17c86",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "The keeping eunuchs were at back, solemn in stately rows, bespeared and bescimitared, the Danish, Irish, and German of their countenances lost in the daub which made them swart."
                            },
                            {
                                "example_id": "27d0bb91-bdac-4690-b5f2-1c65d10be223",
                                "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                                "text": "[…] unpierced ever\nWith glitter of sun rays\nNor with stars stretched, nor looking back from heaven\nSwartest night stretched over wretched men there."
                            }
                        ]
                    },
                    {
                        "sense_id": "3240937e-c323-3624-a490-cd54b9ad58f6",
                        "entry_id": "3bdd4de2-1962-3489-a670-96a3c177f4b9",
                        "glosses": [
                            "Black."
                        ],
                        "tags": [
                            "UK",
                            "dialectal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "85442561-2aab-3ba6-b762-76da3e107bae",
                        "entry_id": "3bdd4de2-1962-3489-a670-96a3c177f4b9",
                        "glosses": [
                            "Gloomy; malignant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e93077e5-7a0d-4945-9513-8acb4fbc57eb",
                                "sense_id": "85442561-2aab-3ba6-b762-76da3e107bae",
                                "text": "Suddenly the swart figure of Time stood up before the gods, with both hands dripping with blood and a red sword dangling idly from his fingers, and said: “Sardathrion is gone! I have overthrown it!”"
                            }
                        ]
                    }
                ],
