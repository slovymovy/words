                                    },
                                    {
                                        "sense_id": "97e98812-9550-3837-8f66-e750fe6e9d2d",
                                        "entry_id": "8fc73226-ea39-3ea0-a32d-938c3b06e575",
                                        "glosses": [
                                            "To bathe using a shower."
