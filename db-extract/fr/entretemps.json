                    }
                ],
                "senses": [
                    {
                        "sense_id": "6dc910ed-02e1-3a5b-b026-b8be8c218676",
                        "entry_id": "c9a85404-0328-3d78-80c5-27309f772e28",
                        "glosses": [
                            "Dans cet intervalle de temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be761f80-7df9-4f92-a800-b349bb504266",
                                "sense_id": "6dc910ed-02e1-3a5b-b026-b8be8c218676",
                                "text": "Entretemps, il arriva, il survint."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe22dd9a-aea3-4207-874a-28aba03286e1",
                        "source_entry_id": "c9a85404-0328-3d78-80c5-27309f772e28",
                        "source_sense_id": "6dc910ed-02e1-3a5b-b026-b8be8c218676",
                        "source_sense_description": "Dans cet intervalle de temps",
                        "target_lang_word": "inzwischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inzwischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                        "entry_id": "05c9bad7-af7b-3f06-acbe-8c627d977b24",
                                        "glosses": [
                                            "in der Zwischenzeit, nach Ablauf einer gewissen Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1349d96b-0837-4d97-acac-435b2f8e3e17",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "Während sie noch spielten, konnten wir inzwischen die nötigen Vorbereitungen treffen."
                                            },
                                            {
                                                "example_id": "2afac981-c6dd-4e01-ae54-bdad7673bc82",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Selbst in den Bundesländern wird inzwischen indirekt eingeräumt, dass die Bahn in der Vergangenheit großzügig bedacht wurde.“"
                                            },
                                            {
                                                "example_id": "76671e86-11a6-45ff-9b2c-234b8bc786bc",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Im geistlichen Kurfürstentum Köln hatten inzwischen ebenfalls die Hexenprozesse sich zu häufen begonnen.“"
                                            },
                                            {
                                                "example_id": "b710f268-df84-4275-9a16-e41fba577005",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Inzwischen bringt der Kellner für Maja das bestellte Kännchen Kaffee und die drei Stücke Kuchen, die sie sich am Buffet ausgesucht hat, und Paul bekommt eine Tasse Tee.“"
                                            },
                                            {
                                                "example_id": "d98eab69-a2a9-49fb-a44b-f789b3d35e99",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Den Leichnam hatte man inzwischen entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfd7d1b8-c77b-4f26-8fa5-ebb5a7e8a7e6",
                        "source_entry_id": "c9a85404-0328-3d78-80c5-27309f772e28",
                        "source_sense_id": "6dc910ed-02e1-3a5b-b026-b8be8c218676",
                        "source_sense_description": "Dans cet intervalle de temps",
                        "target_lang_word": "zwischenzeitlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwischenzeitlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04044c14-501f-315c-a7dd-728b3cf7b400",
                                        "entry_id": "26367ce0-e47a-3e4b-8c7d-59cef519e0ff",
                                        "glosses": [
                                            "für einen gewissen, begrenzten Zeitraum in der Vergangenheit [bestehend, stattfindend]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f338f21-6822-43e1-b78e-25976c6fc5fd",
                                                "sense_id": "04044c14-501f-315c-a7dd-728b3cf7b400",
                                                "text": "„Streitfragen, die zwischenzeitlich befriedet schienen, brechen erneut auf.“"
                                            },
                                            {
                                                "example_id": "7ea47ee4-1b21-46b6-b155-e3ee263e927e",
                                                "sense_id": "04044c14-501f-315c-a7dd-728b3cf7b400",
                                                "text": "„Zwischen 2008 und 2012 stieg die Quote minimal um 0,2 Prozentpunkte – nachdem sie zwischenzeitlich auch schon geringer war.“"
                                            },
                                            {
                                                "example_id": "f2f65624-47b1-4082-bee8-83dbb123ec59",
                                                "sense_id": "04044c14-501f-315c-a7dd-728b3cf7b400",
                                                "text": "„Hatte es zwischenzeitlich auch moderatere Stimmen innerhalb der Gruppe gegeben, die sich sogar für einen Dialog mit der Regierung einsetzten, scheint sich Boko Haram inzwischen völlig radikalisiert zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fb68d8c-1be2-3457-a9ff-94045fe4e63c",
                                        "entry_id": "26367ce0-e47a-3e4b-8c7d-59cef519e0ff",
                                        "glosses": [
                                            "nur in der seither vergangenen Zeit"
                                        ],
                                        "tags": [
                                            "adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8c6ff20-6ac8-42ac-8eae-60cd9bae1438",
                                                "sense_id": "5fb68d8c-1be2-3457-a9ff-94045fe4e63c",
                                                "text": "„Sachenbacher-Stehle ist nach dem zwischenzeitlich überführten italienischen Bobfahrer William Frullani die zweite Athletin, die während der Sotschi-Spiele positiv getestet wurde.“"
                                            },
                                            {
                                                "example_id": "03f8d2dc-35f7-410e-b97b-ba42f316d047",
                                                "sense_id": "5fb68d8c-1be2-3457-a9ff-94045fe4e63c",
                                                "text": "„Zwischenzeitlich aufgetauchte Dokumente haben die Glaubwürdigkeit mehrerer Manager infrage gestellt und die Position der Bank deutlich verschlechtert […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "238bd57a-e1c5-4d0a-b6ce-ac729b83e5f5",
                        "source_entry_id": "c9a85404-0328-3d78-80c5-27309f772e28",
                        "source_sense_id": "6dc910ed-02e1-3a5b-b026-b8be8c218676",
                        "source_sense_description": "Dans cet intervalle de temps",
                        "target_lang_word": "meanwhile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                        "entry_id": "caab6ad0-d45e-39cc-9755-498b9ee5e510",
                                        "glosses": [
                                            "The time between two events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b2315d-7c63-4384-b5eb-77c4ded31571",
                                                "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                                "text": "In the meanwhile, the surveyors carried the line three miles, which was no contemptible day's work, considering how cruelly they were entangled with briers and gallbushes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During the time that something is happening, often specifically in a different place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e5e79c-ae8f-4148-b523-1c9c34e73771",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "There was a party going on downstairs. Meanwhile, I was reading a book."
                                            },
                                            {
                                                "example_id": "e2fca7da-277f-4f41-a041-026da9b103ab",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During an intervening time; from now until a future time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b87e7889-9a76-4362-9b4e-6076a7392553",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "We’re going on holiday next month; meanwhile, keep working on the project."
                                            },
                                            {
                                                "example_id": "eb3d8668-3f83-46a9-837f-55f7e8b2e18d",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "The day may dawn when fair play, love for one's fellow men, respect for justice and freedom, will enable tormented generations to march forth triumphant from the hideous epoch in which we have to dwell. Meanwhile, never flinch, never weary, never despair."
                                            },
                                            {
                                                "example_id": "224cf66c-ad13-4898-9fc8-c656c0cb974a",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "“[…] I’m not ignoring you, I’m very sorry, I’ll talk to you soon. Meanwhile, get your tickets.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "In contrast to aspects previously mentioned."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ed779-978e-44e0-81d8-98bcd1fa47c8",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "Some songs on the album are beautiful. Meanwhile, others are quite forgettable."
                                            },
                                            {
                                                "example_id": "c4a80167-011a-4835-973a-e857e80ce02e",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "When you are in the studio you don’t have anybody to feed off of, meanwhile when you are playing live you interact with people and you feel the energy in the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfa10910-22e6-4450-8158-5c97bdefaaa5",
                        "source_entry_id": "c9a85404-0328-3d78-80c5-27309f772e28",
                        "source_sense_id": "6dc910ed-02e1-3a5b-b026-b8be8c218676",
                        "source_sense_description": "Dans cet intervalle de temps",
                        "target_lang_word": "in the meantime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in the meantime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                        "entry_id": "6f1e09ab-a9b4-36c9-a4f5-460f4faf0409",
                                        "glosses": [
                                            "meanwhile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779d4a11-3bbd-4c10-a9d3-bf2b1bc17fb7",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "But in the meantime Robin Hood and his band lived quietly in Sherwood Forest, without showing their faces abroad, for Robin knew that it would not be wise for him to be seen in the neighborhood of Nottingham, those in authority being very wroth with him."
                                            },
                                            {
                                                "example_id": "fb1ed1c2-10d1-4690-9706-2ce0b4a2907a",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "\"In the meantime,\" said Norbourne, \"we have arrived at the park-gate, and have not determined whither we shall ride.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
