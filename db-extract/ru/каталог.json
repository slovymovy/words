                                    },
                                    {
                                        "sense_id": "1abc3506-e29b-39a9-8531-ebc70d9a79fd",
                                        "entry_id": "2a4ed4d7-e7e6-3c72-84e7-ee4e60b4e0d1",
                                        "glosses": [
                                            "To make a catalogue of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88f45cb-5ba6-4a74-859f-176b5030c989",
                                                "sense_id": "1abc3506-e29b-39a9-8531-ebc70d9a79fd",
                                                "text": "The consequences were catalogued by the Royal Commission for Environmental Pollution in 1994, which recommended several measures to constrain the emission of greenhouse gases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f6b959-482c-38a0-a98d-2c5d0ddf7b57",
