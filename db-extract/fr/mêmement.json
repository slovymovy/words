        "fr-extract.jsonl": [
            {
                "entry_id": "29b1a926-aead-3568-a63d-dd7a778bb37f",
                "word": "mêmement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ca8a04b6-ca77-300d-b75e-8c1c58440517",
                        "entry_id": "29b1a926-aead-3568-a63d-dd7a778bb37f",
                        "glosses": [
                            "De même."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "33b41ebf-185d-4bf4-b2f7-bf8c476fbf41",
                                "sense_id": "ca8a04b6-ca77-300d-b75e-8c1c58440517",
                                "text": "Ça lui faisait faire souvent de longues courses, et mêmement il allait souvent chez la maîtresse de Blanchet, qui demeurait à une lieue du moulin."
                            },
                            {
                                "example_id": "c2140405-7a5e-4370-8ad1-2353837732c3",
                                "sense_id": "ca8a04b6-ca77-300d-b75e-8c1c58440517",
                                "text": "— M. le curé va rentrer, et il n’aurait personne pour affener sa jument, mêmement, je vais chercher mon dard (ma faux), pour en donner un trait sur ces herbes, à seule fin d’en porter une brassée dans la mangeoire."
                            },
                            {
                                "example_id": "71bb68f8-11ec-4062-8dd2-183c57aacce5",
                                "sense_id": "ca8a04b6-ca77-300d-b75e-8c1c58440517",
                                "text": "On n’essaya plus guère de recommencer, car il faut dire que le père et la mère, mêmement les oncles et les tantes, les frères et les sœurs, avaient pour les bessons une amitié qui tournait un peu en faiblesse."
                            },
                            {
                                "example_id": "39d9bdbf-7274-481a-bbcf-7ab9fe12c2d2",
                                "sense_id": "ca8a04b6-ca77-300d-b75e-8c1c58440517",
                                "text": "Vendredi chair ne mangeras,\nNi le samedi mêmement."
                            },
                            {
                                "example_id": "3c1c2ae9-98d4-4a79-b633-9b17958e3edd",
                                "sense_id": "ca8a04b6-ca77-300d-b75e-8c1c58440517",
                                "text": "Ils seront mêmement contre la guerre, la pollution, les épidémies ou la dette grecque."
                            }
                        ]
                    },
                    {
                        "sense_id": "04b774ba-88ac-39f1-9562-b93a73adfd3d",
                        "entry_id": "29b1a926-aead-3568-a63d-dd7a778bb37f",
                        "glosses": [
                            "Surtout."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "510be804-0bbe-4323-8ace-0bb82e59a593",
                                "sense_id": "04b774ba-88ac-39f1-9562-b93a73adfd3d",
                                "text": "Ne savait-il pas [Coligny] que sa religion étant haïe aux personnes mêmement les plus douces et traitables, elle ne pouvait être qu’abominée et détestée en la sienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54917437-5e69-4900-9144-b5fcdcaaa489",
                        "source_entry_id": "29b1a926-aead-3568-a63d-dd7a778bb37f",
                        "target_lang_word": "identically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70c7e356-0a7c-37ea-8439-75194735bcc7",
                                        "entry_id": "44e3fff1-affa-3e46-ba8d-94db2a3864af",
                                        "glosses": [
                                            "In an identical manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45514da4-d827-487b-a924-a4fbd7d47843",
                                                "sense_id": "70c7e356-0a7c-37ea-8439-75194735bcc7",
                                                "text": "It was hard to tell the twins apart: they even spoke identically."
                                            },
                                            {
                                                "example_id": "6e914930-cbcf-4e67-9964-3327a33e0443",
                                                "sense_id": "70c7e356-0a7c-37ea-8439-75194735bcc7",
                                                "text": "It was inevitable that such a system should lead to the wide use of nicknames to distinguish identically named members of a family[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36bbc59d-311c-3125-9d4a-c0491977d7e5",
                                        "entry_id": "44e3fff1-affa-3e46-ba8d-94db2a3864af",
                                        "glosses": [
                                            "In terms of an identity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdf6e97-d597-4210-9ad8-99c243089563",
                                                "sense_id": "36bbc59d-311c-3125-9d4a-c0491977d7e5",
                                                "text": "two expressions that are identically equal to each other"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f95d4b27-194c-4cbd-854c-3df2314b416b",
                        "source_entry_id": "29b1a926-aead-3568-a63d-dd7a778bb37f",
                        "target_lang_word": "even",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "even",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71366570-9d37-3e56-b27e-2a75b12a9001",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Flat and level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb70859f-9629-415b-bc54-671d7c4a78ac",
                                                "sense_id": "71366570-9d37-3e56-b27e-2a75b12a9001",
                                                "text": "Clear out those rocks. The surface must be even."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33683a2e-f5a4-31fa-92c3-4a1eca9bdc75",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Without great variation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa3a236-7c6f-4335-920b-df7284e48110",
                                                "sense_id": "33683a2e-f5a4-31fa-92c3-4a1eca9bdc75",
                                                "text": "Despite her fear, she spoke in an even voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb38b9ec-5298-3519-98bc-c2272f70d05e",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Equal in proportion, quantity, size, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc00c755-27a3-44de-b0e4-112083340059",
                                                "sense_id": "cb38b9ec-5298-3519-98bc-c2272f70d05e",
                                                "text": "The distribution of food must be even."
                                            },
                                            {
                                                "example_id": "4363e70f-6b89-444c-83dd-4e5f788be965",
                                                "sense_id": "cb38b9ec-5298-3519-98bc-c2272f70d05e",
                                                "text": "Call it even."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "524a8599-67bf-3d5b-9957-922fa71ebe5f",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Divisible by two."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa03107d-291d-41d0-9de4-0bea93b7ca25",
                                                "sense_id": "524a8599-67bf-3d5b-9957-922fa71ebe5f",
                                                "text": "Four, fourteen and forty are even numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2398eb0e-f187-3969-b7b1-c851f28f3046",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Convenient for rounding other numbers to; for example, ending in a zero."
                                        ],
                                        "tags": [
                                            "of a number"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e73b959-595a-4d65-a618-00f921eaa929",
                                                "sense_id": "2398eb0e-f187-3969-b7b1-c851f28f3046",
                                                "text": "Coles. How many shares have you bought, Mr. Garfinkle?\nGarfinkle. One hundred and ninety-six thousand.[…]\nJorgenson. […] How'd you figure out to buy such an odd amount? Why not two hundred thousand — nice even number. Thought you liked nice even numbers."
                                            },
                                            {
                                                "example_id": "85159490-43f4-4467-a28c-d3109558ca1a",
                                                "sense_id": "2398eb0e-f187-3969-b7b1-c851f28f3046",
                                                "text": "He put me on the scale in my underwear and socks: 82 pounds.[…] I left, humming all day long, remembering that once upon a time my ideal weight had been 84, and now I'd even beaten that. I decided 80 was a better number, a nice even number to be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29db7874-223b-3751-a8c3-a827fe787660",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "On equal monetary terms; neither owing nor being owed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe6e5940-aa19-3718-9909-336d3c1fa14f",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "On equal terms of a moral sort; quits."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f655062-06c6-44c2-a17e-f0ce41a8a409",
                                                "sense_id": "fe6e5940-aa19-3718-9909-336d3c1fa14f",
                                                "text": "You biffed me back at the barn, and I biffed you here—so now we're even."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b54c2c85-6413-37d3-83d1-97582e4a1408",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Parallel; on a level; reaching the same limit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b368f36e-0625-4822-b007-97bf9ef81639",
                                                "sense_id": "b54c2c85-6413-37d3-83d1-97582e4a1408",
                                                "text": "And shall lay thee even with the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ac3b4e-99ef-35dc-97c1-6f964dd6e832",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Without an irregularity, flaw, or blemish; pure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e0935b0-357b-4060-be2f-f70bdad16b04",
                                                "sense_id": "c2ac3b4e-99ef-35dc-97c1-6f964dd6e832",
                                                "text": "I know my life so even."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "668e720e-5547-332b-bb64-5e1b166c79b7",
                                        "entry_id": "5d4283e4-7796-3ca3-96e9-81f766c0e368",
                                        "glosses": [
                                            "Associate; fellow; of the same condition."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b04a11-2ad3-45c3-b8e0-9d6a3d49a1af",
                                                "sense_id": "668e720e-5547-332b-bb64-5e1b166c79b7",
                                                "text": "His even servant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "even",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83e0dbbe-c084-36c1-b78e-87eaa699cfda",
                                        "entry_id": "fcdb32d5-354a-3863-ad26-3769c53781cf",
                                        "glosses": [
                                            "To make flat and level."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19fe6314-9d29-430e-8646-67a42fe6605b",
                                                "sense_id": "83e0dbbe-c084-36c1-b78e-87eaa699cfda",
                                                "text": "We need to even this playing field; the west goal is too low."
                                            },
                                            {
                                                "example_id": "71a00ca6-ccfd-4ae0-807e-51ddcbab9bc5",
                                                "sense_id": "83e0dbbe-c084-36c1-b78e-87eaa699cfda",
                                                "text": "This temple Xerxes evened with the soil."
                                            },
                                            {
                                                "example_id": "18357104-a853-4118-b82b-7600892bbfb2",
                                                "sense_id": "83e0dbbe-c084-36c1-b78e-87eaa699cfda",
                                                "text": "[...] It will now be good to Beat, Roll, and Mow Carpet-walks, and Cammomile; for now the ground is ſupple, and it will even all inequalities: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd74f532-a01c-3567-bd12-6af2bb36a4be",
                                        "entry_id": "fcdb32d5-354a-3863-ad26-3769c53781cf",
                                        "glosses": [
                                            "To equal or equate; to make the same."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b99a8c6-b9b4-42b3-bace-3bf7d01b574b",
                                                "sense_id": "dd74f532-a01c-3567-bd12-6af2bb36a4be",
                                                "text": "The Engliſh Earl [William Longespée the Younger], though he ſtood on the lower ground in point of birth, yet conceived himſelf to even him [Robert I, Count of Artois] in valour and martiall knowledge."
                                            },
                                            {
                                                "example_id": "42d9a647-0031-418d-95bb-2d0a0fe6159c",
                                                "sense_id": "dd74f532-a01c-3567-bd12-6af2bb36a4be",
                                                "text": "“But aside from that,” I continued, “what have I done that you should even me to dogs by such a supposition? I never yet failed a friend, and it’s not likely I’ll begin with you. There are things between us that I can never forget, even if you can.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "570bdb9d-a3dd-3b5e-97d1-577c5fecabda",
                                        "entry_id": "fcdb32d5-354a-3863-ad26-3769c53781cf",
                                        "glosses": [
                                            "To be equal."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a8b1750-1df1-4843-89ca-e2e3f0660b3f",
                                                "sense_id": "570bdb9d-a3dd-3b5e-97d1-577c5fecabda",
                                                "text": "Thrice nine evens twenty seven."
                                            },
                                            {
                                                "example_id": "771aaa73-a891-436e-9d89-5754d4dec8de",
                                                "sense_id": "570bdb9d-a3dd-3b5e-97d1-577c5fecabda",
                                                "text": "A redoubled numbering never eveneth with the first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1782d20e-656f-3f97-8435-d8f2b42b6d51",
                                        "entry_id": "fcdb32d5-354a-3863-ad26-3769c53781cf",
                                        "glosses": [
                                            "To place in an equal state, as to obligation, or in a state in which nothing is due on either side; to balance, as accounts; to make quits."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7ac049f-55f2-458c-877f-d5bceaec1790",
                                                "sense_id": "1782d20e-656f-3f97-8435-d8f2b42b6d51",
                                                "text": "We need to even the score."
                                            },
                                            {
                                                "example_id": "c55a649c-6950-4604-8dc3-ec18ce911425",
                                                "sense_id": "1782d20e-656f-3f97-8435-d8f2b42b6d51",
                                                "text": "Madam, the care I have had to even your\ncontent I wish might be found in the calendar of my\npast endeavours, for then we wound our modesty, and\nmake foul the clearness of our deservings, when of\nourselves we publish them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bef0b87a-9ac4-399b-ba37-eee95cfc2ec6",
                                        "entry_id": "fcdb32d5-354a-3863-ad26-3769c53781cf",
                                        "glosses": [
                                            "To set right; to complete."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1548a997-6f13-3589-8cc0-afd5ac249829",
                                        "entry_id": "fcdb32d5-354a-3863-ad26-3769c53781cf",
                                        "glosses": [
                                            "To act up to; to keep pace with."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa710fdb-61ac-4f45-a1d4-9513e469d648",
                                                "sense_id": "1548a997-6f13-3589-8cc0-afd5ac249829",
                                                "text": "Prithee away,\nThere's more to be considered: but we'll even\nAll that good time will give us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "even",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "075a3f62-e728-35a0-bb67-ca3b4bf7b2b9",
                                        "entry_id": "151935a6-7d7f-3998-919d-c89e85f4a2f8",
                                        "glosses": [
                                            "Exactly, just, fully."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e49be966-5eed-4933-ac15-5f1153f311ee",
                                                "sense_id": "075a3f62-e728-35a0-bb67-ca3b4bf7b2b9",
                                                "text": "You are leaving tonight? — Even so."
                                            },
                                            {
                                                "example_id": "9c689456-6a2a-4148-b05c-fd8c0e076ac7",
                                                "sense_id": "075a3f62-e728-35a0-bb67-ca3b4bf7b2b9",
                                                "text": "This is my commandment, that ye love one another, even as I have loved you."
                                            },
                                            {
                                                "example_id": "80c89656-3dd9-4749-915d-e00a3eddb593",
                                                "sense_id": "075a3f62-e728-35a0-bb67-ca3b4bf7b2b9",
                                                "text": "I fulfilled my instructions even as I had promised."
                                            },
                                            {
                                                "example_id": "dd6acecc-5f5a-4996-97c0-ab8ef4a7353c",
                                                "sense_id": "075a3f62-e728-35a0-bb67-ca3b4bf7b2b9",
                                                "text": "But on the occasion in question, those dents looked deeper, even as his nervous step that morning left a deeper mark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                        "entry_id": "151935a6-7d7f-3998-919d-c89e85f4a2f8",
                                        "glosses": [
                                            "In reality; implying an extreme example in the case mentioned, as compared to the implied reality."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3deeb48-7d70-437c-86b3-9ef1a17f1c84",
                                                "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                                "text": "Even a blind squirrel finds an acorn sometimes."
                                            },
                                            {
                                                "example_id": "fc4ea421-8fb3-49f9-b670-1278f7fec1dd",
                                                "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                                "text": "Did you even make it through the front door?"
                                            },
                                            {
                                                "example_id": "caafed43-8c89-4668-bf91-24b432bd1888",
                                                "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                                "text": "That was before I was even born."
                                            },
                                            {
                                                "example_id": "43f106a7-6647-4610-8f45-b6c7c9c9df1e",
                                                "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                                "text": "He used to drop into my chambers once in a while to smoke, and was first-rate company. When I gave a dinner there was generally a cover laid for him. I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me."
                                            },
                                            {
                                                "example_id": "da5c3e04-e486-42bd-8a21-1fdd7c8c22cb",
                                                "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            },
                                            {
                                                "example_id": "c78db687-f67e-4c4d-9b03-651e0faa09f7",
                                                "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                                "text": "He read the letter aloud. Sophia listened with the studied air of one for whom, even in these days, a title possessed some surreptitious allurement."
                                            },
                                            {
                                                "example_id": "b08c3ad0-96b0-4edb-8dfe-34e97e06ba7b",
                                                "sense_id": "50e5c1ce-215c-31a1-826b-e2066e86bd75",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia. The cheapest way to clear logged woodland is to burn it, producing an acrid cloud of foul white smoke that, carried by the wind, can cover hundreds, or even thousands, of square miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b40779c-a14a-34ca-9a54-1af4fb4c541a",
                                        "entry_id": "151935a6-7d7f-3998-919d-c89e85f4a2f8",
                                        "glosses": [
                                            "Emphasizing a comparative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88e6e3ec-754b-4779-898c-565b6061ca79",
                                                "sense_id": "6b40779c-a14a-34ca-9a54-1af4fb4c541a",
                                                "text": "I was strong before, but now I am even stronger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "428a2211-6075-36b2-840d-ffb3f67e5d9e",
                                        "entry_id": "151935a6-7d7f-3998-919d-c89e85f4a2f8",
                                        "glosses": [
                                            "Signalling a correction of one's previous utterance; rather, that is."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dfe9a04-469a-42c6-8321-10e76bd47724",
                                                "sense_id": "428a2211-6075-36b2-840d-ffb3f67e5d9e",
                                                "text": "My favorite actor is Jack Nicklaus. Jack Nicholson, even."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "even",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35c0c88e-1dc1-3cb5-9d12-848d7db40dfa",
                                        "entry_id": "bb711fbd-78d8-3dc1-b7c9-00e9b2d05270",
                                        "glosses": [
                                            "An even number."
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689bfad8-16ee-481c-871c-a55cff4352d5",
                                                "sense_id": "35c0c88e-1dc1-3cb5-9d12-848d7db40dfa",
                                                "text": "So let's see. There are two evens here and three odds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "even",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b371e5f3-fe45-3ce4-b498-1d3218ccbc21",
                                        "entry_id": "f17a1c66-bef2-3a91-a11d-e0afe72782e4",
                                        "glosses": [
                                            "Evening."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea75897c-525d-47fd-8400-a139b1a9bcd1",
                                                "sense_id": "b371e5f3-fe45-3ce4-b498-1d3218ccbc21",
                                                "text": "We'll meet at even, when the sun is set."
                                            },
                                            {
                                                "example_id": "19f76ef0-e19d-4a03-a5d1-1d2fd79d42ac",
                                                "sense_id": "b371e5f3-fe45-3ce4-b498-1d3218ccbc21",
                                                "text": "Whẽ the evẽ was come they bꝛought vnto hĩ many that were poſſeſſed with devyllꝭ / […]"
                                            },
                                            {
                                                "example_id": "334d36b8-1dbb-4639-b381-8bac6ed93e52",
                                                "sense_id": "b371e5f3-fe45-3ce4-b498-1d3218ccbc21",
                                                "text": "When ſparkling ſtars twire not thou guil'ſt th' eauen."
                                            },
                                            {
                                                "example_id": "cc86be6d-d2e3-41b5-83c4-1874b4f64bf2",
                                                "sense_id": "b371e5f3-fe45-3ce4-b498-1d3218ccbc21",
                                                "text": "And if any mans ſeede of copulation goe out from him, then hee ſhall waſh all his fleſh in water, and bee vncleane vntill the Euen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
