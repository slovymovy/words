                "senses": [
                    {
                        "sense_id": "aa1df488-5629-33b0-b5da-f18d2e1515eb",
                        "entry_id": "18f49096-3b19-3d5a-aebe-088a7fe6132d",
                        "glosses": [
                            "Verschiebung, Änderung von Machtverhältnissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a89c22a-b077-419f-90c0-908cac8d9823",
                                "sense_id": "aa1df488-5629-33b0-b5da-f18d2e1515eb",
                                "text": "„So fand eine Machtverschiebung von den Stammesführern zu religiösen Würdenträgern statt.“"
                            },
                            {
                                "example_id": "d494c54d-e935-42ef-ade4-a1215e21e3d0",
                                "sense_id": "aa1df488-5629-33b0-b5da-f18d2e1515eb",
                                "text": "„Eine grundlegende Machtverschiebung hatte stattgefunden; nie wieder würden sie über ihn herrschen.“"
                            },
                            {
                                "example_id": "df346065-bdd3-4558-a570-4a860b9909ff",
                                "sense_id": "aa1df488-5629-33b0-b5da-f18d2e1515eb",
                                "text": "„Er hatte allerdings auch eine Umstrukturierung des Handels und eine tiefgreifende Machtverschiebung zur Folge, die einer Entmachtung des Oba gleichkam.“"
                            },
                            {
                                "example_id": "ae042e90-9b38-4db4-bfea-b249902bc684",
                                "sense_id": "aa1df488-5629-33b0-b5da-f18d2e1515eb",
                                "text": "„Die eigenen Geschichten der Azteken zeigen hingegen, dass ihnen völlig bewusst war, dass es im politischen Leben nicht um Götter oder deren Forderungen ging, sondern um Machtverschiebungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
