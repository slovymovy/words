                                    {
                                        "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Appât fixé à l'hameçon d'une ligne de pêcheur, destiné à faire mordre le poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "006d8d65-2c1f-4456-90de-c881d94f935e",
                                                "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                                "text": "Le blé est une amorce plus résistante que le chènevis."
                                            },
                                            {
                                                "example_id": "de8e1786-93fa-49e8-82d7-767738401dfb",
                                                "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                                "text": "— Vois, mon frère, dit-il, les ruses de l’ennemi qui nous dévore ! Voilà les amorces avec lesquelles il pêche les âmes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Matière explosive qui sert à enflammer la charge d’un canon, d’un fusil, d’une mine, etc."
                                        ],
                                        "tags": [
                                            "Pyrotechnie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b986293a-94d8-4d35-97b8-46a43856d28a",
                                                "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                                "text": "La voix claquait. Le vieux clignota comme si on lui eût tiré des amorces aux oreilles."
                                            },
                                            {
                                                "example_id": "8b239df1-c3a2-4088-a07e-35a103d28540",
                                                "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                                "text": "Ce sont, répondit un muletier, nos gens qui battent les buissons à la ronde, et brûlent des amorces pour amuser les brigands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e719e039-a96b-329f-a4c5-f8067a9b291e",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Appât, ce qui attire vers quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0679a8d3-60da-4416-913e-d30b2407581f",
                                                "sense_id": "e719e039-a96b-329f-a4c5-f8067a9b291e",
                                                "text": "La gloire a de puissantes amorces pour les grandes âmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9058f56f-0717-370f-8728-82bf5b85b633",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Oligonucléotide qui, hybridé avec une matrice d'acide nucléique, permet à une polymérase de déclencher la synthèse du brin complémentaire."
