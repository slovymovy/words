                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ascher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d48e8b9-6e57-3cd2-8700-2a58b9641705",
                                        "entry_id": "6bb2c0ab-41dd-3141-beb4-19143499068c",
                                        "glosses": [
                                            "flaches Gefäß für Tabakasche sowie für Reste von Zigaretten und Zigarren"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8511fe60-f0a7-4c93-b798-8e865d140496",
                                                "sense_id": "1d48e8b9-6e57-3cd2-8700-2a58b9641705",
                                                "text": "Kannst du mir mal den Ascher reichen?"
                                            },
                                            {
                                                "example_id": "5bfd3546-ecdb-45b0-8b4c-8d7d42c9ccb8",
                                                "sense_id": "1d48e8b9-6e57-3cd2-8700-2a58b9641705",
                                                "text": "„Ich nahm einen Zigarrenstummel aus dem Ascher, brannte ihn an, machte einen Zug und würgte.“"
                                            },
                                            {
                                                "example_id": "352048c9-1131-4f4b-9a66-f07b7553baa2",
                                                "sense_id": "1d48e8b9-6e57-3cd2-8700-2a58b9641705",
                                                "text": "„Ida stieß ihre Zigarette in Ottos vollem Ascher aus, stieß und stieß, obwohl die Glut schon längst erloschen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
