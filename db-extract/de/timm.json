                            {
                                "example_id": "d6f6a192-da24-479d-a2e6-80f64176f663",
                                "sense_id": "2c98914c-418c-347b-be3d-835cc55a7f11",
                                "text": "Frau Timm geht zur Abendschule."
                            },
                            {
                                "example_id": "b300254d-f07c-4559-a7e0-6bbe175ab2bd",
                                "sense_id": "2c98914c-418c-347b-be3d-835cc55a7f11",
                                "text": "Vom Fleiß des kleinen Timm kannst du dir gut eine Scheibe abschneiden."
                            },
                            {
                                "example_id": "46a2e706-09bb-4e67-9b9f-2e0310cb1bef",
                                "sense_id": "2c98914c-418c-347b-be3d-835cc55a7f11",
                                "text": "Herrn Timms Dackel muss zum Tierarzt."
                            },
                            {
                                "example_id": "06108616-76cf-4ff7-9e89-e7bff867a859",
                                "sense_id": "2c98914c-418c-347b-be3d-835cc55a7f11",
                                "text": "Timm senior macht eine Kreuzfahrt auf die Malediven."
                            }
                        ],
