                                "target_senses": [
                                    {
                                        "sense_id": "4f210d7f-485c-3bb5-8a80-f15cc92431b3",
                                        "entry_id": "9a8efd55-961c-36e9-bf73-2a68074bd8da",
                                        "glosses": [
                                            "Nederlands als moedertaal hebbend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce8643a-2f21-416e-bd2f-9e0f3fc4e1f8",
                                                "sense_id": "4f210d7f-485c-3bb5-8a80-f15cc92431b3",
                                                "text": "Het Nederlandstalige deel van België wordt Vlaanderen genoemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ccc63de-fbf2-47b6-aa18-19364e08b197",
                        "source_entry_id": "9a924893-1785-3e1a-a022-ffb6aa42b61c",
