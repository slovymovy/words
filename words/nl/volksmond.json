    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39f532ea-440d-3ace-9dc4-2775b4802313",
                    "sense_definition": "de informele manier waarop iets door de gewone mensen of de lokale bevolking wordt genoemd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taalgebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Erasmusbrug in Rotterdam wordt in de <w>volksmond</w> ook wel De Zwaan genoemd.",
                            "target_lang_translations": {
                                "en": "The Erasmus Bridge in Rotterdam is <w>colloquially</w> known as The Swan."
                            }
                        },
                        {
                            "text": "Hoewel de officiële naam anders is, spreekt men in de <w>volksmond</w> over het witte huis.",
                            "target_lang_translations": {
                                "en": "Although the official name is different, in <w>popular parlance</w> people speak of the white house."
                            }
                        }
                    ],
                    "synonyms": [
                        "populaire benaming",
                        "omgangstaal"
                    ],
                    "antonyms": [
                        "vaktaal",
                        "officiële naam"
                    ],
                    "common_phrases": [
                        "in de volksmond"
                    ],
                    "target_lang_definitions": {
                        "en": "the informal way something is named by ordinary people or the local population"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "popular parlance",
                                "target_lang_sense_clarification": "common way of speaking"
                            },
                            {
                                "target_lang_word": "colloquially",
                                "target_lang_sense_clarification": "informal naming"
                            },
                            {
                                "target_lang_word": "common parlance",
                                "target_lang_sense_clarification": "general public usage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b3fe0c0-23e8-305e-8266-2e7aa0343ae0",
                    "sense_definition": "de taal van het gewone volk in tegenstelling tot de schrijftaal of wetenschappelijke taal",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "taalgebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige uitdrukkingen uit de <w>volksmond</w> zijn uiteindelijk opgenomen in het woordenboek.",
                            "target_lang_translations": {
                                "en": "Some expressions from the <w>vernacular</w> were eventually included in the dictionary."
                            }
                        },
                        {
                            "text": "De <w>volksmond</w> gebruikt vaak kortere en simpelere woorden dan de overheid.",
                            "target_lang_translations": {
                                "en": "The <w>common people</w> often use shorter and simpler words than the government."
                            }
                        }
                    ],
                    "synonyms": [
                        "volkstaal",
                        "vernacular"
                    ],
                    "antonyms": [
                        "standaardtaal",
                        "cultuurtaal"
                    ],
                    "common_phrases": [
                        "volgens de volksmond"
                    ],
                    "target_lang_definitions": {
                        "en": "the language of the common people as opposed to written or scientific language"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vernacular",
                                "target_lang_sense_clarification": "native everyday language"
                            },
                            {
                                "target_lang_word": "folk speech",
                                "target_lang_sense_clarification": "traditional local dialect"
                            },
                            {
                                "target_lang_word": "popular speech",
                                "target_lang_sense_clarification": "language of the masses"
                            }
                        ]
                    }
                }
            ]
        }
