                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5e7be8fe-90f7-4927-944d-619b717e7416",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "irréductibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d555e435-26c8-3afe-9a1d-8be4f5ea0209",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "glosses": [
                            "Se dit d’un oxyde métallique qu’on ne peut ramener à l’état de métal."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b9a3eae-9857-3cdf-8bab-cc7447213faf",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "glosses": [
                            "Se dit des luxations, des fractures ou des hernies qui ne peuvent être réduites."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ab02b4c7-a304-386e-90ce-c6bfb2da610f",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "glosses": [
                            "Qui ne peut pas être simplifiée, en parlant d’une fraction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8472eafd-2855-48ca-b605-fcf3cf40a6c3",
                                "sense_id": "ab02b4c7-a304-386e-90ce-c6bfb2da610f",
                                "text": "La fraction 4/6 n'est pas sous forme irréductible car 4 et 6 ont en plus de 1 le nombre 2 comme diviseur commun. Cette fraction est donc simplifiable et on a : 4/6 = 2×2/2×3 = 2/3 en simplifiant par 2 en haut et en bas."
                            }
                        ]
                    },
                    {
                        "sense_id": "90fe9405-104d-3a45-b551-6b188b4cb967",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "glosses": [
                            "Ce qui ne peut être réduit sous une autre forme plus simple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abbb670b-095a-4dbf-acff-8f2c1f55510d",
                                "sense_id": "90fe9405-104d-3a45-b551-6b188b4cb967",
                                "text": "Équation irréductible."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dd1257e-c9fa-333d-86b4-15ce668d21c8",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "glosses": [
                            "Rente irréductible: dont on ne peut abaisser le taux d'intérêt."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0ffa8916-9996-3ed3-aef9-bf8e4cb7b3b2",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "glosses": [
                            "Qu'on ne peut assimiler ou ramener l'un à l'autre en parlant de choses mises en relation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f852f2d-3c83-4623-b3aa-727d92c0a0e2",
                                "sense_id": "0ffa8916-9996-3ed3-aef9-bf8e4cb7b3b2",
                                "text": "Ce sont deux notions irréductibles l'une à l'autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "glosses": [
                            "Qu’on ne peut vaincre ou faire fléchir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a9cdf8a7-d336-429b-8325-ec2a53591a29",
                                "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                                "text": "Toutefois la pacification des villes ne va pas sans réactions parfois violentes et soudaines de fanatiques irréductibles."
                            },
                            {
                                "example_id": "b36e6bc7-81a9-4846-bce9-cfee66218825",
                                "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                                "text": "Si une chose frappe particulièrement, ces années-ci, lorsqu’on voit se déployer la frange radicale de ceux qui se croient en insurrection contre un Système qu’ils peinent à définir mais qu’ils ne cessent de maudire, c’est la conviction profonde que l’Histoire mettrait en scène un affrontement irréductible entre des forces obscures, agissantes, maléfiques et, de l’autre côté, une résistance composée de guerriers héroïques, déchiffrant à travers l’actualité les signes invisibles aux autres de cette lutte sans merci."
                            },
                            {
                                "example_id": "39c38503-e7ef-444c-816e-bd38f51bad92",
                                "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                                "text": "Le village en Armorique des irréductibles Gaulois d’Astérix"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
