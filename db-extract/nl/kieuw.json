                        "target_lang_word": "gill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6db1e739-8554-3b1f-86ea-80fd8a121453",
                                        "entry_id": "3b18c915-b3c3-3794-adeb-5ff0ebeb1139",
                                        "glosses": [
                                            "A breathing organ of fish and other aquatic animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ff99d3-4c67-4bf3-bf90-eca631d89c18",
                                                "sense_id": "6db1e739-8554-3b1f-86ea-80fd8a121453",
                                                "text": "Fishes […] perform their respiration under water by the gills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ce74e6-7259-3093-9372-795b407bb18b",
                                        "entry_id": "3b18c915-b3c3-3794-adeb-5ff0ebeb1139",
                                        "glosses": [
                                            "A gill slit or gill cover."
                                        ],
                                        "tags": [
                                            "of a fish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84aa709-3f08-4130-9246-50d13aff5159",
                                                "sense_id": "83ce74e6-7259-3093-9372-795b407bb18b",
                                                "text": "Gill nets are designed to catch a fish by the gills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d07a93-3da2-3e94-9d24-7954e05a6698",
                                        "entry_id": "3b18c915-b3c3-3794-adeb-5ff0ebeb1139",
                                        "glosses": [
                                            "One of the radial folds on the underside of the cap of a mushroom, the surface of which bears the spore-producing organs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8cc7334-ac09-34de-a04a-b7a1f2dbeb82",
                                        "entry_id": "3b18c915-b3c3-3794-adeb-5ff0ebeb1139",
                                        "glosses": [
                                            "The fleshy flap that hangs below the beak of a fowl; a wattle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66f0a542-bf93-3e27-be2e-dee9846eb800",
                                        "entry_id": "3b18c915-b3c3-3794-adeb-5ff0ebeb1139",
                                        "glosses": [
                                            "The flesh under or about the chin; a wattle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "556c6917-2739-430d-aa4b-7fe70f79173c",
                                                "sense_id": "66f0a542-bf93-3e27-be2e-dee9846eb800",
                                                "text": "dropsy fills you to the gills"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "176f1b53-3c0d-3880-9adf-76ea898c6d63",
                                        "entry_id": "3b18c915-b3c3-3794-adeb-5ff0ebeb1139",
                                        "glosses": [
                                            "One of the combs of closely ranged steel pins which divide the ribbons of flax fiber or wool into fewer parallel filaments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27e51881-82d5-39b0-a268-4daa1a6e2be8",
                                        "entry_id": "cad50164-5bd5-36a5-ace7-2f1770094480",
                                        "glosses": [
                                            "To remove the gills from a fish as part of gutting and cleaning it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec70e2f-d747-4013-91a1-01a76a14b72e",
                                                "sense_id": "27e51881-82d5-39b0-a268-4daa1a6e2be8",
                                                "text": "As we had fish home in the icebox, when Bill led the fish up alongside, I leaned over the combing, gilled the fish with my fingers, slid out the hook and let go. The bass lay there for a moment, tired from the arch of the rod and the pull of the line."
                                            },
                                            {
                                                "example_id": "6e4d2a11-0d3c-4e57-82db-1ca1f4a203cf",
                                                "sense_id": "27e51881-82d5-39b0-a268-4daa1a6e2be8",
                                                "text": "She gutted and gilled the fish, then scaled it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9924631-52e9-3c86-b741-96221e778ddc",
                                        "entry_id": "cad50164-5bd5-36a5-ace7-2f1770094480",
                                        "glosses": [
                                            "To catch (a fish) in a gillnet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6bdec50-d8c7-4054-9fb1-89b805fcdd4b",
                                                "sense_id": "d9924631-52e9-3c86-b741-96221e778ddc",
                                                "text": "Owing to the peculiar shape of the pompano and the relatively large mesh in the pompano gill nets, the fish are not caught by being actually gilled."
                                            },
                                            {
                                                "example_id": "bddb3531-0e07-47ff-8ea4-427034c6a054",
                                                "sense_id": "d9924631-52e9-3c86-b741-96221e778ddc",
                                                "text": "In cases of very heavy catches the nets may be hauled and stored with the fish still gilled. The fish would then be shaken out on return to the port."
                                            },
                                            {
                                                "example_id": "76f42a43-47d9-4b51-9b7b-ab148b8f4102",
                                                "sense_id": "d9924631-52e9-3c86-b741-96221e778ddc",
                                                "text": "The intention is to gill the fish, so they are usually scared into the net by rowing one boat into the middle of the net circle and banging the oars on the boat bottom or splashing the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60e4ae53-37ee-34fb-9c0d-ddd1598b3621",
                                        "entry_id": "cad50164-5bd5-36a5-ace7-2f1770094480",
                                        "glosses": [
                                            "To be or become entangled in a gillnet."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae361701-91b0-4e93-abb7-49de71410844",
                                                "sense_id": "60e4ae53-37ee-34fb-9c0d-ddd1598b3621",
                                                "text": "Since the fine threads of the net usually are caught under the gill covers of the fish they are said to be \"gilled.\""
                                            },
                                            {
                                                "example_id": "bf379b9f-a77b-4578-af3a-f15ad313c784",
                                                "sense_id": "60e4ae53-37ee-34fb-9c0d-ddd1598b3621",
                                                "text": "Also, when fish gilled there wasn't as much extra twine to tangle in, so they were easier to release from the net."
                                            }
                                        ]
                                    }
                                ]
                            },
