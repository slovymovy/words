                "senses": [
                    {
                        "sense_id": "183815c6-96d1-3ecc-af7f-8b5549fbd79b",
                        "entry_id": "3ef565e8-002c-3a7f-9f57-39a811f813bc",
                        "glosses": [
                            "Donner un caractère extraterritorial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5953de1b-8080-4173-b15b-44231e5fecfd",
                                "sense_id": "183815c6-96d1-3ecc-af7f-8b5549fbd79b",
                                "text": "Endiguer, transférer, extraterritorialiser sont autant de logiques qui repoussent les frontières et institutionnalisent la violation du principe de non-refoulement."
                            },
                            {
                                "example_id": "c8f313c1-9c53-470e-8951-1113417b390c",
                                "sense_id": "183815c6-96d1-3ecc-af7f-8b5549fbd79b",
                                "text": "Mars devient progressivement l’îlot utopique dont l’Humanité a besoin pour s’extraterritorialiser et créer une extension de sa civilisation."
                            }
                        ]
                    }
