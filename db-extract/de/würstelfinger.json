                    {
                        "sense_id": "8ff31d94-9c09-3fe5-a152-efdc52232c6d",
                        "entry_id": "35ead676-e505-3e6c-bd40-8e75ced5aa2c",
                        "glosses": [
                            "dicker, kurzer, ungelenker und plumper Finger"
