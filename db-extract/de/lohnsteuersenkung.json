                        "tags": [],
                        "examples": [
                            {
                                "example_id": "831cab6f-1693-469a-abef-29f668fb999c",
                                "sense_id": "8f944441-f71b-39a1-a3e0-e8d5c4a30442",
                                "text": "„Die Petition wird gemeinsam mit einer am Donnerstag vom ÖGB-Bundesvorstand beschlossenen Resolution für eine rasche Lohnsteuersenkung Mitte November der Bundesregierung übergeben.“"
                            },
                            {
                                "example_id": "65a4c149-6523-4b99-989a-3892d7e9f5b1",
                                "sense_id": "8f944441-f71b-39a1-a3e0-e8d5c4a30442",
                                "text": "„ÖGB-Vize-Präsident Norbert Schnedl betonte, man könne über alles diskutieren, \"aber nicht darüber, dass sich die Arbeitnehmer und Arbeitnehmerinnen die Lohnsteuersenkung selber bezahlen\".“"
                            },
                            {
                                "example_id": "234604f1-7e97-44f7-a6d6-78b215bde1bc",
                                "sense_id": "8f944441-f71b-39a1-a3e0-e8d5c4a30442",
                                "text": "„Der Multi-Millionär und Neos-Unterstützer über die Vorarlberg-Wahl, die Sanktionen und warum nur mit Reformen und Ausgabenkürzungen keine Lohnsteuersenkung finanzierbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
