                    "sense_definition": "Holding a position, office, or land under a superior, often in a feudal system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>beneficiary</w> lords were required to provide military service to the king.",
                            "target_lang_translations": {
                                "ru": "<w>Вассальные</w> лорды были обязаны нести военную службу королю.",
                                "tr": "<w>Bağımlı</w> lordların krala askeri hizmet sunması gerekiyordu."
                            }
                        },
                        {
                            "text": "Historical records describe the <w>beneficiary</w> king as being subordinate to the emperor.",
                            "target_lang_translations": {
                                "ru": "Исторические записи описывают <w>зависимого</w> короля как подчиненного императору.",
                                "tr": "Tarihi kayıtlar, <w>vassal</w> kralı imparatora tabi olarak tanımlar."
                            }
                        }
