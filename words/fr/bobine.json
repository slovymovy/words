                                "de": "Er muss diese Schnur vor Tagesende <w>aufwickeln</w>.",
                                "es": "Hace falta que <w>bobine</w> este cordel antes de que termine la jornada.",
                                "zh": "他必须在今天结束前把这根绳子<w>绕</w>好。"
                            }
                        }
