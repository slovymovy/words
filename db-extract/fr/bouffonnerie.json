                        ]
                    },
                    {
                        "translation_id": "7fc146cf-634a-49e1-ba4c-b2ad1f15c419",
                        "source_entry_id": "dde1f985-b5b8-3774-8610-991af42fb947",
                        "target_lang_word": "tomfoolery",
