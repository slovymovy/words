            "senses": [
                {
                    "sense_id": "f3cc0f6a-c254-3ab8-9e9d-e17cb5098afd",
                    "sense_definition": "Garder ou serrer fermement dans la main ou dans les bras.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "prehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant <w>tient</w> la main de sa mère pour traverser la rue."
                        },
                        {
                            "text": "Il <w>tenait</w> un parapluie noir pour s'abriter sous la pluie battante."
                        }
                    ],
                    "antonyms": [
                        "lâcher"
                    ],
                    "common_phrases": [
                        "tenir la main",
                        "tenir fermement",
                        "tenir dans ses bras"
                    ]
                },
                {
                    "sense_id": "53d030c6-c32d-3f24-a60f-c456b63770ed",
                    "sense_definition": "Attacher une grande importance ou de l'affection à quelqu'un ou à quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "attachement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>tiens</w> beaucoup à cette montre qui appartenait à mon grand-père."
                        },
                        {
                            "text": "Elle <w>tient</w> à ses amis et fait toujours tout pour les aider."
                        }
                    ],
                    "common_phrases": [
                        "tenir à coeur",
                        "tenir à quelqu'un",
                        "tenir beaucoup à"
                    ]
                },
                {
                    "sense_id": "cd1329fd-b8ae-3f4d-a95b-c1bb802a3364",
                    "sense_definition": "Prendre ou conserver une position corporelle déterminée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande à tous les élèves de se <w>tenir</w> tranquilles."
                        },
                        {
                            "text": "Elle se <w>tient</w> droite sur sa chaise pendant tout le cours."
                        }
                    ],
                    "common_phrases": [
                        "se tenir droit",
                        "se tenir debout",
                        "se tenir assis"
                    ]
                },
                {
                    "sense_id": "d3090a3c-845f-3831-92c8-953db14921fb",
                    "sense_definition": "Accomplir fidèlement une promesse, un contrat ou respecter sa parole.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a promis de venir et il a su <w>tenir</w> sa promesse."
                        },
                        {
                            "text": "Nous devons absolument <w>tenir</w> parole si nous voulons garder leur confiance."
                        }
                    ],
                    "common_phrases": [
                        "tenir parole",
                        "tenir une promesse",
                        "tenir ses engagements"
                    ]
                },
                {
                    "sense_id": "22c25ef0-e21f-3d75-8c98-99f21bc2b265",
                    "sense_definition": "Résister avec fermeté à une pression physique, morale ou militaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la fatigue extrême, les coureurs continuent de <w>tenir</w> bon."
                        },
                        {
                            "text": "Cette vieille table en bois peut encore <w>tenir</w> plusieurs années sans problème."
