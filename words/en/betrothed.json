{
    "word_family": [
        "betroth",
        "betrothal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2251f931-f0c9-3c68-acaa-277708d56488",
                    "sense_definition": "Engaged to be married.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>betrothed</w> couple walked hand in hand through the park.",
                            "target_lang_translations": {
                                "de": "Das <w>verlobte</w> Paar ging Hand in Hand durch den Park.",
                                "tr": "<w>Nişanlı</w> çift parkta el ele yürüdü.",
                                "nl": "Het <w>verloofde</w> stel liep hand in hand door het park."
                            }
                        },
                        {
                            "text": "They were publicly <w>betrothed</w> during the ceremony last weekend.",
                            "target_lang_translations": {
                                "de": "Sie haben sich am vergangenen Wochenende während der Zeremonie öffentlich <w>verlobt</w>.",
                                "tr": "Geçen hafta sonu tören sırasında herkesin önünde <w>nişanlandılar</w>.",
                                "nl": "Ze zijn afgelopen weekend tijdens de ceremonie publiekelijk <w>verloofd</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "engaged",
                        "affianced"
                    ],
                    "common_phrases": [
                        "betrothed couple"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem versprochen, um ihn zu heiraten; verlobt.",
                        "tr": "Evlenmek üzere sözlenmiş, nişanlı.",
                        "nl": "Verloofd om te trouwen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlobt",
                                "target_lang_sense_clarification": "Adjektiv, das den Beziehungsstatus beschreibt."
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nişanlı",
                                "target_lang_sense_clarification": "Evlilik yolunda söz kesilmiş kişi."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verloofd",
                                "target_lang_sense_clarification": "Adjectief dat de relatiestatus beschrijft."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d809d2c2-44f7-36c6-ad45-d68a9b9d4077",
                    "sense_definition": "A person to whom one is engaged to be married.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She proudly introduced him to her parents as her <w>betrothed</w>.",
                            "target_lang_translations": {
                                "de": "Sie stellte ihn ihren Eltern stolz als ihren <w>Verlobten</w> vor.",
                                "tr": "Onu ailesine gururla <w>nişanlısı</w> olarak tanıttı.",
                                "nl": "Ze stelde hem trots aan haar ouders voor als haar <w>verloofde</w>."
                            }
                        },
                        {
                            "text": "He bought a beautiful ring for his <w>betrothed</w> before the wedding.",
                            "target_lang_translations": {
                                "de": "Er kaufte vor der Hochzeit einen wunderschönen Ring für seine <w>Verlobte</w>.",
                                "tr": "Düğünden önce <w>nişanlısı</w> için güzel bir yüzük aldı.",
                                "nl": "Hij kocht voor de bruiloft een prachtige ring voor zijn <w>verloofde</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiancé",
                        "fiancée"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, mit der man verlobt ist.",
                        "tr": "Evlenmek üzere sözleşilen kişi, nişanlı.",
                        "nl": "Een persoon met wie men verloofd is."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verlobter",
                                "target_lang_sense_clarification": "Männliche Person, mit der man verlobt ist."
                            },
                            {
                                "target_lang_word": "Verlobte",
                                "target_lang_sense_clarification": "Weibliche Person, mit der man verlobt ist."
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nişanlı",
                                "target_lang_sense_clarification": "Evlenmek üzere sözleşilen kişi."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verloofde",
                                "target_lang_sense_clarification": "Zelfstandig naamwoord voor de persoon met wie men verloofd is."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5da75549-55a0-3e29-98a5-8cb303682a6f",
                    "sense_definition": "Simple past and past participle of <w>betroth</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young woman was <w>betrothed</w> to a wealthy merchant by her father.",
                            "target_lang_translations": {
                                "de": "Die junge Frau wurde von ihrem Vater einem wohlhabenden Kaufmann <w>versprochen</w>.",
                                "tr": "Genç kadın, babası tarafından zengin bir tüccarla <w>nişanlandırıldı</w>.",
                                "nl": "De jonge vrouw werd door haar vader <w>toegezegd</w> aan een rijke koopman."
                            }
                        },
                        {
                            "text": "They had been <w>betrothed</w> since childhood according to local tradition.",
                            "target_lang_translations": {
                                "de": "Sie waren nach lokaler Tradition schon seit ihrer Kindheit <w>verlobt</w>.",
                                "tr": "Yerel geleneğe göre çocukluklarından beri <w>nişanlıydılar</w>.",
                                "nl": "Ze waren volgens de lokale traditie al sinds hun kindertijd <w>verloofd</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Verlobung eingehen oder jemandem versprechen.",
                        "tr": "Nişanlanmış veya evlilik için söz verilmiş.",
                        "nl": "De verloving aangaan of iemand beloven te trouwen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlobt",
                                "target_lang_sense_clarification": "Partizip II des Verbs 'verloben'."
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nişanlanmış",
                                "target_lang_sense_clarification": "Nişanlanma eyleminin gerçekleşmiş hali."
                            },
                            {
                                "target_lang_word": "sözlenmiş",
                                "target_lang_sense_clarification": "Evlilik için söz verilmiş olma durumu."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verloofd",
                                "target_lang_sense_clarification": "Voltooid deelwoord van het werkwoord 'verloven'."
                            },
                            {
                                "target_lang_word": "toegezegd",
                                "target_lang_sense_clarification": "Iemand formeel beloofd als huwelijkspartner."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}