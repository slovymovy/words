                "senses": [
                    {
                        "sense_id": "aebbb567-0d3b-3c9b-a9de-0523479c149e",
                        "entry_id": "c8e7a01f-ac63-37a9-b408-c2d9f2ea6ebe",
                        "glosses": [
                            "Kuchen, der mit Kürbis zubereitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e0cf3a-6124-4d5d-b546-293490f14ec3",
                                "sense_id": "aebbb567-0d3b-3c9b-a9de-0523479c149e",
                                "text": "„Ich checke sie ab, und sie riecht gut, wie ein Dessert, wie ein gebackener Kuchen, wie ein Kürbiskuchen mit diesen rotbraunen Gewürzen obendrauf.“"
                            },
                            {
                                "example_id": "d4db9c36-627a-4ad2-8666-d456586aa93d",
                                "sense_id": "aebbb567-0d3b-3c9b-a9de-0523479c149e",
                                "text": "„Er beschrieb, wie er seine neue Testperson über einem Stück Kürbiskuchen verführte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
