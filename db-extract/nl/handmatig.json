                "senses": [
                    {
                        "sense_id": "ec9b57af-88a6-33a2-a924-06477f7d4106",
                        "entry_id": "ce7ba0f1-1e9d-35f2-a4eb-ed76f8ba68b8",
                        "glosses": [
                            "met de hand, met vooral menselijke inspanning in plaats van apparaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a275e6-2ff2-4585-9aa9-dd7536f7cd76",
                                "sense_id": "ec9b57af-88a6-33a2-a924-06477f7d4106",
                                "text": "Daar staat echter tegenover dat deze harde vloeren ongeschikt waren voor handmatig dorsen."
                            },
                            {
                                "example_id": "29197d8d-0091-4c39-8c6c-2dd3119d4df2",
                                "sense_id": "ec9b57af-88a6-33a2-a924-06477f7d4106",
                                "text": "(…) vanaf heden zijn ongeveer 40 sigarenmakers (…) uitsluitend 's morgens van 7.30—12 uur te werk gesteld, terwijl het grootste gedeelte 48 uur blijft werken en wel de eerste week 48 uur in het handmatig bedrijf (…)"
                            },
                            {
                                "example_id": "cdef4108-eb41-473c-88cc-a33fdc54ad39",
                                "sense_id": "ec9b57af-88a6-33a2-a924-06477f7d4106",
                                "text": "Veel andere hikers gebruikten de Sawyer Squeeze, waarmee je handmatig het vuile water door een filter moest persen."
                            }
                        ]
                    }
