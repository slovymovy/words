                    {
                        "sense_id": "08f1ef53-00a1-33af-9c82-31d66732b63c",
                        "entry_id": "8c4917b8-aeb4-31bb-99c0-41986be75b4f",
                        "glosses": [
                            "To make or become labile (i.e. unstable)."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ae20e1c3-14f0-4668-adef-40953339f55a",
                                "sense_id": "08f1ef53-00a1-33af-9c82-31d66732b63c",
                                "text": "L. regards the oxidative processes of the body as taking place not as a result of activated O, but rather by means of \"labilized\" H atoms of the proteins of the cells so that they react readily with mol. O₂."
                            },
                            {
                                "example_id": "4c4529f0-11b8-43b6-b8ed-38e94f024238",
                                "sense_id": "08f1ef53-00a1-33af-9c82-31d66732b63c",
                                "text": "[…] in order to labilize the glycosidic bond."
                            },
                            {
                                "example_id": "e00ee5ba-bd3e-4a0e-80d4-cd8c2bff7496",
                                "sense_id": "08f1ef53-00a1-33af-9c82-31d66732b63c",
                                "text": "High trans effect ligands such as H or CO labilize ligands that are trans to themselves."
                            }
                        ]
                    }
