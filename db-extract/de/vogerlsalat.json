                "senses": [
                    {
                        "sense_id": "d172005a-1e96-3f2c-8b0e-fe36f376d025",
                        "entry_id": "f79461cb-b924-36f8-b40c-12433aa76399",
                        "glosses": [
                            "die Pflanzengattung Valerianella"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "38ffe675-7656-423e-848e-05aec270fdad",
                                "sense_id": "d172005a-1e96-3f2c-8b0e-fe36f376d025",
                                "text": "„Vogerlsalat wächst den ganzen Winter hindurch kontinuierlich, egal wie kalt es ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4845a30f-cc29-47bb-8cf2-54edf5930b1f",
                        "source_entry_id": "f79461cb-b924-36f8-b40c-12433aa76399",
                        "source_sense_id": "d172005a-1e96-3f2c-8b0e-fe36f376d025",
                        "source_sense_description": "Österreich: die Pflanzengattung Valerianella",
                        "target_lang_word": "mâche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mâche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65ab6fc0-c052-3855-ac8d-b92ed51e70ad",
                                        "entry_id": "75ad7f96-56ee-31cd-9fba-440c28cb865f",
                                        "glosses": [
                                            "Nom vulgaire de Valerianella locusta, plante potagère de la famille des Caprifoliaceae (caprifoliacées) que l'on mange en salade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22162623-ce00-4d90-9497-b7c20b8bef6d",
                                                "sense_id": "65ab6fc0-c052-3855-ac8d-b92ed51e70ad",
                                                "text": "La texture plus solide de la mâche, la rend moins facile à digérer ; & dans le fait la mâche ainsi mangée, est indigeste pour beaucoup de sujets."
                                            },
                                            {
                                                "example_id": "05890d5a-ddbf-4f9c-ade0-ff88947e78a7",
                                                "sense_id": "65ab6fc0-c052-3855-ac8d-b92ed51e70ad",
                                                "text": "Résistante au gel, la mâche est une salade d’hiver classique."
                                            },
                                            {
                                                "example_id": "c86d5d48-20e5-4c4f-beae-b87b96dd82c6",
                                                "sense_id": "65ab6fc0-c052-3855-ac8d-b92ed51e70ad",
                                                "text": "Sur les pelouses mornes, les arbres dévastés, en forme de fourche, piquaient le ciel. D’étroites rosaces de plantes vives, semblables à de petites mâches, restaient collées, avec quelques herbes, à la terre nue et gelée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mâche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48b50a6d-799c-3449-8ccc-902f0050bb60",
                                        "entry_id": "f246dc4e-067e-32a4-90bb-bf30451a112e",
                                        "glosses": [
                                            "Tanin du vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a97095-375b-4ba0-a992-25e3a888685e",
                                                "sense_id": "48b50a6d-799c-3449-8ccc-902f0050bb60",
                                                "text": "Avoir de la mâche, être riche en tanin."
                                            },
                                            {
                                                "example_id": "8cf711bc-eb4d-498e-9a7a-5bb3129ed430",
                                                "sense_id": "48b50a6d-799c-3449-8ccc-902f0050bb60",
                                                "text": "C’est la teneur en tanin d'un vin qui détermine l'emploi de certains termes chers aux oenophiles, tels que de la mâche, âpre, astringent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mâche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1877e7b-9dbe-361a-ba1a-a74b7fa92220",
                                        "entry_id": "c2e2b4ab-9a7f-39bd-b514-2e127c37313c",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de mâcher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce46bce0-672f-38fa-8cd8-78d96801bf26",
                                        "entry_id": "c2e2b4ab-9a7f-39bd-b514-2e127c37313c",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de mâcher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05519d08-951b-450e-bea4-c413edc86288",
                                                "sense_id": "ce46bce0-672f-38fa-8cd8-78d96801bf26",
                                                "text": "La journaliste Hélène Goutany ne mâche pas ses mots, pas plus qu’elle ne ménage ses efforts dans les deux épisodes d’enquête qu’elle livre au podcast Programme B."
                                            }
                                        ]
                                    },
                                    {
