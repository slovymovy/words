                ],
                "senses": [
                    {
                        "sense_id": "3773d3de-5bb0-3169-9c90-122162085671",
                        "entry_id": "6db17f94-4117-35c3-a14f-d8a0b8001abe",
                        "glosses": [
                            "Mangel an Geld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0393b1f-a5d8-46c9-96b1-1f5cde696ec5",
                                "sense_id": "3773d3de-5bb0-3169-9c90-122162085671",
                                "text": "Das Bauvorhaben musste aus Geldmangel eingestellt werden."
                            },
                            {
                                "example_id": "bd06e583-12e9-4344-bc38-434ee4542f5e",
                                "sense_id": "3773d3de-5bb0-3169-9c90-122162085671",
                                "text": "„Ihre Gehälter wurden aus Geldmangel pauschal gekürzt, manchmal bei gleicher Arbeitszeit um die Hälfte.“"
                            },
                            {
                                "example_id": "de997d56-2b5b-4a14-99a2-bff504ea3aa0",
                                "sense_id": "3773d3de-5bb0-3169-9c90-122162085671",
                                "text": "„Es herrscht überall Geldmangel.“"
                            },
                            {
                                "example_id": "e667d80e-672d-4e6a-8053-5d0051a6dee0",
                                "sense_id": "3773d3de-5bb0-3169-9c90-122162085671",
                                "text": "„Tughluk litt wie Alauddin zuvor an Geldmangel.“"
                            },
                            {
                                "example_id": "605b0530-2a48-4558-9d5c-fe3ccfd62f6c",
                                "sense_id": "3773d3de-5bb0-3169-9c90-122162085671",
                                "text": "„Ich hatte in vielen armen Gegenden gelebt und war stets wegen Geldmangels an die Luft gesetzt worden, bis ich schließlich auf jenes wacklige Haus in der Rue d'Auseil stieß, das von dem volltrunkenen Blandot unterhalten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
