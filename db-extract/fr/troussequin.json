        "fr-extract.jsonl": [
            {
                "entry_id": "39a2706f-7878-360b-8c37-bb5b252e08a9",
                "word": "troussequin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a40cfe9a-d497-4aa7-8522-b989eb58f9ca",
                        "entry_id": "39a2706f-7878-360b-8c37-bb5b252e08a9",
                        "tags": [
                            "plural"
                        ],
                        "form": "troussequins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa93e987-f203-3867-992a-af68b3b0f280",
                        "entry_id": "39a2706f-7878-360b-8c37-bb5b252e08a9",
                        "glosses": [
                            "Partie postérieure d’une selle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d83346-26f7-488d-ba27-419a306235f5",
                                "sense_id": "aa93e987-f203-3867-992a-af68b3b0f280",
                                "text": "On pourrait faire une monographie singulièrement croustilleuse des chastes dames diaconesses qui roulaient par les hôpitaux dans le troussequin des pasteurs, pour la terrification des damnés qui n’étaient pas de langue allemande."
                            },
                            {
                                "example_id": "de67ee34-a2ba-4268-8fae-bf42bc7ad10d",
                                "sense_id": "aa93e987-f203-3867-992a-af68b3b0f280",
                                "text": "Choqué par le pommeau, puis par le troussequin de la lourde selle mexicaine, je redevins un homme éveillé…"
                            },
                            {
                                "example_id": "ad8e5ea8-cf81-46f1-b475-04b27f582f01",
                                "sense_id": "aa93e987-f203-3867-992a-af68b3b0f280",
                                "text": "Il mit le pied à l’étrier, mais sa main meurtrie empoignait mal l’arcade du troussequin."
                            },
                            {
                                "example_id": "712d9e06-5c5b-4173-af34-6312b4542c36",
                                "sense_id": "aa93e987-f203-3867-992a-af68b3b0f280",
                                "text": "Giuseppe portait le troussequin dans lequel étaient roulés le costume de velours et le manteau d’hiver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce91d014-7390-4c45-9ef9-68fe2839841d",
                        "source_entry_id": "39a2706f-7878-360b-8c37-bb5b252e08a9",
                        "source_sense_id": "aa93e987-f203-3867-992a-af68b3b0f280",
                        "target_lang_word": "troussequin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "13e70f69-72fe-4bb4-9974-18754663606a",
                        "source_entry_id": "39a2706f-7878-360b-8c37-bb5b252e08a9",
                        "source_sense_id": "aa93e987-f203-3867-992a-af68b3b0f280",
                        "target_lang_word": "cantle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "518d7798-e991-31b4-8af0-18d28c64cd85",
                                        "entry_id": "73acc977-eb08-31c5-8b93-fa641ae9ac2a",
                                        "glosses": [
                                            "A splinter, slice, or sliver broken off something."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16085d45-af37-41bc-bec6-6bb79255c006",
                                                "sense_id": "518d7798-e991-31b4-8af0-18d28c64cd85",
                                                "text": "See how this river comes me cranking in, / And cuts me from the best of all my land / A huge half-moon, a monstrous cantle out."
                                            },
                                            {
                                                "example_id": "19784781-c459-4410-b01e-cc7f512361ce",
                                                "sense_id": "518d7798-e991-31b4-8af0-18d28c64cd85",
                                                "text": "Their armors forged were of metal frail; / On every side thereof huge cantles flies; / The land was strewed all with plate and mail, / That on the earth, on that their warm blood lies."
                                            },
                                            {
                                                "example_id": "77441737-59d6-41a4-8c0c-ce2237a75719",
                                                "sense_id": "518d7798-e991-31b4-8af0-18d28c64cd85",
                                                "text": "In one cantle of his law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a92c18-3c42-313c-81ff-383d498fff4c",
                                        "entry_id": "73acc977-eb08-31c5-8b93-fa641ae9ac2a",
                                        "glosses": [
                                            "The raised back of a saddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08424af7-d4c2-4ab3-829a-2411f12f77a1",
                                                "sense_id": "e7a92c18-3c42-313c-81ff-383d498fff4c",
                                                "text": "He recognised a horse when he saw one, and could do more than fill a cantle."
                                            },
                                            {
                                                "example_id": "b052acc1-857b-499d-a59d-3aeb747a6296",
                                                "sense_id": "e7a92c18-3c42-313c-81ff-383d498fff4c",
                                                "text": "Next day, he returned with a camel-saddle of equal beauty, the long brass horns of its cantles adorned with exquisite old Yemeni engraving."
                                            },
                                            {
                                                "example_id": "b2a3f657-f886-4bc8-9d5d-ca338a752d54",
                                                "sense_id": "e7a92c18-3c42-313c-81ff-383d498fff4c",
                                                "text": "The traps were packed in the splitwillow basket that his father wore with the shoulderstraps loosed so that the bottom of the basket carried on the cantle of the saddle behind him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "874f1fdb-02e4-3747-a775-d36a231336ec",
                                        "entry_id": "73acc977-eb08-31c5-8b93-fa641ae9ac2a",
                                        "glosses": [
                                            "The top of the head."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fb577ba-2c1d-3560-a2de-acf572a39c5c",
                                        "entry_id": "73acc977-eb08-31c5-8b93-fa641ae9ac2a",
                                        "glosses": [
                                            "On many styles of sporran, a metal arc along the top of the pouch, usually fronting the clasp."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
