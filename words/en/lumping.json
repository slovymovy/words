{
    "word_family": [
        "lump",
        "lumpy",
        "lumpish",
        "lumpiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b135534-0579-368e-a085-1db46ffd548b",
                    "sense_definition": "The act or result of grouping things together into a single mass or category.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lumping</w> of different species into one genus caused a lot of debate among the biologists.",
                            "target_lang_translations": {
                                "ru": "<w>Объединение</w> различных видов в один род вызвало множество споров среди биологов."
                            }
                        },
                        {
                            "text": "The systems called descriptive have fewer such <w>lumpings</w> than the older classification methods.",
                            "target_lang_translations": {
                                "ru": "Системы, называемые дескриптивными, имеют меньше таких <w>обобщений</w>, чем старые методы классификации."
                            }
                        }
                    ],
                    "synonyms": [
                        "grouping",
                        "clustering",
                        "categorization"
                    ],
                    "antonyms": [
                        "splitting",
                        "separation",
                        "differentiation"
                    ],
                    "common_phrases": [
                        "lumping together",
                        "indiscriminate lumping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или результат объединения вещей в одну массу или категорию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединение",
                                "target_lang_sense_clarification": "в одну группу или категорию"
                            },
                            {
                                "target_lang_word": "группировка",
                                "target_lang_sense_clarification": "смешивание разных элементов вместе"
                            },
                            {
                                "target_lang_word": "сваливание в одну кучу",
                                "target_lang_sense_clarification": "фигурально, без разбора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64da4150-e28e-3e54-9eb4-4fee02530789",
                    "sense_definition": "Present participle and gerund of <w>lump</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>lumping</w> all these different issues into one single problem.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>сваливать</w> все эти разные вопросы в одну проблему."
                            }
                        },
                        {
                            "text": "He is <w>lumping</w> the coal into the corner of the cellar.",
                            "target_lang_translations": {
                                "ru": "Он <w>сваливает</w> уголь в угол подвала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lumping things together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола lump (сваливать в кучу, объединять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливание",
                                "target_lang_sense_clarification": "в одну кучу или массу"
                            },
                            {
                                "target_lang_word": "объединение",
                                "target_lang_sense_clarification": "без учета различий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "db613c36-b9eb-3573-a2d1-1dbc818e30d7",
                    "sense_definition": "Unusually large, heavy, or bulky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to carry a <w>lumping</w> great suitcase up the narrow stairs.",
                            "target_lang_translations": {
                                "ru": "Он пытался затащить <w>здоровенный</w> чемодан по узкой лестнице."
                            }
                        },
                        {
                            "text": "The merchant offered a <w>lumping</w> pennyworth to ensure the deal was closed quickly.",
                            "target_lang_translations": {
                                "ru": "Купец предложил <w>щедрую</w> порцию товара за пенни, чтобы поскорее закрыть сделку."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulky",
                        "heavy",
                        "massive"
                    ],
                    "antonyms": [
                        "slight",
                        "tiny"
                    ],
                    "common_phrases": [
                        "lumping great thing",
                        "lumping pennyworth"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for emphasis with 'great'"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычно большой, тяжелый или громоздкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громоздкий",
                                "target_lang_sense_clarification": "о предмете"
                            },
                            {
                                "target_lang_word": "здоровенный",
                                "target_lang_sense_clarification": "разговорное, о размере"
                            },
                            {
                                "target_lang_word": "тяжеленный",
                                "target_lang_sense_clarification": "о весе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}