                                        "sense_id": "89c5742d-e6a1-3119-98be-7603d7fb2ace",
                                        "entry_id": "7f217610-2f32-3df2-8362-db512c66e13e",
                                        "glosses": [
                                            "Espèce de poisson osseux marin venimeux surtout de l’Indo-Pacifique, aux nageoires pectorales développées comme des ailes, avec des bandes de couleurs différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6439e400-5e05-4b32-9188-dc70ce311242",
                                                "sense_id": "89c5742d-e6a1-3119-98be-7603d7fb2ace",
                                                "text": "N’oublions pas la rascasse volante et ses longues nageoires aux fines épines Platax."
                                            },
                                            {
                                                "example_id": "611fd3f8-0abc-4f1d-9d9c-a7626eaec06f",
                                                "sense_id": "89c5742d-e6a1-3119-98be-7603d7fb2ace",
                                                "text": "Le poisson-lion – aussi appelé rascasse volante – a littéralement envahi la Méditerranée, attaquant avec voracité les espèces de poissons natives, augmentant sa population à une vitesse fulgurante, et se répandant ainsi sur de vastes zones. Sans compter que son espérance de vie atteint les trente ans !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
