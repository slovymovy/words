                        "cross_references": [
                            {
                                "target_word": "ondine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                        "entry_id": "a11609e0-c760-360e-8f3e-fdc4e69b8dff",
                                        "glosses": [
                                            "Génie féminin des eaux dans la mythologie germanique. (Le masculin ondin est beaucoup plus rare.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3e2dfc-3bbc-4c6e-9ab5-c1f70e43145a",
                                                "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                                "text": "Tour à tour ondine ou sylphide, cette fluide créature voltigeait dans les airs."
                                            },
                                            {
                                                "example_id": "9adabc54-1e46-4d3d-a4ff-aa7755306ef3",
                                                "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                                "text": "Ce n’étaient plus un petit bûcheron et une petite pêcheuse, — mais un Sylphe et une Ondine, lesquels, plus tard, furent unis légitimement."
                                            },
                                            {
                                                "example_id": "6f57ff7b-693a-43bb-8f53-0081bd184bf1",
                                                "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                                "text": "Triomphe des êtres fantastiques masculins ! Manifestement les sirènes et les ondines n’ont guère eu d’influence ! Cependant voici dans la région de Saint-Hubert et de Virton de quoi sauver l’honneur féminin : là, c’est Marie Crochet qui vous attirera dans l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a98e300-a9fa-3614-85f2-2122b3ab2844",
                                        "entry_id": "a11609e0-c760-360e-8f3e-fdc4e69b8dff",
                                        "glosses": [
                                            "Créature mythique représentée avec un torse humain et une queue de poisson ; sirène."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aac3b633-d51e-3142-a8b2-b25da8a553d1",
