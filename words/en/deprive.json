{
    "word_family": [
        "deprivation",
        "deprivable",
        "depriver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c37798ec-68f4-302c-981d-65731e5bb788",
                    "sense_definition": "To prevent someone from having or using something, especially something essential or important.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "taking away",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law might <w>deprive</w> citizens of their basic right to privacy.",
                            "target_lang_translations": {
                                "ru": "Новый закон может <w>лишить</w> граждан их базового права на частную жизнь."
                            }
                        },
                        {
                            "text": "It is cruel to <w>deprive</w> a child of the opportunity to learn and grow.",
                            "target_lang_translations": {
                                "ru": "Жестоко <w>лишать</w> ребенка возможности учиться и расти."
                            }
                        }
                    ],
                    "synonyms": [
                        "bereave"
                    ],
                    "antonyms": [
                        "enrich"
                    ],
                    "common_phrases": [
                        "deprive of sleep",
                        "deprive of rights",
                        "deprive of oxygen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствовать кому-либо в обладании или использовании чего-либо, особенно чего-то важного или необходимого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишать",
                                "target_lang_sense_clarification": "отбирать что-либо или не давать доступа"
                            },
                            {
                                "target_lang_word": "лишить",
                                "target_lang_sense_clarification": "отобрать что-то важное (завершенное действие)"
                            },
                            {
                                "target_lang_word": "отнимать",
                                "target_lang_sense_clarification": "забирать, лишать чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18080684-7e99-3a29-81fe-836c8aa67080",
                    "sense_definition": "To leave desolate or alone, especially by death.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taking away",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden accident <w>deprived</w> the young children of both their parents.",
                            "target_lang_translations": {
                                "ru": "Внезапный несчастный случай <w>лишил</w> маленьких детей обоих родителей."
                            }
                        },
                        {
                            "text": "The war <w>deprived</w> the small village of its entire youth population.",
                            "target_lang_translations": {
                                "ru": "Война <w>лишила</w> маленькую деревню всей ее молодежи."
                            }
                        }
                    ],
                    "synonyms": [
                        "bereave"
                    ],
                    "common_phrases": [
                        "deprived by death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставить в одиночестве или опустошении, особенно в результате смерти близких."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишить",
                                "target_lang_sense_clarification": "оставить без кого-либо вследствие смерти"
                            },
                            {
                                "target_lang_word": "обездолить",
                                "target_lang_sense_clarification": "сделать несчастным, лишив близких или средств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dd330f4-e194-3b29-9e7f-43a72ce0cc55",
                    "sense_definition": "To remove a member of the clergy from their official position or office.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "removal from office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bishop decided to <w>deprive</w> the priest of his living due to the scandal.",
                            "target_lang_translations": {
                                "ru": "Епископ решил <w>лишить</w> священника прихода из-за скандала."
                            }
                        },
                        {
                            "text": "In historical times, the church could <w>deprive</w> a minister of his rank for heresy.",
                            "target_lang_translations": {
                                "ru": "В прежние времена церковь могла <w>лишить</w> служителя сана за ересь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deprive of office"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ecclesiastical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освободить священнослужителя от его официальной должности или сана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишать",
                                "target_lang_sense_clarification": "отбирать сан или должность"
                            },
                            {
                                "target_lang_word": "извергать",
                                "target_lang_sense_clarification": "извергать из сана (церковный термин)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}