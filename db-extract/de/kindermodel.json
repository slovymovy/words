                "senses": [
                    {
                        "sense_id": "efef49c4-553f-30d5-b42a-4df3dd3595ae",
                        "entry_id": "356817fa-bd2b-3e0b-94cc-b74ebc977e05",
                        "glosses": [
                            "minderjährige Person, die für Werbezwecke abgebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06ebd54-c711-4f5a-b517-03b315d7d640",
                                "sense_id": "efef49c4-553f-30d5-b42a-4df3dd3595ae",
                                "text": "„Der französische Modeversand La Redoute hat auf seiner Internetseite ein Foto mit vier Kindermodels am Strand veröffentlicht.“"
                            },
                            {
                                "example_id": "19623388-03a7-465e-9718-f542ea246369",
                                "sense_id": "efef49c4-553f-30d5-b42a-4df3dd3595ae",
                                "text": "„Unter Tränen entschuldigte sich der nicht vorbestrafte, ledige Angeklagte bei den Opfern. Diese hatte er in den vergangenen zwei Jahren als Fotograf von Kindermodels angelockt.“"
                            },
                            {
                                "example_id": "02a51e67-f83b-499e-bdc8-1458c08bcacd",
                                "sense_id": "efef49c4-553f-30d5-b42a-4df3dd3595ae",
                                "text": "„Sie hat schon mit sieben als Kindermodel für Werbefotos posiert.“"
                            },
                            {
                                "example_id": "b99e44f2-b9b5-4924-a8ce-fd032b47fb27",
                                "sense_id": "efef49c4-553f-30d5-b42a-4df3dd3595ae",
                                "text": "„Im Alter von zwei wurde er erstmals als Kindermodel gebucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4993f87f-97df-39c3-9ec7-528f5ee60f15",
                        "entry_id": "356817fa-bd2b-3e0b-94cc-b74ebc977e05",
                        "glosses": [
                            "minderjährige Person, die bei Modeschauen Kleidung vorführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf068634-4eac-4626-8d57-81356623e225",
                                "sense_id": "4993f87f-97df-39c3-9ec7-528f5ee60f15",
                                "text": "„Im Alter von zwei wurde er erstmals als Kindermodel gebucht.“"
                            },
                            {
                                "example_id": "b2f1a63b-ca03-4c53-a2ac-cee15099a28e",
                                "sense_id": "4993f87f-97df-39c3-9ec7-528f5ee60f15",
                                "text": "„Auch das italienische Modehaus Laura Biagiotti schickt dort aufgebrezelte Kindermodels über den ‚Cakewalk‘, wie der Miniaturlaufsteg scherzhaft genannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
