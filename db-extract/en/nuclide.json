                                        "glosses": [
                                            "bestimmte Ausprägung eines Atoms, die durch die Zusammensetzung seines Kerns beschrieben werden kann (durch die Anzahl Protonen und Neutronen)"
                                        ],
                                        "tags": [
                                            "Atomphysik"
                                        ],
                                        "examples": [
                                            {
