                    {
                        "translation_id": "95152efd-5f52-4a74-961a-d5394005bca2",
                        "source_entry_id": "0dad930e-41e4-3b25-a26f-4da8b3e281c7",
                        "source_sense_id": "b5e05166-202f-33d4-91bd-466d371de31a",
                        "target_lang_word": "Draperie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Draperie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2722015-f1d6-3f8c-8613-ecf227b9e89c",
                                        "entry_id": "4c9e929e-2eba-35fc-a7c7-a519014710d0",
                                        "glosses": [
                                            "dekorative Anordnung von Stoffen oder Gewändern in Falten"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15dce3b-7e3e-4421-a83d-dd2ff4627731",
                                                "sense_id": "d2722015-f1d6-3f8c-8613-ecf227b9e89c",
                                                "text": "Unter dem Wort Draperie begreift man alles, was die Kunst von Bekleidung des Nackenden der Figuren und von gebrochenen Gewändern lehret."
                                            },
                                            {
                                                "example_id": "ff888024-8c87-4750-9f32-6950ba62848d",
                                                "sense_id": "d2722015-f1d6-3f8c-8613-ecf227b9e89c",
                                                "text": "Von den ältesten Zeugnissen der Bildenden Kunst bis hin zur Kunst der Gegenwart ist die Struktur von Stoffen – Faltenwürfe, Plissees, Draperien – ein bedeutender Bestandteil von Gemälden, Fresken, Reliefs und Skulpturen aus Holz, Stein und Bronze."
                                            },
                                            {
                                                "example_id": "8844124a-b06d-4f56-a0f6-269db89002b6",
                                                "sense_id": "d2722015-f1d6-3f8c-8613-ecf227b9e89c",
                                                "text": "Im Jahr 1746 gründete Carl Josef Maria Brentano-Cimaroli am Egelsee (Stauweiher eines Seitenarmes der Günz) eine Lionische Drahtzugfabrik zur Herstellung von Gold-, Silber- und Kupferdraht für Borten, Quasten, Draperien und Uniformen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c1e29e6-b7ea-3096-a887-84ae60011556",
                                        "entry_id": "4c9e929e-2eba-35fc-a7c7-a519014710d0",
                                        "glosses": [
                                            "die durch ^([1]) erzielte Stoffdekoration"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8700effa-129c-49bb-b4b4-3156a04beb98",
                                                "sense_id": "9c1e29e6-b7ea-3096-a887-84ae60011556",
                                                "text": "Die Schmalheit der Röcke wurde oft noch durch querliegende Draperien betont."
                                            },
                                            {
                                                "example_id": "34c3e413-a16a-406a-8cd9-f8ca919e36d8",
                                                "sense_id": "9c1e29e6-b7ea-3096-a887-84ae60011556",
                                                "text": "Der rechte Seitenaltar birgt in der mit Draperien und einem Baldachin verzierten Mittelnische eine Muttergottesfigur aus der Mitte des 17. Jahrhunderts."
                                            },
                                            {
                                                "example_id": "77f56804-49c4-4dd4-a58b-ae1b50e77eaf",
                                                "sense_id": "9c1e29e6-b7ea-3096-a887-84ae60011556",
                                                "text": "Rigaud unterhielt ein umfangreiches Atelier, mit Spezialisten für bestimmte Bildteile wie Hintergründe, Draperien oder Blumenwerk, das in fast industrieller Manier Bildnisse produzierte, die oftmals nur wenige Pinselstriche von der Hand Rigauds aufweisen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "073b071e-3b15-3148-9b51-d1ed63027d2d",
                                        "entry_id": "4c9e929e-2eba-35fc-a7c7-a519014710d0",
                                        "glosses": [
                                            "strahlenförmiges Nordlicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a27312de-4017-49e1-844d-687c0b098c10",
                                                "sense_id": "073b071e-3b15-3148-9b51-d1ed63027d2d",
                                                "text": "Von den Bändern mit Streifenstruktur gibt es alle Übergänge zu Draperien, welche, wie der Name besagt, Vorhängen gleich, gewissermaßen aus dem Nichts des Himmelsgewölbes immer mehr an Stoffdichte zunehmend, herniederwallen und mit ihren mehr oder weniger senkrecht gestreiften Volants den Raum durchfluten, um sich an ihren Enden ab und zu spiralig einzurollen."
                                            },
                                            {
                                                "example_id": "e3ef554a-baac-4d61-85ac-1c92fb3d0f3d",
                                                "sense_id": "073b071e-3b15-3148-9b51-d1ed63027d2d",
                                                "text": "Draperien reichen ab und zu in polnahen Gebieten bis 44 km herab."
                                            },
                                            {
                                                "example_id": "c5413232-6991-4196-bb8a-962f4954ab70",
                                                "sense_id": "073b071e-3b15-3148-9b51-d1ed63027d2d",
                                                "text": "Ihre Lichtintensität ist bei zunehmender Steighöhe beträchtlich und übertrifft die von Draperien."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
