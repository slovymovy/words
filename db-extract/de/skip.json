                        "cross_references": [
                            {
                                "target_word": "skip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e223a0-42b1-3cbc-bc6f-7650f086c9f4",
                                        "entry_id": "c8f86c99-dab4-3fef-b5e4-fe671919f291",
                                        "glosses": [
                                            "To move by hopping on alternate feet."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "526f9d02-7fb5-42c6-b294-b86d4480a6c0",
                                                "sense_id": "12e223a0-42b1-3cbc-bc6f-7650f086c9f4",
                                                "text": "She will skip from one end of the sidewalk to the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a123958-e950-35fb-96a4-4df7a7547572",
                                        "entry_id": "c8f86c99-dab4-3fef-b5e4-fe671919f291",
                                        "glosses": [
                                            "To leap about lightly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b86e2f-fb1d-4c2f-b3f9-907706f74b3a",
                                                "sense_id": "1a123958-e950-35fb-96a4-4df7a7547572",
                                                "text": "The lamb thy riot dooms to bleed to-day, / Had he thy reason, would he skip and play?"
                                            },
                                            {
                                                "example_id": "a58ae37e-56ec-4d2c-9755-9860d289ea5c",
                                                "sense_id": "1a123958-e950-35fb-96a4-4df7a7547572",
                                                "text": "So she drew her mother away skipping, dancing, and frisking fantastically."
                                            },
                                            {
                                                "example_id": "0de668d4-11e8-4722-900f-ff39af269882",
                                                "sense_id": "1a123958-e950-35fb-96a4-4df7a7547572",
                                                "text": "The hosts maintained their discipline and shape, even threatening to grab a second goal on the break - left-back Dan Harding made a scintillating run, skipping past a few challenges before prodding a right-footed shot that did not match his build-up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294f3e2b-9f4e-3d59-81cd-c75b53a21328",
                                        "entry_id": "c8f86c99-dab4-3fef-b5e4-fe671919f291",
                                        "glosses": [
                                            "To skim, ricochet or bounce over a surface."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b4c0a69-dc06-47c3-a935-e9efdb8d7623",
                                                "sense_id": "294f3e2b-9f4e-3d59-81cd-c75b53a21328",
                                                "text": "The rock will skip across the pond."
                                            },
                                            {
                                                "example_id": "0c1853a1-fbc4-4edd-a381-e424b39636f9",
                                                "sense_id": "294f3e2b-9f4e-3d59-81cd-c75b53a21328",
                                                "text": "After Essien's poor attempt flew into the stands, Rodrigo Moreno - Bolton's on-loan winger from Benfica who was making his full Premier League debut - nearly exposed the Blues with a lovely ball for Johan Elmander, but it just skipped away from his team-mate's toes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94dd06b4-380e-39d6-a31e-d442056f0c0b",
                                        "entry_id": "c8f86c99-dab4-3fef-b5e4-fe671919f291",
                                        "glosses": [
                                            "To throw (something), making it skim, ricochet, or bounce over a surface."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79c98f4c-7e51-4d5a-ab07-6da7d34e9164",
                                                "sense_id": "94dd06b4-380e-39d6-a31e-d442056f0c0b",
                                                "text": "I bet I can skip this rock to the other side of the pond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1c69ec-5d34-35eb-8206-1dc68ec8ba69",
                                        "entry_id": "c8f86c99-dab4-3fef-b5e4-fe671919f291",
                                        "glosses": [
                                            "To disregard, miss or omit part of a continuation (some item or stage)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f296f9-46a3-41a6-83c1-c3f0c622353a",
                                                "sense_id": "3f1c69ec-5d34-35eb-8206-1dc68ec8ba69",
                                                "text": "My heart will skip a beat."
                                            },
                                            {
                                                "example_id": "79a96e99-33f2-4594-8afe-a26fbdffb21a",
                                                "sense_id": "3f1c69ec-5d34-35eb-8206-1dc68ec8ba69",
                                                "text": "He skipped the second question and moved on."
                                            },
                                            {
                                                "example_id": "7e67ee03-45ba-46d0-9667-cccfaac60d30",
                                                "sense_id": "3f1c69ec-5d34-35eb-8206-1dc68ec8ba69",
                                                "text": "I will read most of the book, but skip the first chapter because the video covered it."
                                            },
                                            {
                                                "example_id": "4eeb4468-ab79-417e-a26c-878028a3cb6d",
                                                "sense_id": "3f1c69ec-5d34-35eb-8206-1dc68ec8ba69",
                                                "text": "1684-1690, Thomas Burnet, Sacred Theory of the Earth\nBut they who have not this doubt, and have a mind to see the issue of the Theory, may skip these two Chapters, if they please, and proceed to the following"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a6d15a5-36b5-3985-b13f-f6547db2e947",
                                        "entry_id": "c8f86c99-dab4-3fef-b5e4-fe671919f291",
                                        "glosses": [
                                            "Not to attend (some event, especially a class or a meeting)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e5e30f-d042-48a8-8819-2786fc6ac34e",
                                                "sense_id": "6a6d15a5-36b5-3985-b13f-f6547db2e947",
                                                "text": "Yeah, I really should go to the quarterly meeting but I think I'm going to skip it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fee54a4-7692-3b21-96e4-581d6bb873c8",
                                        "entry_id": "c8f86c99-dab4-3fef-b5e4-fe671919f291",
                                        "glosses": [
                                            "To leave, especially in a sudden and covert manner."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69a9e70-5890-45b3-98ff-ac1ddfaf069e",
                                                "sense_id": "5fee54a4-7692-3b21-96e4-581d6bb873c8",
                                                "text": "to skip the country"
                                            },
                                            {
                                                "example_id": "dd8d603b-52dc-4262-9d72-9cfd0ea05194",
