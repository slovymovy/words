                ],
                "senses": [
                    {
                        "sense_id": "f8e4523b-e855-39e1-8d6c-323892a5256c",
                        "entry_id": "c6e8dcbd-f4ce-3250-8392-14f82ee7ef73",
                        "glosses": [
                            "auf traditionellen Bräuchen basierende Spielform, oft magischen oder religiösen Ursprungs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169c3a64-5947-42cb-be64-15f8061e9218",
                                "sense_id": "f8e4523b-e855-39e1-8d6c-323892a5256c",
                                "text": "„Aber auch die eigene Phantasiewelt der Kinder ist […] als wichtiger Lieferant von Spieleinfällen zu nennen: Gespensterspiele, Ritualspiele, Visionsspiele, Zauberspiele.“"
                            },
                            {
                                "example_id": "c6b9f234-111d-447c-8fd9-ee23afeadfe0",
                                "sense_id": "f8e4523b-e855-39e1-8d6c-323892a5256c",
                                "text": "„Bereits auf minoischen Wandfresken aus Knossos und Phaistos vermögen wir Ritualspiele, Tänze und mimische Bewegungen zu erkennen.“"
                            },
                            {
                                "example_id": "3d8bcb45-cfad-4495-99e0-e0cebeaca302",
                                "sense_id": "f8e4523b-e855-39e1-8d6c-323892a5256c",
                                "text": "„Wir einigen uns darauf, daß dieses Ritualspiel zu Klischees herausfordere, für die man niemanden verantwortlich machen kann.“"
                            },
                            {
                                "example_id": "859214ba-4a3c-4bba-b776-ad8e7b80cbc6",
                                "sense_id": "f8e4523b-e855-39e1-8d6c-323892a5256c",
                                "text": "„So muß denn die Frage, in welcher Zeit das Ritualspiel im Verlauf einer Beisetzung aufgeführt wurde, folgendermaßen beantwortet werden: Es kann sich nur um die Zeit vor der 5. Dynastie handeln, in der das Ritualspiel seinen festen Platz im Bestattungsverlauf gehabt haben dürfte.“"
                            },
                            {
                                "example_id": "8a67995f-63a7-410c-af68-1a934198c90f",
                                "sense_id": "f8e4523b-e855-39e1-8d6c-323892a5256c",
                                "text": "„Ritualspiele bilden eine besonders rigide, autoritäre und statische Form der Vergemeinschaftung, die keinen Spielraum für Veränderung oder individuellen Ausdruck läßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
