                                    },
                                    {
                                        "sense_id": "54d9d686-0ab5-372f-b44b-392054134a91",
                                        "entry_id": "6603920a-f9c2-3580-acb3-64c1fa1dfd46",
                                        "glosses": [
                                            "Entrave de bois."
                                        ],
                                        "tags": [
