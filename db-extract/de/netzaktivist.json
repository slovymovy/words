                "senses": [
                    {
                        "sense_id": "0f0c7ca1-4a13-34a9-9455-eaaef69039fe",
                        "entry_id": "b1aaa3ce-a4b1-3837-8e51-0f2ea4c8bfbd",
                        "glosses": [
                            "Person, die im Internet (politisch) aktiv ist und diese Plattform nutzt, um ein Anliegen bekanntzumachen, Misstände anzuprangern oder Veränderungen durchzusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2becd62-043a-4461-bfc7-4c1c711eece0",
                                "sense_id": "0f0c7ca1-4a13-34a9-9455-eaaef69039fe",
                                "text": "Beileibe nicht jeder, also eigentlich kaum ein Blogger ist Netzaktivist, aber es gibt etliche Bürgerrechtler, Menschenrechtler und Datenschützer, die im Internet für ihre Ideen eintreten und einige dieser Personen sind durchaus Netzaktivisten."
                            },
                            {
                                "example_id": "181a5736-cd83-4d33-9821-3e0f33161336",
                                "sense_id": "0f0c7ca1-4a13-34a9-9455-eaaef69039fe",
                                "text": "„Auf einmal wurden große Debatten zu einem netzpolitischen Problem geführt, über das bisher nur die Unterhaltungsindustrie mit ein paar Netzaktivisten stritt.“"
                            },
                            {
                                "example_id": "a2b94473-d37a-4292-ad0f-fa789c38e2db",
                                "sense_id": "0f0c7ca1-4a13-34a9-9455-eaaef69039fe",
                                "text": "„Die »Filterblase« ist ein Begriff des Netzaktivisten Eli Pariser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
