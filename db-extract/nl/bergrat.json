                        "examples": [
                            {
                                "example_id": "6d473bfa-fd07-4bcc-8caa-bdb0d4e3905e",
                                "sense_id": "88da6d17-8dec-3454-bab2-58c9b5a22933",
                                "text": "Een ongemeen groot mormeldier of bergrat, namelijk, was daags te voren uit de koude, waar het met andere in zijnen winterslaap gedompeld lag, in de warme kamer gebragt, om zijnen warmtegraad te toetsen, Men had dit beest, buiten mijn weten, in eene zeer enge blikken kooi ingesperd, die met eene ijzeren tralie gesloten was, en vergeten, hetzelve weder naar buiten in de koude te brengen."
                            }
                        ]
                    }
