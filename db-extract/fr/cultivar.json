                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ff4e7652-f59e-4477-b067-f395e28c3d4c",
                        "source_entry_id": "c65d68f4-7cde-3509-8a7a-bd9c82be9629",
                        "source_sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
                        "source_sense_description": "cultivar",
                        "target_lang_word": "Kulturvarietät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "621393ec-f2a7-4118-8c28-881353f15031",
                        "source_entry_id": "c65d68f4-7cde-3509-8a7a-bd9c82be9629",
                        "source_sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
                        "source_sense_description": "cultivar",
                        "target_lang_word": "Varietät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Varietät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb0243e2-c30c-3a5e-b7f8-415efd040979",
                                        "entry_id": "d8d8db21-11b9-3bbc-9ab4-8c2f24d8584e",
                                        "glosses": [
                                            "Gruppe von Individuen einer Art, die sich genetisch geringfügig von anderen Individuen ihrer Art unterscheiden, die aber nicht wie eine Subspezies ein eigenes Areal einnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c625384b-bd19-47bc-bb24-28c81944642a",
                                                "sense_id": "eb0243e2-c30c-3a5e-b7f8-415efd040979",
                                                "text": "„Welche Varietät findet Ihr bei den Koi am schönsten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "833d0c98-9e9e-3acc-81b7-7b4eed088bdf",
                                        "entry_id": "d8d8db21-11b9-3bbc-9ab4-8c2f24d8584e",
                                        "glosses": [
                                            "Begriff für die verschiedenen lokalen, sozialen, temporalen Erscheinungsformen einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa788b5a-5736-4fc9-b0f6-6f295efef5ba",
                                                "sense_id": "833d0c98-9e9e-3acc-81b7-7b4eed088bdf",
                                                "text": "Das Moselfränkische ist eine Varietät des Hochdeutschen."
                                            },
                                            {
                                                "example_id": "2a4b9f0e-5f69-4f01-80b6-d504fabe99e6",
                                                "sense_id": "833d0c98-9e9e-3acc-81b7-7b4eed088bdf",
                                                "text": "Die Sprache der Goethezeit ist eine andere Varietät des Deutschen als ihre heutige Form."
                                            },
                                            {
                                                "example_id": "1e55ec18-178d-4fb6-a4d7-e6addcf15d9f",
                                                "sense_id": "833d0c98-9e9e-3acc-81b7-7b4eed088bdf",
                                                "text": "„Unter Heteronymen verstehen wir Dubletten mit identischer Bedeutung, die jedoch aus verschiedenen regionalen Varietäten stammen.“"
                                            },
                                            {
                                                "example_id": "4ef356ab-bd31-4299-87a2-5a243d71a211",
                                                "sense_id": "833d0c98-9e9e-3acc-81b7-7b4eed088bdf",
                                                "text": "„Die Sprachwissenschaft redet von Varietäten (es gibt seit einigen Jahrzehnten eine regelrechte »Varietätenlinguistik«).“"
                                            },
                                            {
                                                "example_id": "ddbec004-9c47-4e51-8c5b-eba4a719e3b9",
                                                "sense_id": "833d0c98-9e9e-3acc-81b7-7b4eed088bdf",
                                                "text": "„Bedauerlicherweise fehlt eine umfassende Bestandsaufnahme des färöischen Verbalsystems und seiner morphologischen Formen, einschließlich der Varietäten in den Dialekten und der Archaismen, wie sie bei traditionellen färöischen Texten bisweilen in Erscheinung treten.“"
                                            },
                                            {
                                                "example_id": "08bda971-b67c-41c8-be5c-62c3e2f8af64",
                                                "sense_id": "833d0c98-9e9e-3acc-81b7-7b4eed088bdf",
                                                "text": "„Dabei sind die jeweiligen Sprachbezeichnungen als Ober- und Sammelbegriffe für verschiedene genetisch verwandte Quellsprachen, ihre Dialekte, Varietäten und historischen Sprachstufen zu verstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
