                "entry_id": "bce157a7-29fe-3dcc-8100-46ff55721e8a",
                "word": "fortitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8a8e1fbd-c067-4cc6-9b6a-7c19718165d6",
                        "entry_id": "bce157a7-29fe-3dcc-8100-46ff55721e8a",
                        "tags": [
