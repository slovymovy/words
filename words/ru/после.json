{
    "word_family": [
        "последующий",
        "последовать",
        "последователь",
        "последовательность"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "2db7d20f-fbb5-3570-a539-e5562472a1fe",
                    "sense_definition": "указывает на время, следующее за каким-либо событием",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретимся <w>после</w> работы.",
                            "target_lang_translations": {
                                "nl": "We spreken af <w>na</w> het werk."
                            }
                        },
                        {
                            "text": "Он пришел <w>после</w> обеда.",
                            "target_lang_translations": {
                                "nl": "Hij kwam <w>na</w> de lunch."
                            }
                        }
                    ],
                    "synonyms": [
                        "за"
                    ],
                    "antonyms": [
                        "до",
                        "перед"
                    ],
                    "common_phrases": [
                        "после обеда",
                        "после работы"
                    ],
                    "target_lang_definitions": {
                        "nl": "geeft een tijdstip aan dat volgt op een gebeurtenis"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "na",
                                "target_lang_sense_clarification": "geeft aan dat iets in tijd volgt op een gebeurtenis"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3d37e90a-1487-3e90-99d2-f041c232eff6",
                    "sense_definition": "в будущем, спустя некоторое время",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я занят сейчас, поговорим <w>после</w>.",
                            "target_lang_translations": {
                                "nl": "Ik ben nu bezig, we praten <w>daarna</w> wel verder."
                            }
                        },
                        {
                            "text": "Сначала сделай уроки, а <w>после</w> иди гулять.",
                            "target_lang_translations": {
                                "nl": "Maak eerst je huiswerk en ga <w>daarna</w> buiten spelen."
                            }
                        }
                    ],
                    "synonyms": [
                        "потом",
                        "позже",
                        "позднее"
                    ],
                    "antonyms": [
                        "раньше",
                        "прежде"
                    ],
                    "target_lang_definitions": {
                        "nl": "in de toekomst, na verloop van tijd"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "daarna",
                                "target_lang_sense_clarification": "verwijst naar een tijdstip in de toekomst"
                            },
                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "op een later moment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                    "sense_definition": "по окончании чего-либо, вслед за кем-то или чем-то",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретимся <w>после</w> занятий в университете.",
                            "target_lang_translations": {
                                "nl": "We spreken af <w>na</w> de lessen aan de universiteit."
                            }
                        },
                        {
                            "text": "Он зашел в комнату <w>после</w> всех остальных.",
                            "target_lang_translations": {
                                "nl": "Hij kwam de kamer binnen <w>na</w> alle anderen."
                            }
                        }
                    ],
                    "synonyms": [
                        "вслед за",
                        "по окончании",
                        "по завершении"
                    ],
                    "common_phrases": [
                        "после занятий"
                    ],
                    "target_lang_definitions": {
                        "nl": "bij het beëindigen van iets, of volgend op iemand of iets in een reeks"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "na",
                                "target_lang_sense_clarification": "volgend in tijd of volgorde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af4e1403-ed7a-3477-b759-47503bc2850b",
                    "sense_definition": "после ухода или смерти кого-либо",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>После</w> него осталась большая библиотека книг.",
                            "target_lang_translations": {
                                "nl": "<w>Na</w> zijn overlijden bleef er een grote boekenbibliotheek achter."
                            }
                        },
                        {
                            "text": "Многое изменилось в доме <w>после</w> его отъезда.",
                            "target_lang_translations": {
                                "nl": "Er is veel veranderd in huis <w>na</w> zijn vertrek."
                            }
                        }
                    ],
                    "synonyms": [
                        "по уходу"
                    ],
                    "target_lang_definitions": {
                        "nl": "na het vertrek of overlijden van iemand"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "na",
                                "target_lang_sense_clarification": "geeft aan wat er overblijft of gebeurt na iemands vertrek of overlijden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7da2d998-8b36-3b40-84e1-c30214d59ae3",
                    "sense_definition": "форма предложного падежа единственного числа существительного <w>посол</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера в министерстве говорили о <w>после</w>.",
                            "target_lang_translations": {
                                "nl": "Gisteren spraken ze op het ministerie over de ambassadeur."
                            }
                        },
                        {
                            "text": "Многое зависит от <w>после</w> в этой сложной ситуации.",
                            "target_lang_translations": {
                                "nl": "Veel hangt af van de ambassadeur in deze ingewikkelde situatie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "deze vorm is niet van toepassing in het Nederlands; het is een grammaticale verbuiging van het woord 'ambassadeur'"
                    },
                    "translations": {
                        "nl": []
                    }
                }
            ]
        }
    ]
}