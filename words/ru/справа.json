    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dc3e8bfb-fca1-3964-9df9-cc0421b6bf4b",
                    "sense_definition": "С правой стороны, в правой части пространства.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой дом находится <w>справа</w> от парка.",
                            "target_lang_translations": {
                                "de": "Mein Haus befindet sich <w>rechts</w> vom Park.",
                                "nl": "Mijn huis bevindt zich <w>rechts</w> van het park.",
                                "en": "My house is located <w>to the right</w> of the park."
                            }
                        },
                        {
                            "text": "Посмотрите, <w>справа</w> стоит красивая церковь.",
                            "target_lang_translations": {
                                "de": "Schauen Sie, <w>rechts</w> steht eine schöne Kirche.",
                                "nl": "Kijk, <w>rechts</w> staat een mooie kerk.",
                                "en": "Look, <w>on the right</w> stands a beautiful church."
                            }
                        }
                    ],
                    "synonyms": [
                        "по правую руку"
                    ],
                    "antonyms": [
                        "слева"
                    ],
                    "common_phrases": [
                        "справа от"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf der rechten Seite, in der rechten Raumhälfte.",
                        "nl": "Aan de rechterkant, aan de rechterzijde van een ruimte.",
                        "en": "On the right side; in the right-hand part of an area or space."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rechts",
                                "target_lang_sense_clarification": "Bezeichnet die Position oder Richtung auf der rechten Seite."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "rechts",
                                "target_lang_sense_clarification": "aan de rechterzijde van een positie"
                            },
                            {
                                "target_lang_word": "aan de rechterkant",
                                "target_lang_sense_clarification": "aan de rechterzijde"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "on the right",
                                "target_lang_sense_clarification": "located on the right-hand side"
                            },
                            {
                                "target_lang_word": "to the right",
                                "target_lang_sense_clarification": "positioned towards the right side"
                            },
                            {
                                "target_lang_word": "at the right",
                                "target_lang_sense_clarification": "situated on the right side"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60a65b92-efa1-3203-a1ed-b01c9daed81d",
                    "sense_definition": "С направления правой стороны.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Внезапно <w>справа</w> выехала машина.",
                            "target_lang_translations": {
                                "de": "Plötzlich kam <w>von rechts</w> ein Auto angefahren.",
                                "nl": "Plotseling kwam er <w>van rechts</w> een auto aangereden.",
                                "en": "Suddenly, a car pulled out <w>from the right</w>."
                            }
                        },
                        {
                            "text": "Ветер дул <w>справа</w> и мешал идти.",
                            "target_lang_translations": {
                                "de": "Der Wind wehte <w>von rechts</w> und behinderte das Gehen.",
                                "nl": "De wind waaide <w>van rechts</w> en maakte het lopen moeilijk.",
                                "en": "The wind was blowing <w>from the right</w> and made walking difficult."
                            }
                        }
                    ],
                    "antonyms": [
                        "слева"
                    ],
                    "target_lang_definitions": {
                        "de": "Aus der Richtung der rechten Seite kommend.",
                        "nl": "Vanuit de richting van de rechterzijde komend.",
                        "en": "From the direction of the right side."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "von rechts",
                                "target_lang_sense_clarification": "Bezeichnet eine Bewegung oder einen Einfluss, der von der rechten Seite ausgeht."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "van rechts",
                                "target_lang_sense_clarification": "beweging of wind die van de rechterkant komt"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "from the right",
                                "target_lang_sense_clarification": "coming or moving from the right-hand side"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "040a64c9-9754-31bf-a0ee-16d3cca66a1e",
                    "sense_definition": "Дело или работа, связанные с подготовкой чего-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У хозяина всегда найдется какая-нибудь <w>справа</w> по дому.",
                            "target_lang_translations": {
                                "de": "Der Hausherr findet immer irgendeine <w>Arbeit</w> im Haus.",
                                "nl": "De huiseigenaar vindt altijd wel een <w>klus</w> in het huis.",
                                "en": "The master of the house will always find some <w>chore</w> to do around the home."
                            }
                        },
                        {
                            "text": "Всякая <w>справа</w> требует времени и терпения.",
                            "target_lang_translations": {
                                "de": "Jede <w>Aufgabe</w> erfordert Zeit und Geduld.",
                                "nl": "Elke <w>bezigheid</w> vergt tijd en geduld.",
                                "en": "Every <w>task</w> requires time and patience."
                            }
                        }
                    ],
                    "synonyms": [
                        "дело"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Tätigkeit oder Arbeit, die mit der Vorbereitung von etwas verbunden ist (veraltet).",
                        "nl": "Klus of werkzaamheid gerelateerd aan het voorbereiden of regelen van iets (verouderd).",
                        "en": "A chore, task, or preparation work (archaic)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Arbeit",
                                "target_lang_sense_clarification": "(veraltet) Beschäftigung, Vorbereitungsarbeit"
                            },
                            {
                                "target_lang_word": "Aufgabe",
                                "target_lang_sense_clarification": "(veraltet) zu erledigende Sache"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "klus",
                                "target_lang_sense_clarification": "karwei of voorbereidend werk (verouderd)"
                            },
                            {
                                "target_lang_word": "bezigheid",
                                "target_lang_sense_clarification": "werkzaamheid"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "chore",
                                "target_lang_sense_clarification": "household work or preparation task (archaic)"
                            },
                            {
                                "target_lang_word": "task",
                                "target_lang_sense_clarification": "a job or undertaking to be done (archaic)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2bba4c9-c30c-32fc-9100-eb9082658114",
                    "sense_definition": "Совокупность вещей или снаряжение для хозяйства или ремесла.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для охоты нужна была особая <w>справа</w>.",
                            "target_lang_translations": {
                                "de": "Für die Jagd war eine spezielle <w>Ausrüstung</w> erforderlich.",
                                "nl": "Voor de jacht was een speciale <w>uitrusting</w> nodig.",
                                "en": "Special <w>gear</w> was needed for the hunt."
                            }
                        },
                        {
                            "text": "Всякая <w>справа</w> была собрана заранее.",
                            "target_lang_translations": {
                                "de": "Die gesamte <w>Ausrüstung</w> war im Voraus zusammengestellt worden.",
                                "nl": "Al het <w>gerei</w> was van tevoren verzameld.",
                                "en": "All the <w>equipment</w> had been gathered in advance."
                            }
                        }
                    ],
                    "synonyms": [
                        "снаряжение"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее или региональное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Gesamtheit von Ausrüstungsgegenständen für den Haushalt oder ein Handwerk (veraltet/regional).",
                        "nl": "Het geheel van benodigdheden, uitrusting of tuig voor een huishouden of ambacht (verouderd).",
                        "en": "An aggregate of equipment, gear, or furnishings needed for a craft, hunt, or household (archaic/dialectal)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ausrüstung",
                                "target_lang_sense_clarification": "(veraltet) Gerätschaft für Haushalt oder Handwerk"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "uitrusting",
                                "target_lang_sense_clarification": "geheel van benodigdheden of gereedschap (verouderd)"
                            },
                            {
                                "target_lang_word": "gerei",
                                "target_lang_sense_clarification": "werktuigen en toebehoren"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "gear",
                                "target_lang_sense_clarification": "equipment or outfit for a trade or activity (archaic)"
                            },
                            {
                                "target_lang_word": "equipment",
                                "target_lang_sense_clarification": "necessary gear or apparatus (archaic)"
                            },
                            {
                                "target_lang_word": "tackle",
                                "target_lang_sense_clarification": "gear or implements (archaic)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a42979a2-005c-34b4-a4f0-0c552548bf0f",
                    "sense_definition": "Управление или распоряжение делами.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На него была возложена вся <w>справа</w> в деревне.",
                            "target_lang_translations": {
                                "de": "Ihm wurde die gesamte <w>Verwaltung</w> im Dorf übertragen.",
                                "nl": "Het hele <w>bestuur</w> van het dorp was aan hem toevertrouwd.",
                                "en": "All the village <w>administration</w> was entrusted to him."
                            }
                        },
                        {
                            "text": "Никакая <w>справа</w> не могла помочь в этом споре.",
                            "target_lang_translations": {
                                "de": "Keine <w>Verwaltung</w> konnte in diesem Streit helfen.",
                                "nl": "Geen enkel <w>bestuur</w> kon helpen in dit geschil.",
                                "en": "No <w>authority</w> could help settle this dispute."
                            }
                        }
                    ],
                    "synonyms": [
                        "управа"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее или региональное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Verwaltung oder Anordnung von Angelegenheiten (veraltet/regional).",
                        "nl": "Beheer, bestuur of regeling van zaken (verouderd).",
                        "en": "Management, administration, or resolution of affairs (archaic/dialectal)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verwaltung",
                                "target_lang_sense_clarification": "(veraltet) Führung und Regelung der Angelegenheiten"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bestuur",
                                "target_lang_sense_clarification": "beheer of regeling van dorpszaken (verouderd)"
                            },
                            {
                                "target_lang_word": "beheer",
                                "target_lang_sense_clarification": "het regelen van zaken"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "administration",
                                "target_lang_sense_clarification": "management or running of affairs (archaic)"
                            },
                            {
                                "target_lang_word": "management",
                                "target_lang_sense_clarification": "control or settlement of matters (archaic)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
