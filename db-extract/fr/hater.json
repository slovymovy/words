                "senses": [
                    {
                        "sense_id": "d6928a8a-ce75-38b4-b2b7-d6d058ca5844",
                        "entry_id": "9fb9c8c7-450f-3386-92d8-4c1782c10b00",
                        "glosses": [
                            "Propagateur de haine sur les réseaux."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "689040a3-9be2-4d7a-8550-606574fe8e14",
                                "sense_id": "d6928a8a-ce75-38b4-b2b7-d6d058ca5844",
                                "text": "C’est une militante. Ses tenues d’ado – baskets, robes colorées – et sa coupe afro égarent souvent les « haters » qui la vilipendent sur les réseaux sociaux."
                            },
                            {
                                "example_id": "035d1479-b83e-46ee-be83-42635e4ad8fc",
                                "sense_id": "d6928a8a-ce75-38b4-b2b7-d6d058ca5844",
                                "text": "Point de départ d’une carrière dont à peu près tout le monde — on a rarement vu si peu de haters accompagner les débuts d’un sportif aussi médiatisé — fantasme qu’elle marquera l’histoire."
                            },
                            {
                                "example_id": "22b7ad00-f093-492c-9a73-91f9b9c69e8c",
                                "sense_id": "d6928a8a-ce75-38b4-b2b7-d6d058ca5844",
                                "text": "Les haters, ou rageux, cachés derrière leur écran, participent au soulèvement général et répandent haine ou humiliation, persuadés d’avoir raison et d’être dans leur bon droit."
                            }
                        ]
                    }
