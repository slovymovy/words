                                            {
                                                "example_id": "03336e72-36a1-4351-b1b5-fd44f6974f22",
                                                "sense_id": "17ab1bd3-e6d6-3e66-a75c-425390a3e2cc",
                                                "text": "Le troisième, nommé Gaillard, vieux soldat devenu sous-lieutenant, criblé de blessures, appartenait à la classe des soldats-laboureurs."
                                            },
                                            {
                                                "example_id": "a238ae7f-4ca6-4062-8149-d97e335dc293",
                                                "sense_id": "17ab1bd3-e6d6-3e66-a75c-425390a3e2cc",
                                                "text": "Les jeunes Clodoaldiens nouvellement inscrits sur les listes électorales se sont vu remettre leur première carte électorale et un livret du citoyen par le maire Éric Berdoati et Sacha Gaillard, adjoint au maire délégué à la Citoyenneté."
                                            },
                                            {
                                                "example_id": "3fa89042-808a-4f6c-9a96-52ed8a0eeb54",
                                                "sense_id": "17ab1bd3-e6d6-3e66-a75c-425390a3e2cc",
                                                "text": "L’animateur reçoit Jean-Christophe Rufin pour D’or et de jungle, Raphaël Enthoven pour L’Esprit artificiel, Nathalie Azoulai pour Python, et Raphaël Gaillard pour L’Homme augmenté."
                                            }
                                        ]
