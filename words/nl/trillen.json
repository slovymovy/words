{
    "word_family": [
        "trilling",
        "getril",
        "trilplaat",
        "trilfunctie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0ddf72b-ea0c-37ad-82a6-2d7686f6b8e7",
                    "sense_definition": "snel heen en weer bewegen, vaak door kou, angst of fysieke kracht",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik stond te <w>trillen</w> op mijn benen na dat vreselijke ongeluk.",
                            "target_lang_translations": {
                                "en": "My legs were <w>trembling</w> after that terrible accident.",
                                "ru": "У меня ноги <w>дрожали</w> после той ужасной аварии."
                            }
                        },
                        {
                            "text": "Zijn handen begonnen te <w>trillen</w> toen hij het spannende nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "His hands started to <w>shake</w> when he heard the exciting news.",
                                "ru": "Его руки начали <w>трястись</w>, когда он услышал волнующие новости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trillen op de benen",
                        "trillen van angst",
                        "trillen van de kou"
                    ],
                    "target_lang_definitions": {
                        "en": "to move back and forth quickly, often due to cold, fear, or physical force",
                        "ru": "быстро двигаться вперед и назад, часто из-за холода, страха или физической силы"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tremble",
                                "target_lang_sense_clarification": "shaking due to fear, cold, or emotion"
                            },
                            {
                                "target_lang_word": "shake",
                                "target_lang_sense_clarification": "general movement back and forth"
                            },
                            {
                                "target_lang_word": "shiver",
                                "target_lang_sense_clarification": "shaking specifically from cold or fear"
                            },
                            {
                                "target_lang_word": "quiver",
                                "target_lang_sense_clarification": "slight, rapid shaking"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "от холода, страха или волнения"
                            },
                            {
                                "target_lang_word": "трястись",
                                "target_lang_sense_clarification": "более интенсивное движение"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "легкое, быстрое дрожание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae8a5dd-7f38-3ac3-a4cf-b7e3d8980611",
                    "sense_definition": "een regelmatige, snelle mechanische beweging maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De snaar <w>trilde</w> totdat de harpist deze met zijn hand afdempte.",
                            "target_lang_translations": {
                                "en": "The string <w>vibrated</w> until the harpist dampened it with his hand.",
                                "ru": "Струна <w>вибрировала</w>, пока арфист не приглушил её рукой."
                            }
                        },
                        {
                            "text": "Mijn telefoon begon te <w>trillen</w> in mijn broekzak omdat ik een bericht kreeg.",
                            "target_lang_translations": {
                                "en": "My phone started to <w>vibrate</w> in my pocket because I received a message.",
                                "ru": "Мой телефон начал <w>вибрировать</w> в кармане, потому что мне пришло сообщение."
                            }
                        }
                    ],
                    "synonyms": [
                        "vibreren"
                    ],
                    "common_phrases": [
                        "laten trillen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a regular, rapid mechanical movement",
                        "ru": "совершать регулярное, быстрое механическое движение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vibrate",
                                "target_lang_sense_clarification": "mechanical or physical oscillation"
                            },
                            {
                                "target_lang_word": "thrum",
                                "target_lang_sense_clarification": "a continuous rhythmic humming or vibration"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вибрировать",
                                "target_lang_sense_clarification": "механическое или физическое колебание"
                            },
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "о физических телах, например, струнах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}