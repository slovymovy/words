                "senses": [
                    {
                        "sense_id": "13525e5b-970c-3a8e-b2c2-c960b3440b0f",
                        "entry_id": "22871276-7455-3213-95ff-1d2594c41da6",
                        "glosses": [
                            "mobile Schneeräummaschine, die mit rotierenden Werkzeugen den Schnee schichtweise aufnimmt und seitlich nach oben wegschleudert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d00067-22b4-481b-aa75-4242f7691ce4",
                                "sense_id": "13525e5b-970c-3a8e-b2c2-c960b3440b0f",
                                "text": "„Demnach waren eine großen und eine kleine Schneefräse im Einsatz, zudem zwei große und zwei kleine Lkw.“"
                            },
                            {
                                "example_id": "83b97495-078c-4e17-963d-fd54ff974df4",
                                "sense_id": "13525e5b-970c-3a8e-b2c2-c960b3440b0f",
                                "text": "„Bei großen Räumvorhaben auf der Arlbergbahn kann eine in Innsbruck stationierte selbstfahrende Schneefräse System Beilhack zur Verstärkung angefordert werden.“"
                            },
                            {
                                "example_id": "2a31ebeb-6d8c-4332-aa75-32b90f444567",
                                "sense_id": "13525e5b-970c-3a8e-b2c2-c960b3440b0f",
                                "text": "„Im Winter legte er sich die Laufbahn selbst per Schneefräse frei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
