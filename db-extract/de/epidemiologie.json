                        "sense_id": "e6864135-8154-3a20-b0e6-2c905b927dad",
                        "entry_id": "ccb3b23d-79c8-3dd6-af96-945b554f4e34",
                        "glosses": [
                            "die Lehre, die Wissenschaft von den Ursachen, der Ausbreitung, der Bekämpfung von Epidemien (Massenerkrankungen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a82496-d101-4bd5-bd9e-73d076cea44a",
                                "sense_id": "e6864135-8154-3a20-b0e6-2c905b927dad",
                                "text": "„Ein Schwerpunkt ist die Epidemiologie, also die Frage, warum sich das Virus wie ausbreitet, wo es noch sehr große Lücken gibt.“"
                            },
                            {
                                "example_id": "426051c9-f9ce-4355-824b-3ae6d2fc7317",
                                "sense_id": "e6864135-8154-3a20-b0e6-2c905b927dad",
                                "text": "„Ich hatte Gesundheitswesen studiert und wollte erst eine akademische Karriere in der Epidemiologie einschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "557b082e-cf81-4d3b-abda-65ef4cd705f4",
                        "source_entry_id": "ccb3b23d-79c8-3dd6-af96-945b554f4e34",
                        "source_sense_id": "e6864135-8154-3a20-b0e6-2c905b927dad",
                        "source_sense_description": "Lehre, Wissenschaft von den Ursachen, der Ausbreitung, der Bekämpfung von Epidemien",
                        "target_lang_word": "epidemiology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epidemiology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ce9efb-046c-35bb-823d-0d63580f41d3",
                                        "entry_id": "8cc1b276-79e8-3020-ad7d-349a7e66f118",
                                        "glosses": [
                                            "The branch of science dealing with the spread and control of diseases, viruses, concepts etc. throughout populations or systems."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb8af41b-9d2d-4cb1-a40a-8a3ce4ab7288",
                                                "sense_id": "a6ce9efb-046c-35bb-823d-0d63580f41d3",
                                                "text": "In addition to new diseases, Quammen touches on many of the examples often included in standard disease ecology or epidemiology courses—for example, myxomatosis in nonnative rabbits of Australia, and mutation rates in RNA versus DNA viruses."
                                            },
                                            {
                                                "example_id": "50f5beb7-c7e1-43f8-9e70-f7cf82e7e350",
                                                "sense_id": "a6ce9efb-046c-35bb-823d-0d63580f41d3",
                                                "text": "Melzer and Luke C. Pilling, a research fellow in genomic epidemiology at the University of Exeter Medical School, have also studied the genetics underlying longevity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d29a545-e17c-371c-ad76-6a5875ddc45c",
                                        "entry_id": "8cc1b276-79e8-3020-ad7d-349a7e66f118",
                                        "glosses": [
                                            "The epidemiological body of knowledge about a particular thing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b00a7f55-ee7e-48ac-92ee-a82f213c9f58",
                        "source_entry_id": "ccb3b23d-79c8-3dd6-af96-945b554f4e34",
                        "source_sense_id": "e6864135-8154-3a20-b0e6-2c905b927dad",
                        "source_sense_description": "Lehre, Wissenschaft von den Ursachen, der Ausbreitung, der Bekämpfung von Epidemien",
                        "target_lang_word": "épidémiologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épidémiologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff09ddd0-5913-3754-9c92-055868da9312",
                                        "entry_id": "5c86cd18-793e-356f-9359-9333a1969db7",
                                        "glosses": [
                                            "Discipline scientifique qui étudie, à l’échelle des populations, la fréquence, la distribution et les déterminants des problèmes de santé, ainsi que les moyens d’y remédier."
                                        ],
                                        "tags": [
                                            "Sciences médicales",
                                            "Santé publique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a6cd31-891f-410b-83c9-9cd4ed8d766a",
                                                "sense_id": "ff09ddd0-5913-3754-9c92-055868da9312",
                                                "text": "L’essor de l’épidémiologie moderne trouve son explication dans le fait que, pour la santé publique, la prévention est devenue prioritaire, tant dans le domaine des maladies transmissibles que dans celui des maladies non transmissibles (affections néoplasiques et cardio-vasculaires, troubles du comportement, etc.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d067acda-3077-376e-b7b7-cf2c91d2e039",
                                        "entry_id": "5c86cd18-793e-356f-9359-9333a1969db7",
                                        "glosses": [
                                            "Étude épidémiologique particulière."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277426a5-aae7-4624-865a-f4e36fa736b3",
                                                "sense_id": "d067acda-3077-376e-b7b7-cf2c91d2e039",
                                                "text": "L'épidémiologie des épilepsies revient à évaluer la fréquence de la maladie ainsi que le rôle des facteurs de risque dans l'apparition et la répartition de la maladie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
