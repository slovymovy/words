                ],
                "senses": [
                    {
                        "sense_id": "b719e24f-b7a7-39e1-a8a2-2c6f1a33d5c3",
                        "entry_id": "829ef9dd-59d7-3a06-bf7c-410fc44c22b9",
                        "glosses": [
                            "Hölzer (Balken, Stempel oder dergleichen), um einen Stollen oder Ähnliches abzusichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6cdf35-1fe7-4310-8c87-e0a217b0a00a",
                                "sense_id": "b719e24f-b7a7-39e1-a8a2-2c6f1a33d5c3",
                                "text": "„Auf der linken Seite waren ziemlich oben ein paar Minierhölzer als Lagerstätte waagerecht gelegt.“"
                            },
                            {
                                "example_id": "8b9da093-5210-4e21-8cf0-35d00b5fcbcd",
                                "sense_id": "b719e24f-b7a7-39e1-a8a2-2c6f1a33d5c3",
                                "text": "„Die haben wieder einen Volltreffer hingesetzt, und die Minierhölzer sind ganz zersplittert und der Leutnant ganz zerdrückt, daß es unmöglich war, ihn herauszuarbeiten.“"
                            },
                            {
                                "example_id": "c431983c-fcb1-45f2-8511-47e7ed95104b",
                                "sense_id": "b719e24f-b7a7-39e1-a8a2-2c6f1a33d5c3",
                                "text": "„Kohlen wurden nicht geliefert; so nahmen wir, da anderes Brennmaterial nicht zu erhalten war, Minierhölzer zum Heizen.“"
                            },
                            {
                                "example_id": "c79c4dd6-732d-41a6-bd29-e8d3f05d62c4",
                                "sense_id": "b719e24f-b7a7-39e1-a8a2-2c6f1a33d5c3",
                                "text": "„Es blieb mir nichts anderes übrig, als die Tiere selbst zu entladen, hauptsächlich das so dringend nötige Minierholz.“"
                            },
                            {
                                "example_id": "011d22fe-733c-40fe-993b-8801209f6e28",
                                "sense_id": "b719e24f-b7a7-39e1-a8a2-2c6f1a33d5c3",
                                "text": "„Das Bild stellt so einen Zug vor, die Wagen sind alle mit Minierholz beladen, das zum Bau von Stollen dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
