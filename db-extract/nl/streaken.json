                        "examples": [
                            {
                                "example_id": "47fd73ca-5fc2-4b9d-aa0f-b4f5f58180da",
                                "sense_id": "e882b869-da86-30be-906f-0f20ab964160",
                                "text": "'Ik ben echt fan van je Hayden en ik dacht laat ik vanavond eens voor je streaken', gaf de verschijning in adamskostuum aan. Hij vervolgde met: 'Kunnen we straks backstage niet iets afspreken?'"
                            },
                            {
                                "example_id": "02666c33-23a8-4af1-bb16-b69fece550cf",
                                "sense_id": "e882b869-da86-30be-906f-0f20ab964160",
                                "text": "De presentator riep bij die actie: ,,Jij bent begonnen en je moet ook echt streaken’’, en trok vervolgens de onderbroek van de demonstrant aan flarden. De vegan streaker droop bloot af."
                            }
                        ]
                    }
