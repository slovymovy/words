                    {
                        "sense_id": "97b82b46-8ee1-3fc9-85e3-e3d1f7434ff7",
                        "entry_id": "4395c699-32ad-3ed6-ab20-0c4c8bf4f473",
                        "glosses": [
                            "oliebol gebakken in varkensvet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89948ed-e616-4834-a412-a109f873971e",
                                "sense_id": "97b82b46-8ee1-3fc9-85e3-e3d1f7434ff7",
                                "text": "Toch is de toevoeging 'Oud Hollandsch' mogelijk iets bezijden de waarheid. Volgens de Belgische voedselhistoricus Dirk Prins komt de Hollandse oliebol van Vlaamse bodem. De Vlamingen die in de 16de en 17de eeuw wegens de godsdiensttwisten vluchtten naar de noordelijke Nederlanden zouden de receptuur van de 'smoutebollen' hebben meegenomen. Smout betekent varkensvet, daarin werden de bollen gebakken."
                            },
                            {
                                "example_id": "528dba73-3c38-411d-9750-f784864ccec3",
                                "sense_id": "97b82b46-8ee1-3fc9-85e3-e3d1f7434ff7",
                                "text": "Als het eerste deel geen meervoud heeft, schrijven we dus -e: gerstenat, hellevuur, rijstepap, smoutebol, snottebel"
                            }
                        ]
                    }
