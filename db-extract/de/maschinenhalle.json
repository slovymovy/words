                        "glosses": [
                            "Gebäude, in dem Maschinen fest aufgestellt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c349be-d81b-4014-b5a2-e54452d33f97",
                                "sense_id": "a7185c89-618f-34f1-a2a0-42b4af494f7f",
                                "text": "„Er offerierte den Auftrag zum Bau eines \"riesigen Komplexes\". Darin sollten angeblich eine Gießerei, Maschinenhallen, ein Kraftwerk und Werkstätten gebaut werden.“"
                            },
                            {
                                "example_id": "82d7958f-3d18-4635-999f-aa9e37af16d5",
                                "sense_id": "a7185c89-618f-34f1-a2a0-42b4af494f7f",
                                "text": "„Unsere einzigen Nachbarn sind eine stillgelegte Maschinenhalle und ein Lagerhaus, so lag wie ein ganzer Block, auf der anderen Straßenseite.“"
                            }
                        ],
