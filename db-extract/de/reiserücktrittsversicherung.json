                        "entry_id": "7009aaad-ff2f-3875-aa69-2f2a77cd315a",
                        "glosses": [
                            "Versicherung, die bei Stornierung einer bereits gebuchten Reise die Stornierungskosten übernimmt, falls die Reise kurzfristig und unerwartet abgesagt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30dd5bc3-8d8c-40a9-a5dd-02b818211b43",
                                "sense_id": "6b001a02-51e6-33f7-83ef-e469aa06491e",
                                "text": "„Der Reisende hat zu beachten, dass eine Reiserücktrittsversicherung Angst vor Terror grundsätzlich nicht abdeckt.“"
                            },
                            {
                                "example_id": "c6bebea4-8b2b-4e6a-aaea-c4f3efdd46bc",
                                "sense_id": "6b001a02-51e6-33f7-83ef-e469aa06491e",
                                "text": "„So sinnvoll eine Reiserücktrittsversicherung besonders bei teuren Reisen auch sein mag, so wichtig ist vor dem Abschluss eine genaue Prüfung der Produkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
