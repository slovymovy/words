                    {
                        "sense_id": "3a545f97-3a20-366f-8a83-51864eb8b999",
                        "entry_id": "5819c0cc-1f0d-3a75-8c58-db9f54f49b07",
                        "glosses": [
                            "zmiana w liczbie i strukturze elementów dziedzicznych"
