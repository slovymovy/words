                        "glosses": [
                            "To plash; fall with a plashing sound"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c25894-6324-4422-8fa2-0932d6b19ebf",
                                "sense_id": "ea327b51-30df-3466-8419-b9e80f6ce6f7",
                                "text": "On this day it was so cold that the white bears winked their pink eyes, as they plapped up and down by their pool, and seemed to say, \" Aha, this weather reminds us of dear home!"
                            },
                            {
                                "example_id": "550c031f-df43-4a83-a81f-07429cda0335",
                                "sense_id": "ea327b51-30df-3466-8419-b9e80f6ce6f7",
                                "text": "He'd have to look up, have to look— A stone plapped into a greasy puddle not two feet away."
                            },
                            {
                                "example_id": "2f16a43f-970b-45f6-bc13-d1a6720a10a9",
                                "sense_id": "ea327b51-30df-3466-8419-b9e80f6ce6f7",
                                "text": "The crowd humped together, squealing, around her, to the floor; the room plapped into halflight, low from two wall lamps, glowing on her legs, over the ducking heads."
                            }
                        ]
                    }
