                "senses": [
                    {
                        "sense_id": "3ae1acae-c80d-372c-8414-dd41c6010c3f",
                        "entry_id": "21fe1789-57e5-343c-8162-6894b4f5989d",
                        "glosses": [
                            "To cover with an artificial grass-like material."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c562b9-0cbe-4bf3-8f85-2a919b3fe72f",
                                "sense_id": "3ae1acae-c80d-372c-8414-dd41c6010c3f",
                                "text": "But what was there left to Astroturf? The sitting-room? Hugh's bald patch?"
                            },
                            {
                                "example_id": "b63af6fb-aeb8-4221-a512-7d0c525ae367",
                                "sense_id": "3ae1acae-c80d-372c-8414-dd41c6010c3f",
                                "text": "Is it just me, or is it hard to find anyone nowadays to Astroturf your car?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b9621bf6-06be-3bf2-a75d-92ed7ab880bd",
                        "entry_id": "21fe1789-57e5-343c-8162-6894b4f5989d",
                        "glosses": [
                            "To fabricate an impression of political support for an agenda."
                        ],
                        "tags": [
                            "lowercase",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "eba02526-ff35-4229-9a43-5a76a8ab23e8",
                                "sense_id": "b9621bf6-06be-3bf2-a75d-92ed7ab880bd",
                                "text": "We have been Astroturfed by some of the biggest players in the business. As you will read in the coming pages, a reasonable-sounding group called Americans for Balanced Energy Choices spent us$40 million during the last presidential[…]"
                            },
                            {
                                "example_id": "812b953b-0304-4a3a-b6b5-dcc67812317c",
                                "sense_id": "b9621bf6-06be-3bf2-a75d-92ed7ab880bd",
                                "text": "Even Maher reacted; his Achilles' heel is that even though he's a leftie, he exhibits clear contempt for the astroturfed audience he relies upon for his laughs. The awkwardness continued for a full, commercial-free half hour,[…]"
                            },
                            {
                                "example_id": "90571095-09bb-463d-9dbe-7890c672ffbc",
                                "sense_id": "b9621bf6-06be-3bf2-a75d-92ed7ab880bd",
                                "text": "The opposition party in Washington and its Astroturfed Tea Partiers around the country could focus strictly on assigning blame for the disaster . At the direction of the field marshals of the rich right in Washington , the Tea Party was[…]"
                            }
                        ]
                    }
