{
    "word_family": [
        "goedmaker",
        "goedmaking",
        "maken",
        "goed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2cc10849-5696-3c7b-aa42-a13c2127a5f2",
                    "sense_definition": "een ruzie of onenigheid beëindigen door vrede te sluiten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verzoening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na hun grote ruzie van gisteren hebben ze het gelukkig weer <w>goedgemaakt</w>.",
                            "target_lang_translations": {
                                "en": "After their big argument yesterday, they fortunately <w>made up</w> again."
                            }
                        },
                        {
                            "text": "Ik wil het graag met je <w>goedmaken</w> door vanavond samen uit eten te gaan.",
                            "target_lang_translations": {
                                "en": "I would like to <w>make it up</w> to you by going out to dinner together tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijleggen",
                        "verzoenen"
                    ],
                    "antonyms": [
                        "ruziën"
                    ],
                    "common_phrases": [
                        "het weer goedmaken",
                        "het met iemand goedmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to end a quarrel or disagreement by making peace"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make up",
                                "target_lang_sense_clarification": "to reconcile after a fight"
                            },
                            {
                                "target_lang_word": "reconcile",
                                "target_lang_sense_clarification": "to restore friendly relations"
                            },
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "to resolve a dispute"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1be6503b-a03f-3a48-b231-5cd1fa242567",
                    "sense_definition": "een fout, verlies of schade herstellen of compenseren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "compensatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zal de schade aan je auto natuurlijk volledig voor je <w>goedmaken</w>.",
                            "target_lang_translations": {
                                "en": "I will, of course, fully <w>compensate</w> you for the damage to your car."
                            }
                        },
                        {
                            "text": "De winkelier wilde de fout <w>goedmaken</w> door een kleine korting aan te bieden.",
                            "target_lang_translations": {
                                "en": "The shopkeeper wanted to <w>rectify</w> the mistake by offering a small discount."
                            }
                        }
                    ],
                    "synonyms": [
                        "compenseren",
                        "vergoeden",
                        "herstellen"
                    ],
                    "common_phrases": [
                        "schade goedmaken",
                        "een fout goedmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to repair or compensate for a mistake, loss, or damage"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make up for",
                                "target_lang_sense_clarification": "to compensate for something bad"
                            },
                            {
                                "target_lang_word": "compensate",
                                "target_lang_sense_clarification": "to pay or provide something in recognition of loss"
                            },
                            {
                                "target_lang_word": "rectify",
                                "target_lang_sense_clarification": "to put right a mistake or fault"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cbf0e35-295b-38ae-9a29-7583e8d8a84c",
                    "sense_definition": "boeten voor een overtreding of misdaad door een tegenprestatie te leveren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzoening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde zijn slechte daden uit het verleden te <w>goedmaken</w> met vrijwilligerswerk.",
                            "target_lang_translations": {
                                "en": "He tried to <w>atone for</w> his past bad deeds with volunteer work."
                            }
                        },
                        {
                            "text": "Zij moet haar schuld aan de maatschappij nog volledig <w>goedmaken</w>.",
                            "target_lang_translations": {
                                "en": "She still has to fully <w>make amends</w> for her debt to society."
                            }
                        }
                    ],
                    "synonyms": [
                        "boeten"
                    ],
                    "common_phrases": [
                        "een schuld goedmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to atone for an offense or crime by providing a counter-performance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "atone for",
                                "target_lang_sense_clarification": "to make amends for a sin or crime"
                            },
                            {
                                "target_lang_word": "make amends",
                                "target_lang_sense_clarification": "to compensate for a grievance or injury"
                            },
                            {
                                "target_lang_word": "redeem",
                                "target_lang_sense_clarification": "to make up for a fault or bad behavior"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
