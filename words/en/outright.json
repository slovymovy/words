{
    "word_family": [
        "right"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "182d1a54-46a4-3937-a90c-78e4ed72766e",
                    "sense_definition": "Complete, total, and clear; involving the whole of something without any doubt, limitation, or attempt to hide it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician dismissed the accusations as <w>outright</w> lies.",
                            "target_lang_translations": {
                                "ru": "Политик отверг обвинения как <w>наглую</w> ложь.",
                                "zh": "那位政客驳斥这些指控是<w>公然</w>撒谎。"
                            }
                        },
                        {
                            "text": "We achieved <w>outright</w> domination in the market within two years.",
                            "target_lang_translations": {
                                "ru": "Мы добились <w>полного</w> господства на рынке в течение двух лет.",
                                "zh": "我们在两年内实现了对市场的<w>绝对</w>统治。"
                            }
                        },
                        {
                            "text": "His behavior was an <w>outright</w> refusal to cooperate with the team.",
                            "target_lang_translations": {
                                "ru": "Его поведение было <w>прямым</w> отказом сотрудничать с командой.",
                                "zh": "他的行为是<w>直接</w>拒绝与团队合作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "complete",
                        "total",
                        "utter",
                        "thorough",
                        "unmitigated",
                        "downright"
                    ],
                    "antonyms": [
                        "partial",
                        "incomplete"
                    ],
                    "common_phrases": [
                        "outright lie",
                        "outright ban",
                        "outright rejection",
                        "outright hostility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный, тотальный и явный; затрагивающий что-либо целиком, без сомнений или попыток скрыть.",
                        "zh": "完全的、彻底的、明确的；指某事毫无疑问、没有限制或不加掩饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенный",
                                "target_lang_sense_clarification": "явный, неприкрытый (о лжи, враждебности)"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "тотальный, совершенный"
                            },
                            {
                                "target_lang_word": "прямой",
                                "target_lang_sense_clarification": "непосредственный, категорический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彻底的",
                                "target_lang_sense_clarification": "完全的，不留余地的"
                            },
                            {
                                "target_lang_word": "公然的",
                                "target_lang_sense_clarification": "明目张胆的，不加掩饰的"
                            },
                            {
                                "target_lang_word": "直接的",
                                "target_lang_sense_clarification": "明确的，不含糊的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1f91d42-1645-3817-951f-069b06033f68",
                    "sense_definition": "Clear, final, and certain, with no conditions, restrictions, or outstanding debts attached.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party failed to secure an <w>outright</w> majority in the election.",
                            "target_lang_translations": {
                                "ru": "Партии не удалось получить <w>абсолютное</w> большинство на выборах.",
                                "zh": "该党在选举中未能获得<w>绝对</w>多数席位。"
                            }
                        },
                        {
                            "text": "She is the <w>outright</w> winner of the competition.",
                            "target_lang_translations": {
                                "ru": "Она — <w>безоговорочный</w> победитель этого соревнования.",
                                "zh": "她是这场比赛<w>无可争议的</w>获胜者。"
                            }
                        },
                        {
                            "text": "They do not seek <w>outright</w> independence, but rather greater autonomy.",
                            "target_lang_translations": {
                                "ru": "Они стремятся не к <w>полной</w> независимости, а скорее к большей автономии.",
                                "zh": "他们寻求的不是<w>完全的</w>独立，而是更大的自治权。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unconditional",
                        "absolute",
                        "definite",
                        "clear"
                    ],
                    "antonyms": [
                        "conditional",
                        "tentative"
                    ],
                    "common_phrases": [
                        "outright winner",
                        "outright majority",
                        "outright victory",
                        "outright purchase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ясный, окончательный и определенный, без каких-либо условий или ограничений.",
                        "zh": "明确的、最终的、确定的，没有任何附加条件、限制或债务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безоговорочный",
                                "target_lang_sense_clarification": "неоспоримый, безусловный"
                            },
                            {
                                "target_lang_word": "абсолютный",
                                "target_lang_sense_clarification": "полный, подавляющий (о большинстве)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝对的",
                                "target_lang_sense_clarification": "完全的，无条件的"
                            },
                            {
                                "target_lang_word": "无可争议的",
                                "target_lang_sense_clarification": "毫无疑问的，确定的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c8deb913-96fa-3781-acc2-1ed69226f3e8",
                    "sense_definition": "Completely, totally, or openly; in a direct manner without hesitation or hiding anything.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "completeness_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I refute those allegations <w>outright</w>.",
                            "target_lang_translations": {
                                "ru": "Я <w>категорически</w> отвергаю эти обвинения.",
                                "zh": "我<w>断然</w>否认那些指控。"
                            }
                        },
                        {
                            "text": "The committee rejected the proposal <w>outright</w> without further discussion.",
                            "target_lang_translations": {
                                "ru": "Комитет отверг предложение <w>сразу же</w> без дальнейшего обсуждения.",
                                "zh": "委员会没有进一步讨论，<w>直接</w>否决了该提案。"
                            }
                        },
                        {
                            "text": "That was an <w>outright</w> stupid thing to say during the meeting.",
                            "target_lang_translations": {
                                "ru": "Сказать такое во время собрания было <w>совершенно</w> глупо.",
                                "zh": "在会议上说那种话简直是<w>完全</w>愚蠢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "totally",
                        "absolutely",
                        "flat-out",
                        "entirely",
                        "openly"
                    ],
                    "antonyms": [
                        "partially"
                    ],
                    "common_phrases": [
                        "reject outright",
                        "dismiss outright",
                        "ban outright",
                        "refuse outright"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью, совершенно или открыто; прямым образом, без колебаний и ничего не скрывая.",
                        "zh": "完全地、彻底地或公开地；以直接的方式，毫不犹豫或不加隐瞒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "без обиняков, в лицо"
                            },
                            {
                                "target_lang_word": "открыто",
                                "target_lang_sense_clarification": "не таясь, публично"
                            },
                            {
                                "target_lang_word": "наотрез",
                                "target_lang_sense_clarification": "категорически (об отказе)"
                            },
                            {
                                "target_lang_word": "полностью",
                                "target_lang_sense_clarification": "целиком, совершенно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "断然",
                                "target_lang_sense_clarification": "坚决地，毫不犹豫地"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "彻底地"
                            },
                            {
                                "target_lang_word": "公开地",
                                "target_lang_sense_clarification": "不加掩饰地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57e276fa-1e56-3efa-ba26-064cfe6c6d3b",
                    "sense_definition": "By a single complete payment or action, rather than gradually or with conditions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conditions_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have bought the house <w>outright</w> and have no mortgage.",
                            "target_lang_translations": {
                                "ru": "Я купил дом <w>сразу</w> и не имею ипотеки.",
                                "zh": "我<w>一次性</w>买下了这栋房子，没有抵押贷款。"
                            }
                        },
                        {
                            "text": "She owns the car <w>outright</w> after making the final payment.",
                            "target_lang_translations": {
                                "ru": "Она владеет машиной <w>полностью</w> после внесения последнего платежа.",
                                "zh": "付清最后一笔款项后，她<w>完全</w>拥有了这辆车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fully",
                        "entirely"
                    ],
                    "common_phrases": [
                        "buy outright",
                        "own outright",
                        "pay outright"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одним полным платежом или действием, а не постепенно или с условиями.",
                        "zh": "通过一次性付款或行动完成，而不是分期或附带条件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сразу",
                                "target_lang_sense_clarification": "единовременно, за один раз"
                            },
                            {
                                "target_lang_word": "целиком",
                                "target_lang_sense_clarification": "в полном объеме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一次性",
                                "target_lang_sense_clarification": "全额的，不分期的"
                            },
                            {
                                "target_lang_word": "直接",
                                "target_lang_sense_clarification": "完全地，不通过中间环节"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f83f6164-dbb9-30e6-b10c-c1ccf3aecc1d",
                    "sense_definition": "Instantly and immediately; at the very moment an event occurs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "time_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was killed <w>outright</w> in the crash.",
                            "target_lang_translations": {
                                "ru": "Водитель погиб <w>на месте</w> в этой аварии.",
                                "zh": "司机在车祸中<w>当场</w>死亡。"
                            }
                        },
                        {
                            "text": "Two people died <w>outright</w> and one more passed away later at the hospital.",
                            "target_lang_translations": {
                                "ru": "Два человека погибли <w>сразу</w>, а еще один скончался позже в больнице.",
                                "zh": "两人<w>当场</w>死亡，另有一人在医院去世。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instantly",
                        "immediately",
                        "at once"
                    ],
                    "common_phrases": [
                        "killed outright",
                        "die outright"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мгновенно и немедленно; в тот самый момент, когда происходит событие (обычно о смерти).",
                        "zh": "瞬间且立即；在事件发生的同一时刻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на месте",
                                "target_lang_sense_clarification": "мгновенно, не сходя с места"
                            },
                            {
                                "target_lang_word": "сразу",
                                "target_lang_sense_clarification": "тотчас же"
                            },
                            {
                                "target_lang_word": "наповал",
                                "target_lang_sense_clarification": "насмерть (убит)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当场",
                                "target_lang_sense_clarification": "在事件发生的地点和时刻"
                            },
                            {
                                "target_lang_word": "立即",
                                "target_lang_sense_clarification": "立刻，马上"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d82f90b6-14ac-3f3c-baf5-f2a1189e0654",
                    "sense_definition": "To release a player from a team or contract without conditions, often removing them from the main roster.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran player was <w>outrighted</w> to the minor league team.",
                            "target_lang_translations": {
                                "ru": "Опытный игрок был <w>отчислен</w> в команду низшей лиги.",
                                "zh": "这位老将被<w>下放</w>到了小联盟球队。"
                            }
                        },
                        {
                            "text": "He cleared waivers and was <w>outrighted</w> to Class AA Binghamton.",
                            "target_lang_translations": {
                                "ru": "Он прошел процедуру драфта отказов и был <w>переведен</w> в класс AA в Бингемтон.",
                                "zh": "他通过了豁免程序，被<w>下放</w>至宾汉姆顿的2A级球队。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in sports contexts, particularly North American baseball"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освободить игрока от обязательств перед командой или расторгнуть контракт без условий (спорт).",
                        "zh": "无条件地将球员从球队或合同中释放，通常将其从主要名单中移除。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчислять",
                                "target_lang_sense_clarification": "исключать из команды"
                            },
                            {
                                "target_lang_word": "выводить из состава",
                                "target_lang_sense_clarification": "переводить в низшую лигу или список отказов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下放",
                                "target_lang_sense_clarification": "将球员调至低级别联赛"
                            },
                            {
                                "target_lang_word": "解约",
                                "target_lang_sense_clarification": "解除合同"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}