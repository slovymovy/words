                        "translation_id": "24b77c64-a934-4631-9677-e78a2c72766c",
                        "source_entry_id": "b621b9ce-862b-3ed7-912b-b34dd909edb7",
                        "source_sense_id": "93fb24b3-dd7e-397d-a2e4-59bde7383cf5",
