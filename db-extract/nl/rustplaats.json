                "senses": [
                    {
                        "sense_id": "29ddfc83-e20c-3303-9b99-33718f44fc9d",
                        "entry_id": "90492116-22d6-30ce-ad04-92f24bbe6047",
                        "glosses": [
                            "plaats waar men kan rusten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40b86ad-d0e0-4101-8716-84ec765fcbe3",
                                "sense_id": "29ddfc83-e20c-3303-9b99-33718f44fc9d",
                                "text": "Gelukkig was er een bankje langs de weg dat kon dienen als rustplaats voor de uitgeputte wandelaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcbae12e-cc29-364b-aba2-4dac3d42b82c",
                        "entry_id": "90492116-22d6-30ce-ad04-92f24bbe6047",
                        "glosses": [
                            "de laatste rustplaats: het graf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f3b968e-d3af-4156-b043-9dd9338715ba",
                                "sense_id": "bcbae12e-cc29-364b-aba2-4dac3d42b82c",
                                "text": "De oude man werd naar zijn laatste rustplaats gebracht."
                            },
                            {
                                "example_id": "556597bb-cbfb-4bb9-8c8f-18b0bb288810",
                                "sense_id": "bcbae12e-cc29-364b-aba2-4dac3d42b82c",
                                "text": "De familie Van Rechteren Limpurg is al eeuwen verbonden met de Grote Kerk. In de crypte onder de kerk rusten 26 voorouders van de graaf. Sinds 1875 geldt het mausoleum aan de Gravenallee als laatste rustplaats voor overleden leden van de grafelijke familie. Graaf Adolph wordt daar morgen als veertiende familielid bijgezet."
                            }
                        ]
                    }
