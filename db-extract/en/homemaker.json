                        "target_lang_word": "Hausmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e32ee59a-c7d9-3242-9d5e-dfa9af186c65",
                                        "entry_id": "7ead0c36-3fad-3b8b-a3cf-027f6b8ad016",
                                        "glosses": [
                                            "Mann, der den Haushalt führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be82f16-0c31-4ffd-abbc-135faea9c87a",
                                                "sense_id": "e32ee59a-c7d9-3242-9d5e-dfa9af186c65",
                                                "text": "Da seine Frau im Krankenhaus liegt, ist er zur Zeit der Hausmann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hausmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                        "entry_id": "88dcd8b3-9db3-3bb1-8495-2ad576eec7dd",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5722d0a8-9710-4ffb-b96b-5b997d8699ba",
                                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                                "text": "Frau Hausmann ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "0dbbeefb-57d8-492f-a76f-8a6644f94c5c",
                                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                                "text": "Herr Hausmann wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "006f2d33-e6c2-479e-aaea-d0eb569b18a1",
                                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                                "text": "Die Hausmanns fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "c389a816-f22e-4911-a177-5a9e6c2acad4",
                                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                                "text": "Der Hausmann trägt nie die Pullover, die die Hausmann ihm strickt."
                                            },
                                            {
                                                "example_id": "ef65d88c-1fdf-4cd3-b5a5-6dc0f54bb10e",
                                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hausmann kommt, geht der Herr Hausmann.“"
                                            },
                                            {
                                                "example_id": "b1189d7f-2f8b-4fbb-ba10-7513ca3df685",
                                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                                "text": "Hausmann kommt und geht."
                                            },
                                            {
                                                "example_id": "e73f7054-6543-437b-a21e-38b1da8f41e1",
                                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                                "text": "Hausmanns kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cd17585-c4c2-458a-9f3b-20ba949b3bb3",
                        "source_entry_id": "c3daabb6-de8c-3109-b323-cf89404de0f4",
                        "source_sense_id": "b49dc693-3323-3fa8-a478-739ffefdd3bf",
                        "source_sense_description": "person who maintains his or her residence",
                        "target_lang_word": "Hausfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                        "entry_id": "14afac96-fb04-316b-998f-c2152e64badd",
                                        "glosses": [
                                            "ihren eigenen Haushalt führende und besorgende Frau"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d33f3f2-c0a5-47ac-b844-d35c5d2ccd00",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "„Es muss einen Extrembergsteiger schon frustrieren, wenn die Regionen, in die er vorgedrungen ist, heutzutage sogar von kletternden Hausfrauen erreicht werden - wenn sie denn genügend Kleingeld haben.“"
                                            },
                                            {
                                                "example_id": "f13e1e81-7514-4bea-a225-53681a315387",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "Hausfrau ist ein sehr anstrengender Beruf."
                                            },
                                            {
                                                "example_id": "677f2c09-dc64-4004-8824-0b5bfa36a441",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "\"Und er fing an, von Madame Homais zu sprechen, deren arg vernachlässigte Kleidung sie beide sonst immer zum Lachen gereizt hatte. ‚Was schadet denn das?’ unterbrach ihn Emma. ‚Eine gute Hausfrau zerbricht sich nicht den Kopf über das, was sie annzieht.’ \""
                                            },
                                            {
                                                "example_id": "26e01758-7b72-40b7-8253-6bef3dbb5fd1",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "„Die ersten Absprachen wurden übrigens in den Knuttstuben (Strickstuben) zwischen den beteiligten Hausfrauen getroffen, aus deren Reihen sich später das Festkomitee rekrutierte, das jedem - vom Koch über die Backfrau bis zum Musikus - seine Aufgaben zuwies.“"
                                            },
                                            {
                                                "example_id": "71fab43e-06b9-404f-ae80-c31c03d8ffb8",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "„Aber da dies nur ein paar Seiten aus dem Leben einer dicken Hausfrau aus Neuengland sind, muss ich aufrichtig sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2d46907-9cf8-3c52-9f95-005cdb2d0a3f",
                                        "entry_id": "14afac96-fb04-316b-998f-c2152e64badd",
                                        "glosses": [
                                            "ein möbliertes Zimmer oder Ähnliches vermietende Frau"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
