                ],
                "senses": [
                    {
                        "sense_id": "7b47ef70-3958-3465-986f-6a4a346ab08c",
                        "entry_id": "2074512b-fef4-35b2-a901-ed810dd42bd1",
                        "glosses": [
                            "leichter Wind an/über dem Meer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0109c43-3157-44dd-ad11-3a0d58418620",
                                "sense_id": "7b47ef70-3958-3465-986f-6a4a346ab08c",
                                "text": "„In ihrer Blindheit schien sich der ganze Hass der Öffentlichkeit auf die Person Clarendons zu konzentrieren anstatt auf die Seuche, die ihre früher so gesunde, von ständigen Meeresbrisen durchwehte Stadt heimgesucht hatte.“"
                            },
                            {
                                "example_id": "bf674ae4-bdc9-47ed-b2d5-b6e6eb31b64d",
                                "sense_id": "7b47ef70-3958-3465-986f-6a4a346ab08c",
                                "text": "„Ich blieb am Ufer, nicht weil ich davon überzeugt gewesen wäre, dass das Boot zurückkehrte, sondern weil ich wusste, dass es hier weniger Mücken und Moskitos gab, weil die Meeresbrise sie vertrieb, obwohl man auch so noch mehr als zwei Hände brauchte, um sich ihrer zu erwehren.“"
                            },
                            {
                                "example_id": "ab5c94e9-a1f7-4fc2-a435-d9186e586324",
                                "sense_id": "7b47ef70-3958-3465-986f-6a4a346ab08c",
                                "text": "„Rogers öffnete die Fenster, um die Meeresbrise hereinzulassen.“"
                            },
                            {
                                "example_id": "6fbd3cee-e255-4452-a747-0bb22e4794ca",
                                "sense_id": "7b47ef70-3958-3465-986f-6a4a346ab08c",
                                "text": "„Der beißende Qualm der Kohlefeuer, der unzähligen brennenden Zigaretten und der Kraftwerke machte die Luft stickig und rang mit der salzigen Meeresbrise.“"
                            },
                            {
                                "example_id": "a3fa7d6b-fc02-4a7d-9920-814d6c99f5b6",
                                "sense_id": "7b47ef70-3958-3465-986f-6a4a346ab08c",
                                "text": "„Es war halb fünf am Morgen und die Luft war dank der frischen Meeresbrise angenehm kühl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
