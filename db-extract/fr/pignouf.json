                    {
                        "sense_id": "ac5a26f1-59b9-3cf3-993e-12606e883fa5",
                        "entry_id": "2770653e-8d33-3a3e-8144-2cd614188bea",
                        "glosses": [
                            "Grossier, mal élevé, rustre."
                        ],
                        "tags": [
