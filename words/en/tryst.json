{
    "word_family": [
        "tryster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87b1712a-d1ff-32bf-9837-8efaf89686b5",
                    "sense_definition": "A prearranged meeting, especially between lovers at a specific time and place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple planned a secret <w>tryst</w> in the quiet corner of the park.",
                            "target_lang_translations": {
                                "ru": "Пара запланировала тайное <w>свидание</w> в тихом уголке парка."
                            }
                        },
                        {
                            "text": "They met for a midnight <w>tryst</w> under the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Они встретились на полуночное <w>свидание</w> под старым дубом."
                            }
                        }
                    ],
                    "synonyms": [
                        "assignation",
                        "rendezvous"
                    ],
                    "common_phrases": [
                        "secret tryst"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее условленная встреча, особенно романтическая или тайная встреча влюблённых в назначенном месте и времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидание",
                                "target_lang_sense_clarification": "романтическая или тайная встреча"
                            },
                            {
                                "target_lang_word": "любовное свидание",
                                "target_lang_sense_clarification": "романтическая встреча возлюбленных"
                            },
                            {
                                "target_lang_word": "рандеву",
                                "target_lang_sense_clarification": "условленная встреча, часто тайная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7894b517-2c1a-38d7-8c1a-24ca0c7b59d6",
                    "sense_definition": "A recurring market fair where livestock sales took place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "market",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers gathered at the annual <w>tryst</w> to trade their cattle.",
                            "target_lang_translations": {
                                "ru": "Фермеры собрались на ежегодную <w>ярмарку</w>, чтобы торговать скотом."
                            }
                        },
                        {
                            "text": "The village <w>tryst</w> was the main event for local livestock dealers.",
                            "target_lang_translations": {
                                "ru": "Деревенский <w>скотный базар</w> был главным событием для местных торговцев скотом."
                            }
                        }
                    ],
                    "synonyms": [
                        "fair",
                        "market"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical market practices."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Периодическая ярмарка, на которой продавали и покупали скот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярмарка",
                                "target_lang_sense_clarification": "периодический рынок, особенно скотный"
                            },
                            {
                                "target_lang_word": "скотный базар",
                                "target_lang_sense_clarification": "рынок для торговли домашним скотом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25c74b7f-530e-338c-abcc-77195ad5d0f0",
                    "sense_definition": "A mutual agreement or covenant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They made a solemn <w>tryst</w> to support each other through the coming years.",
                            "target_lang_translations": {
                                "ru": "Они дали торжественный <w>обет</w> поддерживать друг друга в грядущие годы."
                            }
                        },
                        {
                            "text": "The ancient <w>tryst</w> between the two families was finally honored.",
                            "target_lang_translations": {
                                "ru": "Древнее <w>соглашение</w> между двумя семьями наконец было исполнено."
                            }
                        }
                    ],
                    "synonyms": [
                        "covenant",
                        "agreement"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a formal or literary context."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взаимное соглашение, договорённость или торжественное обещание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соглашение",
                                "target_lang_sense_clarification": "взаимный договор или согласие"
                            },
                            {
                                "target_lang_word": "договор",
                                "target_lang_sense_clarification": "взаимное обязательство"
                            },
                            {
                                "target_lang_word": "обет",
                                "target_lang_sense_clarification": "торжественное обещание, клятва"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3d05f60-be88-339c-9838-720ea393aa55",
                    "sense_definition": "To agree to meet at a specific place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lovers decided to <w>tryst</w> by the river at sunset.",
                            "target_lang_translations": {
                                "ru": "Влюблённые решили <w>встретиться</w> у реки на закате."
                            }
                        },
                        {
                            "text": "They <w>tryst</w> in the garden every evening.",
                            "target_lang_translations": {
                                "ru": "Они <w>встречаются</w> в саду каждый вечер."
                            }
                        }
                    ],
                    "synonyms": [
                        "meet",
                        "rendezvous"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Встречаться или договариваться встретиться в определённом месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "сходиться в назначенном месте, приходить на свидание"
                            },
                            {
                                "target_lang_word": "прийти на встречу",
                                "target_lang_sense_clarification": "явиться на условленное свидание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fa549f5-0cc8-38e6-87c0-e4d3f7c8d501",
                    "sense_definition": "To arrange or appoint a meeting time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>trysted</w> a time to discuss the secret plans.",
                            "target_lang_translations": {
                                "ru": "Они <w>назначили</w> время, чтобы обсудить секретные планы."
                            }
                        },
                        {
                            "text": "The king <w>trysted</w> a meeting with his advisors.",
                            "target_lang_translations": {
                                "ru": "Король <w>назначил встречу</w> со своими советниками."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrange",
                        "appoint"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначать или согласовывать время и место встречи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначить встречу",
                                "target_lang_sense_clarification": "договориться о времени или месте встречи"
                            },
                            {
                                "target_lang_word": "назначить свидание",
                                "target_lang_sense_clarification": "договориться о романтической или тайной встрече"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}