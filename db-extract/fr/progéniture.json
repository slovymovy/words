                                    },
                                    {
                                        "sense_id": "566e7d56-0eba-30b9-932a-85db3eb5cf7c",
                                        "entry_id": "9921e2d2-6b66-31e4-97df-ecbe33731de1",
                                        "glosses": [
                                            "Nachkomme, Kind der Familie"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "gehoben",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccac143c-ecd5-49b0-972c-79fd185904d7",
                                                "sense_id": "566e7d56-0eba-30b9-932a-85db3eb5cf7c",
                                                "text": "Manfred wuchs als Spross eines alten Adelsgeschlechts auf."
                                            },
                                            {
                                                "example_id": "d7d6e105-ed19-4d6b-ad54-98c2b4232e01",
                                                "sense_id": "566e7d56-0eba-30b9-932a-85db3eb5cf7c",
                                                "text": "Das Kindermädchen kümmert sich liebevoll um die Sprosse der Familie."
                                            },
                                            {
                                                "example_id": "e04cb9be-194a-4377-b266-74ce420e5d55",
                                                "sense_id": "566e7d56-0eba-30b9-932a-85db3eb5cf7c",
                                                "text": "Das Kindermädchen kümmert sich liebevoll um die Sprossen der Familie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
