                                "ru": "Она выбрала нежный <w>розовый цвет</w> для стен своей спальни.",
                                "zh": "她为卧室的墙壁选了一种柔和的<w>玫瑰色</w>。"
                            }
                        },
                        {
                            "text": "The sky turned a deep <w>rose</w> as the sun set.",
                            "target_lang_translations": {
                                "ru": "Небо окрасилось в глубокий <w>розовый цвет</w> на закате.",
                                "zh": "日落时分，天空变成了深<w>玫瑰色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pink"
                    ],
                    "common_phrases": [
                        "rose color",
                        "dusty rose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пурпурно-красный или розовый цвет.",
                        "zh": "一种紫红色或粉红色。"
                    },
                    "translations": {
