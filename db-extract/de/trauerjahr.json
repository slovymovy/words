                "senses": [
                    {
                        "sense_id": "6cfc2e01-bd81-36ce-9f6d-280081bb08ec",
                        "entry_id": "b390091c-b01c-3e8d-8496-678b284e8811",
                        "glosses": [
                            "der Zeitraum, in dem man nach dem Tod eines nahen Verwandten Trauerkleidung trägt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "004f1ab3-55ab-4450-94ad-b49f569751da",
                                "sense_id": "6cfc2e01-bd81-36ce-9f6d-280081bb08ec",
                                "text": "„Als das Trauerjahr zu Ende war, freite Ludewig seine Detta, so daß jetzt Knecht und Magd Bauer und Bäuerin auf dem Schimmelbergshofe sitzen und genauso viel Ansehen und Achtung im Dorfe haben, als stammten sie aus den großen Lohöfer Geschlechtern.“"
                            },
                            {
                                "example_id": "30782b74-de8a-4524-aa7a-eb0bb56fc140",
                                "sense_id": "6cfc2e01-bd81-36ce-9f6d-280081bb08ec",
                                "text": "„Schon in der Trauerwoche nach dem Tod von Mojsches Frau sucht er eine neue Ehe für ihn einzufädeln, Mojsche aber will erst einen ganzen Trauermonat, dann ein volles Trauerjahr vergehen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cafd78ec-abae-3b88-bc75-12276c4c4b10",
                        "entry_id": "b390091c-b01c-3e8d-8496-678b284e8811",
                        "glosses": [
                            "die gesetzliche Zeit von zehn Monaten, in der eine Witwe keine neue Ehe eingehen durfte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c5b047e6-748a-406a-a78e-9533a60266c8",
                                "sense_id": "cafd78ec-abae-3b88-bc75-12276c4c4b10",
                                "text": "Eine Befreiung vom Trauerjahr war durchaus möglich."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
