                "senses": [
                    {
                        "sense_id": "3b815069-e461-3bde-913d-5bca8865b2fb",
                        "entry_id": "321f802d-093e-3779-a64e-eddbfa3be7f7",
                        "glosses": [
                            "Relatif à la fois à la Grèce et à la Rome antiques, qui relève de ce double héritage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f630cc8f-d0b4-48bf-a1b1-501b120b0490",
                                "sense_id": "3b815069-e461-3bde-913d-5bca8865b2fb",
                                "text": "Civilisation, culture, langues gréco-latines."
                            },
                            {
                                "example_id": "72d56876-4cef-4564-9b40-a0af83b6baf2",
                                "sense_id": "3b815069-e461-3bde-913d-5bca8865b2fb",
                                "text": "Un carré gréco-latin est un tableau carré de n lignes et n colonnes remplies avec n² paires distinctes, et où chaque ligne et chaque colonne ne contient qu'un seul exemplaire."
                            },
                            {
                                "example_id": "a1a64b05-1d24-4be0-9be7-962bb75d8468",
                                "sense_id": "3b815069-e461-3bde-913d-5bca8865b2fb",
                                "text": "L’ample culture gréco-latine des deux frères semble à première vue un phénomène banal pour l’époque : en fait, elle fut toujours rare en pays de langue française, hors du groupe des spécialistes et des professeurs, chez qui elle prend d’habitude des aspects plus étroitement philologiques et scolaires. C’est en Allemagne, c’est en Angleterre surtout qu’on voit des jeunes hommes occuper leurs loisirs à lire, sous les arbres d’un parc, Hésiode et Théocrite."
                            }
                        ]
                    }
                ],
