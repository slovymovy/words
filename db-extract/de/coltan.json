                ],
                "senses": [
                    {
                        "sense_id": "bdcedcdf-cb96-382d-87b1-68e99bb0b363",
                        "entry_id": "0dd5b0d9-8723-3817-8c9a-02663a45d15c",
                        "glosses": [
                            "Mineral, das hauptsächlich in Zentralafrika vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2245504-1e7a-4764-86ca-b51c4084b161",
                                "sense_id": "bdcedcdf-cb96-382d-87b1-68e99bb0b363",
                                "text": "„In diesen Regionen habe der illegale Abbau und der Handel mit Gold, Coltan und Zinnerzen dazu geführt, dass ‚Rebellengruppen ein ökonomisches Eigeninteresse daran hatten, die Kontrolle über die Bergbauregionen zu behalten‘.“"
                            },
                            {
                                "example_id": "4960d743-8b36-4001-8783-53a0598b615a",
                                "sense_id": "bdcedcdf-cb96-382d-87b1-68e99bb0b363",
                                "text": "„Coltan ist Kongos Gold. Denn aus dem Erz Coltan wird das seltene Metall Tantal gewonnen, ohne das die moderne Welt nicht modern wäre: Tantal wird in Kondensatoren für Digitalkameras und Spielkonsolen, für Laptops, Flachbildschirme und Mobiltelefone verwendet.“"
                            },
                            {
                                "example_id": "0952a6a6-d95c-4513-8ee4-b83145f00681",
                                "sense_id": "bdcedcdf-cb96-382d-87b1-68e99bb0b363",
                                "text": "„Gold, Diamanten, Kobalt, Coltan und andere Erze ziehen Milizen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bafcb75c-6660-4ad8-8ab0-47cd09aca1a0",
                        "source_entry_id": "0dd5b0d9-8723-3817-8c9a-02663a45d15c",
                        "source_sense_id": "bdcedcdf-cb96-382d-87b1-68e99bb0b363",
                        "source_sense_description": "Mineral, das hauptsächlich in Zentralafrika vorkommt",
                        "target_lang_word": "coltan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coltan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30c2ffdc-9df0-3c9b-9330-3580f9bb9115",
                                        "entry_id": "0ef8fdee-6fa1-3892-bc53-74d9ce4313ee",
                                        "glosses": [
                                            "A metallic ore, (Fe,Mn)(Ta,Nb)₂O₆, from which the elements niobium and tantalum are extracted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f6874a-89b1-43d6-80e5-8e7d551fdcc4",
                                                "sense_id": "30c2ffdc-9df0-3c9b-9330-3580f9bb9115",
                                                "text": "Coltan is used for the production of tantalum capacitors."
                                            },
                                            {
                                                "example_id": "b8442a74-c31f-4e43-8052-e9c83a878ab0",
                                                "sense_id": "30c2ffdc-9df0-3c9b-9330-3580f9bb9115",
                                                "text": "[…] as of 2003 over one billion cell phones were in use worldwide, so by the time the high-tech bubble approached its bursting point in 2000 and 2001, coltan had become an extremely hot commodity."
                                            },
                                            {
                                                "example_id": "9e2e1af2-bf97-4ff7-a3d7-f48a65057d07",
                                                "sense_id": "30c2ffdc-9df0-3c9b-9330-3580f9bb9115",
                                                "text": "Consider your mobile phone. Before it was assembled in a Chinese factory, the coltan in its capacitors may have been dug by miners in the Eastern Congo, where millions have died in a series of wars over ‘conflict minerals’, though we give this no more thought than previous generations of Westerners gave to the Congolese origins of the ivory in their piano keys, the rubber in their tyres, the copper in their bullet casings or the uranium in their bombs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe988b55-cc98-4bfa-9db3-18b9c8000b25",
                        "source_entry_id": "0dd5b0d9-8723-3817-8c9a-02663a45d15c",
                        "source_sense_id": "bdcedcdf-cb96-382d-87b1-68e99bb0b363",
