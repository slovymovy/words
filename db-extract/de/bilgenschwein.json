                "senses": [
                    {
                        "sense_id": "6b0c2513-1fc2-3f78-b7d4-afa7be507159",
                        "entry_id": "2ab629da-cd35-3645-9024-7f0939ef0673",
                        "glosses": [
                            "ein Fabelwesen aus der Seemannssprache, das in der Bilge leben soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c783f155-99be-4b5b-bf24-d52c0b8a3188",
                                "sense_id": "6b0c2513-1fc2-3f78-b7d4-afa7be507159",
                                "text": "Befehl vom Bluthund. Wir sollen das Bilgenschwein füttern.\" \"Was sollen wir?\", fragte Sven, der glaubte, nicht recht gehört zu haben."
                            },
                            {
                                "example_id": "239ed7e3-40cd-4b86-9375-05e3e2a9fbdc",
                                "sense_id": "6b0c2513-1fc2-3f78-b7d4-afa7be507159",
                                "text": "Sie dachten an die Fabeln vom sogenannten >Bilgenschwein<, welches dort haust und sich von dieser >Kieljauche< ernährt."
                            },
                            {
                                "example_id": "37227c69-43bd-4885-b3ef-e46ff0178fee",
                                "sense_id": "6b0c2513-1fc2-3f78-b7d4-afa7be507159",
                                "text": "Daher kommt der Mythos, dass es auf jedem Schiff ein Bilgenschwein gibt, das sich von dem fauligen Wasser ernährt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
