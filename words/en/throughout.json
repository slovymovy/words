                        "tr": [
                            {
                                "target_lang_word": "baştan başa",
                                "target_lang_sense_clarification": "içinden geçerek"
                            },
                            {
                                "target_lang_word": "içinden",
                                "target_lang_sense_clarification": "delip geçerek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "76057502-d556-3f15-a2bc-78234a513560",
                    "sense_definition": "In every part of a particular area, object, or place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extent_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house has been renovated and painted <w>throughout</w>.",
