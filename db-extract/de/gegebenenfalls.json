                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dc47041-83de-465d-9ff2-4c0608344e36",
                                                "sense_id": "3f847a47-1326-3080-b111-b688e7929822",
                                                "text": "De Russen hebben de gewoonte de heruitgaven van hun eigen gevestigde namen op een enigszins paternalistische manier van een omstandige inleiding te voorzien, waarin de belangstellende lezer vooraf bij het handje genomen wordt en uitvoerig op de verdiensten, casu quo vergissingen van de desbetreffende auteur gewezen wordt."
                                            }
                                        ]
                                    },
