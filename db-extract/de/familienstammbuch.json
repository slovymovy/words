                "senses": [
                    {
                        "sense_id": "8e92bf2a-f6a5-317c-9a4d-3cc4ad04ad2a",
                        "entry_id": "bd96ac7c-7c3c-34ee-a2d4-45748e1b9840",
                        "glosses": [
                            "Mappe, in der amtliche (teilweise auch kirchliche) Dokumente zu den wesentliche Ereignissen einer Familie gesammelt werden"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "cfb26774-2be2-4300-b208-58f8ba581f00",
                                "sense_id": "8e92bf2a-f6a5-317c-9a4d-3cc4ad04ad2a",
                                "text": "„Ein Familienstammbuch haben viele Familien in Deutschland – wenn vielleicht auch nicht unter dieser speziellen Bezeichnung.“"
                            },
                            {
                                "example_id": "4d757e8e-b4db-4276-a95a-a1dfc661fec1",
                                "sense_id": "8e92bf2a-f6a5-317c-9a4d-3cc4ad04ad2a",
                                "text": "„Der Vollzug der Namensweihe wird genau wie sonst die christliche Taufe in das Familienstammbuch eingetragen.“"
                            },
                            {
                                "example_id": "20466efe-3a1b-4ace-baad-10cb38cacfc8",
                                "sense_id": "8e92bf2a-f6a5-317c-9a4d-3cc4ad04ad2a",
                                "text": "„Eine beliebte Fundgrube ist auch das Familienstammbuch, das die Neuvermählten beim Standesamt zur Eheschließung bekommen.“"
                            },
                            {
                                "example_id": "b3405917-2994-4edf-989f-cebaeea577dc",
                                "sense_id": "8e92bf2a-f6a5-317c-9a4d-3cc4ad04ad2a",
                                "text": "„Im Familienstammbuch, schon vorab überreicht, ist in der Spalte für die Kinder Platz für zehn Eintragungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
