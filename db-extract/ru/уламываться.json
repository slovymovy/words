                "senses": [
                    {
                        "sense_id": "6901483b-f6b3-34b0-ba83-908247bd5871",
                        "entry_id": "b518d612-a8cc-3360-b454-3877ff820df5",
                        "glosses": [
                            "страд. к уламывать"
