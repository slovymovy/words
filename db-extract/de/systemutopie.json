                "senses": [
                    {
                        "sense_id": "96f146b2-085c-393e-a244-611875b4ba50",
                        "entry_id": "910ed981-7c5f-37c9-a020-14ab44a3ec0b",
                        "glosses": [
                            "utopisches Idealbild einer systematisch geregelten Gesellschaft mit ihren Sozialstrukturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb53143-af5b-4806-b884-3a011423cdd8",
                                "sense_id": "96f146b2-085c-393e-a244-611875b4ba50",
                                "text": "„Die Antike kannte generell nur wenige rationale Systemutopien im Sinne der platonischen Politeia.“"
                            },
                            {
                                "example_id": "fa8249ac-c184-4667-9c45-8ee3147f0667",
                                "sense_id": "96f146b2-085c-393e-a244-611875b4ba50",
                                "text": "„Was als geschlossene Systemutopie beginnt, endet bei Wells als dystopische Science Fiction.“"
                            },
                            {
                                "example_id": "850af0f8-dfa3-4ba4-8420-62bc3349969b",
                                "sense_id": "96f146b2-085c-393e-a244-611875b4ba50",
                                "text": "„Antworten auf die Frage der Normativität von System-, Wissenschafts- und Technikmodellen gibt die Lebenswelt als gescheiterte Systemutopie von ganz allein.“"
                            },
                            {
                                "example_id": "d87d866f-8baa-4cd4-9904-7131e32e0228",
                                "sense_id": "96f146b2-085c-393e-a244-611875b4ba50",
                                "text": "„Freilich ist diese Aussage nur dann plausibel, wenn man – wie Fest – die politische Utopie auf die geschlossene autoritäre Systemutopie festlegt.“"
                            },
                            {
                                "example_id": "1fdec007-dd2a-4910-83e3-735022371c18",
                                "sense_id": "96f146b2-085c-393e-a244-611875b4ba50",
                                "text": "„Der Punkt ist folgender: Systemutopien setzen ein Endziel als einem Idealzustand voraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
