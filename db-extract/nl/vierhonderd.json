                                "sense_id": "f4e8f024-232d-36b6-88be-66ed539388db",
                                "text": "Als jij vierhonderd opruimt doe ik de twee kamers daarna wel, want die zijn kleiner."
                            }
                        ]
                    },
                    {
                        "sense_id": "88c6c53b-daec-30a1-860c-24999bd4608c",
                        "entry_id": "5b561e05-3dca-332e-afd5-b87d0778b2d2",
                        "glosses": [
                            "groep van 400 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ccd4908-8a67-4598-ac21-baa1a775d61e",
                                "sense_id": "88c6c53b-daec-30a1-860c-24999bd4608c",
                                "text": "Die vierhonderd kunnen onmogelijk een complete brigade met tanks tegenhouden."
                            }
                        ]
                    }
