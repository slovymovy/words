                        "sense_id": "e0f19120-7560-3b32-a940-a1e56607c9a6",
                        "entry_id": "b979c35e-951f-3ffb-8ba9-1e552a9ef6ed",
                        "glosses": [
                            "Propre ou relatif à François Truffaut et à ses films."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3980260-2c7c-4d68-8fdf-3f7dc19db6a9",
                                "sense_id": "e0f19120-7560-3b32-a940-a1e56607c9a6",
                                "text": "Cette difficulté est directement décelable dans l’insistance des critiques sur l’ambiguïté du cinéma truffaldien, à la fois populaire et original."
                            },
                            {
                                "example_id": "d1df609e-ff78-45e2-be03-637ca80027e3",
                                "sense_id": "e0f19120-7560-3b32-a940-a1e56607c9a6",
                                "text": "La seule évocation de Truffaut fait surgir des musiques, des extraits de films, des noms d’acteurs que l’on soit ou non cinéphile ou truffaldien averti."
                            },
                            {
                                "example_id": "a8909d43-94ab-46d6-a1e5-a9867a78e2b1",
                                "sense_id": "e0f19120-7560-3b32-a940-a1e56607c9a6",
                                "text": "\"Mata-Hari, agent H21\" est truffaldien à plus d’un titre. On y retrouve Jeanne Moreau qui fut la première égérie de Truffaut dans \"Jules et Jim\", réalisé deux ans auparavant."
                            }
                        ]
                    }
                ],
