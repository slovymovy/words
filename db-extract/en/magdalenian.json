                                        "entry_id": "a7a1eb8b-9e14-3773-99ea-fef08d418d80",
                                        "glosses": [
                                            "Relatif à la dernière phase du Paléolithique supérieur européen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce97409a-80b6-44c7-b1a1-a831cc985f91",
                                                "sense_id": "aa482eb9-2205-3868-bb67-30567f4908ad",
                                                "text": "La découverte d’un crâne beaucoup plus récent, de type actuel, trouvé dépourvu de mandibule sur un amas de vestiges magdaléniens, est encore plus probante."
                                            },
                                            {
                                                "example_id": "71100cac-4fed-4952-8974-46bc90107277",
                                                "sense_id": "aa482eb9-2205-3868-bb67-30567f4908ad",
                                                "text": "Il n’y avait pas fouilleur plus délicat que lui pour dégager les vestiges fugaces et les micro-burins des chasseurs magdaléniens."
                                            }
                                        ]
                                    }
                                ]
                            }
