                                        "sense_id": "70a15e31-a290-3602-835f-aaae95e5f7f0",
                                        "entry_id": "b9c78a8c-71d8-33a3-a1cd-899278cee3e9",
                                        "glosses": [
                                            "A strong chest or box used for keeping money or valuables safe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6804bfd8-bdc7-4c22-acfa-e34a84c8b187",
                                                "sense_id": "70a15e31-a290-3602-835f-aaae95e5f7f0",
                                                "text": "\"There is nothing in that,\" said Guido, \"but a genealogy of the Carraras, drawn up by my grandfather. We have kept this little ebony coffer for the sake of its curious carving. The marriage of Cana is beautifully wrought on its lid.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b898363d-85c7-328d-b056-90804cd5a158",
                                        "entry_id": "b9c78a8c-71d8-33a3-a1cd-899278cee3e9",
                                        "glosses": [
                                            "An ornamental sunken panel in a ceiling or dome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5f1efad-a64e-4c2d-bd4f-892208f446b3",
                                                "sense_id": "b898363d-85c7-328d-b056-90804cd5a158",
                                                "text": "Prolapsed and waterstained ceiling, the sagging coffers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990752b7-9877-338d-9882-7d0610960516",
                                        "entry_id": "b9c78a8c-71d8-33a3-a1cd-899278cee3e9",
                                        "glosses": [
                                            "A cofferdam."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2e6af94-7196-3b7a-beea-a40a2e42e81e",
                                        "entry_id": "b9c78a8c-71d8-33a3-a1cd-899278cee3e9",
                                        "glosses": [
                                            "A supply or store of money, often belonging to an organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b3221f-2a74-4d9a-87d7-6fb3f56e2225",
                                                "sense_id": "e2e6af94-7196-3b7a-beea-a40a2e42e81e",
                                                "text": "c. 1610–1620 (written), 1661 (first published), Francis Bacon, Letter of Advice to the Duke of Buckingham\nHe would discharge it without any great burden to the queen's coffers."
                                            },
                                            {
                                                "example_id": "072730c9-3902-462c-9884-0ed432bc85d0",
                                                "sense_id": "e2e6af94-7196-3b7a-beea-a40a2e42e81e",
                                                "text": "Hold, there is half my coffer."
                                            },
                                            {
                                                "example_id": "dc273bd7-2ba7-4739-b25f-ec478abfbf75",
                                                "sense_id": "e2e6af94-7196-3b7a-beea-a40a2e42e81e",
                                                "text": "The coffers were empty, and the first thing to be done was to devise some means by which we could raise a revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ef2e52-21ea-3cbe-9eff-b335f15a051e",
                                        "entry_id": "b9c78a8c-71d8-33a3-a1cd-899278cee3e9",
                                        "glosses": [
                                            "A trench dug in the bottom of a dry moat, and extending across it, to enable the besieged to defend it with raking fire."
                                        ],
