                "senses": [
                    {
                        "sense_id": "b4296300-dace-3cfb-927f-b2eac192e719",
                        "entry_id": "875f6968-69b1-32f9-8a24-01daafa7d354",
                        "glosses": [
                            "sich ausschließlich vom Blut anderer Säugetiere oder Vögel ernährende Fledermausart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3602a083-29bc-45b9-a907-b76cf4bb5378",
                                "sense_id": "b4296300-dace-3cfb-927f-b2eac192e719",
                                "text": "„Eine Tätowierung auf der Innenseite seines Handgelenks zeigte eine Vampirfledermaus, vielleicht war es auch eine langstielige Doppelaxt.“"
                            },
                            {
                                "example_id": "198ee6d1-ff2e-4070-8f7c-abfbb659de3b",
                                "sense_id": "b4296300-dace-3cfb-927f-b2eac192e719",
                                "text": "„Der Zahn ähnelte dem einer Schlange oder Vampirfledermaus.“"
                            },
                            {
                                "example_id": "f9e00cee-7001-4a9a-acfb-8026ea2c5bc5",
                                "sense_id": "b4296300-dace-3cfb-927f-b2eac192e719",
                                "text": "„Beim Anblick der Vampirfledermäuse hier und der majestätischen Wasserfälle aus stinkender Scheiße würde sich jeder Erwachsene wahrscheinlich in die Hose machen.“"
                            },
                            {
                                "example_id": "18112aa3-0ee2-43b0-8681-a701db885f55",
                                "sense_id": "b4296300-dace-3cfb-927f-b2eac192e719",
                                "text": "„Der Junge kroch unter Häuser und auf Dachböden und war auch nicht zimperlich, wenn es um Vampirfledermäuse ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
