                        "source_sense_id": "4ad4fb40-0eca-3921-993d-d6bc3d37094e",
                        "source_sense_description": "in het begin",
                        "target_lang_word": "for a start",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
