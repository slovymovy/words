                "senses": [
                    {
                        "sense_id": "15c7b827-2ed9-36cb-a0dc-7ddc5b1d6765",
                        "entry_id": "b505dfcb-5d4d-35f4-a41b-fb85c64f5b9d",
                        "glosses": [
                            "A rich, embroidered brocade used for clothing in the Middle Ages, the web being gold and the woof silk."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "05ba3d60-07c5-3ba6-bf3d-329fff6b41a5",
                        "entry_id": "b505dfcb-5d4d-35f4-a41b-fb85c64f5b9d",
                        "glosses": [
                            "A canopy suspended over an altar or throne, originally made of this fabric; a ciborium."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "99410449-36af-49a9-b28c-9f71628e4f7d",
                                "sense_id": "05ba3d60-07c5-3ba6-bf3d-329fff6b41a5",
                                "text": "Bernini had already provided the chief coup de théâtre of the basilica's interior, the monumental bronze canopy or baldachino over the high altar and tomb of St Peter."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca3efcd2-5c13-356b-ae17-7bc0684f222d",
                        "entry_id": "b505dfcb-5d4d-35f4-a41b-fb85c64f5b9d",
                        "glosses": [
                            "A building in the form of a canopy, or a crown supported by pillars for the covering of an altar; a canopy carried over the host in Roman Catholic countries."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "df5b8b3c-db7c-4bb4-bd2d-c93fadd6d687",
                                "sense_id": "ca3efcd2-5c13-356b-ae17-7bc0684f222d",
                                "text": "BALDACHIN is a Building in form of a Canopy, or Crown ſupported by Pillars, often ſerving for the Covering of an Altar; Alſo a Canopy carried over the Hoſt in Popiſh Countries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "988c6329-4e3f-438b-8d6c-7c0da7db7844",
                        "source_entry_id": "b505dfcb-5d4d-35f4-a41b-fb85c64f5b9d",
