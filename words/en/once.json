                    "sense_definition": "One and only one time; on one occasion only.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "frequency_count",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have visited that museum only <w>once</w> in my life.",
                            "target_lang_translations": {
                                "ru": "Я был в этом музее всего <w>один раз</w> в жизни.",
                                "nl": "Ik heb dat museum slechts <w>één keer</w> in mijn leven bezocht.",
                                "pl": "Odwiedziłem to muzeum tylko <w>raz</w> w życiu.",
                                "de": "Ich habe dieses Museum in meinem Leben nur <w>einmal</w> besucht.",
                                "fr": "Je n'ai visité ce musée qu'<w>une fois</w> dans ma vie.",
                                "it": "Ho visitato quel museo solo <w>una volta</w> in vita mia.",
                                "cs": "To muzeum jsem navštívil pouze <w>jednou</w> v životě.",
                                "tr": "Hayatımda o müzeyi sadece <w>bir kez</w> ziyaret ettim.",
                                "es": "He visitado ese museo solo <w>una vez</w> en mi vida.",
                                "zh": "我这辈子只去过那家博物馆<w>一次</w>。"
                            }
                        },
                        {
                            "text": "Please read the instructions <w>once</w> more before you start.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте инструкции <w>ещё раз</w> перед началом.",
                                "nl": "Lees de instructies alstublieft nog <w>eens</w> door voordat u begint.",
                                "pl": "Przeczytaj instrukcję jeszcze <w>raz</w>, zanim zaczniesz.",
                                "de": "Bitte lesen Sie die Anweisungen noch <w>einmal</w>, bevor Sie beginnen.",
                                "fr": "Veuillez lire les instructions <w>une</w> nouvelle fois avant de commencer.",
                                "it": "Per favore, leggi le istruzioni <w>ancora una</w> volta prima di iniziare.",
                                "cs": "Před začátkem si prosím přečtěte pokyny ještě <w>jednou</w>.",
                                "tr": "Lütfen başlamadan önce talimatları <w>bir kez</w> daha okuyun.",
                                "es": "Por favor, lee las instrucciones <w>una</w> vez más antes de empezar.",
                                "zh": "开始前请把说明再读<w>一遍</w>。"
                            }
                        }
