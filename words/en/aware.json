{
    "word_family": [
        "awareness",
        "unaware"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7bf18e19-0b04-3ce1-9f7e-48b808d5ca92",
                    "sense_definition": "Conscious or having knowledge of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you <w>aware</w> of the risks involved in this decision?",
                            "target_lang_translations": {
                                "ru": "Вы <w>осознаёте</w> риски, связанные с этим решением?",
                                "zh": "你<w>意识到</w>这个决定所涉及的风险了吗？",
                                "pl": "Czy jesteś <w>świadomy</w> ryzyka związanego z tą decyzją?"
                            }
                        },
                        {
                            "text": "I was not <w>aware</w> that the meeting had been cancelled.",
                            "target_lang_translations": {
                                "ru": "Я был не <w>в курсе</w>, что встречу отменили.",
                                "zh": "我没<w>察觉</w>到会议已经被取消了。",
                                "pl": "Nie byłem <w>świadomy</w>, że spotkanie zostało odwołane."
                            }
                        }
                    ],
                    "synonyms": [
                        "conscious",
                        "informed",
                        "mindful",
                        "cognizant",
                        "apprised"
                    ],
                    "antonyms": [
                        "unaware"
                    ],
                    "common_phrases": [
                        "aware of",
                        "well aware",
                        "become aware",
                        "make aware"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знающий или осведомлённый о чём-либо; понимающий ситуацию.",
                        "zh": "知道或了解某事。",
                        "pl": "Posiadający wiedzę o czymś lub zdający sobie sprawę z jakiegoś faktu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осведомлённый",
                                "target_lang_sense_clarification": "обладающий информацией о чём-либо"
                            },
                            {
                                "target_lang_word": "в курсе",
                                "target_lang_sense_clarification": "разговорное выражение; знающий о текущей ситуации"
                            },
                            {
                                "target_lang_word": "осознающий",
                                "target_lang_sense_clarification": "понимающий смысл или последствия чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意识到",
                                "target_lang_sense_clarification": "对某事有认知或理解"
                            },
                            {
                                "target_lang_word": "知道",
                                "target_lang_sense_clarification": "了解某事的情况"
                            },
                            {
                                "target_lang_word": "察觉",
                                "target_lang_sense_clarification": "发觉或注意到某事"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "świadomy",
                                "target_lang_sense_clarification": "mający świadomość czegoś, zdający sobie sprawę z faktów"
                            },
                            {
                                "target_lang_word": "świadom",
                                "target_lang_sense_clarification": "literacka forma przymiotnika, często używana w konstrukcjach z dopełniaczem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcc12e07-4516-3982-80e9-c46bb6940df2",
                    "sense_definition": "Vigilant or on one's guard against danger or difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vigilance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to stay <w>aware</w> of your surroundings when walking alone at night.",
                            "target_lang_translations": {
                                "ru": "Нужно быть <w>внимательным</w> к происходящему вокруг, когда гуляешь один ночью.",
                                "zh": "晚上独自走路时，你需要对周围环境保持<w>警惕</w>。",
                                "pl": "Musisz zachować <w>czujność</w> wobec otoczenia, gdy spacerujesz samotnie w nocy."
                            }
                        },
                        {
                            "text": "Drivers must be <w>aware</w> of pedestrians crossing the street.",
                            "target_lang_translations": {
                                "ru": "Водители должны быть <w>внимательны</w> к пешеходам, переходящим улицу.",
                                "zh": "司机必须<w>留心</w>过马路的行人。",
                                "pl": "Kierowcy muszą być <w>uważni</w> na pieszych przechodzących przez ulicę."
                            }
                        }
                    ],
                    "synonyms": [
                        "alert",
                        "watchful",
                        "wary",
                        "attentive",
                        "observant"
                    ],
                    "common_phrases": [
                        "stay aware",
                        "fully aware"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бдительный, настороже по отношению к опасности или трудностям.",
                        "zh": "对危险或困难保持警惕或防范。",
                        "pl": "Czujny, uważny lub zachowujący ostrożność wobec zagrożeń."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бдительный",
                                "target_lang_sense_clarification": "сохраняющий настороженность"
                            },
                            {
                                "target_lang_word": "внимательный",
                                "target_lang_sense_clarification": "обращающий внимание на окружение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警惕",
                                "target_lang_sense_clarification": "对可能出现的危险保持戒备"
                            },
                            {
                                "target_lang_word": "留心",
                                "target_lang_sense_clarification": "注意周围环境以防意外"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "czujny",
                                "target_lang_sense_clarification": "zachowujący uwagę, gotowy na reakcję"
                            },
                            {
                                "target_lang_word": "uważny",
                                "target_lang_sense_clarification": "skupiony na otoczeniu, spostrzegawczy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c13b1c8-adb7-3288-a4ce-588551a617cc",
                    "sense_definition": "To make someone aware of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The messenger <w>awared</w> the king of the approaching army.",
                            "target_lang_translations": {
                                "ru": "Гонец <w>осведомил</w> короля о приближающейся армии.",
                                "zh": "信使向国王<w>告知</w>了敌军逼近的消息。",
                                "pl": "Posłaniec <w>poinformował</w> króla o zbliżającej się armii."
                            }
                        },
                        {
                            "text": "His conscience <w>awares</w> him of the difference between right and wrong.",
                            "target_lang_translations": {
                                "ru": "Его совесть <w>даёт</w> ему <w>понять</w> разницу между добром и злом.",
                                "zh": "他的良知<w>使</w>他<w>意识到</w>了是非对错的区别。",
                                "pl": "Jego sumienie <w>uświadamia</w> mu różnicę między dobrem a złem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is very rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставить кого-либо в известность о чём-либо.",
                        "zh": "使某人了解某事。",
                        "pl": "Poinformować kogoś o czymś lub uświadomić komuś jakiś fakt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осведомлять",
                                "target_lang_sense_clarification": "сообщать сведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "告知",
                                "target_lang_sense_clarification": "通知某人相关信息"
                            },
                            {
                                "target_lang_word": "使……意识到",
                                "target_lang_sense_clarification": "让某人对某事产生认知"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uświadamiać",
                                "target_lang_sense_clarification": "sprawiać, że ktoś zaczyna coś rozumieć"
                            },
                            {
                                "target_lang_word": "informować",
                                "target_lang_sense_clarification": "przekazywać komuś wiadomości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}