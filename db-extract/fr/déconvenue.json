                        ]
                    },
                    {
                        "translation_id": "69fa0fc3-053d-4777-973b-1091c41a68b5",
                        "source_entry_id": "29a6563a-4b6c-3516-98a4-eb418012476d",
                        "source_sense_id": "cf98148c-8d44-3586-b991-d0c69becf57e",
                        "target_lang_word": "discomfiture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discomfiture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "795c705a-5540-3ead-a6b2-1ec78bf9ee47",
                                        "entry_id": "e4089d71-a1b3-306a-b6a8-48124df3692c",
                                        "glosses": [
                                            "Defeat in battle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "242ba24f-db28-3eff-92e2-f0d73f8fee9e",
                                        "entry_id": "e4089d71-a1b3-306a-b6a8-48124df3692c",
                                        "glosses": [
                                            "An emotional state similar to that arising from defeat; frustration, disappointment, perplexity or embarrassment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ac9e44-fc41-4974-8141-9588eff8bfb0",
                                                "sense_id": "242ba24f-db28-3eff-92e2-f0d73f8fee9e",
                                                "text": "Some of us are concerned because as yet the South shows no penitence. But what exactly do we mean by this? Since down to the close of the war she never confessed any for braving it, the only penitence now left her is that which springs solely from the sense of discomfiture; and since this evidently would be a contrition hypocritical, it would be unworthy in us to demand it."
                                            },
                                            {
                                                "example_id": "2694516f-c750-4833-8011-51570c246371",
                                                "sense_id": "242ba24f-db28-3eff-92e2-f0d73f8fee9e",
                                                "text": "One of them ended its career as a passenger carrying vehicle in 1907, by freezing in Kemp Town Tunnel, to the discomfiture of some important season ticket holders, who did not hesitate to let the directors know what they thought about the incident."
                                            },
                                            {
                                                "example_id": "dee5dd42-3720-420f-9ea7-598c9d282b5f",
                                                "sense_id": "242ba24f-db28-3eff-92e2-f0d73f8fee9e",
                                                "text": "Other countries are not so much angry as avid to exploit the discomfiture of the US or the chaos in the region or both."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4b3a004-901c-4d22-bd67-de18b359a63f",
                        "source_entry_id": "29a6563a-4b6c-3516-98a4-eb418012476d",
                        "source_sense_id": "cf98148c-8d44-3586-b991-d0c69becf57e",
                        "target_lang_word": "disappointment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disappointment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9a2428e-b8a7-3a89-bd7f-1454d45569cf",
                                        "entry_id": "dd6a4577-aaf3-3efb-9fa3-6728d356e852",
                                        "glosses": [
                                            "The feeling or state of being disappointed: a feeling of sadness or frustration when something is not as good as one hoped or expected, or when something bad unexpectedly happens."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1344962b-c74f-464c-968c-911780a3a7f0",
                                                "sense_id": "e9a2428e-b8a7-3a89-bd7f-1454d45569cf",
                                                "text": "Even a trip to beautiful California can cause disappointment."
                                            },
                                            {
                                                "example_id": "38fa1b73-63c0-48e6-9867-994688033896",
                                                "sense_id": "e9a2428e-b8a7-3a89-bd7f-1454d45569cf",
                                                "text": "They remembered too keenly their pleasant credulity as to what to-morrow would bring forth, to dare indulge expectation of its pleasure; they had been disappointed once—so might they be again—for disappointment ever leaves fear behind."
                                            },
                                            {
                                                "example_id": "3ef98ef3-cbda-455b-8fee-5493ed84f49b",
                                                "sense_id": "e9a2428e-b8a7-3a89-bd7f-1454d45569cf",
                                                "text": "Choking back his disappointment after his own team's splendid wins against Liverpool and Aston Villa, he said: \"I've got to be humble and say we were beaten by a very good side.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d9c5bf8-d46d-39ba-ab14-138fab5f3919",
                                        "entry_id": "dd6a4577-aaf3-3efb-9fa3-6728d356e852",
                                        "glosses": [
                                            "An example or the act of disappointing: a circumstance in which a positive expectation is not achieved."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25990bac-5d5a-4f71-9a35-d58ad03f7c95",
                                                "sense_id": "4d9c5bf8-d46d-39ba-ab14-138fab5f3919",
                                                "text": "The disappointment with our trip to California caused bickering."
                                            },
                                            {
                                                "example_id": "07c99747-2233-4eca-95db-2231810410d7",
                                                "sense_id": "4d9c5bf8-d46d-39ba-ab14-138fab5f3919",
                                                "text": "For Liverpool, their season will now be regarded as a relative disappointment after failure to add the FA Cup to the Carling Cup and not mounting a challenge to reach the Champions League places."
                                            },
                                            {
                                                "example_id": "1dd9520d-29e3-41bb-b4ca-275245d405ab",
                                                "sense_id": "4d9c5bf8-d46d-39ba-ab14-138fab5f3919",
                                                "text": "As the disappointments crowded in — the economy, Rhodesia, strife within the trade-union movement — Wilson tried the expedient of a semi-formal inner Cabinet, or Parliamentary Committee, as he misleadingly liked to call it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96557a35-3812-3da2-87b0-d9c585ee8852",
                                        "entry_id": "dd6a4577-aaf3-3efb-9fa3-6728d356e852",
                                        "glosses": [
                                            "Something or someone that disappoints: that which causes disappointment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc628c61-7f0f-4071-babb-cb16a12acf6c",
                                                "sense_id": "96557a35-3812-3da2-87b0-d9c585ee8852",
                                                "text": "Even a trip to beautiful California can be a disappointment."
                                            },
                                            {
                                                "example_id": "bce4d643-9938-4bfe-a691-85834914b491",
                                                "sense_id": "96557a35-3812-3da2-87b0-d9c585ee8852",
                                                "text": "What a disappointment!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
