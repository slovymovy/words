                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6afa39-ddcf-40ec-b304-785470ccbe75",
                                "sense_id": "37911068-4eec-3d03-94ee-4d0d23aa4b89",
                                "text": "„Seine Haut, sonst immer straff und leicht gebräunt, wirkte schlaff und fahl, und die dunklen Ringe unter seinen Augen sahen aus wie mit Kohlestift hingemalt.“"
                            },
                            {
                                "example_id": "230104c9-7b58-4153-b29a-4aacb92f68f2",
                                "sense_id": "37911068-4eec-3d03-94ee-4d0d23aa4b89",
                                "text": "„Er stieg as Letzter zu. Seine Finger schmutzig und fleckig von Pastellfarben und Kohlestiften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
