                "senses": [
                    {
                        "sense_id": "a5ada95a-22c2-3fa1-add5-f142d8c3853a",
                        "entry_id": "33d1e410-f2ff-3de3-bb47-34a704311bf5",
                        "glosses": [
                            "Amerrir sur un lac."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f71d413b-091e-44b2-97b6-621d6b16e156",
                                "sense_id": "a5ada95a-22c2-3fa1-add5-f142d8c3853a",
                                "text": "Ce lancement reste célèbre ce 26 mars 1912. L’appareil réussit à quitter l’eau sur quelque 80 m avant d’alaquer avec difficulté."
                            },
                            {
                                "example_id": "cc0dcf4b-71a3-4efe-92d8-f1199362c009",
                                "sense_id": "a5ada95a-22c2-3fa1-add5-f142d8c3853a",
                                "text": "La 34ᵉ étape est la bonne, il quitte la Hollande à 11h38 GMT par temps brumeux et fort vent arrière. Il alaque à Genève à 15h50 heure locale."
                            }
                        ]
                    }
