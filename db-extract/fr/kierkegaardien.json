                        "glosses": [
                            "Qui découle ou s'apparente à la pensée de Søren Kierkegaard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bbef382-284f-450e-87c7-761a6662c584",
                                "sense_id": "5825c394-d029-383a-8b08-82bcf7184d9d",
                                "text": "Dans les éclairs de la pensée kierkegaardienne, on entrevoit des abîmes qui ressemblent singulièrement à une révélation."
                            },
                            {
                                "example_id": "861f3341-0f62-4c0a-92dc-87f09ce99557",
                                "sense_id": "5825c394-d029-383a-8b08-82bcf7184d9d",
                                "text": "Toute passion se nourrit de négation, parce qu’elle assume et souffre l’exception, au sens kierkegaardien du terme. Elle exile celui qui la vit."
                            }
                        ]
                    }
                ],
