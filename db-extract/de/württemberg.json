                            {
                                "example_id": "21f51e64-b7e2-4799-af0b-9f9590629fd5",
                                "sense_id": "f8b76b0c-9584-3b85-89e5-eed68868e641",
                                "text": "Mit Wirkung vom 1. Januar 1806 wurde Württemberg zum Königreich erhoben. Heute ist es Teil des Bundeslandes Baden-Württemberg."
                            }
                        ],
