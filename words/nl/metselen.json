                    "frequency": "Middle",
                    "semantic_group_id": "bouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman is de hele middag bezig om de nieuwe buitenmuur te <w>metselen</w>.",
                            "target_lang_translations": {
                                "en": "The craftsman spent the whole afternoon <w>laying bricks</w> for the new exterior wall."
                            }
                        },
                        {
                            "text": "In een mum van tijd <w>metselden</w> zij een nieuwe muur voor de garage.",
                            "target_lang_translations": {
                                "en": "In no time at all, they <w>built</w> a new brick wall for the garage."
                            }
                        }
                    ],
                    "synonyms": [
                        "metsen"
                    ],
                    "common_phrases": [
                        "een muur metselen",
                        "met bakstenen metselen"
                    ],
                    "target_lang_definitions": {
