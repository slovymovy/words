                "senses": [
                    {
                        "sense_id": "e44e276b-b172-3212-a273-d26e570e61a4",
                        "entry_id": "b6181101-9523-3656-bc56-85fe18eec309",
                        "glosses": [
                            "besonders ernst zu nehmender Mitbewerber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a97a769-70c2-443e-86d2-3c89f7753939",
                                "sense_id": "e44e276b-b172-3212-a273-d26e570e61a4",
                                "text": "„Das Unternehmen ist der nach Umsatz zweitgrößte Druckmaschinenbauer der Welt, Hauptkonkurrent ist Heidelberger Druck.“"
                            },
                            {
                                "example_id": "f748db41-29da-4ed8-9950-58716fde4716",
                                "sense_id": "e44e276b-b172-3212-a273-d26e570e61a4",
                                "text": "„Wie viele Schweizer Industriefirmen macht Benninger auch die Erfahrung, dass ein Hauptkonkurrent mittlerweile aus China stammt.“"
                            },
                            {
                                "example_id": "0b604b5d-3c9b-434f-96b3-5446bb1aba37",
                                "sense_id": "e44e276b-b172-3212-a273-d26e570e61a4",
                                "text": "„Er und sein Hauptkonkurrent Raila Odinga gehören den größten Ethnien im Land an - Kenyatta den Kikuyu, die seit der Unabhängigkeit die kenianische Politik dominieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
