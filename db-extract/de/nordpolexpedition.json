                "senses": [
                    {
                        "sense_id": "58181ba2-b196-389a-a5ce-e3372abc134f",
                        "entry_id": "939e4820-4f23-34d5-8eb4-31f062fed36e",
                        "glosses": [
                            "(Forschungs-)Reise zum nördlichsten Punkt der Erde (Nordpol)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24781289-f151-4c52-b953-7d04ec330e8a",
                                "sense_id": "58181ba2-b196-389a-a5ce-e3372abc134f",
                                "text": "„Der zweiten Deutschen Nordpolexpedition war vorbehalten, weiteres Licht über diese entlegenen Gestade zu verbreiten.“"
                            },
                            {
                                "example_id": "d1c1f4c3-b2c1-47be-8087-819fc9f1ceb0",
                                "sense_id": "58181ba2-b196-389a-a5ce-e3372abc134f",
                                "text": "„Varta-Batterien sind aufgrund ihrer Zuverlässigkeit bei der ersten Nordpolexpedition dabei gewesen und auch bei der Mondlandung.“"
                            },
                            {
                                "example_id": "a78fca03-a762-446a-aa17-62c8d96e9d7a",
                                "sense_id": "58181ba2-b196-389a-a5ce-e3372abc134f",
                                "text": "„Jules Verne rettete seinen Romanhelden Kapitän Hatteras, dem auf seiner Nordpolexpedition das Feuer abhanden gekommen war, dadurch vor dem Verhungern und Erfrieren, dass er seinen Begleiter aus Eis ein Brennglas fertigen liess.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
