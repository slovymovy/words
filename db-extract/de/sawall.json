                ],
                "senses": [
                    {
                        "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                        "entry_id": "e8eb51b4-4a6d-3d4c-8014-1b71d128252d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9767fee7-ae29-4a65-a7bc-8af5da7e41da",
                                "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                                "text": "Frau Sawall ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ab324c29-b3c3-489c-a8ad-cac092e121fb",
                                "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                                "text": "Herr Sawall wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e073ff9c-23bf-4618-b384-8d1c586f41fa",
                                "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                                "text": "Die Sawalls fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "55b3e0bc-0652-4321-acdb-fd920bf28edd",
                                "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                                "text": "Der Sawall trägt nie die Pullover, die die Sawall ihm strickt."
                            },
                            {
                                "example_id": "70cee492-8c79-4d59-94ad-1a4fb8c1db2e",
                                "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sawall kommt, geht der Herr Sawall.“"
                            },
                            {
                                "example_id": "3cc7e31d-77f1-48a8-ac8a-d92c3e1b9600",
                                "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                                "text": "Sawall kommt und geht."
                            },
                            {
                                "example_id": "a39f0155-c21b-4538-94fe-74c0e46bf71e",
                                "sense_id": "e3077d34-66f1-3b28-8700-ea006f6bb9f3",
                                "text": "Sawalls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
