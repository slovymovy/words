                        "sense_id": "43ef5f88-2f60-3d4d-a058-27dce14916b2",
                        "entry_id": "90c9a602-448e-3fec-9e55-b55dcb5e2e06",
                        "glosses": [
                            "A warehouse."
                        ],
                        "tags": [
                            "Africa",
                            "East",
                            "Hong-Kong",
