                ],
                "senses": [
                    {
                        "sense_id": "5f6038d4-2ed9-3daf-a9de-aa97f30b6641",
                        "entry_id": "de8f95c9-85c5-3e62-9b6b-124c982b8e94",
                        "glosses": [
                            "vereinheitlichte deutsche Rechtsverordnung zu Bauleistungen aller Gewerke und deren Sicherheitsstandard in allen 16 Bundesländern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8f0d1e-58a6-4bec-9829-d6c6441e64ea",
                                "sense_id": "5f6038d4-2ed9-3daf-a9de-aa97f30b6641",
                                "text": "„Vor diesem Hintergrund hat die 98. Bauministerkonferenz am 03./04.06.1999 einmütig die Notwendigkeit einer Musterbauordnung als Orientierungswert für die Bauordnungsgesetzgebung der Länder bekräftigt.“"
                            },
                            {
                                "example_id": "ef96b795-2e4b-4b03-b62c-cdad08b997a5",
                                "sense_id": "5f6038d4-2ed9-3daf-a9de-aa97f30b6641",
                                "text": "„Die Musterbauordnung (MBO) ist eine Standard- und Mindestbauordnung, die den Ländern als Grundlage für deren jeweilige Landesbauordnungen dient.“"
                            },
                            {
                                "example_id": "5ea9954d-fd8a-47a6-9e05-2a0b5238daca",
                                "sense_id": "5f6038d4-2ed9-3daf-a9de-aa97f30b6641",
                                "text": "„Grundlage für die Erstellung der Musterfeuerungsverordnung (MFeuV) bildet § 85 Abs. 1 der Musterbauordnung (MBO) in der Fassung vom November 2002 mit den Änderungen von 2008 und für die Feuerungsverordnungen in den Bundesländern der jeweils entsprechende Paragraf in den Landesbauordnungen, der die Ermächtigungen für die jeweilige oberste auaufsichtsbehörde enthält, durch Rechtsvorschriften (wie z. B. die FeuV) Vorschriften zu erlassen […]“"
                            },
                            {
                                "example_id": "d35953f4-927f-4fcd-b83f-44c14d212d1f",
                                "sense_id": "5f6038d4-2ed9-3daf-a9de-aa97f30b6641",
                                "text": "„Die Musterbauordnung (MBO) ist eine Standard- und Mindestbauordnung, die von den Sachverständigen der Arbeitsgemeinschaft für Städtebau, Bau- und Wohnungswesen zuständigen Minister und Senatoren der 16 Bundesländer (ARGEBAU) ausgearbeitet worden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
