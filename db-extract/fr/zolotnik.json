                        "cross_references": [
                            {
                                "target_word": "золотни́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "73ead349-94ac-3ec4-8b50-41801674997b",
                                        "entry_id": "919163ce-9907-38d3-b1d0-cb4eef556c91",
                                        "glosses": [
                                            "истор. старая русская мера веса (массы), равная 4,266 грамма или 1/96 фунта, употреблявшаяся до введения метрической системы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf74985-d0f0-4a82-be12-30af0764e9c5",
                                                "sense_id": "73ead349-94ac-3ec4-8b50-41801674997b",
                                                "text": "Можно вычислить, что два дредноута, весом по 25.000 тонн каждый, плавая на расстоянии целой версты один от другого, взаимно притягиваются с силою в 1 золотник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fec048-e9ab-3cbb-b37d-c183f6cde5ef",
                                        "entry_id": "919163ce-9907-38d3-b1d0-cb4eef556c91",
                                        "glosses": [
                                            "гирька весом 4,266 грамма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f23db9-ab33-4395-b500-9dedf8431f14",
                                                "sense_id": "11fec048-e9ab-3cbb-b37d-c183f6cde5ef",
                                                "text": "Антоша тотчас же вообразил, что хохлушка, о которой шла речь, вероятно нечаянно проглотила тот самый медный золотник, который кладётся на весы, когда отвешивается на две копейки чаю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887f1e55-df91-38f0-8eec-c0a9de587792",
                                        "entry_id": "919163ce-9907-38d3-b1d0-cb4eef556c91",
                                        "glosses": [
                                            "перен. чрезвычайно малое количество чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d16f63f8-cf66-47f7-915d-dffd1e8d0fb6",
                                                "sense_id": "887f1e55-df91-38f0-8eec-c0a9de587792",
                                                "text": "Всё лишнее отброшено: был взвешен каждый золотник и учтена всякая мелочь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27277fbf-b40e-3ea7-b0af-e0dfa5aa1440",
                                        "entry_id": "919163ce-9907-38d3-b1d0-cb4eef556c91",
                                        "glosses": [
                                            "устар. старатель на золотых приисках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b589405-f390-497c-9e74-1185588c3c21",
                                                "sense_id": "27277fbf-b40e-3ea7-b0af-e0dfa5aa1440",
                                                "text": "А ты видал, в каких сапогах майновские-то золотники ходят?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed628455-5328-34c9-983b-94b43ac679fc",
                                        "entry_id": "919163ce-9907-38d3-b1d0-cb4eef556c91",
                                        "glosses": [
                                            "устар. парчовый сарафан, шитая золотом золотная женская одежда"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1931bcda-9dcd-3b0a-8aad-4c73589a4dd9",
                                        "entry_id": "919163ce-9907-38d3-b1d0-cb4eef556c91",
                                        "glosses": [
                                            "прост. железный колчедан, минерал похожий на золото"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80d9b093-4fc6-3752-9dae-7202eed18e74",
                                        "entry_id": "919163ce-9907-38d3-b1d0-cb4eef556c91",
                                        "glosses": [
                                            "то же, что золототысячник"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "золотни́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e92af9e9-0cf9-3685-9709-02ac82be3e83",
                                        "entry_id": "380d7a1d-ca4a-38fd-b4e8-3a497c4df6c8",
                                        "glosses": [
                                            "техн. устройство, служащее для автоматического управления потоком пара (жидкости, газа) в тепловых, гидравлических и пневматических машинах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7279df-baa5-4f7f-93c5-86ff477475d4",
                                                "sense_id": "e92af9e9-0cf9-3685-9709-02ac82be3e83",
                                                "text": "Золотник закрывает доступ рабочей жидкости в сервомотор, и поршень последнего остается неподвижным."
                                            },
                                            {
                                                "example_id": "b534639c-b8ee-4c47-b54f-dabe791c714d",
                                                "sense_id": "e92af9e9-0cf9-3685-9709-02ac82be3e83",
                                                "text": "Если поршень действуетъ непосредственно на свой золотникъ, то действ1е машины невозможно, потому что поршень долженъ остановиться вследств1е неупругости воды въ тотъ моментъ, когда золотникъ закрываетъ пролетъ,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6724155c-1f9a-33b0-a522-5d6b43f8ce8a",
                                        "entry_id": "380d7a1d-ca4a-38fd-b4e8-3a497c4df6c8",
                                        "glosses": [
                                            "то же, что золотниковый клапан, устройство, направляющее поток жидкости или газа путём смещения подвижной части относительно окон в поверхности, по которой она скользит"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3579a10-d5c7-4637-bec8-21cc3cd2b0ae",
                                                "sense_id": "6724155c-1f9a-33b0-a522-5d6b43f8ce8a",
                                                "text": "— Я забыл, что надо нажимать головой на клапан «головного золотника», — выпускать лишний воздух — «травить воздух», как говорил Протчев."
                                            },
                                            {
                                                "example_id": "3cdf283c-d047-45e8-ac91-109458c1ecf9",
                                                "sense_id": "6724155c-1f9a-33b0-a522-5d6b43f8ce8a",
                                                "text": "Впуск воздуха в камеры горения производится при помощи двух золотников НН, приводимых в движение мотором М. В период сжатия в камеры горения JJ жидкое топливо вбрызгивается при помощи особого насоса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1dd18a-2d8c-3f2e-a0d2-369d2c084321",
                                        "entry_id": "380d7a1d-ca4a-38fd-b4e8-3a497c4df6c8",
                                        "glosses": [
                                            "воздушный невозвратный клапан автомобильной шины; часть ниппеля"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a86328e-81bf-39fa-87d7-ae7b96986dba",
                                        "entry_id": "380d7a1d-ca4a-38fd-b4e8-3a497c4df6c8",
                                        "glosses": [
                                            "устар. то же, что матка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b8601a-94c7-478d-a847-97b011abfcc8",
                                                "sense_id": "8a86328e-81bf-39fa-87d7-ae7b96986dba",
                                                "text": "опущение золотника, золотник поставить на место"
                                            },
                                            {
                                                "example_id": "5e7b07b6-cc41-4686-9eb7-004b35dded8d",
                                                "sense_id": "8a86328e-81bf-39fa-87d7-ae7b96986dba",
                                                "text": "Не ходи, золотник, по утробе, // Не ищите младенца, он здесь, // Он идёт — его мать да отец ждёт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7d46bf4-450c-31a1-928b-26e508986f66",
                                        "entry_id": "380d7a1d-ca4a-38fd-b4e8-3a497c4df6c8",
                                        "glosses": [
                                            "то же, что задний проход"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
