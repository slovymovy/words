                    },
                    {
                        "form_id": "08a2a9f1-c857-4bca-a42d-f3c50700d9c4",
                        "entry_id": "bd35f2cb-22ec-3944-b9b2-cdf70d82a09b",
                        "tags": [
                            "feminine"
                        ],
                        "form": "vêtue"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d210dad7-ebf1-30c1-978e-0493ead9b323",
                        "entry_id": "bd35f2cb-22ec-3944-b9b2-cdf70d82a09b",
                        "glosses": [
                            "Celui qui est habillé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7f0dc2-4f1d-45e0-abb8-ecc4200ca0f3",
                                "sense_id": "d210dad7-ebf1-30c1-978e-0493ead9b323",
                                "text": "Le vêtu de noir, magister de village, etoit frère du curé, et le vêtu de gris, sergent du même village, etoit frère de l’hôte."
                            }
                        ]
                    },
                    {
                        "sense_id": "16a6410b-f59c-3963-98ce-6f1a57fff848",
                        "entry_id": "bd35f2cb-22ec-3944-b9b2-cdf70d82a09b",
                        "glosses": [
                            "Division d’un écu résultant d’un chapé et d’un chaussé, c’est-à-dire le complément au losange dont les pointes touchent les bords de l’écu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f92ffe8-eafa-4200-b4a8-5b6a0eb1fdd6",
                                "sense_id": "16a6410b-f59c-3963-98ce-6f1a57fff848",
                                "text": "[…] ; la losange devient le champ, et les quatre triangles des cantons d’un autre émail sont le vêtu […]"
                            },
                            {
                                "example_id": "0c1ecc7b-29e4-4f8d-9bd1-c63694ea2895",
                                "sense_id": "16a6410b-f59c-3963-98ce-6f1a57fff848",
                                "text": "Palliot nous dit que le chapé et le chaussé se rencontrent dans le vêtu […]"
                            },
                            {
                                "example_id": "da452a59-20c0-408d-ab36-1d9d3c28ca34",
                                "sense_id": "16a6410b-f59c-3963-98ce-6f1a57fff848",
                                "text": "D’or au château de gueules maçonné de sable, sans tour aux flancs, donjonné d’une grosse tour crénelée et couverte, vêtu de sinople, qui est de Sahorre → voir illustration « écu au vêtu de sinople »"
                            }
                        ]
                    }
                ],
