                    },
                    {
                        "sense_id": "436c44a3-e51a-3c27-aed7-db37f9c0c734",
                        "entry_id": "846dba98-d4ee-3606-882d-ffbc08bc6273",
                        "glosses": [
                            "senseless talk or writing; balderdash."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
