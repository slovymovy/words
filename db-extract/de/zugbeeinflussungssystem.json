                "senses": [
                    {
                        "sense_id": "b4332136-2901-38a4-8221-35894a334dd4",
                        "entry_id": "ce6d0b6e-d688-305c-8ecf-0d052ede5687",
                        "glosses": [
                            "technische Anlagen und Systeme der Eisenbahnen, welche die Fahrt von Zügen in Abhängigkeit von der zulässigen Geschwindigkeit kontrollieren"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "072c8e76-0023-4eae-a005-f8a48e1a66a0",
                                "sense_id": "b4332136-2901-38a4-8221-35894a334dd4",
                                "text": "„Ab 1872 entwickelten die beiden Ingenieure MM. Lartigue und Forest mit Crocodile das erste signalabhängige Zugbeeinflussungssystem basierend auf einer abschnittsweisen galvanischen Kopplung des Triebfahrzeugs und der Strecke (s.u.).“"
                            },
                            {
                                "example_id": "a964acc1-ec93-422a-aa0b-8e0177d1d8eb",
                                "sense_id": "b4332136-2901-38a4-8221-35894a334dd4",
                                "text": "„Die Berliner S-Bahn setzt bisher ein mechanisches, ebenfalls eigenständiges Zugbeeinflussungssystem mit sogenannten Bernauer Fahrsperren ein, das in den 1920er Jahren entwickelt wurde.“"
                            },
                            {
                                "example_id": "235fdd2a-2484-4033-8168-9ff555c4b19b",
                                "sense_id": "b4332136-2901-38a4-8221-35894a334dd4",
                                "text": "„In Deutschland müssen alle Strecken, auf denen mehr als 100 Kilometer in der Stunde zugelassen sind, mit einem automatischen Zugbeeinflussungssystem ausgerüstet sein.“"
                            },
                            {
                                "example_id": "0613c618-a9ec-44db-bf94-353343eb5ac9",
                                "sense_id": "b4332136-2901-38a4-8221-35894a334dd4",
                                "text": "„Erst das neue Zugbeeinflussungssystem S-Bahn Berlin (ZBS) erfüllt auch diese Anforderung. Es wird nach und nach installiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
