                "senses": [
                    {
                        "sense_id": "8e86ac8a-fce2-3c54-9c7f-dfc08dd1b057",
                        "entry_id": "40693159-27c9-376e-8c7e-6e4f618bb15d",
                        "glosses": [
                            "Heiler, der sich für seine Handlungen angeblich der Hexerei bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa153db-64ba-4fc9-96e1-ee51f1aafc54",
                                "sense_id": "8e86ac8a-fce2-3c54-9c7f-dfc08dd1b057",
                                "text": "„Laut der Beschreibung in der Schachtel, in der das Ding verpackt gewesen war (und auf der es jetzt wie eine Statue mit gespreizten Zehen auf seinem Podest stand), war es eine voll bewegliche afrikanische Pygmäen-Teufelspuppe: ein zwergenhafter Hexendoktor, knapp fünfzig Zentimeter groß, mit einem überdimensionierten Kopf, der mindestens ein Drittel der ganzen Figur ausmachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b9bae5d-733e-4815-aa69-a174ce1b731b",
