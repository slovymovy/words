{
    "word_family": [
        "myrtaceous",
        "myrtiform"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b62f2ea1-1fd9-3a62-a238-a3e4484b4753",
                    "sense_definition": "An evergreen shrub or small tree of the genus Myrtus, native to southern Europe and north Africa",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with the sweet scent of blooming <w>myrtle</w> bushes.",
                            "target_lang_translations": {
                                "zh": "花园里弥漫着盛开的<w>桃金娘</w>灌木的甜美香气。"
                            }
                        },
                        {
                            "text": "In ancient times a <w>myrtle</w> wreath was often worn as a symbol of love and peace.",
                            "target_lang_translations": {
                                "zh": "在古代，人们常佩戴<w>桃金娘</w>花环作为爱与和平的象征。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "common myrtle",
                        "myrtle wreath",
                        "evergreen myrtle"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种原产于南欧和北非的桃金娘属常绿灌木或小乔木。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "桃金娘",
                                "target_lang_sense_clarification": "指桃金娘科植物，常用于指代Myrtus属。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb27ea52-6f2a-3333-80f9-2976efe7497f",
                    "sense_definition": "A dark green shade that resembles the color of Myrtus leaves",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a <w>myrtle</w> green dress for the evening gala.",
                            "target_lang_translations": {
                                "zh": "她为晚宴挑选了一件<w>桃金娘绿</w>色的礼服。"
                            }
                        },
                        {
                            "text": "The walls of the library were painted in a deep <w>myrtle</w> to create a calm atmosphere.",
                            "target_lang_translations": {
                                "zh": "图书馆的墙壁被漆成了深<w>桃金娘绿</w>色，以营造宁静的氛围。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种类似于桃金娘叶片颜色的深绿色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "桃金娘绿",
                                "target_lang_sense_clarification": "指代一种特定的深绿色调。"
                            }
                        ]
                    },
                    "common_phrases": [
                        "myrtle green"
                    ]
                },
                {
                    "sense_id": "308e1126-959f-3ff5-ae5a-115c37553fc7",
                    "sense_definition": "Any of various plants of the genus Cyrilla",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swamp <w>myrtle</w> is known for its clusters of small white flowers.",
                            "target_lang_translations": {
                                "zh": "沼泽<w>蜜花</w>以其簇生的小白花而闻名。"
                            }
                        },
                        {
                            "text": "Botanists identified the specimen as a rare type of <w>myrtle</w> native to the wetlands.",
                            "target_lang_translations": {
                                "zh": "植物学家将该标本鉴定为一种原产于湿地的稀有<w>蜜花</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swamp myrtle"
                    ],
                    "target_lang_definitions": {
                        "zh": "指代多种属于蜜花科（Cyrillaceae）的植物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜜花",
                                "target_lang_sense_clarification": "指代Cyrilla属植物。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "da32fd23-3cee-3ff8-9e0a-50ad4ceef679",
                    "sense_definition": "A female given name from English",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Myrtle</w> was a very popular name for girls in the early twentieth century.",
                            "target_lang_translations": {
                                "zh": "<w>默特尔</w>是二十世纪初非常流行的女孩名字。"
                            }
                        },
                        {
                            "text": "Aunt <w>Myrtle</w> always brought homemade jam whenever she came to visit us.",
                            "target_lang_translations": {
                                "zh": "<w>默特尔</w>阿姨每次来看我们时，总会带上自制的果酱。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "源自英语的女性名字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "默特尔",
                                "target_lang_sense_clarification": "英语女性人名的音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}