                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de hete zomer kwamen er vaak zware <w>onweren</w> voor in de bergen.",
                            "target_lang_translations": {
                                "en": "During the hot summer, severe <w>thunderstorms</w> often occurred in the mountains.",
                                "es": "Durante el caluroso verano a menudo hubo fuertes <w>tormentas</w> en las montañas."
                            }
                        },
                        {
                            "text": "De opeenvolgende <w>onweren</w> hebben veel schade aangericht aan de oude daken.",
                            "target_lang_translations": {
                                "en": "The consecutive <w>thunderstorms</w> caused a lot of damage to the old roofs.",
                                "es": "Las sucesivas <w>tormentas</w> causaron muchos daños en los tejados viejos."
                            }
                        }
                    ],
