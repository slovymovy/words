                        "glosses": [
                            "kruis van twee even lange, schuingeplaatste balken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f7dc358-6337-4497-a2ed-285402d6255f",
                                "sense_id": "d7f2d6ec-bf85-37ae-ad67-ffde5f5c6ee5",
                                "text": "Er zijn speciale verzamelaarsbeurzen voor andreaskruisen."
