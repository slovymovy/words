{
    "word_family": [
        "wonder",
        "wonderlijk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "70d1d3d9-a3a7-3599-b2fd-16550daf6259",
                    "sense_definition": "Op een wonder lijkend of als een wonder beschouwd",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>wonderbaarlijke</w> genezing van de patiënt verbaasde alle aanwezige artsen in het ziekenhuis.",
                            "target_lang_translations": {
                                "en": "The <w>miraculous</w> recovery of the patient astonished all the doctors present in the hospital."
                            }
                        },
                        {
                            "text": "Het was een <w>wonderbaarlijk</w> toeval dat wij elkaar na al die jaren weer tegenkwamen.",
                            "target_lang_translations": {
                                "en": "It was a <w>miraculous</w> coincidence that we ran into each other again after all those years."
                            }
                        }
                    ],
                    "synonyms": [
                        "miraculeus"
                    ],
                    "common_phrases": [
                        "wonderbaarlijke genezing"
                    ],
                    "target_lang_definitions": {
                        "en": "Resembling a miracle or regarded as a miracle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miraculous",
                                "target_lang_sense_clarification": "Relating to or resembling a miracle."
                            },
                            {
                                "target_lang_word": "wondrous",
                                "target_lang_sense_clarification": "Inspiring a feeling of wonder or marvel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07dc7f18-6550-39fd-a5c0-ceec25edc3f1",
                    "sense_definition": "Bijna niet te geloven of verbazingwekkend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertelde een <w>wonderbaarlijk</w> verhaal over zijn reizen door de verre bergen.",
                            "target_lang_translations": {
                                "en": "He told an <w>astonishing</w> story about his travels through the distant mountains."
                            }
                        },
                        {
                            "text": "Het is <w>wonderbaarlijk</w> hoe snel kinderen een nieuwe taal kunnen leren op jonge leeftijd.",
                            "target_lang_translations": {
                                "en": "It is <w>amazing</w> how quickly children can learn a new language at a young age."
                            }
                        }
                    ],
                    "synonyms": [
                        "miraculeus"
                    ],
                    "target_lang_definitions": {
                        "en": "Almost unbelievable or astonishing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "astonishing",
                                "target_lang_sense_clarification": "Extremely surprising or impressive."
                            },
                            {
                                "target_lang_word": "amazing",
                                "target_lang_sense_clarification": "Causing great surprise or wonder."
                            },
                            {
                                "target_lang_word": "incredible",
                                "target_lang_sense_clarification": "Difficult to believe; extraordinary."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}