    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a27e5f9-2bd2-39d6-92cb-d6e4cc1a0479",
                "word": "pocketknife",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3f0456d4-9aa2-4a5f-9a78-466204529eea",
                        "entry_id": "2a27e5f9-2bd2-39d6-92cb-d6e4cc1a0479",
                        "tags": [
                            "plural"
                        ],
                        "form": "pocketknives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                        "entry_id": "2a27e5f9-2bd2-39d6-92cb-d6e4cc1a0479",
                        "glosses": [
                            "A knife small enough for carrying safely and handily in a pocket; usually a folding knife (with blades or tools that the user can fold or retract into the handle)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8f5066-538e-41bf-b0a7-1351fbb50c3c",
                                "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                "text": "Jimmy had a pocketknife, and he wandered into the drawing-room with it one day, alone, and reduced ten thousand dollars' worth of furniture to an indeterminable value in rather less than three-quarters of an hour."
                            },
                            {
                                "example_id": "c8f956b6-e4a6-4613-ada9-d220d7209598",
                                "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                "text": "The Army, the Navy, the Maritime Commission, and Lend-Lease demanded more and more pocketknives — for demolition kits, medical kits, aviators’ kits, electricians’ kits; knives with tools, knives with marlin spikes. The pocketknife attained a new status — as indispensable equipment for all men in uniform."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbcd15b2-5615-443b-9757-6daad4b6ddb8",
                        "source_entry_id": "2a27e5f9-2bd2-39d6-92cb-d6e4cc1a0479",
                        "source_sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
