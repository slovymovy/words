            "senses": [
                {
                    "sense_id": "da6dbf45-48de-3e75-98c6-5c6696ed2956",
                    "sense_definition": "Personne qui n'a pas la nationalité du pays où elle se trouve ou qui est originaire d'une autre contrée.",
