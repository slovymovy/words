                "senses": [
                    {
                        "sense_id": "d154cc1b-f8c9-3c69-b61c-3aeda6b6fd5a",
                        "entry_id": "23f348c4-e549-3137-a3b6-e24ba61c3513",
                        "glosses": [
                            "zonder angst of verlegenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af37d07-8c2d-4ed0-8614-124cd7b18ec2",
                                "sense_id": "d154cc1b-f8c9-3c69-b61c-3aeda6b6fd5a",
                                "text": "De heldere blauwe ogen keken de opperbevelhebber even onbeschroomd aan als eerder de regimentscommandant en het leek alsof ze door hun uitdrukking de scheidsmuur van conventies doorbraken, die de afstand tussen de opperbevelhebber en de soldaat zo groot maakten."
                            },
                            {
                                "example_id": "ed702d4f-fa91-491a-b301-8074dd34e599",
                                "sense_id": "d154cc1b-f8c9-3c69-b61c-3aeda6b6fd5a",
                                "text": "Ze is het met de Fransen eens dat het nu tijd is om \"onbeschroomd de tegenaanval in te zetten tegen de nationalisten\"."
                            }
                        ]
                    }
                ],
