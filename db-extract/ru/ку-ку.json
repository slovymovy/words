        "ru-extract.jsonl": [
            {
                "entry_id": "4196261c-36a9-3d59-9b92-94265bc803c2",
                "word": "ку-ку",
                "pos": "onomatopeia",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea8fe02d-a1c2-31a9-8423-9ec6b3e08e1e",
                        "entry_id": "4196261c-36a9-3d59-9b92-94265bc803c2",
                        "glosses": [
                            "звукоподражание звуку, издаваемому кукушкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9543540a-3599-4833-bda4-2a66d79c3b62",
                                "sense_id": "ea8fe02d-a1c2-31a9-8423-9ec6b3e08e1e",
                                "text": "Из капища доносятся знакомые, хриплые, милые сердцу звуки: ку-ку!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ad4496e7-f050-303b-ac86-33001bdcb913",
                        "entry_id": "4196261c-36a9-3d59-9b92-94265bc803c2",
                        "glosses": [
                            "звук, издаваемый кукушкой"
                        ],
                        "tags": [
                            "в знач. неизм. сущ. ср. р."
                        ],
                        "examples": [
                            {
                                "example_id": "ba36fb2f-4329-454a-8e32-0ade26742cfa",
                                "sense_id": "ad4496e7-f050-303b-ac86-33001bdcb913",
                                "text": "Люблю я это раннее, немного свежее утро, это громкое ку-ку, доносящееся из соседней рощи, мирную картину трех деревень, ярко облитых алым светом."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4d8c396-f844-3af7-a712-f47c6b775c10",
                        "entry_id": "4196261c-36a9-3d59-9b92-94265bc803c2",
                        "glosses": [
                            "разг. звукоподражание стуку в дверь, которое обычно используется при заходе в помещение для указания на это людям, в нём находящимся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a7c4fd-0e54-4752-b0ff-4ac1c417c03a",
                                "sense_id": "d4d8c396-f844-3af7-a712-f47c6b775c10",
                                "text": "Она играет с ними в прятки ( // Будь начеку! ) ― // Придёт и спросит: «всё ль в порядке? // Я тут! ку-ку!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "90e27f7e-c916-3896-acaa-2ede7e54fc1c",
                        "entry_id": "4196261c-36a9-3d59-9b92-94265bc803c2",
                        "glosses": [
                            "жарг. сумасшедший (часто сопровождается жестом, при котором палец вращается у виска)"
                        ],
                        "tags": [
                            ", в знач. предикатива"
                        ],
                        "examples": [
                            {
                                "example_id": "ef28baa9-41be-497c-8d67-a9273ea58f94",
                                "sense_id": "90e27f7e-c916-3896-acaa-2ede7e54fc1c",
                                "text": "― Задержите ее, она действительно ку-ку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49ad185b-72a6-4ff1-a906-a610fa85abae",
                        "source_entry_id": "4196261c-36a9-3d59-9b92-94265bc803c2",
                        "target_lang_word": "cuckoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuckoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97fe8b81-4080-3c41-84f3-7297194d0c16",
                                        "entry_id": "76328b27-8c66-3698-bbde-d681faf3f522",
                                        "glosses": [
                                            "Any of various birds, of the family Cuculidae within the order Cuculiformes, famous for laying its eggs in the nests of other species; but especially a common cuckoo (Cuculus canorus), that has a characteristic two-note call."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40b87e1-7648-4854-b3a0-52540d6f48c0",
                                                "sense_id": "97fe8b81-4080-3c41-84f3-7297194d0c16",
                                                "text": "He knows me, as the blind man knows the cuckoo, / By the bad voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33a31334-0a8e-3e32-ac68-809fb0a8636e",
                                        "entry_id": "76328b27-8c66-3698-bbde-d681faf3f522",
                                        "glosses": [
                                            "The sound of that particular bird."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08e0659b-d4f9-3d68-ae13-1982d4d68c56",
                                        "entry_id": "76328b27-8c66-3698-bbde-d681faf3f522",
                                        "glosses": [
                                            "The bird-shaped figure found in cuckoo clocks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c42c567c-0983-3770-9db7-525167cc8e7b",
                                        "entry_id": "76328b27-8c66-3698-bbde-d681faf3f522",
                                        "glosses": [
                                            "The cuckoo clock itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "308df003-b6b4-37d9-885a-a2b4ecaddf4e",
                                        "entry_id": "76328b27-8c66-3698-bbde-d681faf3f522",
                                        "glosses": [
                                            "A person who inveigles themselves into a place where they should not be (used especially in the phrase a cuckoo in the nest)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86e4f71b-ba32-393a-8cd2-db725708e302",
                                        "entry_id": "76328b27-8c66-3698-bbde-d681faf3f522",
                                        "glosses": [
                                            "Someone who is crazy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4bd49e4-063d-325d-9ab3-8abf12fd203f",
                                        "entry_id": "76328b27-8c66-3698-bbde-d681faf3f522",
                                        "glosses": [
                                            "Alternative form of coo-coo (Barbadian food)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cuckoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7465ca0-b6cd-3668-930f-7e1d23cee23f",
                                        "entry_id": "6b9f3863-765a-3b18-bf86-2bb22c5adf0a",
                                        "glosses": [
                                            "To make the call of a cuckoo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77385d90-4348-48d5-8944-ee01e92512d1",
                                                "sense_id": "c7465ca0-b6cd-3668-930f-7e1d23cee23f",
                                                "text": "Switzerland is the home of many musical toys and here were carved whistles in the shapes of birds. These cuckooed realistically when blown into, with the beak opening and shutting, and the tail moving up and down to produce the 'cuck' and the 'oooh'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5d46fe-0a3a-37f3-a36c-c4d0532cc945",
                                        "entry_id": "6b9f3863-765a-3b18-bf86-2bb22c5adf0a",
                                        "glosses": [
                                            "To repeat something incessantly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43891225-01f7-3848-905f-3cb6966e53c8",
                                        "entry_id": "6b9f3863-765a-3b18-bf86-2bb22c5adf0a",
                                        "glosses": [
                                            "To take over the home of a vulnerable person for the purposes of carrying out organized crime in a concealed way."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "affb4510-1ef8-4ec2-99c7-5b9c5aeaffe1",
                                                "sense_id": "43891225-01f7-3848-905f-3cb6966e53c8",
                                                "text": "She'll have been cuckooed. That'll be the Knezevics. They can't launder fast enough, so what do you do with it? Where do you put it? You hide it in somebody else's place; somebody who han't got a clue what's going on and couldn't do a fat lot about it if they did."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cuckoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0871f911-cbcc-3176-ab2b-8a9ad9f398bc",
                                        "entry_id": "175e7074-f50c-3169-a315-20727de34a21",
                                        "glosses": [
                                            "Crazy; not sane."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b2daf4-dd88-497b-add2-d6c4d08a5eed",
                                                "sense_id": "0871f911-cbcc-3176-ab2b-8a9ad9f398bc",
                                                "text": "I think I'm going cuckoo!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
