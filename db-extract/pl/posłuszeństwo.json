                    {
                        "sense_id": "5314eab8-77c7-3802-b185-80b9a4bab014",
                        "entry_id": "79e512dd-9409-37ff-818a-e0231cb94860",
                        "glosses": [
                            "postawa zgody na wykonywanie cudzych poleceń, rozkazów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd94d394-613b-406b-b5eb-4f292a88c251",
                                "sense_id": "5314eab8-77c7-3802-b185-80b9a4bab014",
                                "text": "Samotność, milczenie, modlitwa i okazałość nabożeństwa podziałały skutecznie na duszę młodziuchnego Placyda. Z jak największą więc ochotą i skwapliwością pełnił wszystkie obowiązki i posługi, jakie mu nakazywało posłuszeństwo, każdemu starał się przysłużyć, każdego zobowiązać serdeczną życzliwością i uprzejmością."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d9ef0f6-8baf-4040-9963-cb1512891781",
                        "source_entry_id": "79e512dd-9409-37ff-818a-e0231cb94860",
                        "source_sense_id": "5314eab8-77c7-3802-b185-80b9a4bab014",
                        "target_lang_word": "obedience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obedience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                        "entry_id": "19fecf49-a1fc-3e9d-b8f4-f3bfcb6a6019",
                                        "glosses": [
                                            "The quality of being obedient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "727f0952-1d54-4b18-947d-081ce648d8fd",
                                                "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                                "text": "Obedience is essential in any army."
                                            },
                                            {
                                                "example_id": "3cad43cb-b88b-4fb6-a771-7522bc2ebc6f",
                                                "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                                "text": "February 24, 1823, Thomas Jefferson, letter to Mr. Edward Everett\nResistance to tyrants is obedience to God."
                                            },
                                            {
                                                "example_id": "b0259a1d-2d9f-42f9-8d8b-44ad9a9af517",
                                                "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                                "text": "Cautioning Nobs to silence, and he had learned many lessons in the value of obedience since we had entered Caspak, I slunk forward, taking advantage of whatever cover I could find..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b4dbd31-4791-3a2b-b95a-760743ee7f10",
                                        "entry_id": "19fecf49-a1fc-3e9d-b8f4-f3bfcb6a6019",
                                        "glosses": [
                                            "The collective body of persons subject to any particular authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "463370ec-7bf9-380d-95d8-aac6610b4779",
                                        "entry_id": "19fecf49-a1fc-3e9d-b8f4-f3bfcb6a6019",
                                        "glosses": [
                                            "A written instruction from the superior of an order to those under him."
