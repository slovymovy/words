        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ae94f2ae-fb4e-33c5-8f4a-b0b54de17387",
                "word": "managerial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a6a7aa76-ca9e-4aaf-97f3-0d319a0702aa",
                        "entry_id": "ae94f2ae-fb4e-33c5-8f4a-b0b54de17387",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more managerial"
                    },
                    {
                        "form_id": "3d5bca32-8cde-4dd3-9da2-43cc6adb5b98",
                        "entry_id": "ae94f2ae-fb4e-33c5-8f4a-b0b54de17387",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most managerial"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebf21418-7cef-359e-8e33-39bd994b9aaf",
                        "entry_id": "ae94f2ae-fb4e-33c5-8f4a-b0b54de17387",
                        "glosses": [
                            "Of or relating to a manager or management; involving management-like duties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dba26b9c-fa8c-455b-82a8-d18ad262298c",
                                "sense_id": "ebf21418-7cef-359e-8e33-39bd994b9aaf",
                                "text": "As I crisscrossed managerial circles in different corporations, becoming known in some segments of the corporate world and running into managers that I had met in the course of my search, often in odd places, my personal contacts increased as managers referred me to each other."
                            },
                            {
                                "example_id": "8733cb88-d641-48e1-8ddc-6ea0f63a3c49",
                                "sense_id": "ebf21418-7cef-359e-8e33-39bd994b9aaf",
                                "text": "I left the kitchen and went over to Chuckʼs desk, feeling very managerial when I asked him to show me his progress."
                            },
                            {
                                "example_id": "dcd766e1-7ce8-4374-9158-72bc29b10c6d",
                                "sense_id": "ebf21418-7cef-359e-8e33-39bd994b9aaf",
                                "text": "Terry Gourvish, the lead author if the authorised commercial history of BR, described the new BTC structure thus: \"The conclusion must be that the combination of a few undynamic railwaymen, underpaid full-timers (Commission and General Staff) and poorly-paid part-time businessmen was not a very potent managerial cocktail.\""
                            },
                            {
                                "example_id": "43e3a9cb-2841-4077-930f-7365631873c2",
                                "sense_id": "ebf21418-7cef-359e-8e33-39bd994b9aaf",
                                "text": "The game was much bigger than it would have been before England’s managerial handover from Southgate, Carsley the focus of plenty of the attention."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b8a57a7-51f7-49dc-937c-2e8405025347",
                        "source_entry_id": "ae94f2ae-fb4e-33c5-8f4a-b0b54de17387",
                        "source_sense_id": "ebf21418-7cef-359e-8e33-39bd994b9aaf",
                        "source_sense_description": "involving management-like duties",
                        "target_lang_word": "managérial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "managérial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c56f8da-8855-349f-ba4d-bc3842c20e78",
                                        "entry_id": "8ddb7f2e-3b21-3d50-8ec0-9336f7473ffb",
                                        "glosses": [
                                            "Relatif au management."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3893fd4-d406-424e-b851-e0e131c9464c",
                                                "sense_id": "0c56f8da-8855-349f-ba4d-bc3842c20e78",
                                                "text": "Déjà, il est essentiel que les représentants du football professionnel puissent à l’avenir aider le conseil fédéral dans les domaines économiques et managériaux."
                                            },
                                            {
                                                "example_id": "b462b794-cd97-45d6-8104-dd388a36571c",
                                                "sense_id": "0c56f8da-8855-349f-ba4d-bc3842c20e78",
                                                "text": "La seconde [conception du gouvernement privé d’entreprise], celle des économistes néoclassiques des années 1970, niant tout rapport de pouvoir, réduisait la question de la gouvernance à un « problème d’agence » consistant à aligner la conduite managériale sur la valeur actionnariale."
                                            },
                                            {
                                                "example_id": "64eaae45-ee28-4e6b-9d2e-701285abd7b2",
                                                "sense_id": "0c56f8da-8855-349f-ba4d-bc3842c20e78",
                                                "text": "Ils interviennent pour conseiller des « réorganisations », des plans de licenciements et nimber le tout de grandes notions managériales, histoire de rendre la réalité moins mesquine et cruelle."
                                            },
                                            {
                                                "example_id": "fb9fbbd5-08f5-4a3b-a378-24f210cec50d",
                                                "sense_id": "0c56f8da-8855-349f-ba4d-bc3842c20e78",
                                                "text": "La quarantaine (« confinement », en langage managérial) avait été levée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
