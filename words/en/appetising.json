            "senses": [
                {
                    "sense_id": "429bf3ca-201b-3e85-a957-fc84731185f2",
                    "sense_definition": "Appealing to the appetite, especially in appearance or aroma; inviting to eat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fresh bread had a delightfully <w>appetising</w> smell that filled the entire bakery.",
                            "target_lang_translations": {
                                "ru": "У свежего хлеба был восхитительно <w>аппетитный</w> запах, заполнивший всю пекарню."
                            }
                        },
                        {
                            "text": "She prepared an <w>appetising</w> meal of roast chicken and seasonal vegetables.",
                            "target_lang_translations": {
                                "ru": "Она приготовила <w>аппетитный</w> обед из запеченной курицы и сезонных овощей."
                            }
                        }
                    ],
                    "synonyms": [
                        "mouth-watering",
                        "delicious",
                        "tasty",
                        "inviting"
                    ],
                    "antonyms": [
                        "unappetising"
                    ],
                    "common_phrases": [
                        "appetising smell",
                        "appetising aroma",
                        "appetising meal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возбуждающий аппетит, привлекательный на вид или запах; вкусный, аппетитный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аппетитный",
                                "target_lang_sense_clarification": "о еде или её запахе/виде"
                            },
                            {
                                "target_lang_word": "соблазнительный",
                                "target_lang_sense_clarification": "привлекательный, манящий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81e90280-182e-3ed3-9e6a-87e0580ec287",
                    "sense_definition": "present participle and gerund of <w>appetise</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rich aromas drifting from the kitchen were constantly <w>appetising</w> the hungry guests.",
                            "target_lang_translations": {
                                "ru": "Насыщенные ароматы, доносившиеся из кухни, постоянно <w>возбуждали аппетит</w> у голодных гостей."
                            }
                        },
                        {
                            "text": "He focused on <w>appetising</w> the patrons with colorful displays of freshly sliced fruits.",
                            "target_lang_translations": {
                                "ru": "Он сосредоточился на том, чтобы <w>пробуждать аппетит</w> посетителей красочными витринами со свеженарезанными фруктами."
                            }
                        }
                    ],
