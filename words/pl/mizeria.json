    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f92ba68-e5dd-381b-a4a9-f97694ab4fa0",
                    "sense_definition": "Tradycyjna polska sałatka z pokrojonych w plasterki ogórków, najczęściej podawana ze śmietaną.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kulinaria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na obiad podano pieczonego kurczaka z ziemniakami i tradycyjną <w>mizerią</w> ze śmietaną.",
                            "target_lang_translations": {
                                "ru": "На обед подали запечённую курицу с картофелем и традиционной <w>мизерией</w> со сметаной."
                            }
                        },
                        {
                            "text": "Do niedzielnego obiadu mama przygotowała świeżą <w>mizerię</w> z koperkiem.",
                            "target_lang_translations": {
                                "ru": "К воскресному обеду мама приготовила свежий <w>огуречный салат</w> с укропом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mizeria ze śmietaną",
                        "mizeria z ogórków"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционный польский салат из нарезанных кружочками огурцов, чаще всего со сметаной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мизерия",
                                "target_lang_sense_clarification": "традиционный польский огуречный салат"
                            },
                            {
                                "target_lang_word": "салат из огурцов",
                                "target_lang_sense_clarification": "кулинарное блюдо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cc52d1e-d25a-3201-b98f-ffa514d19907",
                    "sense_definition": "Bardzo zły stan, ubóstwo lub niski poziom czegoś.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "niedostatek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ubiegłym roku finansowa <w>mizeria</w> szpitali doprowadziła do poważnych protestów lekarzy.",
                            "target_lang_translations": {
                                "ru": "В прошлом году финансовая <w>нищета</w> больниц привела к серьёзным протестам врачей."
                            }
                        },
                        {
                            "text": "Krytycy zwracają uwagę na artystyczną <w>mizerię</w> tegorocznego festiwalu filmowego.",
                            "target_lang_translations": {
                                "ru": "Критики обращают внимание на художественное <w>убожество</w> кинофестиваля этого года."
                            }
                        }
                    ],
                    "synonyms": [
                        "ubóstwo",
                        "bieda",
                        "nędza",
                        "mizerność"
                    ],
                    "common_phrases": [
                        "mizeria finansowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохое состояние, бедность, убожество или низкий уровень чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нищета",
                                "target_lang_sense_clarification": "крайняя бедность, убогость"
                            },
                            {
                                "target_lang_word": "убожество",
                                "target_lang_sense_clarification": "низкий уровень, жалкое состояние"
                            },
                            {
                                "target_lang_word": "бедственность",
                                "target_lang_sense_clarification": "тяжёлое финансовое или материальное положение"
                            },
                            {
                                "target_lang_word": "мизерность",
                                "target_lang_sense_clarification": "скудность, ничтожность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}