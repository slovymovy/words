                                "target_lang_sense_clarification": "adjective"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "offensichtlich",
                                "target_lang_sense_clarification": "Adjektiv"
                            },
                            {
                                "target_lang_word": "evident",
                                "target_lang_sense_clarification": "Adjektiv"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明显",
                                "target_lang_sense_clarification": "形容词，表示容易察觉"
                            },
                            {
                                "target_lang_word": "显而易见",
                                "target_lang_sense_clarification": "形容词，表示非常清楚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
