                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b4b366-b040-4fc7-8c60-cdeb73419f32",
                                "sense_id": "a817b33b-9f3a-3f23-9c7f-06492da6db7c",
                                "text": "Der Ozonverlust in der Stratosphäre ist das Ergebnis von Emissionen langlebiger, ozonschädigender Substanzen (insbesondere Fluor-Chlor-Kohlenwasserstoffe, FCKW).",
