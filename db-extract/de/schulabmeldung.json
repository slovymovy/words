                "senses": [
                    {
                        "sense_id": "fb9edec2-862c-3ce7-8c3b-d6c3d928dc2c",
                        "entry_id": "a0d33a6a-a711-3823-a8c8-ac06f3726005",
                        "glosses": [
                            "Abmeldung vom Schulbesuch für den häuslichen Unterricht"
                        ],
                        "tags": [
                            "Bildungswesen",
                            "in Österreich rechtens"
                        ],
                        "examples": [
                            {
                                "example_id": "ccd47438-4ef7-4566-a696-fec1de833796",
                                "sense_id": "fb9edec2-862c-3ce7-8c3b-d6c3d928dc2c",
                                "text": "Österreichweit gab es im Schuljahr 2020/2021 2.600 Schulabmeldungen – im bevorstehenden Schuljahr ist die Zahl laut Recherchen von Ö1 deutlich höher."
                            },
                            {
                                "example_id": "78abed8d-45e8-45f7-b351-ddd2f00349e6",
                                "sense_id": "fb9edec2-862c-3ce7-8c3b-d6c3d928dc2c",
                                "text": "Mit der Corona-Pandemie ist die Zahl der Schulabmeldungen gestiegen."
                            },
                            {
                                "example_id": "54fa2eb8-432b-4e28-be17-fd53b21e294d",
                                "sense_id": "fb9edec2-862c-3ce7-8c3b-d6c3d928dc2c",
                                "text": "Bundesschulsprecherin Alexandra Bosek von der VP-nahen Schülerunion sieht in unbegründeten Schulabmeldungen aus Protest gegen Corona-Maßnahmen das Recht auf Bildung verletzt."
                            },
                            {
                                "example_id": "399f18b6-fd2d-4efe-bfef-3bd926736055",
                                "sense_id": "fb9edec2-862c-3ce7-8c3b-d6c3d928dc2c",
                                "text": "Corona führt zu einer Vervielfachung von Schulabmeldungen."
                            },
                            {
                                "example_id": "ae988c77-239e-4580-836c-71ed7dc6fada",
                                "sense_id": "fb9edec2-862c-3ce7-8c3b-d6c3d928dc2c",
                                "text": "Heuras wünscht sich daher eine psychologische Beratung für die Eltern, „wo man mit ihnen darüber spricht, was die Schulabmeldung für die Entwicklung des Kindes bedeutet und welche Alternativen es gibt“, sagt er gegenüber dem ORF."
                            },
                            {
                                "example_id": "de95d41f-20da-4710-9b7a-17bf85ce307b",
                                "sense_id": "fb9edec2-862c-3ce7-8c3b-d6c3d928dc2c",
                                "text": "Seit der Schulabmeldung hatte sich die Schülerin auf die einzelnen Prüfungen privat (teils mit Nachhilfe) vorbereitet, ohne eine Schule zu besuchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
