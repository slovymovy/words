                ],
                "senses": [
                    {
                        "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                        "entry_id": "ca646f8e-9889-3087-97a1-d6967419f728",
                        "glosses": [
                            "Dach mit aufgesetzten über die Dachbreite verlaufenden im Profil dreieckigen Teildächern; oft mit Lichteinlässen/Lufteinlässen; oft im Industriebau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056cb3a6-4aee-40ed-b7c8-41422b2ff0ea",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Dabei wurde der Innenhof mit einem Sheddach versehen.“"
                            },
                            {
                                "example_id": "b6a155c3-62c0-491c-8725-5f1044f01230",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Für die Industriearchitektur wurde das Sheddach entwickelt, um große Hallen mit Tageslicht zu versorgen.“"
                            },
                            {
                                "example_id": "54a48f24-21d0-46e2-afa6-8c14b7e8c7a1",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Der zentrale Gang und die innenliegenden Räume wurden durch ein Sheddach mit Schrägverglasung natürlich belichtet“ […]."
                            },
                            {
                                "example_id": "d3b2ebe9-b103-472f-8dab-5470fb338095",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Bei einem Sheddach wird die rechteckige vertikale Wand des Zusatzquaders noch leicht in Richtung des Firsts geneigt und für den Lichteinfall (Tageslicht) aus Glas gebaut.“"
                            },
                            {
                                "example_id": "9a489beb-c890-4f7c-86c1-30438995d87d",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Die Hallen bestehen aus einem langgestreckten eingeschossigen Baukörper mit Sheddächern.“"
                            },
                            {
                                "example_id": "a7860efc-9315-45c6-91f8-dbee16ac1c9c",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "[Walter Gropius:] „Als typisches Beispiel seiner „späten Moderne“ gilt auch sein Entwurf (1964) für das Bauhaus-Archiv mit den markanten Sheddächern und luftigen Ausstellungspavillons.“"
                            },
                            {
                                "example_id": "6b76fafe-e398-4c9d-b3cf-9436d3f2375c",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Der Kunstverein für die Rheinlande und Westfalen hat in der Düsseldorfer Kunsthalle am Grabbeplatz einen wunderbaren Dachraum, mit fünf Sheddächern, die Oberlicht hereinschaufeln.“"
                            },
                            {
                                "example_id": "89acccec-14e0-44ab-b279-af6b80ec425c",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Licht fällt von oben durch ein gläsernes Sheddach und seitlich durch große Fenster, die den Blick auf den umgebenden Park freigeben.“"
                            },
                            {
                                "example_id": "1f9c66cb-fbda-4ade-9c52-e38db7baad5e",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„»Dahinter werden verglaste Büros eingerichtet. Überdacht wird das mit einem historischen Sheddach, damit Licht in das Gebäude gelangt«, erklärt Investor Pfeifer.“"
                            },
                            {
                                "example_id": "58e0090f-6841-4110-be06-c6189c65cc2b",
                                "sense_id": "78545683-c11a-31e3-81c4-56a35b21e48e",
                                "text": "„Geplant war ein nigelnagel neues Sekunderschulhaus für das Laufental. In Anlehnung an die starke Industrievertretung im Tal wählte eine Jury ein markantes Sheddach, das dem Schulhaus etwas Unverwechselbares geben sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
