                "senses": [
                    {
                        "sense_id": "5a72e1e9-1719-3318-8b5d-e3bbc4179d14",
                        "entry_id": "dde23ef4-8532-39ca-a892-a403d65e510b",
                        "glosses": [
                            "wygłaszanie kazań, bycie kaznodzieją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485c611e-691d-44b6-a075-65f9dd4f63ef",
                                "sense_id": "5a72e1e9-1719-3318-8b5d-e3bbc4179d14",
                                "text": "Wojtyłę pociągało kaznodziejstwo."
                            },
                            {
                                "example_id": "cd3422ec-b3fa-4c67-be5d-49a988196ba4",
                                "sense_id": "5a72e1e9-1719-3318-8b5d-e3bbc4179d14",
                                "text": "Istotnym miernikiem dobrego kaznodziejstwa jest osobiste życie kaznodziei."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "365d4ce4-d3fd-3e60-9e10-cb4b08d74fe2",
                        "entry_id": "dde23ef4-8532-39ca-a892-a403d65e510b",
                        "glosses": [
                            "całość twórczości kaznodziejskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aaf2ebe-32ad-47e9-9644-204d788eb829",
                                "sense_id": "365d4ce4-d3fd-3e60-9e10-cb4b08d74fe2",
                                "text": "Kaznodziejstwo franciszkanów pierwszej doby było proste i czyste jak źródlana woda."
                            },
                            {
                                "example_id": "77ec8e2c-09fa-49e0-a395-1348d4b66072",
                                "sense_id": "365d4ce4-d3fd-3e60-9e10-cb4b08d74fe2",
                                "text": "Miał do tego talent, jego kaznodziejstwo było wysokich lotów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1ab1bd4c-3f2a-3b09-8b6a-9ce1e539e941",
                        "entry_id": "dde23ef4-8532-39ca-a892-a403d65e510b",
                        "glosses": [
                            "talent oratorski"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "37d937e0-46bd-36b3-9897-5ed816d197a7",
                        "entry_id": "dde23ef4-8532-39ca-a892-a403d65e510b",
                        "glosses": [
                            "skłonność do wygłaszania mów, prawienia morałów"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "748f4a5a-b56b-4900-a9ce-bcb538a22b90",
                                "sense_id": "37d937e0-46bd-36b3-9897-5ed816d197a7",
                                "text": "Mam po dziurki w nosie tego jego kaznodziejstwa, tych jego morałów i sentencji."
                            },
                            {
                                "example_id": "907491b7-7472-4ceb-8e61-99e4caf8e4b1",
                                "sense_id": "37d937e0-46bd-36b3-9897-5ed816d197a7",
                                "text": "Zlituj się, będziesz mi tu cały wieczór uprawiał kaznodziejstwo?"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
