                                            {
                                                "example_id": "244d9b4e-d446-45db-a01e-e6f0bfaef204",
                                                "sense_id": "3d3ac746-7f73-3bf9-b622-a781749e9c2a",
                                                "text": "[…] I met a stranger, a quiet little man, who also had been under the weather from malaria."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c81abd56-62c3-3a63-a2fc-c0129c557555",
                                        "entry_id": "714a0ddf-3f12-3169-a61c-2aeada808fba",
                                        "glosses": [
                                            "Somewhat intoxicated or suffering from a hangover."
                                        ],
                                        "tags": [
