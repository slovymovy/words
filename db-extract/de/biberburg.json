                                            {
                                                "example_id": "c378e399-4ab5-4018-a234-37ba352c52c2",
                                                "sense_id": "38ef3563-2a15-3364-818a-974515ca2faf",
                                                "text": "The bullet missed its target and lodged in the bark of a tree."
                                            }
