                        "sense_id": "ad07eb49-9559-33ec-9eab-0cf5f2020f03",
                        "entry_id": "88d3f28d-8489-3780-ae4e-fba32fc064f1",
                        "glosses": [
                            "starker Drang, viele Tore zu erzielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0a68d9-3ee1-45b7-ae3f-9b5cb4cc8ec4",
                                "sense_id": "ad07eb49-9559-33ec-9eab-0cf5f2020f03",
                                "text": "„Auflösungserscheinungen im Spiel der Borussia sowie Torhunger und Spielfreude der Leverkusener sorgten für ein Gladbacher Debakel“"
                            },
                            {
                                "example_id": "aa07e3e4-54d9-4e71-b45a-d5b18f6d74b3",
                                "sense_id": "ad07eb49-9559-33ec-9eab-0cf5f2020f03",
                                "text": "„Aber auch ohne den unstillbaren Torhunger des »Bombers« gelingt den Münchnern eine Galavorstellung.“"
                            },
                            {
                                "example_id": "939f2942-12b2-4bc9-b6e1-ecb072eb1aba",
                                "sense_id": "ad07eb49-9559-33ec-9eab-0cf5f2020f03",
                                "text": "„Meines Erachtens könnten sie jetzt anfangen, das Ergebnis über die Zeit zu retten, aber der Torhunger unserer Stürmer ist unersättlich.“"
                            }
                        ],
