                ],
                "senses": [
                    {
                        "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                        "entry_id": "ba22d1a5-675d-3fab-99bc-b5f308643911",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e9d1cd-323d-4dbc-96cd-8c982ca4ffd5",
                                "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                                "text": "Frau Storm ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "789255dd-3ee5-42c3-bdbd-7c61e56fd861",
                                "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                                "text": "Herr Storm wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b07847b5-748f-4938-b8a7-4d3b610d92cb",
                                "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                                "text": "Die Storms fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bd5e4880-0e4a-4edb-9767-d8cb1488fb31",
                                "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                                "text": "Der Storm trägt nie die Schals, die die Storm ihm strickt."
                            },
                            {
                                "example_id": "914c4e52-92a1-4f9b-ab31-649843de9e86",
                                "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Storm kommt, geht der Herr Storm.“"
                            },
                            {
                                "example_id": "7bf40fd5-c607-4177-b2b3-79a23acbba02",
                                "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                                "text": "Storm kommt und geht."
                            },
                            {
                                "example_id": "74786be6-a6e9-4eeb-8ad1-e25df780041d",
                                "sense_id": "66d68237-5d39-31f2-a985-71e38de75e9f",
                                "text": "Storms kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
