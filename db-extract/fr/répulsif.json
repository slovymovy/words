                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1b18cc-e98a-33c2-b631-86ee2b328439",
                                        "entry_id": "aa808781-12e6-3572-ab89-2794f792518e",
                                        "glosses": [
                                            "Repulsive, inspiring aversion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d21ee6-5eec-4106-ad08-493d61638222",
                                                "sense_id": "3d1b18cc-e98a-33c2-b631-86ee2b328439",
                                                "text": "The mixture of whey, beetroot juice, and spirulina seems repellent to me."
                                            },
                                            {
                                                "example_id": "89709f1d-6279-481d-aed2-af4ce16ec7d9",
                                                "sense_id": "3d1b18cc-e98a-33c2-b631-86ee2b328439",
                                                "text": "People are rightly and justifiably terrified with our culture. Many aspects of it are destructive and repellant."
                                            },
                                            {
                                                "example_id": "96ed9fcd-9068-48ea-a33a-4b05f4e371ff",
                                                "sense_id": "3d1b18cc-e98a-33c2-b631-86ee2b328439",
                                                "text": "[Martin] Heidegger's repellent political beliefs do not contaminate his philosophical work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d056d235-ac51-33fd-a435-7d14a1703d6e",
                                        "entry_id": "aa808781-12e6-3572-ab89-2794f792518e",
                                        "glosses": [
                                            "Resistant or impervious to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc8dc5b-57b0-4e4d-8f73-1041d8a1181d",
                                                "sense_id": "d056d235-ac51-33fd-a435-7d14a1703d6e",
                                                "text": "All that fabric's supposed to be dust-repellent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81d8154-86cc-37a9-8ace-e02a945815fe",
                                        "entry_id": "aa808781-12e6-3572-ab89-2794f792518e",
                                        "glosses": [
                                            "Tending or able to repel; driving back."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206cef9e-5ac4-491c-a573-a4520c98c8e6",
                                                "sense_id": "e81d8154-86cc-37a9-8ace-e02a945815fe",
                                                "text": "These particles exercise a-highly repellent force."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repellent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beaeaa97-fb0f-3e22-b9ec-8bcbe18324f7",
                                        "entry_id": "c71eee91-8bc2-3ea2-9ed5-17e6550df1fd",
                                        "glosses": [
                                            "A substance or solution used to repel insects, dangerous animals, or other pests."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91c5c17-d3b4-41e5-8579-9888f37d705e",
                                                "sense_id": "beaeaa97-fb0f-3e22-b9ec-8bcbe18324f7",
                                                "text": "None of the mosquito repellents we've tried work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d85778d4-216b-3143-af3a-77d10f7dd985",
