                                "target_senses": [
                                    {
                                        "sense_id": "44dd6072-b6c9-3c61-9cf2-4a8724d33d71",
                                        "entry_id": "fb69aa76-374d-36a6-bde9-e51fff0cf94d",
                                        "glosses": [
                                            "Deuxième mois du calendrier grégorien qui compte normalement vingt-huit jours, sauf dans les années bissextiles où il en compte vingt-neuf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "180fe6fb-9efb-4ef1-bdcb-f944b9a75da4",
                                                "sense_id": "44dd6072-b6c9-3c61-9cf2-4a8724d33d71",
                                                "text": "Dans le mois de février de la deuxième année, on coupe rez souche les sarments les plus faibles et l'on taille à un ou deux yeux le sarment le plus fort."
                                            },
                                            {
                                                "example_id": "192b823a-5be6-46ac-a8a2-0a1055024aeb",
                                                "sense_id": "44dd6072-b6c9-3c61-9cf2-4a8724d33d71",
                                                "text": "La nuit vient de bonne heure au mois de février, et quand le futur beau-père et le futur gendre, qui étaient sortis ensemble du café, arrivèrent à la Madeleine, on allumait déjà les becs de gaz."
                                            },
                                            {
                                                "example_id": "ad9ead97-0f8e-4f3f-ab51-1433d3d529f6",
                                                "sense_id": "44dd6072-b6c9-3c61-9cf2-4a8724d33d71",
                                                "text": "Un froid vif descendait du ciel gris sur la terre blanche et le vent brûlait la peau, car c’était février, ce qui au pays de Québec veut dire deux pleins mois d’hiver encore."
                                            },
                                            {
                                                "example_id": "0c376d95-9fe6-43e4-8bf9-0dd453c9d1e5",
                                                "sense_id": "44dd6072-b6c9-3c61-9cf2-4a8724d33d71",
                                                "text": "Fin février est très beau et le 2 mars nous quittons le cantonnement de Marquigny."
                                            },
                                            {
                                                "example_id": "0ae454f9-5877-4736-b358-cedec0f2ecce",
                                                "sense_id": "44dd6072-b6c9-3c61-9cf2-4a8724d33d71",
                                                "text": "Février n’a que 28 jours et c’est déjà trop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
