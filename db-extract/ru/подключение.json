                "senses": [
                    {
                        "sense_id": "7ddb6ccb-fc11-369a-a17b-535cf0c7343a",
                        "entry_id": "404ac48a-d14d-36fc-9b98-5350f2b6a8df",
                        "glosses": [
                            "действие по значению гл. подключать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f43264-c3d3-46cd-af02-a3f45aa385ef",
                                "sense_id": "7ddb6ccb-fc11-369a-a17b-535cf0c7343a",
                                "text": "Перед подключением соковыжималки к электрической сети убедитесь, соответствует ли напряжение сети напряжению, указанному на табличке прибора."
                            }
                        ]
                    },
                    {
                        "sense_id": "58f5a26e-3b88-3935-aa11-32822fba6151",
                        "entry_id": "404ac48a-d14d-36fc-9b98-5350f2b6a8df",
                        "glosses": [
                            "присоединение, подсоединение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae1a8c72-9442-4b02-8a6c-576c9d49f482",
                                "sense_id": "58f5a26e-3b88-3935-aa11-32822fba6151",
                                "text": "Есть несколько схем подключения осушителя в бассейнах."
                            }
                        ]
                    },
                    {
                        "sense_id": "527159ad-17da-34d2-8467-769124463bbb",
                        "entry_id": "404ac48a-d14d-36fc-9b98-5350f2b6a8df",
                        "glosses": [
                            "перен., разг. привлечение к участию в чем-либо, вовлечение во что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aafd5ec1-225e-4f08-b7ee-902af9da3e01",
                                "sense_id": "527159ad-17da-34d2-8467-769124463bbb",
                                "text": "Заинтересован Белый дом в подключении к этой инициативе и России."
                            }
                        ]
                    }
