                    },
                    {
                        "translation_id": "c08d2fed-b8c7-4fae-a0e7-314faa22c54b",
                        "source_entry_id": "fbea5baf-923b-33a1-bcb0-bc82e43cdaad",
                        "source_sense_id": "4f3359a4-fce2-3926-99a6-aa49358c3faa",
                        "source_sense_description": "der Schuft",
                        "target_lang_word": "Schuft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                        "entry_id": "5e36eeba-70ca-3c67-8fd4-72a3ef695484",
                                        "glosses": [
                                            "gemeiner, niederträchtiger Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "980d4c9b-50e5-4aa1-8bf5-aaa39e8c0216",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "Peter ist ein elender Schuft, er lebt ständig auf Kosten anderer und lügt wie gedruckt."
                                            },
                                            {
                                                "example_id": "6b498573-d6f6-4cde-8b1f-8a6b911d7c99",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "Du Schuft! Hättest du mir nicht wenigstens einen Schokoriegel übrig lassen können?"
                                            },
                                            {
                                                "example_id": "e45d63cc-8f14-4f79-bfa0-354439c21188",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "Seitdem Maria mich als gemeinen Schuft bezeichnet hat, rede ich kein Wort mehr mit ihr."
                                            },
                                            {
                                                "example_id": "a05e64f1-4531-4225-9063-6bb954f3695d",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "„Er wollte anständig sein, aber da sind Schufte und Strolche und Lumpen, darum will Franz Biberkopf nichts mehr sehen und hören von der Welt, und wenn er Penner wird, er versauft den letzten Pfennig von seinem Geld.“"
                                            },
                                            {
                                                "example_id": "8c03fbce-a2ac-4df8-a5b0-f25ff7c0da87",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "„Er packte den Schuft an der Kehle und schlug ihm die Waffe aus der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "323fcd35-4906-45df-a6e4-65ba0c6afc4f",
                        "source_entry_id": "fbea5baf-923b-33a1-bcb0-bc82e43cdaad",
                        "source_sense_id": "79afee77-44f0-3bd2-916f-d70fe9265c56",
                        "source_sense_description": "Feigling, Angsthase",
                        "target_lang_word": "Feigling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feigling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                        "entry_id": "68d08fb9-82ee-3a71-b31a-97dbe7378338",
                                        "glosses": [
                                            "furchtsame, ängstliche, risikoscheue Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef2bf05-5c64-4b48-9be2-42eab284e81d",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "Sei kein solcher Feigling und sag deinem Chef endlich mal richtig die Meinung!"
                                            },
                                            {
                                                "example_id": "80b97be5-baa2-4700-9ea8-f667b9670c3b",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Wer eine Familie mit fünf Töchtern gründet, kann kein Feigling sein.“"
                                            },
                                            {
                                                "example_id": "8dcd235e-67cb-432f-ad58-cf295d7da7d0",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Anstatt seinen Leuten zu Hilfe zu kommen, drehte sich dieser jämmerliche Feigling plötzlich um und gab Fersengeld.“"
                                            },
                                            {
                                                "example_id": "3b0e40a9-db73-4956-a505-614ed72cb053",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Nun schämten sich die Moskowiter wohl, dass sie als Feiglinge bezeichnet wurden, und schämten sich, dass sie wegfuhren, fuhren aber trotzdem weg, weil sie wussten, dass es sein musste.“"
                                            },
                                            {
                                                "example_id": "9e39e1ca-6039-4809-8fbb-6bfd8778ba3c",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "(„Soll ich da mal rüberbalancieren?“) – „Tu doch, mach doch, Feigling!“ – (Mögliche Antwort:) „Lieber ein Feigling sein, als einem Doofen ein’n Gefallen tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f713abe-619b-41dd-99ca-9d153803f16d",
                        "source_entry_id": "fbea5baf-923b-33a1-bcb0-bc82e43cdaad",
                        "source_sense_id": "79afee77-44f0-3bd2-916f-d70fe9265c56",
                        "source_sense_description": "Feigling, Angsthase",
                        "target_lang_word": "Angsthase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angsthase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                        "entry_id": "c3d529fe-4b16-3ee8-b596-4cc33f53520c",
                                        "glosses": [
                                            "jemand, der sich oft ängstigt oder feige ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05b24d12-5250-43de-8b65-76506a16a261",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "Kommst du jetzt mit in die Höhle oder bist du ein Angsthase?"
                                            },
                                            {
                                                "example_id": "74421a17-4221-4cf4-9698-1f59689f4022",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "„Die größten Angsthasen versteckten sich hinter der Theke.“"
                                            },
                                            {
                                                "example_id": "9f5824b4-50d9-4a60-ad59-0ede54770ede",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "„Manche fachfremde Pädagogen, sagt Bernd Richter, sind im Fach Chemie sogar bekennende Angsthasen.“"
                                            },
                                            {
                                                "example_id": "680cad93-571a-4773-ba94-5af6c1391230",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "„Nun stehen diese Angsthasen kurz davor, in Europa die Führung zu übernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
