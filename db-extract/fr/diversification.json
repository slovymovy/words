                    {
                        "sense_id": "f82d7d6e-3c00-3d17-a1d8-72931b8cf491",
                        "entry_id": "cc2e40da-129a-3c1c-aeff-ae6f2c3e2609",
                        "glosses": [
                            "Action de diversifier ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ac310f-7382-401b-9b72-1e20fd42da5d",
                                "sense_id": "f82d7d6e-3c00-3d17-a1d8-72931b8cf491",
                                "text": "La diversification d’un portefeuille boursier, et plus largement du patrimoine, est avant tout une méthode d’étalement du risque inhérent à chaque type de placement."
                            },
                            {
                                "example_id": "7b4a2fee-8f7e-4427-9d86-194c4b2d9a4f",
                                "sense_id": "f82d7d6e-3c00-3d17-a1d8-72931b8cf491",
                                "text": "La diversification alimentaire correspond à l’introduction dans l’alimentation du nourrisson d’autres aliments que le lait, en particulier les aliments solides."
                            }
                        ]
                    },
                    {
                        "sense_id": "a43307b3-4229-3ea3-a4a9-ac3847fcd3d3",
