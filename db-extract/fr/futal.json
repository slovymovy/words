                                                "example_id": "d4747cf6-6162-4528-b38c-ea921066dc9c",
                                                "sense_id": "d3635efb-fdca-378e-a914-7c58446329f3",
                                                "text": "Het water werd langzaam bruin en mijn kleren weer schoon. Ik wrong alles uit en hing mijn druipende shirt, sokken en broek op het balkon."
                                            },
                                            {
                                                "example_id": "08b2cb9d-0574-4d65-93f9-be57b3c2e82b",
                                                "sense_id": "d3635efb-fdca-378e-a914-7c58446329f3",
                                                "text": "Een wijde zwarte broek die onder het lopen opbolde als een matrozenbroek."
                                            },
                                            {
                                                "example_id": "83af429c-3a4f-4de3-88b2-30a5a6fd1e20",
                                                "sense_id": "d3635efb-fdca-378e-a914-7c58446329f3",
                                                "text": "De rijkdom was onuitgesproken aanwezig in de snit van haar roze zijden blouse, in haar stoere broek en haar rookgerei."
                                            }
