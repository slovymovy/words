        "nl-extract.jsonl": [
            {
                "entry_id": "7b8862b0-a953-3fa6-9374-c4ab153837ab",
                "word": "oprukkend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c938fbe5-5600-39a1-9653-fca2ecbdcdcf",
                        "entry_id": "7b8862b0-a953-3fa6-9374-c4ab153837ab",
                        "glosses": [
                            "in belang toenemend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97aa9a4a-3f28-4e24-a0c1-c5f94ccd00d1",
                                "sense_id": "c938fbe5-5600-39a1-9653-fca2ecbdcdcf",
                                "text": "Volgens DNB komt de matige loongroei door oprukkend flexwerk. Flexwerkers ondermijnen de positie van vaste krachten en maken het moeilijker riante cao-afspraken te maken."
                            },
                            {
                                "example_id": "ea9b5220-ff1d-4981-aa90-afb47db39cf5",
                                "sense_id": "c938fbe5-5600-39a1-9653-fca2ecbdcdcf",
                                "text": "De Ier Ian Clothorthy (20) studeert sinds 2013 in Berlijn. ,,Ik vind opgroeien in deze tijd in Europa beangstigend. Niet vanwege de aanslagen. Maar door het politieke klimaat van oprukkend rechts, die juist de eenheid van Europa bedreigt.\" De overwinning van Macron in Frankrijk - de nieuwe pro-EU president - geeft hem wat hoop."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b249ae6-65a8-300a-91fa-68d925417a53",
                        "entry_id": "7b8862b0-a953-3fa6-9374-c4ab153837ab",
                        "glosses": [
                            "steeds meer land of gebied overspoelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1543c0be-b3ff-4530-8b2a-b723c1d7e50f",
                                "sense_id": "7b249ae6-65a8-300a-91fa-68d925417a53",
                                "text": "De twaalf meter lange palen in de grond dienden om eventueel oprukkend water de baas te zijn. Zelfs de schroeven die in de muur gedraaid werden, zijn niet zomaar gekozen. De stevige constructie zou in principe windstoten tot 400 kilometer per uur aan moeten kunnen."
                            }
                        ]
                    }
