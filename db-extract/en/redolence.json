                        "examples": [
                            {
                                "example_id": "c1d3033e-aafd-4209-86b1-5efb163e2586",
                                "sense_id": "17a34542-2114-37a5-86d1-a37608fa047d",
                                "text": "The air was wine and seltzer, perfumed, as they absorbed it, with the delicate redolence of prairie flowers."
                            }
                        ]
                    },
                    {
                        "sense_id": "b908981a-2621-35c2-a160-1c0ed397e181",
                        "entry_id": "90ece139-9c06-3c79-badd-46662ae2abca",
                        "glosses": [
                            "An evocative fragrance."
