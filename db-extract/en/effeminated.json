                ],
                "senses": [
                    {
                        "sense_id": "c8753280-8575-32da-ada9-3df6d2c6acef",
                        "entry_id": "74748cf8-db95-3ece-81cc-a784dba596c5",
                        "glosses": [
                            "Having feminine qualities; effeminate."
                        ],
                        "tags": [
                            "derogatory",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "bfd01e7b-cf05-47a2-adbd-8a959c20ce04",
                                "sense_id": "c8753280-8575-32da-ada9-3df6d2c6acef",
                                "text": "whereas, presently upon his censure at this time, his ambition was moderated, his pride humbled, and the means of his former injustice and corruption removed, you would he not relinquish the practice of his most horrible and secret sin of sodomy, keeping still one Godrich, a very effeminated youth, to be his catamite and bed-fellow,"
                            },
                            {
                                "example_id": "5de95d10-a5ee-4d9e-b299-7d176a9002ec",
                                "sense_id": "c8753280-8575-32da-ada9-3df6d2c6acef",
                                "text": "So we get him between the upper and nether mill-stones of a compusory law that requires him to go, and a baffled teacher who forbids him to come– till he is fit for nothing but the reform-school, or the jail, where at last he encounters that physical force which our effeminated public opinion was afraid to have touch him in the first place, when it might have saved him."
                            },
                            {
                                "example_id": "1b1e9698-a55f-4741-9691-c8ee24a42b94",
                                "sense_id": "c8753280-8575-32da-ada9-3df6d2c6acef",
                                "text": "While all readers of Praxis occupy the effeminated reader position and double-read, within that position, readers are interpellated as feminists, and as feminist women in particular."
                            },
                            {
                                "example_id": "3f5cab39-9ceb-4f13-9e91-a9cf84ca95d3",
                                "sense_id": "c8753280-8575-32da-ada9-3df6d2c6acef",
                                "text": "Lisa Jardine sees Viola as an effeminated male, as does Stephen Greenblatt ."
                            },
                            {
                                "example_id": "940c5ba2-335c-45b7-9ae2-f9d8b2e6bb5a",
                                "sense_id": "c8753280-8575-32da-ada9-3df6d2c6acef",
                                "text": "The emperor fortunately did not want to demolish the Alhambra but he tried \"to conserve it, but reduced, neutralized and effeminated\"."
                            },
                            {
                                "example_id": "d2dd3806-e552-4100-8470-2b65bdf7f37c",
                                "sense_id": "c8753280-8575-32da-ada9-3df6d2c6acef",
                                "text": "Echoing standard eighteenth-century moral-philosophical platitudes, ancient Highland society is portrayed as \"manly\" and noble, in contrast with the \"effeminated\" state of civilizatioon and luxury."
                            }
                        ]
                    }
