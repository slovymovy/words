                        "source_sense_id": "29f8fdef-7eb2-30ab-84c1-409c4162698b",
                        "source_sense_description": "Schweiz: runder Topf mit Stiel für Käsefondue, gefertigt zumeist aus Steingut, Keramik, Gusseisen oder Porzellan",
                        "target_lang_word": "caquelon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caquelon",
