                                "target_senses": [
                                    {
                                        "sense_id": "39f13183-314a-3f6e-9100-264d825feb88",
                                        "entry_id": "cf5cd882-845d-3256-8bbf-905ceb5a8d24",
                                        "glosses": [
                                            "Regions beneath the surface of the earth, both natural (eg. caves) and man-made (eg. mines)."
                                        ],
                                        "tags": [],
