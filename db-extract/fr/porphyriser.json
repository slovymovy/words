                "senses": [
                    {
                        "sense_id": "c006df1a-1305-3baf-8b3c-67361e7e70f8",
                        "entry_id": "c7d6b8df-76a4-3302-b1f1-e85287282f67",
                        "glosses": [
                            "Broyer une substance avec la molette sur une table très dure et bien unie, ordinairement de porphyre, pour la réduire en une poudre très fine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b504cf49-5d89-4670-bb96-bbaf90920b87",
                                "sense_id": "c006df1a-1305-3baf-8b3c-67361e7e70f8",
                                "text": "Il était chauffé dans un creuset en porcelaine émaillée, au milieu d'une masse de fer porphyrisé qui le préservait de l'oxydation."
                            },
                            {
                                "example_id": "8de9b9f8-3752-4b3b-8f55-cf3ddd9292ed",
                                "sense_id": "c006df1a-1305-3baf-8b3c-67361e7e70f8",
                                "text": "Et cette becquée se compose d’une fine marmelade d’insectes broyés, porphyrisés entre les mandibules de la Guêpe nourrice."
                            }
                        ]
                    }
                ],
