                                                "sense_id": "6b0db4f4-9c23-3c16-9f7f-4243001017c5",
                                                "text": "Prendre des fortifiants."
                                            },
                                            {
                                                "example_id": "5f339083-4309-49ec-9d7d-d1c5d3de4423",
                                                "sense_id": "6b0db4f4-9c23-3c16-9f7f-4243001017c5",
                                                "text": "30 décembre 44 – Kurt était mon fortifiant, mon Actiphos, mon Hémoglobine Deschiens, mon corset de plâtre, mon écarte-douleur, mon immense cachet d’aspirine, mon baobab."
                                            },
                                            {
                                                "example_id": "0cd4f742-5f7e-421f-80b2-92fe4b01d08a",
                                                "sense_id": "6b0db4f4-9c23-3c16-9f7f-4243001017c5",
                                                "text": "Avant le petit-déjeuner, nous allons vous donner un fortifiant pour mieux passer l’hiver."
                                            }
                                        ]
                                    }
