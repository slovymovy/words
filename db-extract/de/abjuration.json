                    {
                        "translation_id": "f3b273fb-d550-4cdb-a7dc-255ddbd85328",
                        "source_entry_id": "f2626cd2-0649-37e0-a61c-fc571bfc1074",
                        "source_sense_id": "401b3450-8bb3-3453-9aee-e88b2b9e3a33",
                        "source_sense_description": "Rechtswissenschaft, veraltet: Abschwörung; durch Eid bekräftigter Verzicht",
                        "target_lang_word": "abjuration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abjuration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc009e85-5fbc-3248-941e-6650583c49f8",
                                        "entry_id": "eadbbb29-282e-3505-b625-a6bce12c8a28",
                                        "glosses": [
                                            "Action d’abjurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e5450b0-02cd-4ca3-b46c-f3c283b07f5f",
                                                "sense_id": "bc009e85-5fbc-3248-941e-6650583c49f8",
                                                "text": "L’abjuration ne discrédite plus : on sait bien qu’elle est forcée. Que pourraient-ils faire d’autre, sinon aller en prison? dictée mot à mot."
                                            },
                                            {
                                                "example_id": "1cb74696-1541-4fef-a11c-fb0d8548df1b",
                                                "sense_id": "bc009e85-5fbc-3248-941e-6650583c49f8",
                                                "text": "Selon la légende, Galilée aurait ponctué son abjuration par : « Et pourtant elle tourne »."
                                            },
                                            {
                                                "example_id": "c45ed107-54a9-4cb8-b251-b55a688c85b0",
                                                "sense_id": "bc009e85-5fbc-3248-941e-6650583c49f8",
                                                "text": "– Enfin, je crois sincèrement qu’il est inutile d’obtenir des abjurations et des conversions. Mieux vaut réunir tout le monde en Christ que diviser ceux qui croient en lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
