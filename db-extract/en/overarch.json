                                                "example_id": "eafa674c-8d1d-48f2-8730-5bd02525e26b",
                                                "sense_id": "1ef22bd5-ec71-359c-a5d2-5fb0dca34de7",
                                                "text": "Der wuchtige Schwengel bebte leise, als sehne er sich nach einem Schlag an das Dach, das ihn erzern überwölbte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
