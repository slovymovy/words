                                "target_senses": [
                                    {
                                        "sense_id": "9464f2d7-f941-3cde-843b-efb1d41c6527",
                                        "entry_id": "b0dbe1f3-8cb2-3bba-b56d-54bdd0b66a74",
                                        "glosses": [
                                            "eine Gruppe von meist Fachleuten, die über einen Preis oder einen Wettbewerb entscheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d79c68-304e-4d46-9c20-acec633086ec",
                                                "sense_id": "9464f2d7-f941-3cde-843b-efb1d41c6527",
                                                "text": "Die Jury mitsamt der Schauspielerin Diane Kruger hat gesprochen: Die Gewinner für die Bären 2008 stehen fest."
                                            },
                                            {
                                                "example_id": "5578e8e6-dd50-472f-9061-40522f09c65c",
                                                "sense_id": "9464f2d7-f941-3cde-843b-efb1d41c6527",
                                                "text": "„Doch sieben Stunden nach der Verleihung des Preises wurde bekannt, dass die Jurorin Carmen Callil sich aus Protest gegen die Entscheidung für Roth verbittert aus der Jury zurückgezogen hatte.“"
                                            },
                                            {
                                                "example_id": "13788424-6a96-4745-8d4c-73fa008ac706",
                                                "sense_id": "9464f2d7-f941-3cde-843b-efb1d41c6527",
                                                "text": "„Die Braunschweiger Jury hält an ihrem Vorschlag fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31c81f97-d551-3fbf-84c8-086ec1a6829e",
                                        "entry_id": "b0dbe1f3-8cb2-3bba-b56d-54bdd0b66a74",
                                        "glosses": [
                                            "die Gesamtheit der Geschworenen eines Gerichtsverfahrens im angelsächsischen und japanischen Rechtssystem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f0e070-d31b-4736-ac2b-cf909cf87b75",
                                                "sense_id": "31c81f97-d551-3fbf-84c8-086ec1a6829e",
                                                "text": "Die Jury des Gerichtes benötigte laut dem New York Herald nur 20 Minuten, um die Angeklagte schuldig zu sprechen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a2719798-aea1-3565-85d9-480d5319dde3",
                                        "entry_id": "b0dbe1f3-8cb2-3bba-b56d-54bdd0b66a74",
                                        "glosses": [
                                            "ein Schiedsgericht, das beispielsweise Regelstöße überprüft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69984430-69d5-4045-bb01-f4c3bb7c181d",
                                                "sense_id": "a2719798-aea1-3565-85d9-480d5319dde3",
                                                "text": "Das 15-km-Einzelrennen der Frauen bei der Biathlon-WM in Östersund musste wegen zu starken Windes abgesagt werden. Die Jury entschied sich zu diesem Schritt und setzte das WM-Rennen für Donnerstag, 14.05 Uhr, neu an."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
