                ],
                "senses": [
                    {
                        "sense_id": "092a0232-17b0-3b1a-b882-444c497e6d6b",
                        "entry_id": "55e2c6a8-653e-3da7-9f17-1ebbce624aa5",
                        "glosses": [
                            "сокр. от профессиональный союз; объединение людей, связанных по профессии, по характеру деятельности"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "8b00fa67-950c-4ebe-a2d6-1da0b8b5cd09",
                                "sense_id": "092a0232-17b0-3b1a-b882-444c497e6d6b",
                                "text": "В профсоюз я не могу вступить, не имея постоянной работы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e523260e-1c9f-43f4-a20b-67c654dc0d25",
                        "source_entry_id": "55e2c6a8-653e-3da7-9f17-1ebbce624aa5",
                        "source_sense_id": "092a0232-17b0-3b1a-b882-444c497e6d6b",
                        "target_lang_word": "trade union",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trade union",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98eb36bc-c154-3055-888b-83e66c99bce6",
                                        "entry_id": "2bde7435-b85b-302a-bd4f-e2156d64b764",
                                        "glosses": [
                                            "An organization whose members belong to the same trade and that acts collectively to address common issues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b33c19be-dd36-48c8-a98e-2363d19c08ac",
                                                "sense_id": "98eb36bc-c154-3055-888b-83e66c99bce6",
                                                "text": "When the first wave of postwar immigrants arrived in Britain in the 1950s and ’60s, it was a period of rising wages, full employment, an expanding welfare state and strong trade unions. Today, Britain’s manufacturing base has all but disappeared, working-class communities have disintegrated, unions have been neutered and the welfare state has begun to crumble."
                                            },
                                            {
                                                "example_id": "1d44c4ea-b99d-4313-bcd9-6aff37487037",
                                                "sense_id": "98eb36bc-c154-3055-888b-83e66c99bce6",
                                                "text": ", labour union (Canada), labor union (Canada, US)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4f7e92a-3e79-4fcc-96d6-e91d16bc6419",
                        "source_entry_id": "55e2c6a8-653e-3da7-9f17-1ebbce624aa5",
                        "source_sense_id": "092a0232-17b0-3b1a-b882-444c497e6d6b",
                        "target_lang_word": "labor union",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labor union",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fba3d6a-135a-31cb-bbf9-a0c0787a00dc",
                                        "entry_id": "a4a0b243-d55b-37fc-9417-65f101223baf",
                                        "glosses": [
                                            "A continuous association of wage-earners for the purpose of maintaining or improving the conditions of their employment; a trade union."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d71a3d89-f280-4a31-be35-04d2435faf19",
                        "source_entry_id": "55e2c6a8-653e-3da7-9f17-1ebbce624aa5",
                        "source_sense_id": "092a0232-17b0-3b1a-b882-444c497e6d6b",
                        "target_lang_word": "syndicat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syndicat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45f33a41-f263-30b3-963c-79f7ce9d189d",
                                        "entry_id": "9c031aad-0aa0-3523-b0ab-be2f7483fa11",
                                        "glosses": [
                                            "Fonction de syndic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47622d9b-ec84-39c7-9773-bbad8df41b52",
                                        "entry_id": "9c031aad-0aa0-3523-b0ab-be2f7483fa11",
                                        "glosses": [
                                            "Temps pendant lequel on exerce la fonction de syndic."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceffbecf-8150-4981-9eb7-95b7af9848b4",
                                                "sense_id": "47622d9b-ec84-39c7-9773-bbad8df41b52",
                                                "text": "Durant son syndicat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6514b705-224c-35c4-84bb-7b8fa86c98a9",
                                        "entry_id": "9c031aad-0aa0-3523-b0ab-be2f7483fa11",
                                        "glosses": [
                                            "Organisation destinée à représenter les intérêts d’un groupe de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4670f7ee-434b-498e-afc3-7ff0c973985e",
                                                "sense_id": "6514b705-224c-35c4-84bb-7b8fa86c98a9",
                                                "text": "Le but économique des syndicats betteraviers se concentre dans la production et dans la vente ; il peut se définir comme suit : propager parmi les membres les procédés qui permettent d'obtenir les rendements les plus riches […]."
                                            },
                                            {
                                                "example_id": "ba3199cb-1312-4eb6-abd1-7817770babf9",
                                                "sense_id": "6514b705-224c-35c4-84bb-7b8fa86c98a9",
                                                "text": "[…], tandis qu'au contraire, favorisés par la diffusion et le prix de vente de leur liquide, les « pinardiers » richissimes, groupés en syndicats très influents, peuvent, si bon leur semble satisfaire tous leurs caprices."
                                            },
                                            {
                                                "example_id": "bf69e21c-f428-40ae-b147-f88b2ea76a4b",
                                                "sense_id": "6514b705-224c-35c4-84bb-7b8fa86c98a9",
                                                "text": "La réponse est malaisée car dans certaines communes peuvent coexister avec le syndicat agricole un syndicat spécialisé, d’élevage, grêlifuge, etc., sans que l'on puisse discerner si cela recouvre une rivalité politique."
                                            },
                                            {
                                                "example_id": "d308aeee-838b-4950-84b2-5cc5c48863c6",
                                                "sense_id": "6514b705-224c-35c4-84bb-7b8fa86c98a9",
                                                "text": "Dés son commencement la SDN a deux grandes faiblesses : elle fait un peu figure de syndicat de surveillance de l’Allemagne, et ni les États-Unis, revenus à l’isolationnisme, ni l’Union soviétique, « puissance dangereuse », n’en font partie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                        "entry_id": "9c031aad-0aa0-3523-b0ab-be2f7483fa11",
                                        "glosses": [
                                            "Organisation de défense des intérêts professionnels, catégoriels ou de classe, principalement chez les salariés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e6f85f0-fbd1-424b-815e-cd4d56bb15b1",
                                                "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                                "text": "En 1884, le gouvernement ne prévoyait nullement que les syndicats pussent participer à une grande agitation révolutionnaire."
                                            },
                                            {
                                                "example_id": "c28ae610-0995-45d1-a301-2079b436b2b9",
                                                "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                                "text": "Waldeck s’inclina. À regret ! […] J’imagine cependant qu’il lui plut de compléter la grande loi de 1884 portant reconnaissance des syndicats professionnels, dont il était l’auteur, par la non moins grande loi accordant aux citoyens le droit de s’associer librement."
                                            },
                                            {
                                                "example_id": "2b3a30ca-3253-4e4f-af62-eabf404902d4",
                                                "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                                "text": "… : le 22 juillet 1883, un meeting réunit en effet, avec les principaux représentants des syndicats de Londres, 5 Français, les bronziers Tolain et Perrachon, les mécaniciens Aubert et Murat, le maçon Cohadon, le chemisier Bibal."
                                            },
                                            {
                                                "example_id": "e9074f23-8990-4025-abea-6161034c0b22",
                                                "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                                "text": "Quand le mouvement islamiste radical s'empara de la direction des syndicats d’étudiants, à la fin des années 1970, nombre de ses chefs étaient versés dans d'autres idéologies, le marxisme en particulier, ou étaient d'anciens marxistes."
                                            },
                                            {
                                                "example_id": "dda09ddd-8d3d-435c-86f7-0f475f4b1c06",
                                                "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                                "text": "Les propos de la nouvelle secrétaire générale de la fédération CGT Mines-énergie, Virginie Gensel, sont tout aussi pugnaces que ceux de Bernard Thibault, le numéro un du syndicat."
                                            },
                                            {
                                                "example_id": "5fd76eba-a421-4feb-8f0c-d986d27abd90",
                                                "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                                "text": "Les syndicats ont eux obtenu plusieurs avancées en faveur des chômeurs. Les jeunes qui entrent sur le marché du travail et les saisonniers devront avoir travailler cinq mois et non plus six pour être indemnisés."
                                            },
                                            {
                                                "example_id": "cf93b753-bc47-4beb-b016-0f6c22bf13c8",
                                                "sense_id": "890e2b7d-3875-3e9e-bb8e-b10fd918722f",
                                                "text": "Toute personne a le droit de fonder avec d'autres des syndicats et de s'affilier à des syndicats pour la défense de ses intérêts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
