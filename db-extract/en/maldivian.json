                                    {
                                        "sense_id": "9cccd9af-3716-36a3-8d9a-4d08f35f7c68",
                                        "entry_id": "a0195864-cb3e-3991-aa73-b88c43a34680",
                                        "glosses": [
                                            "die Malediven betreffend, von den Malediven kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e577b5de-409b-4a5a-a2a2-e8079d217e1b",
                                                "sense_id": "9cccd9af-3716-36a3-8d9a-4d08f35f7c68",
                                                "text": "Um Übelstände zu überwinden und den Fremdenverkehr zu heben, hat sich die maledivische Regierung entschlossen, einige der bisher unbewohnten Inseln für den Fremdenverkehr und für Meeresbademöglichkeiten auszugestalten."
                                            },
                                            {
                                                "example_id": "b71ee28e-dd4d-428f-86fe-2eaa2211eeaa",
                                                "sense_id": "9cccd9af-3716-36a3-8d9a-4d08f35f7c68",
                                                "text": "Es hatte daraus den Anschein, daß die maledivische Sprache recht umständlich und weitläufig ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59a58309-159c-3782-8cc6-cb6fb30bcfe3",
                                        "entry_id": "a0195864-cb3e-3991-aa73-b88c43a34680",
                                        "glosses": [
                                            "zur Sprache Maledivisch (Dhivehi) gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5c0929-c0c2-462f-b924-60f1dd5902e9",
                                                "sense_id": "59a58309-159c-3782-8cc6-cb6fb30bcfe3",
                                                "text": "Es hatte daraus den Anschein, daß die maledivische Sprache recht umständlich und weitläufig ist."
                                            },
                                            {
                                                "example_id": "82a7d196-8011-4af4-8965-536ea2835673",
                                                "sense_id": "59a58309-159c-3782-8cc6-cb6fb30bcfe3",
                                                "text": "Fünf Meter unter der Meeresoberfläche (Pfeil) erwartet das weltweit erste vollverglaste Unterwasser-Restaurant »lthaak (maledivisch für Perle) seine Gäste."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
