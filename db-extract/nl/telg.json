                "senses": [
                    {
                        "sense_id": "d7b5998a-9f43-3261-a132-945049f7ade9",
                        "entry_id": "50b2e8d1-07e3-34da-bcc0-16d1a74979c3",
                        "glosses": [
                            "lid van een familie, afstammeling van een bepaalde voorouder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2698e63a-0f96-4d31-a153-176380f3a955",
                                "sense_id": "d7b5998a-9f43-3261-a132-945049f7ade9",
                                "text": "Als laatste telg van een luisterrijke familie overleefde hij tijdens de repressie van '44 de naoorlogse concentratiekampen, die de overheid sindsdien doodzwijgt omdat alle vermeende zwarten of incivieken er met duizenden in werden samengedreven en hij er getuige van was hoe vrouwen er werden kaalgeschoren en systematisch werden verkracht."
                            },
                            {
                                "example_id": "efc11f22-a9f7-4f49-b950-1d14d76896a6",
                                "sense_id": "d7b5998a-9f43-3261-a132-945049f7ade9",
                                "text": "Rothschild, telg van de beroemde bankiersfamilie, was een vreemde en teruggetrokken man. Hij woonde zijn hele leven, van 1868 tot 1937, in de kindervleugel van zijn ouderlijk huis in Tring, in Buckinghamshire, waar hij de meubels uit zijn kinderjaren gebruikte, zelfs in zijn kinderbed sliep, hoewel hij op een gegeven moment 135 kilo woog."
                            },
                            {
                                "example_id": "9f23a1ad-3c67-43d8-b319-e05386b4a2f2",
                                "sense_id": "d7b5998a-9f43-3261-a132-945049f7ade9",
                                "text": "Rechtenstudent Rory is een telg uit een rijke Britse familie die ook in het adresboekje van het Britse koningshuis staat. Van de tiener is volgens de Britse tabloid Daily Mail weinig meer bekend dan dat hij in zijn jeugd dure privscholen bezocht en dat hij graag rugby speelt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8107ed83-275f-4fd9-9ccc-95b297c42bc3",
                        "source_entry_id": "50b2e8d1-07e3-34da-bcc0-16d1a74979c3",
                        "source_sense_id": "d7b5998a-9f43-3261-a132-945049f7ade9",
                        "source_sense_description": "lid van een familie",
                        "target_lang_word": "descendant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descendant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32bd91ed-e97f-30fd-a20e-12b26d7c28ef",
                                        "entry_id": "42754fb6-68ad-3021-9f3a-3d4aaa9db072",
                                        "glosses": [
                                            "Descending; going down."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8261c5bb-75b2-46c5-a9e3-d50400b76ac4",
                                                "sense_id": "32bd91ed-e97f-30fd-a20e-12b26d7c28ef",
                                                "text": "The elevator resumed its descendant trajectory."
                                            },
                                            {
                                                "example_id": "297c6a3e-cb71-4f89-bcc6-fb59a1ae45f2",
                                                "sense_id": "32bd91ed-e97f-30fd-a20e-12b26d7c28ef",
                                                "text": "Eagle descendant, or descending. See DESCENDANT, and Pl. 22, fig. 6. Eagle descendant, displayed. See Pl. 22, fig. 7. Eagle displayed, recursant. See DISPLAYED RECURSANT, and Pl. 22, […]"
                                            },
                                            {
                                                "example_id": "2dc918ef-634f-4f50-8495-ea53bc2d72e8",
                                                "sense_id": "32bd91ed-e97f-30fd-a20e-12b26d7c28ef",
                                                "text": "Azure, surmounting a cloud argent, an American eagle descendant, wings endorsed proper, between his beak four lightning streaks, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0815f06e-a86d-300b-9be5-c0cb2c566ce8",
                                        "entry_id": "42754fb6-68ad-3021-9f3a-3d4aaa9db072",
                                        "glosses": [
                                            "Descending from a biological ancestor."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1e347d-3de4-46c7-adab-5fabdc191307",
                                                "sense_id": "0815f06e-a86d-300b-9be5-c0cb2c566ce8",
                                                "text": "Power in the kingdom is transferred in a descendant manner."
                                            },
                                            {
                                                "example_id": "37e6f65d-15f9-4fd9-934e-b7bae48c6cf8",
                                                "sense_id": "0815f06e-a86d-300b-9be5-c0cb2c566ce8",
                                                "text": "Pitiable sportster, / To choose thy prey so humbly, to seduce / A beggar wench who hath not the high pride / Descendant still from kingly ancestors, / To keep her royal place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7928b7b-5ac0-3a90-9375-f5ea4ee31ab1",
                                        "entry_id": "42754fb6-68ad-3021-9f3a-3d4aaa9db072",
                                        "glosses": [
                                            "Proceeding from a figurative ancestor or source."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "descendant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d836f96a-f1d7-39ad-9f4b-a4703c0e4306",
                                        "entry_id": "e607560a-30fa-3872-a273-b6c5cfbf79c6",
                                        "glosses": [
                                            "One of the progeny of a specified person, at any distance of time or through any number of generations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2787b315-b027-46f8-b255-8b88aa90325b",
                                                "sense_id": "d836f96a-f1d7-39ad-9f4b-a4703c0e4306",
                                                "text": "Meronyms: issue, line, progeny; family; clan"
                                            },
                                            {
                                                "example_id": "02c6cd34-57c6-46a3-aadb-d0947bc7a290",
                                                "sense_id": "d836f96a-f1d7-39ad-9f4b-a4703c0e4306",
                                                "text": "The patriarch survived many descendants: five children, a dozen grandchildren, even a great grandchild."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "485f75ac-6040-3680-8f8e-53543d522e64",
                                        "entry_id": "e607560a-30fa-3872-a273-b6c5cfbf79c6",
                                        "glosses": [
                                            "A thing that derives directly from a given precursor or source."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655aca22-301f-4890-b757-62a41657ef7e",
                                                "sense_id": "485f75ac-6040-3680-8f8e-53543d522e64",
                                                "text": "This famous medieval manuscript has many descendants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a272b1d-2430-36f7-9741-1768d74c04c4",
                                        "entry_id": "e607560a-30fa-3872-a273-b6c5cfbf79c6",
                                        "glosses": [
                                            "A later evolutionary type."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26db5ed-0462-4619-9f8c-82c7df321414",
                                                "sense_id": "2a272b1d-2430-36f7-9741-1768d74c04c4",
                                                "text": "Dogs evolved as descendants of early wolves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9975efeb-b285-3e44-b8e5-3eb678d52189",
                                        "entry_id": "e607560a-30fa-3872-a273-b6c5cfbf79c6",
                                        "glosses": [
                                            "A language that is descended from another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe45f62-cd9a-4e41-b027-18b6e776ddd8",
                                                "sense_id": "9975efeb-b285-3e44-b8e5-3eb678d52189",
                                                "text": "English and Scots are the descendants of Old English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25696126-fbbb-3a87-b522-00e1e9c8cf83",
                                        "entry_id": "e607560a-30fa-3872-a273-b6c5cfbf79c6",
                                        "glosses": [
                                            "A word or form in one language that is descended from a counterpart in an ancestor language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "971386f9-1480-45ad-b988-95ee3514c05e",
                                                "sense_id": "25696126-fbbb-3a87-b522-00e1e9c8cf83",
                                                "text": "The direct descendant of this form is the Slavic aorist: Sb.-Cr. nȍsī, dȍnosī."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd8554de-f526-37e9-9be5-b0475fa641b3",
                                        "entry_id": "e607560a-30fa-3872-a273-b6c5cfbf79c6",
                                        "glosses": [
                                            "The intersection of the western (setting) horizon and the ecliptic, its ecliptical longitude; the astrological sign it corresponds to."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "876013dd-f073-4acc-a8da-3476fbeabc12",
                        "source_entry_id": "50b2e8d1-07e3-34da-bcc0-16d1a74979c3",
                        "source_sense_id": "d7b5998a-9f43-3261-a132-945049f7ade9",
                        "source_sense_description": "lid van een familie",
                        "target_lang_word": "scion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee92f3a4-2862-3471-bda8-e21e0711a723",
                                        "entry_id": "0ebc644f-2c88-34de-b0d4-d5ac9ae47d12",
                                        "glosses": [
                                            "A descendant, especially a first-generation descendant of a distinguished family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8348bbcd-88b1-4d01-82d5-ddf0411edd7a",
                                                "sense_id": "ee92f3a4-2862-3471-bda8-e21e0711a723",
                                                "text": "No senate seats in council for the dead; no scion of a time honoured dynasty pants to rule over the inhabitants of a charnel house; the general's hand is cold, and the soldier has his untimely grave dug in his native fields, unhonoured, though in youth."
                                            },
                                            {
                                                "example_id": "0ab21048-8c56-4ada-a509-09f4dee26429",
                                                "sense_id": "ee92f3a4-2862-3471-bda8-e21e0711a723",
                                                "text": "Rudolf was the bold, bad Baron of traditional melodrama. Irene was young, as pretty as a picture, fresh from a music academy in England. He was the scion of an ancient noble family; she an orphan without money or friends."
                                            },
                                            {
                                                "example_id": "26f8bdce-e18f-4aba-bf93-a494c189654c",
                                                "sense_id": "ee92f3a4-2862-3471-bda8-e21e0711a723",
                                                "text": "It was said to him that those people were the scions of Zion."
                                            },
                                            {
                                                "example_id": "f0a6171c-1a98-46f2-be4e-150f96c5015d",
                                                "sense_id": "ee92f3a4-2862-3471-bda8-e21e0711a723",
                                                "text": "He could show his parents Eliot, scion of Derek Moulthorp, and then how could they say he was throwing his life away?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6da10262-a733-30ee-97df-b5005780b301",
                                        "entry_id": "0ebc644f-2c88-34de-b0d4-d5ac9ae47d12",
                                        "glosses": [
                                            "The heir to a throne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f15bde7-da2c-3a6d-98d3-2b6dc6d3f550",
                                        "entry_id": "0ebc644f-2c88-34de-b0d4-d5ac9ae47d12",
                                        "glosses": [
                                            "A guardian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ddfde4b-0b90-3920-9b26-4c6bf5461f80",
                                        "entry_id": "0ebc644f-2c88-34de-b0d4-d5ac9ae47d12",
                                        "glosses": [
                                            "A detached shoot or twig containing buds from a woody plant, used in grafting; a shoot or twig in a general sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f20a53f-d854-4ab0-b098-683078f3bde0",
                                                "sense_id": "1ddfde4b-0b90-3920-9b26-4c6bf5461f80",
                                                "text": "[If] you finde a certaine miſlike or conſumption in the plant, you ſhall immediatly vvith a ſharp knife cut the plant off ſlope-vviſe upvvard, about three fingers from the ground, and ſo let it reſt till the next ſpring, at vvhich time you ſhall behold nevv cyons iſſue from the roote, […]"
                                            },
                                            {
                                                "example_id": "992edcbe-27e2-40eb-9ab6-3919967c6c90",
                                                "sense_id": "1ddfde4b-0b90-3920-9b26-4c6bf5461f80",
                                                "text": "He used to think that the plums in this country weren’t good enough, and so he has reformed them, grafting scion to rootstock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
