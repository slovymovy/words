                "senses": [
                    {
                        "sense_id": "1ad4d366-f3e4-3dab-90a8-84d644d95266",
                        "entry_id": "7b2da1ec-0345-38d0-9b0c-c11c11132ff4",
                        "glosses": [
                            "истор. связанный, соотносящийся по значению с существительными орфизм, орфист"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d7c19ff-0356-444b-a3d7-e8637fdb8220",
                        "source_entry_id": "7b2da1ec-0345-38d0-9b0c-c11c11132ff4",
                        "source_sense_id": "1ad4d366-f3e4-3dab-90a8-84d644d95266",
                        "target_lang_word": "Orphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d84aba1-8523-31f6-8f32-e1114b12c467",
                                        "entry_id": "85fc9d22-57a1-3fca-9074-917ac5fc5987",
                                        "glosses": [
                                            "Of or pertaining to Orphism and its doctrines and rituals."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98d623c1-17a7-4aeb-83da-8b2f783ed710",
                                                "sense_id": "9d84aba1-8523-31f6-8f32-e1114b12c467",
                                                "text": "Orphic ideology mainly concerned the mysteries of Dionysos, which many Greeks took very seriously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d5d931b-b905-3a02-8a28-577524cfa691",
                                        "entry_id": "85fc9d22-57a1-3fca-9074-917ac5fc5987",
                                        "glosses": [
                                            "Having an import not apparent to the senses nor obvious to the intelligence; beyond ordinary understanding; mystic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930c09d2-9611-4a8b-b1c1-f6371f6722be",
                                                "sense_id": "8d5d931b-b905-3a02-8a28-577524cfa691",
                                                "text": "[…] he intended to be a divine artist, a man of visionary states and enchantments, Platonic possession. He got a Rationalistic, Naturalistic education at CCNY. This was not easily reconciled with the Orphic. But all his desires were contradictory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f709b1-8504-3cd1-bf31-4c78b78669a8",
                                        "entry_id": "85fc9d22-57a1-3fca-9074-917ac5fc5987",
                                        "glosses": [
                                            "Hypnotic; entrancing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Orphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abf58dba-f048-3c84-a577-2b69030bc76e",
                                        "entry_id": "1e40ae19-dbf7-3041-b32b-0d8d7464469a",
                                        "glosses": [
                                            "A follower of Orphism."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f351a2c-6729-421d-8f51-cfc90b1a6ee3",
                                                "sense_id": "abf58dba-f048-3c84-a577-2b69030bc76e",
                                                "text": "In particular, Plato often refers to the “Orphics” and mentions the “Orphic life” (Orphikoi tines legomenoi bioi, Laws 782c). Plato clearly distinguished the Orphics and the Pythagoreans. To speak very generally, the Orphics believed that the soul had a divine beginning but fell from the gods due to an original crime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c60af179-cd20-4f0e-9258-8332302b0e4c",
                        "source_entry_id": "7b2da1ec-0345-38d0-9b0c-c11c11132ff4",
                        "source_sense_id": "1ad4d366-f3e4-3dab-90a8-84d644d95266",
                        "target_lang_word": "Orphean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orphean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26316b74-de42-375c-bde7-33dc9bbadd00",
                                        "entry_id": "c14479a9-12b5-39a8-88e7-89a8f3fc8ce2",
                                        "glosses": [
                                            "Of or pertaining to Orpheus, the mythical poet and musician."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d1d7b27-3d6b-4928-b6c6-0d1f4d28d92f",
                                                "sense_id": "26316b74-de42-375c-bde7-33dc9bbadd00",
                                                "text": "It is, indeed, part of the ritual of the candidate for adeptship into the British mysteries, resembling that for the neophyte into the Osirian, Cabiric or Orphean mysteries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
