                "senses": [
                    {
                        "sense_id": "7a41c579-bf6f-3d7b-82b9-f6a05aaef3c7",
                        "entry_id": "ca943a3c-30db-3c44-b014-e41ef93d01ea",
                        "glosses": [
                            "to knock together"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ae42d0-b1b2-414d-a82b-59da3935dad8",
                                "sense_id": "7a41c579-bf6f-3d7b-82b9-f6a05aaef3c7",
                                "text": "сколоти́ть я́щик из до́сок",
                                "translation": "to knock up a box",
                                "english": "to knock up a box"
                            },
                            {
                                "example_id": "b165b745-69aa-452c-8ab4-6480d45c3097",
                                "sense_id": "7a41c579-bf6f-3d7b-82b9-f6a05aaef3c7",
                                "text": "Гнилой фашистской нечисти загоним пулю в лоб,\nОтребью человечества сколотим крепкий гроб!",
                                "translation": "We'll drive a bullet into the forehead of the rotten fascist filth,\nFor the scum of humanity we'll knock together a solid coffin!",
                                "english": "We'll drive a bullet into the forehead of the rotten fascist filth,\nFor the scum of humanity we'll knock together a solid coffin!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9aff81d6-8c45-3ef1-b085-eaccda0cf270",
                        "entry_id": "ca943a3c-30db-3c44-b014-e41ef93d01ea",
                        "glosses": [
                            "to knock together, to knit together"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "881d96fb-27e0-4679-bac5-bf98f5565f48",
                                "sense_id": "9aff81d6-8c45-3ef1-b085-eaccda0cf270",
                                "text": "сколоти́ть гру́ппу",
                                "translation": "to knock together a group",
                                "english": "to knock together a group"
                            },
                            {
                                "example_id": "773dbfbc-7515-47c4-b3c8-702fd84ed6c4",
                                "sense_id": "9aff81d6-8c45-3ef1-b085-eaccda0cf270",
                                "text": "сколоти́ть состоя́ние",
                                "translation": "to scrape together [scrape up; knock up] a fortune",
                                "english": "to scrape together [scrape up; knock up] a fortune"
                            }
                        ]
                    }
                ],
