                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ad4ad90-7e41-484d-b536-9752e5632ba9",
                        "source_entry_id": "f9dc2e11-16b8-303e-bb90-c592243dda26",
                        "source_sense_id": "4921ee95-5d0e-3a49-a50d-67b8a4eafb86",
