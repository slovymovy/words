                "senses": [
                    {
                        "sense_id": "fc482094-d338-370b-95ab-20d3748d1a8e",
                        "entry_id": "31c7f023-9c45-3763-af7f-7cfe1aecee98",
                        "glosses": [
                            "relativ kurze (und weniger anspruchsvolle) Streckenlänge oder Wettkampfdistanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3f38ac7-b1c7-4093-94fa-5ef920c723fd",
                                "sense_id": "fc482094-d338-370b-95ab-20d3748d1a8e",
                                "text": "„Die Wettkämpfe erstreckten sich über verschiedene Kategorien, darunter die Sprintdistanz, Kurzdistanz (Olympische Distanz) und Staffeldistanz sowie die Schnupperdistanz.“"
                            },
                            {
                                "example_id": "a980bb9b-7fe0-438d-ba3c-930f45469724",
                                "sense_id": "fc482094-d338-370b-95ab-20d3748d1a8e",
                                "text": "„Über eine Kurzdistanz mit 1000 Schwimmmetern siegten am Ende Gustav Iden aus Norwegen und die Schwedin Lisa Nordén.“"
                            },
                            {
                                "example_id": "67b34634-55b8-4a63-b820-015746a9539d",
                                "sense_id": "fc482094-d338-370b-95ab-20d3748d1a8e",
                                "text": "„Zudem bedeutete seine Endzeit von 1:53:45 Stunden über die Kurzdistanz Platz eins in der Einzelwertung Oberliga.“"
                            },
                            {
                                "example_id": "625191c3-f5d9-4675-8079-1e2f81501896",
                                "sense_id": "fc482094-d338-370b-95ab-20d3748d1a8e",
                                "text": "„Der Sassenberger Triathlon bot außerdem den Rahmen für die NRWTV Meisterschaften über die Kurzdistanz.“"
                            },
                            {
                                "example_id": "55fd1854-0b60-4af8-9d87-16cb306f41f3",
                                "sense_id": "fc482094-d338-370b-95ab-20d3748d1a8e",
                                "text": "„Die Kurzdistanz der Bernina Ultraks ist die optimale Strecke für Traileinsteigerinnen und -einsteiger und führt ins Steinbock Paradies Pontresina.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
