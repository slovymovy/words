                        "entry_id": "d4e3ecfe-dd92-3ff6-b9e3-8315e6934e3e",
                        "glosses": [
                            "Instrument de laboratoire ou de terrain pour la mesure d’un indice de réfraction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eecc77a-08d0-44a8-919c-af3a7a1330cb",
                                "sense_id": "89670f4a-9a58-3e71-8486-be0a20af80b1",
                                "text": "J’ai utilisé plus particulièrement pour la mesure de la réfraction le réfractomètre de précision de Féry, pour la mesure de la dispersion le réfractomètre de précision de Pulfrich."
                            },
                            {
                                "example_id": "43983577-780c-4fbb-9a82-b7b42037cd30",
                                "sense_id": "89670f4a-9a58-3e71-8486-be0a20af80b1",
                                "text": "Grâce à son utilisation simple, le réfractomètre est utilisé en permanence dans l’industrie des sucreries, l’industrie laitière et l’industrie pharmaceutique."
                            }
                        ]
                    }
                ],
