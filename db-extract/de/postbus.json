                "senses": [
                    {
                        "sense_id": "66add487-7cbb-39ed-b3eb-b1ba582553ee",
                        "entry_id": "6819559f-197f-39f7-abad-ab2a33341e4c",
                        "glosses": [
                            "durch ein Postunternehmen, zum Beispiel die Kraftpost, betriebener Linienbus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed5a3f4-8a31-46f2-87c1-bdf8eb2a907f",
                                "sense_id": "66add487-7cbb-39ed-b3eb-b1ba582553ee",
                                "text": "In der Schweiz heißt der Postbus Postauto, und in Österreich ist der Eigentümer der Postbusse die Bundesbahn."
                            },
                            {
                                "example_id": "1fd8d1f2-3337-417a-bef8-fe9a28a4a398",
                                "sense_id": "66add487-7cbb-39ed-b3eb-b1ba582553ee",
                                "text": "Die Deutsche Bundespost betrieb bis circa 1976 die klassischerweise gelb lackierten Postbusse."
                            },
                            {
                                "example_id": "cb05fc78-24e4-4ed2-96dd-c7e28fcb255a",
                                "sense_id": "66add487-7cbb-39ed-b3eb-b1ba582553ee",
                                "text": "„Das Reisen mit dem Postbus hat in Deutschland eine lange Tradition.“"
                            },
                            {
                                "example_id": "45056987-752d-4dff-9a01-e0b363e0c2c2",
                                "sense_id": "66add487-7cbb-39ed-b3eb-b1ba582553ee",
                                "text": "„Zwar entwickelte sich der Überland-Busverkehr zu Beginn des 20. Jahrhunderts zunächst als Domäne der Post, die mit der sogenannten Kraftpost fast logisch das Erbe der Postkutsche antrat. Aber schon ab 1928 eröffnete die damalige Reichsbahn ihre ersten Buslinien … Das Nebeneinander von Bahnbussen und Postbussen dauerte fast ein halbes Jahrhundert, bis die DB nach 1976 die gelbe Flotte und deren Liniennetz schrittweise übernahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d06d9e75-dfaa-3660-b881-21ddc1cd7a6d",
                        "entry_id": "6819559f-197f-39f7-abad-ab2a33341e4c",
                        "glosses": [
                            "Kurzform für eine Buslinie, die durch ein Postunternehmen betrieben wird, zum Beispiel eine Nahverkehrsverbindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80d8f5f-e3f9-4841-9de0-7876a20a18db",
                                "sense_id": "d06d9e75-dfaa-3660-b881-21ddc1cd7a6d",
                                "text": "„Zwar entwickelte sich der Überland-Busverkehr zu Beginn des 20. Jahrhunderts zunächst als Domäne der Post, die mit der sogenannten Kraftpost fast logisch das Erbe der Postkutsche antrat. Aber schon ab 1928 eröffnete die damalige Reichsbahn ihre ersten Buslinien … Das Nebeneinander von Bahnbussen und Postbussen dauerte fast ein halbes Jahrhundert, bis die DB nach 1976 die gelbe Flotte und deren Liniennetz schrittweise übernahm.“"
                            },
                            {
                                "example_id": "cb52c11b-7f48-4c24-a63a-d7ed76e0df8f",
                                "sense_id": "d06d9e75-dfaa-3660-b881-21ddc1cd7a6d",
                                "text": "Nach Waruba gibt es dann nur noch den Postbus."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
