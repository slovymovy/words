                        "cross_references": [
                            {
                                "target_word": "isthme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b29b2d1-862e-3dd2-9550-ba151adb72b4",
                                        "entry_id": "1c139e94-2831-3af5-a999-28de08daa34d",
                                        "glosses": [
                                            "Langue de terre entre deux mers ou deux golfes, qui joint une terre à une autre, une presqu’île au continent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e97eded1-1e32-4e03-aad4-645a6ec9d5e3",
                                                "sense_id": "5b29b2d1-862e-3dd2-9550-ba151adb72b4",
                                                "text": "Elle est bâtie au milieu de la mer, sur une butte de sable, à l’extrémité d’une presqu’île, dont l’isthme étroit, long et demi-circulaire, forme sa rade immense."
                                            },
                                            {
                                                "example_id": "b70028d8-01f3-46b2-a60f-70a877322fcd",
                                                "sense_id": "5b29b2d1-862e-3dd2-9550-ba151adb72b4",
                                                "text": "À quelques pas plus loin, un isthme étroit et sablonneux me conduisit au pied de Gros-Mont, la plus haute montagne de l'archipel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421dbb78-08e4-309b-a5ec-70b66c42f7dc",
                                        "entry_id": "1c139e94-2831-3af5-a999-28de08daa34d",
                                        "glosses": [
                                            "Partie du corps qui a quelque ressemblance de forme avec un passage étroit."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2707bcbd-7ec5-4036-9a5c-0d3c34dedca8",
                                                "sense_id": "421dbb78-08e4-309b-a5ec-70b66c42f7dc",
                                                "text": "L’isthme du gosier"
                                            }
                                        ]
                                    }
                                ]
                            }
