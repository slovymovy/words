                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25f8a30f-9c88-49fb-befc-ac67049ee4ac",
                                                "sense_id": "fb821410-ad49-33a9-8b84-9f7b5f63b413",
                                                "text": "Many autistic individuals without a PTSD diagnosis may actually meet criteria for PTSD but have not received an official diagnosis, potentially due to stronger prioritization of the primary diagnosis of autism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
