                "senses": [
                    {
                        "sense_id": "8a40270e-9392-3e8f-a97f-cb7cc11073ac",
                        "entry_id": "aaa4fca6-6a9d-3992-ae27-37120fd15d83",
                        "glosses": [
                            "Alternative spelling of wurly (“derisorily small”)."
                        ],
                        "tags": [
                            "Scotland",
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "c5e3ba92-7881-4d33-8c7f-d0d80c49e7f2",
                                "sense_id": "8a40270e-9392-3e8f-a97f-cb7cc11073ac",
                                "text": "Wurlie, 1. Contemptibly puny, or small in size; as \"a wurlie bodie,\" an ill-grown person, Fife, Loth."
                            },
                            {
                                "example_id": "c384f47b-10a3-436b-bed9-20f8803f8992",
                                "sense_id": "8a40270e-9392-3e8f-a97f-cb7cc11073ac",
                                "text": "WIRL, sb. Sc. Yks. […] A small and harsh-featured person; an ill-grown child; a stunted animal. […] Hence (1) Wirly, adj. puny, small; (2) Wirly-bit, sb. a short time; a little way; a small portion. (1) Sc. There's nae a pilchard in my creel, Nor wurlie sprat … They're firm and fat (Jam.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7de9af8-8ca6-35ff-be12-5a7aaacec605",
                        "entry_id": "aaa4fca6-6a9d-3992-ae27-37120fd15d83",
                        "glosses": [
                            "gnarled, knotted; wizened, wrinkled."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "bce989cc-e58c-40c5-9fdb-611a73747548",
                                "sense_id": "f7de9af8-8ca6-35ff-be12-5a7aaacec605",
                                "text": "Wurlie, […] 2. Rough, knotted; as, \"a wurlie rung,\" a knotted stick, S. It is applied to a stick that is distorted, Lanarks. As this sense, however, is considerably remote from the other, the term may have had a different origin. 3. Wrinkled, applied to a person; as, a wurly body, Lanarks."
                            }
                        ]
                    }
                ],
