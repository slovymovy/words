                {
                    "sense_id": "135120c0-551a-3921-af03-5f84f50adf5d",
                    "sense_definition": "A set of coded instructions that a computer follows to perform a task.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wrote a simple <w>programme</w> to calculate his taxes.",
                            "target_lang_translations": {
                                "ru": "Он написал простую <w>программу</w> для расчета своих налогов.",
                                "zh": "他写了一个简单的<w>程序</w>来计算税款。"
                            }
                        },
                        {
                            "text": "Once the computer <w>programme</w> is installed, you can start working.",
                            "target_lang_translations": {
                                "ru": "Как только компьютерная <w>программа</w> будет установлена, вы сможете начать работать.",
                                "zh": "计算机<w>程序</w>安装好后，你就可以开始工作了。"
                            }
                        }
                    ],
