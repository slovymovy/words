                "senses": [
                    {
                        "sense_id": "c897a048-a12b-321d-a34d-bac96a682d9b",
                        "entry_id": "76b04287-e7bf-35fe-9366-4c0dc7fbf196",
                        "glosses": [
                            "Donner un caractère non-linéaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e97eb1f1-0e18-4f78-a38b-240f59b999a2",
                                "sense_id": "c897a048-a12b-321d-a34d-bac96a682d9b",
                                "text": "Essayer de non-linéariser au maximum un jeu impose des contraintes techniques très difficiles à résoudre et aboutit souvent à des aberrations."
                            },
                            {
                                "example_id": "426f146b-5130-4907-b3b9-9b5c815f6f9d",
                                "sense_id": "c897a048-a12b-321d-a34d-bac96a682d9b",
                                "text": "Je suppose que 12 paragraphes c'est un peu court pour une aventure mais j'ai voulu non-linéariser les chemins."
                            },
                            {
                                "example_id": "1071aa71-9f2d-4ee2-bc1f-77310ace9021",
                                "sense_id": "c897a048-a12b-321d-a34d-bac96a682d9b",
                                "text": "Pour non-linéariser “la donnée d'un point et de droites qui passent par ce point”, il suffit de remplacer “droite” par “courbe [paramétrée]”."
                            }
                        ]
                    }
