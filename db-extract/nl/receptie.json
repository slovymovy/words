                "senses": [
                    {
                        "sense_id": "89ee4aac-6126-37a3-8860-56164ee6089d",
                        "entry_id": "3b6622d3-d212-3d91-9767-751bf5927210",
                        "glosses": [
                            "een gelegenheid waarbij gasten ontvangen worden naar aanleiding van een huwelijk, jubileum, pensionering e.d."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9cbffde-e226-428b-a219-6b2a60499040",
                                "sense_id": "89ee4aac-6126-37a3-8860-56164ee6089d",
                                "text": "De receptie werd druk bezocht."
                            },
                            {
                                "example_id": "b7a29ce0-3941-4a6e-ab39-d31233d7fcec",
                                "sense_id": "89ee4aac-6126-37a3-8860-56164ee6089d",
                                "text": "' Vervolgens volgt er een eindeloze verhandeling over wiebelende benen, bloedarmoede, een keer flauwvallen tijdens een receptie ('zo gênant'), Arend die haar dwong tot absolute bedrust, nou ja, en godzijdank, want toen kon ze zich er eindelijk aan overgeven."
                            }
                        ]
                    },
                    {
                        "sense_id": "05412720-e2cc-38b3-b884-de31d65b16ce",
                        "entry_id": "3b6622d3-d212-3d91-9767-751bf5927210",
                        "glosses": [
                            "een plaats waar iemand binnenkomende gasten of klanten ontvangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ccd3d88-aff7-40da-b54a-2ee34565c43b",
                                "sense_id": "05412720-e2cc-38b3-b884-de31d65b16ce",
                                "text": "Weet u waar de receptie van die hotel zich bevindt?"
                            },
                            {
                                "example_id": "5bc153cb-f2f4-4f09-b5a4-303a5549a094",
                                "sense_id": "05412720-e2cc-38b3-b884-de31d65b16ce",
                                "text": "Tijdens Quicks afwezigheid vroeg Pamela me om samen met haar op de binnenplaats onze boterhammen op te eten, waardoor de receptie even onbemand was."
                            },
                            {
                                "example_id": "675588cd-1ed9-4d01-a15f-7095b5022b30",
                                "sense_id": "05412720-e2cc-38b3-b884-de31d65b16ce",
                                "text": "Bij de receptie haalde ik meteen mijn langverwachte resupplydoos op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46acad87-bdf0-4e95-a065-0dbec07bc659",
                        "source_entry_id": "3b6622d3-d212-3d91-9767-751bf5927210",
                        "source_sense_id": "05412720-e2cc-38b3-b884-de31d65b16ce",
