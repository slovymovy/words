                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "36f290bc-e539-452f-9515-b631e6259ccb",
                                "sense_id": "3f6c7f8d-6a92-3930-a5c5-2cb096f752aa",
                                "text": "Quel faiblard !"
                            },
                            {
                                "example_id": "79145f5e-5ce2-48c7-ba4a-fffd1456159a",
                                "sense_id": "3f6c7f8d-6a92-3930-a5c5-2cb096f752aa",
                                "text": "Je leur ai déjà dit que je préfère être un faiblard au milieu de personnes en vie, que de paraître un homme puissant au milieu de corps sans vie."
                            }
                        ]
                    }
