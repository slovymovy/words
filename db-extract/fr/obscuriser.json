                "senses": [
                    {
                        "sense_id": "d8236a54-8a3a-396c-acf8-6d0e7791abb4",
                        "entry_id": "6ce6df9e-487d-3d89-b7bb-4b51d4640149",
                        "glosses": [
                            "Rendre obscur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de55ead-d002-4473-b00b-a8829c0f94c2",
                                "sense_id": "d8236a54-8a3a-396c-acf8-6d0e7791abb4",
                                "text": "Une fois changée, c'est l'heure de la séance qui a lieu dans une petite salle obscurisée remplie de vélos."
                            },
                            {
                                "example_id": "5af92389-5fad-41d4-9d1f-d3a5c97a975b",
                                "sense_id": "d8236a54-8a3a-396c-acf8-6d0e7791abb4",
                                "text": "Tu te caches de moi derrière un rempart de méfiance, ta rancune ou je ne sais quel jalousie ou orgueil obscurisent ta raison, tu me vois comme un ennemi d'Athènes?"
                            },
                            {
                                "example_id": "8874eb9c-5bed-4e5d-a2ac-ad27e98b8c6e",
                                "sense_id": "d8236a54-8a3a-396c-acf8-6d0e7791abb4",
                                "text": "Pourquoi maintenant ces ratés de la société, du savoir, de développement et de modernisme viennent nous obscuriser la vie ?"
                            }
                        ]
                    }
                ],
