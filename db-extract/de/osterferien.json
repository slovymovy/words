                            {
                                "example_id": "b16fcb4f-ed81-414d-98a8-a577c648685d",
                                "sense_id": "ba3e8408-99b1-39db-a0ff-c8acd19c246a",
                                "text": "Sie fahren in den Osterferien an die Ostsee.",
                                "translation": "Ils vont à la mer Baltique pendant les vacances de Pâques."
                            },
                            {
                                "example_id": "a8e425f9-2a2c-4b68-8bea-593dbbd24b0c",
                                "sense_id": "ba3e8408-99b1-39db-a0ff-c8acd19c246a",
                                "text": "Die Tierschützer vermuten, dass die Hündin zu Beginn der Osterferien ausgesetzt wurde.",
                                "translation": "Les protecteurs d’animaux supposent que la chienne a été abandonnée au début des vacances de Pâques."
                            }
                        ]
                    }
