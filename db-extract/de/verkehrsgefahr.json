                ],
                "senses": [
                    {
                        "sense_id": "ada129bc-0a1e-3acc-8090-290fb83158c8",
                        "entry_id": "3ff2dcbd-027e-3937-bae8-e94b449621b3",
                        "glosses": [
                            "Bedrohung, die sich aus der Teilnahme am Verkehrsleben ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8f1658-34fe-4022-a24f-bca7aaeafe0c",
                                "sense_id": "ada129bc-0a1e-3acc-8090-290fb83158c8",
                                "text": "„Regelkundige Kinder sind nicht viel besser vor den Verkehrsgefahren ·geschützt als regelunkundige: Die Entwicklung von Verkehrssinn, Verkehrsverständnis und Handlungsbereitschaft, den notwendigen Verbindungsfeldern von Wissen und Handlungskompetenz, hält offensichtlich mit der Wissensanreicherung nicht Schritt.“"
                            },
                            {
                                "example_id": "b6c7e0a9-0491-4f97-b183-6ffc0adc63e8",
                                "sense_id": "ada129bc-0a1e-3acc-8090-290fb83158c8",
                                "text": "„Sollte es den Eltern aber dabei um den Schutz der Kleinen vor Verkehrsgefahren gehen, so täuschen sie sich.“"
                            },
                            {
                                "example_id": "dadd9781-fc32-4be0-99eb-c4f44993ebd7",
                                "sense_id": "ada129bc-0a1e-3acc-8090-290fb83158c8",
                                "text": "„Heute weiß er es: Korsetts, aber auch Miniröcke, weite Ärmel und unbequeme Schuhe, besonders hohe Absätze, machen die Frauen zu einer allgemeinen Verkehrsgefahr.“"
                            },
                            {
                                "example_id": "a6cc8979-d82c-4a84-8688-d2d4582efbd7",
                                "sense_id": "ada129bc-0a1e-3acc-8090-290fb83158c8",
                                "text": "„Der mangelhafte Spielraum im Hause drängt das Kind auf die Straße und damit in unübersehbare Verkehrsgefahren.“"
                            },
                            {
                                "example_id": "678917b4-c697-4857-a681-d3f763df8b77",
                                "sense_id": "ada129bc-0a1e-3acc-8090-290fb83158c8",
                                "text": "„Denn rund die Hälfte der Familien mit Kindern lebt in dicht bebauten Wohngegenden, wo die Kinder ständig Lärm und Verkehrsgefahren ausgesetzt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
