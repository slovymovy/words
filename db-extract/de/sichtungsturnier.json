                "senses": [
                    {
                        "sense_id": "dc2ec40c-c851-3273-b93c-b7c00a527ef5",
                        "entry_id": "bbaac90e-8487-3366-8449-c57c0ee395d0",
                        "glosses": [
                            "Wettbewerb, bei dem ausgewählte talentierte Sportler eine gezielte Förderung erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb21ab9-5d3c-4c1f-b59d-848b9a732916",
                                "sense_id": "dc2ec40c-c851-3273-b93c-b7c00a527ef5",
                                "text": "„Bei einem Sichtungsturnier in der Sportschule Schöneck ließ er mich mal während eines ganzen Spiels warmlaufen, rein kam ich nicht.“"
                            },
                            {
                                "example_id": "4b34e432-0866-480f-a505-7827f6c8d369",
                                "sense_id": "dc2ec40c-c851-3273-b93c-b7c00a527ef5",
                                "text": "„Schließlich konnte ich ihn überreden, auf ein Sichtungsturnier zu fahren, wo er zum besten Spieler gekürt wurde.“"
                            },
                            {
                                "example_id": "de727f5a-b91d-4f48-80a4-290e08395968",
                                "sense_id": "dc2ec40c-c851-3273-b93c-b7c00a527ef5",
                                "text": "„Er äußerte einen großen Wunsch: bei einem Sichtungsturnier in Frankfurt mitzuspielen, wo viele Talentsucher zusehen würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7fe664d2-8fa4-3480-afa8-e91eab5b3ceb",
                        "entry_id": "bbaac90e-8487-3366-8449-c57c0ee395d0",
                        "glosses": [
                            "jährlich stattfindender Wettbewerb, bei dem Mannschaften der deutschen Bundesländer aus einer Altersklasse gegeneinander antreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62de4548-fd91-4671-b262-3fa9c3361716",
                                "sense_id": "7fe664d2-8fa4-3480-afa8-e91eab5b3ceb",
                                "text": "„Mit der bayerischen Auswahl geht es einmal pro Jahr nach Duisburg zu einem Sichtungsturnier, zur inoffiziellen Deutschen Meisterschaft.“"
                            },
                            {
                                "example_id": "82fab9cc-c6d4-4e20-b325-6c5dd294eede",
                                "sense_id": "7fe664d2-8fa4-3480-afa8-e91eab5b3ceb",
                                "text": "„Der Deutsche Fußballbund hatte vor einem halben Jahr ein großes Sichtungsturnier in Hamburg veranstaltet.“"
                            }
