                                        "sense_id": "ab0a4d2b-90aa-31d1-a12b-d44499f92838",
                                        "entry_id": "ba0e1703-cc8c-3354-a2ca-7568095ee943",
                                        "glosses": [
                                            "The act of washing dishes etc; dishwashing."
                                        ],
                                        "tags": [
                                            "British",
