                "senses": [
                    {
                        "sense_id": "11bc9966-5b54-3c6a-bc6d-2889b8ba1314",
                        "entry_id": "dc3bb8ba-2f87-373c-932d-82064c7a682e",
                        "glosses": [
                            "eine Ansitzeinrichtung, die unmittelbar dem Aufsuchen des Wildes sowie der Jagdausübung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d93e4213-f0da-41b7-a57f-7b6eea8022b3",
                                "sense_id": "11bc9966-5b54-3c6a-bc6d-2889b8ba1314",
                                "text": "Von einem Hochsitz aus beobachtete der Jäger die Wildschweine."
                            },
                            {
                                "example_id": "554a767f-3450-48e5-b935-990e2d9e1406",
                                "sense_id": "11bc9966-5b54-3c6a-bc6d-2889b8ba1314",
                                "text": "„Als er mich in der Abenddämmerung auf einen Hochsitz mitnahm, war sie der Meinung, ich gehöre eher ins Bett.“"
                            },
                            {
                                "example_id": "080b372d-7106-4703-b8e7-5d9b81b2fc0e",
                                "sense_id": "11bc9966-5b54-3c6a-bc6d-2889b8ba1314",
                                "text": "„Es ist eine ziemliche Strecke, bis wir einen der Hochsitze erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8a3cda40-1563-3bcb-986e-cdf062fc5261",
                        "entry_id": "dc3bb8ba-2f87-373c-932d-82064c7a682e",
                        "glosses": [
                            "ein erhöhter Platz, der zum Sitzen geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06214ff-4b13-474b-866e-927a57476f12",
                                "sense_id": "8a3cda40-1563-3bcb-986e-cdf062fc5261",
                                "text": "Er saß auf seinem Hochsitz und blickte nach unten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "965c74c8-ec2c-328b-9753-c1b3c74644df",
                        "entry_id": "dc3bb8ba-2f87-373c-932d-82064c7a682e",
                        "glosses": [
                            "der erhöhte Sitzplatz, der Herrschenden als persönliche Erhöhung diente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b98a26-ed8f-49e9-a97e-305683d8297b",
                                "sense_id": "965c74c8-ec2c-328b-9753-c1b3c74644df",
                                "text": "„da ist ferner ein großer Saal, der Walaskialf heißt: das ist Odins Saal. […] In diesem Saal ist der Hochsitz, der Hlidskialf heißt, und wenn Allvater auf diesem Hochsitz sitzt, so übersieht er die ganze Welt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
