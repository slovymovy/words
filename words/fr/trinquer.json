                    "frequency": "Middle",
                    "semantic_group_id": "boire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour célébrer sa promotion, nous allons <w>trinquer</w> ensemble avec une coupe de champagne."
                        },
                        {
                            "text": "Ils ont levé leurs verres afin de <w>trinquer</w> à la santé des mariés."
                        }
                    ],
                    "synonyms": [
                        "toaster"
                    ],
                    "common_phrases": [
                        "trinquer à la santé",
                        "trinquer avec des amis",
                        "trinquer au champagne"
                    ]
                },
                {
                    "sense_id": "b3584cea-7bee-3bbe-a434-41e4708ec420",
                    "sense_definition": "Subir un dommage, une sanction ou les conséquences désagréables d'une situation.",
