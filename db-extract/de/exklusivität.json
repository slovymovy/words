                ],
                "senses": [
                    {
                        "sense_id": "0963aef7-a60b-321c-a0ae-346df346ec83",
                        "entry_id": "22320b29-d143-3c0e-af21-7f883f3fd26d",
                        "glosses": [
                            "Eigenschaft, die betont, dass etwas außergewöhnlich, erlesen und/oder nur für einen kleinen Kreis zugänglich (exklusiv) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2d39a9-b8ad-4239-8ab9-d5c9e561c8d6",
                                "sense_id": "0963aef7-a60b-321c-a0ae-346df346ec83",
                                "text": "„Diese Skepsis und die angesprochenen Qualitätsdefizite führen dazu, daß aufgeklärte Verbraucher den Versandhäusern die z. T. in ihren Spezialkatalogen suggerierte Exklusivität kaum abnehmen dürften.“"
                            },
                            {
                                "example_id": "51819568-8e54-4830-8d42-0c1d466a90bf",
                                "sense_id": "0963aef7-a60b-321c-a0ae-346df346ec83",
                                "text": "„Gestützt auf ihren Grundbesitz und auf den privilegierten Zugang zur klassischen Diplomatenlaufbahn bewahrte die ungarische Aristokratie dabei ein hohes Maß an Exklusivität.“"
                            },
                            {
                                "example_id": "2b09aa26-7470-4a7d-b61d-3d5cfbe5d747",
                                "sense_id": "0963aef7-a60b-321c-a0ae-346df346ec83",
                                "text": "„Bei der geplanten Zusammenarbeit mit Partnern im indirekten Vertrieb stellt sich immer die Frage nach der Exklusivität im Vertriebsgebiet.“"
                            },
                            {
                                "example_id": "ee5ef45a-e72d-407e-9085-3af0171df4c8",
                                "sense_id": "0963aef7-a60b-321c-a0ae-346df346ec83",
                                "text": "„Die Exklusivität des Blicks auf die Erde, wie er Astronauten vorbehalten war, hielt nicht lange an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
