            },
            {
                "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                "word": "could",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a4f23fb-974e-300b-9c5c-702c8bfc9b15",
                        "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                        "glosses": [
                            "can 的簡單過去時"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3fe0db32-b015-4354-846b-0f74ba899748",
                                "sense_id": "5a4f23fb-974e-300b-9c5c-702c8bfc9b15",
                                "text": "Before I was blind, I could see very well.",
                                "translation": "我失明之前视力很好。"
                            }
                        ]
                    },
                    {
                        "sense_id": "61f2c976-9f00-3dba-b779-44077ed87ae9",
                        "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                        "glosses": [
                            "can 的條件式"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "47fbb372-b9be-3c19-9082-e37fc456ab86",
                        "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                        "glosses": [
                            "can 的條件式",
                            "用来表示过去虚拟式，表示与现实相对的假设。"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8e777717-a457-4000-bf76-deedc6b63fc0",
                                "sense_id": "47fbb372-b9be-3c19-9082-e37fc456ab86",
                                "text": "I think he could do it if he really wanted to.",
                                "translation": "我觉得他要是想肯定会做的。"
                            },
                            {
                                "example_id": "76cf78d3-bf38-4451-a81e-c637ed9b72c4",
                                "sense_id": "47fbb372-b9be-3c19-9082-e37fc456ab86",
                                "text": "I wish I could fly!",
                                "translation": "我要是能飞就好了。"
                            }
                        ]
                    },
                    {
                        "sense_id": "bee93233-2296-37a2-bb37-f7af73c80ff3",
                        "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                        "glosses": [
                            "can 的條件式",
                            "用来礼貌地请求许可。"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7a91fef6-cd41-4a56-bd3a-a7d2ef332069",
                                "sense_id": "bee93233-2296-37a2-bb37-f7af73c80ff3",
                                "text": "Could I borrow your coat?",
                                "translation": "我可以借一下你的外套吗？"
                            }
                        ]
                    },
                    {
                        "sense_id": "50eecb75-9152-381f-8ccb-f6b12a622a5e",
                        "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                        "glosses": [
                            "can 的條件式",
                            "用来礼貌地请求别人做某事。"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "24cd4a6f-70cd-41b6-bb8d-31a07097eedc",
                                "sense_id": "50eecb75-9152-381f-8ccb-f6b12a622a5e",
                                "text": "Could you proofread this email?",
                                "translation": "您可以帮我校对一下这封邮件吗？"
                            }
                        ]
                    },
                    {
                        "sense_id": "dc5ef5dc-2056-3efd-91e3-e809358a63f9",
                        "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                        "glosses": [
                            "can 的條件式",
                            "用来表示某事可能会发生。"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7fd4c703-683f-4acc-a706-e00d57d1b4a8",
                                "sense_id": "dc5ef5dc-2056-3efd-91e3-e809358a63f9",
                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                            },
                            {
                                "example_id": "a3e3f3c4-f9d2-4fb7-98ff-9a065abf02e7",
                                "sense_id": "dc5ef5dc-2056-3efd-91e3-e809358a63f9",
                                "text": "We could rearrange the time if you like.",
                                "translation": "您希望的话我们可以重新安排一下日程。"
                            }
                        ]
                    },
                    {
                        "sense_id": "82ae3ad3-281f-3f21-8e05-ffc6c822ba49",
                        "entry_id": "ca5c553d-2189-35fa-86c0-f10e798745fd",
                        "glosses": [
                            "can 的條件式",
                            "用来表示建议。"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "17911e8e-b33c-4085-8793-7622822be7be",
                                "sense_id": "82ae3ad3-281f-3f21-8e05-ffc6c822ba49",
                                "text": "You could try adding more salt to the soup.",
                                "translation": "你试试给汤里多加点盐。"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee4bbe71-297a-3c2f-a7b9-c4fa536582db",
