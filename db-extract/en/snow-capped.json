        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "93e58461-2da1-3ee3-a1a1-c07a95746072",
                "word": "snow-capped",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1835631a-9ef3-3ef4-8b78-8a481f01107b",
                        "entry_id": "93e58461-2da1-3ee3-a1a1-c07a95746072",
                        "glosses": [
                            "Covered with snow at the top, especially of a hill or mountain."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f22742b-4bcc-41fc-877e-57c53b692d9e",
                                "sense_id": "1835631a-9ef3-3ef4-8b78-8a481f01107b",
                                "text": "In the current era of global warming, Mount Kilimanjaro is no longer permanently snow-capped."
                            },
                            {
                                "example_id": "3b75ed4d-6682-44f3-ba6b-15b7d25d3009",
                                "sense_id": "1835631a-9ef3-3ef4-8b78-8a481f01107b",
                                "text": "But the adventurous visitor only needs to travel just a few hours north of the capital to find a less crowded city, where culinary delicacies can be eaten against the backdrop of a snow-capped, active volcano."
                            }
                        ]
                    }
                ],
                "translations": [
