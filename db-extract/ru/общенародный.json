                                        "sense_id": "7d855b85-4cb8-30e3-9df2-a1286d9a0303",
                                        "entry_id": "16a208c0-6cca-39de-821d-d4099d7d0d19",
                                        "glosses": [
                                            "Adapted to the means of the common people; cheap."
                                        ],
