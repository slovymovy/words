                "senses": [
                    {
                        "sense_id": "10100629-655c-3d30-9aba-a9a936e0b39b",
                        "entry_id": "10b5150a-0467-3ee5-a00f-c1a4c5d6bfd3",
                        "glosses": [
                            "bestimmte Gesteinsart, die auf dem Himmelskörper „Mond“ vorkommt beziehungsweise von dort stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e520df5e-fe5a-4e3b-b7cf-b10be4908cf4",
                                "sense_id": "10100629-655c-3d30-9aba-a9a936e0b39b",
                                "text": "„Seit den Apollo-Missionen kennt man magnetisiertes Mondgestein, der Mond muss also in seiner Anfangszeit vor rund vier Milliarden Jahren ein Magnetfeld besessen haben.“"
                            },
                            {
                                "example_id": "f837ff9e-8703-4236-85d8-0201e38075c4",
                                "sense_id": "10100629-655c-3d30-9aba-a9a936e0b39b",
                                "text": "„Die Astronauten hatten Mondgestein mitgebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
