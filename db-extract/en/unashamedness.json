                        "entry_id": "93c4bc27-0489-3e68-a454-601504ab4762",
                        "glosses": [
                            "The state or quality of not being ashamed."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d855d7b-c749-44cf-b314-d13cd2b6284c",
                                "sense_id": "cca0fc2a-d778-3217-a4cf-c1b785b3f5e7",
                                "text": "Again, the faith of this man was the faith of the valiantness for the truth, and unashamedness either of the Jews’ religion, or of Christ."
                            },
                            {
                                "example_id": "7f2f09e5-01cc-4afa-94e4-afb5fd64d163",
                                "sense_id": "cca0fc2a-d778-3217-a4cf-c1b785b3f5e7",
                                "text": "The rare artists among women, like Sappho and Mrs. Browning and Christina Rossetti and Laurence Hope, in their several different ways, have gotten themselves expressed only through a sublime and glorious unashamedness."
                            },
                            {
                                "example_id": "c3ed1e62-f05d-45d3-9adc-e7a23b26b533",
                                "sense_id": "cca0fc2a-d778-3217-a4cf-c1b785b3f5e7",
                                "text": "The wardrobe foolishness comes off fine thanks to Downey's deadpan unashamedness, while the action stuff, perhaps arresting the first couple of times you see it, already seems hackneyed, mannered and overworked, an affectation of diminishing returns."
                            }
                        ]
                    }
