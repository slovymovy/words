                        "entry_id": "88cba2c6-0a2e-35c4-ac69-32dcd8c3d27c",
                        "glosses": [
                            "Leiter des Bundesministeriums der Verteidigung (Bundesverteidigungsministerium)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f436f26-c4f0-485f-9c52-8918c6e4e0ef",
                                "sense_id": "3304df09-446f-3768-9422-112faf213e7a",
                                "text": "„Letzterer [der Wehrbeauftragte BERKHAN] hat in seinen beiden Amtszeiten sein Amt unter fünf Bundestagspräsidenten und gegenüber drei Bundesverteidigungsministern ausgeübt.“"
                            },
                            {
                                "example_id": "18387ddd-9657-4ff7-a211-a3754bf54d38",
                                "sense_id": "3304df09-446f-3768-9422-112faf213e7a",
                                "text": "„Die Wiederbewaffnung war ein großes Thema, Bundesverteidigungsminister Franz Josef Strauß eine Reiz- und Hassfigur, die Angst vor einem Atomkrieg durchaus präsent.“"
                            }
                        ],
