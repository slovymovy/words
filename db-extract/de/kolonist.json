                    {
                        "form_id": "330f4035-fc86-4986-acae-ef989d8150c9",
                        "entry_id": "7dd91749-e031-3ecd-9e70-658e8cbda72e",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Kolonisten"
                    },
                    {
                        "form_id": "72f095c9-d319-41ab-88e9-921f383472fc",
                        "entry_id": "7dd91749-e031-3ecd-9e70-658e8cbda72e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kolonisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac5a2cd9-7454-32c9-bb00-9f8d6ce4e88c",
                        "entry_id": "7dd91749-e031-3ecd-9e70-658e8cbda72e",
                        "glosses": [
                            "Person, die in einer Kolonie ansässig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "823e91dd-e6f6-4e05-8560-413142f99fe8",
                                "sense_id": "ac5a2cd9-7454-32c9-bb00-9f8d6ce4e88c",
                                "text": "„Obwohl keine Selbständigkeit abgestrebt wurde, lehnte das britische Parlament 1767 die Wünsche der Kolonisten ab und schickte stattdessen frei gewordene Truppen nach Amerika.“"
                            },
                            {
                                "example_id": "6969b743-49fc-429b-9f9c-f9df9eec98ed",
                                "sense_id": "ac5a2cd9-7454-32c9-bb00-9f8d6ce4e88c",
                                "text": "„Seine Kämpfer verwüsten mehrere französische Siedlungen, vertreiben die Kolonisten, viele flüchten nach Algier.“"
                            },
                            {
                                "example_id": "fe66ac3d-3625-4597-b035-679b5f8beda0",
                                "sense_id": "ac5a2cd9-7454-32c9-bb00-9f8d6ce4e88c",
                                "text": "„Die Kolonisten trieb im Wesentlichen der Wunsch, die Ressourcen der neuen Territorien auszubeuten.“"
                            },
                            {
                                "example_id": "9cc8e562-a6c4-4380-b1f9-a41b93f241c7",
                                "sense_id": "ac5a2cd9-7454-32c9-bb00-9f8d6ce4e88c",
                                "text": "„Die amerikanischen Kolonisten reagierten empört.“"
                            },
                            {
                                "example_id": "7cf8f593-17d3-4529-b92e-c65bc95326c8",
                                "sense_id": "ac5a2cd9-7454-32c9-bb00-9f8d6ce4e88c",
                                "text": "„Aber er formulierte in seinem Hieb auf die Immigranten und Kolonisten nur ein altes tschechisches Stereotyp.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e78eaa3a-e808-395f-8dde-16f6bdae1de7",
                        "entry_id": "7dd91749-e031-3ecd-9e70-658e8cbda72e",
                        "glosses": [
                            "Person, die ein Gebiet kolonisiert (urbar/nutzbar macht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d3d6427-7e9e-4f0e-8976-f8f29f9b44e1",
                                "sense_id": "e78eaa3a-e808-395f-8dde-16f6bdae1de7",
                                "text": "„Die Kolonisten trieb im Wesentlichen der Wunsch, die Ressourcen der neuen Territorien auszubeuten.“"
                            },
                            {
                                "example_id": "0f1b7b08-c920-4d2a-8aa5-19fd871f1c12",
                                "sense_id": "e78eaa3a-e808-395f-8dde-16f6bdae1de7",
                                "text": "„Die amerikanischen Kolonisten reagierten empört.“"
                            },
                            {
                                "example_id": "67d92fda-852c-451b-b2da-d4c485467f46",
                                "sense_id": "e78eaa3a-e808-395f-8dde-16f6bdae1de7",
                                "text": "„Aber er formulierte in seinem Hieb auf die Immigranten und Kolonisten nur ein altes tschechisches Stereotyp.“"
                            },
                            {
                                "example_id": "a8440462-3091-4cf7-b03e-251721c3b287",
                                "sense_id": "e78eaa3a-e808-395f-8dde-16f6bdae1de7",
                                "text": "„Auf dem eroberten Territorium errichteten die Ordensritter Festungen, gründeten Städte und besiedelten bislang menschenleere Gebiete mit Kolonisten aus Deutschland und anderen europäischen Ländern.“"
                            },
                            {
                                "example_id": "1d3e0d21-8059-4725-a9d8-2f1d1301a25b",
                                "sense_id": "e78eaa3a-e808-395f-8dde-16f6bdae1de7",
                                "text": "„Zu den Kolonisten, welche die Krim besiedelten, gehörten neben Russen auch Griechen, Bulgaren und Deutsche.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f51f0511-2b30-42fd-8bcd-4731a6fd6b90",
                        "source_entry_id": "7dd91749-e031-3ecd-9e70-658e8cbda72e",
                        "source_sense_id": "ac5a2cd9-7454-32c9-bb00-9f8d6ce4e88c",
                        "source_sense_description": "Person, die in einer Kolonie ansässig ist",
                        "target_lang_word": "settler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "settler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who settles in a new location, especially one who takes up residence in a previously uninhabited place; a colonist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7939f95-5ddf-4655-821d-910db909bc84",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "the first settlers of New England"
                                            },
                                            {
                                                "example_id": "52579e07-6333-46ef-88dd-f34be51f8b08",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "The law, which let settlers stay on private land if they had built there without knowing the property belonged to Palestinians or had done so at the state’s direction, was backed by Israel’s most right-wing governing coalition to date."
                                            },
                                            {
                                                "example_id": "a96ceb0e-4704-4f57-a394-17ba58908b57",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "It was the racist, settler colonialism that created whiteness, that created blackness, half-caste, quarter-caste, octoroon, that saw mixed-race people as a third race. […] This belief was one of the drivers of the ‘protection’ laws that led to the settler government’s theft of children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f6dfcc-cc19-3cd8-a353-b98529b3dcca",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who decides or settles something, such as a dispute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5146319-0904-3f07-bdc9-7d0926625dec",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "That which settles or finishes, such as a blow that decides a contest."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4ceef8-d623-33f8-a7a0-24115af212b1",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "The person in a betting shop who calculates the winnings."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A drink which settles the stomach, especially a bitter drink, often a nightcap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525268af-54b3-4f76-b911-29805489aefe",
                                                "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                                "text": "[H]aving got out the rum bottle for a quiet “settler” just as the victim of his fascinations glided through the carefully adjusted door, he had been persuaded to go on drinking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A vessel, such as a tub, in which something, such as pulverized ore suspended in a liquid, is allowed to settle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b2a9f2-7664-466b-962d-12e5514cfbac",
                                                "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                                "text": "First, there will be little reaction in the settler so that the concentrations of soluble constituents in the recycle stream are the same as those in the bioreactor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
