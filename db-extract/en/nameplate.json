    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "db08da49-d4d7-366e-adfd-a29d29dd556c",
                "word": "nameplate",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "92b15b92-3864-49c5-a058-454df94f40a3",
                        "entry_id": "db08da49-d4d7-366e-adfd-a29d29dd556c",
                        "tags": [
                            "plural"
                        ],
                        "form": "nameplates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d64108d6-3bf8-31ed-8571-cdbf0bc4d103",
                        "entry_id": "db08da49-d4d7-366e-adfd-a29d29dd556c",
                        "glosses": [
                            "A plate or plaque inscribed with a name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d0d3935-34cd-4ecf-9711-59496ae8ddd2",
                                "sense_id": "d64108d6-3bf8-31ed-8571-cdbf0bc4d103",
                                "text": "the nameplate on a locomotive"
                            },
                            {
                                "example_id": "da91d30a-1ec3-4c88-b515-0c83024823b9",
                                "sense_id": "d64108d6-3bf8-31ed-8571-cdbf0bc4d103",
                                "text": "the brass nameplate on the doctor's front door"
                            },
                            {
                                "example_id": "0835234d-6ce8-4cf1-a31a-fabb41ed7549",
                                "sense_id": "d64108d6-3bf8-31ed-8571-cdbf0bc4d103",
                                "text": "No. 6959 is painted in the standard wartime black livery and, like its immediate predecessors, does not carry a nameplate, but the words \"Hall Class\" have been painted on the middle coupled-wheel splasher."
                            },
                            {
                                "example_id": "b71a4985-f652-432a-bca0-3a43deddbc10",
                                "sense_id": "d64108d6-3bf8-31ed-8571-cdbf0bc4d103",
                                "text": "Now the chintzy nameplate is all that distinguishes his work space from those of the photocopier repairperson, diet food company, and kitchen designer down the hall."
                            },
                            {
                                "example_id": "a2eb97f2-bbab-4ae2-987c-ac6bfdaccf2e",
                                "sense_id": "d64108d6-3bf8-31ed-8571-cdbf0bc4d103",
                                "text": "By March 1994, it had moved to Cardiff Canton, and was still allocated there when its nameplates were taken off in March 1997."
                            }
                        ]
                    },
                    {
                        "sense_id": "34c9f134-5f94-37d3-9b88-c4871335b937",
                        "entry_id": "db08da49-d4d7-366e-adfd-a29d29dd556c",
                        "glosses": [
                            "The masthead of a newspaper."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40c7e548-263b-47dd-bc21-f1595c810baf",
                        "source_entry_id": "db08da49-d4d7-366e-adfd-a29d29dd556c",
                        "source_sense_description": "A plate or plaque inscribed with a name",
                        "target_lang_word": "naambord",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naambord",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f8224e5e-e44a-3952-9c2c-def02248d150",
                                        "entry_id": "5e97c39e-43c4-3b31-89b5-1a31fccc5548",
                                        "glosses": [
                                            "een bordje naast de voordeur met de namen van de bewoners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162f62be-eba5-4576-9946-fecbb569836f",
                                                "sense_id": "f8224e5e-e44a-3952-9c2c-def02248d150",
                                                "text": "Het naambordje bevatte niet alleen de voornamen van de ouders en de kinderen, maar ook de namen van de huisdieren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fb30fe8-830d-31a1-9391-051c8d627d0c",
                                        "entry_id": "5e97c39e-43c4-3b31-89b5-1a31fccc5548",
                                        "glosses": [
                                            "andere situaties waarbij namen op een plaatje staan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aba2031-957f-4f63-8f5f-c808fdd17a79",
                                                "sense_id": "7fb30fe8-830d-31a1-9391-051c8d627d0c",
                                                "text": "Naast de deur van het kantoor hangt een naambordje met de namen van de personen die in het kantoor werken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a3bd6aa-d06a-4409-919e-46443b430802",
                        "source_entry_id": "db08da49-d4d7-366e-adfd-a29d29dd556c",
                        "source_sense_description": "A plate or plaque inscribed with a name",
                        "target_lang_word": "plaque (de nom)",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "10cb2201-24df-47e9-91f2-55e00fa002f9",
                        "source_entry_id": "db08da49-d4d7-366e-adfd-a29d29dd556c",
                        "source_sense_description": "A plate or plaque inscribed with a name",
                        "target_lang_word": "Namensschild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namensschild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                        "entry_id": "2845e59f-502c-3301-a21a-d2ca4bd9fd99",
                                        "glosses": [
                                            "an einem Gegenstand befestigte kleine beschriftete Platte zur Erläuterung (etwa an Denkmälern der Name des Dargestellten, des Künstlers, an Gebäuden die Namen der Bewohner, der ansässigen Firma)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc415ff7-037a-4a41-986c-136c56a04cfb",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "Jetzt wohnen wir schon seit zwei Wochen hier und haben immer noch kein neues Namensschild an der Haustür angebracht."
                                            },
                                            {
                                                "example_id": "801bad8d-fdf9-4416-8a67-45ac22bcd8f7",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„Staszek ging hinaus und versuchte das Namensschild zu entziffern und drückte gegen die Tür.“"
                                            },
                                            {
                                                "example_id": "bd42e52f-ee6c-484a-984c-8297c6417f18",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„Während seines Versuchs, das Namensschild zu entziffern, hatte Almuth die Tür geöffnet.“"
                                            },
                                            {
                                                "example_id": "b1087fd9-e9ad-4cb4-a303-2e9e81442c00",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„An der Tür zu den Büroräumen, wo Felber jetzt die Anwaltspraxis führte, befand sich noch das alte Namensschild.“"
                                            },
                                            {
                                                "example_id": "8ecb5b95-9d33-4700-b7e8-3811b228ae84",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„Ein Namensschild an der Tür mit Titel erscheint vielen als ein Zeichen von Arroganz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                        "entry_id": "2845e59f-502c-3301-a21a-d2ca4bd9fd99",
                                        "glosses": [
                                            "an der Kleidung befestigtes Schildchen, um den Hals getragene Karte oder Ähnliches mit dem Namen des Trägers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "523f572f-7e16-45a8-808c-c889274d68f4",
                                                "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                                "text": "Tragen eigentlich alle Polizisten Namensschilder?"
                                            },
                                            {
                                                "example_id": "6a802b0d-5be2-4aee-987c-1ae82ba98856",
                                                "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                                "text": "„Wir sollten Namensschilder malen.“"
                                            },
                                            {
                                                "example_id": "01432baa-fdbf-4a07-8ae8-29b32efa9b05",
                                                "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                                "text": "„Sie zeigt auf ihr Namensschild, das sie an ihrer weißen Bluse trägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
