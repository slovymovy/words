                    {
                        "translation_id": "e0f9e16b-6d56-4f47-b164-b804c95006bb",
                        "source_entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                        "source_sense_description": "short break",
                        "target_lang_word": "Verschnaufpause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschnaufpause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8a3682-5dbe-3726-895d-63a886a2acc4",
                                        "entry_id": "6167f326-f359-33c5-9b38-0026a14e531b",
                                        "glosses": [
                                            "Pause, um sich kurz zu regenerieren und Luft zu schöpfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e846a1-7178-4008-9e7f-8745ec805b3c",
                                                "sense_id": "6e8a3682-5dbe-3726-895d-63a886a2acc4",
                                                "text": "Nach dreißig Minuten Ausdauerlauf brauchte er dringend eine Verschnaufpause."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b405f953-2c82-3d05-aa83-1914bf535619",
                                        "entry_id": "6167f326-f359-33c5-9b38-0026a14e531b",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4f924f-76be-43e8-90d8-72dfb7e2853f",
                                                "sense_id": "b405f953-2c82-3d05-aa83-1914bf535619",
                                                "text": "„Jetzt, siegestrunken und mit einer Verschnaufpause bedacht, hatten die Deutschen wieder Zeit, um sich erneut mit uns zu befassen, obwohl man nicht sagen kann, daß sie uns während der Kämpfe im Westen ganz vergessen hätten.“"
                                            },
                                            {
                                                "example_id": "805c395f-d016-4f96-9acf-896f994d0eab",
                                                "sense_id": "b405f953-2c82-3d05-aa83-1914bf535619",
                                                "text": "„Zum Jahresauftakt 2025 gab es eine kurze Verschnaufpause [des öffentlichen Konsums], die im Zusammenhang mit der vorläufigen Haushaltsführung des Bundes stehen dürfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2495a069-9066-4eea-b9b2-f68faab61855",
                        "source_entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                        "source_sense_description": "short break",
                        "target_lang_word": "Atempause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atempause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94832fe6-f4a2-3fbc-ad75-548251027f9d",
                                        "entry_id": "06553d8b-605d-331d-9d7b-63aad23c9eac",
                                        "glosses": [
                                            "kurze Erholungsphase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af7df316-f055-47db-a913-928735366a3d",
                                                "sense_id": "94832fe6-f4a2-3fbc-ad75-548251027f9d",
                                                "text": "Nach dieser Anstrengung brauchen wir unbedingt eine Atempause."
                                            },
                                            {
                                                "example_id": "8c34da40-3b41-4597-8d63-4e598b98c641",
                                                "sense_id": "94832fe6-f4a2-3fbc-ad75-548251027f9d",
                                                "text": "„Dann, wenn die Seele nach einer Atempause verlangt, zieht es mich je nach Stimmungslage auf den malerischen Wartburg-Weihnachtsmarkt oder ich lasse mich in der illuminierten Kulisse des Erfurter Domplatzes treiben.“"
                                            },
                                            {
                                                "example_id": "bce98891-5ddc-45ce-aff1-bb033dea44a1",
                                                "sense_id": "94832fe6-f4a2-3fbc-ad75-548251027f9d",
                                                "text": "„Diese Atempause bekam es so und so nicht, und Lenin war Realist genug, es zu wissen.“"
                                            },
                                            {
                                                "example_id": "399ad511-4582-46f7-b524-aeb1962c0a9f",
                                                "sense_id": "94832fe6-f4a2-3fbc-ad75-548251027f9d",
                                                "text": "„Jetzt bekam sie immerhin eine Atempause.“"
                                            },
                                            {
                                                "example_id": "2b5f6146-1ba7-4922-b6d8-56e8a9595215",
                                                "sense_id": "94832fe6-f4a2-3fbc-ad75-548251027f9d",
                                                "text": "„Er zwang sich mühsam, und nach einer kleinen Atempause fiel das wahnsinnige Karussell von ihm ab, genauso schnell, wie es gekommen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
