                "senses": [
                    {
                        "sense_id": "bdf813d7-0eb2-3327-869e-cf322cfbeacb",
                        "entry_id": "3395c9a4-a3d4-322a-ac44-9b691250e83f",
                        "glosses": [
                            "Confectionner des verrines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2605d2b-9caa-4318-afa0-54ec3a39659e",
                                "sense_id": "bdf813d7-0eb2-3327-869e-cf322cfbeacb",
                                "text": "Verriner avec classe (et non pas verser dans de vulgaires pots de yaourts en laissant des marques sur les bords."
                            },
                            {
                                "example_id": "a26a42d1-2769-474c-8715-736a0daf4fdc",
                                "sense_id": "bdf813d7-0eb2-3327-869e-cf322cfbeacb",
                                "text": "Dans quelques heures, nous allons tartiner, verriner, terriner..."
                            },
                            {
                                "example_id": "991531e9-a4e8-4f66-b1ac-33845159e34a",
                                "sense_id": "bdf813d7-0eb2-3327-869e-cf322cfbeacb",
                                "text": "Inspirée par ma gelée de framboises, et ayant encore dans le congélateur de la pulpe de fruits de la passion, je décide de \"verriner\" encore une fois."
                            }
                        ]
                    }
