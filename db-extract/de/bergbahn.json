                ],
                "senses": [
                    {
                        "sense_id": "8a38b4d8-3198-3ff8-8ec8-5df4a544ef0b",
                        "entry_id": "3b7c6dfb-ff69-3373-a1cf-ddb02fffd57e",
                        "glosses": [
                            "Verkehrsmittel zur Beförderung von Personen und Gütern auf einen Berg, auf eine Erhebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc3f82cd-10d5-4c01-8a9f-bc46f8ed0664",
                                "sense_id": "8a38b4d8-3198-3ff8-8ec8-5df4a544ef0b",
                                "text": "„Die Zahnradbahn auf das 2349 Meter hohe Rothorn ist die einzige Bergbahn der Schweiz, die noch regelmäßig mit Dampf betrieben wird; […].“"
                            },
                            {
                                "example_id": "e5e247d9-48b0-4d0f-8d89-1255e0a87aa7",
                                "sense_id": "8a38b4d8-3198-3ff8-8ec8-5df4a544ef0b",
                                "text": "„Zehn Bergbahnen zwischen Bad Reichenhall und Oberaudorf wollen ihre Kräfte bündeln und unter der Dachmarke ‚Gipfelglück‘ um Touristen und Freizeitgäste werben.“"
                            },
                            {
                                "example_id": "ffbbf5b1-c446-48d0-9ff7-0a201bc339fb",
                                "sense_id": "8a38b4d8-3198-3ff8-8ec8-5df4a544ef0b",
                                "text": "„Einen Beitrag dazu leisten die unzähligen Bergbahnen. Durch sie wird das Gebiet auch zum Eldorado für Gleitschirm- und Deltaflieger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
