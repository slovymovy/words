                "senses": [
                    {
                        "sense_id": "97823c12-60f4-35c4-9003-e33179c64e9f",
                        "entry_id": "d5ee85b5-b8cd-3ffe-b0f7-d4f548169239",
                        "glosses": [
                            "in der Diaspora lebende Gemeinde"
