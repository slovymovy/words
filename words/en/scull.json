{
    "word_family": [
        "sculler"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "97e73432-7c10-3653-b4c1-d75b3060dfa0",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is a researcher named <w>Scull</w>.",
                            "target_lang_translations": {
                                "ru": "Автор статьи — исследователь по фамилии <w>Скалл</w>."
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Scull</w> live in the southern United States.",
                            "target_lang_translations": {
                                "ru": "Многие люди с фамилией <w>Скалл</w> живут на юге Соединенных Штатов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Скалл",
                                "target_lang_sense_clarification": "Транслитерация фамилии."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "098bde06-1182-3660-b0f9-45b0e0e2f8ec",
                    "sense_definition": "To drink the entire contents of a drinking vessel without pausing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>scull</w> his drink before leaving the bar.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>выпить залпом</w> свой напиток перед уходом из бара."
                            }
                        },
                        {
                            "text": "The competition required participants to <w>scull</w> a pint of water as quickly as possible.",
                            "target_lang_translations": {
                                "ru": "Соревнование требовало от участников <w>осушить</w> пинту воды как можно быстрее."
                            }
                        }
                    ],
                    "synonyms": [
                        "chug",
                        "down"
                    ],
                    "common_phrases": [
                        "scull a beer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпить содержимое сосуда залпом, не останавливаясь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпить залпом",
                                "target_lang_sense_clarification": "Общее выражение для быстрого питья."
                            },
                            {
                                "target_lang_word": "осушить",
                                "target_lang_sense_clarification": "Разговорный вариант, означающий выпить всё до дна."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1653c256-6b93-372c-9c10-0ec9a597acb2",
                    "sense_definition": "To row a boat using a scull or sculls.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete began to <w>scull</w> across the calm lake early in the morning.",
                            "target_lang_translations": {
                                "ru": "Спортсмен начал <w>грести парными веслами</w> по спокойному озеру рано утром."
                            }
                        },
                        {
                            "text": "It takes great balance to <w>scull</w> a narrow racing boat effectively.",
                            "target_lang_translations": {
                                "ru": "Требуется отличное равновесие, чтобы эффективно <w>грести парными веслами</w> на узкой гоночной лодке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грести на лодке, используя парные весла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грести парными веслами",
                                "target_lang_sense_clarification": "Техническое описание процесса гребли."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf77bf00-9731-3f61-96f6-dcb217ef6366",
                    "sense_definition": "To skate while keeping both feet in contact with the ground or ice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "skating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The figure skater learned to <w>scull</w> to gain momentum without lifting her blades.",
                            "target_lang_translations": {
                                "ru": "Фигуристка научилась <w>скользить</w>, чтобы набрать скорость, не отрывая лезвия ото льда."
                            }
                        },
                        {
                            "text": "Beginners often practice how to <w>scull</w> to improve their balance on the ice.",
                            "target_lang_translations": {
                                "ru": "Новички часто тренируются <w>скользить</w>, чтобы улучшить равновесие на льду."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скользить на коньках, не отрывая лезвия от поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "Движение на коньках без отрыва ног."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e3dfa92-0841-3020-bafe-b33f34ea80d4",
                    "sense_definition": "A light rowing boat used for racing by one, two, or four rowers, each operating two oars.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rower prepared his <w>scull</w> for the upcoming regatta.",
                            "target_lang_translations": {
                                "ru": "Гребец подготовил свою <w>парную лодку</w> к предстоящей регате."
                            }
                        },
                        {
                            "text": "She spent hours training in her single <w>scull</w> on the river.",
                            "target_lang_translations": {
                                "ru": "Она часами тренировалась на своей <w>одиночке</w> на реке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая спортивная лодка для академической гребли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́рная ло́дка",
                                "target_lang_sense_clarification": "Спортивный термин для лодки с парными веслами."
                            },
                            {
                                "target_lang_word": "одиночка",
                                "target_lang_sense_clarification": "Спортивная лодка для одного гребца."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fd3d4db-5e0f-34be-b9aa-d6fe8db80029",
                    "sense_definition": "One of a pair of oars handled by a single rower.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He checked that each <w>scull</w> was properly attached to the boat.",
                            "target_lang_translations": {
                                "ru": "Он проверил, чтобы каждое <w>весло</w> было правильно прикреплено к лодке."
                            }
                        },
                        {
                            "text": "The rower pulled both <w>sculls</w> through the water with equal force.",
                            "target_lang_translations": {
                                "ru": "Гребец тянул оба <w>парных весла</w> через воду с одинаковой силой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно из пары весел, используемых гребцом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весло",
                                "target_lang_sense_clarification": "Общее название для гребного инструмента."
                            },
                            {
                                "target_lang_word": "парное весло",
                                "target_lang_sense_clarification": "Специфическое весло для академической гребли."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa8455f8-12d9-3d1d-94fa-f1f9726bda03",
                    "sense_definition": "A shoal of fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>scull</w> of herring moved through the deep water.",
                            "target_lang_translations": {
                                "ru": "Большой <w>косяк</w> сельди двигался в глубокой воде."
                            }
                        },
                        {
                            "text": "The fishermen spotted a <w>scull</w> of fish near the surface.",
                            "target_lang_translations": {
                                "ru": "Рыбаки заметили <w>косяк</w> рыбы у поверхности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Косяк рыбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косяк",
                                "target_lang_sense_clarification": "Стая рыб, движущаяся вместе."
                            },
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "Общее обозначение группы рыб."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}