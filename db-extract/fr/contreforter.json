                "senses": [
                    {
                        "sense_id": "59fefbbe-4a0c-3328-8719-fdb212fbe840",
                        "entry_id": "1535c21a-da4c-3595-b6db-2f28ead89ddc",
                        "glosses": [
                            "Doter de contreforts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d67e49-63e8-4bd9-942c-1533dfff82e9",
                                "sense_id": "59fefbbe-4a0c-3328-8719-fdb212fbe840",
                                "text": "Plus haut encore, toujours sur la gauche, se dresse une maison ancienne que l’on a dû ultérieurement contreforter et qui conserve dans ses murs les vestiges d’une baie à croisée en bois."
                            },
                            {
                                "example_id": "763b06c9-ee1c-4f50-b757-40bd3c2ae1a3",
                                "sense_id": "59fefbbe-4a0c-3328-8719-fdb212fbe840",
                                "text": "Reste que le rebelle, le solitaire supérieur ne perd rien à contreforter sa faroucherie par une microsociété d’admiration mutuelle dont l’aura collégiale rehausse chacun des élus cooptés."
                            }
                        ]
                    }
