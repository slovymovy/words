                ],
                "senses": [
                    {
                        "sense_id": "9c379518-6a4c-3f57-8c0b-e154411cb407",
                        "entry_id": "97bc61b4-43a7-32c3-bbb9-184cb3515b78",
                        "glosses": [
                            "разг. начать шаркать (о ногах, обуви)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e10f25-c051-4ade-9b47-cfd9fe3f183b",
                                "sense_id": "9c379518-6a4c-3f57-8c0b-e154411cb407",
                                "text": "Хлопнула калитка, по земле зашаркали тяжёлые шаги."
                            },
                            {
                                "example_id": "fd494ea7-8678-4f62-8b70-86775650214b",
                                "sense_id": "9c379518-6a4c-3f57-8c0b-e154411cb407",
                                "text": "В коридоре тяжело захлопало, зашаркало и придушенно вздохнуло: «ах-хо-хо»."
                            },
                            {
                                "example_id": "c5152988-e3db-43d2-9941-de35b6fcc54d",
                                "sense_id": "9c379518-6a4c-3f57-8c0b-e154411cb407",
                                "text": "Но ещё гораздо раньше зашаркали в коридоре по полу щетки."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e534e6b-7d72-31d0-97ea-08a24084d6f4",
                        "entry_id": "97bc61b4-43a7-32c3-bbb9-184cb3515b78",
                        "glosses": [
                            "разг. пойти шаркая, шаркающей походкой (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ff37cd-9e19-4de3-bdf0-fbee9e7c9de7",
                                "sense_id": "7e534e6b-7d72-31d0-97ea-08a24084d6f4",
                                "text": "Старухи одна за другой зашаркали к выходу."
                            }
                        ]
                    }
                ],
