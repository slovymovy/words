                        "examples": [
                            {
                                "example_id": "e43f9fc3-c386-4280-9583-3d2c7cf55627",
                                "sense_id": "49d1db04-a478-3d39-ac3b-72cdede3beb2",
                                "text": "Pożegnałem MacCormicka i umieściłem się w brankardzie razem z obsługą pociągu."
                            },
                            {
                                "example_id": "7bdadca5-e64e-4851-af2a-525235170a2a",
                                "sense_id": "49d1db04-a478-3d39-ac3b-72cdede3beb2",
                                "text": "Nie zwróciłbym na to uwagi, gdyby nie niemieccy kolejarze, którzy nic nie mówiąc zaczęli zeskakiwać z brankardu."
                            }
                        ],
