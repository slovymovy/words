{
    "word_family": [
        "spot",
        "spotlessly",
        "spotlessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d14c3856-94a8-3bd7-9eb5-3ed0bc614ec9",
                    "sense_definition": "Exceptionally clean and free from any dirt or marks.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleanliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the entire morning scrubbing the kitchen until every surface was <w>spotless</w>.",
                            "target_lang_translations": {
                                "ru": "Она провела все утро, оттирая кухню, пока каждая поверхность не стала <w>безупречно чистой</w>.",
                                "cs": "Strávila celé dopoledne drhnutím kuchyně, dokud nebyl každý povrch <w>bez poskvrnky</w>."
                            }
                        },
                        {
                            "text": "The hotel staff works hard to keep the lobby in <w>spotless</w> condition for the guests.",
                            "target_lang_translations": {
                                "ru": "Персонал отеля усердно работает, чтобы поддерживать вестибюль в <w>идеальной чистоте</w> для гостей.",
                                "cs": "Personál hotelu tvrdě pracuje, aby udržoval lobby pro hosty v <w>zářivě čistém</w> stavu."
                            }
                        }
                    ],
                    "synonyms": [
                        "immaculate",
                        "spick-and-span",
                        "clean"
                    ],
                    "antonyms": [
                        "dirty",
                        "filthy",
                        "stained"
                    ],
                    "common_phrases": [
                        "spotless condition",
                        "keep it spotless"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно чистый, без следов грязи или пятен.",
                        "cs": "Výjimečně čistý a bez jakýchkoliv nečistot nebo skvrn."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безупречно чистый",
                                "target_lang_sense_clarification": "о поверхностях или помещениях"
                            },
                            {
                                "target_lang_word": "чистейший",
                                "target_lang_sense_clarification": "очень чистый"
                            },
                            {
                                "target_lang_word": "сияющий чистотой",
                                "target_lang_sense_clarification": "о результате уборки"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "bez poskvrnky",
                                "target_lang_sense_clarification": "o čistotě povrchů nebo prostor"
                            },
                            {
                                "target_lang_word": "zářivě čistý",
                                "target_lang_sense_clarification": "o výsledku úklidu"
                            },
                            {
                                "target_lang_word": "čistý jako ze škatulky",
                                "target_lang_sense_clarification": "idiomatické vyjádření pro dokonalou čistotu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7406b7c0-1933-3674-b64d-521c4bc4d46a",
                    "sense_definition": "Free from moral blemish or faults; impeccable in character or reputation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "purity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate maintained a <w>spotless</w> reputation throughout his long career in public service.",
                            "target_lang_translations": {
                                "ru": "Кандидат сохранял <w>незапятнанную</w> репутацию на протяжении всей своей долгой карьеры на государственной службе.",
                                "cs": "Kandidát si po celou svou dlouhou kariéru ve veřejné službě udržel <w>bezúhonnou</w> pověst."
                            }
                        },
                        {
                            "text": "Her <w>spotless</w> record as an employee made her the perfect choice for the promotion.",
                            "target_lang_translations": {
                                "ru": "Ее <w>безупречный</w> послужной список сделал ее идеальным кандидатом на повышение.",
                                "cs": "Její <w>bezúhonný</w> pracovní záznam z ní udělal perfektní volbu pro povýšení."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsullied",
                        "immaculate"
                    ],
                    "antonyms": [
                        "tarnished",
                        "corrupt"
                    ],
                    "common_phrases": [
                        "spotless reputation",
                        "spotless record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный от моральных недостатков или пороков; безупречный по характеру или репутации.",
                        "cs": "Prostý morálních vad nebo chyb; bezúhonný v charakteru nebo pověsti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "о репутации или послужном списке"
                            },
                            {
                                "target_lang_word": "незапятнанный",
                                "target_lang_sense_clarification": "о чести или имени"
                            },
                            {
                                "target_lang_word": "кристально чистый",
                                "target_lang_sense_clarification": "о моральных качествах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "bezúhonný",
                                "target_lang_sense_clarification": "o pověsti nebo záznamu v rejstříku"
                            },
                            {
                                "target_lang_word": "neposkvrněný",
                                "target_lang_sense_clarification": "o cti nebo jménu"
                            },
                            {
                                "target_lang_word": "křišťálově čistý",
                                "target_lang_sense_clarification": "o morálních kvalitách"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7f0659d-559e-32f8-b0f1-0473f906f30e",
                    "sense_definition": "Physically lacking any spots, dots, or natural markings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist identified a rare species of <w>spotless</w> ladybug in the deep forest.",
                            "target_lang_translations": {
                                "ru": "Биолог обнаружил в густом лесу редкий вид божьей коровки <w>без пятен</w>.",
                                "cs": "Biolog identifikoval v hlubokém lese vzácný druh slunéčka <w>bez skvrn</w>."
                            }
                        },
                        {
                            "text": "Unlike its patterned relatives, this particular breed of lily has <w>spotless</w> white petals.",
                            "target_lang_translations": {
                                "ru": "В отличие от своих узорчатых сородичей, этот сорт лилии имеет чисто-белые лепестки <w>без крапинок</w>.",
                                "cs": "Na rozdíl od svých vzorovaných příbuzných má tento konkrétní druh lilie <w>jednobarevné</w> bílé okvětní lístky."
                            }
                        }
                    ],
                    "antonyms": [
                        "spotted",
                        "speckled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически лишенный каких-либо пятен, точек или естественных отметин.",
                        "cs": "Fyzicky postrádající jakékoliv skvrny, tečky nebo přirozené značky."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без пятен",
                                "target_lang_sense_clarification": "об отсутствии окраса или узора"
                            },
                            {
                                "target_lang_word": "однотонный",
                                "target_lang_sense_clarification": "без вкраплений другого цвета"
                            },
                            {
                                "target_lang_word": "без крапинок",
                                "target_lang_sense_clarification": "без пятнышек, о лепестках"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "bez skvrn",
                                "target_lang_sense_clarification": "o absenci vzoru nebo teček"
                            },
                            {
                                "target_lang_word": "jednobarevný",
                                "target_lang_sense_clarification": "o povrchu bez jiných barevných vtrusů"
                            }
                        ]
                    }
                }
            ]
        }
