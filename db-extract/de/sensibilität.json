                    {
                        "form_id": "fc3ceed0-62d1-4991-b991-6579a2577665",
                        "entry_id": "30f0b3e1-58b0-3b0a-af4f-811b4cc146ad",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sensibilitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                        "entry_id": "30f0b3e1-58b0-3b0a-af4f-811b4cc146ad",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße empfindsame (sensible) Aufnahmebereitschaft für Signale der Umgebung und entsprechendes, reagierendes Verhalten zeigt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "e0e7a1a4-1313-40c0-bf1f-f60c49263aa9",
                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                "text": "„Aber genau wie Schüchternheit ist Sensibilität eine Eigenschaft für sich, die manchmal – aber längst nicht immer – mit Introversion einhergeht.“"
                            },
                            {
                                "example_id": "738374cd-6b7c-44c8-bc8c-2a5cf131d3d6",
                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                "text": "„Der Gleitschirmflieger benötigt Geschicklichkeit für das Aufziehen seines Segels, Sensibilität für das Schirmverhalten im Fluge und die Auf- und Abwindströmungen.“"
                            },
                            {
                                "example_id": "4d67c267-8e57-45bb-829c-63ce50fbfd17",
                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                "text": "„Das Gefühl von Wachheit und Sensibilität trage sie durch das ganze Konzert.“"
                            },
                            {
                                "example_id": "b58f2ec5-977a-428f-baa3-f2e967d0bcbf",
                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                "text": "„Dieser Mann hat Einfühlungsvermögen, Sensibilität, soziale Intelligenz und Kommunikationsfähigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9d4e225-5224-3a5d-a04b-4e3027041cf8",
                        "entry_id": "30f0b3e1-58b0-3b0a-af4f-811b4cc146ad",
                        "glosses": [
                            "Empfindlichkeit für Reize und besonders auch Schmerz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376bf71b-c8e8-4213-9a8f-ae513cf93cae",
                                "sense_id": "a9d4e225-5224-3a5d-a04b-4e3027041cf8",
                                "text": "„Unter somatoviszeraler Sensibilität versteht man alle Empfindungen, die durch Reizung der Sinnessensoren des Körpers mit Ausnahme der Sinnesorgane Auge, Ohr, Nase und Zunge ausgelöst werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8941b71c-846f-3054-882d-a51c2779cb8b",
                        "entry_id": "30f0b3e1-58b0-3b0a-af4f-811b4cc146ad",
                        "glosses": [
                            "Empfindlichkeit des Filmmaterials für Licht"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
                                "example_id": "dca537c1-8439-474b-9de4-2c09ba1a29e4",
                                "sense_id": "8941b71c-846f-3054-882d-a51c2779cb8b",
                                "text": "„Die Empfindlichkeit kennzeichnet die Sensibilität des Sensors/Films gegenüber Lichteinfall.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
