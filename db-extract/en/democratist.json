                    {
                        "sense_id": "9da15557-7beb-393e-839a-50c4ebf7bee0",
                        "entry_id": "bce2ee17-6f39-35cc-8261-1720bd835e4f",
                        "glosses": [
                            "A supporter of democracy, a democrat; specifically, an advocate of republican forms of government (originally as a supporter of the French Revolution)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e203f1-5f34-47da-ab43-09d79b9a1586",
                                "sense_id": "9da15557-7beb-393e-839a-50c4ebf7bee0",
                                "text": "You will smile here at the consistency of those democratists, who, when they are not on their guard, treat the humbler part of the community with the greatest contempt, whilst, at the same time, they pretend to make them the depositories of all power."
                            },
                            {
                                "example_id": "58ffd6fe-efab-4ebe-8311-32c30ee421e5",
                                "sense_id": "9da15557-7beb-393e-839a-50c4ebf7bee0",
                                "text": "For the democratist, “true” democracy is always just around the corner, following the widespread observance of a new political program."
                            }
                        ]
                    }
                ],
