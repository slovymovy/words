                "translations": [
                    {
                        "translation_id": "57c8ae27-a3e6-47e8-9834-ac20e0e7713a",
                        "source_entry_id": "94c5af53-bfd7-36fe-b13f-fc881a204028",
                        "source_sense_id": "fc08aa7a-7d82-347d-88ed-58ce6ebbd397",
                        "target_lang_word": "Cheshire cheese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cheshire cheese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                        "entry_id": "22c378ba-90d1-339d-950e-1608a7d91536",
                                        "glosses": [
                                            "A dense and crumbly cheese produced in the English county of Cheshire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f147e77b-eb04-4d4e-beb9-c4d5911a0d03",
                                                "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                                "text": "Would not he believe that he had the same Antipathy to a Candied Orange, or a Piece of Puff-Past, as some have to a Cheshire Cheese, or a Breast of Mutton?"
                                            },
                                            {
                                                "example_id": "14bda872-3f3a-4d91-b6d4-52c6a4a0e795",
                                                "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                                "text": "Cheshire cheeses, on account of their great size, are generally packed flat, and in a single tier only."
                                            },
                                            {
                                                "example_id": "1e4ea2f4-1370-46ed-81d0-00921cfc8697",
                                                "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                                "text": "Cheshire cheese had been sent to London from as early as the sixteenth century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
