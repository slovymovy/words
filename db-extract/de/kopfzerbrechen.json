                    {
                        "form_id": "056007fd-9625-44ac-a376-a897051fac0f",
                        "entry_id": "acf3d054-b578-3782-a45f-7e40c97a7727",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Kopfzerbrechen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32adcd0f-5a49-3f4f-8df4-c9850fb9bf0c",
                        "entry_id": "acf3d054-b578-3782-a45f-7e40c97a7727",
                        "glosses": [
                            "angestrengtes Nachdenken mit dem Ziel, ein schwieriges Problem zu lösen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b8528a-c985-45ac-bbc0-f01786e284a2",
                                "sense_id": "32adcd0f-5a49-3f4f-8df4-c9850fb9bf0c",
                                "text": "„Später dann, betroffen, unheimlich klar, gestand sie sich, daß hier eine Vorstufe jener Selbstverletzungen und Verstümmelungen vorliege, die den Irrenärzten so viel Kopfzerbrechen über ihre Patienten verursachen.“"
                            },
                            {
                                "example_id": "0c309e8a-2a15-48b9-92f7-da63ff64f6c3",
                                "sense_id": "32adcd0f-5a49-3f4f-8df4-c9850fb9bf0c",
                                "text": "„Noch mehr Kopfzerbrechen aber bereitete den Ermittlern der Inhalt seiner Hosentasche: Dort fanden sie zwei beschriebene Papierzettel - die einzig möglichen Hinweise auf die mysteriösen Umstände dieses Todesfalls.“"
                            },
                            {
                                "example_id": "90889673-838d-4f28-9cbf-63424dd0d498",
                                "sense_id": "32adcd0f-5a49-3f4f-8df4-c9850fb9bf0c",
                                "text": "„Die Wahl seiner Kleidung hatte mir einiges Kopfzerbrechen bereitet.“"
                            },
                            {
                                "example_id": "b1414e30-71dd-471a-8249-8b6b99e223d6",
                                "sense_id": "32adcd0f-5a49-3f4f-8df4-c9850fb9bf0c",
                                "text": "„Kopfzerbrechen machte mir allerdings der Teil, als ich aufwachte und merkte, dass er mir über den Kopf strich und so.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a23920c-dc50-4d8d-9810-de8d87d77fcf",
                        "source_entry_id": "acf3d054-b578-3782-a45f-7e40c97a7727",
                        "source_sense_id": "32adcd0f-5a49-3f4f-8df4-c9850fb9bf0c",
                        "source_sense_description": "angestrengtes Nachdenken mit dem Ziel, ein schwieriges Problem zu lösen",
                        "target_lang_word": "headache",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headache",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                        "entry_id": "23a6c3ad-8d0f-3fe4-bddc-302109edaa11",
                                        "glosses": [
                                            "A pain or ache in the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa39f425-fe3f-430d-90cd-72a1d2f85f12",
                                                "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                                "text": "I have a splitting headache after that party last night."
                                            },
                                            {
                                                "example_id": "082cf4c5-5bab-436d-8135-293c995ca2c4",
                                                "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                                "text": "I advise you to take some painkillers for the headache, it's probably nothing serious."
                                            },
                                            {
                                                "example_id": "c235ea89-ecb7-4afc-8e65-7c7fc92d29fe",
                                                "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                                "text": "Sometimes on television they tell you a product is \"good for headaches.\" I don't want something that's good for headaches. I want something that's bad for headaches. And good for me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a0db06-332e-307f-ba28-62a6d6171805",
                                        "entry_id": "23a6c3ad-8d0f-3fe4-bddc-302109edaa11",
                                        "glosses": [
                                            "A nuisance or unpleasant problem."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab9347e-7c0c-4a19-b43b-07429083c813",
                                                "sense_id": "91a0db06-332e-307f-ba28-62a6d6171805",
                                                "text": "The clumsy filing system has been a huge headache."
                                            },
                                            {
                                                "example_id": "2b0612d6-5c94-40b9-9d3b-26f3f90f6d6d",
                                                "sense_id": "91a0db06-332e-307f-ba28-62a6d6171805",
                                                "text": "Bogland now dominates the scene and the construction engineers must have suffered many a headache in seeking to secure a firm foundation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "531932d1-3ccf-4466-9bd2-c30f61090c54",
                        "source_entry_id": "acf3d054-b578-3782-a45f-7e40c97a7727",
                        "source_sense_id": "32adcd0f-5a49-3f4f-8df4-c9850fb9bf0c",
                        "source_sense_description": "angestrengtes Nachdenken mit dem Ziel, ein schwieriges Problem zu lösen",
                        "target_lang_word": "tourment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27d791c4-f66c-344e-af36-b664cfacc87c",
                                        "entry_id": "2e1613d4-0140-3966-930e-dd5662b0f112",
                                        "glosses": [
                                            "Supplice, torture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da748fda-c22b-4a34-97bc-ec0f0501583a",
                                                "sense_id": "27d791c4-f66c-344e-af36-b664cfacc87c",
                                                "text": "Outre ces tourments ordinaires, on voit dans les procédures faites contre les Templiers qu’ils en subirent de plus cruels encore. En quelques pays, on leur arrachait les dents ; en d’autres, on leur faisait calciner les pieds ; ailleurs, en leur suspendant des poids à différentes parties du corps, on ne craignait pas de rendre la torture même impudique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3975d5fa-d43c-3fbc-be25-69add00ed5c7",
                                        "entry_id": "2e1613d4-0140-3966-930e-dd5662b0f112",
                                        "glosses": [
                                            "Violente douleur corporelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66bc3da-9229-491c-a141-b09fb293aa6d",
                                                "sense_id": "3975d5fa-d43c-3fbc-be25-69add00ed5c7",
                                                "text": "Depuis lors, ce prince, en proie à une fièvre brûlante et aux tourments de la goutte, qu’il supportait avec une grande patience, et désillusionné par l’âge et par de cruelles expériences des choses d’ici-bas, ne s’occupa plus que de ses devoirs de chrétien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030bcec1-9a9a-3bbe-aea0-dc8859bcfb1c",
                                        "entry_id": "2e1613d4-0140-3966-930e-dd5662b0f112",
                                        "glosses": [
                                            "Grande peine morale, grand souci."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b021eb1d-77bf-458f-9c0d-ebe397273ec8",
                                                "sense_id": "030bcec1-9a9a-3bbe-aea0-dc8859bcfb1c",
                                                "text": "Quand je pouvais me plaindre en l’amoureux tourment,\nDonnant air à la flamme en ma poitrine enclose,\nJe vivais trop heureux ; las ! maintenant je n’ose\nAlléger ma douleur d’un soupir seulement."
                                            },
                                            {
                                                "example_id": "bc0a164d-e8a8-490a-9ea0-bf62b6d68c30",
                                                "sense_id": "030bcec1-9a9a-3bbe-aea0-dc8859bcfb1c",
                                                "text": "La crainte, l’espoir, la jalousie, la joie, la fureur semblent concourir toutes à la fois ou tour à tour pour rendre plus cruel le tourment de ces infortunés."
                                            },
                                            {
                                                "example_id": "1c46032f-06fb-40b7-8829-8491db3a2da6",
                                                "sense_id": "030bcec1-9a9a-3bbe-aea0-dc8859bcfb1c",
                                                "text": "Aujourd’hui je ne peux poursuivre mon œuvre qu’à la condition de travailler en sécurité, sans le tourment quotidien de la subsistance pour moi et les miens."
                                            },
                                            {
                                                "example_id": "51155678-e441-47fd-95f4-da4373698855",
                                                "sense_id": "030bcec1-9a9a-3bbe-aea0-dc8859bcfb1c",
                                                "text": "Le gendre n’avait pas le droit d’écrire grand-chose ; cependant, on le sentait en tourment pour les champs de chez lui."
                                            },
                                            {
                                                "example_id": "30a40ce7-eafc-4c97-8c1c-1a18c7dad1f0",
                                                "sense_id": "030bcec1-9a9a-3bbe-aea0-dc8859bcfb1c",
                                                "text": "« En vérité, je devrais avoir tourment de tant d’indécence. »"
                                            },
                                            {
                                                "example_id": "7666b22c-efb5-447b-8f10-44ce79267253",
                                                "sense_id": "030bcec1-9a9a-3bbe-aea0-dc8859bcfb1c",
                                                "text": "Est-ce raisonnable et moralement acceptable de plonger les citoyens, usés par tant de désillusions sur les institutions politiques, les politiciens et les médias, dans des tourments de la sorte ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
