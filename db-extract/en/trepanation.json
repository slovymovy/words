                        "sense_id": "1e089502-df82-3b2c-a55e-9507b607413f",
                        "entry_id": "f1f3c525-eaf9-3fed-a643-e47afb9b868e",
                        "glosses": [
                            "The practice of drilling a hole in the skull as a physical, mental, or spiritual treatment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eec1d140-c207-433b-ae03-60b63c054c95",
                                "sense_id": "1e089502-df82-3b2c-a55e-9507b607413f",
                                "text": "Creed had suffered […] a swelling to the brain that the tribe’s chief physic treated with trepanation."
                            },
                            {
                                "example_id": "1c7f960c-2b79-402f-8b25-0c0e50f6b231",
                                "sense_id": "1e089502-df82-3b2c-a55e-9507b607413f",
                                "text": "According to the doctors, Lula, 79, underwent a trepanation: having a 3cm hole made in the skull to insert a drain to remove the bleeding."
                            }
                        ]
                    }
                ],
