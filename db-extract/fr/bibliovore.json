                    {
                        "sense_id": "509189b4-ac3d-3587-8aac-949b2c5c6c8b",
                        "entry_id": "e0a2ac52-134a-3d2c-9f45-f12cf47bccf5",
                        "glosses": [
                            "Personne qui dévore, lit avec passion, les livres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b905dd2b-e9a8-4888-a1bf-5ef80c82d313",
                                "sense_id": "509189b4-ac3d-3587-8aac-949b2c5c6c8b",
                                "text": "Remplie de livres, elle ressemble pourtant à une mangeoire. Comme un nichoir fait pour des volatiles particuliers : les bibliovores."
                            },
                            {
                                "example_id": "f03b274d-5c30-4387-b53b-3cae772d7b48",
                                "sense_id": "509189b4-ac3d-3587-8aac-949b2c5c6c8b",
                                "text": "Tu es donc parti sur la pointe des pieds, neuf ans jour pour jour après un autre auteur et bibliovore, un autre ami tourmenté, Jean-Marie Poupart, un 9 juillet, donc, en cette fête nationale de l’Argentine aimée."
                            }
                        ]
                    }
