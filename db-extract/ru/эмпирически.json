        "ru-extract.jsonl": [
            {
                "entry_id": "78b90297-773f-3cc0-bf3d-c0bc75fef7be",
                "word": "эмпирически",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f085dafd-fffd-311e-a0ba-dfee0023efab",
                        "entry_id": "78b90297-773f-3cc0-bf3d-c0bc75fef7be",
                        "glosses": [
                            "наречие к эмпирический; опытным путём; посредством наблюдений"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "ab976157-8e16-4546-bd07-6f14e51c083c",
                                "sense_id": "f085dafd-fffd-311e-a0ba-dfee0023efab",
                                "text": "Не ограни́чиваясь приближёнными, эмпири́чески на́йденными реше́ниями, греч. геоме́тры и́щут то́чных доказа́тельств и логи́чески исче́рпывающих реше́ний пробле́мы."
                            },
                            {
                                "example_id": "659c58de-947c-4e5d-b0f5-14a7170e1c28",
                                "sense_id": "f085dafd-fffd-311e-a0ba-dfee0023efab",
                                "text": "Эмпирически было зафиксировано наличие определённых циклов в экономическом развитии, откуда следовало, что такой колебательный процесс охватывает практически все стороны воспроизводительного процесса и является имманентным свойством экономики в целом [91]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8514e6bd-73e4-42f0-9221-54c332fd2006",
                        "source_entry_id": "78b90297-773f-3cc0-bf3d-c0bc75fef7be",
                        "source_sense_id": "f085dafd-fffd-311e-a0ba-dfee0023efab",
                        "target_lang_word": "empirically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empirically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a887e10-2936-3237-b94d-550d076f9883",
                                        "entry_id": "cdd5d328-56ce-35e9-a57a-bea4ef4111de",
                                        "glosses": [
                                            "Based on experience as opposed to theoretical knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33bb28a7-0e48-4732-9fe1-47e7664c2161",
                                                "sense_id": "9a887e10-2936-3237-b94d-550d076f9883",
                                                "text": "I have no idea why this works, but empirically, it works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd31432-7b43-31e8-9f05-aeab573db780",
                                        "entry_id": "cdd5d328-56ce-35e9-a57a-bea4ef4111de",
                                        "glosses": [
                                            "Based on data and evidence gathered in the real world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7c132c-ce3f-4674-a04d-fb7131f6fa5b",
                                                "sense_id": "2cd31432-7b43-31e8-9f05-aeab573db780",
                                                "text": "We need to test this idea empirically instead of just speculating about it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "716b09d0-a516-4df0-b9b3-e90377acc8f5",
