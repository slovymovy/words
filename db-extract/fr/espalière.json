                        "glosses": [
                            "Lieu où l’on pratique la culture en espalier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19415b3-47c5-4b77-879e-90e3523e929c",
                                "sense_id": "b9624091-4194-3e62-8946-61d44383fa96",
                                "text": "Dans l’espalière, les rangées sont espacées à 2m,80, et chaque cep, planté séparément, se trouve à 1 mètre de ceux qui l’avoisinent dans la rangée."
                            },
                            {
                                "example_id": "53ec35d6-253d-4079-8759-1cf1a9210b7a",
                                "sense_id": "b9624091-4194-3e62-8946-61d44383fa96",
                                "text": "Il y avait également des vignes en conduite haute, hautins, vergers, espalières, avec pour supports soit des arbres, soit de longs échalas."
                            }
                        ]
                    }
