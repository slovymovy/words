                                    {
                                        "sense_id": "67c01760-eca7-3fcc-89a0-de86cd5e6096",
                                        "entry_id": "f643f1d8-4748-3437-87cb-8038024ae929",
                                        "glosses": [
                                            "A low, heavy, continuous sound, such as that of thunder or a hungry stomach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd26d7ab-ecb8-4972-bceb-4e0745db543f",
                                                "sense_id": "67c01760-eca7-3fcc-89a0-de86cd5e6096",
                                                "text": "The rumble from passing trucks made it hard to sleep at night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed7f56bf-ba6d-336c-8730-a318d43bfe1a",
                                        "entry_id": "f643f1d8-4748-3437-87cb-8038024ae929",
                                        "glosses": [
                                            "A street fight or brawl."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11372b8a-3aab-3fe2-93a0-a98ec42a3637",
                                        "entry_id": "f643f1d8-4748-3437-87cb-8038024ae929",
                                        "glosses": [
                                            "A rotating cask or box in which small articles are smoothed or polished by friction against each other."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be335a77-bdf9-329f-8e76-cab1196765a9",
                                        "entry_id": "f643f1d8-4748-3437-87cb-8038024ae929",
                                        "glosses": [
                                            "A seat for servants, behind the body of a carriage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2872d2b8-1d17-46da-936c-374614419f3c",
                                                "sense_id": "be335a77-bdf9-329f-8e76-cab1196765a9",
                                                "text": "Kit, well wrapped, […] was in the rumble behind."
                                            },
                                            {
                                                "example_id": "f112e149-a2fe-4acf-af1f-0ce1aad93bc4",
                                                "sense_id": "be335a77-bdf9-329f-8e76-cab1196765a9",
                                                "text": "\"I never was so sorry for any thing as for Mr. Glentworth's death,\" said Isabella Granard, endeavouring to screen her face from a small, sharp rain, to which her place in the rumble of a travelling carriage left her quite exposed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "452e7aa4-6dfe-3bd3-8d52-230f704c74df",
                                        "entry_id": "de001a19-0202-3a8c-b825-19152359375c",
                                        "glosses": [
                                            "To make a low, heavy, continuous sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae525bc-c7e9-40a4-b018-6aeba20c1658",
                                                "sense_id": "452e7aa4-6dfe-3bd3-8d52-230f704c74df",
                                                "text": "If I don't eat, my stomach will rumble."
                                            },
                                            {
                                                "example_id": "5195b8d1-9afb-40c7-a6c0-e7686ae8c632",
                                                "sense_id": "452e7aa4-6dfe-3bd3-8d52-230f704c74df",
                                                "text": "I could hear the thunder rumbling in the distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c949b9b-2b25-3d57-a83d-34d2a2d41da2",
                                        "entry_id": "de001a19-0202-3a8c-b825-19152359375c",
                                        "glosses": [
                                            "To discover deceitful or underhanded behaviour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b31cc41-7225-403b-812c-c61b6aab58c8",
                                                "sense_id": "3c949b9b-2b25-3d57-a83d-34d2a2d41da2",
                                                "text": "The police is going to rumble your hideout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44458cf2-7785-3f5e-a198-4daccfe3aa62",
                                        "entry_id": "de001a19-0202-3a8c-b825-19152359375c",
                                        "glosses": [
                                            "To move while making a rumbling noise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07eb51ac-994d-423c-a2bf-50e94dd62c53",
                                                "sense_id": "44458cf2-7785-3f5e-a198-4daccfe3aa62",
                                                "text": "The truck rumbled over the rough road."
                                            },
                                            {
                                                "example_id": "32584efc-5fdf-4e72-b8f3-56909418d2d1",
                                                "sense_id": "44458cf2-7785-3f5e-a198-4daccfe3aa62",
                                                "text": "As the train rumbled slowly over the Forth Bridge, the western sky was aflame with a particularly gorgeous sunset, and lights were twinkling from the small craft riding at anchor on the calm waters of the firth."
                                            },
                                            {
                                                "example_id": "6f4c86d5-020c-4817-b2a5-0bb69c8019d1",
                                                "sense_id": "44458cf2-7785-3f5e-a198-4daccfe3aa62",
                                                "text": "Henderson, beginning a mini-run in the team with David de Gea on paternity leave, threw out to the left flank and Shaw had only one thought – to rumble upfield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f467e93-c90f-3d33-a4f5-d1a712c328a0",
                                        "entry_id": "de001a19-0202-3a8c-b825-19152359375c",
                                        "glosses": [
                                            "To fight; to brawl."
                                        ],
                                        "tags": [
