                        "examples": [
                            {
                                "example_id": "19f736b4-5b6f-4be4-9c44-ac1e46cb9fca",
                                "sense_id": "7b6be890-c371-381c-a81d-304791d1820d",
                                "text": "„Die FDA hatte sich mit der Entscheidung dem Veto ihres eigenen wissenschaftlichen Beratungsgremiums widersetzt.“"
                            },
                            {
                                "example_id": "80767b83-cc7a-447d-afe4-41e49d81fc80",
                                "sense_id": "7b6be890-c371-381c-a81d-304791d1820d",
                                "text": "„Jeder Ebene ist ein Beratungsgremium zugeordnet.“"
                            },
                            {
                                "example_id": "5ea189e5-58d4-41c9-8095-58b8c61c68c7",
                                "sense_id": "7b6be890-c371-381c-a81d-304791d1820d",
                                "text": "„Die fachliche Projektbegleitung erfolgt teilweise durch speziell formierte Beratungsgremien (Working Groups).“"
                            },
                            {
                                "example_id": "e4ab6213-e4ac-46c8-9f6b-361800c0520f",
                                "sense_id": "7b6be890-c371-381c-a81d-304791d1820d",
                                "text": "„Neben wissenschaftlichen Ansprüchen wie Evidenz und Validität müssen Beratungsgremien zusätzlich Prozesse der Deliberation befolgen und demokratische Politikgestaltung respektieren (Pedersen 2014: 548).“"
                            }
                        ],
