                                "target_senses": [
                                    {
                                        "sense_id": "501db3f4-218a-3ccd-a2c9-e50536a02490",
                                        "entry_id": "6f3ecef2-214c-379e-bbae-369396de67fc",
                                        "glosses": [
                                            "To publish (something) in a gazette."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b8cc25b-766f-3d9e-a824-824aeda00792",
                                        "entry_id": "6f3ecef2-214c-379e-bbae-369396de67fc",
                                        "glosses": [
                                            "To announce the status of (someone) in an official gazette; this pertained to both appointments and bankruptcies."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36d98e0-ff43-45df-bd64-2b9de7c370c6",
                                                "sense_id": "5b8cc25b-766f-3d9e-a824-824aeda00792",
                                                "text": "Benjamin had already been gazetted captain and Kopp was in process of being gazetted major."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ec2ddb6-ea45-4151-8fcd-5d9b744a0ad1",
                        "source_entry_id": "9ba7cf67-150a-3b38-b8cd-002b76fe17e0",
                        "source_sense_id": "ba348b4c-1e79-3cea-909c-b5b2758fce53",
                        "source_sense_description": "abwertend, veraltet: periodisch erscheinendes Presseorgan",
                        "target_lang_word": "gazette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0259cff-71b6-3a8f-b4af-4135452e6cbe",
                                        "entry_id": "2e66853b-81cf-3b5e-9e5b-e3dd7ca42958",
                                        "glosses": [
                                            "Monnaie vénitienne valant deux sous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e97c7d-1f8a-4c5e-b70d-4c6263de842d",
                                                "sense_id": "a0259cff-71b6-3a8f-b4af-4135452e6cbe",
                                                "text": "Il se retira en cette ville (Venise) (…), n'aiant avec lui qu'une seule gazette, piece de monnoie valant trois liards de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d958c9f-0ff0-35f1-865a-85abbe734ded",
                                        "entry_id": "2e66853b-81cf-3b5e-9e5b-e3dd7ca42958",
                                        "glosses": [
                                            "Périodique, journal contenant les nouvelles politiques, littéraires ou autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bcb1a8e-e576-40db-85f1-7d29cdb6f716",
                                                "sense_id": "2d958c9f-0ff0-35f1-865a-85abbe734ded",
                                                "text": "Les gazettes et les journaux accroissent alors leur public parce que leurs lecteurs se co-abonnent à une feuille et la font circuler dans de petites sociétés ou « coteries » de dix, vingt ou trente personnes ; ils peuvent faire encore mieux et louer un local à frais communs, payer le chauffage et l’éclairage, le gardiennage et l’entretien."
                                            },
                                            {
                                                "example_id": "12ee9603-781f-4db1-b7ef-90b228b97872",
                                                "sense_id": "2d958c9f-0ff0-35f1-865a-85abbe734ded",
                                                "text": "La vieille route est une fondrière que sauf le « piéton », porteur de la gazette ou de lettres, nul étranger n’emprunte plus."
                                            },
                                            {
                                                "example_id": "d49d64a9-e63e-407a-893d-4d0f665eaeec",
                                                "sense_id": "2d958c9f-0ff0-35f1-865a-85abbe734ded",
                                                "text": "Mon père n’aime pas George Sand parce qu’elle fait paraître des feuilletons-romans dans les gazettes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e02a39e-2e9b-3acc-935c-3f0e3ece48ee",
                                        "entry_id": "2e66853b-81cf-3b5e-9e5b-e3dd7ca42958",
                                        "glosses": [
                                            "Détail minutieux et circonstancié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1cee26-0f99-45e9-a75c-74ad45f4a1fa",
                                                "sense_id": "8e02a39e-2e9b-3acc-935c-3f0e3ece48ee",
                                                "text": "Si je vous faisais une gazette de l'état de ma santé en détail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b2bf834-5f2e-3cc0-bace-26a1c10d136e",
                                        "entry_id": "2e66853b-81cf-3b5e-9e5b-e3dd7ca42958",
                                        "glosses": [
                                            "Pipelette, commère."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80683eb8-9c3b-42bb-8e0f-e337b0501cce",
                                                "sense_id": "9b2bf834-5f2e-3cc0-bace-26a1c10d136e",
                                                "text": "Cette femme est la gazette du quartier."
                                            },
                                            {
                                                "example_id": "c9d482fb-c424-4e63-b36c-9eec648ec95f",
                                                "sense_id": "9b2bf834-5f2e-3cc0-bace-26a1c10d136e",
                                                "text": "Véritable gazette vivante, Bouzille entreprenait alors de raconter à Hélène tous les commérages de ce monde de rapins et de faux antiquaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40fd59aa-8503-3bd8-9cc9-99c7a175d9cd",
                                        "entry_id": "2e66853b-81cf-3b5e-9e5b-e3dd7ca42958",
                                        "glosses": [
                                            "Nouvelles diffusées entre les personnes d'un même groupe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99422b2f-d773-4c1c-93e5-a5785c6e1225",
                                                "sense_id": "40fd59aa-8503-3bd8-9cc9-99c7a175d9cd",
                                                "text": "Les frasques de Liane alimentaient notre gazette familiale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gazette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31729230-cc72-3772-a6d1-3af66185ca81",
                                        "entry_id": "4a6167da-acd9-3688-9144-f46bee2a1b6c",
                                        "glosses": [
                                            "Protection en terre réfractaire utilisée pour l’enfournement et la cuisson de grès, terres, céramiques et porcelaines dans les fours à bois ou à charbon."
