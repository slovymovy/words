{
    "word_family": [
        "avoidance",
        "avoidable",
        "unavoidable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d631596b-27bd-36af-bce3-61ea3f5e62c2",
                    "sense_definition": "To keep away from a person, place, or thing intentionally; to prevent oneself from meeting or interacting with someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prevention_or_distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I try to <w>avoid</w> driving during rush hour because of the traffic.",
                            "target_lang_translations": {
                                "ru": "Я стараюсь <w>избегать</w> поездок в час пик из-за пробок.",
                                "zh": "因为交通拥堵，我尽量<w>避免</w>在高峰时段开车。"
                            }
                        },
                        {
                            "text": "She crossed the street to <w>avoid</w> the angry dog barking at the gate.",
                            "target_lang_translations": {
                                "ru": "Она перешла улицу, чтобы <w>избежать</w> встречи со злой собакой, лающей у ворот.",
                                "zh": "她穿过马路，以<w>避开</w>那只在门口狂吠的恶犬。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shun",
                        "steer clear",
                        "get away from",
                        "evade",
                        "elude",
                        "sidestep",
                        "dodge",
                        "shy away from",
                        "skirt",
                        "stay away from"
                    ],
                    "antonyms": [
                        "confront",
                        "deal with",
                        "engage"
                    ],
                    "common_phrases": [
                        "avoid danger",
                        "avoid contact",
                        "avoid the rush",
                        "avoid at all costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно держаться в стороне от человека, места или предмета; не допускать встречи или взаимодействия.",
                        "zh": "有意地与某人、某地或某物保持距离；防止自己与某人见面或互动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избегать",
                                "target_lang_sense_clarification": "сторониться кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "сторониться",
                                "target_lang_sense_clarification": "держаться в стороне, уклоняться от общения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "避免",
                                "target_lang_sense_clarification": "设法不接触或不遇见"
                            },
                            {
                                "target_lang_word": "躲避",
                                "target_lang_sense_clarification": "为了安全或不想见面而离开"
                            },
                            {
                                "target_lang_word": "避开",
                                "target_lang_sense_clarification": "绕过或离开某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94ad7885-a48a-306a-a1e9-5b08c166f678",
                    "sense_definition": "To try not to do something or to prevent something bad from happening.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prevention_or_distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>avoided</w> answering the difficult question by changing the subject.",
                            "target_lang_translations": {
                                "ru": "Он <w>уклонился</w> от ответа на сложный вопрос, сменив тему.",
                                "zh": "他通过转移话题来<w>规避</w>回答那个难题。"
                            }
                        },
                        {
                            "text": "We left home early to <w>avoid</w> missing the start of the movie.",
                            "target_lang_translations": {
                                "ru": "Мы вышли из дома пораньше, чтобы <w>избежать</w> опоздания к началу фильма.",
                                "zh": "我们早早出门，<w>免得</w>错过电影开场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "avert",
                        "escape",
                        "eschew",
                        "evade",
                        "dodge",
                        "steer clear of"
                    ],
                    "antonyms": [
                        "confront",
                        "deal with"
                    ],
                    "common_phrases": [
                        "avoid doing something",
                        "avoid making mistakes",
                        "avoid an accident",
                        "avoid a situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стараться не совершать какое-либо действие или предотвращать неприятные события.",
                        "zh": "试图不做某事，或防止坏事发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избегать",
                                "target_lang_sense_clarification": "воздерживаться от совершения действия"
                            },
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "стараться избежать обязанности или прямого ответа"
                            },
                            {
                                "target_lang_word": "избежать",
                                "target_lang_sense_clarification": "спастись или уберечься от чего-либо (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "避免",
                                "target_lang_sense_clarification": "防止某种情况发生"
                            },
                            {
                                "target_lang_word": "规避",
                                "target_lang_sense_clarification": "设法躲开（责任、问题等）"
                            },
                            {
                                "target_lang_word": "免得",
                                "target_lang_sense_clarification": "为了不发生某事而采取行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ac4bca6-95f4-3694-9aca-c4fcb4c45c0a",
                    "sense_definition": "To make a legal document or contract invalid or void.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that the contract should be <w>avoided</w> due to the evidence of fraud.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что контракт должен быть <w>аннулирован</w> из-за доказательств мошенничества.",
                                "zh": "律师辩称，由于存在欺诈证据，该合同应当被<w>撤销</w>。"
                            }
                        },
                        {
                            "text": "They sought to <w>avoid</w> the lease agreement in court.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>аннулировать</w> договор аренды в суде.",
                                "zh": "他们试图在法庭上<w>废除</w>这份租赁协议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "waive"
                    ],
                    "common_phrases": [
                        "avoid a contract",
                        "avoid a lease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать юридический документ или контракт недействительным.",
                        "zh": "使法律文件或合同失效或作废。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "объявлять недействительным"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "лишать законной силы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废除",
                                "target_lang_sense_clarification": "取消法律或合同的效力"
                            },
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "宣布合同或协议无效"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}