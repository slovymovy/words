                                "target_senses": [
                                    {
                                        "sense_id": "96201df6-1f83-3990-b359-c2828bcf29b6",
                                        "entry_id": "175d74d9-49a2-3122-aeac-7e82c2107157",
                                        "glosses": [
                                            "Initialism of exchange-traded fund."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f397478e-0fae-4f5a-b7ad-3e572b5f1a32",
                                                "sense_id": "96201df6-1f83-3990-b359-c2828bcf29b6",
                                                "text": "Against this backdrop, we reviewed the Kiplinger ETF 20, the list of our favorite exchange-traded funds."
                                            },
                                            {
                                                "example_id": "c0e6fc86-82fa-4412-aff2-75035f87c88a",
                                                "sense_id": "96201df6-1f83-3990-b359-c2828bcf29b6",
                                                "text": "The ProShares Bitcoin Strategy ETF began trading at $40 a share under the ticker symbol “BITO” and finished the day up 5%. The ProShares fund is the first of what is expected to be several ETFs that track bitcoin futures to debut on Wall Street."
                                            },
                                            {
                                                "example_id": "c095f51f-bf58-428a-9ea4-155b00df834d",
                                                "sense_id": "96201df6-1f83-3990-b359-c2828bcf29b6",
                                                "text": "In contrast, government bond ETFs sucked in $30.4bn, nearly double the level in September, with almost all this money heading into US Treasury funds."
                                            },
                                            {
                                                "example_id": "0164f9be-20cb-4d27-b5cf-1cc9c8d45159",
                                                "sense_id": "96201df6-1f83-3990-b359-c2828bcf29b6",
                                                "text": "According to Farside Investors’ data, spot ETH exchange-traded funds (ETFs) recorded net inflows of roughly $2.4 billion in the past six trading days, well above the $827 million in net inflows into spot BTC ETFs during the same period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
