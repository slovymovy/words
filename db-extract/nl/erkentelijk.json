                ],
                "senses": [
                    {
                        "sense_id": "06bc2df3-27b2-3012-bd4c-66db14093fdb",
                        "entry_id": "fe2cfae7-43fb-3196-868f-7f9300ad22f4",
                        "glosses": [
                            "iemand dankbaar zijn omdat hij je geholpen heeft of iets goeds voor je gedaan heeft."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77cf0e53-c7cc-4b33-8dcd-169d96a34c05",
                                "sense_id": "06bc2df3-27b2-3012-bd4c-66db14093fdb",
                                "text": "Het erkentelijke volk richtte een standbeeld op voor de belangrijke leider."
                            },
                            {
                                "example_id": "29262392-7efb-4671-90d8-78d32753d4f0",
                                "sense_id": "06bc2df3-27b2-3012-bd4c-66db14093fdb",
                                "text": "Ook dank aan Pascal Boogaert die minutieus het manuscript las. Zeer erkentelijk ben ik Fontaine Uitgevers, in het bijzonder directeur Martin Fontijn en managing uitgever Annemie Michels die in het boek geloofden en het samen met mij wilden uitgeven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb3aec2b-c9cc-4604-8cfe-bdaf0a593356",
                        "source_entry_id": "fe2cfae7-43fb-3196-868f-7f9300ad22f4",
                        "source_sense_id": "06bc2df3-27b2-3012-bd4c-66db14093fdb",
                        "target_lang_word": "erkenntlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erkenntlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8087949e-330b-35c0-a8ff-766cafd89564",
                                        "entry_id": "12e105b0-235d-32d5-b0eb-7f417f62e776",
                                        "glosses": [
                                            "so beschaffen, dass es erkannt werden kann, dass es erkennbar, offenbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1515a68c-8876-4a4d-ad48-e025360fd019",
                                                "sense_id": "8087949e-330b-35c0-a8ff-766cafd89564",
                                                "text": "„Der Burgstall ist weitgehend verebnet, die Gräben verfüllt, das Vorwerk kaum noch erkenntlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb40ee3e-ba9e-34c3-af55-e438dabf6329",
                                        "entry_id": "12e105b0-235d-32d5-b0eb-7f417f62e776",
                                        "glosses": [
                                            "für eine empfangene Tat Dank ausdrücken (durch eine Gegenleistung)"
                                        ],
                                        "tags": [
                                            "sich erkenntlich zeigen",
                                            "erweisen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca38ac26-7cd1-412b-ae38-afaa174223ba",
                                                "sense_id": "cb40ee3e-ba9e-34c3-af55-e438dabf6329",
                                                "text": "„Nach seiner Wahl zum US-Präsidenten zeigte sich Cleveland erkenntlich und ernannte Church zum Richter im dritten Gerichtsbezirk des Dakota-Territoriums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c991caad-8c01-4dd0-923b-09f604759225",
                        "source_entry_id": "fe2cfae7-43fb-3196-868f-7f9300ad22f4",
                        "source_sense_id": "06bc2df3-27b2-3012-bd4c-66db14093fdb",
                        "target_lang_word": "grateful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grateful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                        "entry_id": "6a9906e0-089f-317a-9962-3bb8655992cf",
                                        "glosses": [
                                            "Of a person or their actions, feelings, etc.: expressing gratitude or appreciation; appreciative, thankful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0512285-0953-4c24-91fc-a8412e545ae7",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "I’m grateful that you helped me out."
                                            },
                                            {
                                                "example_id": "fb3181c0-9c94-4baa-8e8d-d2dfcabafa0c",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "I cannot giue thee leſſe to be cal'd gratefull: / Thou thoughtſt to helpe me, and ſuch thankes I giue, / As one neere death to thoſe that vviſh him liue: […]"
                                            },
                                            {
                                                "example_id": "b14189da-db5b-4c2e-80d1-66fc6f1368b7",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "They ſat them dovvn, and after no more toil / Of thir ſvveet Gardning labour then ſuffic'd / To recommend coole Zephyr, and made eaſe / More eaſie, vvholſom thirſt and appetite / More grateful, to thir Supper Fruits they fell, / Nectarine Fruits vvhich the compliant boughes / Yeilded them, ſide-long as they ſat recline / On the ſoft dovvnie Bank damaskt vvith flours: […]"
                                            },
                                            {
                                                "example_id": "627e374e-4784-4104-bfac-1401903f7801",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "Ye Nations, vvho the Globe divide, / Ye num'rous Nations ſcatter'd vvide, / To God your grateful Voices raiſe: […]"
                                            },
                                            {
                                                "example_id": "4b073385-22d8-4b99-8475-9e5a455ccd5c",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "VVhen ſhe and I vvere alone, ſhe took grateful notice of the concluding part of the third Letter; vvhere ſhe is mentioned vvith ſo much tenderneſs, and in a manner ſo vvorthy of the character of the politeſt of men, as vvel reſpecting herſelf as her Sex, […]"
                                            },
                                            {
                                                "example_id": "4b0ebbbe-e852-4b72-af6e-ebaaf9b36f84",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "[T]he noble secretary had not only been given a choice toast, sung a choice song, and been hailed by the grateful plaudits of all present; but had proceeded in his attempt to fulfil the pledge which he had given at the gate to the very letter, by calling out lustily for a bottle of Geisenheim, lemons, brandy, and a bowl."
                                            },
                                            {
                                                "example_id": "964af5d5-7ee4-415c-a0a9-bd212c1d4647",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "I am touched—made grateful—proud—yes, truly proud—by your confessed affection—but— […]"
                                            },
                                            {
                                                "example_id": "2ad93052-7417-4b26-b2d1-cc67e6412ecf",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "But, they were happy, grateful, pleased with one another, and contented with the time; and when they faded, and looked happier yet in the bright sprinklings of the Spirit's torch at parting, [Ebenezer] Scrooge had his eye upon them, and especially on Tiny Tim, until the last."
                                            },
                                            {
                                                "example_id": "00739fce-b2a9-4af7-97bd-41cfde68493c",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "For the beauty of the earth, / For the glory of the skies, / For the love which from our birth / Over and around us lies: / Lord of all, to Thee we raise / This our hymn of grateful praise."
                                            },
                                            {
                                                "example_id": "8f18ff2a-9baa-41aa-b951-6b62a9f7de4e",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "Perhaps I could be gratefuller if there were any prospect of a fire."
                                            },
                                            {
                                                "example_id": "6a4cd296-a2ce-4040-976c-4be268791617",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "[Andy] Carroll thought he had equalised with his header against the bar with eight minutes left. Liverpool claimed the ball had crossed the line and Chelsea were grateful for a miraculous intervention from Cech [Petr Čech] to turn his effort on to the woodwork."
                                            },
                                            {
                                                "example_id": "7fa7f61b-5fc4-4eda-9455-62421f36717e",
                                                "sense_id": "0c5ec215-ffaa-3284-b504-72673efa0a96",
                                                "text": "Even if the resulting hypotheses fail to convince, the large amounts of lexical data gathered from a wealth of disparate sources especially by Bertoldi, Alessio and Hubschmid, are impressive in their own right, and I have made grateful use of these scholars' efforts in this study."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                        "entry_id": "6a9906e0-089f-317a-9962-3bb8655992cf",
                                        "glosses": [
                                            "Of a thing or (obsolete) person: pleasing to the mind or senses; agreeable, pleasant, welcome."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bec4c79b-ac68-47f8-9fa4-1e46144237ab",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "[T]his is a guift / Very gratefull, I am ſure of it, to expreſſe / The like kindneſſe my ſelfe, that haue beene / More kindely beholding to you then any: […]"
                                            },
                                            {
                                                "example_id": "dd3f2e16-4322-4e9d-af78-ac2b29d38d84",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "Chaſt, nothing better; vvanton, nothing vvorſe, / The grate-fulſt Bleſsing, or the greateſt Curſe."
                                            },
                                            {
                                                "example_id": "95290b38-c80d-4b58-a601-bd80340cb746",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "[T]he aſſvvagement of his [a wise man's] diſcontent conſiſts in tvvo things, formerly preſcribed as remedies againſt corporeall pain; viz. Diverſion of his thoughts from his loſſe, or the cause of it; and an application of them to thoſe things, vvhich he knovves to be gratefull and pleaſant to his mind."
                                            },
                                            {
                                                "example_id": "80f8febb-946f-4aa8-8771-7b773ed42d25",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "[page 178] The Seer, vvhile Zephyrs curl the ſvvelling deep, / Basks on the breezy ſhore, in grateful ſleep, / His oozy limbs. […] [page 180] VVith joy impetuous, to the port I ſpeed: / The vvants of nature vvith repaſt ſuffice, / 'Till night vvith grateful ſhade involv'd the skies, / And ſhed ambroſial devvs."
                                            },
                                            {
                                                "example_id": "d667456a-fac2-482c-81e4-9d5bce4392e9",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "Then in Oblivion's grateful cup I drovvn / The galling ſneer, the ſupercilious frovvn, / The ſtrange reſerve, the proud affected ſtate / Of upſtart knaves grovvn rich and fools grovvn great."
                                            },
                                            {
                                                "example_id": "853741da-ac93-4ae4-a7ea-6e280ead55e2",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "[W]hen a ſhovver comes to refreſh the earth, then the vvhole multitude [of frogs] are ſeen to quit their retreats, in order to enjoy the grateful humidity."
                                            },
                                            {
                                                "example_id": "29dde1c4-a640-4f8b-b698-448b038acc1e",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "[…] Waverley, […] walked slowly down the avenue, enjoying the grateful and cooling shade, and so much pleased with the placid ideas of rest and seclusion excited by this confined and quiet scene, that he forgot the misery and dirt of the hamlet he had left behind him."
                                            },
                                            {
                                                "example_id": "68fe9d64-1608-4a4c-934e-e4cd54e898f5",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "[T]he mimosa nilotica secerns from its roots a fluid as offensive as that of assafœtida; in the sap of its step an astringent acid; its glands give forth gum arabic; and its flowers an odour of a very grateful fragrance."
                                            },
                                            {
                                                "example_id": "8bc01395-104a-4b84-9360-dee18eb505c6",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "Fell I upon my spear, / O, death was grateful!"
                                            },
                                            {
                                                "example_id": "ea786b1e-c4c1-40d3-839e-f52af019e486",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "All balmy from the groves of Tahiti, came an indolent air, cooled by its transit over the waters; and grateful under foot, was the damp and slightly yielding beach, from which the waves seemed just retired."
                                            },
                                            {
                                                "example_id": "4deef31d-c6ab-402e-b971-6d0edf5561a8",
                                                "sense_id": "9e7cc92a-a75f-3755-b72b-51e4f1373168",
                                                "text": "The system of four-beat alliterative Anglo-Saxon poetry permitted such a range of unaccented syllables between stresses that an exact reproduction of this quality seemed undesirable. The translator, has, therefore, permitted himself no more than two unaccented syllables between stresses, except before and after a full stop where the pause sufficiently separates the light syllables. The resultant effect is a freely equivalenced anapestic measure, perhaps more grateful to modern ears than the less normalized beat of the original."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09b8fbdb-3d2c-4107-b08e-368a3b3c0e3a",
