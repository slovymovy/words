{
    "word_family": [
        "gnarl",
        "gnarled"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "952478b1-adde-3157-9f4e-1ddc8acd4a6f",
                    "sense_definition": "Having or characterized by gnarls; <w>gnarled</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old garden was filled with <w>gnarly</w> trees that looked like they had been there for centuries.",
                            "target_lang_translations": {
                                "ru": "Старый сад был полон <w>узловатых</w> деревьев, которые выглядели так, будто простояли здесь веками."
                            }
                        },
                        {
                            "text": "He reached out with his <w>gnarly</w> fingers to pick up the ancient book from the dusty shelf.",
                            "target_lang_translations": {
                                "ru": "Он протянул свои <w>корявые</w> пальцы, чтобы взять древнюю книгу с пыльной полки."
                            }
                        }
                    ],
                    "synonyms": [
                        "gnarled",
                        "knobbly",
                        "knobby"
                    ],
                    "antonyms": [
                        "smooth",
                        "straight"
                    ],
                    "common_phrases": [
                        "gnarly trees",
                        "gnarly roots",
                        "gnarly branches"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий узлы, наросты или неровности; узловатый или искривленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узловатый",
                                "target_lang_sense_clarification": "о деревьях или пальцах"
                            },
                            {
                                "target_lang_word": "корявый",
                                "target_lang_sense_clarification": "о ветках или руках"
                            },
                            {
                                "target_lang_word": "сучковатый",
                                "target_lang_sense_clarification": "о древесине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6e9fe35-c875-3812-a320-600deae2855e",
                    "sense_definition": "Excellent, attractive, or very impressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "positive_evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <w>gnarly</w> trick you performed on your skateboard at the park today.",
                            "target_lang_translations": {
                                "ru": "Это был <w>крутой</w> трюк, который ты сегодня исполнил на скейтборде в парке."
                            }
                        },
                        {
                            "text": "The surfer caught a <w>gnarly</w> wave and managed to stay on his board until the very end.",
                            "target_lang_translations": {
                                "ru": "Серфер поймал <w>офигенную</w> волну и сумел удержаться на доске до самого конца."
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "cool",
                        "rad",
                        "wicked"
                    ],
                    "antonyms": [
                        "lame",
                        "boring"
                    ],
                    "common_phrases": [
                        "gnarly wave",
                        "gnarly trick"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in surf and skate culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, впечатляющий или очень крутой (часто в сленге серферов и скейтеров)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клёвый",
