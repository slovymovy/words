{
    "word_family": [
        "vooruitgang",
        "voortgang",
        "vooruitstrevend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13340611-8d6d-3fdb-9410-d21e2b6bb99e",
                    "sense_definition": "beter worden of vorderingen maken in een bepaalde activiteit of toestand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verbetering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn leraar zegt dat ik de laatste tijd erg <w>vooruitga</w> met mijn Nederlandse grammatica.",
                            "target_lang_translations": {
                                "en": "My teacher says that I have been <w>improving</w> a lot with my Dutch grammar lately."
                            }
                        },
                        {
                            "text": "De patiënt is na de operatie gelukkig snel <w>vooruitgegaan</w> en mag morgen naar huis.",
                            "target_lang_translations": {
                                "en": "Fortunately, the patient <w>made progress</w> quickly after the surgery and is allowed to go home tomorrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbeteren",
                        "vorderen",
                        "progressie maken",
                        "beter worden"
                    ],
                    "antonyms": [
                        "achteruitgaan",
                        "verslechteren"
                    ],
                    "common_phrases": [
                        "snel vooruitgaan",
                        "met sprongen vooruitgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To get better or make progress in a specific activity or condition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "improve",
                                "target_lang_sense_clarification": "to become better in quality or skill"
                            },
                            {
                                "target_lang_word": "make progress",
                                "target_lang_sense_clarification": "to advance or develop towards a goal"
                            },
                            {
                                "target_lang_word": "advance",
                                "target_lang_sense_clarification": "to move forward in development"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54acdad9-a3b0-3277-a5a4-84565c8ec54b",
                    "sense_definition": "zich fysiek naar voren verplaatsen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De menigte begon langzaam <w>vooruit te gaan</w> toen de deuren van het stadion openden.",
                            "target_lang_translations": {
                                "en": "The crowd began to <w>move forward</w> slowly when the stadium doors opened."
                            }
                        },
                        {
                            "text": "Je moet voorzichtig <w>vooruitgaan</w> in deze smalle en donkere gang.",
                            "target_lang_translations": {
                                "en": "You must <w>advance</w> carefully in this narrow and dark corridor."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorlopen",
                        "voortbewegen",
                        "naar voren gaan"
                    ],
                    "antonyms": [
                        "achteruitgaan"
                    ],
                    "common_phrases": [
                        "langzaam vooruitgaan",
                        "voorzichtig vooruitgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically move forward."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move forward",
                                "target_lang_sense_clarification": "to physically advance in space"
                            },
                            {
                                "target_lang_word": "progress",
                                "target_lang_sense_clarification": "to move or proceed forward"
                            },
                            {
                                "target_lang_word": "advance",
                                "target_lang_sense_clarification": "to move towards the front"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca7b2104-4b1b-3f78-8924-d319f933e8f7",
                    "sense_definition": "eerder vertrekken dan anderen of voor de afgesproken tijd gaan",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zal alvast <w>vooruitgaan</w> om een goede tafel in het restaurant te reserveren.",
                            "target_lang_translations": {
                                "en": "I will <w>go ahead</w> to reserve a good table in the restaurant."
                            }
                        },
                        {
                            "text": "Als jullie nog niet klaar zijn, <w>ga</w> ik alvast <w>vooruit</w> naar de bioscoop.",
                            "target_lang_translations": {
                                "en": "If you aren't ready yet, I'll <w>go on ahead</w> to the cinema."
                            }
                        }
                    ],
                    "synonyms": [
                        "vooruitlopen",
                        "voorgaan"
                    ],
                    "antonyms": [
                        "achterblijven"
                    ],
                    "common_phrases": [
                        "alvast vooruitgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To leave earlier than others or go ahead before the agreed time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go ahead",
                                "target_lang_sense_clarification": "to leave or start before others"
                            },
                            {
                                "target_lang_word": "go on ahead",
                                "target_lang_sense_clarification": "to proceed to a destination before the rest of the group"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}