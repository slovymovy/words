                    {
                        "translation_id": "bf397d22-184d-4173-a186-ec50631f07b7",
                        "source_entry_id": "684b3fe5-ed77-33f6-8185-2fd46f2fca01",
                        "source_sense_description": "tactique militaire",
                        "target_lang_word": "guerrilla",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guerrilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "210e9677-5549-39c4-8472-8e1d47a34c83",
                                        "entry_id": "ea205b44-432f-3068-80fb-9ea0c2092b87",
                                        "glosses": [
                                            "A soldier in a small independent group, fighting against the government or regular forces by surprise raids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71876522-6558-47bb-ba80-d8565bd175e0",
                                                "sense_id": "210e9677-5549-39c4-8472-8e1d47a34c83",
                                                "text": "The right-wing paramilitary's offensive against the Marxist guerrillas failed because they did not know the terrain well enough."
                                            },
                                            {
                                                "example_id": "846727ec-a923-4e5b-a4e6-f9bb900d5e6d",
                                                "sense_id": "210e9677-5549-39c4-8472-8e1d47a34c83",
                                                "text": "From the start of its operations in Colombia, the company was on guard against the decadeslong civil strife in the country between left-wing guerrilla and right-wing paramilitary groups, witnesses have testified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec121ecb-18e0-377e-8742-9922948243b1",
                                        "entry_id": "ea205b44-432f-3068-80fb-9ea0c2092b87",
                                        "glosses": [
                                            "A non-official war carried out by small independent groups; a guerrilla war."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "939846ac-f10e-3daf-82fe-ff7193fcb369",
                                        "entry_id": "ea205b44-432f-3068-80fb-9ea0c2092b87",
                                        "glosses": [
                                            "A marketer who uses guerrilla marketing techniques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8af20039-f3bb-3575-8439-2139254220f6",
                                        "entry_id": "ea205b44-432f-3068-80fb-9ea0c2092b87",
                                        "glosses": [
                                            "A maker of guerrilla television."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guerrilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2be1b80-4862-327b-99f6-62e8bc347909",
                                        "entry_id": "42595c03-8645-309b-9823-ab0482e54bb3",
                                        "glosses": [
                                            "Relating to, using, or typical of guerrilla warfare, or its principles of small independent or non-official perpetrators."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5c80a5-e874-4fb2-96d9-ff3b57517d1f",
                                                "sense_id": "f2be1b80-4862-327b-99f6-62e8bc347909",
                                                "text": "Wherever Nicholson was most wanted, there he was sure to be found. What his life was at this time may be seen from a letter he wrote to his mother: 'I am leading a very guerrilla sort of life with seven hundred horse and foot raised among the people of the country. The chieftain who is in rebellion has eight regular regiments and sixteen guns, so that I am unable to meet them openly in the field.'"
                                            },
                                            {
                                                "example_id": "33fb87da-649d-48e1-be79-6488189476a5",
                                                "sense_id": "f2be1b80-4862-327b-99f6-62e8bc347909",
                                                "text": "On the other hand, after the fall of Feng Ling Tu, the operations of Central Shansi, and Suiyuan, troops were more guerrilla than orthodox in nature."
                                            },
                                            {
                                                "example_id": "b8d56717-03f9-4dfc-9c01-70e43a133e51",
                                                "sense_id": "f2be1b80-4862-327b-99f6-62e8bc347909",
                                                "text": "The Slovak uprising in the latter days was not guerrilla in character, which, incidentally, may have been one of the reasons for its failure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35dd337b-836c-3159-8988-1aff3da798bc",
                                        "entry_id": "42595c03-8645-309b-9823-ab0482e54bb3",
                                        "glosses": [
                                            "Relating to, using, or typical of guerrilla marketing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "866d684f-9891-48ef-81df-9b356b070e2a",
                                                "sense_id": "35dd337b-836c-3159-8988-1aff3da798bc",
                                                "text": "We took a very guerrilla approach to marketing Goin' Hollywood, in keeping with the irreverent tone of the game."
                                            },
                                            {
                                                "example_id": "df0e284b-7c59-4bd2-b202-11bb77e49b25",
                                                "sense_id": "35dd337b-836c-3159-8988-1aff3da798bc",
                                                "text": "\"Mozilla's marketing has been very guerrilla. You're not seeing it spend millions of dollars on TV. Instead, it's a powerful ground swell."
                                            },
                                            {
                                                "example_id": "e6f42651-18b6-4388-a3ff-771e3a70be9e",
                                                "sense_id": "35dd337b-836c-3159-8988-1aff3da798bc",
                                                "text": "My style is more guerrilla. I grew up in a village, a very suppressed environment. I was like one of those young kids who hated the whole conventional way of doing things. So when I started to make films it was very hand-made, very fast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97b8943-6812-3e70-a75e-bb7bc5139a81",
                                        "entry_id": "42595c03-8645-309b-9823-ab0482e54bb3",
                                        "glosses": [
                                            "Using unconventional, non-traditional, non-mainstream and often subversive practices to achieve something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "721f88c8-711f-4174-b3be-24562ab3eddf",
                                                "sense_id": "d97b8943-6812-3e70-a75e-bb7bc5139a81",
                                                "text": "guerrilla marketing"
                                            },
                                            {
                                                "example_id": "db4f3253-d8a8-4495-aa8c-c92f5d3c35ff",
                                                "sense_id": "d97b8943-6812-3e70-a75e-bb7bc5139a81",
                                                "text": "guerrilla tourism"
                                            },
                                            {
                                                "example_id": "626b09ab-856f-4d4b-ad1e-392fe05f87e2",
                                                "sense_id": "d97b8943-6812-3e70-a75e-bb7bc5139a81",
                                                "text": "guerrilla gardening"
                                            },
                                            {
                                                "example_id": "1d1747a3-d0cc-4676-93c3-68bc09e47eb5",
                                                "sense_id": "d97b8943-6812-3e70-a75e-bb7bc5139a81",
                                                "text": "The Boston demonstration, which will feature singing and guerrilla theatre, will begin at 12 noon in front of the Park Street Subway station."
                                            },
                                            {
                                                "example_id": "947bc78c-7975-4b77-9ba4-847a2a518f59",
                                                "sense_id": "d97b8943-6812-3e70-a75e-bb7bc5139a81",
                                                "text": "Jackass’s guerrilla, nonnarrative format"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9811117-5116-4d8a-9cbe-6abdb5e7e554",
                        "source_entry_id": "684b3fe5-ed77-33f6-8185-2fd46f2fca01",
                        "source_sense_description": "tactique militaire",
                        "target_lang_word": "guerilla",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guerilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4953b59f-5d3e-3bd9-8a72-3c67eefe7adf",
                                        "entry_id": "8a137da8-dec7-3937-9e09-866f36f4afe0",
                                        "glosses": [
                                            "Obsolete spelling of guerrilla, now a misspelling."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ce8058d-5085-4222-accc-fd10132a64d2",
                                                "sense_id": "4953b59f-5d3e-3bd9-8a72-3c67eefe7adf",
                                                "text": "From mother and nurse it was a guerilla gunfire of commands, and blithe, quicksilver disobedience from the three blonde, never-still little girls."
                                            },
                                            {
                                                "example_id": "ef6e4c18-628c-4b71-aa89-166001045be5",
                                                "sense_id": "4953b59f-5d3e-3bd9-8a72-3c67eefe7adf",
                                                "text": "Not a cessation of poaching, but a succession of village guerillas;—an internecive war between the gamekeepers and marauders of game;—the whole country flung into brawls and convulsions, for the unjust and exorbitant pleasures of country gentlemen."
                                            },
                                            {
                                                "example_id": "3ea9103d-386e-4cb3-90ee-ab21861d0f40",
                                                "sense_id": "4953b59f-5d3e-3bd9-8a72-3c67eefe7adf",
                                                "text": "1912, Charles Egbert Craddoc (pseudonym of Mary Noailles Murfree), “The Crucial Moment” in The Raid of the Guerilla and Other Stories, Philadelphia: Lippincott"
                                            },
                                            {
                                                "example_id": "cd4fe209-7ee5-4950-8d35-d2536b5c7802",
                                                "sense_id": "4953b59f-5d3e-3bd9-8a72-3c67eefe7adf",
                                                "text": "At Fengsien, 45 kilometres due south of Shanghai, a Japanese force attacked a band of 400 guerillas at 4 a.m. on August 13, putting them to flight."
                                            },
                                            {
                                                "example_id": "13fca2bf-0b0d-42c6-b363-2f9bf1473534",
                                                "sense_id": "4953b59f-5d3e-3bd9-8a72-3c67eefe7adf",
                                                "text": "He was telling Keng about the tactical agreement he had made with the guerillas in Muping and of his interviews with Shen Hung-lieh, chairman of the Shantung provincial government, when they suddenly heard a commotion outside.[…]\n\"Comrades,\" he said, \"we are all guerilla soldiers who have joined hands to protect our own people, not to oppress them."
                                            },
                                            {
                                                "example_id": "c504baf5-5f5e-43d2-a256-71509cc82243",
                                                "sense_id": "4953b59f-5d3e-3bd9-8a72-3c67eefe7adf",
                                                "text": "KYODO also states that, according to Indian intelligence sources, \"the guerillas were sent from their training bases around Khasgar in Xingjiang^([sic – meaning Xinjiang]) Province [in China] to the sensitive areas bordering Afghanistan\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1059d480-09b1-493a-b36c-05debd60e89d",
                        "source_entry_id": "684b3fe5-ed77-33f6-8185-2fd46f2fca01",
