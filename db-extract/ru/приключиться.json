                                        "examples": [
                                            {
                                                "example_id": "1fcac073-571d-4b1c-b9e0-769a2f640667",
                                                "sense_id": "f2c61820-a504-363b-91b4-9b34fea8accb",
                                                "text": "One little incident of my school days occurs to me as amusing."
