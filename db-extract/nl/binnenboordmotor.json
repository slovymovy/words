                "senses": [
                    {
                        "sense_id": "e6f5de02-f51e-36c4-a43c-144ee2724290",
                        "entry_id": "09c9b8c4-6640-3637-bcf2-ed4a626b501e",
                        "glosses": [
                            "een motor die binnen in het schip is geplaatst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf33376-94f1-47fd-90f2-5c42b42d00ed",
                                "sense_id": "e6f5de02-f51e-36c4-a43c-144ee2724290",
                                "text": "Een elektrische boot met binnenboordmotor is in aanschaf niet duurder dan een met een verbrandingsmotor. Dat niet en masse wordt overgestapt op elektrisch varen schrijft Schaap toe aan onbekendheid en vooroordelen."
                            },
                            {
                                "example_id": "9aaa4960-3c8b-452c-a734-31a9ec75207b",
                                "sense_id": "e6f5de02-f51e-36c4-a43c-144ee2724290",
                                "text": "Een beetje cijferwerk. We laten onze virtuele keuze via het internet vallen op een jacht uit 2004 van 6,6 meter, met een kajuit waarin je heel nipt met vier personen kan logeren, en een binnenboordmotor. Kostprijs: 29.500 euro, trailer inbegrepen. De nieuwwaarde hangt uiteraard af van het afwerkingsniveau, maar reken zeker op 50.000 euro, zo blijkt na wat opzoekwerk."
                            }
                        ]
                    }
