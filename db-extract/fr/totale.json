                                "example_id": "60341141-813c-4f19-b4ec-441cb70f5468",
                                "sense_id": "bfe2c4d2-69e7-318a-9f7e-9e9cccbdd7a4",
                                "text": "Je suis malade ça pourrait encore aller avec du repos mais je viens de me payer un torticolis. C'est la totale !"
                            }
                        ]
