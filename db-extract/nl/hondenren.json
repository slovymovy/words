                        "entry_id": "e55aded6-0a5c-31c6-8748-1ac0299b84e1",
                        "glosses": [
                            "een race met honden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce8e969-ca3e-4d0c-a86e-4e4e6e4788b6",
                                "sense_id": "35f51799-e367-38e6-8ec3-1dc5cd32d04e",
                                "text": "Merkwaardigste race ooit: hondenren met apenjockeys: Niet alleen mensen oefenen het beroep van jockey uit, ook Capucijneraapjes kunnen dat. Op de rug van een flinke hond welteverstaan. Waar anders dan in de Verenigde Staten wordt jaarlijks het Banana Derby 'Chimpionship' gehouden."
                            }
                        ]
