                                    {
                                        "sense_id": "ec6ca5f8-0773-3e4d-9d88-ba8803dee93d",
                                        "entry_id": "a7ce7bdf-c944-3014-aef9-4e7259ae2346",
                                        "glosses": [
                                            "Ville canadienne du Québec située dans la région d’Estrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f748134-da94-4673-a1a1-bdb2726febcf",
                                                "sense_id": "ec6ca5f8-0773-3e4d-9d88-ba8803dee93d",
                                                "text": "Le 10 décembre 1830, il recevait une nouvelle commission comme juge de la cour provinciale à Sherbrooke. Il occupait encore ce poste en 1838."
                                            },
                                            {
                                                "example_id": "bce11af1-b573-4dc6-9395-d57734c280ea",
                                                "sense_id": "ec6ca5f8-0773-3e4d-9d88-ba8803dee93d",
                                                "text": "Alexandre Roux a été déclaré coupable de l'homicide involontaire de son bébé de 6 semaines, jeudi après-midi, au palais de justice de Sherbrooke."
                                            },
                                            {
                                                "example_id": "aa23f88c-a88b-41f4-b14d-6aaac27b8b6b",
                                                "sense_id": "ec6ca5f8-0773-3e4d-9d88-ba8803dee93d",
                                                "text": "David Morin, politologue à l’université de Sherbrooke (Canada), a écrit, avec Marie-Ève Carignan, professeure en communication, Mon frère est complotiste, comment rétablir le lien et le dialogue social (Éd. de l’Homme), sorti début mars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1b7086-201e-3115-80fd-83a1d1ae22d9",
                                        "entry_id": "a7ce7bdf-c944-3014-aef9-4e7259ae2346",
                                        "glosses": [
                                            "Circonscription électorale fédérale du Québec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af12221c-b9e7-4c91-abf3-b4fd11b133bb",
                                                "sense_id": "2a1b7086-201e-3115-80fd-83a1d1ae22d9",
                                                "text": "À 19 ans, Pierre-Luc Dusseault a vécu lundi ses premières élections comme citoyen, et sa première victoire, comme candidat du NPD à Sherbrooke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4849c75-7be4-3fe4-a0ca-69d665c1e6aa",
                                        "entry_id": "a7ce7bdf-c944-3014-aef9-4e7259ae2346",
                                        "glosses": [
                                            "Circonscription électorale provinciale du Québec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a8b8f2-7bc3-4304-953a-0481684ac7f9",
                                                "sense_id": "b4849c75-7be4-3fe4-a0ca-69d665c1e6aa",
                                                "text": "Le ministre de la Famille, Luc Fortin, qui est aussi député de Sherbrooke, était à ses côtés pour assurer que le gouvernement soutiendra les entrepreneurs de la région."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5b2d1d6-52ed-3762-9e28-d52f646abf9d",
                                        "entry_id": "a7ce7bdf-c944-3014-aef9-4e7259ae2346",
                                        "glosses": [
                                            "Station du métro de la ville de Montréal (donnant sur la rue Sherbrooke)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761624e9-22cf-46b2-bed1-b627f31b62ee",
                                                "sense_id": "c5b2d1d6-52ed-3762-9e28-d52f646abf9d",
                                                "text": "Ajoutons à cela la piste cyclable qui passe rue Berri, la station de métro Sherbrooke et de nombreuses lignes d’autobus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6884f06b-c5b0-3fba-8503-b32c5f1cc34a",
