                                        "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                        "entry_id": "3256aa1b-8207-3d01-b847-5f83cb9e4553",
                                        "glosses": [
                                            "jemand, der etwas ansagt, ankündigt, zum Beispiel in den Medien (Rundfunk, Fernsehen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f06b3529-7a1b-467e-bb92-95d0797074f3",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Die Musik untermalte noch immer die Stimme des Ansagers.“"
                                            },
                                            {
                                                "example_id": "25426b68-8018-4bf2-938c-6b5f51c31c42",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Ich unterbrach mein Spiel, als ich drinnen die Stimme des Ansagers hörte.“"
                                            },
                                            {
                                                "example_id": "a2ccbdec-3776-4c6b-9d6f-b4a440285ddd",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Die Ansager meldeten mit Genugtuung die Zahl der im Kriege Getöteten.“"
                                            },
                                            {
                                                "example_id": "086a93fe-12a5-4de6-899f-84b491abb484",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Die Deutschen hatten eine Artillerie, die auf alle wichtigen Punkte der Stadt eingeschossen war, und sobald der Ansager eine Sendung anzusagen begann, eröffneten die Batterien das Feuer auf das Rundfunkgebäude.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
