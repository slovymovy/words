                            },
                            {
                                "target_lang_word": "úsloví",
                                "target_lang_sense_clarification": "ustálený obrat, často obrazný"
                            },
                            {
                                "target_lang_word": "pořekadlo",
                                "target_lang_sense_clarification": "obecné lidové či běžné rčení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f20f89d-031e-35df-9741-a4cba6a22a0d",
                    "sense_definition": "A theatrical play that illustrates the meaning of a specific saying.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The troupe performed a short <w>proverb</w> for the royal court.",
                            "target_lang_translations": {
                                "cs": "Soubor předvedl pro královský dvůr krátký <w>divadelní výjev na motiv přísloví</w>."
                            }
                        },
                        {
                            "text": "The play was structured as a <w>proverb</w> to teach a moral lesson.",
                            "target_lang_translations": {
                                "cs": "Hra byla vystavěna jako <w>divadelní kus založený na přísloví</w>, aby předala mravní ponaučení."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátká divadelní hra, která znázorňuje význam určitého přísloví."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "divadelní výjev na motiv přísloví",
                                "target_lang_sense_clarification": "zastarale: krátká divadelní hra založená na významu přísloví"
                            },
                            {
                                "target_lang_word": "divadelní kus založený na přísloví",
                                "target_lang_sense_clarification": "krátký didaktický scénický kus ilustrující rčení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea8af62b-132b-3e52-85a8-ec244032150e",
                    "sense_definition": "To speak or write using traditional sayings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man loved to <w>proverb</w> during his long speeches.",
                            "target_lang_translations": {
                                "cs": "Starý muž rád při svých dlouhých projevech <w>mluvil v příslovích</w>."
                            }
                        },
                        {
                            "text": "He would often <w>proverb</w> to make his points more memorable.",
                            "target_lang_translations": {
                                "cs": "Často <w>užíval přísloví</w>, aby jeho myšlenky lépe utkvěly v paměti."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mluvit nebo psát s použitím tradičních přísloví."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mluvit v příslovích",
                                "target_lang_sense_clarification": "archaicky: mluvit pomocí přísloví"
                            },
                            {
                                "target_lang_word": "užívat přísloví",
                                "target_lang_sense_clarification": "psát nebo mluvit s častým užíváním tradičních rčení"
                            }
                        ]
