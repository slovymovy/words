                "senses": [
                    {
                        "sense_id": "9c911c94-8f77-34e1-8d0e-4985b96bf541",
                        "entry_id": "7f41f2dd-f436-350d-963d-ca1e86e8013e",
                        "glosses": [
                            "Se poser à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c6d2a5-a638-4088-bfa7-9477133e88b8",
                                "sense_id": "9c911c94-8f77-34e1-8d0e-4985b96bf541",
                                "text": "S'autoposer une question est un bon piège."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b4eacc0-fc1e-362e-ac26-a04fb4cdf695",
                        "entry_id": "7f41f2dd-f436-350d-963d-ca1e86e8013e",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41f78a8d-0361-4ccb-b5ba-3441df8f34ff",
                                "sense_id": "8b4eacc0-fc1e-362e-ac26-a04fb4cdf695",
                                "text": "Pourtant l'obligation de s’autoposer, de se fonder en soi-même est primordiale."
                            },
                            {
                                "example_id": "ac99f8db-a79f-44e6-88fc-8737e6ab8258",
                                "sense_id": "8b4eacc0-fc1e-362e-ac26-a04fb4cdf695",
                                "text": "Le rite ne doit donc pas s’autoposer et finir par ne célébrer que les hauts faits d’un groupe religieux ou social."
                            }
                        ]
                    }
