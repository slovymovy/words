                "senses": [
                    {
                        "sense_id": "7c22c736-7595-337c-9c08-4edc13e52691",
                        "entry_id": "c60609ae-9bdb-3151-8e51-82578c3be808",
                        "glosses": [
                            "kleiner Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0874eaf6-9482-4009-9c23-1a6f9791ed10",
                                "sense_id": "7c22c736-7595-337c-9c08-4edc13e52691",
                                "text": "„Kiesinger, der den „homo ludens“ von Hecuzinga beschwor, warnte allerdings davor, nicht nur im Sinne des perfekten Wohlfahrtsstaates an die öffentliche Hand zu appellieren, was ja ein „leichtes Gerüchlein“ habe, sondern – wie in den USA – auch den „freudigen Bürgersinn“ zu mobilisieren.“"
                            },
                            {
                                "example_id": "2f9b438f-9285-4f95-9fe4-55a33a23bfe3",
                                "sense_id": "7c22c736-7595-337c-9c08-4edc13e52691",
                                "text": "„Da stand er offenen Mundes und kopfschüttelnd vor diesen seltsamen Wesen; er berührte mit dem Finger zaghaft die glatte Haut eines Kürbisses und steckte auch seine schlaue Nase etwas über den Zaun, um ein Gerüchlein aufzufangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
