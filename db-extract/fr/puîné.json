                    {
                        "form_id": "6c35fcfc-c566-47d4-a757-80fc08aa02f9",
                        "entry_id": "1539cefd-4afc-3a33-9978-e80f05a019d9",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "puiné"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e0a2e33-3ec8-3005-a671-fea8bdca7e8f",
                        "entry_id": "1539cefd-4afc-3a33-9978-e80f05a019d9",
                        "glosses": [
                            "Qui est né immédiatement après un frère ou une sœur aîné(e)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39e4617f-be29-49af-980d-bea6f34a188b",
                                "sense_id": "7e0a2e33-3ec8-3005-a671-fea8bdca7e8f",
                                "text": "En ce cas, la fille a sur le frère  puîné  un avantage qui consiste en ce qu'elle a la propriété de sa part, si elle se marie, tandis que le frère puîné n'a que l’usufruit de la sienne. (Art. 268 et 346)."
                            },
                            {
                                "example_id": "98be6824-3b07-45be-818f-12bf64657cf0",
                                "sense_id": "7e0a2e33-3ec8-3005-a671-fea8bdca7e8f",
                                "text": "Mes grands-parents y élèvent leurs trois enfants. Le beau Pierre, l'aîné, a seize ans. La facétieuse Juliette, la cadette, en a dix. Entre eux deux, Gabriel, le puîné, a quatorze ans."
                            },
                            {
                                "example_id": "0ebe145c-fd0a-48e4-811e-f83960af30b6",
                                "sense_id": "7e0a2e33-3ec8-3005-a671-fea8bdca7e8f",
                                "text": "Britta et Ropé eurent quatre enfants : des géants, comme eux, dont la taille et la forme dépassaient l'entendement. Le plus jeune avait pour nom Croua. Les puînés, des jumeaux, s'appelaient Alas et Algis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c8fad1a-7969-4c4c-a0de-a78cfb809555",
                        "source_entry_id": "1539cefd-4afc-3a33-9978-e80f05a019d9",
                        "source_sense_id": "7e0a2e33-3ec8-3005-a671-fea8bdca7e8f",
                        "target_lang_word": "secondborn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secondborn",
