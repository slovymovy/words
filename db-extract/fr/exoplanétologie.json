                        "glosses": [
                            "Science qui étudie des planètes appartenant à des systèmes solaires autre que celui du Soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a542c866-4733-4881-9738-83235544ce4d",
                                "sense_id": "715c8923-3cad-3aed-8461-8b422c158b4f",
                                "text": "Il avait des connaissances très précises en astronautique, en techniques de survie, en exoplanétologie..."
                            },
                            {
                                "example_id": "2a129e6c-0d53-4d00-b192-7f1107885455",
                                "sense_id": "715c8923-3cad-3aed-8461-8b422c158b4f",
                                "text": "La découverte de 51 Pegasi b est la première d'une longue série : en moins de vingt ans, on a détecté plus d'un millier d'autres exoplanètes. Les noms de Michel Mayor et Didier Queloz seront pour toujours associés à ce nouveau domaine de l'astronomie, l’exoplanétologie."
                            }
                        ]
                    }
