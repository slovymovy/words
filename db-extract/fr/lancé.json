            {
                "entry_id": "5c774114-ba47-3ee5-b25b-ff22d96c7775",
                "word": "lancé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7564fe4b-9a8b-3374-a6c6-60f56df44aa7",
                        "entry_id": "5c774114-ba47-3ee5-b25b-ff22d96c7775",
                        "glosses": [
                            "Participe passé masculin singulier du verbe lancer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4f7c884b-7502-464e-9701-0076a3f8a749",
                                "sense_id": "7564fe4b-9a8b-3374-a6c6-60f56df44aa7",
                                "text": "Derrière, le tube de néon fulgura, dans un éclatement sonore que suivit une complète obscurité : Darwin y avait lancé un siphon d’eau de seltz."
                            },
                            {
                                "example_id": "2b106b31-f5d0-4265-9728-0ce174953fac",
                                "sense_id": "7564fe4b-9a8b-3374-a6c6-60f56df44aa7",
                                "text": "Le ministère des Sports s’est lancé en 2020 dans un plan national de prévention du dopage et des conduites dopantes dans les activités physiques et sportives, dont l’aboutissement est prévu pour 2024."
                            }
                        ]
                    }
                ],
