                "senses": [
                    {
                        "sense_id": "1c1db344-0acd-3636-87e9-fbe9f70182dd",
                        "entry_id": "bc1b28c5-8064-3673-9536-6a41d5293186",
                        "glosses": [
                            "A newly married man, especially one who was previously a confirmed bachelor."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3863ccf9-c5dc-41fe-be4f-5cc9ca34d4fd",
                                "sense_id": "1c1db344-0acd-3636-87e9-fbe9f70182dd",
                                "text": "The benedict, drearily superfluous to the festivities, had hardly been noticed by her as he lurked about the walls and sought what entertainment was possible to one under the social disabilities of matrimony."
                            },
                            {
                                "example_id": "6529accb-9e55-4fa6-a4ba-60c2c57a2d8e",
                                "sense_id": "1c1db344-0acd-3636-87e9-fbe9f70182dd",
                                "text": "A quarter of a mile inland we came upon the holluschickie -- sleek young bulls, living out the loneliness of their bachelorhood and gathering strength against the day when they would fight their way into the ranks of the benedicts"
                            }
                        ]
                    }
                ],
