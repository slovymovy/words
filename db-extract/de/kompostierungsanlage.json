                "senses": [
                    {
                        "sense_id": "492fcaca-1bf1-34b7-89e5-be599024ad35",
                        "entry_id": "9e4264f4-d3c0-360e-b093-37ac6955fe17",
                        "glosses": [
                            "Anlage für die Kompostierung von Bioabfall und Gärresten; mit Sauerstoffverbrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fd79c87-b0e5-4ffa-a006-0f112040e2b2",
                                "sense_id": "492fcaca-1bf1-34b7-89e5-be599024ad35",
                                "text": "„23.000 Tonnen Grünabfälle und etwa 6.000 Tonnen Gärreste aus der Bioabfallvergärung werden jedes Jahr in der Kompostierungsanlage zu qualitätvollem Kompost.“"
                            },
                            {
                                "example_id": "fb480b22-1e33-4fd4-a956-35aee5072018",
                                "sense_id": "492fcaca-1bf1-34b7-89e5-be599024ad35",
                                "text": "„Die Kompostierungsanlage Donnerkuhle nimmt ganzjährig Ihren Grün- und Strauchschnitt entgegen.“"
                            },
                            {
                                "example_id": "d7f60bf4-10a0-425f-ad92-182a0a135b2f",
                                "sense_id": "492fcaca-1bf1-34b7-89e5-be599024ad35",
                                "text": "„Im Frühjahr und im Herbst veranstaltet die Kompostierungsanlage jeweils einen Komposttag.“"
                            },
                            {
                                "example_id": "354af96a-d4c8-489c-8cfe-55f81134fdad",
                                "sense_id": "492fcaca-1bf1-34b7-89e5-be599024ad35",
                                "text": "„Mengen über 4 cbm können Sie zur Kompostierungsanlage der ESG in Anröchte, Eichholzweg 1, bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
