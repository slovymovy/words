                "senses": [
                    {
                        "sense_id": "c090799e-037f-3087-bf62-a37f542ac6d2",
                        "entry_id": "4e6dd5f4-d63a-358e-92a8-377aff530d34",
                        "glosses": [
                            "Versorgung eines Raumes mit Frischluft durch Luftaustausch oder kontinuierlichen Luftwechsel durch eine Tür"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "1b83f295-3270-4c72-be92-e83ece69c640",
                                "sense_id": "c090799e-037f-3087-bf62-a37f542ac6d2",
                                "text": "„Kunststoffgitter als Türlüftungen in verschiedenen Farben.“"
                            },
                            {
                                "example_id": "9bd5a420-2ff2-4354-a9f5-4d8f83bcede7",
                                "sense_id": "c090799e-037f-3087-bf62-a37f542ac6d2",
                                "text": "„Diese simple Idee setzt der Prototyp einer Türlüftung technisch geschickt um.“"
                            },
                            {
                                "example_id": "7880efb3-b830-4f2f-a98a-570bf09bc99a",
                                "sense_id": "c090799e-037f-3087-bf62-a37f542ac6d2",
                                "text": "„Wie bei der Türlüftung bietet der Überströmer im Türrahmen einen bedarfsgerechten Betrieb.“"
                            },
                            {
                                "example_id": "be74ca0e-cf3e-43fb-b09a-0f1cd79f59c0",
                                "sense_id": "c090799e-037f-3087-bf62-a37f542ac6d2",
                                "text": "„Der natürliche Luftwechsel in einem Gebäude, der auch als freier Luftwechsel bezeichnet wird, beschreibt den Luftaustausch in einem Gebäude durch Öffnungen in der Gebäudehülle ,ohne Berücksichtigung von Fenster- bzw. Türlüftung.“"
                            },
                            {
                                "example_id": "0f74889f-ca08-48ee-a1aa-bf6526e65c7a",
                                "sense_id": "c090799e-037f-3087-bf62-a37f542ac6d2",
                                "text": "„Eine nicht ganz so effektive, aber im Winter sehr gute Alternative ist die Türlüftung, wodurch der Wärmeverlust verhindert werden kann.“"
                            },
                            {
                                "example_id": "8a9bf34d-ef60-4a9d-8057-a0c3dbfa03ae",
                                "sense_id": "c090799e-037f-3087-bf62-a37f542ac6d2",
                                "text": "„Dieser Effekt der „Türlüftung“ zeigt sich auch in der Verteilung der Kohlendioxidkonzentrationen: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
