                        "examples": [
                            {
                                "example_id": "4948e539-e902-42c0-8a8f-448309c17ee0",
                                "sense_id": "cd20e149-9b3e-38ad-8a8c-b08e840c18af",
                                "text": "Mittwochmittage sind immer öde."
                            },
                            {
                                "example_id": "524df2d2-5dba-4545-8d3e-f83baeb15444",
                                "sense_id": "cd20e149-9b3e-38ad-8a8c-b08e840c18af",
                                "text": "Sehen wir uns Mittwochmittag?"
                            },
                            {
                                "example_id": "fd7bcea2-dbca-49be-b57c-eb9ba470de2f",
                                "sense_id": "cd20e149-9b3e-38ad-8a8c-b08e840c18af",
                                "text": "„Am Mittwochmittag ist sie beim Spülen, als ihr einfällt, dass es auf dem Schöning-Grundstück im Schuppen wahrscheinlich Benzin gegeben hatte.“"
                            }
