        "adoration"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a06a067-776b-329c-ae5f-4b473b0b2b7c",
                    "sense_definition": "Aimer beaucoup, apprécier vivement une chose, une activité ou un aliment.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>adore</w> écouter de la musique quand je prépare le dîner."
                        },
                        {
                            "text": "Les enfants <w>adorent</w> passer leurs vacances au bord de la mer."
                        }
                    ],
                    "synonyms": [
                        "aimer",
                        "raffoler"
                    ],
                    "antonyms": [
                        "détester",
                        "haïr"
                    ],
                    "common_phrases": [
                        "adorer voyager",
                        "adorer le chocolat"
                    ]
                },
                {
                    "sense_id": "bd90ad24-797e-3edd-a872-17625e9ade10",
                    "sense_definition": "Aimer passionnément quelqu'un, lui porter un amour ou un attachement immense.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand-père attentionné <w>adore</w> ses petits-enfants et passe tout son temps avec eux."
                        },
                        {
                            "text": "Ils s'<w>adorent</w> depuis le lycée et ne se quittent presque jamais."
                        }
                    ],
                    "synonyms": [
                        "chérir",
                        "idolâtrer"
                    ],
                    "antonyms": [
                        "détester",
                        "haïr"
                    ],
                    "common_phrases": [
                        "adorer ses enfants"
                    ]
                },
                {
                    "sense_id": "2fb7b706-3ed2-3d16-816c-2d283eb49b8b",
                    "sense_definition": "Rendre un culte sacré à une divinité, lui témoigner une vénération suprême.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'Antiquité, les Égyptiens <w>adoraient</w> plusieurs dieux protecteurs."
                        },
                        {
                            "text": "Les fidèles se rassemblent dans le temple pour prier et <w>adorer</w> leur créateur."
                        }
                    ],
                    "synonyms": [
                        "vénérer"
                    ],
                    "antonyms": [
                        "blasphémer",
                        "profaner"
                    ],
                    "common_phrases": [
                        "adorer Dieu"
                    ]
                },
                {
                    "sense_id": "a7ada497-1494-3143-828a-7a395f659362",
                    "sense_definition": "Témoigner des marques de soumission ou de respect extraordinaire envers une personne puissante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la cour impériale, les dignitaires devaient se prosterner pour <w>adorer</w> le souverain."
                        },
                        {
                            "text": "Ce monarque orgueilleux exigeait que tout son peuple l'<w>adore</w> comme un être supérieur."
                        }
                    ],
                    "synonyms": [
                        "vénérer"
                    ],
                    "antonyms": [
                        "mépriser"
                    ],
                    "common_phrases": [
                        "se faire adorer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Sens lié aux cérémonies de cour ou usages anciens"
                        }
                    ]
                }
            ]
        }
    ]
}