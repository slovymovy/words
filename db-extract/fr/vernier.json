            {
                "entry_id": "0502a3a6-f240-3545-8d81-b9af5da21c4e",
                "word": "vernier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3055954-a06c-4b7e-aa22-c2334c2132d8",
                        "entry_id": "0502a3a6-f240-3545-8d81-b9af5da21c4e",
                        "tags": [
                            "plural"
                        ],
                        "form": "verniers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb04826a-89e6-3e5e-8340-dc1529ed6ee8",
                        "entry_id": "0502a3a6-f240-3545-8d81-b9af5da21c4e",
                        "glosses": [
                            "Échelle de graduation secondaire d’un instrument de mesure, permettant par une lecture analogique d’améliorer la précision de la mesure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d055614-9a3a-4c92-a839-c071ca8b0f49",
                                "sense_id": "eb04826a-89e6-3e5e-8340-dc1529ed6ee8",
                                "text": "Un vernier, disposé à l’extrémité de la règle de cuivre, indiquait exactement l’allongement relatif de ladite règle, ce qui permettait de déduire l’allongement absolu du platine."
                            },
                            {
                                "example_id": "f839d377-91fc-4388-a5bc-e3ee51b3ea64",
                                "sense_id": "eb04826a-89e6-3e5e-8340-dc1529ed6ee8",
                                "text": "À la fin du XVIIIᵉ siècle, l’établissement du système métrique est l’occasion de recherches plus minutieuses. On se sert de verniers et de loupes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37b160ed-ed9b-4472-a44f-04429b00a36b",
                        "source_entry_id": "0502a3a6-f240-3545-8d81-b9af5da21c4e",
                        "source_sense_id": "eb04826a-89e6-3e5e-8340-dc1529ed6ee8",
                        "target_lang_word": "Nonius",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nonius",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f69a640b-07c4-39c7-9821-d7f267c6043a",
                                        "entry_id": "0dffb43b-37ec-3876-b715-eeffdae95239",
                                        "glosses": [
                                            "bewegliche Längenskala, die zur Verbesserung der Ablesegenauigkeit auf Messgeräten für Winkel und Längen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "754ac11d-7a33-4ea6-a304-1014938703f3",
                                                "sense_id": "f69a640b-07c4-39c7-9821-d7f267c6043a",
                                                "text": "„Selbst spontifex maximus müsste da Lust auf Genauigkeit bekommen. Und wem der Nonius der Schieblehre bisher nichts sagte, der lernt ihn hier kennen. All das heißt aber nicht, dass hier nur schwierige Arbeiten anstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79543460-cfb8-4d05-8163-cce2abbed409",
                        "source_entry_id": "0502a3a6-f240-3545-8d81-b9af5da21c4e",
