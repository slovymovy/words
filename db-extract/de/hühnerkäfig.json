                "senses": [
                    {
                        "sense_id": "c9f2adf2-d881-3d34-afa8-28d69ce6be18",
                        "entry_id": "21f16822-de54-38cf-8990-74a8e682b82c",
                        "glosses": [
                            "Käfig zum Transport/Aufbewahrung von Hühnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e2fcc7b-baf6-4431-a6e8-343c032d6c80",
                                "sense_id": "c9f2adf2-d881-3d34-afa8-28d69ce6be18",
                                "text": "„Bevor er losfahren konnte, kamen zwei Feuerwehrwagen mit heulenden Sirenen die Straße herunter gerast, gefolgt von einem uralten, himmelblauen Chevy-Kombi, aus dem fünf oder sechs braune Gesichter nach draußen starrten. Auf dem Dach war ein Hühnerkäfig festgebunden.“"
                            },
                            {
                                "example_id": "b00f209b-c330-4d7a-b85a-784e112ab233",
                                "sense_id": "c9f2adf2-d881-3d34-afa8-28d69ce6be18",
                                "text": "„Um die Engerlinge zu vertilgen, tüftelte er sich einen fahrbaren Hühnerkäfig aus, den zwei Männer hinter dem Pfluge herschoben - wobei es nicht ausblieb, daß die Tiere die Pfoten brachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
