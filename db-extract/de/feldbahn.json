                "senses": [
                    {
                        "sense_id": "6cf3fa0b-fe0a-354a-8398-210dc2951510",
                        "entry_id": "7b9a6416-0905-3c8c-8077-7818e86100c2",
                        "glosses": [
                            "mit relativ wenig Aufwand errichtete Schmalspurbahn, die in der Regel für betriebliche Zwecke eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d50d9c5-6316-4fe2-9a49-9ee4b8d7f2e2",
                                "sense_id": "6cf3fa0b-fe0a-354a-8398-210dc2951510",
                                "text": "„Über die einfach aufs Feld gelegten und mit Klammern an den Schienen befestigten Schwellen einer Feldbahn balancierten wir, um die Tümpel und den Kot der Straße zu vermeiden, zwei Stunden und eine halbe nach Batajnica.“"
                            },
                            {
                                "example_id": "9f4f3051-1e72-4284-9f7c-1769cb3ad0f9",
                                "sense_id": "6cf3fa0b-fe0a-354a-8398-210dc2951510",
                                "text": "„Der Unterbau der Feldbahnen richtet sich nach Art des Betriebes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
