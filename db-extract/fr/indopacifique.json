                        "examples": [
                            {
                                "example_id": "d7757bf4-6e61-421a-80b7-5eee8a7d08b0",
                                "sense_id": "2ad1a187-a6fd-3a37-a0b8-121a8d2f23da",
                                "text": "Celle que les Anglo-Saxons appellent « aloha shirt » est née dans les années 1920, à Hawaï. Des Japonais auraient commencé à y fabriquer des chemises à partir de fines cotonnades imprimées de motifs indopacifiques chamarrés."
                            },
                            {
                                "example_id": "2c8e37f2-1806-445d-851f-83e637f95f5d",
                                "sense_id": "2ad1a187-a6fd-3a37-a0b8-121a8d2f23da",
                                "text": "Dans un communiqué, l'US Navy a affirmé que ce passage «démontrait l'engagement des États-Unis en faveur d'une région indopacifique libre et ouverte»."
                            }
                        ]
                    }
