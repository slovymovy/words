                "senses": [
                    {
                        "sense_id": "a6f62c75-8ac4-357f-98dc-db02154dee04",
                        "entry_id": "fac495fe-afed-33f4-b9e7-9a9d57973e05",
                        "glosses": [
                            "« Hors service » , en parlant d'une machine, dans un état tel qu'elle ne peut plus fonctionner correctement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f5112c-18b2-46b0-8d7e-0166156b0985",
                                "sense_id": "a6f62c75-8ac4-357f-98dc-db02154dee04",
                                "text": "Quand je sortis mon portable, il était HS. Je ne pouvais appeler ni taxi ni mes amis."
                            },
                            {
                                "example_id": "896d680e-8924-4b8b-a390-39ff32aa82f2",
                                "sense_id": "a6f62c75-8ac4-357f-98dc-db02154dee04",
                                "text": "Sa voiture était étonnement propre. Le tableau de bord était vide ; la radio était HS et le bouton du radiateur avait disparu."
                            }
                        ]
                    },
                    {
                        "sense_id": "20d2fe53-40d4-3e64-9a7e-dcb89d14da67",
                        "entry_id": "fac495fe-afed-33f4-b9e7-9a9d57973e05",
                        "glosses": [
                            "Épuisé, fatigué, à bout ou exténué, en parlant d'une personne."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1ce51297-1fa1-4dd5-a98e-a8b986fa16f0",
                                "sense_id": "20d2fe53-40d4-3e64-9a7e-dcb89d14da67",
                                "text": "Xandra était HS au moment où ils sont tous partis, endormie si profondément que Boris a sorti un miroir de son sac à main ([…]) et l'a tenu sous son nez pour vérifier qu'elle respirait bien."
                            },
                            {
                                "example_id": "7b518804-5d39-4ea5-90e5-18ba405cf2c4",
                                "sense_id": "20d2fe53-40d4-3e64-9a7e-dcb89d14da67",
                                "text": "Certes les finances étaient à sec, mais les idées, les projets, bon sang, ça, il devait encore en être capable ! Même s'il était dans le trou, même s'il était HS et qu'il paraissait démoli, il m'assurait que rien n'était fini."
                            }
                        ]
                    }
