                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ca3cab0-3be8-3889-bdbf-36f1401867b7",
                                        "entry_id": "e993a591-f604-3689-a6f4-a7e05f543142",
                                        "glosses": [
                                            "Erdvertiefung, in der sich Wasser gesammelt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7d9d74b-6a35-429b-b410-a7881f72e02a",
                                                "sense_id": "9ca3cab0-3be8-3889-bdbf-36f1401867b7",
                                                "text": "„Systematisch besetzten deutsche Einheiten die raren Wasserlöcher.“"
                                            },
                                            {
                                                "example_id": "a8145366-4380-4ef6-a84f-ce36ca160b38",
                                                "sense_id": "9ca3cab0-3be8-3889-bdbf-36f1401867b7",
                                                "text": "„Das von Wildtieren wimmelnde und noch unberührte Okavango-Delta könnte man daher als eines der größten Wasserlöcher des Kontinents bezeichnen.“"
                                            },
                                            {
                                                "example_id": "912a8940-e794-45a5-a0c8-26438201af46",
                                                "sense_id": "9ca3cab0-3be8-3889-bdbf-36f1401867b7",
                                                "text": "„In solchen Wasserlöchern ersäuft man nach altem Brauch Hunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
