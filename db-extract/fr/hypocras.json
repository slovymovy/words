        "fr-extract.jsonl": [
            {
                "entry_id": "929b5274-77af-300a-84d7-28821432a16f",
                "word": "hypocras",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e51e007b-ac2a-3f2d-9bc6-b9967c8718c5",
                        "entry_id": "929b5274-77af-300a-84d7-28821432a16f",
                        "glosses": [
                            "Vin digestif additionné de miel et d’épices « royales » (et de piments en pays d’Oc ou en Catalogne)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d68e8c-8a1d-4cb8-939e-0663405d9b47",
                                "sense_id": "e51e007b-ac2a-3f2d-9bc6-b9967c8718c5",
                                "text": "Ils ont fait hier un souper superbe chez Monsieur le prévôt des marchands, à l’Hôtel de Ville, où on leur a servi des dragées, de l’hypocras, des épices, et autres singularités."
                            },
                            {
                                "example_id": "2e76cb11-cffd-4d5f-9eb4-d54c0801e52f",
                                "sense_id": "e51e007b-ac2a-3f2d-9bc6-b9967c8718c5",
                                "text": "Enfin, l’apothicaire chargea sur la voiture des sirops, hypocras, hydromel, confitures, qu’il prétendait offrir, étant de ses produits, aux frais de Clamecy."
                            },
                            {
                                "example_id": "72cec52d-2a5c-43fe-8aa6-36b30837ad8a",
                                "sense_id": "e51e007b-ac2a-3f2d-9bc6-b9967c8718c5",
                                "text": "J’avais été bien inspirée, car à la carte des caves Saint-Sabin, gothisme oblige, ne figuraient que bière et hypocras."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "539bee23-2af9-4507-bd3c-6e045f07bae1",
                        "source_entry_id": "929b5274-77af-300a-84d7-28821432a16f",
                        "source_sense_id": "e51e007b-ac2a-3f2d-9bc6-b9967c8718c5",
                        "target_lang_word": "hippocras",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hippocras",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3207f67-9b4f-3ad0-8f7d-95c63743c100",
                                        "entry_id": "0403c4fd-db2c-31ce-ace7-2ffc58eefec6",
                                        "glosses": [
                                            "A cordial, made from a spiced wine mixed with sugar and spices, usually including cinnamon, which are strained out by a cloth before the drink is consumed."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bacc42b3-4fe7-492b-a67e-541dcc94db0a",
                                                "sense_id": "f3207f67-9b4f-3ad0-8f7d-95c63743c100",
                                                "text": "It is long since that disorderly potentate [the Lord of Misrule] went the way of the Dodo, and hippocras has become almost as mythical as ambrosia; but, once upon a time, they played a prominent part in legal education."
                                            },
                                            {
                                                "example_id": "08d2bdfe-e0c4-4e72-ae52-8ae5594ae8f7",
                                                "sense_id": "f3207f67-9b4f-3ad0-8f7d-95c63743c100",
                                                "text": "Spiced wine, sweetened with sugar or honey, perhaps the original of the modern liqueur, was employed occasionally under the name of hippocras."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
