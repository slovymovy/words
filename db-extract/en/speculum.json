                                "target_senses": [
                                    {
                                        "sense_id": "29b2c073-e1e9-361a-b02d-c53718534a8b",
                                        "entry_id": "1cc5eed6-ad1b-35f0-99ea-1fa8a01a721a",
                                        "glosses": [
                                            "de snavel van een eend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f396c21-381d-45aa-aaa9-501c6bc23263",
                                                "sense_id": "29b2c073-e1e9-361a-b02d-c53718534a8b",
                                                "text": "Ook zag ik toen pas echt hoe zeer konijnen en hazen van elkaar verschillen, nog veel meer dan je op het oog zou zeggen. En bij de buizerd, voelen hoe scherp zijn klauwen zijn, terwijl die snavel weer helemaal niet zo scherp is. En kijk dat zeefje in een eendenbek. Het is eigenlijk onbeschrijflijk als je deze wilde dieren van zo dichtbij ziet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95888019-4407-3c09-b7d4-949ee4c6a8a3",
                                        "entry_id": "1cc5eed6-ad1b-35f0-99ea-1fa8a01a721a",
                                        "glosses": [
                                            "gynaecologisch instrument voor vaginaal onderzoek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5d5b4c-a562-4771-8aaf-6cf577c8f8f1",
                                                "sense_id": "95888019-4407-3c09-b7d4-949ee4c6a8a3",
                                                "text": "En dan lig je daar bij de huisarts op de tafel, eendenbek in de aanslag. Het is uitstrijkjestijd. Gadver. De meeste vrouwen bevallen nog liever dan dat ze zich onderwerpen aan het inwendige onderzoek naar baarmoederhalskanker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6fea17e-90b0-408d-b161-ad233cdfefab",
                        "source_entry_id": "f0d3c6c9-922b-3c32-a986-c4db61017b39",
