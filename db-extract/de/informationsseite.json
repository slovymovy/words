                        "glosses": [
                            "Internetseite oder Seite in einem Druckerzeugnis, die ein Informationsangebot beziehungsweise eine Informationsquelle darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "529a0221-1d92-4c3f-9614-a71bfb84e2dd",
                                "sense_id": "68343c02-993d-3c7c-9503-7fffcf4fe228",
                                "text": "„Unbekannte Kriminelle haben die Verwaltung des Wasserwerks im hessischen Fritzlar-Homberg am 9. Februar lahmgelegt. Wie das Unternehmen auf einer Informationsseite mitteilt, sei die Wasserversorgung in den angeschlossenen Gemeinden zu keiner Zeit in Gefahr gewesen, da die Betriebstechnik unabhängig vom Verwaltungsnetzwerk sei.“"
                            }
                        ],
