                "senses": [
                    {
                        "sense_id": "3096fc06-f00c-3bbf-9839-e0716959c8db",
                        "entry_id": "7423ea90-f0b4-315b-9dd8-ba066fdb21af",
                        "glosses": [
                            "gesamte Kleidung einer Person, zumindest die Oberbekleidung"
                        ],
                        "tags": [
                            "Alemannic",
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "61a57951-6d76-41a7-9589-1755fff915ac",
                                "sense_id": "3096fc06-f00c-3bbf-9839-e0716959c8db",
                                "text": "„So durfte ein Schneider anno 1419 laut den Überlinger Stadtrechten für ein schlechtes (schlichtes) Häs 14 Pfennige verlangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1f426034-ac5f-3bb2-8fa0-9fa37d5d05fb",
                        "entry_id": "7423ea90-f0b4-315b-9dd8-ba066fdb21af",
                        "glosses": [
                            "traditionelle Verkleidung der Narren und Maskenträger in der schwäbisch-alemannischen Fastnacht"
                        ],
                        "tags": [
                            "Alemannic",
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "fe68d049-e096-418e-b742-64afc32162fc",
                                "sense_id": "1f426034-ac5f-3bb2-8fa0-9fa37d5d05fb",
                                "text": "Das Häs darf nur während der Fasnetszeit getragen werden."
                            },
                            {
                                "example_id": "43c7ea18-49ad-405a-8afc-62c0eaf87ca8",
                                "sense_id": "1f426034-ac5f-3bb2-8fa0-9fa37d5d05fb",
                                "text": "Nach der Fasnet muss das Häs gereinigt und im Bedarfsfall repariert werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
