                                    },
                                    {
                                        "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "A person who tells authorities about improper or illegal activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b071e531-d399-4de0-af29-be4d470bb1cb",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "Being an informer often meant living in fear."
                                            },
                                            {
                                                "example_id": "67ec682d-553b-418f-b414-451e5adb63dc",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "The police relied on an informer to catch the gang."
                                            },
                                            {
                                                "example_id": "ae006e29-ea6f-4b46-a3e6-cf9d40bff675",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "He acted as an informer during the rebellion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471ae915-8014-367b-977b-394d8f856bae",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "One who informs, animates, or inspires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586e092e-9a14-4fc2-aa2e-63f932ce1dd3",
                                                "sense_id": "471ae915-8014-367b-977b-394d8f856bae",
                                                "text": "1729, Alexander Pope, Prologue to Sophonisba (by James Thomson\nNature, informer of the poet's art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d05d47e9-0903-43a2-ab06-c6ada9004d86",
                        "source_entry_id": "7538b19d-3bc8-33d4-bd99-44eab52c1c53",
                        "source_sense_description": "fourbe, menteur, délateur",
                        "target_lang_word": "sicofante",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sicofante",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "95c238b3-4092-3c0f-a6da-6638476ba6d5",
                                        "entry_id": "f1d0e318-7037-32b1-b886-4c174c9afa3b",
                                        "glosses": [
                                            "Variante de sicofanta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9f0062-3ec0-44ab-8596-21e792e4ce8b",
                                                "sense_id": "95c238b3-4092-3c0f-a6da-6638476ba6d5",
                                                "text": "Debe ser en sí mismo difícil hacer una defensa coherente de la obra poundiana. En 1950 todavía, según el artículo ardoroso de un sicofante suyo que lo llama 'The sage of Rapallo' no se le había dedicado libro alguno con excepción del folleto de T.S. Eliot, 'Ezra Pound — His Metric and his Poetry', fechado en 1917."
                                            },
                                            {
                                                "example_id": "ae3e17df-2bfb-493a-bb14-2cc4297db06d",
                                                "sense_id": "95c238b3-4092-3c0f-a6da-6638476ba6d5",
                                                "text": "—Tuve que huir —continuaba Bleontes—, porque mi padre era sicofante. Ganaba la vida denunciando al tirano los sueños de los aristócratas. El tirano tenía sofistas que averiguaban lo que escondían los sueños."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a221bce-10de-41ad-a2fa-a5c7846ec0e4",
                        "source_entry_id": "7538b19d-3bc8-33d4-bd99-44eab52c1c53",
                        "source_sense_description": "fourbe, menteur, délateur",
                        "target_lang_word": "sicofanta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sicofanta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "023c5762-beb9-306d-a64e-9edc7d1fa6a0",
                                        "entry_id": "53f7eae7-d1ae-3bdf-9c48-29f5199e4801",
                                        "glosses": [
                                            "Persona que intenta ganar el favor de otra comportándose de forma zalamera y servil."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cff7aef-f21f-4f8a-9a00-a1abf13ae46c",
                                                "sense_id": "023c5762-beb9-306d-a64e-9edc7d1fa6a0",
                                                "text": "Por dicha el antiguo régimen\nMurió en este suelo ya;\nBien que algunos sicofantas\nLo quieren resucitar."
                                            },
                                            {
                                                "example_id": "58f58d43-0eba-4bb5-92d1-9be0aab54f64",
                                                "sense_id": "023c5762-beb9-306d-a64e-9edc7d1fa6a0",
                                                "text": "Se queja de las calumnias de sus émulos y sicofantas, y le encarga memorias para Horacio Pallavicini, Felipe Sidney y milord Attey."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ac82170-6aca-32f6-b6fc-57291d36f243",
                                        "entry_id": "53f7eae7-d1ae-3bdf-9c48-29f5199e4801",
                                        "glosses": [
                                            "Delator o informante de la policía u otra autoridad."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e4c20d-2e5a-47ca-902f-f82d96052205",
                                                "sense_id": "5ac82170-6aca-32f6-b6fc-57291d36f243",
                                                "text": "Sufrido tan mal rato por el enardecimiento del fiscal, efecto todo de las imposturas de los tres sicofantas referidos, se siguio otra audiencia en la que se presentó el abogado defensor."
                                            },
                                            {
                                                "example_id": "37bb3533-429a-460e-94c8-a2608741b5fc",
                                                "sense_id": "5ac82170-6aca-32f6-b6fc-57291d36f243",
                                                "text": "¡Yo recuso tu presencia en este tribunal por lo que acabo de decir y porque tú no puedes ser ni testigo ni juez en esta causa, pues eres —una vez más— el denunciante y acusador, oh sicofanta, oh mago, oh cacodemonio!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
