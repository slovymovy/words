                "senses": [
                    {
                        "sense_id": "e479a190-dd04-3f1c-8652-b5b3beda54d3",
                        "entry_id": "6323ef2f-3724-3d1d-914c-3672098e4ac5",
                        "glosses": [
                            "Relatif aux pays du Nord, spécialement du nord de l’Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80afc7b-4dcd-44ba-9ba4-c6da118127d4",
                                "sense_id": "e479a190-dd04-3f1c-8652-b5b3beda54d3",
                                "text": "J'ai été contaminé par le virus Friedrich, mais maintenant c'est en compagnie d'une vaste troupe de philosophes schleus et nordiques que j'achève de me désocialiser."
                            },
                            {
                                "example_id": "0fa9cd05-9b72-4310-9931-8eb3d4e747a0",
                                "sense_id": "e479a190-dd04-3f1c-8652-b5b3beda54d3",
                                "text": "La poésie nordique, les légendes nordiques, la poésie, les légendes scandinaves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf239528-1140-4336-889e-7118b28e829c",
                        "source_entry_id": "6323ef2f-3724-3d1d-914c-3672098e4ac5",
                        "source_sense_id": "e479a190-dd04-3f1c-8652-b5b3beda54d3",
                        "target_lang_word": "nordisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nordisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67404bc8-1021-33a9-b695-87563dde7fef",
                                        "entry_id": "d3b1fcf5-e631-3a45-a30c-93f3991bccae",
                                        "glosses": [
                                            "den Norden Europas betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927e1db5-80a6-46cd-9cdb-470f0f76041f",
                                                "sense_id": "67404bc8-1021-33a9-b695-87563dde7fef",
                                                "text": "„Der Vorstoß, den der nordische Pelzhandel planmäßig nach Süden unternahm, hatte seinen natürlichen Ausgangspunkt in der nordisch-schwedischen Kolonie im Gebiete der Stadt Ladoga, der Aldeigjuborg der späteren nordischen Sagas, einer Station, von der man leicht zu den nördlichen Nebenflüssen der Volga vordringen konnte, von der aber auch ein ebenso bequemer Flußweg zum Dnjepr führte.“"
                                            },
                                            {
                                                "example_id": "a94a38a1-1df7-4205-8620-61f4e5f190f5",
                                                "sense_id": "67404bc8-1021-33a9-b695-87563dde7fef",
                                                "text": "„Indische, griechische und nordische Mythologie zeigen klare Ansätze zu einer philosophischen oder »spekulativen« Betrachtungsweise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
