                        "source_sense_id": "4211952d-5aa4-3f11-8992-643c432941a4",
                        "target_lang_word": "cholent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cholent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad2f8d38-15d3-342d-bae3-4b8a0f121bca",
                                        "entry_id": "2a5d2767-5866-3de2-86f1-00371d7cd1a4",
                                        "glosses": [
                                            "A meat stew traditionally served on the Sabbath by Jews."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9fa585-ceff-4487-932f-d0f327ac963d",
                                                "sense_id": "ad2f8d38-15d3-342d-bae3-4b8a0f121bca",
                                                "text": "As Mr. Schonfeld climbed the stairs, he was carrying a steaming 18-quart pot containing the traditional Sabbath stew known as chulent."
                                            },
                                            {
                                                "example_id": "12e06281-dc3f-4784-a5fb-372cc8759981",
                                                "sense_id": "ad2f8d38-15d3-342d-bae3-4b8a0f121bca",
                                                "text": "Food was prepared with a far defter hand; I had matzo ball soup and boiled beef with horseradish, which sounds terrible but was excellent; Eliza ordered cholent, a thick bean stew, topped with a slice of meat loaf — our Jewish-mom-like server basically forced her."
                                            }
                                        ]
                                    }
                                ]
                            }
