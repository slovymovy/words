                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e4f9bc6-9e84-3f9f-a80e-a48f89d7b10f",
                        "entry_id": "e9a9dda4-40f8-3244-b37a-87c624bb2ad4",
                        "glosses": [
                            "ohne Scheu, ohne Zögern"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5dbfbe4e-6541-4152-a0ae-de02760f42b4",
                                "sense_id": "3e4f9bc6-9e84-3f9f-a80e-a48f89d7b10f",
                                "text": "„Heute ist er Finanzminister – und im Grunde heilfroh darüber, dass sein Lager unterlag. Er sagt das natürlich nicht geradeheraus. Er diplomatisiert vielmehr, »dass man im Rückblick sagen muss, es wäre schwierig geworden mit dem Euro«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f5c9b0e-2cae-473c-8814-8bf7ffcbce33",
                        "source_entry_id": "e9a9dda4-40f8-3244-b37a-87c624bb2ad4",
