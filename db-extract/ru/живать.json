                "senses": [
                    {
                        "sense_id": "373f071e-ee9c-3fc5-9d50-747422006b26",
                        "entry_id": "4e8a107f-e23c-3aba-a7dd-ef8aba484cd7",
                        "glosses": [
                            "разг. многокр. к жить"
                        ],
                        "tags": [
                            "iterative"
                        ],
                        "examples": [
                            {
                                "example_id": "ebedc0ca-5538-4450-8142-b4d333252851",
                                "sense_id": "373f071e-ee9c-3fc5-9d50-747422006b26",
                                "text": "― Не волнуйся, ― проговорил Базаров, ― народ мы тёртый, в городах живали."
                            },
                            {
                                "example_id": "9627d965-685e-4141-a251-7270f7f628b6",
                                "sense_id": "373f071e-ee9c-3fc5-9d50-747422006b26",
                                "text": "Ах, не видал ты этих людей, не живал с ними?.."
                            },
                            {
                                "example_id": "74926a03-9d50-43c7-85c2-827ae6e9a517",
                                "sense_id": "373f071e-ee9c-3fc5-9d50-747422006b26",
                                "text": "― Вот мне все больше доводилось на речках живать, и воинская часть наша тоже на реке стояла."
                            }
                        ]
                    }
