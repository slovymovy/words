                ],
                "translations": [
                    {
                        "translation_id": "97f6efb3-a19d-4b83-897c-362376f0a07b",
                        "source_entry_id": "b14f6766-8f39-37f7-b06f-14c52cdfcecc",
                        "source_sense_id": "f464fefa-1cf9-38eb-953a-b5d59a60750a",
                        "source_sense_description": "akkoord gaand, instemmend: bereid tot actie",
                        "target_lang_word": "bereit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bereit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e6dae3a-e52b-388f-9ab5-181b4c7a2e91",
                                        "entry_id": "f3977ae9-ba80-393d-9e2c-53432e65c7ba",
                                        "glosses": [
                                            "auf etwas vorbereitet, mit der Vorbereitung fertig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0ca010-182f-46d1-a0b3-8397ff547c80",
                                                "sense_id": "8e6dae3a-e52b-388f-9ab5-181b4c7a2e91",
                                                "text": "„Alle wollen Medaillen, niemand ist bereit, dafür zu bezahlen und in eine gescheite Nachwuchsförderung zu investieren.“"
                                            },
                                            {
                                                "example_id": "d6169249-fa4e-48ee-815a-b36f78ed29d9",
                                                "sense_id": "8e6dae3a-e52b-388f-9ab5-181b4c7a2e91",
                                                "text": "„Nationen bestehen aus einzelnen Menschen, und nicht jeder ist bereit, der Prahlerei und Rüpelei seiner Regierung Beifall zu spenden.“"
                                            },
                                            {
                                                "example_id": "e0e59342-5ee5-428c-8f5d-ff65ba2092a3",
                                                "sense_id": "8e6dae3a-e52b-388f-9ab5-181b4c7a2e91",
                                                "text": "„Der Rechtssinn ist ohne Zweifel stärker in den Männern als in den Frauen und jene sind bereiter als diese, ihr Recht gegen Jedermann mit Gründen und im Nothfall mit den Waffen zu verfechten.“ (1872)"
                                            },
                                            {
                                                "example_id": "06af8e54-d0cb-4e87-b938-50ebb96325dd",
                                                "sense_id": "8e6dae3a-e52b-388f-9ab5-181b4c7a2e91",
                                                "text": "„Heute sind Ärzte wohl in allen Fachgebieten viel bereiter als früher, sich selbst als mögliche Patienten zu phantasieren und sich Fragen zu stellen: wie sie gerne hätten, daß ihr Arzt zu ihnen spricht, […].“ (2000)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bereit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d5683b-77ab-3dcd-85b1-531b4befaea2",
                                        "entry_id": "507dbd92-90b5-305c-a7dd-4a36b57ae0ff",
                                        "glosses": [
                                            "2. Person Singular Imperativ Präsens Aktiv des Verbs bereiten"
                                        ],
                                        "tags": [
                                            "active",
                                            "form-of",
                                            "imperative",
                                            "present",
                                            "singular"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03feeed2-2abc-448e-8417-dd549d8f9095",
                        "source_entry_id": "b14f6766-8f39-37f7-b06f-14c52cdfcecc",
                        "source_sense_id": "f464fefa-1cf9-38eb-953a-b5d59a60750a",
                        "source_sense_description": "akkoord gaand, instemmend: bereid tot actie",
                        "target_lang_word": "willing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "willing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                        "entry_id": "182c6136-0a62-3bc8-a083-d11be99c66f0",
                                        "glosses": [
                                            "Ready to do something, particularly something that requires change or effort; not objecting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca4ee22-d39d-4411-86b1-d934e9e200fe",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "If my boyfriend isn't willing to change his drinking habits, I will split up with him."
                                            },
                                            {
                                                "example_id": "b2ac2137-2408-477d-9530-376c7176c10c",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "In the eyes of Mr. Farquhar Fenelon Cooke the apotheosis of the Celebrity was complete. The people of Asquith were not only willing to attend the house-warming, but had been worked up to the pitch of eagerness. The Celebrity as a matter of course was master of ceremonies."
                                            },
                                            {
                                                "example_id": "87a62fb7-fed8-4b30-8e22-b10823fc1fb2",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "\"Of course, the ventilation is awful. We pump the air down, but two-hour shifts are the most the men can do - and they are willing lads too.\""
                                            },
                                            {
                                                "example_id": "012c04c8-b222-4f94-8f57-3ed2a4bea7ca",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Coal-eaters they may have been, but a more willing or harder working Atlantic engine was never designed."
                                            },
                                            {
                                                "example_id": "4498e350-caff-4c1c-a04c-c8b230c97daa",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            },
                                            {
                                                "example_id": "42929a8c-4878-488e-8fb8-398feea99fe2",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            }
                                        ]
                                    }
                                ]
                            },
