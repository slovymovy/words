                                        "sense_id": "1c424495-ede0-329f-9b6a-7e874292060a",
                                        "entry_id": "adf983dc-26c3-30f6-8ddb-dce00cbbdb03",
                                        "glosses": [
                                            "Grenze zwischen zwei gleich großen Hälften von Messwerten"
