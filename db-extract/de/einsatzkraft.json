                "senses": [
                    {
                        "sense_id": "7dd6e8ee-e727-385e-9742-7f9dda1ba6d3",
                        "entry_id": "8cd754e8-14f0-38bd-bbb8-b88b931a7cc6",
                        "glosses": [
                            "Mitglied einer offiziellen Organisation (Feuerwehr, Polizei, …), das an einem Einsatz mitwirkt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "a731f959-99a5-4131-838a-de059f27581e",
                                "sense_id": "7dd6e8ee-e727-385e-9742-7f9dda1ba6d3",
                                "text": "„Von Jagow hatte seine kompletten Einsatzkräfte an wichtige Kreuzungen beordert und Straßensperren errichten lassen, um das Demonstrationsverbot durchzusetzen.“"
                            },
                            {
                                "example_id": "552ee99a-eb92-4b2f-9ec4-d5e719105c9f",
                                "sense_id": "7dd6e8ee-e727-385e-9742-7f9dda1ba6d3",
                                "text": "„Mit zwei Schneepflügen, einem Radlader und einer Seilwinde bahnten sich die Einsatzkräfte einen Weg zu dem auf rund 1.300 Meter Seehöhe gelegenen Kloster.“"
                            }
                        ],
