    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87be4fbf-89e4-3737-880c-e32470bade93",
                    "sense_definition": "De buitenste zijde of oppervlakte van een voorwerp of gebouw.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exterieur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>buitenkant</w> van het gebouw is blauw geschilderd.",
                            "target_lang_translations": {
                                "en": "The <w>outside</w> of the building is painted blue."
                            }
                        },
                        {
                            "text": "Als je goed naar de <w>buitenkant</w> kijkt, zie je dat het hout rot is.",
                            "target_lang_translations": {
                                "en": "If you look closely at the <w>exterior</w>, you can see that the wood is rotten."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitenzijde"
                    ],
                    "antonyms": [
                        "binnenkant",
                        "binnenzijde"
                    ],
                    "common_phrases": [
                        "aan de buitenkant"
                    ],
                    "target_lang_definitions": {
                        "en": "The outer side or surface of an object or building."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outside",
                                "target_lang_sense_clarification": "the outer surface or part of something"
                            },
                            {
                                "target_lang_word": "exterior",
                                "target_lang_sense_clarification": "the outer part of a building or structure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "338f4b5e-95cd-3411-8d3e-84e1f927c645",
                    "sense_definition": "Het uiterlijk of de uiterlijke verschijningsvorm van iets of iemand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exterieur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet mensen niet alleen beoordelen op hun <w>buitenkant</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't judge people solely by their <w>outside</w>."
                            }
                        },
                        {
                            "text": "De zwart verkoolde <w>buitenkant</w> omhulde zacht, wit vlees.",
                            "target_lang_translations": {
                                "en": "The charred black <w>exterior</w> encased soft, white meat."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitenzijde",
                        "periferie"
                    ],
                    "antonyms": [
                        "binnenkant",
                        "binnenzijde"
                    ],
                    "target_lang_definitions": {
                        "en": "The external appearance or outward form of something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outside",
                                "target_lang_sense_clarification": "the external appearance of a person or thing"
                            },
                            {
                                "target_lang_word": "exterior",
                                "target_lang_sense_clarification": "outward appearance or demeanor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
