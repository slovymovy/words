{
    "word_family": [
        "contract",
        "contractor",
        "contractual"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78a6c160-6e68-3f63-abf7-993ead3f8700",
                    "sense_definition": "A shortened form of a word, often with omitted letters replaced by an apostrophe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Don't</w> is a common <w>contraction</w> of do not.",
                            "target_lang_translations": {
                                "ru": "<w>Don't</w> — это распространенное <w>сокращение</w> от do not.",
                                "zh": "“Don't”是“do not”的一种常见<w>缩略词</w>。"
                            }
                        },
                        {
                            "text": "Using a <w>contraction</w> makes your writing sound more informal.",
                            "target_lang_translations": {
                                "ru": "Использование <w>сокращений</w> делает ваш текст более неформальным.",
                                "zh": "使用<w>缩略词</w>会让你的写作听起来更随意。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "common contraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая форма слова, в которой пропущенные буквы часто заменяются апострофом.",
                        "zh": "词语的缩略形式，通常用撇号代替省略的字母。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращение",
                                "target_lang_sense_clarification": "общее понятие для усеченной формы слова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缩略词",
                                "target_lang_sense_clarification": "指语言中词语的缩写形式"
                            },
                            {
                                "target_lang_word": "缩写",
                                "target_lang_sense_clarification": "指缩短词语的过程或结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccbc6cbe-922e-3f8a-9dfd-0304715cfd49",
                    "sense_definition": "A shortening of a muscle during its use, or a painful tightening of uterine muscles during childbirth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete felt a painful muscle <w>contraction</w> after the race.",
                            "target_lang_translations": {
                                "ru": "После забега спортсмен почувствовал болезненное <w>сокращение</w> мышц.",
                                "zh": "比赛结束后，运动员感到肌肉一阵痛苦的<w>收缩</w>。"
                            }
                        },
                        {
                            "text": "She began to feel regular <w>contractions</w> as labor started.",
                            "target_lang_translations": {
                                "ru": "С началом родов она стала чувствовать регулярные <w>схватки</w>.",
                                "zh": "随着分娩开始，她开始感到规律的<w>阵痛</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "dilation"
                    ],
                    "common_phrases": [
                        "muscle contraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укорочение мышцы во время её работы или болезненное напряжение маточных мышц во время родов.",
                        "zh": "肌肉在活动时的收缩，或分娩时子宫肌肉的阵发性紧缩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращение",
                                "target_lang_sense_clarification": "физиологическое напряжение мышц"
                            },
                            {
                                "target_lang_word": "схватка",
                                "target_lang_sense_clarification": "периодическое сокращение матки при родах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收缩",
                                "target_lang_sense_clarification": "指肌肉或器官的生理性紧缩"
                            },
                            {
                                "target_lang_word": "阵痛",
                                "target_lang_sense_clarification": "指分娩时子宫的规律性收缩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "732974c2-1fd7-3733-b159-f0f8d2f0b9b6",
                    "sense_definition": "A period of economic decline or negative growth.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country faced a severe economic <w>contraction</w> last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году страна столкнулась с серьезным экономическим <w>спадом</w>.",
                                "zh": "该国去年面临了严重的经济<w>萎缩</w>。"
                            }
                        },
                        {
                            "text": "Businesses often struggle during an economic <w>contraction</w>.",
                            "target_lang_translations": {
                                "ru": "Бизнес часто испытывает трудности во время экономического <w>сокращения</w>.",
                                "zh": "在经济<w>萎缩</w>期间，企业往往举步维艰。"
                            }
                        }
                    ],
                    "antonyms": [
                        "expansion"
                    ],
                    "common_phrases": [
                        "economic contraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период экономического спада или отрицательного роста.",
                        "zh": "经济衰退或负增长的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "экономический термин для снижения активности"
                            },
                            {
                                "target_lang_word": "сокращение",
                                "target_lang_sense_clarification": "уменьшение объема экономики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "萎缩",
                                "target_lang_sense_clarification": "指经济规模或活动的减小"
                            },
                            {
                                "target_lang_word": "衰退",
                                "target_lang_sense_clarification": "指经济活动的下滑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d6fefb9-2963-3c10-a544-797a67968049",
                    "sense_definition": "The process of becoming infected with a disease.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acquiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proper hygiene helps prevent the <w>contraction</w> of illnesses.",
                            "target_lang_translations": {
                                "ru": "Правильная гигиена помогает предотвратить <w>заражение</w> болезнями.",
                                "zh": "良好的卫生习惯有助于预防疾病<w>感染</w>。"
                            }
                        },
                        {
                            "text": "The <w>contraction</w> of malaria is a serious risk in tropical areas.",
                            "target_lang_translations": {
                                "ru": "<w>Заражение</w> малярией представляет серьезный риск в тропических районах.",
                                "zh": "在热带地区，<w>感染</w>疟疾是一个严重的风险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "catching"
                    ],
                    "common_phrases": [
                        "contraction of disease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс заражения болезнью.",
                        "zh": "感染疾病的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заражение",
                                "target_lang_sense_clarification": "процесс приобретения инфекции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感染",
                                "target_lang_sense_clarification": "指患上某种疾病或受到病原体侵袭"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}