                "senses": [
                    {
                        "sense_id": "6570607a-054c-32d4-a770-4db723a6e6ba",
                        "entry_id": "98574304-41fe-3f32-b1ba-7b9cfce3d84b",
                        "glosses": [
                            "Ofen, der mit Kohlen als Brennmaterial betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9eea21b-21e4-4c1f-b9c9-3a1f61647ec1",
                                "sense_id": "6570607a-054c-32d4-a770-4db723a6e6ba",
                                "text": "„Auch zu Hause in unserem Duisburger Zechenhaus stand ein Kohleofen.“"
                            },
                            {
                                "example_id": "d1e2e96d-941d-4af8-a0c1-dff6299732ff",
                                "sense_id": "6570607a-054c-32d4-a770-4db723a6e6ba",
                                "text": "„Als ich ein Baby war, wohnten meine Eltern mit mir in einer winters nur durch einen kleinen Kohleofen beheizbaren Dachkammer im Esslinger Haus meiner Großeltern.“"
                            },
                            {
                                "example_id": "79c5855c-ee73-40d4-96fb-572901d29b07",
                                "sense_id": "6570607a-054c-32d4-a770-4db723a6e6ba",
                                "text": "„Der gleiche Duft wie damals strömt jetzt durch das Hotel als Yalem grüne Kaffeebohnen auf einer gusseisernen Platte über einem kleinen Kohleofen röstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
