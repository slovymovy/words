                ],
                "senses": [
                    {
                        "sense_id": "2c47904b-fa88-32ea-b8ed-12bcef898d39",
                        "entry_id": "08ef5a6a-8fb6-3c40-aaac-f5caa2f9ab99",
                        "glosses": [
                            "aus Orange und Pampelmuse gekreuzte, größere Zitrusfrucht mit gelbem oder orangerotem Fruchtfleisch und säuerlich-bitterlichem Geschmack (Citrus paradisi)"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "6d3f5ef5-5ea8-4388-90f3-afcc8eb46fad",
                                "sense_id": "2c47904b-fa88-32ea-b8ed-12bcef898d39",
                                "text": "„Auf dem Nachttisch lagen fünf Grapefrüchte, ungemein plastisch bis in die Poren, daneben eine Streichholzschachtel, deren Aufschrift ich sah, doch nicht entzifferte.“"
                            },
                            {
                                "example_id": "f54b51c5-ecd7-4554-b42a-4693e90e0a4b",
                                "sense_id": "2c47904b-fa88-32ea-b8ed-12bcef898d39",
                                "text": "„Ullrich Müller von der Weinstube am Brunnen empfiehlt da einen trockenen 2008er Weißburgunder vom Weingut Klaus Böhme aus Kirchscheidungen. ‚Der ist unverschämt frisch, vor Aromen von Zitrus- und Grapefrucht nur so strotzend, dennoch sich beim Essen ein- und unterordnend.[…]‘“"
                            },
                            {
                                "example_id": "8471d804-f510-4366-97ef-36bee1516819",
                                "sense_id": "2c47904b-fa88-32ea-b8ed-12bcef898d39",
                                "text": "„Das Getränk gibt es in fünf Geschmacksrichtungen (in der 0,5l Glasmehrwegflasche): Zitrone, Orange, Cola, Grapefrucht und Cola Orange.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
