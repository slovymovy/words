                                            {
                                                "example_id": "38e9236d-150a-4cf2-b9df-0e77a5f591d8",
                                                "sense_id": "96eb4ca0-d7c2-3b3a-b262-cefc6fc9dd0b",
                                                "text": "Bruhat rattled off a head-spinning 29 correctly spelled words in 90 seconds, including heautophany, nachschläge and puszta."
