                    {
                        "sense_id": "5723cbc8-2999-30c5-9fbc-162c08b01b5f",
                        "entry_id": "6aae00e7-6baa-30a7-be72-303c0595a947",
                        "glosses": [
                            "Bound as though by an oath."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a90e905b-d3c1-494d-94c5-fe474647ed81",
                                "sense_id": "5723cbc8-2999-30c5-9fbc-162c08b01b5f",
                                "text": "I'm sworn to secrecy."
                            },
                            {
                                "example_id": "9d80b2fd-1ddd-412a-ae24-325baf43c4f7",
                                "sense_id": "5723cbc8-2999-30c5-9fbc-162c08b01b5f",
                                "text": "Swum ashore, man, like a duck. I can swim like a duck, I'll be sworn."
                            }
                        ]
                    },
