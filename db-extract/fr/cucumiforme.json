                                    {
                                        "sense_id": "7d5da98b-4649-3f47-b17f-f06e89e8e216",
                                        "entry_id": "61a64054-d128-3b5e-b20d-35cdd1960c15",
                                        "glosses": [
                                            "Shaped like a cucumber; having the form of a cylinder tapered and rounded at the ends, and possibly curved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32685022-cfbb-476d-8a16-33d4fc66a38a",
                                                "sense_id": "7d5da98b-4649-3f47-b17f-f06e89e8e216",
                                                "text": "Cucumiform (Cucumiformis). Cucumber-shaped. Whose longitudinal section is oblong, and transverse circular."
                                            },
                                            {
                                                "example_id": "c14678b6-b58d-41ee-b842-8393167064f9",
                                                "sense_id": "7d5da98b-4649-3f47-b17f-f06e89e8e216",
                                                "text": "She was there, tumbling the marvelous cucumiform weights down upon a chest which looked as though it would cave in under such manna."
                                            },
                                            {
                                                "example_id": "2690cfd2-233f-4001-8189-9c5a18b2f57f",
                                                "sense_id": "7d5da98b-4649-3f47-b17f-f06e89e8e216",
                                                "text": "Uncharacteristically for him, Lord Vetinari laughed out loud. He very nearly gloated at the downfall of his enemy and slammed his copy of the Ankh-Morpork Times, open at the crossword page, on to his desk. ‘Cucumiform, shaped like a cucumber or a variety of squash! l thumb my nose at you, madam!’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
