                                "target_senses": [
                                    {
                                        "sense_id": "a0b4ea76-ecf3-3834-9ebe-fd986cc3c21d",
                                        "entry_id": "6d91fe73-2764-34a3-b12c-bfa17a676bbc",
                                        "glosses": [
                                            "ve skutečnosti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5310a1-407f-486e-b425-8b3aef607006",
                                                "sense_id": "a0b4ea76-ecf3-3834-9ebe-fd986cc3c21d",
                                                "text": "Sliboval, že mi tu knihu přinese, a nakonec to opravdu udělal."
                                            }
                                        ]
