                "translations": [
                    {
                        "translation_id": "aef3aab9-d084-4a10-a07a-f95ec0c681e4",
                        "source_entry_id": "1b78dd6c-2304-3d47-86e8-71c2355c941c",
                        "source_sense_id": "aa76f655-cbce-38df-a87e-0a74ceb46f5c",
                        "source_sense_description": "Suggesting imminent harm",
                        "target_lang_word": "menaçant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menaçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c78ea68f-fc61-398b-a197-05797f9ced84",
                                        "entry_id": "21401235-db5a-3ea5-97a5-24693f9dadc6",
                                        "glosses": [
                                            "Qui menace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2bc266-1bc7-4421-92b6-718a92c6c4b3",
                                                "sense_id": "c78ea68f-fc61-398b-a197-05797f9ced84",
                                                "text": "On dit que tu as poissé nos philippes (filouté nos pièces d’or), reprit le Biffon d’un air menaçant."
                                            },
                                            {
                                                "example_id": "342f44b1-bf4c-49a5-bdd4-b099c0367c54",
                                                "sense_id": "c78ea68f-fc61-398b-a197-05797f9ced84",
                                                "text": "Comme ils franchissaient le seuil, des formes invisibles surgirent, brusquement, de l'ombre. C'était les slouguis qui se précipitaient, menaçants. Mᵐᵉ Durelle poussa un cri."
                                            },
                                            {
                                                "example_id": "3295c4b8-6289-4988-9d23-3fde02a6d6cf",
                                                "sense_id": "c78ea68f-fc61-398b-a197-05797f9ced84",
                                                "text": "De chaque côté de la grille, s’étend un saut-de-loup dont la double crête est garnie des lances et des dards les plus menaçants, de véritables hérissons en fer."
                                            },
                                            {
                                                "example_id": "1bc1ae7d-daf6-4395-93a1-04d60fbaf3db",
                                                "sense_id": "c78ea68f-fc61-398b-a197-05797f9ced84",
                                                "text": "[…], mais le navire imperturbable cingle vers l’immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menaçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5558f4ce-5ce6-3b34-8b23-275904600bf9",
                                        "entry_id": "9664b261-4852-38ee-b15f-a247b0794907",
                                        "glosses": [
                                            "Participe présent de menacer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bb4e4d5-f657-46b6-8dbe-99392da3f502",
                                                "sense_id": "5558f4ce-5ce6-3b34-8b23-275904600bf9",
                                                "text": "Il eut, dans un coin, une longue explication avec Cœlina, qui finit par l’empêcher de faire un esclandre immédiat ; valait mieux que Françoise retournât chez lui d’elle-même, quand on l’aurait calmée ; et il partit à son tour, en menaçant de la venir chercher avec une corde et un bâton, si on ne la décidait pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e305ae-e3fb-4bf5-b9f1-79c4160fbf17",
                        "source_entry_id": "1b78dd6c-2304-3d47-86e8-71c2355c941c",
                        "source_sense_id": "aa76f655-cbce-38df-a87e-0a74ceb46f5c",
                        "source_sense_description": "Suggesting imminent harm",
                        "target_lang_word": "drohend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drohend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                        "entry_id": "71204558-c887-3602-a189-d959d3292b50",
                                        "glosses": [
                                            "(als etwas negatives) unmittelbar bevorstehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c06523-6a0c-48a8-ad94-3411a0766704",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Bei einer drohenden Frühgeburt werden z. B. Beta-2-Sympathomimetika zur Muskelrelaxation der Gebärmutter eingesetzt.“"
                                            },
                                            {
                                                "example_id": "bf1ef0fe-064b-4ef8-a652-3ef4986d75dd",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Gegen Ende des 2. Weltkrieges prägten die Nationalsozialisten angesichts der drohenden Niederlage den Begriff Wunderwaffe und propagierten damit vor allem die siegbringende Wirkung der sogenannten V–Waffen (= »Vergeltungswaffen«).“"
                                            },
                                            {
                                                "example_id": "5a48b6e3-4de8-4ba7-ac95-ddf92cc1f3d8",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Bei einer Vitalindikation werden z. T. auch Maßnahmen ergriffen, die ohne die Lebensgefahr nicht angebracht wären, z. B. ein Luftröhrenschnitt bei drohendem Erstickungstod oder die Anwendung von Zytostatika bei einer akuten Leukämie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "drohend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da5b8bfb-87a3-3025-bfa9-2b7d3a1f911d",
                                        "entry_id": "b32d8c23-81aa-3822-a5bc-9c7dfad4c1eb",
                                        "glosses": [
                                            "Partizip Präsens des Verbs drohen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3898265-c0e3-4d28-b744-bfedfcd18d13",
                        "source_entry_id": "1b78dd6c-2304-3d47-86e8-71c2355c941c",
                        "source_sense_id": "aa76f655-cbce-38df-a87e-0a74ceb46f5c",
                        "source_sense_description": "Suggesting imminent harm",
                        "target_lang_word": "bedrohlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bedrohlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                        "entry_id": "2bddb7a7-e853-300d-b980-c2437a87918e",
                                        "glosses": [
                                            "eine Empfindung von kurz bevorstehender Gefahr oder Not"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c661fba4-af4a-4469-bbd3-e5f60a8288f4",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Jeder Zweite empfindet den Islam als bedrohlich"
                                            },
                                            {
                                                "example_id": "c4a702d3-6e20-4672-9b10-7a2648a72be8",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Die C02-Emissionen steigen so bedrohlich, dass wir einen Klimawandel verursachen."
                                            },
                                            {
                                                "example_id": "762e833e-8220-46bd-9143-ffeae3eb3914",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Die Höhe der Staatsverschuldung in Europa nimmt bedrohliche Ausmaße an."
                                            },
                                            {
                                                "example_id": "a8c811e3-1078-40b0-9c83-2949faa68898",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Manchmal schweben sie hell und luftig über den blauen Sommerhimmel, manchmal türmen sie sich dunkel und bedrohlich am Horizont auf: Wolken."
                                            },
                                            {
                                                "example_id": "bcdd28d9-0840-4d92-acc3-6d1f70810284",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Hochwasser: Bei Sonnenschein und einem strahlend blauen Himmel wirkt das Ganze sehr entspannt und wenig bedrohlich. Doch die Elbe ist im Stadtteil Kleinwittenberg dem Ufer schon bedrohlich nahegekommen, und das ist von keinem Deich geschützt. Lediglich eine schmale Straße trennt die ersten Häuser von der Elbe, die stündlich breiter wird."
                                            },
                                            {
                                                "example_id": "0837ceaa-3940-4389-bc3f-fb0abe7921b2",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Die Regisseure setzten suggestive Schwarz-Weiß-Bilder, gespenstisch geschminkte Darsteller und eine nicht selten bedrohlich wirkende Filmmusik ein, um das Grauen und den Horror auf die Leinwand zu bannen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
