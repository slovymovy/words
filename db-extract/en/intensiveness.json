                                "target_senses": [
                                    {
                                        "sense_id": "9e7dfbd6-4691-304f-9197-87ca7c3e4715",
                                        "entry_id": "d91288f9-8273-3917-9cb0-7de70d39b1a3",
                                        "glosses": [
                                            "Grad, Stärke der Wirkung auf jemand/etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2349efe-3a92-40ca-b058-2c216ebc3de6",
                                                "sense_id": "9e7dfbd6-4691-304f-9197-87ca7c3e4715",
                                                "text": "Die Intensität des Lichtes nimmt zu. Es wird heller."
                                            },
                                            {
                                                "example_id": "17c8415c-c824-4933-afd4-7094cd58e36e",
                                                "sense_id": "9e7dfbd6-4691-304f-9197-87ca7c3e4715",
                                                "text": "Die Intensität der juristischen Studien des jungen Goethe ließ zu wünschen übrig, lieber wandte er sich der Poetik und dem Zeichnen zu."
                                            },
                                            {
                                                "example_id": "b6cb8b07-69ca-4b7f-9b4e-6183bd863fcf",
                                                "sense_id": "9e7dfbd6-4691-304f-9197-87ca7c3e4715",
                                                "text": "„Dennoch, das Zuviel an ununterbrochener Intensität kann – auf Dauer – schaden und sich in sein Gegenteil verkehren.“"
                                            },
                                            {
                                                "example_id": "cd1aeeec-72e9-4b1f-8c64-21cde8b461db",
                                                "sense_id": "9e7dfbd6-4691-304f-9197-87ca7c3e4715",
                                                "text": "„Die Werke de Sades verfolgen einen anderen Zweck als die Erhöhung des Genusses durch Schrankenlosigkeit, Vervielfachung und Intensität.“"
                                            },
                                            {
                                                "example_id": "62944383-5c58-4921-9a9d-6ef0e0cb0c6f",
                                                "sense_id": "9e7dfbd6-4691-304f-9197-87ca7c3e4715",
                                                "text": "„Die Intensität der Diskussion scheint uns heute vielleicht eine historische Kuriosität, aber man sollte sie lesen als exemplarischen Debattenschauplatz für die übergeordnete Problemstellung, was es denn heiße, einen aufgeklärten – und säkularen – Staat einzurichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e4d6623-5581-31b0-92b3-76c3418f571b",
                                        "entry_id": "d91288f9-8273-3917-9cb0-7de70d39b1a3",
                                        "glosses": [
                                            "physikalische Größe: Maß des Energieflusses je Zeit und Fläche"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd1a5d0-ccd0-4cd7-9a9c-dccb5aa4b7fe",
                                                "sense_id": "3e4d6623-5581-31b0-92b3-76c3418f571b",
                                                "text": "Die Intensität des Lasers ist zufriedenstellend."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4c49e4d4-c66e-3fd1-822f-f4d3f6e70023",
                                        "entry_id": "d91288f9-8273-3917-9cb0-7de70d39b1a3",
                                        "glosses": [
                                            "Maß, wie eingehend, mit welchem Grad an Willen eine Straftat begangen wird"
                                        ],
                                        "tags": [
                                            "Jura"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "401f07fb-5efc-4cba-acac-f8561fa65c9b",
                                                "sense_id": "4c49e4d4-c66e-3fd1-822f-f4d3f6e70023",
                                                "text": "Die Intensität der Gewalt ist bei diesem Verbrechen unerheblich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
