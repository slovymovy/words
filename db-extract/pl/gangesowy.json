                "translations": [
                    {
                        "translation_id": "c8db4406-6be3-45ff-8554-1c7de751f13e",
                        "source_entry_id": "5a76ad20-5f69-3978-b3e6-a7c14bbceb50",
                        "source_sense_id": "e3e37228-750d-3908-8fe3-d4cab37cedad",
                        "target_lang_word": "Gangean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gangean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e977315-cfc5-30f4-9c3d-7e6ceed6fd59",
                                        "entry_id": "8cfcba52-2f81-3467-990a-398dac3e117a",
                                        "glosses": [
                                            "Of or pertaining to the Ganges river."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4546f736-a146-4b01-8768-34a5ad68fa40",
                                                "sense_id": "8e977315-cfc5-30f4-9c3d-7e6ceed6fd59",
                                                "text": "Chinese merchants had traded with India and Roman outposts, and Chinese pilgrims had made overland journeys to the Indus and Gangean valleys, often by way of the Oxus and what is now Afghanistan."
                                            },
                                            {
                                                "example_id": "55751a34-e4f8-4683-bcdb-76aaff086025",
                                                "sense_id": "8e977315-cfc5-30f4-9c3d-7e6ceed6fd59",
                                                "text": "Careful interpretation of these indicated that the great Pennine River (Fig 13) evolved from a comparatively minor affair early in the Carboniferous to truly Gangean proportions at about the time that the great ice sheets of the southern hemisphere were accumulating about 330 million years ago."
                                            },
                                            {
                                                "example_id": "abff1f4b-fdc2-440f-bbfc-a4ed9325c423",
                                                "sense_id": "8e977315-cfc5-30f4-9c3d-7e6ceed6fd59",
                                                "text": "In this case, the problem was the Khembalis' little island (fifty-two square kilometers, their website said), which was clearly in all-too-good a location to contribute to ongoing studies of Gangean flooding and tidal storms in the Indian Ocean"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
