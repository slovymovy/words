    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1870182b-b7aa-3418-9a49-1a5eb2c7b89f",
                    "sense_definition": "Двигаться, передвигаться пешком, шагать.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро мы <w>идём</w> пешком в школу через парк.",
                            "target_lang_translations": {
                                "tr": "Her sabah parkın içinden okula <w>yürüyoruz</w>.",
                                "de": "Jeden Morgen <w>gehen</w> wir zu Fuß durch den Park zur Schule."
                            }
                        },
                        {
                            "text": "Человек медленно <w>шёл</w> по улице и смотрел по сторонам.",
                            "target_lang_translations": {
                                "tr": "Adam sokakta yavaşça <w>yürüyordu</w> ve etrafına bakıyordu.",
                                "de": "Der Mann <w>ging</w> langsam die Straße entlang und schaute sich um."
                            }
                        }
                    ],
                    "common_phrases": [
                        "идти пешком"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yürümek, adım atarak ilerlemek.",
                        "de": "Sich zu Fuß fortbewegen, schreiten."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yürümek",
                                "target_lang_sense_clarification": "adım atarak ilerlemek"
                            },
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "yayan hareket etmek"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gehen",
                                "target_lang_sense_clarification": "sich schrittweise fortbewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a063267-d4dd-3388-b24a-c7aeed0f24dc",
                    "sense_definition": "Отправляться или направляться куда-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня вечером мы <w>идём</w> в кино на новый фильм.",
                            "target_lang_translations": {
                                "tr": "Bu akşam yeni filme sinemaya <w>gidiyoruz</w>.",
                                "de": "Heute Abend <w>gehen</w> wir ins Kino, um den neuen Film zu sehen."
                            }
                        },
                        {
                            "text": "Завтра вся семья <w>идёт</w> в гости к бабушке.",
                            "target_lang_translations": {
                                "tr": "Yarın bütün aile büyükanneye misafirliğe <w>gidiyor</w>.",
                                "de": "Morgen <w>geht</w> die ganze Familie die Großmutter besuchen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "идти в кино",
                        "идти домой",
                        "идти в гости"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yere doğru yola çıkmak veya yönelmek.",
                        "de": "Sich zu einem bestimmten Ziel begeben."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "bir yere yönelmek veya devam etmek"
                            },
                            {
                                "target_lang_word": "yola çıkmak",
                                "target_lang_sense_clarification": "bir yere gitmek üzere harekete geçmek"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gehen",
                                "target_lang_sense_clarification": "sich zu einem Ort begeben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bafb5feb-c5d9-3911-aefb-02a8364b3e5a",
                    "sense_definition": "О выпадающих осадках: выпадать (о дожде, снеге).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На улице уже долго <w>идёт</w> сильный дождь.",
                            "target_lang_translations": {
                                "tr": "Dışarıda uzun zamandır şiddetli yağmur <w>yağıyor</w>.",
                                "de": "Draußen <w>regnet</w> es schon lange stark."
                            }
                        },
                        {
                            "text": "Вчера весь день <w>шёл</w> сильный снег.",
                            "target_lang_translations": {
                                "tr": "Dün bütün gün yoğun kar <w>yağdı</w>.",
                                "de": "Gestern hat es den ganzen Tag stark <w>geschneit</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "идёт дождь",
                        "идёт снег"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yağmur veya kar gibi yağışların düşmesi.",
                        "de": "Niederschlag wie Regen oder Schnee fällt vom Himmel."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yağmak",
                                "target_lang_sense_clarification": "yağmur veya kar gökten düşmek"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "regnen",
                                "target_lang_sense_clarification": "bei Regen"
                            },
                            {
                                "target_lang_word": "schneien",
                                "target_lang_sense_clarification": "bei Schnee"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23a4183a-b04b-35c9-b212-6fb393b3344d",
                    "sense_definition": "Работать, быть в исправном состоянии (о механизмах, часах).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мои старые настенные часы всё ещё точно <w>идут</w>.",
                            "target_lang_translations": {
                                "tr": "Eski duvar saatim hâlâ tam tıkırında <w>çalışıyor</w>.",
                                "de": "Meine alte Wanduhr <w>geht</w> immer noch genau."
                            }
                        },
                        {
                            "text": "Эти часы перестали <w>идти</w> вчера вечером.",
                            "target_lang_translations": {
                                "tr": "Bu saat dün akşam <w>çalışmayı</w> bıraktı.",
                                "de": "Diese Uhr ist gestern Abend stehen geblieben, sie <w>geht</w> nicht mehr."
                            }
                        }
                    ],
                    "common_phrases": [
                        "часы идут"
                    ],
                    "target_lang_definitions": {
                        "tr": "Saat veya mekanizma gibi düzeneklerin çalışır durumda olması.",
                        "de": "In Betrieb sein oder funktionieren (bei Uhren oder Maschinen)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çalışmak",
                                "target_lang_sense_clarification": "saat veya mekanizmanın işlemesi"
                            },
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "makinenin, saatin işlemesi"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gehen",
                                "target_lang_sense_clarification": "funktionieren"
                            },
                            {
                                "target_lang_word": "laufen",
                                "target_lang_sense_clarification": "in Betrieb sein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2305d96-87c2-3509-9931-e33bc8c7480f",
                    "sense_definition": "Быть к лицу, подходить (об одежде, стиле, цвете).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тебе очень <w>идёт</w> это синее платье.",
                            "target_lang_translations": {
                                "tr": "Bu mavi elbise sana çok <w>yakışıyor</w>.",
                                "de": "Dieses blaue Kleid <w>steht</w> dir sehr gut."
                            }
                        },
                        {
                            "text": "Новая шляпа совсем ей не <w>идёт</w>.",
                            "target_lang_translations": {
                                "tr": "Yeni şapka ona hiç <w>yakışmıyor</w>.",
                                "de": "Der neue Hut <w>steht</w> ihr überhaupt nicht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "тебе идёт"
                    ],
                    "target_lang_definitions": {
                        "tr": "Giysi, tarz veya rengin kişiye yakışması.",
                        "de": "Ein Kleidungsstück oder Stil passt gut zu jemandem."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yakışmak",
                                "target_lang_sense_clarification": "kıyafetin veya tarzın birine uygun düşmesi"
                            },
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "yaraşmak, yakışmak"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stehen",
                                "target_lang_sense_clarification": "jemandem gut kleiden"
                            },
                            {
                                "target_lang_word": "passen",
                                "target_lang_sense_clarification": "optisch gut aussehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2461e8a-6ac0-337a-8b33-f4f05a167c40",
                    "sense_definition": "Проходить, протекать, совершаться (о времени, процессах).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сейчас <w>идёт</w> важный урок, не шумите.",
                            "target_lang_translations": {
                                "tr": "Şu an önemli bir ders <w>işleniyor</w>, gürültü yapmayın.",
                                "de": "Gerade <w>läuft</w> eine wichtige Unterrichtsstunde, seid bitte leise."
                            }
                        },
                        {
                            "text": "Время <w>идёт</w> быстро, когда мы вместе.",
                            "target_lang_translations": {
                                "tr": "Birlikte olduğumuzda zaman hızlı <w>geçiyor</w>.",
                                "de": "Die Zeit <w>vergeht</w> schnell, wenn wir zusammen sind."
                            }
                        }
                    ],
                    "common_phrases": [
                        "время идёт",
                        "идёт урок"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zamanın veya olayların geçmesi, devam etmesi.",
                        "de": "Zeit vergeht oder ein Prozess läuft ab."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçmek",
                                "target_lang_sense_clarification": "zamanın akıp gitmesi"
                            },
                            {
                                "target_lang_word": "devam etmek",
                                "target_lang_sense_clarification": "ders veya sürecin sürmesi"
                            },
                            {
                                "target_lang_word": "sürmek",
                                "target_lang_sense_clarification": "zamanın geçmesi"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vergehen",
                                "target_lang_sense_clarification": "Zeit, die abläuft"
                            },
                            {
                                "target_lang_word": "laufen",
                                "target_lang_sense_clarification": "ein Prozess, der stattfindet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c5fd96a-bf5f-3299-803a-7265f6219c30",
                    "sense_definition": "Пролегать, простираться, иметься (о дороге, границе, линии).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта узкая тропинка <w>идёт</w> через густой лес.",
                            "target_lang_translations": {
                                "tr": "Bu dar patika sık ormanın içinden <w>geçiyor</w>.",
                                "de": "Dieser schmale Pfad <w>verläuft</w> durch den dichten Wald."
                            }
                        },
                        {
                            "text": "Шоссе <w>идёт</w> вдоль живописного берега реки.",
                            "target_lang_translations": {
                                "tr": "Otoyol nehrin manzaralı kıyısı boyunca <w>uzanıyor</w>.",
                                "de": "Die Autobahn <w>führt</w> entlang des malerischen Flussufers."
                            }
                        }
                    ],
                    "common_phrases": [
                        "дорога идёт"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yol, hat veya sınırın belirli bir hat boyunca uzanması.",
                        "de": "Ein Weg oder eine Linie erstreckt sich in eine Richtung."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uzanmak",
                                "target_lang_sense_clarification": "yolun veya hattın ilerlemesi"
                            },
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "yolun bir yere doğru uzanması"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verlaufen",
                                "target_lang_sense_clarification": "sich räumlich erstrecken"
                            },
                            {
                                "target_lang_word": "führen",
                                "target_lang_sense_clarification": "eine Richtung vorgeben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64cc86f6-e351-3259-9ca3-1f27eb4797fb",
                    "sense_definition": "Показываться, демонстрироваться (о фильме, спектакле).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В городском кинотеатре <w>идёт</w> интересный фильм.",
                            "target_lang_translations": {
                                "tr": "Şehir sinemasında ilginç bir film <w>oynuyor</w>.",
                                "de": "Im Stadtkino <w>läuft</w> ein interessanter Film."
                            }
                        },
                        {
                            "text": "Этот спектакль <w>идёт</w> на сцене уже два года.",
                            "target_lang_translations": {
                                "tr": "Bu oyun iki yıldır sahnede <w>oynanıyor</w>.",
                                "de": "Dieses Theaterstück <w>läuft</w> schon seit zwei Jahren auf der Bühne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "фильм идёт"
                    ],
                    "target_lang_definitions": {
                        "tr": "Film veya oyunun gösterimde olması, oynatılması.",
                        "de": "Ein Film oder Theaterstück wird gezeigt."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "oynamak",
                                "target_lang_sense_clarification": "filmin gösterilmesi veya tiyatronun sahnelenmesi"
                            },
                            {
                                "target_lang_word": "gösterimde olmak",
                                "target_lang_sense_clarification": "filmin vizyonda olması"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "laufen",
                                "target_lang_sense_clarification": "im Programm sein"
                            },
                            {
                                "target_lang_word": "gezeigt werden",
                                "target_lang_sense_clarification": "aufgeführt werden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "195d02bd-9e43-328d-b70a-8442123f95cf",
                    "sense_definition": "Выходить, выделяться, вытекать откуда-либо (о дыме, паре, жидкостях).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "substance_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из высокой фабричной трубы <w>идёт</w> густой дым.",
                            "target_lang_translations": {
                                "tr": "Yüksek fabrika bacasından koyu bir duman <w>çıkıyor</w>.",
                                "de": "Aus dem hohen Fabrikschornstein <w>kommt</w> dichter Rauch."
                            }
                        },
                        {
                            "text": "Из крана на кухне всё ещё <w>идёт</w> горячая вода.",
                            "target_lang_translations": {
                                "tr": "Mutfaktaki musluktan hâlâ sıcak su <w>akıyor</w>.",
                                "de": "Aus dem Wasserhahn in der Küche <w>fließt</w> immer noch heißes Wasser."
                            }
                        }
                    ],
                    "common_phrases": [
                        "идёт дым",
                        "идёт пар"
                    ],
                    "target_lang_definitions": {
                        "tr": "Duman, buhar veya sıvının bir yerden dışarı çıkması, akması.",
                        "de": "Flüssigkeit oder Gas tritt aus einer Öffnung aus."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çıkmak",
                                "target_lang_sense_clarification": "duman veya buharın yükselmesi"
                            },
                            {
                                "target_lang_word": "akmak",
                                "target_lang_sense_clarification": "musluktan suyun gelmesi"
                            },
                            {
                                "target_lang_word": "gelmek",
                                "target_lang_sense_clarification": "sıvı veya gazın dışarı verilmesi"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "herauskommen",
                                "target_lang_sense_clarification": "aus einer Quelle austreten"
                            },
                            {
                                "target_lang_word": "fließen",
                                "target_lang_sense_clarification": "bei Flüssigkeiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7525c862-7c91-3975-85d7-37e8626f9803",
                    "sense_definition": "Двигаться, перемещаться (о транспорте, механизмах).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пассажирский поезд <w>идёт</w> по расписанию точно в срок.",
                            "target_lang_translations": {
                                "tr": "Yolcu treni tarifeye göre tam zamanında <w>ilerliyor</w>.",
                                "de": "Der Personenzug <w>fährt</w> pünktlich nach Fahrplan."
                            }
                        },
                        {
                            "text": "Старый автобус <w>шёл</w> очень медленно из-за снега.",
                            "target_lang_translations": {
                                "tr": "Eski otobüs kar yüzünden çok yavaş <w>ilerliyordu</w>.",
                                "de": "Der alte Bus <w>fuhr</w> wegen des Schnees sehr langsam."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поезд идёт"
                    ],
                    "target_lang_definitions": {
                        "tr": "Taşıt veya araçların hareket etmesi, yol alması.",
                        "de": "Ein Fahrzeug bewegt sich fort."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "taşıtın yol alması"
                            },
                            {
                                "target_lang_word": "ilerlemek",
                                "target_lang_sense_clarification": "aracın hareket etmesi"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fahren",
                                "target_lang_sense_clarification": "sich mit einem Fahrzeug bewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0266e58-7cb5-384c-83f5-36578c111a66",
                    "sense_definition": "Выражает согласие, договорённость (в значении «согласен», «договорились»).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Встретимся завтра в пять? — <w>Идёт</w>!",
                            "target_lang_translations": {
                                "tr": "— Yarın saat beşte buluşalım mı? — <w>Tamam</w>!",
                                "de": "— Treffen wir uns morgen um fünf? — <w>Abgemacht</w>!"
                            }
                        },
                        {
                            "text": "Помоги мне с переводом, а я куплю кофе. — <w>Идёт</w>!",
                            "target_lang_translations": {
                                "tr": "Çeviride bana yardım et, ben de kahve alayım. — <w>Anlaştık</w>!",
                                "de": "— Hilf mir bei der Übersetzung, und ich kaufe Kaffee. — <w>Einverstanden</w>!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ну идёт"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kabullenme, anlaşma veya onay ifade eder.",
                        "de": "Ausdruck von Zustimmung oder Vereinbarung."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "olur",
                                "target_lang_sense_clarification": "anlaştık anlamında onay kelimesi"
                            },
                            {
