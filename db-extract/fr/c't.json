                            {
                                "example_id": "7dc793bb-2546-4d9b-a197-d2f1df16ad84",
                                "sense_id": "d9635539-9c03-37bf-ac9c-72e4e5d1f756",
                                "text": "Voyez comme il est joli, c’t amour avec sa grande collerette ! Ça ne vaut-i pas mieux que c’t autre avec sa moustache blanche ?"
                            },
                            {
                                "example_id": "ddcfae6c-82ec-41dc-999c-e3aa42054212",
                                "sense_id": "d9635539-9c03-37bf-ac9c-72e4e5d1f756",
                                "text": "I’ n’ me croyait pas, c’t’ enfant, i’ r’tournait sous le lit qu’était sa place préférée."
                            },
                            {
                                "example_id": "b2866e1c-098b-40da-9b86-009d2833268d",
                                "sense_id": "d9635539-9c03-37bf-ac9c-72e4e5d1f756",
                                "text": "— Il a dit, l’capitaine, que j’passerais à la tondeuse c’t’ aprèm’…"
                            }
                        ]
                    }
