                ],
                "senses": [
                    {
                        "sense_id": "e371912e-e425-325f-a23d-598c2714f620",
                        "entry_id": "007022af-e2a8-3787-9eba-7aff3bf13ca5",
                        "glosses": [
                            "Tourner la manivelle, tourner quelque chose comme avec une manivelle."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "95f24e2d-13aa-429b-ba32-948a8e9ca0db",
                                "sense_id": "e371912e-e425-325f-a23d-598c2714f620",
                                "text": "[…] moi, non moins piteux que le chien du tournebroche manivellant le rôti que du coin de l’œil il guigne sans en prendre sa part, je m’embusque […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "57b40caa-b15b-37d6-b17f-835c5f216938",
                        "entry_id": "007022af-e2a8-3787-9eba-7aff3bf13ca5",
                        "glosses": [
                            "Manipuler dans un sens tournant."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d332b279-84bf-46e8-9217-3acc73b3c8cd",
                                "sense_id": "57b40caa-b15b-37d6-b17f-835c5f216938",
                                "text": "Nous sortons en nous tenant par le bras, je trouve à me branler au coin d’un immeuble, son grand manteau brandi cache ce que mes mains manivellent."
                            }
                        ]
                    },
                    {
                        "sense_id": "34f4b61b-e98e-3f53-a52e-21e0ea6a54d6",
                        "entry_id": "007022af-e2a8-3787-9eba-7aff3bf13ca5",
                        "glosses": [
                            "Tourner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e561a42c-b87a-4846-bb83-5fdbfdf6064e",
                                "sense_id": "34f4b61b-e98e-3f53-a52e-21e0ea6a54d6",
                                "text": "J’entends les pulsations qui manivellent dans ma tronche… un… deux… trois…"
                            }
                        ]
                    },
                    {
                        "sense_id": "d14edd22-ca5d-3c84-a20e-18551ccf0d4b",
                        "entry_id": "007022af-e2a8-3787-9eba-7aff3bf13ca5",
                        "glosses": [
                            "Équiper d’une manivelle, de manivelles."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dcb90477-2f36-4dc4-af79-e0349b182055",
                                "sense_id": "d14edd22-ca5d-3c84-a20e-18551ccf0d4b",
                                "text": "Ces machines […] sont presque toutes plus ou moins lourdement ferrées, plaquées, vissées, tourillonnées, écrouées, manivellées, crochetées, etc., etc., ce qui rend leur usage très embarrassant pour le praticien, et très fatigant pour le malade."
                            }
                        ]
                    }
