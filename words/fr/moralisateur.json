                        {
                            "text": "Les critiques ont détesté ce film à cause de son discours <w>moralisateur</w> et de son manque de subtilité."
                        }
                    ],
                    "synonyms": [
                        "donneur de leçons",
                        "moralisant"
                    ],
                    "common_phrases": [
