                ],
                "senses": [
                    {
                        "sense_id": "cd4d2394-b930-3d18-adc9-dbf2b811e0b9",
                        "entry_id": "24399c0a-20d1-3b2f-90d0-bf10446992a5",
                        "glosses": [
                            "Diffuser en direct sur Internet (des images capturées par webcam)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06c3fc3-d8d8-4218-9129-7dd264c5662b",
                                "sense_id": "cd4d2394-b930-3d18-adc9-dbf2b811e0b9",
                                "text": "« C’est comme si je live-streamais mon roman », se réjouit Rachel Hulin qui dit s’inspirer des commentaires reçus pour faire avancer l’histoire."
                            },
                            {
                                "example_id": "529dc568-e8c4-4fe2-ad38-4ffe54a58d6a",
                                "sense_id": "cd4d2394-b930-3d18-adc9-dbf2b811e0b9",
                                "text": "Le samedi a débuté par le Grand Champions Breakfast au Westin, dans le centre de Charlotte pour une cérémonie qui a récompensé l’ensemble des pilotes pour leurs réalisations de cette extraordinaire saison - et s’est achevé par la NASCAR Night of Champions Touring Awards, un spectacle impressionnant qui présente sur scène les champions des sept NASCAR Touring Series ainsi que les Rookies of the Year, Most Popular Drivers, Propriétaires et Crew-chiefs des champions, le tout live-streamé en trois langues."
                            },
                            {
                                "example_id": "cf78f733-90a5-4868-b929-59fe9e277e3b",
                                "sense_id": "cd4d2394-b930-3d18-adc9-dbf2b811e0b9",
                                "text": "C'est ce qu'on a expérimenté récemment sur Merkaat le jour de l'éclipse lunaire ou sur Periscope pendant l'interview de Wendy Bouchard sur Twitter, que nous avons live-streamé pendant 10 minutes pour tester l'application."
                            }
                        ]
                    }
