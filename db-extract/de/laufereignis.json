                ],
                "senses": [
                    {
                        "sense_id": "a0fb5c45-51ef-3eef-8f0e-775ce6cf25fb",
                        "entry_id": "fde6d646-81ad-38f3-843d-f0b943fbe92a",
                        "glosses": [
                            "(meistens eine renommierte, bekannte) Laufveranstaltung – zum Beispiel ein Wettkampf oder ein Stadtlauf mit großer Beteiligung"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8f6d227e-0add-45ed-a272-a35f46650d8c",
                                "sense_id": "a0fb5c45-51ef-3eef-8f0e-775ce6cf25fb",
                                "text": "„Mit einer Teilnehmerzahl von ca. 3000 Läufern zählt der Reschenseelauf zu den großen Laufereignissen in Südtirol.“"
                            },
                            {
                                "example_id": "e03833b6-1b76-4a92-a35c-fcbd10705550",
                                "sense_id": "a0fb5c45-51ef-3eef-8f0e-775ce6cf25fb",
                                "text": "„Zu diesem Laufereignis für jedermann werden viele Läufer erwartet.“"
                            },
                            {
                                "example_id": "ef8d9a37-0ba8-48fe-a6d5-d62689f8e6b7",
                                "sense_id": "a0fb5c45-51ef-3eef-8f0e-775ce6cf25fb",
                                "text": "„Auf der 5 km langen Strecke lauft ihr, angefeuert von heißen Rhythmen, durch die historische Innenstadt Dresdens und feiert bei diesem einmaligen Laufereignis bis ins Ziel.“"
                            },
                            {
                                "example_id": "044c3d6c-1a2a-4598-b9c5-3bf3577857f4",
                                "sense_id": "a0fb5c45-51ef-3eef-8f0e-775ce6cf25fb",
                                "text": "„Im Rahmen der Vorbereitung auf verschiedene anstehende Laufereignisse waren heute viele Läuferinnen und Läufer des Lauftreffs rund um Hofgeismar und teilweise auch auswärts unterwegs.“"
                            },
                            {
                                "example_id": "fc606f64-45bd-423e-a027-5e64c0fad994",
                                "sense_id": "a0fb5c45-51ef-3eef-8f0e-775ce6cf25fb",
                                "text": "„Über 1000 Läuferinnen und Läufer aus der Region nahmen an dem renommierten Laufereignis teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
