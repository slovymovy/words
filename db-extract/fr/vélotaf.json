                "senses": [
                    {
                        "sense_id": "62fdbaf3-910d-3bba-bc74-14b9f6525349",
                        "entry_id": "fe38213d-aeab-36ff-a9a2-ea22f59d673a",
                        "glosses": [
                            "Fait d'utiliser le vélo comme moyen de transport pour ses trajets domicile-travail ou pour ses déplacements professionnels."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "98066a6b-f022-4072-9ef7-e54b1634de57",
                                "sense_id": "62fdbaf3-910d-3bba-bc74-14b9f6525349",
                                "text": "Avec l’épidémie de Covid-19, vous craignez de reprendre tout de suite le métro ou le tramway pour aller au travail… C’est le moment de vous convertir au « vélotaf » : le soleil est là, les journées sont plus longues, et la pratique du vélo de plus en plus facilitée ; ainsi, de nouvelles pistes cyclables, pour l’instant temporaires, ont été tracées dans la plupart des grandes villes."
                            },
                            {
                                "example_id": "6e6122d0-7396-41b2-916e-664f9daa16e7",
                                "sense_id": "62fdbaf3-910d-3bba-bc74-14b9f6525349",
                                "text": "Avec la multiplications des pistes cyclables en Île-de-France, le « vélotaf » (sic), à savoir se rendre au travail à vélo vous tente mais vous n’osez pas vous lancer sans aide ?"
                            }
                        ]
                    }
                ],
