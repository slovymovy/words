                "entry_id": "39f38be0-7384-3d78-afe9-51beccb05a32",
                "word": "comorbiditeit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f14fd050-97a0-404d-bc98-17f500faa97b",
                        "entry_id": "39f38be0-7384-3d78-afe9-51beccb05a32",
                        "tags": [
                            "plural"
