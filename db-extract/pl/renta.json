                        "cross_references": []
                    },
                    {
                        "translation_id": "e1f13887-2da9-4dba-9f80-14ebc3c75bfa",
                        "source_entry_id": "0f3ecf13-9505-38a6-a704-797606cce37e",
                        "source_sense_id": "b0886a35-7a7d-3955-8f7a-e38ce081dc0a",
                        "target_lang_word": "disability pension",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4d64a362-0985-4032-8c3c-50f3248e74b8",
                        "source_entry_id": "0f3ecf13-9505-38a6-a704-797606cce37e",
                        "source_sense_id": "b0886a35-7a7d-3955-8f7a-e38ce081dc0a",
                        "target_lang_word": "Rente",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rente",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                        "entry_id": "935551c1-9fbf-3bc3-9043-b2ec75f18ac2",
                                        "glosses": [
                                            "Ruhegeld wegen Alters oder Erwerbsunfähigkeit für Arbeiter und Angestellte"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed7a37a-6f5b-4c83-8495-f879040ea165",
                                                "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                                "text": "Durch die Überalterung in den Industrieländern stagniert die Rente."
                                            },
                                            {
                                                "example_id": "1bcc6d63-8034-4884-811c-8ec723334cf1",
                                                "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                                "text": "Die durchschnittliche Höhe der Renten ist im letzten Jahr um 0,1 % gestiegen."
                                            },
                                            {
                                                "example_id": "98fb62e6-6290-4ff1-bd4b-eb396e1df253",
                                                "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                                "text": "Nächstes Jahr werde ich in Rente gehen."
                                            },
                                            {
                                                "example_id": "b016cf6e-b510-4500-a1de-6a3f249aa6c9",
                                                "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                                "text": "„Mittlerweile in Rente, gab sie sich reiselustig in ihrem Trabi.“"
                                            },
                                            {
                                                "example_id": "05541bb4-54dc-42a0-98a7-f4e21ce7f5bc",
                                                "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                                "text": "„Der Ketzer von Teneriffa konnte sich lange nicht entscheiden, ob er nun in Rente gehen möchte oder nicht.“"
                                            },
                                            {
                                                "example_id": "1d3c16c3-e257-4613-9bb9-c1a5d23318d6",
                                                "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                                "text": "Zwar erhält sie [die Berlinerin Sara Sliwka] heute monatlich rund 300 Euro Entschädigung – für ihre Verfolgung. Aber für ihre viereinhalb Jahre Getto- und Lagerarbeit bekomme sie keinen Cent Rente, klagt die Holocaust-Überlebende."
                                            },
                                            {
                                                "example_id": "9b3615aa-c05a-42df-b382-3a49c28f090e",
                                                "sense_id": "eba04058-737f-3f58-ba21-c9a5f1ea7961",
                                                "text": "„Wie der Vater hatte auch er einen Herzinfarkt hinter sich, und seine Rente lief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "918ccc5f-c326-3ccd-bf1f-7c2c0078b680",
                                        "entry_id": "935551c1-9fbf-3bc3-9043-b2ec75f18ac2",
                                        "glosses": [
                                            "eine Folge regelmäßiger Zahlungen, auf die ein Rechtsanspruch besteht, aber ohne unmittelbare Gegenleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33b7ffe-6ef8-4af9-a144-f9bc1cf943b5",
                                                "sense_id": "918ccc5f-c326-3ccd-bf1f-7c2c0078b680",
                                                "text": "Bei der Auszahlung meiner Lebensversicherung konnte ich wählen, ob ich einen Einmalbetrag erhalten wollte oder eine monatliche Rente."
                                            },
                                            {
                                                "example_id": "0a820706-be40-4831-bb5f-3e9e512942ba",
                                                "sense_id": "918ccc5f-c326-3ccd-bf1f-7c2c0078b680",
                                                "text": "Max hat bei einer Verlosung gewonnen. Er bekommt nun zehn Jahre lang jeden Monat tausend Euro Rente auf sein Konto überwiesen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d86a9cd-32d2-37cb-97c1-af41e429c1e6",
                                        "entry_id": "935551c1-9fbf-3bc3-9043-b2ec75f18ac2",
                                        "glosses": [
                                            "festverzinsliches Wertpapier"
                                        ],
                                        "tags": [
                                            "Bankwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c74fed-eeac-4499-990e-e24831c2fcf4",
                                                "sense_id": "9d86a9cd-32d2-37cb-97c1-af41e429c1e6",
                                                "text": "„Der Staat kann den Kriegskredit kurzfristig in Anspruch nehmen, durch Anleihen bei der Notenbank; […] oder langfristig durch Ausgabe von Renten, das sind Schuldverschreibungen, deren Rückzahlungstermin der Staat nach Belieben auf Jahrzehnte hinausschieben kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cfa65fd-f6ce-4104-a499-b889e7b1ceaf",
                        "source_entry_id": "0f3ecf13-9505-38a6-a704-797606cce37e",
                        "source_sense_id": "b0886a35-7a7d-3955-8f7a-e38ce081dc0a",
                        "target_lang_word": "σύνταξη",
