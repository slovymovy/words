                "senses": [
                    {
                        "sense_id": "7ac8ffe2-acd4-34ae-b4a9-51aa76b315cb",
                        "entry_id": "58726390-b3db-337d-90ae-91c17a01d6cc",
                        "glosses": [
                            "Donner un caractère gourmand à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "855ae585-6555-4603-8929-875d1569874a",
                                "sense_id": "7ac8ffe2-acd4-34ae-b4a9-51aa76b315cb",
                                "text": "Vous pouvez également gourmandiser ce gratin en le complétant de dés de jambon ou lardons et d'oignons par exemple (les faire revenir à feu doux avant de les ajouter au gratin à enfourner)."
                            },
                            {
                                "example_id": "daeabc00-0831-4b1f-8646-fb54fded6cac",
                                "sense_id": "7ac8ffe2-acd4-34ae-b4a9-51aa76b315cb",
                                "text": "Oui, je vous l'ai dit, c'est pas une salade de régime. Mais quand même, de temps en temps on peut bien la gourmandiser (quite à la calorifier... bien sûr que ça se dit, qui en doute !?!) un peu sa salade..."
                            },
                            {
                                "example_id": "baf555b0-4de3-47ee-8479-3ca405c678c3",
                                "sense_id": "7ac8ffe2-acd4-34ae-b4a9-51aa76b315cb",
                                "text": "j'ai essayé deux tabacs pour le moment (ry4 et tribeca) et ça ne m'a pas plu, j'ai été obligée de les gourmandiser avec de la banane ou du caramel pour finir le tank."
                            }
                        ]
                    }
