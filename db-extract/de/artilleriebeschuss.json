                "senses": [
                    {
                        "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                        "entry_id": "8783a494-4d68-3f97-8bfd-d0f1906ed3cd",
                        "glosses": [
                            "Einsatz von Artilleriegeschossen mit großkalibrigen Kanonen, Haubitzen oder Mörsern zur Bekämpfung von Zielen in einer militärischen Auseinandersetzung"
                        ],
                        "tags": [
                            "meist im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "c9c44844-b6f7-415c-98bd-56cf75444fc0",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Durch heftigen Artilleriebeschuss wurden mehrere japanische Stellungen zerstört.“"
                            },
                            {
                                "example_id": "d0fc56ce-1c82-4f49-b5e1-94f59ef319cf",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Durch Artilleriebeschuss wurden Marktkirche, Werdermühle, Rathaus und mehrere Häuser, auch in der Osterstraße zerstört.“"
                            },
                            {
                                "example_id": "82d33bfb-68f5-4f38-983d-1a61599b8e00",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Im Gazastreifen gehen die Kämpfe derweil unverändert weiter. Durch israelischen Artilleriebeschuss im Norden des Küstengebiets wurden nach Angaben von Sanitätern mindestens fünf Menschen getötet.“"
                            },
                            {
                                "example_id": "fe4248d3-1d6c-4e93-9692-5c8f50ce327e",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Das Al-Shifa-Krankenhaus in Gaza-Stadt ist unter heftigen Artilleriebeschuss geraten, war stundenlang ohne Strom – nun stellt das Spital den Betrieb ein.“"
                            },
                            {
                                "example_id": "decd1062-bc20-4501-8db2-5eb6394fd959",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "[22. September 1915:] „An der Westfront leitet anhaltender Artilleriebeschuss eine großangelegte Offensive der Alliierten ein.“"
                            },
                            {
                                "example_id": "a2c35c0e-a4eb-4eb2-bfdd-d6a0548b66ef",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Am 21. Februar 1916, 8h15 setzte ein Artilleriebeschuss ein, aus 1200 Rohren aller Kaliber, wie ihn die Welt noch nicht erlebt hatte.“"
                            },
                            {
                                "example_id": "06c6ff35-48c5-4801-9aad-21edaff553ca",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Nach einem eintägigen Artilleriebeschuss auf die österreichischen Stellungen gingen die russischen Infanteristen aus ihren Stellungen zum Angriff über.“"
                            },
                            {
                                "example_id": "d447dd57-ffff-450f-8d5c-91c5ab87fe4f",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„An der Front in der Ost-Ukraine sind Kiews Truppen unter massivem russischem Artilleriebeschuss,“ […]."
                            },
                            {
                                "example_id": "f5bc0f1c-fca8-45f6-b63c-515a5fc2c5be",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Die Russen zogen sich in den Wald am Ortsrand von Hostomel zurück, nachdem sie kurz zuvor auf dem Weg nach Kiew unter Artilleriebeschuss gerieten.“"
                            },
                            {
                                "example_id": "7f6079f4-cc43-47e7-a967-120644f49187",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Nach ukrainischen Angaben wurden Vororte im Nordwesten der Hauptstadt Kiew unter Artilleriebeschuss genommen.“"
                            },
                            {
                                "example_id": "2f32cf48-e401-43dd-9dcd-4394c7b8260f",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Auch Drohnen und verstärkter Artilleriebeschuss waren in der Gegend zu hören.“"
                            },
                            {
                                "example_id": "4ceef0b7-4576-40cf-b075-7e7751d4d607",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Besonders betroffen von dem Artilleriebeschuss war die Grenzstadt Schebekino, aus der viele Menschen flohen.“"
                            },
                            {
                                "example_id": "59c1c379-74dc-455e-b28e-aedc47952a05",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "„Sie starben demnach durch Artilleriebeschuss im Dorf Wiroljubiwka in einem schwer umkämpften Gebiet in der Nähe der Frontlinie.“"
                            },
                            {
                                "example_id": "e3101529-a3e1-4adf-995f-9e0c90393bd7",
                                "sense_id": "7b9ed5b8-c092-3995-b8fc-751dc46102f4",
                                "text": "[3. Januar 1944:] „Der aus Ostasien kommende deutsche Blockadebrecher \"Weserland\" wird auf dem Weg in seinen Heimathafen von einem US-amerikanischen Zerstörer durch schweren Artilleriebeschuss versenkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
