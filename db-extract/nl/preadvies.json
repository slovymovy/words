                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To relate details of (an event or incident); to recount, describe (something)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2adb3a8e-1eb5-4c51-80c5-b6b45265f0cd",
                                                "sense_id": "9eddd865-5750-3bc3-92d7-3758a446e76b",
                                                "text": "Many of these classic methods are still used, with some modern improvements. For example, with the aid of special microphones and automated sound detection software, ornithologists recently reported[…]that pine siskins (Spinus pinus) undergo an irregular, nomadic type of nocturnal migration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a710260-ca5c-361e-a63c-037dc3e4907a",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To repeat (something one has heard), to retell; to pass on, convey (a message, information etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55af4198-5202-3315-bc10-c016a8c61493",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To take oneself (to someone or something) for guidance or support; to appeal."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b41696-ef95-4371-b21a-57140692e474",
                                                "sense_id": "55af4198-5202-3315-bc10-c016a8c61493",
                                                "text": "thenne they ansuerd by and by that they coude not excuse the quene /[…]/ Allas sayd the quene I made this dyner for a good entente / and neuer for none euyl soo almyghty god me help in my ryght as I was neuer purposed to doo suche euylle dedes / and that I reporte me vnto god"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3303947d-f15e-348f-9c93-0e7d93f8a354",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To notify someone of (particular intelligence, suspicions, illegality, misconduct etc.); to make notification to relevant authorities; to submit a formal report of."
                                        ],
                                        "tags": [
                                            "formal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37e782d-59d3-49a3-b359-5c6216fe1251",
                                                "sense_id": "3303947d-f15e-348f-9c93-0e7d93f8a354",
                                                "text": "For insurance reasons, I had to report the theft to the local police station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c45712ed-6225-3ad3-9a0d-73ca95a0cd5c",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To make a formal statement, especially of complaint, about (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add97d2e-fa79-4e7f-ac02-4e82c62dc1fc",
                                                "sense_id": "c45712ed-6225-3ad3-9a0d-73ca95a0cd5c",
                                                "text": "If you do that again I'll report you to the boss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f9a28d6-3bc2-3223-add6-4d1cd02e17be",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To show up or appear at an appointed time; to present oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "143d6e45-eb45-3959-b336-52393e1d1fc9",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To write news reports (for); to cover as a journalist or reporter."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb2689c-c69f-4112-89d6-0c602eb13847",
                                                "sense_id": "143d6e45-eb45-3959-b336-52393e1d1fc9",
                                                "text": "Andrew Marr reports now on more in-fighting at Westminster."
                                            },
                                            {
                                                "example_id": "37102ee5-4202-4a19-b399-1fa69b552cd5",
                                                "sense_id": "143d6e45-eb45-3959-b336-52393e1d1fc9",
                                                "text": "Every newspaper reported the war."
                                            },
                                            {
                                                "example_id": "20117f76-9713-4c7b-aa7b-e4626beaa040",
                                                "sense_id": "143d6e45-eb45-3959-b336-52393e1d1fc9",
                                                "text": "In January, the country’s weather agency sent aircraft to release chemicals into clouds over the Yellow Sea, South Korea’s Yonhap news agency reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a44daa-270d-3acd-bcaa-627d72d85984",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To be accountable to or subordinate to (someone) in a hierarchy; to receive orders from (someone); to give official updates to (someone who is above oneself in a hierarchy)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de955d5b-0ce3-43a5-b488-db5d807543db",
                                                "sense_id": "e4a44daa-270d-3acd-bcaa-627d72d85984",
                                                "text": "The financial director reports to the CEO."
                                            },
                                            {
                                                "example_id": "19b9c940-e702-4911-ace0-6345e6bd635a",
                                                "sense_id": "e4a44daa-270d-3acd-bcaa-627d72d85984",
                                                "text": "Now that I've been promoted, I report to Benjamin, whom I loathe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12c035b5-6937-305d-b918-3a33dddece25",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To return or present as the result of an examination or consideration of any matter officially referred."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a5f7a6-536a-423a-9f36-096a80f78e92",
                                                "sense_id": "12c035b5-6937-305d-b918-3a33dddece25",
                                                "text": "The committee reported the bill with amendments, or reported a new bill, or reported the results of an inquiry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a97d2a8-41ab-32d6-a855-2549e4f36799",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To take minutes of (a speech, the doings of a public body, etc.); to write down from the lips of a speaker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a7e6c97-4862-3ad3-9823-233e67782c63",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To refer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7d68873-3d04-41f2-b43b-3d23b0488f6a",
                                                "sense_id": "4a7e6c97-4862-3ad3-9823-233e67782c63",
                                                "text": "Baldwine his ſonne, the fourth of that name [Baldwin IV of Jerusalem], ſucceeded his father [Amalric of Jerusalem]: ſo like unto him, that we report the reader to the character of King Almerick, and will ſpare the repeating his description."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90a98d6-f863-3e98-b178-17c64c79d84b",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "To return or repeat, as sound; to echo."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cecc04d6-6119-4bf6-822c-d9e92828c77b",
                                                "sense_id": "c90a98d6-f863-3e98-b178-17c64c79d84b",
                                                "text": "a church with windows only from above[…] that reporteth the voice twelve or thirteen times"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f7acb2-83df-3575-95ae-aa631341a740",
                                        "entry_id": "7b0ab951-cf50-3c34-9796-5fb1e958750f",
                                        "glosses": [
                                            "Of a ship, to return to a port."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba481baa-c0d7-42db-906e-a5957ce91ca5",
                                                "sense_id": "95f7acb2-83df-3575-95ae-aa631341a740",
                                                "text": "Our ship leaves port on Monday and will re-port on Friday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "report",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8aa083-a100-3d44-9914-cf1bf33a2233",
                                        "entry_id": "ab7a8447-94a4-3623-af40-88457b061820",
                                        "glosses": [
                                            "A piece of information describing, or an account of certain events given or presented to someone, with the most common adpositions being by (referring to creator of the report) and on (referring to the subject)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a95c06-9f82-41d4-bf76-038ceeb22bd2",
                                                "sense_id": "4b8aa083-a100-3d44-9914-cf1bf33a2233",
                                                "text": "A report by the telecommunications ministry on the phone network revealed a severe capacity problem."
                                            },
                                            {
                                                "example_id": "281ec73c-fb71-4cf5-a317-86c68fe08b73",
                                                "sense_id": "4b8aa083-a100-3d44-9914-cf1bf33a2233",
                                                "text": "Hospitals are failing to care properly for the growing number of people with dementia, according to an NHS-funded report, which has prompted demands for big improvements to help patients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179ee655-459f-337d-b44a-6640696ae1cb",
                                        "entry_id": "ab7a8447-94a4-3623-af40-88457b061820",
                                        "glosses": [
                                            "Reputation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b2e5f8-13a9-4be3-ae9a-a73d3ad289a6",
                                                "sense_id": "179ee655-459f-337d-b44a-6640696ae1cb",
                                                "text": "I love thee in such sort / As, thou being mine, mine is thy good report."
                                            },
                                            {
                                                "example_id": "60a02296-f2c3-4e31-a9d6-afb7257a992e",
                                                "sense_id": "179ee655-459f-337d-b44a-6640696ae1cb",
                                                "text": "Certain it is that if he had been daft before, he now ran wild in his pranks, and an evil report of him was in every mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "784fdf77-3ec9-3a97-bd94-986051e90944",
                                        "entry_id": "ab7a8447-94a4-3623-af40-88457b061820",
                                        "glosses": [
                                            "The sharp, loud sound from a gun or explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85885c84-e8c2-44b8-932c-1055cd7ce0c0",
                                                "sense_id": "784fdf77-3ec9-3a97-bd94-986051e90944",
                                                "text": "While their masters, the mates, seemed afraid of the sound of the hinges of their own jaws, the harpooneers chewed their food with such a relish that there was a report to it."
                                            },
                                            {
                                                "example_id": "3a464948-5a71-4cb9-accf-60d7a36a0aee",
                                                "sense_id": "784fdf77-3ec9-3a97-bd94-986051e90944",
                                                "text": "[…] a pistol-shot, flash and report, came from the hedge-side."
                                            },
                                            {
                                                "example_id": "cdaba1f1-7f97-4779-a2c2-f9b6550fccfe",
                                                "sense_id": "784fdf77-3ec9-3a97-bd94-986051e90944",
                                                "text": "He knelt upon one knee, cocked the weapon, placed the muzzle against the man's forehead, and turning away his eyes pulled the trigger. There was no report. He had used his last cartridge for the horse."
                                            },
                                            {
                                                "example_id": "d2341d62-2815-4646-a6b1-a07070db1782",
                                                "sense_id": "784fdf77-3ec9-3a97-bd94-986051e90944",
                                                "text": "Waziri’s warriors marched at a rapid trot through the jungle in the direction of the village. For a few minutes, the sharp cracking of guns ahead warned them to haste, but finally the reports dwindled to an occasional shot, presently ceasing altogether."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29adcc4d-14b5-386c-867d-c58716f443e2",
                                        "entry_id": "ab7a8447-94a4-3623-af40-88457b061820",
                                        "glosses": [
                                            "An employee whose position in a corporate hierarchy is below that of a particular manager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295f8f66-1aef-48fd-89c4-9f4f0641f93d",
                                                "sense_id": "29adcc4d-14b5-386c-867d-c58716f443e2",
                                                "text": "The revelation that boss of one year Laurent Freixe was conducting an undisclosed affair with a direct report has rocked a 159-year-old conglomerate that pioneered infant formula and milk chocolate before growing to become the world's largest food and beverage company."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
