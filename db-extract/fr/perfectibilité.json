                        "sense_id": "ea617226-4bc9-3b16-a5dd-fd22dd643cc5",
                        "entry_id": "133327b2-40bd-3600-90cf-bd72f68db0d0",
                        "glosses": [
                            "Qualité de ce qui est perfectible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf08d26-e94d-4310-9190-fcc4267006f7",
                                "sense_id": "ea617226-4bc9-3b16-a5dd-fd22dd643cc5",
                                "text": "La perfectibilité des sciences humaines."
                            },
                            {
                                "example_id": "40720af8-721c-46c2-baf5-e35977edbc6c",
                                "sense_id": "ea617226-4bc9-3b16-a5dd-fd22dd643cc5",
                                "text": "Un de ces types purs comme il s’en trouve encore aux champs, types admirables et mystérieux, qui semblent faits pour un âge d’or qui n’existe pas, et où la perfectibilité serait inutile, puisqu’on aurait la perfection."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bf9bedf-2e3b-4918-ab9e-b14b0e8670a8",
                        "source_entry_id": "133327b2-40bd-3600-90cf-bd72f68db0d0",
                        "source_sense_id": "ea617226-4bc9-3b16-a5dd-fd22dd643cc5",
                        "target_lang_word": "Perfektibilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perfektibilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4192db32-4031-3c92-8594-add0dfd189a3",
                                        "entry_id": "3dc0f1e8-5ea8-345b-bf3a-f5708d565645",
                                        "glosses": [
                                            "Eigenschaft, vervollkommnungsfähig (perfektibel) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6399a89e-6823-4a3d-b198-48d33c322e44",
                                                "sense_id": "4192db32-4031-3c92-8594-add0dfd189a3",
                                                "text": "„Rousseaus Begriff der Perfektibilität wurde oft als die Fähigkeit verstanden, mit der sich der Mensch ‚vervollkommnen‘, sich ‚perfektionieren‘ könne: Perfektibilität wurde mit dem Begriff der Vervollkommnungsfähigkeit übersetzt. Zeitgenossen wie Christoph Martin Wieland (1733–1813) oder Moses Mendelssohn (1729–1786) deuteten diese Fähigkeit im Sinne des aristotelischen Prinzips der Entelechie (von griech. en: in, telos: Ziel, Zweck).“"
                                            },
                                            {
                                                "example_id": "b9be716f-c99b-4b78-ad68-e9200a0a0b27",
                                                "sense_id": "4192db32-4031-3c92-8594-add0dfd189a3",
                                                "text": "„Mit ‚Perfektibilitätsnarrativ‘ wird in diesem Kapitel eine Textformation bezeichnet, in der das Paradigma der Perfektibilität nicht nur bezüglich der in den Romanen entworfenen Entwicklungsvorstellungen eine wichtige Rolle spielt, sondern auch in direktem Bezug zu den Möglichkeitsbedingungen der dargestellten Weiblichkeitsentwürfe steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
