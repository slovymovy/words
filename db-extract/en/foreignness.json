                        "sense_id": "1d8e8b50-70c7-310e-8a0e-6a59fca4282b",
                        "entry_id": "9fff3832-850b-3eb0-84bc-df938746a200",
                        "glosses": [
                            "A characteristic that indicates foreignness."
                        ],
