                "senses": [
                    {
                        "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                        "entry_id": "e65cbbb6-f872-3479-8563-e9c08684ddb8",
                        "glosses": [
                            "Auswirkung, Resultat eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b24594-6fc4-4e03-8acf-7c8036d59c50",
                                "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                                "text": "„Der Spieleffekt lässt sich nur erzielen, solange das Spiel dem Opfer unbekannt ist.“"
                            },
                            {
                                "example_id": "2dd0ff26-c37e-4647-b9a4-d955d261da42",
                                "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                                "text": "„Dementsprechend stehen bei dem folgenden Systematisierungsversuch die Spielfunktion (Zielstruktur) und der Spieleffekt (Wirkungserwartung) als Hinweis auf Fördermöglichkeiten im Vordergrund.“"
                            },
                            {
                                "example_id": "76fbc0e1-f878-4550-8cc2-4154fff313ab",
                                "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                                "text": "„Unter anderem gehe es darum, die Lern- und Spieleffekte des Elementes Wasser zu nutzen.“"
                            },
                            {
                                "example_id": "ec087e5e-a49f-4a39-a0ff-b2ee40017b67",
                                "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                                "text": "„Der Spieleffekt ist bei einem Konvolut mit diesem Umfang von geradezu therapeutischer Wirkung.“"
                            },
                            {
                                "example_id": "188e4df1-15b0-4bdb-a9b1-069302ad023e",
                                "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                                "text": "„‚Ab ins Auto’ heißt es bei dem gleichnamigen Kullerbü-Themenset von HABA, das Kinder mit einem tollen Spieleffekt begeistert.“"
                            },
                            {
                                "example_id": "5129b774-36aa-4f50-a03a-827940b73d43",
                                "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                                "text": "„Die Spielinseln bieten vom Spieleffekt alles, was ein Krippenkind braucht.“"
                            },
                            {
                                "example_id": "2b7b14e1-bdb5-4577-8fd3-44c8154f29a6",
                                "sense_id": "006d07a0-cc0a-33e8-911e-79cc90d05865",
                                "text": "„Jeder Gefährte aktiviert einen individuellen Spieleffekt, sobald er in die Schlacht gerufen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
