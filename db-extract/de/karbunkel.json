                "senses": [
                    {
                        "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                        "entry_id": "6bbeef62-0d01-39cb-8006-fe9f40bd5c50",
                        "glosses": [
                            "großes, tief liegendes Geschwür, das aus mehreren nebeneinanderliegenden Furunkeln besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb58cece-4efc-4337-a8b5-954a55ccb26d",
                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                "text": "Furunkel und Karbunkel treten gehäuft bei Diabetes auf und können ein Hinweis auf diese Erkrankung sein."
                            },
                            {
                                "example_id": "45b249c8-5239-4eb6-9ff4-a532cd23d836",
                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                "text": "Ein Karbunkel im Nacken wächst sich im Lauf der Erzählungen zu einer napfgroßen Geschwulst aus."
                            },
                            {
                                "example_id": "dc3f188b-db20-498f-90bf-8a97d4606108",
                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                "text": "\"Gestern lag ich wieder brach, da ein bösartiger Hund von Karbunkel an linker Lende ausgebrochen\", berichtete Karl Marx seinem Vertrauten Friedrich Engels am 13. Februar 1866 aus dem Londoner Exil."
                            },
                            {
                                "example_id": "6c68e27e-311a-4d86-a7b3-14e7c1968f7a",
                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                "text": "„Ich sah dabei, daß er einen fast verheilten Karbunkel im Nacken hatte mit einem Pflaster darüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48edb6d9-39e3-4734-bc85-34b2daff542a",
                        "source_entry_id": "6bbeef62-0d01-39cb-8006-fe9f40bd5c50",
                        "source_sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                        "source_sense_description": "Medizin: großes, tief liegendes Geschwür, das aus mehreren nebeneinanderliegenden Furunkeln besteht",
                        "target_lang_word": "carbuncle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbuncle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "A deep-red or fiery colored garnet or other dark red precious stone, especially when cut cabochon."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40970a0-fe51-487c-8095-bffde98c8951",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "With eyes like carbuncles, the hellish Pyrrhus […]"
                                            },
                                            {
                                                "example_id": "69ce4e3e-8954-4807-b0af-6089966857dc",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "And I will make thy windows of agates, and thy gates of carbuncles, and all thy borders of pleasant stones."
                                            },
                                            {
                                                "example_id": "811a9f14-66c1-4d4e-8074-6afc6ad5723a",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "His turban, or mandil [mandīl], was of finest white silk interwoven with gold, bestudded with pearl[s] and carbuncles; […]"
                                            },
                                            {
                                                "example_id": "4ce25388-4ee8-443d-9faa-cc48f87a3f7b",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "A piece of marigold or bay leaf was imbedded in the metal, and over it a carbuncle or chrysolite was placed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52aec426-78b2-3677-a6b6-4b4739830dd4",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "A charge or bearing supposed to represent the precious stone, with eight sceptres or staves radiating from a common centre; an escarbuncle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d25045c8-bce7-3dd1-9328-88e02afc131f",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "An abscess larger than a boil, usually with one or more openings draining pus onto the skin. It is usually caused by staphylococcal infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce63526-7272-3c66-b28e-189d34de7a68",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "An unpopular or ugly building; an eyesore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e01d37fc-fa4f-4a66-8ee1-44ac8ab70bbe",
                        "source_entry_id": "6bbeef62-0d01-39cb-8006-fe9f40bd5c50",
                        "source_sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                        "source_sense_description": "Medizin: großes, tief liegendes Geschwür, das aus mehreren nebeneinanderliegenden Furunkeln besteht",
                        "target_lang_word": "karbonkel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karbonkel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "070d5b22-ad65-3741-ab0a-28daa2998564",
                                        "entry_id": "d804b180-b03f-3ed3-bdfd-c6cb4dfacf96",
                                        "glosses": [
                                            "ernstige huidinfectie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62670691-92a9-4733-a8fe-68c78426e6f6",
                                                "sense_id": "070d5b22-ad65-3741-ab0a-28daa2998564",
                                                "text": "Joop Zoetemelk spreidde ooit zijn dijen op een hotelkamer opdat het vaderlands journaille de karbonkel met eigen ogen kon aanschouwen - en bezingen. Tom zou zoiets nooit doen. Hij zou het een weinig smaakvolle exhibitie vinden. Het zitvlak van de coureur is overigens een weelderig en nog lang niet uitgespit onderzoeksgebied - ik spreek uit ervaring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cdf8505-d8c1-3fc9-b091-0f97ff06006d",
                                        "entry_id": "d804b180-b03f-3ed3-bdfd-c6cb4dfacf96",
                                        "glosses": [
                                            "robijnachtige edelsteen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18db5ccc-fa40-43c5-94ab-e4e1be78aa11",
                                                "sense_id": "3cdf8505-d8c1-3fc9-b091-0f97ff06006d",
                                                "text": "Wat voor de Angolees Mauro Manuel niet kon, was geen probleem voor de Braziliaan Douglas. Terwijl ze toch allebei voetballers zijn, zij het niet op hetzelfde niveau. En de bal is rond voor iedereen. Hun ogen als karbonkels zijn ook perfect inwisselbaar. Maar kennelijk wordt het soortelijke gewicht voor de samenleving van een snoeiharde libero hoger aangeslagen dan dat van een lieve, dromerige jongen die met twee woorden spreekt en zijn best doet op school."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
