                        "glosses": [
                            "Restaurant, das sich auf dem Gelände eines Flughafens befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1357ea6b-dcc2-4dc1-b4cc-c15df53047f2",
                                "sense_id": "71c4900c-91b3-37c2-b454-1a7e73a8dd79",
                                "text": "„Das Airbräu Brauhaus schaffte es laut der amerikanischen Internetseite \"The Daily Meal\" als einziges deutsches Flughafenlokal in die Liste der 20 weltweit besten Flughafenrestaurants.“"
                            },
                            {
                                "example_id": "1072842f-c572-481f-929c-4152d923d676",
                                "sense_id": "71c4900c-91b3-37c2-b454-1a7e73a8dd79",
                                "text": "„Ein alter Mann ging durch das Flughafenrestaurant und versuchte, Trachtenpuppen zu verkaufen, große Puppen, kleine Puppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
