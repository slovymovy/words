                        "glosses": [
                            "Culture inspirée de la cryptozoologie et des cryptides, s’étendant au folklore, légendes urbaines et théories conspirationnistes."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
