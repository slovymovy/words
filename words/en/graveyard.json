{
    "word_family": [
        "grave"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "604cd85c-8128-380e-a40e-58b8cfaee673",
                    "sense_definition": "A piece of land where dead people are buried.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "burial_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>graveyard</w> is located behind the village church.",
                            "target_lang_translations": {
                                "zh": "那座古老的<w>墓地</w>位于村庄教堂的后面。"
                            }
                        },
                        {
                            "text": "They walked through the quiet burial ground to visit the family <w>graveyard</w>.",
                            "target_lang_translations": {
                                "zh": "他们穿过安静的埋葬地，去探访家族<w>墓地</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "burial ground",
                        "cemetery",
                        "churchyard"
                    ],
                    "common_phrases": [
                        "old graveyard",
                        "visit graveyard"
                    ],
                    "target_lang_definitions": {
                        "zh": "埋葬死者的一块土地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "墓地",
                                "target_lang_sense_clarification": "指埋葬死者的场所，最通用的词。"
                            },
                            {
                                "target_lang_word": "坟场",
                                "target_lang_sense_clarification": "指埋葬死者的场所，口语中常用。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4038c5bd-16c0-3ba0-a4fd-44aecbdd12d0",
                    "sense_definition": "A time very early in the morning when most people are asleep.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works the <w>graveyard</w> shift at the factory.",
                            "target_lang_translations": {
                                "zh": "他在工厂上<w>深夜</w>班。"
                            }
                        },
                        {
                            "text": "Working during the <w>graveyard</w> hours is very difficult for your health.",
                            "target_lang_translations": {
                                "zh": "在<w>深夜</w>时段工作对你的健康非常不利。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "graveyard shift",
                        "graveyard slot"
                    ],
                    "target_lang_definitions": {
                        "zh": "指深夜或凌晨大多数人熟睡的时间段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "深夜",
                                "target_lang_sense_clarification": "指深夜时段。"
                            },
                            {
                                "target_lang_word": "凌晨",
                                "target_lang_sense_clarification": "指深夜至清晨的时间段。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4263c241-734d-31c6-b7d7-04c440edd569",
                    "sense_definition": "A place where discarded or useless items are collected.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player moved his defeated cards to the <w>graveyard</w> pile.",
                            "target_lang_translations": {
                                "zh": "玩家将他被击败的卡牌移到了<w>废弃场</w>。"
                            }
                        },
                        {
                            "text": "Old computers often end up in a digital <w>graveyard</w>.",
                            "target_lang_translations": {
                                "zh": "旧电脑最终往往会被扔进数字<w>废弃场</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "存放废弃或无用物品的地方。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "废弃场",
                                "target_lang_sense_clarification": "指存放废弃物的地方。"
                            },
                            {
                                "target_lang_word": "堆放处",
                                "target_lang_sense_clarification": "指存放无用物品的区域。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}