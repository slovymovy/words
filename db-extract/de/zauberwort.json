                                            {
                                                "example_id": "5cb0e627-1cc6-4757-9af3-6b91b92c4f52",
                                                "sense_id": "651aa978-d198-3ff3-bb2d-a79ce343b875",
                                                "text": "Il y a des mots magiques. Juge, c’est un mot magique. Comme Dieu, comme mort, comme enfant, et quelques autres encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e4ffd50-bb96-3fe7-8118-5ae6acc5e22e",
                                        "entry_id": "bb76307c-f7e3-330e-8b9e-c1d147df1ec4",
