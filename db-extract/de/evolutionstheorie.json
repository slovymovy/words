                        ],
                        "form": "die Evolutionstheorien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e06eac6f-241d-37f4-b46d-848438828073",
                        "entry_id": "7d843e14-6d6f-32b8-b0dc-ad79206d64b2",
                        "glosses": [
                            "wissenschaftliche Theorie zu Ursprung, Entwicklung und Vielfalt des Lebens auf der Erde"
                        ],
                        "tags": [
                            "Naturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "c6a5c850-4dc6-49c9-bdd3-2f491bf9a22f",
                                "sense_id": "e06eac6f-241d-37f4-b46d-848438828073",
                                "text": "Die Evolutionstheorie vermittelt uns eine Vorstellung davon, wie das Leben auf der Erde sich entwickelt haben kann."
                            },
                            {
                                "example_id": "3b3ccfa7-438b-4ecb-af6f-185a2b9d423c",
                                "sense_id": "e06eac6f-241d-37f4-b46d-848438828073",
                                "text": "„Erst als mit dem Erscheinen von Charles Darwins Werk „On the Origin of Species“ ein viel umfassenderes Beweismaterial […] beigebracht wurde, setzte sich die Evolutionstheorie in den biologischen Wissenschaften durch.“"
                            },
                            {
                                "example_id": "d5242ac6-a8af-4e3f-9f77-8715f215b020",
                                "sense_id": "e06eac6f-241d-37f4-b46d-848438828073",
                                "text": "„Es war die Evolutionstheorie, die all diese religiösen Mystifikationen zu eliminieren begonnen hatte.“"
                            },
                            {
                                "example_id": "a17a7cb1-0d1b-4592-8fca-1febf2b46a42",
                                "sense_id": "e06eac6f-241d-37f4-b46d-848438828073",
                                "text": "Erst Anfang des Jahres hatte der türkische Vize-Regierungschef Kurtulmus Zweifel an der Evolutionstheorie geäußert und sie als veraltet bezeichnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
