                        "source_sense_id": "764825f6-cd14-3bc0-8f15-8824987605f0",
                        "target_lang_word": "recoil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46a28e3c-2f99-321d-bb99-9b3e25dbe0cd",
                                        "entry_id": "848d645e-72a5-3b17-9880-57b5a840a85d",
                                        "glosses": [
                                            "A starting or falling back; a rebound; a shrinking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f41fa36-b928-4360-834c-3daef494e498",
                                                "sense_id": "46a28e3c-2f99-321d-bb99-9b3e25dbe0cd",
                                                "text": "the recoil of nature, or of the blood"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f44c99-5c81-3ae9-8f20-5e092e68f001",
                                        "entry_id": "848d645e-72a5-3b17-9880-57b5a840a85d",
                                        "glosses": [
                                            "The state or condition of having recoiled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad13a9ab-352f-4b83-b689-9ea7b23622f3",
                                                "sense_id": "86f44c99-5c81-3ae9-8f20-5e092e68f001",
                                                "text": "The recoil from formalism is skepticism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb08a4e-13b7-3cf4-9778-65f232330fc5",
                                        "entry_id": "848d645e-72a5-3b17-9880-57b5a840a85d",
                                        "glosses": [
                                            "The energy transmitted back to the shooter from a firearm which has fired. Recoil is a function of the weight of the weapon, the weight of the projectile, and the speed at which it leaves the muzzle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e168599-c287-323b-8b1a-22c6e1d72657",
                                        "entry_id": "848d645e-72a5-3b17-9880-57b5a840a85d",
                                        "glosses": [
                                            "An escapement in which, after each beat, the scape-wheel recoils slightly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "recoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78c737bc-9d0f-3efe-8452-ea2203556d37",
                                        "entry_id": "9bb740fd-b8ee-3d34-9a50-510edbcee42d",
                                        "glosses": [
                                            "To pull back, especially in disgust, horror or astonishment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a960366-8893-4631-8578-eed57eabdd9d",
                                                "sense_id": "78c737bc-9d0f-3efe-8452-ea2203556d37",
                                                "text": "He recoiled in disgust when he saw the mess."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e9c4d5-f362-3ed3-b6cc-0d5cb2c43a90",
                                        "entry_id": "9bb740fd-b8ee-3d34-9a50-510edbcee42d",
                                        "glosses": [
                                            "To recoil before an opponent."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5c23cca-2c29-4384-8d51-eddaa494d95f",
                                                "sense_id": "d7e9c4d5-f362-3ed3-b6cc-0d5cb2c43a90",
                                                "text": "that rude rout […] forced them, how ever strong and stout / They were, as well approv'd in many a doubt, / Backe to recule […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5497016a-cfe5-385a-98e2-52b98ef2ed0b",
                                        "entry_id": "9bb740fd-b8ee-3d34-9a50-510edbcee42d",
                                        "glosses": [
                                            "Of a firearm: to quickly push back when fired."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                                        "entry_id": "9bb740fd-b8ee-3d34-9a50-510edbcee42d",
                                        "glosses": [
                                            "To retire, withdraw."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec05e93-9bc0-4cb8-aa2b-05164a966be5",
                                                "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                                                "text": "Ye both forwearied be: therefore a whyle / Iread you rest, and to your bowres recoyle."
                                            },
                                            {
                                                "example_id": "12416bab-aa9f-466f-9846-cb4aa34b15ae",
                                                "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                                                "text": "Thus vvhen this Courtly Gentleman vvith toyle / Himſelfe hath vvearied, he doth recoyle / Vnto his reſt, and there vvith ſvveete delight / Of Muſicks skill reuiues his toyled ſpright, […]"
                                            },
                                            {
                                                "example_id": "c0d44b52-bc32-4637-9749-daad5ed88b06",
                                                "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                                                "text": "Her will, recoiling to her better judgement"
                                            },
                                            {
                                                "example_id": "64eb4c99-6546-4be5-965f-8afd5332d22e",
                                                "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                                                "text": "Evil on itself shall back recoil.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "13b06bba-286c-467a-a51f-f07e76edc4c4",
                                                "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                                                "text": "Manners knovvs diſtance, and a man unrude / VVo'd ſoon recoile, and not intrude / His Stomach to a ſecond Meale."
                                            },
                                            {
                                                "example_id": "d06d3578-79f9-4016-bf5a-efa309e1dc94",
                                                "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                                                "text": "The solemnity of her demeanor made it impossible […] that we should recoil into our ordinary spirits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
