                "senses": [
                    {
                        "sense_id": "b94c17ba-f5ee-3c4f-9784-48d11c0db85b",
                        "entry_id": "966d9417-b4bd-3469-95e1-1da03bda7094",
                        "glosses": [
                            "extrem großes Insekt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "39aa1e13-3fbb-487e-a439-39edc978bc23",
                                "sense_id": "b94c17ba-f5ee-3c4f-9784-48d11c0db85b",
                                "text": "„Sie durchquerten einen großen, ausgetrockneten See; die dahinter aneinandergereihten toten Vulkane ragten wie Bauten von Rieseninsekten in die Höhe.“"
                            },
                            {
                                "example_id": "1fb6cd81-30e1-4642-a6ed-ab072730e45f",
                                "sense_id": "b94c17ba-f5ee-3c4f-9784-48d11c0db85b",
                                "text": "„Außerdem war das Netz viel zu grobmaschig, als dass sich etwas anderes als ein mutiertes Rieseninsekt darin hätte verfangen können.“"
                            },
                            {
                                "example_id": "68cff16c-7177-45c7-8bf7-859689d86a46",
                                "sense_id": "b94c17ba-f5ee-3c4f-9784-48d11c0db85b",
                                "text": "„Das Geräusch war schrill und nervenzerfetzend wie das Summen eines Rieseninsekts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
