                "senses": [
                    {
                        "sense_id": "bd65c665-3461-3b3e-96d7-10731eb74a5e",
                        "entry_id": "1199efdd-0f58-3fab-93db-0eba291b025f",
                        "glosses": [
                            "een van te voren klaargemaakte map met documenten voor de pers waarmee voorlichters van een organisatie de pers kunnen informeren over die organisatie (op een manier die gunstig is voor die organisatie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7ea0f9a-109f-476a-8ed4-7bdc28e34ec7",
                                "sense_id": "bd65c665-3461-3b3e-96d7-10731eb74a5e",
                                "text": "Dat een zender zichzelf tegen het licht houdt is op zich een goede zaak, maar het is te hopen dat die oefening meer oplevert dan wat de persmap van Canvas eergisteren beloofde."
                            },
                            {
                                "example_id": "473f3d6f-7d6d-4282-aa7c-dc3086968d71",
                                "sense_id": "bd65c665-3461-3b3e-96d7-10731eb74a5e",
                                "text": "‘Gênante humor’, ‘feelgood’, ‘uit het leven gegrepen’: neen, dit komt niet uit de persmap van Thuis, maar uit die van deze nieuwe serie, met onder meer Stan Van Samang. Een gescheiden moeder beleeft uit het leven gegrepen dingen, gênante humor drijft het verhaal voort."
                            }
                        ]
                    }
