                "senses": [
                    {
                        "sense_id": "4ec4a6cc-cc44-3916-a1ab-7e7641e6e7d5",
                        "entry_id": "2601d36c-64f9-38d9-99a8-34bda1ce97a3",
                        "glosses": [
                            "The tree Adina cordifolia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b17bcd2-771f-4034-9167-f13146ec1a3a",
                                "sense_id": "4ec4a6cc-cc44-3916-a1ab-7e7641e6e7d5",
                                "text": "So Prince Earth-worm secured Prince Tortoies with chains and raised the earth on his back, and in a short time there was an island in the midst of the waters. Thakur Jiu then caused a karam tree to spring up, and at the foot of the karam tree he caused sirom grass to grow. He then caused dhobi grass to spring up, after which he covered the earth with all kinds of trees and herbs. In this manner the earth became firm and stable."
                            },
                            {
                                "example_id": "e4ccfedd-060e-457f-8897-1784f5163de7",
                                "sense_id": "4ec4a6cc-cc44-3916-a1ab-7e7641e6e7d5",
                                "text": "The bride is given a comb made locally of karam wood, bracelets, chawar, which is a braid of false hair, and a blouse"
                            }
                        ]
                    }
                ],
