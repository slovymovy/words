                        "glosses": [
                            "The state or condition of being a laird."
                        ],
                        "tags": [
                            "Scotland",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8dddc51f-f2bc-4bc2-b45b-3562943dcff4",
                                "sense_id": "73858cba-b563-37f6-b108-ebc66cbc631f",
                                "text": "He would as soon have thought of wearing a white linen shirt or having the lairdship of a barony, as of getting ham to his breakfast."
                            },
                            {
                                "example_id": "d0926d28-4aa3-4ff7-a930-6acff7cc2606",
                                "sense_id": "73858cba-b563-37f6-b108-ebc66cbc631f",
                                "text": "II. I whyles claw the elbow o' troublesome thought; But man is a sodger, and life is a faught: My mirth and guid humour are coin in my pouch, And my freedom's my lairdship nae monarch dare touch."
                            },
                            {
                                "example_id": "099c355a-6bd7-4a85-92aa-bd57e0182e11",
                                "sense_id": "73858cba-b563-37f6-b108-ebc66cbc631f",
                                "text": "They talked of affairs, particular and general, of Ian's late proceedings and the lairdship of Alexander, of men and places that they knew away from this countryside."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5d5ba44-dc8e-3ead-9ce0-8c9ca3212478",
                        "entry_id": "1d68a8a4-8f35-3d8c-b41d-1346970a1a06",
                        "glosses": [
                            "The area of land owned by a laird."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a99bdc6c-48f4-40b1-9d78-635e9d36ad86",
                                "sense_id": "e5d5ba44-dc8e-3ead-9ce0-8c9ca3212478",
                                "text": "'Laird,' said she (for so she always called him, though his lairdship was of the smallest), 'will ye tell them to bury me whaur I'll lie across at your feet?'"
                            }
                        ]
                    }
