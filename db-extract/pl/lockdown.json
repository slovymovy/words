                "senses": [
                    {
                        "sense_id": "025870fe-6e08-3e97-9dfd-0bf68bf8b822",
                        "entry_id": "1246302d-2608-35dc-8a45-63ae8f3a1b07",
                        "glosses": [
                            "zakaz wyjścia, zakaz opuszczania danej strefy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b80fab25-eabe-4c59-bff4-dd47729747fa",
                                "sense_id": "025870fe-6e08-3e97-9dfd-0bf68bf8b822",
                                "text": "Pomimo utrzymującej się w ostatnich dniach wyższej liczby zakażeń rząd nie planuje przywracać lockdownu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d72f9b0d-7323-4fa0-8c07-15d3393d59b8",
                        "source_entry_id": "1246302d-2608-35dc-8a45-63ae8f3a1b07",
                        "source_sense_id": "025870fe-6e08-3e97-9dfd-0bf68bf8b822",
                        "target_lang_word": "lockdown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lockdown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b489b0-c8b9-31c9-a985-cf85f4c0eda1",
                                        "entry_id": "94665b2f-2220-3215-919b-707ac33770c8",
                                        "glosses": [
                                            "The confinement of people in their own rooms (e.g., in a school) or cells (in a prison), or to their own homes or areas (e.g., in the case of a city- or nation-wide issue) as a security measure after or amid a disturbance or as a non-pharmaceutical intervention in a pandemic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bbebc01-448b-46de-b840-444dd9ec59f6",
                                                "sense_id": "f9b489b0-c8b9-31c9-a985-cf85f4c0eda1",
                                                "text": "At the time of writing, no decisions had been made by the Government as to when or how lockdown restrictions might begin to be lifted. However, discussions were taking place in the industry about how social distancing could be maintained on the railway if some patronage were to return soon."
                                            },
                                            {
                                                "example_id": "dd3d6239-53b6-4e4e-a3f1-1a2727761c62",
                                                "sense_id": "f9b489b0-c8b9-31c9-a985-cf85f4c0eda1",
                                                "text": "Fans relished the traditional FA Cup fanfare from the Coldstream Guards and the hymn Abide With Me before throwing themselves wholeheartedly into an experience they have been largely deprived of since the first coronavirus lockdown began in March 2020."
                                            },
                                            {
                                                "example_id": "622f9e60-dd67-44fe-ace3-8527f6f08389",
                                                "sense_id": "f9b489b0-c8b9-31c9-a985-cf85f4c0eda1",
                                                "text": "When a column of smoke appeared on Thursday over the Sitong Bridge overpass in the Haidian district of Beijing, it drew attention to a protester who had hung banners openly bashing China’s top leader by name and criticizing the country’s “zero Covid” policy, including one calling for “freedom and not lockdowns.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57030f70-8441-3853-8038-be9617e4019d",
                                        "entry_id": "94665b2f-2220-3215-919b-707ac33770c8",
                                        "glosses": [
                                            "A contrivance to fasten logs together in rafting."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fefa6181-050f-4814-b154-201cd4870392",
                                                "sense_id": "57030f70-8441-3853-8038-be9617e4019d",
                                                "text": "The rafts were made up of strings of logs about seventeen feet wide, held together by poles across them. Each log was pinned to the poles by wooden pegs and lockdowns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b621675b-524e-4799-be7f-38a10b8152c7",
                        "source_entry_id": "1246302d-2608-35dc-8a45-63ae8f3a1b07",
                        "source_sense_id": "025870fe-6e08-3e97-9dfd-0bf68bf8b822",
                        "target_lang_word": "Lockdown",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lockdown",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                        "entry_id": "a1900a48-809f-363a-8a36-60716ad99e06",
                                        "glosses": [
                                            "(während eines Amoklaufs, eines terroristischen Anschlags oder dergleichen) aus Sicherheitsgründen verhängte vollständige Abriegelung eines Gebäudes, Gebäudekomplexes beziehungsweise eines bestimmten bewohnten oder von Menschen frequentierten Areals (die zumeist mit der Verbarrikadierung der sich in dem oder den Gebäuden beziehungsweise auf dem Areal befindlichen Personen sowie mit der Ausgangssperre aller Anwohner der umliegenden Gebäude innerhalb einer gesteckten Sicherheitszone einhergeht)"
                                        ],
                                        "tags": [
                                            "zumeist mit Bezug auf nordamerikanische Verhältnisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e36e51-1c57-4136-a99a-c0a640e26d74",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Zwei Tage vor dem heutigen so genannten Lockdown, wo alle Sportstätten von den Sicherheitskräften abgeriegelt werden, wurde auf dem Bahnhof in Sydney Bombenalarm ausgelöst.“"
                                            },
                                            {
                                                "example_id": "d1945d7b-a260-4195-be63-243f71b3ba44",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Bei uns war am Freitagvormittag plötzlich Lockdown.“"
                                            },
                                            {
                                                "example_id": "940bd107-e202-4a10-b015-7349c3d42f07",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Der Lockdown wurde an der Sandy-Hook-Volksschule und dem angrenzenden Kindergarten regelmäßig geübt.“"
                                            },
                                            {
                                                "example_id": "2822922b-e86d-49f2-a1dd-2da44301152a",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Denn obwohl am Tag des Amoklaufs alle Schulen und Kindergärten in Santa Monica auf ‚Lockdown‘ (also fest abgeriegelt) waren und man uns Eltern über E-Mail benachrichtigte, dass niemand Unbefugter den Kindergarten betreten könne, hatte eine der Kindergärtnerinnen vergessen abzuschließen. Das hatte Konsequenzen für die Verantwortliche, denn ein ‚Lockdown‘ wird sehr ernst genommen und zwei Mal im Jahr realistisch trainiert.[…]‚Lockdowns‘ sind keine Lösung. Die einzig richtige Antwort auf Gewaltexzesse sind strenge Waffen- und Munitionsgesetze.“"
                                            },
                                            {
                                                "example_id": "1b3fe637-2747-4741-b221-6c8a58598215",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Nachdem der Lockdown aufgehoben wurde, kommen Abgeordnete und Senatoren aus den Gebäuden,[…].“"
                                            },
                                            {
                                                "example_id": "34cd8882-f609-472d-aa9c-f216097427a3",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Der Militärstützpunkt war unmittelbar nach der Tat im ‚Lockdown‘, einer Notstandssituation.“"
                                            },
                                            {
                                                "example_id": "cfa5ce3a-97af-4082-9db0-9ec968263e00",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Weitere Schüler und Lehrer verschanzten sich aus Angst vor den Schüssen in ihren Klassenzimmern, nachdem ein so genannter Lockdown (Verriegelung der Räume) angeordnet worden war.“"
                                            },
                                            {
                                                "example_id": "b6d18504-ee26-49c3-abee-9f4f7bc5a830",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„Abgeordnete, Mitarbeiter, Journalisten verbarrikadieren sich, das Gebäude steht jetzt unter ‚Lockdown‘: Keiner kommt rein, keiner kommt raus.“"
                                            },
                                            {
                                                "example_id": "0d26e5d6-d0a1-4bdc-9bda-9009001fee6a",
                                                "sense_id": "61ad091c-c506-3528-b3db-aaa69d8ae8d6",
                                                "text": "„China hat Probleme zu liefern, auch wegen der Lockdowns ganzer Städte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                        "entry_id": "a1900a48-809f-363a-8a36-60716ad99e06",
                                        "glosses": [
                                            "Form des Unterbindens von Kontakten zwischen Menschen, um ein Ansteckungsrisiko zu minimieren; zum Beispiel, indem Bezirke abgeriegelt werden oder Ausgangssperren bis hin zur Massenquarantäne verhängt werden"
                                        ],
                                        "tags": [
                                            "mit Bezug auf eine Ansteckungsgefahr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9157a77-4205-4ec0-98ec-fa4f10f92aa1",
                                                "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                                "text": "„Laut Urs Schmid seien die ersten 2.5 Tag des Lockdowns im Kanton Solothurn gut verlaufen.“"
                                            },
                                            {
                                                "example_id": "65bbacfb-75ba-4d37-8141-c83d52a92128",
                                                "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                                "text": "„‚Ich bin kein Freund des Lockdowns. Wer so etwas verhängt, muss auch sagen, wann und wie er es wieder aufhebt‘, sagte Montgomery. Die SPD-Europapolitikerin Katarina Barley sagte, Ausgangssperren sollten das letzte Mittel sein.“"
                                            },
                                            {
                                                "example_id": "1e7c41c4-2b9a-4976-baf6-8fae7b9fe55b",
                                                "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                                "text": "„Und dann wären wir eben bei einem richtigen gesellschaftlichen Lockdown, so wie in China passiert.“"
                                            },
                                            {
                                                "example_id": "1b585c35-184b-4fe3-a3ee-955fe4e39677",
                                                "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                                "text": "„In China haben die Lockdowns gezeigt, dass die Ausbreitung des Virus verlangsamt und sogar gestoppt werden kann.“"
                                            },
                                            {
                                                "example_id": "50194431-ced7-4891-93ea-754f52a56d0f",
                                                "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                                "text": "„‚Deutschland braucht eine Vollbremsung, einen Lockdown, mindestens so, wie ihn Italien jetzt hat‘, forderte Stephan Ortner, Direktor des Forschungsinstituts Eurac Research in Bozen in Südtirol.“"
                                            },
                                            {
                                                "example_id": "71ed45cd-6af4-483b-b041-0d0a18ca2218",
                                                "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                                "text": "„Andere fragwürdige Studien und Interviews mit Scheinexperten behaupten, dass es keinen Lockdown brauchte oder dass das neue, unbekannte Virus weit weniger gefährlich sei als behauptet.“"
                                            },
                                            {
                                                "example_id": "2199c9cb-f904-4e15-9d39-138278a15cc5",
                                                "sense_id": "c1425433-df4d-321f-a896-b552206cbe34",
                                                "text": "[…] „wie schon der erste Lockdown, so wirft auch der zweite wieder ein Schlaglicht auf eines der gravierendsten Defizite der deutschen Politik: die digitale Bildung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
