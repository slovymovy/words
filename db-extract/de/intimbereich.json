                "senses": [
                    {
                        "sense_id": "b59e1f5f-efe5-38e9-8439-3f56b7749802",
                        "entry_id": "8fe0a6a6-998d-3199-a3fa-1aec9f80fa12",
                        "glosses": [
                            "Körperzone in der Nähe der äußeren Geschlechtsorgane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a12dfff-d06f-43be-865f-dfa6e6b928bf",
                                "sense_id": "b59e1f5f-efe5-38e9-8439-3f56b7749802",
                                "text": "Sportler schützen ihren Intimbereich zum Beispiel durch Suspensorien."
                            },
                            {
                                "example_id": "4f5278e9-c8ab-4c58-8a0f-05d7e2d9061f",
                                "sense_id": "b59e1f5f-efe5-38e9-8439-3f56b7749802",
                                "text": "„Ich wurde an die Kante des Stuhles geschoben, die Knie wurden mir auseinandergedrückt und mein, wie es so anschaulich heißt, Intimbereich eingeschäumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b3b5519-8d7f-3638-9980-704985c42b61",
                        "entry_id": "8fe0a6a6-998d-3199-a3fa-1aec9f80fa12",
                        "glosses": [
                            "Ort, Gedanken oder Gefühle, die besonders privat sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "717348f6-6d8e-48da-ae6b-e5409f265966",
                                "sense_id": "3b3b5519-8d7f-3638-9980-704985c42b61",
                                "text": "Als die Einbrecher meine Schränke durchwühlten, drangen sie dadurch in meinen Intimbereich ein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
