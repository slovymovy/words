                                        "entry_id": "bfb4b8d3-2cc0-3af1-9716-adb4e9677dff",
                                        "glosses": [
                                            "rettile erbivoro estinto degli Ornitischi, originario del Giurassico, lungo più di sei metri, con doppia cresta vertebrale di grosse placche ossee a forma di astuccio corneo e coda terminante con quattro lunghe punte ossee"
                                        ],
                                        "tags": [],
