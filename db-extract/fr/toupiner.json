                ],
                "senses": [
                    {
                        "sense_id": "6fd4b6e3-7683-383a-9a30-3fecba56d663",
                        "entry_id": "bd8013b1-0727-3ba4-b6fb-c7cc92481070",
                        "glosses": [
                            "Tourner sur place comme une toupie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "844b8e36-a555-4a71-9e5d-5c51fc3fde07",
                                "sense_id": "6fd4b6e3-7683-383a-9a30-3fecba56d663",
                                "text": "Vers la fin de la danse, elle commença de toupiner, lentement d'abord, puis de plus en plus vite, d’abord au mitan de la salle, puis en grand cercle, à la manière d’un toton près de choir."
                            },
                            {
                                "example_id": "12ff88bd-801f-4285-a352-09860bf85ab0",
                                "sense_id": "6fd4b6e3-7683-383a-9a30-3fecba56d663",
                                "text": "Mais ma tante Solange me faisait peur, demi-vieille, toupinant sans fin dans sa cuisine, la bouche tordue de tics."
                            },
                            {
                                "example_id": "41bb987a-8328-4b2e-97a3-c137af0ed52b",
                                "sense_id": "6fd4b6e3-7683-383a-9a30-3fecba56d663",
                                "text": "Il virevolte, toupine."
                            }
                        ]
                    },
                    {
                        "sense_id": "28664a39-4ad9-3bbd-937f-7a2145ab80f8",
                        "entry_id": "bd8013b1-0727-3ba4-b6fb-c7cc92481070",
                        "glosses": [
                            "Mesurer au boisseau, avec un toupinier, boisselier."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e784bfac-79d7-3ccc-98ac-f9edb7abbf35",
                        "entry_id": "bd8013b1-0727-3ba4-b6fb-c7cc92481070",
                        "glosses": [
                            "(patois vaudois - Suisse) Somnoler."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9e626cd0-6535-329d-ae0b-6a75308052c6",
                        "entry_id": "bd8013b1-0727-3ba4-b6fb-c7cc92481070",
                        "glosses": [
                            "(régional) Cuisiner."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b15c4f90-cad3-48f8-aa36-515ea81d8d5c",
                                "sense_id": "9e626cd0-6535-329d-ae0b-6a75308052c6",
                                "text": "J'aimerais bien que tu la conduises à votre chambre avant que tu te mettes à toupiner ! répondit elle. Jeanne se changera; elle te donnera un coup de main pour la cuisine."
                            }
                        ]
                    }
