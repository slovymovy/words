                "senses": [
                    {
                        "sense_id": "96988137-8576-3387-8f46-4ef58d082f1d",
                        "entry_id": "f6bd57ef-43d6-3440-a962-eda2507922e6",
                        "glosses": [
                            "Strophe in der mittelalterlichen okzitanisch-katalanischen (später auch spanischen und portugiesischen) Dichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5366247d-e7c9-4284-ab4b-6747a4421b52",
                                "sense_id": "96988137-8576-3387-8f46-4ef58d082f1d",
                                "text": "„Herr Raimbaut von Vaqueiras, der sich mit ihm Engles nannte, machte darauf folgende Cobla : „Tuit me pregon, Engles, que vos don saut.\" — In der Cobla wundert sich Raimbaut, wie Guilhelm nur den gefälschten Siegeln des Bürgers habe glauben können, worauf im Wilhelm mit der schon früher teilweise angeführten Cobla erwidert, er wundere sich sehr, ihn gegen sich so erbost zu sehen, bald würde er für so verrückt wie der närrische Herr Peirol gehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "149f341c-ca90-3804-bd13-c31e3343a4db",
                        "entry_id": "f6bd57ef-43d6-3440-a962-eda2507922e6",
                        "glosses": [
                            "das elf-köpfige Orchester, das die Sardana spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "47cfb171-1a17-4a2b-8833-288996d20b89",
                                "sense_id": "149f341c-ca90-3804-bd13-c31e3343a4db",
                                "text": "„Ventura beherrschte mehrere Instrumente, Flöte, Oboe, Klarinette und Gitarre. Sein Interesse für die damalige Form der Cobla war außerordentlich.“"
                            },
                            {
                                "example_id": "1b17859d-cac7-4001-9c0c-639a6673c1f1",
                                "sense_id": "149f341c-ca90-3804-bd13-c31e3343a4db",
                                "text": "Die Cobla von Olot spielt am Sonntag zum Tanz auf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
