                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c58d04-a32b-4950-a31a-9821da98e859",
                                                "sense_id": "c2992f09-a10a-3513-b371-8912beea3972",
                                                "text": "Cet homme ne marque point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f30e08a8-c390-31f6-8095-f2f63e60a55e",
                                        "entry_id": "da9004ef-bd00-3eed-9907-ca1751e6e567",
                                        "glosses": [
                                            "Attirer l’attention."
                                        ],
