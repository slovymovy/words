                        "examples": [
                            {
                                "example_id": "da2e2a91-e7b3-4f56-a65e-46298fce636a",
                                "sense_id": "680e65b5-d362-3d50-80ba-0d7f0ec88b64",
                                "text": "„Unter einem neuen Kapitän lief das Schiff zu seiner ersten Atlantiküberquerung aus, während der es keine weiteren Zwischenfälle gab.“"
                            },
                            {
                                "example_id": "65d207c1-e8ef-4107-b7f7-102018ffa204",
                                "sense_id": "680e65b5-d362-3d50-80ba-0d7f0ec88b64",
                                "text": "„Der berühmte Pilot, seit seiner Atlantiküberquerung 1927 in Amerika ein Nationalheld, findet ein Kuvert mit einer Lösegeldforderung.“"
                            },
                            {
                                "example_id": "35ed8a86-8a01-44d8-9b48-d7a50e99f9b6",
                                "sense_id": "680e65b5-d362-3d50-80ba-0d7f0ec88b64",
                                "text": "„Der Wettlauf um die erste Atlantiküberquerung war schließlich auch eine Frage des nationalen Prestiges.“"
                            }
                        ],
