                                    {
                                        "sense_id": "69e9e765-faeb-3924-8efa-8c8451308561",
                                        "entry_id": "c992b846-cb33-3417-a72d-a48ff36049b0",
                                        "glosses": [
                                            "A small island."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e5e762-700e-47db-bd1b-7e33b8b2ea94",
                                                "sense_id": "69e9e765-faeb-3924-8efa-8c8451308561",
                                                "text": "There is an islet on the other side of this body of water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec8fe82-12d8-39d6-aa40-c00001d1133e",
                                        "entry_id": "c992b846-cb33-3417-a72d-a48ff36049b0",
                                        "glosses": [
                                            "An isolated piece of tissue that has a specific function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f410212f-4da1-40a9-aafc-ec7eb994bc82",
                        "source_entry_id": "6a9cf629-c893-3c4e-820a-2fc929ed1445",
                        "source_sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                        "source_sense_description": "kleine Insel",
                        "target_lang_word": "îlet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "îlet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5475d4be-c79e-32ab-be2e-fd14f1f76113",
                                        "entry_id": "b7cf7f5e-1435-3cd9-bf4b-17ab16e910e5",
                                        "glosses": [
                                            "Petite île."
                                        ],
                                        "tags": [],
                                        "note": "On dit aujourd'hui de préférence îlot",
                                        "examples": [
                                            {
                                                "example_id": "5c8bacc7-1ae8-48ae-8a69-246f0f894890",
                                                "sense_id": "5475d4be-c79e-32ab-be2e-fd14f1f76113",
                                                "text": "Sur un îlet situé à l’entrée de la rade, on éleva des fortifications considérables."
                                            },
                                            {
                                                "example_id": "4b17cb11-532a-47e7-9d2e-b1afcf2b24e0",
                                                "sense_id": "5475d4be-c79e-32ab-be2e-fd14f1f76113",
                                                "text": "Trois ou quatre encablures d’un détroit où affleuraient cayes et bancs de sable, puis c’était l’Îlet, parasol d’amandiers aux luisances de jade et de flamboyants d’un vermillon aussi luminescent que s’il avait été peint par le douanier Rousseau."
                                            },
                                            {
                                                "example_id": "9c28bfbd-58a2-47fe-a4d1-14e9518ccc4a",
                                                "sense_id": "5475d4be-c79e-32ab-be2e-fd14f1f76113",
                                                "text": "La Rosée, qui menait le convoi, avait mis le cap sur un îlet plat qui faisait face à la rive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a0f3f0-9641-3951-aabe-551d3d340602",
                                        "entry_id": "b7cf7f5e-1435-3cd9-bf4b-17ab16e910e5",
                                        "glosses": [
                                            "Groupe isolé de maisons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00cee25d-1a51-4a3e-8b94-0e2c7a7068c2",
                                                "sense_id": "05a0f3f0-9641-3951-aabe-551d3d340602",
                                                "text": "Vingt-neuf rues tirées au cordeau coupent aujourd’hui le Cap en deux cent vingt-cinq îlets de maisons riantes qui montent au nombre de neuf cents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "629be055-ebed-370d-8171-6e058b26ab0e",
                                        "entry_id": "b7cf7f5e-1435-3cd9-bf4b-17ab16e910e5",
                                        "glosses": [
                                            "Petit plateau isolé par des ravines."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "note": "La prononciation locale est différente (\\i.lɛt\\",
                                        "examples": [
                                            {
                                                "example_id": "4153771e-9348-4d6e-814e-20c9f79f6d9c",
                                                "sense_id": "629be055-ebed-370d-8171-6e058b26ab0e",
                                                "text": "Un paysage qu’on aurait dit taillé à la hache par quelque géant mythologique, et qui rebondissait d’îlets en remparts, laissant planer ces ombres immenses et inquiétantes, qui balayaient l’espace au gré des alizés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee85dac6-62da-3b72-8c20-7322f8c3b1d0",
                                        "entry_id": "b7cf7f5e-1435-3cd9-bf4b-17ab16e910e5",
                                        "glosses": [
                                            "Par ellipse, peut désigner des hameaux ou groupes de maisons situés sur ces îlets."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dc1217c-03d7-4ff4-bab3-ca9377c6ee74",
                                                "sense_id": "ee85dac6-62da-3b72-8c20-7322f8c3b1d0",
                                                "text": "Grand Îlet était autrefois le plus grand de tous les îlets du cirque de Salazie ; il fut longtemps uniquement accessible à pied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7167197-83a0-4559-a671-42d3146e68da",
                        "source_entry_id": "6a9cf629-c893-3c4e-820a-2fc929ed1445",
                        "source_sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                        "source_sense_description": "kleine Insel",
                        "target_lang_word": "îlette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "îlette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f7adc97-d29e-33a4-8d97-047248f83b59",
                                        "entry_id": "fb77a632-c845-368c-806a-cf1a2382d030",
                                        "glosses": [
                                            "Petite île (et surtout : très petite île), Îlot, îlet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9d4b64-d908-4f02-bda8-588715553b81",
                                                "sense_id": "2f7adc97-d29e-33a4-8d97-047248f83b59",
                                                "text": "Nous avons déjeuné à Ermenonville, puis nous sommes promenés dans le parc, le long de la pièce d'eau, jusqu'au cénotaphe dans l'îlette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfddd6a1-572f-48fd-911b-791ac7298171",
                        "source_entry_id": "6a9cf629-c893-3c4e-820a-2fc929ed1445",
                        "source_sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                        "source_sense_description": "kleine Insel",
                        "target_lang_word": "îlot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "îlot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f4a426-9bd6-3fa4-8d07-07ac6d7b1272",
                                        "entry_id": "bad5beb4-2ea5-3713-aa18-a92e30f51654",
                                        "glosses": [
                                            "Très petite île."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb625f81-f513-48b8-b85e-ad1e5eb61dac",
                                                "sense_id": "f6f4a426-9bd6-3fa4-8d07-07ac6d7b1272",
                                                "text": "Au nord-ouest de la Grande-Ile, on voit une suite d’îlots moins considérables, assez étendus cependant pour que leur plateau présente quelque végétation."
                                            },
                                            {
                                                "example_id": "08c2bd75-3e0d-4a57-82fb-6123147b1716",
                                                "sense_id": "f6f4a426-9bd6-3fa4-8d07-07ac6d7b1272",
                                                "text": "Envisagé du bord, un débarquement semblait d'autant plus difficile qu'outre les remous et les brisants qui encerclaient l’îlot, la configuration du rocher ne s'y prête guère."
                                            },
                                            {
                                                "example_id": "33874ebe-11f1-4d5b-8da1-173321682e70",
                                                "sense_id": "f6f4a426-9bd6-3fa4-8d07-07ac6d7b1272",
                                                "text": "Pendant toute la nuit, je dus veiller attentivement, car mes observations m'avaient indiqué la proximité du rocher de Malpelo, petit îlot isolé à trois cent milles du cap San Francisco, la côte sud-américaine la plus proche."
                                            },
                                            {
                                                "example_id": "40027a4a-de27-4648-8575-d310fa941b98",
                                                "sense_id": "f6f4a426-9bd6-3fa4-8d07-07ac6d7b1272",
                                                "text": "A l'écart de la troupe, des huîtriers pies et des sternes pierregarin trouvaient matière à prise de becs sur un îlot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b925e5b-005d-33b5-8e7c-4e8e782b5fc9",
                                        "entry_id": "bad5beb4-2ea5-3713-aa18-a92e30f51654",
                                        "glosses": [
                                            "Petit groupe de maisons entouré de rues."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74f8784-2968-40f1-b0d4-7695bdf65e24",
                                                "sense_id": "7b925e5b-005d-33b5-8e7c-4e8e782b5fc9",
                                                "text": "On a démoli tout cet îlot de maisons ou, absolument, tout cet îlot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c058c1-04df-3a0c-8c8e-f7d91c95639b",
                                        "entry_id": "bad5beb4-2ea5-3713-aa18-a92e30f51654",
                                        "glosses": [
                                            "Petite zone ayant une caractéristique opposée à ce qui l’entoure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fa7c3c8-570f-4310-9f48-a1f85dffa9f9",
                                                "sense_id": "b8c058c1-04df-3a0c-8c8e-f7d91c95639b",
                                                "text": "Un îlot de verdure."
                                            },
                                            {
                                                "example_id": "3b7ce094-c5b6-4f8a-81bf-641903649f20",
                                                "sense_id": "b8c058c1-04df-3a0c-8c8e-f7d91c95639b",
                                                "text": "Un îlot de fraîcheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e53518e-69cb-31a0-9ed7-2bd77d3331de",
                                        "entry_id": "bad5beb4-2ea5-3713-aa18-a92e30f51654",
                                        "glosses": [
                                            "Territoire de taille indéterminée, considéré comme isolé, ayant une caractéristique opposée à ce qui l'entoure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ba470f-9993-4953-a038-65375feac957",
                                                "sense_id": "8e53518e-69cb-31a0-9ed7-2bd77d3331de",
                                                "text": "Sur la carte du monde, les frontières du totalitarisme se sont étendues si largement que les îlots de la liberté sont cernés par ces régimes où règne la force. Notre Europe est l'un de ces îlots, et il faut se réjouir qu'au groupe des pays de liberté qui la composent soient venus se joindre la Grèce, l'Espagne et le Portugal, aux vocations aussi anciennes que les nôtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fddb349-4420-3e1e-8367-6ea68e11405e",
                                        "entry_id": "bad5beb4-2ea5-3713-aa18-a92e30f51654",
                                        "glosses": [
                                            "Petit comptoir entouré de plancher, généralement trouvé dans la cuisine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5828154-e212-43eb-bd7a-a087daa6e888",
                                                "sense_id": "0fddb349-4420-3e1e-8367-6ea68e11405e",
                                                "text": "Certains îlots sont munis d’un évier et alimentés en courant électrique ; ils sont alors immeubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418e9b87-5234-3150-b206-7c06e3d49bde",
                                        "entry_id": "bad5beb4-2ea5-3713-aa18-a92e30f51654",
                                        "glosses": [
                                            "Ensemble de parcelles cadastrales entièrement limité, mais non coupé, par le domaine public routier, ferroviaire, fluvial ou maritime, ou par certaines voies de communication ou cours d’eau privés, ou par certaines limites administratives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e331c56-5e3f-32f0-9711-1b12ce47e975",
                                        "entry_id": "bad5beb4-2ea5-3713-aa18-a92e30f51654",
                                        "glosses": [
                                            "Formation tissulaire ou cellulaire, normale ou pathologique, qui se développe dans un tissu de nature différente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041e7761-6176-46e2-86c7-c812737bb55d",
                                                "sense_id": "0e331c56-5e3f-32f0-9711-1b12ce47e975",
                                                "text": "Ces petits points opaques forment par leur accroissement et par leur réunion , de petits îlots caséiformes, jaunes, plus ou moins résistants."
                                            },
                                            {
                                                "example_id": "6ba3f3a6-8acf-41ea-86c2-cd7dad153e03",
                                                "sense_id": "0e331c56-5e3f-32f0-9711-1b12ce47e975",
                                                "text": "L’examen très attentif d’excellents clichés est le moyen essentiel de dépister une affection proliférative (cancer ou hémopathie) par la présence de zones lytiques localisées, d’images lacunaires ou d’îlots densifiants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
