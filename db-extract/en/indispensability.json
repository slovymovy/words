                "forms": [
                    {
                        "form_id": "19c779d2-99cb-44bb-89c3-4b857a125b97",
                        "entry_id": "476028f9-6b29-334e-80a7-87577ac64e85",
                        "tags": [
                            "plural"
                        ],
                        "form": "indispensabilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d4546be-6f6e-3fd9-87f6-6be8e8132ec0",
                        "entry_id": "476028f9-6b29-334e-80a7-87577ac64e85",
                        "glosses": [
                            "The characteristic of being indispensable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7359a651-e44a-46f9-9904-10a285097648",
                                "sense_id": "4d4546be-6f6e-3fd9-87f6-6be8e8132ec0",
                                "text": "In thinly-peopled spots, I have known brick-layers on tramp, coming up with bricklayers at work, to be so sensible of the indispensability of lookers-on, that they themselves have sat up in that capacity, and have been unable to subside into the acceptance of a proffered share in the job, for two or three days together."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e15b5a8-eee2-32bf-87dc-51973ff27975",
                        "entry_id": "476028f9-6b29-334e-80a7-87577ac64e85",
                        "glosses": [
                            "Something indispensable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ef410ce1-4a47-4819-ba26-d8ad3048bdae",
                                "sense_id": "8e15b5a8-eee2-32bf-87dc-51973ff27975",
                                "text": "Beetle: Yes, I am certain I can be helpful. Indispensable!\nMonkey: In what way?\n[Beetle displays his ability with bow and arrow, firing multiple arrows on the same spot]\n[…]\nBeetle: Just tell me of our quest, and I will immediately demonstrate my numerous indispensabilities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b99e99be-7fff-4df4-81c7-f2fab74a2b85",
                        "source_entry_id": "476028f9-6b29-334e-80a7-87577ac64e85",
                        "source_sense_description": "the characteristic of being indispensable",
                        "target_lang_word": "indispensabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indispensabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87c0717b-0e5a-3477-b86e-1222a195b358",
                                        "entry_id": "9fcedb36-3b94-352b-9643-c33b9dfae5c7",
                                        "glosses": [
                                            "État ou qualité de ce qui est indispensable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f3c5bd-953f-4d35-a5d4-9012eadfb9ff",
                                                "sense_id": "87c0717b-0e5a-3477-b86e-1222a195b358",
                                                "text": "Plus encore que les faits physiologiques, les faits pathologiques affirment l’indispensabilité de cette étude."
                                            },
                                            {
                                                "example_id": "cfad44ed-0da2-4a61-8f2e-8add9210e40e",
                                                "sense_id": "87c0717b-0e5a-3477-b86e-1222a195b358",
                                                "text": "Son point de départ est ce qu'il nomme une affirmation d’indispensabilité : telle chose est indispensable à la cohérence de l'expérience, pour que ce soit une expérience intelligible. Par développement logique, on définit ensuite une chaîne d'affirmations d’indispensabilité. L'on en vient alors à l'énonciation de conditions limites de la connaissance, sans reconnaissance desquelles il n'y aurait plus d'expérience possible du tout."
                                            },
                                            {
                                                "example_id": "695d6207-7ed6-4cd9-91af-c10b67512cf8",
                                                "sense_id": "87c0717b-0e5a-3477-b86e-1222a195b358",
                                                "text": "Nous savons tous quelle était la réponse de Quine à cette question, à savoir : l’admissibilité ontologique des entités mathématiques abstraites sur la base de leur utilité dans l'activité de la science. L'argument principal en faveur de cette admissibilité est donné donc dans la thèse d’indispensabilité, appelée depuis la thèse Putnam-Quine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5515c427-8576-4216-b689-5d5e8d68214e",
                        "source_entry_id": "476028f9-6b29-334e-80a7-87577ac64e85",
                        "source_sense_description": "the characteristic of being indispensable",
                        "target_lang_word": "Unentbehrlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unentbehrlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afc15324-34cc-3778-92fa-517c7ea233ea",
                                        "entry_id": "883df3e8-0185-3207-be24-7e30adf099aa",
                                        "glosses": [
                                            "Eigenschaft von etwas, sich als nicht verzichtbar erwiesen zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa847dc-0d0c-4ead-81bd-da14720e4592",
                                                "sense_id": "afc15324-34cc-3778-92fa-517c7ea233ea",
                                                "text": "„Erst gegen zwei Uhr morgens konnten sie die versammelte Meute von der Unentbehrlichkeit von Literatur in einem Nachtklub überzeugen.“"
                                            },
                                            {
                                                "example_id": "e7f67f6c-da86-4714-9f1e-a66e4aa07259",
                                                "sense_id": "afc15324-34cc-3778-92fa-517c7ea233ea",
                                                "text": "„Jeder höhere Verwaltungsbeamte ist in ruhigen, von keinen Stürmen erschütterten Zeiten der Meinung, die ganze ihm anvertraute Bevölkerung bewege sich nur dank seinen Bemühungen, und das dieser Meinung entspringende Gefühl eigener Unentbehrlichkeit bildet für ihn den grössten Lohn seiner Mühen und Anstrengungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
