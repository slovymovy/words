                "entry_id": "c0402582-cd46-316d-9658-7ab50f9994ce",
                "word": "vastgespen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab01fd2b-0d06-3bf1-9869-b5849b9867d6",
                        "entry_id": "c0402582-cd46-316d-9658-7ab50f9994ce",
                        "glosses": [
                            "iets of iemand vastmaken met een gesp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3d1098-b427-49f5-98c6-3593f2afbbbf",
                                "sense_id": "ab01fd2b-0d06-3bf1-9869-b5849b9867d6",
                                "text": "Brandon is een sterke jongeman die agressief kan worden als hij situaties moeilijk overziet of aankan. Om het personeel tegen hem te beschermen, moet hij zich iedere keer vastgespen als mensen de ruimte waar hij verblijft betreden."
                            },
                            {
                                "example_id": "fc9926b6-f69f-4683-8f2d-afb0f6ab0fc3",
                                "sense_id": "ab01fd2b-0d06-3bf1-9869-b5849b9867d6",
                                "text": "Vandaag was Feillu nog even de plaaggeest van etappewinnaar Mark Cavendish. De Fransman tikte op 1 kilometer van de streep met zijn wiel het pedaal van de Brit aan. De voetvan Cavendish schoot los. Maar de sprinter van HTC kon hem op tijd weer vastgespen en de sprint alsnog winnen."
                            },
                            {
                                "example_id": "c0300169-7655-4cb9-b1ac-c19aeeefac21",
                                "sense_id": "ab01fd2b-0d06-3bf1-9869-b5849b9867d6",
                                "text": "Het luchthavenpersoneel stelde voor om hem in een van de beschikbare rolstoelen ter plaatse te vervoeren, maar dat was voor de man geen optie. ,,Ze stonden erop dat ze me zouden vastgespen’’, verklaart Levene. ,,Ik zou niet in staat zijn anders te gaan zitten en zou een drukwond hebben kunnen oplopen.” Zijn eigen rolstoel werd aangepast met een speciaal kussen dat zulke wonden voorkomt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae625359-e47a-4281-b776-dab7dd8f8e42",
                        "source_entry_id": "c0402582-cd46-316d-9658-7ab50f9994ce",
                        "source_sense_id": "ab01fd2b-0d06-3bf1-9869-b5849b9867d6",
                        "target_lang_word": "clasp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clasp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6360852-f5f9-3b5a-820b-c2a2a98b8545",
                                        "entry_id": "1548ef56-3359-3860-82a8-918fd764249e",
                                        "glosses": [
                                            "A device with interlocking parts used for fastening things together, such as a fastener or a holder."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dccf85c-cf77-426d-8366-f9fff74eeec3",
                                                "sense_id": "a6360852-f5f9-3b5a-820b-c2a2a98b8545",
                                                "text": "I always have a hard time working the clasp on this necklace!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d666e86b-bfb7-35aa-962e-1f11a737ba74",
                                        "entry_id": "1548ef56-3359-3860-82a8-918fd764249e",
                                        "glosses": [
                                            "A bar or insignia on a medal ribbon, to either indicate an additional award of the medal, or the action or service for which it was awarded."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0d09a5b-28db-3297-9d93-31d5f2b8e08d",
                                        "entry_id": "1548ef56-3359-3860-82a8-918fd764249e",
                                        "glosses": [
                                            "An embrace, a grasp, or handshake."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c894d903-89fa-4595-93e6-7640e47fbe1f",
                                                "sense_id": "a0d09a5b-28db-3297-9d93-31d5f2b8e08d",
                                                "text": "He took her hand in a firm clasp."
                                            },
                                            {
                                                "example_id": "3110bb49-6210-4694-8d79-e442530fc232",
                                                "sense_id": "a0d09a5b-28db-3297-9d93-31d5f2b8e08d",
                                                "text": "How few! yet how they creep / Through my fingers to the deep, / While I weep—while I weep! / O God! can I not grasp / Them with a tighter clasp?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clasp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                        "entry_id": "377bce19-5388-30a7-8cc8-d7f845a4e5ec",
                                        "glosses": [
                                            "To take hold of; to grasp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a541633a-b1fc-41a2-a07d-0a5acfa02d5a",
                                                "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                                "text": "They clasped hands and parted as friends."
                                            },
                                            {
                                                "example_id": "4b4244fe-b2a3-48de-b97f-b7d76f123cff",
                                                "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                                "text": "And when the Boy dropped off to sleep, the Rabbit would snuggle down close under his little warm chin and dream, with the Boy's hands clasped close round him all night long."
                                            },
                                            {
                                                "example_id": "2b1d8f62-2be9-42f3-8658-09573f90b5da",
                                                "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                                "text": "The poor dear lady shivered, and I could see the tension of her nerves as she clasped her husband closer to her and bent her head lower and lower still on his breast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1af081-3cf6-37ce-bfd2-4b69ca9bca48",
                                        "entry_id": "377bce19-5388-30a7-8cc8-d7f845a4e5ec",
                                        "glosses": [
                                            "To shut or fasten together with, or as if with, a clasp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3677e1d6-bf2d-38ff-a930-8fe95d8c3472",
                                        "entry_id": "377bce19-5388-30a7-8cc8-d7f845a4e5ec",
                                        "glosses": [
                                            "To cling."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
