                "translations": [
                    {
                        "translation_id": "ee173fd7-b79e-4a74-8078-1d2b967161f5",
                        "source_entry_id": "e24761ea-1e6c-391f-98bd-c2e69eab3daa",
                        "source_sense_id": "a8d3e4a6-bca4-3cc1-8c60-c93c15e121d1",
                        "target_lang_word": "Tracht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tracht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73a8a528-8d9d-3a56-ad2e-62dc022da957",
                                        "entry_id": "b028043d-7106-3482-9ee4-33d484a93911",
                                        "glosses": [
                                            "Bekleidung einer bestimmten Personengruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dc9da01-638f-4170-8497-8c908f7623fd",
                                                "sense_id": "73a8a528-8d9d-3a56-ad2e-62dc022da957",
                                                "text": "Im Spreewald und in Oberbayern kann man noch häufiger Trachten sehen."
                                            },
                                            {
                                                "example_id": "7a2d841b-c2ad-46ec-99ed-20d9d8f71970",
                                                "sense_id": "73a8a528-8d9d-3a56-ad2e-62dc022da957",
                                                "text": "„Sie durften nicht mehr ihre Trachten tragen.“"
                                            },
                                            {
                                                "example_id": "55083709-d540-4d37-b787-3b13b3c72c78",
                                                "sense_id": "73a8a528-8d9d-3a56-ad2e-62dc022da957",
                                                "text": "„Die meisten Leute, die ich sehe, gehen in kaukasischer Tracht mit Waffen; einige gehen auch in europäischer Jacke mit steifem Filzhut, die Offiziere tragen tscherkessische Uniform.“"
                                            },
                                            {
                                                "example_id": "7c4262f9-2c1a-434e-83b8-d3beb179b80a",
                                                "sense_id": "73a8a528-8d9d-3a56-ad2e-62dc022da957",
                                                "text": "„In schlichter Tracht, aber reich geschmückt stand sie nun in Erwartung auf der Veranda.“"
                                            },
                                            {
                                                "example_id": "f97d4d1e-92ae-494a-a0c1-7dda09fab818",
                                                "sense_id": "73a8a528-8d9d-3a56-ad2e-62dc022da957",
                                                "text": "„Sie trug die Tracht ihres Dorfes, sah jedoch mit ihren goldenen Ketten um Hals und Handgelenke sehr nett aus.“"
                                            },
                                            {
                                                "example_id": "2d4c64d1-670a-4449-a8fe-b6bb38fb3b32",
                                                "sense_id": "73a8a528-8d9d-3a56-ad2e-62dc022da957",
                                                "text": "„Die eine hat isländische Tracht an, die andre was Schwarzseidenes mit Bimmelbammel oben und unten, beide vor lauter Feierlichkeit mucksmäuschenstumm, und himmeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a2d1f8d-e202-3b5c-bd59-bf76741a21db",
                                        "entry_id": "b028043d-7106-3482-9ee4-33d484a93911",
                                        "glosses": [
                                            "in den Bienenstock eingetragene Nahrung (Nektar und Pollen)"
                                        ],
                                        "tags": [
                                            "Imkerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a677613-40bb-4175-a0ae-f613562242d5",
                                                "sense_id": "9a2d1f8d-e202-3b5c-bd59-bf76741a21db",
                                                "text": "Weißklee liefert eine gute Tracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
