                "senses": [
                    {
                        "sense_id": "1a5d757c-3af0-3cec-9afa-b23b7d4227e9",
                        "entry_id": "5f74c19d-0081-33a0-8533-3e9275a32c2d",
                        "glosses": [
                            "Personne non-binaire ou sans détermination de genre qui, à titre professionnel, cultive la terre ou élève des animaux destinés à être consommés."
                        ],
                        "tags": [
                            "Variations diaéthiques"
                        ],
                        "examples": [
                            {
                                "example_id": "738b4272-b3b2-43f1-b76c-5167e30772d5",
                                "sense_id": "1a5d757c-3af0-3cec-9afa-b23b7d4227e9",
                                "text": "Les agriculteurices n'attendent que vous pour les soutenir vers la transition agroécologique et locale"
                            },
                            {
                                "example_id": "6b9669e1-89a9-411e-8df5-692070fbde84",
                                "sense_id": "1a5d757c-3af0-3cec-9afa-b23b7d4227e9",
                                "text": "L'AMAP (Association pour le Maintien d'une Agriculture Paysanne) est par essence une association qui essaye de revaloriser le travail des agriculteurices."
                            },
                            {
                                "example_id": "39ba7c24-37a0-4a52-923a-ceb4ab078cbe",
                                "sense_id": "1a5d757c-3af0-3cec-9afa-b23b7d4227e9",
                                "text": "Pas un mot sur, ou pour, les plus de 600 agriculteurices qui sont mort·es au cours de cette lutte historique."
                            }
                        ]
                    }
