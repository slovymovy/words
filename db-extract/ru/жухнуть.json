                                                "example_id": "21a75660-237a-49e2-b1e3-03fe1b63d665",
                                                "sense_id": "a3bbba1d-420c-3160-b98b-b95aefd3b94b",
                                                "text": "But those newcomers need water — water that is vanishing as a megadrought dries up reservoirs and rivers across the West. […] Groundwater and streams vital both to farmers and cities are drying up. […] Gov. Spencer Cox of Utah said all but one of the fields on his family’s farm had dried up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8335f55c-56a3-313a-98f4-c9c9edc26611",
                                        "entry_id": "a0c18df1-b5f1-33d6-b36e-9cb01cc8960b",
                                        "glosses": [
                                            "To cause to become dry."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46a52787-c875-4929-8e0b-1fd4dab0e712",
                                                "sense_id": "8335f55c-56a3-313a-98f4-c9c9edc26611",
                                                "text": "The heatwave dried up all the rivers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58075d10-5847-3c35-939b-e79ab2c8f2fe",
                                        "entry_id": "a0c18df1-b5f1-33d6-b36e-9cb01cc8960b",
                                        "glosses": [
                                            "To manually dry dishes and utensils."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc912a9d-ef37-4ce8-874c-d407396fcc67",
                                                "sense_id": "58075d10-5847-3c35-939b-e79ab2c8f2fe",
                                                "text": "I'll dry up if you wash up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c7454f-1af2-3214-8e07-1ea5ec853827",
                                        "entry_id": "a0c18df1-b5f1-33d6-b36e-9cb01cc8960b",
                                        "glosses": [
                                            "To deprive someone of (something vital)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ee4f5b5-cb77-4463-9028-ce84ff9fa387",
                                                "sense_id": "72c7454f-1af2-3214-8e07-1ea5ec853827",
                                                "text": "The bankruptcy rumor dried up his sales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb0f110-2b64-377a-b5d8-188e8d0411de",
                                        "entry_id": "a0c18df1-b5f1-33d6-b36e-9cb01cc8960b",
                                        "glosses": [
                                            "To gradually decrease and eventually cease."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcb6e878-0f25-4c5f-8b3d-dabd68d2dc5e",
                                                "sense_id": "2eb0f110-2b64-377a-b5d8-188e8d0411de",
                                                "text": "When our money dried up, we had to get proper jobs."
                                            },
                                            {
                                                "example_id": "6e5a5f9f-2fdb-4dd0-af63-cfd922c03d5f",
                                                "sense_id": "2eb0f110-2b64-377a-b5d8-188e8d0411de",
                                                "text": "After the stock market crash, the easy financing dried up."
                                            },
                                            {
                                                "example_id": "da6ae5f6-fa0c-4410-a41e-15dbbe87eb66",
                                                "sense_id": "2eb0f110-2b64-377a-b5d8-188e8d0411de",
                                                "text": "This love has dried up and stayed behind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3871381-b304-3739-b18d-f77bb20d7125",
                                        "entry_id": "a0c18df1-b5f1-33d6-b36e-9cb01cc8960b",
                                        "glosses": [
                                            "To stop talking because one has forgotten what one was going to say."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a9eaa7e-ba71-4b35-bde6-453ae80fe938",
                                                "sense_id": "b3871381-b304-3739-b18d-f77bb20d7125",
                                                "text": "This surprised me so much that I dried up for a moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a779ce-f3fa-3c70-8b52-7d45d77bcf91",
                                        "entry_id": "a0c18df1-b5f1-33d6-b36e-9cb01cc8960b",
                                        "glosses": [
                                            "To stop talking because one has forgotten what one was going to say.",
                                            "To forget one's lines."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7d239d1-1fd0-3749-9fbe-03d52d81d857",
                                        "entry_id": "a0c18df1-b5f1-33d6-b36e-9cb01cc8960b",
                                        "glosses": [
                                            "To stop talking or drop a topic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e0cf01-ec7b-4ca8-a94e-963e1e84fb38",
                                                "sense_id": "d7d239d1-1fd0-3749-9fbe-03d52d81d857",
                                                "text": "Oh, dry up, you old fuddy-duddy!"
                                            },
                                            {
                                                "example_id": "882e6456-072b-4317-8de6-0b47a3f716e0",
                                                "sense_id": "d7d239d1-1fd0-3749-9fbe-03d52d81d857",
                                                "text": "\"Oh, dry up,' said Arnold morosely."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b8bee9e-ac74-4880-8064-10691684d854",
