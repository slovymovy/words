                "senses": [
                    {
                        "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                        "entry_id": "211aa5ea-05e9-31b6-997c-024adb42cddb",
                        "glosses": [
                            "Auskunft, Beratung von Kunden über angebotene Waren oder Dienstleistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95711401-41c1-4162-adaf-bf197d6369f4",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Mit einem guten Mix aus Beratungsservice und attraktiven Konditionen für Finanzprodukte hievte sich die PSD Bank München in der Landeshauptstadt auf Platz zwei im Regionalentscheid.“"
                            },
                            {
                                "example_id": "c773d7a4-f015-40a3-8571-8259ffc73693",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Sie kommen an Universitäten, die längst nicht jeden Mensaplan, Anmeldebogen oder Beratungsservice in Englisch vorhalten.“"
                            },
                            {
                                "example_id": "6d472e28-7c38-46ba-9076-272d3c0ea650",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Genau dies sei das Ziel der externen Mitarbeiterberatung, sagt Werner Fürstenberg, dessen Fürstenberg-Institut den Beratungsservice für Shell und andere große Unternehmen wie Unilever oder Johnson&Johnson in Deutschland anbietet.“"
                            },
                            {
                                "example_id": "6cd1d4d1-b440-47c1-9248-154f1d32423c",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Eine Besonderheit bietet die ERV-Reiseversicherung mit dem kostenlosen medizinischen Beratungsservice an.“"
                            },
                            {
                                "example_id": "10b462e7-df6e-4555-b341-7ae1acca6a2c",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Ich war gerade auf der Suche nach Kooperationspartnern für MamiConcierge, einem Netzwerk und Beratungsservice für werdende und ganz frische Mütter, um sie zu entlasten und im Alltag zu unterstützen.“"
                            },
                            {
                                "example_id": "74e4228a-3ea0-4815-be7e-deb6add40f23",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Ganz wichtig: Nehmen Sie vor dem Buchen den kostenlosen Beratungsservice der Veranstalter in Anspruch.“"
                            },
                            {
                                "example_id": "b5195840-698f-45f3-8f45-5793ce06472a",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Wer zum Beispiel krank wird, sollte sofort den medizinischen Beratungsservice anrufen, den jede Versicherung anbietet.“"
                            },
                            {
                                "example_id": "48a9d171-380a-4cfe-9cc4-0d38445f3629",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Wir bieten unseren Mitarbeitern jetzt einen eigenen Beratungsservice an, der sie dabei unterstützt, mit Behörden, ihren Banken, ihren Vermietern zu sprechen.“"
                            },
                            {
                                "example_id": "8892f2cb-5365-429f-903f-1477b80325ef",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Besonders bei Menschen, die gerade Opfer von Einbrechern geworden seien, gingen die Unterhaltungen über den eigentlichen Beratungsservice hinaus.“"
                            },
                            {
                                "example_id": "4f089402-26c4-40e0-9db7-a64218617b8d",
                                "sense_id": "e52078a1-ea9a-3ec1-848e-ca4fa0c57ed5",
                                "text": "„Winfried Schumann ist Leiter des psychologischen Beratungsservice von Uni und Studentenwerk in Oldenburg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
