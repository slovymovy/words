    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d7a24505-e512-3767-be9f-ebb36f90bc7b",
                    "sense_definition": "Drückt eine zeitliche Abfolge aus; an erster Stelle, bevor etwas anderes geschieht.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reihenfolge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen <w>erst</w> die Hausaufgaben machen, bevor wir spielen können."
                        },
                        {
                            "text": "<w>Erst</w> putzen wir uns gründlich die Zähne und danach gehen wir schlafen."
                        }
                    ],
                    "synonyms": [
                        "zuerst",
                        "zunächst",
                        "vorher",
                        "zuvor",
                        "als Erstes"
                    ],
                    "common_phrases": [
                        "erst die Arbeit dann das Vergnügen"
                    ]
                },
                {
                    "sense_id": "45154b44-e901-3559-bc7f-dab7271299f1",
                    "sense_definition": "Zeigt an, dass eine Zeitangabe, ein Alter oder ein Ausmaß geringer ist als möglicherweise vermutet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ausmass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie ist <w>erst</w> zehn Jahre alt und kann schon sehr gut schwimmen."
                        },
                        {
                            "text": "Keine Sorge, es ist <w>erst</w> acht Uhr und wir haben noch viel Zeit."
                        }
                    ],
                    "synonyms": [
                        "lediglich",
                        "nur"
                    ]
                },
                {
                    "sense_id": "4fb02121-40a6-3602-bcca-c56b9042f5fd",
                    "sense_definition": "Drückt aus, dass ein Vorgang nicht vor einem bestimmten zukünftigen Zeitpunkt stattfindet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zeitpunkt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der neue Deutschkurs an unserer Schule beginnt <w>erst</w> im nächsten Monat."
                        },
                        {
                            "text": "Mein Bruder kommt <w>erst</w> morgen spät am Abend nach Hause zurück."
                        }
                    ]
                },
                {
                    "sense_id": "918a7477-a2e2-30d5-acb7-e06d79f49910",
                    "sense_definition": "Bezieht sich auf die Vergangenheit und drückt aus, dass ein Geschehen noch nicht lange her ist.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vergangenheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir haben die Schlüssel für die neue Wohnung <w>erst</w> gestern bekommen."
                        },
                        {
                            "text": "Sie ist <w>erst</w> vor wenigen Minuten von der Arbeit zurückgekommen."
                        }
                    ],
                    "synonyms": [
                        "kürzlich",
                        "eben",
                        "gerade"
                    ]
                },
                {
                    "sense_id": "7ac930c2-e432-3ab5-a704-4ea3bedc3cef",
                    "sense_definition": "Dient als Partikel zur Steigerung, Hervorhebung oder Bekräftigung einer Aussage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verstaerkung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn das Wetter so stürmisch bleibt, bleibe ich <w>erst</w> recht zu Hause."
                        },
                        {
                            "text": "Ich habe keine Zeit dafür und ehrlich gesagt heute <w>erst</w> recht keine Lust."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "erst recht"
                    ]
                }
            ]
        }
