                                        "entry_id": "76627805-57c4-3ff4-bcb9-15d5df15acc5",
                                        "glosses": [
                                            "senkrecht abfallendes Rohr, durch das Wasser von einer höheren Fläche zu einer niedrigeren Fläche abgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f44476-124a-4e53-b3b1-185b347bdee3",
                                                "sense_id": "e70037b1-5863-34c6-a829-9ee74a81fda1",
                                                "text": "Der Durchmesser des passenden Fallrohrs richtet sich nach der Dachgröße und dem Durchmesser der jeweiligen gewählten Dachrinne."
                                            },
                                            {
                                                "example_id": "baa26cf0-4eda-4b9d-857f-cd9435bad636",
                                                "sense_id": "e70037b1-5863-34c6-a829-9ee74a81fda1",
                                                "text": "An eine Rinne aus Titanzink können theoretisch Fallrohre aus Kupfer angeschlossen werden, nicht jedoch umgekehrt."
                                            },
                                            {
                                                "example_id": "be5a1f4c-fbbf-4440-a0a2-7ad280edb3b5",
                                                "sense_id": "e70037b1-5863-34c6-a829-9ee74a81fda1",
                                                "text": "Dies liegt darin begründet, dass die im abfließenden Regenwasser enthaltenen Kupferionen bei den Fallrohren aus Zink Korrosion hervorrufen und zur Entstehung von Löchern beitragen kann."
                                            },
                                            {
                                                "example_id": "e810cf02-911a-4cc6-85b3-667e6b12a1d0",
                                                "sense_id": "e70037b1-5863-34c6-a829-9ee74a81fda1",
                                                "text": "Bei Regen werden die Blätter in die Regenrinne gespült und landen schliesslich im Fallrohr."
                                            },
                                            {
                                                "example_id": "0820cb89-9a38-4536-b173-870c4c58eea2",
                                                "sense_id": "e70037b1-5863-34c6-a829-9ee74a81fda1",
                                                "text": "Falls das Fallrohr eines Dachrinne verstopft ist, brauchen Sie eine Rohrreinigungsspirale aus dem Baumarkt und eine lange Leiter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
