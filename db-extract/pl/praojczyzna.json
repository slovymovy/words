                    {
                        "translation_id": "cbeda84d-c764-49eb-ab9b-992f026458f6",
                        "source_entry_id": "e5c294be-925f-38d1-879e-1a44badd42eb",
                        "source_sense_id": "78b08ff0-4137-3999-8363-e148973086a6",
                        "target_lang_word": "Urheimat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urheimat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                        "entry_id": "6d6b4f6c-d745-3c10-9ecf-f86679a57a58",
                                        "glosses": [
                                            "Region, in der der historische Ursprung eines Volkes vermutet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea0563d-e268-4d3c-a175-5f6fc684639a",
                                                "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                                "text": "„Obwohl auch die Archäologen nicht genau sagen können, woher die Kelten kamen, fanden sie immerhin heraus, daß deren Urheimat irgendwo in Mitteleuropa lag.“"
                                            },
                                            {
                                                "example_id": "acee808d-7dbb-4696-9d52-43def00974b4",
                                                "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                                "text": "„Über die Urheimat des Indogermanischen ist viel und wild gerätselt worden.“"
                                            },
                                            {
                                                "example_id": "b418c368-cff4-4f45-ae46-c4707a86a14b",
                                                "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                                "text": "„Einzelne Wörter reichen also zum Nachweis einer bestimmten Urheimat nicht aus, weil sich das Verhältnis von »Wörtern« und »Sachen« im Laufe der Jahrhunderte verändern kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
