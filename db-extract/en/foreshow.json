                        "entry_id": "2fd587f6-f1a9-38f8-bfe9-cdad64a5f29a",
                        "glosses": [
                            "A manifestation in advance; a prior indication."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "35a14db4-a0a3-43af-90cd-7d7b280c3ddb",
                                "sense_id": "780c844d-abde-3637-b93e-25566fb2c862",
                                "text": "The fore-shew of their inclination whilest they are young is so uncertaine […] that it is very hard, (yea for the wisest) to ground any certaine judgement […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
