                                    {
                                        "sense_id": "f9d4b33f-9ae0-3cee-a51c-d538ede4e428",
                                        "entry_id": "80d6193f-f2ca-34d8-8ee3-bc9de81c9e86",
                                        "glosses": [
                                            "een man die prostituees tegen betaling beschermt en helpt, een souteneur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a5a348-222e-420b-ab73-b377c3043dc9",
                                                "sense_id": "f9d4b33f-9ae0-3cee-a51c-d538ede4e428",
                                                "text": "Een pooier die meerdere vrouwen voor hem had werken, zoals in Amerikaanse films, kwam in Nederland echter nauwelijks voor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec18265-3b05-3dcc-ae3b-53acd0a6f579",
                                        "entry_id": "80d6193f-f2ca-34d8-8ee3-bc9de81c9e86",
                                        "glosses": [
                                            "een patser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e2ed194-4f43-4cef-a727-204ef609981c",
                                                "sense_id": "5ec18265-3b05-3dcc-ae3b-53acd0a6f579",
                                                "text": "Wat een pooier zeg, die man die de hele tijd loopt op te scheppen over z'n Ferrari."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "add99413-a8d5-4b57-bd6e-f11a51fb6311",
                        "source_entry_id": "1bc4b332-5619-3f4a-bf42-a1ddb5a1874c",
                        "source_sense_id": "0023bbaf-0115-3e7f-aa09-22cd542a4a3c",
                        "source_sense_description": "Amoureux considéré comme sans envergure",
                        "target_lang_word": "Zuhälter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuhälter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                        "entry_id": "605bed47-26fd-32d2-89e5-66823cdedff4",
                                        "glosses": [
                                            "eine Person, die von der Prostitution einer oder mehrerer Frauen (oder Männer) lebt und die Betroffenen dabei ausbeutet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "371e1110-2788-4c22-9e3d-f261baa7dc30",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "Ihr Zuhälter hat sie verprügelt."
                                            },
                                            {
                                                "example_id": "de67e368-c41e-4c58-b059-78837f5e838a",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Sie machte das als Hobby, hatte keinen Zuhälter und kannte keine anderen Nutten.“"
                                            },
                                            {
                                                "example_id": "a70e4065-d759-41bc-bc2f-f763f983712b",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Ein Zuhälter war auf sie aufmerksam geworden und hatte sie mit Geschenken überhäuft, bis sie nachgab und die Vormittage in einem Stundenhotel verbrachte.“"
                                            },
                                            {
                                                "example_id": "8416721f-be67-4a37-8fd0-4c3674693d04",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Wenn ihn zuzeiten sein Wettglück verließ, scheint sich Durrieux auch als Carolines Zuhälter betätigt zu haben.“"
                                            },
                                            {
                                                "example_id": "34a99a2c-7f5a-4f17-ac3f-c17d6624a88d",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Max sah auch Zuhälter herumlaufen und Huren, die auffallender gekleidet waren und leuchtendere Farben trugen als die anderen Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
