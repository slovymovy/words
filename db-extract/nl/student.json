                "senses": [
                    {
                        "sense_id": "2ab4c8fe-fec8-3597-a108-fad6a63131df",
                        "entry_id": "3ac2b5d9-88c0-36de-b732-1ab57ccfd6db",
                        "glosses": [
                            "iemand die hoger onderwijs volgt"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "94afa542-d555-49bf-9791-7e8db41eae35",
                                "sense_id": "2ab4c8fe-fec8-3597-a108-fad6a63131df",
                                "text": "De universiteit met al haar medewerkers, studenten en onderzoekers vormt een academische gemeenschap."
                            },
                            {
                                "example_id": "fd11c79f-6702-4ae5-8ba0-52415fe37bbc",
                                "sense_id": "2ab4c8fe-fec8-3597-a108-fad6a63131df",
                                "text": "Aan de geslaagde student wordt een getuigschrift uitgereikt en een lijst met de door hem behaalde resultaten uit het tweede, derde en vierde jaar."
                            },
                            {
                                "example_id": "47c913f8-e9ca-41cd-8329-72726dabda34",
                                "sense_id": "2ab4c8fe-fec8-3597-a108-fad6a63131df",
                                "text": "Tentamenweek of niet, studenten, promovendi en andere medewerkers van de afdeling Aardwetenschappen aan de Vrije Universiteit in Amsterdam voeren vandaag actie. Ze proberen het voorgenomen besluit om hun studie en banen weg te bezuinigen tegen te houden. En niet alleen zij maken zich zorgen: ook het werkveld luidt de noodklok. Een petitie tegen het plan is al meer dan 8000 keer getekend."
                            },
                            {
                                "example_id": "72ce54c0-459e-41b1-b30d-524ffd20ddcb",
                                "sense_id": "2ab4c8fe-fec8-3597-a108-fad6a63131df",
                                "text": "Genie, de student uit Australië, Jetfighter, de vagebond uit Amerika, en Van Go, de burgerman uit Nederland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1877ec7e-bffe-43b6-9692-06e04a12c225",
                        "source_entry_id": "3ac2b5d9-88c0-36de-b732-1ab57ccfd6db",
                        "source_sense_id": "2ab4c8fe-fec8-3597-a108-fad6a63131df",
                        "source_sense_description": "iemand die hoger onderwijs volgt",
                        "target_lang_word": "Student",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Student",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                        "entry_id": "3cdb4f39-2955-3daa-bf28-6483c55cc833",
                                        "glosses": [
                                            "Person, die an einer Universität oder Fachhochschule studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30bf535-8676-4587-9cb6-623fa1923cd7",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "Sind Sie Student dieser Universität?"
                                            },
                                            {
                                                "example_id": "eac7a33f-205f-461d-9702-dbc92eb055cb",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Es war normal, dass ich mich ihnen anschloss, da wir keinen Zugang zu den reichen Studenten hatten, der Mehrzahl unserer Kommilitonen.“"
                                            },
                                            {
                                                "example_id": "158cfe27-3175-459b-b19d-29817bdce361",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Es war die Zeit, als sich die Jugend an der Universität noch siezte, als Studenten Anzüge und Krawatten trugen und ihre Kommilitoninnen Kleider mit weißen Kragen oder Perlenketten.“"
                                            },
                                            {
                                                "example_id": "cf5ec9b2-1408-41af-bd6a-b70389c4eeb5",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Die meisten Studenten sind Krüppel und Kranke, die der Krieg freigab.“"
                                            },
                                            {
                                                "example_id": "7e816e7d-7db8-429c-9be1-0b40eae3d2b1",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Junge Leute, eben auch meine Studenten und Studentinnen, waren fasziniert von dem neuen Modell, als sie erstmals davon Kenntnis erhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "251a84e6-dfc8-4889-be8b-2b7555d547cc",
                        "source_entry_id": "3ac2b5d9-88c0-36de-b732-1ab57ccfd6db",
                        "source_sense_id": "2ab4c8fe-fec8-3597-a108-fad6a63131df",
