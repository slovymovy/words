                                                "example_id": "55bbe9ba-ba88-48e0-b9d4-8357dae6460b",
                                                "sense_id": "d0f554e4-1e3e-3304-9ada-6975f9236935",
                                                "text": "Die Kerschs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "c27a7e26-3256-46f9-bdb7-cfe96538f59d",
                                                "sense_id": "d0f554e4-1e3e-3304-9ada-6975f9236935",
                                                "text": "Der Kersch trägt nie die Schals, die die Kersch ihm strickt."
                                            },
                                            {
                                                "example_id": "38a57281-81a6-4dc2-8bd5-380444c47b6e",
                                                "sense_id": "d0f554e4-1e3e-3304-9ada-6975f9236935",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kersch kommt, geht der Herr Kersch.“"
                                            },
                                            {
                                                "example_id": "fc0402bf-a100-4526-bca1-023ffa8ad49c",
                                                "sense_id": "d0f554e4-1e3e-3304-9ada-6975f9236935",
                                                "text": "Kersch kommt und geht."
                                            },
                                            {
                                                "example_id": "9e8762b2-0e1c-4521-ad6d-768e5b8a7df7",
                                                "sense_id": "d0f554e4-1e3e-3304-9ada-6975f9236935",
                                                "text": "Kerschs kamen, sahen und siegten."
                                            }
