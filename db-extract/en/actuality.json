                "senses": [
                    {
                        "sense_id": "f85b4127-38a0-3310-a82e-74addeabd554",
                        "entry_id": "d03fafb9-3119-3580-ae86-c34c18060965",
                        "glosses": [
                            "The state of existing; existence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b1214183-9d7e-334c-9ff6-89c66443ee0c",
                        "entry_id": "d03fafb9-3119-3580-ae86-c34c18060965",
                        "glosses": [
                            "An instance or quality of being actual or factual; fact."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2371f0ac-ec1d-475a-bb6e-4b1e1f6b86a9",
                                "sense_id": "b1214183-9d7e-334c-9ff6-89c66443ee0c",
                                "text": "\"It seems as though I have lived this life always. The world of books and bookish folk is very vague, more like a dream memory than an actuality. I surely have hunted and forayed and fought all the days of my life. And you, too, seem a part of it. You are -- \" I was on the verge of saying, \"my woman, my mate,\" but glibly changed it to -- \"standing the hardship well.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "3f3b2de6-8376-3493-a497-c7213ac53e96",
                        "entry_id": "d03fafb9-3119-3580-ae86-c34c18060965",
                        "glosses": [
                            "Live reporting on current affairs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "da845731-797f-47ba-88f3-18ed748a3bb6",
                                "sense_id": "3f3b2de6-8376-3493-a497-c7213ac53e96",
                                "text": "A cabled despatch is better than nothing, but a voicecast of tolerable quality is preferable, and in certain types of story a voicecast with live or recorded actuality is best of all. Correspondents all have portable tape recorders."
                            },
                            {
                                "example_id": "93a3cf0f-13a7-4ef0-bba1-f2e248fec69d",
                                "sense_id": "3f3b2de6-8376-3493-a497-c7213ac53e96",
                                "text": "This is a news report from the scene of the event. When a voicer and an actuality are combined into one complete story, it's known as a wrap."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2ad9ea1-8238-3645-b463-8ee7070484d6",
                        "entry_id": "d03fafb9-3119-3580-ae86-c34c18060965",
                        "glosses": [
                            "A short early motion picture."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e19e40a6-266f-4aab-a996-10d64817b37d",
                                "sense_id": "e2ad9ea1-8238-3645-b463-8ee7070484d6",
                                "text": "By 1903, the actuality film had reached its peak; in 1903, the Edison and Biograph companies, combined, registered three hundred fifty one actuality films for copyright protection. By 1908 that number had dropped to two."
                            }
                        ]
                    }
                ],
