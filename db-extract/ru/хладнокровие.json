                "translations": [
                    {
                        "translation_id": "f967d9ea-283e-4dc0-8871-65058ad32e68",
                        "source_entry_id": "7d1a56fb-e786-3cbf-94db-d6336a071153",
                        "source_sense_id": "975bad5b-9cc5-3c99-8cb4-e2fe06c094fa",
                        "target_lang_word": "cold-bloodedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
