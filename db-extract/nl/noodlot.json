                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "64e21f64-960c-39d6-8c1c-c837a83942d6",
                        "entry_id": "730de03b-0a3f-32b7-bdbc-5148bb9658d6",
                        "glosses": [
                            "fate, destiny"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "893da18c-ffbe-4654-a994-18dd5f6f6649",
                                "sense_id": "64e21f64-960c-39d6-8c1c-c837a83942d6",
                                "text": "Maar de gedachte van een noodlot, een blind werkende kracht, waaraan zowel het bestel der wereld als het leven van de mens onderworpen zouden zijn, is een voorstelling uit het Heidendom en volkomen in strijd met de leer van den almachtigen en persoonlijken God van de Islām."
                            },
                            {
                                "example_id": "f5bfdd66-cc1d-40e1-a13e-54e9ac58a7bf",
                                "sense_id": "64e21f64-960c-39d6-8c1c-c837a83942d6",
                                "text": "Het noodlot van het ethische systeem, gepersonaliseerd in de figuur van Creon, staat in een scherp conflict met haar vrije gewetensovertuiging het lijk van haar broer Eteocles te moeten begraven."
                            },
                            {
                                "example_id": "daa26cc3-2f47-4e48-a892-c4187aad9315",
                                "sense_id": "64e21f64-960c-39d6-8c1c-c837a83942d6",
                                "text": "Heb je het gevoel dat jij je gedrag zelf stuurt? Of heb je het gevoel dat het van buiten gestuurd wordt (het noodlot, de anderen, de maatschappij, de omstandigheden, enzovoort)?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9f2a8f0a-69c4-3606-be5b-ea94b0988d7d",
                        "entry_id": "730de03b-0a3f-32b7-bdbc-5148bb9658d6",
                        "glosses": [
                            "disastrous fate"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e41da5e6-2a68-4fa4-b3c7-f0afe6fb0e49",
                                "sense_id": "9f2a8f0a-69c4-3606-be5b-ea94b0988d7d",
                                "text": "Elswyth die zoals altijd ongeduldig was geworden en haar noodlot tegemoet was gegaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd2fbd2a-9b5c-3101-8c08-11385675f7ef",
                        "entry_id": "730de03b-0a3f-32b7-bdbc-5148bb9658d6",
                        "glosses": [
                            "bad luck, misfortune"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d9514ec5-3f90-43b1-b091-daf427f1d555",
                                "sense_id": "dd2fbd2a-9b5c-3101-8c08-11385675f7ef",
                                "text": "Binnen vijf minuten sloeg het noodlot toe bij Kompany, die sinds hij medio 2008 voor City tekende al dertien keer (!) eerder met een kuitblessure kampte."
                            }
                        ]
                    }
                ],
