                ],
                "senses": [
                    {
                        "sense_id": "4e6a59cb-869e-3597-aa61-4a18b0dac3e1",
                        "entry_id": "f38f1d77-226a-32e1-b893-dc2d0604ffdb",
                        "glosses": [
                            "weibliche Person, die so krank oder verletzt (siehe auch: sterbenskrank) ist, dass sie in wenigen Stunden oder Tagen sterben (= das Leben beenden, ableben) wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba00aba7-80d6-4d1e-b79e-ea6915d575b7",
                                "sense_id": "4e6a59cb-869e-3597-aa61-4a18b0dac3e1",
                                "text": "„Mit lauter und immer höher werdender Stimme wiederholt die Sterbende unter dem Steinhagel das muslimische Glaubensbekenntnis.“"
                            },
                            {
                                "example_id": "fb5d48a8-be89-4cd6-8fcd-7ebff04fc022",
                                "sense_id": "4e6a59cb-869e-3597-aa61-4a18b0dac3e1",
                                "text": "„Mehrere Monate lang besuchen [drei junge Schauspieler] Menschen auf der Schwelle zum Tod: eine Todkranke in ihrer Wohnung, eine Sterbende in einem Hospiz, einen Hochbetagten in einem Altenheim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
