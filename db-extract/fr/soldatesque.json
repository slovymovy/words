        "fr-extract.jsonl": [
            {
                "entry_id": "1b01ceff-4474-3258-aeb1-624cebcbd6c3",
                "word": "soldatesque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cad0992a-aefd-4aa0-91c1-a14070b57a81",
                        "entry_id": "1b01ceff-4474-3258-aeb1-624cebcbd6c3",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "soldatesques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66d3a9eb-ebe6-38e8-a008-9dc1dcbdac8a",
                        "entry_id": "1b01ceff-4474-3258-aeb1-624cebcbd6c3",
                        "glosses": [
                            "Relatif aux soldats."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "96eb16de-2dcb-4464-a750-c53b1f1d71f3",
                                "sense_id": "66d3a9eb-ebe6-38e8-a008-9dc1dcbdac8a",
                                "text": "C’est de lui que le maréchal Lannes disait trente ans plus tard, avec un esprit soldatesque: « Si, pendant qu’il vous parle, son derrière venait à recevoir un coup de pied, sa figure ne vous en dirait rien. »"
                            },
                            {
                                "example_id": "841ca359-edff-4f55-8962-2f0c77fa1494",
                                "sense_id": "66d3a9eb-ebe6-38e8-a008-9dc1dcbdac8a",
                                "text": "Ces étudiantes national-socialistes cent pour cent affichent volontiers une allure soldatesque qui contraste, étrangement, avec leur pruderie réelle et touchante."
                            },
                            {
                                "example_id": "fb4714b1-38c6-4994-9489-427d9ef0d373",
                                "sense_id": "66d3a9eb-ebe6-38e8-a008-9dc1dcbdac8a",
                                "text": "Mais l’argot soldatesque et civil nous fourniraient une profusion d’exemples d’une verdeur encore plus significative."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ccd8379-216f-439f-9d7e-25cc8bbbb24a",
                        "source_entry_id": "1b01ceff-4474-3258-aeb1-624cebcbd6c3",
                        "source_sense_id": "66d3a9eb-ebe6-38e8-a008-9dc1dcbdac8a",
