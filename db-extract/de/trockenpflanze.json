                "senses": [
                    {
                        "sense_id": "ba306e5a-ec81-3682-8fac-efaf81dc3536",
                        "entry_id": "293e068f-92b5-3fbe-8d3d-05c758c1ff5d",
                        "glosses": [
                            "Pflanze, die an Trockenheit angepasst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad85377-b0ca-455e-95dd-e8b86275af3a",
                                "sense_id": "ba306e5a-ec81-3682-8fac-efaf81dc3536",
                                "text": "„Sie ist eine typische Trockenpflanze, das heisst sie ist an extrem trockene Standorte angepasst.“"
                            },
                            {
                                "example_id": "6c8dd1dd-b0c4-4512-820c-2a804425ad49",
                                "sense_id": "ba306e5a-ec81-3682-8fac-efaf81dc3536",
                                "text": "„Diese weite Verbreitung der Kiefer und ihre Beschränkung auf ungünstige Böden ist überaus charakteristisch, weil die Kiefer eine Xerophile, eine Trockenpflanze ist.“"
                            },
                            {
                                "example_id": "591fdaa6-29a9-4764-9cd6-f8a954d9becb",
                                "sense_id": "ba306e5a-ec81-3682-8fac-efaf81dc3536",
                                "text": "„Die Kiefer ist eine Trockenpflanze, ihr ist es oben im Bereich der naßkalten Winde zu feucht!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
