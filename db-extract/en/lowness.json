                                                "sense_id": "386e7238-bf90-3f0c-be2f-69dccad325e7",
                                                "text": "Romie Esteves (Rosina) paart zwoele laagte aan heldere hoogte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc9224d-53a9-34ea-992b-deb7d70c7a22",
