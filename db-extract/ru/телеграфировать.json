                "senses": [
                    {
                        "sense_id": "379c65e8-fa69-3a01-9557-fbbcbc0c8a29",
                        "entry_id": "129ae7b5-c292-3158-b4cc-df10a621e2d1",
                        "glosses": [
                            "передавать (передать) при помощи телеграфа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52648e96-0e6b-4455-ae3c-713fa35d6030",
                                "sense_id": "379c65e8-fa69-3a01-9557-fbbcbc0c8a29",
                                "text": "С Кипра должны телеграфировать лично генералу Королькову и сообщить ему цифровой код вклада на предъявителя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a30c81ee-b645-4cc2-a278-4ced221e3553",
                        "source_entry_id": "129ae7b5-c292-3158-b4cc-df10a621e2d1",
                        "source_sense_id": "379c65e8-fa69-3a01-9557-fbbcbc0c8a29",
                        "target_lang_word": "telegraph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telegraph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75b5e997-ff22-3427-ad92-b8d1616e2531",
                                        "entry_id": "04c3de46-6183-352e-aa32-d51ab5ab4e5f",
                                        "glosses": [
                                            "Synonym of telegraphy, any process for transmitting arbitrarily long messages over a long distance using a symbolic code."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8c09dc-1b60-41ac-8da4-2c7a6125ef7a",
                                                "sense_id": "75b5e997-ff22-3427-ad92-b8d1616e2531",
                                                "text": "This strict sense of telegraph developed from French usage for Napoleon's overland semaphore network but rather arbitrarily excludes similar Chinese and other signalling networks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d6f9e51-0bca-3257-b216-ea897b384b65",
                                        "entry_id": "04c3de46-6183-352e-aa32-d51ab5ab4e5f",
                                        "glosses": [
                                            "The electrical device gradually developed in the early 19th century to transmit messages (telegrams) using Morse code; the entire system used to transmit its messages including overhead lines and transoceanic cables."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9038429b-99e1-44f6-8db2-cbe2d05cca1b",
                                                "sense_id": "7d6f9e51-0bca-3257-b216-ea897b384b65",
                                                "text": "The first message transmitted by telegraph in the United States was WHAT HATH GOD WROUGHT."
                                            },
                                            {
                                                "example_id": "4596edbe-b222-4ea3-abf5-f3d01c9e20d6",
                                                "sense_id": "7d6f9e51-0bca-3257-b216-ea897b384b65",
                                                "text": "The Bat—they called him the Bat.[…]. He[…]played a lone hand,[…]. Most lone wolves had a moll at any rate—women were their ruin—but if the Bat had a moll, not even the grapevine telegraph could locate her."
                                            },
                                            {
                                                "example_id": "c0d3f0d1-118c-4499-87b6-f88b5e73d8c9",
                                                "sense_id": "7d6f9e51-0bca-3257-b216-ea897b384b65",
                                                "text": "The middle-class families celebrated by Kipling, the prolific lowbrow families whose sons officered the army and navy and swarmed over all the waste places of the earth from the Yukon to the Irrawaddy, were dwindling before 1914. The thing that had killed them was the telegraph. In a narrowing world, more and more governed from Whitehall, there was every year less room for individual initiative... By 1920 nearly every inch of the colonial empire was in the grip of Whitehall. Well-meaning, over-civilized men, in dark suits and black felt hats, with neatly rolled umbrellas crooked over the left forearm, were imposing their constipated view of life on Malaya and Nigeria, Mombasa and Mandalay."
                                            },
                                            {
                                                "example_id": "cdfc88a6-9d14-4ed4-981f-a97a2c2c1f63",
                                                "sense_id": "7d6f9e51-0bca-3257-b216-ea897b384b65",
                                                "text": "When a train has to ascend the incline, it first runs down, engine first, from the station about 60 or 70 yards. Then comes behind it the aforesaid truck, or one similar, which, being attached to an endless wire rope, a communication is made by means of the electric telegraph to the engineman at the top of the incline, when the fixed engine begins to work, and the train, partly pulled by the locomotive before, and partly pushed by the truck behind, rapidly ascends, taking somewhere about three minutes to get up."
                                            },
                                            {
                                                "example_id": "96f2e2c0-ec82-4d3f-88e9-bde015b87e83",
                                                "sense_id": "7d6f9e51-0bca-3257-b216-ea897b384b65",
                                                "text": "“Despite the current furore over hacking, which is only a modern term for bugging, eavesdropping, signals intercept, listening-in, tapping, monitoring, there has never been guaranteed privacy since the earliest optical telegraphs to today’s internet,” Packer says. “There never was and never will be privacy.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8a5377-4c85-3aca-8d95-4a7cb67cc404",
                                        "entry_id": "04c3de46-6183-352e-aa32-d51ab5ab4e5f",
                                        "glosses": [
                                            "A visible or audible cue that indicates to an opponent the action that a character is about to take."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "telegraph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aaae8943-2173-3758-b41e-dbd176de79bb",
                                        "entry_id": "e08c9c68-d9c4-39d6-b470-1a1adb8e84e6",
                                        "glosses": [
                                            "To use a telegraph, send a message by telegraph."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1785aad3-4582-4fd6-855d-f2ba5400b6c9",
                                                "sense_id": "aaae8943-2173-3758-b41e-dbd176de79bb",
                                                "text": "Whenever this portent occurs, my steward telegraphs to me, that I, as head of the family, be not unsteeled against the shock of a bereavement […]"
                                            },
                                            {
                                                "example_id": "d2430296-5fe3-4ea3-b952-a1910f1f6ede",
                                                "sense_id": "aaae8943-2173-3758-b41e-dbd176de79bb",
                                                "text": "In \"The Boscombe Valley Mystery,\" Sherlock Holmes telegraphs Watson: \"Have you a couple of days to spare? Have just been wired for from the West of England in connection with Boscombe Valley tragedy. […].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59a55d0e-a701-39dd-8d85-78b238d1a4d4",
                                        "entry_id": "e08c9c68-d9c4-39d6-b470-1a1adb8e84e6",
                                        "glosses": [
                                            "To clearly communicate to another nonverbally, whether by gesture, a change in attitude, or any other sign, especially unintentionally."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91837f0b-e8f7-4ad0-8dbd-29f0868abe11",
                                                "sense_id": "59a55d0e-a701-39dd-8d85-78b238d1a4d4",
                                                "text": "Her frown telegraphed her displeasure."
                                            },
                                            {
                                                "example_id": "46b10eac-2255-4a12-a669-81237afb4694",
                                                "sense_id": "59a55d0e-a701-39dd-8d85-78b238d1a4d4",
                                                "text": "He took a jab and telegraphed his punch so loudly that I was able to land a solid right hand to his stomach."
                                            },
                                            {
                                                "example_id": "cd1d8002-6d5a-4312-b31e-af0bb7b27de5",
                                                "sense_id": "59a55d0e-a701-39dd-8d85-78b238d1a4d4",
                                                "text": "The trip was the latest step in a broader transformation of Mr. Putin that has become apparent in recent weeks. He is telegraphing a shift away from wartime crisis mode back toward the aura of a calm, paternalistic leader shielding Russians from the dangers of the world."
                                            },
                                            {
                                                "example_id": "dcf44faa-31b0-463a-8b1c-97bbe9b046dd",
                                                "sense_id": "59a55d0e-a701-39dd-8d85-78b238d1a4d4",
                                                "text": "For weeks, Ukrainian officials had telegraphed plans for a planned counterattack in the southern Kherson region, but instead the main focus of this week’s counterattack has been Kharkiv in the north-east, taking everyone, including apparently the Russians, by surprise."
                                            },
                                            {
                                                "example_id": "1b990672-6e7d-43b5-b735-0af628228f01",
                                                "sense_id": "59a55d0e-a701-39dd-8d85-78b238d1a4d4",
                                                "text": "Sergey Radchenko, a professor at the Johns Hopkins University School of Advanced International Studies, said China appeared to telegraph “a reproach to the Russians, that they’re not acting like a great power, that they are creating instability.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
