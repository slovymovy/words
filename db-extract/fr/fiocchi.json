                "forms": [],
                "senses": [
                    {
                        "sense_id": "c840c4ee-2c88-3891-89c3-43b6ab326880",
                        "entry_id": "7fddd245-cfc7-3bea-a336-9b6c1f64a877",
                        "glosses": [
                            "Houppe, vêtu de façon huppée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f63ab88d-01f1-4895-97e9-4b2ad0f61c5e",
                                "sense_id": "c840c4ee-2c88-3891-89c3-43b6ab326880",
                                "text": "Être in fiocchi, être en costume d'apparat, porter tous ses atours."
                            },
                            {
                                "example_id": "bae6cef4-1a1b-438a-9762-baa18842f867",
                                "sense_id": "c840c4ee-2c88-3891-89c3-43b6ab326880",
                                "text": "[…] je crois que la superbe Tanville aura plus de chagrin à ma première visite, où je compte bien la demander, qu'elle n'a cru nous en faire toutes les fois qu'elle est venue nous voir in fiocchi."
                            },
                            {
                                "example_id": "a62f44bd-65e3-4959-a5e2-03d0fd568555",
                                "sense_id": "c840c4ee-2c88-3891-89c3-43b6ab326880",
                                "text": "Il gardait sous la remise une voiture, où sur les panneaux étaient peints les deux bâtons en sautoir, et il louait des chevaux quand il devait aller in fiocchi, soit au ministère, soit au château, dans une cérémonie ou à quelque fête."
                            },
                            {
                                "example_id": "c462cb4f-f831-4e6b-bb74-16b1f6c6011b",
                                "sense_id": "c840c4ee-2c88-3891-89c3-43b6ab326880",
                                "text": "Dans l’espérance de séduire le capitaine Fracasse, des dames de la ville s’étaient mises sous les armes, et comme on dit à Rome, in fiocchi."
                            }
                        ]
                    }
                ],
