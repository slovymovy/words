{
    "word_family": [
        "clumpy",
        "clumpiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89c81080-92c8-361a-b3a0-a65347504c74",
                    "sense_definition": "A cluster or unshaped mass of material.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry soil formed a hard <w>clump</w> in the middle of the garden.",
                            "target_lang_translations": {
                                "zh": "干燥的土壤在花园中间形成了一个坚硬的<w>团</w>。",
                                "ru": "Сухая почва образовала твёрдый <w>ком</w> посреди сада."
                            }
                        },
                        {
                            "text": "She found a <w>clump</w> of mud stuck to her shoe after the walk.",
                            "target_lang_translations": {
                                "zh": "散步后，她发现鞋子上粘着一<w>块</w>泥。",
                                "ru": "После прогулки она обнаружила, что к её ботинку прилип <w>ком</w> грязи."
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "lump",
                        "mass"
                    ],
                    "common_phrases": [
                        "clump of mud"
                    ],
                    "target_lang_definitions": {
                        "zh": "物质形成的团块或堆积物。",
                        "ru": "Скопление или бесформенная масса какого-либо вещества."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "团",
                                "target_lang_sense_clarification": "指成团的物质"
                            },
                            {
                                "target_lang_word": "块",
                                "target_lang_sense_clarification": "指成块的物质"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ком",
                                "target_lang_sense_clarification": "о комке мягкого или рыхлого вещества, например земли или грязи"
                            },
                            {
                                "target_lang_word": "комок",
                                "target_lang_sense_clarification": "о бесформенном куске вещества"
                            },
                            {
                                "target_lang_word": "глыба",
                                "target_lang_sense_clarification": "о более крупной массе вещества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20984fa1-d94d-340e-b235-2d0912f4cf2b",
                    "sense_definition": "A thick group or bunch of plants or hair.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat under a large <w>clump</w> of trees to escape the sun.",
                            "target_lang_translations": {
                                "zh": "我们坐在大<w>丛</w>树下躲避阳光。",
                                "ru": "Мы сели под большой <w>группой</w> деревьев, чтобы укрыться от солнца."
                            }
                        },
                        {
                            "text": "A small <w>clump</w> of flowers grew near the old stone wall.",
                            "target_lang_translations": {
                                "zh": "老石墙边长着一<w>簇</w>小花。",
                                "ru": "Возле старой каменной стены рос небольшой <w>кустик</w> цветов."
                            }
                        }
                    ],
                    "synonyms": [
                        "bunch",
                        "cluster",
                        "thicket"
                    ],
                    "common_phrases": [
                        "clump of trees"
                    ],
                    "target_lang_definitions": {
                        "zh": "植物或毛发的丛或簇。",
                        "ru": "Густая группа или пучок растений, волос и т. п."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丛",
                                "target_lang_sense_clarification": "指聚集在一起的植物"
                            },
                            {
                                "target_lang_word": "簇",
                                "target_lang_sense_clarification": "指聚集在一起的毛发或花朵"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "заросли",
                                "target_lang_sense_clarification": "о группе деревьев, кустов или другой растительности"
                            },
                            {
                                "target_lang_word": "клок",
                                "target_lang_sense_clarification": "о пучке волос, шерсти и т. п."
                            },
                            {
                                "target_lang_word": "кустик",
                                "target_lang_sense_clarification": "о компактно растущих цветах или растениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b10158b-7f71-3647-96bd-4f12291a95c4",
                    "sense_definition": "A dull, heavy sound of impact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy book hit the floor with a loud <w>clump</w>.",
                            "target_lang_translations": {
                                "zh": "那本厚重的书掉在地上，发出<w>咚</w>的一声。",
                                "ru": "Тяжёлая книга с громким <w>глухим стуком</w> упала на пол."
                            }
                        },
                        {
                            "text": "I heard the <w>clump</w> of boots walking down the hallway.",
                            "target_lang_translations": {
                                "zh": "我听见走廊里传来靴子<w>咚咚</w>的脚步声。",
                                "ru": "Я услышал <w>глухой топот</w> сапог в коридоре."
                            }
                        }
                    ],
                    "synonyms": [
                        "thud",
                        "thump"
                    ],
                    "target_lang_definitions": {
                        "zh": "沉重而沉闷的撞击声。",
                        "ru": "Глухой, тяжёлый звук удара или падения."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咚",
                                "target_lang_sense_clarification": "拟声词，形容沉重的撞击声"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "глухой стук",
                                "target_lang_sense_clarification": "глухой тяжёлый звук удара"
                            },
                            {
                                "target_lang_word": "грохот",
                                "target_lang_sense_clarification": "звук тяжёлого падения или удара"
                            },
                            {
                                "target_lang_word": "топот",
                                "target_lang_sense_clarification": "о частых тяжёлых шагах или ударах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5146b5-a3b1-348f-a144-1873fafdca93",
                    "sense_definition": "A thick piece added to the sole of a shoe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shoe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler added a leather <w>clump</w> to the worn-out sole.",
                            "target_lang_translations": {
                                "zh": "鞋匠在磨损的鞋底上加了一块皮革<w>鞋掌</w>。",
                                "ru": "Сапожник прикрепил кожаную <w>набoйку</w> к изношенной подошве."
                            }
                        },
                        {
                            "text": "These boots have a thick <w>clump</w> for better grip on ice.",
                            "target_lang_translations": {
                                "zh": "这些靴子有厚实的<w>鞋掌</w>，在冰面上抓地力更好。",
                                "ru": "У этих ботинок толстая <w>набойка</w> для лучшего сцепления на льду."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "加在鞋底上的厚垫。",
                        "ru": "Толстая деталь, добавляемая к подошве обуви."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鞋掌",
                                "target_lang_sense_clarification": "指修补鞋底用的厚垫"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "набoйка",
                                "target_lang_sense_clarification": "деталь, прикрепляемая к подошве обуви для защиты или ремонта"
                            },
                            {
                                "target_lang_word": "подмётка",
                                "target_lang_sense_clarification": "толстая часть подошвы; менее точное соответствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "976eedd2-8796-3799-9a5a-e0a389d587e1",
                    "sense_definition": "Compressed clay found in coal strata.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners encountered a layer of <w>clump</w> while digging.",
                            "target_lang_translations": {
                                "zh": "矿工在挖掘时遇到了一层<w>硬粘土</w>。",
                                "ru": "Во время работы шахтёры наткнулись на слой <w>плотной глины</w>."
                            }
                        },
                        {
                            "text": "The <w>clump</w> was removed before the coal could be extracted.",
                            "target_lang_translations": {
                                "zh": "在开采煤炭之前，这层<w>硬粘土</w>被移除了。",
                                "ru": "Этот <w>слой плотной глины</w> убрали перед добычей угля."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "煤层中发现的压缩粘土。",
                        "ru": "Сжатая глина, встречающаяся в угольных пластах."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "硬粘土",
                                "target_lang_sense_clarification": "地质学中指煤层间的压缩粘土"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "плотная глина",
                                "target_lang_sense_clarification": "геологический термин: плотная глина в угольных пластах"
                            },
                            {
                                "target_lang_word": "сжатая глина",
                                "target_lang_sense_clarification": "специализированное геологическое соответствие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97905510-fc37-3f99-b54a-dc5f151871ac",
                    "sense_definition": "To gather together in dense groups.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students began to <w>clump</w> together near the entrance.",
                            "target_lang_translations": {
                                "zh": "学生们开始在入口附近<w>聚集</w>起来。",
                                "ru": "Студенты начали <w>сбиваться</w> в тесную группу у входа."
                            }
                        },
                        {
                            "text": "Sheep often <w>clump</w> in the corner of the field during storms.",
                            "target_lang_translations": {
                                "zh": "暴风雨期间，羊群经常在田野的角落里<w>聚拢</w>。",
                                "ru": "Во время бури овцы часто <w>сбиваются</w> в углу поля."
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "gather",
                        "bunch"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "target_lang_definitions": {
                        "zh": "聚集在一起形成密集的群体。",
                        "ru": "Собираться вместе в плотную, тесную группу."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "聚集",
                                "target_lang_sense_clarification": "指人或动物聚在一起"
                            },
                            {
                                "target_lang_word": "聚拢",
                                "target_lang_sense_clarification": "指物体或群体向中心靠拢"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сбиваться в кучу",
                                "target_lang_sense_clarification": "о людях или животных, собирающихся тесной группой"
                            },
                            {
                                "target_lang_word": "сгрудиться",
                                "target_lang_sense_clarification": "становиться плотной группой"
                            },
                            {
                                "target_lang_word": "скучиваться",
                                "target_lang_sense_clarification": "нейтрально: собираться вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1ed83c7-97d6-3b26-bd4b-1dbce536deb8",
                    "sense_definition": "To walk with heavy, noisy footfalls.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started to <w>clump</w> up the wooden stairs in his heavy boots.",
                            "target_lang_translations": {
                                "zh": "他穿着沉重的靴子，<w>重重地走</w>上了木楼梯。",
                                "ru": "Он начал <w>тяжело топать</w> вверх по деревянной лестнице в своих тяжёлых сапогах."
                            }
                        },
                        {
                            "text": "The giant began to <w>clump</w> across the floor.",
                            "target_lang_translations": {
                                "zh": "巨人开始<w>重重地走</w>过地板。",
                                "ru": "Великан начал <w>тяжело топать</w> по полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "stomp",
                        "trudge"
                    ],
                    "common_phrases": [
                        "clump up stairs"
                    ],
                    "target_lang_definitions": {
                        "zh": "脚步沉重且嘈杂地行走。",
                        "ru": "Идти с тяжёлыми, шумными шагами."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重重地走",
                                "target_lang_sense_clarification": "形容脚步沉重"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "топать",
                                "target_lang_sense_clarification": "идти тяжело и шумно"
                            },
                            {
                                "target_lang_word": "громыхать",
                                "target_lang_sense_clarification": "идти с тяжёлыми шагами"
                            },
                            {
                                "target_lang_word": "тяжело шагать",
                                "target_lang_sense_clarification": "подчёркивает тяжёлую поступь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05ea9c85-15dd-382a-8356-0465cb52a004",
                    "sense_definition": "To form into clusters or lumps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flour will <w>clump</w> if you add water too quickly.",
                            "target_lang_translations": {
                                "zh": "如果加水太快，面粉就会<w>结块</w>。",
                                "ru": "Мука <w>собьётся в комки</w>, если слишком быстро добавить воду."
                            }
                        },
                        {
                            "text": "Stir the sauce constantly so the ingredients do not <w>clump</w>.",
                            "target_lang_translations": {
                                "zh": "不断搅拌酱汁，以免配料<w>结块</w>。",
                                "ru": "Постоянно помешивай соус, чтобы ингредиенты не <w>слипались в комки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "coagulate",
                        "congeal"
                    ],
                    "target_lang_definitions": {
                        "zh": "形成团块或凝结在一起。",
                        "ru": "Образовывать комки или слипаться в плотные сгустки."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "结块",
                                "target_lang_sense_clarification": "指粉末或液体凝结成块"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сбиваться в комки",
                                "target_lang_sense_clarification": "о муке, порошке, соусе и т. п."
                            },
                            {
                                "target_lang_word": "комковаться",
                                "target_lang_sense_clarification": "образовывать комки"
                            },
                            {
                                "target_lang_word": "слипаться",
                                "target_lang_sense_clarification": "слипаться, образуя плотные куски"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c852dd3-9177-3556-ba36-24038252b729",
                    "sense_definition": "To strike or beat someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully threatened to <w>clump</w> him if he did not leave.",
                            "target_lang_translations": {
                                "zh": "那个恶霸威胁说，如果他不离开就<w>猛击</w>他。",
                                "ru": "Хулиган пригрозил <w>врезать</w> ему, если он не уйдёт."
                            }
                        },
                        {
                            "text": "He was angry enough to <w>clump</w> the table with his fist.",
                            "target_lang_translations": {
                                "zh": "他气得用拳头<w>猛击</w>桌子。",
                                "ru": "Он был так зол, что готов был <w>грохнуть</w> кулаком по столу."
                            }
                        }
                    ],
                    "synonyms": [
                        "hit",
                        "strike",
                        "thump"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "击打或殴打某人。",
                        "ru": "Ударить или избить кого-либо; разговорное употребление."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "指用力击打"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "разг. сильно ударить"
                            },
                            {
                                "target_lang_word": "треснуть",
                                "target_lang_sense_clarification": "ударить с силой"
                            },
                            {
                                "target_lang_word": "грохнуть",
                                "target_lang_sense_clarification": "сильно стукнуть или грохнуть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}