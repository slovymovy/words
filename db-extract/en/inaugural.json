                ],
                "senses": [
                    {
                        "sense_id": "dc1fe34d-dd35-3d4a-b255-5db3e824dbd0",
                        "entry_id": "c8fd8b50-2b60-3558-af22-7c6c06b0e8d3",
                        "glosses": [
                            "An inauguration; a formal beginning."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4892491f-3b6a-477f-8e7f-e0c211637985",
                                "sense_id": "dc1fe34d-dd35-3d4a-b255-5db3e824dbd0",
                                "text": "The inaugural of the President will take place in March."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ea09ee8-c559-36cb-9fa6-c7dfe159952b",
                        "entry_id": "c8fd8b50-2b60-3558-af22-7c6c06b0e8d3",
                        "glosses": [
                            "A formal speech given at the beginning of an office."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaec281e-e00f-4417-a7c6-8b98688de46a",
                                "sense_id": "1ea09ee8-c559-36cb-9fa6-c7dfe159952b",
                                "text": "In his inaugural, President Obama proclaimed 'an end to the petty grievances and false promises, the recriminations and worn-out dogmas, that for far too long have strangled our politics'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c39f54ce-dcec-40f4-bbb8-cddd1ca8547f",
                        "source_entry_id": "c8fd8b50-2b60-3558-af22-7c6c06b0e8d3",
                        "source_sense_description": "an inauguration",
                        "target_lang_word": "investiture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investiture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                                        "entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                                        "glosses": [
                                            "Acte par lequel on investit quelqu’un d’un titre ou d’une dignité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0ffbdb5-5a71-4ffb-8ea1-2c4df8c03b33",
                                                "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                                                "text": "Ce n'était pas sans une vive appréhension que le Grand Orient se voyait imposer un Grand Maitre absolument étranger à la Maçonnerie et qui ne devint Maçon qu'après sa haute investiture."
                                            },
                                            {
                                                "example_id": "23969ced-a2ec-48d6-aa27-46e6661e3704",
                                                "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                                                "text": "La Vieille-Ville était aussi le théâtre des cérémonies grandioses comme l'entrée du duc de Lorraine arrivant par la porte de la Craffe et prêtant serment avant son investiture."
                                            },
                                            {
                                                "example_id": "4971cc7a-1ea6-4b0f-bda8-0a3d7336485b",
                                                "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                                                "text": "Loin de mettre un terme à leur différend, l’investiture de Bédié comme président de la République consacra plutôt une rupture entre les deux hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6217790-edd9-3889-a8c8-332b90450735",
                                        "entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                                        "glosses": [
                                            "Acte par lequel un parti politique soutient un candidat ou une candidate à une élection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdef52cf-02f2-47ce-a66d-78ee850e9e43",
                                                "sense_id": "b6217790-edd9-3889-a8c8-332b90450735",
                                                "text": "Depuis plusieurs semaines, Édouard Philippe et son entourage travaillaient à leur ralliement. Les investitures du parti présidentiel sabotent cette manœuvre destinée à aligner des candidats solides, plus proches du Premier ministre que des caciques de LREM canal historique ou venus du PS."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da3e71ee-7f77-4c15-bd29-982bf13e991e",
                        "source_entry_id": "c8fd8b50-2b60-3558-af22-7c6c06b0e8d3",
                        "source_sense_description": "an inauguration",
                        "target_lang_word": "inauguration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inauguration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13b97f1a-b21f-31b8-ab4f-4e4724355da4",
                                        "entry_id": "db2b55a9-d324-3b31-8955-7f525a8470d8",
                                        "glosses": [
                                            "Action d’inaugurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0843dd4b-9bc5-4150-894a-e513a67fbf10",
                                                "sense_id": "13b97f1a-b21f-31b8-ab4f-4e4724355da4",
                                                "text": "Nous avons mentionné sommairement, hier, l’inauguration du monument élevé à Mézières-sous-Bellegarde, par l'initiative de la municipalité et avec le concours du Souvenir français, à la mémoire des combattants des 24 et 30 novembre 1870."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4735f5b5-9ba4-3c67-9f1a-370badc2741a",
                                        "entry_id": "db2b55a9-d324-3b31-8955-7f525a8470d8",
                                        "glosses": [
                                            "Sacre ; couronnement d'un souverain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35de9b58-d85a-4715-b804-252d2ca27a6b",
                                                "sense_id": "4735f5b5-9ba4-3c67-9f1a-370badc2741a",
                                                "text": "Chaque année, les chanoinesses élisaient entre elles la bâtonnière, dont les fonctions consistaient à porter les insignes du chapitre noble, dans les processions générales et à l’inauguration du souverain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a429f6f6-52bb-3b82-9511-f3cf9bb01cc5",
                                        "entry_id": "db2b55a9-d324-3b31-8955-7f525a8470d8",
                                        "glosses": [
                                            "Intronisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df771f94-edf0-4686-89e9-fc0db1d5e301",
                                                "sense_id": "a429f6f6-52bb-3b82-9511-f3cf9bb01cc5",
                                                "text": "Comme approchait le jour de l'inauguration du nouveau président, le désordre, la crainte et la misère étendaient leur empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
