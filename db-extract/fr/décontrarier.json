                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4df0084-85fa-4f1b-a587-37d860f97bcb",
                                "sense_id": "139cce7f-18d8-3991-93a9-f85f5d62acac",
                                "text": "pense à tes petits enfants...ça va te \"décontrarier\" !!!"
                            },
                            {
                                "example_id": "8ebbce6a-9abd-4521-9f31-96fa238cb1ca",
                                "sense_id": "139cce7f-18d8-3991-93a9-f85f5d62acac",
                                "text": "Si quelqu’un a une explication, merci de me décontrarier."
                            },
                            {
                                "example_id": "f0a2bbb6-4714-4ebb-8dea-fcb3ef7ed3ae",
                                "sense_id": "139cce7f-18d8-3991-93a9-f85f5d62acac",
                                "text": "Bon, il va falloir songer à se « décontrarier »…"
                            },
                            {
                                "example_id": "5b478c68-7aed-4b58-b3b9-94a5e4114654",
                                "sense_id": "139cce7f-18d8-3991-93a9-f85f5d62acac",
                                "text": "c’est l’heure de l'apéro, je vais aller me \"décontrarier\" un peu !"
                            },
                            {
                                "example_id": "8a9f5fa4-afbf-4e31-bda6-3187bbf65022",
                                "sense_id": "139cce7f-18d8-3991-93a9-f85f5d62acac",
                                "text": "Vous devriez vous \"décontrarier\", toutes ces petites crises accumulées, ce n’est jamais très bon dans la durée…!!"
                            }
                        ]
                    }
