                    {
                        "sense_id": "a7ee34b1-19ac-32e8-965f-77dd55269de5",
                        "entry_id": "68105e01-d313-3eff-bb64-8edff7c2645a",
                        "glosses": [
                            "Alliance militaire entre deux ou plusieurs villes ou cités-États grecques, notamment durant la Ligue de Délos."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "22a7c79a-20a7-4028-bd3e-25c787d4131b",
                                "sense_id": "a7ee34b1-19ac-32e8-965f-77dd55269de5",
                                "text": "Il semble que la seule obligation des Chalcidiens fut de participer à la symmachie lacédémonienne, ce qui impliquait de suivre la même politique extérieure et de fournir des contingents militaires à l'armée spartiate."
                            },
                            {
                                "example_id": "ad120628-bf89-44c1-8918-9f7fe3580ade",
                                "sense_id": "a7ee34b1-19ac-32e8-965f-77dd55269de5",
                                "text": "La confédération béotienne, à l'inverse des ligues péloponnésiennes ou athéniennes, ne semble pas avoir d'abord été une symmachie, mais bien plutôt se rattacher à ces Koina qui rassemblaient autour d'un sanctuaire les cités d'un même ethnos."
                            }
                        ]
                    }
                ],
