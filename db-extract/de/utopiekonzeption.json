                "senses": [
                    {
                        "sense_id": "0828b5e1-b543-39d9-8afc-5a273b4a9f1d",
                        "entry_id": "47d61c61-b3f2-3a8d-af6a-6ba39ca28c52",
                        "glosses": [
                            "Entwurf, Planung einer fiktiven Lebens- oder Gesellschaftsform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71c90a92-5d95-4526-a4cc-12998ccfe6e0",
                                "sense_id": "0828b5e1-b543-39d9-8afc-5a273b4a9f1d",
                                "text": "„Es wird eine Verbindung zwischen der wirkungsästhetischen Dimension der Gattung Lyrik und der in dieser Studie forcierten Utopiekonzeption erkennbar.“"
                            },
                            {
                                "example_id": "09de7f3d-d712-417f-91a5-decdf7ddee2b",
                                "sense_id": "0828b5e1-b543-39d9-8afc-5a273b4a9f1d",
                                "text": "„Argumentiert man aber von einer festgelegten Utopiekonzeption aus, so wird der Utopiebegriff in jedem Falle in unzulässiger Weise eingeschränkt.“"
                            },
                            {
                                "example_id": "f82d6119-f9e9-4186-9743-ac42109f3f59",
                                "sense_id": "0828b5e1-b543-39d9-8afc-5a273b4a9f1d",
                                "text": "„Er schrieb über Goethes Altersstil, aber mit einer aus Musils Utopiekonzeption gewonnenen Perspektive.“"
                            },
                            {
                                "example_id": "87f426d5-2f6d-4dac-a5ef-42811c454b34",
                                "sense_id": "0828b5e1-b543-39d9-8afc-5a273b4a9f1d",
                                "text": "„Blochs Utopiekonzeption und Utopiegeschichtsschreibung begibt sich damit auch der Möglichkeit einer Kritik des utopischen Überschwangs.“"
                            },
                            {
                                "example_id": "be63b94a-4b1a-4fb0-850a-94fb3081dd66",
                                "sense_id": "0828b5e1-b543-39d9-8afc-5a273b4a9f1d",
                                "text": "„Doch ist der Gesellschaftsentwurf, den Bacon in Nova Atlantis beschreibt, nicht die Pointe seiner Utopiekonzeption.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
