                ],
                "senses": [
                    {
                        "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                        "entry_id": "f8ba67ac-4f0d-3fce-9e12-05c172da6bf9",
                        "glosses": [
                            "Loch zu einem Hohlraum, beispielsweise einer Höhle, einem Tunnel, einer Zisterne, einem Tank, oder auf einem gefrorenen Gewässer, um in diesen Hohlraum oder ins Wasser gelangen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c2ab30-a1e2-4dba-a079-46cbfaa75607",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Die Luft ist kühl und feucht wie in einer echten Grotte. Der Archäologe Jean-Pierre Chadelle zeigt nach oben, zum Einstiegsloch.“"
                            },
                            {
                                "example_id": "1672c281-9ed0-4777-b2ba-f6ab2d2843c0",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Vince Minney ist Abwassertechniker und muss seit 24 Jahren in die Kanäle. In Watstiefeln und Schutzanzug klettert der 54-Jährige durch ein Einstiegsloch in die Eingeweide der Stadt, auf einer Steigleiter geht es sieben Meter in die stinkende Unterwelt.“"
                            },
                            {
                                "example_id": "fa8c3531-d973-497b-967b-a2a740863169",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "[Bankraub:] „Im Kellerboden der Bank war das Einstiegsloch, […].“"
                            },
                            {
                                "example_id": "59f6bbf1-7881-46cb-ba78-f45ce621eb46",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Die Grabungsstelle tarnen sie […], in dem sie eine Kommode […] vor das Einstiegsloch stellen. So haben sie auch weiterhin heimlich Zugang zum Fundort.“"
                            },
                            {
                                "example_id": "00465425-f5c3-4193-8769-0338da33e8d0",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Vorsichtig […] schlängelte sich Duke durch das Einstiegsloch, so wie er es gelernt hatte, […].“"
                            },
                            {
                                "example_id": "33f9cfdd-ae1a-4938-81fa-a4cd1c9242fe",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Gribner sah, dass die Kinder den bewusstlosen Taxifahrer zu diesem Einstiegsloch zogen.“"
                            },
                            {
                                "example_id": "9af011b7-7229-42fc-87bc-bcc6fd18099e",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Schlafmaus-Nistkästen unterscheiden sich deutlich sichtbar in der Bauart [Anmerkung: von Vogelnistkästen]: Das Einstiegsloch befindet sich bei ihnen auf der Rückseite, die zum Baum gewandt ist. So können die kleinen Bewohner am Baumstamm entlang bis in die Kästen hineinklettern.“"
                            },
                            {
                                "example_id": "8c27c1a3-a88e-42fd-a7ba-e8ef16ee2d1c",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Bei einer Temperatur von minus 21 Grad Celsius steigt der Österreicher Dieter Kuchling mit seinem Team in den Tiroler Blindsee. Für den Einstieg sägen die Extremsportler ein großes Einstiegsloch in die Eisdecke.“"
                            },
                            {
                                "example_id": "a0e11f19-6ad7-45bf-a2e7-50ee039f2ef7",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "„Nur schmale Streifen von Sonnenlicht fallen durch das Einstiegsloch in die geheimnisvolle Unterwasserwelt.“"
                            },
                            {
                                "example_id": "2bab5613-14b2-4865-acba-8ed1e03d076a",
                                "sense_id": "8b5e1365-199a-3126-a5d8-545c81cc3634",
                                "text": "[Fischotter:] „Fischreiche Flüsse mit üppiger Ufervegetation braucht der 90 Zentimeter große Raubmarder, der […] auch unter Eis stets sein Einstiegsloch wiederfindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
