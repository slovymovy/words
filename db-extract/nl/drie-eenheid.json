                        "cross_references": [
                            {
                                "target_word": "Trinität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddfe9e62-1376-3732-b361-722decd53eb3",
                                        "entry_id": "d6b06bb7-1d87-33a8-b963-66b50c724786",
                                        "glosses": [
                                            "Beschreibung Gottes, die von der Dreiheit der gleich großen Personen Vater („Gottvater“), Sohn (Jesus Christus) und Heiliger Geist in der Einheit Gottes ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20270faf-82c0-47d7-a131-c3f8b86c3463",
                                                "sense_id": "ddfe9e62-1376-3732-b361-722decd53eb3",
                                                "text": "Die Trinität wird von fast allen christlichen Kirchen vertreten, wenn auch mit unterschiedlicher Akzentuierung."
                                            },
                                            {
                                                "example_id": "bb92bd61-fe77-4406-ac76-01514d7d1a24",
                                                "sense_id": "ddfe9e62-1376-3732-b361-722decd53eb3",
                                                "text": "„Im Gegensatz zur Westkirche vermochte sich ein großer Teil der Ostkirche kaum gegen kaiserliche Interventionen zu wehren. Hier könnte die starke Stellung des Constantius II. aus der Widerspiegelung arianischer Anschauungen mit ihren abgestuften Hierarchien innerhalb der Trinität resultieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a38db492-aba0-48cf-a57b-2ff5b80fc3d4",
                        "source_entry_id": "94278d54-0b94-376c-9241-4fa2e7de1958",
