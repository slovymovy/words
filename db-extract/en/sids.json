                "senses": [
                    {
                        "sense_id": "cdd87b81-d601-3fff-8837-2f6d6a9120bc",
                        "entry_id": "2ce00728-c081-3671-a29b-3b1256ba5407",
                        "glosses": [
                            "sudden infant death syndrom: plötzlicher unerwarteter Tod eines Säuglings, bei dem eine Obduktion keine adäquate Todesursache erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5ce7f2-3bcf-44f2-a30b-11ab76a2005c",
                                "sense_id": "cdd87b81-d601-3fff-8837-2f6d6a9120bc",
                                "text": "The risk to die caused by SIDS is higher if the child has passed ALTE bevor.",
                                "translation": "Das Risiko an SIDS zu sterben ist erhöht, wenn das Kind zuvor Episoden von ALTE durchgemacht hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b584fab0-d90a-3743-a17a-41833b4907e2",
                        "entry_id": "2ce00728-c081-3671-a29b-3b1256ba5407",
                        "glosses": [
                            "small island developing states: kleine Inselstaaten mit geringem Entwicklungsstand"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0074989-5edf-4427-af82-944246dd35f6",
                        "source_entry_id": "2ce00728-c081-3671-a29b-3b1256ba5407",
                        "source_sense_id": "cdd87b81-d601-3fff-8837-2f6d6a9120bc",
                        "target_lang_word": "plötzlicher Kindstod",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plötzlicher Kindstod",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb566c76-7b68-3195-a119-af587431f775",
                                        "entry_id": "e697f1d4-c819-3f21-90dc-2555c1813c6b",
                                        "glosses": [
                                            "plötzlich eintretender Tod eines Säuglings oder Kleinstkindes, bei dem eine Autopsie keine adäquate Todesursache erbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5efeda08-79ef-4b95-bab0-9488589a012c",
                                                "sense_id": "eb566c76-7b68-3195-a119-af587431f775",
                                                "text": "„Die meisten der drei Millionen Kinder, die von schweren Raucherinnen weltweit geboren werden, kommen vorgeschädigt auf die Welt: Durchschnittlich um ein halbes Pfund untergewichtig, mit gebremster Lernfähigkeit, die Rate des Atemnotsyndroms ist bei ihnen verdoppelt, die Häufigkeit des ‚plötzlichen Kindstodes‘ um 50 Prozent erhöht.“"
                                            },
                                            {
                                                "example_id": "6f7bd7fc-6fc9-4732-9fb7-c70fa6e5dc89",
                                                "sense_id": "eb566c76-7b68-3195-a119-af587431f775",
                                                "text": "„Gerichtsmedizinern fiel nichts Ungewöhnliches auf. Sie attestierten den so genannten plötzlichen Kindstod. Beim dritten Fall im vorigen Jahr wurde die Kriminalpolizei Konstanz jedoch stutzig. Sie schöpfte angesichts der Häufung von plötzlichen Kindstoden bei ein- und derselben Mutter Verdacht.“"
                                            },
                                            {
                                                "example_id": "6ad713cb-5f43-4fbd-9f4c-48c7afb37344",
                                                "sense_id": "eb566c76-7b68-3195-a119-af587431f775",
                                                "text": "„Für das Sudden Infant Death Syndrome (SIDS), auf deutsch plötzlicher Kindstod, spielen umweltmedizinische Einflüsse eine bedeutende Rolle. […] Der plötzliche Kindstod betrifft überwiegend Kinder zwischen dem zweiten und sechsten Lebensmonat, womit das SIDS trotz weitreichender Aufklärungskampagnen und vermehrter Erforschung der Risikofaktoren als häufigste Todesursache bei Säuglingen in Industrienationen gilt.“"
                                            },
                                            {
                                                "example_id": "225cf672-1fc7-4831-ae56-2fa177c8dc26",
                                                "sense_id": "eb566c76-7b68-3195-a119-af587431f775",
                                                "text": "„Der Gesetzentwurf verweist auf ‚Schätzungen aus Großbritannien‘, denenzufolge der Anteil fälschlich als plötzlicher Kindstod eingestufter Tötungsdelikte bei fast 15 % liege; zwei deutsche Forschungen zum plötzlichen Kindstod hätten 3 % bzw. 3,5 % nachweisbarer Tötungen unter den Fällen gefunden, ‚bei denen zunächst keinerlei Verdacht auf ein nicht natürliches Geschehen bestand‘; und eine Studie aus Österreich habe ergeben, dass ‚5 bis 10 % aller plötzlichen Kindstode in Wirklichkeit Kindstötungen‘ waren.“"
                                            },
                                            {
                                                "example_id": "5cc8d6ba-4601-4b63-a990-07d528dc33f5",
                                                "sense_id": "eb566c76-7b68-3195-a119-af587431f775",
                                                "text": "„Im 19. und 20. Jahrhundert wurden zahlreiche anatomische, infektiologische, pathophysiologische, psychologische und immunologische Thesen über Ursachen des plötzlichen Kindstods formuliert ([…]).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e919ab9f-0c32-4f9a-aad4-ccc738987104",
                        "source_entry_id": "2ce00728-c081-3671-a29b-3b1256ba5407",
                        "source_sense_id": "cdd87b81-d601-3fff-8837-2f6d6a9120bc",
                        "target_lang_word": "Krippentod",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krippentod",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "044eb222-7f69-3333-ad20-adfe65fc863d",
                                        "entry_id": "033a32d3-a956-3f4a-b9fc-e0863f9fdd2d",
                                        "glosses": [
                                            "plötzlich eintretender Tod eines Säuglings oder Kleinstkindes, bei dem eine Autopsie keine adäquate Todesursache erbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f834c1-2be7-42a3-87ee-0cbc72d809ff",
                                                "sense_id": "044eb222-7f69-3333-ad20-adfe65fc863d",
                                                "text": "„Ärzte des Kinderkrankenhauses in Sheffield (England) führen einen Teil der oft lebensgefährdenden Kinderkrankheiten, vor allem Falle des ‚Krippentodes‘, auf eine Überlastung des kleinen Organismus mit Natrium zurück.“"
                                            },
                                            {
                                                "example_id": "a8866b0c-4a44-4c99-bfd6-b208c7c6bf6a",
                                                "sense_id": "044eb222-7f69-3333-ad20-adfe65fc863d",
                                                "text": "„Ärzte haben noch kein Licht in das Dunkel um den Krippentod bringen können[.]“"
                                            },
                                            {
                                                "example_id": "66c3358f-e252-49a4-a661-d9a4b522b539",
                                                "sense_id": "044eb222-7f69-3333-ad20-adfe65fc863d",
                                                "text": "„Der plötzliche Kindstod – auch Krippentod – tritt unvermutet und plötzlich bei Säuglingen und Kleinkindern ein.“"
                                            },
                                            {
                                                "example_id": "62e75eda-6b0b-4e22-92f4-b35b900a60f3",
                                                "sense_id": "044eb222-7f69-3333-ad20-adfe65fc863d",
                                                "text": "„Schon vor einigen Jahren wurde vermutet, dass ein Serotoninmangel im Hirn eine Ursache des Krippentods sein könnte ([…]).“"
                                            },
                                            {
                                                "example_id": "181b2a40-b589-42d7-8119-ee55be84d369",
                                                "sense_id": "044eb222-7f69-3333-ad20-adfe65fc863d",
                                                "text": "„Die Kinder sollten in Rückenlage und in einem Schlafsack in einem nicht zu warmen Schlafzimmer (ideal wären 18 Grad) und in einer rauchfreien Wohnung untergebracht sein. […] Er wusste zu berichten, dass allein durch diese Maßnahmen die Zahl der Krippentode mehr als halbiert werden konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
