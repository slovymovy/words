                "word": "goggles",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                        "entry_id": "7db57115-c1be-3b3a-ab1c-9a3090c23510",
                        "glosses": [
                            "Protective eyewear set in a flexible frame to fit snugly against the face."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "88e46fd1-dae7-49ad-8f81-2ade732e9988",
                                "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                                "text": "Goggles must be worn in the swimming pool."
                            },
                            {
                                "example_id": "291e1588-7b24-4fd0-9ed0-6149164b20fe",
                                "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                                "text": "We had to put on our goggles as it was snowing outside."
                            },
                            {
                                "example_id": "27108c70-afa6-4409-a079-3a202ea283e2",
                                "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                                "text": "Regretted that I had not provided myself with goggles, as the road is so constantly traveled that the dust became a most serious nuisance."
                            }
                        ]
                    },
                    {
                        "sense_id": "50a3e814-ba37-37f1-be89-a8b38f34b9bc",
                        "entry_id": "7db57115-c1be-3b3a-ab1c-9a3090c23510",
                        "glosses": [
                            "Blinds for shying horses."
