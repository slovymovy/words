                        "sense_id": "eb5f3f65-6bd3-382a-b4a4-35b7664ce5dd",
                        "entry_id": "41b5fc03-14b1-3fe0-b25f-121e9fd0ca0d",
                        "glosses": [
                            "lid van een bepaalde joodse secte in de tijd van Jezus"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8ea45018-7723-34a7-9aa1-aaa7b1570ec6",
                        "entry_id": "41b5fc03-14b1-3fe0-b25f-121e9fd0ca0d",
                        "glosses": [
                            "iemand die doet alsof hij heel gelovig of fatsoenlijk is terwijl hij zich verwerpelijk gedraagt"
                        ],
