                        "examples": [
                            {
                                "example_id": "a2b0b2a7-861c-4ca7-9965-2eccd93de2a9",
                                "sense_id": "4278d8e5-b5a8-3852-87f1-ff236d0b6660",
                                "text": "En effet dans ce cas on peut rediagonaliser l’hamiltonien à l'intérieur de chaque sous-espace correspondant à chaque mode et obtenir une nouvelle base produit, et l’énergie est alors la somme des énergies des différent modes."
                            },
                            {
                                "example_id": "a2e50bb8-a1cf-4f39-8c58-ba9655127c51",
                                "sense_id": "4278d8e5-b5a8-3852-87f1-ff236d0b6660",
                                "text": "Il faut rediagonaliser complètement la matrice hamiltonienne (souvenez-vous de l’exemple fondamental)."
                            }
                        ]
