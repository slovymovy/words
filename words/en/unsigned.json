{
    "word_family": [
        "sign",
        "signature",
        "signatory",
        "signage",
        "signet"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "910f945a-4650-3b4f-b551-ef54eb450277",
                    "sense_definition": "Not having a signature or endorsement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lacking_signature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank rejected the <w>unsigned</w> check because it lacked the necessary authorization.",
                            "target_lang_translations": {
                                "ru": "Банк отклонил <w>неподписанный</w> чек, так как на нем отсутствовала необходимая авторизация."
                            }
                        },
                        {
                            "text": "She found an <w>unsigned</w> letter on her desk and wondered who had sent it.",
                            "target_lang_translations": {
                                "ru": "Она нашла на своем столе <w>неподписанное</w> письмо и задалась вопросом, кто его прислал."
                            }
                        }
                    ],
                    "synonyms": [
                        "unendorsed",
                        "unautographed"
                    ],
                    "antonyms": [
                        "signed"
                    ],
                    "common_phrases": [
                        "unsigned check",
                        "unsigned letter",
                        "unsigned document"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий подписи или официального подтверждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неподписанный",
                                "target_lang_sense_clarification": "о документе или письме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c16e9b70-b95c-34c3-b47b-2a298290c40c",
                    "sense_definition": "Not under contract with a specific organization, such as a sports team or a record label.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "no_contract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>unsigned</w> player also had the option of sitting out a year and negotiating as a free agent.",
                            "target_lang_translations": {
                                "ru": "У <w>свободного</w> игрока также была возможность пропустить год и вести переговоры в качестве свободного агента."
                            }
                        },
                        {
                            "text": "Many <w>unsigned</w> bands upload their music to the internet to gain a following.",
                            "target_lang_translations": {
                                "ru": "Многие <w>независимые</w> группы выкладывают свою музыку в интернет, чтобы привлечь поклонников."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncontracted",
                        "independent"
                    ],
                    "antonyms": [
                        "signed"
                    ],
                    "common_phrases": [
                        "unsigned band",
                        "unsigned artist",
                        "unsigned player"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не связанный контрактом с конкретной организацией, например, спортивной командой или лейблом звукозаписи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свободный",
                                "target_lang_sense_clarification": "не имеющий контракта, например, агент"
                            },
                            {
                                "target_lang_word": "независимый",
                                "target_lang_sense_clarification": "без контракта с лейблом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d41bdff-e788-3641-8542-e9188838bbb5",
                    "sense_definition": "Representing only non-negative numbers; having no sign bit to indicate a negative value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We use an <w>unsigned</w> variable to store the employee's salary, since it will never be less than zero.",
                            "target_lang_translations": {
                                "ru": "Мы используем <w>беззнаковую</w> переменную для хранения зарплаты сотрудника, так как она никогда не будет меньше нуля."
                            }
                        },
                        {
                            "text": "The programmer declared an <w>unsigned</w> integer to maximize the range of positive values.",
                            "target_lang_translations": {
                                "ru": "Программист объявил <w>беззнаковое</w> целое число, чтобы максимально расширить диапазон положительных значений."
                            }
                        }
                    ],
                    "synonyms": [
                        "non-negative"
                    ],
                    "antonyms": [
                        "signed"
                    ],
                    "common_phrases": [
                        "unsigned integer",
                        "unsigned variable",
                        "unsigned type"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий только неотрицательные числа; не имеющий знакового бита для обозначения отрицательного значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беззнаковый",
                                "target_lang_sense_clarification": "в программировании и математике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "010bb17e-69b1-30c0-a4aa-36ab6ea864ac",
                    "sense_definition": "A numeric value or variable that does not have a sign and can only represent positive values or zero.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For compilers which produce two-byte <w>unsigneds</w>, the maximum cumulative frequency is limited.",
                            "target_lang_translations": {
                                "ru": "Для компиляторов, создающих двухбайтовые <w>беззнаковые числа</w>, максимальная накопленная частота ограничена."
                            }
                        },
                        {
                            "text": "The function expects <w>unsigneds</w> as arguments to prevent negative input errors.",
                            "target_lang_translations": {
                                "ru": "Функция ожидает <w>беззнаковые величины</w> в качестве аргументов, чтобы предотвратить ошибки, связанные с отрицательными входными данными."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Числовое значение или переменная, которая не имеет знака и может представлять только положительные значения или ноль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беззнаковое число",
                                "target_lang_sense_clarification": "тип данных в программировании"
                            },
                            {
                                "target_lang_word": "беззнаковая величина",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}