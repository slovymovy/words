                        "examples": [
                            {
                                "example_id": "25bf22d2-4b55-433d-8330-6983537ca794",
                                "sense_id": "2d58469a-a67f-347c-bfb2-3f902f45c536",
                                "text": "Hans Heinrich sah einem an ihm vorübertanzenden Niggergirl interessiert, fast verwundert ins Gesicht. Der Kontrast zwischen ihrem „schwarzen“ Ausschnitt und dem hellfarbigen Abendkleid wirkte mehr als komisch."
                            },
                            {
                                "example_id": "6795cea3-c44c-4879-8500-2d5acc55614e",
                                "sense_id": "2d58469a-a67f-347c-bfb2-3f902f45c536",
                                "text": "[…] und geben die jüngsten Integrationsgreuel aus den Schulen zu Protokoll („Dieses Niggergirl fragt meine Tochter, und die ist noch nicht mal zehn, ob sie schon mal gebumst hat“)."
                            }
                        ]
                    }
