        "fr-extract.jsonl": [
            {
                "entry_id": "71c4fe4e-2b4e-3260-8129-b0d2feb705ad",
                "word": "EVD",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c93828a-7a02-34e7-9100-f21e94b37213",
                        "entry_id": "71c4fe4e-2b4e-3260-8129-b0d2feb705ad",
                        "glosses": [
                            "Format de disque ayant été très peu utilisé entre 2004 et 2008 initialement créé en Chine pour contourner les royalties du format DVD."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc13b06-f8b4-4abf-a503-d9e61a30a27f",
                                "sense_id": "6c93828a-7a02-34e7-9100-f21e94b37213",
                                "text": "Seulement 4 films sont sortis en EVD : Big Mamma, Black Mask 2: City of Masks, Hero (2002) et Le Secret des poignards volants."
                            },
                            {
                                "example_id": "399ad32a-6ea9-491d-b2c7-c65ef0c558da",
                                "sense_id": "6c93828a-7a02-34e7-9100-f21e94b37213",
                                "text": "Mettre tous les DVD à la poubelle. C’est l’objectif de E-world Technology – société contrôlée par un consortium d’entreprises soutenu par l’Etat chinois –, qui mise sur l’EVD, Enhanced Versatile Disc, dont le lancement est prévu en 2004. Premier atout par rapport au DVD, une qualité audio et vidéo nettement supérieure. Autre intérêt pour la Chine, qui fabrique 70 % des lecteurs de DVD dans le monde, posséder sa propre technologie et ne plus payer de royalties pour la norme DVD (325 millions de dollars par an). Bémol, le prix des lecteurs : 200 euros , contre 50 euros pour le DVD."
                            },
                            {
                                "example_id": "50f8a313-4430-455c-8e3e-5ea81e2100e0",
                                "sense_id": "6c93828a-7a02-34e7-9100-f21e94b37213",
                                "text": "Ainsi, au début des années 2000, l’EVD (Enhanced Versatile Disc), destiné à concurrencer le DVD, fut un échec. De même, quelques années plus tard, pour le FVD (Forward Versatile Disc), concurrent du HD DVD de Toshiba."
                            }
                        ]
                    }
