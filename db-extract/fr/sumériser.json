                "senses": [
                    {
                        "sense_id": "5e405f4a-0eb5-3f2a-bbf9-4f72a6322873",
                        "entry_id": "25f8abef-d6a8-3fb6-b924-dd23cc8f0080",
                        "glosses": [
                            "Donner un caractère sumérien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb938354-cca5-4d41-89ca-43d7afcac274",
                                "sense_id": "5e405f4a-0eb5-3f2a-bbf9-4f72a6322873",
                                "text": "Il est possible qu’à l’origine, le nom de Sîn soit sémitique, mais que ce nom ait été « sumérisé » en Su’en, écrit EN.ZU."
                            },
                            {
                                "example_id": "c115636a-5d9f-486d-94d1-210f9ea49a62",
                                "sense_id": "5e405f4a-0eb5-3f2a-bbf9-4f72a6322873",
                                "text": "La langue indigène en Mitanni est celle même du Hatti : preuve que le haut Euphrate n’avait pas encore été profondément sumérisé ou chaldéisé ; qu’il demeurait « anatolien » au sens vague d’asianique."
                            }
                        ]
                    }
