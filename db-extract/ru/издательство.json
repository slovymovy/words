                    {
                        "translation_id": "b05188a4-a59b-4608-b7e6-c08ef3c7c074",
                        "source_entry_id": "cc3187fe-fecd-387f-b64f-49f2ce46062a",
                        "source_sense_id": "34ccefd8-24c2-305d-ad06-8f87e35c2736",
                        "target_lang_word": "Verlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b145ec50-8870-3e77-9cf5-6d2a88c268db",
                                        "entry_id": "45e9f6c8-59fd-3f3e-b828-7df9e3d44c5e",
                                        "glosses": [
                                            "ein Unternehmen, das Werke der Literatur, Kunst, Musik oder Wissenschaft vervielfältigt und verbreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba3fc6d0-b3d2-4ff0-895c-7ee96ffe7342",
                                                "sense_id": "b145ec50-8870-3e77-9cf5-6d2a88c268db",
                                                "text": "Der Verlag übernahm das Manuskript und brachte es als Buch heraus."
                                            },
                                            {
                                                "example_id": "9b8535a2-2fcb-440c-bd74-b28638f55ab2",
                                                "sense_id": "b145ec50-8870-3e77-9cf5-6d2a88c268db",
                                                "text": "„Skral sollte mich doch mal nach meinen Erfahrungen mit Verlagen und Lektoren befragen, wenn er über mich als Schreiber zu berichten hat.“"
                                            },
                                            {
                                                "example_id": "287dae22-2787-455e-a125-72a0a6b14c53",
                                                "sense_id": "b145ec50-8870-3e77-9cf5-6d2a88c268db",
                                                "text": "„Der kleine Verlag meines Vaters lief damals ganz gut mit all den Monografien und Kunstkalendern.“"
                                            },
                                            {
                                                "example_id": "4a1815e3-be93-4691-a838-ac59f47337d7",
                                                "sense_id": "b145ec50-8870-3e77-9cf5-6d2a88c268db",
                                                "text": "„Sie hatten eine kleine Druckerei gehabt, einen kleinen Verlag, eine Buchhandlung, aber jetzt hatten sie nur noch diesen kleinen Schreibwarenladen, in dem sie auch Süßigkeiten an Schulkinder verkauften.“"
                                            },
                                            {
                                                "example_id": "efc54714-5573-4d57-be3b-925a3402485f",
                                                "sense_id": "b145ec50-8870-3e77-9cf5-6d2a88c268db",
                                                "text": "„Bei den ersten goldenen Anzeichen des Herbstes buchte Sylvia eine Schiffspassage nach London, wo sie die besten Verlage und Buchhandlungen abklappern wollte, um möglichst günstig an Bücher für ihren Laden heranzukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0b20e4b-77f4-305d-a297-e08dfde0c646",
                                        "entry_id": "45e9f6c8-59fd-3f3e-b828-7df9e3d44c5e",
                                        "glosses": [
                                            "ein Unternehmen, das als Zwischenhändler für eine Ware arbeitet, zum Beispiel ein Bierverlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ae40a7-4392-4e96-b8d0-68835b91f1fd",
                                                "sense_id": "e0b20e4b-77f4-305d-a297-e08dfde0c646",
                                                "text": "„Das letzte versprach der Amtmann; Frauen, Raum und Verlag gaben die Bewohner, und Geschicklichkeit brachten die Einwandernden mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
