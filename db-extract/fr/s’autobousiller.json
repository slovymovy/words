                        "glosses": [
                            "Se bousiller soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f7263ad-ef03-4bb5-9100-5d724b686e35",
                                "sense_id": "6d38209f-7e78-31b6-bd18-2c88a141c912",
                                "text": "Ca devient de plus en plus dur de rester sympa avec la série, à voir sa propension à s'autobousiller..."
                            },
                            {
                                "example_id": "e4b2bc84-2adc-4509-a503-e29da53c044a",
                                "sense_id": "6d38209f-7e78-31b6-bd18-2c88a141c912",
                                "text": "Et Chirac qui le laisse tranquillement s'autobousiller, fier de lui sans doute, avant de le virer prochainement peut-être."
                            },
                            {
                                "example_id": "c2f85818-8e3a-48b2-b220-e36f5ad13461",
                                "sense_id": "6d38209f-7e78-31b6-bd18-2c88a141c912",
                                "text": "Les \"Bobs\" comme toi ont tendance à s'autobousiller, tu te mines le moral..."
                            }
                        ]
                    }
