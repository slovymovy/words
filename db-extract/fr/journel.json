                        "examples": [
                            {
                                "example_id": "bb5693d6-feb9-426d-9897-78b15432100c",
                                "sense_id": "3abfc9fd-90a2-39b6-8713-afb823df8c7d",
                                "text": "L’experience journelle."
                            },
                            {
                                "example_id": "41dddc1b-f1a4-42f6-be13-7648c26a51f5",
                                "sense_id": "3abfc9fd-90a2-39b6-8713-afb823df8c7d",
                                "text": "Les officiers généraux et particuliers sentaient que leur réputation et leur fortune dépendaient de leur application, de leur conduite, de leurs actions ; que la distinction journelle y était attachée par la préférence ou le délaissement."
                            },
                            {
                                "example_id": "c58a6804-a85f-4a9e-a9b3-551ffb328187",
                                "sense_id": "3abfc9fd-90a2-39b6-8713-afb823df8c7d",
                                "text": "Les visites journelles en demi-public du roi à son ancienne maîtresse [Montespan] faisaient un contraste fort ridicule avec son assiduité chez celle qui l’avait servie."
                            }
                        ]
