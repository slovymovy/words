                "senses": [
                    {
                        "sense_id": "8a1d1bd6-0ba2-359b-8845-01c927e15149",
                        "entry_id": "514a4335-e53d-333a-a29a-3353e480e973",
                        "glosses": [
                            "van een verpakking dat deze nog nooit is geopend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89cc34d-7aba-41ac-9d9a-d2df14b09ad9",
                                "sense_id": "8a1d1bd6-0ba2-359b-8845-01c927e15149",
                                "text": "Pasja had altijd een onaangebroken pak kaarsen voor haar in voorraad."
                            },
                            {
                                "example_id": "b5cad470-a2f3-480f-a465-4928047a3627",
                                "sense_id": "8a1d1bd6-0ba2-359b-8845-01c927e15149",
                                "text": "De onderzoeker pleit ervoor die werkwijze te herzien. \"Je kunt gesealde verpakkingen uitgeven, zodat je kunt zien dat de doosjes onaangebroken zijn\", zegt ze tegen Trouw."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66c2aa03-02d5-4cd9-ad9e-88cfdbc2136f",
                        "source_entry_id": "514a4335-e53d-333a-a29a-3353e480e973",
                        "source_sense_id": "8a1d1bd6-0ba2-359b-8845-01c927e15149",
                        "source_sense_description": "van een verpakking dat deze nog nooit is geopend",
                        "target_lang_word": "unbroken",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbroken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d349f435-46dc-3ddb-bbe8-8841bb881260",
                                        "entry_id": "f556f020-f3d8-3778-b2f1-72747f274ba7",
                                        "glosses": [
                                            "Whole, not divided into parts."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8bde010-c547-457d-a454-5ec855aed507",
                                                "sense_id": "d349f435-46dc-3ddb-bbe8-8841bb881260",
                                                "text": "After the vase had fallen down the flight of stairs we were amazed to find it still unbroken."
                                            },
                                            {
                                                "example_id": "5e838d12-f99a-4b10-a864-a440c903700a",
                                                "sense_id": "d349f435-46dc-3ddb-bbe8-8841bb881260",
                                                "text": "A considerable amount of unbroken stone is brought down to Ravenglass and used locally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14390acb-b375-351b-8d7b-342cf8e6891c",
                                        "entry_id": "f556f020-f3d8-3778-b2f1-72747f274ba7",
                                        "glosses": [
                                            "Of a horse, not tamed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb75451-0739-4848-bdbc-42690e315f2b",
                                                "sense_id": "14390acb-b375-351b-8d7b-342cf8e6891c",
                                                "text": "There is something majestic about the spirit of an unbroken mustang as it runs wild across the prairie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c42a2604-519b-3ece-b959-544dfab7d7fb",
                                        "entry_id": "f556f020-f3d8-3778-b2f1-72747f274ba7",
                                        "glosses": [
                                            "Continuous, without interruption."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923649fe-d3fe-47e6-b512-8d31524f0782",
                                                "sense_id": "c42a2604-519b-3ece-b959-544dfab7d7fb",
                                                "text": "The team's unbroken winning streak was a record."
                                            },
                                            {
                                                "example_id": "b74fd9ab-7243-4b8f-a6df-6bd6b0a0ef2f",
                                                "sense_id": "c42a2604-519b-3ece-b959-544dfab7d7fb",
                                                "text": "The climb out of Aberdeen is a most forbidding proposition to an engine starting cold; it is quite unbroken for 7 miles up the cliffs to milepost 234."
                                            }
                                        ]
                                    }
                                ]
                            },
