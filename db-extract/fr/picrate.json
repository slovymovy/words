                        "examples": [
                            {
                                "example_id": "79d56d55-a3b9-4100-b52c-cc6a1c7a7b8d",
                                "sense_id": "7451d555-d462-3319-93ca-825f1015d7e5",
                                "text": "Bah ! Ex malo bonum ! Profitons-en pour faire le plein d'eau douce !\nDe l'eau? Quand nos cales sont pleines de vin pris sur ce pinardier phénicien !?\nParlons-en ! Regarde l'effet de ce picrate sur nos hommes !",
                                "translation": "Asterix and the Chieftain's Daughter",
                                "english": "Asterix and the Chieftain's Daughter"
                            }
                        ]
