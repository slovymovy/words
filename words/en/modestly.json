{
    "word_family": [
        "modest",
        "modesty"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a7d074ed-56f7-3ac2-9c29-989dda9c56c2",
                    "sense_definition": "In a humble or unassuming manner, without showing off.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winner <w>modestly</w> accepted the award and thanked her team.",
                            "target_lang_translations": {
                                "ru": "Победительница <w>скро́мно</w> приняла награду и поблагодарила свою команду."
                            }
                        },
                        {
                            "text": "He <w>modestly</w> bowed his head after the applause died down.",
                            "target_lang_translations": {
                                "ru": "Он <w>скро́мно</w> опустил голову, когда аплодисменты стихли."
                            }
                        }
                    ],
                    "synonyms": [
                        "humbly",
                        "unassumingly"
                    ],
                    "antonyms": [
                        "arrogantly",
                        "boastfully"
                    ],
                    "common_phrases": [
                        "bowed modestly",
                        "accepted modestly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скромно, без хвастовства, не привлекая к себе лишнего внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скро́мно",
                                "target_lang_sense_clarification": "в манере, лишенной тщеславия или высокомерия"
                            },
                            {
                                "target_lang_word": "сде́ржанно",
                                "target_lang_sense_clarification": "в поведении, характеризующемся умеренностью и отсутствием излишеств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "465931d8-aa49-34d7-b5cf-58606e2d670d",
                    "sense_definition": "To a small or limited degree or extent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy will <w>modestly</w> increase the total budget for the project.",
                            "target_lang_translations": {
                                "ru": "Новая политика <w>незначи́тельно</w> увеличит общий бюджет проекта."
                            }
                        },
                        {
                            "text": "Prices have <w>modestly</w> risen since the start of the year.",
                            "target_lang_translations": {
                                "ru": "С начала года цены <w>уме́ренно</w> выросли."
                            }
                        }
                    ],
                    "synonyms": [
                        "slightly",
                        "moderately"
                    ],
                    "antonyms": [
                        "significantly",
                        "greatly"
                    ],
                    "common_phrases": [
                        "modestly increase",
                        "modestly reduce"
                    ],
                    "target_lang_definitions": {
                        "ru": "В небольшой степени, умеренно, незначительно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уме́ренно",
                                "target_lang_sense_clarification": "в пределах разумного, без излишеств"
                            },
                            {
                                "target_lang_word": "незначи́тельно",
                                "target_lang_sense_clarification": "в малой степени, слегка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}