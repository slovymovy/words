                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "201c0eaa-9758-366a-88cb-44dbca8343e4",
                                        "entry_id": "38c3e34a-cbec-3402-8183-e3248d509399",
                                        "glosses": [
                                            "An epitome or compend, as of a book; a shortened or abridged form; an abbreviation."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14894a2a-448b-4b47-93ab-64afb3269c24",
                                                "sense_id": "201c0eaa-9758-366a-88cb-44dbca8343e4",
                                                "text": "The article which embodied my researches having proved somewhat too long for its purpose, an abridgment of it only was inserted in the Encyclopædia."
                                            },
                                            {
                                                "example_id": "fb52b456-fcf8-428d-94ca-5ca26f8e0262",
                                                "sense_id": "201c0eaa-9758-366a-88cb-44dbca8343e4",
                                                "text": "When the goal is simply to be as faithful as possible to the material—as if a movie were a marriage, and a rights contract the vow—the best result is a skillful abridgment, one that hits all the important marks without losing anything egregious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8dca7d-1833-32f5-993c-b5d2a438906f",
                                        "entry_id": "38c3e34a-cbec-3402-8183-e3248d509399",
                                        "glosses": [
                                            "That which abridges or cuts short; hence, an entertainment that makes the time pass quickly"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e073632f-ed1c-4967-b579-02ba432a72bf",
                                                "sense_id": "fb8dca7d-1833-32f5-993c-b5d2a438906f",
                                                "text": "What abridgment have you for this evening? What masque? what music?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d81dce51-22cd-3300-844e-878409cd9604",
                                        "entry_id": "38c3e34a-cbec-3402-8183-e3248d509399",
                                        "glosses": [
                                            "Any of various brief statements of case law made before modern reporting of legal cases."
                                        ],
