                ],
                "senses": [
                    {
                        "sense_id": "c933b362-dfec-3e5c-921e-a8779f04a7f0",
                        "entry_id": "c46c3496-2242-35ec-82a0-4ac0bf7cae78",
                        "glosses": [
                            "Légèrement effervescent, en parlant d’un vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de56a338-4797-4e03-8a9a-061ef6c1da49",
                                "sense_id": "c933b362-dfec-3e5c-921e-a8779f04a7f0",
                                "text": "Un vin perlant aussi appelé perlé ou moustillant est un vin blanc sec en général. Il se situe à la limite du vin tranquille et du vin pétillant. Tout dépend de la pression du gaz carbonique dans la bouteille."
                            }
                        ]
                    },
                    {
                        "sense_id": "75404065-5616-3acf-b3aa-ae249a20c7eb",
                        "entry_id": "c46c3496-2242-35ec-82a0-4ac0bf7cae78",
                        "glosses": [
                            "Pétillant, en parlant de la sensation procurée par un vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7f05a3-0ca6-44cd-8eb6-39b16b249309",
                                "sense_id": "75404065-5616-3acf-b3aa-ae249a20c7eb",
                                "text": "Avec son attaque perlante et sa finale vive, voilà un bien sémillant sémillon."
                            }
                        ]
                    },
                    {
                        "sense_id": "609c8dac-385b-3c4b-b93f-96443bc78677",
                        "entry_id": "c46c3496-2242-35ec-82a0-4ac0bf7cae78",
                        "glosses": [
                            "Qui perle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b69be4-9577-4159-bb37-fdd1681dcf4f",
                                "sense_id": "609c8dac-385b-3c4b-b93f-96443bc78677",
                                "text": "La joie, d’abord perlante, comme à l’entaille point une goutte de sang frais, ce merveilleux vermeil. Puis la joie déferlante, rompant les amarres."
                            },
                            {
                                "example_id": "f6f0ef80-445d-4cc1-a7e6-e04bd07e0d64",
                                "sense_id": "609c8dac-385b-3c4b-b93f-96443bc78677",
                                "text": "Il est ancré dans son lit, assis droit, une sueur perlante inondant le drap qu’il a relevé sur ses épaules."
                            }
                        ]
                    }
                ],
