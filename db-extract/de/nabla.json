                ],
                "senses": [
                    {
                        "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                        "entry_id": "728aac8a-f144-3583-a713-a7289c7cf65d",
                        "glosses": [
                            "im Altertum verwendetes Saiteninstrument, das wahrscheinlich der Harfe ähnlich war"
                        ],
                        "tags": [
                            "historical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a5f3b083-dc61-430a-9c03-951fb1184231",
                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                "text": "„Nach Clemens Alexandrinus und Eusebios war die Nabla eine Erfindung der Kappadoker, nach Athenaios war sie eine Erfindung der Phönizier.“"
                            },
                            {
                                "example_id": "7ef630ba-02ec-42e3-abc9-ab0eaf40ccad",
                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                "text": "„Dazu stimmt vor allem die Angabe der Kirchenväter, daß bei der Nabla der Resonanzkörper oben gewesen sei (s. o.).“"
                            },
                            {
                                "example_id": "9cb39cdb-692d-4209-a462-64ab3b190341",
                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                "text": "„Auch Euphorion in Tepi Ploduiwy (Athen. IV. 182) betont, daß die Spieler der Nabla, Pandura und Sambyke durchaus nicht neuere Instrumente spielen […]“"
                            },
                            {
                                "example_id": "d4c8dc62-1ce7-445b-9961-49bf6293bfa8",
                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                "text": "„Mag das Wort Amby was immer bedeuten (und am allerwenigsten kann es ‚Jungfrauen‘ bedeuten), so kann es hier nur die Bedeutung eines Instrumentes, d. h. eines eigenen Nabla haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
