                        "zh": [
                            {
                                "target_lang_word": "姓名首字母",
                                "target_lang_sense_clarification": "用于签名或缩写"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc08f29d-b5bb-3b6b-b7d8-a26b8d141708",
                    "sense_definition": "A large or decorative letter at the beginning of a chapter or section.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_letter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript featured a beautiful gold <w>initial</w> on the first page.",
                            "target_lang_translations": {
                                "ru": "Древняя рукопись содержала красивую золотую <w>буквицу</w> на первой странице.",
                                "zh": "这份古代手稿的第一页上有一个精美的金色<w>首字</w>。"
                            }
                        },
                        {
                            "text": "A large illuminated <w>initial</w> marked the start of the new chapter.",
                            "target_lang_translations": {
                                "ru": "Большой иллюминированный <w>инициал</w> отмечал начало новой главы.",
                                "zh": "一个巨大的装饰性<w>首字</w>标志着新章节的开始。"
                            }
