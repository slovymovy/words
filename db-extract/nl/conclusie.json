                "senses": [
                    {
                        "sense_id": "3709e123-1746-35e2-bc51-9d3b5cc63e63",
                        "entry_id": "18ca9fbb-8637-3f67-85ba-260bafb42328",
                        "glosses": [
                            "de uitkomst van een denkproces, besluit, gevolgtrekking, bevinding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdc1f60-c082-495a-a825-428cf85120e4",
                                "sense_id": "3709e123-1746-35e2-bc51-9d3b5cc63e63",
                                "text": "De conclusie van het betoog was dat de regering onvoldoende rekening had gehouden met de belangen van de bewoners."
                            },
                            {
                                "example_id": "b1153396-8c8e-4929-82d9-ebe7a4f25c3a",
                                "sense_id": "3709e123-1746-35e2-bc51-9d3b5cc63e63",
                                "text": "Ze was de greep op haar eigen gedachten volledig kwijt. De vragen en voorbarige conclusies stroomden als een woeste rivier."
                            },
                            {
                                "example_id": "1b3157d4-106c-466b-9213-ffb5c2fec66c",
                                "sense_id": "3709e123-1746-35e2-bc51-9d3b5cc63e63",
                                "text": "Deze conclusie, zijn verklaring van plichtsbesef en de resten van zijn garnalensoesje spoelde hij weg met een grote slok zoete witte wijn, terwijl ik bleef zitten met de vraag hoe hij vanuit dit geïsoleerde hotel, dat op honderden kilometers van zee lag, leiding gaf aan een intercontinentaal georiënteerd maritiem bedrijf, maar ik durfde het niet te vragen, want hij had alweer een nieuw roesje in zijn mond gestopt."
                            }
                        ]
                    },
                    {
                        "sense_id": "abd015fe-c8a0-39cb-8159-127263c932e5",
                        "entry_id": "18ca9fbb-8637-3f67-85ba-260bafb42328",
                        "glosses": [
                            "verklaring geschreven door een advocaat waarin een partij in een rechtszaak zijn eisen en middelen uiteenzet"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47ee1be0-e893-4829-aaf2-b3df6fdc0dac",
                        "source_entry_id": "18ca9fbb-8637-3f67-85ba-260bafb42328",
                        "target_lang_word": "Schlussfolgerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlussfolgerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                        "entry_id": "9803a1c3-0f89-3225-a1f7-ea58c35841a9",
                                        "glosses": [
                                            "Ableitung eines Ergebnisses aus gegebenen Voraussetzungen und Ergebnis dieser Ableitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e288d1f-766b-4f8f-b0cb-21f5c0001d20",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Paul presste die Lippen zusammen, schaute für einen Moment frustriert seitlich nach unten und konnte nicht glauben, was Lindsay da an Schlussfolgerungen bereithielt.“"
                                            },
                                            {
                                                "example_id": "e6973fc0-f056-42bc-a4f3-1fc8bfa02280",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Diese Schlussfolgerung ist fragwürdig.“"
                                            },
                                            {
                                                "example_id": "dc3fa6f2-7d86-454a-8641-3aca371745e9",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            },
                                            {
                                                "example_id": "222e6208-15ab-4c3b-b21f-7a0e1b90b3bc",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Seine Schlussfolgerungen waren gedrängt, einfach und klar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36d5eb94-f567-46a0-910a-f9c2eda8e1a5",
                        "source_entry_id": "18ca9fbb-8637-3f67-85ba-260bafb42328",
                        "target_lang_word": "conclusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conclusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09b6865d-2421-3055-ad70-3d3d9a5fa292",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "The end, finish, close or last part of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a669cca-94b5-41f3-a40d-b1951f2db1d7",
                                                "sense_id": "09b6865d-2421-3055-ad70-3d3d9a5fa292",
                                                "text": "At the end of the seventh hour, a flourish of trumpets announced the conclusion of the contest; […]"
                                            },
                                            {
                                                "example_id": "da95ecb1-cb8e-49fa-873f-857f64538c15",
                                                "sense_id": "09b6865d-2421-3055-ad70-3d3d9a5fa292",
                                                "text": "Some have recently questioned whether conclusion of a START treaty is a lower priority for the Bush Administration than conclusion of a conventional force in Europe (CFE) treaty or whether we want to delay START pending progress in CFE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9efc76-87ae-30e3-bc7b-4f0dffabecc6",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "The outcome or result of a process or act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "A decision reached after careful thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b80d13d8-0f4a-4d96-9c51-a9e29fc10511",
                                                "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                                "text": "The board has come to the conclusion that the proposed takeover would not be in the interest of our shareholders."
                                            },
                                            {
                                                "example_id": "a2a91468-e950-4dfc-8f26-256ea88309e2",
                                                "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                                "text": "[I]n her boſome Ile vnclaſpe my heart, / And take her hearing priſoner with the force / And ſtrong incounter of my amorous tale: / Then after to her father will I breake, / And the concluſion is, ſhe ſhal be thine, [...]"
                                            },
                                            {
                                                "example_id": "4dd5dc88-bef2-4e83-b1fc-b092412eb037",
                                                "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529f0919-1098-3fb7-b28f-c6c3c892be74",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "In an argument or syllogism, the proposition that follows as a necessary consequence of the premises."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564b2d9e-a693-4440-9d04-473439e5c2f1",
                                                "sense_id": "529f0919-1098-3fb7-b28f-c6c3c892be74",
                                                "text": "He granted him both the major and minor, but denied him the conclusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e505fd00-d948-3531-bdf8-9c60e5f510e3",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "An experiment, or something from which a conclusion may be drawn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98fe0b06-6fcc-44c5-8446-eae9492e0517",
                                                "sense_id": "e505fd00-d948-3531-bdf8-9c60e5f510e3",
                                                "text": "[W]ee practiſe likewise all Concluſions of Grafting, and Inoculating, as well of VVilde-Trees, as Fruit-Trees, which produceth many Effects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0669db78-e0dc-352e-bc63-a4714e0dc867",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "The end or close of a pleading, for example, the formal ending of an indictment, \\\"against the peace\\\", etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a56ac9d-07c7-3c9a-9b54-da123465e76d",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "An estoppel or bar by which a person is held to a particular position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e6be52-d0d5-4b55-a70f-f0dd5d2e01b0",
                                                "sense_id": "7a56ac9d-07c7-3c9a-9b54-da123465e76d",
                                                "text": "It was determined, that though the fine operated at first by conclusion, and passed no interest, yet the estoppel should bind the heir"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb9b56fd-407a-3319-87d7-8dd8458f837d",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "arrangement; settlement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11201680-5c13-49f8-a678-92e2a65d7f07",
                        "source_entry_id": "18ca9fbb-8637-3f67-85ba-260bafb42328",
                        "target_lang_word": "conclusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conclusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e270476e-0da1-3059-887a-414a2d7f9d32",
                                        "entry_id": "42d40a1f-cfdc-3106-9829-4cd0bfc135f4",
                                        "glosses": [
                                            "Terminaison d’une affaire, d’une délibération, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b52de4-3b59-4163-8a3c-9c4695f8a275",
                                                "sense_id": "e270476e-0da1-3059-887a-414a2d7f9d32",
                                                "text": "Moscou offre en compensation une rectification frontalière en Carélie orientale et la conclusion d'un pacte d'assistance."
                                            },
                                            {
                                                "example_id": "8918d15a-d9c4-480d-a14e-8548b91e2b26",
                                                "sense_id": "e270476e-0da1-3059-887a-414a2d7f9d32",
                                                "text": "La conclusion d’un traité. - La conclusion d’un mariage. - Il faut en venir à la conclusion. - Nous touchons au moment de la conclusion, à la conclusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68c2045c-b0dd-3c30-8229-aeb3fc60e940",
                                        "entry_id": "42d40a1f-cfdc-3106-9829-4cd0bfc135f4",
                                        "glosses": [
                                            "Ce qui termine et qui résume un discours, un récit, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02705a8b-0754-4575-97cb-994537cedb36",
                                                "sense_id": "68c2045c-b0dd-3c30-8229-aeb3fc60e940",
                                                "text": "La conclusion de son discours fit beaucoup d’impression sur l’auditoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5de1c7e-3ed2-3492-9eb3-4ae24decb7d7",
                                        "entry_id": "42d40a1f-cfdc-3106-9829-4cd0bfc135f4",
                                        "glosses": [
                                            "Conséquence que l’on tire d'un raisonnement, et surtout d’un argument en forme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d822da9e-2943-4476-9d76-a7cfd8f0300b",
                                                "sense_id": "d5de1c7e-3ed2-3492-9eb3-4ae24decb7d7",
                                                "text": "En combinant avec les observations si précises de M. Edwards celles de ses devanciers et de ses successeurs, nous pouvons en tirer une conclusion générale."
                                            },
                                            {
                                                "example_id": "a7d91bd2-d49e-4b4e-869e-e8dcc373c3ec",
                                                "sense_id": "d5de1c7e-3ed2-3492-9eb3-4ae24decb7d7",
                                                "text": "Nous sommes arrivés, de critique en critique, à cette triste conclusion : que le juste et l'injuste, dont nous pensions jadis avoir le discernement, sont termes de convention, vagues, indéter­minables ; […]."
                                            },
                                            {
                                                "example_id": "53a9a39e-fb9c-4713-a7b3-a2e6117e3017",
                                                "sense_id": "d5de1c7e-3ed2-3492-9eb3-4ae24decb7d7",
                                                "text": "Ainsi, Constantin V, successeur de Léon III, en partant des mêmes principes christologiques que les iconophiles, arrive à des conclusions opposées aux leurs."
                                            },
                                            {
                                                "example_id": "ac0f1da8-55b7-4aeb-83f8-1f109e97f725",
                                                "sense_id": "d5de1c7e-3ed2-3492-9eb3-4ae24decb7d7",
                                                "text": "J'ignore quel est le crétin qui est arrivé à la conclusion qu’une image vaut mille mots, et si je le savais, je trouverais le moyen de lui régler son compte en chambre noire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df93c008-06c9-33f3-b04d-6a4fc36572aa",
                                        "entry_id": "42d40a1f-cfdc-3106-9829-4cd0bfc135f4",
                                        "glosses": [
                                            "Ce que les parties demandent par des requêtes, soit écrites, soit verbales, ou par d’autres actes."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df08bfb-6938-4e6c-b780-c344b46316bf",
                                                "sense_id": "df93c008-06c9-33f3-b04d-6a4fc36572aa",
                                                "text": "On m’a donné tout ce que je demandais par mes conclusions. - On lui a adjugé ses fins et conclusions. - Prendre des conclusions à l’audience."
                                            },
                                            {
                                                "example_id": "df8d30e3-c429-4db3-a018-81893382cb28",
                                                "sense_id": "df93c008-06c9-33f3-b04d-6a4fc36572aa",
                                                "text": "Conclusions au fond. - conclusions principales, subsidiaires, additionnelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6af2f1b-e1d9-3ee2-bee0-2cf2c0d26742",
                                        "entry_id": "42d40a1f-cfdc-3106-9829-4cd0bfc135f4",
                                        "glosses": [
                                            "Avis et réquisitions du ministère public dans les affaires où il intervient."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a24496-b6f7-44ec-801a-2bfff848c3d1",
                                                "sense_id": "f6af2f1b-e1d9-3ee2-bee0-2cf2c0d26742",
                                                "text": "M. le procureur de la République a donné, ce matin, ses conclusions dans l'affaire de M. l’abbé Grulet, ancien curé de Guignicourt-sur-Vence, contre M. Meyrac et le Petit Ardennais, et dans celle de M. Meyrac contre la Croix des Ardennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
