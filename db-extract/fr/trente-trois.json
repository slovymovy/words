        "fr-extract.jsonl": [
            {
                "entry_id": "c53c5842-b255-3297-a7aa-15d13f73c4e6",
                "word": "trente-trois",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e8ce8bd1-1bd4-3974-8acf-0ee6c13f56d4",
                        "entry_id": "c53c5842-b255-3297-a7aa-15d13f73c4e6",
                        "glosses": [
                            "Trente-deux plus un, adjectif numéral cardinal correspondant au nombre 33."
                        ],
                        "tags": [
                            "Antéposé"
                        ],
                        "examples": [
                            {
                                "example_id": "a45b2a68-96ba-4562-b548-86c01fd04afb",
                                "sense_id": "e8ce8bd1-1bd4-3974-8acf-0ee6c13f56d4",
                                "text": "Mais à Babylone, en 323, la maladie foudroie le jeune souverain qui meurt à trente-trois ans, tout auréolé de gloire. Alexandre a donné naissance à une monarchie universelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "063536f4-94b4-3969-9cba-9e14f33ab41e",
                        "entry_id": "c53c5842-b255-3297-a7aa-15d13f73c4e6",
                        "glosses": [
                            "Trente-troisième."
                        ],
                        "tags": [
                            "Postposé"
                        ],
                        "examples": [
                            {
                                "example_id": "196ed317-9b9b-4436-bb92-8674318e1633",
                                "sense_id": "063536f4-94b4-3969-9cba-9e14f33ab41e",
                                "text": "Page trente-trois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8f00ad6-e21a-4633-b541-cc5e3ce88a8b",
                        "source_entry_id": "c53c5842-b255-3297-a7aa-15d13f73c4e6",
                        "target_lang_word": "dreiunddreißig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreiunddreißig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "236e6df1-4518-37d6-8c4a-97e379dae420",
                                        "entry_id": "8289f7c0-6dc1-3364-816b-dbd1db7da3e4",
                                        "glosses": [
                                            "die Kardinalzahl zwischen zweiunddreißig und vierunddreißig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f62549c-6337-4a14-aa58-6aed2f983106",
                                                "sense_id": "236e6df1-4518-37d6-8c4a-97e379dae420",
                                                "text": "Auf der Weide stehen dreiunddreißig Kühe."
                                            },
                                            {
                                                "example_id": "9e8ee529-0ca0-47ed-a267-5285c5dc0988",
                                                "sense_id": "236e6df1-4518-37d6-8c4a-97e379dae420",
                                                "text": "„Der Arzt, mit dessen Hilfe die USA die Identität bin Ladens feststellten, wurde im Mai 2012 wegen angeblicher Unterstützung der Lashkar-e-Islam (Armee des Islam) in Pakistan angeklagt und von einem Gericht in den Stammesgebieten zu dreiunddreißig Jahren Haft verurteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "556c5e7d-e036-3ccf-990f-a6c0da6135c9",
                                        "entry_id": "8289f7c0-6dc1-3364-816b-dbd1db7da3e4",
                                        "glosses": [
                                            "dreiunddreißig Jahre (alt)"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c2daffa-ffc5-4ae6-a261-2e0d17b211f5",
                                                "sense_id": "556c5e7d-e036-3ccf-990f-a6c0da6135c9",
                                                "text": "Nächstes Jahr werde ich dreiunddreißig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9a4cd224-4f7f-3839-8a05-ad516bc24df2",
                                        "entry_id": "8289f7c0-6dc1-3364-816b-dbd1db7da3e4",
                                        "glosses": [
                                            "1933, das Jahr dreiunddreißig im betreffenden Jahrhundert"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18dfd63c-5758-41d2-b1e5-b34e641382f5",
                                                "sense_id": "9a4cd224-4f7f-3839-8a05-ad516bc24df2",
                                                "text": "„Der Krieg kam und die Marken und Güterzüge mit Soldaten, […], und mein Großvater sagte: ›Wir werden den Tod der Juden büßen müssen.‹ […] Er saß ganz still da […], aber als wir weggingen, war er wütend – auf sich und ›auf die Idioten, die dreiunddreißig etwas hätten tun sollen‹ – was, hat er mir nicht gesagt, und ich hätte es auch nicht genau verstanden.“"
                                            },
                                            {
                                                "example_id": "a8036d77-68c0-4f63-a2a7-3f4e8c1c209d",
                                                "sense_id": "9a4cd224-4f7f-3839-8a05-ad516bc24df2",
                                                "text": "„Zuletzt war er der Kriminalpolizei Frankfurt am Main vorgestanden, doch kehrte er schon dreiunddreißig in seine Vaterstadt zurück. Der Grund seiner Heimreise war […] eine Ohrfeige gewesen, die er einem hohen Beamten der damaligen neuen deutschen Regierung gegeben hatte.“"
                                            },
                                            {
                                                "example_id": "d2eaf022-cc39-4c22-a558-6469c03ed5cb",
                                                "sense_id": "9a4cd224-4f7f-3839-8a05-ad516bc24df2",
                                                "text": "„Was wir genau wissen. ist: Die große Entscheidung hat begonnen. Welcher Kommunist hat nicht seit dreiunddreißig damit gerechnet?“"
                                            },
                                            {
                                                "example_id": "65614942-302d-4ab4-875f-605766404789",
                                                "sense_id": "9a4cd224-4f7f-3839-8a05-ad516bc24df2",
                                                "text": "„‚Ab dreiundreißig ging es dann wieder aufwärts. Adolf Hitler kam an die Macht, es gab wieder Arbeit und Brot. […]‘“"
                                            },
                                            {
                                                "example_id": "8c48af66-fd8a-464c-9f14-f86732e0974a",
                                                "sense_id": "9a4cd224-4f7f-3839-8a05-ad516bc24df2",
                                                "text": "„Von dreiunddreißig bis sechsunddreißig war er bei der SS.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
