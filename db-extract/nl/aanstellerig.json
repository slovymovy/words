                "senses": [
                    {
                        "sense_id": "f8cb42f4-15eb-37a7-980e-1ed14eec8c55",
                        "entry_id": "91e7efc3-ffec-3322-bd0a-8731f4819fd8",
                        "glosses": [
                            "zich te veel aanstellend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa39bc5-3361-4d79-8c58-d9efaceb157c",
                                "sense_id": "f8cb42f4-15eb-37a7-980e-1ed14eec8c55",
                                "text": "Axel heeft zijn mondkapje afgedaan en foetert op de nog altijd te lakse regeringspolitiek en het aanstellerige volk dat nu al versoepelingen van de lockdown eist."
                            },
                            {
                                "example_id": "d3e8a876-247a-4f27-900c-632a0bbd9f6b",
                                "sense_id": "f8cb42f4-15eb-37a7-980e-1ed14eec8c55",
                                "text": "Soms liet hij één handje aanstellerig wapperen en riep: 'Hiehie!' Dat deed-ie als Jos zwak was in zijn ogen. Wanneer hij met voetbal door een bonkige tegenstander gemeen onderuit was geschoffeld.'Kom op, Jossie!' klonk het dan van de zijlijn.'Doorbijten.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dccbc48-8d06-4754-916d-ccdbc114ccc7",
                        "source_entry_id": "91e7efc3-ffec-3322-bd0a-8731f4819fd8",
                        "source_sense_id": "f8cb42f4-15eb-37a7-980e-1ed14eec8c55",
                        "target_lang_word": "affected",
                        "target_lang_code": "en",
