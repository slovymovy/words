                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found herself <w>worsted</w> in the argument despite her strong opinions.",
                            "target_lang_translations": {
                                "ru": "Она оказалась <w>побеждённой</w> в споре, несмотря на свои твердые убеждения.",
                                "es": "Ella se encontró <w>derrotada</w> en la discusión a pesar de sus fuertes opiniones.",
                                "zh": "尽管她立场坚定，但在争论中还是被<w>击败</w>了。"
                            }
