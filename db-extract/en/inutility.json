                        "sense_id": "fb38c728-e779-3429-8c14-10ed96be28ba",
                        "entry_id": "dc6fb9df-47a8-333d-adc6-9b2ef4b34ab6",
                        "glosses": [
                            "Something of no use."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ec78e62f-0158-455a-935a-5c4e7c7bd64d",
                                "sense_id": "fb38c728-e779-3429-8c14-10ed96be28ba",
                                "text": "But I will hope better things for young Robert's sake; that he will learn something more important than that most useless of all inutilities, the forging of hexameters and pentameters […]"
                            },
                            {
                                "example_id": "67da38c6-dbbc-4f94-91dd-88672836ce8a",
                                "sense_id": "fb38c728-e779-3429-8c14-10ed96be28ba",
                                "text": "A hideous account of a hanging, drawing, and quartering had first attracted him to it; but later he discovered the book (Curiosities of Literature was its name) full of the finest confused feeding—such as forgeries and hoaxes, Italian literary societies, religious and scholastic controversies of old when men (even that most dreary John Milton, of Lycidas) slanged each other, not without dust and heat, in scandalous pamphlets; personal peculiarities of the great; and a hundred other fascinating inutilities."
                            }
                        ]
                    }
