                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3df637b5-d118-402e-b27d-7d3a6b5c3d73",
                                "sense_id": "e53cff7b-34f9-3b38-9efe-ff5412a1fcba",
                                "text": "L’hémiplégie gauche diffère en effet de l’hémiplégie droite non seulement par la main paralysée, mais aussi par des signes spécifiques."
                            },
                            {
                                "example_id": "f859d82a-053e-457a-ac0a-d0bb6de5f5cb",
                                "sense_id": "e53cff7b-34f9-3b38-9efe-ff5412a1fcba",
                                "text": "Monsieur le P-DG du PIC en fut anéanti. La bouche ouverte, appuyant le pouce et l’index au creux de ses joues, il pensa être victime d’une hémiplégie."
                            }
                        ]
                    }
