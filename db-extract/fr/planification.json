                                        "entry_id": "73a8dbeb-0de1-36c7-ba05-64c29fff170d",
                                        "glosses": [
                                            "Erstellungsprozess eines Planes, vorausschauende Entwicklung einer sinnvollen Anordnung mehrerer Einzelhandlungen zur Erreichung eines Zieles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f049a1c2-95bc-4bff-a272-28d5de06bd15",
                                                "sense_id": "58558287-29b7-3654-b65a-e9d5dfd146e6",
                                                "text": "„Die Verwaltung ist für das Organisatorische zuständig, wie das Planen der Versammlungen.“"
                                            }
