                                "sense_id": "cf5cb120-dbe8-3a49-85e0-5d3f5e91d345",
                                "text": "„Die Eigenwerte einer Diagonalmatrix sind die Einträge auf der Hauptdiagonale mit den kanonischen Einheitsvektoren als Eigenvektoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
