                "entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                "word": "nergens",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f5dd9a2a-5b5e-3b05-af79-36efa9096c18",
                        "entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                        "glosses": [
                            "op geen enkele plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7a5777-f01c-4e0b-a3b3-71abe93a7fe8",
                                "sense_id": "f5dd9a2a-5b5e-3b05-af79-36efa9096c18",
                                "text": "Dat zul je nergens aantreffen."
                            },
                            {
                                "example_id": "98a90b57-7e87-49e1-803e-19e3d23fedf2",
                                "sense_id": "f5dd9a2a-5b5e-3b05-af79-36efa9096c18",
                                "text": "Ze besloten zich vanaf een plateau in een meertje te storten. In werkelijkheid kunnen ze alleen maar wadend in de troebele poel hun dood tegemoet zijn gelopen - een nabij ravijn is nergens te bekennen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f31bea95-1131-3e43-9837-bc06a2c3aadd",
                        "entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                        "glosses": [
                            "als locatief deel van een samengesteld voornaamwoordelijk bijwoord vervangt het een ontkennend voornaamwoord als niets of niks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70ca814-e478-4275-93d8-c28a837f251d",
                                "sense_id": "f31bea95-1131-3e43-9837-bc06a2c3aadd",
                                "text": "Hij praatte over niets => hij praatte nergens over."
                            },
                            {
                                "example_id": "a4902348-2212-428c-991a-efb348794b01",
                                "sense_id": "f31bea95-1131-3e43-9837-bc06a2c3aadd",
                                "text": "Hij maakte zich nergens druk om, al helemaal niet over morgen en was een echte hippie met zijn geliefde hasjpijp in zijn mond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d6907f5-12ce-4234-87db-fcec993e929b",
                        "source_entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                        "target_lang_word": "nirgendwo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nirgendwo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                        "entry_id": "19f9b637-81c7-3fe9-9019-8d879fbc27e3",
                                        "glosses": [
                                            "an keinem Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf355826-9558-45e4-8d84-e9c21634c736",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "Nirgendwo kann man seine Ruhe haben!"
                                            },
                                            {
                                                "example_id": "4070ae7d-dd26-4bbd-b214-11d6c79bf021",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "Ich habe meinen Geldbeutel überall gesucht, aber nirgendwo gefunden."
                                            },
                                            {
                                                "example_id": "6de8a9f2-d14e-42a4-a63e-f7c81fda64e5",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "„Sie sind »schollengebunden«, das heißt, sie dürfen nirgendwo anders hinziehen, müssen für ihre kümmerlichen Äcker dem Grafen Frondienst leisten und ihn sogar bei allen familiären Veränderungen, etwa Heiraten, um Erlaubnis fragen.“"
                                            },
                                            {
                                                "example_id": "c6ceb28e-d2b6-463b-99b8-37bd04715cd2",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "„Nirgendwo sind Investoren aus dem In- und Ausland so aktiv.“"
                                            },
                                            {
                                                "example_id": "36eb950a-2d75-4493-8f54-15a4f6a59776",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "Nirgendwo in der westlichen Welt gibt es so viele Waffen [wie in Amerika], nirgendwo sonst werden so viele Morde begangen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaa89819-db9d-45c5-a616-02883465e92b",
                        "source_entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                        "target_lang_word": "nirgends",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nirgends",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                        "entry_id": "30930d73-9211-38ac-ad96-caebfa769430",
                                        "glosses": [
                                            "an keinem Ort, nirgendwo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee87f73c-b4a1-40cd-9c91-633a55c0bc7d",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "Ich suche seit zwei Stunden meine Brille, aber ich kann sie nirgends finden."
                                            },
                                            {
                                                "example_id": "1d34bed1-4a77-4e10-877c-51052e0d5d83",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "Er wollte am liebsten nirgends auffallen."
                                            },
                                            {
                                                "example_id": "0b615d3a-c137-47ed-9ce0-677e1e6fb7e7",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "Leider ist dieser Artikel nirgends erhältlich."
                                            },
                                            {
                                                "example_id": "76cab074-54b1-45f1-86c5-f16a6197f14d",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "„Dann darf ich nirgends mehr spielen, und immerzu fallen Bomben auf meinen Kopf.“"
                                            },
                                            {
                                                "example_id": "81257ebf-ba2d-4270-b963-4442130d4532",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "„Bewacht wird die Zufahrt von zwei Wärtern in Tarnuniform, von denen einer auf einem Holzturm achtgibt, dass der Wald nirgends brennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8954633b-24e9-4905-966e-10e1a99b4356",
                        "source_entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                        "target_lang_word": "nowhere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nowhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ec7bd4f-84eb-3e5d-b78b-32fdf081e6b8",
                                        "entry_id": "d8899560-4520-3042-9880-e56f241721f7",
                                        "glosses": [
                                            "In no place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98db661-ee45-4801-be34-ff6af430e982",
                                                "sense_id": "1ec7bd4f-84eb-3e5d-b78b-32fdf081e6b8",
                                                "text": "Nowhere did the rules say anything about popcorn."
                                            },
                                            {
                                                "example_id": "162e1c3d-ae55-456a-acbc-8ab7f5943ef6",
                                                "sense_id": "1ec7bd4f-84eb-3e5d-b78b-32fdf081e6b8",
                                                "text": "The keys are nowhere in the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a519134-cb7e-3a25-afcf-056cc09ebef8",
                                        "entry_id": "d8899560-4520-3042-9880-e56f241721f7",
                                        "glosses": [
                                            "To no place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8063426-896f-4f06-a925-84064f44a2ba",
                                                "sense_id": "7a519134-cb7e-3a25-afcf-056cc09ebef8",
                                                "text": "We sat in traffic, going nowhere."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nowhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b880067e-53b5-34a8-a6aa-0989662c9747",
                                        "entry_id": "ba7f0e81-7af9-3a3f-b182-d0979e862769",
                                        "glosses": [
                                            "Unimportant; unworthy of notice."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a38184a-1f70-4ceb-a38c-1ed97f2d6d8f",
                                                "sense_id": "b880067e-53b5-34a8-a6aa-0989662c9747",
                                                "text": "As a foreign stamp gazette it is nowhere. An article on Stamp Collecting, by J. E. Gray, “reprinted from one of his books,” and a catalogue of stamps constitute its sole attraction. We are surprised to find such sounding pretentions so poorly supported."
                                            },
                                            {
                                                "example_id": "2f55ee2d-c629-4982-8937-c46c14d65c94",
                                                "sense_id": "b880067e-53b5-34a8-a6aa-0989662c9747",
                                                "text": "Elinore was such a bitch, such a nowhere person."
                                            },
                                            {
                                                "example_id": "7f30e7a0-5e56-4805-8081-44872f29204e",
                                                "sense_id": "b880067e-53b5-34a8-a6aa-0989662c9747",
                                                "text": "He always allowed them to motivate him to a level of intensity to do better, rather than remain in a nowhere life in a nowhere place like Harlem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nowhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ba8aa3d-95ab-3b9f-bf90-1ceda0031fe5",
                                        "entry_id": "8ed3a58d-3eef-3722-b6ed-69e9c14f5e24",
                                        "glosses": [
                                            "No particular place, noplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0a0ef7-f07d-4dd1-925e-592a6640270c",
                                                "sense_id": "3ba8aa3d-95ab-3b9f-bf90-1ceda0031fe5",
                                                "text": "They went on a cruise to nowhere."
                                            },
                                            {
                                                "example_id": "5a1e1c34-2f8c-4644-9357-ed551e3d6e57",
                                                "sense_id": "3ba8aa3d-95ab-3b9f-bf90-1ceda0031fe5",
                                                "text": "While they paced the platform of the station, they reviewed the career of misdemeanours—Nutley, Chiddiugstone, Midhurst, Penn, and many nowheres, and now Aylesbury."
                                            },
                                            {
                                                "example_id": "ab793667-3956-47be-b8ef-aa48bacd575a",
                                                "sense_id": "3ba8aa3d-95ab-3b9f-bf90-1ceda0031fe5",
                                                "text": "On a warm summer's evening On a train bound for nowhere I met up with the gambler"
                                            },
                                            {
                                                "example_id": "4c567363-16cb-43d1-82ab-e478979c26a4",
                                                "sense_id": "3ba8aa3d-95ab-3b9f-bf90-1ceda0031fe5",
                                                "text": "Oh, not the middle of nowhere like the rest of Indiana, but a nowhere so flat and ugly you want to lie down in a ditch and never get up again."
                                            },
                                            {
                                                "example_id": "2c8816ed-4bd7-4da8-b56f-4f49256b1396",
                                                "sense_id": "3ba8aa3d-95ab-3b9f-bf90-1ceda0031fe5",
                                                "text": "But some Nowheres do still exist and are there to be found by any genuinely free spirit willing to hook a caravan behind his four-wheel-drive and dream, say, of finding that isolated campsite beside an as yet undiscovered waterhole"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68283873-6536-4c30-8ef8-6b15ca81e185",
                        "source_entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                        "target_lang_word": "nulle part",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nulle part",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2463f60a-6b22-30ce-ac47-575bc6c07ce3",
                                        "entry_id": "30c10c26-380a-317c-a471-779a2fa9f757",
                                        "glosses": [
                                            "En aucun endroit. — Note d’usage : Le plus souvent utilisé avec la particule négative ne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69f0f22-0822-4d5a-aa0c-5a347dbc6e49",
                                                "sense_id": "2463f60a-6b22-30ce-ac47-575bc6c07ce3",
                                                "text": "Où pouvons-nous d’ailleurs n'être nulle part comme dans un café ? Voici des chaises, un comptoir, deux glaces en vis-à- vis, des tables."
                                            },
                                            {
                                                "example_id": "6b06fd92-b5df-47e4-86d6-8dbb86bf814c",
                                                "sense_id": "2463f60a-6b22-30ce-ac47-575bc6c07ce3",
                                                "text": "Si profond était le fossé entre la bourgeoisie manufacturière et les ouvriers du textile que les luttes révolutionnaires, dans Sedan, prirent comme nulle part ailleurs le caractère d’un conflit entre classes."
                                            },
                                            {
                                                "example_id": "5c80ca43-7a9f-4f90-968b-a107bc23a0f1",
                                                "sense_id": "2463f60a-6b22-30ce-ac47-575bc6c07ce3",
                                                "text": "Il passa au peigne des pages de titres pour trouver un chapitre ou un article qui traitât de sujets en rapport avec la lèpre, mais nulle part la maladie n'était mentionnée."
                                            },
                                            {
                                                "example_id": "d07eb5bf-6063-4084-9f56-4d369ac1c97d",
                                                "sense_id": "2463f60a-6b22-30ce-ac47-575bc6c07ce3",
                                                "text": "Marié et établi en Belgique en 1911, Michel s’installa dans ce Bruxelles affairiste et mondain où la passion d’acquérir et le snobisme du nom et du titre sévissent comme nulle part ailleurs."
                                            },
                                            {
                                                "example_id": "c71a7d79-5503-4de5-b49b-ecd123a595a2",
                                                "sense_id": "2463f60a-6b22-30ce-ac47-575bc6c07ce3",
                                                "text": "— Il faut essayer de trouver des racines, comprends-tu ?\n— Oui.\n— On ne peut pas toujours être un homme de nulle part.\nIl avait appuyé sur les syllabes de « nulle part » avec coquetterie.\n— L’homme de nulle part…\nEt il se désignait de la main gauche, en inclinant la tête et en esquissant un sourire charmeur. Jadis cela devait être d’un certain effet sur les femmes."
                                            },
                                            {
                                                "example_id": "a53e3be4-987c-4cf0-83c7-ca3847e9442d",
                                                "sense_id": "2463f60a-6b22-30ce-ac47-575bc6c07ce3",
                                                "text": "Le regard ankylosé par trop d’impérities, je cherchais un improbable mais tant espéré soutien au loin, partout et nulle part, peut-être vers le ciel où s'était machinalement orientée ma tête; ce ciel où avaient établi leurs pénates, mon défunt père et mes regrettées sœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70e67cd1-7b82-3f9c-8c59-ed5d395b305b",
                                        "entry_id": "30c10c26-380a-317c-a471-779a2fa9f757",
                                        "glosses": [
                                            "Quelque part."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fdae597-4693-495d-9989-8689e0e5b2fe",
                                                "sense_id": "70e67cd1-7b82-3f9c-8c59-ed5d395b305b",
                                                "text": "Je ne sache pas qu’il existe nulle part en Europe un ensemble aussi complet et aussi formidable de défense des VIᵉ, XIIᵉ et XIIIᵉ siècles, un sujet d’étude aussi intéressant, et une situation plus pittoresque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa94fe49-09b8-4d7f-950e-a6e4b202011b",
                        "source_entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
