                                "target_lang_sense_clarification": "фамилия (немецкий вариант)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4c2c950-2fc3-3ccc-8846-52167988a215",
                    "sense_definition": "A unisex given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "given_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Winter</w> is a very unique name for a baby girl.",
                            "target_lang_translations": {
                                "ru": "<w>Уинтер</w> — очень необычное имя для девочки."
                            }
                        },
                        {
                            "text": "I went to school with a boy named <w>Winter</w> who loved art.",
                            "target_lang_translations": {
                                "ru": "Я ходил в школу с мальчиком по имени <w>Уинтер</w>, который любил искусство."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Унисекс имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уинтер",
                                "target_lang_sense_clarification": "личное имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41170d1e-c45f-374a-851f-110a1b3c771d",
                    "sense_definition": "A place name, such as a town in Wisconsin, USA.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locations",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small village of <w>Winter</w> is located in Sawyer County.",
                            "target_lang_translations": {
                                "ru": "Небольшая деревня <w>Уинтер</w> расположена в округе Сойер."
                            }
                        },
                        {
                            "text": "They drove through <w>Winter</w> on their way to the northern lakes.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Уинтер</w> по пути к северным озерам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States and Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название, например, город в штате Висконсин, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уинтер",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        }
