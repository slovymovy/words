{
    "word_family": [
        "slug",
        "sluggard"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "51537455-5e3b-34e0-a324-b3a38e46fb94",
                    "sense_definition": "Moving or operating at a slow speed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sluggish</w> river moved slowly through the valley.",
                            "target_lang_translations": {
                                "zh": "<w>缓慢的</w>河流在山谷中静静流淌。",
                                "es": "El río <w>lento</w> se movía despacio a través del valle."
                            }
                        },
                        {
                            "text": "Traffic was <w>sluggish</w> during the morning rush hour.",
                            "target_lang_translations": {
                                "zh": "早高峰期间交通十分<w>迟缓</w>。",
                                "es": "El tráfico estaba <w>lento</w> durante la hora punta de la mañana."
                            }
                        }
                    ],
                    "synonyms": [
                        "slow",
                        "crawling",
                        "creeping"
                    ],
                    "antonyms": [
                        "nimble"
                    ],
                    "common_phrases": [
                        "sluggish traffic",
                        "sluggish stream"
                    ],
                    "target_lang_definitions": {
                        "zh": "指移动或运行速度缓慢。",
                        "es": "Que se mueve o funciona a una velocidad reducida."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缓慢的",
                                "target_lang_sense_clarification": "形容动作或过程进展迟缓。"
                            },
                            {
                                "target_lang_word": "迟缓的",
                                "target_lang_sense_clarification": "形容反应或移动速度慢。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lento",
                                "target_lang_sense_clarification": "Que se mueve o sucede con velocidad reducida."
                            },
                            {
                                "target_lang_word": "pausado",
                                "target_lang_sense_clarification": "Que se realiza con calma y sin prisa."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac5eb766-73d3-3a31-a6ea-f10b5bb3deba",
                    "sense_definition": "Showing little activity or growth in an economic context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported <w>sluggish</w> sales for the third quarter.",
                            "target_lang_translations": {
                                "zh": "该公司报告称第三季度销售额<w>低迷</w>。",
                                "es": "La empresa reportó ventas <w>estancadas</w> durante el tercer trimestre."
                            }
                        },
                        {
                            "text": "A <w>sluggish</w> economy makes it difficult for new businesses to succeed.",
                            "target_lang_translations": {
                                "zh": "<w>疲软的</w>经济环境使得新企业难以成功。",
                                "es": "Una economía <w>lenta</w> dificulta el éxito de los nuevos negocios."
                            }
                        }
                    ],
                    "synonyms": [
                        "slow"
                    ],
                    "common_phrases": [
                        "sluggish economy",
                        "sluggish growth"
                    ],
                    "target_lang_definitions": {
                        "zh": "指经济活动或增长乏力、停滞不前。",
                        "es": "Que muestra poca actividad o crecimiento en un contexto económico."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "低迷的",
                                "target_lang_sense_clarification": "形容市场或经济表现不佳。"
                            },
                            {
                                "target_lang_word": "疲软的",
                                "target_lang_sense_clarification": "形容经济增长或销售额缺乏活力。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "estancado",
                                "target_lang_sense_clarification": "Que no progresa o no tiene movimiento."
                            },
                            {
                                "target_lang_word": "lento",
                                "target_lang_sense_clarification": "Que avanza con poca velocidad o dinamismo."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa1a4b3f-e57c-3dd4-81b1-59e8f10d8dc3",
                    "sense_definition": "Lacking energy or motivation to be active.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lazy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt <w>sluggish</w> after eating such a heavy lunch.",
                            "target_lang_translations": {
                                "zh": "吃了一顿丰盛的午餐后，我感到<w>无精打采</w>。",
                                "es": "Me sentí <w>letárgico</w> después de comer un almuerzo tan pesado."
                            }
                        },
                        {
                            "text": "The hot weather made everyone feel <w>sluggish</w> and tired.",
                            "target_lang_translations": {
                                "zh": "炎热的天气让每个人都感到<w>迟钝</w>且疲惫。",
                                "es": "El clima caluroso hizo que todos se sintieran <w>desganados</w> y cansados."
                            }
                        }
                    ],
                    "synonyms": [
                        "lazy",
                        "lethargic",
                        "indolent"
                    ],
                    "common_phrases": [
                        "feel sluggish"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人缺乏活力、精神萎靡或懒散。",
                        "es": "Que carece de energía o motivación para estar activo."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无精打采的",
                                "target_lang_sense_clarification": "形容人精神状态不佳，缺乏动力。"
                            },
                            {
                                "target_lang_word": "迟钝的",
                                "target_lang_sense_clarification": "形容人反应慢或身体沉重。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "letárgico",
                                "target_lang_sense_clarification": "Que siente falta de energía o somnolencia."
                            },
                            {
                                "target_lang_word": "desganado",
                                "target_lang_sense_clarification": "Que no tiene ganas o interés en hacer algo."
                            },
                            {
                                "target_lang_word": "apático",
                                "target_lang_sense_clarification": "Que muestra falta de entusiasmo o interés."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}