                "senses": [
                    {
                        "sense_id": "8b0c1b57-0b02-3380-8a55-05991876ec3f",
                        "entry_id": "47cf2398-6b2d-36c3-ba89-7d603e5952cf",
                        "glosses": [
                            "Treibstoff oder Kraftstoff, der nicht aus Erdöl oder Ölsand gewonnen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a055e4ad-cc6d-4d2f-849b-2570f2f3f6b0",
                                "sense_id": "8b0c1b57-0b02-3380-8a55-05991876ec3f",
                                "text": "Der Schein trügt beim Biosprit, dass dieser gut für die Umwelt sei."
                            },
                            {
                                "example_id": "81f582ba-ac57-4427-a42a-ed9a6cfc6693",
                                "sense_id": "8b0c1b57-0b02-3380-8a55-05991876ec3f",
                                "text": "„Allerdings boykottiert ebendiese Mehrheit auch den neuen Biosprit, schert sich kein bisschen um Ökostrom und dreht durch, wenn die jährliche Heizkostenabrechnung zwanzig Euro teurer ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6bca5b0-fc68-4ed8-81fa-4df0099a0417",
                        "source_entry_id": "47cf2398-6b2d-36c3-ba89-7d603e5952cf",
                        "source_sense_id": "8b0c1b57-0b02-3380-8a55-05991876ec3f",
                        "source_sense_description": "umgangssprachlich: Treibstoff oder Kraftstoff, der nicht aus Erdöl oder Ölsand gewonnen wird",
                        "target_lang_word": "biofuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biofuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                        "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                                        "glosses": [
                                            "Any fuel that is obtained from a renewable biological resource, especially from biomass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eef6db-0f59-4a0a-83e7-429aff85058c",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "Even second-generation biofuels, made from crop wastes or wood, are an environmental disaster, either extending the cultivated area or removing the straw and stovers which protect the soil from erosion and keep carbon and nutrients in the ground."
                                            },
                                            {
                                                "example_id": "86a12086-d47b-4836-84ed-afdac1311da3",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "The Environmental Protection Agency announced proposed changes to its biofuels program Tuesday to spur more biofuel use and crack down on waivers issued to refineries by the Trump administration, notching a win for the biofuels industry and farmers and a blow to oil refineries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
