                                "sense_id": "5beb41be-53e8-3ba6-8994-b658b34ef219",
                                "text": "Nie myślałam, że na obozie będzie aż tak wesoło z tymi dzieciakami."
                            },
                            {
                                "example_id": "9115be7c-74de-4624-91dc-8043f129d1f9",
                                "sense_id": "5beb41be-53e8-3ba6-8994-b658b34ef219",
                                "text": "Czeka na was przytulna sala z kominkiem, w którym wesoło iskrzy ogień"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb5bf2b1-f3bf-4c16-a3e7-1f0a2f6d8916",
                        "source_entry_id": "9ca33078-4399-3b5d-b5a2-29d7f7474d08",
                        "source_sense_id": "5beb41be-53e8-3ba6-8994-b658b34ef219",
                        "target_lang_word": "merrily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merrily",
