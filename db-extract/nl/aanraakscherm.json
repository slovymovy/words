                        "entry_id": "364c8e7c-7ec3-3864-8240-3955238a2bfd",
                        "glosses": [
                            "een beeldscherm dat ook als invoerapparaat voor een computer kan worden gebruikt door het scherm aan te raken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e854d4-3c4d-4633-8f15-7790f948eb65",
                                "sense_id": "bf6ee949-5a75-3268-bcd4-94ee1a9faef1",
                                "text": "Aanraakschermen worden vooral toegepast op palmtops en andere apparaten waar de ruimte beperkt is, maar kan eveneens op gewone computerschermen gebruikt worden."
                            }
                        ]
                    }
                ],
                "translations": [
