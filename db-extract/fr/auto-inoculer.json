                ],
                "senses": [
                    {
                        "sense_id": "668cff6d-ce43-366d-8c1d-89315002f6b7",
                        "entry_id": "57556d7a-b7c3-3bfc-ac91-9b8573a5badb",
                        "glosses": [
                            "Inoculer à soi-même, ou quelque chose qui provient du destinataire de l'inoculation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b87d8e7b-9ba7-4a8e-a0b1-d129a4613539",
                                "sense_id": "668cff6d-ce43-366d-8c1d-89315002f6b7",
                                "text": "En même temps que les recherches qui précèdent, nous avons institué une troisième série d'expériences consistant à auto-inoculer un groupe de génisses avec leur propre vaccin aux périodes successives de son évolution."
                            },
                            {
                                "example_id": "4bbd425d-6705-4167-9414-efb33911367b",
                                "sense_id": "668cff6d-ce43-366d-8c1d-89315002f6b7",
                                "text": "Ross réussit ensuite à s'auto-inoculer la malaria par piqûres de ces moustiques, un mode de transmission qu'il confirma ensuite avec d'autres « volontaires »."
                            },
                            {
                                "example_id": "e4d463cb-c1d8-4daa-80f1-a5940290f8bb",
                                "sense_id": "668cff6d-ce43-366d-8c1d-89315002f6b7",
                                "text": "Mais le chancroide possède un autre caractère beaucoup plus important qu'aucun de ceux mentionnés jusqu'ici, nous voulons parler de la propriété qu'il possède de s'auto-inoculer."
                            }
                        ]
                    }
                ],
