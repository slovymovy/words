                "senses": [
                    {
                        "sense_id": "d7a43c6a-81ab-34fe-a00e-dfc62f555fb0",
                        "entry_id": "d76cbdb9-a16a-3861-9ee8-c3b7e2e0c642",
                        "glosses": [
                            "Ce qui permet de se défouler."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f9934e13-adb8-4fa6-8e2d-fc3cb23b226c",
                                "sense_id": "d7a43c6a-81ab-34fe-a00e-dfc62f555fb0",
                                "text": "Il s’agit là d’une sorte de défouloir, d’abord pour des individus en position d’autorité (parents, enseignants, chefs de toutes sortes), pour se venger sur les plus faibles qu’eux des critiques qu’on leur a fait subir à l’époque où ils étaient faibles eux-mêmes."
                            },
                            {
                                "example_id": "01baf152-eb93-4392-8b33-4fb8b7546923",
                                "sense_id": "d7a43c6a-81ab-34fe-a00e-dfc62f555fb0",
                                "text": "J’arrive justement à un moment jouissif et défouloir : l’explosion à la masse d’une épave, qui servira ensuite à la démonstration de désincarcération des sapeurs-pompiers locaux."
                            },
                            {
                                "example_id": "7e17c6bb-9730-4a5c-9db4-1ac712ecc2d1",
                                "sense_id": "d7a43c6a-81ab-34fe-a00e-dfc62f555fb0",
                                "text": "Je me demande même si une société violente n’a pas besoin de cette violence organisée et mise sur scène pour servir de défouloir collectif."
                            },
                            {
                                "example_id": "03bfd568-e47a-4d6d-98e0-6eb051e851ff",
                                "sense_id": "d7a43c6a-81ab-34fe-a00e-dfc62f555fb0",
                                "text": "– Simpliste ? Je ne suis qu’un interlude pour toi, un défouloir sexuel pour oublier ton deuil."
                            }
                        ]
                    }
                ],
