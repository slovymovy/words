                                    {
                                        "sense_id": "ff72b8d5-cbe7-396d-8848-2a6355c4f4e9",
                                        "entry_id": "383c882b-437f-3abd-a1a7-cafe9846eb5c",
                                        "glosses": [
                                            "A large Oriental tobacco pipe wherein the smoke is drawn through water to filter and cool it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5fd939c-7379-491d-8b75-13456dc8535c",
                                                "sense_id": "ff72b8d5-cbe7-396d-8848-2a6355c4f4e9",
                                                "text": "He went to the Pyramids and Syria, and there left his malady behind him, and returned with a fine beard, and a supply of tarbooshes and nargillies, with which he regales all his friends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9992653-0fe8-4ced-9ec6-77e9d7e46401",
                        "source_entry_id": "496c93e7-27e3-303e-9b5b-6bf98c6787b9",
                        "source_sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                        "source_sense_description": "orientalische Wasserpfeife",
                        "target_lang_word": "narguilé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narguilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df13d2fc-a4f0-3072-a7a1-ca09db393dfd",
                                        "entry_id": "802de2b5-efcb-35b6-aa1f-0cb88cf8bf24",
                                        "glosses": [
                                            "Pipe formée d’un fourneau, où brûle le tabac, et d’un long tuyau qui traverse un vase rempli d’eau parfumée, en usage en Turquie, en Perse et au Moyen-Orient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4add8e8b-9bb7-45da-9564-eb6998db0345",
                                                "sense_id": "df13d2fc-a4f0-3072-a7a1-ca09db393dfd",
                                                "text": "Ali, silencieux et attentif, apporta le tabac et les narguilés, servit le café et disparut."
                                            },
                                            {
                                                "example_id": "d208c696-af7e-42c4-8f3d-d94e875b5676",
                                                "sense_id": "df13d2fc-a4f0-3072-a7a1-ca09db393dfd",
                                                "text": "Le cheikh n’était plus à sa place. Chose curieuse, le bout doré de son narguilé traînait par terre. D’ordinaire, quand il se levait, il enroulait le tuyau autour du foyer, d’une geste machinal, et retirait le bout pour le garder propre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9503a90f-b5e8-3ae9-bc3d-ad691fa82ec2",
                                        "entry_id": "802de2b5-efcb-35b6-aa1f-0cb88cf8bf24",
                                        "glosses": [
                                            "Tuyau qui fournit l’air au scaphandrier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebf31e88-44a4-456c-af45-7ea3c728fc4f",
                        "source_entry_id": "496c93e7-27e3-303e-9b5b-6bf98c6787b9",
                        "source_sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                        "source_sense_description": "orientalische Wasserpfeife",
                        "target_lang_word": "narghilé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narghilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "470983a2-72b5-3270-b9f7-d6205c129f5e",
                                        "entry_id": "707aa129-b80a-32ad-a824-a4396a341748",
                                        "glosses": [
                                            "Variante de narguilé."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1dd4cad-22ab-4cd2-90d8-cf6881eeda77",
                                                "sense_id": "470983a2-72b5-3270-b9f7-d6205c129f5e",
                                                "text": "Chaque soir, on nous trouve, comme deux bons Orientaux, fumant notre narguilhé sous les platanes d’un café turc."
                                            },
                                            {
                                                "example_id": "3407ec6e-61c1-4bb3-8fa1-ea8b98a75c48",
                                                "sense_id": "470983a2-72b5-3270-b9f7-d6205c129f5e",
                                                "text": "Ali, silencieux et attentif, apporta le tabac et les narghilés, servir le café et disparut."
                                            },
                                            {
                                                "example_id": "4d8072a9-7241-43bc-95b6-d78aff1d38f8",
                                                "sense_id": "470983a2-72b5-3270-b9f7-d6205c129f5e",
                                                "text": "Dans la braise fumant au font de l'alvéole,\nEt nimbée alentour d'une frêle auréole,\nKarifé reconnu le feu d'un narghilé."
                                            },
                                            {
                                                "example_id": "f1d93017-10ce-48a7-ae1c-2f41b96477f6",
                                                "sense_id": "470983a2-72b5-3270-b9f7-d6205c129f5e",
                                                "text": "Un batcha mit entre les mains de Toursène un narghilé. Toursène en porta le bec à ses lèvres, et laissa pénétrer dans ses poumons la fumée rafraîchie par l’eau du récipient."
                                            },
                                            {
                                                "example_id": "e5483d68-e22f-4bdd-9f5a-92b954f9209f",
                                                "sense_id": "470983a2-72b5-3270-b9f7-d6205c129f5e",
                                                "text": "Les moins pauvres appelaient à grands cris l’un des batchas qui circulaient à travers la foule avec des narghilés pour l’usage desquels on payait bouffée par bouffée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
