{
    "word": "one-time",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3a02b3b6-72b8-3f20-a2b5-c5b20277796f",
                "word": "one-time",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                        "entry_id": "3a02b3b6-72b8-3f20-a2b5-c5b20277796f",
                        "glosses": [
                            "Of or pertaining to a specific period of time in the past, not extending to the present."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9041d2b0-da49-4483-936a-ac2ee83dca20",
                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                "text": "He was the one-time president of the club."
                            },
                            {
                                "example_id": "dc6dde85-ee64-461e-b335-867118ce50b6",
                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                "text": "His one-time investment in a brickyard had put the idea into his head—an idea that he decided was a good one, for it enabled him to suggest that she ride along with him to inspect the quarry."
                            },
                            {
                                "example_id": "7b093a76-38f5-4387-a261-4ca7c66f263f",
                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                "text": "Pollyanna never doubted now that John Pendleton was her Aunt Polly's one-time lover; […]"
                            },
                            {
                                "example_id": "6b208f16-44eb-4848-ba05-6198806b2a1e",
                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                "text": "The old Ramsgate Harbour station of the one-time South Eastern Railway was a case in point, as also the stations in the Isle of Wight that you name, such as Ventnor West."
                            },
                            {
                                "example_id": "1f2cf204-74b6-46ca-beb5-55dd2db52741",
                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                "text": "Has the one-time wonder fuel become the new asbestos – not to say mustard gas?"
                            }
                        ]
                    },
                    {
                        "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                        "entry_id": "3a02b3b6-72b8-3f20-a2b5-c5b20277796f",
                        "glosses": [
                            "Occurring or used in a single instance and then never again."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "facca33e-a539-4f56-b556-a8fba7358818",
                                "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                                "text": "one-time charge/payment"
                            },
                            {
                                "example_id": "1de858ab-de8b-4b90-95eb-ace5f228709a",
                                "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                                "text": "He was an eloquent speaker, and his slip of the tongue was a one-time error."
                            },
                            {
                                "example_id": "25919889-58e3-4081-b9b2-1dd18263df57",
                                "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                                "text": "Even if an attacker manages to intercept a one-time password, that password has already been used and is no longer usable to authenticate."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b661919-6f55-4b32-b094-956f9f76b20a",
                        "source_entry_id": "3a02b3b6-72b8-3f20-a2b5-c5b20277796f",
                        "source_sense_description": "of or pertaining to a specific time in the past — see also former, erstwhile",
                        "target_lang_word": "ehemalig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ehemalig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                        "entry_id": "0b5f42f5-4e56-302b-9c41-31f1c7b56c34",
                                        "glosses": [
                                            "nicht mehr existent oder nicht mehr bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4df7f26-743d-4ce7-bd5a-e80c9aa4e1af",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "Ich hab gestern meinen ehemaligen Chef getroffen."
                                            },
                                            {
                                                "example_id": "d739c384-d54e-4e88-bc77-ef01aa5108f6",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Das kann auch nicht jeder behaupten, dass sein ehemaliger Spanischlehrer der Direktor des Phallusmuseums ist, denke ich.“"
                                            },
                                            {
                                                "example_id": "98871611-ea1d-4864-893a-a46f5998ca92",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Die zerklüftete Kraterlandschaft der ehemaligen Braunkohletagebaus ist eine faszinierende, menschengemachte Landschaft.“"
                                            },
                                            {
                                                "example_id": "e3dba4b6-6d2f-48b3-9fd5-904f470b266d",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                                            },
                                            {
                                                "example_id": "5e5c88ed-1f1a-474e-abe8-1ac96b77fc8c",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Der ehemalige US-Präsident Trump hat im Prozess um manipulierte Vermögenswerte die vom Gericht neu festgelegte Kaution über 175 Millionen Dollar hinterlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67bb5b30-6084-4d62-8ea4-8fd72437a21f",
                        "source_entry_id": "3a02b3b6-72b8-3f20-a2b5-c5b20277796f",
                        "source_sense_description": "of or pertaining to a specific time in the past — see also former, erstwhile",
