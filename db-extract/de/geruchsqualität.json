                ],
                "senses": [
                    {
                        "sense_id": "b413f444-63a9-3e10-b889-7993cea62c96",
                        "entry_id": "6d6c0711-e53c-3de6-815f-901b707980f3",
                        "glosses": [
                            "individuell und konkret definierte Eigenschaft von Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "735832ce-2845-43b2-940f-d95954f1dae1",
                                "sense_id": "b413f444-63a9-3e10-b889-7993cea62c96",
                                "text": "„Es ist bisher nicht gelungen, unter den vielen vom Menschen unterscheidbaren Duftstoffen Geruchsqualitäten voneinander abzugrenzen.“"
                            },
                            {
                                "example_id": "d52309e5-b609-4ea8-9fbb-271a05be0239",
                                "sense_id": "b413f444-63a9-3e10-b889-7993cea62c96",
                                "text": "„Die Geruchsqualität \"Rind“ wirkt kaum belästigend, gefolgt von der Geruchsqualität \"Schwein“ mit einer deutlich größeren Belästigungswirkung und der Geruchsqualität \"Geflügel“ mit der stärksten Belästigungswirkung.“"
                            },
                            {
                                "example_id": "63281871-a8fe-45be-b645-3bd3534d2d5d",
                                "sense_id": "b413f444-63a9-3e10-b889-7993cea62c96",
                                "text": "„Zusätzlich kann die Geruchsqualität auch von der Konzentration abhängen.“"
                            },
                            {
                                "example_id": "1b35f658-b8eb-4981-aac0-bc2d9c516e99",
                                "sense_id": "b413f444-63a9-3e10-b889-7993cea62c96",
                                "text": "„Unter der Geruchsqualität (oft auch mit Geruchscharakteristik bezeichnet) versteht man die verbale Beschreibung eines Geruchs auf der Basis von Geruchserfahrungen, wobei meistens Adjektive (zB süß, minzig, faulig) oder Substantive verwendet werden, die die vermutete Quelle nennen (es riecht zB nach: Rauch, Kohl oder Rosen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
