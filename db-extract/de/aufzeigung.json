                                        "sense_id": "0f59220f-a755-3841-b4a6-6640203113cf",
                                        "entry_id": "24fc8b26-7d88-3dec-b0f0-48fbd60062ff",
                                        "glosses": [
                                            "The act of illustrating; the act of making clear and distinct."
                                        ],
