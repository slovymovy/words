                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9e8a106-9117-4f93-a2a2-c2659f12b490",
                        "source_entry_id": "3f1dcfb2-ddb1-3b13-a09b-c395f712baf2",
                        "source_sense_id": "46b31aeb-f167-310a-b253-26473c45598b",
                        "target_lang_word": "Arès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c69b91d8-9c98-3547-bc0b-1179a790226b",
                                        "entry_id": "5d8c3fe7-3bc7-3df2-b0e9-8c75d84678f2",
                                        "glosses": [
                                            "Dieu de la guerre, fils de Zeus et d’Héra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f889a3-e5c4-43f6-9683-d0eea412fe7a",
                                                "sense_id": "c69b91d8-9c98-3547-bc0b-1179a790226b",
                                                "text": "Mars, identifié avec le dieu grec Arès, l'a été aussi avec le dieu gaulois Toutatis; Minerve, confondue avec la déesse grecque Athéna, l'a été aussi avec la déesse gauloise Belisama, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Arès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c36a95ce-37f6-3273-8f41-d9cbe5629223",
                                        "entry_id": "0dea1abf-8029-3241-b8dd-7f9ee1bb38d2",
                                        "glosses": [
                                            "Commune française, située dans le département de la Gironde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a4ab86-8105-451a-9c3e-f13d55ea0d36",
                                                "sense_id": "c36a95ce-37f6-3273-8f41-d9cbe5629223",
                                                "text": "Je n’ai jamais su pourquoi le boulevard où nous résidons se nomme Javal, […], pas plus que la raison pour laquelle cette petite cité balnéaire s’appelle Arès.\nC’est là, à Arès, que j’ai vécu les plus belles vacances de ma vie, des moments d’insouciance, de rêverie et de découverte."
                                            },
                                            {
                                                "example_id": "f31c40db-6ce9-4784-8aca-b7151ea037ee",
                                                "sense_id": "c36a95ce-37f6-3273-8f41-d9cbe5629223",
                                                "text": "En venant d’Arès et en arrivant sur Lège, après le pont du canal, à env. 4 km de Claouey, prendre à droite direction « Le Grand Crohot » ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
