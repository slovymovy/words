                ],
                "senses": [
                    {
                        "sense_id": "ed49ec82-0c60-3075-b45d-e7924bc96747",
                        "entry_id": "04178832-3d04-389d-ae15-2ea24c61918b",
                        "glosses": [
                            "An infantryman; a soldier."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "03644330-2444-40a4-8b18-290647e01c1c",
                                "sense_id": "ed49ec82-0c60-3075-b45d-e7924bc96747",
                                "text": "In any event we soon had the Army jawan sent by the Major with us in the boat and headed for shore."
                            },
                            {
                                "example_id": "bab97b47-ff1c-4a3c-9820-cf4270359f14",
                                "sense_id": "ed49ec82-0c60-3075-b45d-e7924bc96747",
                                "text": "He obviously expected one of the senior army officials to walk over and talk to the jawan."
                            },
                            {
                                "example_id": "1431d2db-fe85-4c71-8484-c2f0ad4f9b10",
                                "sense_id": "ed49ec82-0c60-3075-b45d-e7924bc96747",
                                "text": "They could now see a whole lot of army jawans in gum boots looking for something in the mud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "877a29c8-4335-49e0-8ee4-bff011863ae3",
                        "source_entry_id": "04178832-3d04-389d-ae15-2ea24c61918b",
                        "source_sense_id": "ed49ec82-0c60-3075-b45d-e7924bc96747",
                        "source_sense_description": "infantryman, soldier",
                        "target_lang_word": "infanterist",
