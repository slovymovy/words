                    {
                        "translation_id": "3dc55d35-4dee-43c6-9d13-99d9a76ebb00",
                        "source_entry_id": "cf3565de-a666-33e8-99af-1989d45d10e1",
                        "source_sense_id": "26c139e9-ed53-361b-b4ea-4282c5b22c13",
