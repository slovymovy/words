                                        "entry_id": "d1ce3ee2-aed5-37c7-be2b-511384093472",
                                        "glosses": [
                                            "Celle qui pollue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d8d3be-f41b-477b-b625-6ed7a0ceb50a",
                                                "sense_id": "47d77592-8f8f-3ac5-83d0-9a35bfba08a2",
                                                "text": "Dis, la pollueuse, tu ne saurais pas s’il y a une auberge pour les jeunes ici, ou un truc dans le genre, c’est la demoiselle qui cherche."
                                            }
                                        ]
                                    }
                                ]
