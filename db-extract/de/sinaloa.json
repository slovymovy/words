                        "examples": [
                            {
                                "example_id": "938a4547-c7f0-482a-b6e3-91a2809a3615",
                                "sense_id": "8272a398-3050-3c80-9855-ae0bee4eb994",
                                "text": "„Der Arzthelfer war ein Student aus Sinaloa, der sich hier ausbilden ließ.“"
                            },
                            {
                                "example_id": "56860c7c-e3b6-4c31-a8f9-dbbf6c1e867d",
                                "sense_id": "8272a398-3050-3c80-9855-ae0bee4eb994",
                                "text": "„Court war sich nicht sicher, ob sie noch in Sonora waren oder es runter nach Sinaloa oder gar nach Nayarit geschafft hatten, wo sein mexikanischer Albtraum am Grab von Eddie Gamboa begonnen hatte.“"
                            },
                            {
                                "example_id": "d6c3611b-ad59-4818-badc-ca622297173c",
                                "sense_id": "8272a398-3050-3c80-9855-ae0bee4eb994",
                                "text": "„Ich hatte von dieser Geschichte zwar gelesen, aber ich hatte nicht verstanden, wie wichtig sie war, bis ich Sinaloa kennenlernte, eine Landzunge, ein Paradies, in dem man mit den schlimmsten Höllenqualen bestraft werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
