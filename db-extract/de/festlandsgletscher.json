                "senses": [
                    {
                        "sense_id": "c28dbe45-23fd-3dae-a272-2721bb288638",
                        "entry_id": "91ad71c3-e2de-3584-a0a0-cc8f2d030515",
                        "glosses": [
                            "langfristig gefrorene, sich bewegende Eismasse (Gletscher), die sich auf dem Festland (zum Beispiel in Europa, Nordamerika, Nordasien) befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da9b062-d415-4ef2-bd36-316728c67066",
                                "sense_id": "c28dbe45-23fd-3dae-a272-2721bb288638",
                                "text": "„Von einigen der höchsten Gipfel reichen Gletscher bis auf das Fjell herab. Dazu gehört auch der Jostedalsbre, der größte Festlandsgletscher Europas.“"
                            },
                            {
                                "example_id": "84a93d20-5656-4246-900a-5454f3c19dbc",
                                "sense_id": "c28dbe45-23fd-3dae-a272-2721bb288638",
                                "text": "„Der Folgefonna (auch Folgefonni genannt) ist der er drittgrößte Festlandsgletscher Norwegens (nach Jostedalsbreen und Svartisen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
