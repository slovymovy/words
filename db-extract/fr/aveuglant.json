                ],
                "senses": [
                    {
                        "sense_id": "3926c568-5df2-3e95-aa6d-3da8cd9461ab",
                        "entry_id": "c9b2ba36-b1ee-3932-a868-b99e9e230d31",
                        "glosses": [
                            "Qui rend aveugle, qui provoque la perte de la vision, la cécité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a317c993-23a7-4a15-a648-e2886dc7c143",
                                "sense_id": "3926c568-5df2-3e95-aa6d-3da8cd9461ab",
                                "text": "Les UV réverbérés par la neige sont aveuglants à moyen terme."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0a9b8a6-48bf-331c-a132-eb4e7de20ea0",
                        "entry_id": "c9b2ba36-b1ee-3932-a868-b99e9e230d31",
                        "glosses": [
                            "Qui empêche momentanément de voir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71151f6-1db8-4028-be08-988b45d1d956",
                                "sense_id": "b0a9b8a6-48bf-331c-a132-eb4e7de20ea0",
                                "text": "Et Le Gonidec saute à l'eau aveuglante. Il nage tant bien que mal, et donne contre une échelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "e512749e-ce14-3c8e-b800-4f2c8d753e24",
                        "entry_id": "c9b2ba36-b1ee-3932-a868-b99e9e230d31",
                        "glosses": [
                            "Qui empêche momentanément de voir correctement en raison d’une lumière trop intense."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "92a5998f-c41d-43c9-814c-17ea28133b02",
                                "sense_id": "e512749e-ce14-3c8e-b800-4f2c8d753e24",
                                "text": "Aveuglante comme le soleil de Sétif, la solution, la seule, la vraie, était là, qui, dès le début, l’avait effleuré et qu’il avait repoussée comme un grand niquedouille sentimental qu’il était."
                            },
                            {
                                "example_id": "5684b0c2-9ca7-4347-8e15-e21c18ca74af",
                                "sense_id": "e512749e-ce14-3c8e-b800-4f2c8d753e24",
                                "text": "Alors des flammes aveuglantes jaillirent dans toutes les directions autour du point où le projectile toucha terre, et l’homme qui avait sauté devint, pendant quelques secondes, un éclat de feu et disparut… entièrement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0caa2788-d7a3-4649-a4d6-2815003ac246",
                        "source_entry_id": "c9b2ba36-b1ee-3932-a868-b99e9e230d31",
