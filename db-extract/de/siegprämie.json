                "senses": [
                    {
                        "sense_id": "7c4be2dd-4008-3ae5-9c5b-e2fbe8bbad7e",
                        "entry_id": "08d33c3a-07b0-31cc-b5c5-d1262f37b735",
                        "glosses": [
                            "Prämie, die für den Sieg in einem Wettbewerb in Aussicht gestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88977d69-41e9-400b-b01d-3837b67db131",
                                "sense_id": "7c4be2dd-4008-3ae5-9c5b-e2fbe8bbad7e",
                                "text": "„Der Triumph lohnte sich auch finanziell, gab es doch eine Siegprämie von 500.000 Euro, die der THW gerade in der wirtschaftlich schwierigen Corona-Zeit gut gebrauchen kann.“"
                            },
                            {
                                "example_id": "9a746c89-9079-4fd2-9b75-7b505ce636ab",
                                "sense_id": "7c4be2dd-4008-3ae5-9c5b-e2fbe8bbad7e",
                                "text": "„In der Marshall Arena von Milton Keynes, einer Retortenstadt nördlich von London, treten sie in zwei Gruppenphasen und anschließenden K.-o.-Runden gegeneinander an, um bis zum 11. Juni den Empfänger der Siegprämie über 30.000 Pfund zu ermitteln.“"
                            }
                        ],
