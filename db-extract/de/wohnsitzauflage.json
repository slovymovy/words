                ],
                "senses": [
                    {
                        "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                        "entry_id": "c3c73932-ffa9-36aa-ae9e-9a38a4c02cf5",
                        "glosses": [
                            "behördliche Anweisung, einen bestimmten Wohnort zu wählen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8664f2-7af1-4109-a882-7dfe4d67addf",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Auch rechtlich seien die Pläne für eine Wohnsitzauflage problematisch.“"
                            },
                            {
                                "example_id": "e0bc8088-58be-444a-9c70-514d26f3e735",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Bei der aktuellen Diskussion geht es genau genommen nicht um eine Residenzpflicht, sondern um eine Wohnsitzauflage.“"
                            },
                            {
                                "example_id": "8bcfa539-b957-47ae-9569-743755047a35",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Wohnsitzauflagen für Migranten können zulässig sein, wenn sie der Integration dienen sollen.“"
                            },
                            {
                                "example_id": "88829959-4ae2-44bd-8170-bfbf0b6d7b24",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Unter einer Residenzpflicht, oftmals auch Wohnsitzauflage genannt, versteht man gemeinhin die Pflicht, sich für einen bestimmten Zeitraum in einem von einer Behörde festgesetzten Gebiet aufzuhalten.“"
                            },
                            {
                                "example_id": "3009f7f6-771e-4967-a4a5-669b45cd0f72",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„In Österreich sei man in der Diskussion noch lange nicht so weit, erklärt Mödlhammer: ‚Erst müssen wir eine länderübergreifende Lösung für die Mindestsicherung finden, dann kann ich mir vorstellen, dass wir über die Wohnsitzauflage sprechen.‘“"
                            },
                            {
                                "example_id": "355554fe-2738-4b0a-9104-beba1abd0f36",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Diese Wohnsitzauflage wird für drei Jahre befristet eingeführt, tritt aber rückwirkend zum 1. Januar 2016 in Kraft.“"
                            },
                            {
                                "example_id": "e011b60c-f6d4-44be-8be6-c623f2bf5f1b",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Vor allem die Wohnsitzauflage und die Sanktionen sind von mehreren Verbänden wie der Diakonie und Pro Asyl kritisiert worden.“"
                            },
                            {
                                "example_id": "8196b3a9-74c0-4115-97e2-469835a1021e",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Für anerkannte, arbeitslose Asylbewerber und Flüchtlinge wird eine vorübergehende Wohnsitzauflage eingeführt.“"
                            },
                            {
                                "example_id": "88a578b6-ee0b-408b-9971-496f1586d9c4",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Angesichts der jüngsten Arbeitslosenzahlen erneuerte Sozialminister Alois Stöger (SPÖ) am Montag gegenüber der ‚Presse‘ seine Forderung, dass auch in Österreich eine Wohnsitzauflage für Flüchtlinge eingeführt werden soll.“"
                            },
                            {
                                "example_id": "172dfbb6-b3a8-40f4-af2c-6c7eab629faf",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Auch Sachsen plant eine Wohnsitzauflage, in Thüringen streitet die rot-rot-grüne Koalition derzeit über das Für und Wider einer solchen Regelung.“"
                            },
                            {
                                "example_id": "98b7e7cb-3649-4798-b3f1-f0e6e56cfdb4",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Die Thüringer Landesregierung will Mitte September darüber entscheiden, ob sie eine Wohnsitzauflage einführen will.“"
                            },
                            {
                                "example_id": "4fd3b3f8-b756-4c79-9dd0-6f3c79326ba5",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Der Flüchtlingsrat Thüringen spricht sich gegen eine Wohnsitzauflage für Flüchtlinge innerhalb des Freistaats aus.“"
                            },
                            {
                                "example_id": "36189161-6e6b-4f03-8dda-278f89200fff",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Als erstes Bundesland hat Bayern die Wohnsitzauflage für Flüchtlinge eingeführt.“"
                            },
                            {
                                "example_id": "48f31990-f591-426c-b0be-7d8068e5fe87",
                                "sense_id": "7c148945-3c7e-35c3-a429-8c52a779af89",
                                "text": "„Im Unterschied zur Residenzpflicht verpflichtet die Wohnsitzauflage Asylbewerber und Geduldete nicht, sich nur in einem bestimmten Bereich der Ausländerbehörde physisch aufzuhalten, sondern die Wohnsitzauflage verpflichtet, in einem bestimmten Ort zu wohnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
