                        "glosses": [
                            "lange, gekrulde beharing van het schaap Ovis aries"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8317e047-bb85-4d7c-a703-a478421882d5",
                                "sense_id": "ec0a1bca-0de6-3659-ab53-61a988c01c3f",
                                "text": "De wolvenkaken malen alles met gemak fijn. Alleen schapenvacht is vaak te dik en te wollig om te verteren."
                            }
                        ]
                    },
                    {
                        "sense_id": "85b79238-99e0-3481-993d-e1992e809685",
                        "entry_id": "3bfc2fc0-a457-3a70-afff-ecea537796d4",
                        "glosses": [
                            "geprepareerde huid met beharing van een schaap Ovis aries, of kunststof nabootsingen daarvan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "479d8752-40c2-4d1c-9602-be1ec9688c9f",
                                "sense_id": "85b79238-99e0-3481-993d-e1992e809685",
                                "text": "De gordijnen zijn van rood velours, schapenvachten op de grond, de houtkachel knappert knus."
                            },
                            {
                                "example_id": "1c42b85e-4f6c-4e78-95a6-c62fd5cc3a80",
                                "sense_id": "85b79238-99e0-3481-993d-e1992e809685",
                                "text": "Er staan lekkere rieten stoelen met een schapenvachtje, stoere houten tafels met eenvoudige stoelen; binnen oogt het allemaal aangeharkt ruraal."
                            }
                        ]
                    }
