                ],
                "senses": [
                    {
                        "sense_id": "dc1812e0-71bc-3564-a02b-2ebd3b8484a6",
                        "entry_id": "da8b1f79-22b9-38a3-b642-bed324e9d247",
                        "glosses": [
                            "mit Samt bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63987d76-4dd4-468a-81c7-58fde1054bda",
                                "sense_id": "dc1812e0-71bc-3564-a02b-2ebd3b8484a6",
                                "text": "„Alexander und der Polizist trugen Annie in den Salon und legten sie auf die alte samtbezogene Couch.“"
                            },
                            {
                                "example_id": "33d357b2-04fa-49a5-adb0-6ac2d6a2bd2b",
                                "sense_id": "dc1812e0-71bc-3564-a02b-2ebd3b8484a6",
                                "text": "„Der Chef de partie hob die samtbezogene Kette hoch, die den Zugang versperrte.“"
                            },
                            {
                                "example_id": "df8159ca-3fe0-4eaa-a977-b67f52d5fc73",
                                "sense_id": "dc1812e0-71bc-3564-a02b-2ebd3b8484a6",
                                "text": "„Dann schiebt er ein samtbezogenes Zweiersofa hinaus.“"
                            },
                            {
                                "example_id": "8dbb5800-d095-4b0d-b799-16de594bfbed",
                                "sense_id": "dc1812e0-71bc-3564-a02b-2ebd3b8484a6",
                                "text": "„Li deutete auf die beiden anderen samtbezogenen Stühle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
