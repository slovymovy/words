                    {
                        "translation_id": "e83c4595-907b-43ec-8969-abafc9373e18",
                        "source_entry_id": "c3cb6d59-a559-3832-851c-7ef791ec0b5d",
                        "target_lang_word": "неврология",
                        "target_lang_code": "ru",
