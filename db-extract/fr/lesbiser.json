                "senses": [
                    {
                        "sense_id": "3515cb1c-70bf-3bda-bba9-45dbf49eb17c",
                        "entry_id": "51b5abb6-8322-374e-8ac9-73f254c33774",
                        "glosses": [
                            "Avoir un rapport sexuel entre femmes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d69a1c53-a7a0-40f5-81ae-2714ca02ab32",
                                "sense_id": "3515cb1c-70bf-3bda-bba9-45dbf49eb17c",
                                "text": "« J'avais un rendez-vous avec Madame Lallemant ; je devançai l'heure et je trouvai ma belle lesbisant avec la limonadière (Madame Beugnet, femme d'un graveur sur bois). Que faire à vingt-un ans, brûlé par la vue et par tous les autres sens ? Paphiser ces deux lesbiennes. Ce fut ce que je fis. »"
                            }
                        ]
                    }
