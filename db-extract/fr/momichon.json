                        ],
                        "examples": [
                            {
                                "example_id": "a05f277a-1d70-4ccb-8f76-4f3aedb80e4e",
                                "sense_id": "bfdd85ae-8732-3004-a875-41c6989e1453",
                                "text": "Amène-toi morveux : on est grands, merde aux gniards. Ça te travaille pas, la glande, momichon ? Ça va le faire. Ça vient, a pas peur."
                            },
                            {
                                "example_id": "5d62405e-6caf-4a13-9422-59fc249681c2",
                                "sense_id": "bfdd85ae-8732-3004-a875-41c6989e1453",
                                "text": "Ailleurs, le même Saint-Anne ayant rencontré deux momichons de dix et douze ans : […]."
                            },
                            {
                                "example_id": "7bb6baa4-8add-418c-b694-ead3927c36c8",
                                "sense_id": "bfdd85ae-8732-3004-a875-41c6989e1453",
                                "text": "Malgré ce prénom que j'aime tant, le plus beau, oui, le plus beau, je lui fais — intérieurement — la grimace, à la momichonne."
                            }
                        ]
                    }
                ],
