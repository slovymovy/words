{
    "word_family": [
        "pelt",
        "pelter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ee8e90d-7329-30c3-8803-e13d969707bf",
                    "sense_definition": "present participle and gerund of <w>pelt</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hit_repeatedly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry protesters began <w>pelting</w> the government building with stones and rotten fruit.",
                            "target_lang_translations": {
                                "ru": "Разгневанные протестующие принялись <w>забрасывать</w> здание правительства камнями и гнилыми фруктами."
                            }
                        },
                        {
                            "text": "Cold rain was <w>pelting</w> down against our faces as we ran to the shelter.",
                            "target_lang_translations": {
                                "ru": "Холодный дождь <w>хлестал</w> нам в лица, пока мы бежали к укрытию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pelting down",
                        "pelting with stones"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола pelt (забрасывать, осыпать ударами, хлестать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забрасывание",
                                "target_lang_sense_clarification": "камнями, предметами"
                            },
                            {
                                "target_lang_word": "забрасывающий",
                                "target_lang_sense_clarification": "причастие: бросающий предметы"
                            },
                            {
                                "target_lang_word": "хлещущий",
                                "target_lang_sense_clarification": "об осадках: о дожде, граде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1a958c2-d5ff-3653-a6f9-a11e01df0921",
                    "sense_definition": "The act of striking or bombarding someone or something with repeated blows or projectiles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hit_repeatedly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>pelting</w> of heavy hail badly damaged the roof of the greenhouse.",
                            "target_lang_translations": {
                                "ru": "Непрерывные <w>удары</w> крупного града сильно повредили крышу теплицы."
                            }
                        },
                        {
                            "text": "They shielded their faces to protect themselves from the severe <w>pelting</w> of sand during the storm.",
                            "target_lang_translations": {
                                "ru": "Они закрывали лица, чтобы защититься от яростного <w>секущего удара</w> песчинок во время бури."
                            }
                        }
                    ],
                    "synonyms": [
                        "bombardment",
                        "barrage"
                    ],
                    "common_phrases": [
                        "pelting of rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по нанесению частых ударов или непрерывное забрасывание предметами, осадками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забрасывание",
                                "target_lang_sense_clarification": "камнями или снарядами"
                            },
                            {
                                "target_lang_word": "барабанящий стук",
                                "target_lang_sense_clarification": "ударов дождя, града"
                            },
                            {
                                "target_lang_word": "обстрел",
                                "target_lang_sense_clarification": "шквальный обстрел предметами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6e1c0d6-d6e0-35ca-844b-dd6add7cf8d5",
                    "sense_definition": "Insignificant, contemptibly small, or paltry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "paltry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt nobleman cared little for the complaints of a <w>pelting</w> petty official.",
                            "target_lang_translations": {
                                "ru": "Коррумпированного вельможу мало волновали жалобы <w>ничтожного</w> мелкого чиновника."
                            }
                        },
                        {
                            "text": "They wasted immense amounts of money fighting over a few <w>pelting</w> strips of wasteland.",
                            "target_lang_translations": {
                                "ru": "Они растратили огромные деньги, сражаясь за несколько <w>жалких</w> клочков пустоши."
                            }
                        }
                    ],
                    "synonyms": [
                        "paltry",
                        "petty",
                        "mean",
                        "trifling"
                    ],
                    "antonyms": [
                        "grand",
                        "noble"
                    ],
                    "common_phrases": [
                        "pelting officer",
                        "pelting wars"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in common modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительный, ничтожный, презренный (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ничтожный",
                                "target_lang_sense_clarification": "жалкий, мелкий"
                            },
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "незначительный, убогий"
                            },
                            {
                                "target_lang_word": "мелкий",
                                "target_lang_sense_clarification": "не заслуживающий внимания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}