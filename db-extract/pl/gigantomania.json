                                    {
                                        "sense_id": "42ca8195-803a-36f1-8377-1c53a0984b67",
                                        "entry_id": "4824ada4-fcc5-3e6d-9650-cf0b88c914e5",
                                        "glosses": [
                                            "de (ziekelijke) neiging tot het willen realiseren van immense buitenproportionele bouwprojecten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b6cda5-1d05-4267-a452-d436fa1a15c7",
                                                "sense_id": "42ca8195-803a-36f1-8377-1c53a0984b67",
                                                "text": "de nazileiders leden, naast andere psychopathische storingen, ook aan een ernstige vorm van gigantomanie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9819e36e-f600-4e23-a768-24363fb275f8",
                        "source_entry_id": "f9c2a1b8-9037-3dd3-91a1-0e2bbd04b1bd",
                        "source_sense_id": "1ea4015f-86b8-3361-84ba-be668dd31b06",
                        "target_lang_word": "Gigantomanie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gigantomanie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                        "entry_id": "19fdc944-2a5c-3df1-80f5-d21fedf464b6",
                                        "glosses": [
                                            "Neigung, bei neuen Dingen (beispielsweise einem Bauwerk, einer technischen Anlage) durch Größe oder Leistung zu beeindrucken"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "804ffde3-71e0-4e24-bfdf-a1e798ea350a",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "„Die Länge der Seitenflügel beträgt etwa 85 Meter. Der Speisesaal im Süden der Ordensburg besitzt eine Länge von 116 Metern. Im Geiste der nationalsozialistischen Gigantomanie wurde die Anlage mit gewaltigen Gebäuden und Ausdehnung geplant.“"
                                            },
                                            {
                                                "example_id": "ddaacd3d-394e-4ff6-99b7-8c89dd98895e",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "„Und schließlich führte Hitlers Gigantomanie zur Verschwendung erheblicher Mittel für die Entwicklung militärisch unsinniger, geradezu absurder Panzerprojekte“"
                                            },
                                            {
                                                "example_id": "fce7d507-f634-47b5-a595-a7e7656f53a7",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "„Der Hang zur Gigantomanie ist gefährlich, in undemokratischen Staaten besonders.“"
                                            },
                                            {
                                                "example_id": "504b54c0-1061-4a3a-8da7-24a19a0e0991",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "„Der russische Präsident Putin sonnt sich gerne in Superlativen. Sein Hang zur Gigantomanie kennt keine Grenzen, wenn es darum geht, Russland als Großmacht zu verkaufen.“"
                                            },
                                            {
                                                "example_id": "484420fc-5d15-4401-8eea-57a33917bf66",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "[Olympiabewerbung 2032 in Deutschland:] „Die Gigantomanie der Vergangenheit, wo für eine Milliarde Stadien gebaut wurden, die nachher niemand genutzt hat, ist heute nicht mehr akzeptabel.“"
                                            },
                                            {
                                                "example_id": "b454dca2-f590-4fd8-af91-b537f756cd59",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "„Die Stones setzten ihre Welttourneen fort, während derer sie in riesigen Stadien auftraten. Die Gigantomanie und der Perfektionismus dieser vollständig durchorganisierten Großtourneen erstickten nach Meinung von Kritikern allerdings jegliche Spontaneität.“"
                                            },
                                            {
                                                "example_id": "14d79fc8-42a7-447b-aa4a-7c3ccb3cbefb",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "[Windkraftanlagen:] „Die immer wieder aufflackernden Akzeptanzprobleme der Branche hängen womöglich auch mit der Gigantomanie zusammen.“"
                                            },
                                            {
                                                "example_id": "f91e28e1-0d92-47d5-9baa-ce683b4db3d9",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "„Die Gigantomanie bei E-SUVs mit 700 Kilogramm Batteriemasse ist inakzeptabel.“"
                                            },
                                            {
                                                "example_id": "0b2a545c-d810-4a8d-9fff-939a9afae7c9",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "[Kinofilm \"Die zehn Gebote\" (1956): …] „Produzent und Regisseur Cecil B. DeMille war für seine Gigantomanie berüchtigt.“"
                                            },
                                            {
                                                "example_id": "63baa388-5b8a-4a34-a659-8ed6a9df29de",
                                                "sense_id": "93ace418-aaae-3961-8a2c-6cdd08b052bc",
                                                "text": "[Apollo 11:] Die sorgsam ausgewählten Fotografien fangen die technische Gigantomanie ebenso ein wie den Zeitgeist von 1969."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
