                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les teinturiers utilisent l'<w>indigo</w> pour donner cette teinte caractéristique aux toiles de jean."
                        },
                        {
                            "text": "L'<w>indigo</w> synthétique a progressivement remplacé le pigment naturel dans la production industrielle."
                        }
                    ],
                    "common_phrases": [
