                        "entry_id": "c1b98f37-7606-3cc5-b723-c775d0719f68",
                        "glosses": [
                            "Having shapely and voluptuous curves; curvy."
                        ],
                        "tags": [
                            "of a woman"
                        ],
                        "examples": [
                            {
                                "example_id": "b5e6b425-8be0-4480-901d-0b943b2d1311",
                                "sense_id": "de4dad8c-84d2-33b0-8a19-70a6e4eae9ca",
                                "text": "He watched her walk, upon curvaceous legs, to the edge of the bed. For just a second, she smiled down at him."
                            },
                            {
                                "example_id": "9f33c82e-4c86-44af-a5ab-00d7f9d2da48",
                                "sense_id": "de4dad8c-84d2-33b0-8a19-70a6e4eae9ca",
                                "text": "Anya is tall, gorgeous and curvaceous, all of which I enjoy sexually, especially the curvaceous part: I enjoy squeezing and grabbing all the sexy, abundant parts of her body."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e65d1c4-9bfb-4ea6-b9d7-3a414acd4166",
                        "source_entry_id": "c1b98f37-7606-3cc5-b723-c775d0719f68",
                        "source_sense_id": "de4dad8c-84d2-33b0-8a19-70a6e4eae9ca",
