                "senses": [
                    {
                        "sense_id": "cc7dc669-fefa-3933-aa9c-5a3506cd453d",
                        "entry_id": "7c81b3ed-490b-3f5b-89ac-2d047c637670",
                        "glosses": [
                            "принадлежащий архиерею"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa59eac-328b-4f1b-86a7-efa9ed647d18",
                                "sense_id": "cc7dc669-fefa-3933-aa9c-5a3506cd453d",
                                "text": "Оставалось другое средство: подкупить слуг архиереевых и с их помощию подменить икону иным в соответствие сей хитро написанным подобием."
                            },
                            {
                                "example_id": "2d7fcadb-b209-45a3-9c31-c32e392c8c26",
                                "sense_id": "cc7dc669-fefa-3933-aa9c-5a3506cd453d",
                                "text": "Вместе с Иоанном они дошли до дома архиереева…"
                            }
                        ]
                    }
