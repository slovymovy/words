                "senses": [
                    {
                        "sense_id": "668970f7-02c7-3f52-9ac4-2489f1321673",
                        "entry_id": "2dc0a823-368d-3674-a2ae-d22f01faf564",
                        "glosses": [
                            "Person oder Korporation, die Sitz und Stimme im Reichstag besaß"
                        ],
                        "tags": [
                            "historical",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "36c19855-6bb9-4bbc-acc1-5fa71814733f",
                                "sense_id": "668970f7-02c7-3f52-9ac4-2489f1321673",
                                "text": "„Ebenso hatte sich die Beziehung zwischen den Reichsständen und der Habsburger Monarchie dramatisch verschlechtert.“"
                            },
                            {
                                "example_id": "21941a31-ed5b-4d4c-9aad-72fc47983329",
                                "sense_id": "668970f7-02c7-3f52-9ac4-2489f1321673",
                                "text": "„Als 1518 auf dem Augsburger Reichstag päpstliche Abgesandte auf finanzielle und militärische Hilfe gegen die Türken und die Eintreibung einer ›Türkensteuer‹ drangen, wiesen die Reichsstände die Forderungen mit Hinweis auf die Gravamina zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
