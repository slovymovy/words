                        "examples": [
                            {
                                "example_id": "aa3251ec-baba-462b-9672-cdbb04678790",
                                "sense_id": "fea2dcb9-b215-38f3-973b-a7f0942bb370",
                                "text": "De vrouw wist woensdagmiddag te ontkomen door een badjas aan het raam op de eerste verdieping vast te maken en vervolgens daarlangs naar beneden te klimmen. Ze was toen al enkele dagen vastgehouden. Haar gijzelnemers waren twee mannen die ze kent."
                            }
                        ]
                    },
                    {
                        "sense_id": "30a2115c-0157-3917-be87-1579f5e2bc3b",
                        "entry_id": "8de7eeec-3492-32c8-adcc-e2608c90e0b9",
                        "glosses": [
                            "ergens naast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796dfc16-b508-4b03-ae1f-27a62c0606a0",
                                "sense_id": "30a2115c-0157-3917-be87-1579f5e2bc3b",
                                "text": "In het Amsterdamse Bos ligt de Bosbaan, een 2300 meter lange en 118 meter brede roeibaan. Daarlangs is tevens het Olympisch trainingscentrum gevestigd, de thuisbasis voor de meeste Nederlandse toproeiers uit het Aegon Nationaal RoeiTeam."
                            }
                        ]
                    }
