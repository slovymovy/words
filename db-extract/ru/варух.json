                                        "sense_id": "9ebb1f51-8dee-39b8-88d8-97bbf6b6cf68",
                                        "entry_id": "21ef9b0b-e2c5-3966-96f2-c0c78787e9f6",
                                        "glosses": [
                                            "Any of a number of Old Testament men, including the scribe and companion of Jeremiah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a21cef-563c-4178-9e48-9c61ebab0fee",
                                                "sense_id": "9ebb1f51-8dee-39b8-88d8-97bbf6b6cf68",
                                                "text": "Then Jeremiah called Baruch the son of Neriah: and Baruch wrote from the mouth of Jeremiah all the words of the LORD, which he had spoken unto him, upon a roll of a book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a48db5e9-f8f3-31fd-b10b-8647522f9de8",
                                        "entry_id": "21ef9b0b-e2c5-3966-96f2-c0c78787e9f6",
                                        "glosses": [
                                            "A book of the Catholic and Eastern Orthodox canon of the Old Testament, considered apocryphal by Protestants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
