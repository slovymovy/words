                "senses": [
                    {
                        "sense_id": "66094ec4-ec51-3111-a340-629914905e11",
                        "entry_id": "d893974a-3515-328e-a1d8-1fab95aeeb12",
                        "glosses": [
                            "Verkehrsanlage mit Bussteigen zur zentralen Verknüpfung mehrerer Buslinien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a4d5e1-1bc4-4679-9431-4497950d9dba",
                                "sense_id": "66094ec4-ec51-3111-a340-629914905e11",
                                "text": "„Die drei Meilen zum Autobus-Bahnhof gingen sie zu Fuß; beim ersten Tageslicht brachen sie auf, da sie nicht so genau wußten, wann der Bus kommen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "661fe87d-86fe-4543-bf68-fb160e927b27",
                        "source_entry_id": "d893974a-3515-328e-a1d8-1fab95aeeb12",
                        "source_sense_id": "66094ec4-ec51-3111-a340-629914905e11",
                        "source_sense_description": "Verkehrsanlage mit Bussteigen zur zentralen Verknüpfung mehrerer Buslinien",
                        "target_lang_word": "bus station",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bus station",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4424dbdd-8c36-3e14-8d68-3f1f4f3e540b",
                                        "entry_id": "63ee8a7d-6948-3b77-b914-65de62df4181",
                                        "glosses": [
                                            "A major bus stop, one that serves as a transfer point between a large number of routes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca528de1-e3aa-48c9-bfc2-b23974d5de2d",
                                                "sense_id": "4424dbdd-8c36-3e14-8d68-3f1f4f3e540b",
                                                "text": "In the bus station the father handed me five dollars and pointed me to the lunch counter. \"Get yourself something to eat.\" He went into the men's room... ."
                                            },
                                            {
                                                "example_id": "8c5e9233-4c46-4859-b7eb-a3d76e6a19b6",
                                                "sense_id": "4424dbdd-8c36-3e14-8d68-3f1f4f3e540b",
                                                "text": "We're in my car heading toward the bus station to get to New York."
                                            },
                                            {
                                                "example_id": "8531dd94-d2a7-4fd5-9508-49dfb9ded0bf",
                                                "sense_id": "4424dbdd-8c36-3e14-8d68-3f1f4f3e540b",
                                                "text": "The square was near the bus station in the new part of Antibes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a4e6b7a-bfa1-499b-b2b2-78ae21b6c61b",
                        "source_entry_id": "d893974a-3515-328e-a1d8-1fab95aeeb12",
                        "source_sense_id": "66094ec4-ec51-3111-a340-629914905e11",
                        "source_sense_description": "Verkehrsanlage mit Bussteigen zur zentralen Verknüpfung mehrerer Buslinien",
                        "target_lang_word": "gare routière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gare routière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                        "entry_id": "93d21070-df22-3e98-b115-9f43a3897343",
                                        "glosses": [
                                            "Lieu consacré, dans une ville, au stationnement des autocars effectuant des liaisons avec des localités éloignées, à leur départ et à leur arrivée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07e5413e-a162-430d-bfea-b8ed954de420",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "Une gare routière est un aménagement équipé d’un bâtiment destiné à l’accueil des voyageurs."
                                            },
                                            {
                                                "example_id": "2a41566a-55f7-417b-b130-933bfec9e54d",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "« une gare routière est un aménagement situé hors voirie et équipé d’un bâtiment d’accueil ouvert au public »"
                                            },
                                            {
                                                "example_id": "9b3ae8e1-c6b1-4ae0-b767-4572ae58a3f8",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "Ainsi, en 2022, 71 % des voyageurs SLO ont été pris en charge ou déposés dans l’une des 76 gares routières (représentant 27 % des aménagements de transport routier de voyageurs), c’est-à-dire un aménagement équipé d’un bâtiment voyageurs"
                                            },
                                            {
                                                "example_id": "4c01345a-5185-46d4-bbe0-c383eb4ec991",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "Six jours plus tard, un suspect est interpellé par les douanes à Marseille, à la gare routière Saint-Charles, alors qu'il se trouvait dans un autocar en provenance d'Amsterdam via Bruxelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
