                    {
                        "translation_id": "a7bc1cc7-b2cc-40a7-9c2c-f3a476ed4f32",
                        "source_entry_id": "7a50b49c-53f8-3387-b673-892a3d8e76ca",
                        "source_sense_id": "b4da1f7c-cf6c-35e9-b512-8658bf2f26f0",
                        "source_sense_description": "Wissenschaftler, der sich mit der Ethnologie (Völkerkunde) beschäftigt",
                        "target_lang_word": "ethnologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01ad9c0e-36a0-3be4-9ddf-852df93c2f62",
                                        "entry_id": "cf175265-f80c-372c-8275-82b3c5952fb2",
                                        "glosses": [
                                            "One who practices ethnology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a28086-004b-40ea-a302-91356a61ad12",
                                                "sense_id": "01ad9c0e-36a0-3be4-9ddf-852df93c2f62",
                                                "text": "The learned modern Ethnologists, however, will generally have none of this latter idea. As a rule they delight in representing early peoples as totally destitute of common sense (which is supposed to be a monopoly of us moderns!); and if the Sabbath-arrangement has had any value or use they insist on ascribing this to pure accident, and not to the application of any sane argument or reason."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb693b67-565a-441e-9e1e-c4386da69f34",
                        "source_entry_id": "7a50b49c-53f8-3387-b673-892a3d8e76ca",
                        "source_sense_id": "b4da1f7c-cf6c-35e9-b512-8658bf2f26f0",
                        "source_sense_description": "Wissenschaftler, der sich mit der Ethnologie (Völkerkunde) beschäftigt",
                        "target_lang_word": "ethnologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "403410a1-65b3-3e2d-b6d6-b2c9b2387382",
                                        "entry_id": "aa969d23-b70f-3a28-8ff8-dfda59b93ff1",
                                        "glosses": [
                                            "Celui, celle qui s’occupe d’ethnologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2359e98-ee8d-4f35-8110-77b4fe98a22d",
                                                "sense_id": "403410a1-65b3-3e2d-b6d6-b2c9b2387382",
                                                "text": "J’ai rejoint une population qui avait longtemps refusé tout contact pacifique avec l’extérieur et n’avait croisé les premiers missionnaires que peu de temps avant mon arrivée (les ethnologues arrivent toujours après les missionnaires !)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
