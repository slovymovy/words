                    }
                ],
                "senses": [
                    {
                        "sense_id": "387b6c74-dca3-33b2-af68-1f011fad65bf",
                        "entry_id": "1dc3e06f-6438-36c8-b56d-0c372f1f934c",
                        "glosses": [
                            "A hidden message revealed in the completed grid of a crossword."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06ebad6-090c-40da-b479-f55ed0164d8c",
                                "sense_id": "387b6c74-dca3-33b2-af68-1f011fad65bf",
                                "text": "The puzzle itself was fairly easy however there was an elegant nina based on the middle entry (INSIDE STORY) in which each of the across answers hid a synonym of \"story\", e.g. 5A and 6A were: STABle gendER."
                            },
                            {
                                "example_id": "e8912df3-0f23-4b41-a4aa-a512d2680892",
                                "sense_id": "387b6c74-dca3-33b2-af68-1f011fad65bf",
                                "text": "Ninas may or may not be present and, even if one is there, it can go unnoticed because, not being intrinsic to the solution, its presence is not advertised—or because it is so well hidden."
                            },
                            {
                                "example_id": "01e41596-23c8-44a8-8b6f-35c9e3eabaaa",
                                "sense_id": "387b6c74-dca3-33b2-af68-1f011fad65bf",
                                "text": "Other “personal” ninas are happier and subtler: birthday wishes to loved ones, which, ultimately, have only one intended reader"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
