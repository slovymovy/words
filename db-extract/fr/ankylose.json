        "fr-extract.jsonl": [
            {
                "entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
                "word": "ankylose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e776c54-d412-4939-a8d5-ddd45a6d3708",
                        "entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
                        "tags": [
                            "plural"
                        ],
                        "form": "ankyloses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc1e211c-d814-3948-afdf-9644d4715826",
                        "entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
                        "glosses": [
                            "Arrêt complet ou incomplet du mouvement dans les articulations, dans les jointures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43187aa1-dba2-477d-8227-477d9440ee53",
                                "sense_id": "cc1e211c-d814-3948-afdf-9644d4715826",
                                "text": "Le cas de Hoinemann se rapporte à une fille de 12 ans opérée par Langenbeek pour une ankylose du coude à angle obtus et qui succomba 4 mois 1/2 seulement après l’opération."
                            },
                            {
                                "example_id": "c29e01cc-8745-46aa-a11c-ada43e67614b",
                                "sense_id": "cc1e211c-d814-3948-afdf-9644d4715826",
                                "text": "Il est si ému qu’il n’ose s’installer confortablement. Il gardera longtemps sa pose en biais, bien qu’il soit sensible à l’ankylose et au torticolis. Il a sa valise sur les genoux et il attend…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f1519b02-84b9-39a3-af78-39998b6170f3",
                        "entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
                        "glosses": [
                            "Raidissement, affaiblissement ou insensibilité des membres dus à une immobilité prolongée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8702419b-0693-4546-aa43-2907e628a5d6",
                                "sense_id": "f1519b02-84b9-39a3-af78-39998b6170f3",
                                "text": "L’ankylose fondait, dans son épaule, laissant place à des éclairs fulgurants de douleur."
                            },
                            {
                                "example_id": "dbc00459-19b2-4e10-b7cb-2a13f079cc7f",
                                "sense_id": "f1519b02-84b9-39a3-af78-39998b6170f3",
                                "text": "Le tête-à-tête avec Meurtzer n'avait que trop duré. Une sournoise migraine s'était emparée de moi, en même temps que l’ankylose. Je ne sentais plus mes jambes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59592804-08dc-4bc3-8123-623811b51e06",
                        "source_entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
                        "target_lang_word": "Ankylose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ankylose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                        "entry_id": "0b5b51b5-6963-3546-8103-17a2c9425c0c",
                                        "glosses": [
                                            "Versteifung eines natürlicherweise beweglichen Gelenks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67760c4e-e2ea-4fe0-9262-6518f7a16c94",
                                                "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                                "text": "„Neben der klinischen Untersuchung liefert die Computertomographie entscheidende Informationen über den Grad und die Ausdehnung der Ankylose insbesondere nach medial, wo sich aufgrund der engen tomographischen Beziehung zu den großen Halsgefäßen und Hirnnerven operationstechnisch besondere Gefährdungen ergeben können.“"
                                            },
                                            {
                                                "example_id": "75be2712-ee3f-404f-8591-9ec88ee8d265",
                                                "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                                "text": "„Eine weitere Stufe entzündungsbedingter Knochenproliferationen bei zerstörtem Gelenk unter Überbrückung desselben führt zur Ankylose.“"
                                            },
                                            {
                                                "example_id": "cbfd5b68-accd-49bd-92d3-f0cae099620f",
                                                "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                                "text": "„Bei Ankylose tritt durch eine Verschmelzung zwischen Wurzelelement und Knochen eine unphysiologisch starre Verbindung zwischen Zahn und Zahnhalteapparat ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cf3c2b8-fad4-4b3f-9eae-ac641ba4d320",
                        "source_entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
