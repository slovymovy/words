                ],
                "senses": [
                    {
                        "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                        "entry_id": "589fbb69-ff10-3103-bebe-734762454285",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f25755-c212-4272-b3e0-f2c25171ed71",
                                "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                                "text": "Frau Burgdorf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bc24e2ac-0edd-4da3-b36c-5b17ffe9e816",
                                "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                                "text": "Herr Burgdorf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "46573186-4729-4356-867f-615629943c4b",
                                "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                                "text": "Die Burgdorfs fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "cf423d7e-63bf-48fe-8e0f-73a0bf00dab4",
                                "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                                "text": "Der Burgdorf trägt nie die Pullover, die die Burgdorf ihm strickt."
                            },
                            {
                                "example_id": "7ea1df7c-c264-4420-9855-ffdc6280c7c9",
                                "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Burgdorf kommt, geht der Herr Burgdorf.“"
                            },
                            {
                                "example_id": "2d382114-1532-4386-86cd-e29baceb10a5",
                                "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                                "text": "Burgdorf kommt und geht."
                            },
                            {
                                "example_id": "e71feeb3-880b-4614-92a1-70d6f75aeb31",
                                "sense_id": "87836e74-284a-34e1-9e39-3e003268183c",
                                "text": "Burgdorfs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
