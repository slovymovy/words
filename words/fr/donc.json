{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "6326227f-82cc-30bf-b87f-81333fa0b6a1",
                    "sense_definition": "Introduit la conséquence logique ou l'aboutissement d'un raisonnement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train est en retard, nous devons <w>donc</w> attendre sur le quai."
                        },
                        {
                            "text": "Il n'a pas assez dormi cette nuit, il est <w>donc</w> très fatigué ce matin."
                        }
                    ],
                    "synonyms": [
                        "par conséquent",
                        "ainsi"
                    ],
                    "common_phrases": [
                        "c'est donc pour cela"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "55c068f4-5266-3816-a32d-42b25e9e92c3",
                    "sense_definition": "Renforce une injonction, une demande ou une invitation, généralement avec un verbe à l'impératif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "injonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prenez <w>donc</w> une tasse de café chaud avant de reprendre la route."
                        },
                        {
                            "text": "Entre <w>donc</w> au salon et assieds-toi confortablement près de la fenêtre."
                        }
                    ],
                    "common_phrases": [
                        "viens donc voir",
                        "regardez donc cela"
                    ]
                },
                {
                    "sense_id": "0dd8fd0f-cbe4-3bcf-ab6a-13319e88f4dc",
                    "sense_definition": "Exprime la surprise, l'étonnement ou l'impatience dans une phrase interrogative ou exclamative.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interrogation_exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mais où ai-je <w>donc</w> posé mes clés de voiture ce matin ?"
                        },
                        {
                            "text": "Qu'avez-vous <w>donc</w> entendu pendant cette réunion pour réagir de cette façon ?"
                        }
                    ],
                    "common_phrases": [
                        "dis donc"
                    ]
                },
                {
                    "sense_id": "9f935cdb-11eb-36f9-8c43-7b5ff30db261",
                    "sense_definition": "Marque la reprise du propos principal après une interruption ou une digression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reprise_discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je disais <w>donc</w> que notre budget prévisionnel pour l'année prochaine sera légèrement revu à la hausse."
                        },
                        {
                            "text": "Revenons <w>donc</w> à notre point de départ avant d'aborder la question suivante."
                        }
                    ],
                    "common_phrases": [
                        "comme je disais donc",
                        "revenons donc au sujet"
                    ]
                },
                {
                    "sense_id": "8df0bb77-37b2-347e-a149-75937db5b46b",
                    "sense_definition": "Sert à appuyer ou à confirmer une affirmation avec vivacité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "renforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avez-vous apprécié cette représentation au théâtre hier soir ? — Et comment <w>donc</w> !"
                        },
                        {
                            "text": "C'est <w>donc</w> bien vrai que cette équipe a remporté la finale hier soir."
                        }
                    ],
                    "common_phrases": [
                        "et comment donc"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à l'oral"
                        }
                    ]
                }
            ]
        }
    ]
}