                    "target_lang_definitions": {
                        "ru": "Подготовить предварительную версию документа, письма или плана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "проект документа"
                            },
                            {
                                "target_lang_word": "набрасывать",
                                "target_lang_sense_clarification": "черновик"
                            },
                            {
                                "target_lang_word": "проектировать",
                                "target_lang_sense_clarification": "план"
                            }
