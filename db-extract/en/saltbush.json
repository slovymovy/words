                                            {
                                                "example_id": "987f715d-6a80-4d56-aa12-cd9728158827",
                                                "sense_id": "420734ce-3fd7-3f10-95b6-85e2a26fc02d",
                                                "text": "ARROCHE, genre de plante de la famille des chénopodées, dont la principale espèce, l'arroche des jardins, est aussi connue sous les noms de belle-dame, bonne-dame, et follette."
                                            },
                                            {
                                                "example_id": "fd38d559-e1eb-4898-9370-859c9f45d522",
                                                "sense_id": "420734ce-3fd7-3f10-95b6-85e2a26fc02d",
                                                "text": "— La « verdure » : choux, poirée, bonne-dame, buglosse, oseille, patience, bourrache, épinards, choux blancs, pancaliers et cabus."
                                            }
                                        ]
                                    }
                                ]
                            }
