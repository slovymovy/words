                ],
                "senses": [
                    {
                        "sense_id": "ad0f0a0a-2eff-3e2e-9526-334a756bc03e",
                        "entry_id": "d896a94a-62df-3663-9044-e0a88fe6671f",
                        "glosses": [
                            "übertriebene, unangemessene Reaktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5679c5e8-876d-4e37-9644-4076ae3553b8",
                                "sense_id": "ad0f0a0a-2eff-3e2e-9526-334a756bc03e",
                                "text": "„Als sie am Morgen erwachte, war sie überzeugt, dass mehr hinter diesen Träumen steckte als eine unbewusste Überreaktion auf einen unheimlichen Nachbarn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c62fedb4-5983-4ad6-94bd-459147be1a87",
                        "source_entry_id": "d896a94a-62df-3663-9044-e0a88fe6671f",
                        "source_sense_id": "ad0f0a0a-2eff-3e2e-9526-334a756bc03e",
                        "source_sense_description": "übertriebene Reaktion",
                        "target_lang_word": "overreaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overreaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                        "entry_id": "66d5ca6e-efe7-3f0f-9fa8-78461cecd03c",
                                        "glosses": [
                                            "A reaction that is excessive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e283e41d-297c-4365-9b90-8f62e6569e44",
                                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                                "text": "She had every right to dump you, but cutting up all your clothes after she did so was an overreaction."
                                            },
                                            {
                                                "example_id": "0b3e6d58-c747-4139-b346-92371a0eb4c8",
                                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                                "text": "This whole fear over swine flu was unfounded; it was clearly an overreaction."
                                            },
                                            {
                                                "example_id": "1a3a600f-0203-4f85-b394-c6ff115e4de5",
                                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                                "text": "The threat of terrorism to the British lies in the overreaction to it of British governments. Each one in turn clicks up the ratchet of surveillance, intrusion and security. Each one diminishes liberty."
                                            },
                                            {
                                                "example_id": "7848ca77-5681-4722-907d-30034aac0694",
                                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                                "text": "In most cases, this overreaction to terrorism poses a far greater threat to our security than the terrorists themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43687997-28cd-47b6-b410-24dac008944f",
                        "source_entry_id": "d896a94a-62df-3663-9044-e0a88fe6671f",
                        "source_sense_id": "ad0f0a0a-2eff-3e2e-9526-334a756bc03e",
                        "source_sense_description": "übertriebene Reaktion",
                        "target_lang_word": "sobrerreacción",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sobrerreacción",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "09b712c9-9534-32c1-ad76-d5c773a76efb",
                                        "entry_id": "cbc3b04c-cb0f-3cfb-97da-9c73cfc173fe",
                                        "glosses": [
                                            "Reacción desmesurada frente a un suceso acontecido."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810f8286-cb78-4a2f-be2b-32bb200db72a",
                                                "sense_id": "09b712c9-9534-32c1-ad76-d5c773a76efb",
                                                "text": "Martínez ―por supuesto queda para una conversación más (em yo diría más) larga, probablemente acá en piso, para un buen diálogo, para un intercambio si quiere―, a mí me llama mucho la atención la sobrerreacción del kirchnerismo buscando cumplimentar la normativa cuando hubo tanto desapego a la norma en el gobierno de Alberto Fernández, Cristina Fernández de Kirchner, y eventualmente Sergio Massa sobre el final. Digo esto porque la sobrerreacción que se ha vivenciado sobre lo ocurrido ―muy grave por cierto, que he venido marcando hasta el hartazgo desde que empezamos la tarde― parecería darle algo de aire al gobierno en virtud de que aparecen siendo absolutamente leguleyos, constitucionalistas, muy observadores de la ley, aquellos que la infligieron arteramente incluso en los momentos más delicados como la pandemia, con la fiesta de Olivos y otras cosas..."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
