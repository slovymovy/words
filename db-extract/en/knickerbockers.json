                                        "sense_id": "f635b726-2c14-3587-8440-f23d47e05ecd",
                                        "entry_id": "ae851d65-5add-3615-b0b1-9240c34a5377",
                                        "glosses": [
                                            "Sorte de bermuda descendant en-dessous du genou et s’attachant par une boutonnière"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861d8b49-cc83-4806-879c-65a22e011db6",
                                                "sense_id": "f635b726-2c14-3587-8440-f23d47e05ecd",
                                                "text": "Leurs mains, enfouies au fond des poches des knickers, ou nouées derrière le dos, à la façon paysanne, portaient le cal du piolet, du rocher, de la corde, les stigmates de leur métier : la charge d'âmes à assurer vers les sommets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d097e1f-638b-470c-a982-074398d5ea2c",
                        "source_entry_id": "542ac43f-154d-39c9-8b39-2c2db295031f",
                        "source_sense_id": "c71448eb-bd9f-33c1-b0b4-a9fc2959d9de",
                        "source_sense_description": "knickerbockers",
                        "target_lang_word": "Knickerbocker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knickerbocker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                        "entry_id": "898b19c5-6d09-321c-b7ce-34492ebf074b",
                                        "glosses": [
                                            "halblange, weit geschnittene Hose, die unter den Knien mit eng anliegendem Bund endet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512d9dc1-dcc2-47d9-bd12-c27d2df217eb",
                                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                                "text": "„Er hatte ein lederfarbenes Gesicht, trug die Hände meist in den Taschen seiner melierten Knickerbockers, und wenn man ihm etwas mitteilte, machte er den Mund langsam ganz weit auf und sagte das »Ach«.“"
                                            },
                                            {
                                                "example_id": "60937cf9-d809-40d2-a7f5-9c4f64efcf56",
                                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                                "text": "„Himpel erwartete mich in Hemd und Knickerbockern, an seiner Windjacke putzten die beiden Sekretärinnen herum, rieben da, wischten, reinigten mit Terpentin.“"
                                            },
                                            {
                                                "example_id": "0cf62c2e-6587-4955-a69b-bdd9a691efa6",
                                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                                "text": "„Das war ein pikfeiner Junge in Knickerbockern aus Bremen, Kaffeeimport.“"
                                            },
                                            {
                                                "example_id": "0314545c-c240-48c7-a1ef-a8e229fbbac1",
                                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                                "text": "„Er trug rotgrün gepunktete Kniestrümpfe, hellgraue Knickerbocker, außerdem eine Weste, Jacke und Schlips.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
