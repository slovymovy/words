                "senses": [
                    {
                        "sense_id": "b88be43b-4f30-3708-87f8-b86ce83a99b1",
                        "entry_id": "68c857da-dacf-3e50-9282-22c3a7c9c145",
                        "glosses": [
                            "Art und Weise, wie bei der Herstellung von etwas vorzugehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e780f61e-3b6d-490e-93b1-4305c4ba1d7d",
                                "sense_id": "b88be43b-4f30-3708-87f8-b86ce83a99b1",
                                "text": "„Besonders bei der Produktion im großen Maßstab seien aktuelle Herstellungsverfahren oft aufwendig und nicht präzise genug, heißt es in der Projektbeschreibung.“"
                            },
                            {
                                "example_id": "e04aff4c-0563-4b92-8451-4634be5d41e8",
                                "sense_id": "b88be43b-4f30-3708-87f8-b86ce83a99b1",
                                "text": "„Schließlich habe man das Herstellungsverfahren des Streichkäses patentrechtlich geschützt, die Marke als Wortmarke eintragen lassen und somit das alleinige Recht auf diesen Geschmack.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
