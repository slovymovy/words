                        "glosses": [
                            "deel van de metaalsector waarin men grote metalen (bouw)werken maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e2ef0e-9cf4-44ef-94aa-ef1aeedf195e",
                                "sense_id": "1f79e275-7587-3076-a6a9-5a083f386335",
                                "text": "De werknemers van verschillende bedrijven in de groot- en kleinmetaal eisen hogere lonen, een vierdaagse werkweek en waardering van vakmanschap. Eerder liepen de cao-onderhandelingen voor klein- en grootmetaal vast. Die cao's gelden voor ongeveer een half miljoen werknemers."
                            },
                            {
                                "example_id": "a6ae8826-6cbc-4ba2-8990-e905b9537919",
                                "sense_id": "1f79e275-7587-3076-a6a9-5a083f386335",
                                "text": "Werkgevers en werknemers in de kleinmetaal hebben een akkoord bereikt over een nieuwe cao. Na weken van estafettestakingen zijn nieuwe acties daardoor van de baan. Werknemers in de grootmetaal staken wel door."
                            }
                        ]
                    }
