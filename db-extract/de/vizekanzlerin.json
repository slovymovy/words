                "senses": [
                    {
                        "sense_id": "356864ca-7e8d-3a29-a4d3-c010336ac22c",
                        "entry_id": "c589a105-f6ff-3ed9-89be-de0b795a9ff9",
                        "glosses": [
                            "Stellvertreterin eines Kanzlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f8ee97b-19db-49ad-8a93-479ddf0753ae",
                                "sense_id": "356864ca-7e8d-3a29-a4d3-c010336ac22c",
                                "text": "„Auffallend ist in beiden Umfragen, wie sehr die FPÖ-Wähler treu zur Regierung stehen – ein klarer Unterschied zu jener FPÖ-Wählerschaft, mit der die schwarz-blaue Koalition von Wolfgang Schüssel und seiner blauen Vizekanzlerin Susanne Riess-Passer in deren Regierungszeit zu Beginn des vorigen Jahrzehnts konfrontiert war.“"
                            },
                            {
                                "example_id": "9ec967cf-6bf4-4705-bb24-ca3f77c6119a",
                                "sense_id": "356864ca-7e8d-3a29-a4d3-c010336ac22c",
                                "text": "„Auf dem Foto ist die österreichische Vizekanzlerin und Vorsitzende der rechtspopulistischen Freiheitlichen Partei Österreichs (FPÖ), Susanne Riess-Passer, 40, im Gespräch mit dem königlichen Paar zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
