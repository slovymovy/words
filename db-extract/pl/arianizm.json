                "senses": [
                    {
                        "sense_id": "c6b2c4dd-9096-388a-856b-a1d6a879f437",
                        "entry_id": "103fe702-90ee-390f-b1dc-e778d35831f5",
                        "glosses": [
                            "wczesnochrześcijańska, antytrynitarna doktryna teologiczna negująca boskość Jezusa i głosząca jego stworzenie lub zrodzenie przez Boga Ojca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf549287-7455-4050-bb35-7b1c5fa29d30",
                                "sense_id": "c6b2c4dd-9096-388a-856b-a1d6a879f437",
                                "text": "W Kościele wschodnim w IV w. wielkim problemem stał się arianizm."
                            },
                            {
                                "example_id": "dcf227b3-24c8-42c6-9891-3b03e3861e8b",
                                "sense_id": "c6b2c4dd-9096-388a-856b-a1d6a879f437",
                                "text": "Toteż dopiero po krótkim epizodzie Juliana Apostaty i panowaniu kilku cesarzy, na przemian nicejczyków i arian, Teodozjusz Wielki zadał arianizmowi decydujący cios."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c2a0ec3d-f6fe-38d7-9c0d-6a6a657b3daa",
                        "entry_id": "103fe702-90ee-390f-b1dc-e778d35831f5",
