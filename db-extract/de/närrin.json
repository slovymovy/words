                "senses": [
                    {
                        "sense_id": "9b730429-e7fe-38d1-84ef-8ce138fd6ecd",
                        "entry_id": "40adcdec-d8c1-3a72-bd33-5974e62ec6cd",
                        "glosses": [
                            "weibliche Person, die sich unklug verhält"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "18e0c82e-a095-44d0-b75c-c3c802608f80",
                                "sense_id": "9b730429-e7fe-38d1-84ef-8ce138fd6ecd",
                                "text": "Das hast du wirklich getan? Du bist doch eine Närrin!"
                            },
                            {
                                "example_id": "1d72e998-687b-446a-a066-512145a5e176",
                                "sense_id": "9b730429-e7fe-38d1-84ef-8ce138fd6ecd",
                                "text": "„Mit diesem Brief glaubte ich, der Närrin mit der größten Sanftmut zu begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1cc7805-5543-39cc-915a-77f602856ca2",
                        "entry_id": "40adcdec-d8c1-3a72-bd33-5974e62ec6cd",
                        "glosses": [
                            "weibliche Person, die von jemandem oder von etwas besessen ist"
                        ],
                        "tags": [
                            "häufig in Verbindungen"
                        ],
                        "examples": [
                            {
                                "example_id": "8dc38db1-97b3-4742-a0b7-33962f8a0119",
                                "sense_id": "e1cc7805-5543-39cc-915a-77f602856ca2",
                                "text": "Wenn es um Pferde geht, wird Tanja zur Närrin."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "75911ed8-b84f-37b5-bc80-7dc8be9d41f0",
                        "entry_id": "40adcdec-d8c1-3a72-bd33-5974e62ec6cd",
                        "glosses": [
                            "zu Karneval/im Fasching feiernde, weibliche Person in Verkleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5cc863b-000c-4906-8860-4e732a3d29ce",
                                "sense_id": "75911ed8-b84f-37b5-bc80-7dc8be9d41f0",
                                "text": "Narren und Närrinnen machen die Straßen unsicher."
                            }
                        ],
