                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauswurz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                        "entry_id": "61675062-a5b5-3aa6-ab96-9b8761addf4a",
                                        "glosses": [
                                            "Pflanzengattung innerhalb der Familie der Dickblattgewächse; Sempervivum"
                                        ],
                                        "tags": [
                                            "wissenschaftlicher Name"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a2976b3-e9e2-4ffe-af0c-19a01975ffa4",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Hauswurz pflanzen ist für jeden Gartenfreund ein Muss.“"
                                            },
                                            {
                                                "example_id": "67f3e6ca-6270-4f22-b89f-f914cc1b5ab0",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Die Hauswurz verträgt besonders gut heiße und trockene oder besonders kalte Standorte.“"
                                            },
                                            {
                                                "example_id": "9010917c-ee3d-4630-af68-5e15651a45c3",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Ist der Hauswurz vertrocknet ist, müssen Sie ihn nicht gleich wegwerfen.“"
                                            },
                                            {
                                                "example_id": "5e1536a2-744e-4c73-8418-b0c819fce88a",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„‚Auch steinige Bereiche, zum Beispiel neben einer Einfahrt, können mit Steinbrech und Hauswurz bepflanzt werden.‘“"
                                            },
                                            {
                                                "example_id": "3922e32c-2ff8-4c80-a166-a67d261c7a3d",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Quasi unzerstörbar ist die Hauswurz (Sempervivum), nicht ohne Grund auch Steinrose genannt.“"
                                            },
                                            {
                                                "example_id": "bc94b9bb-7db9-42cf-b959-4de13ea7c06e",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Unbedingt anpflanzen sollte man außerdem die Hauswurz Sempervivum tectorum, denn sie schützt bei Gewitter zuverlässig vor dem Blitz.“"
                                            },
                                            {
                                                "example_id": "cf52c541-d37e-43a2-995d-d331d0334897",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Jakob Eschmann senior ist einer der besten Enziankenner der Welt; seine Sammlung von 200 Enzian-Arten, 400 Hauswurzen und über 50 verschiedenen Seidelbasten ist im Mutterland der Gartenkultur, in England, berühmter als in der Schweiz, denn «Alpines» haben dort einen besonderen Stellenwert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
