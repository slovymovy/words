                                "example_id": "f853d211-d4c6-414c-a4cc-e51c98eb7de7",
                                "sense_id": "fd537335-8d34-38bf-9974-7ae72c059f0a",
                                "text": "Jej siostra mieszka na Żmudzi.",
                                "translation": "Ihre Schwester wohnt in Samogitien."
                            },
                            {
                                "example_id": "a5f5c8d5-642a-4fdf-b7f8-ebdb8a6149eb",
                                "sense_id": "fd537335-8d34-38bf-9974-7ae72c059f0a",
                                "text": "Jedziemy na Żmudź.",
                                "translation": "Wir fahren nach Samogitien."
                            },
                            {
                                "example_id": "a1681bb9-53a0-4ff4-a7df-ecf95ca480d8",
                                "sense_id": "fd537335-8d34-38bf-9974-7ae72c059f0a",
                                "text": "„zima tęga przykryła Żmudź świętą grubym na łokieć, białym kożuchem;“",
                                "translation": "der strenge Winter bedeckte das heilige Samogitien mit einem eine Elle dicken, weißen Mantel;"
                            }
