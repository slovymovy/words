        "ru-extract.jsonl": [
            {
                "entry_id": "4bacf3bd-fafd-3ee1-8847-12926ba4adb7",
                "word": "вкратце",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                        "entry_id": "4bacf3bd-fafd-3ee1-8847-12926ba4adb7",
                        "glosses": [
                            "кратко, сжато"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "becb5b8f-8d8c-459b-a1fe-fe09f983d2a3",
                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                "text": "Итак, вот вкратце мое мнение по сему предмету."
                            },
                            {
                                "example_id": "4df4150d-1335-41b7-9152-c4519354213c",
                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                "text": "В дневнике отца Фоки отмечены две визитации этого владыки (тоже уже скончавшегося) ― одна вкратце и вскользь, а другая поспокойнее и попросторнее."
                            },
                            {
                                "example_id": "51c0a688-ca48-44fb-9546-d41b024244be",
                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                "text": "И он с свойственною ему ясностью рассказал вкратце эти новые, очень важные и интересные открытия."
                            },
                            {
                                "example_id": "9c97395a-0897-4ec3-b937-48ba74c1d9a8",
                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                "text": "Скажи мне вкратце, кто они, а им ― кто я, и будем наслаждаться жизнью!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d66660bf-c26f-4656-960f-b67dbbccea14",
                        "source_entry_id": "4bacf3bd-fafd-3ee1-8847-12926ba4adb7",
                        "source_sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                        "target_lang_word": "briefly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "briefly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c975e3c-eec0-37f3-8b98-35229c1f6f31",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "In a brief manner, summarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3987ca-0857-464f-bccd-f7b1770fc945",
                                                "sense_id": "3c975e3c-eec0-37f3-8b98-35229c1f6f31",
                                                "text": "He covered the subject briefly in his book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "For a brief period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a17e64b-159c-4242-9341-55bc729af470",
                                                "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                                "text": "He only worked here briefly."
                                            },
                                            {
                                                "example_id": "c2226221-32cb-4f2f-8ae3-168c425de687",
                                                "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                                "text": "Instead, ddakji was played for dramatic effect earlier in the season — pitting two men who had forged a sweet bond against each other, making one of them briefly believe he’d been eliminated by his friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "To be brief, in short."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d54d18-28e3-4bdc-a227-34d9111bdf7a",
                                                "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                                                "text": "Briefly, I am not happy about what happened, but no one will be losing their job."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "496fdaf1-24c7-4179-aa3c-642ff8dcc3ed",
                        "source_entry_id": "4bacf3bd-fafd-3ee1-8847-12926ba4adb7",
                        "source_sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                        "target_lang_word": "in brief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
