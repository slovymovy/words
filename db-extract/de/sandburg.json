                        "form": "die Sandburg"
                    },
                    {
                        "form_id": "25a8f73c-c1fd-434e-9e0b-6497ded64ffb",
                        "entry_id": "aaf74b37-7e41-3e29-a37e-899a7522fb32",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sandburgen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                        "entry_id": "aaf74b37-7e41-3e29-a37e-899a7522fb32",
                        "glosses": [
                            "von Menschen erbaute (kleine) Burg aus Sand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d83bdc-db7a-4732-9d58-cc94e0f6100e",
                                "sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                                "text": "„Wie aus dieser neuen Flexibilität die filigranen Strukturen der Welt erwachsen, veranschaulichte er mit einer Sanduhr: In ihr rieselt der Sand nicht einfach zu dem gewohnten Haufen im Stundenglas, sondern formt dort eine kühn geschwungene Sandburg.“"
                            },
                            {
                                "example_id": "8a0824b6-8349-4561-8fcd-10c199188849",
                                "sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                                "text": "„Auch die eine oder andere Sandburg nimmt es mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d628a727-52e0-47de-91e5-ce8b41edad0f",
                        "source_entry_id": "aaf74b37-7e41-3e29-a37e-899a7522fb32",
                        "source_sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                        "source_sense_description": "von Menschen erbaute (kleine) Burg aus Sand",
                        "target_lang_word": "sandcastle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandcastle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8259d50-8d64-3f2d-9be3-cc15277f4ccd",
                                        "entry_id": "51d90604-e5d9-319f-9af6-99297f58b9c3",
                                        "glosses": [
                                            "A sculpture made of sand and resembling a miniature castle; typically, but not always, made for fun by a child on a beach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd55d9d-28dd-4a0d-b572-bb6f4133a2cb",
                                                "sense_id": "c8259d50-8d64-3f2d-9be3-cc15277f4ccd",
                                                "text": "Children learn the importance of water in soil mechanics from an early age. They learn on the beach while making sandcastles. When they use dry sand, their castle flows into a heap even as they lift the bucket. The particles of sand have no cohesion and little friction between them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41375eed-c400-4943-90c4-3a5ecd99f868",
                        "source_entry_id": "aaf74b37-7e41-3e29-a37e-899a7522fb32",
                        "source_sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                        "source_sense_description": "von Menschen erbaute (kleine) Burg aus Sand",
                        "target_lang_word": "château de sable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "château de sable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9600a0e-c8b9-3557-9972-909608a11055",
                                        "entry_id": "686a87a9-4d98-374a-8096-ddb946663afa",
                                        "glosses": [
                                            "Sorte de construction éphémère en sable, en forme approximative de château médiéval, bâti pour jouer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd14b73-4d23-4811-a051-aa4aafdc1895",
                                                "sense_id": "c9600a0e-c8b9-3557-9972-909608a11055",
                                                "text": "Tout est prévu pour la distraction des enfants et la tranquillité des parents : promenades à dos d’âne ou de poney, terrain de jeux constamment surveillé, et chaque semaine un concours de châteaux de sable doté de nombreux prix."
                                            },
                                            {
                                                "example_id": "ef06c0b4-0314-41be-9e73-18d377e102bc",
                                                "sense_id": "c9600a0e-c8b9-3557-9972-909608a11055",
                                                "text": "Mai 1977. Assis sur la plage de l’hôtel Mauna Kea à Hawaï, deux hommes construisent un château de sable. L'un est un grand échalas de trente ans, avec une barbe et des cheveux négligés, […]."
                                            },
                                            {
                                                "example_id": "fe1b5123-15df-429a-b0e1-308ec1ad2212",
                                                "sense_id": "c9600a0e-c8b9-3557-9972-909608a11055",
                                                "text": "Tout au long de ces vingt dernières années, j'ai observé qu'il leur fallait se rassurer comme un enfant qui ne cesse de reconstruire son château de sable de plus en plus haut sur la plage que la marée recouvre inexorablement."
                                            },
                                            {
                                                "example_id": "23419e8e-cf3a-4889-835a-1165a1544b55",
                                                "sense_id": "c9600a0e-c8b9-3557-9972-909608a11055",
                                                "text": "Plus loin, les tout-petits jouent aux billes, vont à la pêche aux canards, font des concours de châteaux de sable."
                                            },
                                            {
                                                "example_id": "f73e9de0-cbf2-4e39-a302-ebc02ba7da3b",
                                                "sense_id": "c9600a0e-c8b9-3557-9972-909608a11055",
                                                "text": "Ce fut le col et nous descendîmes vers le refuge, dans la poudre bleue de froid. C’était alors une jouissance d’enfant qui écrase son château de sable : détruire en quelques lacets le bénéfice de la montée patiente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95fce280-813e-458c-a8eb-be7b80fa94ae",
                        "source_entry_id": "aaf74b37-7e41-3e29-a37e-899a7522fb32",
                        "source_sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
