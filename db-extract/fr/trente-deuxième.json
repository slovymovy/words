                                    {
                                        "sense_id": "afc123d8-9d8c-3ad2-a57f-0f90b33fc9c8",
                                        "entry_id": "a4223e26-ecb9-3758-a845-8b776f354e49",
                                        "glosses": [
                                            "nach dem oder der einunddreißigsten kommend; in einer Reihenfolge an Stelle zweiunddreißig"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c7f1758-83da-468c-b9f7-0cca7a4235e3",
                                                "sense_id": "afc123d8-9d8c-3ad2-a57f-0f90b33fc9c8",
                                                "text": "Der kyrillische Buchstabe ‚Я‘ ist der zweiunddreißigste Buchstabe des weißrussischen Alphabets."
                                            },
                                            {
                                                "example_id": "c3c4044f-8898-4f60-9ae4-71398a48e226",
                                                "sense_id": "afc123d8-9d8c-3ad2-a57f-0f90b33fc9c8",
                                                "text": "Die Basketball-Südamerikameisterschaft 1987, die zweiunddreißigste Basketball-Südamerikameisterschaft, fand zwischen dem 13. und 20. Mai 1987 in Asunción, Paraguay statt, das zum dritten Mal die Meisterschaft ausrichtete."
                                            },
                                            {
                                                "example_id": "ed54380c-7efb-46bc-b064-12d472161df9",
                                                "sense_id": "afc123d8-9d8c-3ad2-a57f-0f90b33fc9c8",
                                                "text": "Das etwas sattelförmige Clitellum umfasst beim geschlechtsreifen Wurm sechs bis acht Segmente, meist vom vierundzwanzigsten oder fünfundzwanzigsten bis zum zweiunddreißigsten bis vierunddreißigsten Segment."
                                            },
                                            {
                                                "example_id": "6cd89146-c04e-4a88-9b84-b03b4cd8f41f",
                                                "sense_id": "afc123d8-9d8c-3ad2-a57f-0f90b33fc9c8",
                                                "text": "Ping Pong ist das zweiunddreißigste Kindeskind von Herrn Schu Fu Lu Pi Plu und beim ersten Treffen mit Jim und Lukas 368 Tage alt."
                                            },
                                            {
                                                "example_id": "d855abd2-4978-46f7-9405-06f08988a241",
                                                "sense_id": "afc123d8-9d8c-3ad2-a57f-0f90b33fc9c8",
                                                "text": "Zweiunddreißigste Noten sind mit einem ovalen, ausgefüllten Notenkopf und einem geraden Notenstiel mit drei Flaggen oder Balken notiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
