                                    {
                                        "sense_id": "816ee63c-de43-38ac-bcca-0f52a6d68183",
                                        "entry_id": "db6de4fd-edab-3d4f-bbb1-7870a556ec91",
                                        "glosses": [
                                            "Blood, especially that from a wound when thickened due to exposure to the air."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab1033ea-e3ff-3cb0-bf2a-3b178c632cd7",
                                        "entry_id": "db6de4fd-edab-3d4f-bbb1-7870a556ec91",
                                        "glosses": [
                                            "A gout or mass of such blood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3fd0c84-fa0c-448b-b988-c3e906787f07",
                                                "sense_id": "ab1033ea-e3ff-3cb0-bf2a-3b178c632cd7",
                                                "text": "And I beheld the roof and the walls one gore of blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51e9383d-cdd3-3703-ac0f-68cb7a5d0b06",
                                        "entry_id": "db6de4fd-edab-3d4f-bbb1-7870a556ec91",
                                        "glosses": [
                                            "Carnage, bloodshed, murder, violence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa93cad-c7c5-4e11-b9b6-8a86d28f034e",
                                                "sense_id": "51e9383d-cdd3-3703-ac0f-68cb7a5d0b06",
                                                "text": "The zombie scenes are reminiscent of what you might see on a show like The Walking Dead, short bursts of extreme violence and gore punctuating expository dialogue scenes where the survivors try to figure out how they’re going to get from point A to point B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abae08e-6bae-3061-bc53-bda8eb3a9968",
                                        "entry_id": "db6de4fd-edab-3d4f-bbb1-7870a556ec91",
                                        "glosses": [
                                            "Dirt, filth, often dung or mud."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f4007c-fa98-45fa-934b-ad68bc15463a",
                                                "sense_id": "0abae08e-6bae-3061-bc53-bda8eb3a9968",
                                                "text": "As a sowe waloweth in the stynkynge gore pytte, or in the puddell."
                                            }
                                        ]
                                    }
                                ]
                            },
