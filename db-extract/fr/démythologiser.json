                ],
                "senses": [
                    {
                        "sense_id": "84355938-15e5-3d74-a1c7-ef497a825d18",
                        "entry_id": "fc679be5-e860-3204-ad4e-642db23fd593",
                        "glosses": [
                            "Faire perdre son caractère mythologique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f974e09-9cee-4cf9-8b20-ffda59df0e40",
                                "sense_id": "84355938-15e5-3d74-a1c7-ef497a825d18",
                                "text": "Et voilà pourquoi il peut alors assigner à la collection la tâche de nous démythologiser ou de nous défantasmagoriser : la collection aurait ainsi, au rebours du patrimonial, un principe critique très fort à l’égard du mythe et de la fantasmagorie, et en ce sens-là Benjamin serait très proche parent (sur des données à la fois voisines et différentes) de Brecht et d’Adorno."
                            },
                            {
                                "example_id": "c4f35c6e-1483-4ed4-8c88-72dd60e4ceb7",
                                "sense_id": "84355938-15e5-3d74-a1c7-ef497a825d18",
                                "text": "Démythologiser Dieu ?"
                            },
                            {
                                "example_id": "e451fe93-31b9-44d9-926e-8665572e78ad",
                                "sense_id": "84355938-15e5-3d74-a1c7-ef497a825d18",
                                "text": "Ces exorcistes, issus de la critique rationaliste des années 60, souhaitent « démythologiser » Satan et voient davantage le problème sous l'angle psychologique."
                            },
                            {
                                "example_id": "533e111b-6bb8-4b8f-9a28-bac91abd380d",
                                "sense_id": "84355938-15e5-3d74-a1c7-ef497a825d18",
                                "text": "Il existe une différence, à cet égard, entre démystifier et démythologiser."
                            }
                        ]
                    }
                ],
