                        "glosses": [
                            "zumeist kleines, vorwiegend mit Palmenbäumen bewachsenes Waldstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbd0f672-a623-40e5-b797-ec05241e1971",
                                "sense_id": "776ec2f9-6edc-3df3-9f39-04cc98dddcc3",
                                "text": "„Zwischen Palmenhainen windet sich die Silberschlange des Tungabhadra-Flusses, und in alle Himmelsrichtungen ragen Hügel, die von Granitbrocken übersät sind.“"
                            },
                            {
                                "example_id": "70342751-9964-41a5-8073-29c5a3f32de9",
                                "sense_id": "776ec2f9-6edc-3df3-9f39-04cc98dddcc3",
                                "text": "„Auf der Île aux Forbans, in einem Palmenhain nahe der kleinen Hafenstadt Ambodifotatra, stehen verwitterte Grabsteine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
