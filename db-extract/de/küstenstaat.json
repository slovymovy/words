                "senses": [
                    {
                        "sense_id": "4027c5e8-057e-392d-8a79-e94c0b1caf57",
                        "entry_id": "006ce46d-90a8-3141-bc31-1b7f7a19ad91",
                        "glosses": [
                            "ein Staat, der an einen Ozean beziehungsweise ein Meer grenzt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "4e568656-dfa6-4a70-8403-44e5fc27b90f",
                                "sense_id": "4027c5e8-057e-392d-8a79-e94c0b1caf57",
                                "text": "Allen Küstenstaaten ist gemein, dass sie freien Zugang zum Ozean haben."
                            },
                            {
                                "example_id": "ff5e28d7-c3f2-42ef-9f5b-76d55ab9ec25",
                                "sense_id": "4027c5e8-057e-392d-8a79-e94c0b1caf57",
                                "text": "[Es] brennt in dem Küstenstaat Oregon , wo es üblicherweise längst nicht so trocken ist wie in Nevada, Utah und Idaho. Auch in diesen Bundesstaaten wüten die Feuer."
                            },
                            {
                                "example_id": "31710d68-1e48-4d3e-837d-d3865e0461d9",
                                "sense_id": "4027c5e8-057e-392d-8a79-e94c0b1caf57",
                                "text": "Durch internationale Abkommen ist geregelt, dass die Seenotrettung von allen Küstenstaaten in ihren Hoheitsgewässern durchzuführen ist."
                            },
                            {
                                "example_id": "c3f487e7-fa78-41a9-a627-b6a8221bad3e",
                                "sense_id": "4027c5e8-057e-392d-8a79-e94c0b1caf57",
                                "text": "Die dänische Küche ist geprägt von der geographischen Lage Dänemarks als Küstenstaat mit seinen zahlreichen Inseln sowie seiner ausgeprägten Landwirtschaft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
