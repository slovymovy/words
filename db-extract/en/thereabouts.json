                        "glosses": [
                            "Location; whereabouts."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "023177c1-493b-48dd-a40e-daba850bfd23",
                                "sense_id": "014f8a22-e498-3c88-ad4b-06e0c1879daa",
                                "text": "True, he had stopped at Langston Bucket by chance, and there was no reason why Mr. Boke should theorise as to his thereabouts."
                            },
                            {
                                "example_id": "696b6815-32d1-4ec5-95f6-407920d6dfaa",
                                "sense_id": "014f8a22-e498-3c88-ad4b-06e0c1879daa",
                                "text": "My companions are not far off, and are aware of my thereabouts."
                            }
                        ]
                    }
                ],
