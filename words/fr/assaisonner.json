    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "744d3aee-0fd3-3e86-83f6-fd6d069a00aa",
                    "sense_definition": "Ajouter des condiments, du sel ou des épices à un aliment pour en relever la saveur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>assaisonner</w> la salade avec un filet d'huile d'olive et un peu de vinaigre."
                        },
                        {
                            "text": "Le chef cuisinier <w>assaisonne</w> généreusement la viande avant de la faire dorer."
                        }
                    ],
                    "synonyms": [
                        "épicer",
                        "relever"
                    ],
                    "common_phrases": [
                        "assaisonner la salade",
                        "assaisonner un plat"
                    ]
                },
                {
                    "sense_id": "f0074e1e-bf0f-38f5-848f-daba78a4b342",
                    "sense_definition": "Agrémenter des propos ou des écrits d'une touche piquante, spirituelle ou ironique.",
