                                    },
                                    {
                                        "sense_id": "f812aa7f-8123-3762-8eb6-b628d558b03a",
                                        "entry_id": "5ccb6123-f10c-318a-a979-aae8e84f3463",
                                        "glosses": [
                                            "Machine à botteler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdae1816-1651-44d8-b932-afb38d5930b3",
                                                "sense_id": "f812aa7f-8123-3762-8eb6-b628d558b03a",
                                                "text": "La semaine dernière, c’était le toit des porcs, la botteleuse, de nouvelles courroies, un moteur, toujours quelque chose."
                                            },
                                            {
                                                "example_id": "d2adcf96-67e5-4070-9923-39f610b6884e",
                                                "sense_id": "f812aa7f-8123-3762-8eb6-b628d558b03a",
                                                "text": "Installée en position inclinée sur la plate-forme, cette botteleuse bricolée ne pourrait plus être utilisée de façon conforme."
                                            },
                                            {
                                                "example_id": "eb2e8e51-9da0-4abb-b0de-c48da535f150",
                                                "sense_id": "f812aa7f-8123-3762-8eb6-b628d558b03a",
                                                "text": "Je passerai demain, pour atteler la botteleuse au Massey, dit Gus en faisant mine de partir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e97b3685-cbe3-3aa4-b14a-9c9b3cb2295c",
                                        "entry_id": "5ccb6123-f10c-318a-a979-aae8e84f3463",
                                        "glosses": [
                                            "Machine manuelle pour rouler les cigarettes. Rouleuse à cigarette."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3032d7e7-39c7-489a-b82b-086e933e97d2",
                                                "sense_id": "e97b3685-cbe3-3aa4-b14a-9c9b3cb2295c",
                                                "text": "J’ai retrouvé la boîte à cigarettes de mon père, sa botteleuse. Il tassait le tabac dans le creux d’une membrane, léchait une feuille de RizLaCroix, la mettait en place, refermait la boîte."
                                            }
                                        ]
                                    }
                                ]
                            }
