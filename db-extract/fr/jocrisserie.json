                        "examples": [
                            {
                                "example_id": "04cf937d-efd0-480f-a502-31255fcce976",
                                "sense_id": "e2131436-6f21-3688-81e2-bb73abe9769c",
                                "text": "Il court çà et là une trivialité, une jocrisserie qui pourtant, à mon sens, ne manque pas de raison : Que je suis heureux de ne pas aimer les épinards, car si je les aimais j’en mangerais, et je ne peux pas les souffrir."
                            },
                            {
                                "example_id": "a2658e0e-11e9-4b3c-b6b4-e6992ec97fc5",
                                "sense_id": "e2131436-6f21-3688-81e2-bb73abe9769c",
                                "text": "L’habile homme, toutefois, se croyant, quand même, désigné pour instruire ses contemporains, c’est, en même temps, le prodige d’une sorte de jocrisserie peinturière s'exaspérant jusqu’à devenir tourbillon […]."
                            }
                        ]
                    }
