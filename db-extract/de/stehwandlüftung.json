                "senses": [
                    {
                        "sense_id": "fbe7fb8f-75d6-3264-a01e-9a3e76d5a320",
                        "entry_id": "25595c78-0370-30b5-8715-0706c25d7f91",
                        "glosses": [
                            "lüftungstechnische Zu- und Abluftführung durch einstellbare Einbauelement in einer Wand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f7ef420-1a1e-4a15-a21a-5d3bfd66a914",
                                "sense_id": "fbe7fb8f-75d6-3264-a01e-9a3e76d5a320",
                                "text": "„Als Basis für eine ideale Klärschlammtrocknung haben wir ein Lüftungssystem, bestehend aus Stehwandlüftung und Firstlüftung, sowie einer Kombination von Ventilatoren, projektiert.“"
                            },
                            {
                                "example_id": "91b241b6-1f45-49a3-9aab-4d3f3578b31c",
                                "sense_id": "fbe7fb8f-75d6-3264-a01e-9a3e76d5a320",
                                "text": "„Die Abteilung war Teil eines 9,4 m breiten deutschen Normgewächshauses mit 2,5 m hohen Seitenwänden, einer Stehwandlüftung zur Südseite und Firstlüftungen.“"
                            },
                            {
                                "example_id": "6b9ac02d-e0ab-4d51-b093-c0b82fc2f3bf",
                                "sense_id": "fbe7fb8f-75d6-3264-a01e-9a3e76d5a320",
                                "text": "„So sorgt die Stehwandlüftung für gute Temperaturführung und die Assimilationsbeleuchtung für optimale Lichtverhältnisse.“"
                            },
                            {
                                "example_id": "73051f29-8fcc-4c56-8013-32a554978d45",
                                "sense_id": "fbe7fb8f-75d6-3264-a01e-9a3e76d5a320",
                                "text": "„Besonders bei niedrigen Gewächshäusern empfiehlt sich der Einbau einer Stehwandlüftung.“"
                            },
                            {
                                "example_id": "5846a4bc-d9a8-4f0e-886e-02c784625ffb",
                                "sense_id": "fbe7fb8f-75d6-3264-a01e-9a3e76d5a320",
                                "text": "„Unsere Standard-Stehwandhöhe von 2 m senkrecht garantiert einen optimalen Wirkungsgrad der Stehwandlüftung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
