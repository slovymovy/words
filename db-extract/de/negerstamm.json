                "senses": [
                    {
                        "sense_id": "aa7dbd2a-a8d7-349e-80b0-78c9035d4aaa",
                        "entry_id": "0226e277-e23b-376b-836b-e28d77d9b8bc",
                        "glosses": [
                            "Stamm von dunkelhäutigen Menschen"
                        ],
                        "tags": [
                            "derogatory",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "281dec02-08c6-4758-b3d3-2827edd817a8",
                                "sense_id": "aa7dbd2a-a8d7-349e-80b0-78c9035d4aaa",
                                "text": "„Laut einem anderen Zeugen, Mr. T.H. Wilson-Grant, einem lizensierten Händler aus Mepli, sind die Negerstämme in eine Art Massenwahn verfallen.“"
                            },
                            {
                                "example_id": "27990f2f-e2e9-4c69-ba98-61a80d19374e",
                                "sense_id": "aa7dbd2a-a8d7-349e-80b0-78c9035d4aaa",
                                "text": "„Für solche Kriege galten spezielle Regeln. Das hatte der sich unter den deutschen Rechtsextremen höchster Beliebtheit erfreuende Staatswissenschaftler Heinrich von Treitschke bereits in Politik (1897/98) festgestellt: »Aber das Völkerrecht wird zur Phrase, wenn man dergleichen Grundsätze auch auf barbarische Völker anwenden will. Einem Negerstamm muß man zur Strafe seine Häuser anzünden, ohne ein solches Exempel richtet man da nichts aus. Es ist nicht Humanität und feines Rechtsgefühl, sondern schimpfliche Schwäche, wenn das Deutsche Reich nicht nach diesen Grundsätzen verfährt.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
