                        "glosses": [
                            "Département français de la région administrative des Pays de la Loire, qui porte le numéro 44."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "464bebd9-18f9-4020-bdff-0d4765431517",
                                "sense_id": "70d0d008-5497-3e21-a1ad-6475940743fd",
                                "text": "C’est le cas à Campbon, dans le nord de la Loire-Atlantique, où « ce banc est bien plus qu’un simple mobilier », assure-t-on à l’école publique Ferdinand-Daniel."
                            },
                            {
                                "example_id": "6c277ef1-c452-4c7f-a41c-c3e550b8ce95",
                                "sense_id": "70d0d008-5497-3e21-a1ad-6475940743fd",
                                "text": "Alric Paon, à la tête d’un réseau d’une quinzaine de poissonneries et points de vente en Loire-Atlantique, observe également cette augmentation soudaine du tarif du bulot : « Les habitués nous posent des questions, forcément. On explique le contexte et on tire sur nos marges. »"
                            }
                        ]
                    }
