                ],
                "senses": [
                    {
                        "sense_id": "f523f08c-1624-32d3-81ca-06e2c8cadfea",
                        "entry_id": "ae57b67d-b32c-3658-919f-1ee948d9d904",
                        "glosses": [
                            "sehr spät reifende Rotweinrebsorte mit großen Beeren, die vor allen Dingen in Württemberg angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55159721-35e5-4f8e-a1e7-9f9821b839ce",
                                "sense_id": "f523f08c-1624-32d3-81ca-06e2c8cadfea",
                                "text": "Ihren Namen verdankt die Rebe dem intensiven, aber unaufdringlichen Muskatbukett; mit dem Trollinger teilt sie die rubinrote Färbung und gute Bekömmlichkeit."
                            },
                            {
                                "example_id": "7219cc52-a08d-4125-aea7-a5f8925325be",
                                "sense_id": "f523f08c-1624-32d3-81ca-06e2c8cadfea",
                                "text": "„Der Name Muskattrollinger deutet schon die beiden Gegensätze dieser Weinsorte an - auf der einen Seite die hellrote Farbe eines Trollingers, auf der anderen Seite der würzige Duft eines Muskatweins. Manfred Buscher bewirtschaftet in Bechtheim die einzige Anlage mit Muskattrollinger in ganz Rheinhessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "22bf26b5-15ba-35bf-9903-0bf0fc121b8f",
                        "entry_id": "ae57b67d-b32c-3658-919f-1ee948d9d904",
                        "glosses": [
                            "Wein, der aus Trauben der unter [1] genannten Rebsorte hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ca43c38-9e71-4331-8f68-cc1f9e1c3e02",
                                "sense_id": "22bf26b5-15ba-35bf-9903-0bf0fc121b8f",
                                "text": "Um auszudrücken, dass der Muskattrollinger keine Cuvée ist, vermeidet man die auch zulässige Schreibweise Muskat-Trollinger."
                            },
                            {
                                "example_id": "88017b76-5c6f-4c35-93b8-e0769d72b496",
                                "sense_id": "22bf26b5-15ba-35bf-9903-0bf0fc121b8f",
                                "text": "Der Muskattrollinger wirkt als Rotwein mitunter etwas zu parfümiert."
                            },
                            {
                                "example_id": "6a263367-b4b8-4b0a-b815-6e268b9d554d",
                                "sense_id": "22bf26b5-15ba-35bf-9903-0bf0fc121b8f",
                                "text": "»Wie man sich so fühlt, wenn man mit einem Kollegen, den man nicht mag, einen Mord aufklären soll.« »Na super«, bemerkte Katja. »Hast du Lust, mir die ganze Sache bei einem Glas Muskattrollinger zu erzählen?«"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
