                        "glosses": [
                            "Prophète hébreu, homme inspiré, illuminé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654aaa0f-d492-4ba2-8c46-6095f05b1092",
                                "sense_id": "f6c01fd3-7c98-3831-93ae-2adfdb4e1cb2",
                                "text": "Chaque tribu nomade avait son nabi ou prophète."
                            },
                            {
                                "example_id": "e326cf9c-373a-4536-aea9-90dbd0d94f82",
                                "sense_id": "f6c01fd3-7c98-3831-93ae-2adfdb4e1cb2",
                                "text": "Quelle analogie pouvait-on relever entre cet octogénaire las et triste et l’évangéliste de l’Ancien Testament, le nabi en tumulte, l’impétueux, le vitupérant Isaïe ?"
                            },
                            {
                                "example_id": "f0232d62-2413-4142-9c8e-58ac2162a0a7",
                                "sense_id": "f6c01fd3-7c98-3831-93ae-2adfdb4e1cb2",
                                "text": "Le titre du livre de Gibran Khalil Gibran, Le Prophète (ou The Prophet pour la version originale en anglais) se dit An-Nabi dans l'écriture arabe translittérée en alphabet latin."
                            }
                        ]
                    },
