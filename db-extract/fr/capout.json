                                            {
                                                "example_id": "a72ad227-cade-4cd9-95bc-9bc9582640f5",
                                                "sense_id": "bbe80581-2412-3c0f-9235-5db8032705d4",
                                                "text": "Die Waschmaschine, die ich eben als „neuwertig“ gekauft habe, ist leider kaputt."
                                            },
                                            {
                                                "example_id": "d19daf2e-f383-4d56-8c2a-346fda202d32",
                                                "sense_id": "bbe80581-2412-3c0f-9235-5db8032705d4",
                                                "text": "Viele Firmen bauen in ihre Produkte \"Sollbruchstellen\" ein: Das Gerät geht nach relativ kurzer Zeit kaputt, der Kunde muss ein neues kaufen."
                                            },
                                            {
                                                "example_id": "1888c51a-69fc-49fa-8c37-61717031261d",
                                                "sense_id": "bbe80581-2412-3c0f-9235-5db8032705d4",
                                                "text": "„Mein einziger Sport-BH ist kaputt, und da die Dessous-Geschäfte momentan geschlossen haben und der Versandhandel nicht liefert, werde ich auch in Zukunft ohne auskommen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7dd26208-b03f-320b-9a81-9e94421dff7e",
                                        "entry_id": "5ac1bcc8-beac-3e3a-81ed-0dbe6db21370",
                                        "glosses": [
                                            "körperlich oder seelisch erschöpft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf0b140-bc54-4ff2-8508-775b95eccceb",
                                                "sense_id": "7dd26208-b03f-320b-9a81-9e94421dff7e",
                                                "text": "Nach den 42 Kilometern war ich kaputt wie nie zuvor."
                                            },
                                            {
                                                "example_id": "285a5265-58b1-407e-a326-189528d03129",
                                                "sense_id": "7dd26208-b03f-320b-9a81-9e94421dff7e",
                                                "text": "\"Der Eindruck des Holocaust und des Weltkrieges auf die deutschen Juden, die nach Südafrika emigrierten, war derart gewaltig, dass sie emotional erschöpft waren und sich deshalb nicht an politischen Aktivitäten gegen die Apartheid beteiligten\", sagt Newman und erinnert sich an seinen eigenen Vater, der aus Deutschland geflohen ist: \"Danach war er emotional kaputt\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b3004d36-f7a1-3199-8297-b78f6fa5ba04",
                                        "entry_id": "5ac1bcc8-beac-3e3a-81ed-0dbe6db21370",
                                        "glosses": [
                                            "menschlich am Ende; wirtschaftlich ruiniert"
                                        ],
                                        "tags": [],
