                                                "sense_id": "ebf6b34b-0789-39d3-b241-3d0c0ee59df6",
                                                "text": "Mein Kater ist ein Stromer, der kommt nur noch zum Fressen nach Hause, oder wenn er krank ist."
                                            },
                                            {
                                                "example_id": "31721747-d6c9-4988-bcc9-e8095bd4deab",
                                                "sense_id": "ebf6b34b-0789-39d3-b241-3d0c0ee59df6",
                                                "text": "„Der Stromer brauchte keine weitere Aufforderung.“"
                                            }
