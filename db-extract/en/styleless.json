                "senses": [
                    {
                        "sense_id": "df2ad80b-f32e-3cac-b4c0-99920b99de2f",
                        "entry_id": "c7f53b33-ba19-34cd-bd1b-c4a9bf29b34e",
                        "glosses": [
                            "Lacking good style or any style at all."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "34cbcf10-813e-4e15-a340-deeb5f35cbc9",
                                "sense_id": "df2ad80b-f32e-3cac-b4c0-99920b99de2f",
                                "text": "It is not enough to say that style is a characteristic mode of expression, for then it would be almost impossible to speak of anything as styleless."
                            },
                            {
                                "example_id": "6e7c1509-e48d-4802-9f74-0ae1139df4e9",
                                "sense_id": "df2ad80b-f32e-3cac-b4c0-99920b99de2f",
                                "text": "He was too thin, so that the styleless clothes hung poorly, and something in his coloring made her think that he ate the wrong foods."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d688251-f902-32ed-948d-f7f6b40bafea",
                        "entry_id": "c7f53b33-ba19-34cd-bd1b-c4a9bf29b34e",
                        "glosses": [
                            "Lacking a style (stalk structure)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
