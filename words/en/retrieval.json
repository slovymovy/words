                    "sense_definition": "The cognitive process of bringing stored information into consciousness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "information_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sleep deprivation can significantly impair your memory <w>retrieval</w> during an exam.",
                            "target_lang_translations": {
                                "ru": "Недосыпание может значительно ухудшить <w>воспроизведение</w> информации из памяти во время экзамена."
                            }
                        },
                        {
                            "text": "The patient showed improvement in the <w>retrieval</w> of long-term memories after therapy.",
                            "target_lang_translations": {
                                "ru": "После терапии у пациента наблюдалось улучшение в <w>извлечении</w> долговременных воспоминаний."
                            }
