{
    "word_family": [
        "pourquoi",
        "quoique"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "f23e8269-231a-36aa-9d41-fcb6d55df295",
                    "sense_definition": "Quelle chose ; s'emploie familièrement en fin de proposition pour remplacer « que » ou « qu'est-ce que ».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu fais <w>quoi</w> ce soir après les cours avec tes amis ?"
                        },
                        {
                            "text": "C'est <w>quoi</w> cette musique bizarre qui vient de la chambre voisine ?"
                        }
                    ],
                    "common_phrases": [
                        "c'est quoi"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usage courant à l'oral"
                        }
                    ]
                },
                {
                    "sense_id": "787c2341-57c3-33b5-8131-3dc6e559e059",
                    "sense_definition": "Quelle chose ; employé après une préposition dans une phrase interrogative.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À <w>quoi</w> penses-tu en regardant ainsi par la fenêtre ce matin ?"
                        },
                        {
                            "text": "De <w>quoi</w> as-tu besoin pour préparer le repas de ce soir ?"
                        }
                    ],
                    "common_phrases": [
                        "à quoi",
                        "de quoi"
                    ]
                },
                {
                    "sense_id": "365551f7-c4f3-3e68-ac5e-9bccea20a32d",
                    "sense_definition": "Employé avec une négation pour signifier l'absence de motif d'inquiétude ou de remerciement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantite_indefinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Merci pour votre aide précieuse, il n'y a pas de <w>quoi</w> !"
                        },
                        {
                            "text": "Ne t'inquiète pas, il n'y a pas de <w>quoi</w> paniquer pour cela."
                        }
                    ],
                    "common_phrases": [
                        "pas de quoi",
                        "il n'y a pas de quoi"
                    ]
                },
                {
                    "sense_id": "d7ea2fa4-2d71-31f1-868b-253128f4f528",
                    "sense_definition": "Quelle chose ; employé dans une interrogation indirecte devant un verbe à l'infinitif.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interrogatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne sais vraiment pas <w>quoi</w> choisir sur cette carte de desserts."
                        },
                        {
                            "text": "Elle hésite encore et ne sait pas <w>quoi</w> faire de ses vacances."
                        }
                    ],
                    "common_phrases": [
                        "quoi faire",
                        "quoi dire"
                    ]
                },
                {
                    "sense_id": "fd903b82-5979-3f77-9ab8-e2b7abbda6d4",
                    "sense_definition": "Pronom relatif précédé d'une préposition, représentant un antécédent neutre indéfini.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est exactement ce sur <w>quoi</w> notre équipe travaille depuis deux semaines."
                        },
                        {
                            "text": "Il n'y a rien à <w>quoi</w> je tienne plus qu'à ma liberté."
                        }
                    ],
                    "common_phrases": [
                        "ce sur quoi",
                        "ce à quoi"
                    ]
                },
                {
                    "sense_id": "bac104d0-0f99-3fc9-a5f8-9d925905892d",
                    "sense_definition": "Ce qui est nécessaire ou suffisant pour accomplir une action déterminée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite_indefinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons largement de <w>quoi</w> nourrir tous nos invités ce soir."
                        },
                        {
                            "text": "Prends ton manteau chaud, il y a de <w>quoi</w> attraper froid dehors."
                        }
                    ],
                    "common_phrases": [
                        "avoir de quoi",
                        "de quoi faire"
                    ]
                },
                {
                    "sense_id": "83e2da5d-7a6c-31dc-858c-5cf513ab7b30",
                    "sense_definition": "Quelle que soit la chose, quelles que soient les circonstances envisageables.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quoi</w> qu'il arrive, nous devons rester calmes et garder confiance."
                        },
                        {
                            "text": "Elle garde le sourire <w>quoi</w> qu'on puisse lui reprocher injustement."
                        }
                    ],
                    "common_phrases": [
                        "quoi qu'il arrive",
                        "quoi qu'il en soit"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "cc635095-9749-3f49-aa54-84955b9448fb",
                    "sense_definition": "Exprime l'incompréhension et demande à l'interlocuteur de répéter ce qu'il vient de dire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interjection_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Tu viens avec nous ? — <w>Quoi</w> ? Je n'ai pas entendu avec tout ce vacarme."
                        },
                        {
                            "text": "<w>Quoi</w> ? Peux-tu parler un peu plus fort, s'il te plaît ?"
                        }
                    ],
                    "synonyms": [
                        "comment",
                        "pardon",
                        "hein"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "peut paraître impoli face à des inconnus"
                        }
                    ]
                },
                {
                    "sense_id": "4185da01-bbbe-3bb5-a036-6d322391f7cf",
                    "sense_definition": "Exprime un sentiment de vive surprise, d'étonnement ou d'indignation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interjection_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quoi</w> ! Tu as déjà dépensé tout ton argent de poche en deux jours ?"
                        },
                        {
                            "text": "<w>Quoi</w> ! C'est inadmissible de parler de cette manière à un collègue !"
                        }
                    ],
                    "synonyms": [
                        "comment",
                        "hein"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "marque de surprise spontanée"
                        }
                    ]
                },
                {
                    "sense_id": "13bfa0cb-aea7-3d6d-bf2c-03ecb98a2ff4",
                    "sense_definition": "Exprime une attente de justification, une mise au point ou un léger agacement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interjection_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quoi</w> ? Pourquoi me regardes-tu avec cet air coupable depuis tout à l'heure ?"
                        },
                        {
                            "text": "<w>Quoi</w> ? Tu as un problème avec ma façon d'organiser cette réunion ?"
                        }
                    ],
                    "synonyms": [
                        "qu'est-ce qu'il y a"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre informel ou familier"
                        }
                    ],
                    "common_phrases": [
                        "ben quoi"
                    ]
                },
                {
                    "sense_id": "b9fe7b0f-26f5-30e6-b767-eb86eb51b740",
                    "sense_definition": "Marqueur discursif placé en fin de phrase pour solliciter l'assentiment ou ponctuer le propos.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tic_langage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On a marché toute l'après-midi sous la pluie, une vraie galère, <w>quoi</w>."
                        },
                        {
                            "text": "Ce n'est jamais simple de tout recommencer à zéro dans une nouvelle ville, <w>quoi</w>."
                        }
                    ],
                    "synonyms": [
                        "hein",
                        "n'est-ce pas",
                        "non"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "tic de langage très répandu à l'oral"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e7a9c700-333b-3625-a920-fa96858110c1",
                    "sense_definition": "S'emploie en clôture d'énoncé pour résumer brièvement une idée, marquant un raccourci familier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tic_langage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'avait aucune envie de participer à notre fête d'anniversaire, <w>quoi</w>."
                        },
                        {
                            "text": "C'est une voiture ancienne mais qui rend encore de grands services, <w>quoi</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "utilisé oralement pour clore un propos"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "925cf5cb-825a-3341-944b-3ac5a3293cd3",
                    "sense_definition": "Le fond, l'objet ou la matière d'une étude, par opposition aux méthodes employées.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conférencier a minutieusement examiné le <w>quoi</w> avant d'aborder le comment de la méthode."
                        },
                        {
                            "text": "Il convient de bien distinguer le <w>quoi</w> et le pourquoi dans ce débat philosophique."
                        }
                    ],
                    "common_phrases": [
                        "le quoi et le comment"
                    ]
                }
            ]
        }
    ]
}