                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614123de-7b7d-4c6c-b708-53a00a3f9aaf",
                                "sense_id": "c005fb52-f19b-30c0-9337-9487476b20d0",
                                "text": "Et les jeunes femmes habiles, aiguilles en bouche et pied battant leur machine à coudre, « font elles-mêmes leurs robes » et passent des journées à « smocker » celles de leurs fillettes."
