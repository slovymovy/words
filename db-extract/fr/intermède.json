                                        "glosses": [
                                            "An intervening episode, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d01859ee-d79e-389d-98c7-c3097e807f89",
                                        "entry_id": "112f265b-f147-3535-aff7-520d406178d1",
                                        "glosses": [
                                            "An entertainment between the acts of a play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b1e133-e81e-4212-babc-4e2704610ea7",
                                                "sense_id": "d01859ee-d79e-389d-98c7-c3097e807f89",
                                                "text": "[O]ur ovvne Statutes […] preciſely prohibit the ſatyricall depraving, traducing, or derogation of the Common Prayer-Booke, and of the Sacrament of the Lords Supper in any Enterludes, Playes or Rimes, (in vvhich kinde Playes had been formerly peccant) under ſevere penalties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1647d55a-42dc-3f93-8e59-6ba400a23c55",
                                        "entry_id": "112f265b-f147-3535-aff7-520d406178d1",
                                        "glosses": [
                                            "A short piece put between the parts of a longer composition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "interlude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "650eca22-91c1-3f77-a0d6-ed98d6a38338",
                                        "entry_id": "0db9c564-0a7d-3727-9332-4ded2a1953d6",
                                        "glosses": [
                                            "To provide with an interlude."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d3109a8-cc65-411f-9065-93c9e18eb243",
                                                "sense_id": "650eca22-91c1-3f77-a0d6-ed98d6a38338",
                                                "text": "Jimmy Jam, co-producer of Ms. Jackson’s heavily interluded and influential 1989 album, “Rhythm Nation 1814” (and producer of a forthcoming album by Usher with interludes), also defended them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8268c73-382b-3cb5-87a7-6930c43b9ea9",
                                        "entry_id": "0db9c564-0a7d-3727-9332-4ded2a1953d6",
                                        "glosses": [
                                            "To serve as an interlude."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1340a5e4-f923-461a-b373-92701b55e078",
                                                "sense_id": "d8268c73-382b-3cb5-87a7-6930c43b9ea9",
                                                "text": "During some brief, interluding, silent pauses in their interview thus far, Pierre had heard a soft, slow, sad, to-and-fro, meditative stepping on the floor above; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
