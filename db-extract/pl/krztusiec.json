                    {
                        "sense_id": "671431c7-0afb-34e5-9696-35495abc86b3",
                        "entry_id": "60417d2e-ee1d-34d0-bfc0-6ca7e09c866e",
                        "glosses": [
                            "zakaźna choroba wieku dziecięcego, której objawem są kaszel i duszności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c50a010-5e5a-4c37-a7e3-109e0ddcf184",
                                "sense_id": "671431c7-0afb-34e5-9696-35495abc86b3",
                                "text": "W szkole szaleje krztusiec, nie wypuszczę dziecka z domu!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aa96bcf-985d-49da-a38b-805c84d11336",
                        "source_entry_id": "60417d2e-ee1d-34d0-bfc0-6ca7e09c866e",
                        "source_sense_id": "671431c7-0afb-34e5-9696-35495abc86b3",
                        "target_lang_word": "pertussis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pertussis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                        "entry_id": "396d496b-21b9-3fb6-bfb9-4de7814dc06d",
                                        "glosses": [
                                            "Whooping cough."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24e1784-70f2-47cf-bd6e-cd92c6bcafe3",
                                                "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                                "text": "With the introduction of an improved and standardized pertussis vaccine in the 1940s, there followed a remarkable decline in pertussis in the United States, most of the Western world, and Australia, New Zealand, and Japan."
                                            },
                                            {
                                                "example_id": "66eda0a3-c505-4b11-918a-8a6c5a191827",
                                                "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                                "text": "Bordetella pertussis is a Gram-negative bacterial pathogen that infects the human respiratory tract, causing the disease pertussis or whooping cough."
                                            },
                                            {
                                                "example_id": "c54a0153-34cc-4080-82ad-a1f6703bef9e",
                                                "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                                "text": "2015, Dr. Stephen Berger, Pertussis: Global Status, GIDEON Informatics, Inc., E-book, page 343,\nDuring 1993 to 2004, the hospitalization rate [in the US] for pertussis among infants ages <= 2 months was 239 per 100,000 live births."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cd414b8-f3bf-4418-a9d2-5b26d5f97071",
                        "source_entry_id": "60417d2e-ee1d-34d0-bfc0-6ca7e09c866e",
                        "source_sense_id": "671431c7-0afb-34e5-9696-35495abc86b3",
                        "target_lang_word": "whooping cough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whooping cough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e9da726-524f-3882-af18-1abd23baabb5",
                                        "entry_id": "e9640d97-2271-3620-9d7b-1765e67808ad",
                                        "glosses": [
                                            "A contagious disease of the respiratory system that usually affects children caused by the bacterium Bordetella pertussis, the advanced stage of which is characterised by spasms of coughing followed by a whooping sound during the intake of breath."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8310859-7135-45d6-9eef-1f31397e6812",
                        "source_entry_id": "60417d2e-ee1d-34d0-bfc0-6ca7e09c866e",
                        "source_sense_id": "671431c7-0afb-34e5-9696-35495abc86b3",
                        "target_lang_word": "coqueluche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coqueluche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                        "entry_id": "7df69823-1326-34ce-8135-b1cfcb0847b0",
                                        "glosses": [
                                            "Maladie bactérienne due à Bordetella pertussis, elle atteint principalement les enfants et se caractérisé par une toux convulsive."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ad219b-12fc-4a9e-a3c3-a0da4fd62fb6",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Il arrive un moment où l’idée du mariage vous prend tous : c’est comme la coqueluche qui attrape les enfants à un certain âge."
                                            },
                                            {
                                                "example_id": "e3a0a127-c7ed-4c31-af6d-73a270a57dab",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Je te répondrai que l’on n’a jamais prétendu non plus, avec le seul secours du bon sens, guérir la coqueluche ou la scarlatine."
                                            },
                                            {
                                                "example_id": "ab080346-52f3-463d-a64c-421e1c02963a",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Depuis 1996, près de 300 cas annuels de coqueluche ont été déclarés en France, avec deux pics observés respectivement en 1997 et en 2000. Le taux d’incidence national chez les enfants de 0 à 2 mois est estimé à 276/100 000 en moyenne."
                                            },
                                            {
                                                "example_id": "2cbff8f4-0741-4eb2-8265-33a89d73f0bc",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Il y a l’entérite cholériforme liée à une nourriture inadaptée, la variole, la rougeole, la coqueluche, la tuberculose. Et face à tout cela, une inaction coupable des pouvoirs publics. Un manque tragique de maternités de crèches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                        "entry_id": "7df69823-1326-34ce-8135-b1cfcb0847b0",
                                        "glosses": [
                                            "Personne particulièrement en vogue, favori."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9d8d25-9ac9-4615-9c4f-9d0b4ae4b3e5",
                                                "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                                "text": "Alexis Hanquinquant est une coqueluche du handisport tricolore, multiple champion de France, champion d’Europe et plusieurs fois médaillé olympique"
                                            },
                                            {
                                                "example_id": "78becd6f-8428-425f-b393-d8a642b5ed64",
                                                "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                                "text": "– Il y a des très jolies femmes à Aix.\n– J’ai donné quelques assauts devant elles.\n– Vous avez dû être leur coqueluche ?...\n– Elles faisaient, en effet, une belle tapisserie."
                                            },
                                            {
                                                "example_id": "86c57c26-4ab2-46a0-bb64-284f0002b3a0",
                                                "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                                "text": "Une œuvre de la jeune coqueluche Yéanzi a été adjugée pour 67 600 euros chez Piasa, à Paris, mi-novembre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deab51b4-f2f6-348b-ac4f-22f7c2f1a05b",
                                        "entry_id": "7df69823-1326-34ce-8135-b1cfcb0847b0",
                                        "glosses": [
                                            "Chose appréciée, affection, engouement."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0168f97a-fcfa-4a07-bc19-2fdfd76031f6",
                                                "sense_id": "deab51b4-f2f6-348b-ac4f-22f7c2f1a05b",
                                                "text": "Cependant, au milieu de cette coqueluche de tendresse pour Lantier, Gervaise, les premières semaines, vécut dans un grand trouble."
                                            },
                                            {
                                                "example_id": "6ceccc20-863e-4c3e-9540-2751de48776a",
                                                "sense_id": "deab51b4-f2f6-348b-ac4f-22f7c2f1a05b",
                                                "text": "Le vrai roi du guinche, la coqueluche, le mieux placé pour lever les frangines, c’est l’accordéon."
                                            }
                                        ]
                                    }
                                ]
                            },
