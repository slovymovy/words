                "senses": [
                    {
                        "sense_id": "87470f8e-ace8-3dc3-af25-0bd52eb180da",
                        "entry_id": "08159db7-8e5d-395e-a8e0-7094f7dc1467",
                        "glosses": [
                            "Relatif aux ISO, mesuré en ISO (unité de mesure de la sensibilité photographique à la lumière)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81882f6-0202-45c8-afa6-4302cd9d1f9b",
                                "sense_id": "87470f8e-ace8-3dc3-af25-0bd52eb180da",
                                "text": "J’ai ouvert mon diaphragme au maximum, ce qui m'a permis d'obtenir une vitesse suffisamment élevée pour figer le mouvement du passant sans avoir besoin d’augmenter la sensibilité ISO."
                            },
                            {
                                "example_id": "6b502be3-f211-4b24-afed-1c995af2a8ed",
                                "sense_id": "87470f8e-ace8-3dc3-af25-0bd52eb180da",
                                "text": "À l'instar du diaphragme et des vitesses, l’échelle ISO respecte une progression du simple au double : 25, 50, 100, 200, 400, 800, 1 600, 3 200, 6 400..."
                            },
                            {
                                "example_id": "47447db9-345c-4e03-b3fe-0801aa68d6ce",
                                "sense_id": "87470f8e-ace8-3dc3-af25-0bd52eb180da",
                                "text": "Plus la valeur ISO est élevée, plus le film sera sensible à la lumière, il sera moins gourmand et pourra se contenter de moins de lumière."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
