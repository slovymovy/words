                        "examples": [
                            {
                                "example_id": "b95380da-2c82-484b-9798-2d75a1afa104",
                                "sense_id": "b96af4e0-fef8-3387-b9c9-1c4da8a93da3",
                                "text": "Narcissus und die Tulipan, / Die ziehen sich viel schöner an / Als Salomonis seyde."
                            },
                            {
                                "example_id": "b0e83b58-6b7e-4caf-b0e3-0b7db80e4c5c",
                                "sense_id": "b96af4e0-fef8-3387-b9c9-1c4da8a93da3",
                                "text": "„Guter Freund, redete er ihn an, könnt ihr mir nicht sagen, wie der Herr heißt, dem dieses wunderschöne Haus gehört mit den Fenstern voll Tulipanen, Sternenblumen und Levkoien?“"
                            }
                        ]
                    }
