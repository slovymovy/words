                        "cross_references": [
                            {
                                "target_word": "debitorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae01cda-0dce-356c-812a-2d4926bca016",
                                        "entry_id": "b5e811fc-5b54-3b38-a626-7832c6ba800e",
                                        "glosses": [
                                            "ein debitorisch geführtes Konto: dauerhaft überzogen, als Kreditkonto geführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac1de39c-40a7-4f21-97bc-5b0e17f023d2",
                                                "sense_id": "8ae01cda-0dce-356c-812a-2d4926bca016",
                                                "text": "Ein debitorisch geführtes Konto ist ein Konto, welches dauerhaft überzogen wird und mit Schuldzinsen belastet wird. Damit ist der Kontoinhaber gegenüber der Bank ein Debitor. Der Gegensatz zu debitorisch ist kreditorisch. Mit einem kreditorisch geführten Konto, welches dauerhaft im Plus ist, stellt der Kontoinhaber der Bank einen Kredit zur Verfügung. Damit ist der Kontoinhaber gegenüber der Bank ein Kreditor."
                                            },
                                            {
                                                "example_id": "deef6327-e556-442f-80fc-cc4f758ae7be",
                                                "sense_id": "8ae01cda-0dce-356c-812a-2d4926bca016",
                                                "text": "„Diese Einzelvorgänge auf einem debitorisch geführten Girokonto könnten an sich durch das Auf- und Verrechnungsverbot erfaßt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
