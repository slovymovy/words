                                                "sense_id": "8629c494-e2c0-35b3-8e76-c44ea6733562",
                                                "text": "А бей азовский с товарищи своими ночевал в таборах."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "бей",
