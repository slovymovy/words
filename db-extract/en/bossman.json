                        "examples": [
                            {
                                "example_id": "52580910-bccd-4677-bd1a-290451c8f5f4",
                                "sense_id": "a4b4de72-58b1-3a06-aae4-e7e3844f981d",
                                "text": "Valerie nodded her head and added, \"The workers don't back you up. They want to cooperate when they don't see the bossman, but as they see the bossman, they get frightened. […]"
                            },
                            {
                                "example_id": "48360731-5a8a-4812-9d59-4ec32d9f491d",
                                "sense_id": "a4b4de72-58b1-3a06-aae4-e7e3844f981d",
                                "text": "I had a job but the bossman let me go (he said)\nI'm sorry but I won't be needing your help no more (I said)\nPlease, mister bossman, I need this job more than you know\nBut he gave me my last paycheck and he sent me on out the door"
                            }
                        ]
                    },
                    {
                        "sense_id": "62e05870-b9b2-3e7e-a637-1e737d03978b",
                        "entry_id": "5d13cb98-fb00-3fcc-ae37-2d105dc35e52",
                        "glosses": [
                            "Used as a term of address for an unfamiliar, possibly distrusted man: bud, buddy, friend."
                        ],
                        "tags": [
                            "informal",
                            "vocative"
                        ],
                        "examples": [
                            {
                                "example_id": "c96df536-5ebc-4179-a776-9989b611d8e0",
                                "sense_id": "62e05870-b9b2-3e7e-a637-1e737d03978b",
                                "text": "You should watch what you say, bossman."
                            },
                            {
                                "example_id": "579cffff-8215-4183-8c99-2676f929cf0a",
                                "sense_id": "62e05870-b9b2-3e7e-a637-1e737d03978b",
                                "text": "I don’t know what to tell you, bossman."
                            }
                        ]
                    },
                    {
                        "sense_id": "50890266-1615-3577-8efc-f6112b23159d",
                        "entry_id": "5d13cb98-fb00-3fcc-ae37-2d105dc35e52",
                        "glosses": [
                            "Used as a term of address for a man who appears courageous: boss."
                        ],
