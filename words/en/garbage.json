                {
                    "sense_id": "6392df68-80fd-37e3-9e12-ed0e01d5d8c3",
                    "sense_definition": "Data in a computer's memory that is no longer in use or is incorrect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system performs <w>garbage</w> collection to free up memory.",
                            "target_lang_translations": {
                                "ru": "Система выполняет сборку <w>мусора</w> для освобождения памяти.",
                                "tr": "Sistem, bellekte yer açmak için <w>çöp</w> toplama işlemini gerçekleştirir.",
                                "zh": "系统执行<w>垃圾</w>回收以释放内存。"
                            }
                        },
                        {
                            "text": "If you input bad data, the output will be <w>garbage</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы введете неверные данные, на выходе получится <w>мусор</w>.",
                                "tr": "Hatalı veri girerseniz, çıktı da <w>çöp</w> olacaktır.",
                                "zh": "如果你输入错误的数据，输出的也会是<w>垃圾</w>信息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "garbage collection",
                        "garbage in garbage out"
