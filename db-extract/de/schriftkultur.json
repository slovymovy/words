                "senses": [
                    {
                        "sense_id": "7a675571-9515-38d3-96ea-a4ec1ffe106f",
                        "entry_id": "5ae74ee6-94bc-3af2-b75f-cbaa415a6fb9",
                        "glosses": [
                            "durch Gebrauch der Schrift geprägte Kultur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f562121e-6586-48ca-a8ed-85ce89815e89",
                                "sense_id": "7a675571-9515-38d3-96ea-a4ec1ffe106f",
                                "text": "„Dennoch waren sie von einer Schriftkultur noch weit entfernt.“"
                            },
                            {
                                "example_id": "96e337c0-1d59-4f9a-86fc-b58b99b897dc",
                                "sense_id": "7a675571-9515-38d3-96ea-a4ec1ffe106f",
                                "text": "„In Timbuktu entdeckt das islamische Afrika seine uralte Schriftkultur neu.“"
                            },
                            {
                                "example_id": "d518c586-a3f4-4b9d-ac6c-b20936f5804b",
                                "sense_id": "7a675571-9515-38d3-96ea-a4ec1ffe106f",
                                "text": "„Derjenige, der sich mit wichtigen Fragen der allgemeinen Kulturgeschichte beschäftigt - und die Entwicklung von Schriftsystemen und der Schriftkultur gehört dazu -, muß kulturelle Kontraste erleben.“"
                            },
                            {
                                "example_id": "591fa997-033b-48df-8325-d31ec98dfe78",
                                "sense_id": "7a675571-9515-38d3-96ea-a4ec1ffe106f",
                                "text": "„Mit dem Siegenzug der 3-D-Technik in Kino und Spielen scheint nun erstmals eine Art Schriftkultur des Gebärdens möglich, basierend nicht auf Stift und Papier, sondern auf 3-D-Kameras.“"
                            },
                            {
                                "example_id": "23bd552a-1766-4d58-87e2-f4374675ffaf",
                                "sense_id": "7a675571-9515-38d3-96ea-a4ec1ffe106f",
                                "text": "„Die Kelten hatten zwar lange Zeit Kontakt zu Schriftkulturen, aber Schrift spielte bei ihnen nie eine so wichtige Rolle wie bei den Römern oder den Griechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
