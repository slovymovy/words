                                        "entry_id": "7ef689fc-5fab-3ed9-b459-d7496676bdb1",
                                        "glosses": [
                                            "Montage électronique permettant de diviser le courant ou la tension."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "053ec35d-7664-31b0-8b45-393c2d054a97",
                                        "entry_id": "7ef689fc-5fab-3ed9-b459-d7496676bdb1",
                                        "glosses": [
                                            "Celui qui est cause de division, de désunion."
                                        ],
