{
    "word_family": [
        "empêchement",
        "empêcheur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9dec8fc2-b759-342f-bb67-82b79037404c",
                    "sense_definition": "Faire en sorte que quelqu'un ne puisse pas faire quelque chose, ou le gêner dans ce qu'il veut faire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "faire obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit des voisins m'<w>empêche</w> de dormir toute la nuit."
                        },
                        {
                            "text": "La pluie nous a <w>empêchés</w> de sortir ce week-end."
                        },
                        {
                            "text": "Rien ne pourra l'<w>empêcher</w> de réaliser son rêve."
                        }
                    ],
                    "common_phrases": [
                        "empêcher de dormir",
                        "empêcher de sortir",
                        "empêcher de passer"
                    ]
                },
                {
                    "sense_id": "0050ce45-c59c-3031-8ed5-1efb62984949",
                    "sense_definition": "Faire obstacle à quelque chose pour qu'il n'arrive pas ou ne puisse pas se produire.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "faire obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce système permet d'<w>empêcher</w> de nombreux accidents sur la route."
                        },
                        {
                            "text": "Les pompiers ont réussi à <w>empêcher</w> l'incendie de se propager."
                        },
                        {
                            "text": "Une barrière a été installée pour <w>empêcher</w> l'eau d'entrer dans la cave."
                        }
                    ],
                    "synonyms": [
                        "prévenir"
                    ],
                    "common_phrases": [
                        "empêcher un accident",
                        "empêcher la propagation",
                        "empêcher un désastre"
                    ]
                },
                {
                    "sense_id": "c41be9de-17fb-322e-874f-7522997d8ca5",
                    "sense_definition": "Se retenir de faire quelque chose, ne pas pouvoir résister à l'envie de le faire (surtout à la forme pronominale s'empêcher de).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne peux pas m'<w>empêcher</w> de rire quand il raconte cette histoire."
                        },
                        {
                            "text": "Elle n'a pas pu s'<w>empêcher</w> de pleurer en le revoyant après tant d'années."
                        }
                    ],
                    "synonyms": [
                        "se retenir de"
                    ]
                },
                {
                    "sense_id": "5d228c00-7697-31fc-a5d5-3e71d002945b",
                    "sense_definition": "Gêner ou arrêter quelqu'un ou quelque chose par un obstacle ; être retenu par un obstacle (surtout au participe : empêché).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "faire obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur, <w>empêché</w> par un rendez-vous imprévu, n'a pas pu assister à la réunion."
                        },
                        {
                            "text": "Les chevaux étaient <w>empêchés</w> d'avancer par la boue épaisse qui couvrait le chemin."
                        }
                    ],
                    "common_phrases": [
                        "empêché par un obstacle"
                    ]
                },
                {
                    "sense_id": "6c9a8481-c693-3a29-851d-4096588b0838",
                    "sense_definition": "Embarrasser, mettre dans l'embarras ; au participe, être embarrassé, ne pas savoir comment agir.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se trouva fort <w>empêché</w> de lui répondre devant tout le monde."
                        },
                        {
                            "text": "Je suis bien <w>empêché</w> de choisir entre ces deux propositions."
                        }
                    ],
                    "common_phrases": [
                        "bien empêché",
                        "fort empêché"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "emploi vieilli ou littéraire"
                        }
                    ]
                }
            ]
        }
    ]
}