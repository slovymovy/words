                "senses": [
                    {
                        "sense_id": "428f4282-e390-304f-be4c-6c495c4a618e",
                        "entry_id": "22c4a7c0-3e93-333f-87d1-5060e1d6bb69",
                        "glosses": [
                            "Relatif à la radiation."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "4b23315e-ed5b-46d5-8526-5baad960dfb7",
                                "sense_id": "428f4282-e390-304f-be4c-6c495c4a618e",
                                "text": "En climatologie, le forçage radiatif est approximativement défini comme la différence entre l'énergie radiative reçue et l'énergie radiative émise par un système climatique donné."
                            },
                            {
                                "example_id": "c39770df-ae3e-4c77-8717-1ff15a7205a5",
                                "sense_id": "428f4282-e390-304f-be4c-6c495c4a618e",
                                "text": "Le bilan radiatif de la Terre dresse la quantité d'énergie reçue par le système climatique Terre-atmosphère et la quantité d'énergie réémise vers l'espace."
                            },
                            {
                                "example_id": "5a5a1dca-fedb-42db-9343-01ef22591110",
                                "sense_id": "428f4282-e390-304f-be4c-6c495c4a618e",
                                "text": "Les organismes primitifs convertissent l'énergie radiative du Soleil en une énergie biologique utilisable grâce au processus de la photosynthèse."
                            }
                        ]
                    }
                ],
