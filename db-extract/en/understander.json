                        "sense_id": "85c64cde-f267-3a29-941e-d4756cc56546",
                        "entry_id": "9fea845d-2d9e-39d7-9553-e791d924e603",
                        "glosses": [
                            "One who understands something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91698b6b-37bf-4327-95de-33cfa0078706",
                                "sense_id": "85c64cde-f267-3a29-941e-d4756cc56546",
                                "text": "I am not a speed reader, I am a speed understander."
                            },
                            {
                                "example_id": "9818f607-6a13-488c-9368-b44b473cb177",
                                "sense_id": "85c64cde-f267-3a29-941e-d4756cc56546",
                                "text": "\"You knew Mr. Kampf intimately?\"\n\"Yes, I guess so.\" She smiled as one understander to another."
                            },
                            {
                                "example_id": "35ec0651-a46d-4c7c-9e23-7d5b675b7da5",
                                "sense_id": "85c64cde-f267-3a29-941e-d4756cc56546",
                                "text": "These are the people of the brain, after all, the understanders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39a6e1a3-df03-4e65-a5a6-2c9603ac5ddd",
                        "source_entry_id": "9fea845d-2d9e-39d7-9553-e791d924e603",
                        "source_sense_id": "85c64cde-f267-3a29-941e-d4756cc56546",
                        "source_sense_description": "one who understands",
                        "target_lang_word": "Versteher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versteher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56cffaa4-4fba-3173-a01b-97aec15a2a2a",
                                        "entry_id": "af141caf-4736-3ba8-814b-25fc5784861e",
                                        "glosses": [
                                            "Person, die jemanden oder etwas versteht; jemand, der sich verständnisvoll und/oder aufgeschlossen einem anderen gegenüber zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41166b3c-4077-4495-9610-3409bf241f16",
                                                "sense_id": "56cffaa4-4fba-3173-a01b-97aec15a2a2a",
                                                "text": "„Aber wie ich bereits sagte, steuert unsere Herrschaft als alleinige Versteher des Kosmos rasant ihrem Ende zu.“"
                                            },
                                            {
                                                "example_id": "7eb577e5-7a38-46ff-8705-c23f534bacd9",
                                                "sense_id": "56cffaa4-4fba-3173-a01b-97aec15a2a2a",
                                                "text": "„So wie das Werk vorliegt, konnte es heute nur in München entstehen, der Stadt, die vielleicht nicht die größten Einzelkünstler, aber die universellsten Versteher und wohl auch das höchste Niveau besitzt.“"
                                            },
                                            {
                                                "example_id": "bc7e1335-204d-4eab-8588-06774861177d",
                                                "sense_id": "56cffaa4-4fba-3173-a01b-97aec15a2a2a",
                                                "text": "„In der Innenpolitik sollte der Bundespräsident nicht nur Mahner sein, sondern auch Versteher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
