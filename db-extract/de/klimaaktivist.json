                "senses": [
                    {
                        "sense_id": "d00866b4-0729-3c9c-964e-417012a045fe",
                        "entry_id": "d62ec5b1-9e7e-30cb-b31a-14034d486fd0",
                        "glosses": [
                            "climate activist"
                        ],
