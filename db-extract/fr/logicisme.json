                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf5b74a0-89d5-4c9c-a7b2-ef7c69d488c3",
                                "sense_id": "3b3c6f52-eb68-389e-92a6-deb22464f086",
                                "text": "La psychologie et la sociologie ont […] abusé du logicisme."
