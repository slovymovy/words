                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b3c6dc4-e1b9-4040-bc17-e241ac844ad1",
                        "source_entry_id": "c0204117-e539-30d9-b0e3-cee163b49240",
                        "source_sense_id": "4b9f4a56-c367-3c08-bb9b-01837b6de5f1",
                        "source_sense_description": "of, relating to, or following a curriculum",
                        "target_lang_word": "curriculaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curriculaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c5d6407-87e6-3948-973a-5349237b5a82",
                                        "entry_id": "2882e1e6-c7db-3671-aaf7-6332ed202b8e",
                                        "glosses": [
                                            "Relatif au curriculum (cursus scolaire), à l’ensemble des pratiques éducatives."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffa181b-c1b3-4ad7-b105-b5426ee6814b",
                                                "sense_id": "9c5d6407-87e6-3948-973a-5349237b5a82",
                                                "text": "La logique curriculaire va dans le bon sens mais son nom sonne comme un affreux barbarisme."
                                            },
                                            {
                                                "example_id": "1f3a7fc7-1698-4171-a929-8cbd3b09be6d",
                                                "sense_id": "9c5d6407-87e6-3948-973a-5349237b5a82",
                                                "text": "Il est apparu depuis quelque temps dans le jargon pédagogique une expression qui fait florès avec la « refondation » de l’Ecole : la démarche « curriculaire ». Que signifie au juste cette formule ?"
                                            },
                                            {
                                                "example_id": "6bbd7dc2-1900-414d-ab48-d87f7dfd4682",
                                                "sense_id": "9c5d6407-87e6-3948-973a-5349237b5a82",
                                                "text": "En salle de classe, ce n'est plus la logique curriculaire qui opère, mais bien la logique de l'apprentissage. Les programmes d'études sont des outils pour l'enseignant."
                                            },
                                            {
                                                "example_id": "51a78afb-7a95-4a68-b148-9fe1bec3b0ad",
                                                "sense_id": "9c5d6407-87e6-3948-973a-5349237b5a82",
                                                "text": "Les stratégies scolaires d'ECD/EDH sont variées, couvrant à la fois le contenu et les approches curriculaires ainsi que les pratiques au sein de l’environnement scolaire considéré dans sa globalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef9af32d-10ea-44bc-a803-fea08a9af5ef",
                        "source_entry_id": "c0204117-e539-30d9-b0e3-cee163b49240",
                        "source_sense_id": "4b9f4a56-c367-3c08-bb9b-01837b6de5f1",
                        "source_sense_description": "of, relating to, or following a curriculum",
                        "target_lang_word": "curricular",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curricular",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae88449-b841-3f7d-8cc4-05f406c89d48",
                                        "entry_id": "9f2af53e-404f-36c5-b289-4bf06adb8c58",
                                        "glosses": [
                                            "das Curriculum/den Lehrplan betreffend, am Curriculum/Lehrplan orientiert"
                                        ],
                                        "tags": [
                                            "Pädagogik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f857ccde-5afb-4926-8389-61c8385f4e7f",
                                                "sense_id": "3ae88449-b841-3f7d-8cc4-05f406c89d48",
                                                "text": "„Vor der Einschulung gibt es in Deutschland keine curricularen Angebote, die kleinere Kinder nutzen könnten.“"
                                            },
                                            {
                                                "example_id": "1d79dbfc-dc92-41c8-9800-b7b9be3e6108",
                                                "sense_id": "3ae88449-b841-3f7d-8cc4-05f406c89d48",
                                                "text": "„Es ist grundsätzlich ein guter Gedanke, dass man über Engagement, das erst mal nicht zu den curricularen Lernzielen des eigenen Studiums gehört, Kompetenzen erwirbt, die sich im Studium anwenden lassen“"
                                            },
                                            {
                                                "example_id": "9675be83-573f-4022-b1bd-d049d5a9176a",
                                                "sense_id": "3ae88449-b841-3f7d-8cc4-05f406c89d48",
                                                "text": "„Merksätze kondensieren und portionieren das curricular gefilterte Wissen.“"
                                            },
                                            {
                                                "example_id": "aada5416-2b4d-492b-a406-55f741d8a2cd",
                                                "sense_id": "3ae88449-b841-3f7d-8cc4-05f406c89d48",
                                                "text": "„Die Handreichung ‚Curriculare Grundlagen – Deutsch als Zweitsprache’ richtet sich an alle Lehrkräfte, die im schulischen Kontext insbesondere mit neu zugewanderten Schülerinnen und Schülern arbeiten.“"
                                            },
                                            {
                                                "example_id": "85966acb-902a-4d56-9d1c-51dd32b2874c",
                                                "sense_id": "3ae88449-b841-3f7d-8cc4-05f406c89d48",
                                                "text": "„Insgesamt deklarieren folgende, aus der Lebenswirklichkeit erwachsende Erfordernisse das interdisziplinäre Unterrichtsprinzip, ergänzend zum disziplinären, zu einem unverzichtbaren Ingredienz moderner curricularer Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
