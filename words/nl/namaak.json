{
    "word_family": [
        "namaken",
        "maker",
        "maaksel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c83ea84a-18b1-32f2-b1b3-9e1b595c5bed",
                    "sense_definition": "Iets wat nagemaakt is om op het origineel te lijken, vaak van mindere kwaliteit of illegaal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "imitatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze tas ziet er echt uit, maar het is gewoon goedkope <w>namaak</w>.",
                            "target_lang_translations": {
                                "en": "This bag looks real, but it is just a cheap <w>imitation</w>."
                            }
                        },
                        {
                            "text": "De politie nam een grote partij <w>namaak</w> van bekende merken in beslag.",
                            "target_lang_translations": {
                                "en": "The police seized a large batch of <w>counterfeits</w> of well-known brands."
                            }
                        }
                    ],
                    "synonyms": [
                        "nepper"
                    ],
                    "antonyms": [
                        "origineel"
                    ],
                    "common_phrases": [
                        "goedkope namaak",
                        "namaak van merken"
                    ],
                    "target_lang_definitions": {
                        "en": "Something made to look like the original, often of lower quality or illegal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imitation",
                                "target_lang_sense_clarification": "a copy or simulation of the real thing"
                            },
                            {
                                "target_lang_word": "fake",
                                "target_lang_sense_clarification": "not genuine; a forgery or counterfeit"
                            },
                            {
                                "target_lang_word": "counterfeit",
                                "target_lang_sense_clarification": "an illegal copy of something, like money or branded goods"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f3d597a-1364-3e46-8e64-c123abb2b257",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>namaken</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik weet niet of ik dit schilderij goed <w>namaak</w>.",
                            "target_lang_translations": {
                                "en": "I don't know if I am <w>copying</w> this painting well."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat ik de handtekening precies <w>namaak</w>.",
                            "target_lang_translations": {
                                "en": "It is important that I <w>imitate</w> the signature exactly."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of the verb 'namaken' (to imitate, copy, or reproduce)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imitate",
                                "target_lang_sense_clarification": "to copy the appearance or behavior of something"
                            },
                            {
                                "target_lang_word": "copy",
                                "target_lang_sense_clarification": "to make a reproduction of something"
                            },
                            {
                                "target_lang_word": "reproduce",
                                "target_lang_sense_clarification": "to create a copy or duplicate of an original"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}