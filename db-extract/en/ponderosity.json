                        "entry_id": "7e7b3545-8954-3d8b-8894-d3c30c69f5d8",
                        "glosses": [
                            "The quality of requiring extensive thought."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0e2cc5f-22ed-40b0-9309-98b314a64a3e",
                                "sense_id": "3ef2dcd9-4545-39e1-9d8d-5f1b89e424dc",
                                "text": "The ponderosity of her qualifications for nobility was sometimes too much even for her mother, and her devotion to peerage was such, that she would certainly have declined a seat in heaven if offered to her without the promise that it should be in the upper house"
                            }
                        ]
                    },
                    {
                        "sense_id": "b916bd74-bef8-33b1-8ad8-c28d52c8b1eb",
                        "entry_id": "7e7b3545-8954-3d8b-8894-d3c30c69f5d8",
                        "glosses": [
                            "Weight; heaviness."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8d191615-a681-4ae4-86b8-f88db8d5c857",
                                "sense_id": "b916bd74-bef8-33b1-8ad8-c28d52c8b1eb",
                                "text": "Again, whereas men affirm they perceive an addition of ponderosity in dead bodies, comparing them usually unto blocks and stones, whensoever they lift or carry them; this accessional preponderancy is rather in appearance than reality."
                            }
                        ]
                    }
