                {
                    "sense_id": "995667a7-b8ee-3fa0-8a42-96ba5854483b",
                    "sense_definition": "dać komuś łapówkę w zamian za przychylność lub nieuczciwe działanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "korupcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Próbowali <w>przekupić</w> urzędnika, aby szybciej wydał decyzję budowlaną.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>подкупить</w> чиновника, чтобы он быстрее выдал разрешение на строительство."
                            }
                        },
                        {
                            "text": "Nie da się <w>przekupić</w> uczciwego sędziego żadnymi pieniędzmi.",
                            "target_lang_translations": {
                                "ru": "Честного судью невозможно <w>подкупить</w> никакими деньгами."
                            }
                        }
                    ],
                    "synonyms": [
                        "skorumpować"
                    ],
                    "common_phrases": [
