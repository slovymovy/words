{
    "word_family": [
        "Tatsache",
        "Tatsachenbericht"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5af45aa7-a9fe-30c1-aeb5-cb4081924504",
                    "sense_definition": "in der Realität, der Wirklichkeit entsprechend; drückt Bestätigung oder Überraschung aus",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "realitaet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Zug ist heute <w>tatsächlich</w> pünktlich am Bahnhof angekommen."
                        },
                        {
                            "text": "Ich habe lange gezweifelt, aber er hat die Prüfung <w>tatsächlich</w> bestanden."
                        }
                    ],
                    "synonyms": [
                        "in der Tat",
                        "faktisch",
                        "ungelogen"
                    ],
                    "common_phrases": [
                        "etwas tatsächlich tun",
                        "tatsächlich wahr sein"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e049195-dce7-31a0-9718-4ddbdcc00379",
                    "sense_definition": "den Tatsachen entsprechend; in Wirklichkeit bestehend und nicht nur erdacht",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "realitaet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>tatsächlichen</w> Kosten für das Bauprojekt waren viel höher als geplant."
                        },
                        {
                            "text": "Es gab bisher keinen Beweis für eine <w>tatsächliche</w> Veränderung der Situation."
                        }
                    ],
                    "synonyms": [
                        "faktisch",
                        "wahrheitsgemäß"
                    ],
                    "antonyms": [
                        "fiktiv"
                    ],
                    "common_phrases": [
                        "die tatsächlichen Kosten",
                        "eine tatsächliche Gefahr"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "21455947-d0a8-3154-97a0-7c49c2679400",
                    "sense_definition": "Ausruf des Erstaunens oder Zweifels im Sinne von „wirklich?“",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ausruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "«<w>Tatsächlich</w>?», fragte sie erstaunt, als sie die unerwartete Nachricht hörte."
                        },
                        {
                            "text": "Er rief ungläubig «<w>Tatsächlich</w>!», nachdem er das Wahlergebnis im Fernsehen gesehen hatte."
                        }
                    ]
                }
            ]
        }
    ]
}