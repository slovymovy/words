                        "glosses": [
                            "Personne qui rame (dans l’eau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "689646ab-f637-4754-a19a-797a1cafe26e",
                                "sense_id": "9ad96bf5-22cd-31f5-919c-9a4258363665",
                                "text": "Un rameur remonte une rivière."
                            },
                            {
                                "example_id": "1ff3583d-e95e-4817-a6d4-d0f1f20d0b2a",
                                "sense_id": "9ad96bf5-22cd-31f5-919c-9a4258363665",
                                "text": "Un banc de rameurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "772c3335-e9ee-3c37-a2ba-f4c1f4bf7a35",
                        "entry_id": "92b4287c-3d21-3d25-bee7-f0208f72e5e5",
                        "glosses": [
                            "Nom donné à des insectes de la famille des gerridae, car ceux-ci se déplacent à la surface de l'eau comme s'ils ramaient."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f864ae20-1ee0-4f02-beea-8b7f8b2ab122",
                        "source_entry_id": "92b4287c-3d21-3d25-bee7-f0208f72e5e5",
                        "target_lang_word": "Ruderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                        "entry_id": "f62180b1-ae08-34a6-abca-4f8b819bd5f3",
                                        "glosses": [
                                            "Person, die ein Boot rudert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd013090-ccdf-4302-9384-cf06d37b95e6",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Auf die gleiche Weise werden die Sitzbalken für die Ruderer eingezogen und fixiert.“"
                                            },
                                            {
                                                "example_id": "5f7ffacd-d77c-4888-8d1c-ed30d5b48c1d",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Die Ruderer schafften stromabwärts vier Meilen pro Stunde und stromaufwärts die Hälfte.“"
                                            },
                                            {
                                                "example_id": "d3a182af-baee-4221-b5e7-2b736a2ef4ce",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Ich verließ Korfu bei Einbruch der Nacht und kam am frühen Morgen in Otranto an, ohne daß meine Ruderer auch nur einmal ihre Ruder eintauchten.“"
                                            },
                                            {
                                                "example_id": "7d2ed0e2-b499-46b0-97f0-8f8683174505",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Sein Offizier wandte sich nun zu den Ruderern, die noch im Boote saßen, und erteilte ihnen die ihm zugekommenen Orders.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87a251bc-bd1d-4ee2-a97b-f28a9366fe47",
                        "source_entry_id": "92b4287c-3d21-3d25-bee7-f0208f72e5e5",
