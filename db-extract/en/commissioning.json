                        "sense_id": "5b3068e9-aace-3e5c-9743-a9bb421c603d",
                        "entry_id": "5bfb7db7-2ad2-3c69-ad91-c1dde796f6f2",
                        "glosses": [
                            "The process of assuring that all systems and components of a major piece of equipment, a process, a building or similar are designed, installed and tested according to the operational requirements of the owner or final client."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9872c059-f27a-48e2-abd4-f4684a8aebe7",
                                "sense_id": "5b3068e9-aace-3e5c-9743-a9bb421c603d",
                                "text": "The destroyer's commissioning will be held on February 1st."
                            },
                            {
                                "example_id": "4792e8e6-669d-4d39-a171-0ab465344153",
                                "sense_id": "5b3068e9-aace-3e5c-9743-a9bb421c603d",
                                "text": "It was taken out of passenger service in early 2013, for conversion into a test bed for the commissioning of the European Rail Traffic Management System (ERTMS) on the Hertford Loop and elsewhere."
                            }
                        ]
                    }
                ],
                "translations": [
