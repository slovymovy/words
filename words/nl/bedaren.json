{
    "word_family": [
        "bedaard",
        "bedaring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c887f3a8-6153-3684-b006-fd7d17d84fd7",
                    "sense_definition": "weer rustig of kalm worden na een periode van drukte, emotie of geweld",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kalmte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de hevige ruzie begon de sfeer in de kamer eindelijk te <w>bedaren</w>.",
                            "target_lang_translations": {
                                "en": "After the heavy argument, the atmosphere in the room finally began to <w>calm down</w>."
                            }
                        },
                        {
                            "text": "De storm zal vannacht waarschijnlijk <w>bedaren</w> zodat de schepen weer kunnen varen.",
                            "target_lang_translations": {
                                "en": "The storm will likely <w>subside</w> tonight so that the ships can sail again."
                            }
                        }
                    ],
                    "synonyms": [
                        "kalmeren"
                    ],
                    "antonyms": [
                        "opwinden",
                        "escaleren"
                    ],
                    "common_phrases": [
                        "de storm laat bedaren",
                        "de gemoederen bedaren"
                    ],
                    "target_lang_definitions": {
                        "en": "to become quiet or calm again after a period of activity, emotion, or violence"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "calm down",
                                "target_lang_sense_clarification": "to become less excited or angry"
                            },
                            {
                                "target_lang_word": "subside",
                                "target_lang_sense_clarification": "of a storm or intense situation"
                            },
                            {
                                "target_lang_word": "die down",
                                "target_lang_sense_clarification": "to gradually decrease in intensity"
                            },
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "to become stable or calm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40019bc6-4234-34a9-a706-19d2d9446270",
                    "sense_definition": "iemand of iets die onrustig is weer rustig maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kalmte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De moeder probeerde haar huilende baby te <w>bedaren</w> met een zacht liedje.",
                            "target_lang_translations": {
                                "en": "The mother tried to <w>soothe</w> her crying baby with a soft song."
                            }
                        },
                        {
                            "text": "Het was moeilijk om de woedende menigte te <w>bedaren</w> na het slechte nieuws.",
                            "target_lang_translations": {
                                "en": "It was difficult to <w>pacify</w> the angry crowd after the bad news."
                            }
                        }
                    ],
                    "synonyms": [
                        "kalmeren",
                        "zinnigen"
                    ],
                    "antonyms": [
                        "opruien",
                        "prikkelen"
                    ],
                    "common_phrases": [
                        "een kind bedaren",
                        "de menigte bedaren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make someone or something that is restless or agitated calm again"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "calm",
                                "target_lang_sense_clarification": "to make someone peaceful or quiet"
                            },
                            {
                                "target_lang_word": "soothe",
                                "target_lang_sense_clarification": "to gently calm a person or feelings"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "to cause someone to become still or silent"
                            },
                            {
                                "target_lang_word": "pacify",
                                "target_lang_sense_clarification": "to quell the anger or agitation of a group"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3383d5b3-41bd-31df-8343-d9719e09e12d",
                    "sense_definition": "een toestand van rust of kalmte",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kalmte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met zijn vaderlijk gezag wist hij de jongens tot <w>bedaren</w> te brengen.",
                            "target_lang_translations": {
                                "en": "With his fatherly authority, he managed to <w>calm</w> the boys down."
                            }
                        },
                        {
                            "text": "Het duurde lang voordat de gemoederen weer tot <w>bedaren</w> kwamen.",
                            "target_lang_translations": {
                                "en": "It took a long time before tempers <w>cooled down</w> again."
                            }
                        }
                    ],
                    "synonyms": [
                        "kalmeren",
                        "zinnigen"
                    ],
                    "antonyms": [
                        "onrust"
                    ],
                    "common_phrases": [
                        "tot bedaren brengen",
                        "tot bedaren komen"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of rest, peace, or calmness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "calm",
                                "target_lang_sense_clarification": "the state of being peaceful"
                            },
                            {
                                "target_lang_word": "composure",
                                "target_lang_sense_clarification": "the state of being in control of one's emotions"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "absence of disturbance or noise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}