            "senses": [
                {
                    "sense_id": "814ac94c-07f3-3486-9350-f55117598c8d",
                    "sense_definition": "Prendre fin, s'interrompre ou faire arrêter une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie a enfin <w>cessé</w> de tomber après plusieurs heures de violent orage.",
                            "target_lang_translations": {
                                "en": "The rain has finally <w>stopped</w> falling after several hours of a violent thunderstorm.",
                                "ru": "Дождь наконец <w>прекратился</w> после нескольких часов сильной грозы.",
                                "nl": "Na verscheidene uren van hevig onweer is de regen eindelijk <w>opgehouden</w>.",
                                "de": "Nach mehreren Stunden heftigen Gewitters hat der Regen endlich <w>aufgehört</w>.",
                                "pl": "Deszcz w końcu <w>przestał</w> padać po kilku godzinach silnej burzy.",
                                "it": "La pioggia ha finalmente <w>smesso</w> di cadere dopo diverse ore di violento temporale.",
                                "cs": "Po několika hodinách silné bouřky konečně <w>přestalo</w> pršet.",
                                "tr": "Birkaç saat süren şiddetli bir fırtınanın ardından yağmur sonunda <w>dindi</w>.",
                                "es": "Por fin <w>paró</w> de llover tras varias horas de violenta tormenta.",
                                "zh": "经过好几个小时的猛烈暴风雨，雨终于<w>停止</w>下来了。"
                            }
                        },
                        {
                            "text": "Il a décidé de <w>cesser</w> de fumer pour préserver sa santé.",
                            "target_lang_translations": {
                                "en": "He decided to <w>stop</w> smoking to protect his health.",
                                "ru": "Он решил <w>бросить</w> курить, чтобы сохранить здоровье.",
                                "nl": "Hij heeft besloten te <w>stoppen</w> met roken om zijn gezondheid te beschermen.",
                                "de": "Er hat beschlossen, mit dem Rauchen <w>aufzuhören</w>, um seine Gesundheit zu schützen.",
                                "pl": "Postanowił <w>rzucić</w> palenie, aby zachować zdrowie.",
                                "it": "Ha deciso di <w>smettere</w> di fumare per proteggere la sua salute.",
                                "cs": "Rozhodl se <w>přestat</w> kouřit, aby chránil své zdraví.",
                                "tr": "Sağlığını korumak için sigarayı <w>bırakmaya</w> karar verdi.",
                                "es": "Decidió <w>dejar</w> de fumar para proteger su salud.",
                                "zh": "为了保护自己的健康，他决定<w>停止</w>抽烟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrêter",
                        "finir",
                        "interrompre",
                        "terminer"
                    ],
                    "antonyms": [
                        "continuer"
                    ],
                    "common_phrases": [
                        "cesser de fumer",
                        "cesser le combat"
                    ],
                    "target_lang_definitions": {
                        "en": "To come to an end, or to bring an action or process to a stop.",
                        "ru": "Переставать что-либо делать или заставлять какое-либо действие заканчиваться.",
                        "nl": "Een handeling beëindigen of ermee ophouden.",
                        "de": "Eine Tätigkeit oder einen Vorgang beenden oder anhalten.",
                        "pl": "Przestawać coś robić lub doprowadzać do zakończenia jakiejś czynności.",
                        "it": "Smettere di fare qualcosa o far terminare un'azione o un processo.",
                        "cs": "Přestat s něčím nebo nechat děj, činnost či proces skončit.",
                        "tr": "Bir eylem ya da olay sona erer veya durdurulur; alışkanlıktan vazgeçmek anlamında da kullanılır.",
                        "es": "Llegar a su fin o interrumpir una acción, de modo que deje de producirse.",
                        "zh": "结束某件事，或使正在进行的行为中止。"
                    },
