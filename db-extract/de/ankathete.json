                        "sense_id": "1dac4d53-f8dc-3b12-9078-0496c9834938",
                        "entry_id": "ca348db3-face-3568-8fbb-b8f389f71b62",
                        "glosses": [
                            "diejenige Seite des Dreiecks, die zusammen mit der Hypotenuse diesen Winkel bildet"
                        ],
                        "tags": [
                            "in Bezug auf einen der beiden spitzen Winkel in einem rechtwinkligen Dreieck"
                        ],
                        "examples": [
                            {
                                "example_id": "dccd1b44-7340-410e-a5cd-136a22f17535",
                                "sense_id": "1dac4d53-f8dc-3b12-9078-0496c9834938",
                                "text": "„Der Sinus von Alpha (Alpha ist der Winkel zwischen Ankathete und Hypotenuse) ist das Verhältnis von der Gegenkathete (die Kathete, die nicht an Alpha grenzt) zur Hypotenuse.“"
                            }
                        ],
