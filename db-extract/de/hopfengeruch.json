                "senses": [
                    {
                        "sense_id": "40600418-875f-3d15-a0cb-bf7061d57325",
                        "entry_id": "41552240-1685-3506-b563-74511fbc477f",
                        "glosses": [
                            "Geruch, der von weiblichen Hopfenpflanzen und deren Hopfendolden/Hopfenzapfen stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d31d84-f8a7-4348-8adb-2f1a35869021",
                                "sense_id": "40600418-875f-3d15-a0cb-bf7061d57325",
                                "text": "„Der frische Hopfengeruch, begleitet von einem Hauch Sommerwiese, verspricht eine frisch-aromatische,wohlig weiche Bierköstlichkeit.“"
                            },
                            {
                                "example_id": "034aae3c-ca47-48ea-8f8b-a37a4f41d997",
                                "sense_id": "40600418-875f-3d15-a0cb-bf7061d57325",
                                "text": "„Die Drüsenschuppen der Deckblätter und Blüten des Hopfenzapfens enthalten ätherische Öle, die den bekannten würzigen Hopfengeruch verbreiten.“"
                            },
                            {
                                "example_id": "3fc9bb14-36ff-4c04-9637-8866b893d9d9",
                                "sense_id": "40600418-875f-3d15-a0cb-bf7061d57325",
                                "text": "„Der Hopfengeruch und -geschmack waren zu intensiv.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
