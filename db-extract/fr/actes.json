                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cc08f052-0625-38c3-beb8-4723f0b46ae9",
                        "entry_id": "5ab8dbc4-8836-3279-83bd-e8496bb561b4",
                        "glosses": [
                            "Actes des Apôtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72289ed2-599d-4eec-854f-2851708cc5aa",
                                "sense_id": "cc08f052-0625-38c3-beb8-4723f0b46ae9",
                                "text": "Les Actes sont la première histoire du christianisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e4de008-ebf6-390a-8895-143edb4d6aab",
                        "entry_id": "5ab8dbc4-8836-3279-83bd-e8496bb561b4",
                        "glosses": [
                            "Ensemble de prières catholiques d'une phrase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0518223f-4164-4068-8623-a6cfcc7ce579",
                                "sense_id": "9e4de008-ebf6-390a-8895-143edb4d6aab",
                                "text": "La mère Chapdelaine priait à haute voix, très vite, et les deux autres voix lui répondaient ensemble en un murmure indistinct. Cinq Pater, cinq Ave, les Actes, puis les longues litanies pareilles à une mélopée."
                            }
                        ]
                    }
