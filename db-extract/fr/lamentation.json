        "fr-extract.jsonl": [
            {
                "entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
                "word": "lamentation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4f869ff9-029d-444c-bfb6-3ccf166d0bae",
                        "entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "lamentations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04841860-7f74-3f9c-b330-f13f9b37b350",
                        "entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
                        "glosses": [
                            "Plainte accompagnée de gémissements et de cris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4079d4a5-aa32-4cac-abec-3d147a4ee226",
                                "sense_id": "04841860-7f74-3f9c-b330-f13f9b37b350",
                                "text": "Et bien des fois, descendu dans la nuit des géhennes sociales, j’ai porté aux moribonds la résignation, l’espérance aux désespérés ; bien des fois j’ai changé en cris de joie les lamentations farouches de ces damnés."
                            },
                            {
                                "example_id": "78d85d82-6948-4759-9888-24df15c0d850",
                                "sense_id": "04841860-7f74-3f9c-b330-f13f9b37b350",
                                "text": "…et, au milieu du silence troublé par le seul bruissement de la brise hivernale, je crus effectivement entendre de longues plaintes qui me semblaient n'être pas seulement la lamentation du vent."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f34a34e-e4b7-3897-ab8f-af2a24268d0a",
                        "entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
                        "glosses": [
                            "Expression de douleur et de regret."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b8f346-09bc-4916-9de6-28c71cc6cba3",
                                "sense_id": "6f34a34e-e4b7-3897-ab8f-af2a24268d0a",
                                "text": "Sa visite fut une longue lamentation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea65a7b5-a865-4bf2-a81f-b75a298ea381",
                        "source_entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
                        "target_lang_word": "Klage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41db4b0b-2b49-3bf8-83c5-14527688731a",
                                        "entry_id": "c1a4ae40-345c-3972-a3b8-b733efa60b9e",
                                        "glosses": [
                                            "sprachlich gefasste Äußerung unlustvoller Gefühle von Schmerz, Leid oder Trauer, etwa über den Tod eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "139a3891-7f03-4dd4-a23f-f23c91062f0e",
                                                "sense_id": "41db4b0b-2b49-3bf8-83c5-14527688731a",
                                                "text": "Die Klagen der trauernden Frauen waren weithin hörbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af490894-092b-398e-bd1e-41bd387c3919",
                                        "entry_id": "c1a4ae40-345c-3972-a3b8-b733efa60b9e",
                                        "glosses": [
                                            "sprachlich gefasste Äußerung unlustvoller Gefühle von Enttäuschung, Unzufriedenheit, Ärger oder Ressentiment, mit Implikationen von Kritik oder Schelte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f97aee-457f-4daa-8a09-08656b0de187",
                                                "sense_id": "af490894-092b-398e-bd1e-41bd387c3919",
                                                "text": "Die Schüler sollten sich mit ihren Klagen über das Kantinenessen direkt an die Schulleitung wenden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "afde138b-d542-37ee-b887-e263f473aea4",
                                        "entry_id": "c1a4ae40-345c-3972-a3b8-b733efa60b9e",
                                        "glosses": [
                                            "ein Antrag an ein Gericht, über einen Rechtsstreit zu entscheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c619e775-fee9-473e-892b-37c8d0f5c236",
                                                "sense_id": "afde138b-d542-37ee-b887-e263f473aea4",
                                                "text": "Dagegen muss Klage erhoben werden."
                                            },
                                            {
                                                "example_id": "00e38e07-d032-4e47-92a9-cc8b460ce8f9",
                                                "sense_id": "afde138b-d542-37ee-b887-e263f473aea4",
                                                "text": "„Deshalb haben die vier Fahnder jetzt Klage gegen Gutachter H. eingereicht und auch seinem Auftraggeber, dem Land Hessen, den Streit erklärt.“"
                                            },
                                            {
                                                "example_id": "c5a33983-61e9-4449-b671-27ac6fbae620",
                                                "sense_id": "afde138b-d542-37ee-b887-e263f473aea4",
                                                "text": "„Sylvia kehrte in das Hinterzimmer ihres eigenen Ladens zurück und verfasste mit einem Stift, der mit jedem Wort leichter wurde, einen Antwortbrief an Roth und seinen Anwalt, in dem sie erklärte, dass sie die Klage fallen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "78915c3f-c07c-3004-ae6d-5b429a23e840",
                                        "entry_id": "c1a4ae40-345c-3972-a3b8-b733efa60b9e",
                                        "glosses": [
                                            "bestimmte Formen der Dichtung, in deren Mittelpunkt eine Klage ([1]) steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e34f4835-00b2-46bc-a75c-e47fbd00c5b8",
                                                "sense_id": "78915c3f-c07c-3004-ae6d-5b429a23e840",
                                                "text": "Die Klage des Sumerischen Hiob gilt als ältester Beleg für das Klagelied eines einzelnen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ce564db-5875-4de7-964b-bcc8c7d0cde5",
                        "source_entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
