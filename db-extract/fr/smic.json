                    },
                    {
                        "form_id": "d35e2749-c39f-491a-aeed-452a38be1cb1",
                        "entry_id": "0a348c48-eb91-31ce-a2a2-c5733ce59da5",
                        "tags": [],
                        "form": "smic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72991ec5-9788-3857-ab04-04de2c6124ef",
                        "entry_id": "0a348c48-eb91-31ce-a2a2-c5733ce59da5",
                        "glosses": [
                            "Salaire horaire fixé par la loi et en dessous duquel théoriquement personne ne doit être payé."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "a9ec23a4-c120-4098-bdea-3c0f5d01492b",
                                "sense_id": "72991ec5-9788-3857-ab04-04de2c6124ef",
                                "text": "Je suis au SMIC, juste de quoi payer le loyer et la bouffe ! - Le SMIC est passé à 8,44 € le premier juillet 2007, une fortune !"
                            },
                            {
                                "example_id": "e102546d-4b94-4501-a1bb-05741d2bd7de",
                                "sense_id": "72991ec5-9788-3857-ab04-04de2c6124ef",
                                "text": "Il faudra qu’un jour on leur explique ce détail : si un jeune de niveau Bac+4 est contraint d’accepter un emploi payé à peine plus que le SMIC pour pouvoir se loger et manger (et ils sont nombreux dans ce cas), aucun employeur n’acceptera plus de payer un autre jeune au prix normal du marché."
                            }
                        ]
                    },
                    {
                        "sense_id": "c82e0cf5-0c0f-3c14-9e66-facddbc03f59",
                        "entry_id": "0a348c48-eb91-31ce-a2a2-c5733ce59da5",
                        "glosses": [
                            "Montant mensuel correspondant à ce salaire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2eacae15-af2f-4937-82cb-55753f8b206d",
                                "sense_id": "c82e0cf5-0c0f-3c14-9e66-facddbc03f59",
                                "text": "Avant la mise en place du paquet fiscal, la limite de l’exonération d’impôts concernant les salaires des étudiants était à hauteur de 2 SMIC acquis pendant les vacances d’été."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7d0c6145-5198-3659-af7f-483e29de9953",
                "word": "smic",
