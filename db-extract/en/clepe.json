                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a0a29ba8-0faf-3521-9c43-4c5e69618ae6",
                        "entry_id": "adbb5068-70dd-3e48-b559-01efb368d4d7",
                        "glosses": [
                            "To call; call upon; cry out to."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7966b8d0-1d05-32a2-bc54-43ebb9948416",
                        "entry_id": "adbb5068-70dd-3e48-b559-01efb368d4d7",
                        "glosses": [
                            "To call to oneself; invite; summon."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2ed811e3-e965-393a-abe7-52748b6c53f0",
                        "entry_id": "adbb5068-70dd-3e48-b559-01efb368d4d7",
                        "glosses": [
                            "To call; call by the name of; name."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "802d3c32-4c04-4c91-82e4-b5f7206f490e",
                                "sense_id": "2ed811e3-e965-393a-abe7-52748b6c53f0",
                                "text": "She clepes him king of graues, & graue for kings, / Imperious ſupreme of all mortall things."
                            },
                            {
                                "example_id": "183756a2-af54-47c9-9926-722cdea2a436",
                                "sense_id": "2ed811e3-e965-393a-abe7-52748b6c53f0",
                                "text": "See Borneo's sea-girt shore where ever flow / the perfumed liquor's thick and curded gouts, / the tears of forest-trees men \"Camphor\" clepe, / wherefore that Island crop of Fame shall reap."
                            },
                            {
                                "example_id": "84d5a2c9-2976-41b7-a75e-61a31393fd83",
                                "sense_id": "2ed811e3-e965-393a-abe7-52748b6c53f0",
                                "text": "Boyden McNair, with his right elbow on his knee and his bent head resting on the hand which covered his eyes, sat near Wolfe's desk in the dunce's chair, yclept that by me on the day that District Attorney Anderson of Westchester sat in it while Wolfe made a dunce of him."
                            }
                        ]
                    },
                    {
                        "sense_id": "074878aa-99e5-3eaf-909d-4a5c54390613",
                        "entry_id": "adbb5068-70dd-3e48-b559-01efb368d4d7",
                        "glosses": [
                            "To tell lies about; inform against (someone)."
                        ],
                        "tags": [
                            "dialectal",
                            "intransitive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "b65bc51c-cc60-4d4d-b34a-ff224533eb05",
                                "sense_id": "074878aa-99e5-3eaf-909d-4a5c54390613",
                                "text": "You tried to mentor someone, teach them the basics of the trade, and they ran off to clype on you."
                            }
                        ]
                    },
                    {
                        "sense_id": "36a9c529-8094-33e5-8381-af2956c89ad6",
                        "entry_id": "adbb5068-70dd-3e48-b559-01efb368d4d7",
                        "glosses": [
                            "To be loquacious; tattle; gossip."
