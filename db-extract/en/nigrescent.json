                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccab069d-8da3-489c-a6c8-d7bc10312f71",
                                "sense_id": "79b5ebdd-f931-3b19-9da7-6591aa57e741",
                                "text": "At night the temperature is 250 degrees below zero; by day it is the heat of boiling water. Yet the sun is but an intense circle of white aloft in a nigrescent sky."
                            },
                            {
                                "example_id": "b9e28153-d3f7-4560-a9c9-c596366b6d64",
                                "sense_id": "79b5ebdd-f931-3b19-9da7-6591aa57e741",
                                "text": "Pomp of Words Moſt ſplendidly nigrescent"
                            },
                            {
                                "example_id": "da8dad1d-eab0-41e3-bdc4-f9a4f06e6212",
                                "sense_id": "79b5ebdd-f931-3b19-9da7-6591aa57e741",
                                "text": "[T]he dark death roses came into bloom. I cut them and carried them to Thecla, nigrescent purple flecked with scarlet."
