                        "glosses": [
                            "Taquiner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6dc0f5a-4271-4543-aa29-33fec49d01a2",
                                "sense_id": "33ad5dcd-36c3-3848-b06f-cb93cb64a4a6",
                                "text": "J’ai dû quitter le lycée en troisième classique (ce qui représente déjà six ans d’étude de latin et quatre de grec), me répondit le poète, et quand on a goûté aux langues mortes, on se plaît toujours, malgré soi, à les retaquiner."
                            },
                            {
                                "example_id": "f85dfcba-ff54-4bf0-bc39-465050b143f5",
                                "sense_id": "33ad5dcd-36c3-3848-b06f-cb93cb64a4a6",
                                "text": "Les pêcheurs fribourgeois pourront retaquiner la truite."
                            },
                            {
                                "example_id": "e5a71bb9-4baf-4873-a36b-8f10a7c51699",
                                "sense_id": "33ad5dcd-36c3-3848-b06f-cb93cb64a4a6",
                                "text": "L’occasion de retaquiner le goujon."
                            }
                        ]
                    }
