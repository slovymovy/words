                                "example_id": "75c5dc28-279b-4f3c-aaa3-2b51f89f7d83",
                                "sense_id": "5f83d9ea-2912-316f-9ee0-5c2182e1de06",
                                "text": "Viele Arten bilden den Farbstoff Fucoxanthin, ein Xanthophyll, der den Plastiden eine goldbraune bis braune Farbe verleiht."
                            },
                            {
                                "example_id": "ee123673-e128-430f-8268-cf114a5292c6",
                                "sense_id": "5f83d9ea-2912-316f-9ee0-5c2182e1de06",
                                "text": "Xanthophylle kommen in den Plastiden aller photosynthetisch aktiver Zellen von Pflanzen vor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
