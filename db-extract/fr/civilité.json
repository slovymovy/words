                                    {
                                        "sense_id": "6dd5b70f-32a7-33d5-936c-6def86f5ec0d",
                                        "entry_id": "102c78aa-60d0-3d65-80f1-a6305bbbad43",
                                        "glosses": [
                                            "belleefdheid, galanterie, vriendelijkheid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3edb60-e93d-48c3-8ba0-a22e7f5de26a",
                                                "sense_id": "6dd5b70f-32a7-33d5-936c-6def86f5ec0d",
                                                "text": "Hoffelijkheid en behulpzaamheid zijn belangrijke kenmerken van de etiquette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
