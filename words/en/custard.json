                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We were introduced to Mr. <w>Custard</w> at the community meeting yesterday.",
                            "target_lang_translations": {
                                "pl": "Wczoraj na spotkaniu społeczności przedstawiono nas panu <w>Custardowi</w>."
                            }
                        },
                        {
                            "text": "Several families with the surname <w>Custard</w> lived in the village during the nineteenth century.",
                            "target_lang_translations": {
                                "pl": "W XIX wieku w wiosce mieszkało kilka rodzin o nazwisku <w>Custard</w>."
                            }
                        }
