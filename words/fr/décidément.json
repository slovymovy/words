            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a9755e68-315b-360f-b078-3c3a394146a6",
                    "sense_definition": "En définitive, tout bien considéré ; confirme une impression ou un constat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "constat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs tentatives infructueuses, il n'y a <w>décidément</w> rien d'autre à faire pour régler ce problème."
                        },
                        {
                            "text": "<w>Décidément</w>, cette petite ville réserve de très belles surprises aux visiteurs de passage."
                        }
                    ],
                    "synonyms": [
                        "définitivement",
                        "manifestement"
                    ]
                },
                {
                    "sense_id": "65e94386-7daa-3623-8d9e-f769aa628339",
                    "sense_definition": "D'une manière décisive, indubitable ou absolument évidente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "évidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec cette nouvelle victoire éclatante, cet athlète est <w>décidément</w> le meilleur de sa génération."
                        },
                        {
                            "text": "Le deuxième tableau de cette exposition est <w>décidément</w> le plus réussi de toute la collection."
                        }
                    ],
                    "synonyms": [
                        "incontestablement",
                        "nettement"
                    ]
                },
                {
                    "sense_id": "7edc25ff-ed64-3c69-b154-a0504c24fa9a",
                    "sense_definition": "D'une manière ferme, résolue et sans hésitation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fermeté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux difficultés croissantes, elle a <w>décidément</w> choisi d'affronter la situation sans reculer."
                        },
                        {
                            "text": "Le directeur a <w>décidément</w> refusé toute négociation avec les représentants du syndicat."
                        }
                    ],
                    "synonyms": [
                        "fermement",
                        "résolument"
                    ],
                    "antonyms": [
                        "hésitamment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens vieilli"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e571bed8-6ed6-39fc-97ca-1ea345080a48",
                    "sense_definition": "Marque la surprise, l'agacement ou la résignation devant un fait récurrent ou contrariant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Décidément</w>, cette machine tombe en panne chaque fois que nous devons imprimer un document urgent."
                        },
                        {
                            "text": "Mais <w>décidément</w>, rien ne se passe jamais comme prévu dans cette organisation compliquée !"
                        }
                    ]
                }
            ]
        }
