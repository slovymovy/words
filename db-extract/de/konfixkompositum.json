                ],
                "senses": [
                    {
                        "sense_id": "19751805-9b86-3150-bebf-3c8ff980b6ee",
                        "entry_id": "36bd6bef-1dfa-3b18-993f-1779c235d8da",
                        "glosses": [
                            "Kompositum, an dem mindestens zwei Konfixe beteiligt sind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d4ec4d9-895f-4c8a-8328-ed29dafb62d5",
                                "sense_id": "19751805-9b86-3150-bebf-3c8ff980b6ee",
                                "text": "\"Biblio-thek\" ist ein Konfixkompositum aus den Konfixen \"biblio-\" und \"-thek\"."
                            },
                            {
                                "example_id": "316a756d-2dbf-4593-a236-db7e3a98332c",
                                "sense_id": "19751805-9b86-3150-bebf-3c8ff980b6ee",
                                "text": "„Wortbildungskonstruktionen mit Konstituenten, die im Deutschen nicht frei als Grundmorpheme vorkommen und auch nicht als Varianten wie unter 3) betrachtet werden können, sind Konfixkomposita.“"
                            },
                            {
                                "example_id": "5655d177-4f31-4632-a9ef-3adb2b4d1eda",
                                "sense_id": "19751805-9b86-3150-bebf-3c8ff980b6ee",
                                "text": "„Deutliche Besonderheiten zeigen dagegen die Konfixkomposita.“"
                            },
                            {
                                "example_id": "1bfdad85-6997-44f7-ab2e-33fd02deb225",
                                "sense_id": "19751805-9b86-3150-bebf-3c8ff980b6ee",
                                "text": "„Der dritte Typ von Konfixkompositum enthält Konfixe sowohl im Erst- als auch im Zweitglied, zum Beispiel Bibliothek.“"
                            },
                            {
                                "example_id": "6c12c870-8ebd-4276-a6eb-eceb7980da04",
                                "sense_id": "19751805-9b86-3150-bebf-3c8ff980b6ee",
                                "text": "„Im Vergleich zum nominalen Konfix-Kompositum nutzen Sprecherschreiber diese Möglichkeit allerdings eher selten.“"
                            },
                            {
                                "example_id": "9f484532-033c-4b1e-919e-aa810cdb966c",
                                "sense_id": "19751805-9b86-3150-bebf-3c8ff980b6ee",
                                "text": "„Im Gegensatz dazu kann die Struktur der im Lehnwortschatz so häufigen Konfixkomposita nicht auf diese Art und Weise verdeutlicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
