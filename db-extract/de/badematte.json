                "senses": [
                    {
                        "sense_id": "4e985b8b-c1d4-312f-84cb-43cff397537b",
                        "entry_id": "1cab6b0d-3234-31da-a36a-a64e35c26b3b",
                        "glosses": [
                            "Unterlage, die vor eine Badewanne oder Dusche gelegt wird, um das heruntertropfende Wasser nach dem Baden/Duschen aufzufangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bc99438-8fe9-4285-8ae4-4bbf1fa56538",
                                "sense_id": "4e985b8b-c1d4-312f-84cb-43cff397537b",
                                "text": "„Eine ebenerdige Dusche mit Haltegriffen und einem Duschhocker sind unheimlich wichtig, um problemlos ein- und auszusteigen und einen sicheren Halt beim Duschen zu gewährleisten. Zusätzlich sind Badematten auf dem Boden und in der Dusche eine sinnvolle Anschaffung.“"
                            },
                            {
                                "example_id": "fb09db11-dac7-4f8f-bbac-8a7231aa8008",
                                "sense_id": "4e985b8b-c1d4-312f-84cb-43cff397537b",
                                "text": "„Die Übertragung geschieht weltweit von Mensch zu Mensch und von Tier zu Mensch, auch über Bodenbeläge, Badematten u. Teppiche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
