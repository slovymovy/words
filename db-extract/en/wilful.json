                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8ed048c-bd29-400a-88c7-cc6a5ea7aa02",
                        "source_entry_id": "1b12e26a-dff1-38f5-9152-ee8248c761e9",
                        "source_sense_description": "stubborn",
                        "target_lang_word": "eigensinnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eigensinnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "418952ec-bdf3-37f3-8ca7-421823720305",
                                        "entry_id": "576d6776-9ae5-3780-bee3-35282c78b182",
                                        "glosses": [
                                            "gegen alle vernünftigen Vorstellungen beharrend, von Eigensinn bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90091a87-70ad-4e1a-ba20-6e67f02f17db",
                                                "sense_id": "418952ec-bdf3-37f3-8ca7-421823720305",
                                                "text": "Ungesellige Menschen sind gewöhnlich eigensinnig."
                                            },
                                            {
                                                "example_id": "c66e7b5c-b84f-4d57-9986-3cfce9d6abef",
                                                "sense_id": "418952ec-bdf3-37f3-8ca7-421823720305",
                                                "text": "„Der edle Mensch ist festen Sinnes, doch eigensinnig ist er nicht.“ (Konfuzius)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da167829-81cd-4523-a6f0-2fc336638c3b",
                        "source_entry_id": "1b12e26a-dff1-38f5-9152-ee8248c761e9",
                        "source_sense_description": "stubborn",
                        "target_lang_word": "упрямый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "упрямый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6339554e-408d-386d-9317-2e43db266421",
                                        "entry_id": "a681a601-90ef-3855-ad88-8522b7306f9e",
                                        "glosses": [
                                            "несговорчивый, неуступчивый, непременно желающий настоять на своём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b1f213-09ab-490f-9cfc-67ff6a83b186",
                                                "sense_id": "6339554e-408d-386d-9317-2e43db266421",
                                                "text": "Он чувствовал это, и это было справедливо: хитрый и упрямый шут, Фёдор Павлович, очень твёрдого характера «в некоторых вещах жизни», как он сам выражался, бывал, к собственному удивлению своему, весьма даже слабоват характером в некоторых других «вещах жизни»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f28e10-503d-37d3-9544-2f4ceb4b289f",
                                        "entry_id": "a681a601-90ef-3855-ad88-8522b7306f9e",
                                        "glosses": [
                                            "выражающий упрямство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd78673f-e17e-431f-8ce9-9d49d03c088d",
                                                "sense_id": "c5f28e10-503d-37d3-9544-2f4ceb4b289f",
                                                "text": "И, действительно, поделать с ребёнком ничего нельзя было: если он начинал капризничать, то вы могли терпеть, могли раздражаться, упрекать няньку, свою жену за то, что они распустили ребёнка так, что хоть беги из дому; могли, действительно, убегать, и, проносясь мимо окон детской, уже с улицы видеть всё тот же упрямый, но с каким-то напряжённым интересом провожающий вас взгляд, — лицо, всё с тем же открытым ртом, из которого в это мгновение несётся всё тот же надрывающий душу вой."
                                            },
                                            {
                                                "example_id": "9f33a88d-04c1-48d8-a004-cfbb532bfbbe",
                                                "sense_id": "c5f28e10-503d-37d3-9544-2f4ceb4b289f",
                                                "text": "Теперь он стал весь виден: очень бледный, с нежным девичьим лицом, с голубыми глазами и упрямым детским подбородком с ямочкой посредине; лет ему, должно быть, было около тридцати, тридцати пяти."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7619dac2-38f0-3610-8d8c-ab1f4fd2f1b4",
                                        "entry_id": "a681a601-90ef-3855-ad88-8522b7306f9e",
                                        "glosses": [
                                            "перен. (о неодушевлённых предметах) неподдающийся"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a52ea4-021e-4645-9e57-de5edd2e4cd1",
                                                "sense_id": "7619dac2-38f0-3610-8d8c-ab1f4fd2f1b4",
                                                "text": "В такое время хорошо гнать метлой или лопатой грязную воду в канавах, пускать по воде кораблики или долбить каблуками упрямый лёд."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
