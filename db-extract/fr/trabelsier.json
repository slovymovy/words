                        "entry_id": "17e225ed-98a6-32e6-a089-cdd7eb111527",
                        "glosses": [
                            "Voler de grandes sommes d’argent, voler l’argent du peuple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10d3a21-a17e-4780-888f-3e4d758b0ac4",
                                "sense_id": "fda8a1f1-3ad8-30e3-ac1f-623f9fd66711",
                                "text": "Si un pays se fait trabelsier, le peuple doit se tunisier."
                            },
                            {
                                "example_id": "3d9362d3-ad18-4561-80d9-6217707559b5",
                                "sense_id": "fda8a1f1-3ad8-30e3-ac1f-623f9fd66711",
                                "text": "J’ai voulu Trabelsier [voler] le coiffeur, mais il s’est Tunisié [défendu], alors je me suis Benalisé [enfui]."
                            }
                        ]
                    }
