                {
                    "sense_id": "496b731c-1008-37c4-a7ca-2ea341ad7a27",
                    "sense_definition": "The point at which the axes of a coordinate system intersect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plot the point three units up from the <w>origin</w> on the graph.",
                            "target_lang_translations": {
