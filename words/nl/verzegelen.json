            "senses": [
                {
                    "sense_id": "e738a3e2-bbec-38e0-8179-9ac07c7c014c",
                    "sense_definition": "iets officieel of hermetisch dichtmaken zodat het niet meer geopend kan worden zonder sporen achter te laten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sluiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie besloot de deur van het pand te <w>verzegelen</w> na het onderzoek.",
                            "target_lang_translations": {
                                "en": "The police decided to <w>seal</w> the door of the building after the investigation."
                            }
                        },
                        {
                            "text": "Je moet de envelop goed <w>verzegelen</w> voordat je hem aangetekend verstuurt.",
                            "target_lang_translations": {
                                "en": "You must <w>seal</w> the envelope well before sending it by registered mail."
                            }
                        }
                    ],
                    "synonyms": [
                        "afsluiten",
                        "dichtmaken"
                    ],
                    "antonyms": [
                        "openen",
                        "verbreken"
                    ],
                    "common_phrases": [
                        "een envelop verzegelen",
                        "een pand verzegelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially or hermetically close something so that it cannot be opened without leaving traces."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seal",
                                "target_lang_sense_clarification": "to close something securely or officially"
                            },
                            {
                                "target_lang_word": "seal off",
                                "target_lang_sense_clarification": "to prevent access to a place or object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb7e2794-52e3-342b-8e17-937f4d6e6a04",
                    "sense_definition": "een afspraak of relatie officieel bevestigen of bekrachtigen",
