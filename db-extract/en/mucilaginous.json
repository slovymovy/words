                        "entry_id": "3b2a4fed-99a0-3a35-9cdf-24afd0768d65",
                        "glosses": [
                            "Of or pertaining to mucilage; of, pertaining to, or resembling mucus; slimy and viscous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f26ce2c-9c2d-460e-9c37-f070252d8a00",
                                "sense_id": "8f5e86f1-635e-38fd-ae0b-04a7806117a2",
                                "text": "Appa [...] forked down his throat the mucilaginous scrambled eggs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dbb817e-d8ec-4c8b-9321-55f71419917f",
