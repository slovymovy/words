                "senses": [
                    {
                        "sense_id": "dab2ba61-5881-3155-980b-f79b3905e344",
                        "entry_id": "004c187b-35fc-365d-862b-f42e36ddb464",
                        "glosses": [
                            "Pflanze innerhalb der Familie der Doldenblütler, die in Eurasien und im westlichen Nordafrika verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec503071-4627-458b-800a-28ccc909eb5c",
                                "sense_id": "dab2ba61-5881-3155-980b-f79b3905e344",
                                "text": "„Die auch Bergkümmel oder Bergfenchel genannte Pflanze hat tatsächlich etwas von jenen Gewürzen, denn das Berg-Laserkraut riecht kräftig und besitzt auffallend flügelig geriefte Früchte.“"
                            },
                            {
                                "example_id": "eb25c4a8-f2eb-4b92-a5cb-e3d4dfd216c0",
                                "sense_id": "dab2ba61-5881-3155-980b-f79b3905e344",
                                "text": "„Auf den Moorwiesen des Balaton-Oberlandes – in den Becken von Pécsely, Kál und Tapolca – sieht man im Mai und Juni ein Blütenmeer, darunter verschiedene Orchideen und den ungarischen Bergfenchel.“"
                            },
                            {
                                "example_id": "406755d4-1b3e-4e24-99e0-dae54b0abfd5",
                                "sense_id": "dab2ba61-5881-3155-980b-f79b3905e344",
                                "text": "„Meerkohl und Bergfenchel wachsen in der wohlgepflegten Sanddüne, die Silberscharte gehört abermals zur Erhaltungskultur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
