                        "examples": [
                            {
                                "example_id": "db4119af-0787-4f97-bdf9-c517b870c628",
                                "sense_id": "8f4c36b1-07c8-32e1-8e18-1994bd2cf205",
                                "text": "Der Seekadett entspricht dem Fahnenjunker bei Heer und Luftwaffe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ec71acd7-8b9b-357a-acee-5bba0f7809b3",
                        "entry_id": "736ae368-230b-3d20-93e6-8c61c0214b24",
