                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5bd4985e-ec17-395e-989f-ea81e4106825",
                                        "entry_id": "9b1bd11d-a7a2-3201-a3dc-ab8dee40abfc",
                                        "glosses": [
                                            "lidový"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5069ba-c268-497e-bf2f-d13e05b82a97",
                                                "sense_id": "5bd4985e-ec17-395e-989f-ea81e4106825",
                                                "text": "Démotické písmo bylo hojně užíváno v běžném životě starých Egypťanů."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5a1927-3b60-3ca6-b690-017053b92e5f",
                                        "entry_id": "9b1bd11d-a7a2-3201-a3dc-ab8dee40abfc",
                                        "glosses": [
                                            "napsaný v démotickém písmu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f38e928-3de4-47cd-bfc0-59c598298688",
                                                "sense_id": "cb5a1927-3b60-3ca6-b690-017053b92e5f",
                                                "text": "V Esetině chrámu na ostrově Philae se nachází nejmladší známý démotický nápis z 11. prosince 452, který v překladu zní „Nohy Panachteta Mladšího“."
                                            }
                                        ]
                                    }
                                ]
                            },
