    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e98d2ecd-a73e-3448-9e6c-45fe3c2dfa31",
                    "sense_definition": "Transformer un liquide en solide sous l'action du froid intense ou se changer en glace.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "changement_etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'eau du lac commence à <w>geler</w> dès les premières semaines de décembre."
                        },
                        {
                            "text": "Le froid intense a fait <w>geler</w> les canalisations de la vieille maison."
                        }
                    ],
                    "synonyms": [
                        "glacer"
                    ],
                    "antonyms": [
                        "chauffer"
                    ],
                    "common_phrases": [
                        "commencer à geler"
                    ]
                },
                {
                    "sense_id": "9636e0d0-de47-399e-a688-0dbf49eee87d",
                    "sense_definition": "En parlant des conditions météorologiques, faire une température inférieure à zéro degré Celsius.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>gèle</w> dehors ce matin, mettez votre manteau le plus chaud."
                        },
                        {
                            "text": "La météo annonce qu'il va <w>geler</w> pendant toute la nuit prochaine."
                        }
                    ],
                    "common_phrases": [
                        "geler à pierre fendre"
                    ]
                },
                {
                    "sense_id": "014aeb93-7baf-3d6b-9d80-902a509a3367",
                    "sense_definition": "Ressentir une sensation de froid très vif, souffrir intensément du froid.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ferme vite cette fenêtre ouverte, nous sommes en train de <w>geler</w> ici."
                        },
                        {
                            "text": "Sans gants ni bonnet, je <w>gèle</w> complètement après dix minutes de marche."
                        }
                    ],
                    "common_phrases": [
                        "geler sur place"
                    ]
                },
                {
                    "sense_id": "287b7286-7bff-38fb-9dd5-bdb26d2b0aa4",
                    "sense_definition": "Suspendre, bloquer provisoirement l'évolution ou l'usage de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blocage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé de <w>geler</w> les tarifs de l'électricité cette année."
                        },
                        {
                            "text": "La justice a ordonné de <w>geler</w> les avoirs bancaires du suspect."
                        }
                    ],
                    "common_phrases": [
                        "geler les prix",
                        "geler les avoirs",
                        "geler un projet"
                    ]
                },
                {
                    "sense_id": "f94d21aa-fbc3-3781-92f0-49b040338051",
                    "sense_definition": "Endommager ou anéantir des cultures ou des arbres fruitiers par une vague de froid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette gelée printanière tardive risque de <w>geler</w> les jeunes pousses de vigne."
                        },
                        {
                            "text": "Le verglas a malheureusement fini par <w>geler</w> tous les poiriers du verger."
                        }
                    ]
                },
                {
                    "sense_id": "6e74ec55-a93a-3104-8815-d6506bb2360b",
                    "sense_definition": "Se trouver dans un état de forte altération cognitive sous l'effet de drogues.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drogue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette soirée agitée, il était totalement <w>gelé</w> et incapable de parler."
                        },
                        {
                            "text": "Certains jeunes du quartier passent leurs journées à se <w>geler</w> la tête."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre argotique"
                        }
                    ]
                }
            ]
        }
