                                        "sense_id": "144adf51-02e0-3c90-87a5-55896fe5665b",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "A voter who is not present at the time of voting; absentee voter."
                                        ],
