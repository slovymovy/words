                                    {
                                        "sense_id": "79ac166f-cf4b-3b39-ac65-aa4c6411e936",
                                        "entry_id": "496aa48b-6319-3cf3-8ce9-d6cc96aee64a",
                                        "glosses": [
                                            "wissenschaftliche Beschäftigung mit den Mitteln zur Bekämpfung und Untersuchung von Straftaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73b8849-298b-4e21-9d87-b28e63a85cc1",
                                                "sense_id": "79ac166f-cf4b-3b39-ac65-aa4c6411e936",
                                                "text": "„Binnen weniger Jahre wurde aus dem Büroschreiber eine international anerkannte Koryphäe der Kriminalistik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
