    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6607c809-1f71-3d67-8065-db2b923c18a3",
                    "sense_definition": "Plate-forme en saillie sur la façade d'un bâtiment, entourée d'une balustrade ou d'un garde-corps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, il prend son café sur le <w>balcon</w> en regardant la rue animée."
                        },
                        {
                            "text": "Nous avons loué un appartement lumineux avec un grand <w>balcon</w> donnant sur le parc."
                        }
                    ],
                    "common_phrases": [
                        "fleurir son balcon",
                        "appartement avec balcon"
                    ]
                },
                {
                    "sense_id": "a80e9d87-506d-3f7d-bc8b-e384dbefd076",
                    "sense_definition": "Galerie d'une salle de spectacle ou d'un théâtre, située en hauteur au-dessus du parterre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons réservé des places au <w>balcon</w> pour mieux apprécier la mise en scène."
                        },
                        {
                            "text": "Depuis le premier <w>balcon</w>, la vue sur l'orchestre et la scène était tout simplement magnifique."
                        }
                    ],
                    "common_phrases": [
                        "place au balcon"
                    ]
                },
                {
                    "sense_id": "d02757e4-87c2-375d-9907-c76835b93d58",
                    "sense_definition": "Poitrine volumineuse ou décolleté plongeant chez une femme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec son décolleté plongeant, elle savait qu'il y avait du monde au <w>balcon</w>."
                        },
                        {
                            "text": "Avec cette robe très ajustée, on remarquait immédiatement son imposant <w>balcon</w>."
                        }
                    ],
                    "synonyms": [
                        "devanture"
                    ],
                    "common_phrases": [
                        "avoir du monde au balcon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier et imagé"
                        }
                    ]
                },
                {
                    "sense_id": "79315d50-2d1b-31c8-bc4a-1f40d607369b",
                    "sense_definition": "Balustrade métallique de sécurité située à l'avant ou à l'arrière d'un bateau.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la manœuvre délicate, l'équipier s'est fermement agrippé au <w>balcon</w> avant pour ne pas glisser."
                        },
                        {
                            "text": "Le voilier a heurté le quai, ce qui a tordu le <w>balcon</w> arrière."
                        }
                    ],
                    "common_phrases": [
                        "balcon avant",
                        "balcon arrière"
                    ]
                }
            ]
        }
    ]
