                        "source_sense_id": "5fa793c6-07de-3941-8e20-2efa1bebaddd",
                        "target_lang_word": "σωβινισμός",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
