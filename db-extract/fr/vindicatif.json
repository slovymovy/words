                                    {
                                        "sense_id": "9b4f2a1a-13f7-3164-9dfb-cfab64230a0e",
                                        "entry_id": "d62cb53f-8927-3134-9a85-2cce112af797",
                                        "glosses": [
                                            "begierig, sich zu rächen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b46c0e7-0ad8-419a-9130-7135c86e35f6",
                                                "sense_id": "9b4f2a1a-13f7-3164-9dfb-cfab64230a0e",
                                                "text": "„Aber jeder Gedanke an Stalin erfüllte ihn so rachsüchtig mit Zorn, dass er nachts im Lager vor Hass keinen Schlaf fand.“"
                                            },
                                            {
                                                "example_id": "cdd92101-5751-4196-9072-71bc4aabb1f6",
                                                "sense_id": "9b4f2a1a-13f7-3164-9dfb-cfab64230a0e",
                                                "text": "Der rachsüchtige Ex-Ehemann der Verunglückten hatte die Bremsschläuche angeschnitten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55254242-d143-4242-91ea-a88048f21cd6",
                        "source_entry_id": "b08562bd-0c37-3830-941a-78355d4addf7",
                        "source_sense_description": "Qui aime à se venger",
                        "target_lang_word": "vindictive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
