                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e950d2-b76a-4086-9bfd-f5a4f91076f1",
                                "sense_id": "57414e2c-b2fc-3a5d-bb3e-e24bcab09502",
                                "text": "„›Nein, Madam. Es ist natürliches Massivholz.‹“"
                            },
                            {
                                "example_id": "ec787d0b-6783-41b8-bbac-26bf75502c22",
                                "sense_id": "57414e2c-b2fc-3a5d-bb3e-e24bcab09502",
                                "text": "„Diese Tür war aus Massivholz, doch als ich am Knauf zog, stellte ich fest, dass sie von innen nur mit einem einfachen Haken am Rahmen, der von einer Öse in der Wand gehalten wurde, verschlossen war.“"
                            }
                        ],
