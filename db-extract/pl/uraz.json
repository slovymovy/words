                        ],
                        "examples": [
                            {
                                "example_id": "4dabac22-9279-4559-93c8-3cab3b41c769",
                                "sense_id": "5511abde-2ade-3ebe-9235-752824f3b727",
                                "text": "Uraz nogi przeszkadza mi w chodzeniu.",
                                "translation": "Ma blessure à la jambe m'empêche de marcher."
                            }
                        ]
                    },
                    {
                        "sense_id": "53680afb-b09b-3d0d-9c4f-dc98ac475639",
                        "entry_id": "0ca000eb-006f-3c5d-9404-1ce731583dc7",
                        "glosses": [
                            "Ressentiment envers quelqu’un qui a offensé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3409ade8-3c84-4c4d-b0f3-91bf80b56176",
                                "sense_id": "53680afb-b09b-3d0d-9c4f-dc98ac475639",
                                "text": "Od kiedy pani Jola przycięła mu ucho, ma uraz do wszystkich fryzjerek.",
                                "translation": "Depuis que Mme Jola lui a coupé l'oreille, il en veut à tous les coiffeurs."
                            }
                        ]
