                    },
                    {
                        "form_id": "fa769dd2-05d6-4da8-b5cf-a5169d4b197c",
                        "entry_id": "8f59e5e1-a974-3f33-a6bb-4c6567d77f5c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Goldminen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                        "entry_id": "8f59e5e1-a974-3f33-a6bb-4c6567d77f5c",
                        "glosses": [
                            "Bergwerk, in dem Gold abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8326a02c-9276-4734-8d14-ba16d5e9d7f7",
                                "sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                                "text": "Im Tauerngebirge fanden sie eine stillgelegte Goldmine."
                            },
                            {
                                "example_id": "8ebe9d34-048d-48cc-b658-ac9d3e112017",
                                "sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                                "text": "„Sein Name war Montez, und er war der Manager der Goldmine gewesen.“"
                            },
                            {
                                "example_id": "9ad7e3a3-5ee2-4e06-b983-a7a84c9f44e8",
                                "sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                                "text": "„Die Goldminen, von Rio de Janeiro aus etwa 400 Kilometer im Inland gelegen, waren die größten Südamerikas.“"
                            },
                            {
                                "example_id": "2c799932-7f44-464c-8dff-8b13e072c18b",
                                "sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                                "text": "„Und er soll den Europäern Zugang verschaffen zu den Goldminen der dortigen Könige, deren Reichtum legendär ist.“"
                            },
                            {
                                "example_id": "6311bc10-12f1-4399-8765-b15646ff5b10",
                                "sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                                "text": "„In Njurguilahti, direkt am Bootssteg von Ahkun Tupa, ist der Start zu den Goldminen vom Lemmenjoki.“"
                            },
                            {
                                "example_id": "7ea2ecd4-f1de-49a0-9cee-ba222f553248",
                                "sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                                "text": "„Viele männliche Bewohner zog es zu den Goldminen Südafrikas, wo man vergleichsweise gut verdienen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "717a83d5-653f-453a-b0fc-5bee4ea24dfd",
                        "source_entry_id": "8f59e5e1-a974-3f33-a6bb-4c6567d77f5c",
                        "source_sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
                        "source_sense_description": "Bergwerk, in dem Gold abgebaut wird",
                        "target_lang_word": "gold mine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold mine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80b2e5b2-53a5-398b-83e5-53dcc87a5eba",
                                        "entry_id": "001ed901-e180-3873-9a53-15932f166bdb",
                                        "glosses": [
                                            "A mine for gold ore or metal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00be5797-a108-483a-a67c-3be1ea167f36",
                                                "sense_id": "80b2e5b2-53a5-398b-83e5-53dcc87a5eba",
                                                "text": "South Africa has many goldmines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                        "entry_id": "001ed901-e180-3873-9a53-15932f166bdb",
                                        "glosses": [
                                            "A very profitable economic venture."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95de3e4f-87de-40af-b469-037d7e68d13b",
                                                "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                                "text": "This oil deposit is a regular gold mine. We make more and more money every year!"
                                            },
                                            {
                                                "example_id": "8d2f9943-d43f-4b1c-9587-c0c1ffa0ed21",
                                                "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                                "text": "The possessors of Salisbury & Yeovil Railway shares had ample compensation for the anxiety which the first few years of the company's existence had given them, for the concern proved a veritable gold mine."
                                            },
                                            {
                                                "example_id": "6f740adf-fd65-48f8-a9ca-09e71fbdcbdb",
                                                "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                                "text": "[Hal Varian] went to work helping Page, Brin, and Schmidt develop more efficient auction algorithms and build the auction model that became such a gold mine for Google."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbb3ddd-764d-394e-9b1b-893d98cd23dc",
                                        "entry_id": "001ed901-e180-3873-9a53-15932f166bdb",
                                        "glosses": [
                                            "A plentiful stockpile of something sought-after."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa67e532-9603-4c22-8b5e-8cd66a1ea704",
                                                "sense_id": "efbb3ddd-764d-394e-9b1b-893d98cd23dc",
                                                "text": "The Smithsonian Institution is a goldmine of knowledge, but like most mines, you have to dig for the good stuff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85b3afab-1b4a-4c88-8b89-b7d157c25249",
                        "source_entry_id": "8f59e5e1-a974-3f33-a6bb-4c6567d77f5c",
                        "source_sense_id": "411e2bcd-a754-3e4c-922e-e4ff76d42520",
