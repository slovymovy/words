                ],
                "senses": [
                    {
                        "sense_id": "32fc54d9-9119-3e96-8b6d-a1ae6e6ad832",
                        "entry_id": "59785dfe-e46f-3a2a-8897-ee8948422bd1",
                        "glosses": [
                            "Steuer, die beim Vertrieb von Tabakprodukten vom Staat eingehoben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10dc3d46-423f-41c5-9a2c-d9e44c1075fa",
                                "sense_id": "32fc54d9-9119-3e96-8b6d-a1ae6e6ad832",
                                "text": "Die Tabaksteuer wird immer höher."
                            },
                            {
                                "example_id": "989b744f-a76b-4086-9b15-e5fb4922dfcb",
                                "sense_id": "32fc54d9-9119-3e96-8b6d-a1ae6e6ad832",
                                "text": "„Die Glimmstängel werden sich auch heuer wieder verteuern, obwohl die Tabaksteuer erstmals seit zehn Jahren nicht mehr steigt, sagt Josef Prirschl mit Blick auf die Industrie, die einiges Geld in die Rückverfolgbarkeit ihrer Produkte investiert habe.“"
                            },
                            {
                                "example_id": "d283b3d9-0384-4aad-ae75-582042dceb5e",
                                "sense_id": "32fc54d9-9119-3e96-8b6d-a1ae6e6ad832",
                                "text": "„Tabakmonopol und Tabaksteuer wurden bald zu bedeutsamen Finanzfaktoren.“"
                            },
                            {
                                "example_id": "b1432cb4-ca7c-435b-a4f2-1c53f51bbc79",
                                "sense_id": "32fc54d9-9119-3e96-8b6d-a1ae6e6ad832",
                                "text": "„Rund fünfzehn Milliarden Euro nimmt der Staat pro Jahr durch Tabaksteuern ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
