{
    "word_family": [
        "squirter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "719ca013-24ad-34eb-ba47-6c661965f96b",
                    "sense_definition": "A small child",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>squirt</w> where have you been all afternoon?",
                            "target_lang_translations": {
                                "cs": "Ahoj <w>prcku</w>, kde jsi byl celé odpoledne?"
                            }
                        },
                        {
                            "text": "The little <w>squirt</w> was running around the park with his friends.",
                            "target_lang_translations": {
                                "cs": "Ten malý <w>mrňous</w> běhal po parku se svými kamarády."
                            }
                        }
                    ],
                    "synonyms": [
                        "ankle-biter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term of address for a child"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malé dítě (často používané jako neformální oslovení)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prcek",
                                "target_lang_sense_clarification": "neformální, familiární označení pro malé dítě"
                            },
                            {
                                "target_lang_word": "mrňous",
                                "target_lang_sense_clarification": "neformální označení pro malé dítě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e385b2-79c5-3c64-b5f4-f068a875f2d9",
                    "sense_definition": "A small, quick stream or jet of liquid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful or you will get a <w>squirt</w> of lemon juice in your eye.",
                            "target_lang_translations": {
                                "cs": "Dávej pozor, jinak ti <w>stříkne</w> citronová šťáva do oka."
                            }
                        },
                        {
                            "text": "The broken pipe released a small <w>squirt</w> of water onto the floor.",
                            "target_lang_translations": {
                                "cs": "Z prasklého potrubí <w>vystříkl</w> na podlahu malý proud vody."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý, rychlý proud nebo výstřik kapaliny"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stříkanec",
                                "target_lang_sense_clarification": "množství kapaliny, které vystříklo"
                            },
                            {
                                "target_lang_word": "proud",
                                "target_lang_sense_clarification": "rychle tekoucí kapalina"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e069953b-4494-3533-93cd-2ba4bfbf7b90",
                    "sense_definition": "An instrument that forcefully ejects a small, quick stream of liquid",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played in the garden with their plastic water <w>squirt</w> toys.",
                            "target_lang_translations": {
                                "cs": "Děti si na zahradě hrály se svými plastovými <w>stříkačkami</w> na vodu."
                            }
                        },
                        {
                            "text": "He used a small <w>squirt</w> to clean the dust off the camera lens.",
                            "target_lang_translations": {
                                "cs": "Použil malý <w>rozprašovač</w>, aby očistil prach z objektivu fotoaparátu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nástroj nebo zařízení, které pod tlakem vystřikuje kapalinu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stříkačka",
                                "target_lang_sense_clarification": "nástroj pro stříkání kapaliny"
                            },
                            {
                                "target_lang_word": "rozprašovač",
                                "target_lang_sense_clarification": "zařízení na rozptylování kapaliny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc83476-e419-33b7-8e3d-6f8c2f096679",
                    "sense_definition": "An annoyingly pretentious or unimportant person",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to listen to that little <w>squirt</w> talk about things he knows nothing about.",
                            "target_lang_translations": {
                                "cs": "Nechci poslouchat toho malého <w>fracka</w>, jak mluví o věcech, o kterých nic neví."
                            }
                        },
                        {
                            "text": "He acted like a total <w>squirt</w> when he tried to impress everyone with his fake knowledge.",
                            "target_lang_translations": {
                                "cs": "Choval se jako úplný <w>namyšlenec</w>, když se snažil na všechny zapůsobit svými falešnými znalostmi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Derogatory term"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která působí domýšlivě nebo bezvýznamně"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "namyšlený fracek",
                                "target_lang_sense_clarification": "pejorativní označení pro arogantní osobu"
                            },
                            {
                                "target_lang_word": "nula",
                                "target_lang_sense_clarification": "označení pro někoho bezvýznamného"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d41c97b9-37ff-3609-8e10-f18443405cc2",
                    "sense_definition": "To cause liquid to be ejected in a rapid stream from a narrow opening",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>squirt</w> some soap onto the sponge before you wash the dishes.",
                            "target_lang_translations": {
                                "cs": "Prosím, <w>stříkni</w> trochu mýdla na houbičku, než umyješ nádobí."
                            }
                        },
                        {
                            "text": "You should <w>squirt</w> a little bit of water into the plant pot every morning.",
                            "target_lang_translations": {
                                "cs": "Každé ráno bys měl do květináče <w>vstříknout</w> trochu vody."
                            }
                        }
                    ],
                    "common_phrases": [
                        "squirt water"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, aby kapalina vystříkla úzkým otvorem"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stříknout",
                                "target_lang_sense_clarification": "jednorázové vystříknutí kapaliny"
                            },
                            {
                                "target_lang_word": "vstříknout",
                                "target_lang_sense_clarification": "vstříknout kapalinu dovnitř něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4bd04e2-4b10-3d41-aa23-83d8ebd4f5e7",
                    "sense_definition": "To be thrown out or ejected in a rapid stream",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The juice <w>squirted</w> out of the orange when I squeezed it too hard.",
                            "target_lang_translations": {
                                "cs": "Šťáva z pomeranče <w>vystříkla</w>, když jsem ho příliš silně zmáčkl."
                            }
                        },
                        {
                            "text": "Water <w>squirted</w> from the hose as soon as he turned the handle.",
                            "target_lang_translations": {
                                "cs": "Jakmile otočil kohoutkem, z hadice <w>vytryskla</w> voda."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Být vymrštěn nebo vytrysknout v rychlém proudu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vystříknout",
                                "target_lang_sense_clarification": "náhlé vytečení kapaliny pod tlakem"
                            },
                            {
                                "target_lang_word": "vytrysknout",
                                "target_lang_sense_clarification": "prudké vytečení kapaliny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}