                ],
                "senses": [
                    {
                        "sense_id": "f46fae2e-2e7b-3394-930f-8b70849a4f83",
                        "entry_id": "296c10e1-ac27-3169-bf4b-6c1fd3a0b5d4",
                        "glosses": [
                            "By means of sight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0486dcb-0e04-4ac2-b228-51be9a97c450",
                                "sense_id": "f46fae2e-2e7b-3394-930f-8b70849a4f83",
                                "text": "The radar's detection was confirmed visually, because seeing is believing."
                            },
                            {
                                "example_id": "1db5fe33-2639-432c-9561-2b9cfe909040",
                                "sense_id": "f46fae2e-2e7b-3394-930f-8b70849a4f83",
                                "text": "He explained that engineers had been able to examine the bridge visually, and had started surveying likely sites for access roads and where to place the heavyweight crawler crane. NR was also ordering the aggregates needed for the access roads."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "737e9916-ccdd-4524-85a3-6f505da2ef43",
                        "source_entry_id": "296c10e1-ac27-3169-bf4b-6c1fd3a0b5d4",
                        "source_sense_id": "f46fae2e-2e7b-3394-930f-8b70849a4f83",
                        "source_sense_description": "by means of sight",
                        "target_lang_word": "optisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e666015-58f9-3c18-a3f9-b12e77b3b0ac",
                                        "entry_id": "5425296b-4705-3e34-9fee-e23ccab323dc",
                                        "glosses": [
                                            "die Optik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c4d3ec3-cd2d-45e9-ba7e-1d17977aff16",
                                                "sense_id": "1e666015-58f9-3c18-a3f9-b12e77b3b0ac",
                                                "text": "Zu den optischen Hilfsmitteln zählen auch Lichtsignalanlagen."
                                            },
                                            {
                                                "example_id": "009b952d-79e8-4a47-b243-5b9e1255e7d0",
                                                "sense_id": "1e666015-58f9-3c18-a3f9-b12e77b3b0ac",
                                                "text": "Das war bestimmt eine optische Täuschung."
                                            },
                                            {
                                                "example_id": "ba0c13c5-6f9a-46c0-a9f6-9b2fced2f93f",
                                                "sense_id": "1e666015-58f9-3c18-a3f9-b12e77b3b0ac",
                                                "text": "„Optisch wird sich der neue Crossover am Allroad Concept orientieren, der in diesem Frühjahr in Peking präsentiert wurde.“"
                                            },
                                            {
                                                "example_id": "23760cb2-8347-4ad3-b1f5-a76d78afb6cb",
                                                "sense_id": "1e666015-58f9-3c18-a3f9-b12e77b3b0ac",
                                                "text": "Brillen und Ferngläser sind optische Geräte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e0fd1e9-eeb7-3bbf-890f-33310a53ac03",
                                        "entry_id": "5425296b-4705-3e34-9fee-e23ccab323dc",
                                        "glosses": [
                                            "dem Augenschein nach, dem äußeren Anscheine nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360af2e7-db41-46ca-824d-4603556ba667",
                                                "sense_id": "3e0fd1e9-eeb7-3bbf-890f-33310a53ac03",
                                                "text": "Man möchte sich ja nicht optisch älter machen, als man ist."
                                            },
                                            {
                                                "example_id": "4f543785-b9a7-4cc2-9c21-831bc734077b",
                                                "sense_id": "3e0fd1e9-eeb7-3bbf-890f-33310a53ac03",
                                                "text": "Rein optisch ist das ein sehr gelungenes Buch."
                                            },
                                            {
                                                "example_id": "9dbcaa48-cf27-4925-bef8-edfa4b068f97",
                                                "sense_id": "3e0fd1e9-eeb7-3bbf-890f-33310a53ac03",
                                                "text": "Optisch gibt es nichts zu bemängeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6d547a7-2c36-42d1-baf4-428a0448277d",
                        "source_entry_id": "296c10e1-ac27-3169-bf4b-6c1fd3a0b5d4",
                        "source_sense_id": "f46fae2e-2e7b-3394-930f-8b70849a4f83",
                        "source_sense_description": "by means of sight",
                        "target_lang_word": "visuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                        "entry_id": "d6c89767-8107-3b22-9a0e-770349014750",
                                        "glosses": [
                                            "alle Vorgänge die optische Wahrnehmung betreffend, Synonym zu optisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f20943f-bc65-47a6-b39c-7d1e78cb0312",
                                                "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                                "text": "Visuelle Reize werden im Gehirn über mehrere Stufen hinweg aufbereitet."
                                            },
                                            {
                                                "example_id": "00e2b7d7-4637-4450-9f01-5696e05ecebd",
                                                "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                                "text": "Rein visuell war es ein Erlebnis, aber mit der Musik kann ich persönlich nicht so viel anfangen."
                                            },
                                            {
                                                "example_id": "b8348eb1-cb34-4a60-b7a8-713f1b03250a",
                                                "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                                "text": "Wie funktioniert eigentlich die visuelle Wahrnehmung? Wieso können wir sehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                        "entry_id": "d6c89767-8107-3b22-9a0e-770349014750",
                                        "glosses": [
                                            "das Sehen oder den Gesichtssinn betreffend, über das Sehen aufgenommen, vermittelt, empfunden, gelernt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a9ad91-e980-472b-a867-e97c81d090e7",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Er ist ein visueller Lerntyp."
                                            },
                                            {
                                                "example_id": "43670527-f28a-4c06-bfef-582f09066a6a",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Es gibt eine gute visuelle Lernmethode zu dem Thema."
                                            },
                                            {
                                                "example_id": "aefea0f7-410d-4980-b706-5380b4ca1100",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Die visuellen Informationen, die auf einen einströmen, sind atemberaubend."
                                            },
                                            {
                                                "example_id": "dec8f831-fbbf-44f9-adce-3682f301129f",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Ein Teilgebiet der Kommunikationswissenschaften ist die visuelle Kommunikation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
