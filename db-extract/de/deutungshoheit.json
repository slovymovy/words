                "senses": [
                    {
                        "sense_id": "857a4421-85a6-348a-88f7-a1fb48ac3c83",
                        "entry_id": "1a0eb5a7-8d43-3093-b67b-5cc489a3ff48",
                        "glosses": [
                            "alleiniges Recht, einen Sachverhalt zu interpretieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e086b5e-f46c-4e3f-a670-a0bf2f976ea6",
                                "sense_id": "857a4421-85a6-348a-88f7-a1fb48ac3c83",
                                "text": "Patienten fühlen sich oft übergangen und falsch beraten, wenn der Arzt die alleinige Deutungshoheit über die Befunde beansprucht und die Meinung des Patienten nicht zur Kenntnis nimmt."
                            },
                            {
                                "example_id": "9b1a140f-69bb-4f47-bc79-055f2476ca06",
                                "sense_id": "857a4421-85a6-348a-88f7-a1fb48ac3c83",
                                "text": "„Haben Schüler in Washington amerikanische Ureinwohner respektlos behandelt? Inzwischen zeigt sich: Der Fall ist kompliziert - und um die Deutungshoheit wird erbittert gerungen.“"
                            }
                        ],
