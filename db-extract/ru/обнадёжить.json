                    {
                        "form_id": "d718e6aa-dfb6-4423-94c0-094fe6697a4e",
                        "entry_id": "ad6c5e79-025e-3380-b912-f71ce375a942",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обнадёживши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "524cb18e-bcdc-3832-abce-cebff9af6d3a",
                        "entry_id": "ad6c5e79-025e-3380-b912-f71ce375a942",
                        "glosses": [
                            "вселить надежду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcaf5bf1-68c7-4818-8228-0eb5d9e5ac43",
                                "sense_id": "524cb18e-bcdc-3832-abce-cebff9af6d3a",
                                "text": "Павла, чтобы утешить отца и обнадёжить Митю, объявила им, что наутро будет самый главный доктор, который, конечно, в два-три дня вылечит Митю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1167cc4-0e60-4241-a093-33bbb353cf2f",
                        "source_entry_id": "ad6c5e79-025e-3380-b912-f71ce375a942",
                        "source_sense_id": "524cb18e-bcdc-3832-abce-cebff9af6d3a",
                        "target_lang_word": "encourage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encourage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                        "entry_id": "53091342-1b8d-3b40-9e02-eab547d0ecba",
                                        "glosses": [
                                            "To mentally support; to motivate, give courage, hope or spirit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e08683-9cc4-4404-bac0-edea0ea6c88d",
                                                "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                                "text": "I encouraged him during his race."
                                            },
                                            {
                                                "example_id": "12cfc985-ee1d-49ab-9bff-cef5b69fde60",
                                                "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                                "text": "Delia's coach encouraged her to focus on the positives."
                                            },
                                            {
                                                "example_id": "3894ab6d-fad8-4d91-8fc5-863569c5f23e",
                                                "sense_id": "799eaefe-03b7-3e13-a0fb-9ed6e6e71949",
                                                "text": "\"It's a lose-lose situation. It can be turned into a win-win. We should be encouraging and supporting expensive bi-mode freight locomotives, especially where capacity is constrained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf1a855-0811-352d-9f5a-3a7369f707e6",
                                        "entry_id": "53091342-1b8d-3b40-9e02-eab547d0ecba",
                                        "glosses": [
                                            "To spur on, strongly recommend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ec46539-2e73-4300-a73f-1ebc534fdd6d",
                                                "sense_id": "fbf1a855-0811-352d-9f5a-3a7369f707e6",
                                                "text": "We encourage the use of bicycles in the town centre."
                                            },
                                            {
                                                "example_id": "acb76fd3-edcd-4d49-84ae-26168d466ee5",
                                                "sense_id": "fbf1a855-0811-352d-9f5a-3a7369f707e6",
                                                "text": "We encourage you to cycle instead of taking the car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                        "entry_id": "53091342-1b8d-3b40-9e02-eab547d0ecba",
                                        "glosses": [
                                            "To foster, give help or patronage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3945341a-b694-4e47-bc20-6d372b2a3454",
                                                "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                                "text": "The royal family has always encouraged the arts in word and deed."
                                            },
                                            {
                                                "example_id": "3162e6a8-4747-4592-935c-ab3ff6958224",
                                                "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                                "text": "They remove all sense of self-responsibility from us prisoners. We have virtually no control over any aspect of our lives. This does not encourage our ability to return to community life outside."
                                            },
                                            {
                                                "example_id": "63a2dfe9-2427-4bf0-896d-f3123ecedd83",
                                                "sense_id": "5d79cfa1-69e5-310d-9806-e0fe08aed447",
                                                "text": "And this is where the larger problem lies: when states try to enforce impossible bans, everyone loses. 3D printing farragoes have all the hallmarks of the absolute worst kind of ineffectual ban: one which encourages overly draconian laws that carry huge side effects, and that ultimately to have little to no effect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fb4c0cb-fc2e-4ef9-85b3-ac5a686c0833",
                        "source_entry_id": "ad6c5e79-025e-3380-b912-f71ce375a942",
                        "source_sense_id": "524cb18e-bcdc-3832-abce-cebff9af6d3a",
                        "target_lang_word": "animar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7e15a4-dd51-3b07-8875-be500abeb71f",
                                        "entry_id": "7f863a82-b761-381f-8864-89a300265e87",
                                        "glosses": [
                                            "Dar o insuflar ánimo, valor o confianza."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b09c800-7946-3797-b099-7f60ee30cc28",
                                        "entry_id": "7f863a82-b761-381f-8864-89a300265e87",
                                        "glosses": [
                                            "Levantar la moral a alguien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c9f42f-df4d-4ae7-b218-6b3df2687407",
                                                "sense_id": "1b09c800-7946-3797-b099-7f60ee30cc28",
                                                "text": "En una de ellas coincidió con el gran actor inglés John Gielgud, quien la animó a seguir, ya que veía en ella muchas cualidades para esta profesión."
                                            },
                                            {
                                                "example_id": "eba8bb3b-7f5b-42b7-82ab-9efd4643330a",
                                                "sense_id": "1b09c800-7946-3797-b099-7f60ee30cc28",
                                                "text": "Su padre le reprimía por ello, pero le animó a buscar su propio camino."
                                            },
                                            {
                                                "example_id": "77801aae-48a1-4b79-81fa-436b9dbbfd61",
                                                "sense_id": "1b09c800-7946-3797-b099-7f60ee30cc28",
                                                "text": "Mientras estudió en Fairfax su profesor de inglés (mr. Vernon) le animó a escribir poesía, muchas de las cuales se convertirían después en canciones como Under the Bridge (1991), que evoca una época donde estuvo perdido en las drogas y hasta vivió debajo de un puente."
                                            },
                                            {
                                                "example_id": "ef063b77-f808-4eeb-91e8-3c2d7a219aa2",
                                                "sense_id": "1b09c800-7946-3797-b099-7f60ee30cc28",
                                                "text": "Un año después, su entrenador, Jan Blankers, la animó a entrar en el equipo olímpico holandés."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "565b969d-a012-3630-b43f-5e74c61912f7",
