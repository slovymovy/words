                                "target_senses": [
                                    {
                                        "sense_id": "8bcc937f-19b4-3e19-9adb-07e018fc3095",
                                        "entry_id": "e43140c0-35b2-35be-828c-ddaefe9ab8d4",
                                        "glosses": [
                                            "The act of accusing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648d2ea7-9808-4170-9134-5dfb8e8cde74",
                                                "sense_id": "8bcc937f-19b4-3e19-9adb-07e018fc3095",
                                                "text": "We come not by the way of accusation / To taint that honour every good tongue blesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a4c82c-7d90-3909-abb1-fc69f0a458c9",
                                        "entry_id": "e43140c0-35b2-35be-828c-ddaefe9ab8d4",
                                        "glosses": [
                                            "A formal charge brought against a person in a court of law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e92c2ef3-3a02-4dd8-9ac5-d7d63976ffef",
                                                "sense_id": "88a4c82c-7d90-3909-abb1-fc69f0a458c9",
                                                "text": "[They] set up over his head his accusation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcd74209-e60d-3552-ab30-867269d97797",
                                        "entry_id": "e43140c0-35b2-35be-828c-ddaefe9ab8d4",
                                        "glosses": [
                                            "An allegation."
                                        ],
                                        "tags": [
