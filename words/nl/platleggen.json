            "senses": [
                {
                    "sense_id": "829e3e49-6077-3f43-9b48-249de101b82d",
                    "sense_definition": "iets in een horizontale of vlakke positie neerleggen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond was bang en besloot zijn oren <w>plat</w> te <w>leggen</w> tegen zijn kop.",
                            "target_lang_translations": {
                                "en": "The dog was scared and decided to <w>flatten</w> its ears against its head.",
                                "ru": "Собака испугалась и решила <w>прижать</w> уши к голове."
                            }
                        },
                        {
                            "text": "Je moet de stoelen eerst <w>platleggen</w> voordat we de grote tafel in de auto kunnen schuiven.",
                            "target_lang_translations": {
                                "en": "You must <w>fold down</w> the seats first before we can slide the large table into the car.",
                                "ru": "Сначала нужно <w>сложить</w> сиденья, прежде чем мы сможем загрузить большую карту в машину."
                            }
                        }
                    ],
                    "antonyms": [
                        "rechtop zetten"
                    ],
                    "common_phrases": [
                        "oren platleggen",
                        "stoelen platleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to place something in a horizontal or flat position",
                        "ru": "класть что-либо в горизонтальное или плоское положение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lay flat",
                                "target_lang_sense_clarification": "to place something horizontally"
                            },
                            {
                                "target_lang_word": "flatten",
                                "target_lang_sense_clarification": "to make something flat, like ears or seats"
                            },
                            {
                                "target_lang_word": "fold down",
                                "target_lang_sense_clarification": "specifically for seats or furniture"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "положить плашмя",
                                "target_lang_sense_clarification": "в горизонтальное положение"
                            },
                            {
                                "target_lang_word": "прижать",
                                "target_lang_sense_clarification": "о прижатии ушей"
                            },
                            {
                                "target_lang_word": "сложить",
                                "target_lang_sense_clarification": "о сиденьях или мебели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f82c81bc-8e77-3586-9db4-372472ae336d",
                    "sense_definition": "ervoor zorgen dat een systeem, netwerk of proces stopt met functioneren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "buiten werking stellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hackers probeerden gisteren het hele computernetwerk van de bank <w>plat</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "en": "Hackers tried to <w>shut down</w> the bank's entire computer network yesterday.",
                                "ru": "Вчера хакеры попытались <w>обрушить</w> всю компьютерную сеть банка."
                            }
                        },
                        {
                            "text": "Een grote stroomstoring kan het treinverkeer in het hele land volledig <w>platleggen</w>.",
                            "target_lang_translations": {
                                "en": "A major power outage can completely <w>paralyze</w> train traffic across the entire country.",
                                "ru": "Крупный сбой в электроснабжении может полностью <w>парализовать</w> движение поездов по всей стране."
                            }
