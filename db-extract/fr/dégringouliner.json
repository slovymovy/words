                                "example_id": "56d7e08b-79d5-4a8f-a29d-5c44962d1e52",
                                "sense_id": "f6f8fd36-3552-34e5-a74f-8039734b0b40",
                                "text": "Il dégringouline de son piédestal, s’agite dans l’ombre, cherche, fouille, gratte."
                            }
                        ]
