                                                "example_id": "6bdb3d55-d86d-4222-9621-2fe4553322cf",
                                                "sense_id": "3fa23aeb-85c1-358a-85ef-9527f678ef64",
                                                "text": "В проходах между проволочными заграждениями ставятся рогатки, оплетённые колючей проволокой."
                                            }
                                        ]
                                    },
