                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malijski",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "378603e8-489e-3104-a0cc-83639b34e1ab",
                                        "entry_id": "264a240e-eff6-3b3e-9e8e-e389c1087cc6",
                                        "glosses": [
                                            "odnoszący się do państwa Mali"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38f7fdb-1a29-45af-92d8-18a3e77b3d74",
                                                "sense_id": "378603e8-489e-3104-a0cc-83639b34e1ab",
                                                "text": "Jedną z największych atrakcji tegorocznej edycji festiwalu jest z pewnością koncert, który zaplanowano w czwartek … Jego gwiazdą będzie Salif Keita, pochodzący z książęcej rodziny malijski artysta"
                                            },
                                            {
                                                "example_id": "a9e47203-0b81-4dc7-8934-a481d12e6bb2",
                                                "sense_id": "378603e8-489e-3104-a0cc-83639b34e1ab",
                                                "text": "Jeden z najsłynniejszych malijskich muzyków, Songhaj z pochodzenia, nagrał piosenkę o wsi Dofana"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
