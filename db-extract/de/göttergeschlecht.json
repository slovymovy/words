                "senses": [
                    {
                        "sense_id": "7029995b-4bb9-3247-b6ba-a9e095c11478",
                        "entry_id": "009882d9-d768-3a00-a736-c50b5711217d",
                        "glosses": [
                            "Geschlecht von Göttern innerhalb eines mythologischen Systems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d44af451-0d12-4f39-bb22-8e2fc59f9a61",
                                "sense_id": "7029995b-4bb9-3247-b6ba-a9e095c11478",
                                "text": "Die Asen und Vanen galten den Wikingern als rivalisierende Göttergeschlechter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a11d4ba0-abff-3ac4-9ff1-e77e27e87c70",
                        "entry_id": "009882d9-d768-3a00-a736-c50b5711217d",
                        "glosses": [
                            "Gruppe/Gemeinschaft/Dynastie von Göttern innerhalb einer bestimmten Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563d2e41-619a-472a-bbeb-589d6766c85b",
                                "sense_id": "a11d4ba0-abff-3ac4-9ff1-e77e27e87c70",
                                "text": "„Das erste Göttergeschlecht (oder die erste Götterdynastie) war die sogenannte Achtheit der Ursprungsgötter in Schmunu (Hermoupolis).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "34123007-83ff-36f4-950a-9ec13d381347",
                        "entry_id": "009882d9-d768-3a00-a736-c50b5711217d",
                        "glosses": [
                            "Götter, in Abgrenzung zu den Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6181830-9f1d-4da2-b485-81439ea348fa",
                                "sense_id": "34123007-83ff-36f4-950a-9ec13d381347",
                                "text": "„Die Musen erkoren den Auserwählten zum Dichter und Sänger, damit er vom Anfang der Welt und der Abfolge der Göttergeschlechter berichte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
