                        "examples": [
                            {
                                "example_id": "d58a82ca-6962-4629-af6f-2191caaa7d8a",
                                "sense_id": "df3101ac-57b5-3114-82a8-2f7f98ced1be",
                                "text": "Чу́вствуя, что на него́ смо́трят, и что сейча́с его́ не́друг всё расска́жет и его́ опозо́рит, что да́же э́то ме́рзкое о́бщество бу́дет смея́ться над ним, Анфе́ртьев, не обора́чиваясь, скры́лся в толпе́ торгу́ющих с рук.",
                                "translation": "Konstantin Vaginov",
                                "english": "Konstantin Vaginov"
                            }
                        ]
                    }
