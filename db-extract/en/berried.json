                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470ae767-dddb-4f58-8614-9e6c00ab89cb",
                                "sense_id": "0d31dad5-845c-304b-9b2e-cf2f9b653df0",
                                "text": "The kissing-bunch, of berried holly hung with bright and glittering things, spun slowly over Mrs Morel's head as she trimmed her little tarts in the kitchen."
                            },
                            {
                                "example_id": "9febea81-9dec-4dfc-a260-fbd4c21f2448",
                                "sense_id": "0d31dad5-845c-304b-9b2e-cf2f9b653df0",
                                "text": "I cycled the three miles each morning between hedges draped with spangled cobwebs and berried bryony."
                            },
                            {
                                "example_id": "8b7334a3-bf3d-4e94-8310-95700e8835a4",
                                "sense_id": "0d31dad5-845c-304b-9b2e-cf2f9b653df0",
                                "text": "This style of wine uses small-berried, thick-skinned grapes which produce less juice than those used for crisp white wines, but with more concentration and weight."
                            }
                        ]
                    },
