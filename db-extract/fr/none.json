            {
                "entry_id": "a6d1e773-e052-3ae0-b967-fa5e375ee29c",
                "word": "none",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b1f0a732-5ce6-4337-ad35-5f6d38b9bc2a",
                        "entry_id": "a6d1e773-e052-3ae0-b967-fa5e375ee29c",
                        "tags": [
                            "plural"
                        ],
                        "form": "nones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "643f9ada-12a4-3d11-84db-7e4890b6506c",
                        "entry_id": "a6d1e773-e052-3ae0-b967-fa5e375ee29c",
                        "glosses": [
                            "Quatrième partie du jour, qui commençait à la fin de la neuvième heure, ou, selon notre manière de compter, vers trois heures de l’après-midi."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4a517bf9-f3f8-35c8-9f67-329df0c1881d",
                        "entry_id": "a6d1e773-e052-3ae0-b967-fa5e375ee29c",
                        "glosses": [
                            "Une des heures canoniales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e4cd9a-2de0-4eb1-833a-9fef135aba6f",
                                "sense_id": "4a517bf9-f3f8-35c8-9f67-329df0c1881d",
                                "text": "Avant de la laisser seule, le moine lui indiqua la liturgie des heures, matines, laudes, tierce, sexte, none, vêpres, complies et vigiles, et devant son air concentré et perdu, il lui dit que chaque horaire était noté sur une feuille posée sur le bureau..."
                            },
                            {
                                "example_id": "5cc8b2b6-f579-426a-b1bf-af8458df87b8",
                                "sense_id": "4a517bf9-f3f8-35c8-9f67-329df0c1881d",
                                "text": "La bataille durait depuis none, quand ceux de Bruges lâchèrent le pied et tournèrent le dos."
                            },
                            {
                                "example_id": "0adc68ab-33dd-43f6-83aa-a48e8f3418c0",
                                "sense_id": "4a517bf9-f3f8-35c8-9f67-329df0c1881d",
                                "text": "Rendez-vous est pris pour le vendredi 23 novembre, juste après none."
                            },
                            {
                                "example_id": "bfb560f4-d06a-4264-bf5a-5de02ac17bae",
                                "sense_id": "4a517bf9-f3f8-35c8-9f67-329df0c1881d",
                                "text": "Elle entendit sonner none à la cloche du couvent Santa Clara installé au sud du palais."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8b4541b-c403-396c-878c-b796ea521471",
                        "entry_id": "a6d1e773-e052-3ae0-b967-fa5e375ee29c",
                        "glosses": [
                            "Neuvième denier qui permet de jouir de certains biens. ^([1])"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af3225ce-a711-472e-a718-99100948dcff",
                        "source_entry_id": "a6d1e773-e052-3ae0-b967-fa5e375ee29c",
                        "target_lang_word": "none",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e27d5be-1be7-39aa-b41b-7f2f497cd1e1",
                                        "entry_id": "297366bf-80a9-3fde-ba02-64f1568b0cae",
                                        "glosses": [
                                            "Not any of a given number or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153a62a1-afde-4683-bde8-9d19fd23999f",
                                                "sense_id": "0e27d5be-1be7-39aa-b41b-7f2f497cd1e1",
                                                "text": "None of those is a good example. None are even acceptable."
                                            },
                                            {
                                                "example_id": "98ddb917-c0a7-414d-8b55-41c9078a5fad",
                                                "sense_id": "0e27d5be-1be7-39aa-b41b-7f2f497cd1e1",
                                                "text": "None of this meat tastes right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b708d97-84da-304e-ae21-b56214f6eb92",
                                        "entry_id": "297366bf-80a9-3fde-ba02-64f1568b0cae",
                                        "glosses": [
                                            "Not any of a given number or group.",
                                            "No one, nobody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6fc1bc7-e1d2-4510-a8b2-bb8f863e8ced",
                                                "sense_id": "2b708d97-84da-304e-ae21-b56214f6eb92",
                                                "text": "None of those people is my father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3086bd57-474a-370b-92df-8c7089c99895",
                                        "entry_id": "297366bf-80a9-3fde-ba02-64f1568b0cae",
                                        "glosses": [
                                            "Not any of a given number or group.",
                                            "No person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af69913-8d9a-4b35-8191-ac0b551057e5",
                                                "sense_id": "3086bd57-474a-370b-92df-8c7089c99895",
                                                "text": "None of those people are my parents. None shall pass."
                                            },
                                            {
                                                "example_id": "83224277-6799-467e-ade6-248c2ee9d909",
                                                "sense_id": "3086bd57-474a-370b-92df-8c7089c99895",
                                                "text": "Alas, none of these people were writing the reviews."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                        "entry_id": "4898e341-88c2-349f-aba7-f2d5c27df75d",
                                        "glosses": [
                                            "Not any; no (usually used only before a vowel or h)"
                                        ],
                                        "tags": [
                                            "West-Country"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97bda935-2ea3-4342-9871-dd9fbcb1771f",
                                                "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                                "text": "Thou shalt have none other gods but me."
                                            },
                                            {
                                                "example_id": "f1911cc1-4cc0-4b49-b177-4c6cc120a9c2",
                                                "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                                "text": "the foles toke their lampes, but toke none oyle with them."
                                            },
                                            {
                                                "example_id": "514a77a8-5ba4-4cbe-b751-cf0f5194ac2f",
                                                "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                                "text": "None lasses were in the dunces' row. If one had been there people would have looked at her and felt sorry but not boys."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "442a1e45-51e8-3f62-9fd4-2b562d988461",
                                        "entry_id": "b8da377a-3c78-34f9-813f-7a536102c849",
                                        "glosses": [
                                            "To no extent, in no way."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "154b13a8-dfb1-4d10-9f36-99ac4d44170d",
                                                "sense_id": "442a1e45-51e8-3f62-9fd4-2b562d988461",
                                                "text": "I felt none the worse for my recent illness."
                                            },
                                            {
                                                "example_id": "d34520bc-ef12-43da-b651-f65e82b54a36",
                                                "sense_id": "442a1e45-51e8-3f62-9fd4-2b562d988461",
                                                "text": "my lack of education hasn't hurt me none"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1489aae7-fcdf-3f1a-bb57-d7c7e2c81b9c",
                                        "entry_id": "b8da377a-3c78-34f9-813f-7a536102c849",
                                        "glosses": [
                                            "Not at all, not very."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "197aeb77-ef3b-46da-a267-75a3f5c5bec4",
                                                "sense_id": "1489aae7-fcdf-3f1a-bb57-d7c7e2c81b9c",
                                                "text": "We could hear none too well from the back."
                                            },
                                            {
                                                "example_id": "fe30b065-6836-43bc-8d53-ca0a2b59540e",
                                                "sense_id": "1489aae7-fcdf-3f1a-bb57-d7c7e2c81b9c",
                                                "text": "He was none too pleased with the delays in the program that was supposed to be his legacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad85b53b-5a04-398b-aef8-39ac63d018dd",
                                        "entry_id": "b8da377a-3c78-34f9-813f-7a536102c849",
                                        "glosses": [
                                            "No, not."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                        "entry_id": "2ace23bc-b981-3980-898b-f75275d5388c",
                                        "glosses": [
                                            "A person without religious affiliation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76066c52-03c1-4b51-ae01-d373e461814f",
                                                "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                                "text": "Both the religiously dis-identified (\"nones\") and the religiously committed report mystical experiences."
                                            },
                                            {
                                                "example_id": "601af3d5-1eca-4f73-b0fb-4dc994b2231b",
                                                "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                                "text": "Stable nones, that is, people who report in both years that they have no religious affiliation, are, in fact, much less religious"
                                            },
                                            {
                                                "example_id": "c923e8af-4504-4ee2-b367-577bdc4fdc00",
                                                "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                                "text": "we have grouped people into nones (no religion), Jews, Catholics, mainline Protestants, and evangelical protestants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8e3820-3415-3e57-953f-1786b480ba7c",
                                        "entry_id": "062e4040-133b-3849-a88e-db77550441fb",
                                        "glosses": [
                                            "Alternative form of nones: the ninth hour after dawn; (Christianity) the religious service appointed to this hour."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f92cd1c7-c967-3b9f-a57f-674b878859b1",
                                        "entry_id": "062e4040-133b-3849-a88e-db77550441fb",
                                        "glosses": [
                                            "Synonym of midafternoon: the time around or following noon or nones."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab4349a-08f5-4f94-8306-73b0d0c004c1",
                                                "sense_id": "f92cd1c7-c967-3b9f-a57f-674b878859b1",
                                                "text": "None of the day, is the third quarter of the day beginning at Noon and lasting till the Sun be gone half way towards setting."
                                            },
                                            {
                                                "example_id": "03b2adb6-05d3-45ea-969e-330dd7ea0b79",
                                                "sense_id": "f92cd1c7-c967-3b9f-a57f-674b878859b1",
                                                "text": "The last, which began at the middle of the Afternoon, i.e. at half the Time between Noon and Sun-setting, was called None, because it began at the Ninth Hour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
