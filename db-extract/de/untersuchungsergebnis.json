                    {
                        "sense_id": "eb639ec9-c642-3183-a34e-15cb550d9541",
                        "entry_id": "6aac6a4e-f97c-3682-b900-cc16d67e0697",
                        "glosses": [
                            "Ergebnis, das aufgrund einer erfolgreichen Untersuchung zustande gekommen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6cd91c6-f759-485d-abb0-34dad98bb862",
                                "sense_id": "eb639ec9-c642-3183-a34e-15cb550d9541",
                                "text": "„Und mit dieser Möglichkeit mußte er aufgrund der letzten Untersuchungsergebnisse rechnen.“"
                            },
                            {
                                "example_id": "1ed19678-d144-4aa1-8517-477b097c34b7",
                                "sense_id": "eb639ec9-c642-3183-a34e-15cb550d9541",
                                "text": "„Mein Gesicht war immer noch nass von der verregneten Landpartie und kurz war ich besorgt, ob die Tropfen auf meiner Stirn eventuell zu einer Verfälschung des Untersuchungsergebnisses führen könnten.“"
                            }
                        ],
