                                        "entry_id": "87d21fd0-9da4-3233-b8fd-4d2e0bd843b2",
                                        "glosses": [
                                            "South Korean pop music influenced by Western styles."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74292d67-d7d0-4dc2-81b4-4148d5b26992",
                                                "sense_id": "635f40f2-b157-311a-b128-066a6fb96c8f",
                                                "text": "Somehow, even I got sucked into this strange K-pop universe. Sure, the quality of the music is sometimes debatable."
                                            },
                                            {
                                                "example_id": "c86fc1ad-1082-425c-8d97-c82310d1e745",
                                                "sense_id": "635f40f2-b157-311a-b128-066a6fb96c8f",
                                                "text": "The K-pop septet BTS will return in spring 2026 with a new album and world tour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
