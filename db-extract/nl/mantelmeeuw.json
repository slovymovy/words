                "senses": [
                    {
                        "sense_id": "06cb1fbd-5992-39b9-8a22-774510ab780d",
                        "entry_id": "ae52f5b7-cec6-3f2a-bd38-f8d75e94f5dd",
                        "glosses": [
                            "benaming voor twee soorten meeuwen met een donkere rug en vleugels"
                        ],
                        "tags": [
                            "steltloperachtigen"
                        ],
                        "examples": [
                            {
                                "example_id": "15e5fbad-963e-4a25-a1dd-6202b1bcb5b9",
                                "sense_id": "06cb1fbd-5992-39b9-8a22-774510ab780d",
                                "text": "Van meeuwen verdelgen kan geen sprake zijn, reageert Vogelbescherming Vlaanderen. Want zowel de (veel voorkomende) zilvermeeuw als de kleine mantelmeeuw is een beschermde diersoort."
                            },
                            {
                                "example_id": "b7d6bff0-b8c8-48f1-a9fc-04eadf7fb145",
                                "sense_id": "06cb1fbd-5992-39b9-8a22-774510ab780d",
                                "text": "De Feugelpôlle is een van een handvol plekken in Nederland waar de grote stern nestelt. De witte vogels met hun zwarte punkkapsel zitten altijd tussen de kokmeeuwen omdat die hun territorium fel verdedigen tegen rovende zilvermeeuwen en mantelmeeuwen."
                            }
                        ]
                    }
