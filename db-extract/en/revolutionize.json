                                                "sense_id": "1c3d9c2a-9793-3e55-8892-d448bc88d89e",
                                                "text": "Mit dem neuen Automodell wird der Markt revolutioniert."
                                            },
                                            {
                                                "example_id": "96c81b79-ed34-4705-b201-030ed8ec1ebf",
                                                "sense_id": "1c3d9c2a-9793-3e55-8892-d448bc88d89e",
                                                "text": "„Wikipedia hat den Zugang zum Weltwissen revolutioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ad43f8f-13b4-35ff-adc4-edcee1c7a847",
                                        "entry_id": "389fc470-8807-368f-a015-222830b84e75",
                                        "glosses": [
                                            "Menschen auf einen Umsturz vorbereiten, sie dafür begeistern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2aed632-7f65-42ac-9c8b-b6f1e98456f0",
                                                "sense_id": "6ad43f8f-13b4-35ff-adc4-edcee1c7a847",
                                                "text": "„War sie trunken vom Glauben, die kleine Gruppe der Spartakisten könne die Massen revolutionieren, die Regierung ablösen und den Krieg, der ein verlorener war, beenden?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "10522a3f-586e-3aad-a873-81f196759b6c",
                                        "entry_id": "389fc470-8807-368f-a015-222830b84e75",
                                        "glosses": [
                                            "an einer Bewegung zum Umsturz in den politischen Gefügen (Revolution) teilnehmen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9999dfb0-9a11-4187-bace-b005d16901b2",
                                                "sense_id": "10522a3f-586e-3aad-a873-81f196759b6c",
                                                "text": "„Doch die wertvollsten Verfassungsreformen waren nur ein Rückgreifen auf alte, nunmehr besser verstandene Grundsätze; selbst wenn das Volk revolutionierte, tat es dies nie aus dem Verlangen nach einer neuen Ordnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
