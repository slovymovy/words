                                        "sense_id": "f9ef807c-ca46-3967-9305-d3adc7c14f52",
                                        "entry_id": "0b1f47bd-fd21-3853-834b-53b110f4ae9d",
                                        "glosses": [
                                            "scheikundig element met symbool I en atoomnummer 53 Het is een violet- donkergrijs halogeen"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c085a53-6ace-473b-9cc0-44422de5ed36",
                                                "sense_id": "f9ef807c-ca46-3967-9305-d3adc7c14f52",
                                                "text": "Jodium hebben we nodig voor een goed werkende schildklier, een belangrijke regelaar van onze stofwisseling en hormoonhuishouding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d89c8a78-007f-4d90-813a-3d0be8e38522",
                        "source_entry_id": "3d8b3ee3-5d76-3c60-b72c-1459241aa20d",
                        "source_sense_description": "химический элемент и вещество",
                        "target_lang_word": "jod",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jod",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "1111f02e-ea47-3d59-91b4-df472c61539e",
                                        "entry_id": "2b029fe8-140a-3f7e-bb0d-121653cf4f5d",
                                        "glosses": [
                                            "pierwiastek chemiczny o symbolu I i liczbie atomowej 53"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48defcf4-2d6d-4164-bd43-9e5b50c1f8dd",
                                                "sense_id": "1111f02e-ea47-3d59-91b4-df472c61539e",
                                                "text": "Jakie właściwości chemiczne ma jod?"
                                            },
                                            {
                                                "example_id": "fc8aad28-f4c7-4bf2-b3f2-6c6325083ee6",
                                                "sense_id": "1111f02e-ea47-3d59-91b4-df472c61539e",
                                                "text": "Jajka, a głównie żółtka, zawierają dużo składników przeciwmiażdżycowych - nienasyconych kwasów tłuszczowych, siarki, choliny, jodu."
                                            },
                                            {
                                                "example_id": "08989030-8636-4189-8a33-0ef66e90b1ec",
                                                "sense_id": "1111f02e-ea47-3d59-91b4-df472c61539e",
                                                "text": "— Powietrze jest tam przesycone minerałami, mikroelementami oraz jodem, bromem i magnezem — wyjaśnia Małgorzata Sidor z iwonickiego Zakładu Przyrodniczo-Leczniczego."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "803667e5-159d-4089-94b1-f49c05092e2a",
                        "source_entry_id": "3d8b3ee3-5d76-3c60-b72c-1459241aa20d",
