                    {
                        "sense_id": "7a67ad52-215e-32de-ac78-a167cb17f71c",
                        "entry_id": "4e5e7d9d-7d34-3362-bce8-54c79878890f",
                        "glosses": [
                            "Untersuchung, durch welche die körperliche und geistige Eignung der untersuchten Person für einen bestimmten Zweck festgestellt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3116553b-da3b-402d-b706-00ec08311ce9",
                                "sense_id": "7a67ad52-215e-32de-ac78-a167cb17f71c",
                                "text": "„Weil die Beurteilungspraxis der für die Tauglichkeitsuntersuchung von Zivildienern herangezogenen Amtsärzte uneinheitlich sei, soll die Überprüfung künftig ebenfalls durch das Verteidigungsministerium erfolgen.“"
                            },
                            {
                                "example_id": "2e7a8240-5028-4644-ba2f-274c313b29b5",
                                "sense_id": "7a67ad52-215e-32de-ac78-a167cb17f71c",
                                "text": "„Mindestens ein Mal im Jahr müssen sich Piloten erneut der Tauglichkeitsuntersuchung unterziehen - unter bestimmten Voraussetzungen sogar alle sechs Monate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
