                        "sense_id": "b84e0796-86e4-3a39-824b-e09b33f0e6c3",
                        "entry_id": "d82ee1c0-3734-349d-8f3b-4b14fe84adf3",
                        "glosses": [
                            "Resembling a cavern in size, shape, or atmosphere.",
                            "Giving the impression of vast, dark depths."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00c0aca6-1359-4d3f-843a-87193d4204b3",
