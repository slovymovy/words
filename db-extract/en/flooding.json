                "translations": [
                    {
                        "translation_id": "1e8b3b93-4395-4035-b3db-2c0bf251fcba",
                        "source_entry_id": "c5ddafbf-6592-36c1-bbdd-d958d8a628f5",
                        "source_sense_description": "act of flooding",
                        "target_lang_word": "inondation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inondation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d390c05-695a-3b7d-be9f-324a47253188",
                                        "entry_id": "4b8f1390-b0b2-3894-a81d-efdc7dc6e866",
                                        "glosses": [
                                            "Débordement d’un cours d’eau, ou accumulation d’eaux de ruissellement, qui submerge temporairement une zone normalement hors d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e4348a-a4d9-441f-b154-16b109dba8d5",
                                                "sense_id": "5d390c05-695a-3b7d-be9f-324a47253188",
                                                "text": "En janvier 1970, les inondations ont été particulièrement terribles et les inondés de 1967 de Loures (48 familles), lassés de vivre depuis trois ans dans des baraques, sont allés occuper un quartier d’Odivelas avec la sympathie populaire, sinon officielle."
                                            },
                                            {
                                                "example_id": "bfa8ec6a-2bd0-4a9d-b678-3399ab662ad6",
                                                "sense_id": "5d390c05-695a-3b7d-be9f-324a47253188",
                                                "text": "Si par malheur les crues de l’Ourthe coïncidaient avec celles de la Meuse, des inondations catastrophiques affectaient toute la vallée en aval de Liège."
                                            },
                                            {
                                                "example_id": "b6bb857a-9d73-4855-ab7e-28ad1a4db418",
                                                "sense_id": "5d390c05-695a-3b7d-be9f-324a47253188",
                                                "text": "Pour les années de crue moyenne (comme 1992), la crue contribue à l’inondation des plaines par phénomène de débordements successifs de seuils après sortie du lit mineur."
                                            },
                                            {
                                                "example_id": "7c0b2160-227d-4c66-9f31-4d9648ffb252",
                                                "sense_id": "5d390c05-695a-3b7d-be9f-324a47253188",
                                                "text": "Les zones humides ont la capacité de retenir l’eau, de la stocker et ainsi de limiter les crues et inondations."
                                            },
                                            {
                                                "example_id": "08fe4c47-6969-4349-8590-33b4b5dab028",
                                                "sense_id": "5d390c05-695a-3b7d-be9f-324a47253188",
                                                "text": "En cas d’inondation, on pourrait penser que l’eau est abondante, mais ce n’est pas le cas : « Elle contient des eaux usées, des déchets, des produits chimiques nocifs et des bactéries qui sont à l’origine de nombreux problèmes de santé », explique Jim Cobb, auteur du Prepper’s Long-Term Survival Guid (« Guide de survie à long terme à l’usage des préparateurs » en français)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a633b1-af9d-3b75-8857-6196103cbe54",
                                        "entry_id": "4b8f1390-b0b2-3894-a81d-efdc7dc6e866",
                                        "glosses": [
                                            "Tendre une inondation, Lâcher les eaux autour d’une place, d’une position, pour empêcher les approches de l’ennemi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60f7b2fc-83e6-363a-830d-a6fa955d616e",
                                        "entry_id": "4b8f1390-b0b2-3894-a81d-efdc7dc6e866",
                                        "glosses": [
                                            "Les eaux débordées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "474507c4-de5c-4886-b3d9-26edef5a8c85",
                                                "sense_id": "60f7b2fc-83e6-363a-830d-a6fa955d616e",
                                                "text": "L’inondation couvrait une immense étendue de pays."
                                            },
                                            {
                                                "example_id": "2680e044-5547-408c-b421-ad79f8a44b8a",
                                                "sense_id": "60f7b2fc-83e6-363a-830d-a6fa955d616e",
                                                "text": "Il entra dans la place en passant à travers l’inondation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8176baa3-4e57-3fb5-89f0-faf5032bbf77",
                                        "entry_id": "4b8f1390-b0b2-3894-a81d-efdc7dc6e866",
                                        "glosses": [
                                            "Invasion d’un pays par une grande multitude de gens, d’une grande quantité de certaines choses."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ebdb42a-1449-4571-aec3-1fa53ef11d59",
                                                "sense_id": "8176baa3-4e57-3fb5-89f0-faf5032bbf77",
                                                "text": "Une grande inondation de barbares."
                                            },
                                            {
                                                "example_id": "ee4f6807-3343-43e7-b12f-45358fc3fd39",
                                                "sense_id": "8176baa3-4e57-3fb5-89f0-faf5032bbf77",
                                                "text": "Une inondation de pamphlets, de brochures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd53b49e-b127-46ce-a7c6-9df94345d6d7",
