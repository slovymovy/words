                    {
                        "sense_id": "4053d318-7531-39d5-8bd1-ce22b3b856d9",
                        "entry_id": "8f2f7960-ac3d-318e-84dd-9530578d3abb",
                        "glosses": [
                            "Fighting; contending; in conflict."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e25fb4f-b75d-4652-9b26-2fd481e8ace4",
                                "sense_id": "4053d318-7531-39d5-8bd1-ce22b3b856d9",
                                "text": "To eliminate conflicting movements at the busy Brighton Main Line station, Network Rail proposes to rebuild the station with two extra platforms (from six to eight) and a larger concourse."
                            }
                        ]
                    },
                    {
                        "sense_id": "34be334e-e39b-3307-8a88-d50a6cf00f3a",
                        "entry_id": "8f2f7960-ac3d-318e-84dd-9530578d3abb",
                        "glosses": [
                            "Being in opposition; contrary; contradictory."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64e803e2-4861-4659-8df2-37c815a79e20",
                                "sense_id": "34be334e-e39b-3307-8a88-d50a6cf00f3a",
                                "text": "in the absence of all conflicting evidence"
                            },
                            {
                                "example_id": "91dda46b-1218-4431-b23d-5a36b3132626",
                                "sense_id": "34be334e-e39b-3307-8a88-d50a6cf00f3a",
                                "text": "On the other hand, the more effective the current activation vector is in reactivating the conflicting information, the more likely the two conflicting pieces of information are to be coactivated."
                            },
                            {
                                "example_id": "5616b3a8-0a5e-47ee-b2bd-8bff483c2d55",
                                "sense_id": "34be334e-e39b-3307-8a88-d50a6cf00f3a",
                                "text": "Of Sally Brass, conflicting rumours went abroad. Some said with confidence that she had gone down to the docks in male attire, and had become a female sailor; others darkly whispered that she had enlisted as a private in the second regiment of Foot Guards, and had been seen in uniform, and on duty, to wit, leaning on her musket and looking out of a sentry-box in St james's Park, one evening."
                            }
                        ]
                    }
