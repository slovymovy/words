                "senses": [
                    {
                        "sense_id": "dc7a5cce-5905-36d8-854d-c4c6e3900aa5",
                        "entry_id": "b4b4c13c-624e-3cf8-a76d-a67e3bd203b2",
                        "glosses": [
                            "ehrenamtlicher studentischer Verein, der ein Programm zwischen Kneipe, Kulturangeboten, Disko und Partys bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b834add7-b186-417e-a0f4-f94415584292",
                                "sense_id": "dc7a5cce-5905-36d8-854d-c4c6e3900aa5",
                                "text": "„Annetta saß bereits eine halbe Stunde im bekannten Studentenklub und wollte ihren Abschluss des Studiums feiern.“"
                            },
                            {
                                "example_id": "279eaead-8b84-4574-865d-6f2fa4479212",
                                "sense_id": "dc7a5cce-5905-36d8-854d-c4c6e3900aa5",
                                "text": "„Studenten gründeten nach dem Kasseturm in Weimar den zweiten Studentenklub der DDR.“"
                            },
                            {
                                "example_id": "1ef3b19d-e8d5-4878-90e6-9730706b3091",
                                "sense_id": "dc7a5cce-5905-36d8-854d-c4c6e3900aa5",
                                "text": "„Überall im Land waren mittlerweile unabhängige Studentenklubs entstanden, in denen über die Zukunft Ungarns diskutiert wurde.“"
                            },
                            {
                                "example_id": "b548de15-d1a0-4d5f-a9df-41ac58b1d507",
                                "sense_id": "dc7a5cce-5905-36d8-854d-c4c6e3900aa5",
                                "text": "„In den Gewölben am Ostende der Brühlschen Terasse [sic!] hat seit 1968 Dresdens bekanntester Studentenklub Bärenzwinger seinen Sitz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
