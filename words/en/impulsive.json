{
    "word_family": [
        "impulse",
        "impulsion",
        "impulsive",
        "impulsively",
        "impulsiveness",
        "impulsivity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30839567-9ec8-3b9f-82e8-4dc42a5f6dbb",
                    "sense_definition": "Acting or done suddenly without careful thought or consideration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made an <w>impulsive</w> decision to quit her job and travel the world.",
                            "target_lang_translations": {
                                "ru": "Она приняла <w>импульсивное</w> решение бросить работу и отправиться путешествовать по миру."
                            }
                        },
                        {
                            "text": "Try to control your <w>impulsive</w> behavior before you regret what you said.",
                            "target_lang_translations": {
                                "ru": "Постарайся контролировать своё <w>импульсивное</w> поведение, пока не пожалел о сказанном."
                            }
                        }
                    ],
                    "synonyms": [
                        "hasty",
                        "precipitant",
                        "rash"
                    ],
                    "antonyms": [
                        "deliberate",
                        "cautious"
                    ],
                    "common_phrases": [
                        "impulsive decision",
                        "impulsive buyer",
                        "impulsive behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершаемый под влиянием внезапного побуждения, без предварительного обдумывания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "импульсивный",
                                "target_lang_sense_clarification": "склонный действовать по первому побуждению"
                            },
                            {
                                "target_lang_word": "порывистый",
                                "target_lang_sense_clarification": "действующий под воздействием внезапного порыва"
                            },
                            {
                                "target_lang_word": "спонтанный",
                                "target_lang_sense_clarification": "незапланированный, совершаемый без раздумий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4106048b-8d9d-3c06-a8ca-c62a79c4fccb",
                    "sense_definition": "Acting momentarily or by a sudden surge rather than continuously, especially relating to physical forces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collision delivered an <w>impulsive</w> force that pushed the vehicle off the road.",
                            "target_lang_translations": {
                                "ru": "Столкновение вызвало <w>ударную</w> силу, которая выбросила автомобиль с дороги."
                            }
                        },
                        {
                            "text": "Engineers must calculate both constant loads and sudden <w>impulsive</w> shocks on the bridge.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны рассчитывать как постоянные нагрузки, так и внезапные <w>импульсные</w> удары по мосту."
                            }
                        }
                    ],
                    "antonyms": [
                        "continuous"
                    ],
                    "common_phrases": [
                        "impulsive force",
                        "impulsive noise",
                        "impulsive load"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий кратковременно или скачкообразно, а не непрерывно (о физических силах или воздействиях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "импульсный",
                                "target_lang_sense_clarification": "о физической силе, нагрузке или сигнале"
                            },
                            {
                                "target_lang_word": "ударный",
                                "target_lang_sense_clarification": "о мгновенной механической силе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "822a9afb-a19a-3694-bc59-be8dd0f17e02",
                    "sense_definition": "Having the power to drive or impel forward; impelling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind acted as the primary <w>impulsive</w> power behind the historic sailing ship.",
                            "target_lang_translations": {
                                "ru": "Ветер служил основной <w>движущей</w> силой этого исторического парусника."
                            }
                        },
                        {
                            "text": "Curiosity remains the chief <w>impulsive</w> energy behind many scientific discoveries.",
                            "target_lang_translations": {
                                "ru": "Любопытство остаётся главной <w>побудительной</w> силой многих научных открытий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "impulsive power"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in this literal driving sense in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводящий в движение, побуждающий или толкающий вперед."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движущий",
                                "target_lang_sense_clarification": "о силе или энергии, побуждающей к движению"
                            },
                            {
                                "target_lang_word": "побудительный",
                                "target_lang_sense_clarification": "о мотиве или стимуле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "152660dd-7bec-33ac-baa0-1e2dacdead58",
                    "sense_definition": "A person whose personality or behavior is characterized by sudden, unplanned actions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was an incurable <w>impulsive</w> who spent his entire paycheck the day he received it.",
                            "target_lang_translations": {
                                "ru": "Он был неисправимым <w>импульсивным человеком</w>, который тратил всю зарплату в день её получения."
                            }
                        },
                        {
                            "text": "The group needed a calm planner rather than another restless <w>impulsive</w>.",
                            "target_lang_translations": {
                                "ru": "Группе требовался спокойный планировщик, а не очередной беспокойный <w>человек порыва</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, склонный действовать импульсивно и необдуманно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "импульсивный человек",
                                "target_lang_sense_clarification": "человек, склонный к необдуманным поступкам"
                            },
                            {
                                "target_lang_word": "человек порыва",
                                "target_lang_sense_clarification": "человек, действующий под влиянием эмоций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6463b6cf-b349-3c15-b080-0aeb2952d7f2",
                    "sense_definition": "Something that impels or provides an impulse; a driving motive or agent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fear was the primary <w>impulsive</w> that prompted the soldiers to retreat quickly.",
                            "target_lang_translations": {
                                "ru": "Страх стал главным <w>побуждением</w>, заставившим солдат быстро отступить."
                            }
                        },
                        {
                            "text": "Ambition served as an <w>impulsive</w> that drove his tireless pursuit of political office.",
                            "target_lang_translations": {
                                "ru": "Честолюбие служило <w>движущей силой</w>, подстегивавшей его неустанную борьбу за государственный пост."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used as a noun meaning an impelling force or motive."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Побудительная сила, толчок или движущий мотив."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побудительная сила",
                                "target_lang_sense_clarification": "движущий фактор"
                            },
                            {
                                "target_lang_word": "импульс",
                                "target_lang_sense_clarification": "внутренний или внешний толчок к действию"
                            },
                            {
                                "target_lang_word": "побуждение",
                                "target_lang_sense_clarification": "мотив к поступку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}