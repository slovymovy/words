                                        "entry_id": "907e4340-cf76-36b2-a753-52201835e7c5",
                                        "glosses": [
                                            "A subsequent brief recitement or enumeration of the major points in a narrative, article, or book."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449ae616-ad5e-4ad1-8c7b-08f097d1e556",
                                                "sense_id": "572c0212-78ac-37a9-8a48-6661e633e46d",
                                                "text": "The dolorous effects of the second world war on train services, and its protracted legacies of over-age equipment and shortages of material for replacement, are too fresh in memory to require recapitulation here; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c474c2-0001-381e-b5d0-0b7f2edd0e90",
                                        "entry_id": "907e4340-cf76-36b2-a753-52201835e7c5",
                                        "glosses": [
                                            "The third major section of a musical movement written in sonata form, representing thematic material that originally appeared in the exposition section."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
