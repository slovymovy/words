                "senses": [
                    {
                        "sense_id": "56e3efe2-da37-39fc-af9f-8507430623e9",
                        "entry_id": "2aaed9c4-de98-39b5-93e5-c94d8ca9f5c9",
                        "glosses": [
                            "Angehöriger eines untergegangenen baltischen Volkes in Prußen, dem späteren Ost- und Westpreußen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9640cff-8f63-471b-9bcc-92c35f6b210d",
                                "sense_id": "56e3efe2-da37-39fc-af9f-8507430623e9",
                                "text": "Er war Pruße, seine Frau Kurin."
                            },
                            {
                                "example_id": "fd4eaa73-06ae-4135-ad63-512d7008f0d1",
                                "sense_id": "56e3efe2-da37-39fc-af9f-8507430623e9",
                                "text": "Allgemein wird berichtet, die Prußen hätten keine Schrift gehabt."
                            },
                            {
                                "example_id": "8e414688-9bdd-48fd-8487-9886d1cfb059",
                                "sense_id": "56e3efe2-da37-39fc-af9f-8507430623e9",
                                "text": "„War der Orden im 13. Jahrhundert überwiegend mit Aufständen der Prußen beschäftigt, konzentrierte er sich im 14. Jahrhundert auf den Krieg jenseits der Grenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
