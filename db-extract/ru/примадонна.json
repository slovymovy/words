                                                "example_id": "e5aa0d42-4795-4cbd-87fa-0a36757b46fd",
                                                "sense_id": "b16aef71-cd1b-3be1-9bfb-575116395204",
                                                "text": "„Er brachte es nicht über sich, ins Publikum zu schauen, er konnte nicht einmal mit der Primadonna kommunizieren, die unablässig lächelte, um das Publikum für das Kommende einzunehmen.“"
                                            },
                                            {
                                                "example_id": "c65237e3-86a7-4b26-8a1d-8e9310e03126",
                                                "sense_id": "b16aef71-cd1b-3be1-9bfb-575116395204",
                                                "text": "„Ich dachte gleich, daß er der Kastrat war, der die Rolle der Primadonna im Theater von Ancona gespielt hatte, für das die gleichen Gesetze gelten wie in Rom.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
