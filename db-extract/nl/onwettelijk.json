                "senses": [
                    {
                        "sense_id": "783cd573-1c4f-3296-ad5a-1127ae6d4eaf",
                        "entry_id": "6a4095c6-a062-3e7c-94a3-744e709cf585",
                        "glosses": [
                            "zonder dat er een juridische onderbouwing voor is; strijdig met wettelijke bepalingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d07d24b4-be51-4cd6-bf27-7f198e264023",
                                "sense_id": "783cd573-1c4f-3296-ad5a-1127ae6d4eaf",
                                "text": "Ook nu wordt er flink gedemonstreerd in Hongkong. Eerder deze week zijn al twintig activisten gearresteerd. Activiste Chan pleit als voormalig advocaat voor hun vrijlating. \"Het onwettelijk vasthouden van mensen is onacceptabel in Hongkong, dus ik dring er op aan om ze zo snel mogelijk vrij te laten.\""
                            },
                            {
                                "example_id": "ad1a66f3-db92-4f82-9bcd-8231a822b3d1",
                                "sense_id": "783cd573-1c4f-3296-ad5a-1127ae6d4eaf",
                                "text": "En dat is \"onwettelijk\", zegt vakbond CNV, die het proces financieel ondersteunt. Zo heeft de OR geen advies kunnen geven over nieuwe arbeidsvoorwaarden."
                            }
                        ]
                    }
