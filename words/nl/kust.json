                {
                    "sense_id": "f094b14f-2a29-3640-94ab-10823e41d5b1",
                    "sense_definition": "De omgeving of situatie, specifiek gebruikt om aan te geven dat er geen gevaar dreigt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coast_idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wachtte een paar minuten tot de <w>kust</w> echt veilig was.",
                            "target_lang_translations": {
                                "en": "I waited a few minutes until the <w>coast</w> was truly clear.",
                                "ru": "Я подождал пару минут, пока <w>горизонт</w> не стал действительно чист.",
                                "pl": "Odczekałem kilka minut, aż <w>teren</w> będzie naprawdę czysty.",
                                "de": "Ich wartete ein paar Minuten, bis die <w>Luft</w> wirklich rein war.",
                                "fr": "J'ai attendu quelques minutes jusqu'à ce que la <w>voie</w> soit vraiment libre.",
                                "it": "Ho aspettato qualche minuto finché non c'era davvero <w>via libera</w>.",
                                "cs": "Počkal jsem několik minut, dokud nebyl <w>vzduch</w> opravdu čistý.",
                                "tr": "<w>Ortalık</w> gerçekten sakinleşene kadar birkaç dakika bekledim.",
                                "es": "Esperé unos minutos hasta que <w>no hubo moros en la costa</w> de verdad."
                            }
                        },
                        {
                            "text": "De inbrekers controleerden of de <w>kust</w> veilig was voordat ze naar binnen gingen.",
                            "target_lang_translations": {
                                "en": "The burglars checked if the <w>coast</w> was clear before they went inside.",
                                "ru": "Грабители проверили, свободен ли <w>путь</w>, прежде чем войти внутрь.",
                                "pl": "Włamywacze sprawdzili, czy <w>droga</w> jest wolna, zanim weszli do środka.",
                                "de": "Die Einbrecher überprüften, ob die <w>Luft</w> rein war, bevor sie hineingingen.",
                                "fr": "Les cambrioleurs ont vérifié si la <w>voie</w> était libre avant d'entrer.",
                                "it": "I ladri hanno controllato che la <w>strada fosse libera</w> prima di entrare.",
                                "cs": "Zloději zkontrolovali, zda je <w>vzduch</w> čistý, než vešli dovnitř.",
                                "tr": "Hırsızlar içeri girmeden önce <w>etrafın</w> güvenli olup olmadığını kontrol ettiler.",
                                "es": "Los ladrones comprobaron si <w>el camino estaba despejado</w> antes de entrar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de kust is veilig"
                    ],
                    "target_lang_definitions": {
                        "en": "The surroundings or situation, specifically used to indicate that there is no danger.",
                        "ru": "Обстановка или ситуация, когда нет опасности (обычно в идиоме \"de kust is veilig\").",
                        "pl": "Otoczenie lub sytuacja, używane szczególnie do wskazania, że nie ma niebezpieczeństwa.",
                        "de": "Die Umgebung oder Situation, speziell verwendet, um auszudrücken, dass keine Gefahr droht.",
                        "fr": "L'environnement ou la situation, spécifiquement utilisé pour indiquer qu'il n'y a pas de danger.",
                        "it": "L'ambiente o la situazione, usato specificamente per indicare che non c'è pericolo.",
                        "cs": "Okolí nebo situace, konkrétně používané k vyjádření, že nehrozí žádné nebezpečí.",
                        "tr": "Herhangi bir tehlikenin olmadığını belirtmek için kullanılan çevre veya durum.",
                        "es": "El entorno o situación, usado específicamente para indicar que no hay peligro."
                    },
