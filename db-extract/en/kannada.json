                                            {
                                                "example_id": "a2719d08-a7b4-4d00-a8a2-a70e80176925",
                                                "sense_id": "bc77fad3-cac2-386a-95be-857648bb5322",
                                                "text": "Nach Anzahl der Sprecher steht Kannada an achter Stelle der Sprachen Indiens."
                                            },
                                            {
                                                "example_id": "ee6e792d-91d6-4ccd-aed1-1a652718c20a",
                                                "sense_id": "bc77fad3-cac2-386a-95be-857648bb5322",
                                                "text": "„Wie viele indische Sprachen verfügt Kannada über eine eigene Schrift, die Kannada-Schrift.“"
                                            }
                                        ],
