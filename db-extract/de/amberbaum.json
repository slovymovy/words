                                        "glosses": [
                                            "The tree itself, or any other species of the genus Liquidambar, also called sweetgum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eaa4a0a-95be-4abe-8fd5-0c35abe19cb7",
                                                "sense_id": "135c1203-761e-37e3-9d63-126923292591",
                                                "text": "Liquidambar maintains a European foothold in a small area of southwestern Turkey."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ecd643c-e662-4327-a928-0a83d2437909",
                        "source_entry_id": "77f2b878-d5b7-30e3-b494-8c96299887a1",
                        "source_sense_id": "c3846a64-fb3a-3aa2-a983-50ee9a8b37e6",
                        "source_sense_description": "hoher, laubabwerfender Baum, der in Nord- und Mittelamerika sowie in Kleinasien vorkommt",
                        "target_lang_word": "liquidambar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liquidambar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2334896-6b6a-38d7-91b8-de8ff4cd7167",
                                        "entry_id": "79e263f0-fcac-33af-a31c-b3af647d62d3",
                                        "glosses": [
                                            "Genre d’arbres à feuilles caduques de la famille des Hamamélidacées composé de quatre espèces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1924d966-6b90-4d75-b0d8-b6fca8b6fb83",
                                                "sense_id": "d2334896-6b6a-38d7-91b8-de8ff4cd7167",
                                                "text": "Des gisements célèbres du Groenland ont été étudiés par Heer. On y trouvait Noisetiers, Magnolias, Liquidambars, Vignes, Platanes, et des Conifères comme les Cyprès chauves."
                                            },
                                            {
                                                "example_id": "b4a3ec95-6bb0-4965-a7a2-de96e8692bcc",
                                                "sense_id": "d2334896-6b6a-38d7-91b8-de8ff4cd7167",
                                                "text": "Aurore d’eau fraîche et de miel. Blanche respiration des troupeaux. Dans les liquidambars, les cenzontles chantaient. La fleur des verveines allait éclater…"
                                            },
                                            {
                                                "example_id": "3bdbefff-cbff-48f6-ae8b-04e75fc677da",
                                                "sense_id": "d2334896-6b6a-38d7-91b8-de8ff4cd7167",
                                                "text": "Le liquidambar a été introduit en 1681 en Europe où il est aujourd’hui très répandu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72156d67-7eae-3550-b04f-c0fdbced3b05",
                                        "entry_id": "79e263f0-fcac-33af-a31c-b3af647d62d3",
                                        "glosses": [
                                            "Baume sécrété par cet arbre et utilisé autrefois dans la fabrication de certains vernis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450c9227-2e8a-4f52-8e90-104d4a805f24",
                                                "sense_id": "72156d67-7eae-3550-b04f-c0fdbced3b05",
                                                "text": "… ce baume liquide qui se sépare, par le repos, en deux parties connues sous le nom de liquidambar liquide ou huile de liquidambar et de liquidambar mou ou blanc. Ce dernier seul sert dans la fabrication des vernis à l'alcool."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
