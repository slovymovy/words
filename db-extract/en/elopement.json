        "fr-extract.jsonl": [
            {
                "entry_id": "c23dd5a5-16b8-34d7-bbab-c1d9b518eae0",
                "word": "elopement",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8acbfa35-5f05-48a2-8c64-61511abfef9a",
                        "entry_id": "c23dd5a5-16b8-34d7-bbab-c1d9b518eae0",
                        "tags": [
                            "plural"
                        ],
                        "form": "elopements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e4dd5b2-f0ea-3939-a261-c09076d3063d",
                        "entry_id": "c23dd5a5-16b8-34d7-bbab-c1d9b518eae0",
                        "glosses": [
                            "Escapade avec son amant ou sa maitresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa029ec5-1dc3-4db7-83dc-fe3bfbb02b43",
                                "sense_id": "0e4dd5b2-f0ea-3939-a261-c09076d3063d",
                                "text": "…and Julia's elopement, the additional blow which had met him on his arrival in London, though its force had been deadened at the moment, must, she knew, be sorely felt.",
                                "translation": "…et l’évasion de Julia était venue porter le dernier coup au cœur paternel de sir Thomas."
                            },
                            {
                                "example_id": "22385330-f3cb-4584-ac0b-0d2f6cc38345",
                                "sense_id": "0e4dd5b2-f0ea-3939-a261-c09076d3063d",
                                "text": "A hundred various schemes were alternately fixed upon and rejected, as the difficulties of each preponderated in their minds; and the dread of losing Emily for ever, induced her lover to urge an elopement with him. To this proposition she returned a decided negative; but when the period of parting arrived, and she felt that she might be sacrificing herself to a life of misery and despair, she promised that, should no fortunate circumstance occur to induce her mother to sacrifice her love of rank to her daughter’s happiness, she would finally consent to leave her father’s roof for the protection of a husband’s arms."
                            }
                        ]
                    },
                    {
                        "sense_id": "617ba72d-b3f6-3221-8c80-344952bef653",
                        "entry_id": "c23dd5a5-16b8-34d7-bbab-c1d9b518eae0",
                        "glosses": [
                            "Élopement, mariage intimiste."
                        ],
                        "tags": [
                            "Famille"
                        ],
                        "examples": [
                            {
                                "example_id": "c6cba5ed-f3ad-47e9-9913-24467bbc5443",
                                "sense_id": "617ba72d-b3f6-3221-8c80-344952bef653",
                                "text": "Elopement is a marriage which is conducted in a sudden and secretive fashion, sometimes involving a hurried flight away from one's place of residence together with one’s beloved with the intention of getting married without parental approval."
                            }
                        ]
                    }
