                "senses": [
                    {
                        "sense_id": "cdb6f9e7-d4d6-3422-b6bc-a27d64119017",
                        "entry_id": "d1b6c254-d30c-33d3-8688-0fb60f0e3127",
                        "glosses": [
                            "подвергать (подвергнуть) кремации; сжигать (сжечь) труп в специально оборудованной печи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea48049-1028-4c69-8452-a9dce4746f00",
                                "sense_id": "cdb6f9e7-d4d6-3422-b6bc-a27d64119017",
                                "text": "Там работают, там умирают, только их трупы вывозят и кремируют в наземных лагерях."
                            },
                            {
                                "example_id": "df210531-1998-4d7b-8f52-d15974c6b2cc",
                                "sense_id": "cdb6f9e7-d4d6-3422-b6bc-a27d64119017",
                                "text": "Некоторым из них приходится кремировать умерших, вместо того, чтобы закапывать их в землю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c04cf1da-40d0-4196-a066-45d2764cbec0",
                        "source_entry_id": "d1b6c254-d30c-33d3-8688-0fb60f0e3127",
                        "source_sense_id": "cdb6f9e7-d4d6-3422-b6bc-a27d64119017",
