                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pentakaidecahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05ddb67c-bc5e-39ef-94ae-327949fef423",
                                        "entry_id": "1619d2a9-e553-396a-873f-4eb09bfe87ee",
                                        "glosses": [
                                            "Synonym of pentadecahedron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318e088e-69d4-4fc8-9908-1abe9768440f",
                                                "sense_id": "05ddb67c-bc5e-39ef-94ae-327949fef423",
                                                "text": "The lacunar pattern of this grain therefore includes six tetragonal and nine hexagonal faces. Relating this to polyhedrons, we find that no pentakaidecahedron with such a combination of faces can exist (see page 199)."
                                            },
                                            {
                                                "example_id": "4176ddcf-aca7-4cd9-b824-869ffbb0e31f",
                                                "sense_id": "05ddb67c-bc5e-39ef-94ae-327949fef423",
                                                "text": "The host structure is similar to that of the (n–C₄H₉)₄ N⁺C₆H₅COOH⁻·39.5 H₂O consisting of a tetragonal body-centered arrangement of groups of five face-sharing pentagonal dodecahedra interlinked by tetrakaidecahedra and pentakaidecahedra."
                                            },
                                            {
                                                "example_id": "1f9ef8d4-9fc8-4a13-8c0d-9f941ab453d1",
                                                "sense_id": "05ddb67c-bc5e-39ef-94ae-327949fef423",
                                                "text": "An ideal unit cell consists of ten dodecahedrons, sixteen tetrakaidecahedrons and four pentakaidecahedrons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
