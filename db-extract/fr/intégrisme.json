                        "entry_id": "c01fd23a-a861-3f9e-85ca-6626aca84c03",
                        "glosses": [
                            "Volonté d’appliquer une doctrine dans son intégralité et sans jamais la remettre en question."
                        ],
                        "tags": [],
                        "examples": []
                    }
