                        "source_entry_id": "8900f49c-0331-32a2-9817-9503d107a037",
                        "source_sense_id": "4c2f9aa5-4ee7-3062-b867-a2398799e430",
                        "target_lang_word": "spite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                        "entry_id": "52613071-e410-3026-82b9-e9b45a5dbfe3",
                                        "glosses": [
                                            "Ill will or hatred toward another, accompanied with the desire to unjustifiably irritate, annoy, or thwart; a want to disturb or put out another; mild malice"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d44c1d7-f746-4e56-9bc3-7cf1227d684c",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "He was so filled with spite for his ex-wife, his brother was afraid of what he might do."
                                            },
                                            {
                                                "example_id": "cac032a3-e3f3-4b5c-a101-373144c458c7",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "They did it just for spite."
                                            },
                                            {
                                                "example_id": "4c852062-f663-4fc8-b533-aa620efafd2b",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "This is the deadly spite that angers."
                                            },
                                            {
                                                "example_id": "97f3e3a7-ca15-40da-b2b4-2506dffae4aa",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "Out of spite, the human beings pretended not to believe that it was Snowball who had destroyed the windmill: they said that it had fallen down because the walls were too thin."
                                            },
                                            {
                                                "example_id": "ec6194d0-2442-4d3c-92f1-443eafde358f",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "sex with older men was a way to both internalize my spite towards my mother and to find security in a father figure I lacked with my own father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0636b4f2-f483-305c-8624-d6e6dcce5b53",
                                        "entry_id": "52613071-e410-3026-82b9-e9b45a5dbfe3",
                                        "glosses": [
                                            "Vexation; chagrin; mortification."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb48490-a3a2-45aa-93d5-a7fa80b0c2c4",
                                                "sense_id": "0636b4f2-f483-305c-8624-d6e6dcce5b53",
                                                "text": "\"The time is out of joint: O cursed spite.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93f44a66-7ec8-3cb1-b07e-7e616d59f5cc",
                                        "entry_id": "69b388a9-01dd-34b5-b069-461d5da13803",
                                        "glosses": [
                                            "To treat maliciously; to try to hurt or thwart."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9626b14c-8854-4db0-8e93-b78d87c767af",
                                                "sense_id": "93f44a66-7ec8-3cb1-b07e-7e616d59f5cc",
                                                "text": "She soon married again, to spite her ex-husband."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbfa1852-b390-35fb-9376-9a2e5e0cecfb",
                                        "entry_id": "69b388a9-01dd-34b5-b069-461d5da13803",
                                        "glosses": [
                                            "To be angry at; to hate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c38f1e43-2cda-4efd-b30a-8b83aa3184fd",
                                                "sense_id": "fbfa1852-b390-35fb-9376-9a2e5e0cecfb",
                                                "text": "The Danes, then […] pagans, principally spited places of religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad5b6ea-23da-3894-b977-baf98fe7e5bd",
                                        "entry_id": "69b388a9-01dd-34b5-b069-461d5da13803",
                                        "glosses": [
                                            "To fill with spite; to offend; to vex."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01196f68-0e88-49ea-9c8b-ca6335b87433",
                                                "sense_id": "3ad5b6ea-23da-3894-b977-baf98fe7e5bd",
                                                "text": "But the laſt and fatal Blow, given to that antient Learning, was in the time of Darius, Father of Xerxes, who with the reſt of the Perſians, ſpighted at the Magi, upon the Uſurpation of the Crown by one of their Number, (that counterfeited a younger Son of Cyrus after the Death of Cambyſes,) when he came to be ſetled in that Throne, endeavour'd to aboliſh, not only their Learning and Credit, but their Language too, by changing the old Aſſyrian Characters, and introducing thoſe of Perſia, which grew to be the common Uſe of that whole Empire."
                                            }
                                        ]
                                    }
                                ]
