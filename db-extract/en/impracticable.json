                ],
                "senses": [
                    {
                        "sense_id": "6ec88556-0152-31be-adbe-0c6baa648069",
                        "entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                        "glosses": [
                            "Not practicable; impossible or difficult in practice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b093fe0-df5b-418a-b5d4-7e193b2a0c27",
                                "sense_id": "6ec88556-0152-31be-adbe-0c6baa648069",
                                "text": "It has not been used for many years, and although it was impracticable to photograph the engine in the small confines of the shed it was possible to obtain a picture of the plate which it still carries showing the former ownership."
                            },
                            {
                                "example_id": "ce862f6b-535a-4213-902a-16cd1117c692",
                                "sense_id": "6ec88556-0152-31be-adbe-0c6baa648069",
                                "text": "Prison abolitionists are dismissed as utopians and idealists whose ideas are at best unrealistic and impracticable, and, at worst, mystifying and foolish. This is a measure of how difficult it is to envision a social order that does not rely on the threat of sequestering people in dreadful places designed to separate them from their communities and families."
                            }
                        ]
                    },
                    {
                        "sense_id": "93c537e2-36bb-39bf-b406-9ddb7d51cf17",
                        "entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                        "glosses": [
                            "impassable (of a passage or road)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7215727f-969f-3c2d-b9d3-eba548992f0d",
                        "entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                        "glosses": [
                            "unmanageable"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ad881f95-9846-444b-be27-a6783a899312",
                                "sense_id": "7215727f-969f-3c2d-b9d3-eba548992f0d",
                                "text": "And yet this tough impracticable heart / Is govern'd by a dainty-finger'd girl ; […]"
                            },
                            {
                                "example_id": "73ce2bcd-4249-4c66-939d-9a704bbe371e",
                                "sense_id": "7215727f-969f-3c2d-b9d3-eba548992f0d",
                                "text": "H. is a person of extraordinary health & vigor, of unerring perception, & equal expression; and yet he is impracticable, and does not flow through his pen or (in any of our legitimate aqueducts) through his tongue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afb1a193-b0b8-4141-b854-0689a14773d8",
                        "source_entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                        "source_sense_description": "not practicable",
                        "target_lang_word": "onuitvoerbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onuitvoerbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "eadfe735-5d68-3e4d-9405-d66f9821455f",
                                        "entry_id": "fe42efb3-6612-3f09-8506-14c4e97ce346",
                                        "glosses": [
                                            "niet mogelijk om zo te doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd797445-b1aa-4c7f-8452-e3f317d1537e",
                                                "sense_id": "eadfe735-5d68-3e4d-9405-d66f9821455f",
                                                "text": "Deze opdrachten moet ik teruggeven want ze zijn voor mij onuitvoerbaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1796b3b-06ce-44bd-8fc4-72a7c94789d1",
                        "source_entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                        "source_sense_description": "not practicable",
                        "target_lang_word": "impraticable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impraticable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e41bf20-3a3c-37eb-b473-af93e490297f",
                                        "entry_id": "4a67753f-0b06-339f-a570-f5685a7909bc",
                                        "glosses": [
                                            "Qui ne peut se faire, s’exécuter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "860b1aa5-4134-406c-b908-5f6e71a904b8",
                                                "sense_id": "8e41bf20-3a3c-37eb-b473-af93e490297f",
                                                "text": "Deux systèmes sont en présence […]. Le premier est impraticable, le second donnerait lieu à des glissements qui iraient à l'encontre du but proposé."
                                            },
                                            {
                                                "example_id": "6fd25b1b-e966-4170-8a98-24b234472053",
                                                "sense_id": "8e41bf20-3a3c-37eb-b473-af93e490297f",
                                                "text": "Mais nous avons vu comment Saint Louis, poussé par ses convictions religieuses, voulut rendre l'usure impraticable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fabaed53-340e-3719-bd2e-19bed2d860cb",
                                        "entry_id": "4a67753f-0b06-339f-a570-f5685a7909bc",
                                        "glosses": [
                                            "Qualifie les lieux où l’on ne peut passer, où l’on ne passe qu’avec beaucoup de difficulté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be752640-222e-4071-afd0-36979b31fd51",
                                                "sense_id": "fabaed53-340e-3719-bd2e-19bed2d860cb",
                                                "text": "Le comte des Essarts , parti de Versailles le 9 Février, pour se rendre à sa terre des Essarts, ayant trouvé que la route de traverse de Damville aux Essarts étoit impraticable & dangereuse par la surabondance des neiges, se vit forcé de rester plusieurs jours à Damville chez le procureur fiscal."
                                            },
                                            {
                                                "example_id": "dbdbdccd-09e0-4e98-aaf2-d64090dc6d52",
                                                "sense_id": "fabaed53-340e-3719-bd2e-19bed2d860cb",
                                                "text": "Dumouriez le félicita et lui renouvela l'ordre de rendre la trouée de Noirval impraticable. Les paysans y vinrent avec des haches, des bêches et des pioches, creusèrent des tranchées et coupèrent les ponts de la Fournelle."
                                            },
                                            {
                                                "example_id": "6f81eb82-cbae-4309-af64-4cda2ea39e75",
                                                "sense_id": "fabaed53-340e-3719-bd2e-19bed2d860cb",
                                                "text": "Les terrains argileux de la Alcarria se transformèrent en fondrières, les pistes d’envol devinrent impraticables et la visibilité à peu près nulle."
                                            },
                                            {
                                                "example_id": "5c9f2969-22a0-4ddf-848e-22b326fb9a34",
                                                "sense_id": "fabaed53-340e-3719-bd2e-19bed2d860cb",
                                                "text": "Dans l'intérieur, qui paraissait impraticable, des routes se sont miraculeusement ouvertes, parcourues aussitôt par des automobiles."
                                            },
                                            {
                                                "example_id": "297d90e1-aab9-48da-a03d-a6524e6f2d0a",
                                                "sense_id": "fabaed53-340e-3719-bd2e-19bed2d860cb",
                                                "text": "La route est impraticable, l'eau du robinet terreuse, les draps de lit trempés, les habits champignonneux. Le lagon, habituellement bleu-vert transparent, devient marron à force de réceptionner la terre qui s'y déverse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c879dddb-9504-4ff9-b759-88fdd616a1cd",
                        "source_entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                        "source_sense_description": "not practicable",
                        "target_lang_word": "undurchführbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undurchführbar",
