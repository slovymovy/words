                "senses": [
                    {
                        "sense_id": "7e10f72b-aaaa-3b1b-90f1-07753b7b287d",
                        "entry_id": "4c98b9d5-9b87-399f-9f2b-71c86da7b931",
                        "glosses": [
                            "Optimiste considéré comme naïf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c16bdda-e463-4319-be8c-11b8276c9dce",
                                "sense_id": "7e10f72b-aaaa-3b1b-90f1-07753b7b287d",
                                "text": "Je hais ces idioptimistes. La situation de notre pays est cataclysmique.[…] Après-guerre, certains juifs disaient : « En 1940, les optimistes ont fini à Auschwitz, et les pessimistes à Hollywood. » Ils avaient raison : le monde appartient aux pessimistes."
                            },
                            {
                                "example_id": "9648d8e1-424a-45dd-8189-d2d53f7b89be",
                                "sense_id": "7e10f72b-aaaa-3b1b-90f1-07753b7b287d",
                                "text": "Cette attitude passéiste doit être revue – seuls les éternels idioptimistes s’accorderont à dire que le statu-quo doit être maintenu."
                            }
                        ]
                    }
                ],
