                                        "sense_id": "01548e76-e30d-3421-8c0a-e410f9905553",
                                        "entry_id": "f5a413f0-7dfc-3120-9f27-c61336511922",
                                        "glosses": [
                                            "Édifice qui entoure une cour fermée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f48b467-803f-4bc6-9dd0-323923191449",
                                                "sense_id": "01548e76-e30d-3421-8c0a-e410f9905553",
                                                "text": "Les marchés d’esclaves les plus importants étaient ceux de Fez et de Marrakech. Je n’ai vu que ce dernier. C’était un préau carré entouré d’un cloître."
                                            }
                                        ]
                                    }
