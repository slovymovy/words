                "senses": [
                    {
                        "sense_id": "390c3d06-e1ea-3cba-bf78-53d2828fa0ba",
                        "entry_id": "2e42efb4-5a5e-3968-b6a3-59bd414ea1b7",
                        "glosses": [
                            "Having the physical features of a male."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "77c31ce6-97de-4f91-8f9a-fea3aa697bd0",
                                "sense_id": "390c3d06-e1ea-3cba-bf78-53d2828fa0ba",
                                "text": "The character of the appendage is evidently the most reliable means of distinguishing species, but even this may vary in some instances, so that the number and arrangement of the antheridia and androphorous cells is not always a safe guide."
                            },
                            {
                                "example_id": "8e602b88-9f57-4b3a-af46-1822dea53ae5",
                                "sense_id": "390c3d06-e1ea-3cba-bf78-53d2828fa0ba",
                                "text": "The species is probably androphorous, as a number of individuals carry a much smaller individual adhering to the disc, in the same way as Mortensen (1936) has recorded for Astrochlamys bruneus Koehler."
                            },
                            {
                                "example_id": "449e50d4-3bb5-43a0-9ad9-f0bf3a45e67f",
                                "sense_id": "390c3d06-e1ea-3cba-bf78-53d2828fa0ba",
                                "text": "Fell (1958) suggested that A. waitei is androphorous, but examination of specimens carrying smaller ones on the disc—both dorsal and ventral sides—has shown that these are juveniles, not dwarf males (Fig. 8)."
                            }
                        ]
                    }
                ],
