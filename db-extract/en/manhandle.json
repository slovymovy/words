                                        "examples": [
                                            {
                                                "example_id": "af55765e-12ce-41df-acf2-6ad394220352",
                                                "sense_id": "148fe651-a6c1-3c34-9e98-8cfb479f7774",
                                                "text": "„Er war jetzt in dem Boot, doch davor war er im Ozean gewesen, bis zum Hals, und die Wellen waren über ihm zusammengeschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2936ec7b-a7d5-3406-afb4-d2673cef0467",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "schließen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ccc8036-579a-4d2e-95b4-5df114b5fe1f",
                                                "sense_id": "2936ec7b-a7d5-3406-afb4-d2673cef0467",
                                                "text": "„Das darf sie nicht auch noch vermasseln, hat schon Kaltenbronn versetzt, der in seiner Sitzecke bestimmt schon die Zeitung zusammengeschlagen und sich verabschiedet hat, während Siana ihn vermutlich aufzuhalten versuchte und ihm ein anderes Mädchen empfahl: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7bb42aeb-51ba-36f5-9d8f-8761c3652a60",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "aus Holz notdürftig konstruieren"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47fa274-8e93-4b13-9f0d-5f99c531f52a",
                                                "sense_id": "7bb42aeb-51ba-36f5-9d8f-8761c3652a60",
                                                "text": "„Komm her, du sollst diese Kiste zusammenschlagen; hier ist ein neuer Hammer für dich, er kostet zehn Groschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6430f2a-73fb-4141-bad8-00d4594dc903",
                        "source_entry_id": "9211cfaa-e8c2-39cd-928d-049dd3810968",
