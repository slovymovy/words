                    {
                        "translation_id": "b3c78cf5-1155-4849-9258-337e714ad48b",
                        "source_entry_id": "bb51d2aa-301c-3b8d-8936-cb1505e59811",
                        "source_sense_id": "aa117783-5ad2-3566-9332-03d40c8e3a8e",
                        "source_sense_description": "Extremely beautiful",
                        "target_lang_word": "восхитительный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "восхитительный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "93bf95f2-f85e-398a-be40-c24eaebbcee7",
                                        "entry_id": "90611c97-8540-3a52-b4e1-9d3629f775c1",
                                        "glosses": [
                                            "вызывающий восхищение, необычайно хороший"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec66d9d-3b9a-443b-83db-376fdd1b2ca2",
                                                "sense_id": "93bf95f2-f85e-398a-be40-c24eaebbcee7",
                                                "text": "Никогда ещё, кажется, не было такой восхитительной, такой дивной весны!"
                                            },
                                            {
                                                "example_id": "992e47d4-4d17-4572-85cb-b739508367b9",
                                                "sense_id": "93bf95f2-f85e-398a-be40-c24eaebbcee7",
                                                "text": "Она, как вы уже знаете, пела своим восхитительным контральто; он мастерски играл на скрипке."
                                            },
                                            {
                                                "example_id": "7c8e0752-742f-4196-bfbc-f6bfa3f1f24d",
                                                "sense_id": "93bf95f2-f85e-398a-be40-c24eaebbcee7",
                                                "text": "Она о чем-то расспрашивала, он что-то отвечал, сознавая только одно, что она опять около него, цветущая, красивая, чудная, восхитительная, как грёза поэта."
                                            },
                                            {
                                                "example_id": "f60be042-ed9b-45fe-a225-a8501bc3b5fb",
                                                "sense_id": "93bf95f2-f85e-398a-be40-c24eaebbcee7",
                                                "text": "От всех этих разговоров Анне Акимовне почему-то вдруг захотелось замуж, захотелось сильно, до тоски; кажется, полжизни и все состояние отдала бы, только знать бы, что в верхнем этаже есть человек, который для нее ближе всех на свете, что он крепко любит ее и скучает по ней; и мысль об этой близости, восхитительной, невыразимой на словах, волновала её душу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
