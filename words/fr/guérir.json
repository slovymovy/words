    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3db3b8a-5a7b-335a-adb7-381ec6f40deb",
                    "sense_definition": "Rendre la santé à quelqu'un ou faire disparaître une maladie, une blessure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament permet de <w>guérir</w> rapidement cette infection."
                        },
                        {
                            "text": "Le médecin espère <w>guérir</w> tous ses patients avant la fin du mois."
                        }
                    ],
                    "synonyms": [
                        "soigner"
                    ],
                    "antonyms": [
                        "infecter"
                    ],
                    "common_phrases": [
                        "guérir une maladie",
                        "guérir une blessure"
                    ]
                },
                {
                    "sense_id": "85610300-8990-3989-b5df-4dc864b0f434",
                    "sense_definition": "Recouvrer la santé, être débarrassé d'une affection ou d'une lésion corporelle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec beaucoup de repos, vous allez <w>guérir</w> sans difficulté."
                        },
                        {
                            "text": "Sa blessure au genou <w>guérit</w> très lentement après l'accident."
                        }
                    ],
                    "synonyms": [
                        "rétablir"
                    ],
                    "antonyms": [
                        "empirer",
                        "rechuter"
                    ],
                    "common_phrases": [
                        "guérir vite",
                        "guérir complètement"
                    ]
                },
                {
                    "sense_id": "27625268-fe8f-3b04-9ba6-2a650b1f32e5",
                    "sense_definition": "Délivrer ou se libérer d'une mauvaise habitude, d'une illusion ou d'un tourment moral.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette dure leçon va le <w>guérir</w> de sa trop grande naïveté."
                        },
                        {
                            "text": "Il tente de se <w>guérir</w> d'une vieille rancune qui le rongeait."
                        }
                    ],
                    "synonyms": [
                        "débarrasser",
                        "désillusionner"
                    ],
                    "common_phrases": [
                        "guérir de ses illusions",
                        "guérir d'un défaut"
                    ]
                }
            ]
        }
    ]
