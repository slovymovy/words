                                "ru": "Врач надеется <w>вылечить</w> всех своих пациентов до конца месяца.",
                                "nl": "De arts hoopt al zijn patiënten voor het einde van de maand te <w>genezen</w>.",
                                "de": "Der Arzt hofft, alle seine Patienten vor Ende des Monats zu <w>kurieren</w>.",
                                "pl": "Lekarz ma nadzieję <w>wyleczyć</w> wszystkich swoich pacjentów przed końcem miesiąca.",
                                "it": "Il medico spera di <w>guarire</w> tutti i suoi pazienti prima della fine del mese.",
                                "cs": "Lékař doufá, že všechny své pacienty <w>vyléčí</w> ještě před koncem měsíce.",
                                "tr": "Doktor, ay bitmeden tüm hastalarını <w>iyileştirmeyi</w> umuyor.",
                                "es": "El médico espera <w>curar</w> a todos sus pacientes antes de que acabe el mes.",
                                "zh": "医生希望在本月底前<w>治好</w>所有病人。"
                            }
