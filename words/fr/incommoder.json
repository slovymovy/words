            "senses": [
                {
                    "sense_id": "da47208e-225a-3866-be56-9439d4b19753",
                    "sense_definition": "Causer une gêne physique ou morale, troubler la tranquillité ou le confort de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gêne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La forte odeur de peinture commence à m'<w>incommoder</w> après plusieurs heures de travail."
                        },
                        {
                            "text": "Le bruit des travaux risque d'<w>incommoder</w> les voisins pendant toute la matinée."
                        }
                    ],
                    "synonyms": [
                        "déranger",
                        "gêner",
                        "importuner"
                    ],
                    "antonyms": [
                        "soulager",
                        "accommoder"
                    ],
                    "common_phrases": [
                        "incommoder les voisins"
                    ]
                },
                {
                    "sense_id": "112714e5-0082-3ac9-9a0e-b486a47161c1",
                    "sense_definition": "Provoquer une indisposition, un malaise physique ou une légère atteinte à la santé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malaise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs personnes ont été légèrement <w>incommodées</w> par la fumée lors de l'incendie."
                        },
                        {
                            "text": "Ce repas trop lourd l'a durablement <w>incommodé</w> pendant le reste de la journée."
                        }
                    ],
                    "synonyms": [
                        "indisposer"
                    ],
                    "common_phrases": [
                        "incommodé par la fumée",
                        "incommodé par les émanations"
                    ]
                },
                {
                    "sense_id": "33ba2419-9246-3f7b-a45c-2610401af1d4",
                    "sense_definition": "Gêner quelqu'un dans le fonctionnement normal d'un membre ou d'un organe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infirmité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis sa chute sur le trottoir verglacé, le vieil homme est fort <w>incommodé</w> d'un genou."
                        },
                        {
                            "text": "Une ancienne blessure sportive l'<w>incommode</w> du bras droit dès que l'humidité augmente."
                        }
                    ],
                    "synonyms": [
                        "handicaper",
                        "entraver"
                    ],
                    "common_phrases": [
                        "incommodé d'une jambe"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Usage vieilli pour désigner une infirmité ou une douleur corporelle."
                        }
                    ]
                },
                {
                    "sense_id": "473dd9fd-ae78-3836-845a-2fe67457e1ae",
                    "sense_definition": "Causer des embarras ou des revers de fortune, notamment sur le plan financier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "embarras matériel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La faillite inattendue de son associé l'a grandement <w>incommodé</w> dans ses affaires."
                        },
                        {
                            "text": "Sans appui financier pour soutenir ses projets, le marchand s'est trouvé rapidement <w>incommodé</w>."
                        }
                    ],
                    "synonyms": [
                        "gêner"
                    ],
                    "common_phrases": [
                        "incommodé dans ses affaires"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "S'emploie dans la langue classique pour signifier être gêné financièrement."
                        }
                    ]
                }
            ]
        }
