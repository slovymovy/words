                                            "zwrot lekceważący skierowany do młodszej od siebie osoby"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "depreciative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66677d1-ddc6-46ab-bd6e-c864bdddbb90",
                                                "sense_id": "44e006b3-78d0-32c9-ba42-3de40420e4f1",
                                                "text": "To dla pana, panie młody, są godziny urzędowe, nie dla mnie, a w ogóle proszę grzeczniej, kiedy nie wiesz pan, z kim pan gadasz."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
