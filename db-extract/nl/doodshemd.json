                "senses": [
                    {
                        "sense_id": "0c20d8ee-7969-368c-9292-46436c8123eb",
                        "entry_id": "b7c27a5d-6ee7-3f93-8966-b8d7f02bf4a9",
                        "glosses": [
                            "wijd uitlopend wit gewaad tot aan de enkels dat een dode draagt als men hem of haar begraaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635854ea-50f0-4b65-bd71-10275ccf687e",
                                "sense_id": "0c20d8ee-7969-368c-9292-46436c8123eb",
                                "text": "Snijders: \"Ik ken dit lied al heel lang, ik vond het in de bieb. Ik ken er geen uitvoering van. Ik las het en ik wist hoe het moest. Het legt zo eenvoudig mogelijk uit waarom oorlog altijd doorgaat: moeder breit een trui, vader doet zaken, zoon vecht en iedereen vindt dat normaal. Brecht beschreef een moeder die het doodshemd voor haar gesneuvelde zoon naait: Als ik dit geweten had, had ik het niet toegestaan, zegt ze. Zulke dingen raken me, dit lied ook.\""
                            },
                            {
                                "example_id": "ee6da2b3-df98-4e5f-a3a1-29b38078da4d",
                                "sense_id": "0c20d8ee-7969-368c-9292-46436c8123eb",
                                "text": "Meder: \"De oude, uit de mond opgetekende volksverhalen spreken van spoken als melkachtig witte, doorzichtige verschijningen.\" Zo’n spook is de geest van een overledene, gekleed in een doodshemd – een wijd uitlopend wit hemd tot op de enkels."
                            },
                            {
                                "example_id": "90aa6939-e711-45d7-a888-12eb5247ec16",
                                "sense_id": "0c20d8ee-7969-368c-9292-46436c8123eb",
                                "text": "Bij de klassieke uitvaart, bedoelt hij, ligt de dode er chique bij. Soms onder een glasplaat, vaak in een kist met satijnen bekleding. In de showroom in Almelo ligt zelfs een wit glanzend doodshemd, in plastic verpakt. Nee, die worden niet veel meer verkocht."
                            }
                        ]
                    }
                ],
