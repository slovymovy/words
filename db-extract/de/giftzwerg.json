                ],
                "senses": [
                    {
                        "sense_id": "d4c2d097-29ac-3770-9bb4-71cab510f1d2",
                        "entry_id": "9dc520bf-6a74-3d92-93d3-5051977b2ab2",
                        "glosses": [
                            "Bezeichnung für einen Menschen, der ein gehässiges und boshaftes Verhalten an den Tag legt, was häufig eine geringe Körpergröße wettmachen soll"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "00d45082-4bf6-4b9b-87da-a42e095ce380",
                                "sense_id": "d4c2d097-29ac-3770-9bb4-71cab510f1d2",
                                "text": "Dein Nachbar, dieser kleine Giftzwerg, hat mir unten doch tatsächlich die Haustür vor der Nase zugeschlagen."
                            },
                            {
                                "example_id": "7f683a9f-d5d2-4180-88bd-3213b0114ffb",
                                "sense_id": "d4c2d097-29ac-3770-9bb4-71cab510f1d2",
                                "text": "Steht da doch plötzlich dieser kleine, grüne Giftzwerg vor mir und will meinen Ausweis sehen!"
                            },
                            {
                                "example_id": "85af3d19-d96a-4119-ac17-50db77f309de",
                                "sense_id": "d4c2d097-29ac-3770-9bb4-71cab510f1d2",
                                "text": "Besonders allergisch reagierte Mimi auf andere Frauen. Als John [Lenon] Yoko Ono mitbrachte, kommentierte sie nur: „Wer ist dieser Giftzwerg?“"
                            },
                            {
                                "example_id": "aba0d5a3-8f3e-48f0-9399-f1c0ef8ddbc8",
                                "sense_id": "d4c2d097-29ac-3770-9bb4-71cab510f1d2",
                                "text": "[Interviewer:] „Herr Kellner, der FDP-Politiker Wolfgang Kubicki hat [den Grünen-Politiker] Robert Habeck gelobt. \"Die schönsten Autobahnen in Schleswig-Holstein habe man mit Habeck finanzieren können\", hat er der Süddeutschen Zeitung gesagt. Das klingt für Grüne nicht so toll. Liegt das an Kubicki oder an Habeck?“ [Bundesgeschäftsführer Michael] Kellner: „Das liegt daran, dass der Kubicki ein kleiner Giftzwerg ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
