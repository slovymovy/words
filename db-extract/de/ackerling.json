                        "entry_id": "6bcdb847-5c4d-3e81-ad39-f9a57b3dc7df",
                        "glosses": [
                            "ein ungiftiger Pilz, die zur Gattung Agrocybe aus der Familie der Mistpilzartigen (Bolbitiaceae) zählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f44d9d3e-e45a-4eac-bbe1-ae99773eff71",
                                "sense_id": "38769a73-636d-33d1-a8db-028efbc354ee",
                                "text": "Ackerlinge wachsen ab dem Frühsommer, meist auf Erde, teils aber auch auf Holz."
                            },
                            {
                                "example_id": "a40e2d44-bf14-4681-87b7-318236bac0bf",
                                "sense_id": "38769a73-636d-33d1-a8db-028efbc354ee",
                                "text": "Manche Ackerlinge sind ungenießbar."
                            },
                            {
                                "example_id": "24d268ac-46dc-4153-ab30-b6459f545a25",
                                "sense_id": "38769a73-636d-33d1-a8db-028efbc354ee",
                                "text": "Der Ackerling ist eine Pilzart."
                            }
                        ],
                        "sense_index_json": "\"1\""
