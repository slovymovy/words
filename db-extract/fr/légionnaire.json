        "fr-extract.jsonl": [
            {
                "entry_id": "5347464f-a8a3-3616-8834-fad40ec8f2fb",
                "word": "légionnaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63c9f9a7-37de-49eb-9d71-3cf8a7ff4992",
                        "entry_id": "5347464f-a8a3-3616-8834-fad40ec8f2fb",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "légionnaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0eea95b7-1fb8-3af5-b9c6-6d6554cf55eb",
                        "entry_id": "5347464f-a8a3-3616-8834-fad40ec8f2fb",
                        "glosses": [
                            "Relatif aux soldats des légions romaines ou de la Légion étrangère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947245ce-2f46-4214-b858-4288a5573ab5",
                                "sense_id": "0eea95b7-1fb8-3af5-b9c6-6d6554cf55eb",
                                "text": "J’ai vu le soldat légionnaire veiller au milieu d’un désert sur les remparts d’un camp […]"
                            },
                            {
                                "example_id": "2eee8892-9072-4dd3-8fef-8cfc6e973bb5",
                                "sense_id": "0eea95b7-1fb8-3af5-b9c6-6d6554cf55eb",
                                "text": "Mais, en 28, le représentant romain auprès de la nation frisonne avait eu la mauvaise idée d’augmenter le tribut léger versé jusque-là sous la forme de peaux de bœuf à la petite garnison légionnaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc18304a-8b14-445b-b8bb-367c35f2ec61",
                        "source_entry_id": "5347464f-a8a3-3616-8834-fad40ec8f2fb",
                        "source_sense_id": "0eea95b7-1fb8-3af5-b9c6-6d6554cf55eb",
                        "target_lang_word": "legionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e71325d8-e28a-3a93-b3cb-ced5e70b1ec9",
                                        "entry_id": "b890f231-fe78-3dc2-a1a2-453a9522a2a8",
                                        "glosses": [
                                            "A soldier belonging to a legion; a professional soldier of the ancient Roman army."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772dfaed-a030-47e7-b183-d56f47afa339",
                                                "sense_id": "e71325d8-e28a-3a93-b3cb-ced5e70b1ec9",
                                                "text": "Suddenly, [...] he saw all this as romantic — the last legionary, his aloneness, the lost cause really lost — and instinctively he pulled in his paunch, stroked down his hair to cover the naked part of the scalp, and wiped the sweat off his cheeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f0b1af4-1b25-3d63-a727-ed162feeba4b",
                                        "entry_id": "b890f231-fe78-3dc2-a1a2-453a9522a2a8",
                                        "glosses": [
                                            "A person who is neither a citizen nor colonial/imperial subject of the state whose military they join."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39a5d6a2-ed65-3261-8648-68f3ad870239",
                                        "entry_id": "b890f231-fe78-3dc2-a1a2-453a9522a2a8",
                                        "glosses": [
                                            "A member of a legion, such as the American Legion, or of any organization containing the term legion in its title (e.g. the French Foreign Legion)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "legionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90e92553-8756-3300-af1e-08ef11449e0c",
                                        "entry_id": "4334105c-a6c7-37a5-8a1a-a7eff2412722",
                                        "glosses": [
                                            "Relating to, or consisting of, a legion or legions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a37d1ec2-d3f5-42dc-93ef-2695f2a46000",
                                                "sense_id": "90e92553-8756-3300-af1e-08ef11449e0c",
                                                "text": "a legionary force"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5087a60b-4156-3f88-90a9-f4480ff56b1a",
                                        "entry_id": "4334105c-a6c7-37a5-8a1a-a7eff2412722",
                                        "glosses": [
                                            "Containing a great number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d09de212-6a01-40ec-a0fb-d00ca2a21728",
                                                "sense_id": "5087a60b-4156-3f88-90a9-f4480ff56b1a",
                                                "text": "1646, Sir Thomas Browne, Pseudodoxia Epidemica (aka, Vulgar Errours), Google Books\nUnto whom (what is deplorable in men and Christians) too many applying themselves, betwixt jest and earnest, betray the cause of truth, and insensibly make up the legionary body of error."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "0f34f66b-2e00-3907-a262-80154046b8b9",
                "word": "légionnaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "905b83a5-3d79-4406-b5d0-d99d34edbaf3",
                        "entry_id": "0f34f66b-2e00-3907-a262-80154046b8b9",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "légionnaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb4823b6-805e-38cd-964b-2ce9c072b2f6",
                        "entry_id": "0f34f66b-2e00-3907-a262-80154046b8b9",
                        "glosses": [
                            "Soldat dans une légion romaine."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "a28bc7af-207a-4f48-a4d1-b7c62a81bc89",
                                "sense_id": "bb4823b6-805e-38cd-964b-2ce9c072b2f6",
                                "text": "Les légionnaires firent des merveilles en cette occasion."
                            },
                            {
                                "example_id": "8e441088-2359-4b7e-8a35-2745a2ec5c23",
                                "sense_id": "bb4823b6-805e-38cd-964b-2ce9c072b2f6",
                                "text": "Les légionnaires du centurion Marcus, officier d’Arles, participaient vendredi 12 août à une marche expérimentale sur quatre kilomètres entre Le Fâ et Arces-sur-Gironde."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5375196-4748-3906-b3c5-4fb7fe1e4346",
                        "entry_id": "0f34f66b-2e00-3907-a262-80154046b8b9",
                        "glosses": [
                            "ou Soldat de la Légion étrangère."
                        ],
                        "tags": [
                            "France",
                            "Espagne"
                        ],
                        "examples": [
                            {
                                "example_id": "b1c19068-f608-4b5d-8883-cb50ddeee562",
                                "sense_id": "e5375196-4748-3906-b3c5-4fb7fe1e4346",
                                "text": "Les légionnaires descendirent des camions, par grappes, les jambes molles, le corps lourd."
                            },
                            {
                                "example_id": "0f25ff2a-d8c9-4212-b198-a45bd38ee5cf",
                                "sense_id": "e5375196-4748-3906-b3c5-4fb7fe1e4346",
                                "text": "La vie civile n’est pas clémente pour les anciens légionnaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1c061cb-0a23-3637-89a2-a2047763c372",
                        "entry_id": "0f34f66b-2e00-3907-a262-80154046b8b9",
                        "glosses": [
                            "Combattant (ou ancien combattant) d’une armée ou membre d’une quelconque confrérie."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "801042cb-c1be-4ed2-bf0d-74f0ab12c7a5",
                                "sense_id": "f1c061cb-0a23-3637-89a2-a2047763c372",
                                "text": "La maladie doit son nom à une épidémie de pneumonie parmi des légionnaires participants à une convention de l’American Legion dans un hôtel de Philadelphie en 1976."
                            },
                            {
                                "example_id": "bae87beb-3669-4932-9ed6-3f94919c668a",
                                "sense_id": "f1c061cb-0a23-3637-89a2-a2047763c372",
                                "text": "Les légionnaires du Christ font vœux de pauvreté, d’obéissance, de chasteté, de charité et d’humilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f3687c6-cef6-3395-ab36-aafd4f5b8a58",
                        "entry_id": "0f34f66b-2e00-3907-a262-80154046b8b9",
                        "glosses": [
                            "Membre de l’ordre de la Légion d’honneur."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "320ffb5c-db93-4874-b876-df6edb4fa203",
                                "sense_id": "3f3687c6-cef6-3395-ab36-aafd4f5b8a58",
                                "text": "Il était simple légionnaire, il a été nommé officier."
                            }
                        ]
                    }
                ],
