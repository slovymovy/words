                "senses": [
                    {
                        "sense_id": "86e9b535-66cf-3390-86ab-d837281a05cb",
                        "entry_id": "b7bfc7fd-00d6-335d-ab6c-49d6344d0e33",
                        "glosses": [
                            "действие по значению гл. расспрашивать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5173faea-bb79-43f0-a753-ff36b5f65b0c",
                                "sense_id": "86e9b535-66cf-3390-86ab-d837281a05cb",
                                "text": "Мои знакомые, а также распорядители вечером, разумеется, подмечали эти подглядывания и расспрашивания обо мне моего мужа и слегка над ним и надо мной подтрунивали, что меня иногда очень сердило."
                            },
                            {
                                "example_id": "33f34d32-542d-496c-ab75-0e8f07e9768b",
                                "sense_id": "86e9b535-66cf-3390-86ab-d837281a05cb",
                                "text": "И тут же, в параллельном и пристрастном расспрашивании, выяснилось, что и частые эти командировки он устраивал себе не всегда по необходимости и, конечно, за счёт предприятия."
                            }
                        ]
                    }
