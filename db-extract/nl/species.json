                "translations": [
                    {
                        "translation_id": "b51ea254-85ca-4a7c-87de-3e37a74977fd",
                        "source_entry_id": "92dbddd6-f9a4-342d-a528-d2ff587f46c5",
                        "source_sense_id": "7e2227db-95fa-3b69-8ffe-02612cfbacda",
                        "source_sense_description": "soort, diersoort, plantensoort",
                        "target_lang_word": "species",
                        "target_lang_code": "en",
