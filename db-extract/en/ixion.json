    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a3d671f0-9056-3432-937e-a18496aecd1b",
                "word": "Ixion",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24a9fdb3-b76c-3380-9e25-858f99577676",
                        "entry_id": "a3d671f0-9056-3432-937e-a18496aecd1b",
                        "glosses": [
                            "King of Lapiths, who was punished by Zeus for trying to seduce Hera by being bound to a winged fiery wheel that was always spinning."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "83e56d56-5560-4adb-8182-f50a52af2161",
                                "sense_id": "24a9fdb3-b76c-3380-9e25-858f99577676",
                                "text": "As to fitfulness, I have never learnt the art of binding myself to any of the wheels on which the Ixions of these days are turning round and round."
                            },
                            {
                                "example_id": "baff62fd-7263-4b21-80e3-ae56aab6a432",
                                "sense_id": "24a9fdb3-b76c-3380-9e25-858f99577676",
                                "text": "The complicated conjunction and adverb “ut” also looms. Mr. Butterfield said that it is “the sort of infernal business that would make Sisyphus and Ixion smile kindly on the job satisfaction they got from their daily toil,” referring to figures from classical mythology forced to labor in pain for eternity."
                            }
                        ]
                    },
                    {
                        "sense_id": "94c19b68-8847-3dc6-a8b6-5302446a9d0b",
                        "entry_id": "a3d671f0-9056-3432-937e-a18496aecd1b",
                        "glosses": [
                            "A Kuiper belt object (KBO), 28978 Ixion (provisional designation 2001 KX₇₆), once thought to be a possible dwarf planet."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
