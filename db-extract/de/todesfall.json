                "senses": [
                    {
                        "sense_id": "063fd3bb-094e-32ef-9d51-7c36e0c2adb3",
                        "entry_id": "d36f3e83-265e-3140-bd25-bd5deacb16a3",
                        "glosses": [
                            "Tod einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d096e483-7a19-49da-a5a5-218f57a13bd7",
                                "sense_id": "063fd3bb-094e-32ef-9d51-7c36e0c2adb3",
                                "text": "„Und er erzählte mir, dass es im Dorf nebenan bis heute noch Häuser mit einem »Seelenloch« gebe - winzigen Fenstern, die beim Eintritt eines Todesfalles geöffnet wurden, damit die Seele des Verstorbenen mühelos entweichen könne.“"
                            },
                            {
                                "example_id": "4630dc94-f171-414f-8fd6-228640d49304",
                                "sense_id": "063fd3bb-094e-32ef-9d51-7c36e0c2adb3",
                                "text": "„Er hat in Bremen als Hauptkommissar über tausend Todesfälle bearbeitet.“"
                            },
                            {
                                "example_id": "f1ef855d-d04b-436d-9b5e-cd121eef7641",
                                "sense_id": "063fd3bb-094e-32ef-9d51-7c36e0c2adb3",
                                "text": "„Die deutsch-tschechische Historikerkommission hat jetzt eine Zahl von 15000 – 30000 Todesfällen errechnet.“"
                            },
                            {
                                "example_id": "70ebb751-c7ec-4fba-80b2-d2732457d599",
                                "sense_id": "063fd3bb-094e-32ef-9d51-7c36e0c2adb3",
                                "text": "„Und er erlebt auch Schreckliches, einen Todesfall etwa, im Ringkampf.“"
                            },
                            {
                                "example_id": "7a0b4b4d-d43a-43c5-8f24-e91ed11bf9b5",
                                "sense_id": "063fd3bb-094e-32ef-9d51-7c36e0c2adb3",
                                "text": "„Jeder dritte Todesfall hierzulande geht auf das Konto einer Herz- oder Kreislauferkrankung: Herzinfarkte, Schlaganfälle, chronische Herzschwäche oder eben Herzstillstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
