                "senses": [
                    {
                        "sense_id": "c0b13b70-4409-3906-bd22-23597e436bca",
                        "entry_id": "596d84ab-94f4-37fa-b919-3b0dfb5dc84f",
                        "glosses": [
                            "Software, die die Zusammenarbeit an einem Projekt innerhalb eines Netzwerkes unterstützt"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "6b0406a7-0fec-42ab-a614-f21ece9109f5",
                                "sense_id": "c0b13b70-4409-3906-bd22-23597e436bca",
                                "text": "„Im Februar 2014 wurde beschlossen, künftig Kolab 3.1 als Groupware in der Münchner Stadtverwaltung einzusetzen.“"
                            },
                            {
                                "example_id": "ce9a998a-06df-40ab-8598-8ea92f0f50f5",
                                "sense_id": "c0b13b70-4409-3906-bd22-23597e436bca",
                                "text": "„MS Exchange ist ein sogenannte Groupware, mit deren Hilfe die Abgeordneten nicht nur Mails verschicken und empfangen können wie bisher, sondern auch ihre Adressbücher zentral verwalten und Termine miteinander abstimmen.“"
                            },
                            {
                                "example_id": "0bedca09-4bb4-43b7-893c-f51a77b18ae0",
                                "sense_id": "c0b13b70-4409-3906-bd22-23597e436bca",
                                "text": "„Zahlreiche Quellen belegen, dass gerade die Großen wie IBM, Oracle und Apple offene Formate als den Schlüssel zur Zukunft der Groupware sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
