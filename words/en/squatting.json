{
    "word_family": [
        "squat",
        "squatter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c3f3bc6-bf34-3f50-8159-1d7baa7d9d16",
                    "sense_definition": "The physical posture of sitting with one's knees bent and weight on the feet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deep <w>squatting</w> position is common in many cultures for resting.",
                            "target_lang_translations": {
                                "cs": "Hluboká poloha v <w>podřepu</w> je v mnoha kulturách běžná pro odpočinek."
                            }
                        },
                        {
                            "text": "Prolonged <w>squatting</w> can be difficult for people with knee problems.",
                            "target_lang_translations": {
                                "cs": "Dlouhodobé <w>dřepění</w> může být pro lidi s problémy s koleny obtížné."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzická poloha v podřepu, kdy jsou kolena pokrčená a váha spočívá na chodidlech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podřep",
                                "target_lang_sense_clarification": "poloha těla v podřepu"
                            },
                            {
                                "target_lang_word": "dřep",
                                "target_lang_sense_clarification": "cvičební nebo fyzická pozice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbd61cbe-4e87-3d11-bb99-834808796fdb",
                    "sense_definition": "The act of living in an empty building or on land without the owner's permission.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "illegal_occupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council is trying to stop illegal <w>squatting</w> in abandoned warehouses.",
                            "target_lang_translations": {
                                "cs": "Městská rada se snaží zastavit nelegální <w>squatting</w> v opuštěných skladech."
                            }
                        },
                        {
                            "text": "Many people turned to <w>squatting</w> due to the severe housing crisis.",
                            "target_lang_translations": {
                                "cs": "Mnoho lidí se kvůli vážné bytové krizi uchýlilo k <w>squattingu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "trespassing"
                    ],
                    "common_phrases": [
                        "illegal squatting"
                    ],
                    "target_lang_definitions": {
                        "cs": "Neoprávněné obývání prázdné budovy nebo pozemku bez souhlasu majitele."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "squatting",
                                "target_lang_sense_clarification": "nelegální obsazení objektu"
                            },
                            {
                                "target_lang_word": "neoprávněné užívání nemovitosti",
                                "target_lang_sense_clarification": "formální právní popis"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fdcf69c-805f-3e94-97b5-6bc4d083897d",
                    "sense_definition": "Present participle and gerund of <w>squat</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>squatting</w> on the floor to look under the heavy cabinet.",
                            "target_lang_translations": {
                                "cs": "Byl <w>dřepěl</w> na podlaze, aby se podíval pod těžkou skříňku."
                            }
                        },
                        {
                            "text": "After <w>squatting</w> for a long time, her legs felt very stiff.",
                            "target_lang_translations": {
                                "cs": "Poté, co dlouho <w>dřepěla</w>, měla nohy velmi ztuhlé."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost spočívající v setrvávání v podřepu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dřepět",
                                "target_lang_sense_clarification": "být v pozici podřepu"
                            },
                            {
                                "target_lang_word": "dřepění",
                                "target_lang_sense_clarification": "podstatné jméno slovesné"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}