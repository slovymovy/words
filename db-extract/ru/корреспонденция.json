                    },
                    {
                        "sense_id": "1d7abbcd-7015-3eb2-abd3-c983a492b6cb",
                        "entry_id": "481b3f0d-3e3e-3aad-b09f-0a303ac8867e",
                        "glosses": [
                            "оперативный жанр журналистики, сообщения с мест, статьи, присланные в газету или журнал корреспондентами"
                        ],
