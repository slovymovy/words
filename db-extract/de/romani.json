                                "target_senses": [
                                    {
                                        "sense_id": "95d8c1d0-0bf3-3965-ad0d-046ebf5c2268",
                                        "entry_id": "648721b0-f2fe-344c-9b2d-ca4cdd0e9acd",
                                        "glosses": [
                                            "A member of the Roma, a nomadic people with origins in India."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b742267c-e283-4926-8cf9-94db749e5763",
                                                "sense_id": "95d8c1d0-0bf3-3965-ad0d-046ebf5c2268",
                                                "text": "The Romani have long been discriminated against."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
