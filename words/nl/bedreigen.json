                        "met de dood bedreigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To frighten someone by saying you will do something to harm them",
                        "ru": "пугать кого-либо, заявляя о намерении причинить вред или совершить неприятное действие"
                    },
                    "translations": {
