                ],
                "senses": [
                    {
                        "sense_id": "678bfd63-a347-35ed-acaa-ec739a6a90d0",
                        "entry_id": "24f332fd-0cef-3878-ad31-54e915fe55e4",
                        "glosses": [
                            "Zeitraum (in den Subtropen und Tropen), in dem nur sehr wenig Regen fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88bbbd94-2346-49d4-a4a1-538dbc47d5b3",
                                "sense_id": "678bfd63-a347-35ed-acaa-ec739a6a90d0",
                                "text": "Oft liegt die Trockenzeit zwischen November und Mai."
                            },
                            {
                                "example_id": "68bc7555-7ad3-475e-8658-bc7bea4b56d3",
                                "sense_id": "678bfd63-a347-35ed-acaa-ec739a6a90d0",
                                "text": "„Während es in der Trockensavanne fünf bis siebeneinhalb Monate nicht regnet, dauert die Trockenzeit in der Dornsavanne sieben bis zehn Monate.“"
                            },
                            {
                                "example_id": "160c98f1-601c-421c-80b2-7c7ee1d3236f",
                                "sense_id": "678bfd63-a347-35ed-acaa-ec739a6a90d0",
                                "text": "„Tuareg-Nomaden gründen Timbuktu um 1100 zwischen der Flussniederung und dem Glutofen der Sahara als Lagerplatz während der Trockenzeit.“"
                            },
                            {
                                "example_id": "3764bc64-4d93-4b8e-9cb1-b1424a16933b",
                                "sense_id": "678bfd63-a347-35ed-acaa-ec739a6a90d0",
                                "text": "„In der Trockenzeit musste es hier gefährliche Stromschnellen geben, doch jetzt führte der Tembi genügend Wasser, und unsere Piroge glitt unbeeindruckt darüber hinweg.“"
                            },
                            {
                                "example_id": "7268e733-5beb-4c5e-8205-17abb7171c0d",
                                "sense_id": "678bfd63-a347-35ed-acaa-ec739a6a90d0",
                                "text": "„In der Trockenzeit mischen sich oft Schweiß und Staub auf meiner Stirn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
