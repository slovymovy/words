                "senses": [
                    {
                        "sense_id": "cd69b603-058a-36fa-b26b-fb2d3d62588e",
                        "entry_id": "b778a590-9a3e-3684-ae14-c10182d754db",
                        "glosses": [
                            "natuurlijke stuk gebergte waarop apen leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3dc0425-3605-4a82-9dbd-f5a6650c6bc1",
                                "sense_id": "cd69b603-058a-36fa-b26b-fb2d3d62588e",
                                "text": "De kajuitsjongen brandde van verlangen de apenrots eens van nabij te zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "77aec75e-4058-34a2-850b-ab3ea526a902",
                        "entry_id": "b778a590-9a3e-3684-ae14-c10182d754db",
                        "glosses": [
                            "kunstmatig stenen landschap met hoogteverschillen in een dierentuin waarop apen leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b884e60a-13f9-4512-8234-ee353ff6e0ad",
                                "sense_id": "77aec75e-4058-34a2-850b-ab3ea526a902",
                                "text": "Ze hadden de dieren weer gezien: de olifanten die achter het hekje stonden, de apen op de apenrots die de meeste kijkers trokken, de leeuwen en beren achter hun tralies, de lama in de kinderboerderij, waar je voor moest oppassen, de pinguins, waar Jeroen altijd weer om moest schateren."
                            }
                        ]
                    },
                    {
                        "sense_id": "42a2e40e-203d-3c06-b87b-f8a6a9481957",
                        "entry_id": "b778a590-9a3e-3684-ae14-c10182d754db",
                        "glosses": [
                            "bijnaam voor gebouwen vanwege hun vorm"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "86848c6b-67c0-46ef-be55-98e9f35405df",
                                "sense_id": "42a2e40e-203d-3c06-b87b-f8a6a9481957",
                                "text": "Al veertig jaar voor de Noorse bankverzekeraar gaf een Nederlandse financiële instelling opdracht voor de bouw van een ‘apenrots’, zoals het Centraal-Beheergebouw in Apeldoorn bekendstaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "955f36b7-7974-386d-8664-8488715538aa",
                        "entry_id": "b778a590-9a3e-3684-ae14-c10182d754db",
                        "glosses": [
                            "bijnaam voor gebouwen vanwege hun vorm",
                            "kantoorgebouw Bezuidenhoutseweg 67 in Den Haag, dat tot 2017 het Ministerie van Buitenlandse Zaken onderdak bood"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "4f30165d-4cf3-4e0f-bd78-0302d8303e31",
                                "sense_id": "955f36b7-7974-386d-8664-8488715538aa",
                                "text": "Al veertig jaar voor de Noorse bankverzekeraar gaf een Nederlandse financiële instelling opdracht voor de bouw van een ‘apenrots’, zoals het Centraal-Beheergebouw in Apeldoorn bekendstaat."
                            },
                            {
                                "example_id": "37c81597-e5a4-4a23-b903-f17dbb8743d8",
                                "sense_id": "955f36b7-7974-386d-8664-8488715538aa",
                                "text": "De onvrede over de gedwongen samenwoning legt het vooralsnog af tegen de onvrede over de huidige huisvesting: de zogeheten ‘apenrots’ aan de Bezuidenhoutseweg in Den Haag. Toen dit markante gebouw, met schuin oplopende etages, van architect Dick Apon (vandaar de verbasterde aanduiding) in 1984 werd opgeleverd, was het nog het visitekaartje van de rijksoverheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "26048197-66f6-36c2-a47e-70128ca2dc6e",
                        "entry_id": "b778a590-9a3e-3684-ae14-c10182d754db",
                        "glosses": [
                            "rangorde van fel bevochten posities binnen een organisatie"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "99c3acab-3dcb-4f80-bafd-e8274f14b163",
                                "sense_id": "26048197-66f6-36c2-a47e-70128ca2dc6e",
                                "text": "Want je kunt nu lekker hoog op de apenrots zitten, als straks alles met sociale media moet, loop jij weer achter op de jeugd."
                            }
                        ]
                    }
