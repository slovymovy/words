                    },
                    {
                        "translation_id": "d1de0e49-3f3b-464b-be11-7e3357eece5d",
                        "source_entry_id": "82cc6c2f-9591-31a4-80a9-bbe79a7a56fa",
                        "source_sense_id": "c019d5fc-5506-3a82-8c59-392853474805",
                        "target_lang_word": "海滩",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3fefedb8-cea6-4c11-a3b6-a54421e1bd6b",
                        "source_entry_id": "82cc6c2f-9591-31a4-80a9-bbe79a7a56fa",
                        "source_sense_id": "c019d5fc-5506-3a82-8c59-392853474805",
                        "target_lang_word": "Untiefe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untiefe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b633730-3244-351c-8e6b-c1ab931a758d",
                                        "entry_id": "ea80647b-af43-361b-b295-2d4f84b90c95",
                                        "glosses": [
                                            "flache, seichte Stelle in Gewässern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55f87ca-5818-4a70-b704-fcdd9e89c33b",
                                                "sense_id": "4b633730-3244-351c-8e6b-c1ab931a758d",
                                                "text": "Die Schifffahrt muss immer auch auf Untiefen achten."
                                            },
                                            {
                                                "example_id": "b64166aa-8935-4bfb-89dd-392e1c16cef6",
                                                "sense_id": "4b633730-3244-351c-8e6b-c1ab931a758d",
                                                "text": "„Wo immer sich die Strömung verlangsamt, bilden sich Inseln und Untiefen.“"
                                            },
                                            {
                                                "example_id": "bc189407-6dd3-471d-aa39-930beda93a51",
                                                "sense_id": "4b633730-3244-351c-8e6b-c1ab931a758d",
                                                "text": "„Wir versuchten zunächst, das Schiff über die Untiefe zu zwingen, doch ohne Erfolg, und als die Ebbe kam, kippte es auf die Kimm, und die Schandeckel gerieten unter Wasser.“"
                                            },
                                            {
                                                "example_id": "ba98f8da-bda7-493f-a888-2c9dae281ba4",
                                                "sense_id": "4b633730-3244-351c-8e6b-c1ab931a758d",
                                                "text": "„Er wollte kein richtiges Boot mit Spanten und Planken konstruieren, sondern nur eine flache Piroge, mit der man leicht über Untiefen hinwegkam, und die sich auch ohne Anstrengung tragen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3b34691-d718-3b7e-a762-909861e9f5ac",
                                        "entry_id": "ea80647b-af43-361b-b295-2d4f84b90c95",
                                        "glosses": [
                                            "große Tiefe"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca6ee2b-d3d8-41b4-b982-f51e725a7a9e",
                                                "sense_id": "d3b34691-d718-3b7e-a762-909861e9f5ac",
                                                "text": "Viele Schiffe sind schon in den Untiefen der Ozeane spurlos verschwunden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0f8e0186-a2d9-3505-9f45-cea860b29b50",
                                        "entry_id": "ea80647b-af43-361b-b295-2d4f84b90c95",
                                        "glosses": [
                                            "unergründliche Realität"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b28f1994-7136-49cc-b175-44987a9a285b",
                                                "sense_id": "0f8e0186-a2d9-3505-9f45-cea860b29b50",
                                                "text": "„Dann erfährt Will Vesper selbst die Untiefen nationalsozialistischer Kulturpolitik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6dd04be-4e18-4162-9d91-d69f1dab03e2",
                        "source_entry_id": "82cc6c2f-9591-31a4-80a9-bbe79a7a56fa",
                        "source_sense_id": "c019d5fc-5506-3a82-8c59-392853474805",
                        "target_lang_word": "seichte Stelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb0f90cf-a67a-41f6-a1e8-e8072e515b74",
                        "source_entry_id": "82cc6c2f-9591-31a4-80a9-bbe79a7a56fa",
                        "source_sense_id": "c019d5fc-5506-3a82-8c59-392853474805",
                        "target_lang_word": "Sandbank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandbank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62ff0619-c9eb-3a16-99c6-d46b8134e688",
                                        "entry_id": "8a50d41b-eaa0-3e45-bf9c-15f53f4ef713",
                                        "glosses": [
                                            "eine Ablagerung von Sand oder Kies am Grund von Meeren und Flüssen, die wenigstens zeitweise aus dem Wasser ragt, gebildet durch die Tide und Strömung"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85871174-6c2d-4ed1-a761-d8949359bc22",
                                                "sense_id": "62ff0619-c9eb-3a16-99c6-d46b8134e688",
                                                "text": "Sandbänke können für Schiffe gefährlich werden."
                                            },
                                            {
                                                "example_id": "e09d2a1a-7c00-4936-bed5-38937f5f65aa",
                                                "sense_id": "62ff0619-c9eb-3a16-99c6-d46b8134e688",
                                                "text": "„Kurz vor Sonnenuntergang legte Moussa die Piroge auf eine Sandbank mitten im Fluss.“"
                                            },
                                            {
                                                "example_id": "a49164f5-4888-48d2-ba5e-da16abb4e7d4",
                                                "sense_id": "62ff0619-c9eb-3a16-99c6-d46b8134e688",
                                                "text": "„Dort hatte sich eine ziemlich große und eine volle Meile stromab sich hinziehende Sandbank gebildet, die unter dem Wasser zu einem eine halbe Meile tiefer gelegenen Inselchen führte.“"
                                            },
                                            {
                                                "example_id": "0c9cd162-0ded-4710-9664-e2210a40b973",
                                                "sense_id": "62ff0619-c9eb-3a16-99c6-d46b8134e688",
                                                "text": "„Auf den flachen Sandbänken des Eilands sonnten sich große Robben, die sich der Ingenieur bei Gelegenheit einmal näher anschauen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
