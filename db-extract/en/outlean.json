                "senses": [
                    {
                        "sense_id": "5febc976-a3de-3286-a611-9662b0dc3908",
                        "entry_id": "ead12e20-9c7e-32b1-be73-115b8b62ebdb",
                        "glosses": [
                            "To lean outward."
                        ],
                        "tags": [
                            "intransitive",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "756a44f6-9993-4ee3-81a8-7c1bdb57b462",
                                "sense_id": "5febc976-a3de-3286-a611-9662b0dc3908",
                                "text": "And so, between those populous rough hands / Raised in the sun, Duke Leopold outleant, / And took the patriot's oath."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d19bc56-d2fa-3802-9271-dbffc4a8328e",
                        "entry_id": "ead12e20-9c7e-32b1-be73-115b8b62ebdb",
                        "glosses": [
                            "To lean further than; surpass in leaning."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f6b76ba9-3852-4411-8a2b-917e3a701902",
                                "sense_id": "7d19bc56-d2fa-3802-9271-dbffc4a8328e",
                                "text": "On the home stretch, the leader was gone, but there were five or six other guys who were within a few yards of each other for second place. I went outside on the last turn, with a Dave Wottle move, and I outleaned the others at the finish."
                            }
                        ]
                    }
