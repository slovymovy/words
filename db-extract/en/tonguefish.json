                    {
                        "sense_id": "4b89232d-fbf3-330a-8512-c29616056b60",
                        "entry_id": "7e63fd1c-3dd8-3b92-9442-2a9676b01aa6",
                        "glosses": [
                            "Any of the flatfishes in the taxonomic family Cynoglossidae, distinguished by the presence of a long hook on the snout overhanging the mouth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c17e2e2-3d5d-45dc-9437-e177dd838e60",
                                "sense_id": "4b89232d-fbf3-330a-8512-c29616056b60",
                                "text": "Members of the family Cynoglossidae, the tonguefishes are for the most part too small to be of much interest as food fishes."
                            },
                            {
                                "example_id": "843e2a3e-1d9d-4010-99ac-b25799ac7791",
                                "sense_id": "4b89232d-fbf3-330a-8512-c29616056b60",
                                "text": "The tonguefishes are flatfishes found in the tropical and subtropical seas of the world, hut some species are found in freshwater hahitats (see Achiridae for a discussion of flatfishes)."
                            },
                            {
                                "example_id": "7f606f18-b003-4045-8d45-a1da8dd167d9",
                                "sense_id": "4b89232d-fbf3-330a-8512-c29616056b60",
                                "text": "But the tonguefish are unaffected by the noxious gases.\nThe ”narked\" fish end up as chow for the tonguefish."
                            }
                        ]
                    }
                ],
