                ],
                "senses": [
                    {
                        "sense_id": "5f9f4ec4-88a1-34c1-94b4-d7d7ea94a0dc",
                        "entry_id": "28c6e438-738f-3706-927c-dd1f3c805f81",
                        "glosses": [
                            "große Gruppe von ungebildeten Menschen"
                        ],
                        "tags": [
                            "derogatory",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "a903f7b1-2efa-412d-b7a1-be6dd1b4bc05",
                                "sense_id": "5f9f4ec4-88a1-34c1-94b4-d7d7ea94a0dc",
                                "text": "„Der Plebs, der noch nie eine Uni von innen gesehen hat, kann doch nicht aufs Podium.“"
                            },
                            {
                                "example_id": "33fa5975-0e3c-47e5-89ee-e4250a6621c4",
                                "sense_id": "5f9f4ec4-88a1-34c1-94b4-d7d7ea94a0dc",
                                "text": "„Bewußt fühlte er sich als ein Teil des Plebs, der solchen Veranstaltungen beiwohnt.“"
                            },
                            {
                                "example_id": "14b970ea-7c50-405b-9223-aeb7e0d2f2ac",
                                "sense_id": "5f9f4ec4-88a1-34c1-94b4-d7d7ea94a0dc",
                                "text": "„Das blieb dem Plebs vorbehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6fe47d3-0271-4460-92b1-099009c360e8",
