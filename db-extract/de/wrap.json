                        "entry_id": "2f1701b4-a48e-3154-be9d-def03227e445",
                        "glosses": [
                            "dünne, mit unterschiedlichen Zutaten gefüllte Teigrolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d732d529-0894-4d61-bfdb-a051f71172cb",
                                "sense_id": "f27af264-bcd4-3523-95cd-0af3671b0194",
