                "senses": [
                    {
                        "sense_id": "81a03f67-5b97-377d-b4fd-c16d50f864df",
                        "entry_id": "2569eef6-1e08-386e-b812-b59b7bd15f0c",
                        "glosses": [
                            "Donner un caractère glauque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e3f89d6-8400-410a-81ad-6f394cac5a5b",
                                "sense_id": "81a03f67-5b97-377d-b4fd-c16d50f864df",
                                "text": "Si vous cherchez à glauquiser votre service de table, vous pouvez retrouver cet item à la figure simienne sur Firebox."
                            },
                            {
                                "example_id": "d0cdece0-cc3e-4ff5-910e-858c3257c604",
                                "sense_id": "81a03f67-5b97-377d-b4fd-c16d50f864df",
                                "text": "Tout est prétexte à « glauquiser » encore plus ce fait divers, en déterrant encore et toujours des traits de caractère cachés de l'athlète."
                            },
                            {
                                "example_id": "a771f948-13cb-45bc-8f06-199ac04357f9",
                                "sense_id": "81a03f67-5b97-377d-b4fd-c16d50f864df",
                                "text": "C'est comme le réflexe grande armoire, on oublie : ce n'est ni écolo ni économique, et ça glauquise souvent l'atmosphère."
                            }
                        ]
                    }
