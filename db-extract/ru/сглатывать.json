                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f1c9846-ba21-4e64-a5c8-c5514f4a7e80",
                        "source_entry_id": "bd2c48aa-90b1-305d-a4d5-9deb161a4426",
                        "target_lang_word": "swallow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe776b2-859c-3770-887b-ad4611735e8b",
                                        "entry_id": "9d990ecc-5b26-3b63-beda-f6df91d75efe",
                                        "glosses": [
                                            "To cause (food, drink etc.) to pass from the mouth into the stomach; to take into the stomach through the throat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e9a01d7-cadd-4d89-904b-c3bfa77779e0",
                                                "sense_id": "bfe776b2-859c-3770-887b-ad4611735e8b",
                                                "text": "What the liquor was I do not know, but it was not so strong but that I could swallow it in great gulps and found it less burning than my burning throat."
                                            },
                                            {
                                                "example_id": "a0baa053-e14a-4267-a1dd-f9d1b98411b1",
                                                "sense_id": "bfe776b2-859c-3770-887b-ad4611735e8b",
                                                "text": "Clothes are to be worn and food is to be swallowed: they remain trapped in the physical world."
                                            },
                                            {
                                                "example_id": "4bebda47-6809-4af2-a1f0-355ca1ca8bf7",
                                                "sense_id": "bfe776b2-859c-3770-887b-ad4611735e8b",
                                                "text": "The four-and-one-half-day trial was centered on acts that neither she nor prosecutors dispute: On July 13, 2012, she drove her Lexus S.U.V. erratically after swallowing Zolpidem, a generic form of the sleep medication Ambien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9fa84d8-0e62-3e56-8862-54379881f88b",
                                        "entry_id": "9d990ecc-5b26-3b63-beda-f6df91d75efe",
                                        "glosses": [
                                            "To take (something) in so that it disappears; to consume, absorb."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80f6742d-67f0-4d0b-b56c-eb750d6c8896",
                                                "sense_id": "a9fa84d8-0e62-3e56-8862-54379881f88b",
                                                "text": "The necessary provision of the life swallows the greatest part of their time."
                                            },
                                            {
                                                "example_id": "43c890e9-edcc-4974-ad85-b3455cd05d61",
                                                "sense_id": "a9fa84d8-0e62-3e56-8862-54379881f88b",
                                                "text": "His body, like so many others swallowed by the ocean's hungry maw, was never found."
                                            },
                                            {
                                                "example_id": "6c35bfaa-6935-41cf-87ab-1feafc10918a",
                                                "sense_id": "a9fa84d8-0e62-3e56-8862-54379881f88b",
                                                "text": "Elsewhere still, they'd managed to find the wreck of a Japanese midget submarine, and so, when the battleships were done being swallowed by the seabed, some efforts were being made to haul this up as well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcf14b74-0f7a-30b4-849f-af8341e314ec",
                                        "entry_id": "9d990ecc-5b26-3b63-beda-f6df91d75efe",
                                        "glosses": [
                                            "To take food down into the stomach; to make the muscular contractions of the oesophagus to achieve this, often taken as a sign of nervousness or strong emotion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5935112-a188-4551-b01d-6063bfa0ed9e",
                                                "sense_id": "dcf14b74-0f7a-30b4-849f-af8341e314ec",
                                                "text": "My throat was so sore that I was unable to swallow."
                                            },
                                            {
                                                "example_id": "10e7f015-d4ca-458f-b2f9-b05572b16627",
                                                "sense_id": "dcf14b74-0f7a-30b4-849f-af8341e314ec",
                                                "text": "She swallowed nervously then, appearing near sick with what she had to say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f2204d8-e45d-3c2a-9358-04752ba79aca",
                                        "entry_id": "9d990ecc-5b26-3b63-beda-f6df91d75efe",
                                        "glosses": [
                                            "To accept easily or without questions; to believe, accept."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e76d0863-79e8-4e3f-8138-ae8ade5d5d87",
                                                "sense_id": "5f2204d8-e45d-3c2a-9358-04752ba79aca",
                                                "text": "this humbug was readily swallowed by men who were supposed to be intelligent,"
                                            },
                                            {
                                                "example_id": "c8988285-3ad8-4cb1-bcb2-54527a2c4483",
                                                "sense_id": "5f2204d8-e45d-3c2a-9358-04752ba79aca",
                                                "text": "Most newspapers we saw swallowed whole an S.R. estimate that it would cost £20m to equip the Region with point heaters."
                                            },
                                            {
                                                "example_id": "03028e25-039c-4b0e-87a5-d3795b935598",
                                                "sense_id": "5f2204d8-e45d-3c2a-9358-04752ba79aca",
                                                "text": "Be careful of the Commie Lies / swallow them and freedom dies / The USA must realize / that she's the biggest prize."
                                            },
                                            {
                                                "example_id": "6deaa9e4-10e9-4934-bb47-fe0bf414e91b",
                                                "sense_id": "5f2204d8-e45d-3c2a-9358-04752ba79aca",
                                                "text": "Americans swallowed his tale because they wanted to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe0e489a-3958-3f0c-8c54-ca7d35a4c5bd",
                                        "entry_id": "9d990ecc-5b26-3b63-beda-f6df91d75efe",
                                        "glosses": [
                                            "To engross; to appropriate; usually with up."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df4b3cda-cb66-4baf-92c5-4453ca7b1f32",
                                                "sense_id": "fe0e489a-3958-3f0c-8c54-ca7d35a4c5bd",
                                                "text": "Homer excels […] in this, that he swallowed up the honour of those who succeeded him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5d61334-23f9-392b-bbff-ed7b6643dc36",
                                        "entry_id": "9d990ecc-5b26-3b63-beda-f6df91d75efe",
                                        "glosses": [
                                            "To retract; to recant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a57d2f4-028b-40cd-a82b-bb96ec2af569",
                                                "sense_id": "f5d61334-23f9-392b-bbff-ed7b6643dc36",
                                                "text": "to swallow one's opinions"
                                            },
                                            {
                                                "example_id": "914365ef-ea1c-40e0-9e40-b9408f5b7691",
                                                "sense_id": "f5d61334-23f9-392b-bbff-ed7b6643dc36",
                                                "text": "Left her in her tears, and dried not one of them with his comfort; swallowed his vows whole"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138f2dc0-8574-317b-8756-709c5172cfe9",
                                        "entry_id": "9d990ecc-5b26-3b63-beda-f6df91d75efe",
                                        "glosses": [
                                            "To put up with; to bear patiently or without retaliation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f23a09f-4bd0-4e35-a450-2f4cf0b2bc56",
                                                "sense_id": "138f2dc0-8574-317b-8756-709c5172cfe9",
                                                "text": "to swallow an affront or insult"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be612d89-19ce-3deb-9b41-be085ae0abba",
                                        "entry_id": "eae62482-91fa-3860-b689-3a170eaa59b4",
                                        "glosses": [
                                            "A deep chasm or abyss in the earth."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ace0e6ea-4023-37d5-8349-adaf54823c07",
                                        "entry_id": "eae62482-91fa-3860-b689-3a170eaa59b4",
                                        "glosses": [
                                            "The mouth and throat; that which is used for swallowing; the gullet."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72b39b82-26b5-4879-b0db-cfc0152f68a7",
                                                "sense_id": "ace0e6ea-4023-37d5-8349-adaf54823c07",
                                                "text": "The door burst wide open, and he saw nothing but a gaping jaw extending from the threshold up to the lintel. \"There is a mouthful for you,\" said the youngster, and threw the pauper boy into the swallow; \"taste that! But let me see now who you are! Perhaps you are an old acquaintance?\" And so it was; it was the devil who was about again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60af25a7-77a5-3b26-94db-955a60b798aa",
                                        "entry_id": "eae62482-91fa-3860-b689-3a170eaa59b4",
                                        "glosses": [
                                            "The amount swallowed in one gulp; the act of swallowing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f3bdab-8007-4d7c-bd62-222563a95e32",
                                                "sense_id": "60af25a7-77a5-3b26-94db-955a60b798aa",
                                                "text": "He took the aspirin with a single swallow of water."
                                            },
                                            {
                                                "example_id": "1b33debe-295a-4f95-bc63-4da969777f57",
                                                "sense_id": "60af25a7-77a5-3b26-94db-955a60b798aa",
                                                "text": "She took a swallow of milk and made a face. \"This milk is blinky.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "651c7393-dcf2-36e5-982a-8c9c266c4c0b",
                                        "entry_id": "eae62482-91fa-3860-b689-3a170eaa59b4",
                                        "glosses": [
                                            "The opening in a pulley block between the sheave and shell through which the rope passes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed69238-6535-458c-8c4c-83235f21b740",
                                                "sense_id": "651c7393-dcf2-36e5-982a-8c9c266c4c0b",
                                                "text": "In addition, j-lock shackles can pass through the swallow of a modern genoa track even with a sheet in tension already there, and this is very useful when preparing a sail change on the same tack."
                                            },
                                            {
                                                "example_id": "b6c54561-c462-4ad4-a52b-0227d949ea51",
                                                "sense_id": "651c7393-dcf2-36e5-982a-8c9c266c4c0b",
                                                "text": "Blocks are made in a great variety of patterns. All are designed to be used one way. The rope goes through the swallow."
                                            },
                                            {
                                                "example_id": "c151a83e-3afb-4f14-bf33-100f965563b7",
                                                "sense_id": "651c7393-dcf2-36e5-982a-8c9c266c4c0b",
                                                "text": "When specifying blocks, excessive friction is avoided by ensuring (a) that the diameter of the sheave is at least twice the circumference of the rope or six times its diameter (preferably more), and (b) that the 'swallow' of the block is substantially wider than the diameter of the rope, to avoid rubbing against the inside of the cheeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74261743-a215-3968-a843-36d20a9c084e",
                                        "entry_id": "eae62482-91fa-3860-b689-3a170eaa59b4",
                                        "glosses": [
                                            "Any of various carbohydrate-based dishes that are swallowed without much chewing, commonly paired and eaten with various types of soup."
                                        ],
                                        "tags": [
                                            "Nigeria",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6fc232f-a9b4-3124-9b3d-184816d29d72",
                                        "entry_id": "1ea1be35-8532-3d53-9d07-56e3392b2cb3",
                                        "glosses": [
                                            "A small, migratory bird of the Hirundinidae family with long, pointed, moon-shaped wings and a forked tail which feeds on the wing by catching insects."
                                        ],
