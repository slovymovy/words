                        "entry_id": "ebb3556c-8d69-39af-9777-2f5788d72207",
                        "glosses": [
                            "Bauteil einer elektrischen Leuchte, das die elektrische Energie in Licht- und Wärmeenergie umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dda1544-6453-4d15-86b6-bc83f16ea93b",
                                "sense_id": "5f88abe4-b20f-3199-a523-8c17f47cd0f8",
                                "text": "„Seitdem das Aus der Glühbirne beschlossen wurde, tut sich manch einer schwer mit der Wahl der passenden Leuchtkörper.“"
                            },
                            {
                                "example_id": "10d36d7e-7a96-45fb-a1ac-bccc9e5f1582",
                                "sense_id": "5f88abe4-b20f-3199-a523-8c17f47cd0f8",
                                "text": "„Im allgemeinen sind Leuchtkörper für vorwiegend direktes Licht zweckmäßig, weil hauptsächlich der Ladentisch und der Hackklotz gut beleuchtet werden müssen.“"
                            }
                        ],
