        "fr-extract.jsonl": [
            {
                "entry_id": "5969b0cc-eb73-35e9-83fa-6309c2523fae",
                "word": "Abuja",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "db0517f7-42da-4519-a2d1-0718d96266fe",
                        "entry_id": "5969b0cc-eb73-35e9-83fa-6309c2523fae",
