                        "glosses": [
                            "A mollusk of the genus Marginella, or its shell."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f97c57d1-4f4e-4422-af48-1b868f18dee0",
                                "sense_id": "ca1e6877-8230-3522-87df-2ec7b2d107b3",
                                "text": "Common shells include frog-shells, distorsios, volutes, tulips, murex, cones, olives, marginellas, cowries, augers and the Florida horse conch, the state's official shell, which can grow up to 24in (6 1 cm) long."
                            },
                            {
                                "example_id": "8fd9e4d0-92cf-4801-b26e-fcf9b1be02d4",
                                "sense_id": "ca1e6877-8230-3522-87df-2ec7b2d107b3",
                                "text": "Smooth, shiny, brightly colored shells, marginellas are usually found in tropical and warm water."
                            },
                            {
                                "example_id": "486208dc-60e5-4c51-8213-7cadef7ec703",
                                "sense_id": "ca1e6877-8230-3522-87df-2ec7b2d107b3",
                                "text": "Marginellas have smooth, shiny shells with an elongate, narrow aperture three-quarters or more of the total shell length."
                            }
                        ]
                    }
