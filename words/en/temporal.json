            "senses": [
                {
                    "sense_id": "658194da-2a8d-3607-a03f-18f5846f805d",
                    "sense_definition": "Relating to the sequence of time or to a particular point in time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers analyzed the <w>temporal</w> sequence of events to understand the cause of the accident.",
                            "target_lang_translations": {
                                "ru": "Исследователи проанализировали <w>временну́ю</w> последовательность событий, чтобы понять причину аварии."
                            }
                        },
                        {
                            "text": "There is a clear <w>temporal</w> pattern in how the disease spreads during the winter months.",
                            "target_lang_translations": {
                                "ru": "Существует четкая <w>временна́я</w> закономерность в том, как распространяется болезнь в зимние месяцы."
                            }
