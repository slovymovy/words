                        "glosses": [
                            "das Verwenden eigener, bereits publizierter wissenschaftlicher Texte, ohne dies entsprechend zu kennzeichnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aec06d1-79ff-44e9-b47b-2d16028b33e7",
                                "sense_id": "a14c7807-f201-384f-83f3-930e4c933bd7",
                                "text": "„Experten für wissenschaftliches Fehlverhalten schätzen ein Eigenplagiat als minderschwer ein.“"
                            },
                            {
                                "example_id": "a4ae8d9f-82b5-4d29-bcc2-0b83094a6193",
                                "sense_id": "a14c7807-f201-384f-83f3-930e4c933bd7",
                                "text": "„Das sogenannte Eigenplagiat gibt es nicht – denn das würde ja bedeuten, dass es möglich wäre, sich selbst zu beklauen.“"
                            }
                        ],
