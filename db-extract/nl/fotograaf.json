                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c622e68-31e9-383f-83b4-7084ca5e0a19",
                        "entry_id": "4328f699-3ca7-3faa-9013-6566bf370ea1",
                        "glosses": [
                            "iemand die foto's maakt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "8edfa4c4-54ff-45cb-9eab-1105f4c73ac8",
                                "sense_id": "5c622e68-31e9-383f-83b4-7084ca5e0a19",
                                "text": "De fotograaf maakte een portret."
                            },
                            {
                                "example_id": "76c998a4-5a1f-429a-b38e-04eeb26995d1",
                                "sense_id": "5c622e68-31e9-383f-83b4-7084ca5e0a19",
                                "text": "Koning Willem-Alexander en zijn gezin poseren vrijdagmiddag weer voor fotografen. NU.nl-verslaggever Danja Koeleman vertelt hoe het er achter de schermen aan toegaat."
                            },
                            {
                                "example_id": "47da5404-38a6-4e7a-8836-f346a7567af2",
                                "sense_id": "5c622e68-31e9-383f-83b4-7084ca5e0a19",
                                "text": "De vierde foto was het best als je wilde weten hoe mijn vader eruitzag. Het was een portretfoto die genomen was bij een echte fotograaf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31f5adf2-868f-4a5f-990d-aad3cc90b320",
                        "source_entry_id": "4328f699-3ca7-3faa-9013-6566bf370ea1",
                        "source_sense_id": "5c622e68-31e9-383f-83b4-7084ca5e0a19",
                        "source_sense_description": "iemand die fotos maakt",
                        "target_lang_word": "Fotograf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                        "entry_id": "8078ae2f-39fb-3956-9736-15810da72568",
                                        "glosses": [
                                            "Person, die sich beruflich mit dem Herstellen und Bearbeiten von Lichtbildern beschäftigt"
                                        ],
                                        "tags": [
                                            "(ungeschützte) Berufsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9adce3a5-b1c6-4662-961c-1c2c9cc2b486",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Der Gehirn-Anatom also, der auf ein der Leiche entnommenes Gehirn starrt, um hier Residuen von Gedanken zu finden, begeht von seinem Denken aus denselben Fehler, wie ein Fotograf, der aus Betrachtung einer Negativ-Platte Schlüsse auf die Natur — des Lichts ziehen wollte.“"
                                            },
                                            {
                                                "example_id": "35aa9e2b-6090-4da5-8808-68ef29d618f3",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Denn Herr Jürgens, der Standesbeamte von Glowitz, Kreis Stolp in Pommern, ist eigentlich der Fotograf unseres Kirchspiels, allgegenwärtig bei Taufen, Konfirmationen und Hochzeiten in den Dörfern ringsum.“"
                                            },
                                            {
                                                "example_id": "db96e323-a39e-4d5a-8512-749bcc3a6f46",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Jan erzählte von seinem Beruf, von den Vorzügen, von den Schwierigkeiten, sich als freier Fotograf zu etablieren.“"
                                            },
                                            {
                                                "example_id": "c91d357b-12cf-4c04-a15e-3d09d43032f0",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Die Gang verstellte dem Fotografen den Weg und stellte ihm die Frage, was er denn hier mache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71d65741-8c48-468c-9f5c-f5c21d21d8b6",
                        "source_entry_id": "4328f699-3ca7-3faa-9013-6566bf370ea1",
                        "source_sense_id": "5c622e68-31e9-383f-83b4-7084ca5e0a19",
                        "source_sense_description": "iemand die fotos maakt",
                        "target_lang_word": "photographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd380886-dd70-3480-8bc7-74a37337d199",
                                        "entry_id": "f8254f16-af1c-3c7f-94cb-f979aedcfd4a",
                                        "glosses": [
                                            "One who takes photographs, typically as an occupation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070aee87-ec90-4eb6-b87c-81c8490107f5",
                                                "sense_id": "bd380886-dd70-3480-8bc7-74a37337d199",
                                                "text": "Award-winning Sydney photographer Stephen Dupont’s latest exhibition focuses on change and detribalisation in Papua New Guinea ."
                                            },
                                            {
                                                "example_id": "57cd2987-6b97-4261-b7a8-75b567d069a8",
                                                "sense_id": "bd380886-dd70-3480-8bc7-74a37337d199",
                                                "text": "Multiple photographers worried privately in conversations with Axios that the images from the rally could turn into a kind of \"photoganda,\" with the Trump campaign using them to further their agenda despite the photographers' intent of capturing a news event."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9a6d798-2cb8-48c0-b376-6bd702c3c0a5",
                        "source_entry_id": "4328f699-3ca7-3faa-9013-6566bf370ea1",
                        "source_sense_id": "5c622e68-31e9-383f-83b4-7084ca5e0a19",
                        "source_sense_description": "iemand die fotos maakt",
                        "target_lang_word": "photographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "312ce042-ae3a-312e-bb3d-ae8977b740ea",
                                        "entry_id": "1957fbe2-c567-3673-bd4d-b03abb9d15b8",
                                        "glosses": [
                                            "Personne qui prend des photographies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                        "entry_id": "1957fbe2-c567-3673-bd4d-b03abb9d15b8",
                                        "glosses": [
                                            "Personne qui s’occupe professionnellement de photographie, qui en fait son métier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5bec39-8c4c-48b0-87ae-94f2f4e9f16b",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "On retrouve chez Abramow un héritage lisible de Guy Bourdin (1928-1991), immense photographe des années 1970, dont les cadrages acrobatiques, et les couleurs éclatantes, rendaient les mannequins à la fois ultrasexys et parfaitement puissantes."
                                            },
                                            {
                                                "example_id": "8f739ff4-4ca8-4ae0-87c2-33148fb8b1da",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "Il n’est plus permis aujourd’hui à un photographe quelque peu averti, d’ignorer la sensitométrie. Les méthodes de mesures créées par Hürter et Driffield, perfectionnées par un grand nombre de savants, ont acquis une importance considérable en photographie."
                                            },
                                            {
                                                "example_id": "b6b38b37-34f1-453d-873a-31a02c580e4c",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "C'était le photographe. Il fit son entrée avec les instruments de son art sorcier : les plaques de verre sensibilisées de façon à fixer pour longtemps, sinon pour toujours, l'aspect des choses, la chambre obscure construite à l'instar de l'œil et pour suppléer aux manques de la mémoire, le trépied avec son voile noir."
                                            },
                                            {
                                                "example_id": "0c85e412-c962-4a37-864e-6c2fe4b1e5a5",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "Une fois les yeux dessillés, un observateur attentif ne peut manquer de remarquer la présence de ces photographes qui, dans les grandes villes comme dans les villages les plus reculés, de jour comme de nuit, sont devenus les témoins obligés des évènements ordinaires ou extraordinaires qui jalonnent la vie quotidienne des populations."
                                            },
                                            {
                                                "example_id": "8314afd2-662c-45d2-9aa6-3fe870071e45",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "Le jeune musicien, mitraillé par les photographes, est à bonne école, son père étant l’un des sonneurs principaux du bagad Kevrenn Kastell."
                                            },
                                            {
                                                "example_id": "38174d55-58ad-478d-b5fa-71c46f98a8a4",
                                                "sense_id": "9b485185-ef95-3490-bd7b-81878a848ca7",
                                                "text": "— Si seules de rares femmes photographes marquent l’histoire de la photographie au XIXᵉ siècle, elles prennent superbement leur revanche à partir des années vingt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a2eda7-5584-3c58-b387-9e34c6d50e78",
                                        "entry_id": "1957fbe2-c567-3673-bd4d-b03abb9d15b8",
                                        "glosses": [
                                            "Nom donné à l’assistant-bourreau qui tient la tête du condamné dans la lunette de la guillotine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d963e837-e2fc-4b65-a549-75afac111fd6",
                                                "sense_id": "20a2eda7-5584-3c58-b387-9e34c6d50e78",
                                                "text": "Moi, j’étais «photographe». Devant la lunette, les doigts placés derrière les oreilles du type, je devais le tirer vers moi pour qu’il ne se rétracte pas soudainement."
                                            },
                                            {
                                                "example_id": "e0952df3-0bed-4082-9b40-349382b8095d",
                                                "sense_id": "20a2eda7-5584-3c58-b387-9e34c6d50e78",
                                                "text": "La fonction de «photographe» (placé au pied de la guillotine, il doit saisir la tête du condamné qui passe par «l’objectif» et la poser, une fois coupée, dans la bassine prévue à cet effet) est une fonction «délicate» et «dangereuse»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
