                            }
                        },
                        {
                            "text": "Er viel een <w>strook</w> licht door de gordijnen naar binnen.",
                            "target_lang_translations": {
                                "en": "A <w>strip</w> of light fell in through the curtains.",
                                "ru": "Сквозь шторы внутрь падала <w>полоса</w> света.",
                                "pl": "Przez zasłony wpadał do środka <w>pasek</w> światła.",
                                "de": "Ein <w>Streifen</w> Licht fiel durch die Vorhänge herein.",
                                "fr": "Une <w>bande</w> de lumière entrait à travers les rideaux.",
                                "it": "Una <w>striscia</w> di luce filtrava attraverso le tende.",
                                "cs": "Záclonami dovnitř pronikal <w>pruh</w> světla.",
