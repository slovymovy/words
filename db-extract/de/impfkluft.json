                        "glosses": [
                            "Ungleichheit bei der Verteilung von Impfstoffen (beispielsweise zwischen Entwicklungsländern und westlichen Staaten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dabf04f5-59bc-4f4a-9329-40efbdaf98b2",
                                "sense_id": "da92f906-9d4e-307d-a7a7-461c637c0b7d",
                                "text": "[Coronapandemie:] „»Wir beobachten eine weltweit wachsende Impfkluft«“ [, sagt der israelische Virologe Nadav Davidovitch.]"
                            },
                            {
                                "example_id": "a8934eff-8df0-4f0c-9f89-312f7c0a91ee",
                                "sense_id": "da92f906-9d4e-307d-a7a7-461c637c0b7d",
                                "text": "[Schlagzeile:] „Seidenstraßeninitiative – Die Impfkluft, die China gezielt ausnutzt“"
                            },
                            {
                                "example_id": "bafb53da-b4e0-4c1c-a72d-0d74f4c853bf",
                                "sense_id": "da92f906-9d4e-307d-a7a7-461c637c0b7d",
                                "text": "[Coronapandemie 2021:] „WHO: Impfkluft ist „grotesk“ – Die Weltgesundheitsorganisation (WHO) prangert die Unterschiede zwischen armen und reichen Ländern bei den Impfraten an: Die Kluft werde „jeden Tag grotesker“, sagte WHO-Generaldirektor Tedros Adhanom Ghebreyesus am Montag in Genf.“"
                            },
                            {
                                "example_id": "cab67f7a-f999-48fb-8e31-b1f1bfbf13f7",
                                "sense_id": "da92f906-9d4e-307d-a7a7-461c637c0b7d",
                                "text": "[Coronapandemie 2021:] „Die WHO lässt kaum eine Gelegenheit aus, auf eine gefährliche Ungerechtigkeit hinzuweisen: die Impfkluft zwischen Arm und Reich. Die \"Ich-zuerst-Haltung\" der Reichen könne fatale Folgen haben.“"
                            },
