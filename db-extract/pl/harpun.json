                    {
                        "translation_id": "e598d87e-80af-4285-b025-b98aa4ba2938",
                        "source_entry_id": "654612da-f725-3425-a3af-227c80b251a9",
                        "source_sense_id": "dfb366a8-60d9-3973-9d92-96cf14c53da9",
                        "target_lang_word": "Harpune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harpune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                        "entry_id": "d10a75ba-6743-391d-a048-880e11d19e13",
                                        "glosses": [
                                            "Speer mit Widerhaken für den Fischfang oder Walfang"
                                        ],
                                        "tags": [
                                            "Fischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0d6bd42-f9c5-40b8-802e-74a1fa2db2d1",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Wie die Umweltschutzorganisation mitteilte, feuerte ein Walfänger beim Schuss auf einen Zwergwal eine Harpune nur einen Meter über ein Greenpeace-Schlauchboot.“"
                                            },
                                            {
                                                "example_id": "6149e4c5-7706-4227-a125-c51d10ccf919",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Besser wäre es natürlich, die Harpune mitzunehmen, einen Riesenfisch zu harpunieren und ihn an Land zu ziehen.“"
                                            },
                                            {
                                                "example_id": "d87e4873-b967-469e-89cd-5382647ee7e9",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Er legt ein unvermutetes Talent für das Wattfischen - mit einer kleinen selbst gefertigten Harpune - an den Tag.“"
                                            },
                                            {
                                                "example_id": "eefc5ace-d84f-43ea-8cc3-77ffef11c5c1",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Nach vier erfolglosen Versuchen warf er die Harpune ins Boot, zog sich an Bord und setze sich schweigend ins Heck, um das Paddel wieder aufzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88cfe85d-a26f-42f9-b7d2-64fbb6dbbcc8",
