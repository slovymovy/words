                                    {
                                        "sense_id": "06c4c367-1fa1-3ae5-b437-f02dc4247a57",
                                        "entry_id": "648cd998-3155-301a-94b8-406accb14d48",
                                        "glosses": [
                                            "aan een kat herinnerend of erop gelijkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968d88b0-820a-4f61-8f91-804af8319d1e",
                                                "sense_id": "06c4c367-1fa1-3ae5-b437-f02dc4247a57",
                                                "text": "Met een katachtige sprong belandde de lenige jongen van het dakje op de grond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2692b076-61db-4c14-b087-40996a83030a",
                        "source_entry_id": "883b0c8b-2cbb-3f19-9b16-c1d0f8c2ac3b",
                        "source_sense_description": "catlike",
                        "target_lang_word": "katzenhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katzenhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "456cb24b-3e76-3de3-8a14-405a3706a620",
                                        "entry_id": "44629a27-aeaf-35c3-99d3-2f8a4b4d53f9",
                                        "glosses": [
                                            "in gewisser Hinsicht mit einer Katze vergleichbar, ihr ähnlich: sich so bewegend, mit solchen Augen oder Anderes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5697c4cc-c026-4140-82ba-c23fcde02eda",
                                                "sense_id": "456cb24b-3e76-3de3-8a14-405a3706a620",
                                                "text": "„Bei einem anderen Gerichtstermin entkam er wartenden Reportern durch einen katzenhaften Sprung aus dem Fenster des Justizgebäudes.“"
                                            },
                                            {
                                                "example_id": "0e460de2-17fe-4a97-ab4d-a73634066ca8",
                                                "sense_id": "456cb24b-3e76-3de3-8a14-405a3706a620",
                                                "text": "„Henri de Toulouse-Lautrec sagte über die Cancan-Tänzerin, die sich \"La Goulue\" nannte: \"mal fröhlich, mal schüchtern, mal kühn oder katzenhaft graziös, geschmeidig wie ein Handschuh!\"“"
                                            },
                                            {
                                                "example_id": "bf016156-3d8b-4ae2-9486-b045d8cb05b2",
                                                "sense_id": "456cb24b-3e76-3de3-8a14-405a3706a620",
                                                "text": "„Einer der prominentesten Fälle aus der jüngeren Geschichte ist die holländische Tänzerin Mata Hari. \"Sie war die geborene Spionin, katzenhaft, falsch und skrupellos, sie lockte die Männer mit ihrem Körper\", urteilte der Untersuchungsrichter in Paris über die angebliche deutsche Spionin. Im Oktober 1917 wurde sie hingerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "698bebf7-e5f0-42e5-a887-ead9e4050587",
                        "source_entry_id": "883b0c8b-2cbb-3f19-9b16-c1d0f8c2ac3b",
                        "source_sense_description": "sly and spiteful",
                        "target_lang_word": "kattig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kattig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef0bdd9-f7f5-3599-971d-fb6575a9733b",
                                        "entry_id": "63b0e87d-5398-30b3-863e-987939ea64d4",
                                        "glosses": [
                                            "onvriendelijk, de onaardige variant van assertief, en dat alles vooral als het over een meisje gaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ec2bdb-6200-42ac-8267-dc34f4f1a2a5",
                                                "sense_id": "9ef0bdd9-f7f5-3599-971d-fb6575a9733b",
                                                "text": "Het kattige meisje deed heel gemeen tegen haar vriendinnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "123fcbfc-e47e-461a-b8b4-564f6ddc6406",
