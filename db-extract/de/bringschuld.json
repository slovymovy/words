                "senses": [
                    {
                        "sense_id": "c394c404-83f3-3e1f-b549-0b1a888211d3",
                        "entry_id": "a75e6104-ab26-3b2e-8503-cae1721ac4fb",
                        "glosses": [
                            "Aufgabe des aktiven Partners in einer Interaktion, sich um den Erfolg zu bemühen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eb737fa-5e72-4add-b786-9478e8118ae0",
                                "sense_id": "c394c404-83f3-3e1f-b549-0b1a888211d3",
                                "text": "„So wie Textverfaser eine rhetorische Bringschuld haben, haben die Rezipienten eine Holschuld.“"
                            },
                            {
                                "example_id": "6f1c6553-ce47-4349-9d5c-d70125aa3f4a",
                                "sense_id": "c394c404-83f3-3e1f-b549-0b1a888211d3",
                                "text": "„Er weiß, dass er in der Bringschuld ist und zeigen muss, warum wir ihn geholt haben. “"
                            },
                            {
                                "example_id": "5308c30a-fe9f-4a07-be48-e239d33c491a",
                                "sense_id": "c394c404-83f3-3e1f-b549-0b1a888211d3",
                                "text": "„Die Linguistik hat eine Bringschuld und eine Verantwortung der Sprachgemeinschaft gegenüber, deren Sprache sie erforscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "61be39a8-8cad-303c-9c24-7ba5ac5dd364",
                        "entry_id": "a75e6104-ab26-3b2e-8503-cae1721ac4fb",
                        "glosses": [
                            "„Schuld, die am Wohnort des Gläubigers zu begleichen ist“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "821140e8-4bce-42b3-86e9-efa3c2e31e9d",
                                "sense_id": "61be39a8-8cad-303c-9c24-7ba5ac5dd364",
                                "text": "„Die Niederlassung des Gläubigers ist bei der Bringschuld der Leistungsort für die Zahlung. Für die Warenannahme ist bei der Bringschuld der Ort des Schuldners der Übergabeplatz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
