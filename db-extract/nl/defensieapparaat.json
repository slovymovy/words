                        "examples": [
                            {
                                "example_id": "79ddf80d-a539-47d5-95b9-94eb149c8306",
                                "sense_id": "5455719b-0137-33e1-8a37-f1098df350ac",
                                "text": "Vrijdag en zaterdag komen alle NAVO-lidstaten bij elkaar voor een top in de Poolse hoofdstad Warschau. Het gaat dan onder meer over de spanningen met Rusland, de strijd tegen IS en het geld dat lidstaten uitgeven aan hun defensieapparaat."
                            },
                            {
                                "example_id": "11f054c8-da4c-419c-8650-9fba7a46cd49",
                                "sense_id": "5455719b-0137-33e1-8a37-f1098df350ac",
                                "text": "De VS zegt zich te willen focussen op Azië en daar militaire bases gaan openen om geld te besparen. Het land moet in tien jaar tijd een biljoen euro bezuinigen op zijn defensieapparaat."
                            },
                            {
                                "example_id": "eee6fbcf-4d87-419b-897f-597512db19b4",
                                "sense_id": "5455719b-0137-33e1-8a37-f1098df350ac",
                                "text": "De president ziet zich door ingrijpende bezuinigingen genoodzaakt flink te snijden in het defensieapparaat. De komende tien jaar moet er bijna 500 miljard dollar worden bezuinigd, zo'n 380 miljard euro."
                            }
                        ]
                    }
