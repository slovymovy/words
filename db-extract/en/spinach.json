                                "example_id": "4ed0a4e6-1580-497f-93f7-5bb4ba4e3f96",
                                "sense_id": "f13d9e12-dacb-38ca-997c-c17ca7ade5fd",
                                "text": "How much spinach you got on you?",
                                "translation": "Сколько у тебя с собой денег?"
                            }
                        ]
