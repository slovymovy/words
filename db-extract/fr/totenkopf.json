                "senses": [
                    {
                        "sense_id": "50b028d4-d40a-3771-80bd-1c11cde53435",
                        "entry_id": "70544fac-73be-357f-919a-91fbf22d64c4",
                        "glosses": [
                            "Insigne utilisé par différentes composantes armées, militaires ou paramilitaires au cours de l’histoire de l’Allemagne."
                        ],
                        "tags": [
                            "Germanisme"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "278cb5f3-333d-3eaa-a18f-fdf5855543dd",
                        "entry_id": "70544fac-73be-357f-919a-91fbf22d64c4",
                        "glosses": [
                            "Symbole nazi représentant une tête de mort qui était utilisé dans certaines sections SS."
                        ],
                        "tags": [
                            "Nazism",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "88fe4636-4d06-4d6e-81a8-4ad54e46bbb5",
                                "sense_id": "278cb5f3-333d-3eaa-a18f-fdf5855543dd",
                                "text": "Le RAC et NSBM utilisent des symboles issus de différentes cultures, en particulier nordique et germanique, pour propager la haine raciale et recruter de nouveaux adeptes. Ces symboles, tels que la croix celtique ou des runes, sont détournés de leur signification originale pour promouvoir des idéologies racistes, nationalistes et néonazies. D’autres, comme le soleil noir, la totenkopf et la croix gammée nazie, symboles intrinsèquement antisémites, sont utilisés pour glorifier la suprématie blanche et la “race aryenne”. En utilisant ces symboles, ces mouvements nationalistes cherchent à créer un sentiment contre-culturel et de repli identitaire tout en diffusant des idées toxiques racistes et xénophobes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e880542c-86c9-42e3-81e9-2cc42b0256d9",
                        "source_entry_id": "70544fac-73be-357f-919a-91fbf22d64c4",
                        "target_lang_word": "Totenkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totenkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5dba791e-a46e-3faf-9aef-4acc5ec0f93d",
                                        "entry_id": "70ee7faa-f084-3fc0-87af-5a4b457ca4e0",
                                        "glosses": [
                                            "der Kopf eines Verstorbenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04eba435-82f4-46c4-850a-cb9d900f4091",
                                                "sense_id": "5dba791e-a46e-3faf-9aef-4acc5ec0f93d",
                                                "text": "„Der Totenkopf wurde schon immer gern als Vanitas-Symbol, als Zeichen für die Vergänglichkeit, benutzt.“"
                                            },
                                            {
                                                "example_id": "af2f5d5d-cdb4-4556-ac49-8a766fbf8194",
                                                "sense_id": "5dba791e-a46e-3faf-9aef-4acc5ec0f93d",
                                                "text": "„Nach langem Zögern wurde der Schädel 1954 dem britischen Gouverneur von Tanganyika, Sir Edward Twining, übergeben, wo der Totenkopf des Schwarzen Napoleon seitdem im Mkwawa-Gedächtnismuseum von Kalenga zu besichtigen ist.“"
                                            },
                                            {
                                                "example_id": "82131215-de5b-4c74-ab75-7fcc4efaad4c",
                                                "sense_id": "5dba791e-a46e-3faf-9aef-4acc5ec0f93d",
                                                "text": "„Die Tür nach dem Felde war mit einer Lage Gips überzogen, und auf dieser waren in Reih und Glied fünfhundert Pfeifenköpfe angebracht, die Abd-el-Kaders, Neger, nackte Frauen, Hufeisen und Totenköpfe darstellten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8218fbe5-cc08-3968-8895-c501373f30d0",
                                        "entry_id": "70ee7faa-f084-3fc0-87af-5a4b457ca4e0",
                                        "glosses": [
                                            "ein Zeichen, das einen Totenkopf (siehe [1]) und damit Lebensgefahr symbolisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be29469f-45e1-4c3e-b015-1de2e27b059d",
                                                "sense_id": "8218fbe5-cc08-3968-8895-c501373f30d0",
                                                "text": "„Mein Scharführer trank sein Bier, schob die Mütze mit dem Totenkopf etwas zurück und glättete sein schweißiges Haar.“"
                                            },
                                            {
                                                "example_id": "09912ef6-2c8b-4510-b12c-d6c9450cfd63",
                                                "sense_id": "8218fbe5-cc08-3968-8895-c501373f30d0",
                                                "text": "Wenn auf einer Flasche ein stilisierter Totenkopf angebracht ist, darf man den Inhalt nicht trinken."
                                            },
                                            {
                                                "example_id": "0f22c3a1-3a60-4700-b35a-c432568a69c7",
                                                "sense_id": "8218fbe5-cc08-3968-8895-c501373f30d0",
                                                "text": "„Auf dem Heck der Schiffe waren Totenköpfe zu sehen, und auf den Decks standen Kapitäne mit Dreispitz auf dem Kopf, die ihre Pistolen und Rapiere schwangen.“"
                                            },
                                            {
                                                "example_id": "4f9222c7-5274-4e20-b83e-04fecc77ce08",
                                                "sense_id": "8218fbe5-cc08-3968-8895-c501373f30d0",
                                                "text": "„Unter den vielen Blauuniformierten entdecke ich jetzt auch einen in feldgrauem Waffenrock und scharfen Breeches: kein Mann vom Heer, sondern einer mit einem silbernen Totenkopf an der Mütze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b59df1fc-e618-3391-a973-9ca8d15cb918",
                                        "entry_id": "70ee7faa-f084-3fc0-87af-5a4b457ca4e0",
                                        "glosses": [
                                            "Kurzform für den Totenkopfschwärmer"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d94035f1-61c0-4c1b-8542-40abf8ede86a",
                                                "sense_id": "b59df1fc-e618-3391-a973-9ca8d15cb918",
                                                "text": "Den Totenkopf bekommt man normalerweise tagsüber nicht zu Gesicht, da er nachtaktiv ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
