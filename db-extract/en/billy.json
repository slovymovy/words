                    }
                ],
                "translations": [
                    {
                        "translation_id": "68e5df8b-6a7b-4a7a-ab0c-aaa6f156f562",
                        "source_entry_id": "6ed2a9b0-fec8-3ccb-9ab6-5a74abb200b2",
                        "source_sense_id": "bd33aa75-79df-3acc-8310-d3fd738aaa1b",
                        "source_sense_description": "Behälter zum Gebrauch über dem Lagerfeuer",
                        "target_lang_word": "Kochgeschirr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kochgeschirr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95c91265-54c8-34fb-82ec-5b1ec122fbe7",
                                        "entry_id": "5bc1d65f-dae2-3ab0-aa29-019445b67eb8",
                                        "glosses": [
                                            "Geschirr, das beim Kochen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b22335-9a09-4dae-ad1b-0016288523be",
                                                "sense_id": "95c91265-54c8-34fb-82ec-5b1ec122fbe7",
                                                "text": "„Viele Profiköche schwören auf Kochgeschirr aus Gusseisen: […]“"
                                            },
                                            {
                                                "example_id": "670a441c-bd4b-48b0-8f8f-ce384d0f9d4a",
                                                "sense_id": "95c91265-54c8-34fb-82ec-5b1ec122fbe7",
                                                "text": "„Dann zündete er den Spirituskocher an und setzte das Kochgeschirr mit Wasser darauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9db63b81-b8bc-3afa-b8f3-65ef7cb624cd",
                                        "entry_id": "5bc1d65f-dae2-3ab0-aa29-019445b67eb8",
                                        "glosses": [
                                            "Behälter für Nahrungsmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b1e894-81e8-4e3e-96a1-c82cc5fcbe56",
                                                "sense_id": "9db63b81-b8bc-3afa-b8f3-65ef7cb624cd",
                                                "text": "„Ich schnallte mein Kochgeschirr ab und ging zur Feldküche.“"
                                            },
                                            {
                                                "example_id": "77695fbf-eae9-4563-b7ee-cf7d9e5be8b8",
                                                "sense_id": "9db63b81-b8bc-3afa-b8f3-65ef7cb624cd",
                                                "text": "„Pierre rückte ans Feuer heran und begann zu essen, was im Kochgeschirr war, und dies Essen schmeckte ihm besser als alles, was man ihm in seinem ganzen Leben vorgesetzt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "880dc064-7a9b-4304-91e8-f77cd877d6e2",
                        "source_entry_id": "6ed2a9b0-fec8-3ccb-9ab6-5a74abb200b2",
                        "source_sense_id": "dd19cf37-c6f4-3f9d-b8ad-0632f37b6bb5",
                        "source_sense_description": "amerikanisch: der Stock zum Gebrauch als Waffe",
                        "target_lang_word": "Knüppel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knüppel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                        "entry_id": "f2484c3c-137a-3b09-9bca-095953533a12",
                                        "glosses": [
                                            "dicker Stock, der meist als Schlagwaffe verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9078d7bf-eb07-40fc-825e-11335609ec50",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "Er nahm den Knüppel und schlug zurück."
                                            },
                                            {
                                                "example_id": "79026bdb-ac08-4e62-b560-364cc73ca6a2",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "„Heu und Federvieh holten sie aus den Ställen, verflucht von den Bauern, die mit Knüppeln und Mistforken drohten, aber nichts gegen die Waffen der Reiter ausrichten konnten.“"
                                            },
                                            {
                                                "example_id": "3ea3173e-3e1d-40b9-ad49-4478c4457838",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "„Das war, als würfe man jemandem einen Knüppel zwischen die Beine.“"
                                            },
                                            {
                                                "example_id": "be780d62-44c6-4513-a823-9dc31be471f7",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "„Der Gegner dieses Fechters, der den Degen wegwarf und einen Knüppel in die Hand nahm, das waren die Russen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "605d289e-33fd-3f60-add1-6a87e9998bac",
                                        "entry_id": "f2484c3c-137a-3b09-9bca-095953533a12",
                                        "glosses": [
                                            "Brötchen aber zusätzlich mit Milch hergestellt"
                                        ],
                                        "tags": [
                                            "in Berlin und Umgebung eine Backware ähnlich einer Schrippe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928ab616-ae57-4fca-ab80-0b0d5d2a2d7c",
                                                "sense_id": "605d289e-33fd-3f60-add1-6a87e9998bac",
                                                "text": "Oh wie lecker, hier gibt es Knüppel und Splitterbrötchen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3160a2aa-dabf-454d-bf51-1b665532a0e7",
                        "source_entry_id": "6ed2a9b0-fec8-3ccb-9ab6-5a74abb200b2",
                        "source_sense_id": "daaba876-8a68-3573-903f-8f2044be0385",
