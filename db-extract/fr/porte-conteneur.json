                ],
                "senses": [
                    {
                        "sense_id": "a6abf268-1a2d-3317-938e-3a20c9e3442d",
                        "entry_id": "3ee4727a-51f9-3dc9-9a3f-817edb739f54",
                        "glosses": [
                            "Navire destiné au transport de conteneurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9306417-37f2-45b7-9ecb-8d8240d5c5fe",
                                "sense_id": "a6abf268-1a2d-3317-938e-3a20c9e3442d",
                                "text": "Les porte-conteneurs ont révolutionné le transport maritime et permis la mondialisation de l’économie."
                            },
                            {
                                "example_id": "9227f801-3071-4bdf-84b7-3662936fd452",
                                "sense_id": "a6abf268-1a2d-3317-938e-3a20c9e3442d",
                                "text": "Les derniers porte-conteneurs de Classe 3E de la Maersk apportent — au prix d’une réduction de la vitesse — deux innovations significatives : une réduction de 30 % de la consommation et une diminution de 30 % du rejet de gaz carbonique."
                            },
                            {
                                "example_id": "90f7af85-ad38-4571-be84-b32366e11c52",
                                "sense_id": "a6abf268-1a2d-3317-938e-3a20c9e3442d",
                                "text": "Des produits alimentaires de tous les continents s’offraient au long de rayonnages interminables, et j’avais presque le vertige en songeant à la logistique mobilisée, aux immenses porte-conteneurs traversant les océans incertains."
                            },
                            {
                                "example_id": "cedff5b3-2fd1-487a-90ea-5348241671d0",
                                "sense_id": "a6abf268-1a2d-3317-938e-3a20c9e3442d",
                                "text": "L'Ever Given, exploité par l’entreprise taïwanaise Evergreen Marine, est l'un des plus grands porte-conteneurs au monde. Il mesure 400 mètres, soit l’équivalent de quatre terrains de football, et peut transporter 20 000 conteneurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31ff4a8e-7c78-4a6b-85cf-b529e390577f",
                        "source_entry_id": "3ee4727a-51f9-3dc9-9a3f-817edb739f54",
                        "source_sense_id": "a6abf268-1a2d-3317-938e-3a20c9e3442d",
                        "target_lang_word": "Containerschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Containerschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d30839ea-2098-34a3-97cb-d7f5a986ce70",
                                        "entry_id": "8b09b23e-22c8-3fdf-8165-0c3e88ec500c",
                                        "glosses": [
                                            "Frachtschiff, das für den Transport von Containern gebaut ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82e149f-ffe3-483f-bdbb-6f2733c6c2fd",
                                                "sense_id": "d30839ea-2098-34a3-97cb-d7f5a986ce70",
                                                "text": "Die Containerschiffe werden anscheinend immer größer."
                                            },
                                            {
                                                "example_id": "2d4612b7-02cc-429b-ba0d-e27f92394bf0",
                                                "sense_id": "d30839ea-2098-34a3-97cb-d7f5a986ce70",
                                                "text": "„Ihr Arbeitgeber, ein weißer Mann, habe ihr geholfen auf ein Containerschiff zu gelangen.“"
                                            },
                                            {
                                                "example_id": "49768959-f967-456e-abf1-1716d9dab1ba",
                                                "sense_id": "d30839ea-2098-34a3-97cb-d7f5a986ce70",
                                                "text": "„Deswegen haben Hamburg und Schleswig-Holstein ausfallgefährdete Darlehen für mehr als 250 Containerschiffe, Tanker und Massengutfrachter in eine staatliche Gesellschaft ausgegliedert.“"
                                            },
                                            {
                                                "example_id": "2121a55c-6dd9-472e-9f2d-c9b2ac498b81",
                                                "sense_id": "d30839ea-2098-34a3-97cb-d7f5a986ce70",
                                                "text": "„Bereits vier Tage war ich in der griechischen Hauptstadt, am Mittwoch, den 3. Oktober, war ich mit einem Containerschiff am riesigen Hafen von Piräus angekommen.“"
                                            },
                                            {
                                                "example_id": "9237dbdd-88ef-4e48-8f69-cdf608881767",
                                                "sense_id": "d30839ea-2098-34a3-97cb-d7f5a986ce70",
                                                "text": "„Wie wichtig der Rhein als Transportweg für Massengüter und Container ist, wurde deutlich, als im März 2007 nach der Havarie eines Containerschiffes der Fluss für mehrere Tage gesperrt werden musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6500ab74-dbc6-4269-8888-4d23a49ccdfb",
                        "source_entry_id": "3ee4727a-51f9-3dc9-9a3f-817edb739f54",
