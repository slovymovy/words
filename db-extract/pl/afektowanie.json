                                                "example_id": "f6cbef80-afa1-439f-b145-48efd28d2c3e",
                                                "sense_id": "4ef00db7-4213-358b-8a41-b3de93aff70a",
                                                "text": "Just send a good, strong current through, so that the water overflows gushingly, and shake the reels from time to time […]"
                                            }
