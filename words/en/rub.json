{
    "word_family": [
        "rubber",
        "rubdown"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                    "sense_definition": "To move your hand, a cloth, or another object backwards and forwards over a surface while pressing against it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_friction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>rubbed</w> her hands together to keep them warm in the cold air.",
                            "target_lang_translations": {
                                "ru": "Она <w>потерла</w> руки друг о друга, чтобы согреть их на холодном воздухе.",
                                "zh": "她把双手<w>揉</w>在一起，好在冷空气中取暖。"
                            }
                        },
                        {
                            "text": "He <w>rubbed</w> the stain with a damp cloth until it disappeared.",
                            "target_lang_translations": {
                                "ru": "Он <w>тер</w> пятно влажной тряпкой, пока оно не исчезло.",
                                "zh": "他用湿布<w>擦</w>拭污渍，直到它消失。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rub hands together",
                        "rub eyes",
                        "rub hard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать рукой, тканью или другим предметом взад-вперед по поверхности, надавливая на нее.",
                        "zh": "在物体表面上用力来回移动手、布或其他物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тереть",
                                "target_lang_sense_clarification": "общее действие"
                            },
                            {
                                "target_lang_word": "потереть",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦",
                                "target_lang_sense_clarification": "一般动作"
                            },
                            {
                                "target_lang_word": "揉",
                                "target_lang_sense_clarification": "用手用力按压并转动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79577514-b7d0-3cd1-af16-8d7539a3756c",
                    "sense_definition": "To spread a substance like cream, liquid, or powder onto a surface or skin using a rubbing motion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_apply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>rub</w> the sun cream into your skin before going to the beach.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>втереть</w> солнцезащитный крем в кожу перед выходом на пляж.",
                                "zh": "去海滩前，你应该把防晒霜<w>抹</w>在皮肤上。"
                            }
                        },
                        {
                            "text": "The chef <w>rubbed</w> the chicken with a mixture of herbs and spices.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар <w>натер</w> курицу смесью трав и специй.",
                                "zh": "厨师用香草和香料混合物<w>擦</w>在鸡肉上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rub into",
                        "rub with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить вещество (крем, жидкость или порошок) на поверхность или кожу втирающими движениями.",
                        "zh": "通过摩擦动作将乳霜、液体或粉末等物质涂抹在表面或皮肤上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "втирать",
                                "target_lang_sense_clarification": "внутрь поверхности или кожи"
                            },
                            {
                                "target_lang_word": "натирать",
                                "target_lang_sense_clarification": "покрывать поверхность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦",
                                "target_lang_sense_clarification": "涂抹"
                            },
                            {
                                "target_lang_word": "抹",
                                "target_lang_sense_clarification": "涂抹"
                            },
                            {
                                "target_lang_word": "涂抹",
                                "target_lang_sense_clarification": "正式用法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3da4dd7-4b26-3e11-85ad-2d30fb033e2c",
                    "sense_definition": "To press or move against something in a way that causes pain, irritation, or damage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_chafe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My new shoes <w>rub</w> my heels whenever I walk long distances.",
                            "target_lang_translations": {
                                "ru": "Мои новые туфли <w>натирают</w> мне пятки, когда я хожу на большие расстояния.",
                                "zh": "我走长路时，新鞋总会<w>磨</w>脚后跟。"
                            }
                        },
                        {
                            "text": "The strap of the heavy bag <w>rubbed</w> against her shoulder.",
                            "target_lang_translations": {
                                "ru": "Лямка тяжелой сумки <w>терла</w> ей плечо.",
                                "zh": "沉重包包的带子一直<w>磨</w>着她的肩膀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rub against",
                        "shoes rub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давить или тереться обо что-то, вызывая боль, раздражение или повреждение.",
                        "zh": "因摩擦而导致疼痛、刺激或损伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натирать",
                                "target_lang_sense_clarification": "вызывать мозоли или повреждения"
                            },
                            {
                                "target_lang_word": "тереть",
                                "target_lang_sense_clarification": "причинять дискомфорт трением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨",
                                "target_lang_sense_clarification": "导致皮肤受损或不适"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9a435d2-118d-3f68-9fdb-ecac32abcaa2",
                    "sense_definition": "An act of moving something against a surface with pressure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give the table a good <w>rub</w> with this polish to make it shine.",
                            "target_lang_translations": {
                                "ru": "Хорошенько <w>протри</w> стол этой полиролью, чтобы он заблестел.",
                                "zh": "用这种抛光剂好好<w>擦</w>一下桌子，让它发亮。"
                            }
                        },
                        {
                            "text": "He gave his tired neck a quick <w>rub</w> to relieve the tension.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>растер</w> свою уставшую шею, чтобы снять напряжение.",
                                "zh": "他快速<w>揉</w>了揉疲惫的脖子以缓解紧张。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a rub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в движении чего-либо по поверхности с нажимом.",
                        "zh": "用力在表面上移动物体的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растирание",
                                "target_lang_sense_clarification": "массаж или лечебная процедура"
                            },
                            {
                                "target_lang_word": "протирка",
                                "target_lang_sense_clarification": "чистка поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦拭",
                                "target_lang_sense_clarification": "清洁动作"
                            },
                            {
                                "target_lang_word": "揉搓",
                                "target_lang_sense_clarification": "按摩或摩擦动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc77a25f-eef8-33e5-b003-ebe5e6236c82",
                    "sense_definition": "A substance, such as an ointment or spice mixture, designed to be applied to the body or food by rubbing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied a muscle <w>rub</w> to her sore back after the workout.",
                            "target_lang_translations": {
                                "ru": "Она нанесла мышечную <w>растирку</w> на больную спину после тренировки.",
                                "zh": "锻炼后，她在酸痛的背部涂抹了肌肉<w>擦剂</w>。"
                            }
                        },
                        {
                            "text": "Use a dry spice <w>rub</w> on the meat at least an hour before grilling.",
                            "target_lang_translations": {
                                "ru": "Используйте сухую <w>натирку</w> из специй для мяса по крайней мере за час до гриля.",
                                "zh": "烧烤前至少一小时，在肉上涂抹干香料<w>腌料</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle rub",
                        "spice rub",
                        "dry rub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, например мазь или смесь специй, предназначенное для нанесения на тело или еду путем втирания.",
                        "zh": "用于涂抹在身体或食物上的物质，如药膏或香料混合物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растирка",
                                "target_lang_sense_clarification": "жидкая мазь"
                            },
                            {
                                "target_lang_word": "натирка",
                                "target_lang_sense_clarification": "смесь специй"
                            },
                            {
                                "target_lang_word": "мазь",
                                "target_lang_sense_clarification": "лекарственное средство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦剂",
                                "target_lang_sense_clarification": "外用药"
                            },
                            {
                                "target_lang_word": "腌料",
                                "target_lang_sense_clarification": "用于食物的干香料混合物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25f1ced4-1e9e-3a43-97e6-c2526deecb0f",
                    "sense_definition": "A difficulty, problem, or obstacle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_problem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wants to travel the world, but the <w>rub</w> is that he has no money.",
                            "target_lang_translations": {
                                "ru": "Он хочет путешествовать по миру, но <w>загвоздка</w> в том, что у него нет денег.",
                                "zh": "他想环游世界，但<w>症结</w>在于他没钱。"
                            }
                        },
                        {
                            "text": "We have a great plan, but there is the <w>rub</w>: we lack the time to do it.",
                            "target_lang_translations": {
                                "ru": "У нас отличный план, но в этом-то и <w>загвоздка</w>: нам не хватает времени на его выполнение.",
                                "zh": "我们有个很棒的计划，但<w>难点</w>在于我们没时间去执行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snag",
                        "hitch",
                        "catch"
                    ],
                    "common_phrases": [
                        "there is the rub"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in the idiom 'there is the rub'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудность, проблема или препятствие.",
                        "zh": "困难、问题或障碍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загвоздка",
                                "target_lang_sense_clarification": "разговорное, часто в идиомах"
                            },
                            {
                                "target_lang_word": "затруднение",
                                "target_lang_sense_clarification": "формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难点",
                                "target_lang_sense_clarification": "关键问题"
                            },
                            {
                                "target_lang_word": "症结",
                                "target_lang_sense_clarification": "问题的核心"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}