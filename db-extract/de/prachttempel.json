                            {
                                "example_id": "fe607696-bdd6-4290-bdc4-2a8d76f06986",
                                "sense_id": "1b9613c3-da93-3735-b08a-dfc56734d1da",
                                "text": "„Im Zentrum erhob sich ein mit Juwelen besetzter Prachttempel, der dem semitischen Sonnengott Elagabal gewidmet war.“"
                            },
                            {
                                "example_id": "41692b65-2c8d-4c2a-9842-38220f1885cf",
                                "sense_id": "1b9613c3-da93-3735-b08a-dfc56734d1da",
                                "text": "„Entlang der Via Latina liegen einige römische Ruinen, darunter der restaurierte Tempel der Valerier und der Prachttempel der Barberini.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
