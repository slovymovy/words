                            {
                                "example_id": "91c6b396-b8fd-4d63-8b0d-2def5fe5ce48",
                                "sense_id": "141eb1c0-90d4-3181-9d52-2ec89e2b3603",
                                "text": "„In ihrem Spitznamen steckt die ganze banale Gegenwärtigkeit, das Generve, das Klein-Klein, das tägliche Aufräumen der Kinderzimmer, bei dem die Kinder nur widerwillig mitmachen.“"
                            },
                            {
                                "example_id": "a9bb19ca-2662-45b0-a4d7-4659d80daf7c",
                                "sense_id": "141eb1c0-90d4-3181-9d52-2ec89e2b3603",
                                "text": "„Die Deutschen wollen in Sachen Corona mit Blick auf das nahende Weihnachtsfest endlich klare Ansagen. Lieber einmal Courage in der Pandemie-Politik als weiterhin nur Klein-Klein […].“"
                            }
                        ],
