                        "glosses": [
                            "Having conspicuous jowls; with a double chin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643b61ec-af81-4823-a2b2-2516a19699c0",
                                "sense_id": "272f7ade-124a-3aee-9446-94b7a5c05a81",
                                "text": "[…] his strong jaw renders the face indeed “jowly” rather than oval, consequently the expression is normally hard, though open and not ill-humoured, whilst the smile which comes out of it is pleasant."
                            },
                            {
                                "example_id": "0ad1c9cd-b183-455b-b716-b0ad9b1c96cb",
                                "sense_id": "272f7ade-124a-3aee-9446-94b7a5c05a81",
                                "text": "Over the last few years, the liberal Democratic image of Vice President Richard M. Nixon as a jowly, blue-jawed villain with a ski-jump nose has receded in the light of his growing stature and achievements."
                            },
                            {
                                "example_id": "74370d42-ec86-43b2-b0c6-fcc206b36019",
                                "sense_id": "272f7ade-124a-3aee-9446-94b7a5c05a81",
                                "text": "Nick, or Domenico, was sixty or so now and looked it. He was jowly and paunched and was still Italian enough not to give a damn."
                            }
                        ]
                    }
