                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "привычку или дело"
                            },
                            {
                                "target_lang_word": "завязывать",
                                "target_lang_sense_clarification": "разг. прекращать делать что-то"
                            },
                            {
                                "target_lang_word": "избавляться",
                                "target_lang_sense_clarification": "от зависимости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戒掉",
                                "target_lang_sense_clarification": "摆脱习惯或瘾"
                            },
                            {
                                "target_lang_word": "改掉",
                                "target_lang_sense_clarification": "停止坏习惯"
                            }
                        ]
                    }
