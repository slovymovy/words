                ],
                "senses": [
                    {
                        "sense_id": "3acddc22-9f63-37ab-ba0f-e4f5f730f29d",
                        "entry_id": "7fcb5116-c094-306d-b8b2-9b3dea93012c",
                        "glosses": [
                            "aus dem Orleanstrauch (Bixa orellana) gewonnener orangeroter Farbstoff zum Färben von Nahrungs- und Genussmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd2c49c-6ca8-40bf-886e-1f5cb719495a",
                                "sense_id": "3acddc22-9f63-37ab-ba0f-e4f5f730f29d",
                                "text": "Früher wurde Orlean zum Färben von Textilien verwendet. Heute benutzt man ihn hauptsächlich zur Färbung von Lebensmittel, wie beispielsweise Käse."
                            },
                            {
                                "example_id": "6ee4e80f-b4c8-45f3-a40e-f8d8deb5ae85",
                                "sense_id": "3acddc22-9f63-37ab-ba0f-e4f5f730f29d",
                                "text": "Wenn man Orlean mit Wasser kocht, so entsteht eine röthlich gelbe trübe Brühe von starkem eigenthümlichen Geruch und widerlichem Geschmack."
                            },
                            {
                                "example_id": "48c1d9d1-56f5-4d01-815a-d801ef77f5e7",
                                "sense_id": "3acddc22-9f63-37ab-ba0f-e4f5f730f29d",
                                "text": "Um mit Orlean zu färben, löst man ihn stets in einer schwachen alkalischen Lauge."
                            },
                            {
                                "example_id": "b0eb4ef9-8ace-453e-9557-a2cd651502cd",
                                "sense_id": "3acddc22-9f63-37ab-ba0f-e4f5f730f29d",
                                "text": "Es gibt nur wenige substantive Farbstoffe. Diese sind pflanzlichen Ursprungs wie zum Beispiel Safran (Farbstoff: Crocetin, ein Carotinoid), Kurkumia (Farbstoff: Curcumin) und Orlean (Farbstoff: Bixin, ein Carotinoid)."
                            },
                            {
                                "example_id": "6d6640df-7dc1-421e-b3c1-a71695708e75",
                                "sense_id": "3acddc22-9f63-37ab-ba0f-e4f5f730f29d",
                                "text": "Nur wenige Farbstoffe färben Seide und Wolle direkt, ohne Beize oder Küpe, z.B. Orlean (Bixa orellana, orange), Berberitzenrinde und -wurzel (Berberis vulgaris, gelb), Kurkuma (Curcuma longa, gelb), Safflor (Carthamus tinctorius, rot), noch weniger sogar bei Baumwolle (Orlean und Kurkuma)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
