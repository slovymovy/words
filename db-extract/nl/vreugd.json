                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c5efa6d-353f-3109-b3c5-2caf7e965c87",
                        "entry_id": "4d1f2997-bc00-3092-acb7-4c1708f1984b",
                        "glosses": [
                            "vrolijke opgewekte stemming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4764b0a-88a1-45ec-ab08-514af89b8462",
                                "sense_id": "3c5efa6d-353f-3109-b3c5-2caf7e965c87",
                                "text": "Na de vreugde en tranen van gisteravond tijdens de verkiezingsbijeenkomsten kwamen de gekozen Tweede Kamerleden vandaag bijeen in Den Haag. Voor taart, maar ook om de volgende stappen te bespreken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6c06805-fd7a-43e4-8344-a011c8364be7",
                        "source_entry_id": "4d1f2997-bc00-3092-acb7-4c1708f1984b",
                        "source_sense_id": "3c5efa6d-353f-3109-b3c5-2caf7e965c87",
                        "target_lang_word": "joy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7fc6d6-0e84-34cd-9fad-4ff49bf09cf7",
                                        "entry_id": "238bcaa7-03a0-3448-a5cb-688589c5fe6b",
                                        "glosses": [
                                            "Expressing appreciation and happiness."
                                        ],
                                        "tags": [
                                            "dated",
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ecdeb84-5e96-4347-ad4e-e22675eb3d85",
                                                "sense_id": "9e7fc6d6-0e84-34cd-9fad-4ff49bf09cf7",
                                                "text": "'Joy! joy!' he cried, throwing his arms towards Heaven, 'on a grave be the site of our Temple; and now our happiness is for Eternity!'"
                                            },
                                            {
                                                "example_id": "0de65ece-25bc-4c4c-bc0f-4f6a588d74ab",
                                                "sense_id": "9e7fc6d6-0e84-34cd-9fad-4ff49bf09cf7",
                                                "text": "Hanrahan closed his mouth, tried unsuccessfully to breathe through his nose, then opened his mouth again. \"Oh, joy,\" he muttered. \"This kid doesn't even go to the bathroom, I bet. Probably been taught not to. It isn't nice.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0415c15a-f5df-3f21-b3d5-24211338247f",
                                        "entry_id": "d10abdb0-3bb0-3d7a-ae2e-ce068fe6edaf",
                                        "glosses": [
                                            "To feel joy, to rejoice."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095f3b04-4e4c-4fa1-86d6-b595951ee567",
                                                "sense_id": "0415c15a-f5df-3f21-b3d5-24211338247f",
                                                "text": "for oftymes or this oure lord shewed hym vnto good men and vnto good knyghtes in lykenes of an herte But I suppose from hens forth ye shalle see no more / and thenne they Ioyed moche / and dwelled ther alle that day / And vpon the morowe whan they had herde masse / they departed and commaunded the good man to god"
                                            },
                                            {
                                                "example_id": "2637f1d8-e911-4206-9216-0a21f9949553",
                                                "sense_id": "0415c15a-f5df-3f21-b3d5-24211338247f",
                                                "text": "I joy to see you wear around your neck the holy relic I bestowed on you;—but what Moorish charmlet is that you wear beside it?"
                                            },
                                            {
                                                "example_id": "98ec4155-aabf-4ce2-bab9-a35aad18a4c0",
                                                "sense_id": "0415c15a-f5df-3f21-b3d5-24211338247f",
                                                "text": "1885, Richard Francis Burton (translator), The Book of the Thousand Nights and a Night, Night 18, “Tale of the Portress,” p. 178,\nI swore readily enough to this and he joyed with exceeding joy and embraced me round the neck while love for him possessed my whole heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a3cc8ea-f764-31ef-aa41-b1036d830c3f",
                                        "entry_id": "d10abdb0-3bb0-3d7a-ae2e-ce068fe6edaf",
                                        "glosses": [
                                            "To enjoy."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f481cd2-6a3d-450b-b318-e3d9724f8534",
                                                "sense_id": "8a3cc8ea-f764-31ef-aa41-b1036d830c3f",
                                                "text": "I haue my wish, in that I ioy thy sight,"
                                            },
                                            {
                                                "example_id": "32e9cbba-d912-48f3-9035-c007c18ecac3",
                                                "sense_id": "8a3cc8ea-f764-31ef-aa41-b1036d830c3f",
                                                "text": "For from the time that Scudamour her bought,\nIn perilous fight, she neuer ioyed day […]."
                                            },
                                            {
                                                "example_id": "6df60ffc-ce01-48a7-8697-2c3a13f5d014",
                                                "sense_id": "8a3cc8ea-f764-31ef-aa41-b1036d830c3f",
                                                "text": "Is this the Love, is this the recompence\nOf mine to thee, ingrateful Eve, exprest\nImmutable when thou wert lost, not I,\nWho might have liv’d and joyd immortal bliss,\nYet willingly chose rather Death with thee:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df0bdff9-e7df-345e-b5aa-f48832adfba7",
                                        "entry_id": "d10abdb0-3bb0-3d7a-ae2e-ce068fe6edaf",
                                        "glosses": [
                                            "To give joy to; to congratulate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1111ab3-4754-4f6f-86d1-2593b87b6e88",
                                                "sense_id": "df0bdff9-e7df-345e-b5aa-f48832adfba7",
                                                "text": "Then round our Death-bed ev'ry Friend ſhou'd run, / And joy us of our Conqueſt, early won: […]"
                                            },
                                            {
                                                "example_id": "a7345b32-67f1-4a55-874b-8350f8190225",
                                                "sense_id": "df0bdff9-e7df-345e-b5aa-f48832adfba7",
                                                "text": "Evil like Us they shun, and covet Good;\nAbhor the Poison, and receive the Food.\nLike Us they love or hate: like Us they know,\nTo joy the Friend, or grapple with the Foe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e478a826-adad-35bb-ae1a-da882f6030f2",
                                        "entry_id": "d10abdb0-3bb0-3d7a-ae2e-ce068fe6edaf",
                                        "glosses": [
                                            "To gladden; to make joyful; to exhilarate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3eaa98-704a-4285-95ba-b854de526de9",
                                                "sense_id": "e478a826-adad-35bb-ae1a-da882f6030f2",
                                                "text": "Yet neither pleasure’s art can joy my spirits,\nNor yet the other’s distance comfort me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d307fc30-8f7b-3937-9e8f-2a351a4a6e66",
                                        "entry_id": "0449d2bd-6415-3c53-bddc-5025c136c198",
                                        "glosses": [
                                            "A feeling of extreme happiness or cheerfulness, especially related to the acquisition or expectation of something good."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5557c623-7672-471c-ba98-23d3c9a47df9",
                                                "sense_id": "d307fc30-8f7b-3937-9e8f-2a351a4a6e66",
                                                "text": "a child's joy on Christmas morning"
                                            },
                                            {
                                                "example_id": "397678c3-d3ea-47e9-9e09-3fb5570f9f29",
                                                "sense_id": "d307fc30-8f7b-3937-9e8f-2a351a4a6e66",
                                                "text": "It is his joy to walk in the rain."
                                            },
                                            {
                                                "example_id": "8f9ecf2b-76bb-42f0-a143-057087a0442d",
                                                "sense_id": "d307fc30-8f7b-3937-9e8f-2a351a4a6e66",
                                                "text": "[…]purſued his vnneighbourly purpoſe in ſuch ſort: that hee being the ſtronger perſwader, and ſhe (belike) too credulous in beleeuing or elſe ouer-feeble in reſiſting, from priuate imparlance, they fell to action; and continued their cloſe fight a long while together, vnſeene and vvithout ſuſpition, no doubt to their equall ioy and contentment."
                                            },
                                            {
                                                "example_id": "dc8b4e3d-db4d-4646-bc3c-dfa02ea8275e",
                                                "sense_id": "d307fc30-8f7b-3937-9e8f-2a351a4a6e66",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca1356f-ec9c-3e5e-971b-a18643064c66",
                                        "entry_id": "0449d2bd-6415-3c53-bddc-5025c136c198",
                                        "glosses": [
                                            "Anything that causes such a feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40973f94-077b-49b9-a550-e37b659b5a48",
                                                "sense_id": "3ca1356f-ec9c-3e5e-971b-a18643064c66",
                                                "text": "the joys and demands of parenthood"
                                            },
                                            {
                                                "example_id": "b1a4e804-530c-4a1a-bb21-217bfc498291",
                                                "sense_id": "3ca1356f-ec9c-3e5e-971b-a18643064c66",
                                                "text": "For, ye are our glory and ioy."
                                            },
                                            {
                                                "example_id": "bf21647e-d79e-4a8d-9ec2-105c81d39744",
                                                "sense_id": "3ca1356f-ec9c-3e5e-971b-a18643064c66",
                                                "text": "A thing of beauty is a joy forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4abd4391-5abe-30dd-9942-010d946c65c8",
                                        "entry_id": "0449d2bd-6415-3c53-bddc-5025c136c198",
                                        "glosses": [
                                            "Luck or success; a positive outcome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b20781a-986b-42da-90d9-e025cb7db906",
                                                "sense_id": "4abd4391-5abe-30dd-9942-010d946c65c8",
                                                "text": "Grant had no joy with taking a nap, so he began to systematically feel if everything was working: fingers and toes, etc."
                                            },
                                            {
                                                "example_id": "7e1b0724-871e-41a6-8da8-94c52db40a92",
                                                "sense_id": "4abd4391-5abe-30dd-9942-010d946c65c8",
                                                "text": "'Rob? It's Gary. Are you having any joy with this trip to Bali?' 'No joy at all, mate. I reckon Bali's out for the foreseeable future. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00014b8d-2db6-31c9-a9fd-d593b5d7865b",
                                        "entry_id": "0449d2bd-6415-3c53-bddc-5025c136c198",
                                        "glosses": [
                                            "The sign or exhibition of joy; gaiety; merriment; festivity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d36ad2c-5fe3-41e6-adea-048c808c3581",
                                                "sense_id": "00014b8d-2db6-31c9-a9fd-d593b5d7865b",
                                                "text": "Such ioy made Vna, when her knight she found;"
                                            },
                                            {
                                                "example_id": "35687ba9-a869-4cae-ac34-80ae9935ba12",
                                                "sense_id": "00014b8d-2db6-31c9-a9fd-d593b5d7865b",
                                                "text": "The roofs with joy resound."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
