                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de181583-0014-4c36-b301-07d1053ae1e4",
                                "sense_id": "bc83048a-5dda-3cec-9678-b2eaf090381a",
                                "text": "„Einem Behördensprecher zufolge handelt es sich um die dritthöchste Geldbuße, die bislang gegen Einzelpersonen verhängt wurde.“"
                            },
                            {
                                "example_id": "aec27743-e289-4df2-8721-f262c7a90d05",
                                "sense_id": "bc83048a-5dda-3cec-9678-b2eaf090381a",
                                "text": "„Der Chefinspekteur der Internationalen Atomenergiebehörde (IAEA), Tero Varjoranta, hat überraschend seinen Posten aufgegeben. Dies teilte ein Behördensprecher in Wien mit.“"
                            }
                        ],
