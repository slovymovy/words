                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Smoking",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db6e5eda-6d7e-30f2-8236-97cd3db7d7c2",
                                        "entry_id": "b4849bec-cd54-356f-a342-d0ac2a451efc",
                                        "glosses": [
                                            "Anzug für Herren, der bei kleineren gesellschaftlichen Anlässen getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1b47ca-7611-4041-95db-465beaf3208e",
                                                "sense_id": "db6e5eda-6d7e-30f2-8236-97cd3db7d7c2",
                                                "text": "„Ich hatte mir extra einen Smoking gekauft.“"
                                            },
                                            {
                                                "example_id": "7727001f-4449-4c9a-ab1a-60ce2e47062c",
                                                "sense_id": "db6e5eda-6d7e-30f2-8236-97cd3db7d7c2",
                                                "text": "„Die Gläser klangen aneinander, die Mädchen lachten hell auf, während sie schon das Glas zum Munde führten, denn der untersetzte Herr im Smoking mit dem Einglas im Auge und den Schmissen auf dem Bulldoggengesicht hatte mit der Sektflasche gegen den Rand des Kühlers geklopft.“"
                                            },
                                            {
                                                "example_id": "26753958-1d74-4a3c-b86c-d8e3feabeac1",
                                                "sense_id": "db6e5eda-6d7e-30f2-8236-97cd3db7d7c2",
                                                "text": "Zum Smoking trug er ein Hemd mit Biesen und ein Kummerbund."
                                            },
                                            {
                                                "example_id": "7c6bda1a-4e07-4cfa-992a-fc660e4774d2",
                                                "sense_id": "db6e5eda-6d7e-30f2-8236-97cd3db7d7c2",
                                                "text": "„Drei Mädchen in kurzen Paillettenkleidern tanzten zu persischem Pop um einen alten Mann im Smoking herum.“"
                                            },
                                            {
                                                "example_id": "f58a6fc3-b18f-4925-b2df-1a98b2dd6ea6",
                                                "sense_id": "db6e5eda-6d7e-30f2-8236-97cd3db7d7c2",
                                                "text": "„Der Herr Ober im Smoking nahm den Auftrag demütig gnädig auf und wiederholte die Namen der Gerichte und Getränke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7da3cba4-e038-49b5-8c05-dac5d10da5d5",
                        "source_entry_id": "350ecc79-542c-3637-85de-db5ade581574",
                        "source_sense_id": "501dd2d5-41f6-3f5c-ad88-1fc6e7e27654",
                        "target_lang_word": "dinner jacket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dinner jacket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a112c3eb-b99a-357d-b751-5c6277a92fba",
                                        "entry_id": "4de6a7b4-c54d-32c3-8313-27761a4216d4",
                                        "glosses": [
                                            "A jacket, often white, corresponding to a tuxedo jacket."
                                        ],
                                        "tags": [
                                            "US",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb40d174-9673-4de9-9df0-b7addbec0da1",
                                                "sense_id": "a112c3eb-b99a-357d-b751-5c6277a92fba",
                                                "text": "Constant was fully dressed in blue-green evening shorts and a dinner jacket of gold brocade."
                                            },
                                            {
                                                "example_id": "96cc5e4e-91f6-42ef-b571-72d78388470f",
                                                "sense_id": "a112c3eb-b99a-357d-b751-5c6277a92fba",
                                                "text": "He was dressed in a gray dinner jacket and matching trousers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                        "entry_id": "4de6a7b4-c54d-32c3-8313-27761a4216d4",
                                        "glosses": [
                                            "The formal suit, typically black, that includes this type of jacket."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b42f8e-f732-46d0-a2fc-039e37b31b7e",
                                                "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                                "text": "[They] sat in a pen in the corner, smoking cigarettes and reading magazines; four or five girls in black silk dresses and the same number of slight effeminate young men in dinner-jackets."
                                            },
                                            {
                                                "example_id": "e66fda71-d43d-4b59-b73a-417d4cfcbd42",
                                                "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                                "text": "Mr Lackersteen was even wearing a dinner-jacket—white, because of the season—and was completely sober. The boiled shirt and piqué waistcoat seemed to hold him upright and stiffen his moral fibre like a breastplate."
                                            },
                                            {
                                                "example_id": "8338a265-5e7d-4d35-b5a7-8c47a1f5f744",
                                                "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                                "text": "It was a dinner-jacket evening—not tails, because they would only be three—and though he had respected such niceties for years he found them suddenly ridiculous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
