                        "source_entry_id": "e9a559e2-72fd-380d-9111-356e383770c0",
                        "source_sense_id": "2e11af3a-0a6f-3b9d-b613-dad7945d50f5",
                        "source_sense_description": "Verkehr: Geländewagen mit Vierradantrieb, Jeep",
                        "target_lang_word": "Geländewagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geländewagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                        "entry_id": "4a568ca3-7598-37f9-817d-caa6eb3d2c02",
                                        "glosses": [
                                            "ein Automobil zum Befahren von schwierigem Gelände abseits von ausgebauten Straßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c751717e-abc1-4398-9a75-14809b4c7b87",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Mein Vater fährt einen Geländewagen Baujahr 2001."
                                            },
                                            {
                                                "example_id": "d8043dd4-db01-4bee-b112-d48edf5f3add",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Gestern wurde ein Geländewagen vom Dorfplatz gestohlen."
                                            },
                                            {
                                                "example_id": "2a7a950f-5de4-4971-9a3e-98059d292a08",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Auf dem Supermarktparkplatz stehen zwei hochwertige Geländewagen."
                                            },
                                            {
                                                "example_id": "f95ef263-7426-4dae-bd50-7467442748f6",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Während der Fahrt nach München überholten uns zwei schwarze Geländewagen."
                                            },
                                            {
                                                "example_id": "5c3c308d-db50-4b1a-b40b-13d81745f719",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Ein chromblitzender Geländewagen mit einer auffälligen Werbeaufschrift wurde von einem braungebrannten Muskelmann aus einer Ausfahrt gesteuert.“"
                                            },
                                            {
                                                "example_id": "ffe0f57b-934e-419d-86de-2bb39da33d18",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Bis auf 150 Meter kamen wir mit dem Geländewagen an den Schlund heran, dann zu Fuß weiter.“"
                                            },
                                            {
                                                "example_id": "1a99b769-97f3-4bbe-9d01-aef8060a4fde",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„In meinem Geländewagen sitzt man höher als in den meisten anderen Fahrzeugen, endlich muss Negusse nicht zu allen aufblicken!“"
                                            },
                                            {
                                                "example_id": "6e3eceab-f68d-43f9-b67a-24fd3190297e",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Wir hatten einen Geländewagen mit Vierradantrieb, aber genau davor habe ich seit jeher einen Horror, noch dazu bei schwierigem Gelände und allem, was das so mit sich bringt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85548028-3f02-4d26-81f0-c47d67c39852",
                        "source_entry_id": "e9a559e2-72fd-380d-9111-356e383770c0",
                        "source_sense_id": "2e11af3a-0a6f-3b9d-b613-dad7945d50f5",
                        "source_sense_description": "Verkehr: Geländewagen mit Vierradantrieb, Jeep",
                        "target_lang_word": "Jeep",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jeep",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                        "entry_id": "633a15c4-7473-3462-99b4-737195218786",
                                        "glosses": [
                                            "ein geländegängiger Kraftwagen mit Allradantrieb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b10758-ce9a-41f9-8f42-ed8473618e4d",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "Ich hab mir im Urlaub extra einen Jeep gemietet, um abseits der normalen Straßen fahren zu können."
                                            },
                                            {
                                                "example_id": "f330ba10-cb6d-4c09-8574-a2820b4d9edc",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Die fünf CIA-Agenten, die auf Sumatra dabei gewesen waren, machten sich Hals über Kopf mit einem Jeep Richtung Süden aus dem Staub.“"
                                            },
                                            {
                                                "example_id": "ba81fe8f-2241-4f0b-b1ba-fac7282cdab0",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Anfangs war es eine Qual, den Jeep zu fahren - der einzige Nachteil an ihm.“"
                                            },
                                            {
                                                "example_id": "c68fd3d9-9682-4a81-9c8f-84dde58e860a",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Ich verließ meinen Jeep, zog meine Schuhe aus, wusch meine Plattfüße im Suezkanal, ging dann zurück, stieg in meinen Jeep.“"
                                            },
                                            {
                                                "example_id": "d19fbedf-2a85-4d20-83ca-feb2f28c1f4e",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Sie parkten den Jeep vor der Jagdhütte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "92846393-650a-38b7-90f9-ffc0a2955d96",
                                        "entry_id": "633a15c4-7473-3462-99b4-737195218786",
                                        "glosses": [
                                            "eine Automarke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
