                        "entry_id": "db6b5821-db02-3fc1-b692-e5594d8429ce",
                        "glosses": [
                            "het uitputten van een tegenstander"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ca7cf3e9-25b1-40d0-ab81-3b6e4c6f98ba",
                                "sense_id": "cc7b2a65-4cdc-3e85-986e-82b78ca15151",
                                "text": "Of Gesink ooit een serieuze gooi had kunnen doen naar een Tourzege als hij de ploeg van nu om zich heen had gehad, zullen we nooit weten. Zeker is wel dat hij de afgelopen jaren met het nodige beuk- en sloopwerk aan het begin van een steile klim een flink steentje heeft bijgedragen aan het succes van zijn kopmannen."
                            }
                        ]
