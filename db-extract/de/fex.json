                "senses": [
                    {
                        "sense_id": "524739cf-6907-3f10-a58e-dd47239d7ddd",
                        "entry_id": "f9544746-f4fd-3b11-89d2-a08635634c56",
                        "glosses": [
                            "leidenschaftlicher, begeisterter Anhänger von etwas"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "c52975af-053b-4e4a-8009-a044d57b6eff",
                                "sense_id": "524739cf-6907-3f10-a58e-dd47239d7ddd",
                                "text": "Nicht wahr, er ist ein echter Fex."
                            },
                            {
                                "example_id": "1f1fbe39-489c-4a5e-8591-f0c4ecf04a7b",
                                "sense_id": "524739cf-6907-3f10-a58e-dd47239d7ddd",
                                "text": "„Aus Jux nennt man Jeden ein' Fex, der etwas mit an Blödsinn gränzender Passion treibt, so gibt's ein Musikfex, Pattifex, Münzenfex, Bergfex, der alle Sonntag ins Gebirg wandert, […]“ (1874)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e9855f7-f607-40ab-8e0c-a14dd6195b41",
                        "source_entry_id": "f9544746-f4fd-3b11-89d2-a08635634c56",
                        "source_sense_id": "524739cf-6907-3f10-a58e-dd47239d7ddd",
                        "target_lang_word": "enthusiast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enthusiast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                        "entry_id": "029a23de-4001-3410-8972-4ffc62560d20",
                                        "glosses": [
                                            "A person filled with or guided by enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd22552d-c3ff-44ce-81b9-6269fca8b4e8",
                                                "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                                "text": "But Charles Aubyn (for it was he) had, like most enthusiasts, overcalculated the influence of his eloquence; surprise had alone procured him a hearing, and the bold cavaliers around were little in the mood for a homily."
                                            },
                                            {
                                                "example_id": "cd28ba49-7500-4c4f-aa5f-0026929abce2",
                                                "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                                "text": "I would challenge any rock enthusiast to refrain from tapping his/her foot when listening to such music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc859136-4878-3bd1-9966-1558cadd2f23",
                                        "entry_id": "029a23de-4001-3410-8972-4ffc62560d20",
                                        "glosses": [
                                            "A person exhibiting over-zealous religious fervour."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
