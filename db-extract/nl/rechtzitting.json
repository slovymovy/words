                ],
                "senses": [
                    {
                        "sense_id": "ebf980ea-a2b6-322f-aab7-85cdd16b108d",
                        "entry_id": "bf5b54b1-854a-3a34-9367-38f8445201a7",
                        "glosses": [
                            "onderdeel van een proces waar het geschil wordt besproken met de rechter(s)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3063c874-fa25-4520-aa10-62dca72c0a9c",
                                "sense_id": "ebf980ea-a2b6-322f-aab7-85cdd16b108d",
                                "text": "Tijdens de rechtzitting houdt de officier van justitie zijn requisitoir en de advocaat zijn pleidooi."
                            },
                            {
                                "example_id": "1a1f3fb8-9106-4287-b9d0-b9c67cb49ab6",
                                "sense_id": "ebf980ea-a2b6-322f-aab7-85cdd16b108d",
                                "text": "De verdachten verdedigden hun uitgaven tijdens de rechtzitting met de uitleg dat die nodig waren voor een bepaalde levenstijl waarmee ze makkelijker toegang konden krijgen tot mensen die mooie zakelijke kansen boden."
                            },
                            {
                                "example_id": "cf80e70a-2f58-4b22-80b2-1c57d38a03d4",
                                "sense_id": "ebf980ea-a2b6-322f-aab7-85cdd16b108d",
                                "text": "De voorgeschiedenis is enerverend en de rechtzittingen trokken de aandacht van het grote publiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f5a4824-09f4-454b-987e-b5c1acf0cb3e",
                        "source_entry_id": "bf5b54b1-854a-3a34-9367-38f8445201a7",
                        "source_sense_id": "ebf980ea-a2b6-322f-aab7-85cdd16b108d",
                        "target_lang_word": "Gerichtsverhandlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerichtsverhandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc480d73-8456-3ded-b3c1-75ed8b858e2c",
                                        "entry_id": "ce385069-c89b-339f-8253-281fdb4df5e0",
                                        "glosses": [
                                            "Erörterung einer Angelegenheit oder eines Sachverhalts zu einem bestimmten gerichtlichen Termin vor Gericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb85c3d-80ec-40d4-a42a-2ff83350d657",
                                                "sense_id": "bc480d73-8456-3ded-b3c1-75ed8b858e2c",
                                                "text": "„Der Inhalt der Erzählung scheint die himmliche Gerichtsverhandlung zu sein, die jeder zu besuchen hat, bevor er ins Paradies kommt.“"
                                            },
                                            {
                                                "example_id": "c53a6b9e-5c74-4a35-86d0-15d5596b7e65",
                                                "sense_id": "bc480d73-8456-3ded-b3c1-75ed8b858e2c",
                                                "text": "Die Gerichtsverhandlung ist durch Urteil, Einstellung des Verfahrens oder Freispruch des Angeklagten beendet."
                                            },
                                            {
                                                "example_id": "8c1ed85e-ca5b-4a84-82cf-8ab19c0dab4d",
                                                "sense_id": "bc480d73-8456-3ded-b3c1-75ed8b858e2c",
                                                "text": "„So kann er die drohende Gerichtsverhandlung vermeiden.“"
                                            },
                                            {
                                                "example_id": "fce883b1-d3da-4932-8762-e86d073b8372",
                                                "sense_id": "bc480d73-8456-3ded-b3c1-75ed8b858e2c",
                                                "text": "„Nach der geglückten Gerichtsverhandlung am Montag war Hedin Poulsen jedenfalls der Ansicht, dass all die Unklarheiten in diesem Fall ihm zum Vorteil gereichten.“"
                                            },
                                            {
                                                "example_id": "f2609db2-03be-4476-b57a-3541a4bd7fda",
                                                "sense_id": "bc480d73-8456-3ded-b3c1-75ed8b858e2c",
                                                "text": "„Kalick war der Junge gewesen, der mich angezeigt hatte wegen Defätismus und während der Gerichtsverhandlung auf Härte, unerbittlicher Härte bestanden hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d003544c-c8b0-4d8e-9d40-691a2a2fd4b5",
                        "source_entry_id": "bf5b54b1-854a-3a34-9367-38f8445201a7",
                        "source_sense_id": "ebf980ea-a2b6-322f-aab7-85cdd16b108d",
                        "target_lang_word": "trial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c083f0cc-5937-3b0e-bb2a-3f86c1b5e7af",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "An occasion on which a person or thing is tested to find out how well they perform or how suitable they are."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c509f3-8411-4cfd-b8e5-02d732a2f55d",
                                                "sense_id": "c083f0cc-5937-3b0e-bb2a-3f86c1b5e7af",
                                                "text": "all thy vexations / Were but my trials of thy love and thou / Hast strangely stood the test here"
                                            },
                                            {
                                                "example_id": "8e7da6f2-3251-4f69-8833-025506ab5256",
                                                "sense_id": "c083f0cc-5937-3b0e-bb2a-3f86c1b5e7af",
                                                "text": "had my powers been less limited, I might have enforced obedience; but as it was, it was but a trial of strength between her and me, in which she generally came off victorious"
                                            },
                                            {
                                                "example_id": "f1fecb78-3135-4548-8cd5-f2ae07af965e",
                                                "sense_id": "c083f0cc-5937-3b0e-bb2a-3f86c1b5e7af",
                                                "text": "Jama saw the sweaty, smelly work as a kind of test that, if passed, would entitle him to see his father, a trial of his worth as a son and as a man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1a7f90-7888-3aaf-aa5b-680296804200",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "An occasion on which a person or thing is tested to find out how well they perform or how suitable they are.",
                                            "The testing of a product or procedure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4e92fd0-a8f3-4ab2-ab54-75b68bb7c154",
                                                "sense_id": "3a1a7f90-7888-3aaf-aa5b-680296804200",
                                                "text": "They will perform the trials for the new equipment next week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "571fca08-4db6-3cb4-93c2-a1a5b3e14a14",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "An occasion on which a person or thing is tested to find out how well they perform or how suitable they are.",
                                            "A research study to test the effectiveness and safety of a drug, medical procedure, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3214199d-c0cd-44df-90bb-f188cad9d34b",
                                                "sense_id": "571fca08-4db6-3cb4-93c2-a1a5b3e14a14",
                                                "text": "A randomized, controlled trial (RCT)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c776e61-4b99-3625-bebe-0d11e54a84e1",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "An occasion on which a person or thing is tested to find out how well they perform or how suitable they are.",
                                            "An event in which athletes’ or animals’ abilities are tested as they compete for a place on a team, or to move on to the next level of a championship, for example."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b50b2001-0042-46d6-99de-5f239f6b955d",
                                                "sense_id": "9c776e61-4b99-3625-bebe-0d11e54a84e1",
                                                "text": "soccer trials; sheepdog trials"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "465b722a-f971-31ea-ac27-3aba9a4e4582",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "An occasion on which a person or thing is tested to find out how well they perform or how suitable they are.",
                                            "A piece of ware used to test the heat of a kiln."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e14b08a2-7774-37d9-84d7-5b77a461f1c6",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "An occasion on which a person or thing is tested to find out how well they perform or how suitable they are.",
                                            "An internal examination set by Eton College."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b21a6eb-c382-3b3c-b52b-7ee4764ac711",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "An occasion on which a person or thing is tested to find out how well they perform or how suitable they are.",
                                            "An occasion on which armies or individuals meet in combat."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ffb7d8-58f2-46fe-a76a-182d6a28682a",
                                                "sense_id": "7b21a6eb-c382-3b3c-b52b-7ee4764ac711",
                                                "text": "In both your armies there is many a soul / Shall pay full dearly for this encounter, / If once they join in trial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "A meeting or series of meetings in a court of law at which evidence is presented to a judge (and sometimes a jury) to allow them to decide on a legal matter (especially whether an accused person is guilty of a crime)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7828cac2-2494-4473-9435-77da70bdd882",
                                                "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                                "text": "2020, Charles Yu, Interior Chinatown, New York: Pantheon, Act VI,\nYour Honor, we object to all of this. The whole thing. This mock trial. The entire justice system is rigged against my client."
                                            },
                                            {
                                                "example_id": "deb6e076-5758-4906-a2ed-7ef5a028bd44",
                                                "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                                "text": "If you are convicted at trial, you have the right to file an appeal."
                                            },
                                            {
                                                "example_id": "ea4e0fac-4670-40fa-92c8-34018370e7d3",
                                                "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                                "text": "He was charged with war crimes and brought to trial before the International Tribunal."
                                            },
                                            {
                                                "example_id": "7f983d4a-f1a9-4c64-86a4-bebef9163508",
                                                "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                                "text": "The journalists have been held in custody for three years without trial."
                                            },
                                            {
                                                "example_id": "c80157ec-c39f-4caf-b586-2939d423ea38",
                                                "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                                "text": "as she hath / Been publicly accused, so shall she have / A just and open trial"
                                            },
                                            {
                                                "example_id": "8e4b9389-11af-4706-b9b9-824693a4a077",
                                                "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                                "text": "She, after form of trial condemned to die on the scaffold, / Patiently met her doom at the foot of the statue of Justice."
                                            },
                                            {
                                                "example_id": "35a8fd88-5acd-4f6d-be8a-9ea8a8f78c29",
                                                "sense_id": "6aa6d892-7051-342b-9df6-0c2800d62581",
                                                "text": "[…] this case should never have come to trial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "591508e2-176f-3a70-a4e8-32f72893d087",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "A difficult or annoying experience or person; (especially religion) such an experience seen as a test of faith and piety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e0bf01-dcda-479f-b540-0a447dbe11e9",
                                                "sense_id": "591508e2-176f-3a70-a4e8-32f72893d087",
                                                "text": "That boy was a trial to his parents."
                                            },
                                            {
                                                "example_id": "d072e84d-70ad-44d4-8edb-f2c5b662f258",
                                                "sense_id": "591508e2-176f-3a70-a4e8-32f72893d087",
                                                "text": "That they are Cowards, many have said, but few have found it so in the time of Trial."
                                            },
                                            {
                                                "example_id": "39d6a76a-0c98-4472-a848-f7e28e279993",
                                                "sense_id": "591508e2-176f-3a70-a4e8-32f72893d087",
                                                "text": "Poor Justine was very ill; but other trials were reserved for her."
                                            },
                                            {
                                                "example_id": "fbd93f6c-12a0-4a45-aa7f-5d96defc1a0a",
                                                "sense_id": "591508e2-176f-3a70-a4e8-32f72893d087",
                                                "text": "I’m afraid I’m going to be a dreadful trial to you. Maybe you’d better send me back to the asylum."
                                            },
                                            {
                                                "example_id": "619d34cb-433a-4181-8b9d-c19fbd3b775f",
                                                "sense_id": "591508e2-176f-3a70-a4e8-32f72893d087",
                                                "text": "[…] I’m not used […] to waiting hungry on others while they eat. It is a sore trial for a hobbit, that."
                                            },
                                            {
                                                "example_id": "0b174ecc-a1c8-40a5-8416-9ff6a8e33475",
                                                "sense_id": "591508e2-176f-3a70-a4e8-32f72893d087",
                                                "text": "You must be strong now, for your greatest trials are still ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab717098-dd3a-3be4-a8a0-d38a8326c68b",
                                        "entry_id": "a3b51196-a8b7-3485-b512-9d75ce31a752",
                                        "glosses": [
                                            "The action of trying (to do) something, especially more than once. (This sense is still current in the expression trial and error.)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24342ea0-0e64-46fa-8d4d-dbaa6cc08a3a",
                                                "sense_id": "ab717098-dd3a-3be4-a8a0-d38a8326c68b",
                                                "text": "Finding my first Seed did not grow, which I easily imagin’d was by the Drought, I sought for a moister Piece of Ground to make another Trial in,"
                                            },
                                            {
                                                "example_id": "93dcad45-b3ea-4733-8802-4965e28ac44b",
                                                "sense_id": "ab717098-dd3a-3be4-a8a0-d38a8326c68b",
                                                "text": "He summoned up all his strength for one last trial, and bent his faltering steps towards [the house]."
                                            },
                                            {
                                                "example_id": "9a30c0c4-c3bc-4467-8022-a3f184bebc4c",
                                                "sense_id": "ab717098-dd3a-3be4-a8a0-d38a8326c68b",
                                                "text": "After a dozen trials he succeeded in lighting the lantern,"
                                            },
                                            {
                                                "example_id": "19c2b9e2-8844-411b-bcd4-2cffbb2e840d",
                                                "sense_id": "ab717098-dd3a-3be4-a8a0-d38a8326c68b",
                                                "text": "Before the first living cell was created, there may have been many trials and failures."
                                            }
                                        ]
                                    }
                                ]
                            },
