                        "sense_id": "a812511d-25d7-3810-ae7f-c3fd1cd3b02f",
                        "entry_id": "e8cc4439-76af-3c60-bf5b-fedac3c5a279",
                        "glosses": [
                            "związany z czartem, dotyczący czarta"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c9e0306-6a00-43f2-857c-d6d2ecf017d9",
                        "source_entry_id": "e8cc4439-76af-3c60-bf5b-fedac3c5a279",
                        "source_sense_id": "a812511d-25d7-3810-ae7f-c3fd1cd3b02f",
                        "target_lang_word": "чёртов",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чёртов",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8dedb136-49b9-3fed-b102-dd98e0d50e32",
                                        "entry_id": "b2b88bb4-0425-3d69-a7b9-782198eb30d2",
                                        "glosses": [
                                            "принадлежащий чёрту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "623226a0-44da-4d5e-9fcf-1b4baac187f1",
                                                "sense_id": "8dedb136-49b9-3fed-b102-dd98e0d50e32",
                                                "text": "Чёртов хвост."
                                            },
                                            {
                                                "example_id": "c62bbc3a-1414-4e1b-a65c-3a0b8143ea73",
                                                "sense_id": "8dedb136-49b9-3fed-b102-dd98e0d50e32",
                                                "text": "Чёртовы рога."
                                            },
                                            {
                                                "example_id": "89031005-24e4-4f05-a466-3663b2b854d7",
                                                "sense_id": "8dedb136-49b9-3fed-b102-dd98e0d50e32",
                                                "text": "Чёртово логово."
                                            },
                                            {
                                                "example_id": "4a848eb5-a069-448c-bc9a-918f294390b4",
                                                "sense_id": "8dedb136-49b9-3fed-b102-dd98e0d50e32",
                                                "text": "Два чёртовых ущелья."
                                            },
                                            {
                                                "example_id": "75c91f5c-37f9-4f31-a75c-df691227da4f",
                                                "sense_id": "8dedb136-49b9-3fed-b102-dd98e0d50e32",
                                                "text": "Однажды, написав ему письмо по этому делу, заключил его таким образом: «С истинным почтением имею честь быть не вам покорный слуга, потому что я чёртовым слугою быть не намерен, а просто слуга Божий, Александр Сумароков»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "991483ec-4860-3d67-af80-81e94cc4f17e",
                                        "entry_id": "b2b88bb4-0425-3d69-a7b9-782198eb30d2",
                                        "glosses": [
                                            "разг., сниж. проклятый, ненавистный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16dd2f73-f232-4417-a017-45e7ae91e0e1",
                                                "sense_id": "991483ec-4860-3d67-af80-81e94cc4f17e",
                                                "text": "— Вишь, он небось, чёртов сын, к себе не поставил, станичный-то."
                                            },
                                            {
                                                "example_id": "fbb8382a-ff4c-4ec5-9158-08fe342e1f00",
                                                "sense_id": "991483ec-4860-3d67-af80-81e94cc4f17e",
                                                "text": "И этот чёртов управдом будет только завтра!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
