        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "58d9df55-f8e5-33c5-9813-774ea5a3a89a",
                    "sense_definition": "in zeer sterke mate; heel erg",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik schrok me <w>dood</w> toen de deur plotseling dichtsloeg.",
                            "target_lang_translations": {
                                "en": "I was scared to <w>death</w> when the door suddenly slammed shut.",
                                "ru": "Я испугался <w>до смерти</w>, когда дверь внезапно захлопнулась."
                            }
                        },
                        {
                            "text": "Na die lange wandeling was ik echt <w>dood</w> op.",
                            "target_lang_translations": {
