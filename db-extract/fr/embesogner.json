                ],
                "senses": [
                    {
                        "sense_id": "01c17155-b0ac-37fa-8147-bd10a0c50247",
                        "entry_id": "5adf6f0c-1513-3084-a81c-1bd696003321",
                        "glosses": [
                            "Affecter une besogne à quelqu'un, occuper quelqu'un à un travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b5e6d8-fb3b-4890-b224-45f375dd5c69",
                                "sense_id": "01c17155-b0ac-37fa-8147-bd10a0c50247",
                                "text": "Ces soins de gagne-petit nous ont embesognés, et nos maîtres en ont profité."
                            },
                            {
                                "example_id": "d854f8bb-1f9c-4f4a-ac9b-63b4ad845d40",
                                "sense_id": "01c17155-b0ac-37fa-8147-bd10a0c50247",
                                "text": "Fils, petits-fils de gens de journée, ils vivaient eux aussi de leurs bras, battant les campagnes pour la loue au moment des récoltes et quand ils trouvaient à s'embesogner, ils pouvaient enfin manger pendant quelques semaines, par exemple un carrichon de pain avec son accompagnement: un petas de fromage, une sardine salée, une caponatina d'aubergines."
                            },
                            {
                                "example_id": "c5e27173-0d38-4c1a-a034-838f172f3305",
                                "sense_id": "01c17155-b0ac-37fa-8147-bd10a0c50247",
                                "text": "La lecture sert à éveiller la notion de sujet à « embesogner mon esprit, non ma mémoire »."
                            }
                        ]
                    }
                ],
