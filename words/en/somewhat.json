                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное количество, степень или часть.",
                        "zh": "一定的数量、程度或部分。"
                    },
                    "translations": {
                        "ru": [
