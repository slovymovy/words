                    {
                        "sense_id": "ebf9498b-f90d-3f4e-b7bf-dbcb9644aabd",
                        "entry_id": "535a23d5-b97b-33d3-bdcb-27f8301dec43",
                        "glosses": [
                            "obiekt przeznaczony do hodowli, tresury i pokazów wytresowanych delfinów lub innych waleni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19512973-28d3-4bdf-95c2-848af7005ae7",
                                "sense_id": "ebf9498b-f90d-3f4e-b7bf-dbcb9644aabd",
                                "text": "Chorzowskim ogrodem zoologicznym zainteresowani są z kolei Francuzi, którzy chcieliby otworzyć tutaj całoroczne delfinarium oraz egzotarium."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecbf2a23-5bdb-4051-8eb1-59e9209c8bbb",
                        "source_entry_id": "535a23d5-b97b-33d3-bdcb-27f8301dec43",
                        "source_sense_id": "ebf9498b-f90d-3f4e-b7bf-dbcb9644aabd",
