                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Athenian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b759c0b-6d5c-324b-a8f6-9e71a57a3274",
                                        "entry_id": "681265a7-5654-367f-afb4-2036824f9cf8",
                                        "glosses": [
                                            "An inhabitant, resident, or citizen of Athens, Greece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7151ad9c-7440-4f22-b94b-29b655cb06e8",
                                                "sense_id": "0b759c0b-6d5c-324b-a8f6-9e71a57a3274",
                                                "text": "Euen plaine Cittizens, hauing well deſerued of the Common-weale, were therefore among the Athenians ennobled."
                                            },
                                            {
                                                "example_id": "1f08f1f9-7ea9-442f-bd9c-fa386ccfce32",
                                                "sense_id": "0b759c0b-6d5c-324b-a8f6-9e71a57a3274",
                                                "text": "Here the satire is directed against the passion of the Athenians for the excitement of the law-courts[…]"
                                            }
                                        ]
                                    }
