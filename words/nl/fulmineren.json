            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ffabc7c-c636-3c98-a500-d06262ec70f5",
                    "sense_definition": "Hevig en woedend tekeergaan of schelden, vaak tegen een persoon of beleid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "woede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus bleef tijdens het felle debat onophoudelijk <w>fulmineren</w> tegen de nieuwe belastingmaatregelen.",
                            "target_lang_translations": {
                                "de": "Der Politiker fuhr während der hitzigen Debatte unaufhörlich fort, gegen die neuen Steuermaßnahmen zu <w>wettern</w>."
                            }
                        },
                        {
                            "text": "In zijn wekelijkse column <w>fulmineerde</w> de journalist tegen de toenemende bureaucratie in het onderwijs.",
                            "target_lang_translations": {
                                "de": "In seiner wöchentlichen Kolumne <w>wetterte</w> der Journalist gegen die zunehmende Bürokratie im Bildungswesen."
                            }
                        }
                    ],
                    "synonyms": [
                        "razen",
                        "tekeergaan",
                        "tieren"
                    ],
                    "common_phrases": [
                        "fulmineren tegen"
                    ],
                    "target_lang_definitions": {
                        "de": "Heftig und wütend schimpfen, wettern oder losziehen, oft gegen eine Person oder Maßnahme."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wettern",
                                "target_lang_sense_clarification": "heftig gegen etwas schimpfen (wettern gegen)"
                            },
                            {
                                "target_lang_word": "fulminieren",
                                "target_lang_sense_clarification": "gehoben für heftig schimpfen oder donnern"
                            },
                            {
                                "target_lang_word": "eifern",
                                "target_lang_sense_clarification": "erregt und leidenschaftlich gegen etwas reden"
                            },
                            {
                                "target_lang_word": "wüten",
                                "target_lang_sense_clarification": "in Zorn geraten und toben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2653f95d-8bc2-3bd1-b676-c62fc2fbb806",
                    "sense_definition": "Een luid, knallend of ontploffend geluid maken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het zware onweer hoorden de dorpelingen de donder vervaarlijk over de vallei <w>fulmineren</w>.",
                            "target_lang_translations": {
                                "de": "Während des schweren Unwetters hörten die Dorfbewohner den Donner bedrohlich über dem Tal <w>grollen</w>."
                            }
                        },
                        {
                            "text": "De chemische substantie begon plotseling luid te <w>fulmineren</w> in het afgesloten laboratorium.",
                            "target_lang_translations": {
                                "de": "Die chemische Substanz begann im abgeschlossenen Labor plötzlich lautstark zu <w>knallen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "knallen",
                        "ploffen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Zelden nog gebruikt in de betekenis van ontploffen of knallen."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein lautes, knallendes oder explodierendes Geräusch von sich geben (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "knallen",
                                "target_lang_sense_clarification": "ein lautes, explosives Geräusch machen"
                            },
                            {
                                "target_lang_word": "donnern",
                                "target_lang_sense_clarification": "laut dröhnen oder krachen"
                            },
                            {
                                "target_lang_word": "detonieren",
                                "target_lang_sense_clarification": "mit lautem Knall explodieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c29a43-96f1-3a11-b18a-8c447c390dbf",
                    "sense_definition": "Feestelijk met lichten versieren of verlichten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ter gelegenheid van het koninklijk huwelijk liet men het hele plein prachtig <w>fulmineren</w>.",
                            "target_lang_translations": {
                                "de": "Anlässlich der königlichen Hochzeit ließ man den gesamten Platz prachtvoll <w>illuminieren</w>."
                            }
                        },
                        {
                            "text": "De oude gevels werden 's avonds feeëriek <w>gefulmineerd</w> met honderden kleine lantaarns.",
                            "target_lang_translations": {
                                "de": "Die alten Fassaden wurden abends mit Hunderten kleiner Laternen zauberhaft <w>erleuchtet</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "illumineren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderde betekenis, synoniem met illumineren."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Festlich mit Lichtern schmücken oder beleuchten (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "illuminieren",
                                "target_lang_sense_clarification": "festlich beleuchten"
                            },
                            {
