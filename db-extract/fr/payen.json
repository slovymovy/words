                        "examples": [
                            {
                                "example_id": "dafb0a0b-79d8-4193-93fd-cfe3e4945279",
                                "sense_id": "f5c74737-05bf-3efe-90da-c69fff071285",
                                "text": "Le docteur Jean-Louis Payen est hépato-gastro-entérologue et écrivain."
                            },
                            {
                                "example_id": "e0cb0ade-ece7-4459-8d04-a0b50fc23b3a",
                                "sense_id": "f5c74737-05bf-3efe-90da-c69fff071285",
                                "text": "Gérard Payen, a présenté le PFE, Partenariat Français pour l’Eau, qui travaille sur l’eau à l’international dont un groupe de travail est spécifiquement dédié aux Outre-mer."
                            },
                            {
                                "example_id": "c95c0fcf-6945-4e68-993d-a85d1760c9c5",
                                "sense_id": "f5c74737-05bf-3efe-90da-c69fff071285",
                                "text": "Observer ses pairs, chercher à les comprendre et croire aux liens entre êtres humains restent des points importants de l'écriture de Pascale Payen qui flirte avec un réalisme à fleur de peau."
                            }
                        ]
                    }
                ],
