                "translations": [
                    {
                        "translation_id": "a79065c3-52e5-4bbf-b598-d058d7d52179",
                        "source_entry_id": "96bf53a9-cc58-399c-9250-b976e1b3dc56",
                        "source_sense_id": "45f27422-7f1a-31d8-9657-961568451e9d",
                        "source_sense_description": "river in Turkey, Georgia and Azerbaijan",
                        "target_lang_word": "Кура́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Кура́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5b7e33a-c707-3a47-82ad-3658daf11aeb",
                                        "entry_id": "9399f9b7-71e8-3c5a-87bf-601318b5a08a",
                                        "glosses": [
                                            "крупнейшая река Закавказья, впадающая в Каспийское море и протекающая по территории трёх государств: Турции, Грузии и Азербайджана, где в неё впадает Аракс; является основной рекой Грузии и Азербайджана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7276e1db-98ee-4828-a242-d46b0f101f0f",
                                                "sense_id": "f5b7e33a-c707-3a47-82ad-3658daf11aeb",
                                                "text": "Немного лет тому назад, // Там, где сливаяся шумят // Обнявшись, будто две сестры ,// Струи Арагвы и Куры, // Был монастырь."
                                            },
                                            {
                                                "example_id": "957b281c-5e7b-4cf1-a539-18b91fc59e9c",
                                                "sense_id": "f5b7e33a-c707-3a47-82ad-3658daf11aeb",
                                                "text": "С восточной стороны протекала Кура, а с юга возвышалась гора, на которой виднелись еще развалины верхней крепости, служившей цитаделью в прежние времена."
                                            },
                                            {
                                                "example_id": "9002e864-3419-49e2-8cda-579a8596f976",
                                                "sense_id": "f5b7e33a-c707-3a47-82ad-3658daf11aeb",
                                                "text": "Выйдя из дому, я обрывом спустилась к Куре, перешла мост и, взобравшись на гору с противоположного берега, оглянулась назад."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Кура́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "32b74ad9-9b47-3f01-81f9-ae3aa4e32b24",
                                        "entry_id": "205792f5-2c66-3c76-83fb-ff5a10c0446f",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0f0da4-df8f-480e-853f-eb6817043d0e",
                                                "sense_id": "32b74ad9-9b47-3f01-81f9-ae3aa4e32b24",
                                                "text": "Мою подругу зовут Кура."
                                            }
                                        ]
                                    }
                                ]
                            },
