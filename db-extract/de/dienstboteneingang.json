                "senses": [
                    {
                        "sense_id": "ebb27776-9a80-33bd-8c87-d2e4aa7e20ee",
                        "entry_id": "651c0cb1-59d2-3cab-a9ff-8b2f3f12d518",
                        "glosses": [
                            "Nebeneingang eines Gebäudes, der für die Benutzung durch die Dienstboten vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9029deb5-69cf-4a7a-afc9-70d9b16e1ad9",
                                "sense_id": "ebb27776-9a80-33bd-8c87-d2e4aa7e20ee",
                                "text": "„Den ehemaligen Dienstboteneingang dort haben wir durch ein großes Fenster ersetzt, damit ich mehr Licht habe.“"
                            },
                            {
                                "example_id": "3466fa17-97ae-4c30-bb81-416a3811ea4e",
                                "sense_id": "ebb27776-9a80-33bd-8c87-d2e4aa7e20ee",
                                "text": "„Zwar schlossen sich im Seitenflügel, entlang eines langen, schmalen Gangs, meist die Küche und etliche weitere Zimmer an, die vielfach über einen eigenen Dienstboteneingang verfügten.“"
                            },
                            {
                                "example_id": "a26f15af-298f-4bd6-8c27-d3f5b88dc982",
                                "sense_id": "ebb27776-9a80-33bd-8c87-d2e4aa7e20ee",
                                "text": "„Als er sein erstes Mandat antrat, fuhr Mujica mit dem Moped vor - der Portier am Parlamentsgebäude wollte ihn daraufhin zum Dienstboteneingang schicken.“"
                            },
                            {
                                "example_id": "0dfd582a-105a-4920-b422-49086eea7cb8",
                                "sense_id": "ebb27776-9a80-33bd-8c87-d2e4aa7e20ee",
                                "text": "„Oder sie mussten durch den Dienstboteneingang eintreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
