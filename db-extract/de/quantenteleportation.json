                "senses": [
                    {
                        "sense_id": "46a3dd64-3926-3ca7-b123-79491dd9c696",
                        "entry_id": "463bbbc3-fe36-34ad-9a06-f8a8fd56e82e",
                        "glosses": [
                            "Informationsübertragung auf Basis von quantenphysischen Vorgängen in verschränkten Quantensystemen"
                        ],
                        "tags": [
                            "Quantenphysik",
                            "Quantentechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "258e2092-0253-41af-b0a9-e02f4e1be881",
                                "sense_id": "46a3dd64-3926-3ca7-b123-79491dd9c696",
                                "text": "Bei der Quantenteleportation werden einem Photon, also einem Quantenteilchen, Eigenschaften entzogen und instantan auf ein nicht verbundenes, weit entferntes anderes Photon übertragen."
                            },
                            {
                                "example_id": "8b6f8df3-9173-4962-98ce-a80a7806fe51",
                                "sense_id": "46a3dd64-3926-3ca7-b123-79491dd9c696",
                                "text": "Die Quantenteleportation erinnert ein wenig an „Scotty beam me up“ aus Raumschiff Enterprise."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
