                "senses": [
                    {
                        "sense_id": "4c900873-0738-3cbb-96b0-58f04e990e4b",
                        "entry_id": "ebc343fd-c693-3c4e-9d7a-2009cafa369d",
                        "glosses": [
                            "sportlicher Wettkampf, an dem Personen aus allen Teilen der Erde teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf7976e-efa8-4a44-82af-8d9e91d2f3c6",
                                "sense_id": "4c900873-0738-3cbb-96b0-58f04e990e4b",
                                "text": "„Bei früheren Kontinental- und Weltturnieren wurden Änderungen meist noch nicht umgesetzt, sondern erst mit Start der nationalen Ligen.“"
                            },
                            {
                                "example_id": "8905e53c-38d9-48c4-9bbd-c5347c442cd3",
                                "sense_id": "4c900873-0738-3cbb-96b0-58f04e990e4b",
                                "text": "„Der 38-Jährige folgt auf Wolfgang Stark, der beim Weltturnier vor vier Jahren in Südafrika im Einsatz gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
