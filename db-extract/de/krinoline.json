                        "source_sense_description": "Kleidung: Reifrock (ein durch Reifen aus Holz, Draht oder Fischbein gespreizter Unterrock)",
                        "target_lang_word": "кринолин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кринолин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b019cb96-8625-33bf-af53-f9dc96e5a588",
                                        "entry_id": "c13eb9ed-6aa4-3c0b-9586-676b016ca303",
                                        "glosses": [
                                            "истор. широкая юбка на тонких обручах, надеваемая под платье для придания силуэту пышной формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6fd43a7-18bb-4e1a-b0ce-e239ea61287e",
                                                "sense_id": "b019cb96-8625-33bf-af53-f9dc96e5a588",
                                                "text": "Уж ныне все горничные растопырились, ходят в кринолинах."
                                            },
                                            {
                                                "example_id": "decdf080-e1cd-4b88-9a13-0332ba648edf",
                                                "sense_id": "b019cb96-8625-33bf-af53-f9dc96e5a588",
                                                "text": "А давно ли, читатель, невесты ходили в кринолинах, а женихи щеголяли в полосатых брюках и во фраках с искрой?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3660f6ea-3b60-38bd-bd94-95fe0df4bf7b",
                                        "entry_id": "c13eb9ed-6aa4-3c0b-9586-676b016ca303",
                                        "glosses": [
                                            "истор., морск. ограждение на речных судах в корме в виде фермы, предохраняющей руль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0906819c-ed68-46d3-b829-c9b6e716c2a7",
                                                "sense_id": "3660f6ea-3b60-38bd-bd94-95fe0df4bf7b",
                                                "text": "На платформах располагалось по четыре мины заграждения, которые сбрасывались в воду по выступающим с бортов решеткам, которые назывались кринолинами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8214c906-d703-3acf-b2d5-4fcc2949faa4",
                                        "entry_id": "c13eb9ed-6aa4-3c0b-9586-676b016ca303",
                                        "glosses": [
                                            "истор., морск. название противоторпедных сетей, подвешенных на особых выстрелах с обоих бортов корабля по всему их протяжению"
                                        ],
                                        "tags": [
                                            "в 1870–1880 годах"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60ce623a-5388-3d24-9f87-d9af1e141c80",
                                        "entry_id": "c13eb9ed-6aa4-3c0b-9586-676b016ca303",
                                        "glosses": [
                                            "истор., морск. вытянутая вдоль борта галерея крупного античного боевого корабля"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
