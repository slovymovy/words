                        "sense_id": "3b98b056-b0c6-3418-8771-2bdab0b8df0f",
                        "entry_id": "8870ff59-7a90-38df-bca5-1af1bab97c5a",
                        "glosses": [
                            "et régional (midi de la France, franco-provençal): têtu, entêté, opiniâtre, qui n’en fait qu'à sa tête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "905c2a96-bf09-4398-b63f-b27b8c0ef68f",
                                "sense_id": "3b98b056-b0c6-3418-8771-2bdab0b8df0f",
                                "text": "Elle est aussi testarde que son père!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f841353-d4b1-41fe-9f4a-a35ac5f09d9f",
                        "source_entry_id": "8870ff59-7a90-38df-bca5-1af1bab97c5a",
                        "source_sense_id": "3b98b056-b0c6-3418-8771-2bdab0b8df0f",
                        "target_lang_word": "dickköpfig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dickköpfig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                        "entry_id": "699f1afe-7d4e-3c90-8585-955a45fc9fcc",
                                        "glosses": [
                                            "auf der eigenen Meinung beharrend (selbst wenn diese als dumm oder lächerlich wahrgenommen wird); bei einem Disput/Streit nicht nachgebend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e5e8ee-e5db-49c4-9691-0b52f735d1fd",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Er nannte sie ärgerlich »die dickköpfigste, halsstarrigste Frau, die es je gegeben hat«.“"
                                            },
                                            {
                                                "example_id": "423264e4-dd07-4bd9-90e4-79054cd4d3ba",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Karl Obermüllers dickköpfiger Vater Gustav ist verbotenerweise Traktor gefahren und hat prompt einen Unfall gebaut.“"
                                            },
                                            {
                                                "example_id": "8b298b38-5b10-4ecd-8d18-3c7825123eea",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Obwohl Hartmut nichts mit ihr zu tun haben will, kann er sich der dickköpfigen Anhänglichkeit des Mädchens nicht erwehren und entschließt sich sogar, der Kleinen zu helfen.“"
                                            },
                                            {
                                                "example_id": "453f71c6-d39b-420a-b84f-e9db1db9ba6d",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„»Er war bekannt für seine Individualität, Integrität und gelegentliche dickköpfige Exzentrik«, hieß es weiter.“"
                                            },
                                            {
                                                "example_id": "da8debfd-f51b-44cc-bcc0-50a1858d1a8a",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Bobby Fischer erscheint hier aber vorwiegend als dickköpfige und durchaus auch richtig unsympathische Nervensäge,“ […]."
                                            },
                                            {
                                                "example_id": "22f1303c-35d9-43d0-a2fb-4c0ab50b72ce",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Zuletzt hauste er samt dickköpfigem Kater, einem philosophisch veranlagten Papagei und zwei gefräßigen Schildkröten in seiner privaten Arche Noah.“"
                                            },
                                            {
                                                "example_id": "7c3d3fc0-6d4f-4e89-ab5a-6ab92e1d66da",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„»Ich spiele im Internet und gehe täglich in den Park, um mich mit diesen alten Cracks zu messen. Beim Schach verfolge ich den selben dickköpfigen Ansatz wie im wahren Leben. In dem Sinne, dass ich nicht versuche, besser zu werden, indem ich darüber lese, sondern indem ich eigene Erfahrungen mache, viel spiele und mich durch meine Fehler verbessere. Auch wenn jeder richtige Schachspieler, der das jetzt hört, wahrscheinlich denkt: ‚Was für ein Trottel.‘«“"
                                            },
                                            {
                                                "example_id": "7ee1ef39-27f9-49bb-b5d5-9c0eb03a0d7d",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "[…] „Hunde dieser Rasse können manchmal sehr dickköpfig sein“ […]."
                                            },
                                            {
                                                "example_id": "bffb8ea0-9749-484e-b0cf-c60d0501d405",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Weil Dunja und Joe beide zu stolz und dickköpfig sind, sich auszusöhnen, bricht Joe am nächsten Tag zur Rückreise nach München aus.“"
                                            },
                                            {
                                                "example_id": "d4378c9f-db25-4241-95d7-dda87a2584c7",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "[Garton Ash über die Briten und den Brexit:] „»Wir sind dickköpfig und stur, einige Jahre müssten vergehen, bevor wir überhaupt einsehen, einen großen Fehler gemacht zu haben.«“"
                                            },
                                            {
                                                "example_id": "ce0c8d0d-a5e7-4596-a63d-4955cd0b814e",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Colani war schon immer dickköpfig - und so ließ er sich auch von niemandem in seine Arbeit reinreden.“"
                                            },
                                            {
                                                "example_id": "030341da-52bf-4ced-9f09-02e6fe32a240",
                                                "sense_id": "cc52bc10-9d82-37ad-9f3d-886d017d7c29",
                                                "text": "„Der Waliser an sich gilt als gutmütig und dickköpfig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44257f0c-ad52-45ce-b471-d46dcafb6494",
                        "source_entry_id": "8870ff59-7a90-38df-bca5-1af1bab97c5a",
                        "source_sense_id": "3b98b056-b0c6-3418-8771-2bdab0b8df0f",
                        "target_lang_word": "eigensinnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eigensinnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "418952ec-bdf3-37f3-8ca7-421823720305",
                                        "entry_id": "576d6776-9ae5-3780-bee3-35282c78b182",
                                        "glosses": [
                                            "gegen alle vernünftigen Vorstellungen beharrend, von Eigensinn bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90091a87-70ad-4e1a-ba20-6e67f02f17db",
                                                "sense_id": "418952ec-bdf3-37f3-8ca7-421823720305",
                                                "text": "Ungesellige Menschen sind gewöhnlich eigensinnig."
                                            },
                                            {
                                                "example_id": "c66e7b5c-b84f-4d57-9986-3cfce9d6abef",
                                                "sense_id": "418952ec-bdf3-37f3-8ca7-421823720305",
                                                "text": "„Der edle Mensch ist festen Sinnes, doch eigensinnig ist er nicht.“ (Konfuzius)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa49706f-78e3-495b-b7dc-ea0c45318d9b",
                        "source_entry_id": "8870ff59-7a90-38df-bca5-1af1bab97c5a",
                        "source_sense_id": "3b98b056-b0c6-3418-8771-2bdab0b8df0f",
                        "target_lang_word": "starrköpfig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starrköpfig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                        "entry_id": "b4be7968-72a0-3a0f-9c2c-aff847078989",
                                        "glosses": [
                                            "auf der eigenen Meinung beharrend (selbst wenn diese als dumm oder lächerlich wahrgenommen wird); bei einem Disput/Streit nicht nachgebend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659c63b9-f19b-493a-96f4-8b694a59cdad",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Nach dem Tod seiner Frau wurde Zürrer zum starrköpfigen Einzelgänger.“"
                                            },
                                            {
                                                "example_id": "094f280f-60d2-4744-9a5e-34f6131c872b",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Cetshwayo wurden eine starrköpfige Haltung und die Duldung von Grenzverletzungen in Transvaal und Natal vorgeworfen.“"
                                            },
                                            {
                                                "example_id": "fdf25026-862f-4358-bfbc-954a718fda63",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "[Atomkraftwerke:] „Es handelt sich übrigens nicht um eine Fehleinschätzung starrköpfiger kommunistischer Diktatoren: England, Frankreich und zahlreiche osteuropäische Länder kommen zu dem gleichen Schluss wie China.“"
                                            },
                                            {
                                                "example_id": "8cb80aff-0e99-4b1f-8892-9f176ab2a639",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Die Ermittlungen im Umfeld der Toten führt Klufti in sehr abgelegene Alpentäler und zu deren starrköpfigen Bewohnern, die noch wortkarger sind als er.“"
                                            },
                                            {
                                                "example_id": "3c2dfa44-0fce-4dbf-84dc-512ca6013bd9",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Marens unsichere Versuche, sich mit ihrem Vater auszusöhnen, scheinen bei dem starrköpfigen alten Mann auf taube Ohren zu stoßen“ […]."
                                            },
                                            {
                                                "example_id": "13b18ca1-7af7-44f8-8e11-ca8fc81c176e",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "[Gebrüder Grimm:] „»Sie waren sehr aneckende Charaktere, sie waren Arbeitstiere, Moralisten und Freaks.« Sie seien bekannt gewesen für ihre strenge und starrköpfige Art, besonders wenn es um ihre Forschung ging.“"
                                            },
                                            {
                                                "example_id": "1340747b-2db6-45ac-a929-c1ffd209720e",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Opferverbände kritisierten, dass Margot Honecker bis zu ihrem Tod starrköpfig den DDR-Unrechtsstaat und den Mauerbau verteidigt hatte“ […]."
                                            },
                                            {
                                                "example_id": "cc52837b-3d40-4c7d-b417-78034abdb92d",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Hitler blieb aber starrköpfig und verweigerte dem Afrika-Korps den Rückzug auf das europäische Festland.“"
                                            },
                                            {
                                                "example_id": "cd435c21-394c-4ba4-b0e1-874a8d9654b6",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Mehdorn ist starrköpfig und verschlimmert so Konflikte stets.“"
                                            },
                                            {
                                                "example_id": "7e7f0d25-68e3-4d24-b6a5-5f19ed0923aa",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "[Kirk Douglas:] „Hollywood mag ihn nicht - trotz seiner Erfolge. Er ist eigensinnig, starrköpfig und ordnet sich nicht dem Regelwerk der allmächtigen Studio-Bosse unter.“"
                                            },
                                            {
                                                "example_id": "bc6bb18f-4868-4a4f-9279-f7634d814e5c",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„»Tagelang habe ich im Fernsehen die Proteste mitverfolgt. Als die große Masse an Menschen zu Hause blieb, habe ich mit meinem Protest begonnen. Nicht weil ich starrköpfig bin, sondern konsequent.«“"
                                            },
                                            {
                                                "example_id": "a69b22bd-ca67-48e2-ab2f-31758861ee04",
                                                "sense_id": "1933dfa4-a798-3c20-975e-a8fbb27ee7bd",
                                                "text": "„Warum scheitert er? Weil er sich zu wichtig nimmt, stur und starrköpfig wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
