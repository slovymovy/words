            {
                "entry_id": "4408cf11-ea44-340d-a8c4-bb4c13cb8b7f",
                "word": "SPD",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "68ddff91-ba64-32ab-b3d4-5405e05eef19",
                        "entry_id": "4408cf11-ea44-340d-a8c4-bb4c13cb8b7f",
                        "glosses": [
                            "Initialism of Social Democratic Party of Germany (“Sozialdemokratische Partei Deutschlands”)."
                        ],
                        "tags": [
                            "German",
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "a77fcf20-4538-4532-9177-0018b8b4780a",
                                "sense_id": "68ddff91-ba64-32ab-b3d4-5405e05eef19",
                                "text": "Albrecht Lein reports that the core of the Braunschweig Antifa was made up of KPD and SPD members in their forties and fifties who had avoided the front, though Catholic workers’ organizations and other forces were also involved."
                            },
                            {
                                "example_id": "8df5d252-ad3f-4699-ad85-a793d44f3864",
                                "sense_id": "68ddff91-ba64-32ab-b3d4-5405e05eef19",
                                "text": "In a quirk of German politics, the governing coalitions are often given names. The previous coalition government, headed by the SPD (red), included the Green Party (green) and Liberal Party (yellow) - together they were known as the “traffic light” coalition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57fc6016-2ebd-4aaf-abf7-4b56ef95cc8a",
                        "source_entry_id": "4408cf11-ea44-340d-a8c4-bb4c13cb8b7f",
                        "source_sense_id": "68ddff91-ba64-32ab-b3d4-5405e05eef19",
                        "source_sense_description": "Social Democratic Party of Germany",
                        "target_lang_word": "SPD",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "SPD",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b761c204-ee93-3f70-82d5-64f69d07284b",
                                        "entry_id": "66fbfa73-c003-30bb-bd2f-44670597dfd9",
                                        "glosses": [
                                            "Sozialdemokratische Partei Deutschlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d5878d3-2eb0-4610-8df0-0a2b128f12ae",
                                                "sense_id": "b761c204-ee93-3f70-82d5-64f69d07284b",
                                                "text": "„Von 1949–1969 war die SPD Oppositionspartei. Von 1966–1969 bildete sie mit der CDU/ CSU unter Bundeskanzler Kiesinger eine Große Koalition und von 1969–1982 mit der F.D.P. die sozial-liberale Koalition unter den Kanzlern Brandt und Schmidt.“"
                                            },
                                            {
                                                "example_id": "77fcac80-bc71-4b60-92d8-4d7dbc0c1793",
                                                "sense_id": "b761c204-ee93-3f70-82d5-64f69d07284b",
                                                "text": "„Zufällig für den Tag der österreichischen Kriegserklärung hatte die SPD zu einer großen Antikriegsdemonstration im Zentrum Berlins aufgerufen.“"
                                            },
                                            {
                                                "example_id": "452a17be-a249-4b46-9892-6eae7f899f5f",
                                                "sense_id": "b761c204-ee93-3f70-82d5-64f69d07284b",
                                                "text": "„Die Führung der SPD jedenfalls will ein Entgegenkommen.“"
                                            },
                                            {
                                                "example_id": "bbddbe1e-165c-405b-b5fa-e395e8903e84",
                                                "sense_id": "b761c204-ee93-3f70-82d5-64f69d07284b",
                                                "text": "„Die SPD hat hier also gewissermaßen das Erstgeburtsrecht für eine durchaus respektable Bezeichnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "SPD",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5557a754-6629-3aae-a55f-2def6142e96d",
                                        "entry_id": "0fa9be24-6fa6-39bc-9964-bcf8b11fd1cc",
                                        "glosses": [
                                            "Sozialpsychiatrischer Dienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "634128fa-cac3-4d12-acc9-374654263cd1",
                                                "sense_id": "5557a754-6629-3aae-a55f-2def6142e96d",
                                                "text": "Der Pädagoge des SPD empfiehlt den Besuch einer Tagesstätte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
