                "senses": [
                    {
                        "sense_id": "7241a7e2-c8be-3742-a028-0eda37a7d395",
                        "entry_id": "bb535a00-032a-3517-bda0-2adc149d2caf",
                        "glosses": [
                            "Donner un caractère ésotérique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad13887-e5dc-41a3-bbbf-0d405e640cfc",
                                "sense_id": "7241a7e2-c8be-3742-a028-0eda37a7d395",
                                "text": "Voulant a priori ésotériser l’exotérisme, l’Islam tendra forcément à exotériser l’ésotérisme ; non la gnose en soi, laquelle est inviolable, mais le Soufisme en tant que phénomène global ;"
                            },
                            {
                                "example_id": "58a8058b-2d35-4a1f-8cfd-dfc84f6fa99f",
                                "sense_id": "7241a7e2-c8be-3742-a028-0eda37a7d395",
                                "text": "Le projet des cabalistes chrétiens n’était pas « d’ésotériser » le christianisme par le judaïsme, mais de faire dire à la tradition juive ce que les cabalistes chrétiens supposaient être son dernier mot : le christianisme."
                            }
                        ]
                    }
