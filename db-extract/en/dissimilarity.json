                "entry_id": "b4f695fa-428c-3454-afc2-a9cd72be3694",
                "word": "dissimilarity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "84a7d327-5dcf-4ed8-b77d-165541a880f4",
                        "entry_id": "b4f695fa-428c-3454-afc2-a9cd72be3694",
                        "tags": [
                            "plural"
                        ],
                        "form": "dissimilarities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "def4ee8d-138c-30c4-b012-a2166103bd68",
                        "entry_id": "b4f695fa-428c-3454-afc2-a9cd72be3694",
                        "glosses": [
                            "A lack of similarity or a lack of likeness in appearance to something else."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e030ad86-b136-423f-b896-addd4607c6d6",
                                "sense_id": "def4ee8d-138c-30c4-b012-a2166103bd68",
                                "text": "The experiment was abandoned when one fine day spontaneous combustion of the pulverised coal in the container occurred, and a black cloud of the very finely divided fuel rose into the air by the force of the explosion, and was slowly wafted by the prevailing breeze over the town, upon which it descended with the resemblance of black snow, but with the dissimilarity that it did not melt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d74a42c-6425-45ce-9ebd-5cac9e540886",
                        "source_entry_id": "b4f695fa-428c-3454-afc2-a9cd72be3694",
                        "source_sense_id": "def4ee8d-138c-30c4-b012-a2166103bd68",
                        "source_sense_description": "lack of similarity in appearance to something else",
                        "target_lang_word": "dissimilitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissimilitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53ecd2ac-bdf9-3e13-8138-860f16dd9cf2",
                                        "entry_id": "4c354085-bbcd-3ee9-8396-f953c86b2625",
                                        "glosses": [
                                            "Absence ou manque de similitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87dbf616-ef11-472e-ac0e-b38d116bb1eb",
                                                "sense_id": "53ecd2ac-bdf9-3e13-8138-860f16dd9cf2",
                                                "text": "Le second état de la gravure présente une dissimilitude frappante avec le premier."
                                            },
                                            {
                                                "example_id": "3c6e65f3-8a0d-4e72-b2fb-f393cbda558c",
                                                "sense_id": "53ecd2ac-bdf9-3e13-8138-860f16dd9cf2",
                                                "text": "1. beaucoup de grammairiens ont agité la question de savoir si, dans la déclinaison des mots, il faut suivre la dissimilitude ou la similitude, c’est-à-dire, en d’autres termes, l’anomalie ou l’analogie."
                                            },
                                            {
                                                "example_id": "e060fd97-aac5-4211-98e3-e68ba65ecc0b",
                                                "sense_id": "53ecd2ac-bdf9-3e13-8138-860f16dd9cf2",
                                                "text": "Sans doute la dissimilitude que nous avons constatée entre l’\"intellectus\" et la \"res\" contredit la perfection de l’accord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
