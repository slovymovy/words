                            {
                                "example_id": "ce58b3d9-990d-40c8-a6f2-8681d62bc739",
                                "sense_id": "8b63513c-67a5-3964-a214-af97f0d2c91f",
                                "text": "Twintig jaar lang had Kron deze plek op zijn zwerftochten gemeden; nu lag de open plek onschuldig in de avondzon."
                            },
                            {
                                "example_id": "63c1054c-1916-4327-a101-e898e2699936",
                                "sense_id": "8b63513c-67a5-3964-a214-af97f0d2c91f",
                                "text": "Ik vroeg me af wat ik moest doen als ik op mijn zwerftocht door de stad Conrad tegenkwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bb4df45-0953-493c-b281-72b7aae35482",
                        "source_entry_id": "34328594-73d9-36ef-afa2-43f6d35979a8",
                        "source_sense_id": "8b63513c-67a5-3964-a214-af97f0d2c91f",
