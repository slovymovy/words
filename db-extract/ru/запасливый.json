                        ]
                    },
                    {
                        "translation_id": "225b2876-9e67-45aa-bc38-4b89ea1db3dd",
                        "source_entry_id": "e8987c91-c076-3c1d-b3c3-0eb9ed536407",
                        "source_sense_id": "ad46ce93-e2e9-341e-b37f-431c60aa76da",
                        "target_lang_word": "vorsorglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorsorglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                        "entry_id": "35c88a30-6569-38c0-8ff6-ef028546c617",
                                        "glosses": [
                                            "im Voraus sorgend, meist um Probleme zu vermeiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9ec399-2367-4c78-a3c2-4da0692996e3",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "Ich habe vorsorglich alle Putzmittel in die oberen Schränke getan."
                                            },
                                            {
                                                "example_id": "dbc8dd93-4181-4abd-a781-c16643955017",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "Karl-Heinz holte sich schon am Sonnabend vorsorglich seine Eintrittskarte."
                                            },
                                            {
                                                "example_id": "2742d9c2-87e2-496a-a5b5-42caeccb6c22",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "„Vor zwei Jahren mußte ich mein Brustimplantate vorsorglich entfernen lassen: wegen des Krebsrisikos der Silikoneinlagen.“"
                                            },
                                            {
                                                "example_id": "4654cf43-72e7-450e-b6d3-16cd4d705f01",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "„Ich werde meinen Freund heiraten. Aber nur, wenn wir vorsorglich für den Fall, dass es doch zur Scheidung kommt, einen Ehevertrag schliessen.“"
                                            },
                                            {
                                                "example_id": "6c549b94-204d-4396-b886-39b731e18506",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "Eine große Flutwelle drohte [nachdem eine Gerölllawine den Fluß Kali Gandaki aufstaute]. […] Das größte Wasserkraftwerk Nepals […] wurde vorsorglich abgeschaltet."
                                            },
                                            {
                                                "example_id": "d9eca6f4-66c1-4c7c-a8d1-8ee6c8c23a9a",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "[Nach einer Panne mit dem gefährlichen Milzbranderreger Anthrax] seien für [22 Armee-Mitglieder] \"vorsorglich medizinische Maßnahmen\" einschließlich der Verabreichung von Antibiotika getroffen worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ea983c2-dfff-4205-a07b-9668d630431e",
                        "source_entry_id": "e8987c91-c076-3c1d-b3c3-0eb9ed536407",
                        "source_sense_id": "ad46ce93-e2e9-341e-b37f-431c60aa76da",
                        "target_lang_word": "ménager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ménager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a03bc3b-22f3-3977-a5d4-be06204f7191",
                                        "entry_id": "042ba63f-10c8-3295-b9b3-f7fb04a3735c",
                                        "glosses": [
                                            "Qui administre avec épargne, avec économie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec006188-32ef-4113-9a65-5bc785543638",
                                                "sense_id": "5a03bc3b-22f3-3977-a5d4-be06204f7191",
                                                "text": "C’est un homme très ménager de ses deniers."
                                            },
                                            {
                                                "example_id": "24eb73de-9a93-4c32-b505-68399454c000",
                                                "sense_id": "5a03bc3b-22f3-3977-a5d4-be06204f7191",
                                                "text": "Il n’est pas assez ménager de son bien."
                                            },
                                            {
                                                "example_id": "fb42c911-8cdf-4ed4-91fe-0bb393398cb8",
                                                "sense_id": "5a03bc3b-22f3-3977-a5d4-be06204f7191",
                                                "text": "Les jeunes gens ne sont guère ménagers, ne sont pas assez ménagers."
                                            },
                                            {
                                                "example_id": "562e05d3-7c89-4481-96c2-4801357b86ca",
                                                "sense_id": "5a03bc3b-22f3-3977-a5d4-be06204f7191",
                                                "text": "— Une fille comme toi, plaisante à voir, de bonne santé et avec ça vaillante et ménagère, c’est fait pour encourager ses vieux parents, d’abord, et puis après se marier et fonder une famille chrétienne."
                                            },
                                            {
                                                "example_id": "8abef0f0-f91f-4186-9c20-307eba283025",
                                                "sense_id": "5a03bc3b-22f3-3977-a5d4-be06204f7191",
                                                "text": "Madeleine agitait l’eau par mouvements prompts de grande laveuse ; elle ne craignait point de se mouiller les bras ni de faire sauter des gouttes jusqu'à son visage. Elle frottait entre ses mains pour ne pas user l’étoffe et, quant au savon, elle en était très ménagère : elle rinçait vivement, le linge défripé d’un coup sec, claquant à hauteur de figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e302ccb-e8d0-34b0-9509-22b202968c22",
                                        "entry_id": "042ba63f-10c8-3295-b9b3-f7fb04a3735c",
                                        "glosses": [
                                            "Qui administre la vie, la personne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12e325fa-7b2d-481d-bb9b-17fe57295332",
                                                "sense_id": "6e302ccb-e8d0-34b0-9509-22b202968c22",
                                                "text": "Pauvres en vies humaines, nous en sommes aussi peu ménagers que possible. Nous arrivons peu à peu et sans protester à subir une mortalité de 50 p. 100 supérieure à celle de nos voisins, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf6e726-90e4-3348-b95b-f4cd213e76ac",
                                        "entry_id": "042ba63f-10c8-3295-b9b3-f7fb04a3735c",
                                        "glosses": [
                                            "Qui a rapport à l’administration du ménage, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9a5d266-c2f7-417f-8df8-8eef6a72c345",
                                                "sense_id": "fcf6e726-90e4-3348-b95b-f4cd213e76ac",
                                                "text": "L’enseignement ménager."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5be2114e-e006-3e72-b7f4-216a01dbe37a",
                                        "entry_id": "042ba63f-10c8-3295-b9b3-f7fb04a3735c",
                                        "glosses": [
                                            "Qui est relatif au ménage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837edfab-aad3-43eb-8a7d-8f6e1a044e3d",
                                                "sense_id": "5be2114e-e006-3e72-b7f4-216a01dbe37a",
                                                "text": "Quand les tâches ménagères lui laissent un peu de répit, elle offre ses services à la paroisse, où l'on ne refuse jamais son aide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ménager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dbc4256-0944-3a12-8759-dca0d9286c14",
                                        "entry_id": "22fb23e8-31ea-37a1-9a60-cb8e18ac0a5c",
                                        "glosses": [
                                            "Personne qui administre avec économie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8d54ce-ef7c-47fc-839f-6d54b84d13a3",
                                                "sense_id": "3dbc4256-0944-3a12-8759-dca0d9286c14",
                                                "text": "Les censeurs, ménagers des deniers publics, du moins quand ils prenaient leur devoir à cœur, se heurtaient à des prétentions contre lesquelles ils avaient peine à se défendre…"
                                            },
                                            {
                                                "example_id": "3f493b96-87ae-467b-8723-f61aacc8ad16",
                                                "sense_id": "3dbc4256-0944-3a12-8759-dca0d9286c14",
                                                "text": "Les Rifains retranchés dans la montagne, tireurs adroits et ménagers de leurs munitions, s'étaient révélés comme des ennemis redoutables, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b89962d9-d608-311c-bf4a-89b3ff07d969",
                                        "entry_id": "22fb23e8-31ea-37a1-9a60-cb8e18ac0a5c",
                                        "glosses": [
                                            "Paysan qui travaille sa terre et ne se loue pas."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee75e084-6ccb-414b-aee9-09740574809b",
                                                "sense_id": "b89962d9-d608-311c-bf4a-89b3ff07d969",
                                                "text": "Mais en gros, ménager est dans le Midi l’équivalent de laboureur et il est très vivant en ce sens dans le langage des pays d’oc."
                                            },
                                            {
                                                "example_id": "dfa89793-f945-4d79-b9ae-f0a31e3ac59a",
                                                "sense_id": "b89962d9-d608-311c-bf4a-89b3ff07d969",
                                                "text": "L’histoire que tu as entendue n’est pas un conte de mon imagination. Si jamais tu viens en Provence, nos ménagers te parleront souvent de la cabro de moussu Seguin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ménager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a6b7764-1238-3858-bb8c-95618a370bc9",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Dépenser avec circonspection, avec prudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ef9676-0425-4ca3-8358-01e9157c4163",
                                                "sense_id": "1a6b7764-1238-3858-bb8c-95618a370bc9",
                                                "text": "Comme il ne nous restait guère de munitions, nous les ménagions le plus que nous pouvions."
                                            },
                                            {
                                                "example_id": "776cc9a8-ec1e-4d72-9748-e48d1187cfe0",
                                                "sense_id": "1a6b7764-1238-3858-bb8c-95618a370bc9",
                                                "text": "L’huis réservé s'ouvrit et le cerbère chargé de le garder sourit à Pibrac qui ne lui ménageait pas les gratifications […]."
                                            },
                                            {
                                                "example_id": "a5073a1b-8495-499d-9551-75992d558a04",
                                                "sense_id": "1a6b7764-1238-3858-bb8c-95618a370bc9",
                                                "text": "Vous ne ménagez pas vos efforts pour mener à bien tous vos projets."
                                            },
                                            {
                                                "example_id": "e361c744-ba33-4065-be27-31eda957b964",
                                                "sense_id": "1a6b7764-1238-3858-bb8c-95618a370bc9",
                                                "text": "Il importait donc de les maintenir dans un parfait état de vigueur. Aussi la viande saignante, et principalement la chair de ces rennes qui se laissaient tuer aux environs de la factorerie, ne leur fut-elle point ménagée."
                                            },
                                            {
                                                "example_id": "90e9ef4d-97df-490f-9e95-f84c2220a170",
                                                "sense_id": "1a6b7764-1238-3858-bb8c-95618a370bc9",
                                                "text": "On attaquerait la roche à la masse afin d'épargner les burins, car il n'y avait pas de forge pour les recharger. Cette façon de procéder ménagerait également la dynamite, car il fallait aussi craindre le pouillant qui asphyxie."
                                            },
                                            {
                                                "example_id": "46a487ca-947d-49cc-bece-3160fb52dfae",
                                                "sense_id": "1a6b7764-1238-3858-bb8c-95618a370bc9",
                                                "text": "En cherchant à ménager, on paiera finalement plus cher, parce que pendant que l’entraîneur Legault regarde ses pee-wee patiner sur la bottine, la facture monte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42ebf3ab-939a-3dda-8ac4-52cf08c97213",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Éviter de faire des démarches, en faire le moins qu’on peut."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168d030f-d723-49a3-98d1-3bdb255bd9b7",
                                                "sense_id": "42ebf3ab-939a-3dda-8ac4-52cf08c97213",
                                                "text": "Il craint de se déranger, il ménage bien ses pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8eff979-fc36-3aff-a0f8-2e3174781ce5",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Se servir d’un être ou d’une chose de façon qu’ils restent en bon état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7ebe7d-4698-4f28-b3e0-49fec4c433b8",
                                                "sense_id": "e8eff979-fc36-3aff-a0f8-2e3174781ce5",
                                                "text": "Il s’acharnera au travail, il ne ménagera ni son temps, ni ses forces, à une époque où le radium et la radiothérapie profonde était encore inconnue."
                                            },
                                            {
                                                "example_id": "073fd737-788f-4d39-8578-cc3ac4385234",
                                                "sense_id": "e8eff979-fc36-3aff-a0f8-2e3174781ce5",
                                                "text": "Ces objectifs sont déterminés par un plan à long terme, pour l'atteinte duquel on ménagera au maximum ses forces tout en cherchant les prises les plus variées qu'offre la situation du moment."
                                            },
                                            {
                                                "example_id": "9f7645f7-76a5-4177-a371-a30292b4579c",
                                                "sense_id": "e8eff979-fc36-3aff-a0f8-2e3174781ce5",
                                                "text": "Ménager la chèvre et le chou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b9c4265-fa36-338f-898d-c08eff53867e",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Disposer avec adresse, avec art."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689e5c63-d902-4cef-83d3-0b07ac62866c",
                                                "sense_id": "3b9c4265-fa36-338f-898d-c08eff53867e",
                                                "text": "Le Roi a une entrevue à Nice avec le Pape Paul III, qui ménage une trêve de dix ans entre les Puissances belligérantes."
                                            },
                                            {
                                                "example_id": "4f9bc229-93da-465b-986b-b9beba7265e1",
                                                "sense_id": "3b9c4265-fa36-338f-898d-c08eff53867e",
                                                "text": "On ménage une porte d'entrée, à laquelle on parvient avec une échelle, et on forme des compartiments en planches pour recevoir le grain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Traiter avec ménagement, avec égard, de manière à ne pas offenser, à ne pas déplaire. (En parlant de personnes)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d55c0d4c-9f0e-46e0-a0e6-034102e5fb19",
                                                "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                                "text": "C’est un homme à ménager."
                                            },
                                            {
                                                "example_id": "a1f4dcda-75f4-4bc3-851a-89b7f4751e94",
                                                "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                                "text": "C’est un homme qu’il faut ménager, qu’il importe de ménager."
                                            },
                                            {
                                                "example_id": "68b1e6d5-8236-4b7a-95e0-15324f97119b",
                                                "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                                "text": "Don Juan — C'est un dessein que j'ai formé par pure politique, un stratagème utile, une grimace nécessaire, où je veux me contraindre pour ménager un père dont j'ai besoin, et me mettre à couvert du côté des hommes de cent fâcheuses aventures qui pourraient m’arriver."
                                            },
                                            {
                                                "example_id": "da0916dc-0fca-4ac4-99cd-88f437357303",
                                                "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                                "text": "Puisqu’il se pose en ennemi, on ne le ménagera point."
                                            },
                                            {
                                                "example_id": "fd94b266-8add-42cf-842b-c8c63efeaab9",
                                                "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                                "text": "Qui veut voyager loin ménage sa monture."
                                            },
                                            {
                                                "example_id": "4a7bba24-f1fe-476e-a497-e8aedd9be79f",
                                                "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                                "text": "L’adjoint ménageait les prêtres."
                                            },
                                            {
                                                "example_id": "ebb3c8e3-840e-4f09-a2e7-eecfb8fd5f02",
                                                "sense_id": "241315d2-98b3-37ea-91fe-b329041e3390",
                                                "text": "Ménager la susceptibilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "957801dc-7d63-306e-ac1a-9821901e7880",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Épargner quelqu’un, user modérément de la supériorité, de l’avantage qu’on a sur lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db28345-9e0e-41e8-a807-2052c48e6b70",
                                                "sense_id": "957801dc-7d63-306e-ac1a-9821901e7880",
                                                "text": "Les compagnies, qui jusqu'en janvier 1852 ménageaient les messageries à chevaux et la navigation fluviale, éliminent leurs concurrents, les ruinant ou les achetant, jouant à leur guise avec les prix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a9bcb0-b601-355a-aab2-ae5ab914bba1",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Procurer, réserver une chose à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55657d8-1dc7-4db9-a57f-1fae2de854ad",
                                                "sense_id": "40a9bcb0-b601-355a-aab2-ae5ab914bba1",
                                                "text": "\"Vous me devez plus que la vie. En échange, ménagez-moi une entrevue avec le duc d'Angoulême dès que vous serez libre.\""
                                            },
                                            {
                                                "example_id": "5c135687-6cb5-47ae-8777-e21a5f1fea75",
                                                "sense_id": "40a9bcb0-b601-355a-aab2-ae5ab914bba1",
                                                "text": "Theresa May espérait, avec ce compromis, ménager un accès au marché unique européen pour les produits britanniques."
                                            },
                                            {
                                                "example_id": "5925662e-a683-4978-b9c3-c374f2b9c8ad",
                                                "sense_id": "40a9bcb0-b601-355a-aab2-ae5ab914bba1",
                                                "text": "Vous m’avez ménagé une surprise agréable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42aa4b37-a237-34d0-88d4-2aabfb77537b",
                                        "entry_id": "87aa4638-8632-3cce-8a6d-ccd48dd86666",
                                        "glosses": [
                                            "Prendre soin de sa santé, ne pas aller jusqu’au bout de ses forces."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed179af-8174-485a-9c4f-a5e2434fb0db",
                                                "sense_id": "42aa4b37-a237-34d0-88d4-2aabfb77537b",
                                                "text": "Vous n’êtes pas encore tout à fait guéri, et, si vous ne vous ménagez, vous retomberez malade."
                                            },
                                            {
                                                "example_id": "1a086af3-b411-4e22-bd02-a27662d7577e",
                                                "sense_id": "42aa4b37-a237-34d0-88d4-2aabfb77537b",
                                                "text": "Une très vive douleur cardiaque la tire de son demi-sommeil. Il lui semble qu’elle va mourir si elle bouge. Le docteur lui a recommandé de beaucoup se ménager."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
