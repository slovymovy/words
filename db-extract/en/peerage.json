                        "sense_id": "476bef0a-89de-39c8-a401-de5aeca46fd2",
                        "entry_id": "b85eb6a4-bf92-3adc-a5c8-eaa6bd961c47",
                        "glosses": [
                            "The rank or title of a peer or peeress."
