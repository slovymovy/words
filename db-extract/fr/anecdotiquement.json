                        "entry_id": "ec0b362e-ab62-34a7-b0fd-a0a9cb6e5b29",
                        "glosses": [
                            "De manière anecdotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78aa25b-b37c-4c45-8acc-6dd63ecf9153",
                                "sense_id": "a4c9017a-9fe3-31ab-a3c8-126e417f88b6",
                                "text": "Car l'actuel 4e du classement du championnat est le seul à être passé sous les 1'19, performance qu'il a réalisée deux fois même puisqu'il dispose (anecdotiquement) du 2e temps officieux de la qualification."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ca0b882-24b2-4851-9ad5-7c64ded60f9f",
                        "source_entry_id": "ec0b362e-ab62-34a7-b0fd-a0a9cb6e5b29",
                        "source_sense_id": "a4c9017a-9fe3-31ab-a3c8-126e417f88b6",
                        "target_lang_word": "anecdotally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anecdotally",
