    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                "word": "mannish",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4b16d230-5bae-4138-8877-74bebfb48b6d",
                        "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more mannish"
                    },
                    {
                        "form_id": "4b1111a5-13a3-443f-8638-c54d64e3ebe6",
                        "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most mannish"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "133cc3f6-5ea5-3b72-9be3-666a4e1cd231",
                        "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                        "glosses": [
                            "Resembling or characteristic of a man, masculine."
                        ],
                        "tags": [
                            "of a woman"
                        ],
                        "examples": [
                            {
                                "example_id": "c691cb7b-01e0-4623-b2f0-418666b7107c",
                                "sense_id": "133cc3f6-5ea5-3b72-9be3-666a4e1cd231",
                                "text": "A woman impudent and mannish grown\nIs not more loathed than an effeminate man\nIn time of action."
                            },
                            {
                                "example_id": "d0c410a1-b5ad-422f-b067-e164de080153",
                                "sense_id": "133cc3f6-5ea5-3b72-9be3-666a4e1cd231",
                                "text": "She detested the look of herself in large goggles, detested being forced to tie on her hat, detested the heavy, mannish coat of rough tweed that Sir Philip insisted she must wear when motoring."
                            }
                        ]
                    },
                    {
                        "sense_id": "6228bae1-adab-381b-8a23-68fd47d0e4c2",
                        "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                        "glosses": [
                            "Resembling or characteristic of a grown man (as opposed to a boy); mature, adult."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45aa357-64e6-4a80-9423-1ab9bf737a5e",
                                "sense_id": "6228bae1-adab-381b-8a23-68fd47d0e4c2",
                                "text": "And let us, Polydore, though now our voices\nHave got the mannish crack, sing him to the ground,"
                            },
                            {
                                "example_id": "28df27cf-8120-4fa7-abb5-72eafc76c6e2",
                                "sense_id": "6228bae1-adab-381b-8a23-68fd47d0e4c2",
                                "text": "And so, with an air of mannish superiority, he seems rather to pity the bashful girl, than to apprehend that he shall not succeed."
                            },
                            {
                                "example_id": "5577aefc-4184-43c0-a47f-87f1bbca0928",
                                "sense_id": "6228bae1-adab-381b-8a23-68fd47d0e4c2",
                                "text": "[…] Aunt Lucy found out about it and woke me up the next morning with a switch in her hand. . . . But I got all mannish that morning, Joyce. I said, “Aunt Lucy, you ain’t gonna whip me no more. I’se a man now—and you ain’t gonna whip me.”"
                            },
                            {
                                "example_id": "3de161b9-9a7a-4427-b2ea-c94dec12d14a",
                                "sense_id": "6228bae1-adab-381b-8a23-68fd47d0e4c2",
                                "text": "It’s things like these that remind me that for all his mannish ways, he’s still just a little tyke after all."
                            }
                        ]
                    },
                    {
                        "sense_id": "a103bbd3-c33c-3d5b-891d-813a05947250",
                        "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                        "glosses": [
                            "Impertinent; assertive."
                        ],
                        "tags": [
                            "Caribbean",
                            "Guyana"
                        ],
                        "examples": [
                            {
                                "example_id": "1bfad300-6c6b-4790-9779-64083bed6154",
                                "sense_id": "a103bbd3-c33c-3d5b-891d-813a05947250",
                                "text": "2014, Kurt Campbell, “Police left 15-year-old to die — Relatives,” inewsguyana.com, 11 March, 2014,\n“They could have saved his life because he was still living, one woman said when she told the police that the boy was alive he said leave him to die, he’s wanted,” Giddings cried, adding that “I know he bad, he mannish, he does misbehave but I never know he was wanted… how can they make the claim without medical assistance.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9d1ff29a-422f-3039-b377-54a93b6060a3",
                        "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                        "glosses": [
                            "Precocious."
                        ],
                        "tags": [
                            "Caribbean"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "15bf2b5c-b014-37d6-a3bd-e886831cbc01",
                        "entry_id": "973455b9-cb15-31c0-bc9b-a55512799785",
                        "glosses": [
                            "Resembling or characteristic of a human being, in form or nature; human."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "e7330a08-8d59-4d84-96d0-7e4db01154f3",
                                "sense_id": "15bf2b5c-b014-37d6-a3bd-e886831cbc01",
                                "text": "The Westron was a Mannish speech, though enriched and softened under Elvish influence."
                            }
                        ]
                    }
                ],
