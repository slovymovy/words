{
    "word_family": [
        "vastroesten",
        "roest",
        "roesten",
        "vast"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "866e2200-2656-3091-889f-338ca4ec98a3",
                    "sense_definition": "Zolang al hetzelfde gebleven dat het niet meer kan veranderen (figuurlijk)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_onveranderlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer zit vol met <w>vastgeroeste</w> vooroordelen over hoe dieren zich moeten gedragen.",
                            "target_lang_translations": {
                                "en": "The farmer is full of <w>deep-seated</w> prejudices about how animals should behave."
                            }
                        },
                        {
                            "text": "Het is moeilijk om zulke <w>vastgeroeste</w> gewoontes na al die jaren nog te doorbreken.",
                            "target_lang_translations": {
                                "en": "It is difficult to break such <w>entrenched</w> habits after all these years."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstokt"
                    ],
                    "antonyms": [
                        "flexibel",
                        "veranderbaar"
                    ],
                    "common_phrases": [
                        "vastgeroeste vooroordelen",
                        "vastgeroeste gewoontes"
                    ],
                    "target_lang_definitions": {
                        "en": "Having remained the same for so long that it can no longer change (figurative)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deep-seated",
                                "target_lang_sense_clarification": "of habits, prejudices, or beliefs"
                            },
                            {
                                "target_lang_word": "entrenched",
                                "target_lang_sense_clarification": "firmly established and difficult to change"
                            },
                            {
                                "target_lang_word": "set in one's ways",
                                "target_lang_sense_clarification": "unwilling to change habits or opinions"
                            },
                            {
                                "target_lang_word": "incorrigible",
                                "target_lang_sense_clarification": "unchangeably established in a belief or habit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4127149-15f2-38cd-b99a-503d19e35d33",
                    "sense_definition": "Door roesten helemaal aan elkaar vastzittend (letterlijk)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "letterlijk_roest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een speciale spray kreeg hij de <w>vastgeroeste</w> bouten eindelijk los.",
                            "target_lang_translations": {
                                "en": "With a special spray, he finally got the <w>rusted-solid</w> bolts loose."
                            }
                        },
                        {
                            "text": "De oude machine had veel <w>vastgeroeste</w> onderdelen die vervangen moesten worden.",
                            "target_lang_translations": {
                                "en": "The old machine had many <w>rusted-together</w> parts that needed to be replaced."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vastgeroeste bouten"
                    ],
                    "target_lang_definitions": {
                        "en": "Completely stuck together due to rusting (literal)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rusted solid",
                                "target_lang_sense_clarification": "of metal parts, completely stuck"
                            },
                            {
                                "target_lang_word": "rusted shut",
                                "target_lang_sense_clarification": "of doors, locks, or containers"
                            },
                            {
                                "target_lang_word": "rusted together",
                                "target_lang_sense_clarification": "fused by rust"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bdb55bfa-5afc-3d4e-afb7-28ed20e324fd",
                    "sense_definition": "Voltooid deelwoord van <w>vastroesten</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De metalen onderdelen zijn door de regen helemaal <w>vastgeroest</w>.",
                            "target_lang_translations": {
                                "en": "The metal parts have completely <w>rusted solid</w> due to the rain."
                            }
                        },
                        {
                            "text": "Hij is in zijn oude denkpatronen <w>vastgeroest</w>.",
                            "target_lang_translations": {
                                "en": "He is <w>stuck</w> in his old thinking patterns."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of 'vastroesten' (to rust solid / to become deeply set)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rusted solid",
                                "target_lang_sense_clarification": "literally stuck due to rust"
                            },
                            {
                                "target_lang_word": "stuck in a rut",
                                "target_lang_sense_clarification": "figuratively unable to change"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}