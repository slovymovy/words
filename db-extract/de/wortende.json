                "senses": [
                    {
                        "sense_id": "f80d2f1d-67c1-3656-a683-cf4fa0db580f",
                        "entry_id": "cba34082-e557-3d37-bb0f-88e7abc0ac1a",
                        "glosses": [
                            "letztes sprachliches Element eines Wortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766e27aa-c94d-4055-90ba-9c96e8e9e84e",
                                "sense_id": "f80d2f1d-67c1-3656-a683-cf4fa0db580f",
                                "text": "„Einzelne Vokalbuchstaben am Wortanfang oder -ende werden jedoch nicht abgetrennt.“"
                            },
                            {
                                "example_id": "6c93a0c3-b7c8-46a2-84f2-ab29a12fe054",
                                "sense_id": "f80d2f1d-67c1-3656-a683-cf4fa0db580f",
                                "text": "Der Buchstabe <ß> kommt nur im Wortende oder in der Wortmitte deutscher Wörter vor."
                            },
                            {
                                "example_id": "3cc9da62-7dc0-47f1-80fa-86a669486d37",
                                "sense_id": "f80d2f1d-67c1-3656-a683-cf4fa0db580f",
                                "text": "Der Laut [ŋ] kommt nur im Wortende oder in der Wortmitte deutscher Wörter vor."
                            },
                            {
                                "example_id": "7aa1daa9-b5e4-41e8-8921-7392c59c19b9",
                                "sense_id": "f80d2f1d-67c1-3656-a683-cf4fa0db580f",
                                "text": "Im Deutschen gibt es am Wortende nur stimmlose Verschluss- und Reibelaute."
                            },
                            {
                                "example_id": "2829a472-eef6-405d-8522-86084e1b8ecf",
                                "sense_id": "f80d2f1d-67c1-3656-a683-cf4fa0db580f",
                                "text": "Beim Sprechen gibt es eine Tendenz, am Wortende einzelne Laute auszulassen."
                            },
                            {
                                "example_id": "1e649237-a30f-4b1c-87a7-4dcba664a0fa",
                                "sense_id": "f80d2f1d-67c1-3656-a683-cf4fa0db580f",
                                "text": "„Wie im Hebräischen besitzen einige der Buchstaben neben ihrer Grundform noch eine weitere, die ausschließlich am Wortende eingesetzt wird – die sogenannten Schlussbuchstaben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
