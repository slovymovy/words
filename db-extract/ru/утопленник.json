                        "target_lang_word": "Wasserleiche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserleiche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c22fbe29-51c9-3d38-87c0-ac393df550ef",
                                        "entry_id": "516170fa-0d9e-3552-8bc6-f2f20c665ce1",
                                        "glosses": [
                                            "die Leiche einer Person, die ertrunken ist und bereits sich längere Zeit im Wasser befand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de4b6f5-0a52-49e3-9e62-56dcf8507c0d",
                                                "sense_id": "c22fbe29-51c9-3d38-87c0-ac393df550ef",
                                                "text": "„Im Jahr 2008 wurde in der Nähe von Lüttich (Belgien) eine Wasserleiche gefunden.“"
                                            },
                                            {
                                                "example_id": "7716dc94-06ee-4958-a6d5-a2b9786ba602",
                                                "sense_id": "c22fbe29-51c9-3d38-87c0-ac393df550ef",
                                                "text": "„Hinter den Schaufenstern der lang gestreckten Publikumshalle lagen auf schrägen Brettern die namenlosen Wasserleichen und Erhängten.“"
                                            },
                                            {
                                                "example_id": "481eb379-ded1-442a-b536-7f19b3cce329",
                                                "sense_id": "c22fbe29-51c9-3d38-87c0-ac393df550ef",
                                                "text": "„Den Tommies ist es nicht gelungen, Wasserleichen aus uns zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26c85716-5072-4904-9663-9de164661198",
                        "source_entry_id": "5a8f66ca-8679-3e67-9dce-9b2bc9f0e9ee",
                        "source_sense_id": "23bee79b-18c6-3ff6-8a06-21bd5a546653",
