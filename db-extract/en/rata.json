        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8ec7d77a-a45f-3ffa-92b0-8c018d3b8e4b",
                "word": "Rata",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3f7c61f5-917f-39d1-8417-7c8a149bcb17",
                        "entry_id": "8ec7d77a-a45f-3ffa-92b0-8c018d3b8e4b",
                        "glosses": [
                            "Any of several legendary heroes in various Polynesian mythologies, notably associated with canoe building; in the context of comparative mythology, these figures are frequently identified with each other, resulting in as few as one or two distinct identities."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f4550e3-0e4c-44e5-885c-6a09248def26",
                                "sense_id": "3f7c61f5-917f-39d1-8417-7c8a149bcb17",
                                "text": "The epics from other Polynesian islands may differ in detail, but in all of them, Rata (also known as Laska, Lasa, Aka, Raka) remains the illustrious canoe builder whose expertise in seafaring has never been surpassed."
                            },
                            {
                                "example_id": "8db508fe-17c9-4bf7-96de-ea53657fb6b8",
                                "sense_id": "3f7c61f5-917f-39d1-8417-7c8a149bcb17",
                                "text": "2009, Sarah Bartlett, Rata, entry in The Mythology Bible, Sterling Publishing Co., page 356,\nThere are many versions of Rata′s adventures throughout the islands of Polynesia. Rata is a warrior hero with magical powers and is part of the Tawhaki cycle, a great cycle of dynastic myths. In this version from the islands of the South Pacific, it is Rata′s quest for vengeance that is told."
                            }
                        ]
                    }
                ],
