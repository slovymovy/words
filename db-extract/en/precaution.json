                                    {
                                        "sense_id": "0504f4ec-d711-37fe-9128-3c333ef3f0ba",
                                        "entry_id": "39638ee2-1acd-3fed-bc5a-b3bc2966fa72",
                                        "glosses": [
                                            "het zorgen van tevoren om eventueel onheil of ongemak te voorkomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3b6129-1cec-47c8-865d-ce409b6f5d43",
                                                "sense_id": "0504f4ec-d711-37fe-9128-3c333ef3f0ba",
                                                "text": "Bonnie is met windsnelheden tussen de 60 en 80 kilometer per uur nu nog een tropische storm van de zwakste categorie, zegt Geijs, hoewel er uitschieters naar boven mogelijk zijn. De lokale autoriteiten hebben echter uit voorzorg een stormwaarschuwing (Code Rood) gegeven."
                                            },
                                            {
                                                "example_id": "37a56228-8c9b-4d63-b0b4-5c8a671d47f1",
                                                "sense_id": "0504f4ec-d711-37fe-9128-3c333ef3f0ba",
                                                "text": "De fabriek werd uit voorzorg ontruimd en omwonenden kregen een NL-alert."
                                            }
                                        ]
