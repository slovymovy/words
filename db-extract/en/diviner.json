                    {
                        "sense_id": "ead20cda-bab8-3e1c-98cc-5f0bdf199a37",
                        "entry_id": "246d26c1-557f-3706-97f3-725e6bc691d5",
                        "glosses": [
                            "One who foretells the future."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fc2911f-a9ca-48f6-87bc-0be06a4c5740",
                                "sense_id": "ead20cda-bab8-3e1c-98cc-5f0bdf199a37",
                                "text": "Saw my future with a death diviner / My reflection in her eyes drew up / My twisted past / Oh, I came unmasked"
                            }
                        ]
                    },
                    {
                        "sense_id": "9d0d1975-d60e-3dc9-998f-ea2f7f00a5c7",
                        "entry_id": "246d26c1-557f-3706-97f3-725e6bc691d5",
