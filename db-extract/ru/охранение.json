                ],
                "translations": [
                    {
                        "translation_id": "52ff0d4e-2b7d-4507-8edf-b1079bd182fb",
                        "source_entry_id": "673da79b-f4cb-3ef1-a273-9034c49befd2",
                        "source_sense_description": "действие",
                        "target_lang_word": "protection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Action de protéger, de défendre quelqu’un, de veiller à ce qu’il ne lui arrive pas de mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc7f81e-d093-4d11-bc82-a084742a881e",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Depuis que la Gaule est privée de la protection de Rome, sa tutrice, elle est ravagée par une série d’invasions, …."
                                            },
                                            {
                                                "example_id": "41a9cdb1-cc36-4c43-b98b-b02c7c1badad",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Sous les Carolingiens, les Capitulaires recommandent au Comte de veiller à la protection des orphelins; il ne s’agit en somme que de l’exercice pratique de la mainbournie royale."
                                            },
                                            {
                                                "example_id": "334a1d9c-cf16-4595-9a31-313d8b8bb010",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Il serait bon encore d’invoquer la protection du grand thaumaturge vers qui des milliers et des milliers de pèlerins venaient de toutes les provinces, de toutes les nations."
                                            },
                                            {
                                                "example_id": "ae05c937-8411-4a69-a882-d39b684c791d",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Toute caravane qui entrait dans le territoire du sultan d’Ayar devait payer cette taxe, moyennant quoi elle était, théoriquement du moins, sous la protection du sultan jusqu’à ce qu’elle quitte le territoire placé sous son commandement."
                                            },
                                            {
                                                "example_id": "b084ce69-2bbe-405f-879c-7cd12a52ab97",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Le basculement d’une posture de déni et du consentement meurtrier passif à la protection réelle des enfants et à la lutte contre l’impunité des agresseurs serait un fait historique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3508e568-65bf-3a74-96ea-32ebe78bbd4e",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Action de prendre soin de la fortune, des intérêts de quelqu’un, de favoriser l’accroissement, le progrès, la défense de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da2d1f7a-ffa0-4338-a38b-a52cc6fdc3d4",
                                                "sense_id": "3508e568-65bf-3a74-96ea-32ebe78bbd4e",
                                                "text": "La recherche de micro-polluants organiques dangereux s’inscrit dans le concept de développement durable conciliant la protection de l’environnement et le développement économique."
                                            },
                                            {
                                                "example_id": "cde0557b-44e9-4315-be08-6b519de0d626",
                                                "sense_id": "3508e568-65bf-3a74-96ea-32ebe78bbd4e",
                                                "text": "La protection accordée par des lois à l’industrie nationale s’oppose au système du libre-échange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Personne qui en protège, qui en favorise d’autres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d21aaaba-b386-4d25-8f5b-10ad1030f170",
                                                "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                                "text": "Cet homme a de puissantes protections."
                                            },
                                            {
                                                "example_id": "73bd3e98-9686-436d-958c-8a03cba2a854",
                                                "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                                "text": "Il compte sur ses protections."
                                            },
                                            {
                                                "example_id": "480179b6-fdb4-4bd2-b25d-4b2381d8da86",
                                                "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                                "text": "Il n’a aucune protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0fd5c91-1149-3944-8854-08b979f3e364",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Objet qui assure la sécurité des biens ou des personnes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f4152a-f46e-4cd8-8adb-6fb510908d49",
                                                "sense_id": "c0fd5c91-1149-3944-8854-08b979f3e364",
                                                "text": "Cette protection mobile doit recouvrir la partie extérieure de la fraise de désilage et doit rester solidaire de la machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5b52ac-f7dd-34e0-8e67-867b6916f6e5",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Emploi de protecteur à la cour papale de Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f230c2-e280-47d3-ace5-0c08ecc8bc6b",
                                                "sense_id": "2b5b52ac-f7dd-34e0-8e67-867b6916f6e5",
                                                "text": "Le pape donna la protection des jacobins à tel cardinal."
                                            },
                                            {
                                                "example_id": "345316f4-b385-493f-b8fe-4fd678d24e3b",
                                                "sense_id": "2b5b52ac-f7dd-34e0-8e67-867b6916f6e5",
                                                "text": "Le roi donna la protection de France à tel cardinal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
