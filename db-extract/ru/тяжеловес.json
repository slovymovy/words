                "translations": [
                    {
                        "translation_id": "bf30587f-2301-4dfb-b74b-43a0b7352c4c",
                        "source_entry_id": "fee49a3b-a872-3583-ae00-d33bee28054e",
                        "source_sense_id": "3634b732-1cbe-3c8b-adf4-0f16580c5b23",
                        "target_lang_word": "carthorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carthorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42ac069e-cf6c-352d-be25-509d4b0a3c0a",
                                        "entry_id": "4bec8c06-b289-3afc-aa08-e53cf2166eea",
                                        "glosses": [
                                            "A large, strong horse used for pulling heavy loads."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671a7a7a-83bd-40fa-925e-9c013e6ca3fc",
                                                "sense_id": "42ac069e-cf6c-352d-be25-509d4b0a3c0a",
                                                "text": "The blacksmith's forge shone bright on the opposite side of the way, and the proprietor had the hind-leg of a carthorse in his leather-coated lap."
                                            },
                                            {
                                                "example_id": "ff59e7b0-f4f9-401f-a702-149b4c591097",
                                                "sense_id": "42ac069e-cf6c-352d-be25-509d4b0a3c0a",
                                                "text": "He is not a man of independent fortune, for he works like a carthorse."
                                            },
                                            {
                                                "example_id": "13ec1f71-730f-4e4e-ab98-1f1ab035d83f",
                                                "sense_id": "42ac069e-cf6c-352d-be25-509d4b0a3c0a",
                                                "text": "Athelstan Arundel walked home[…], foaming and raging. […] He walked the whole way, walking through crowds, and under the noses of dray-horses, carriage-horses, and cart-horses, without taking the least notice of them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
