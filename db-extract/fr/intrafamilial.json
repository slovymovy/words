                    }
                ],
                "senses": [
                    {
                        "sense_id": "939e01d7-93a0-35aa-9de3-494d5be2f53f",
                        "entry_id": "c5c1da77-b0a4-3b46-bebd-375525ad0762",
                        "glosses": [
                            "À l’intérieur d’une même famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8549816e-d9a8-419a-abd0-bad47b098f81",
                                "sense_id": "939e01d7-93a0-35aa-9de3-494d5be2f53f",
                                "text": "Il aura le mandat d’étudier le phénomène des homicides intrafamiliaux, aussi bien au Québec que dans d’autres sociétés."
                            },
                            {
                                "example_id": "f73729c0-76dd-4e23-9924-462d0b927fbc",
                                "sense_id": "939e01d7-93a0-35aa-9de3-494d5be2f53f",
                                "text": "L’avocate Astrid Bedoret (SOS Inceste) a réclamé que l’inceste soit inscrit comme tel dans le code pénal, alors que les abus sexuels dans le cadre d’une relation intrafamiliale sont actuellement seulement reconnus comme une circonstance aggravante lors de la fixation de la peine. — («Le Cardinal était pédophile, mais aussi incestueux», , 24 nov 2010)"
                            },
                            {
                                "example_id": "2aeaf7f0-4fcf-469b-a7af-a070d5090f94",
                                "sense_id": "939e01d7-93a0-35aa-9de3-494d5be2f53f",
                                "text": "Un «Plan d’action national de lutte contre la violence entre partenaires et intrafamiliale 2010-2014» doit être mis prochainement en place, en fait lorsqu’un nouveau gouvernement aura été formé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5e0c380-293b-4c5c-8c99-2d945979e62f",
                        "source_entry_id": "c5c1da77-b0a4-3b46-bebd-375525ad0762",
                        "source_sense_id": "939e01d7-93a0-35aa-9de3-494d5be2f53f",
                        "target_lang_word": "domestic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domestic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea10ffc6-cee4-3ad5-ab54-13fbf3532514",
                                        "entry_id": "ed1e560e-57d5-3cd9-bdfd-f4b6a59844bc",
                                        "glosses": [
                                            "Of or relating to the home."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf8f68ca-3d26-3d90-adee-4f9527ae5e67",
                                        "entry_id": "ed1e560e-57d5-3cd9-bdfd-f4b6a59844bc",
                                        "glosses": [
                                            "Of or relating to activities normally associated with the home, wherever they actually occur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "410567fe-7f0d-40e7-a276-99560996760c",
                                                "sense_id": "bf8f68ca-3d26-3d90-adee-4f9527ae5e67",
                                                "text": "domestic violence; domestic hot water"
                                            },
                                            {
                                                "example_id": "a848a3d2-34e0-499e-9cee-7fe0c03dd30a",
                                                "sense_id": "bf8f68ca-3d26-3d90-adee-4f9527ae5e67",
                                                "text": "The relationship between a hairstylist and a client can be far more than simply somebody to cut and shape hair, which is why Tennessee is the latest state to require cosmetologists to complete training on how to recognize and respond to signs of domestic abuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7f792d1-38f2-3a63-b0b2-c682ed428d7f",
                                        "entry_id": "ed1e560e-57d5-3cd9-bdfd-f4b6a59844bc",
                                        "glosses": [
                                            "Kept by someone, for example as a farm animal or a pet."
                                        ],
                                        "tags": [
                                            "of an animal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5df6b2fc-20ae-40d0-962b-58d1d859be64",
                                                "sense_id": "d7f792d1-38f2-3a63-b0b2-c682ed428d7f",
                                                "text": "It shall be the duty of any owner or person in charge of any domestic animal or animals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa85b00a-a7b4-3bf6-a631-88a3d1d1be2c",
                                        "entry_id": "ed1e560e-57d5-3cd9-bdfd-f4b6a59844bc",
                                        "glosses": [
                                            "Internal to a specific country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6840cbca-6a9e-4a82-beef-7bf9f92022c9",
                                                "sense_id": "fa85b00a-a7b4-3bf6-a631-88a3d1d1be2c",
                                                "text": "The proportion of international economic flows relative to domestic ones."
                                            },
                                            {
                                                "example_id": "354d190d-1f57-4bb7-b313-4c28a7b95385",
                                                "sense_id": "fa85b00a-a7b4-3bf6-a631-88a3d1d1be2c",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44593968-fd92-3559-88c4-c3fb35725e1f",
                                        "entry_id": "ed1e560e-57d5-3cd9-bdfd-f4b6a59844bc",
                                        "glosses": [
                                            "Tending to stay at home; not outgoing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b77a8bc2-4212-40c4-9c24-63eed54b0675",
                                                "sense_id": "44593968-fd92-3559-88c4-c3fb35725e1f",
                                                "text": "“Dan’s not as domestic as you,\" I commented rather nastily."
                                            },
                                            {
                                                "example_id": "ff5bbb42-8d16-495d-8a63-448b8caa48b5",
                                                "sense_id": "44593968-fd92-3559-88c4-c3fb35725e1f",
                                                "text": "Homosexual men were non-warlike and homosexual women non-domestic, so that their energies sought different outlets from those of ordinary men and women; they became the initiators of new activities."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "domestic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25ef65b5-ecf6-394b-b732-add81dcc88f0",
                                        "entry_id": "cae89841-9d53-386f-b8a9-e3d50eb40215",
                                        "glosses": [
                                            "A maid or household servant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0583d14a-b8c7-4ff6-9f41-b778a4526fd3",
                                                "sense_id": "25ef65b5-ecf6-394b-b732-add81dcc88f0",
                                                "text": "It ſeems, the Minds of theſe People are ſo taken up with intenſe Speculations, that they neither can ſpeak, nor attend to the Diſcourſes of others, without being rouzed by ſome external Taction upon the Organs of Speech and Hearing; for which reaſon, thoſe Perſons who are able to afford it always keep a Flapper (the Original is Climenole) in their Family, as one of their Domeſticks, nor ever walk abroad or make Viſits without him."
                                            },
                                            {
                                                "example_id": "2bc3ac35-094d-45d6-97ca-99b262123230",
                                                "sense_id": "25ef65b5-ecf6-394b-b732-add81dcc88f0",
                                                "text": "Her fears thus prevailing, she communicated them to her mother as soon as the object of them had retired, who not in the least participating in them, they gradually subsided; but for an interval only, for, when retired to her chamber, during the hours of repose, every sound intimidated her; the growling of their faithful dog, or a halfsuppressed bark, brought the looks of the new domestic again before her sight."
                                            },
                                            {
                                                "example_id": "14367d9c-3194-426b-9c2b-8f742257ddee",
                                                "sense_id": "25ef65b5-ecf6-394b-b732-add81dcc88f0",
                                                "text": "New standards of cleanliness increased the workload for domestics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84ecb0b0-397f-3820-a211-a042cc4b3010",
                                        "entry_id": "cae89841-9d53-386f-b8a9-e3d50eb40215",
                                        "glosses": [
                                            "A domestic dispute, whether verbal or violent."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a4f70b-fa6a-4f8f-bb4d-59874198a594",
                                                "sense_id": "84ecb0b0-397f-3820-a211-a042cc4b3010",
                                                "text": "2005, Bellingham-Whatcom County Commission Against Domestic Violence, Domestic Violence in Whatcom County (read on the Whatcom County website athttps://web.archive.org/web/20060618212243/http://www.co.whatcom.wa.us/boards/dv_whatcom042505.pdf on 20 May 2006) - The number of “verbal domestics” (where law enforcement determines that no assault has occurred and where no arrest is made), decreased significantly."
                                            },
                                            {
                                                "example_id": "13f1cf1a-1a91-4464-ae56-6a61cd211bab",
                                                "sense_id": "84ecb0b0-397f-3820-a211-a042cc4b3010",
                                                "text": "Nobody wanted to join the 'Cardigan Squad' – so-called because Child Protection officers were seen as woolly, glorified social workers that mopped up after domestics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
