                        "examples": [
                            {
                                "example_id": "e2ce977a-8be2-415b-bead-fbfeb7ada78c",
                                "sense_id": "ac8a48ec-9227-3fd2-a0c4-bf5f3eec05c1",
                                "text": "„Auf die richtige Lage kommt es an - ganz gleich, ob man einen kleinen oder großen Weinvorrat hat.“"
                            },
                            {
                                "example_id": "449acc24-72f3-4314-b717-b6b51d7f8fdd",
                                "sense_id": "ac8a48ec-9227-3fd2-a0c4-bf5f3eec05c1",
                                "text": "„Das revolutionäre Komitee in Petrograd beschließt, alle Weinvorräte zu vernichten, da in letzter Zeit häufig Plünderungen von Wein- und Alkoholdepots vorgekommen sind.“"
                            }
