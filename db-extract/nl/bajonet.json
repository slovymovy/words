                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8206a59-3e3c-493c-bad5-0df4a39096da",
                                "sense_id": "cae7b543-8e70-3568-a225-b0f051664fa0",
                                "text": "De meeste doden vallen door de kogels uit het geweer, niet door de bajonet op het geweer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "060d16d1-8447-4b36-ae12-a27cc388611d",
                        "source_entry_id": "351cf92d-fee3-3dd8-a5e1-bfae7dc56397",
                        "source_sense_id": "cae7b543-8e70-3568-a225-b0f051664fa0",
                        "source_sense_description": "een steekwapen bovenop de loop van een geweer",
                        "target_lang_word": "Bajonett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bajonett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa777685-e50d-3733-b086-1674e7eed857",
                                        "entry_id": "585f9ffb-df28-33d9-915d-9c63bdedd90c",
                                        "glosses": [
                                            "eine Stoßwaffe mit Stahlklinge, die auf einen Gewehrschaft aufgesteckt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5eff23e-1ea8-49bf-a7a8-5acfddcbe422",
                                                "sense_id": "aa777685-e50d-3733-b086-1674e7eed857",
                                                "text": "Er wurde mit dem Bajonett erstochen."
                                            },
                                            {
                                                "example_id": "f546f8f6-382c-4083-b37d-73f32d78224b",
                                                "sense_id": "aa777685-e50d-3733-b086-1674e7eed857",
                                                "text": "„Aufgeregt hält er Ausschau und sieht einige Männer über die Brustwehr springen, während sie das Bajonett vorstrecken wie Stabhochspringer, die sich mit dem Stab der Latte nähern.“"
                                            },
                                            {
                                                "example_id": "f940e03e-e424-4073-89b4-f5ade6c8fe72",
                                                "sense_id": "aa777685-e50d-3733-b086-1674e7eed857",
                                                "text": "„Die Rekruten mußten mit gezückten Bajonetten auf eine Strohpuppe zurennen und sie durchbohren.“"
                                            },
                                            {
                                                "example_id": "c0f89059-dad4-46dd-81ef-c571978e3e97",
                                                "sense_id": "aa777685-e50d-3733-b086-1674e7eed857",
                                                "text": "„Dem Blitzen der Bajonette in der Abendsonne hielten die Franzosen scheinbar nicht stand, denn eiligst verließen sie ihre Stellungen.“"
                                            },
                                            {
                                                "example_id": "b73edcef-9406-44f4-8873-3897bd28d8bc",
                                                "sense_id": "aa777685-e50d-3733-b086-1674e7eed857",
                                                "text": "„Einer seiner Kameraden greift sich die Ziege; die anderen stechen mit ihren Bajonetten auf Oleka ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e5fefcc-20cd-4428-b4a6-06d3f901ca80",
                        "source_entry_id": "351cf92d-fee3-3dd8-a5e1-bfae7dc56397",
                        "source_sense_id": "cae7b543-8e70-3568-a225-b0f051664fa0",
                        "source_sense_description": "een steekwapen bovenop de loop van een geweer",
                        "target_lang_word": "bayonet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bayonet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5df0f99-b173-3bce-aae9-9dbf3dfc24ef",
                                        "entry_id": "2dbf0edf-76c9-37a2-9f3a-55dc68faa20e",
                                        "glosses": [
                                            "A blade mounted to the end of a long gun, originally with a handle inserted into the bore, now usually attached underbarrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a817066-8b8a-4de6-9058-9f8591994cdf",
                                                "sense_id": "a5df0f99-b173-3bce-aae9-9dbf3dfc24ef",
                                                "text": "Fig. 3. Its bayonet, to be fixed by sticking the handle into the muzzle of the musquet."
                                            },
                                            {
                                                "example_id": "709dec77-1698-495a-9871-9bcfccba28da",
                                                "sense_id": "a5df0f99-b173-3bce-aae9-9dbf3dfc24ef",
                                                "text": "“Well, the proper way to kill a man with a bayonet is this: First you thrust it in under the ribs—here.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a6276af-ffef-3497-9821-f9acdbf3af65",
                                        "entry_id": "2dbf0edf-76c9-37a2-9f3a-55dc68faa20e",
                                        "glosses": [
                                            "A pin which plays in and out of holes made to receive it, and which thus serves to engage or disengage parts of the machinery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bayonet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eda6994e-e035-3b31-8843-6d5fb674355c",
                                        "entry_id": "ccdca6ff-4ab8-3b52-8860-a9efb4ecd00b",
