                ],
                "senses": [
                    {
                        "sense_id": "0d611fd9-5072-3b5c-bcd0-dd6086a35e03",
                        "entry_id": "feb8f50e-2c2e-3c32-9dc4-cbc7980b021c",
                        "glosses": [
                            "Réguler de façon excessive, ou de façon supérieure à la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f2c4bc9-333b-4374-a13a-1d3fb2657496",
                                "sense_id": "0d611fd9-5072-3b5c-bcd0-dd6086a35e03",
                                "text": "Réguler mais pas sur-réguler"
                            },
                            {
                                "example_id": "ef3dd6c6-a167-4782-b65b-143afc5feb95",
                                "sense_id": "0d611fd9-5072-3b5c-bcd0-dd6086a35e03",
                                "text": "La Commission doit ainsi éviter de sur-réguler, et doit laisser les industries croître dans l'intérêt de l'Europe."
                            }
                        ]
                    },
                    {
                        "sense_id": "3186347a-a8ee-3052-9f6c-7d599e9f747e",
                        "entry_id": "feb8f50e-2c2e-3c32-9dc4-cbc7980b021c",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "154d893d-8e4f-4cb6-9d34-e18080701690",
                                "sense_id": "3186347a-a8ee-3052-9f6c-7d599e9f747e",
                                "text": "En d’autres termes, une mutation dans une protéine régulatrice peut «sur-réguler» ou «sous-réguler» le gène transcrit."
                            }
                        ]
                    }
