                                    {
                                        "sense_id": "809fffa5-422c-3b24-bc13-78b542d6c5a7",
                                        "entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                                        "glosses": [
                                            "stroming in de literatuur aan het eind van de 19e eeuw, die de mens beschouwt als bepaald door milieu en erfelijkheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919c32bb-971c-409a-ac8e-6803a9fdf168",
                                                "sense_id": "809fffa5-422c-3b24-bc13-78b542d6c5a7",
                                                "text": "Het is Emile Zola geweest die de term 'naturalisme' van toepassing verklaarde op het soort literatuur dat hemzelf voor ogen stond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98984978-3563-3ac2-8341-06def53e29f8",
                                        "entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                                        "glosses": [
                                            "stroming in de schilderkunst waarin men alles zo realistisch mogelijk poogt uit te beelden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4dbc88-53d8-4f52-91b3-e2ac9efd591a",
                                                "sense_id": "98984978-3563-3ac2-8341-06def53e29f8",
                                                "text": "Impressionisme volgt op de periode van het naturalisme waarbij de schilder zo getrouw mogelijk de realiteit weergeeft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d481964-dd0c-3d45-9166-1607226fb280",
                                        "entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                                        "glosses": [
                                            "leer die de natuur boven alles stelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff44e621-555e-4fd8-aefa-ad7e1d274c4f",
                                                "sense_id": "5d481964-dd0c-3d45-9166-1607226fb280",
                                                "text": "Toen het rationalisme aan het einde van de 17de eeuw het menselijke verstand tot het hoogste goed verhief en het materialisme de materie als het enig werkelijke beschouwde, kon de filosofische denkrichting van het naturalisme zich gaan ontplooien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
