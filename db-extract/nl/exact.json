                    {
                        "translation_id": "7121e926-00af-473e-a354-e3827cba062a",
                        "source_entry_id": "773a38ee-c27f-34e3-8703-5536e1fe32a5",
                        "source_sense_id": "d0abdf33-30b0-3ede-a63e-355b001931f3",
