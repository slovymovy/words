                "senses": [
                    {
                        "sense_id": "71403f3b-7f27-34dc-a2e5-f81051e011d4",
                        "entry_id": "cc0c8ebd-681a-3c78-934e-82b5a8013229",
                        "glosses": [
                            "Donner un caractère dipolaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406c2706-3de7-416d-b6ea-a3bb65511deb",
                                "sense_id": "71403f3b-7f27-34dc-a2e5-f81051e011d4",
                                "text": "Alors certes on peut dipolariser par exemple pour une install 100% HC et quand la pièce s'y prête bien entendu, mais si on travaille en radiation directe dans une pièce non dédiée, sorry mais les enceintes arrière ont une importance déterminante dans le résultat en termes de spacialisation, de restitution des graves, et de définition!"
                            },
                            {
                                "example_id": "b47a8ca1-3328-4b0a-ac6e-15788eea7b0f",
                                "sense_id": "71403f3b-7f27-34dc-a2e5-f81051e011d4",
                                "text": "Les réactifs polaires s’additionnent au groupe carbonyle dipolarisé, d’après la loi de Coulomb (paragraphe 1.2) : les nucléophiles se lient au carbone, les électrophiles à l’oxygène."
                            },
                            {
                                "example_id": "d9c047ac-2c71-48dc-a708-b0698496983e",
                                "sense_id": "71403f3b-7f27-34dc-a2e5-f81051e011d4",
                                "text": "Par diffusion Rayleigh dipolarisée Foulani (31) a été aussi amené à attribuer à l’anisotropie optique moléculaire des liaisons du cyclohexane une valeur différente de celle des alcanes."
                            }
                        ]
                    }
