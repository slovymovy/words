                        "examples": [
                            {
                                "example_id": "df9e4180-6dd2-4d0a-abe3-a71d1c63afc6",
                                "sense_id": "e0c4fb8a-1d5a-3d21-b75a-a757fc2f3176",
                                "text": "Chaque gamelle a, d’ailleurs, une anse rabattable contre le bord et un écusson en cuivre pour l’inscription du numéro du plat."
                            },
                            {
                                "example_id": "3af48a8a-add8-41b2-be4c-cf5e0e76bb14",
                                "sense_id": "e0c4fb8a-1d5a-3d21-b75a-a757fc2f3176",
                                "text": "L’arme peut être livrée avec une crosse fixe en matière plastique ou une crosse rabattable composée de deux branches tubulaires gainées de caoutchouc."
                            },
                            {
                                "example_id": "049b55c5-623a-490e-b8ec-f8aa5e4eeb4c",
                                "sense_id": "e0c4fb8a-1d5a-3d21-b75a-a757fc2f3176",
                                "text": "La Familiale, tant en finition Luxe que Confort (seule la sellerie diffère) propose elle aussi huit places, mais l’aménagement diffère du break : à l’avant on trouve une banquette, à l’arrière trois strapontins rabattables, et dans la partie « hayon » une autre banquette de deux places uniquement et non rabattable."
                            }
                        ]
