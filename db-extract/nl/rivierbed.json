                                "sense_id": "ab40717b-7b32-3564-8593-675784ac235f",
                                "text": "In de zomer droogt het rivierbed vaak op.",
                                "translation": "In the summer, the riverbed often dries up.",
                                "english": "In the summer, the riverbed often dries up."
                            },
                            {
                                "example_id": "859a8d6c-063b-4c2e-a06d-5bfee13d2583",
                                "sense_id": "ab40717b-7b32-3564-8593-675784ac235f",
                                "text": "Ze vonden oude artefacten in het rivierbed.",
                                "translation": "They found ancient artifacts in the riverbed.",
                                "english": "They found ancient artifacts in the riverbed."
                            },
                            {
                                "example_id": "b13e3fe0-ba34-40c1-a5d0-aa8eac7d15be",
                                "sense_id": "ab40717b-7b32-3564-8593-675784ac235f",
                                "text": "Het rivierbed was bezaaid met gladde stenen.",
                                "translation": "The riverbed was littered with smooth stones.",
                                "english": "The riverbed was littered with smooth stones."
                            }
                        ]
                    }
