                        "glosses": [
                            "To drive badly or wrongly."
                        ],
                        "tags": [
                            "ambitransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e93a7500-dfce-4c1c-910e-c3a3e72e8e8f",
                                "sense_id": "35b1e43c-8491-31e9-b7ee-755c0b1c1c3e",
                                "text": "Nightly it blazed, and waved its fiery tail,\nAnd made the dreaded Ursa Major quail;\nDestined but once before her fear to prove,\nWhen Phaeton the Solar car misdrove."
                            },
                            {
                                "example_id": "5ac035ee-ab55-4ba2-be62-7a83c62b573e",
                                "sense_id": "35b1e43c-8491-31e9-b7ee-755c0b1c1c3e",
                                "text": "It removes culpability from any distortion and makes anything, no matter how heinous, a complete accident. A drunk driver who crashes a car into someone can now apologise for miscounting his alcohol intake before going on to misdrive into someone he mistook for a road."
                            }
                        ]
                    }
