                "senses": [
                    {
                        "sense_id": "c685d997-de73-3d81-9ec3-dec903571443",
                        "entry_id": "91606884-b1ac-33c3-a677-0aa645a71542",
                        "glosses": [
                            "Filet de viande maigre découpé à partir de la poitrine d’une oie ou d’un canard gras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92dd1629-764a-4577-9053-fa87b384de31",
                                "sense_id": "c685d997-de73-3d81-9ec3-dec903571443",
                                "text": "Au menu : apéritif, melon de pays, terrine de poisson, coup du milieu, mouton ou magret de canard, mojhettes, salade, fromage, glace, café cognac."
                            },
                            {
                                "example_id": "9481a0cf-a56c-4125-b353-d9aac40b687e",
                                "sense_id": "c685d997-de73-3d81-9ec3-dec903571443",
                                "text": "Déposez le magret côté peau vers le bas dans une poêle froide et faites cuire sur feu doux jusqu’à ce que la peau soit très fine et uniformément croustillante."
                            },
                            {
                                "example_id": "ccecffec-e328-4986-9998-0d8dffe5bbd9",
                                "sense_id": "c685d997-de73-3d81-9ec3-dec903571443",
                                "text": "Que diriez-vous d’une belle tranche de jambon de Bayonne avec une salade de tomates de Marmande et des asperges du Blayais, puis un magret des Landes et, pour finir, une barquette de fraises du Périgord ?"
                            }
                        ]
                    }
                ],
