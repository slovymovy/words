{
    "word_family": [
        "amener",
        "mener",
        "emmener"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15b2d66f-d72f-3ddb-b85a-62da025ed928",
                    "sense_definition": "Reconduire une personne, un animal ou un objet à l'endroit d'où il est parti, ou le rapporter à son point de départ.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "Déplacer vers un lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>ramène</w> les enfants à la maison après l'école."
                        },
                        {
                            "text": "Peux-tu me <w>ramener</w> chez moi en voiture ce soir ?"
                        }
                    ],
                    "common_phrases": [
                        "ramener à la maison",
                        "ramener chez soi"
                    ]
                },
                {
                    "sense_id": "ea2334ea-e0b0-345c-88eb-f00a4d1e067a",
                    "sense_definition": "Rapporter ou apporter avec soi quelque chose d'un endroit donné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Déplacer vers un lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>ramené</w> de jolis souvenirs de son voyage en Italie."
                        },
                        {
                            "text": "Tu peux <w>ramener</w> du pain en rentrant du travail ?"
                        }
                    ],
                    "common_phrases": [
                        "ramener un souvenir",
                        "ramener des cadeaux"
                    ]
                },
                {
                    "sense_id": "80b6df51-534d-39c8-8936-d6cf6c13bbf8",
                    "sense_definition": "Amener de nouveau quelqu'un ou quelque chose quelque part.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Déplacer vers un lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai dû <w>ramener</w> l'ancre à bord, ce qui m'a pris des heures."
                        },
                        {
                            "text": "Le guide a <w>ramené</w> le groupe à bord du bateau après la visite."
                        }
                    ],
                    "common_phrases": [
                        "ramener à bord"
                    ]
                },
                {
                    "sense_id": "c7341ee6-1642-3b32-8651-b7b2093570df",
                    "sense_definition": "Faire revenir quelque chose, en particulier une situation, un sujet ou un moment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Rétablissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur essaie de <w>ramener</w> la discussion sur le sujet principal."
                        },
                        {
                            "text": "Le printemps a <w>ramené</w> les beaux jours et la bonne humeur."
                        }
                    ],
                    "common_phrases": [
                        "ramener la question"
                    ]
                },
                {
                    "sense_id": "79aa11ba-22c7-3cc0-83ba-4d4baa87e277",
                    "sense_definition": "Tirer vers soi ou faire venir en avant ou dessus ce qui est en arrière ou dessous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>ramène</w> ses cheveux en arrière avant de manger."
                        },
                        {
                            "text": "Il <w>ramène</w> les bras contre son corps pour se protéger du froid."
                        }
                    ],
                    "common_phrases": [
                        "ramener ses cheveux",
                        "ramener en arrière"
                    ]
                },
                {
                    "sense_id": "cc939a85-18eb-363a-979b-540e74e4fa7f",
                    "sense_definition": "Réduire quelque chose à une forme plus simple ou à un seul élément ; en parlant d'un problème, se résumer à.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Réduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>ramener</w> cette fraction à sa plus simple expression."
                        },
                        {
                            "text": "Tous ces problèmes se <w>ramènent</w> à une seule question d'argent."
                        }
                    ],
                    "common_phrases": [
                        "ramener à un seul",
                        "ramener à sa plus simple expression"
                    ]
                },
                {
                    "sense_id": "3cd0052d-7ce5-31cd-9a17-89513866b0f7",
                    "sense_definition": "Faire renaître ou rétablir un état, un sentiment ou une situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Rétablissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mesure a <w>ramené</w> le calme dans la ville."
                        },
                        {
                            "text": "La paix a <w>ramené</w> la prospérité dans la région."
                        }
                    ],
                    "common_phrases": [
                        "ramener la paix",
                        "ramener le calme"
                    ]
                },
                {
                    "sense_id": "48e5085d-edbb-3b65-8735-999f6fec307b",
                    "sense_definition": "Rapporter une chose à soi-même ou à un point précis, en faisant tout dépendre de cela.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Réduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a toujours tendance à tout <w>ramener</w> à elle dans les conversations."
                        },
                        {
                            "text": "Arrête de tout <w>ramener</w> à toi, ce n'est pas le sujet !"
                        }
                    ],
                    "common_phrases": [
                        "tout ramener à soi"
                    ]
                },
                {
                    "sense_id": "4fb268ac-54e4-31a2-8fa1-28dd9a2f36a5",
                    "sense_definition": "Se ramener : arriver quelque part, se présenter, venir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est <w>ramené</w> à la fête sans prévenir personne."
                        },
                        {
                            "text": "<w>Ramène</w>-toi vite, on t'attend depuis une heure !"
                        }
                    ],
                    "synonyms": [
                        "débarquer"
                    ],
                    "common_phrases": [
                        "se ramener sans prévenir",
                        "ramène-toi"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier, surtout à la forme pronominale"
                        }
                    ]
                },
                {
                    "sense_id": "574a1b83-8266-3a8a-8272-c54b6547a46b",
                    "sense_definition": "En parlant d'un corps de troupes poursuivi, le faire retourner à son point de départ après une charge qui a échoué.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cavalerie a chargé, mais elle a été vivement <w>ramenée</w>."
                        },
                        {
                            "text": "Les troupes ennemies furent <w>ramenées</w> jusqu'à leur camp après l'attaque."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme militaire ancien"
                        }
                    ]
                }
            ]
        }
    ]
