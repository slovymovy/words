{
    "word_family": [
        "accommodate",
        "accommodation",
        "accommodator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "caffa20e-5091-3580-8cd0-884a520cee24",
                    "sense_definition": "Willing to help others or to change one's plans to suit someone else's needs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "helpful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel staff were very <w>accommodating</w> and helped us find a nearby restaurant.",
                            "target_lang_translations": {
                                "nl": "Het hotelpersoneel was erg <w>behulpzaam</w> en hielp ons een restaurant in de buurt te vinden."
                            }
                        },
                        {
                            "text": "She was very <w>accommodating</w> when I asked to reschedule our meeting for next week.",
                            "target_lang_translations": {
                                "nl": "Ze was erg <w>meegaand</w> toen ik vroeg om onze afspraak naar volgende week te verplaatsen."
                            }
                        }
                    ],
                    "synonyms": [
                        "obliging",
                        "helpful",
                        "cooperative"
                    ],
                    "antonyms": [
                        "unhelpful",
                        "uncooperative"
                    ],
                    "common_phrases": [
                        "very accommodating",
                        "extremely accommodating"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bereid om anderen te helpen of plannen aan te passen aan de behoeften van iemand anders."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "behulpzaam",
                                "target_lang_sense_clarification": "Bereid om hulp te bieden."
                            },
                            {
                                "target_lang_word": "meegaand",
                                "target_lang_sense_clarification": "Bereid om zich aan te passen aan de wensen van anderen."
                            },
                            {
                                "target_lang_word": "dienstverlenend",
                                "target_lang_sense_clarification": "In een professionele context, gericht op het helpen van klanten."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6213dd1a-262a-3fbc-a57d-6a1ad9c95f33",
                    "sense_definition": "Easily influenced or controlled by others, often in a negative way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pliable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt official was <w>accommodating</w> to the demands of the powerful lobbyist.",
                            "target_lang_translations": {
                                "nl": "De corrupte ambtenaar was <w>volgzaam</w> naar de eisen van de machtige lobbyist."
                            }
                        },
                        {
                            "text": "He was too <w>accommodating</w> to his boss's unethical requests.",
                            "target_lang_translations": {
                                "nl": "Hij was te <w>buigzaam</w> voor de onethische verzoeken van zijn baas."
                            }
                        }
                    ],
                    "synonyms": [
                        "pliable",
                        "submissive",
                        "yielding"
                    ],
                    "antonyms": [
                        "stubborn",
                        "inflexible"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gemakkelijk beïnvloedbaar of controleerbaar door anderen, vaak op een negatieve manier."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "buigzaam",
                                "target_lang_sense_clarification": "Figuurlijk, makkelijk te sturen of te beïnvloeden."
                            },
                            {
                                "target_lang_word": "volgzaam",
                                "target_lang_sense_clarification": "Zonder eigen wil de bevelen van anderen opvolgend."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8afcf198-3ede-3a5d-86fe-d55aabae9bd4",
                    "sense_definition": "Present participle and gerund of <w>accommodate</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>accommodating</w> all the guests in the main hall.",
                            "target_lang_translations": {
                                "nl": "We zijn alle gasten aan het <w>huisvesten</w> in de grote zaal."
                            }
                        },
                        {
                            "text": "The new building is capable of <w>accommodating</w> hundreds of students.",
                            "target_lang_translations": {
                                "nl": "Het nieuwe gebouw is in staat om honderden studenten <w>plaats te bieden</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb accommodate."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord en gerundium van 'accommodate' (huisvesten, plaats bieden aan)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "huisvestend",
                                "target_lang_sense_clarification": "Onderdak bieden aan personen."
                            },
                            {
                                "target_lang_word": "plaats biedend aan",
                                "target_lang_sense_clarification": "Ruimte bieden voor mensen of zaken."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}