                        "glosses": [
                            "Manière dont prononce celui qui grasseye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528d3748-3606-4ab8-9e65-6b365845846e",
                                "sense_id": "c96a3e9e-99ac-3231-a4be-5a1b5bb68655",
                                "text": "Tout naturellement, tandis que grandissait Baby Lucy, je lui parlais français, tandis que sa mère lui disait en anglais – avec le grasseyement irlandais – la litanie des mots absurdes et tendres."
                            },
                            {
                                "example_id": "d1a0a3fe-e3ed-4fe4-ba2c-967a3d99df16",
                                "sense_id": "c96a3e9e-99ac-3231-a4be-5a1b5bb68655",
                                "text": "La prononciation des R, par exemple, oscille entre un grasseyement occasionnel, consonne roulée et articulation un peu molle, à l’anglaise, mais l’on pourra trouver là un certain charme exotique à la Maggie Teyte."
                            }
                        ]
                    }
