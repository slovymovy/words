                "senses": [
                    {
                        "sense_id": "cfce44ba-a22e-31b7-aefd-75065a751c98",
                        "entry_id": "fc7ea6db-3dcb-32b4-9470-52262de00a7e",
                        "glosses": [
                            "flache und dünne Scheibe aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "946b79d5-a909-4604-9c5e-dc8fc59081ce",
                                "sense_id": "cfce44ba-a22e-31b7-aefd-75065a751c98",
                                "text": "„Wissenschaftler des National Physical Laboratory im britischen Teddington haben das vermutlich bislang schwärzeste, künstlich geschaffene Schwarz hergestellt, indem sie eine glänzende Metallplatte für einige Sekunden in Salpetersäure tauchten.“"
                            },
                            {
                                "example_id": "cba2512d-6e86-439f-bf52-2ac0b89e4412",
                                "sense_id": "cfce44ba-a22e-31b7-aefd-75065a751c98",
                                "text": "„Eine Metallplatte hätten sie ihm eingesetzt, erzählten sie daheim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
