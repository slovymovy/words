                                    },
                                    {
                                        "sense_id": "9bd858e0-1eb4-34b7-b374-73d03a42c255",
                                        "entry_id": "9f2d9c7a-c894-355e-98c3-7b2c9a50ede2",
                                        "glosses": [
                                            "Time to recover one's breath; hence, a delay, a spell of time."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "074b4785-f997-474a-9132-ec114bd71598",
                                                "sense_id": "9bd858e0-1eb4-34b7-b374-73d03a42c255",
                                                "text": "DON PEDRO. Count Claudio, when mean you to go to church? / CLAUDIO. To-morrow, my lord. Time goes on crutches till love have all his rites. / LEONATO. Not till Monday, my dear son, which is hence a just seven-night; and a time too brief too, to have all things answer my mind. / DON PEDRO. Come, you shake the head at so long a breathing; but, I warrant thee, Claudio, the time shall not go dully by us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a01dfb0d-90af-3c16-a2ca-bfa9cb73acc3",
                                        "entry_id": "9f2d9c7a-c894-355e-98c3-7b2c9a50ede2",
                                        "glosses": [
                                            "Any gentle influence or operation; inspiration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab4a0527-eede-427f-95c2-c0426ea73b4f",
                                                "sense_id": "a01dfb0d-90af-3c16-a2ca-bfa9cb73acc3",
                                                "text": "the breathings of the Holy Spirit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3782732-c27b-3648-8960-1d796d31dd27",
                                        "entry_id": "9f2d9c7a-c894-355e-98c3-7b2c9a50ede2",
                                        "glosses": [
                                            "Aspiration; secret prayer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af98c3c-0ac2-4d67-89b1-62b137968bec",
                                                "sense_id": "c3782732-c27b-3648-8960-1d796d31dd27",
                                                "text": "Let us then begin Heaven here, in the Frame and Temper of our Minds, in our heavenly Affections and Converſation; in a due Prepation for, and in earneſt Deſires and Breathings after that bleſſed State vvhich vve firmly believe and aſſuredly hope to be one day poſſeſſed of: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
