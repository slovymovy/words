{
    "word_family": [
        "vulturine",
        "vulturous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7feac6aa-2b9f-3909-85fa-175abec193bb",
                    "sense_definition": "A large bird that feeds on dead animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>vulture</w> circled high above the desert looking for food.",
                            "target_lang_translations": {
                                "ru": "<w>Гриф</w> кружил высоко над пустыней в поисках пищи."
                            }
                        },
                        {
                            "text": "The <w>vulture</w> landed on the carcass to begin its meal.",
                            "target_lang_translations": {
                                "ru": "<w>Стервятник</w> опустился на тушу, чтобы начать трапезу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная птица, питающаяся падалью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гриф",
                                "target_lang_sense_clarification": "хищная птица, питающаяся падалью"
                            },
                            {
                                "target_lang_word": "стервятник",
                                "target_lang_sense_clarification": "птица, питающаяся падалью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "707b1c77-a1ca-37b4-85c0-07db5db329ba",
                    "sense_definition": "A person who takes advantage of others' misfortune for personal gain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The greedy <w>vulture</w> tried to buy the house while the family was still grieving.",
                            "target_lang_translations": {
                                "ru": "Этот алчный <w>стервятник</w> пытался купить дом, пока семья еще скорбела."
                            }
                        },
                        {
                            "text": "He was called a <w>vulture</w> for profiting from the company's bankruptcy.",
                            "target_lang_translations": {
                                "ru": "Его назвали <w>стервятником</w> за то, что он нажился на банкротстве компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambulance chaser",
                        "vampire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который пользуется чужими несчастьями ради собственной выгоды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стервятник",
                                "target_lang_sense_clarification": "переносное значение: алчный, жестокий человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf8bece7-c94a-3f4d-9beb-12baadad6ca1",
                    "sense_definition": "To wait or hover near someone in a predatory or opportunistic manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would <w>vulture</w> around the office waiting for someone to quit.",
                            "target_lang_translations": {
                                "ru": "Он <w>кружил</w> по офису <w>как стервятник</w>, ожидая, пока кто-нибудь уволится."
                            }
                        },
                        {
                            "text": "Do not <w>vulture</w> over the guests while they are trying to eat.",
                            "target_lang_translations": {
                                "ru": "Не <w>нависайте</w> над гостями <w>как стервятник</w>, пока они пытаются поесть."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ожидать или кружить рядом с кем-то в хищной или оппортунистической манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружить как стервятник",
                                "target_lang_sense_clarification": "идиоматическое описание хищного поведения"
                            },
                            {
                                "target_lang_word": "нависать как стервятник",
                                "target_lang_sense_clarification": "выжидающе держаться рядом с кем-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe39e309-3e1b-3cfb-a223-46fa1e4ad096",
                    "sense_definition": "Having a greedy or predatory nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vulture</w> investor sought to strip the company of its assets.",
                            "target_lang_translations": {
                                "ru": "Инвестор-<w>стервятник</w> стремился лишить компанию ее активов."
                            }
                        },
                        {
                            "text": "His <w>vulture</w> instincts made him very successful in the cutthroat market.",
                            "target_lang_translations": {
                                "ru": "Его <w>хищнические</w> инстинкты сделали его очень успешным на этом беспощадном рынке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий жадной или хищнической натурой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хищнический",
                                "target_lang_sense_clarification": "о жадном, беспощадном поведении"
                            },
                            {
                                "target_lang_word": "стервятнический",
                                "target_lang_sense_clarification": "редко используемое прилагательное, описывающее поведение стервятника"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}