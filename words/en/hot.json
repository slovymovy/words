                {
                    "sense_id": "117c55d5-8559-374f-bd03-63c663a05378",
                    "sense_definition": "Popular, in high demand, or currently very fashionable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new smartphone is so <w>hot</w> that we cannot keep it in stock.",
                            "target_lang_translations": {
                                "ru": "Этот новый смартфон настолько <w>популярен</w>, что мы не успеваем пополнять запасы."
                            }
                        },
                        {
                            "text": "The band is one of the <w>hottest</w> new acts on the music scene.",
                            "target_lang_translations": {
                                "ru": "Эта группа — один из самых <w>модных</w> новых коллективов на музыкальной сцене."
                            }
                        }
                    ],
                    "synonyms": [
                        "popular",
                        "trendy",
                        "fashionable",
                        "in demand"
                    ],
                    "common_phrases": [
                        "hot item",
                        "hot ticket",
                        "hot new"
