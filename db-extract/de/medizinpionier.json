                "senses": [
                    {
                        "sense_id": "a3807dc1-6e67-381c-afc6-1f1392430edd",
                        "entry_id": "297f70ff-889c-3280-a78d-c03079f7c785",
                        "glosses": [
                            "Person, die die Medizin (besonders in ihren Anfängen) bahnbrechend entwickelt und gefördert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95347131-d5ae-4966-93dc-5ce81ed5ab6f",
                                "sense_id": "a3807dc1-6e67-381c-afc6-1f1392430edd",
                                "text": "„Assadian zitierte den Wiener Medizinpionier Theodor Billroth: \"Hygiene ist nicht alles, aber ohne Hygiene ist alles Nichts.\"“"
                            },
                            {
                                "example_id": "f8ffc160-68a5-416e-9033-64586f797303",
                                "sense_id": "a3807dc1-6e67-381c-afc6-1f1392430edd",
                                "text": "„Bei ihrer Untersuchung kam den Forschern um Düx der Zufall zur Hilfe: Sie entdeckten im medizinhistorischen Museum Berlins in einer Sammlung, die Anfang des 20. Jahrhunderts der Medizinpionier Rudolf Virchow zusammengetragen hatte, die Lunge eines Kindes.“"
                            },
                            {
                                "example_id": "f7bb6d64-0edf-43b0-bf68-91549a98bf67",
                                "sense_id": "a3807dc1-6e67-381c-afc6-1f1392430edd",
                                "text": "„Dieser Schrotflinten-Ansatz störte den Medizinpionier Paul Ehrlich bereits 1907.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
