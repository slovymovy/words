                "senses": [
                    {
                        "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                        "entry_id": "9373a6af-c50f-3127-9903-5318fde1004b",
                        "glosses": [
                            "Experte für Schmetterlinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2208324e-ffac-421a-8913-e04fdb31177f",
                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                "text": "„Der Schmetterlingskundler Robert Trusch, Kurator Naturkundemuseum in Karlsruhe, sieht wie viele seiner Fachkollegen die Agrargifte, besonders die Neonicotinoide, als einen der Hauptfaktoren für das Insektensterben.“"
                            },
                            {
                                "example_id": "18ced1b1-024d-40e5-abfd-613a33fe4cea",
                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                "text": "„Sieben Jahre lang arbeitete er als Schmetterlingskundler an der Universität Harvard im Institut für vergleichende Zoologie.“"
                            },
                            {
                                "example_id": "b1fc6d78-479d-49ac-8599-a7dbef448c40",
                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                "text": "„Dass Schmetterlingskundler und Ornithologen sich grämen, wenn der Bestand einer Art nicht mehr gesichert ist oder sie gänzlich aus ihrem Lebensraum verschwindet, will man ja gerne zugestehen.“"
                            },
                            {
                                "example_id": "602b713f-5dd1-4073-a819-c2b7f2b84c19",
                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                "text": "„Der Schmetterlingskundler Jim Miller vom American Museum of Natural History beschrieb Pseudoricia flavizoma, eine verblüffend hübsche Motte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
