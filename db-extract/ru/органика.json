                        ],
                        "form": "орга́никою"
                    },
                    {
                        "form_id": "bb7bced0-eaa1-47d7-8a9c-2ec79ba783f0",
                        "entry_id": "f8923adc-6eab-30fe-a198-57262f5c1732",
                        "tags": [
