                {
                    "sense_id": "96553773-bd1f-3a25-9f2e-80080760d8cb",
                    "sense_definition": "Fixer ou énoncer une règle ou une modalité, en parlant d'une loi, d'un contrat ou d'un règlement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrat de travail <w>prévoit</w> une période d'essai de trois mois renouvelable.",
                            "target_lang_translations": {
                                "en": "The employment contract <w>stipulates</w> a renewable three-month probationary period.",
                                "ru": "Трудовой договор <w>предусматривает</w> испытательный срок в три месяца, который можно продлить.",
                                "nl": "De arbeidsovereenkomst <w>voorziet in</w> een verlengbare proeftijd van drie maanden.",
                                "de": "Im Arbeitsvertrag ist eine verlängerbare Probezeit von drei Monaten <w>vorgesehen</w>.",
                                "pl": "Umowa o pracę <w>przewiduje</w> trzymiesięczny okres próbny, który można przedłużyć.",
                                "it": "Il contratto di lavoro <w>prevede</w> un periodo di prova di tre mesi, rinnovabile.",
                                "cs": "Pracovní smlouva <w>stanoví</w> zkušební dobu tří měsíců, kterou lze prodloužit.",
                                "tr": "İş sözleşmesi, yenilenebilir üç aylık bir deneme süresi <w>öngörüyor</w>.",
                                "es": "El contrato de trabajo <w>prevé</w> un período de prueba de tres meses renovable.",
                                "zh": "劳动合同<w>规定</w>试用期为三个月，并可续签。"
                            }
                        },
                        {
                            "text": "Comme le <w>prévoit</w> la loi, les membres de l'assemblée voteront à bulletin secret.",
                            "target_lang_translations": {
                                "en": "As the law <w>provides</w>, members of the assembly will vote by secret ballot.",
                                "ru": "Как <w>предусмотрено</w> законом, члены собрания будут голосовать тайным бюллетенем.",
                                "nl": "Zoals de wet <w>voorschrijft</w>, zullen de leden van de vergadering bij geheime stemming stemmen.",
                                "de": "Wie es das Gesetz <w>vorsieht</w>, stimmen die Mitglieder der Versammlung geheim ab.",
                                "pl": "Jak <w>stanowi</w> ustawa, członkowie zgromadzenia będą głosować w tajnym głosowaniu.",
                                "it": "Come <w>prevede</w> la legge, i membri dell'assemblea voteranno a scrutinio segreto.",
                                "cs": "Jak zákon <w>stanoví</w>, členové shromáždění budou hlasovat tajně.",
                                "tr": "Kanunun <w>öngördüğü</w> üzere meclis üyeleri gizli oyla oy kullanacak.",
                                "es": "Tal como <w>establece</w> la ley, los miembros de la asamblea votarán en votación secreta.",
                                "zh": "正如法律<w>规定</w>的那样，议会成员将以无记名投票方式表决。"
                            }
                        }
                    ],
