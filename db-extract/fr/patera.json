                                        "entry_id": "f3040ee3-b794-370e-b3dd-19f9404bb875",
                                        "glosses": [
                                            "The caldera or crater (dish-shaped depression) atop a volcano, especially an extraterrestrial one; also used in the names of extraterrestrial volcanoes which have such a caldera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b2fb010-0520-4eef-b2b0-3bff074621a9",
                                                "sense_id": "7e075068-4e1c-3063-9bce-43bfe3ec1d39",
                                                "text": "What caused the transitions from explosive to effusive volcanism in the Circum-Hellas Volcanic Province generally and during the eruptive lifetimes of individual highland patera volcanoes?"
                                            },
                                            {
                                                "example_id": "6f0ae430-7fcc-4b29-b5d4-df40fb2b7d5f",
                                                "sense_id": "7e075068-4e1c-3063-9bce-43bfe3ec1d39",
                                                "text": "Note that the eroded plains materials to the right of the patera show no signs of individual lava flows."
                                            }
                                        ]
                                    }
