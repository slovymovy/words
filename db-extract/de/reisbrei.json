                ],
                "senses": [
                    {
                        "sense_id": "2b95be54-2447-34be-a433-3c8beb346694",
                        "entry_id": "1acbdca2-72e0-3f0b-a8fd-0957457ffa7a",
                        "glosses": [
                            "aus Reis zubereiteter Brei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da27de43-0bab-431a-9590-5f458a35bee0",
                                "sense_id": "2b95be54-2447-34be-a433-3c8beb346694",
                                "text": "„Er hatte die Nacht in einem feuchten, dreckigen rattenverseuchten buddhistischen Disneyland verbracht und sich zum Scheißen über einen offenen Graben kauern müssen, und jetzt stand er in der nebligen Kälte, versuchte, eine Schale Reisbrei runterzuwürgen, um nach Sonnenaufgang noch ein paar tausend Stufen mehr hinaufzusteigen.“"
                            },
                            {
                                "example_id": "daa5016b-596a-4bf2-95a0-e589728d1c5f",
                                "sense_id": "2b95be54-2447-34be-a433-3c8beb346694",
                                "text": "„Auch sie hatte schon kleine Stiche des Grolls gegen ihre Mutter verspürt, einmal, als sie nicht mit zum Schulpicknick durfte, oder als sie nur noch den Rest aus einer Schüssel mit süßem Reisbrei bekommen hatte, weniger als ihre Brüder.“"
                            },
                            {
                                "example_id": "0ca2d752-338a-4ce8-96f0-d7afa3848b09",
                                "sense_id": "2b95be54-2447-34be-a433-3c8beb346694",
                                "text": "„›Ich mache ihm einen leckeren Reisbrei.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
