                        "entry_id": "e9722e4a-87e4-3aed-bb3f-20d20d9e80fb",
                        "glosses": [
                            "investisseur qui investit conjointement avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e92a280-58e7-4f82-8170-054640bce35b",
                                "sense_id": "d5bfd192-c868-3205-bb76-23b8c0d51c01",
                                "text": "Les co-créateurs et/ou co-investisseurs mobilisent toutes leurs ressources pour anticiper les éventuels aléas sur la route des entrepreneurs."
                            },
                            {
                                "example_id": "a110f13b-ed6f-4636-add8-aeecaf0c0674",
                                "sense_id": "d5bfd192-c868-3205-bb76-23b8c0d51c01",
                                "text": "Pour pouvoir bien négocier votre partenariat de co-investissement, vous devez avoir les réponses aux questions que votre co-investisseur se posera."
                            },
                            {
                                "example_id": "92e318ac-c0a5-4f50-a9b2-6e610db90950",
                                "sense_id": "d5bfd192-c868-3205-bb76-23b8c0d51c01",
                                "text": "Les co-investisseurs peuvent être d’autres investisseurs (pas forcément des migrants) ou des mécanismes publics ou privés d’accompagnement (pécule type PDLM, capital-risque de l’économie solidaire, prêts bancaires, etc.)."
                            }
                        ]
                    }
