                    "frequency": "High",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De film had een <w>luchtige</w> toon waardoor iedereen vrolijk de bioscoop verliet.",
                            "target_lang_translations": {
                                "en": "The film had a <w>lighthearted</w> tone, which made everyone leave the cinema feeling cheerful."
                            }
                        },
                        {
                            "text": "Zij praat altijd op een <w>luchtige</w> manier over haar problemen.",
                            "target_lang_translations": {
                                "en": "She always talks about her problems in a <w>casual</w> manner."
                            }
