                "senses": [
                    {
                        "sense_id": "1f684e5c-b86c-3b5d-9431-ccc9665915a4",
                        "entry_id": "85902faa-1ca2-3b48-b7ff-e595b63527f1",
                        "glosses": [
                            "weiblicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b097d14e-23d7-4fa7-b40d-86227b7dedc9",
                                "sense_id": "1f684e5c-b86c-3b5d-9431-ccc9665915a4",
                                "text": "Es gibt nichts, das Barbara aus der Fassung bringt."
                            }
                        ],
