                        "examples": [
                            {
                                "example_id": "4edb9e45-c665-4aed-b380-e9e9648769b4",
                                "sense_id": "e1d867b9-256e-35fd-a4e5-02a0ca037326",
                                "text": "В течение месяца он успел объездить всех знакомых, которых сумел накопить во время своих кочеваний."
                            },
                            {
                                "example_id": "9aa3e362-ceda-46d1-8a9e-c3897d47525a",
                                "sense_id": "e1d867b9-256e-35fd-a4e5-02a0ca037326",
                                "text": "Вместо рыболовного кочевания мы стали вести кочевую жизнь земледельческую, пока не устроились окончательно."
                            }
                        ]
                    }
