                {
                    "sense_id": "38e50a92-7cab-3cb0-8a80-0be6071c0525",
                    "sense_definition": "eine neue Version, Freigabe oder Überarbeitung eines Softwareprogramms",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Veroeffentlichung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seit heute früh ist das neue <w>Release</w> des Betriebssystems für alle Nutzer verfügbar."
                        },
                        {
                            "text": "Vor dem nächsten <w>Release</w> müssen die Entwickler noch mehrere kritische Fehler in der Anwendung beheben."
                        }
                    ],
                    "synonyms": [
                        "Programmversion",
                        "Softwareversion"
                    ],
                    "common_phrases": [
