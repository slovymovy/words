                ],
                "senses": [
                    {
                        "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                        "entry_id": "b4fa3443-4742-36d2-832d-e6693f0ac6a1",
                        "glosses": [
                            "Kletteranlage zwischen mehreren Masten oder Bäumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5851060-62c3-4bac-8da6-005c58e2d5a0",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Das Highlight im Park ist ein Seilgarten in 40m Höhe, der einem den Regenwald mal aus dieser Perspektive zeigt.“"
                            },
                            {
                                "example_id": "da3aa83f-d44f-4663-89fe-d05c42244a96",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Sie schaukelten und rutschten und kletterten den Seilgarten entlang, bis sie auf einer Drehscheibe Platz nahmen.“"
                            },
                            {
                                "example_id": "1a3f74e4-5e4f-4d72-82be-30ca448e5ac1",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Wenn das Wetter mitspielt, sorgt das Ökowerk mit Wildbienenpfad, Libellenteich, Weidenlabyrinthen und der Arche für alte Haustierrassen, mit Hängebrücken, Seilgarten und solarbetriebener Mini-Eisenbahn für gute Laune.“"
                            },
                            {
                                "example_id": "fae268af-f845-421e-a4e3-969bbaba50bf",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Nach dem gemeinsamen Frühstück beschließen die anderen, den Tag im Seilgarten auf einem der Außendecks zu verbringen.“"
                            },
                            {
                                "example_id": "2e0a96ab-36b3-49d4-982b-25088ad29f4a",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Das Gelände mit seinen Attraktionen wie große Spielwiese, Wasserspielplatz, Seilgarten, dem Felsenmeer und der Heinrichshöhle und vielem mehr hat ganzjährig von 9:30 Uhr bis Sonnenuntergang geöffnet.“"
                            },
                            {
                                "example_id": "c3a72565-4a9d-4c06-b123-832288853fc0",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Einige bauten einen Seilgarten, schleppten Altreifen für den Hindernisparcours herbei, andere errichteten eine Kletterwand oder bauten eine Küche zum Kochen im Freien und die Kantine.“"
                            },
                            {
                                "example_id": "132d8db0-cfc8-4fec-b1eb-df6ad2d7e786",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Die Gäste wurden stilecht geschminkt, in zwei Gruppen geteilt und vier Stunden lang durch einen Parcours aus Kletterwänden, Wasserfällen und Seilgärten gehetzt.“"
                            },
                            {
                                "example_id": "c40aafdc-72bd-40c0-bc64-5e0fbfde36d1",
                                "sense_id": "43b6c84f-d8ef-3209-b022-1a54118568e8",
                                "text": "„Als Alternative zu den Hochseilgärten werden inzwischen niedrige Seilgärten angeboten, sodass die Überwindung von Seilgärten Höhenangst entfällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
