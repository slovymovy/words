                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f1abe8-d171-49d8-a7a9-916cedb2d59e",
                                "sense_id": "0559e2f7-cb11-3556-a3cd-196d78d6ef3d",
