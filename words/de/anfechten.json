                    "frequency": "Middle",
                    "semantic_group_id": "rechtlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Anwalt riet seinem Mandanten, das Urteil des Gerichts vor der nächsten Instanz <w>anzufechten</w>."
                        },
                        {
                            "text": "Die Opposition kündigte an, das offizielle Ergebnis der Wahl wegen Unregelmäßigkeiten <w>anzufechten</w>."
                        }
                    ],
                    "synonyms": [
                        "beanstanden"
                    ],
                    "antonyms": [
                        "akzeptieren",
                        "anerkennen"
                    ],
                    "common_phrases": [
                        "ein Urteil anfechten",
                        "eine Wahl anfechten",
                        "einen Vertrag anfechten",
                        "einen Beschluss anfechten"
                    ]
                },
                {
                    "sense_id": "4af9abeb-aa69-331c-85e3-30ad75352041",
                    "sense_definition": "jemandem Kummer bereiten, jemanden innerlich berühren oder beunruhigen (meist verneint gebraucht)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die scharfe Kritik der Konkurrenz <w>ficht</w> die Geschäftsleitung überhaupt nicht <w>an</w>."
                        },
                        {
                            "text": "Was <w>ficht</w> dich denn heute <w>an</w>, dass du so wütend bist?"
                        }
                    ],
                    "synonyms": [
                        "bekümmern",
                        "berühren",
                        "kümmern"
                    ],
                    "common_phrases": [
                        "nicht anfechten",
                        "was ficht dich an"
                    ]
                }
            ]
        },
