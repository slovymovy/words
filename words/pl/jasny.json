                {
                    "sense_id": "9e359445-66ec-3009-a811-4ff3327b8cba",
                    "sense_definition": "Pełen światła, dobrze oświetlony lub emitujący światło; przeciwieństwo ciemnego.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_illumination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ten <w>jasny</w> i słoneczny dzień poszliśmy na długi spacer.",
                            "target_lang_translations": {
                                "ru": "В этот <w>ясный</w> и солнечный день мы отправились на долгую прогулку.",
                                "de": "An diesem <w>hellen</w> und sonnigen Tag machten wir einen langen Spaziergang."
                            }
                        },
                        {
                            "text": "Twój nowy pokój jest bardzo <w>jasny</w> dzięki dużym oknom.",
                            "target_lang_translations": {
                                "ru": "Твоя новая комната очень <w>светлая</w> благодаря большим окнам.",
                                "de": "Dein neues Zimmer ist dank der großen Fenster sehr <w>hell</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "oświetlony",
                        "widny",
                        "świetlisty",
                        "promienny"
                    ],
                    "antonyms": [
                        "ciemny"
                    ],
                    "common_phrases": [
                        "jasny dzień",
                        "jasny pokój",
                        "jasne słońce"
                    ],
                    "target_lang_definitions": {
