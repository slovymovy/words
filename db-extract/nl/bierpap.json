                "senses": [
                    {
                        "sense_id": "c589becb-1288-3613-bd78-1e58ef3bee7f",
                        "entry_id": "e3c04557-516a-38e3-858d-baa96f4f0d51",
                        "glosses": [
                            "pap gemaakt van melk, bloem en bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c49cbd-da04-4910-b1d4-5548e233cc68",
                                "sense_id": "c589becb-1288-3613-bd78-1e58ef3bee7f",
                                "text": "Haal de stukken kip door het bierpapje en frituur 12 minuten in heet vet of echt in een frituur."
                            },
                            {
                                "example_id": "b888aff9-104d-4fe8-a0fb-47b42c5244aa",
                                "sense_id": "c589becb-1288-3613-bd78-1e58ef3bee7f",
                                "text": "Een duik in de geschiedenis leert dat ze altijd bier hebben gedronken als water, dat was gewoon gezonder. Het had meer voordelen: het gaf een mager kleintje een flinke boost. Bovendien hield het gerstenat moeder en baby lekker rustig. Je verwerkte het dan wel in een gerecht en serveerde het als een bordje bierpap, ook wel bekend onder de naam biersoep, bierschlemp of bierenbroodspot (dat laatste eten ze in Vlaanderen)."
                            }
                        ]
                    }
