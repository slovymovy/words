                ],
                "senses": [
                    {
                        "sense_id": "4b731b14-e8c5-3723-822d-3bb60115d9b2",
                        "entry_id": "5bb543cb-bd6e-319e-917d-8510b07417f5",
                        "glosses": [
                            "Draht, hergestellt aus Eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce84642-46ce-4e56-90f7-fea5491adb7f",
                                "sense_id": "4b731b14-e8c5-3723-822d-3bb60115d9b2",
                                "text": "„Auf einer Rampe zum Untergeschoss der Grundschule, in der das Casoria Contemporary Art Museum (CAM) untergebracht ist, brennt ein Gemälde, das an einem Gerüst aus Eisendraht hängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fc29c5d-a141-4f56-9f2c-cc492f31e093",
                        "source_entry_id": "5bb543cb-bd6e-319e-917d-8510b07417f5",
                        "source_sense_id": "4b731b14-e8c5-3723-822d-3bb60115d9b2",
                        "source_sense_description": "Draht, hergestellt aus Eisen",
                        "target_lang_word": "fil de fer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fil de fer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcef8064-b08e-3c81-8ba2-633214a70ae4",
                                        "entry_id": "7cd50cee-2d1c-38c0-9e06-4f3db0c82de3",
                                        "glosses": [
                                            "Cylindre en fer de même diamètre et assez fin pour ressembler à un fil, malléable et résistant à la tension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b1251d-670e-4170-ada6-1aceee7c85cd",
                                                "sense_id": "bcef8064-b08e-3c81-8ba2-633214a70ae4",
                                                "text": "Un petit guichet, grillagé de fil de fer, permettait d’examiner les visiteurs avant d’ouvrir."
                                            },
                                            {
                                                "example_id": "c3943933-784d-4a5e-8cec-0704ca01c14a",
                                                "sense_id": "bcef8064-b08e-3c81-8ba2-633214a70ae4",
                                                "text": "Je vous dis qu’ils ont enclos un espace de plus de quinze cents mètres de côté, avec des ronces artificielles et des fils de fer barbelés, jusqu’à trois mètres de hauteur…"
                                            },
                                            {
                                                "example_id": "cc438e82-eb4c-4aba-9841-47bf61bd7b2b",
                                                "sense_id": "bcef8064-b08e-3c81-8ba2-633214a70ae4",
                                                "text": "A genoux, j’avançai vers une paillasse tout contre le mur. J’essayai de m’y étendre sur le ventre, mais elle était couturée de toutes parts de fil de fer barbelé."
                                            },
                                            {
                                                "example_id": "053b370a-e709-4b67-9451-f757e840ac79",
                                                "sense_id": "bcef8064-b08e-3c81-8ba2-633214a70ae4",
                                                "text": "Mon attention a été attirée par un pantalon de velours côtelé, assez usagé, et qui séchait sur un fil de fer à proximité de la porte de la cuisine, ou plus précisément en face de cette porte."
                                            },
                                            {
                                                "example_id": "86a6a778-2c88-471f-8116-c4a5fe6f088b",
                                                "sense_id": "bcef8064-b08e-3c81-8ba2-633214a70ae4",
                                                "text": "Ce n’est pas un objet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81aa5ac3-d0cd-3ae5-b1b6-6a4ead87f4f6",
                                        "entry_id": "7cd50cee-2d1c-38c0-9e06-4f3db0c82de3",
                                        "glosses": [
                                            "Sport d’équilibre pratiqué sur un fil de fer suspendu dans les airs. Discipline traditionnelle dans un cirque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c85cbd9-f4ec-4f81-b060-e4dec66dd83e",
                                                "sense_id": "81aa5ac3-d0cd-3ae5-b1b6-6a4ead87f4f6",
                                                "text": "En même temps que s’opérait ce qui, pour son entourage bourgeois, n’était qu’une « déchéance », il mettait un terme à une vie amoureuse agitée, par un sot mariage, puis un encore plus sot collage, préférant à des femmes qui leur étaient très supérieures à tous égards deux brutes stupides, dont la première – paysanne enfuie toute jeune de chez elle avec une troupe de forains chinois – avait été d’abord avaleuse de sabres, puis danseuse sur fil de fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ffd6cbb-504c-32f5-b8ad-30d1eb462fa0",
                                        "entry_id": "7cd50cee-2d1c-38c0-9e06-4f3db0c82de3",
                                        "glosses": [
                                            "Larve des taupins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d517f9f-d3c0-4299-9b86-ef6a3997974d",
                                                "sense_id": "6ffd6cbb-504c-32f5-b8ad-30d1eb462fa0",
                                                "text": "Les fils de fer des taupins ressemble à des vers longs, fins et à peau rigide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb446af4-b872-3ba0-9241-2984508219d9",
                                        "entry_id": "7cd50cee-2d1c-38c0-9e06-4f3db0c82de3",
                                        "glosses": [
                                            "Représentation visuelle d’objet en 3D avant habillage d’une texture."
                                        ],
                                        "tags": [
                                            "Logiciel 3D"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f415984-da5f-3e53-9e7c-65e3bf9837ae",
                                        "entry_id": "7cd50cee-2d1c-38c0-9e06-4f3db0c82de3",
