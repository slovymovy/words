{
    "word_family": [
        "spend",
        "spender",
        "spending"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c7058db-08ba-315b-840d-d9b989c859ff",
                    "sense_definition": "Consumed, used up, or having no energy left.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhausted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spent</w> cartridge fell to the ground after the shot.",
                            "target_lang_translations": {
                                "ru": "После выстрела <w>отстрелянная</w> гильза упала на землю."
                            }
                        },
                        {
                            "text": "After the long race, the runner felt completely <w>spent</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого забега бегун чувствовал себя совершенно <w>изможденным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "consumed",
                        "depleted",
                        "exhausted",
                        "used up"
                    ],
                    "common_phrases": [
                        "spent force",
                        "spent fuel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Израсходованный, использованный или лишенный энергии, истощенный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истощенный",
                                "target_lang_sense_clarification": "о человеке, чувствующем сильную усталость"
                            },
                            {
                                "target_lang_word": "израсходованный",
                                "target_lang_sense_clarification": "о ресурсах или предметах, которые были использованы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68e09eaf-35a3-3d20-a589-70af6c168dd5",
                    "sense_definition": "Of a criminal conviction, no longer appearing on a person's record.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The applicant did not need to disclose the <w>spent</w> conviction during the interview.",
                            "target_lang_translations": {
                                "ru": "Кандидату не нужно было сообщать о <w>погашенной</w> судимости во время собеседования."
                            }
                        },
                        {
                            "text": "After several years, the minor offense became a <w>spent</w> conviction.",
                            "target_lang_translations": {
                                "ru": "Спустя несколько лет мелкое правонарушение стало <w>погашенной</w> судимостью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О судимости: погашенная или снятая, больше не отражающаяся в справке о судимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погашенная",
                                "target_lang_sense_clarification": "о судимости, срок которой истек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50207813-75de-3d2b-bf20-d976e3ece57d",
                    "sense_definition": "Of legislation, no longer in force because its provisions have expired.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to repeal the <w>spent</w> legislation from the previous decade.",
                            "target_lang_translations": {
                                "ru": "Комитет решил отменить <w>утратившее силу</w> законодательство предыдущего десятилетия."
                            }
                        },
                        {
                            "text": "Lawyers argued that the old statute was <w>spent</w> and no longer applicable.",
                            "target_lang_translations": {
                                "ru": "Юристы утверждали, что старый закон <w>утратил силу</w> и больше не применим."
                            }
                        }
                    ],
                    "synonyms": [
                        "finished"
                    ],
                    "target_lang_definitions": {
                        "ru": "О законодательстве: утративший силу, не действующий из-за истечения срока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утративший силу",
                                "target_lang_sense_clarification": "о законе или постановлении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69bcc23f-c430-3011-b557-abb25ae90b15",
                    "sense_definition": "Of fish, exhausted after the process of spawning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exhausted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spent</w> salmon drifted slowly downstream after spawning.",
                            "target_lang_translations": {
                                "ru": "<w>Отнерестившийся</w> лосось медленно плыл по течению после нереста."
                            }
                        },
                        {
                            "text": "Fishermen often release <w>spent</w> fish back into the river.",
                            "target_lang_translations": {
                                "ru": "Рыбаки часто выпускают <w>отнерестившуюся</w> рыбу обратно в реку."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhausted"
                    ],
                    "target_lang_definitions": {
                        "ru": "О рыбе: обессилевшая после нереста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отнерестившаяся",
                                "target_lang_sense_clarification": "о рыбе после процесса икрометания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c12618a0-cd85-3879-8e99-40a3a39abbd3",
                    "sense_definition": "Simple past and past participle of <w>spend</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>spent</w> all her money on new clothes yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера она <w>потратила</w> все свои деньги на новую одежду."
                            }
                        },
                        {
                            "text": "They have <w>spent</w> many hours studying for the final exam.",
                            "target_lang_translations": {
                                "ru": "Они <w>провели</w> много часов, готовясь к выпускному экзамену."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb spend."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола spend (тратить, проводить время)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потратил",
                                "target_lang_sense_clarification": "о деньгах или ресурсах"
                            },
                            {
                                "target_lang_word": "провел",
                                "target_lang_sense_clarification": "о времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}