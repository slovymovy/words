                                                "example_id": "9b99d2a3-2996-4a43-8a12-8167d3cd469a",
                                                "sense_id": "b620ecd9-9ed6-3322-80c8-aa408a0acfe0",
                                                "text": "The nation lost two major contributors to the cause of human rights in the murders of Mayor George Moscone and Supervisor Harvey Milk on Nov. 27."
                                            }
