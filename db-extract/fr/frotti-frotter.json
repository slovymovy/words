                ],
                "senses": [
                    {
                        "sense_id": "9792ffd0-acaa-3384-a390-a0216f4d7f1d",
                        "entry_id": "ebe757b9-e837-3c8c-be7c-2bcdb327f9c8",
                        "glosses": [
                            "Frotter avec un va-et-vient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c9b9ea-ac17-4a63-aaa4-0a0f077e3ca5",
                                "sense_id": "9792ffd0-acaa-3384-a390-a0216f4d7f1d",
                                "text": "Le public, amateur de danse, peut donc se frotti-frotter jusqu'au petit matin si il le souhaite."
                            },
                            {
                                "example_id": "c27d3019-f689-4ae5-abae-5c8f272d07ce",
                                "sense_id": "9792ffd0-acaa-3384-a390-a0216f4d7f1d",
                                "text": "Et ça vaut pour tout le monde : la prochaine fois qu’un de vous s’avise de frotti-frotter un autre clown, qu’il pense au sort réservé à Cul-brillant."
                            },
                            {
                                "example_id": "7c473997-40ec-42c0-b66d-99fc28c36042",
                                "sense_id": "9792ffd0-acaa-3384-a390-a0216f4d7f1d",
                                "text": "Est-ce que tu crois que l'on peut frotti-frotter ça pour les faire disparaître sans que cela ne cause problème ?"
                            },
                            {
                                "example_id": "28349053-3412-4796-ae27-c9eebba6f2b7",
                                "sense_id": "9792ffd0-acaa-3384-a390-a0216f4d7f1d",
                                "text": "Eh bien, c'est comme les Girls Gone Wild, vous voyez, des beautés qui aiment se frotti-frotter et se donner des coups de langue sous l’œil de la caméra entre deux douches de champagne à la plage."
                            }
                        ]
                    }
                ],
