                    {
                        "translation_id": "59a3977b-72c6-48b4-afdf-d71dbd1a50c6",
                        "source_entry_id": "5809e75d-e602-3fb6-81f4-08cd672d93ab",
                        "source_sense_id": "40af1d97-1811-39f3-ab0c-1a721b98c4df",
                        "target_lang_word": "Alpes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alpes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "765724d6-0dcf-30fa-8f9d-4889cb27422d",
                                        "entry_id": "6f3cf6fb-f726-34f9-9cde-838b4869347c",
                                        "glosses": [
                                            "Chaîne de montagnes s’étendant sur les territoires de l’Italie, de la France, de la Suisse, de l’Autriche, du Liechtenstein, de l’Allemagne et de la Slovénie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7084d6-e608-4658-9545-90184a86ec0e",
                                                "sense_id": "765724d6-0dcf-30fa-8f9d-4889cb27422d",
                                                "text": "Au milieu de ces montagnes, dans ces Alpes, dans ce pays des hautes neiges, des aigles et de la liberté, se plaidait donc aussi, sans espoir de le gagner, ce grand procès de ceux qui ne possèdent pas contre ceux qui possèdent."
                                            },
                                            {
                                                "example_id": "2546e616-7be6-4909-852a-a7603b277af5",
                                                "sense_id": "765724d6-0dcf-30fa-8f9d-4889cb27422d",
                                                "text": "Gonthramn eut pour lot, avec le royaume d’Orléans, part de son oncle Chlodomir, tout le territoire des Burgondes, depuis la Saône et les Vosges, jusqu’aux Alpes et à la mer de Provence."
                                            },
                                            {
                                                "example_id": "b9951e34-4ab1-40a3-bf7e-05390eb07513",
                                                "sense_id": "765724d6-0dcf-30fa-8f9d-4889cb27422d",
                                                "text": "[…], puis, à travers une éclaircie, nous reconnaissons des montagnes qui se découvrent une à une ; pendant quelques minutes, toute une rangée de pics se déploie dans la trouée : on dirait la chaîne des Alpes surgissant du milieu de l’Océan."
                                            },
                                            {
                                                "example_id": "8f7d6d93-2881-452c-95f7-bcb3b56fa53d",
                                                "sense_id": "765724d6-0dcf-30fa-8f9d-4889cb27422d",
                                                "text": "La chaîne des Alpes est issue de la Thétys, océan créé il y a 200 Ma, et de ses marges continentales africaine et européenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a484974f-6b62-4988-80c1-475297e116e5",
                        "source_entry_id": "5809e75d-e602-3fb6-81f4-08cd672d93ab",
                        "source_sense_id": "40af1d97-1811-39f3-ab0c-1a721b98c4df",
