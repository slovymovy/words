                        "examples": [
                            {
                                "example_id": "36e8c079-58d4-40aa-b31d-ae0edd3adfb6",
                                "sense_id": "c5ba89e8-c32f-3d93-b505-3612b67f74c6",
                                "text": "„Die plumpe Schneefigur saß da, überlebensgroß, und wachte königlich über die Fassade von Easterham Manor.“"
                            },
                            {
                                "example_id": "8fe1b74a-aafd-4a07-b82d-16d8673303f2",
                                "sense_id": "c5ba89e8-c32f-3d93-b505-3612b67f74c6",
                                "text": "„Ein bisschen wehmütig schaute er die Schneefigur an, dann blickte er verträumt in Richtung Eisenbahnbrücke.“"
                            },
                            {
                                "example_id": "de18ad8b-2bf5-4bd5-9b51-83edb8c2b5e6",
                                "sense_id": "c5ba89e8-c32f-3d93-b505-3612b67f74c6",
                                "text": "„Es dämmerte und die Nebelschwaben verzogen sich langsam als sie die lustige Schneefigur fertig hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
