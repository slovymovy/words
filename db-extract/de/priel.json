                "senses": [
                    {
                        "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                        "entry_id": "487f4b64-c461-36c0-a67b-1de6323f79ab",
                        "glosses": [
                            "natürlicher, tideabhängiger Wasserlauf im Deichvorland und Watt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "049c65f0-ff92-439c-aa58-e0c28a69d1ff",
                                "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                                "text": "Größere Priele dienen der Wattschifffahrt als Fahrrinnen."
                            },
                            {
                                "example_id": "c53a74cd-aab0-4570-958c-351b3a3770ac",
                                "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                                "text": "„Seeschwalben stürzen sich kopfüber in kleine Priele, die die Hallig wie Adern durchziehen.“"
                            },
                            {
                                "example_id": "294e437f-6cdc-4d07-901a-e59da5b4e079",
                                "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                                "text": "„Nach drei Stunden lag der sandige Boden des Meeresarms frei, in der Mitte floß noch Wasser in einem Priel, das sich aber ohne weiteres durchwaten lassen mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
