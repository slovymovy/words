                "senses": [
                    {
                        "sense_id": "0485f172-5a9f-3810-86cd-0c2699d7adfd",
                        "entry_id": "725db4a4-355e-358e-9bd0-854fbbf3984a",
                        "glosses": [
                            "Relatif aux apophtegmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86f9663-5d0f-4774-a574-2d9628d5a6ce",
                                "sense_id": "0485f172-5a9f-3810-86cd-0c2699d7adfd",
                                "text": "Qui n'admirerait […], dans le voisinage immédiat de Léopold et de Marchenoir, la cocasse enveloppe du vieux graveur Klatz, youtre crasseux et puant, mais irréparablement dénué de génie, dont le bafouillage apophtegmatique de brocanteur alsacien est apprécié comme un pharmaque sans rival contre toutes les mélancolies ?"
                            }
                        ]
                    }
                ],
                "translations": [
