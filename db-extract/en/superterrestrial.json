                        "glosses": [
                            "Above the Earth or earthly concerns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6773798-1f2c-4994-abd0-788a3b40e31e",
                                "sense_id": "1f5e7e1b-2045-3958-a236-16c46d4ac34b",
                                "text": "Secondly, modern criticism argues that a tangible or palpable body is not adapted to a superterrestrial abode. But this is ignoring the fact that the stars and the planets are superterrestrial, and yet they are material."
                            },
                            {
                                "example_id": "5e095abd-0826-49d6-9b0a-36c9cfe7a1e9",
                                "sense_id": "1f5e7e1b-2045-3958-a236-16c46d4ac34b",
                                "text": "Lulling music washed around me, soft voices announced the rising and falling of airliners, huge screens clicked soothingly through neverending arrivals and departures. Where in all this superterrestrial world was Tom?"
                            }
                        ]
                    }
