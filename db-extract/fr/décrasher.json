                "senses": [
                    {
                        "sense_id": "3502473c-1c02-3951-94ad-05ac46f92b9a",
                        "entry_id": "dc2ab0f8-34a4-31b2-b943-a98680af7ab4",
                        "glosses": [
                            "Remettre dans un état normal après un crash."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff40d67d-7c73-4713-bf22-b968a5b8ce73",
                                "sense_id": "3502473c-1c02-3951-94ad-05ac46f92b9a",
                                "text": "WinRE, c'est la partition de récupération protégée car cachée qui permet de décrasher l'OS sans courir après le DVD."
                            },
                            {
                                "example_id": "4fdd7c9e-434a-4499-9c21-caf0857c4fda",
                                "sense_id": "3502473c-1c02-3951-94ad-05ac46f92b9a",
                                "text": "Comment puis-je récupérer mon vrai grade et faire \"décrasher\" mon machinchose ?"
                            },
                            {
                                "example_id": "5e368954-c1a5-4a3f-9c58-b524f2854b3b",
                                "sense_id": "3502473c-1c02-3951-94ad-05ac46f92b9a",
                                "text": "Qu'ils en profitent pour décrasher le serveur héroïque."
                            },
                            {
                                "example_id": "b5a56f07-7ab8-4c40-ae04-7fb447ac39da",
                                "sense_id": "3502473c-1c02-3951-94ad-05ac46f92b9a",
                                "text": "Sinon, j'ai réussi à « décrasher » ma session."
                            }
                        ]
                    }
                ],
