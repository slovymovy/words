                                    {
                                        "sense_id": "d5e2e542-9a47-375b-ae18-6844f5511d3c",
                                        "entry_id": "a5855087-2cb2-3236-a7d2-cfae7ad072e8",
                                        "glosses": [
                                            "sontuoso velo eucaristico usato presso i bizantini solitamente decorato con l'immagine di Cristo morto e disteso fra due angeli come raffigurazione simbolica del sudario"
                                        ],
