                            {
                                "example_id": "055666da-65d5-4b1e-8a09-7cbecd7c8895",
                                "sense_id": "893450e3-d8c5-3b47-acc1-3fa5f8ca62ca",
                                "text": "„Im Bereich der heutigen Kennedybrücke überquerte bereits eine Römerstraße den Fluss.“"
                            },
                            {
