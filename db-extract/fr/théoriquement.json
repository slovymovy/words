                    },
                    {
                        "translation_id": "f8ac6d9e-0cbd-48f6-aefc-dd852f3b8478",
                        "source_entry_id": "aa67bc22-647b-32bb-a342-693d943da931",
                        "target_lang_word": "teoricamente",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teoricamente",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "4d10c504-d3cc-3a83-8f8a-0373d08ebf11",
                                        "entry_id": "f8fe3a8d-d156-3d6a-b676-7430d03aa607",
                                        "glosses": [
                                            "in maniera teorica"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0fb1425-f685-4398-9b6e-c80a07b766cc",
                                                "sense_id": "4d10c504-d3cc-3a83-8f8a-0373d08ebf11",
                                                "text": "L’alimentazione fornisce energia al corpo e teoricamente non si dovrebbe mangiare più di ciò che si consuma"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2fbbacd-3415-4f74-bcc9-78bd744592dd",
                        "source_entry_id": "aa67bc22-647b-32bb-a342-693d943da931",
                        "target_lang_word": "理論的には",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bab36574-6b4a-41d8-9c5d-748ca699c66b",
                        "source_entry_id": "aa67bc22-647b-32bb-a342-693d943da931",
                        "target_lang_word": "theoretisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theoretisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                                        "entry_id": "0ffbc849-8342-35ab-9b7d-bf73a02af4dc",
                                        "glosses": [
                                            "wat niet perse in de werkelijkheid voorkomt, m.b.t. feiten en wetten berustende wetenschappelijke kennis die niet proefondervindelijk aan de praktijk is getoetst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9085baba-444b-4b86-ad5b-70bf34592346",
                                                "sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                                                "text": "Dat is slechts een theoretisch verschijnsel."
                                            },
                                            {
                                                "example_id": "b402b948-41a3-42c7-a4a3-5b07481b8632",
                                                "sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                                                "text": "Theoretisch leek de oplossing heel eenvoudig. In de praktijk was het iets moeilijker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ace7acf2-fb4c-4e85-b442-481c35ce2d1f",
                        "source_entry_id": "aa67bc22-647b-32bb-a342-693d943da931",
                        "target_lang_word": "теоретически",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "теоретически",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7b80a5bb-61c0-350c-82d2-9ab5e6c97055",
                                        "entry_id": "2467bc56-b139-3c2e-a3e9-33cd0c206879",
                                        "glosses": [
                                            "наречие к теоретический; с точки зрения теории как общих, разработанных в отвлеченном плане основ какой-либо науки"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1f9bb54-0f58-4550-9ff6-06ff15498699",
                                                "sense_id": "7b80a5bb-61c0-350c-82d2-9ab5e6c97055",
                                                "text": "Моё открытие, черти б его съели, с которым вы носитесь, стоит ровно один ломаный грош… 〈…〉 Теоретически это интересно. Ну, ладно! Физиологи будут в восторге."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552704cf-8937-3f1f-8336-37f0f88f3421",
                                        "entry_id": "2467bc56-b139-3c2e-a3e9-33cd0c206879",
                                        "glosses": [
                                            "в соответствии с законами и принципами общих основ какой-либо науки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4122ff-ae07-45af-82d8-4d0c7962bf80",
                                                "sense_id": "552704cf-8937-3f1f-8336-37f0f88f3421",
                                                "text": "Как человек, теоретически образованный, он мог делать из фактов выводы, которых не умели делать люди, подобные Марье Алексевне, не знающие ничего, кроме обыденных личных забот да ходячих афоризмов простонародной общечеловеческой мудрости: пословиц, поговорок и тому подобных старых и старинных, древних и ветхих изречений."
                                            },
                                            {
                                                "example_id": "00558b8a-0dc0-41d2-aba9-fd0c6a0d7a2b",
                                                "sense_id": "552704cf-8937-3f1f-8336-37f0f88f3421",
                                                "text": "Далее, рассуждая теоретически, мы можем допустить четыре возможности."
                                            },
                                            {
                                                "example_id": "5a8afcc3-b1f4-49ae-ae29-9a55cb6d5938",
                                                "sense_id": "552704cf-8937-3f1f-8336-37f0f88f3421",
                                                "text": "Он хорошо подготовлен теоретически, и ему идей не занимать."
                                            },
                                            {
                                                "example_id": "ee8a11cd-ef3a-4304-901d-9274b6e7d45a",
                                                "sense_id": "552704cf-8937-3f1f-8336-37f0f88f3421",
                                                "text": "Как правило, теоретически рассчитанные места расположения антенн не вполне совпадают с найденными опытным путем — реальность не укладывается в самые сложные формулы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7423c29f-1c77-35fd-81e0-dc4078bc3fa7",
                                        "entry_id": "2467bc56-b139-3c2e-a3e9-33cd0c206879",
                                        "glosses": [
                                            "разг. отвлечённо, умозрительно, не опираясь на реальную действительность; абстрактно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61b960d6-5ae1-442c-9690-57c7c82f0a98",
                                                "sense_id": "7423c29f-1c77-35fd-81e0-dc4078bc3fa7",
                                                "text": "— Я понимаю, — говорил капитан, — есть выход. Ты же немец. Ты можешь эмигрировать в свободную Германию. — Теоретически это возможно. Практически — исключено."
                                            },
                                            {
                                                "example_id": "38cc188f-1d1c-463f-991d-bf56ea85f5f4",
                                                "sense_id": "7423c29f-1c77-35fd-81e0-dc4078bc3fa7",
                                                "text": "В США теоретически можно арендовать машину и без страховки, но делать это настоятельно не советую ― не дай бог что случится…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
