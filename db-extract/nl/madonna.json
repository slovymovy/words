                "senses": [
                    {
                        "sense_id": "1590afe3-21a3-3987-adc9-3ea33efd7221",
                        "entry_id": "bc075b57-cdd4-3387-a69f-ea5e88380888",
                        "glosses": [
                            "beeld of afbeelding van Maria als moeder met het kindje Jezus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3eec7a-8f15-4b18-82ac-35c679d44d95",
                                "sense_id": "1590afe3-21a3-3987-adc9-3ea33efd7221",
                                "text": "Het westelijke schild vertoont - niet duidelijk te onderscheiden - een zittende madonna met een heilige, knielend met gevouwen handen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b5193c9-bda6-3721-8645-2cd0b6dcaa6e",
                        "entry_id": "bc075b57-cdd4-3387-a69f-ea5e88380888",
                        "glosses": [
                            "vrouw die kuis leeft"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "139981ba-5405-469c-8dac-dd2afd7379b1",
                                "sense_id": "5b5193c9-bda6-3721-8645-2cd0b6dcaa6e",
                                "text": "Ik denk omdat ons ondeugende carnavalsprinsje vrouwen die niet passen in het christelijke madonna/hoer-patroon doodeng vindt en hen voorheen misschien zelfs wel als verwerpelijk zag."
                            }
                        ]
                    },
                    {
                        "sense_id": "d54dd962-0719-3d1e-be41-986aeeeefed4",
                        "entry_id": "bc075b57-cdd4-3387-a69f-ea5e88380888",
                        "glosses": [
                            "vrouw of meisje met een uitstraling van zuiverheid"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0b4e7971-d612-48b3-a2a4-c1a425f42730",
                                "sense_id": "d54dd962-0719-3d1e-be41-986aeeeefed4",
                                "text": "Quaerts ziet in Cecile een wezen van hoger orde, een madonna, die hij slechts platonisch kan en wil liefhebben, terwijl Cecile hem gewoon menselijk met lichaam en ziel bemint."
                            }
                        ]
                    }
