                "senses": [
                    {
                        "sense_id": "551c2d5d-7093-3499-b007-32dad911a420",
                        "entry_id": "887068f3-e456-3729-b658-ca945ee12756",
                        "glosses": [
                            "een houten constructie die vaak in een punt water overbrugt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c482fa6a-873e-3919-a087-40c5e656bd23",
                        "entry_id": "887068f3-e456-3729-b658-ca945ee12756",
                        "glosses": [
                            "een vogelbehuizing zonder ren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d25d980-45fa-4562-8bd8-53ed8a3c7086",
                                "sense_id": "c482fa6a-873e-3919-a087-40c5e656bd23",
                                "text": "Voor mij werd het eikenhouten kinderledikantje van de til gehaald en in elkaar gezet."
                            },
                            {
                                "example_id": "b8fba78f-f223-4d29-a8e9-c463644e77f0",
                                "sense_id": "c482fa6a-873e-3919-a087-40c5e656bd23",
                                "text": "We schommelden op de schommel die opa heel doordacht in de schuur aan een balk had bevestigd, precies zo dat je bij het hard achterwaarts schommelen met je hoofd door het open luik van de til ging en kon kijken wat daarboven allemaal voor spannends lag opgeslagen, en bij het naar voren gaan door de openstaande schuurdeur naar buiten, vanwaar je bij oma in de tegenoverliggende keuken naar binnen kon kijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ff07cd8-be64-471c-ad6c-f5a4d76d9f86",
                        "source_entry_id": "887068f3-e456-3729-b658-ca945ee12756",
                        "source_sense_id": "551c2d5d-7093-3499-b007-32dad911a420",
                        "source_sense_description": "een houten constructie die vaak in een punt water overbrugt",
                        "target_lang_word": "Balkenbrücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f682fa0d-b1f8-49f8-96a1-78ebcf1b9795",
                        "source_entry_id": "887068f3-e456-3729-b658-ca945ee12756",
                        "source_sense_id": "551c2d5d-7093-3499-b007-32dad911a420",
                        "source_sense_description": "een houten constructie die vaak in een punt water overbrugt",
                        "target_lang_word": "Holzbrücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holzbrücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15830cce-b27f-35b2-978c-c290a17e1598",
                                        "entry_id": "dc75e42a-ff10-3f80-bb29-92a1762f6bde",
                                        "glosses": [
                                            "Brücke hergestellt aus Holz"
                                        ],
                                        "tags": [
                                            "Verkehrsinfrastruktur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "725c33fa-35d4-4b18-9936-1b3db8670f43",
                                                "sense_id": "15830cce-b27f-35b2-978c-c290a17e1598",
                                                "text": "Die alte, baufällige Holzbrücke wurde durch eine stählerne Konstruktion ersetzt."
                                            },
                                            {
                                                "example_id": "8a908d9b-1438-4a56-80fc-3bc30c0d5b46",
                                                "sense_id": "15830cce-b27f-35b2-978c-c290a17e1598",
                                                "text": "„Auf einer langen Holzbrücke gingen wir über den versumpften Bach.“"
                                            },
                                            {
                                                "example_id": "963c786b-e0fa-45b4-9e9e-1ee9d49f2eac",
                                                "sense_id": "15830cce-b27f-35b2-978c-c290a17e1598",
                                                "text": "„Der Pfad führte jetzt über eine Holzbrücke.“"
                                            },
                                            {
                                                "example_id": "99f9ef90-d6d8-4f4a-aef4-2ef58e0ebc38",
                                                "sense_id": "15830cce-b27f-35b2-978c-c290a17e1598",
                                                "text": "„Eine Viertelstunde später erschienen die Pferde; man nahm Abschied und wandte sich auf die Holzbrücke zu, die die Turner vor ihnen passiert hatten.“"
                                            },
                                            {
                                                "example_id": "e2459174-d8b9-4f94-b2bc-f93ed3adef08",
                                                "sense_id": "15830cce-b27f-35b2-978c-c290a17e1598",
                                                "text": "„Wer sie durchqueren wollte, musste zunächst eine Holzbrücke überqueren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15ead6fc-912c-45ef-8830-30db0f999f2a",
                        "source_entry_id": "887068f3-e456-3729-b658-ca945ee12756",
                        "source_sense_id": "c482fa6a-873e-3919-a087-40c5e656bd23",
                        "source_sense_description": "een vogelbehuizing zonder ren",
                        "target_lang_word": "Taubenschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taubenschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                        "entry_id": "5823d365-4104-3c9d-83ff-745a05399f37",
                                        "glosses": [
                                            "Verschlag, der Haustauben Schutz vor Witterungseinflüssen und natürlichen Feinden bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d282d4b6-a3dc-468f-a7b8-756e77ec81d1",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "Auf der Flucht vor einem Habicht konnte sich die Taube in den Taubenschlag retten."
                                            },
                                            {
                                                "example_id": "69e584e9-96a8-4d01-8ab3-d14c3f2cbd37",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Er forderte von der Stadt eine vorübergehende Aufhebung des Fütterungsverbotes und neue Taubenschläge zur kontrollierten Haltung der Vögel, um deren \"Leid\" in den Griff zu bekommen.“"
                                            },
                                            {
                                                "example_id": "e39b3944-6a6c-431e-b908-04699a9a290d",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Kosole erzählt, dass er heute Nachmittag seinen Taubenschlag reparieren will.“"
                                            },
                                            {
                                                "example_id": "c384c44f-17c1-45ea-8945-0401cd51d066",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„In einer Ecke des Hühnerhofs wurde ein Taubenschlag aufgestellt.“"
                                            },
                                            {
                                                "example_id": "2c2ac939-ad5f-479a-a5f6-6e1ff14e3451",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Die Welle der Kelter erschien ihnen riesenhaft; dann stiegen sie in den Taubenschlag hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73686df3-aa3f-4782-b05e-5492e0e11531",
