                        "examples": [
                            {
                                "example_id": "f0bb9b4b-9b5a-41e8-af7d-de1a3297b65e",
                                "sense_id": "1cce9df5-7de7-3295-bfc9-df92dbd6277d",
                                "text": "Het was een verkiezingsjaar en de Moderaterna, zoals rechts zich tegenwoordig noemde, en de sociaaldemo craten waren overeengekomen om het IB weg te houden bij de verkiezingsMaar voor alle linkse mensen in het land, en ook voor het journalisten korps, was de reportage over het IB de grootste en krachtigste onthulling ooit."
                            },
                            {
                                "example_id": "8ea0c295-bf77-44b3-8c49-b07bcf8e1a9c",
                                "sense_id": "1cce9df5-7de7-3295-bfc9-df92dbd6277d",
                                "text": "Niet alleen Pelosi liet duidelijk weten wat ze van de president denkt, ook andere Democratische Congresleden deden dat. Zeven Democraten stonden tijdens de toespraak op en liepen weg. Daarmee lijkt de toon gezet voor dit verkiezingsjaar."
                            }
                        ]
