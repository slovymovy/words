                                "target_lang_sense_clarification": "término estándar y más común"
                            },
                            {
                                "target_lang_word": "pochoclo",
                                "target_lang_sense_clarification": "común en Argentina"
                            },
                            {
                                "target_lang_word": "crispetas",
                                "target_lang_sense_clarification": "común en Colombia"
                            },
                            {
                                "target_lang_word": "canguil",
                                "target_lang_sense_clarification": "común en Ecuador"
                            }
                        ]
