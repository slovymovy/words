                    {
                        "sense_id": "b9bed2f9-041c-32ae-9f46-94d97db335e6",
                        "entry_id": "e3fc1687-03b6-376e-bddb-0e29d0298e8e",
                        "glosses": [
                            "Carrière d’où l’on tire de l’ardoise."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "450bcfbd-55d1-44e9-b041-c45fdbd27e75",
                                "sense_id": "b9bed2f9-041c-32ae-9f46-94d97db335e6",
                                "text": "À Vichy, on visitait l’établissement thermal, la fabrique de bicarbonate de soude ; quelques-uns des membres de l’excursion allaient jusqu’à l’ardoiserie et exploraient le terrain carbonifère."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b31d543-7c38-310c-88ff-1b1bd9876e85",
                        "entry_id": "e3fc1687-03b6-376e-bddb-0e29d0298e8e",
                        "glosses": [
                            "Fabrique d’ardoises."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "9c1e0808-f90d-4201-a116-207d6528acd1",
                                "sense_id": "8b31d543-7c38-310c-88ff-1b1bd9876e85",
                                "text": "Les ardoisières de La Forêt possèdent en outre une station centrale électrique, au gaz pauvre, pour l’épuisement, l’éclairage et les divers services intérieurs et extérieurs des carrières et de l’ardoiserie."
                            },
                            {
                                "example_id": "b6b3c70a-983f-4825-818b-cf35c3d4141d",
                                "sense_id": "8b31d543-7c38-310c-88ff-1b1bd9876e85",
                                "text": "Dans la vallée de la Meuse, l’activité industrielle, très ancienne, contraste avec le paysage forestier. Le « paysan de la forêt » s’est longtemps spécialisé dans l’ardoiserie, le textile, la métallurgie."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfb0ea6b-0c55-3cd8-9d76-42623d7983b9",
                        "entry_id": "e3fc1687-03b6-376e-bddb-0e29d0298e8e",
                        "glosses": [
                            "Ensemble des ardoises d’une toiture."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "758707c0-b800-4d89-8101-5f01c750d0c0",
                                "sense_id": "cfb0ea6b-0c55-3cd8-9d76-42623d7983b9",
                                "text": "Sur les pentes presque perpendiculaires des toitures, criblant la longueur totale de leurs dimensions, l’ardoiserie venait d’être soulevée et arrachée."
                            }
                        ]
                    }
