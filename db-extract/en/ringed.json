    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d0894a74-317f-3a76-be98-da6d83fe11d2",
                "word": "ringed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5e1b7216-bc10-37e1-8e5e-26f6238161f1",
                        "entry_id": "d0894a74-317f-3a76-be98-da6d83fe11d2",
                        "glosses": [
                            "Marked with rings, circles, or loops."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "695a38e5-7b04-302e-b7bc-44bd3d91b3c7",
                        "entry_id": "d0894a74-317f-3a76-be98-da6d83fe11d2",
                        "glosses": [
                            "Wearing a wedding ring; hence, lawfully wedded."
                        ],
                        "tags": [
                            "archaic",
                            "literary",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "90347c28-d6c4-45e8-be1d-994c633e69e1",
                                "sense_id": "695a38e5-7b04-302e-b7bc-44bd3d91b3c7",
                                "text": "I was born of a true man and a ring'd wife, and I can't argue upon it; but I and my old woman 'ud burn upon it, that would we."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67218cc3-a80a-4542-9ef9-1636eefd3a99",
                        "source_entry_id": "d0894a74-317f-3a76-be98-da6d83fe11d2",
                        "source_sense_description": "marked with rings, circles, or loops",
                        "target_lang_word": "annelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "611ec161-6618-32f7-9081-5147a5447af0",
                                        "entry_id": "f0c6e323-04b3-3661-9462-df9624b17385",
                                        "glosses": [
                                            "Qui est disposé en forme d’anneaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30df1db1-2e23-4ad8-aa75-62cea41fedc7",
                                                "sense_id": "611ec161-6618-32f7-9081-5147a5447af0",
                                                "text": "Chevelure annelée."
                                            },
                                            {
                                                "example_id": "33523fb3-4fde-419b-af16-b4dde2198c72",
                                                "sense_id": "611ec161-6618-32f7-9081-5147a5447af0",
                                                "text": "La figure était jaune, parcheminée, annelée de rides, décimée par l’âge."
                                            },
                                            {
                                                "example_id": "68372ebb-c08e-4842-9c93-2275c1d678b9",
                                                "sense_id": "611ec161-6618-32f7-9081-5147a5447af0",
                                                "text": "Aimée, s’étant lavée la tête, est descendue les cheveux défaits et encore humides, des cheveux dorés doux comme de la soie, assez courts, annelés mollement à l’extrémité."
                                            },
                                            {
                                                "example_id": "3162663a-b84b-4129-8bf5-1c0fdf3d8017",
                                                "sense_id": "611ec161-6618-32f7-9081-5147a5447af0",
                                                "text": "On voit très bien les fils qu'il peut produire, cet amours, de grands êtres clairs, bien distincts, avec des doigts annelés et un nez court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dde43d-a6ba-3474-bd28-f3f1b44961e8",
                                        "entry_id": "f0c6e323-04b3-3661-9462-df9624b17385",
                                        "glosses": [
                                            "Qui a un ou plusieurs anneaux."
                                        ],
                                        "tags": [
                                            "Sciences naturelles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bbc0172-4092-4c57-bd71-5f8cf1a9597e",
                                                "sense_id": "60dde43d-a6ba-3474-bd28-f3f1b44961e8",
                                                "text": "À Madagascar, un lémurien à queue annelée a fait preuve de malice."
                                            },
                                            {
                                                "example_id": "caf9ccae-2eca-4911-9c97-5f164816994c",
                                                "sense_id": "60dde43d-a6ba-3474-bd28-f3f1b44961e8",
                                                "text": "Le corps des scolopendres est annelé."
                                            },
                                            {
                                                "example_id": "26133c2a-45dc-4b1c-82a1-806760aa9271",
                                                "sense_id": "60dde43d-a6ba-3474-bd28-f3f1b44961e8",
                                                "text": "Le corps de plusieurs serpents est annelé de brun ou de jaune."
                                            },
                                            {
                                                "example_id": "b16fb141-3305-4be7-8d23-1902ef67984e",
                                                "sense_id": "60dde43d-a6ba-3474-bd28-f3f1b44961e8",
                                                "text": "La hampe n'est point faite d'un bois inflexible, mais annelée et, comme une herbe, souple et longue, elle est docile au rêve de la terre, soit qu'elle se porte vers le soleil, soit que, sur les fleuves rapides et terreux ou au-dessus de la mer et du ciel, elle incline sa touffe énorme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "annelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee3b5cf9-f28f-3862-89cb-84c952e0a969",
                                        "entry_id": "c42e0327-8fb5-380a-b074-d8a6bb454df3",
                                        "glosses": [
                                            "Ver de la classe zoologique des Annelés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98a61985-ca05-4333-8723-085303743b5e",
                                                "sense_id": "ee3b5cf9-f28f-3862-89cb-84c952e0a969",
                                                "text": "Chez le vertébré comme chez l’annelé, nous voyons d’ailleurs les fils ressembler au père ou à la mère, aux différences individuelles près."
                                            },
                                            {
                                                "example_id": "7adbb53d-f80c-4853-b4a6-70b2c6d18dd1",
                                                "sense_id": "ee3b5cf9-f28f-3862-89cb-84c952e0a969",
                                                "text": "L'existence de gamètes hétérogènes ne suffit pas à définir deux sexes distincts ; en fait, il arrive souvent que la différenciation des cellules génératrices n'amène pas la scission de l'espèce en deux types : elles peuvent appartenir toutes deux à un même individu. C'est le cas des espèces hermaphrodites, si nombreuses chez les plantes et qu'on rencontre aussi chez quantité d'animaux inférieurs, entre autres chez les annelés et les mollusques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "annelé",
                                "target_lang_code": "fr",
