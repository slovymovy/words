{
    "word_family": [
        "index",
        "indexing",
        "indexed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83949a4f-5bbc-38d1-8a7f-3bb36c933c70",
                    "sense_definition": "A sign, token, or indicator of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rising prices are a clear <w>indice</w> of economic instability.",
                            "target_lang_translations": {
                                "zh": "物价上涨是经济不稳定的一个明确<w>迹象</w>。"
                            }
                        },
                        {
                            "text": "His silence was an <w>indice</w> of his deep disappointment.",
                            "target_lang_translations": {
                                "zh": "他的沉默是他深感失望的<w>标志</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indicator",
                        "sign",
                        "token"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This spelling is rarely used in modern English, where index is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "某种事物的迹象、标志或指示物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "迹象",
                                "target_lang_sense_clarification": "指事物发生、发展或存在的表现。"
                            },
                            {
                                "target_lang_word": "标志",
                                "target_lang_sense_clarification": "表明某种特征或状态的记号。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03d6a643-ff0f-3e85-a96b-9cb44461e6a6",
                    "sense_definition": "A piece of evidence or a suggestion that points to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was no <w>indice</w> that the suspect had been in the room.",
                            "target_lang_translations": {
                                "zh": "没有任何<w>线索</w>表明嫌疑人曾进入过这个房间。"
                            }
                        },
                        {
                            "text": "The subtle change in her tone provided an <w>indice</w> of her true feelings.",
                            "target_lang_translations": {
                                "zh": "她语气的细微变化提供了她真实感受的<w>暗示</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indication",
                        "clue",
                        "hint"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is largely obsolete in contemporary English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指向某事的证据或暗示。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "线索",
                                "target_lang_sense_clarification": "指可以引出结果的迹象或证据。"
                            },
                            {
                                "target_lang_word": "暗示",
                                "target_lang_sense_clarification": "不直接说明而用含蓄的言语或动作表示。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}