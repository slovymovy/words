                        "form": "das Obergeschoss"
                    },
                    {
                        "form_id": "daa373e8-8811-4b83-a67a-61a96979ca35",
                        "entry_id": "b21546db-6d72-3948-adbf-c46b08639059",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Obergeschosse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16aa1a3f-0567-377b-a916-c326eaafdc46",
                        "entry_id": "b21546db-6d72-3948-adbf-c46b08639059",
                        "glosses": [
                            "Stockwerk(e) zwischen dem Dachgeschoss und dem Erdgeschoss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf5295f6-2404-4ac8-a0e0-6b3507629822",
                                "sense_id": "16aa1a3f-0567-377b-a916-c326eaafdc46",
                                "text": "Sie hatten für den Urlaub ein Zimmer im ersten Obergeschoss gebucht."
                            },
                            {
                                "example_id": "4a7dd79d-ef1e-4f32-b564-36164b0bb94a",
                                "sense_id": "16aa1a3f-0567-377b-a916-c326eaafdc46",
                                "text": "„Die Obergeschosse gingen infolge Brandes verloren.“"
                            },
                            {
                                "example_id": "6fcd3633-d01a-4307-916a-068c3c2ac7df",
                                "sense_id": "16aa1a3f-0567-377b-a916-c326eaafdc46",
                                "text": "„Von einer großzügigen Eingangshalle mit gewundener Treppe gelangt man in ein knappes Dutzend Räume, darunter ein Salon, ein Esszimmer, ein Raucherzimmer, ein Arbeitszimmer plus Bibliothek und im Obergeschoss mindestens fünf Schlafräume.“"
                            },
                            {
                                "example_id": "76d2a0ac-ddff-4886-b3d0-383d67ba1708",
                                "sense_id": "16aa1a3f-0567-377b-a916-c326eaafdc46",
                                "text": "„Sie hatte deshalb in dem Obergeschosse des an der Straße gelegenen Gebäudes hinter Wandschirmen Tische decken und dort viele Zierlaternen aufhängen lassen.“"
                            },
                            {
                                "example_id": "72011259-0b69-4509-9d93-ba1baee18c50",
                                "sense_id": "16aa1a3f-0567-377b-a916-c326eaafdc46",
                                "text": "„Ihr Bruder Petja hielt sich ebenfalls im Obergeschoss auf: er fabrizierte gerade mit seinem Diener und ehemaligen Kinderwärter ein Feuerwerk, das er in der Nacht abbrennen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
