                ],
                "senses": [
                    {
                        "sense_id": "7f7b67a3-2fda-39fd-b5d9-57e3b4103ccf",
                        "entry_id": "2275f8a6-77da-3606-b3ee-8196da6ec07e",
                        "glosses": [
                            "Profitless; pointless; unavailing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d1c251-dcdc-408d-aa2f-3bf4507ee721",
                                "sense_id": "7f7b67a3-2fda-39fd-b5d9-57e3b4103ccf",
                                "text": "I'll follow him no more with bootless prayers."
                            },
                            {
                                "example_id": "dd26e927-87e0-4994-953a-a53d7f3e6522",
                                "sense_id": "7f7b67a3-2fda-39fd-b5d9-57e3b4103ccf",
                                "text": "When, in disgrace with fortune and men's eyes, / I all alone beweep my outcast state / And trouble deaf heaven with my bootless cries"
                            },
                            {
                                "example_id": "0ad1c9c0-239f-411f-8cff-ab1c4f07bd2e",
                                "sense_id": "7f7b67a3-2fda-39fd-b5d9-57e3b4103ccf",
                                "text": "APRIL FOOL, Any one imposed on, or sent on a bootless errand on the first of April, on which day it is the custom among the lower people, children, and servants, by dropping empty papers carefully doubled up, sending persons on absurd messages, and such like contrivances, to impose on every one they can, and then to salute them with the title of April-fool."
                            },
                            {
                                "example_id": "cccd4abd-722e-4a03-956b-a7c6c23742a9",
                                "sense_id": "7f7b67a3-2fda-39fd-b5d9-57e3b4103ccf",
                                "text": "The lieutenant tried the handle again, but still his efforts were quite bootless. He pushed and kicked, but the door was a strong one."
                            }
                        ]
                    }
                ],
