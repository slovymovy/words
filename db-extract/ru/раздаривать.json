                                            {
                                                "example_id": "0008400b-7870-45c4-9319-f80d26b28699",
                                                "sense_id": "882d91bd-97c7-3126-a9d3-68fd7fc6b32c",
                                                "text": "La sua vita [del Cardinale Borromeo] fu un continuo profondere ai poveri (Manzoni)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c75123a2-814e-3fb6-889e-7ce9049641c9",
                                        "entry_id": "ddd4a748-614f-315f-bb27-e297de3d50e2",
                                        "glosses": [
                                            "versare, spargere, spandere, diffondere, effondere, anche con riferimento al proprio patrimonio di doti e ricchezze interiori o con sfumatura ironica"
                                        ],
                                        "tags": [],
                                        "examples": [
