                "senses": [
                    {
                        "sense_id": "9b247f20-0fa4-33df-9f3b-b9a06c2ed09d",
                        "entry_id": "f177ef64-3e6b-36cf-b4b7-bd9f72acbc7a",
                        "glosses": [
                            "der Bereich, den man erfassen kann, ohne die Blickrichtung zu ändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4d7b34-95ae-443e-83ad-6bd7148bba58",
                                "sense_id": "9b247f20-0fa4-33df-9f3b-b9a06c2ed09d",
                                "text": "„Die einzigen Objekte in meinem Gesichtsfeld, die sich in diesem dichtbebauten und menschenreichen Stadtteil bewegten, waren ein hinter mir fahrender Mann mit einem Buggy und eine gemächlich die Querstraße hinaufzuckelnde Pferdebahn.“"
                            },
                            {
                                "example_id": "a28bcb53-2d8d-4833-b9ab-895f9bad012d",
                                "sense_id": "9b247f20-0fa4-33df-9f3b-b9a06c2ed09d",
                                "text": "„Dann tauchte ein schwarzer Vorhang in seinem Gesichtsfeld auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
