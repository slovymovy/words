                ],
                "senses": [
                    {
                        "sense_id": "66d816fc-fc2d-389c-81ed-3761902fd2a7",
                        "entry_id": "b78ee90e-d3b9-3a78-a480-3315fe38ef3a",
                        "glosses": [
                            "Qualifie un chou qui s'est pommé."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "574f725c-7c0f-40fe-922f-4651d125d4eb",
                                "sense_id": "66d816fc-fc2d-389c-81ed-3761902fd2a7",
                                "text": "Peut-être faudrait-il alors expliquer à ceux-là que les cigognes sont occupées et les choux mal pommés pour cause d’intempéries."
                            }
                        ]
                    },
                    {
                        "sense_id": "62adb241-1a68-30c5-8166-912e0c4d54bc",
                        "entry_id": "b78ee90e-d3b9-3a78-a480-3315fe38ef3a",
                        "glosses": [
                            "Qualifie une folie, une sottise achevée, complète."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e70ac857-32a5-48ea-bda0-ecb37bc430ad",
                                "sense_id": "62adb241-1a68-30c5-8166-912e0c4d54bc",
                                "text": "Vous souvient-il que le cardinal de Retz, qui avait le cœur si haut, l’homme de France auquel on a vu peut-être le plus de courage, un homme comparable aux anciens, ayant donné d’impatience un coup de pied au cul à son écuyer qui faisait quelque sottise pommée, fut accablé de coups de canne et rossé d’importance par cet homme, qui se trouva beaucoup plus fort que lui ?"
                            },
                            {
                                "example_id": "c16cc48f-c1f1-4e40-baca-0d803db672b9",
                                "sense_id": "62adb241-1a68-30c5-8166-912e0c4d54bc",
                                "text": "Ce que tu dis là est d'une niaiserie pommée."
                            }
                        ]
                    },
                    {
                        "sense_id": "a89f6572-7451-3a4d-965c-72de6620e84e",
                        "entry_id": "b78ee90e-d3b9-3a78-a480-3315fe38ef3a",
                        "glosses": [
                            "Qualifie de même le fou ou le sot."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bd127fe5-8f85-478b-934d-4a3e3e429e43",
                                "sense_id": "a89f6572-7451-3a4d-965c-72de6620e84e",
                                "text": "J’suis super pommé avec les filles !"
                            }
                        ]
                    },
                    {
                        "sense_id": "08eb91a6-65d8-3ef3-a54c-37ff33a65edc",
                        "entry_id": "b78ee90e-d3b9-3a78-a480-3315fe38ef3a",
                        "glosses": [
                            "Relatif à un produit informatique de la marque Apple dont le logo est une pomme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3893bb70-b2f7-42ec-a3e0-a5175e0ac4b2",
                                "sense_id": "08eb91a6-65d8-3ef3-a54c-37ff33a65edc",
                                "text": "Accusée d'avoir plagié les produits pommés, la firme coréenne doit laisser les avocats d'Apple fouiller dans ces prototypes, afin qu'ils puissent avérer ou non le fait que Samsung ait copié les produits de la Pomme."
                            },
                            {
                                "example_id": "ca02f763-fe7c-4dae-94cc-e386050396d3",
                                "sense_id": "08eb91a6-65d8-3ef3-a54c-37ff33a65edc",
                                "text": "Apple et Amazon sont parvenus à un accord et les produits pommés vont se vendre sur les boutiques en ligne du constructeur et les magasins agréés."
                            }
                        ]
                    }
                ],
