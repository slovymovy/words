                "senses": [
                    {
                        "sense_id": "e3c1bf9e-45d2-3904-9ad4-f05ac5f3e324",
                        "entry_id": "44ff45c5-2f9b-3a01-80fa-544f378fb951",
                        "glosses": [
                            "jüdische Gesetzes- und Religionslehrerin, Predigerin und Seelsorgerin"
                        ],
                        "tags": [
                            "Judentum"
                        ],
                        "examples": [
                            {
                                "example_id": "1c9e2ff2-7eb3-4f9e-afe8-eef60fadd5ca",
                                "sense_id": "e3c1bf9e-45d2-3904-9ad4-f05ac5f3e324",
                                "text": "„In Berlin ist am Donnerstag die erste in der Bundesrepublik Deutschland ausgebildete Rabbinerin ordiniert worden.“"
                            },
                            {
                                "example_id": "d6fec021-4823-4f7b-a9f6-53dc6f1b75fb",
                                "sense_id": "e3c1bf9e-45d2-3904-9ad4-f05ac5f3e324",
                                "text": "Die erste Rabbinerin in den USA war Sally Jane Priesand, die 1972 am Hebrew Union College in Cincinnati ordiniert wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62cf25ff-de28-4246-bbcd-190169ee30ac",
                        "source_entry_id": "44ff45c5-2f9b-3a01-80fa-544f378fb951",
                        "source_sense_id": "e3c1bf9e-45d2-3904-9ad4-f05ac5f3e324",
                        "source_sense_description": "Judentum: jüdische Gesetzes- und Religionslehrerin, Predigerin und Seelsorgerin",
                        "target_lang_word": "rabbine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabbine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e38317-cfa0-3271-87bd-c92eaf377f32",
                                        "entry_id": "e3681c6e-fecc-3183-b569-a6ac143908f3",
                                        "glosses": [
                                            "Ministre du culte judaïque."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "517d0cdf-e12f-4ca2-acdf-c571beabc63f",
                                                "sense_id": "b8e38317-cfa0-3271-87bd-c92eaf377f32",
                                                "text": "Delphine Horvilleur, rabbine du Mouvement juif libéral de France (MJLF) juge aberrante une telle interdiction qui participe, selon elle, d’une ignorance entretenue."
                                            },
                                            {
                                                "example_id": "b778d509-b34e-4f51-b1ad-3e64bb884561",
                                                "sense_id": "b8e38317-cfa0-3271-87bd-c92eaf377f32",
                                                "text": "Nous avons réuni Kahina Bahloul et Delphine Horvilleur, imame et rabbine, pour un échange sans tabou, à la veille du procès des attentats de janvier 2015."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5495078-1e8d-3104-a010-a23182ab64bb",
                                        "entry_id": "e3681c6e-fecc-3183-b569-a6ac143908f3",
                                        "glosses": [
                                            "Épouse d’un rabbin."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e629628b-1a03-4ea0-aae8-015226234d5d",
                                                "sense_id": "b5495078-1e8d-3104-a010-a23182ab64bb",
                                                "text": "Il y avait un relent permanent de tabac à priser, de vinaigre, de bancs de bois marqués d’entailles, de cuisine, qui venait de l’appartement de la rabbine, de rideaux de velours poussiéreux, de brocart doré des châles de prière, de vieux livres qui semblaient nous venir du temps de Moïse et des Prophètes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
