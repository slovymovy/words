{
    "word_family": [
        "pewterer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa1196bb-c67b-3ff0-b9e2-72e3071e50b4",
                    "sense_definition": "A metal alloy consisting primarily of tin with small amounts of copper and antimony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique shop displayed several beautiful <w>pewter</w> plates on the wooden shelf.",
                            "target_lang_translations": {
                                "de": "Das Antiquitätengeschäft stellte mehrere wunderschöne <w>Zinnteller</w> auf dem Holzregal aus."
                            }
                        },
                        {
                            "text": "Many historical items were crafted from <w>pewter</w> because it was easier to shape than iron.",
                            "target_lang_translations": {
                                "de": "Viele historische Gegenstände wurden aus <w>Zinn</w> gefertigt, da es leichter zu formen war als Eisen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pewter plate",
                        "pewter mug"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Metalllegierung, die hauptsächlich aus Zinn mit geringen Mengen Kupfer und Antimon besteht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hartzinn",
                                "target_lang_sense_clarification": "Bezeichnung für die Legierung selbst."
                            },
                            {
                                "target_lang_word": "Zinn",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für das Material im handwerklichen Kontext."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a02c1b29-f0f8-3e65-aa84-99e094ca6ae7",
                    "sense_definition": "Objects or utensils made from the metal alloy pewter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She polished the old <w>pewter</w> until it shone like silver.",
                            "target_lang_translations": {
                                "de": "Sie polierte das alte <w>Zinn</w>, bis es wie Silber glänzte."
                            }
                        },
                        {
                            "text": "The collection of <w>pewter</w> was passed down through the family for generations.",
                            "target_lang_translations": {
                                "de": "Die <w>Zinnsammlung</w> wurde über Generationen in der Familie weitergegeben."
                            }
                        }
                    ],
                    "synonyms": [
                        "pewterware"
                    ],
                    "common_phrases": [
                        "antique pewter"
                    ],
                    "target_lang_definitions": {
                        "de": "Gegenstände oder Utensilien, die aus der Metalllegierung Zinn hergestellt sind."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Zinnwaren",
                                "target_lang_sense_clarification": "Sammelbegriff für Gegenstände aus Zinn."
                            },
                            {
                                "target_lang_word": "Zinngegenstände",
                                "target_lang_sense_clarification": "Konkrete Objekte aus Zinn."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66b7de93-beff-39a2-84d3-f96defa27189",
                    "sense_definition": "A dark, dull grey color resembling the appearance of the metal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sky turned a deep <w>pewter</w> before the heavy storm began.",
                            "target_lang_translations": {
                                "de": "Der Himmel färbte sich in ein tiefes <w>Zinngrau</w>, bevor das schwere Unwetter begann."
                            }
                        },
                        {
                            "text": "He painted the walls a soft <w>pewter</w> to create a modern look.",
                            "target_lang_translations": {
                                "de": "Er strich die Wände in einem sanften <w>Zinngrau</w>, um einen modernen Look zu erzeugen."
                            }
                        }
                    ],
                    "synonyms": [
                        "grey"
                    ],
                    "common_phrases": [
                        "pewter grey"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine dunkle, matte graue Farbe, die dem Aussehen des Metalls ähnelt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zinngrau",
                                "target_lang_sense_clarification": "Farbbezeichnung für das spezifische Grau."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41c59ec0-4849-31d8-916f-ed29fc29d4b4",
                    "sense_definition": "A drinking mug or tankard made of pewter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired workers sat at the table and rested their <w>pewters</w> after a long shift.",
                            "target_lang_translations": {
                                "de": "Die müden Arbeiter saßen am Tisch und stellten ihre <w>Zinnkrüge</w> nach einer langen Schicht ab."
                            }
                        },
                        {
                            "text": "He lifted his heavy <w>pewter</w> to toast to their success.",
                            "target_lang_translations": {
                                "de": "Er hob seinen schweren <w>Zinnkrug</w>, um auf ihren Erfolg anzustoßen."
                            }
                        }
                    ],
                    "synonyms": [
                        "tankard"
                    ],
                    "common_phrases": [
                        "beer pewter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a traditional drinking vessel."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Trinkkrug oder Humpen aus Zinn."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Zinnkrug",
                                "target_lang_sense_clarification": "Traditioneller Trinkbehälter aus Zinn."
                            },
                            {
                                "target_lang_word": "Zinnseidel",
                                "target_lang_sense_clarification": "Regionale Bezeichnung für einen Zinnkrug."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "acad5049-e069-3d6e-ad2e-e28df3d49a59",
                    "sense_definition": "Having a dark, dull grey color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>pewter</w> dress that matched the cloudy sky.",
                            "target_lang_translations": {
                                "de": "Sie trug ein <w>zinngraues</w> Kleid, das zum bewölkten Himmel passte."
                            }
                        },
                        {
                            "text": "The car had a sleek <w>pewter</w> finish that looked very elegant.",
                            "target_lang_translations": {
                                "de": "Das Auto hatte eine elegante <w>zinngraue</w> Lackierung, die sehr edel aussah."
                            }
                        }
                    ],
                    "synonyms": [
                        "grey"
                    ],
                    "common_phrases": [
                        "pewter finish"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine dunkle, matte graue Farbe aufweisend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zinngrau",
                                "target_lang_sense_clarification": "Adjektiv zur Beschreibung einer Farbe."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f581235b-1e50-3e98-a7ca-8a9ca590b80b",
                    "sense_definition": "To cover or coat an object with a layer of pewter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman decided to <w>pewter</w> the base of the lamp to protect it.",
                            "target_lang_translations": {
                                "de": "Der Handwerker beschloss, den Lampenfuß zu <w>verzinnen</w>, um ihn zu schützen."
                            }
                        },
                        {
                            "text": "They <w>pewtered</w> the surface to give it a more durable finish.",
                            "target_lang_translations": {
                                "de": "Sie <w>verzinnten</w> die Oberfläche, um ihr ein haltbareres Finish zu verleihen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Gegenstand mit einer Zinnschicht überziehen oder beschichten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verzinnen",
                                "target_lang_sense_clarification": "Fachbegriff für das Beschichten mit Zinn."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}