                ],
                "senses": [
                    {
                        "sense_id": "d5d43d4a-5e3d-3a5e-ae41-fa152eb9293f",
                        "entry_id": "9f286501-636c-3445-9b35-189417081ecf",
                        "glosses": [
                            "Asservir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ce7e9a-b7b3-4a45-9897-9ab1ba9fb7d4",
                                "sense_id": "d5d43d4a-5e3d-3a5e-ae41-fa152eb9293f",
                                "text": "On ne s'occupe pas d'enlever les mauvaises réformes d'un empereur despote; c'est aux capricieuses volontés d'un ministre despote qu'on vent nous rasservir!"
                            },
                            {
                                "example_id": "5376d969-31ea-4ec5-ad98-6ecba406a423",
                                "sense_id": "d5d43d4a-5e3d-3a5e-ae41-fa152eb9293f",
                                "text": "Mais les sénateurs n'étaient que sénateurs; et l'esprit da corps fut toujours d'abuser le peuple et de rasservir,de se regarder soi-même comme l'état par excellence, et de faire de la multitude le jouet de sa politique et l'instrument de sa grandeur."
                            }
                        ]
                    }
                ],
