                "senses": [
                    {
                        "sense_id": "c3381fc2-a645-38fe-ba00-b5402279bf90",
                        "entry_id": "04713e59-6db9-3164-9f82-39b05b46d351",
                        "glosses": [
                            "Regen während des Monsuns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58782d56-3f8d-47e6-b012-5ea2e1bba0ce",
                                "sense_id": "c3381fc2-a645-38fe-ba00-b5402279bf90",
                                "text": "„In seinen elf Regierungsjahren hatte er für Millionen von Dollars Aufträge für Straßen vergeben, von denen er wusste, dass sie sich beim ersten Monsunregen auflösen würden.“"
                            },
                            {
                                "example_id": "c5895834-1def-4d32-81f7-ff3db8da308b",
                                "sense_id": "c3381fc2-a645-38fe-ba00-b5402279bf90",
                                "text": "„Ich habe ihn einmal angerufen und ihm gesagt, er soll sich beeilen, damit er vor dem Monsunregen fertig wird.“"
                            },
                            {
                                "example_id": "ed73f542-4850-4dc7-8d93-212d108fe8d7",
                                "sense_id": "c3381fc2-a645-38fe-ba00-b5402279bf90",
                                "text": "„Während die Person im Buch durch die gefrorene sibirische Wildnis stapfte, fraßen außerhalb des Buches die Monsunregen des Frühsommers und die schwülen feuchten Winde an dem Leim, der die Seiten der Bücher zusammenhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
