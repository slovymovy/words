{
    "word_family": [
        "hamer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eaabd7ca-afd9-35ff-8c78-45d5ba7cc885",
                    "sense_definition": "met een hamer ergens in slaan",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>hamerde</w> voor de zekerheid nog een paar spijkers door het hout.",
                            "target_lang_translations": {
                                "en": "He <w>hammered</w> a few more nails through the wood just to be sure."
                            }
                        },
                        {
                            "text": "De timmerman <w>hamert</w> de spijker in de muur.",
                            "target_lang_translations": {
                                "en": "The carpenter <w>is hammering</w> the nail into the wall."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spijkers hameren"
                    ],
                    "target_lang_definitions": {
                        "en": "To hit or drive something into a surface using a hammer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to hammer",
                                "target_lang_sense_clarification": "general action of hitting with a hammer"
                            },
                            {
                                "target_lang_word": "to nail",
                                "target_lang_sense_clarification": "specifically driving nails into something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb8d7e98-98ea-35a6-8f2c-e2d3cc1c542c",
                    "sense_definition": "zwaar de nadruk op iets leggen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe hij hier in de klas ook op <w>gehamerd</w> had, het vraagstuk werd allerbelabberdst beantwoord op het examen.",
                            "target_lang_translations": {
                                "en": "No matter how much he had <w>harped on</w> this in class, the question was answered very poorly on the exam."
                            }
                        },
                        {
                            "text": "De docent <w>hamert</w> er bij de studenten op dat zij op tijd komen.",
                            "target_lang_translations": {
                                "en": "The teacher <w>stresses</w> to the students that they must arrive on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "benadrukken",
                        "beklemtonen"
                    ],
                    "common_phrases": [
                        "ergens op hameren"
                    ],
                    "target_lang_definitions": {
                        "en": "To emphasize something strongly or repeatedly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to harp on",
                                "target_lang_sense_clarification": "to talk about something repeatedly and annoyingly"
                            },
                            {
                                "target_lang_word": "to stress",
                                "target_lang_sense_clarification": "to give particular importance to a point"
                            },
                            {
                                "target_lang_word": "to hammer home",
                                "target_lang_sense_clarification": "to make a point very clear and forceful"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}