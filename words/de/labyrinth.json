{
    "word_family": [
        "labyrinthisch",
        "Labyrinthfisch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7364da0-e13a-3009-863a-858a40cfa15f",
                    "sense_definition": "System von verzweigten Wegen oder Gängen, in dem man sich schwer zurechtfindet, oder ein unüberschaubares Gewirr",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weg_orientierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Touristen verirrten sich stundenlang in dem verwinkelten <w>Labyrinth</w> aus schmalen Gassen der Altstadt."
                        },
                        {
                            "text": "Der Freizeitpark eröffnete ein großes grünes <w>Labyrinth</w> aus hohen Hecken für seine Besucher."
                        }
                    ],
                    "synonyms": [
                        "Irrgarten",
                        "Irrgang",
                        "Gewirr",
                        "Wirrwarr",
                        "Durcheinander"
                    ],
                    "common_phrases": [
                        "ein verwinkeltes Labyrinth",
                        "sich im Labyrinth verlaufen"
                    ]
                },
                {
                    "sense_id": "392eb333-008d-38aa-977e-fe9b50a10a5d",
                    "sense_definition": "In sich verschlungene Wegführung ohne Verzweigungen, die von außen zum Zentrum führt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weg_orientierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf dem Boden der alten Kathedrale befindet sich ein kunstvolles <w>Labyrinth</w> aus Steinplatten."
                        },
                        {
                            "text": "Anders als ein Irrgarten besitzt dieses historische <w>Labyrinth</w> keine Abzweigungen oder Sackgassen."
                        }
                    ],
                    "common_phrases": [
                        "klassisches Labyrinth"
                    ]
                },
                {
                    "sense_id": "5c17186e-45d8-39b1-ba87-d80156a1333c",
                    "sense_definition": "Mit Flüssigkeit gefülltes Hohlraumsystem im Innenohr für den Hör- und Gleichgewichtssinn",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei einer Entzündung im <w>Labyrinth</w> des Ohres leiden viele Betroffene an plötzlichem Schwindel."
                        },
                        {
                            "text": "Der Arzt erklärte dem Patienten den komplizierten Aufbau des <w>Labyrinths</w> im Innenohr."
                        }
                    ],
                    "synonyms": [
                        "Innenohr",
                        "Labyrinthorgan"
                    ],
                    "common_phrases": [
                        "knöchernes Labyrinth",
                        "membranöses Labyrinth"
                    ]
                }
            ]
        }
    ]
}