                        "entry_id": "2fb3204a-f508-3c43-ab6a-9ae9fb67a0f0",
                        "glosses": [
                            "sure, no fear"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "62d26508-f502-4a6d-8ed7-b33307da8a5e",
                                "sense_id": "ed130ee1-3842-3bf0-9892-e58fc0fe74e7",
                                "text": "Небо́сь, не замёрзнешь!",
                                "translation": "Don't worry, you won't get frostbite!",
