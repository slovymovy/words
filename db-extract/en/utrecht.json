                                            "spelwoord van het Nederlandse spellingalfabet voor de letter u"
                                        ],
                                        "tags": [
                                            "spellingsalfabet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42ff637a-e0b4-46c6-aca5-92f5a58127e7",
                        "source_entry_id": "a8712056-e15f-38bc-aa84-0fc9f61248b0",
                        "source_sense_description": "city in the Netherlands",
                        "target_lang_word": "Utrecht",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Utrecht",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f0696a-9f50-3562-ad04-c0081da53314",
                                        "entry_id": "c023fb56-3103-34c4-88e4-b35482e38b2d",
                                        "glosses": [
                                            "Commune et ville des Pays-Bas située dans la province d’Utrecht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d5a815f-fff6-4afa-94fc-2eb75619d30c",
                                                "sense_id": "f1f0696a-9f50-3562-ad04-c0081da53314",
                                                "text": "Une problématique à laquelle a réfléchi Marianne de Groot-Pons, graphique designer pour l’agence Pons Ontwerp basée à Utrecht, aux Pays-Bas."
                                            },
                                            {
                                                "example_id": "322d7502-da21-452c-b44a-aff4c4a705bb",
                                                "sense_id": "f1f0696a-9f50-3562-ad04-c0081da53314",
                                                "text": "Les tables peintes en marbre, les tabourets en velours d’Utrecht rouge, le quinquet à globe plein d’huile alimentant deux becs, attaché par une chaîne au plafond et enjolivé de cristaux, commencèrent la célébrité du Café de la Guerre."
                                            },
                                            {
                                                "example_id": "23c23242-9dd7-4578-9f07-e660a566e639",
                                                "sense_id": "f1f0696a-9f50-3562-ad04-c0081da53314",
                                                "text": "Le Néerlandais Robert Gesink portera le maillot rouge de leader au départ de la 2ᵉ étape entre Bois-le-Duc et Utrecht (175 km) aujourd’hui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afda0671-94f7-3756-bf86-534063956720",
                                        "entry_id": "c023fb56-3103-34c4-88e4-b35482e38b2d",
                                        "glosses": [
                                            "Une des douze provinces des Pays-Bas dont le chef-lieu est Utrecht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fda6dbdf-86e2-478b-a4f3-12cbf4944858",
                                                "sense_id": "afda0671-94f7-3756-bf86-534063956720",
                                                "text": "Ces arrêtés, en vigueur dans trois provinces, parmi lesquelles la province d’Utrecht, conféraient au stadhouder le pouvoir de nommer des magistrats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "231c967b-e94d-3add-aed8-1b9491faff6d",
                                        "entry_id": "c023fb56-3103-34c4-88e4-b35482e38b2d",
                                        "glosses": [
                                            "Ville de la province du KwaZulu-Natal en Afrique du Sud."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a397ed-f6f4-4666-829d-4acf8b142899",
                                                "sense_id": "231c967b-e94d-3add-aed8-1b9491faff6d",
                                                "text": "En 1860, la république de Lydenburg, dont faisait partie Utrecht, avait rejoint la république du Transvaal, cette alliance ayant pour but de renforcer l’identité boer de la région."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b17fb62-0029-4879-8267-ae02cc2556de",
                        "source_entry_id": "a8712056-e15f-38bc-aa84-0fc9f61248b0",
                        "source_sense_description": "city in the Netherlands",
                        "target_lang_word": "Utrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Utrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3576f8fa-1c49-3cf7-aa9c-387a12f6d7a6",
                                        "entry_id": "86c89350-68c3-337a-9d9b-b9df744ddb2f",
                                        "glosses": [
                                            "große Stadt in den Niederlanden"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c89c751-6b3f-4e6a-82c2-a2838508c5b7",
                                                "sense_id": "3576f8fa-1c49-3cf7-aa9c-387a12f6d7a6",
                                                "text": "Die Stadt Utrecht ist sehr zentral in den Niederlanden gelegen, deswegen kommt auch ihrem Bahnhof eine besondere Bedeutung für Fernverbindungen zu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35bc4da1-af65-4b0f-97a2-5efffc1d17e2",
                        "source_entry_id": "a8712056-e15f-38bc-aa84-0fc9f61248b0",
