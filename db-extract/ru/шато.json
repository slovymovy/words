                                        "glosses": [
                                            "Chateaubriand (pièce de viande)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbeb33b2-6b20-426d-93ac-3d5590412aba",
                                                "sense_id": "43d99a06-8c20-39b3-9f95-e7285d5c0a8b",
                                                "text": "Marina riait aux larmes, pendant que Michel mangeait un château qui n’était pas saignant, non, il était bleu !"
                                            }
                                        ]
