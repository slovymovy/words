                "senses": [
                    {
                        "sense_id": "90da80f8-4842-3e86-b6ae-e1383f32351e",
                        "entry_id": "702ae5f6-08df-3f4b-bbf5-0287cbb80836",
                        "glosses": [
                            "aromatische Verbindung, die vom Benzol abgeleitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95a9c910-3a53-43c8-8e1d-235df2a91ee6",
                                "sense_id": "90da80f8-4842-3e86-b6ae-e1383f32351e",
                                "text": "Xanthen ist der Grundstoff vieler Xanthenfarbstoffe."
                            },
                            {
                                "example_id": "6f9f9142-7a34-485d-8693-220c0746b2aa",
                                "sense_id": "90da80f8-4842-3e86-b6ae-e1383f32351e",
                                "text": "Eosin ist ein Derivat von Xanthen."
                            },
                            {
                                "example_id": "c876f140-fdc5-4029-8b53-88084d6208c2",
                                "sense_id": "90da80f8-4842-3e86-b6ae-e1383f32351e",
                                "text": "„Xanthen […] ist ein tricyclischer Ether und damit eine heterocyclische Verbindung.“"
                            },
                            {
                                "example_id": "8e2e9d05-39f8-49fe-81a8-ab8c71a05029",
                                "sense_id": "90da80f8-4842-3e86-b6ae-e1383f32351e",
                                "text": "„Xanthen wird durch Erhitzen von 2,2'-Dihydroxy-diphenylmethan hergestellt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
