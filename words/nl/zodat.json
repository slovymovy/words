                {
                    "sense_id": "d364df7c-45ce-3182-b2ee-2f82680091a0",
                    "sense_definition": "Met de bedoeling dat; om te zorgen dat iets gebeurt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik spaar elke maand geld <zodat> ik later een huis kan kopen.",
                            "target_lang_translations": {
                                "en": "I save money every month <w>so that</w> I can buy a house later.",
                                "ru": "Я откладываю деньги каждый месяц, <w>чтобы</w> потом купить дом.",
                                "pl": "Co miesiąc oszczędzam pieniądze, <w>żeby</w> później móc kupić dom.",
                                "de": "Ich spare jeden Monat Geld, <w>damit</w> ich später ein Haus kaufen kann.",
                                "fr": "J'économise de l'argent chaque mois <w>pour que</w> je puisse acheter une maison plus tard.",
                                "it": "Risparmio denaro ogni mese <w>così da</w> poter comprare una casa più tardi.",
                                "cs": "Každý měsíc si šetřím peníze, <w>aby</w>ch si mohl později koupit dům.",
                                "tr": "Daha sonra ev alabilmek <w>için</w> her ay para biriktiriyorum.",
                                "es": "Ahorro dinero cada mes <w>para que</w> pueda comprar una casa más tarde.",
                                "zh": "我每个月都存钱，<w>为了</w>以后能买一套房子。"
                            }
                        },
                        {
                            "text": "Zij vertrok vroeg van huis <zodat> ze de eerste bus kon halen.",
                            "target_lang_translations": {
                                "en": "She left home early <w>so that</w> she could catch the first bus.",
                                "ru": "Она вышла из дома рано, <w>чтобы</w> успеть на первый автобус.",
                                "pl": "Wyszła wcześnie z domu, <w>żeby</w> zdążyć na pierwszy autobus.",
                                "de": "Sie ging früh aus dem Haus, <w>damit</w> sie den ersten Bus erwischen konnte.",
                                "fr": "Elle est partie tôt de la maison <w>afin qu'</w>elle puisse attraper le premier bus.",
                                "it": "È uscita di casa presto <w>affinché</w> potesse prendere il primo autobus.",
                                "cs": "Odešla z domu brzy, <w>aby</w> stihla první autobus.",
                                "tr": "İlk otobüsü yakalayabilsin <w>diye</w> evden erken çıktı.",
                                "es": "Salió de casa temprano <w>para que</w> pudiera tomar el primer autobús.",
                                "zh": "她很早就出门了，<w>以便</w>能赶上第一班公交车。"
                            }
                        }
                    ],
