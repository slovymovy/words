                ],
                "senses": [
                    {
                        "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                        "entry_id": "3ca75b31-220f-31fb-b38e-2f31965e2422",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0f77a19-ff95-4604-bff0-3243663386fb",
                                "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                                "text": "Frau Hellmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c73c3972-0c1b-4b80-a9e4-a4bc51f588bd",
                                "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                                "text": "Herr Hellmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7f23e1b5-25c6-497b-bf80-10df44e1cb51",
                                "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                                "text": "Die Hellmanns kommen heute aus dem Schwarzwald."
                            },
                            {
                                "example_id": "7265cdcd-104c-482f-bb6d-ad565b8fc616",
                                "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                                "text": "Der Hellmann trägt nie die Schals, die die Hellmann ihm strickt."
                            },
                            {
                                "example_id": "ffa77621-a864-41aa-8894-49c9d3b40833",
                                "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hellmann kommt, geht der Herr Hellmann.“"
                            },
                            {
                                "example_id": "ad39ce88-06e5-4793-946e-feff802c47c1",
                                "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                                "text": "Hellmann kommt und geht."
                            },
                            {
                                "example_id": "b6f9cdee-1aee-4a1f-a24a-04d89b8684e0",
                                "sense_id": "e0e22f75-bd78-3ca8-9adc-68bbd29b6dfb",
                                "text": "Hellmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
