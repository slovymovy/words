                                        "glosses": [
                                            "Adventurous, willing to take on or look for risks; overbold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4cd84d0-46e8-40ff-aae2-839f84cb67da",
                                                "sense_id": "5fd365f1-9201-33c5-b340-59e884185431",
                                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50efd6a-29aa-3fed-ae1c-4ae7fbf8d32f",
                                        "entry_id": "17f2f78f-b437-3a49-abe6-08d36a349d33",
                                        "glosses": [
                                            "Courageous or showing bravery; doughty."
                                        ],
                                        "tags": [],
                                        "examples": [
