                            },
                            {
                                "target_lang_word": "凶狠",
                                "target_lang_sense_clarification": "形容眼神或表情充满敌意"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "furioso",
                                "target_lang_sense_clarification": "que siente mucha ira o enojo"
                            },
                            {
                                "target_lang_word": "enfurecido",
                                "target_lang_sense_clarification": "que está en un estado de gran irritación"
                            }
                        ]
                    }
