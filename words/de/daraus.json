                    "semantic_group_id": "kausal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat einen großen Fehler gemacht, aber hoffentlich wird er <w>daraus</w> lernen."
                        },
                        {
                            "text": "Die Erklärung war ziemlich kompliziert, deshalb werde ich einfach nicht schlau <w>daraus</w>."
