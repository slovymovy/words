                                                "example_id": "157fe8d9-2287-4ad2-9424-dd983dc3715b",
                                                "sense_id": "21ef6f9c-ed36-393e-b2bc-66414c5f6551",
                                                "text": "Die Partei XY gerät nun in Zugzwang."
                                            }
