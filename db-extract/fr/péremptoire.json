        "fr-extract.jsonl": [
            {
                "entry_id": "beb24ab4-54cc-3937-a0bb-c6949728e34c",
                "word": "péremptoire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e69beacd-0cbf-4dac-a3f8-4c46a0ba263e",
                        "entry_id": "beb24ab4-54cc-3937-a0bb-c6949728e34c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "péremptoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "601bbf71-806d-3ac2-811f-53738f90aefe",
                        "entry_id": "beb24ab4-54cc-3937-a0bb-c6949728e34c",
                        "glosses": [
                            "Qui consiste dans la seule allégation de la péremption."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e80011a1-1f93-3c13-8035-eb96433a339d",
                        "entry_id": "beb24ab4-54cc-3937-a0bb-c6949728e34c",
                        "glosses": [
                            "Qui est décisif ; contre quoi il n’y a rien à alléguer ou à répliquer."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "394aba3f-3f7d-4f8e-ae7a-0963c6ddd8d6",
                                "sense_id": "e80011a1-1f93-3c13-8035-eb96433a339d",
                                "text": "On ne sait trop pourquoi Hulot a voulu contester l’existence du premier, qui semble pourtant établie d'une manière péremptoire par l'histoire."
                            },
                            {
                                "example_id": "6577fac2-94b6-40de-9f45-b8a4f2e64667",
                                "sense_id": "e80011a1-1f93-3c13-8035-eb96433a339d",
                                "text": "« Monsieur le maréchal, continua Capestang, vous voulez faire de moi un assassin à gages. Et cela demande une réponse péremptoire. La voici ! » Et, à toute volée, il jeta son gant comme un soufflet."
                            },
                            {
                                "example_id": "326c8665-e161-4cdf-bf6f-28688038efa4",
                                "sense_id": "e80011a1-1f93-3c13-8035-eb96433a339d",
                                "text": "– Ce que je dis est appuyé sur des raisons péremptoires."
                            },
                            {
                                "example_id": "11b3a136-054f-4852-af93-aef8c9b6ab4c",
                                "sense_id": "e80011a1-1f93-3c13-8035-eb96433a339d",
                                "text": "« Ici, tu as peur, lui dit-il, et cependant je connais ton courage. Quelquefois même je l’ai senti. Il faut donc que ta peur ait des raisons péremptoires, et ces raisons péremptoires, c’est que tu as simplement peur d’une mort inutile. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "aadd813c-4308-30b0-9e3f-3452f65fea2c",
                        "entry_id": "beb24ab4-54cc-3937-a0bb-c6949728e34c",
                        "glosses": [
                            "Qui affirme ses opinions sans autres considérations, sans réplique possible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6836779-f4bf-4323-93ce-4262946aea21",
                                "sense_id": "aadd813c-4308-30b0-9e3f-3452f65fea2c",
                                "text": "Je suppose que vos raisons doivent être péremptoires, et il se pourrait que je puisse vous être utile."
                            },
                            {
                                "example_id": "69b0a7c9-ad6d-4436-8089-03bea952ad60",
                                "sense_id": "aadd813c-4308-30b0-9e3f-3452f65fea2c",
                                "text": "Le ton péremptoire et l’expression allusive me glacèrent. J’eus le pressentiment d'une discussion immédiate et violente."
                            },
                            {
                                "example_id": "dc418583-af33-4cb5-abdb-c92be78880e6",
                                "sense_id": "aadd813c-4308-30b0-9e3f-3452f65fea2c",
                                "text": "Pour bien des raisons, les sociétés de l’ennui ont besoin de l’art et de la culture, qu’elles séparent de façon péremptoire du travail et de la production."
                            },
                            {
                                "example_id": "c9dfadf0-c889-4b1c-9e22-801222623b84",
                                "sense_id": "aadd813c-4308-30b0-9e3f-3452f65fea2c",
                                "text": "Aujourd'hui, plus de six mois après son décès, Sandrine Audic en veut “aux producteurs de Hold-Up”, ainsi qu'à Didier Raoult, qui “n'avait pas à asséner des messages péremptoires”."
                            },
                            {
                                "example_id": "2c47cffc-e913-4f82-849f-896c95c03fb7",
                                "sense_id": "aadd813c-4308-30b0-9e3f-3452f65fea2c",
                                "text": "C’est pareillement pour des raisons de discrétion visant à éviter le décisif, le catégorique, le péremptoire qu’on aura recours, dans le cas de certains rapports sociaux, à l’imparfait perspectif tenant lieu généralement d’un prétérit indéfini estimé trop conclusif."
                            },
                            {
                                "example_id": "db445c0c-b15e-490d-b232-ab42502f3ef1",
                                "sense_id": "aadd813c-4308-30b0-9e3f-3452f65fea2c",
                                "text": "Les plaques et le sol, ça se croise pas, c'est parallèle. Si vous voulez du perpendiculaire, vous avez le sol et les tréteaux, par exemple. Et si je vous dis que vous êtes deux glands, là vous avez du péremptoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4636e96f-4a30-438d-9699-6a6be1e7c159",
                        "source_entry_id": "beb24ab4-54cc-3937-a0bb-c6949728e34c",
                        "target_lang_word": "besserwisserisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besserwisserisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                        "entry_id": "23cb9dd8-bb44-31b8-8c4e-c98da3d58706",
                                        "glosses": [
                                            "seine persönliche Meinung so nach außen zeigend, als glaube man, nur selber recht zu haben"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e241c9-3ddb-495e-9222-3387a7a56dcf",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "Bei den eigenen Kindern kommt der besserwisserische Satz „Siehste, ich hab's Dir ja gleich gesagt“ \"besonders\" gut an."
                                            },
                                            {
                                                "example_id": "d877a994-f051-4bbe-ae5e-8537a22893a5",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "„Zu dominant. Zu belehrend. Zu ungeduldig. Besserwisserisch, gefühllos und egozentrisch werden ‚die Deutschen‘ derzeit nicht nur in den südeuropäischen Ländern wie Griechenland, Italien und Spanien empfunden. Es sind Negativeindrücke, die beinahe weltweit gelten.“"
                                            },
                                            {
                                                "example_id": "77225b0f-8e96-45e4-a47e-a66950d326e9",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "Frauen, die sich in den Mittelpunkt stellen, gelten immer noch schnell als besserwisserisch und wenig weiblich."
                                            },
                                            {
                                                "example_id": "fb0b74b5-0b0b-4e78-a004-56363ff1e5e4",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "Wir müssen uns nur klarer positionieren, weniger besserwisserisch, mehr weltoffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4139e8ba-d60f-4d3c-a4d1-04c416dc4215",
                        "source_entry_id": "beb24ab4-54cc-3937-a0bb-c6949728e34c",
                        "target_lang_word": "peremptory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peremptory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2ae84c-094b-31ab-9452-48ef585d1fd1",
                                        "entry_id": "1502bf3f-d2e0-37d6-8bd9-2123c507593b",
                                        "glosses": [
                                            "Precluding debate or expostulation; not admitting of question or appeal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e56b71c-9750-4616-a884-87ac6ff1d6a6",
                                                "sense_id": "4e2ae84c-094b-31ab-9452-48ef585d1fd1",
                                                "text": "there is no reason but if any of the outlawries be indeed without error, but it should be a peremptory plea to the person in a writ of error, as well as in any other action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24f1629-054e-3f30-ad7b-729e59bf8df1",
                                        "entry_id": "1502bf3f-d2e0-37d6-8bd9-2123c507593b",
                                        "glosses": [
                                            "(of a date or deadline) Absolutely requiring compliance or attendance; brooking no further delay; to proceed whether a party attends or not; final."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3723070-bb13-4d0b-9b92-919f178bc186",
                                                "sense_id": "b24f1629-054e-3f30-ad7b-729e59bf8df1",
                                                "text": "As this trial has now been postponed multiple times, there will be an adjournment to April 24, peremptory on the parties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f756118-e91d-3e81-9c37-d8bc852488bd",
                                        "entry_id": "1502bf3f-d2e0-37d6-8bd9-2123c507593b",
                                        "glosses": [
                                            "Positive in opinion or judgment; absolutely certain, overconfident, unwilling to hear any debate or argument (especially in a pejorative sense); dogmatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f709c5-21dc-410d-9014-ae5163d8a2e7",
                                                "sense_id": "9f756118-e91d-3e81-9c37-d8bc852488bd",
                                                "text": "He marched under a placard reading \"End Bossiness Now\" but decided it was a little too peremptory, not quite British, so changed the slogan on subsequent badges, to \"End Bossiness Soon.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6081136-cfe7-31b7-8e45-f39aa0bf4a10",
                                        "entry_id": "1502bf3f-d2e0-37d6-8bd9-2123c507593b",
                                        "glosses": [
                                            "Firmly determined, resolute; obstinate, stubborn."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d996cb75-8a56-3ada-bae2-d5b01cbc05a3",
                                        "entry_id": "1502bf3f-d2e0-37d6-8bd9-2123c507593b",
                                        "glosses": [
                                            "Accepting no refusal or disagreement; imperious, dictatorial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f2f5892-f2ac-4507-85cc-cf5cb657f2c9",
                                                "sense_id": "d996cb75-8a56-3ada-bae2-d5b01cbc05a3",
                                                "text": "Upon the other hand, there are a great many people who, having no private property of their own, and being always on the brink of sheer starvation, are compelled to do the work of beasts of burden, to do work that is quite uncongenial to them, and to which they are forced by the peremptory, unreasonable, degrading Tyranny of want."
                                            },
                                            {
                                                "example_id": "f4d6b0fc-e155-4e5b-9152-d9c009ba1660",
                                                "sense_id": "d996cb75-8a56-3ada-bae2-d5b01cbc05a3",
                                                "text": "[…] less surprising than that he had been depressed by a book. Something was making him nibble at the edge of stale ideas as if his sturdy physical egotism no longer nourished his peremptory heart."
                                            },
                                            {
                                                "example_id": "147867f4-1688-401c-a4c3-b1d07e34513b",
                                                "sense_id": "d996cb75-8a56-3ada-bae2-d5b01cbc05a3",
                                                "text": "Though today (surveying that yellowing document) I shudder at the peremptory tone of the instructions I gave, Alastair - in that same volume in which I get chastised for my coverage of the Macmillan rally - was generous enough to remark that my memorandum became 'an office classic'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peremptory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "742ecfc9-a8e0-335b-97bc-71432dcc1801",
                                        "entry_id": "572e68e8-54d2-30cc-b55f-27b0b6c955d6",
                                        "glosses": [
                                            "A challenge to the admission of a juror, without the challenger needing to show good cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6278e4f7-2d78-40e6-aa02-6016726ccaa9",
                                                "sense_id": "742ecfc9-a8e0-335b-97bc-71432dcc1801",
                                                "text": "Each side was allowed 20 peremptories, and the prosecution used 18 of its allotment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
