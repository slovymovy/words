                                        "sense_id": "9a7d1f6d-3c68-3698-b8cf-2e9bcb99e2d8",
                                        "entry_id": "da637c96-30df-3502-bcff-ed01c194d476",
                                        "glosses": [
                                            "een lens of lenzenstelsel in een optisch instrument dat naar het oog van de kijker gericht is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54b8994d-74f6-400c-8447-2a5a05af860e",
                                                "sense_id": "9a7d1f6d-3c68-3698-b8cf-2e9bcb99e2d8",
                                                "text": "Het oculair mag wel eens schoongemaakt worden!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d35e437-6ea2-4eb1-915d-ee61ba99e42d",
                        "source_entry_id": "2e31534e-52d4-3c05-980a-cf4c29e2f037",
                        "source_sense_id": "1a261461-0dd4-359b-b39f-a6a69ae3a591",
                        "target_lang_word": "Okular",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okular",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc628ec-00ad-3f6c-9016-9facc9972328",
                                        "entry_id": "db8f7f57-2879-3d90-931a-24493bda4866",
                                        "glosses": [
                                            "bei optischen Geräten jene Linse, die dem Auge zugewandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e38b6b-b229-45a3-bf72-4309d8f5d900",
                                                "sense_id": "6cc628ec-00ad-3f6c-9016-9facc9972328",
                                                "text": "Das Okular kann durch eine zusätzliche Gummimuschel an das Auge angepasst werden."
                                            },
                                            {
                                                "example_id": "59bdef3f-74f4-4725-a4a8-7b396d687b1a",
                                                "sense_id": "6cc628ec-00ad-3f6c-9016-9facc9972328",
                                                "text": "„Durch die Okulare sah er eine dunkel gekleidete Frau mit breitrandigem Filzhut, unter dem das graue Haar hervorquoll.“"
                                            },
                                            {
                                                "example_id": "bbbef84f-6348-41cb-ad5d-fbba894fdd77",
                                                "sense_id": "6cc628ec-00ad-3f6c-9016-9facc9972328",
                                                "text": "„Er drehte sich nicht nach den beiden um, sondern starrte gebannt unter der Kante seines Schirms hindurch auf das Nest, justierte für alle Fälle noch einmal das Okular.“"
                                            },
                                            {
                                                "example_id": "255bb0bd-423e-486a-8c5f-f5bdb96841a4",
                                                "sense_id": "6cc628ec-00ad-3f6c-9016-9facc9972328",
                                                "text": "„Pettenkofer hing am Okular.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12310c5b-8b06-4ae6-81ce-4896fb92b1d9",
                        "source_entry_id": "2e31534e-52d4-3c05-980a-cf4c29e2f037",
                        "source_sense_id": "1a261461-0dd4-359b-b39f-a6a69ae3a591",
                        "target_lang_word": "окуляр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "окуляр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "316367fc-f33a-32b2-bb2d-da1453354dd6",
                                        "entry_id": "f66df961-f976-3fe4-b5fd-d35419ad9f1e",
                                        "glosses": [
                                            "часть оптического прибора, состоящая из системы линз и обращённая к глазу наблюдателя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d245bb6b-3587-49b7-ac98-673688581901",
                                                "sense_id": "316367fc-f33a-32b2-bb2d-da1453354dd6",
                                                "text": "— Очень хорошо, — сказал Персиков и припал глазом к окуляру микроскопа."
                                            },
                                            {
                                                "example_id": "0cbaafa3-71f5-431f-8618-656c80cfe830",
                                                "sense_id": "316367fc-f33a-32b2-bb2d-da1453354dd6",
                                                "text": "Пассажиры молча трудятся у правого борта, щёлкают фотоаппаратами, торопливо ловят набегающий берег в окуляры биноклей и дымчатых очков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8a0418-8522-336c-8681-8ce6d6b07401",
                                        "entry_id": "f66df961-f976-3fe4-b5fd-d35419ad9f1e",
                                        "glosses": [
                                            "разг., мн. ч. то же, что очки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f159ca9-0d01-4d3d-ad0e-dd9abf99c517",
                                                "sense_id": "8f8a0418-8522-336c-8681-8ce6d6b07401",
                                                "text": "Скажи, пожалуйста, даже совсем никак глаз её не видно за тёмными окулярами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
