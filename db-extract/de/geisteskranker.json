                ],
                "senses": [
                    {
                        "sense_id": "f4401397-88d8-3e7d-a923-2f15399e3047",
                        "entry_id": "75033397-6ef3-36b4-89c8-78f62d0a2162",
                        "glosses": [
                            "jemand, der geisteskrank ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d0e421-aa83-42c0-8b2e-ecd9478aa545",
                                "sense_id": "f4401397-88d8-3e7d-a923-2f15399e3047",
                                "text": "„Alle, der Graf selbst, sein Kutscher und die Dragoner seiner Eskorte, sahen auf die freigelassenen Geisteskranken und besonders den, der auf sie zurannte, mit einer unklaren Empfindung des Schreckens und der Neugier.“"
                            },
                            {
                                "example_id": "6a6c1f2f-51a7-45a8-aeaf-b332a48c82cb",
                                "sense_id": "f4401397-88d8-3e7d-a923-2f15399e3047",
                                "text": "„Da gibt es die Anekdote vom Geisteskranken, der sich für einen Hund hielt und nach seiner Entlassung gefragt wird, wie er sich jetzt fühle.“"
                            },
                            {
                                "example_id": "c79274f9-ee75-4b7d-a848-b1786adbca41",
                                "sense_id": "f4401397-88d8-3e7d-a923-2f15399e3047",
                                "text": "„Im Jahr 1917 wird Franz Jung – er hat mit Erfolg den Geisteskranken gespielt – aus der Haft entlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
