                "senses": [
                    {
                        "sense_id": "087250a9-3c09-3296-b53b-6e6a4d868767",
                        "entry_id": "c36beb7e-693a-3005-b21e-8251dc9a9ba8",
                        "glosses": [
                            "страдающий психическим заболеванием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced547b2-01c8-4879-9a2c-2ae27fd3b21f",
                                "sense_id": "087250a9-3c09-3296-b53b-6e6a4d868767",
                                "text": "В душевнобольных людях того времени видели одержимых злым духом или же святых."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90955ef5-b91a-4b67-afc9-93b5f4f3c808",
                        "source_entry_id": "c36beb7e-693a-3005-b21e-8251dc9a9ba8",
                        "source_sense_id": "087250a9-3c09-3296-b53b-6e6a4d868767",
                        "target_lang_word": "geisteskrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geisteskrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1515473-de53-31fd-87cb-fb6beffe7127",
                                        "entry_id": "282e3285-81f1-3a0f-b372-32906e0aa00b",
                                        "glosses": [
                                            "geistig behindert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af7123f6-f0b6-4418-ad51-73dc3ba10e58",
                                                "sense_id": "e1515473-de53-31fd-87cb-fb6beffe7127",
                                                "text": "Im Zentrum der Komödie »Die Physiker« stehen drei Physiker, die sich als geisteskrank ausgeben."
                                            },
                                            {
                                                "example_id": "87a54be4-28f3-49ad-bc21-220c8211095a",
                                                "sense_id": "e1515473-de53-31fd-87cb-fb6beffe7127",
                                                "text": "Die Bezeichnung von geistig behinderten Menschen als geisteskrank wird meist eher abfällig und herabwürdigend benutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dab621a-96b5-35dc-8be1-eab415aa8c05",
                                        "entry_id": "282e3285-81f1-3a0f-b372-32906e0aa00b",
                                        "glosses": [
                                            "sehr wütend, vorübergehend emotional fehlgeleitet, psychotisch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2166fc2f-a190-412f-a401-06992ea182d7",
                                                "sense_id": "9dab621a-96b5-35dc-8be1-eab415aa8c05",
                                                "text": "Er reagierte bei diesem Wutausbruch völlig geisteskrank und warf zahlreiche Gegenstände an die Wand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
