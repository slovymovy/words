                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>separated</w> the students into small groups for the project.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>разделил</w> учеников на небольшие группы для проекта.",
                                "zh": "老师把学生们<w>分</w>成了几个小组来做项目。"
                            }
                        },
                        {
                            "text": "We <w>separated</w> the recycling into glass, paper, and plastic.",
                            "target_lang_translations": {
                                "ru": "Мы <w>разделили</w> отходы для переработки на стекло, бумагу и пластик.",
                                "zh": "我们把可回收物按玻璃、纸张和塑料进行了<w>分类</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
