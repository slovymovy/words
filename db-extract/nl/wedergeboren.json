                        "examples": [
                            {
                                "example_id": "91782b9c-8e3f-40a9-89b5-19c0173c76c0",
                                "sense_id": "7072ec08-ed01-39d4-a517-cbc17abd0b47",
                                "text": "Slechts de wisselvalligheden van het leven kunnen ons de ijdelheid ervan tonen, en kunnen onze aangeboren liefde voor de dood of de wedergeboorte tot een nieuw leven bevorderen."
                            }
                        ]
                    },
