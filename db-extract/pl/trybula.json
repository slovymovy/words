                "senses": [
                    {
                        "sense_id": "b3ba03c6-4228-390e-9826-dbdfdefdb46e",
                        "entry_id": "0474aa23-8013-36b3-9079-074d5faa106c",
                        "glosses": [
                            "Anthriscus, rodzaj roślin należący do rodziny selerowatych, o wiotkich, pierzastych liściach przypominających nać pietruszki, o zapachu anyżku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f2b888b-b474-457f-a821-0a2039949087",
                                "sense_id": "b3ba03c6-4228-390e-9826-dbdfdefdb46e",
                                "text": "Trybula oczyszcza krew oraz wzmacnia odporność"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71102cb8-54bb-4361-84d3-db9f6a1596ce",
                        "source_entry_id": "0474aa23-8013-36b3-9079-074d5faa106c",
                        "source_sense_id": "b3ba03c6-4228-390e-9826-dbdfdefdb46e",
                        "target_lang_word": "chervil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chervil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66c15510-7297-3825-b39c-2d4630db4748",
                                        "entry_id": "7012b154-f3b5-3993-a1d1-7768f9d81013",
                                        "glosses": [
                                            "A leafy herb, Anthriscus cerefolium, resembling parsley."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b65ec751-90e4-4bd4-8bb1-3e877a11b34f",
                                                "sense_id": "66c15510-7297-3825-b39c-2d4630db4748",
                                                "text": "The life of one plant would be affected by another. Rue was definitely hostile to basil, rosemary to hyssop, but coriander, dill and chervil lived on the friendliest of terms[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ace4594-4ac9-3fa8-9d42-6a6a92ee18e9",
                                        "entry_id": "7012b154-f3b5-3993-a1d1-7768f9d81013",
                                        "glosses": [
                                            "Leaves from the plant, used as an herb in cooking, which have a mild flavor of anise."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c68cfb8b-b84e-4ae0-bc90-f5f1b35de37c",
                                                "sense_id": "5ace4594-4ac9-3fa8-9d42-6a6a92ee18e9",
                                                "text": "No herb, except perhaps tarragon, is quite so French as chervil, an association that is not surprising for a nation known for its celebration of fine food and the subtle use of herbs."
                                            },
                                            {
                                                "example_id": "c09327a4-194b-4f10-81d7-60ebbc059b6c",
                                                "sense_id": "5ace4594-4ac9-3fa8-9d42-6a6a92ee18e9",
                                                "text": "Cook fresh chervil leaves very little, if at all. They are best when added to a dish after it has been cooked, or toward the end of the cooking time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d470815-877f-43f5-ba7c-353d7f219814",
                        "source_entry_id": "0474aa23-8013-36b3-9079-074d5faa106c",
                        "source_sense_id": "b3ba03c6-4228-390e-9826-dbdfdefdb46e",
                        "target_lang_word": "Kerbel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerbel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb62f14-9de1-310a-ac5e-a0ab033d2f99",
                                        "entry_id": "3a812a72-059e-30e3-a9fb-edb2e78d6d4d",
                                        "glosses": [
                                            "Ein Gewürzkraut mit gefiederten Blättern und Blüten in weißen Dolden (echter Kerbel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "515afec4-d940-4bbe-a92a-8ebdee1c56c2",
                                                "sense_id": "5cb62f14-9de1-310a-ac5e-a0ab033d2f99",
                                                "text": "„Eine erbärmliche, dünne Suppe aus Sauerampfer, Kerbel, Löwenzahn und vielen Wiesenkräutern hatte Frau Hellbricht zum Essen vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
