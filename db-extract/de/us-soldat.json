                    {
                        "sense_id": "1d5ee7cb-bf96-303d-8f51-b09b3463f7a3",
                        "entry_id": "d4e827cf-e1d9-3518-b736-9f5d118cafe8",
                        "glosses": [
                            "Angehöriger der Streitkräfte der Vereinigten Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9697b4ef-927f-4bb4-8489-560fb2e0c228",
                                "sense_id": "1d5ee7cb-bf96-303d-8f51-b09b3463f7a3",
                                "text": "„Der US-Soldat Eddi Slovik wird von einem Kriegsgericht wegen Fahnenflucht zum Tode verurteilt und am 31. Januar 1945 erschossen.“"
                            },
                            {
                                "example_id": "00bb045c-8925-4973-9fb4-e67291e49ef2",
                                "sense_id": "1d5ee7cb-bf96-303d-8f51-b09b3463f7a3",
                                "text": "„Spielkarten mit Bildern wichtiger archäologischer Denkmäler und einfachen Verhaltensregeln sollen ab sofort bei US-Soldaten das Bewusstsein für den Denkmalschutz schärfen.“"
                            },
                            {
                                "example_id": "7f555669-2e2a-4dc6-af86-c9c0d4f82519",
                                "sense_id": "1d5ee7cb-bf96-303d-8f51-b09b3463f7a3",
                                "text": "„Nach kurzer Fahrt kamen sie an einen Kontrollpunkt, der mit zwei US-Soldaten besetzt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
