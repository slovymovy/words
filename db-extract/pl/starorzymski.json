                ],
                "translations": [
                    {
                        "translation_id": "2513c8a2-8a17-479a-9189-d7725fa3b675",
                        "source_entry_id": "9f9bcf55-ebfe-37d0-829b-c6d8f447f16f",
                        "source_sense_id": "47a9a7ec-242a-3343-aba6-14f42dbfaca8",
                        "target_lang_word": "altrömisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altrömisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb45557-e618-3364-9e55-da01cbada0aa",
                                        "entry_id": "b26023be-8b23-38eb-b760-a3df2e21ab93",
                                        "glosses": [
                                            "das Rom, das römische Reich der Antike betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00aa2ac7-c7ee-410a-a33e-9a04a2f866c4",
                                                "sense_id": "6bb45557-e618-3364-9e55-da01cbada0aa",
                                                "text": "Bei den Städten gilt eine altrömische Gründung als die hochkarätigste; …"
                                            },
                                            {
                                                "example_id": "0c52f46e-2309-400e-aee0-46d78712e623",
                                                "sense_id": "6bb45557-e618-3364-9e55-da01cbada0aa",
                                                "text": "Zweitens gilt unabänderlich der altrömische Rechtssatz: \"Ultra posse nemo obligatur\" – über das hinaus, was er zu leisten vermag, ist niemand verpflichtet."
                                            },
                                            {
                                                "example_id": "f77aeb64-a2c8-48ea-8ea8-a796d512d02e",
                                                "sense_id": "6bb45557-e618-3364-9e55-da01cbada0aa",
                                                "text": "Schon bald wurde der altrömische Trachtenverein eingeladen, bei Festen und Straßenumzügen mitzuwirken."
                                            },
                                            {
                                                "example_id": "78dd44a1-03f1-47a8-917d-1da40a4b00ee",
                                                "sense_id": "6bb45557-e618-3364-9e55-da01cbada0aa",
                                                "text": "So war bis vor Kurzem unklar, was genau den altrömischen Beton physikalisch und chemisch so widerstandsfähig macht."
                                            },
                                            {
                                                "example_id": "2716eda2-be75-48b8-8c66-c708b625072a",
                                                "sense_id": "6bb45557-e618-3364-9e55-da01cbada0aa",
                                                "text": "Vulkan-Asche ist womöglich die wichtigste Zutat in der altrömischen Beton-Rezeptur."
                                            },
                                            {
                                                "example_id": "eb764461-212f-4a9e-b712-a1d63b2acf72",
                                                "sense_id": "6bb45557-e618-3364-9e55-da01cbada0aa",
                                                "text": "Und dieses begnadete Fleckchen Erde becircte schon altrömische Kaiser: Nicht ohne Grund tauschte Augustus die Nachbarinsel Ischia gegen Capri ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee95edc0-6f82-4727-a3de-e8b1804b4da0",
