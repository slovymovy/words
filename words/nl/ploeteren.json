                            },
                            {
                                "target_lang_word": "to slog",
                                "target_lang_sense_clarification": "working hard at something tedious"
                            },
                            {
                                "target_lang_word": "to drudge",
                                "target_lang_sense_clarification": "doing hard, menial, or monotonous work"
                            },
                            {
