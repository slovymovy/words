                "senses": [
                    {
                        "sense_id": "b1d0507d-837f-3f9b-8f8c-735a45bc1322",
                        "entry_id": "e0d93106-b188-3c8e-a331-5253d10bcf3f",
                        "glosses": [
                            "durch Schießen in ein Material entstandene Vertiefung oder Durchbruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f52676-dc4d-4677-99ba-038e8edc7ec6",
                                "sense_id": "b1d0507d-837f-3f9b-8f8c-735a45bc1322",
                                "text": "„Auf einem Parkplatz der Polizei rosten Autos mit Einschusslöchern und zerborstenen Windschutzscheiben, ein Vorhof zu den Gräberfeldern der Stadt: Fahrzeuge, die in den vergangenen Monaten an Tatorten sichergestellt worden sind.“"
                            },
                            {
                                "example_id": "e80ae0cd-8cf1-4ab5-8ab9-2399c8224448",
                                "sense_id": "b1d0507d-837f-3f9b-8f8c-735a45bc1322",
                                "text": "„Vergeblich suchte er das Einschussloch im Bretterzaun und das Projektil.“"
                            },
                            {
                                "example_id": "7cd219ed-7305-4041-b28b-477c6fa03f63",
                                "sense_id": "b1d0507d-837f-3f9b-8f8c-735a45bc1322",
                                "text": "„Zum Teil bildeten die Einschusslöcher im Karosserieblech regelmäßige, lineare Muster, was ihm verriet, dass sie von automatischen Waffen stammten.“"
                            },
                            {
                                "example_id": "c2c640a0-552f-493c-9e71-1795aa815e82",
                                "sense_id": "b1d0507d-837f-3f9b-8f8c-735a45bc1322",
                                "text": "„Blut und Eiter rinnen aus dem Einschussloch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
