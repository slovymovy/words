                                        "glosses": [
                                            "met het ritme van een jambe, een versvoet van een onbeklemtoonde lettergreep, gevolgd door een beklemtoonde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80a8057-bb67-480d-a06f-510f5825a873",
                                                "sense_id": "f8c9d81f-3c63-3026-8ac4-bd66776f8cff",
                                                "text": "De gedichten zijn, behoudens een enkele uitzondering, opgebouwd uit drie strofen en het aantal gedichten met een ononderbroken jambisch ritme is wel erg hoog. Ondanks het hoogstaande onderwerp maakt dit ze toch voorspelbaar en uiteindelijk enigszins teleurstellend."
                                            },
                                            {
                                                "example_id": "48e68830-1781-4d14-b51e-2fa01914bb70",
                                                "sense_id": "f8c9d81f-3c63-3026-8ac4-bd66776f8cff",
                                                "text": "Plots weet een meisje op de achterste rij het. Ze komt naar voren en zet met een rode stift streepjes onder ”welk”, ”len”, ”um” en ”telt”. Conclusie: een jambisch metrum."
                                            }
                                        ]
                                    }
                                ]
