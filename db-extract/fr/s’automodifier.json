                    {
                        "sense_id": "e2203c56-753d-35f7-a3df-e9dfef814306",
                        "entry_id": "374d5d20-0197-3552-a87e-d25db131d91b",
                        "glosses": [
                            "Se modifier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a62d3c60-0b94-457f-90d2-e49cdb66ed02",
                                "sense_id": "e2203c56-753d-35f7-a3df-e9dfef814306",
                                "text": "Le code ne peut donc pas s'automodifier."
                            },
                            {
                                "example_id": "b6fb4676-a025-475f-9f62-70dc2370872a",
                                "sense_id": "e2203c56-753d-35f7-a3df-e9dfef814306",
                                "text": "Ils travaillaient tous les deux sur une nouvelle technique de métaprogrammation, un nouveau type de logiciel capable de s'automodifier."
                            },
                            {
                                "example_id": "e1423f65-1cd2-40de-9206-86ceaba67568",
                                "sense_id": "e2203c56-753d-35f7-a3df-e9dfef814306",
                                "text": "Les virus sont de plus en plus évolués, ils peuvent s'automodifier pour échapper à une éventuelle détection (virus polymorphes)."
                            }
                        ]
                    }
