                        "form": "консекве́нтна"
                    },
                    {
                        "form_id": "71bc7e11-4f69-407d-afcc-bc0f2ea4f535",
                        "entry_id": "f50e94fd-7ea9-3eac-98f6-1cd7f0e46d32",
                        "tags": [
                            "plural",
