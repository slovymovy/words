        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4504c8d-2c9e-32af-a54d-bd394f15fc9c",
                    "sense_definition": "Нечто иное, отличающееся от уже названного или известного.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Говорить — это одно, а делать — совсем <w>другое</w>.",
                            "target_lang_translations": {
                                "en": "Talking is one thing, but doing is quite <w>another</w>.",
                                "zh": "说是这么说，做起来又是<w>另一回事</w>。"
                            }
                        },
                        {
                            "text": "Он обещал одно, а сделал <w>другое</w>.",
                            "target_lang_translations": {
                                "en": "He promised one thing, but did <w>something else</w>.",
                                "zh": "他答应的是一回事，做的却是<w>别的东西</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "иное"
                    ],
                    "common_phrases": [
