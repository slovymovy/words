                "senses": [
                    {
                        "sense_id": "0e0f3253-f53a-39e4-b499-3cefb701bee3",
                        "entry_id": "d07b70e6-c38b-340b-b28d-be52b7344e2a",
                        "glosses": [
                            "so, dass es erschrecken kann"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "096c4b4c-370c-488a-aba1-438bac4aed68",
                                "sense_id": "0e0f3253-f53a-39e4-b499-3cefb701bee3",
                                "text": "„Das liest sich fürwahr fürchterbar: Eine Geisterlichtparade, Gruselgeschichten mit der Waldhexe, Geisterkegeln, ein schauriger Wald der Finsternis …“"
                            },
                            {
                                "example_id": "27c168c5-f552-4697-8045-8f01687aa6bb",
                                "sense_id": "0e0f3253-f53a-39e4-b499-3cefb701bee3",
                                "text": "„Sie kreischten und brüllten so »fürchterbar«, dass einem noch immer der kalte Schauer über den Rücken läuft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
