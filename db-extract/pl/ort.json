                ],
                "senses": [
                    {
                        "sense_id": "c66fad33-725e-35af-a37b-e1127beab19f",
                        "entry_id": "cd10ba69-687d-36f8-aa74-bdf31b6d4768",
                        "glosses": [
                            "srebrny pieniądz europejski będący w obiegu w XVI–XVIII wieku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f114b0-a5db-44ab-a4c1-c6c49391080c",
                                "sense_id": "c66fad33-725e-35af-a37b-e1127beab19f",
                                "text": "Słowo ort w języku staroniemieckim na obszarach Nadrenii, północnych Niemiec i Skandynawii oznaczało czwartą część jakiejś całości, a w obiegu pieniężnym ćwierć talara"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "07b31d83-a612-367e-b352-7a1686e0e493",
                        "entry_id": "cd10ba69-687d-36f8-aa74-bdf31b6d4768",
                        "glosses": [
                            "typ poziomego chodnika w górnictwie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "389bd383-5e73-43da-8625-6ee3cc782fb1",
                        "source_entry_id": "cd10ba69-687d-36f8-aa74-bdf31b6d4768",
                        "source_sense_id": "c66fad33-725e-35af-a37b-e1127beab19f",
                        "target_lang_word": "Ort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c1e1a1a-a519-37b6-9436-fef771f1e479",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "lokalisierbarer, begrenzter Platz, definierte Stelle (punktförmig oder ausgedehnt) auf einer Fläche oder im Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada4bf01-521d-4266-9187-c2e58c9dc890",
                                                "sense_id": "9c1e1a1a-a519-37b6-9436-fef771f1e479",
                                                "text": "„Denn man bemerkt leicht, daß darin etwas schon vorausgesetzt werde, was nicht durch Erfahrung bekannt ist, sondern vielleicht auf eingebildeten Schlüssen beruht: nämlich daß mein denkendes Ich in einem Orte sei, der von den Örtern anderer Theile desjenigen Körpers, der zu meinem Selbst gehört, unterschieden wäre.“"
                                            },
                                            {
                                                "example_id": "5e7bdcdf-9bb2-4498-ba47-affc81c35182",
                                                "sense_id": "9c1e1a1a-a519-37b6-9436-fef771f1e479",
                                                "text": "Punkt A1 liegt am angegebenen Ort auf der Linie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "12e678af-a3e7-3632-8582-0b90720d53a9",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "geografisch definierte Siedlung"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "062b2197-a5d5-4bf1-bbee-967503e72928",
                                                "sense_id": "12e678af-a3e7-3632-8582-0b90720d53a9",
                                                "text": "Im nächsten Ort gibt es bestimmt ein Gasthaus."
                                            },
                                            {
                                                "example_id": "cca91975-e068-43e6-bb7f-dfa3acdaa3ee",
                                                "sense_id": "12e678af-a3e7-3632-8582-0b90720d53a9",
                                                "text": "„An Orten ohne Sehenswürdigkeiten kann das Reisen neu beginnen.“"
                                            },
                                            {
                                                "example_id": "6344f1d1-877c-4332-9baa-deab93a9edd9",
                                                "sense_id": "12e678af-a3e7-3632-8582-0b90720d53a9",
                                                "text": "„Dieses oberhalb des Ortes gelegene Gästehaus war früher einmal eine Jugendherberge.“"
                                            },
                                            {
                                                "example_id": "57db9b1f-4ff5-4fdf-ba6c-21ee00602954",
                                                "sense_id": "12e678af-a3e7-3632-8582-0b90720d53a9",
                                                "text": "„Am Moselufer standen viele Häuser dicht nebeneinander, und vom Ufer aus führten dann viele schmale Gassen von der Uferstraße aus in den Ort.“"
                                            },
                                            {
                                                "example_id": "6f36660c-2101-4a7e-8bb9-fb5dc8849f28",
                                                "sense_id": "12e678af-a3e7-3632-8582-0b90720d53a9",
                                                "text": "„Sie schickte mich einfach mit einem Zettel, etwas Geld und jeder Menge Gesten, die ich erst nach einer Weile verstand, zu dem kleinen Lebensmittelladen im Ort, um neues Mehl zu besorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7aa1f9d5-2bee-3342-ad13-d536fbe2d206",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "die Bevölkerung von ^([2])"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83102c43-e8b6-4d57-bf5c-0954883a9a34",
                                                "sense_id": "7aa1f9d5-2bee-3342-ad13-d536fbe2d206",
                                                "text": "Der ganze Ort war auf den Beinen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d5b23a0e-ec20-3a0d-bf59-ac5428d6cd08",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "Stadtstaat, Land, der beziehungsweise das der Alten Eidgenossenschaft angehörte oder aber mit dieser verbündet war"
                                        ],
                                        "tags": [
                                            "Plural 1",
                                            "auch n"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba16da47-9f36-4e81-9165-a25df0ff148b",
                                                "sense_id": "d5b23a0e-ec20-3a0d-bf59-ac5428d6cd08",
                                                "text": "Die Alte Eidgenossenschaft bestand von 1353 bis 1481 aus den Acht Alten Orten und von 1513 bis 1798 aus den Dreizehn Alten Orten."
                                            },
                                            {
                                                "example_id": "b5a7cf93-685e-4511-a192-7259bda10be4",
                                                "sense_id": "d5b23a0e-ec20-3a0d-bf59-ac5428d6cd08",
                                                "text": "„Tagsatzung hiessen bis 1848 die Versammlungen, an denen bevollmächtigte Boten der eidgenössischen Orte gemeinsame Geschäfte berieten.“"
                                            },
                                            {
                                                "example_id": "f15fc90f-28db-4aaf-906a-8715253880f4",
                                                "sense_id": "d5b23a0e-ec20-3a0d-bf59-ac5428d6cd08",
                                                "text": "„1411 nahmen die eidgenössischen Orte die Appenzeller erstmals in ihr Burg- und Landrecht auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7c56903c-4480-3918-933e-bb6d62f04169",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "Ortgang, die giebelseitige Begrenzung eines Daches"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50a3f4c6-95f0-45e9-81a2-56f3b2c950d1",
                                                "sense_id": "7c56903c-4480-3918-933e-bb6d62f04169",
                                                "text": "Das Schwarzwaldhaus hat an dem Dach einen sehr schönen Ort."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "d000997d-105b-3235-a360-5c81743ec090",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "Spitze einer Blankwaffe"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2408b740-83bb-401c-ad15-19bc34301ba5",
                                                "sense_id": "d000997d-105b-3235-a360-5c81743ec090",
                                                "text": "In den Händen des Schwertkämpfers verschwanden die Örter des Schwertes in zahlreichen feindlichen Körpern."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "ce9a050d-3d20-3fba-9a31-6a2d3c6c1929",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "Ahle, Pfriem"
                                        ],
                                        "tags": [
                                            "Schuhmacherhandwerk",
                                            "auch n"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab38d49d-7781-4722-a71a-45612944a5ed",
                                                "sense_id": "ce9a050d-3d20-3fba-9a31-6a2d3c6c1929",
                                                "text": "Der Schuhmacher reparierte meine Schuhe mit einem Ort."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "7cca9c39-d080-342c-9e82-6b25205d0c9c",
                                        "entry_id": "3b3f439c-b603-3555-a986-99c4d40ab3ff",
                                        "glosses": [
                                            "Bezeichnung der Stelle eines Gestirns am Firmament"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c227e8e-cfa0-42d3-ad8c-68a8091332a1",
                                                "sense_id": "7cca9c39-d080-342c-9e82-6b25205d0c9c",
                                                "text": "Im Laufe der Jahrtausende verschieben sich wegen der Eigenbewegung die Örter der Fixsterne zueinander."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
