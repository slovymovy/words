                        ]
                    },
                    {
                        "translation_id": "c639ca0b-8594-47cb-a2a3-c223d3120122",
                        "source_entry_id": "3e5ec8fc-1e29-3a47-aa77-e757b238b9e0",
                        "source_sense_id": "7e05afbe-4fe3-3bc0-8d70-da21f8edb939",
                        "source_sense_description": "someone from Sevilla",
                        "target_lang_word": "Sévillane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sévillane",
