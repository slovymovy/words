                ],
                "translations": [
                    {
                        "translation_id": "c51b2d65-9cc4-4a1b-b7ac-774fb52f8ccb",
                        "source_entry_id": "69c0e9f8-958f-3f5f-bec2-f43259e4871e",
                        "source_sense_id": "4f95fd40-246a-306c-a261-63ffcdf77deb",
