                },
                {
                    "sense_id": "b16305a4-f6b9-3a8c-bcc2-e2e79c220a66",
                    "sense_definition": "Sert à relier deux noms pour exprimer la destination ou l'usage d'un objet.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il range toujours ses livres dans un grand sac <w>à</w> dos."
                        },
                        {
                            "text": "Elle a acheté une nouvelle boîte <w>à</w> bijoux en bois."
                        }
