                    "semantic_group_id": "fluessigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem schweren Unwetter lief die ganze <w>Soße</w> direkt in unsere Garage.",
                            "target_lang_translations": {
                                "en": "After the severe storm, all the <w>muck</w> ran straight into our garage.",
                                "ru": "После сильной бури вся эта <w>жижа</w> потекла прямо в наш гараж.",
                                "nl": "Na het zware noodweer liep de hele <w>smurrie</w> rechtstreeks onze garage in.",
                                "pl": "Po gwałtownej nawałnicy cała ta <w>breja</w> wlała się prosto do naszego garażu.",
                                "fr": "Après les violentes intempéries, toute cette <w>boue</w> a coulé directement dans notre garage.",
                                "it": "Dopo la violenta tempesta, tutta quella <w>melma</w> è finita direttamente nel nostro garage.",
                                "cs": "Po silné bouřce natekla všechna ta <w>břečka</w> přímo do naší garáže.",
                                "tr": "Şiddetli fırtınanın ardından bütün o <w>pis su</w> doğrudan garajımıza aktı.",
                                "es": "Tras la fuerte tormenta, toda esa <w>porquería</w> entró directamente en nuestro garaje.",
                                "zh": "暴风雨过后，所有那些<w>脏水</w>直接流进了我们的车库。"
                            }
                        },
                        {
                            "text": "Die alte Fabrik leitete eine braune <w>Soße</w> heimlich in den nahegelegenen Fluss.",
                            "target_lang_translations": {
                                "en": "The old factory secretly discharged a brown <w>sludge</w> into the nearby river.",
                                "ru": "Старая фабрика тайно сливала коричневую <w>жижу</w> в протекающую поблизости реку.",
                                "nl": "De oude fabriek loosde stiekem een bruine <w>smurrie</w> in de nabijgelegen rivier.",
                                "pl": "Stara fabryka potajemnie spuszczała brązowy <w>szlam</w> do pobliskiej rzeki.",
                                "fr": "La vieille usine déversait secrètement une <w>mixture</w> brune dans la rivière voisine.",
                                "it": "La vecchia fabbrica scaricava segretamente una <w>fanghiglia</w> marrone nel fiume vicino.",
                                "cs": "Stará továrna tajně vypouštěla hnědou <w>břečku</w> do nedaleké řeky.",
                                "tr": "Eski fabrika, yakındaki nehre gizlice kahverengi bir <w>balçık</w> akıtıyordu.",
                                "es": "La vieja fábrica vertía clandestinamente un <w>lodo</w> marrón al río cercano.",
                                "zh": "这家老工厂暗中将褐色的<w>污水</w>排入了附近的河流。"
                            }
                        }
