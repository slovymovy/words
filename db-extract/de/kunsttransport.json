                ],
                "senses": [
                    {
                        "sense_id": "2ccf9edd-f870-3448-b660-81ed74c6261e",
                        "entry_id": "6dd90561-d946-3596-854d-1a76ac4aaf66",
                        "glosses": [
                            "Beförderung von künstlerischen Objekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "940ea4d0-1fc2-4722-870d-7a48924759d0",
                                "sense_id": "2ccf9edd-f870-3448-b660-81ed74c6261e",
                                "text": "„Sie erfolgte in Zusammenarbeit mit einer im Kunsttransport erfahrenen Spedition und unter Einbindung eines externen Restaurators.“"
                            },
                            {
                                "example_id": "c76f588d-8786-4caa-a7cd-161b62cc27fc",
                                "sense_id": "2ccf9edd-f870-3448-b660-81ed74c6261e",
                                "text": "„Im letzten Moment vor dem Eintreffen der amerikanischen Truppen schickten die Staatlichen Museen zu Berlin noch einen Kunsttransport.“"
                            },
                            {
                                "example_id": "e5e089d2-2ec9-4746-949d-e600b07052f7",
                                "sense_id": "2ccf9edd-f870-3448-b660-81ed74c6261e",
                                "text": "„Meinen Sie, der Überfall auf einen Kunsttransport, der assyrische Kostbarkeiten für den Louvre enthielt, würde unbeachtet bleiben?“"
                            },
                            {
                                "example_id": "1ad9e7fd-8d8d-4c18-9b1d-e6856412db87",
                                "sense_id": "2ccf9edd-f870-3448-b660-81ed74c6261e",
                                "text": "„Im Kunsttransport hat man es mit wenigen Firmen zu tun: Jedes Land hat ein, zwei Speditionen («ein hart erarbeitetes Monopol»), die die wertvollen Bilder unter grösster Geheimhaltung von Safe zu Safe transportieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
