                ],
                "senses": [
                    {
                        "sense_id": "0778531c-e240-32d4-8d1e-adaa3be7cbfe",
                        "entry_id": "27e5c14e-b1d4-374a-bd6e-56979254f38b",
                        "glosses": [
                            "Apaiser, calmer de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff55b0d-012d-435f-9b46-7af90cbbb164",
                                "sense_id": "0778531c-e240-32d4-8d1e-adaa3be7cbfe",
                                "text": "De quels ruisseaux de pleurs le rapaiserez-vous [Dieu],\nPour faire détourner de vos coupables têtes\nLes traits de son courroux ?"
                            },
                            {
                                "example_id": "6c1472c5-68ff-4bc4-921a-933c41f19de9",
                                "sense_id": "0778531c-e240-32d4-8d1e-adaa3be7cbfe",
                                "text": "Je viens prendre le temps de rapaiser Alcmène"
                            },
                            {
                                "example_id": "6746f5c3-1e43-42af-853e-dc97a129bf32",
                                "sense_id": "0778531c-e240-32d4-8d1e-adaa3be7cbfe",
                                "text": "Vous me rapaisez… en me disant que vous voulez… venir loger chez moi."
                            },
                            {
                                "example_id": "af2d302d-bc22-4c3a-88e5-1a0f8277e715",
                                "sense_id": "0778531c-e240-32d4-8d1e-adaa3be7cbfe",
                                "text": "Vous reposez-vous ? il faut un peu rapaiser votre sang, qui a été terriblement ému pendant le voyage"
                            }
                        ]
                    },
                    {
                        "sense_id": "ccb2db71-35e8-3556-a49f-070f786824d0",
                        "entry_id": "27e5c14e-b1d4-374a-bd6e-56979254f38b",
                        "glosses": [
                            "Se calmer."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "347e7e25-ab41-4854-bb16-728dc829095f",
                                "sense_id": "ccb2db71-35e8-3556-a49f-070f786824d0",
                                "text": "La mer se rapaise après la tourmente."
                            }
                        ]
                    }
