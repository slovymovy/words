    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42857250-dbd3-34f7-b9bb-7cd166356983",
                    "sense_definition": "een langgerekte bakvormige constructie aan een dak die regenwater opvangt en afvoert",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "waterafvoer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bladeren van de bomen hebben de <w>goot</w> volledig verstopt.",
                            "target_lang_translations": {
                                "en": "The leaves from the trees have completely blocked the <w>gutter</w>.",
                                "ru": "Листья с деревьев полностью забили <w>желоб</w>."
                            }
                        },
                        {
                            "text": "Je moet de <w>goot</w> schoonmaken voordat het gaat regenen.",
                            "target_lang_translations": {
                                "en": "You need to clean the <w>gutter</w> before it starts raining.",
                                "ru": "Тебе нужно почистить <w>водосток</w>, прежде чем пойдет дождь."
                            }
                        }
                    ],
                    "synonyms": [
                        "dakgoot",
                        "regenpijp"
                    ],
                    "common_phrases": [
                        "verstopte goot",
                        "goot schoonmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "An elongated trough-like structure on a roof that collects and drains rainwater.",
                        "ru": "Удлиненная желобообразная конструкция на крыше, которая собирает и отводит дождевую воду."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gutter",
                                "target_lang_sense_clarification": "on a roof"
                            },
                            {
                                "target_lang_word": "eavestrough",
                                "target_lang_sense_clarification": "roof drainage"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "водосточный желоб",
                                "target_lang_sense_clarification": "на крыше"
                            },
                            {
                                "target_lang_word": "водосток",
                                "target_lang_sense_clarification": "система отвода воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2494d8a-a045-32bd-a06f-be28ce5616b1",
                    "sense_definition": "een gleuf of greppel langs de weg bedoeld voor het afvoeren van vloeistof",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waterafvoer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water stroomde door de <w>goot</w> naar de riolering.",
                            "target_lang_translations": {
                                "en": "The water flowed through the <w>gutter</w> to the sewers.",
                                "ru": "Вода текла по <w>канаве</w> в канализацию."
                            }
                        },
                        {
                            "text": "Pas op dat je niet met je fiets in de diepe <w>goot</w> terechtkomt.",
                            "target_lang_translations": {
                                "en": "Be careful not to end up in the deep <w>ditch</w> with your bike.",
                                "ru": "Смотри не угоди на велосипеде в глубокий <w>кювет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "greppel",
                        "geul",
                        "riool"
                    ],
                    "common_phrases": [
                        "langs de goot"
                    ],
                    "target_lang_definitions": {
                        "en": "A groove or ditch along the side of a road intended for draining liquids.",
                        "ru": "Углубление или канава вдоль дороги, предназначенная для отвода жидкости."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gutter",
                                "target_lang_sense_clarification": "along a street"
                            },
                            {
                                "target_lang_word": "ditch",
                                "target_lang_sense_clarification": "drainage channel"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сточная канава",
                                "target_lang_sense_clarification": "вдоль дороги"
                            },
                            {
                                "target_lang_word": "кювет",
                                "target_lang_sense_clarification": "придорожная канава"
                            },
                            {
                                "target_lang_word": "желоб",
                                "target_lang_sense_clarification": "для стока воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1015216-5da9-34b0-9e39-79a314079bc4",
                    "sense_definition": "een figuurlijke plaats van moreel verval, armoede of dakloosheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder hulp van zijn familie zou hij waarschijnlijk in de <w>goot</w> belanden.",
                            "target_lang_translations": {
                                "en": "Without help from his family, he would likely end up in the <w>gutter</w>.",
                                "ru": "Без помощи семьи он, вероятно, оказался бы на <w>дне</w>."
                            }
                        },
                        {
                            "text": "Hij krabbelde langzaam weer op nadat hij jarenlang in de <w>goot</w> had geleefd.",
                            "target_lang_translations": {
                                "en": "He slowly got back on his feet after living in the <w>gutter</w> for years.",
                                "ru": "Он медленно поднялся на ноги после того, как годами жил в <w>сточной канаве</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderkant",
                        "zelfkant"
                    ],
                    "common_phrases": [
                        "in de goot",
                        "belanden in de goot"
                    ],
                    "target_lang_definitions": {
                        "en": "A figurative place of moral decay, poverty, or homelessness.",
                        "ru": "Переносное значение, обозначающее место морального упадка, нищеты или бездомности."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gutter",
                                "target_lang_sense_clarification": "figurative state of poverty"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дно",
                                "target_lang_sense_clarification": "социальное падение"
                            },
                            {
                                "target_lang_word": "сточная канава",
                                "target_lang_sense_clarification": "фигурально о нищете"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2067df26-6c98-3963-86b8-e6f88d015e0a",
                    "sense_definition": "de enkelvoudige verleden tijd van het werkwoord <w>gieten</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gieten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>goot</w> de melk voorzichtig in het glas zonder te morsen.",
                            "target_lang_translations": {
                                "en": "I carefully <w>poured</w> the milk into the glass without spilling.",
                                "ru": "Я осторожно <w>налил</w> молоко в стакан, не пролив ни капли."
                            }
                        },
                        {
                            "text": "Zij <w>goot</w> de planten elke ochtend met een grote gieter.",
                            "target_lang_translations": {
                                "en": "She <w>watered</w> the plants every morning with a large watering can.",
                                "ru": "Она каждое утро <w>поливала</w> растения из большой лейки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense of gieten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The simple past tense of the verb 'to pour'.",
                        "ru": "Форма прошедшего времени единственного числа глагола 'gieten' (лить, наливать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poured",
                                "target_lang_sense_clarification": "past tense of pour"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лил",
                                "target_lang_sense_clarification": "прошедшее время от лить"
                            },
                            {
                                "target_lang_word": "налил",
                                "target_lang_sense_clarification": "прошедшее время от налить"
                            },
                            {
                                "target_lang_word": "поливал",
                                "target_lang_sense_clarification": "прошедшее время от поливать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18a1ac31-896a-3e0a-b852-da9fd843f63f",
                    "sense_definition": "onpersoonlijke uitdrukking voor het heel hard regenen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We konden niet naar buiten omdat het regende dat het <w>goot</w>.",
                            "target_lang_translations": {
                                "en": "We couldn't go outside because it was <w>pouring</w> with rain.",
                                "ru": "Мы не могли выйти на улицу, потому что дождь <w>лил как из ведра</w>."
                            }
                        },
                        {
                            "text": "Het <w>goot</w> van de lucht toen we eindelijk bij het station aankwamen.",
                            "target_lang_translations": {
                                "en": "It was <w>bucketing down</w> when we finally arrived at the station.",
                                "ru": "С неба <w>лило</w>, когда мы наконец добрались до станции."
                            }
                        }
                    ],
                    "synonyms": [
                        "storten",
                        "plenzen"
                    ],
                    "common_phrases": [
                        "regenen dat het goot"
                    ],
                    "target_lang_definitions": {
                        "en": "An impersonal expression for raining very heavily.",
                        "ru": "Безличное выражение для обозначения очень сильного дождя."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poured",
                                "target_lang_sense_clarification": "of rain"
                            },
                            {
                                "target_lang_word": "bucketed down",
                                "target_lang_sense_clarification": "heavy rain"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лило как из ведра",
                                "target_lang_sense_clarification": "о сильном дожде"
                            },
                            {
                                "target_lang_word": "лил",
                                "target_lang_sense_clarification": "о дожде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7869f0a8-ef78-3306-8955-8713226c72c7",
                    "sense_definition": "een lid van een historisch Oost-Germaans volk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "volk",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "De geschiedenisles ging vandaag over de migratie van de <w>Goot</w> door Europa.",
                            "target_lang_translations": {
                                "en": "Today's history lesson was about the migration of the <w>Goth</w> through Europe.",
                                "ru": "Урок истории сегодня был посвящен миграции <w>готов</w> по Европе."
                            }
                        },
                        {
                            "text": "Een Romein en een <w>Goot</w> hadden in die tijd een heel andere cultuur.",
                            "target_lang_translations": {
                                "en": "A Roman and a <w>Goth</w> had very different cultures in those days.",
                                "ru": "У римлянина и <w>гота</w> в те времена были совершенно разные культуры."
                            }
                        }
                    ],
                    "target_lang_definitions": {
