                                        "entry_id": "56419618-d8a3-397d-829d-6cdd6fc9ed97",
                                        "glosses": [
                                            "weites, sportliches Gehen, Sport und Freizeitbeschäftigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d53ac210-1e79-41b9-be3f-52a63341d273",
                                                "sense_id": "a7879960-a01b-3020-aabf-d4a313637b2b",
                                                "text": "„Die Geschichte des Wanderns beginnt im 18. Jahrhundert – als Freizeitvergnügen des Bildungsbürgertums.“"
                                            },
                                            {
                                                "example_id": "a6b7bf86-7e56-455a-90c4-e820b02dd6f6",
                                                "sense_id": "a7879960-a01b-3020-aabf-d4a313637b2b",
                                                "text": "„Zu den Hobby-Sportarten aus Sicht des Rechnungshofes zählen Golf, Bergsteigen, Billard, Bowling, Kegeln, Luftsport, Motorsport, Motorbootyachtsport, Schach, Tanzen, Tauchen und Wandern.“"
                                            },
                                            {
                                                "example_id": "174fcbf3-39fb-41cc-ae68-ceb510e27fdc",
                                                "sense_id": "a7879960-a01b-3020-aabf-d4a313637b2b",
                                                "text": "„Das Wandern ist des Müllers Lust,",
                                                "translation": "das Wandern, das Wandern, das Wandern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cc56fd1b-b32f-3cca-92f2-f26412680df2",
