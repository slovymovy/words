                        "entry_id": "9367ae7a-c469-3f59-a96e-2b098e2cdc55",
                        "glosses": [
                            "Gattung nach Auftrag und Ausstattung gleicher Einheiten"
                        ],
                        "tags": [
                            "Heer"
                        ],
                        "examples": [
                            {
                                "example_id": "0c6a5b1f-41c9-4b82-a950-b13f3ce8ea9a",
                                "sense_id": "d8617766-a3fa-3008-b901-41750430d44e",
                                "text": "„Als man früher besondere, allen anderen überlegene Truppengattungen anwerben konnte, wie die schweizerische Infanterie oder die französische Ritterschaft im 16. Jahrhundert, hielt man es nicht für nötig, große Armeen auszuheben; das ist aber nicht mehr so, wenn alle Soldaten den gleichen Wert haben.“"
                            },
                            {
                                "example_id": "2c6964a2-d2f8-4ccc-ac42-6b360a4dca54",
                                "sense_id": "d8617766-a3fa-3008-b901-41750430d44e",
                                "text": "„Zwischen den einzelnen Truppengattungen war eine Art Strasse freigeblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
