    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd58eaaf-9fdb-3db9-b9e8-318750212e1e",
                    "sense_definition": "The activity of shopping for secondhand or inexpensive items, especially at flea markets, garage sales, or thrift stores.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shopping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the entire Saturday <w>thrifting</w> with her friends in search of vintage coats.",
                            "target_lang_translations": {
                                "ru": "Она провела всю субботу, <w>ходя по секонд-хендам</w> с подругами в поисках винтажных пальто."
                            }
                        },
                        {
                            "text": "Many teenagers have embraced <w>thrifting</w> as a way to find unique clothes on a budget.",
                            "target_lang_translations": {
                                "ru": "Многие подростки полюбили <w>шопинг в секонд-хендах</w> как способ найти уникальную одежду без лишних затрат."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go thrifting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покупки подержанных или недорогих вещей, особенно в секонд-хендах, на блошиных рынках или гаражных распродажах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупки в секонд-хендах",
                                "target_lang_sense_clarification": "процесс поиска и приобретения вещей"
                            },
                            {
                                "target_lang_word": "шопинг в секонд-хендах",
                                "target_lang_sense_clarification": "поход по комиссионкам и секонд-хендам"
                            },
                            {
                                "target_lang_word": "трифтинг",
                                "target_lang_sense_clarification": "современный заимствованный термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2beb61d-b8cc-3bac-b146-9632f6d37ece",
                    "sense_definition": "present participle of <w>thrift</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shopping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the afternoon <w>thrifting</w> through local second-hand shops for retro furniture.",
                            "target_lang_translations": {
                                "ru": "Они провели день, <w>выискивая</w> ретро-мебель <w>в местных секонд-хендах</w>."
                            }
                        },
                        {
                            "text": "Instead of buying brand new clothes, he prefers <w>thrifting</w> at charity stores.",
                            "target_lang_translations": {
                                "ru": "Вместо покупки совершенно новой одежды он предпочитает <w>покупать вещи</w> в благотворительных магазинах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
