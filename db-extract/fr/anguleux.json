                                            {
                                                "example_id": "0ae3d4e5-fce0-4a02-9f21-613aeac2fb02",
                                                "sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                                                "text": "Kasten vol identieke versies van de icosahedron (20-kantige vorm) donderen om, alsof er ooit een windhoos door het kunstenaarsatelier raasde."
                                            },
                                            {
                                                "example_id": "5413cf50-ce3d-4dc1-9764-f65a2291df93",
                                                "sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                                                "text": "De Renegade rijdt er niet minder om. Hij stuurt zeker, zelfs met voldoende gevoel en de kantige koets blijft behoorlijk goed overeind. Bovendien duikt hij bij het remmen nauwelijks."
                                            },
                                            {
                                                "example_id": "4b82de5e-a976-4840-931c-1779323037c9",
                                                "sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                                                "text": "De twee slachtoffers werden op hun motorjacht zwaar toegetakeld met een ‘kantig’ voorwerp. Daarna zijn ze overboord gegooid. Pas de volgende dag werden hun lichamen gevonden in het Hoendiep."
                                            }
