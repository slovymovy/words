                        "examples": [
                            {
                                "example_id": "c876e020-13f9-48be-bb51-8c527bc86441",
                                "sense_id": "d46143ac-381a-3af5-9e42-1fa5989cfdf9",
                                "text": "Il découvrirait un campanile de tuiles rongées par la mousse, douze maisonnettes éparses, entourées de leurs vergers et de leurs chenevières."
                            },
                            {
                                "example_id": "cfb3f464-5e5a-4249-8c72-f997ef682c5f",
                                "sense_id": "d46143ac-381a-3af5-9e42-1fa5989cfdf9",
                                "text": "Pour me consoler, ma mère me tailla une part de la miche de froment et me donna quelques poires Saint-Jean qu’elle avait trouvées sous le poirier de la chenevière."
                            },
                            {
                                "example_id": "3474b06d-741c-45b9-8468-1d567deebe30",
                                "sense_id": "d46143ac-381a-3af5-9e42-1fa5989cfdf9",
                                "text": "J’allais d’un bon pas ; aux vignes succédaient les vignes, aux chenevières les chenevières, puis apparut le bois de sapins, où descendait le sentier sombre ; la lune pâle au-dessus, y traçait d’un côté son immense sillon de lumière."
                            }
                        ]
                    }
