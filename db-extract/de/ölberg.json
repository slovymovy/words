                            "singular"
                        ],
                        "form": "der Ölberg"
                    },
                    {
                        "form_id": "f505d565-d15e-42c1-81c0-724b90e0ee5e",
                        "entry_id": "198ba098-5597-3bbb-b0f2-f3feaa6b73e3",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Ölbergs"
                    },
                    {
                        "form_id": "02d9e4c3-9e8a-46e3-9ce4-cf6f8fd2eacc",
                        "entry_id": "198ba098-5597-3bbb-b0f2-f3feaa6b73e3",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Ölberg"
                    },
                    {
                        "form_id": "c31d92ae-0a3a-4943-a9a4-670b93405406",
                        "entry_id": "198ba098-5597-3bbb-b0f2-f3feaa6b73e3",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Ölberg"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                        "entry_id": "198ba098-5597-3bbb-b0f2-f3feaa6b73e3",
                        "glosses": [
                            "östlich der Jerusalemer Altstadt gelegene Erhebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b8050c-ab25-4f98-837d-66169609fc2a",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Im April, nach der Evakuierung Jaffas und Tel Avivs, hatte Dschamal Pascha die in Jerusalem verbliebenen Konsuln zu einer dringenden Besprechung in sein Hauptquartier auf dem Ölberg einberufen.“"
                            },
                            {
                                "example_id": "49c258cc-741b-411b-9abb-4a9159e6705f",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Abed arbeitete bis nachmittags bei Bezeq, wo er eine Monteurkolonne beaufsichtigte, die in ganz Ostjerusalem Telefonleitungen reparierte, von Dahiyat a-Salaam und dem Shuafat-Lager bis hin zum Ölberg und in die Altstadt.“"
                            },
                            {
                                "example_id": "4ff2e539-0fcd-4ff2-a253-03955ec069c0",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Dahinter war die kleinere silbergraue Kuppel der al-Aqsa-Moschee mit dem Ölberg im Hintergrund zu sehen.“"
                            },
                            {
                                "example_id": "51348a2a-fa9b-417c-a5b0-d012fa4785a5",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Er bot an, die Stadt zu teilen, die jüdisch bewohnten Stadtteile der israelischen Hauptstadt und die arabisch bewohnten Stadtteile der palästinensischen Hauptstadt zuzuschlagen und für das sogenannte heilige Becken (die Altstadt, den Tempelberg/Haram al-Scharif, die an die Altstadt angrenzende Davidstadt und den Ölberg) einen Sonderstatus unter Verwaltung einer dritten Partei einzurichten.“"
                            },
                            {
                                "example_id": "e2e37b64-8b49-4428-b7e8-4487aae5c9ef",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Unterwegs hielten wir auf dem Skopusberg und dem Ölberg, um vor der ewigen Stadt ›niederzuknien‹.“"
                            },
                            {
                                "example_id": "25305452-d764-4d9c-a247-181ef1ed93c5",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Sie beschwört ihren Herrn Yasu und wirft sich auf IHn. Sie packt Ihn an der Kehle, bis Er keine Luft mehr bekommt, sie hängt sich an Sein Gewand, bis er keinen Schritt mehr tun kann, sie greift sich Seinen Kelch und schleudert ihn durch den Raum, sie pöbelt Ihn an, als Er vom Ölberg steigt und Seine Predigt halten will, sie reißt Seinen Jüngern die Fische aus der Hand und wirft sie zurück in den See Genezareth.“"
                            },
                            {
                                "example_id": "a3455be4-bfd6-4e96-bf49-79bb6170c5f0",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Viele der größten Helden Israels lagen am Ölberg begraben, und heute sollten neue dazukommen.“"
                            },
                            {
                                "example_id": "b47a0bf3-c84b-471a-a54d-f2279dcb96f3",
                                "sense_id": "6293aeec-6d65-312d-8abe-4e1cd076a0f5",
                                "text": "„Erst nach der islamischen Rückgewinnung Jerusalems um die Mitte des 13. Jahrhunderts konnten die Juden die Kulthandlungen an den Toren zum Tempelberg und auf dem Ölberg wieder aufnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
