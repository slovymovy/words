                "senses": [
                    {
                        "sense_id": "14cb3c81-f6d0-3973-bdf1-2bcb4c62b793",
                        "entry_id": "fa5fcc69-ffa1-3015-9cb5-d487b18ab0a0",
                        "glosses": [
                            "Saleté, ordure."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "b76af994-cd31-4f7b-a642-171e7ddafae6",
                                "sense_id": "14cb3c81-f6d0-3973-bdf1-2bcb4c62b793",
                                "text": "Enfle-toi torse pâle et que les effrois ruissellent avec les eaux et les bordilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ce4613-8f8d-3827-a346-20a15db3d31b",
                        "entry_id": "fa5fcc69-ffa1-3015-9cb5-d487b18ab0a0",
                        "glosses": [
                            "Saleté, ordure.",
                            "une décharge d’ordures."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dcc7445a-b4d7-3a4a-b07a-e26b2049d58d",
                        "entry_id": "fa5fcc69-ffa1-3015-9cb5-d487b18ab0a0",
                        "glosses": [
                            "Saleté, ordure.",
                            "Poubelle."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "c14e2778-c10e-4b41-9269-7b132b15f161",
                                "sense_id": "dcc7445a-b4d7-3a4a-b07a-e26b2049d58d",
                                "text": "Flanquez donc ça bordille, dit Maples. Perte de temps."
                            },
                            {
                                "example_id": "7a35414c-ce09-4fc9-a7ec-a5670f91fcdc",
                                "sense_id": "dcc7445a-b4d7-3a4a-b07a-e26b2049d58d",
                                "text": "Puis il voit ses savattes déchirées — Regardez ! Elles sont juste bonnes à mettre à la bordille, maintenant."
                            }
                        ]
                    },
                    {
                        "sense_id": "439481ea-618f-3617-84c0-96d9bff1666c",
                        "entry_id": "fa5fcc69-ffa1-3015-9cb5-d487b18ab0a0",
                        "glosses": [
                            "Personne méprisable."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "eae25854-32c9-4f96-9367-460e3e99da25",
                                "sense_id": "439481ea-618f-3617-84c0-96d9bff1666c",
                                "text": "Ne faites pas attention Monsieur le Curé, c’est un saligaud, une bordille qui ne respecte rien, pas même les choses sacrées, putain de bonne Mère !"
                            },
                            {
                                "example_id": "1804bc83-a6f4-4d1f-b8d5-5cc23e267680",
                                "sense_id": "439481ea-618f-3617-84c0-96d9bff1666c",
                                "text": "Trois couleurs sur les affiches nous traitent comme des bordilles\nC'est pas Manille OK, mais les cigarettes se torpillent"
                            }
                        ]
                    },
                    {
                        "sense_id": "aad67bfb-a29b-35bc-b6f8-80c1c2a59579",
                        "entry_id": "fa5fcc69-ffa1-3015-9cb5-d487b18ab0a0",
                        "glosses": [
                            "Objet de faible valeur, de mauvaise qualité."
                        ],
                        "tags": [
                            "Provence",
                            "Dauphiné"
                        ],
                        "examples": [
                            {
                                "example_id": "d5515187-d7b5-4095-b0b5-cfb23094656a",
                                "sense_id": "aad67bfb-a29b-35bc-b6f8-80c1c2a59579",
                                "text": "Voï ! Qu’est-ce que c’est que cette bordille que tu nous ramènes ? - C’est pas une bordille. C’est un fanal., ."
                            }
                        ]
                    },
                    {
                        "sense_id": "99932d5b-348d-3c08-9f3c-f835066bf9bb",
                        "entry_id": "fa5fcc69-ffa1-3015-9cb5-d487b18ab0a0",
                        "glosses": [
                            "Dénonciateur."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ccb99075-a9c1-4946-8634-8e5286be465c",
                                "sense_id": "99932d5b-348d-3c08-9f3c-f835066bf9bb",
                                "text": "C'est moi, Minot. Rien à voir avec ton affaire, mais c'était une grosse bordille, le Bastien et une balance. Je ne regrette rien."
                            }
                        ]
                    }
