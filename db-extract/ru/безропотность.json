                "senses": [
                    {
                        "sense_id": "33fe9129-4fe1-3f34-af99-e5448c7416ff",
                        "entry_id": "f001e8c2-3b40-3455-bcad-aa6c3b0385c5",
                        "glosses": [
                            "свойство по значению прилагательного безропотный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae1a5112-daa3-43f2-af1a-805dda0a8b9b",
                                "sense_id": "33fe9129-4fe1-3f34-af99-e5448c7416ff",
                                "text": "Дух безропотности, безогненности, безлюбовности, безрадужности, безблагодатности, безгорестности, — тысячи многоразличных «без», опустошающих и умерщвляющих душу."
                            },
                            {
                                "example_id": "2229239f-d567-4bca-9687-8d510d41fba1",
                                "sense_id": "33fe9129-4fe1-3f34-af99-e5448c7416ff",
                                "text": "Только сознание лишило нас безропотности твари, и мы прибавили себе мучений."
                            },
                            {
                                "example_id": "c3eb67f2-8d94-4971-9682-ec97ee54e78a",
                                "sense_id": "33fe9129-4fe1-3f34-af99-e5448c7416ff",
                                "text": "Злят меня и абсолютная безропотность людей, их спокойствие и равнодушие, словно иначе быть не может."
                            }
                        ]
                    }
                ],
