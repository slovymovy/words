                {
                    "sense_id": "ac3f807d-5161-31ab-8ef8-e1852f4224c3",
                    "sense_definition": "Het zachte, gedempte licht tijdens de zonsopgang of zonsondergang.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We wandelden door het bos in het zachte <w>schemerlicht</w>. ",
                            "target_lang_translations": {
                                "en": "We walked through the forest in the soft <w>twilight</w>."
                            }
                        },
                        {
                            "text": "In het zachte <w>schemerlicht</w> kon ik zijn gezicht nauwelijks zien.",
                            "target_lang_translations": {
                                "en": "In the soft <w>twilight</w>, I could barely see his face."
                            }
                        }
                    ],
                    "synonyms": [
                        "schemering",
                        "schemerdonker",
                        "halfduister"
                    ],
                    "common_phrases": [
                        "zacht schemerlicht",
                        "in het schemerlicht"
                    ],
                    "target_lang_definitions": {
                        "en": "The soft, subdued light during sunrise or sunset."
                    },
                    "translations": {
                        "en": [
