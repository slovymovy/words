                                        "sense_id": "e3bf2588-1dcd-3813-af78-c2e1e8170f59",
                                        "entry_id": "f2fbe8f3-7b5f-34c1-b529-e8a41f9c701e",
                                        "glosses": [
                                            "Measured stacked or organized (such as of firewood when in neat stacks), but with gaps between individual pieces."
                                        ],
                                        "tags": [
                                            "of volumes of materials"
                                        ],
