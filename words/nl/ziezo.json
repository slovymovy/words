            "senses": [
                {
                    "sense_id": "5964bf89-569d-30a4-a83f-182e0fcc4a97",
                    "sense_definition": "uitroep om aan te geven dat iets klaar of voltooid is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ziezo</w>, de klus is eindelijk geklaard.",
                            "target_lang_translations": {
                                "fr": "<w>Voilà</w>, le travail est enfin terminé.",
                                "en": "<w>There</w>, the job is finally done."
                            }
                        },
                        {
                            "text": "Ik heb de laatste doos ingepakt, <w>ziezo</w>.",
                            "target_lang_translations": {
                                "fr": "J'ai emballé le dernier carton, <w>et voilà</w>.",
                                "en": "I've packed the last box, <w>and that's that</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "klaar",
                        "voilà"
                    ],
                    "common_phrases": [
                        "ziezo dat is klaar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Interjection utilisée pour indiquer que quelque chose est terminé ou accompli.",
                        "en": "An exclamation used to indicate that a task or action is finished, completed, or settled."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "voilà",
                                "target_lang_sense_clarification": "pour marquer la fin d'une action ou d'une tâche"
                            },
                            {
                                "target_lang_word": "et voilà",
                                "target_lang_sense_clarification": "expression courante pour souligner l'achèvement"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "there",
                                "target_lang_sense_clarification": "used when completing a task or placing something down"
                            },
                            {
                                "target_lang_word": "there we go",
                                "target_lang_sense_clarification": "used to mark the completion of an action"
                            },
                            {
                                "target_lang_word": "that's that",
                                "target_lang_sense_clarification": "used to indicate something is finished and done with"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9155009-fa82-3836-9bca-5c6473d60f59",
                    "sense_definition": "uitroep van opluchting of tevredenheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ziezo</w>, dat ziet er een stuk beter uit.",
                            "target_lang_translations": {
                                "fr": "<w>Voilà</w>, ça a l'air beaucoup mieux comme ça.",
                                "en": "<w>There</w>, that looks a lot better."
                            }
                        },
                        {
                            "text": "<w>Ziezo</w>, nu kunnen we eindelijk gaan zitten.",
                            "target_lang_translations": {
                                "fr": "<w>Ça y est</w>, nous pouvons enfin nous asseoir.",
                                "en": "<w>Right then</w>, now we can finally sit down."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Interjection exprimant le soulagement ou la satisfaction après une action.",
                        "en": "An exclamation expressing relief, satisfaction, or content at a result."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "voilà",
                                "target_lang_sense_clarification": "pour exprimer la satisfaction devant un résultat"
                            },
                            {
                                "target_lang_word": "ça y est",
                                "target_lang_sense_clarification": "pour marquer le soulagement qu'une situation est enfin résolue"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "there",
                                "target_lang_sense_clarification": "expressing satisfaction with a result"
                            },
                            {
                                "target_lang_word": "right then",
                                "target_lang_sense_clarification": "expressing ready satisfaction or transition after finishing something"
                            },
                            {
                                "target_lang_word": "all done",
                                "target_lang_sense_clarification": "expressing satisfaction that a situation or task is settled"
                            }
                        ]
                    }
                }
            ]
        }
    ]
