                ],
                "senses": [
                    {
                        "sense_id": "4461d9bd-9cb4-3d21-9e51-d25909d75fbc",
                        "entry_id": "7b7746e4-971f-33a0-9e35-a021d8b9fdda",
                        "glosses": [
                            "Oberst der Ulanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e3497a-5f23-4577-8ff7-beb9dd0e765b",
                                "sense_id": "4461d9bd-9cb4-3d21-9e51-d25909d75fbc",
                                "text": "„Warum schwimmen, wir haben doch unsere Pferde, antwortete der Ulanenoberst und fragte, ob es gestattet sei, mit seinen Reitern den Fluss schwimmend zu überqueren.“"
                            },
                            {
                                "example_id": "50c604ac-8409-4c61-a32e-3ec5f283adfd",
                                "sense_id": "4461d9bd-9cb4-3d21-9e51-d25909d75fbc",
                                "text": "„Ulanenoberst von Raumont hatte es schwer, mit seiner Stimme gegen den Vind anzukommen.“"
                            },
                            {
                                "example_id": "b9c74824-1b49-42d5-b4ff-a99cb20fb400",
                                "sense_id": "4461d9bd-9cb4-3d21-9e51-d25909d75fbc",
                                "text": "„Der polnische Ulanenoberst, ein schöner alter Mann, der vor Aufregung ganz rot geworden war und ins Stottern geriet, fragte den Adjutanten, ob es ihm wohl erlaubt werden würde, mit seinen Ulanen, ohne erst eine Furt zu suchen, den Fluß zu durchschwimmen.“"
                            },
                            {
                                "example_id": "cf012228-3289-4dc1-8ad6-8be83f13c12f",
                                "sense_id": "4461d9bd-9cb4-3d21-9e51-d25909d75fbc",
                                "text": "„18-20-Jährig wählte er seine lebenslang beibehaltene Thematik und seine künstlerischen Techniken und konnte erreichen, dass König Friedrich Wilhelm III. 1817 erstmals ein Bild von ihm kaufte: ein Ulanenoberst an der Spitze seiner Reiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
