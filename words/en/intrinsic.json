{
    "word_family": [
        "intrinsically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f8054e37-a0c5-3970-8085-5277302a5c25",
                    "sense_definition": "Belonging to the essential nature or constitution of a thing; inherent, innate, or inseparable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "essential_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intrinsic</w> value of the ancient coin lies in its historical significance rather than the metal itself.",
                            "target_lang_translations": {
                                "ru": "<w>Собственная</w> ценность древней монеты заключается в ее исторической значимости, а не в самом металле."
                            }
                        },
                        {
                            "text": "Every human being possesses <w>intrinsic</w> worth that must be respected by society.",
                            "target_lang_translations": {
                                "ru": "Каждый человек обладает <w>присущим</w> ему достоинством, которое общество должно уважать."
                            }
                        }
                    ],
                    "synonyms": [
                        "essential",
                        "inherent",
                        "innate",
                        "natural",
                        "inborn",
                        "integral"
                    ],
                    "antonyms": [
                        "extrinsic"
                    ],
                    "common_phrases": [
                        "intrinsic value",
                        "intrinsic worth",
                        "intrinsic motivation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присущий самой природе или существу чего-либо; внутренний, врожденный или неотделимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присущий",
                                "target_lang_sense_clarification": "свойственный по самой природе"
                            },
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "заложенный внутри, неотъемлемый"
                            },
                            {
                                "target_lang_word": "имманентный",
                                "target_lang_sense_clarification": "книжн., внутренне присущий"
                            },
                            {
                                "target_lang_word": "собственный",
                                "target_lang_sense_clarification": "о ценности, значимости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9fecaaa-8eb6-33c7-a93f-d441a58223d2",
                    "sense_definition": "Built-in or provided as a fundamental part of a system, especially in programming languages.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "built_in_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler provides several <w>intrinsic</w> functions that allow direct access to hardware instructions.",
                            "target_lang_translations": {
                                "ru": "Компилятор предоставляет несколько <w>встроенных</w> функций, обеспечивающих прямой доступ к аппаратным инструкциям."
                            }
                        },
                        {
                            "text": "We prefer to use the <w>intrinsic</w> operators of the language rather than writing custom functions.",
                            "target_lang_translations": {
                                "ru": "Мы предпочитаем использовать <w>встроенные</w> операторы языка, а не писать собственные функции."
                            }
                        }
                    ],
                    "synonyms": [
                        "built-in",
                        "inbuilt"
                    ],
                    "common_phrases": [
                        "intrinsic function"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Встроенный или предоставляемый как фундаментальная часть системы, особенно в языках программирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встроенный",
                                "target_lang_sense_clarification": "о функциях или операторах в программировании"
                            },
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "предоставляемый компилятором"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59b06641-6c7c-3fe2-a710-8276cdd6e9f7",
                    "sense_definition": "Situated entirely within, or peculiar to, a part, organ, or limb, especially of muscles and nerves.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomical_internal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intrinsic</w> muscles of the hand allow for delicate and precise movements of the fingers.",
                            "target_lang_translations": {
                                "ru": "<w>Собственные</w> мышцы кисти обеспечивают тонкие и точные движения пальцев."
                            }
                        },
                        {
                            "text": "An <w>intrinsic</w> laryngeal muscle is responsible for controlling the tension of the vocal cords.",
                            "target_lang_translations": {
                                "ru": "<w>Внутренняя</w> мышца гортани отвечает за контроль натяжения голосовых связок."
                            }
                        }
                    ],
                    "antonyms": [
                        "extrinsic"
                    ],
                    "common_phrases": [
                        "intrinsic muscles"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный полностью внутри или свойственный определенной части, органу или конечности (особенно о мышцах и нервах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "анатом., расположенный внутри органа или части тела"
                            },
                            {
                                "target_lang_word": "собственный",
                                "target_lang_sense_clarification": "анатом., о мышцах органа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2209511-09e0-3a35-ba67-abaf499595a2",
                    "sense_definition": "A built-in function that is implemented directly by the compiler, without any intermediate call to a library.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "programming_built_in",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using a compiler <w>intrinsic</w> can significantly optimize the performance of the inner loop.",
                            "target_lang_translations": {
                                "ru": "Использование <w>интринсика</w> компилятора может значительно оптимизировать производительность внутреннего цикла."
                            }
                        },
                        {
                            "text": "The developer replaced the assembly code with a vector <w>intrinsic</w> for better readability.",
                            "target_lang_translations": {
                                "ru": "Разработчик заменил ассемблерный код векторным <w>интринсиком</w> для лучшей читаемости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compiler intrinsic",
                        "vector intrinsic"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Встроенная функция, реализуемая непосредственно компилятором без промежуточного вызова библиотеки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интринсик",
                                "target_lang_sense_clarification": "программирование, встроенная функция"
                            },
                            {
                                "target_lang_word": "встроенная функция",
                                "target_lang_sense_clarification": "компилятора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaedf6f0-56bc-34ec-b53f-1fbee45dfc79",
                    "sense_definition": "An ability or trait possessed by a character that does not require any external equipment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating the corpse of certain monsters grants the player a permanent <w>intrinsic</w> like poison resistance.",
                            "target_lang_translations": {
                                "ru": "Поедание трупов некоторых монстров дает игроку постоянное <w>внутреннее свойство</w>, например, сопротивляемость яду."
                            }
                        },
                        {
                            "text": "He lost his teleportation <w>intrinsic</w> after stepping on a cursed trap.",
                            "target_lang_translations": {
                                "ru": "Он потерял свою <w>врожденную способность</w> к телепортации, наступив на проклятую ловушку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность или черта персонажа, не требующая внешнего снаряжения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутреннее свойство",
                                "target_lang_sense_clarification": "в играх, врожденная способность"
                            },
                            {
                                "target_lang_word": "пассивная способность",
                                "target_lang_sense_clarification": "гейминг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}