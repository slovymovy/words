                        "translation_id": "159d52e9-abb4-4665-8ddb-206c0c2ab0f9",
                        "source_entry_id": "3401b082-3dff-303a-9ce2-b2632e72f435",
                        "source_sense_id": "3d1d94d7-16c4-35e2-9597-711971230962",
                        "target_lang_word": "пивной",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пивной",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e8d665-acac-3419-bdcb-534b60bbb256",
                                        "entry_id": "5b69ba6c-a7c8-3324-8864-bc45582e70af",
                                        "glosses": [
                                            "относящийся к пиву или к его производству, продаже и т. п., свойственный пиву, предназначенный для пива, вызванный употреблением пива и т. п"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc2f8495-43aa-41d6-b19d-dc6bc263c3aa",
                                                "sense_id": "b0e8d665-acac-3419-bdcb-534b60bbb256",
                                                "text": "У второго мальчика, Павлуши, волосы были всклоченные, чёрные, глаза серые, скулы широкие, лицо бледное, рябое, рот большой, но правильный, вся голова огромная, как говорится, с пивной котёл, тело приземистое, неуклюжее."
                                            },
                                            {
                                                "example_id": "98fe1058-c2f7-4f89-a4cd-0c1d730ce466",
                                                "sense_id": "b0e8d665-acac-3419-bdcb-534b60bbb256",
                                                "text": "Старичок протёр глаза, поманил лакея, показал ему рубль и, отрицательно покачав головой, постукал по пустой пивной бутылке, стоявшей на столе."
                                            },
                                            {
                                                "example_id": "7aee269a-9d87-43fb-b034-3e5af3736cd6",
                                                "sense_id": "b0e8d665-acac-3419-bdcb-534b60bbb256",
                                                "text": "А потом тут хорошая манера: при пивных заводах есть такие садики — дают только пиво на стол, а сосиски и ветчину посетители с собой в бумажке приносят."
                                            },
                                            {
                                                "example_id": "5af8f08c-0c4d-4cbb-97d7-2909701d7c89",
                                                "sense_id": "b0e8d665-acac-3419-bdcb-534b60bbb256",
                                                "text": "Пивной хмель вдруг вышел из головы, и ему уже казалось, что душа перевернулась вверх ногами."
                                            },
                                            {
                                                "example_id": "48807719-5bae-4710-ae3a-1af9f481c63d",
                                                "sense_id": "b0e8d665-acac-3419-bdcb-534b60bbb256",
                                                "text": "Из окон кабачков мирно струился свет, завсегдатаи не спеша мочили усы в пивной пене."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
