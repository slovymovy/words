{
    "word_family": [
        "relayer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "102cc9e9-a2ac-34a8-8d1c-3a2d0775c843",
                    "sense_definition": "To pass on or transfer information, a message, or a signal from one person or place to another.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The CCTV cameras <w>relay</w> what is going on to the headquarters in real time.",
                            "target_lang_translations": {
                                "ru": "Камеры видеонаблюдения <w>транслируют</w> происходящее в штаб-квартиру в режиме реального времени.",
                                "zh": "闭路电视摄像头实时向总部<w>转播</w>现场情况。"
                            }
                        },
                        {
                            "text": "Please <w>relay</w> a message to the team about the change in the meeting schedule.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>передай</w> команде сообщение об изменении в расписании встреч.",
                                "zh": "请向团队<w>转达</w>会议时间变更的消息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "convey"
                    ],
                    "common_phrases": [
                        "relay a message",
                        "relay information",
                        "relay the signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать информацию, сообщение или сигнал от одного человека или места другому.",
                        "zh": "传递信息、消息或信号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "сообщать информацию или сигнал"
                            },
                            {
                                "target_lang_word": "транслировать",
                                "target_lang_sense_clarification": "передавать сигнал или изображение"
                            },
                            {
                                "target_lang_word": "переслать",
                                "target_lang_sense_clarification": "отправить полученное сообщение дальше"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传递",
                                "target_lang_sense_clarification": "传达信息或信号"
                            },
                            {
                                "target_lang_word": "转达",
                                "target_lang_sense_clarification": "代为传达消息"
                            },
                            {
                                "target_lang_word": "转播",
                                "target_lang_sense_clarification": "转送信号或影像"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "735b9d1e-38d1-3017-ae2b-133b62546ca3",
                    "sense_definition": "To arrange or place people or animals in stages so that one can take over from another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The riders were <w>relayed</w> across the desert to ensure the mail arrived quickly.",
                            "target_lang_translations": {
                                "ru": "Всадников <w>расставили сменами</w> по всей пустыне, чтобы почта была доставлена быстро.",
                                "zh": "骑手们在沙漠中通过<w>轮换</w>以确保邮件快速送达。"
                            }
                        },
                        {
                            "text": "They decided to <w>relay</w> the horses at specific intervals along the mountain path.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>сменять</w> лошадей через определенные промежутки пути на горной тропе.",
                                "zh": "他们决定在山路沿途的特定间隔处<w>换马</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расставлять людей или животных этапами, чтобы один мог сменить другого.",
                        "zh": "分阶段安排人员或动物，以便轮换。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расставлять сменами",
                                "target_lang_sense_clarification": "для обеспечения непрерывности движения"
                            },
                            {
                                "target_lang_word": "сменять",
                                "target_lang_sense_clarification": "очередность в работе или пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮换",
                                "target_lang_sense_clarification": "交替进行工作或行程"
                            },
                            {
                                "target_lang_word": "接力",
                                "target_lang_sense_clarification": "通过接替方式完成任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37bec351-e0b4-3a92-9e44-5e88bab84493",
                    "sense_definition": "To lay something down again, such as floor tiles, cables, or railroad tracks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>relay</w> the carpet because it was not aligned correctly.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>перестилать</w> ковер, так как он был выровнен неправильно.",
                                "zh": "工人不得不<w>重铺</w>地毯，因为它没对齐。"
                            }
                        },
                        {
                            "text": "The city plans to <w>relay</w> the tracks to accommodate the new high-speed trains.",
                            "target_lang_translations": {
                                "ru": "Город планирует <w>переложить</w> пути, чтобы приспособить их для новых скоростных поездов.",
                                "zh": "城市计划<w>重铺</w>轨道以适应新的高速列车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "relay the floor",
                        "relay the tracks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заново укладывать что-либо, например, плитку, кабели или железнодорожные пути.",
                        "zh": "重新铺设，如地板、地毯、电缆或铁轨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекладывать",
                                "target_lang_sense_clarification": "плитку, пол или кирпич"
                            },
                            {
                                "target_lang_word": "перестилать",
                                "target_lang_sense_clarification": "ковер или покрытие"
                            },
                            {
                                "target_lang_word": "перемонтировать",
                                "target_lang_sense_clarification": "кабели или пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重铺",
                                "target_lang_sense_clarification": "重新铺设地面或轨道"
                            },
                            {
                                "target_lang_word": "重新安装",
                                "target_lang_sense_clarification": "重新布置线路或设备"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "420d2897-150b-34cc-b1bb-cd22b7c50d06",
                    "sense_definition": "A race or competition between teams where each member completes a specific part of the course.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our school won the gold medal in the four by one hundred meter <w>relay</w>.",
                            "target_lang_translations": {
                                "ru": "Наша школа завоевала золотую медаль в <w>эстафете</w> четыре по сто метров.",
                                "zh": "我们学校在四百米<w>接力赛</w>中赢得了金牌。"
                            }
                        },
                        {
                            "text": "The runners practiced passing the baton for the upcoming <w>relay</w> race.",
                            "target_lang_translations": {
                                "ru": "Бегуны тренировались передавать палочку для предстоящей <w>эстафеты</w>.",
                                "zh": "跑步运动员们为即将到来的<w>接力赛</w>练习交接棒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "relay race"
                    ],
                    "common_phrases": [
                        "swimming relay",
                        "anchor the relay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гонка или соревнование между командами, где каждый участник проходит определенную часть дистанции.",
                        "zh": "团队间的接力比赛，每位成员完成赛程的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эстафета",
                                "target_lang_sense_clarification": "спортивное соревнование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接力赛",
                                "target_lang_sense_clarification": "体育竞技项目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b52aadd2-92cd-3ef2-ad22-15dec508e774",
                    "sense_definition": "An electrical device that uses a small current to control a much larger current in another circuit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician replaced the faulty <w>relay</w> to get the cooling system working again.",
                            "target_lang_translations": {
                                "ru": "Техник заменил неисправное <w>реле</w>, чтобы система охлаждения снова заработала.",
                                "zh": "技术员更换了故障<w>继电器</w>，使冷却系统恢复工作。"
                            }
                        },
                        {
                            "text": "An electromagnetic <w>relay</w> is used to switch the high-voltage motor on and off.",
                            "target_lang_translations": {
                                "ru": "Электромагнитное <w>реле</w> используется для включения и выключения высоковольтного двигателя.",
                                "zh": "电磁<w>继电器</w>用于控制高压电机的开关。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "electrical relay",
                        "control relay"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическое устройство, использующее слабый ток для управления более сильным током в другой цепи.",
                        "zh": "一种利用小电流控制另一电路中大电流的电气装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реле",
                                "target_lang_sense_clarification": "электротехническое устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "继电器",
                                "target_lang_sense_clarification": "电子控制元件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e17fc6-64c2-3c4f-821b-b41fb23da18b",
                    "sense_definition": "A fresh set of horses or animals kept at a station to replace tired ones on a long journey.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stagecoach stopped at the inn to pick up a fresh <w>relay</w> of horses.",
                            "target_lang_translations": {
                                "ru": "Дилижанс остановился у постоялого двора, чтобы взять свежую <w>смену</w> лошадей.",
                                "zh": "驿站马车在旅店停下，换了一批<w>备用</w>马匹。"
                            }
                        },
                        {
                            "text": "Without a <w>relay</w> of horses, the journey across the plains would take weeks.",
                            "target_lang_translations": {
                                "ru": "Без <w>сменных</w> лошадей путешествие через равнины заняло бы недели.",
                                "zh": "如果没有<w>换乘</w>的马匹，穿越平原的旅程将耗时数周。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "relay of horses"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сменная группа лошадей или других животных, содержащаяся на станции для замены уставших в долгом пути.",
                        "zh": "在长途旅行中，为替换疲惫的动物而准备的备用组。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смена",
                                "target_lang_sense_clarification": "запасные лошади на станции"
                            },
                            {
                                "target_lang_word": "подстава",
                                "target_lang_sense_clarification": "исторический термин для сменных лошадей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "换乘",
                                "target_lang_sense_clarification": "更换交通工具或牲畜"
                            },
                            {
                                "target_lang_word": "备用",
                                "target_lang_sense_clarification": "替换用的牲畜"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}