            {
                "entry_id": "47e5590e-1d40-360b-924e-2475c89d4813",
                "word": "Indus",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1868f914-86c9-393f-aa0d-e8393766d1bb",
                        "entry_id": "47e5590e-1d40-360b-924e-2475c89d4813",
                        "glosses": [
                            "Fleuve d’Asie qui prend sa source en Chine, passe par le Pakistan et l’Inde et se jette dans l’océan Indien, et qui a donné son nom à l’Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030d43b4-f024-4dc8-8b3e-09c8fa728f8f",
                                "sense_id": "1868f914-86c9-393f-aa0d-e8393766d1bb",
                                "text": "Le Pakistan et le nord-ouest de l’Inde dépendent des eaux de l’Indus, le Nord-Est de l’Inde et le Bengladesh des eaux du Brahmapoutre, le Nord de l’Inde des eaux du Gange."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f00b113-638c-327c-b64c-545b58964d2d",
                        "entry_id": "47e5590e-1d40-360b-924e-2475c89d4813",
                        "glosses": [
                            "Dieu-fleuve associé à ce fleuve, dans la mythologie gréco-romaine."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ffefd7b-8836-4b1e-83ba-a52e54c1a732",
                        "source_entry_id": "47e5590e-1d40-360b-924e-2475c89d4813",
                        "target_lang_word": "Indus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
