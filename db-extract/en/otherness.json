                "senses": [
                    {
                        "sense_id": "2541d57a-f769-38e0-9062-a41ecf11c9d9",
                        "entry_id": "ff687ad6-5eb8-3cb1-9c1e-d2a14bbb10a7",
                        "glosses": [
                            "The quality of being different or distinct."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2925fd04-72e6-412c-83ca-08f4e697d5b7",
                                "sense_id": "2541d57a-f769-38e0-9062-a41ecf11c9d9",
                                "text": "As Floya Anthias argues in her chapter, there is a need to fight against all those constructions of difference and identity that exclude and devalorise, and against all those social practices that construct identities and differences in naturalised, collectivised and binary ways and in terms of hierarchical otherness, unequal resource allocation and modes of inferiorisation (see also Anthias 1998a)."
                            }
                        ]
                    },
                    {
                        "sense_id": "adf4b88f-2996-3b7c-8de8-8545e1afe0ac",
                        "entry_id": "ff687ad6-5eb8-3cb1-9c1e-d2a14bbb10a7",
                        "glosses": [
                            "The result or product of being different or distinct."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2c91552-4467-442b-b9fa-07a75b1eb1fb",
                        "source_entry_id": "ff687ad6-5eb8-3cb1-9c1e-d2a14bbb10a7",
