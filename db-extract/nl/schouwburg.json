                                            {
                                                "example_id": "37599a70-34c2-4931-a987-92a4d21d97fd",
                                                "sense_id": "9cba4cb2-ffc3-3a67-b636-87b650f6f405",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            },
                                            {
                                                "example_id": "f9c9e7be-f11a-4bde-9382-3c202a59a4f3",
                                                "sense_id": "9cba4cb2-ffc3-3a67-b636-87b650f6f405",
                                                "text": "City's players and supporters travelled from one end of the emotional scale to the other in those vital seconds, providing a truly remarkable piece of football theatre and the most dramatic conclusion to a season in Premier League history."
                                            },
                                            {
                                                "example_id": "4d4b4609-bcfe-4b98-9494-faadd32c6088",
                                                "sense_id": "9cba4cb2-ffc3-3a67-b636-87b650f6f405",
                                                "text": "But the picture was different elsewhere - Theatre Royal Windsor recorded full houses, although the managing director stated that the actors had trouble getting to and from the theatre."
                                            }
                                        ]
                                    },
