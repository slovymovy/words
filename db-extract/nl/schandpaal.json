                                        "sense_id": "447c3d91-ffa4-3497-94fb-4be573745f3a",
                                        "entry_id": "2e9b097b-714e-3e01-90ea-6b12748ad818",
                                        "glosses": [
                                            "an einem öffentlichen Ort errichtetes, aufrecht stehendes Bauteil aus Holz oder Stein, an dem eine Person zur Strafe festgemacht wird"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15799d3b-1b9f-4c31-9394-1b4cf729b6c0",
                                                "sense_id": "447c3d91-ffa4-3497-94fb-4be573745f3a",
                                                "text": "„Bei uns müßtet Ihr ob solcher dreisten Worte, verkehrt auf einem Esel gebunden, durch die Stadt reiten und am Schandpfahl stehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
