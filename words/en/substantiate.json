{
    "word_family": [
        "substance",
        "substantial",
        "substantially",
        "substantiation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92be2035-4f02-319e-bc0a-e54da8985be4",
                    "sense_definition": "To verify or prove the truth of something by providing evidence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was asked to <w>substantiate</w> her claims with official documents.",
                            "target_lang_translations": {
                                "pl": "Poproszono prawniczkę, aby <w>poparła dowodami</w> swoje roszczenia za pomocą oficjalnych dokumentów."
                            }
                        },
                        {
                            "text": "He could not <w>substantiate</w> the rumors with any reliable evidence.",
                            "target_lang_translations": {
                                "pl": "Nie potrafił <w>potwierdzić</w> tych plotek żadnymi wiarygodnymi dowodami."
                            }
                        }
                    ],
                    "synonyms": [
                        "verify",
                        "corroborate",
                        "authenticate",
                        "validate",
                        "confirm"
                    ],
                    "antonyms": [
                        "refute",
                        "disprove",
                        "contradict"
                    ],
                    "common_phrases": [
                        "substantiate a claim",
                        "substantiate allegations"
                    ],
                    "target_lang_definitions": {
                        "pl": "Potwierdzić lub udowodnić prawdziwość czegoś poprzez przedstawienie dowodów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "potwierdzić",
                                "target_lang_sense_clarification": "najbardziej ogólne określenie na uwiarygodnienie informacji"
                            },
                            {
                                "target_lang_word": "poprzeć dowodami",
                                "target_lang_sense_clarification": "wskazuje na użycie konkretnych argumentów lub dokumentów"
                            },
                            {
                                "target_lang_word": "udowodnić",
                                "target_lang_sense_clarification": "wskazuje na wykazanie słuszności twierdzenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f257bd84-b0c3-300e-8786-3d4febb65809",
                    "sense_definition": "To give physical form or concrete substance to an idea or concept.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "embody",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect sought to <w>substantiate</w> his abstract vision into a tangible building design.",
                            "target_lang_translations": {
                                "pl": "Architekt starał się <w>zmaterializować</w> swoją abstrakcyjną wizję w namacalny projekt budynku."
                            }
                        },
                        {
                            "text": "The artist managed to <w>substantiate</w> her complex emotions through a series of powerful sculptures.",
                            "target_lang_translations": {
                                "pl": "Artystce udało się <w>ucieleśnić</w> swoje złożone emocje poprzez serię poruszających rzeźb."
                            }
                        }
                    ],
                    "synonyms": [
                        "embody",
                        "materialize",
                        "realize"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nadać fizyczną formę lub konkretną postać idei lub koncepcji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ucieleśnić",
                                "target_lang_sense_clarification": "nadanie idei fizycznej lub widzialnej formy"
                            },
                            {
                                "target_lang_word": "zmaterializować",
                                "target_lang_sense_clarification": "przekształcenie koncepcji w coś namacalnego"
                            },
                            {
                                "target_lang_word": "urzeczywistnić",
                                "target_lang_sense_clarification": "sprawienie, że coś staje się rzeczywistością"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}