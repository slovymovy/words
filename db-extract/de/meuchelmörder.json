                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc970a8-60fc-4fd1-a782-143ff3f77665",
                                "sense_id": "8403b18d-43b4-3903-a4ff-20b36e6caadf",
                                "text": "In der Region treibt ein Meuchelmörder sein Unwesen."
                            },
                            {
                                "example_id": "6c8feb14-76f2-4a4a-bd1d-697c00efc5eb",
                                "sense_id": "8403b18d-43b4-3903-a4ff-20b36e6caadf",
                                "text": "„Ich erwiderte ihr, ich hätte geträumt, sie sei so böse auf mich, daß sie mit Meuchelmördern gesprochen hätte, um mich umbringen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
