                "senses": [
                    {
                        "sense_id": "a5452e0d-68fa-3cbd-bf53-7a0c9cb7ea70",
                        "entry_id": "56f8fd0d-d247-39c0-8fab-5ef6c45a2db7",
                        "glosses": [
                            "eine Gattung der Libellen"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5a3a3949-6006-48d9-aaa1-21918077683f",
                                "sense_id": "a5452e0d-68fa-3cbd-bf53-7a0c9cb7ea70",
                                "text": "„Bei uns werden die Arten je nach Autor auf 5–8 Gattungen verteilt: Pokaljungfern oder Pokal-Azurjungfern (Cercion), Rubinjungfern (Ceriagrion), Becherjungfern oder Becher-Azurjungfern (Enallagma), Granataugen (Erythromma), Pechlibellen (Ischnura), Zwerglibellen (Nehallenia), Adonislibellen (Pyrrhosoma) und die artenreichsten Azurjungfern (Coenagrion, früher Agrion).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a8f71a7-b362-3c78-b9b7-6d088a1e6d45",
                        "entry_id": "56f8fd0d-d247-39c0-8fab-5ef6c45a2db7",
                        "glosses": [
                            "Vertreter der Gattung von [1] und kleinste Libelle Europas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c95526ef-c45a-42b5-8917-72f18a2bc9dc",
                                "sense_id": "4a8f71a7-b362-3c78-b9b7-6d088a1e6d45",
                                "text": "„Verbreitet war die Zwerglibelle bisher noch von Deutschland bis Sibirien.“"
                            },
                            {
                                "example_id": "00dc91bc-7fdf-49d8-bb61-ab67ccc23286",
                                "sense_id": "4a8f71a7-b362-3c78-b9b7-6d088a1e6d45",
                                "text": "„Die Zwerglibelle (Nehalennia speciosa) sei jetzt wieder im Jura-Massiv gesichtet worden, nachdem sie seit 1876 nicht mehr in Frankreich gesehen worden sei.“"
                            },
                            {
                                "example_id": "27a3e6ad-57eb-404c-ac51-8389ce34a2a8",
                                "sense_id": "4a8f71a7-b362-3c78-b9b7-6d088a1e6d45",
                                "text": "„Jeder, der die Zwerglibelle schon einmal gesehen hat, wird begeistert sein.“"
                            },
                            {
                                "example_id": "5e8efc46-82c9-403e-a0a1-2d72191684c1",
                                "sense_id": "4a8f71a7-b362-3c78-b9b7-6d088a1e6d45",
                                "text": "„Im Sphagnum-Moor des zentralen Bereichs, in den Großseggenwiesen und am Randweiher der Schwemm kommt die Zwerglibelle laut LEHMANN (1990) hingegen nur als Gast vor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b19b123e-14fe-4d3e-98c4-c92cdeba6754",
