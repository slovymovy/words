                        "entry_id": "52a35c1e-c660-3ab8-8030-248bf1e935e0",
                        "glosses": [
                            "een voorgestelde manier om het Israëlisch-Palestijns conflict te beëindigen, door twee onafhankelijke staten op te richten op het grondgebied van het voormalige mandaatgebied Palestina (historisch Palestina)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2d5506-08d9-4ac7-a0f4-2507f2a12346",
                                "sense_id": "add6f44e-9074-3dd5-9e29-7cfdbcd4fa5b",
                                "text": "Sjoerd Sjoerdsma van D66 zegt dat Trump een bom legt onder de tweestatenoplossing. Hij noemt het voornemen roekeloos. \"Waarom zou je een fragiele regio doelbewust verder destabiliseren?\", vraagt Sjoerdsma zich af."
                            },
                            {
                                "example_id": "66f24793-2930-4a42-a011-9786ff757c67",
                                "sense_id": "add6f44e-9074-3dd5-9e29-7cfdbcd4fa5b",
                                "text": "EU-buitenlandcoördinator Mogherini zei gisteren al dat de Europese Unie voorstander is van de tweestatenoplossing en dat elk proces dat die ondermijnt, moet worden vermeden."
                            }
                        ]
                    }
