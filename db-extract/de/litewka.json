                "senses": [
                    {
                        "sense_id": "dc52499d-9bce-3268-88ff-79c10f4c0d19",
                        "entry_id": "d75c01fa-24f6-3e8d-93d9-6d101a3181ea",
                        "glosses": [
                            "bequeme Jacke einer Uniform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f775a7e-a00c-4b3f-9360-3c9b859af707",
                                "sense_id": "dc52499d-9bce-3268-88ff-79c10f4c0d19",
                                "text": "„Seine Litewka liegt vor ihm.“"
                            },
                            {
                                "example_id": "09aa24e8-bc36-4426-b627-40d0cc038222",
                                "sense_id": "dc52499d-9bce-3268-88ff-79c10f4c0d19",
                                "text": "„Und damit wir bloß nicht davon reden, zeigt sie uns noch mal die beiden Litewkas ihrer beiden Söhne, die hat sie extra mitgebracht, zeigt uns die Schußlöcher und die Blutflecke im Schein der Kerze, ganz nah, immer näher…“"
                            },
                            {
                                "example_id": "0c6c5a4d-6429-4a48-bf1d-338eb4880236",
                                "sense_id": "dc52499d-9bce-3268-88ff-79c10f4c0d19",
                                "text": "„Die Tür zum Pagelschen Zimmer geht auf, und in ihr steht der junge Wolfgang Pagel, groß, mit breiten Schultern und schmalen Hüften, dem hellen, fröhlichen Gesicht, in seiner feldgrauen Litewka mit den schmalen, roten Streifen - es ist ein Stoff, der selbst jetzt, nach fünfjährigem Gebrauch, noch gut aussieht, sanftsilbrig glänzend wie manche Lindenblätter…“"
                            },
                            {
                                "example_id": "2181714b-0357-443a-bcc3-0ae87c26fdda",
                                "sense_id": "dc52499d-9bce-3268-88ff-79c10f4c0d19",
                                "text": "„Schlump, dem sein schäbiger Rock schon lange nicht mehr gefiel, sprang herzu und krampfte eine schöne, neue Litewka.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
