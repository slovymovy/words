                        "entry_id": "f4bc06e1-5ff3-32d6-9900-976ff062ec3d",
                        "glosses": [
                            "Habitant du Havre, commune française située dans le département de la Seine-Maritime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81716d01-854a-4ba6-a987-6f5378ee44db",
                                "sense_id": "23ac1d0c-b56e-32ca-8a82-7a7fd44ca69a",
                                "text": "Et les Havrais sont nombreux à flâner sur cette promenade quand le soleil se couche."
                            },
                            {
                                "example_id": "2a67f8cf-f16e-4ada-ad8d-049933a772c5",
                                "sense_id": "23ac1d0c-b56e-32ca-8a82-7a7fd44ca69a",
                                "text": "Les Havrais préfèrent les Renault aux Peugeot et les chiens aux chats."
                            },
                            {
                                "example_id": "e0b8a272-d526-4b56-b833-87c32b8f950e",
                                "sense_id": "23ac1d0c-b56e-32ca-8a82-7a7fd44ca69a",
                                "text": "Édouard Philippe, alors maire et président de l’agglomération, avait déniché pas moins de 20 millions d’euros. Un an plus tard, les Havrais se réveillent avec la gueule de bois."
                            }
                        ]
                    }
