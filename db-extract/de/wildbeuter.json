                "senses": [
                    {
                        "sense_id": "d193db55-6ee4-32d7-a541-ff8f89cc3508",
                        "entry_id": "fd561d31-0c89-3b78-a507-347b3263f23d",
                        "glosses": [
                            "Menschen, die ihren Lebensunterhalt ausschließlich durch Sammeln wilder Pflanzen und durch die Jagd wilder Tiere bestreiten"
                        ],
                        "tags": [
                            "Völkerkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "bb80bbbb-a7f2-4582-b6a2-38f84fd99521",
                                "sense_id": "d193db55-6ee4-32d7-a541-ff8f89cc3508",
                                "text": "„In Gegensatz zu ihren Nachfahren der Agrar- und Industriegesellschaft hatten die Wildbeuter so gut wie keinen Besitz, und Dinge spielten in ihrem Leben nur eine sehr untergeordnete Rolle.“"
                            },
                            {
                                "example_id": "ba18e07a-0242-4c0e-869e-2a9470ff94c6",
                                "sense_id": "d193db55-6ee4-32d7-a541-ff8f89cc3508",
                                "text": "Reine Wildbeuter gibt es heutzutage fast kaum noch."
                            },
                            {
                                "example_id": "388ec7da-766f-49c4-9676-bd0abab8e24c",
                                "sense_id": "d193db55-6ee4-32d7-a541-ff8f89cc3508",
                                "text": "„Die Menschen der Westküste lebten als Wildbeuter: Sie fingen Lachse, sammelten Muscheln, jagten Wild und zerrieben Eicheln zu Mehl, um daraus Fladenbrote zu backen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
