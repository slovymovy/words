                        "glosses": [
                            "Relatif au Biafra, à un type de végétation typique de cette région."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dfb4943-94c3-4507-954a-6bad9b251e02",
                                "sense_id": "724e52a5-07d6-38ee-904d-eedcc7b574e9",
                                "text": "D’après les études menées dans la région des hautes terres du Cameroun, les spécialistes sont formels que la végétation originelle dans cette région du Cameroun fur la forêt biafrienne à césalpiniacées."
                            },
                            {
                                "example_id": "cb5f7479-1f35-4946-95fb-f9ce551a4048",
                                "sense_id": "724e52a5-07d6-38ee-904d-eedcc7b574e9",
                                "text": "C’est la forêt toujours verte sempervirente dite biafrienne, hyper humide au nord-ouest vu l’abondance des pluies."
                            }
                        ]
                    }
