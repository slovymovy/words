{
    "word_family": [
        "cook"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f152e2a-4e4f-3fe1-96e2-23f1c4618d82",
                    "sense_definition": "A small, sweet, baked treat, typically round and flat.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She baked a fresh <w>cooky</w> for her grandson.",
                            "target_lang_translations": {
                                "fr": "Elle a préparé un <w>biscuit</w> frais pour son petit-fils."
                            }
                        },
                        {
                            "text": "The child enjoyed eating a chocolate chip <w>cooky</w>.",
                            "target_lang_translations": {
                                "fr": "L'enfant a aimé manger un <w>cookie</w> aux pépites de chocolat."
                            }
                        }
                    ],
                    "synonyms": [
                        "biscuit"
                    ],
                    "common_phrases": [
                        "dunk a cooky"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This spelling is an older variant of the modern word cookie."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un petit gâteau sucré, généralement rond et plat."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "biscuit",
                                "target_lang_sense_clarification": "Terme général pour un petit gâteau sec."
                            },
                            {
                                "target_lang_word": "cookie",
                                "target_lang_sense_clarification": "Emprunt à l'anglais désignant spécifiquement le biscuit aux pépites de chocolat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "219fce7e-98d5-3df7-ac78-099b0745b9c7",
                    "sense_definition": "The contents of the stomach, often used in the context of vomiting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt so ill that he started to lose his <w>cookies</w>.",
                            "target_lang_translations": {
                                "fr": "Il se sentait si mal qu'il a commencé à <w>vomir</w>."
                            }
                        },
                        {
                            "text": "The rough boat ride made everyone want to toss their <w>cookies</w>.",
                            "target_lang_translations": {
                                "fr": "La traversée agitée en bateau a donné envie à tout le monde de <w>rendre</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toss one's cookies",
                        "lose one's cookies"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to refer to vomiting."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Expression familière désignant le fait de vomir."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vomir",
                                "target_lang_sense_clarification": "Terme standard pour l'action de rejeter le contenu de l'estomac."
                            },
                            {
                                "target_lang_word": "rendre",
                                "target_lang_sense_clarification": "Terme familier pour vomir."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3617f494-19b8-3a09-8384-67eec38a8e66",
                    "sense_definition": "A misspelling of the adjective <w>kooky</w>, meaning strange or eccentric.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>cooky</w> behavior made everyone in the room feel uncomfortable.",
                            "target_lang_translations": {
                                "fr": "Son comportement <w>excentrique</w> mettait tout le monde mal à l'aise dans la pièce."
                            }
                        },
                        {
                            "text": "She has a <w>cooky</w> sense of humor that not everyone understands.",
                            "target_lang_translations": {
                                "fr": "Elle a un sens de l'humour <w>farfelu</w> que tout le monde ne comprend pas."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentric",
                        "strange",
                        "quirky"
                    ],
                    "antonyms": [
                        "normal",
                        "sane"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une orthographe erronée de l'adjectif 'kooky', signifiant étrange ou excentrique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "excentrique",
                                "target_lang_sense_clarification": "Qui sort de l'ordinaire de manière originale ou bizarre."
                            },
                            {
                                "target_lang_word": "bizarre",
                                "target_lang_sense_clarification": "Qui est étrange ou inhabituel."
                            },
                            {
                                "target_lang_word": "farfelu",
                                "target_lang_sense_clarification": "Qui est un peu fou ou étrange de manière amusante."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}