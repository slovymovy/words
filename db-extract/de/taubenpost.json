                "senses": [
                    {
                        "sense_id": "83e4e882-160c-3ecc-a91e-7a2e6d19449d",
                        "entry_id": "ab00fa3c-716e-3409-844e-55c691fe0a5d",
                        "glosses": [
                            "Beförderung von schriftlichen Mitteilungen durch Brieftauben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2f482b4-61e1-483e-af3f-e1dd2645a800",
                                "sense_id": "83e4e882-160c-3ecc-a91e-7a2e6d19449d",
                                "text": "Die Taubenpost wurde nach dem Zweiten Weltkrieg fast völlig von modernen Telekommunikationsmitteln verdrängt."
                            },
                            {
                                "example_id": "4aca3645-4408-42f9-9fdb-df93aa2bd3b6",
                                "sense_id": "83e4e882-160c-3ecc-a91e-7a2e6d19449d",
                                "text": "„Der römische Offizier Brutus nutzte die Taubenpost zum Austausch mit seinen Verbündeten, als er 43 vor Christus von Marcus Antonius in Mutina (heute Modena) belagert wurde.“"
                            },
                            {
                                "example_id": "4a0fb53f-b03b-48ba-98c9-2b03bcfb27fa",
                                "sense_id": "83e4e882-160c-3ecc-a91e-7a2e6d19449d",
                                "text": "„Interessante Formen nahm die Taubenpost im 19. Jahrhundert an.“"
                            },
                            {
                                "example_id": "31504a87-05b2-447a-8537-e324cd9d9d32",
                                "sense_id": "83e4e882-160c-3ecc-a91e-7a2e6d19449d",
                                "text": "„Wenden wir uns zunächst der Taubenpost zu.“"
                            },
                            {
                                "example_id": "19598ebd-3423-4c47-8d85-e2dad437d6a1",
                                "sense_id": "83e4e882-160c-3ecc-a91e-7a2e6d19449d",
                                "text": "„Taubenpostmarken der Great Barrier Pigeongram Agency und des Original Great Barrier Pigeongram Service aus dem 19. Jahrhundert sowie philatelistische Würdigung des 100. Jubiläums der Taubenpost von 1997 (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
