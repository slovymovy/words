                    },
                    {
                        "translation_id": "fa92915c-cb5d-470f-8bb6-b388c914aade",
                        "source_entry_id": "e8d34c35-2f4e-3675-9123-cdc89c4bdce2",
                        "source_sense_id": "3cad1043-3121-3521-a898-b2528eac9c0c",
                        "target_lang_word": "antisocial",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antisocial",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "78b75f98-855a-3eab-aef8-7ad26adefbbe",
                                        "entry_id": "d4dfe6a4-4baf-39c8-8d99-b57f4a028b2c",
                                        "glosses": [
                                            "Persona incapaz de adaptarse al orden social. No acepta ser gregario o parte de la sociedad a la cual rechaza y detesta, llegando incluso por sus propias convicciones a atentar contra cualquiera de ellos sin distingo o diferenciacion alguna."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
