                            {
                                "example_id": "20b1d1df-e7ae-47e2-ae65-9abfcfddb7bb",
                                "sense_id": "3594d41c-d3a3-33b2-8d67-8ee9d5723eb1",
                                "text": "Der Säugling trägt ein gestricktes Mützchen."
                            },
                            {
                                "example_id": "2ff2f888-b387-48e3-9f50-bf91cda9a338",
                                "sense_id": "3594d41c-d3a3-33b2-8d67-8ee9d5723eb1",
                                "text": "„Das Kind hatte ein Mützchen auf mit goldenen Biesen und den acht Glückszeichen und trug dazu einen tiefroten Rock, weiß-seidene Strümpfe und Atlasschuhe.“"
                            }
