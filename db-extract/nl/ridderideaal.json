                        "glosses": [
                            "de nobele idealen van middeleeuwse ridders; de gedragscode van middeleeuwse ridders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f73e03-5311-4eaf-8800-513a8f1f1ba8",
                                "sense_id": "06521dc2-a424-32bb-aade-eb2984b64d7f",
                                "text": "Zo'n heer, die zich geheel inzette voor de verwezenlijking van het ridderideaal, bleef geen tijd over voor een vrouw en een gezin."
                            },
                            {
                                "example_id": "b3f1c96b-6933-474c-8054-2d990061b957",
                                "sense_id": "06521dc2-a424-32bb-aade-eb2984b64d7f",
                                "text": "Gaat de dienst aan het ridderideaal volstrekt voor de dienst aan de beminde vrouw? Moet de ridder de liefde wantrouwen omdat zij hem al te spoedig heldendaden en glorie doet vergeten?' Aldus merkt Jean Pierre Foucher op in zijn inleiding tot Chrétiens Yvain, le chevalier au lion."
                            }
                        ]
                    }
