{
    "word_family": [
        "kanarek",
        "kanarkowy",
        "kanarowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70b8043c-58db-3d85-a824-ae2663496bb8",
                    "sense_definition": "kontroler biletów w komunikacji miejskiej lub kolejowej",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kontroler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marian próbował wcisnąć <w>kanarowi</w> stary bilet, ale ten nie dał się nabrać.",
                            "target_lang_translations": {
                                "ru": "Мариан попытался подсунуть <w>контролёру</w> старый билет, но тот не попался на уловку."
                            }
                        },
                        {
                            "text": "Kiedy do tramwaju wszedł <w>kanar</w>, pasażerowie zaczęli nerwowo szukać swoich biletów.",
                            "target_lang_translations": {
                                "ru": "Когда в трамвай зашёл <w>контролёр</w>, пассажиры начали нервно искать свои билеты."
                            }
                        }
                    ],
                    "synonyms": [
                        "kontroler",
                        "konduktor",
                        "gw. (Górny Śląsk) kobuch"
                    ],
                    "common_phrases": [
                        "kontrola kanara",
                        "uciec przed kanarem"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "potoczne określenie kontrolera biletów"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "контролёр билетов в общественном транспорте или на железной дороге"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контролёр",
                                "target_lang_sense_clarification": "билетный контролёр в транспорте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b84709f2-3711-3930-a425-2bf2cad41a21",
                    "sense_definition": "zgrubienie od <w>kanarek</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ptak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten żółty ptak w klatce to prawdziwy wielki <w>kanar</w>, który głośno śpiewa od rana.",
                            "target_lang_translations": {
                                "ru": "Эта жёлтая птица в клетке — настоящий здоровенный <w>кенар</w>, который громко поёт с самого утра."
                            }
                        },
                        {
                            "text": "Kupiliśmy w sklepie zoologicznym dużego <w>kanara</w> o pięknych, jaskrawych piórach.",
                            "target_lang_translations": {
                                "ru": "Мы купили в зоомагазине крупную <w>канарейку</w> с красивыми, яркими перьями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "zgrubienie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "увеличительное к слову «kanarek» (канарейка)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канарейка",
                                "target_lang_sense_clarification": "крупная птица"
                            },
                            {
                                "target_lang_word": "кенар",
                                "target_lang_sense_clarification": "самец канарейки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a577185e-037b-3744-8f81-3d4f4f6f3c0d",
                    "sense_definition": "roślina z rodziny traw, mozga kanaryjska, uprawiana na paszę i ziarno dla ptaków",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "roslina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnik zasiał na niewielkim polu <w>kanar</w>, aby mieć karmę dla hodowanych ptaków.",
                            "target_lang_translations": {
                                "ru": "Фермер засеял на небольшом поле <w>канареечник</w>, чтобы иметь корм для птиц."
                            }
                        },
                        {
                            "text": "Dojrzały <w>kanar</w> kołysał się na wietrze przed zbiorem nasion.",
                            "target_lang_translations": {
                                "ru": "Созревший <w>канареечник</w> колыхался на ветру перед сбором семян."
                            }
                        }
                    ],
                    "synonyms": [
                        "mozga kanaryjska",
                        "trawa kanarkowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "растение семейства злаков (канареечник канарский), выращиваемое на корм и зерно для птиц"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канареечник",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "канареечник канарский",
                                "target_lang_sense_clarification": "ботаническое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1826a273-1a18-3d08-8084-d8464b9ae902",
                    "sense_definition": "ziarno mozgi kanaryjskiej używane jako karma dla ptaków domowych",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "roslina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wsypałem świeży <w>kanar</w> do karmnika w klatce moich papug.",
                            "target_lang_translations": {
                                "ru": "Я насыпал свежее <w>канареечное семя</w> в кормушку в клетке моих попугаев."
                            }
                        },
                        {
                            "text": "Mieszanka ziaren zawierała głównie proso oraz drobny <w>kanar</w> dla ptaków.",
                            "target_lang_translations": {
                                "ru": "Зерновая смесь содержала в основном просо и мелкое <w>канареечное семя</w> для птиц."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "зерно канареечника, используемое в качестве корма для домашних птиц"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канареечное семя",
                                "target_lang_sense_clarification": "зерно для птиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66efad4e-1dec-38c5-8279-1b96d0e19c18",
                    "sense_definition": "żandarm lub policjant wojskowy w przedwojennej Polsce, noszący żółty otok na czapce",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wojsko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na przedwojennej ulicy Warszawy pojawił się wojskowy <w>kanar</w> pilnujący porządku.",
                            "target_lang_translations": {
                                "ru": "На довоенной улице Варшавы появился военный <w>жандарм</w>, следивший за порядком."
                            }
                        },
                        {
                            "text": "Żołnierze na przepustce z daleka wypatrywali <w>kanara</w>, by uniknąć kłopotów z dyscypliną.",
                            "target_lang_translations": {
                                "ru": "Солдаты в увольнении издалека высматривали <w>патрульного</w>, чтобы избежать проблем с дисциплиной."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "określenie historyczne z okresu międzywojennego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "жандарм или военный полицейский в довоенной Польше, носивший жёлтый околыш на фуражке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жандарм",
                                "target_lang_sense_clarification": "историческое сленговое название польского военного полицейского"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "926a654b-c462-3f0a-8de3-de1f5e810aef",
                    "sense_definition": "dawne słodkie wino sprowadzane z Wysp Kanaryjskich",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wino",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnej Rzeczypospolitej szlachta chętnie piła hiszpański <w>kanar</w> podczas wystawnych uczt.",
                            "target_lang_translations": {
                                "ru": "В старой Речи Посполитой шляхта охотно пила испанское <w>канарское вино</w> во время пышных пиров."
                            }
                        },
                        {
                            "text": "Gospodarz nalał gościom do kielichów aromatyczny, słodki <w>kanar</w> prosto z piwnicy.",
                            "target_lang_translations": {
                                "ru": "Хозяин налил гостям в бокалы ароматное сладкое <w>канарское</w> прямо из погреба."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dawne określenie wina"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "старинное сладкое вино, привозимое с Канарских островов (канарское вино)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канарское вино",
                                "target_lang_sense_clarification": "сорт десертного вина"
                            },
                            {
                                "target_lang_word": "канарское",
                                "target_lang_sense_clarification": "вино"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b5123f3f-d5ff-38a7-b3c3-a4d0a39d27de",
                    "sense_definition": "rzeka w Polsce, lewy dopływ Wisły w Małopolsce",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rzeka",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Niewielka rzeka <w>Kanar</w> przepływa leniwie przez tereny Małopolski w stronę Wisły.",
                            "target_lang_translations": {
                                "ru": "Небольшая река <w>Канар</w> лениво протекает по территории Малопольши в сторону Вислы."
                            }
                        },
                        {
                            "text": "Wędkarze spędzili całe popołudnie nad brzegiem rzeki <w>Kanar</w>, łowiąc ryby.",
                            "target_lang_translations": {
                                "ru": "Рыболовы провели весь день на берегу реки <w>Канар</w>, ловя рыбу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "река в Польше, левый приток Вислы в Малопольше"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Канар",
                                "target_lang_sense_clarification": "название реки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}