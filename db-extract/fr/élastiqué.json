                "translations": [
                    {
                        "translation_id": "11db3595-22ab-459d-a06d-38ad6611618b",
                        "source_entry_id": "b222774f-2c0f-3426-8420-000df207e1e9",
                        "source_sense_id": "4b651a21-02c5-3d07-bf00-3b4600b930bc",
                        "source_sense_description": "Kleidung: mit Gummiband, mit Gummizug",
                        "target_lang_word": "mit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                        "entry_id": "f89d2e81-79c2-3045-868a-98f2ab11c3f0",
                                        "glosses": [
                                            "etwas oder jemandem angeschlossen oder damit als gewisse Einheit verbunden; zusammen"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b50069-98a3-4276-94f4-c3f510790258",
                                                "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                                "text": "Ich gehe mit Freunden spazieren."
                                            },
                                            {
                                                "example_id": "b58c10e0-4eff-4e51-9cff-d2509a7aaf7c",
                                                "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                                "text": "Hier hätten wir dann einen Fernseher mit Fernbedienung."
                                            },
                                            {
                                                "example_id": "626be311-f90f-4a34-b6dc-cc5d0a7afcf6",
                                                "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                                "text": "Mit wem hast du da telefoniert?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                        "entry_id": "f89d2e81-79c2-3045-868a-98f2ab11c3f0",
                                        "glosses": [
                                            "unter Ausnutzung, durch die Hilfe von etwas"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46b4d1e3-7620-4d9f-8b65-a82314f33321",
                                                "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                                "text": "Ich fahre mit dem Auto."
                                            },
                                            {
                                                "example_id": "6e7b3812-f013-465f-8500-368232021202",
                                                "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                                "text": "Wir sind da mit der Seilbahn hochgefahren."
                                            },
                                            {
                                                "example_id": "c2ffb95a-b222-4f0c-a9f6-f5cf8240ea0e",
                                                "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                                "text": "Mit Seehofer besucht erstmals ein bayerischer Ministerpräsident das Nachbarland Tschechien. (Hörfunk-Nachricht zu einer Zeit, in der Horst Seehofer der Ministerpräsident von Bayern ist, nur mit diesem Wissen von Bedeutung 1 unterscheidbar)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d9ddbd5a-e401-3152-8bf6-a331d75a72b7",
                                        "entry_id": "f89d2e81-79c2-3045-868a-98f2ab11c3f0",
                                        "glosses": [
                                            "beim Kämpfen mit einem Gegner (im Wettkampf mit); gegen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c9662-5027-445b-be73-c535532589d3",
                                                "sense_id": "d9ddbd5a-e401-3152-8bf6-a331d75a72b7",
                                                "text": "Im Kampf mit der gegnerischen Mannschaft konnte unser Team ein ehrenwertes Unentschieden erreichen."
                                            },
                                            {
                                                "example_id": "bb9822b3-c236-4963-a5f3-48138d056d87",
                                                "sense_id": "d9ddbd5a-e401-3152-8bf6-a331d75a72b7",
                                                "text": "Ich habe mich noch nicht entschieden, ich ringe noch mit mir, ob ich wirklich einen ganzen Tag frei nehmen soll."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "mit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e906643-cde6-3e37-9fe2-fa4aeb3055bf",
                                        "entry_id": "bab1bd5f-7bed-31c5-b0ff-542c68ae3989",
                                        "glosses": [
                                            "wie andere, zusammen mit anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d7915e-ec26-44ef-ad2c-5535cfb1f538",
                                                "sense_id": "7e906643-cde6-3e37-9fe2-fa4aeb3055bf",
                                                "text": "Dieses Hemd gehört nicht mit in die Buntwäsche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7b9dc69-9dcb-31e1-b15b-d31b63e67cc9",
                                        "entry_id": "bab1bd5f-7bed-31c5-b0ff-542c68ae3989",
                                        "glosses": [
                                            "neben anderen, als eines/einige von mehreren"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a6ae27-c245-45e9-9911-9d8dbbc9e754",
                                                "sense_id": "b7b9dc69-9dcb-31e1-b15b-d31b63e67cc9",
                                                "text": "Das ist mit das interessanteste Verzeichnis und auch eines der wichtigsten."
                                            },
                                            {
                                                "example_id": "fed13667-d8d2-468b-9825-a3ccd80f8b50",
                                                "sense_id": "b7b9dc69-9dcb-31e1-b15b-d31b63e67cc9",
                                                "text": "„Mit die schönsten Gerichtsgebäude in Deutschland sind das Landgericht in Bremen von 1895 und das auf einer Insel gelegene Amtsgericht in Lindau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c52805bf-5ad6-4548-9341-e50362d5628d",
                        "source_entry_id": "b222774f-2c0f-3426-8420-000df207e1e9",
