    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "603b2f62-8b45-3800-8f97-d52253427fa2",
                    "sense_definition": "A dance step where one foot chases the other, commonly used in ballet and ballroom dancing; alternative spelling of <w>chassé</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructor asked the students to perform a <w>chasse</w> across the floor to improve their coordination.",
                            "target_lang_translations": {
                                "ru": "Инструктор попросил учеников выполнить <w>шассе</w> через весь зал, чтобы улучшить координацию."
                            }
                        },
                        {
                            "text": "She executed a perfect <w>chasse</w> step before transitioning into a graceful leap during her routine.",
                            "target_lang_translations": {
                                "ru": "Она безупречно исполнила шаг <w>шассе</w>, прежде чем перейти к изящному прыжку во время своего выступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "chassé"
                    ],
                    "common_phrases": [
                        "chasse step",
                        "triple chasse"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Танцевальный шаг, при котором одна нога как бы догоняет другую; используется в балете и бальных танцах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шассе",
                                "target_lang_sense_clarification": "танцевальное движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94ce256e-fe8e-39cd-a6f8-94683008e311",
                    "sense_definition": "A small drink of spirits or liqueur taken after coffee to remove the taste; a shortened form of <w>chasse-café</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy dinner, he enjoyed a small <w>chasse</w> of brandy to settle his stomach.",
                            "target_lang_translations": {
                                "ru": "После плотного ужина он выпил маленькую рюмку бренди в качестве <w>шассе-кафе</w>, чтобы успокоить желудок."
                            }
                        },
                        {
                            "text": "The waiter offered a <w>chasse</w> to accompany the espresso at the end of the meal.",
                            "target_lang_translations": {
                                "ru": "Официант предложил <w>дижестив</w> к эспрессо в конце трапезы."
                            }
                        }
                    ],
                    "synonyms": [
                        "chasse-café",
                        "digestif"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая порция крепкого алкоголя или ликера, выпиваемая после кофе, чтобы перебить его вкус."
                    },
                    "translations": {
                        "ru": [
                            {
