                "senses": [
                    {
                        "sense_id": "002837d9-b316-3fde-baeb-1d7711682073",
                        "entry_id": "2d098777-7aef-3234-b6b9-adbc86bd5041",
                        "glosses": [
                            "Frau aus Franken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c9e272-e57c-4706-b4cc-597ed5fab8cf",
                                "sense_id": "002837d9-b316-3fde-baeb-1d7711682073",
                                "text": "Fränkinnen sind meist sehr freundliche Frauen."
                            },
                            {
                                "example_id": "b10c8bab-76e6-4cf7-b2bb-861760b8b5cc",
                                "sense_id": "002837d9-b316-3fde-baeb-1d7711682073",
                                "text": "„Die Fränkin Julia Simon erzielte gleich bei der EM-Qualifikation am Luftgewehr einen neuen Maximalwert von 634,1 Ringen mit 60 Schuss.“"
                            },
                            {
                                "example_id": "000f3ad0-271a-4ee2-a6be-5cc53afc4170",
                                "sense_id": "002837d9-b316-3fde-baeb-1d7711682073",
                                "text": "„Eine der Fränkinnen läuft grinsend nach vorn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6e00e9ec-b466-3960-b17a-a555e1a7706c",
                        "entry_id": "2d098777-7aef-3234-b6b9-adbc86bd5041",
                        "glosses": [
                            "weibliche Angehörige des Fränkischen Volkes"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1cdf7541-e07b-4a79-a588-d546c27d03c3",
                                "sense_id": "6e00e9ec-b466-3960-b17a-a555e1a7706c",
                                "text": "Im etymologischen Sinne sind Fränkinnen heute eher am Rhein und in Frankreich anzutreffen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
