                "senses": [
                    {
                        "sense_id": "b25a22cd-7526-3c22-ab9f-a72a7ccde46d",
                        "entry_id": "0120cdf4-03f1-33bc-a5f6-1d569f9466d6",
                        "glosses": [
                            "Menge an Staub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135ca46f-51a6-42bb-a4d8-42f563e52bbb",
                                "sense_id": "b25a22cd-7526-3c22-ab9f-a72a7ccde46d",
                                "text": "„Darüber hinaus wurde aber auch festgestellt, dass die Staubmenge seit der Mitte des 19. Jahrhunderts angestiegen ist.“"
                            },
                            {
                                "example_id": "2234374c-16d0-4409-8996-8bed7b244dac",
                                "sense_id": "b25a22cd-7526-3c22-ab9f-a72a7ccde46d",
                                "text": "„Immer wieder wirbeln Stürme gewaltige Staubmengen in den Himmel über der Bodélé-Senke im nördlichen Tschad, der größten Staubquelle der Erde.“"
                            },
                            {
                                "example_id": "33a65d75-09c2-4ba5-87a9-116ac2a65b86",
                                "sense_id": "b25a22cd-7526-3c22-ab9f-a72a7ccde46d",
                                "text": "„In anderen Galaxien wirbeln dagegen gewaltige Gas- und Staubmengen um das zentrale Schwarze Loch und leuchten dabei nicht selten heller als das gesamte Sternsystem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
