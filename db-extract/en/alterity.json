                        "entry_id": "c648c7bf-dd76-3d11-bab1-096bf06f1a36",
                        "glosses": [
                            "Otherness; the entity in contrast to which an identity is constructed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c1644446-cf80-4b1c-950b-df5bb0fc8cf8",
                                "sense_id": "80146535-5b4a-31fe-9874-8f5168ad4428",
                                "text": "Nominal declensions, verbal case endings, gerundival constructions, in short, the full range of grammatical alterations—for which Sanskrit has a particular genius and meticulous order—announce language itself as a field of alterity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9599da3b-e4ba-4834-922f-41fc54e7924a",
                        "source_entry_id": "c648c7bf-dd76-3d11-bab1-096bf06f1a36",
                        "source_sense_id": "80146535-5b4a-31fe-9874-8f5168ad4428",
