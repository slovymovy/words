                                    {
                                        "sense_id": "d4261c73-ecb4-344f-aac4-2abff94e96cc",
                                        "entry_id": "74a580ef-0ffa-326a-aa8d-2ef3cfa33a20",
                                        "glosses": [
                                            "so freundlich und zuvorkommend, dass man jemanden mögen muss und ihm/ihr vertraut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5110c5ed-0d17-44ff-9dd9-d49274f50d9e",
                                                "sense_id": "d4261c73-ecb4-344f-aac4-2abff94e96cc",
                                                "text": "Die Polynesierinnen sind für ihr einnehmendes Wesen berühmt."
                                            },
                                            {
                                                "example_id": "9e3a3137-79f8-4b7c-8e0e-a869cb171771",
                                                "sense_id": "d4261c73-ecb4-344f-aac4-2abff94e96cc",
                                                "text": "Noch einnehmender aber als alle Tiere [Fische, Meeresschildkröten] ist die Sprache der Einheimischen [aus Curaçao], Papiamentu – eine Mischung aus Holländisch, Spanisch und Portugiesisch."
                                            },
                                            {
                                                "example_id": "1fb32cda-0cfc-464f-ad0d-3989e30e9eb2",
                                                "sense_id": "d4261c73-ecb4-344f-aac4-2abff94e96cc",
                                                "text": "Er [Thorsten Frei] ist ein Mann mit Elan, offen, verbindlich, einnehmend. Keiner mit Ecken und Kanten wie [Volker] Kauder, sondern konziliant."
                                            },
                                            {
                                                "example_id": "4a563931-8759-45d3-909d-3cbd3a2e8cd4",
                                                "sense_id": "d4261c73-ecb4-344f-aac4-2abff94e96cc",
                                                "text": "Er [Ingo Zamperoni] ist größer und schlanker, und er wirkt in seinen grauen Jeans und dem karierten Hemd noch jünger als auf dem Bildschirm. Er ist höflich, einnehmend, interessiert. So leitet er auch die Konferenz. Man spricht englisch, und Zamperonis Englisch ist tadellos […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
