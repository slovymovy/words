                        "glosses": [
                            "Chapitre du Coran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38fa5664-4c33-4d57-96e7-cefbca820da6",
                                "sense_id": "ab4540e0-feb1-322e-9e4d-de21cf6b28d8",
                                "text": "Elle savait aussi réciter les deux ou trois courtes sourates du Coran qu'aucun musulman n'ignore."
