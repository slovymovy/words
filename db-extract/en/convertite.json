                        "examples": [
                            {
                                "example_id": "0654b1a3-d01b-47d4-b2e7-1b74753fb128",
                                "sense_id": "c5fd5b34-ff6f-321c-96df-825cac4fb244",
                                "text": "He thence departs a heavy convertite; / She remains a hopeless castaway"
                            },
                            {
                                "example_id": "04000ef8-b6de-4884-9916-3368deae6c2d",
                                "sense_id": "c5fd5b34-ff6f-321c-96df-825cac4fb244",
                                "text": "Bar. Oh earth-mettall'd villaines, and no Hebrews born!\nAnd will you basely thus submit your selves\nTo leave your goods to their arbitrament?\nGov. Why Barabas wilt thou be christned?\nBar. No, Governour, I will be no convertite."
                            },
                            {
                                "example_id": "f326874c-6a6d-4373-9dd8-0fcc4da83b90",
                                "sense_id": "c5fd5b34-ff6f-321c-96df-825cac4fb244",
                                "text": "Up then arose that grim convertite,\nHomeward he hied him when ended the rite"
                            }
                        ]
                    }
