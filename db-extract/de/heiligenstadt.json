                        "glosses": [
                            "eine Stadt in Thüringen, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "060547d8-5d61-43f1-99ef-60a11fe94e37",
                                "sense_id": "dce09dca-58c9-3c68-92e8-65d0d9098b7a",
                                "text": "Heiligenstadt liegt in Deutschlands östlicher Mitte."
                            },
                            {
                                "example_id": "e68ef0ea-edb1-4238-b025-001f0e9eaef8",
                                "sense_id": "dce09dca-58c9-3c68-92e8-65d0d9098b7a",
                                "text": "„Für die Menschen aus Duderstadt, Heiligenstadt und Worbis war es gleichwohl eine Selbstverständlichkeit, zum Broterwerb in die Fremde zu ziehen, aber daheim auf dem Eichsfeld die eigenen Wurzeln zu pflegen.“"
                            }
