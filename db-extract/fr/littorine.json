                        "entry_id": "fd6b4b01-9e51-3783-94f7-6f3edcb5cb8a",
                        "glosses": [
                            "Gastéropode testacé, différant du genre Turbo par un opercule corné et une coquille non nacrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3453a2d2-a300-4a23-9fb8-4d4445b1b0a1",
                                "sense_id": "9c3abbc5-3605-31af-927c-5c4880078113",
                                "text": "On y distingue la littorine vulgaire, appelée bigorneau, bigourneau, vignot, et qui est le sabot littoral de certains auteurs de la littorine muriquée, dite aussi bosson."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4791c2b-afc4-43bc-b80b-bb962a1224b6",
                        "source_entry_id": "fd6b4b01-9e51-3783-94f7-6f3edcb5cb8a",
