                ],
                "senses": [
                    {
                        "sense_id": "fca33158-0df2-353f-a140-c8de1e2056f9",
                        "entry_id": "d2759944-53fa-3dc6-a6d1-222d4dade5b3",
                        "glosses": [
                            "kultywator do spulchniania gruntu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b96ce0e-e660-4a4d-a9e2-86483afdfe9d",
                                "sense_id": "fca33158-0df2-353f-a140-c8de1e2056f9",
                                "text": "Agregat ścierniskowy jest też często stosowany jako spulchniacz zaskorupionych gleb, kruszarka brył, niszczarka chwastów oraz mieszalnik nawozów z glebą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a6064f22-6483-3ca0-95b1-7fc253380947",
                        "entry_id": "d2759944-53fa-3dc6-a6d1-222d4dade5b3",
                        "glosses": [
                            "urządzenie do spulchniania podłoża"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28cbe694-b9a9-44b7-af1d-44f2e7e16c52",
                                "sense_id": "a6064f22-6483-3ca0-95b1-7fc253380947",
                                "text": "W celu łatwiejszego odspojenia gruntu, głowicę ssącą pogłębiarki wyposaża się w spulchniacz"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "c4579748-bf4c-3cee-90c1-3e3d9982485c",
                        "entry_id": "d2759944-53fa-3dc6-a6d1-222d4dade5b3",
                        "glosses": [
                            "element kosiarki powodujący spulchnienie pokosu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52490bb9-0c54-4500-800e-344840accafc",
                                "sense_id": "c4579748-bf4c-3cee-90c1-3e3d9982485c",
                                "text": "Kosiarki mogą być dodatkowo wyposażone w spulchniacze pokosu lub w zgniatacz pokosu"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "f49955b4-1381-3dea-b762-b49831fa3494",
                        "entry_id": "d2759944-53fa-3dc6-a6d1-222d4dade5b3",
                        "glosses": [
                            "mieszadło wyposażone w noże używane w piwowarstwie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6ad4e3-a09f-4228-ab4e-3768743f8cfe",
                                "sense_id": "f49955b4-1381-3dea-b762-b49831fa3494",
                                "text": "Zbiornik wyposażony jest w spulchniacze (mieszadła ze specjalnymi nożami), zraszacze do ługowania wysłodzin i dysze do mycia"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "48f1dfe9-bf6f-3346-83ea-e6b036023ed8",
                        "entry_id": "d2759944-53fa-3dc6-a6d1-222d4dade5b3",
                        "glosses": [
                            "substancja powodująca spulchnienie"
                        ],
                        "tags": [
                            "cuk."
                        ],
                        "examples": [
                            {
                                "example_id": "6e99d16e-7334-4008-8fe5-cf0cd37b8980",
                                "sense_id": "48f1dfe9-bf6f-3346-83ea-e6b036023ed8",
                                "text": "Według tradycyjnej receptury fafernuchy przygotowywane są bez spulchniaczy i mogą być długo przechowywane jak pierniki"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
