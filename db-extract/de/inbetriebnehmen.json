                        "examples": [
                            {
                                "example_id": "462b34bf-9c42-486b-a092-67a7f57e3018",
                                "sense_id": "c2f0d065-8549-3185-a8bb-bdc63f6eb745",
                                "text": "„Diese Zweifache Belastung der unternehmerischen Investitionslust entspringt der richtigen Diagnose, daß wir gegenwärtig in einer Investitionskonjunktur leben. Durch ungezügeltes Bauen von Fabriken und Inbetriebnehmen neuer Maschinen und Anlagen werden Arbeitsplätze geschaffen, die wegen der Knappheit an Arbeitskräften nur besetzt werden können, wenn Löhne geboten werden, mit denen sich Unternehmer die Arbeitskräfte gegenseitig abwerben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
