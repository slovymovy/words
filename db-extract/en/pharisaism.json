            },
            {
                "entry_id": "642a1a31-8443-3141-8f2e-4a27c381c1e4",
                "word": "Pharisaism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d646cb7e-7550-35c0-892d-34a17b9bba6c",
                        "entry_id": "642a1a31-8443-3141-8f2e-4a27c381c1e4",
                        "glosses": [
                            "Alternative letter-case form of pharisaism."
                        ],
                        "tags": [
                            "alt-of",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03d58b8f-5177-4aba-b05c-42c2845c3374",
                                "sense_id": "d646cb7e-7550-35c0-892d-34a17b9bba6c",
                                "text": "The man who thinks that his religion is the sum-total of the religious dogmas he believes in, who thinks that to live in harmony with the allhood of things it requires only that one subscribe to certain prescribed religious dogmas, in whose mind the means of salvation is simply frequency and fervency of prayer, assiduity and fidelity of attendance on worship, — in the case of that man his so-called religion is just as apt as not to become an actual aid to immorality, for it is not religion at all, but purblind, self-righteous Pharisaism."
                            }
                        ]
                    }
                ],
