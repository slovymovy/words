                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a287562-0bb7-4509-b21a-0d1ea92a01b8",
                                "sense_id": "60ca18bb-56dc-391a-bd6c-b533090e4b74",
                                "text": "Dans Une Anglaise à bicyclette de Didier Decoin, un Britannique adopte une petite Sioux échappée du massacre de Wounded Knee."
                            },
                            {
                                "example_id": "97ef92f5-eacb-495b-be49-9ed813463e48",
                                "sense_id": "60ca18bb-56dc-391a-bd6c-b533090e4b74",
                                "text": "Le lendemain, des engagés du fort qui se trouvent de l'autre côté de la rivière sont en effet attaqués par plus de 400 Sioux."
                            },
                            {
                                "example_id": "dfcbe00f-303a-4576-85ec-c088ae809ab1",
                                "sense_id": "60ca18bb-56dc-391a-bd6c-b533090e4b74",
                                "text": "Eh bien, moi, je l’avoue, j’aimerais être calme, cool, flegmatique devant la crise comme John Wayne devant une horde de Sioux, mais je ne le suis pas."
                            }
                        ]
                    }
