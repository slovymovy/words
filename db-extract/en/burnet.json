                                "example_id": "bf97599a-f3c2-4574-b65c-881f83bce45e",
                                "sense_id": "c144eed5-e6cb-3df1-b2bc-1f50a7c9994f",
                                "text": "ASPARAGUS, cauliflowers, imperial Sileſia, royal and cabbage lettuces, burnet, purſlain, cucumbers, naſturtian flowers, peaſe and beans ſown in October, artichokes, ſcarlet ſtrawberries, and kidney beans."
                            }
                        ]
                    },
                    {
                        "sense_id": "107edfe4-69b6-334a-afbc-c2bd5f84f91e",
                        "entry_id": "012bc3dc-42c1-3e2c-ac71-57cebb6b86ad",
                        "glosses": [
                            "Any of several species of moths of the family Zygaenidae, typically having black forewings with red spots."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "27db2fc4-62c8-42b8-936c-fac6f9a0a947",
                                "sense_id": "107edfe4-69b6-334a-afbc-c2bd5f84f91e",
                                "text": "There are a few day-flying exceptions such as hummingbird hawk-moths, silver Ys, cinnabars, scarlet tigers and burnets but, in general, knowledge of moths lags behind that of butterflies."
                            }
                        ]
                    }
