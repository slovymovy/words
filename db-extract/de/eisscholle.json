                "senses": [
                    {
                        "sense_id": "e12bac32-121c-30a6-80b7-bc3a4cd65152",
                        "entry_id": "d52a562c-d3ae-3430-ad97-4e659606fc0f",
                        "glosses": [
                            "aus der Eisdecke eines Gewässers gebrochenes, schwimmendes Stück Eis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3264ff59-6f74-4ae2-af18-08de8623d9b0",
                                "sense_id": "e12bac32-121c-30a6-80b7-bc3a4cd65152",
                                "text": "Auch wenn man es ihnen verbietet, spielen Kinder gern auf Eisschollen."
                            },
                            {
                                "example_id": "056c1d10-56f1-4c11-a5ec-b3592372a9a7",
                                "sense_id": "e12bac32-121c-30a6-80b7-bc3a4cd65152",
                                "text": "„Die Erforschung der riesigen Eisscholle gehörte ebenfalls zum Arbeitsprogramm.“"
                            },
                            {
                                "example_id": "0bce4337-d134-4bce-bad6-421f92c8c3cf",
                                "sense_id": "e12bac32-121c-30a6-80b7-bc3a4cd65152",
                                "text": "„Allmählich häuften sich die Eisschollen an der Mercymündung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31ba78ac-daed-4213-b25e-46a8b9722dbb",
                        "source_entry_id": "d52a562c-d3ae-3430-ad97-4e659606fc0f",
                        "source_sense_id": "e12bac32-121c-30a6-80b7-bc3a4cd65152",
                        "source_sense_description": "aus der Eisdecke eines Gewässers gebrochenes, schwimmendes Stück Eis",
                        "target_lang_word": "ice-floe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "46b1474b-c10e-4844-90bd-b2ba585662dc",
                        "source_entry_id": "d52a562c-d3ae-3430-ad97-4e659606fc0f",
                        "source_sense_id": "e12bac32-121c-30a6-80b7-bc3a4cd65152",
                        "source_sense_description": "aus der Eisdecke eines Gewässers gebrochenes, schwimmendes Stück Eis",
                        "target_lang_word": "glaçon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaçon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9130086a-0b36-3121-8e54-dd36c9a256f7",
                                        "entry_id": "9c8bc2a3-626e-368d-bb8b-280c7f5c44fb",
                                        "glosses": [
                                            "Morceau de glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0128431a-c2df-4d1c-b3b2-c3797a0b0d8e",
                                                "sense_id": "9130086a-0b36-3121-8e54-dd36c9a256f7",
                                                "text": "La vive et légère indigène, comme un chamois dans les roches alpestres, marchait d’un pied sûr au milieu des glaçons."
                                            },
                                            {
                                                "example_id": "a6ee32eb-762e-45fd-b41f-6cec6bf5ba65",
                                                "sense_id": "9130086a-0b36-3121-8e54-dd36c9a256f7",
                                                "text": "Aussitôt, la rivière déborda; puis, brusquement, le barrage céda, et les eaux, retrouvant leur écoulement, rentrèrent dans leur lit, mais en déposant sur les terrains qu'elles venaient d'envahir les glaçons qu'elles charriaient. Ceux-ci forment un immense glacier recouvrant les deux côtés de la vallée, […]."
                                            },
                                            {
                                                "example_id": "65cf3b7c-35ca-4bec-afbe-518c103062f6",
                                                "sense_id": "9130086a-0b36-3121-8e54-dd36c9a256f7",
                                                "text": "Il vient ! Il a franchi l’épaisseur de nos bois !\nLe fleuve aux glaçons bleus fond et chante à sa voix ;\nLes grands loups de Pohja, gémissant de tendresse,\nOnt clos leurs yeux sanglants sous sa douce caresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d01b2e-2ef8-3095-be55-6cb153c09d51",
                                        "entry_id": "9c8bc2a3-626e-368d-bb8b-280c7f5c44fb",
                                        "glosses": [
                                            "Petit cube de glace destiné en particulier à être ajouté à une boisson pour la rafraichir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98fa3fa-0725-40d8-82c8-2b44749ab533",
                                                "sense_id": "f7d01b2e-2ef8-3095-be55-6cb153c09d51",
                                                "text": "Mais pourquoi donc ? Parce que les carences en fer accompagnées d’anémie entraînent fréquemment un comportement que l’on appelle le « pica ». Il se traduit, huit fois sur dix par une… pagophagie, ce qui signifie une absorption massive de glaces ; glaçons en cube, et non pas des glaces en cornet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040f952d-0dcd-3ff1-a80a-bd2deb4b5de9",
                                        "entry_id": "9c8bc2a3-626e-368d-bb8b-280c7f5c44fb",
                                        "glosses": [
                                            "Colonne de glace créée par l’écoulement d’eau qui gèle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "504205a4-36a6-3d7c-b8a1-a65adefa1f70",
                                        "entry_id": "9c8bc2a3-626e-368d-bb8b-280c7f5c44fb",
                                        "glosses": [
                                            "Se dit d’une personne dont l’abord est d’une grande froideur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f3f1505-9902-3d05-b82a-9a8517269ff5",
                                        "entry_id": "9c8bc2a3-626e-368d-bb8b-280c7f5c44fb",
                                        "glosses": [
                                            "Granule constitué de combustible de fusion solidifié à très basse température, qui est injecté à grande vitesse dans un plasma de fusion confiné par un champ magnétique, pour alimenter ce plasma en combustible ou pour en modifier les propriétés."
                                        ],
                                        "tags": [
                                            "Fusion nucléaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
