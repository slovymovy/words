{
    "word_family": [
        "move",
        "movable",
        "immovable",
        "moving",
        "mover"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2314d901-0343-3f7a-a29f-7937b515d898",
                    "sense_definition": "The act or process of changing physical position or place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We noticed a slight <w>movement</w> in the tall grass on the hill.",
                            "target_lang_translations": {
                                "ru": "Мы заметили легкое <w>движение</w> в высокой траве на холме.",
                                "zh": "我们注意到山坡上的高草丛里有轻微的<w>移动</w>。"
                            }
                        },
                        {
                            "text": "The camera tracks the <w>movement</w> of the players across the field.",
                            "target_lang_translations": {
                                "ru": "Камера отслеживает <w>перемещение</w> игроков по полю.",
                                "zh": "摄像机追踪着球员在场上的<w>移动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "motion",
                        "move"
                    ],
                    "antonyms": [
                        "stasis"
                    ],
                    "common_phrases": [
                        "freedom of movement",
                        "rapid movement",
                        "slight movement",
                        "eye movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс изменения физического положения или места.",
                        "zh": "改变物理位置或地点的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движение",
                                "target_lang_sense_clarification": "физическое действие"
                            },
                            {
                                "target_lang_word": "перемещение",
                                "target_lang_sense_clarification": "смена местоположения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "移动",
                                "target_lang_sense_clarification": "物理上的位移"
                            },
                            {
                                "target_lang_word": "动作",
                                "target_lang_sense_clarification": "身体部位的活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05f4fad8-fc31-3ba2-a600-ffe167892057",
                    "sense_definition": "A group of people working together to advance their shared political, social, or artistic ideas.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been an active member of the labor <w>movement</w> for twenty years.",
                            "target_lang_translations": {
                                "ru": "Она была активным участником рабочего <w>движения</w> в течение двадцати лет.",
                                "zh": "她作为劳工<w>运动</w>的积极分子已经二十年了。"
                            }
                        },
                        {
                            "text": "The civil rights <w>movement</w> changed the laws and culture of the country.",
                            "target_lang_translations": {
                                "ru": "<w>Движение</w> за гражданские права изменило законы и культуру страны.",
                                "zh": "民权<w>运动</w>改变了这个国家的法律和文化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "social movement",
                        "political movement",
                        "labor movement",
                        "peace movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, объединенных общей целью или убеждениями.",
                        "zh": "一群人为推进其共同的政治、社会或艺术理念而共同努力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движение",
                                "target_lang_sense_clarification": "общественная группа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运动",
                                "target_lang_sense_clarification": "社会或政治团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1467d3a0-d0a7-369c-ae52-74cacf2c530a",
                    "sense_definition": "A distinct principal division of a longer musical work, such as a symphony or concerto.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience clapped between the first and second <w>movement</w> by mistake.",
                            "target_lang_translations": {
                                "ru": "Зрители по ошибке зааплодировали между первой и второй <w>частью</w>.",
                                "zh": "观众在第一和第二<w>乐章</w>之间错误地鼓了掌。"
                            }
                        },
                        {
                            "text": "Beethoven's Ninth Symphony has a famous choral fourth <w>movement</w>.",
                            "target_lang_translations": {
                                "ru": "Девятая симфония Бетховена известна своей хоровой четвертой <w>частью</w>.",
                                "zh": "贝多芬的第九交响曲有一个著名的合唱第四<w>乐章</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "first movement",
                        "slow movement",
                        "symphonic movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самостоятельная часть крупного музыкального произведения.",
                        "zh": "大型音乐作品（如交响曲或协奏曲）中独立的乐章。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "часть",
                                "target_lang_sense_clarification": "музыкального произведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乐章",
                                "target_lang_sense_clarification": "音乐作品的组成部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97265ca2-c67d-3af9-91c8-85d3cec6c8b4",
                    "sense_definition": "The moving parts of a mechanism, especially the internal works of a clock or watch.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This antique watch has a very complex and delicate mechanical <w>movement</w>.",
                            "target_lang_translations": {
                                "ru": "У этих старинных часов очень сложный и хрупкий <w>механизм</w>.",
                                "zh": "这块古董表有着非常复杂且精密的机械<w>机芯</w>。"
                            }
                        },
                        {
                            "text": "He carefully cleaned the <w>movement</w> to restore the clock to working order.",
                            "target_lang_translations": {
                                "ru": "Он осторожно почистил <w>механизм</w>, чтобы вернуть часы в рабочее состояние.",
                                "zh": "他小心地清理了<w>机芯</w>，使时钟恢复了正常运转。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "watch movement",
                        "clock movement",
                        "quartz movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущиеся части механизма, особенно внутренняя часть часов.",
                        "zh": "机械装置的活动部件，尤指钟表的内部机芯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "механизм",
                                "target_lang_sense_clarification": "устройство часов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机芯",
                                "target_lang_sense_clarification": "钟表内部的机械结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0df9e663-7de8-3db3-9519-d6e8a737baed",
                    "sense_definition": "The impression or illusion of motion in an artwork, painting, or design.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used bold brushstrokes to create a sense of <w>movement</w> in the static image.",
                            "target_lang_translations": {
                                "ru": "Художник использовал смелые мазки, чтобы создать ощущение <w>движения</w> в статичном изображении.",
                                "zh": "艺术家运用大胆的笔触，在静态画面中创造出一种<w>动感</w>。"
                            }
                        },
                        {
                            "text": "There is a lot of dynamic <w>movement</w> in the composition of this sculpture.",
                            "target_lang_translations": {
                                "ru": "В композиции этой скульптуры много <w>динамики</w>.",
                                "zh": "这座雕塑的构图中充满了动态的<w>动感</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sense of movement",
                        "implied movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впечатление или иллюзия движения в художественном произведении.",
                        "zh": "艺术品、绘画或设计中表现出的动感或运动错觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движение",
                                "target_lang_sense_clarification": "в искусстве"
                            },
                            {
                                "target_lang_word": "динамика",
                                "target_lang_sense_clarification": "энергичность композиции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动感",
                                "target_lang_sense_clarification": "艺术作品中的视觉效果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d758ecb3-ee72-3853-85d8-f265248e9631",
                    "sense_definition": "An act of emptying the bowels.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient about the frequency of his bowel <w>movements</w>.",
                            "target_lang_translations": {
                                "ru": "Врач спросил пациента о частоте его <w>стула</w>.",
                                "zh": "医生询问了病人的<w>排便</w>频率。"
                            }
                        },
                        {
                            "text": "A diet high in fiber contributes to a regular healthy <w>movement</w>.",
                            "target_lang_translations": {
                                "ru": "Богатая клетчаткой диета способствует регулярному здоровому <w>стулу</w>.",
                                "zh": "高纤维饮食有助于保持规律健康的<w>排便</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowel movement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for bowel movement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт опорожнения кишечника.",
                        "zh": "排便的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стул",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "испражнение",
                                "target_lang_sense_clarification": "физиологический процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排便",
                                "target_lang_sense_clarification": "医学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}