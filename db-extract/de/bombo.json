                ],
                "senses": [
                    {
                        "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                        "entry_id": "69c0a1c2-882a-38db-aaed-4249f2a9f393",
                        "glosses": [
                            "große Trommel, die in der Vertikale gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e046421-20e1-41b2-9027-d89535ee0828",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "Die Bombo ist bekannt aus Militärkapellen und von Volksfesten in Italien und der Iberischen Halbinsel."
                            },
                            {
                                "example_id": "92f25278-9c71-406a-a554-6af3086daecc",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Bernhard Arnold vom Olbers-Planetarium zeigte es uns, während Ulli Simon die Bombo schlug und die Ziegenhufe an seinen Fußgelenken rasseln ließ.“"
                            },
                            {
                                "example_id": "b5e2a271-f158-43a5-a04d-a47ea8563e6e",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Die Bombo - Riesentrommel - trägt ihren Namen schließlich zu Recht!“"
                            },
                            {
                                "example_id": "03547667-cbbc-489e-bf00-931d5690af9b",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Begleitet werden die Sänger Mamel Aguirre und Choche Ballesteros u.a. mit Akkordeon, Bombo, Querflöte, Saxophon und Kontrabass.“"
                            },
                            {
                                "example_id": "fe3119d3-9445-4aaf-92bd-fa68efaccb87",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Das Tam-tam der Bombos wird lauter, schneller, heftiger, der Tanz ekstatisch.“"
                            },
                            {
                                "example_id": "301ae034-a039-4bc9-96d2-bf488e7229fb",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Im Ensemble sind Instrumente wie Gitarre, Bombo, Charango und Kontrabass zu hören.“"
                            },
                            {
                                "example_id": "53453664-7e51-4576-b77f-85d62f211b92",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Er stellte sich im Nationalstadion in Santiago in die Kurve, trommelte auf dem Bombo, der Riesenpauke der Ultras, sprang auf die Wellenbrecher, sang mit, zog das Oberhemd aus – und schwenkte es in der Luft, wie es die Einpeitscher in südamerikanischen Fankurven tun.“"
                            },
                            {
                                "example_id": "1fa111cd-d438-4e76-b1d4-f08a148de709",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Dieses Mal hat er sich unter anderem als Percussionist weitergebildet: auf dem Bombo, der traditionellen argentinischen Trommel.“"
                            },
                            {
                                "example_id": "cbd9c7ca-bb78-4876-bb57-43ae158c3f67",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Landestypische Instrumente wie die Bombo oder das Charango, aber auch die Gitarre, durften dabei nicht fehlen.“"
                            },
                            {
                                "example_id": "122ae52f-b920-49b0-a465-d1ea778a2c2a",
                                "sense_id": "2b22f1f9-0d91-3091-acd1-66c35192db73",
                                "text": "„Doch auch die andere Seite, das kraftvolle in die Hände klatschen, stampfende und ausschlagende Füße im Rhythmus der argentinischen Trommeln, den Bombos, fehlt nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
