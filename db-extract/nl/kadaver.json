                    }
                ],
                "senses": [
                    {
                        "sense_id": "8bce858f-43d8-31f5-a385-5af3046a1515",
                        "entry_id": "288a8ca8-8a45-3731-b5b7-7ab0eaff232c",
                        "glosses": [
                            "dood lichaam van een dier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c813721-cf63-41fc-b6c3-44f5f9ffc0a9",
                                "sense_id": "8bce858f-43d8-31f5-a385-5af3046a1515",
                                "text": "De reebok werd in het kader van het project Ruimte voor aaseters in de natuur neergelegd. Kadavers zijn schaars, schrijven de deelnemende natuurorganisaties op hun website. Aangereden wild wordt vaak vernietigd en ook in natuurgebieden worden dode dieren opgeruimd. Door verkeersslachtoffers terug te plaatsen, hopen de organisaties dat grote aaseters weer terugkeren in de natuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb4ca48-eabd-48b0-a477-0436c4e13a6c",
                        "source_entry_id": "288a8ca8-8a45-3731-b5b7-7ab0eaff232c",
                        "source_sense_id": "8bce858f-43d8-31f5-a385-5af3046a1515",
                        "source_sense_description": "dood lichaam van een dier",
                        "target_lang_word": "Kadaver",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kadaver",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                        "entry_id": "8920a24b-1d94-3a6a-97b5-9e2c3f6c64bf",
                                        "glosses": [
                                            "toter, in Verwesung begriffener Tierkörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b8adbd-8f31-4eae-82b3-44aa11e384dc",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "Die Tierkörperverwertung nimmt alle Kadaver entgegen."
                                            },
                                            {
                                                "example_id": "e9d6e75d-5432-437c-8a87-2ba50bc2dbd2",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Eins, zwei, drei, ist dem Tier die Haut über den Kopf gezogen, und ein anderes Pferd mit einer Karre kommt, um den Kadaver wegzuziehen.“"
                                            },
                                            {
                                                "example_id": "5a1dc9fd-9b93-41f0-b958-9fa057e8a72f",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Aufgerissene Mäuler, erschreckte Augen, zerissenes Gedärm, Fliegenschwärme hatten sich auf den Kadavern niedergelassen.“"
                                            },
                                            {
                                                "example_id": "5df7339e-e701-4d3b-8922-10cde9aa52b9",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Einige Monate später, der Kriminalfall Piontek ruht als vorläufig ungelöst in den Akten, zeigt ein Forstarbeiter bei der Polizei an, dass sein Labrador in einem Waldgebiet, das nach Feststellung der Polizei weiter entfernt von Pionteks Jagdgründen liegt, den offensichtlich nicht tief genug vergrabenen Kadaver eines mittelgroßen Hundes aufgespürt habe.“"
                                            },
                                            {
                                                "example_id": "4816e7f6-0c57-4e33-89c2-247ecee8d00f",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Alsdann nahmen sie ihn zwischen sich und trugen ihn hinaus und schmissen ihn wie einen Kadaver auf die Straße .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65b522cb-a58d-36fa-83b4-3f6e3d0089bc",
                                        "entry_id": "8920a24b-1d94-3a6a-97b5-9e2c3f6c64bf",
                                        "glosses": [
                                            "schwacher, kraftloser Körper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d9bdae-7489-4376-8408-086c455a1fcc",
                                                "sense_id": "65b522cb-a58d-36fa-83b4-3f6e3d0089bc",
                                                "text": "Beweg doch deinen Kadaver ein bisschen mehr!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a342732-70a7-4d8d-b4b4-d4e9f5c5a853",
                        "source_entry_id": "288a8ca8-8a45-3731-b5b7-7ab0eaff232c",
                        "source_sense_id": "8bce858f-43d8-31f5-a385-5af3046a1515",
                        "source_sense_description": "dood lichaam van een dier",
                        "target_lang_word": "carcass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carcass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a dead animal, especially a vertebrate or other animal having flesh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d96aa1d-d02b-4531-b84c-ec70c3d37899",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "The forest was covered in dog carcass."
                                            },
                                            {
                                                "example_id": "0340f0de-6529-4e18-bd3f-687ed076c69f",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "Plate 31, figure B shows a desiccated carcass in the ventral position with a sharp S curvature in the vertebral column. Such pronounced drying-out of a carcass probably happens only when it is quickly carried to a dry place and exposed to the strong rays of the sun."
                                            },
                                            {
                                                "example_id": "2fead4c5-11dd-406e-a03f-eaa74f173faa",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "Despite all of the groups' experiences with leopards and carcasses in trees, neither the vervets nor the baboons gave alarm calls at the sight of the carcass alone."
                                            },
                                            {
                                                "example_id": "df8bed54-2fd6-4a7c-9c2f-5680895c11c8",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "Instead, the majority of studies involve freezing the carcasses until time permits the analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a slaughtered animal, stripped of unwanted viscera, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9c91a7-7c40-41d6-aeaa-b714c7c60bf6",
                                                "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                                "text": "1961, D. M. Doty, John C. Pierce, Beef Muscle Characteristics as Related to Carcass Grade, Carcass Weight, and Degree of Aging, US Department of Agriculture, Technical Bulletin No. 1231, page 33,\nLean flavor scores for this muscle were lower than those for ribeye, especially in Prime grade carcasses."
                                            },
                                            {
                                                "example_id": "a537770b-1ca7-4355-9c29-6dde866505ea",
                                                "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                                "text": "The most important is the carcass but the liver, kidneys and, to a limited extent, various other visceral components also have value as food items.[…]For example, the carcasses from sheep and cattle have the head removed immediately after slaughter but in pigs this may be delayed until after chilling and further butchery."
                                            },
                                            {
                                                "example_id": "85b75246-9de0-4e29-9ced-1133e326fe24",
                                                "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                                "text": "In some countries, there is still a significant trade in chicken carcasses that have been plucked, but not eviscerated, by the producer. Subsequently, the carcass may be eviscerated by a butcher or in the kitchen of the consumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a dead human, a corpse or cadaver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4415586-ea74-4a15-8e86-56de9e3b9729",
                                                "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                                "text": "He saw a human carcass while digging a hole and ran away screaming."
                                            },
                                            {
                                                "example_id": "87050c0f-2b9a-4b89-b440-c9db5bc3b77f",
                                                "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                                "text": "And when their ſcattered armie is ſubdu’d: / And you march on their ſlaughtered carkaſſes, / Share equally the gold that bought their liues, / And liue like Gentlmen in Perſea, […]"
                                            },
                                            {
                                                "example_id": "38f5d4ff-6e02-4530-92e3-b05c6843c3e1",
                                                "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                                "text": "And the carkeiſes of this people ſhall be meate for the fowles of the heauen, and for the beaſts of the earth, and none ſhall fray them away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64950bad-20b0-39c9-9ffc-5b6cfc96b036",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a live person or animal."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b443fa92-2c0c-457a-a520-28aabcce420b",
                                                "sense_id": "64950bad-20b0-39c9-9ffc-5b6cfc96b036",
                                                "text": "A Churliſh Envious Curr vvas gotten into a Manger, and there lay Growling and Snarling to keep the Horſes from their Provender. The Dog Eat None himſelf, and yet rather Ventur'd the Starving his Own Carcaſe then he would ſuffer any thing elfe to be the Better for't."
                                            },
                                            {
                                                "example_id": "59b5ea8a-f524-4ccd-97fa-f49f124bdc4c",
                                                "sense_id": "64950bad-20b0-39c9-9ffc-5b6cfc96b036",
                                                "text": "\"If you saw the care she takes over hoisting her beastly old carcass up and down those stairs, you could make a sure bet against her having another accident there.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d5d1cf-7a3a-3ac4-a838-354b28e06d8b",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The framework of a structure, especially one not normally seen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38573fec-9b5a-4328-b0a1-0540a4f969b3",
                                                "sense_id": "97d5d1cf-7a3a-3ac4-a838-354b28e06d8b",
                                                "text": "The tyres used on DC-8s have a tread portion that contains three fabric re-enforcing layers. These layers protect the tyre carcass to some extent against foreign object damage. A tyre tread, however, does not contribute to the carcass integrity^([sic]); even when a tyre is worn to the third fabric layer, the normal change point, it does not lose any structural integrity. The mandatory change point for a tyre is when it is worn to the carcass layer; however, at this point, the tyre could not undergo a retread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e688647f-9e06-3784-b020-18af21f5a9aa",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "An early incendiary ship-to-ship projectile consisting of an iron shell filled with saltpetre, sulphur, resin, turpentine, antimony and tallow with vents for flame."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c82f8bee-e1d1-4893-8488-99ac53a1d33d",
