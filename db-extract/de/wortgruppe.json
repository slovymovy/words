                    {
                        "form_id": "12bd72e4-63c4-4a15-8676-90e0bb3e692a",
                        "entry_id": "bdf07cd3-5c11-3cb0-81aa-ddc897d65434",
                        "tags": [
                            "accusative",
                            "plural"
