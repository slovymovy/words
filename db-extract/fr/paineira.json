                        "glosses": [
                            "Arbuste de la zone tropicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33fbbcf6-608a-41c4-8665-419bb3368ebb",
                                "sense_id": "edd2059c-91c3-3568-81a2-14ecb6bc8743",
                                "text": "Dans Le Char à bæufs, précisément daté du 15 août 1638, ils prennent la forme « classique » de deux arbres où Joaquim de Sousa Leão reconnaît un acacia et une paineira (Chorisa speciosa) aussi appelée « barriguda »."
                            },
                            {
                                "example_id": "db36fb61-4a12-4a39-a4d4-d474599bbbea",
                                "sense_id": "edd2059c-91c3-3568-81a2-14ecb6bc8743",
                                "text": "Un horizon de petites collines couvertes d'arbres en fleurs, parmi lesquels se distinguent les ipés jaunes, les paineiras candides et soyeux, les quaresmas d'un mauve intense, les crêtes rouges des flamboyants."
                            }
                        ]
                    }
