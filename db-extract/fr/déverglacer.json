                        "glosses": [
                            "Faire disparaître le verglas de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710814e7-59e7-47db-8eb7-fc2899424e1e",
                                "sense_id": "f3efeb62-4108-3974-b3d2-6c876b209e6c",
                                "text": "Comme je concentrais mon attention sur une portion de route difficile, que le soleil radieux, au-dessus de la montagne, n'avait pas pu déverglacer, il en a profité pour se rendormir."
                            },
                            {
                                "example_id": "1bb89302-1124-4d90-9a5e-d9a9e7b83424",
                                "sense_id": "f3efeb62-4108-3974-b3d2-6c876b209e6c",
                                "text": "Les travaux de viabilité ont davantage consisté à déneiger qu'à déverglacer."
                            }
                        ]
                    }
