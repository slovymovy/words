                    "frequency": "VeryLow",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude reisverhalen werd de tropische ara weleens aangeduid als een <w>raaf</w>.",
                            "target_lang_translations": {
                                "en": "In old travelogues, the tropical macaw was sometimes referred to as a <w>macaw</w>."
                            }
                        },
                        {
                            "text": "Men verbaasde zich vroeger over deze bontgekleurde <w>raaf</w> uit de Nieuwe Wereld.",
                            "target_lang_translations": {
