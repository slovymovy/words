                            "target_lang_translations": {
                                "en": "He had once been a student, only to end up, <w>of all things</w>, a philologist."
                            }
                        },
                        {
                            "text": "Ze hebben die oude, prachtige boom gekapt om er <w>godbetert</w> een parkeerplaats van te maken.",
                            "target_lang_translations": {
