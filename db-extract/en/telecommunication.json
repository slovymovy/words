                "senses": [
                    {
                        "sense_id": "8d73dd14-dcb8-3ad3-b961-bd74b8fe5acd",
                        "entry_id": "dbfd53a0-69bb-343d-bd82-28f89aa6ea66",
                        "glosses": [
                            "The science and technology of the communication of messages over a distance using electric, electronic or electromagnetic impulses."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ab887cd8-1820-3b7b-b83a-72e840e0c02a",
                        "entry_id": "dbfd53a0-69bb-343d-bd82-28f89aa6ea66",
                        "glosses": [
                            "A message so transmitted."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d71d9ff2-0bf6-37a2-a571-7956ebaa1fa3",
                        "entry_id": "dbfd53a0-69bb-343d-bd82-28f89aa6ea66",
                        "glosses": [
                            "Systems used in transmitting such signals."
                        ],
                        "tags": [
                            "countable",
                            "in-plural",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "40cf6153-99cd-455e-9e13-5f1e60a95eb6",
                                "sense_id": "d71d9ff2-0bf6-37a2-a571-7956ebaa1fa3",
                                "text": "Oct. 1 is “U-Day,” when Myanmar officially will adopt the new system. From then on, all electronic communication from government offices, telecommunications companies, banks and media must be in Unicode, by law."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c33ddf57-7a42-48f2-b541-596f6a82db39",
                        "source_entry_id": "dbfd53a0-69bb-343d-bd82-28f89aa6ea66",
