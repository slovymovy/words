                "senses": [
                    {
                        "sense_id": "52ecaf98-2823-3ac1-a6b9-a1106df45838",
                        "entry_id": "2bafc437-9578-30ae-94ab-23e1e8b4df41",
                        "glosses": [
                            "Grundsatz, der dem Wähler zusichert, frei wählen zu können, ohne dass seine Wahlentscheidung beobachtet oder nachträglich rekonstruiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd49e4d-46dc-45bf-9432-1c7773850fa1",
                                "sense_id": "52ecaf98-2823-3ac1-a6b9-a1106df45838",
                                "text": "Das Wahlgeheimnis wird durch die Wahlkabine, in der der Wahlvorgang stattfinden muss und die verschlossene Wahlurne, in die der Stimmzettel geworfen wird, gesichert. Auch Wahlzettel und in der Wahlkabine liegende Schreibstifte müssen gleich sein."
                            },
                            {
                                "example_id": "abb85d18-8c28-4036-9c53-9bd6e93c0c41",
                                "sense_id": "52ecaf98-2823-3ac1-a6b9-a1106df45838",
                                "text": "Die Sicherung des Wahlgeheimnisses ist einer der Grundsätze demokratischer Wahlen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
