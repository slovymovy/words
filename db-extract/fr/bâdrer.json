                "senses": [
                    {
                        "sense_id": "62387ffc-f103-3a79-9b80-b178260a1788",
                        "entry_id": "35122d17-051d-35db-b515-ddb37e8a8c85",
                        "glosses": [
                            "Ennuyer, déranger, tourmenter, incommoder, achaler."
                        ],
                        "tags": [
                            "Canada",
                            "Louisiane"
                        ],
                        "examples": [
                            {
                                "example_id": "4e2322cc-2b92-49f6-9a86-90dc222e0e3c",
                                "sense_id": "62387ffc-f103-3a79-9b80-b178260a1788",
                                "text": "Viens pu m'bâdrer avec ça !"
                            },
                            {
                                "example_id": "a44b430b-69ea-4d61-8b5b-364d10f5f8e3",
                                "sense_id": "62387ffc-f103-3a79-9b80-b178260a1788",
                                "text": "Je voulus reprendre ma charge. Mais lui :\n— Allons ! Allons ! «Bâdrez moié pas ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ac9b573-8b31-38d2-bc67-bceb56dbf343",
                        "entry_id": "35122d17-051d-35db-b515-ddb37e8a8c85",
                        "glosses": [
                            "S’bâdrer, s'embêter avec quelque chose."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "06699d3e-2d29-40ff-ad13-b54386ed3964",
                                "sense_id": "8ac9b573-8b31-38d2-bc67-bceb56dbf343",
                                "text": "Je m'bâdre pas de ça."
                            },
                            {
                                "example_id": "03e14624-e64e-443c-be6a-3643a7066cce",
                                "sense_id": "8ac9b573-8b31-38d2-bc67-bceb56dbf343",
                                "text": "Il ne se bâdrera pas de ton opinion."
                            }
                        ]
                    }
