{
    "word_family": [
        "ambiguity",
        "unambiguous",
        "ambiguously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "345a47e1-cd8d-368e-aebf-f3d111642d93",
                    "sense_definition": "Open to more than one interpretation or having a double meaning.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was criticized for his <w>ambiguous</w> statements and lack of precision.",
                            "target_lang_translations": {
                                "ru": "Политика критиковали за его <w>двусмысленные</w> высказывания и отсутствие точности."
                            }
                        },
                        {
                            "text": "The ending of the movie was deliberately <w>ambiguous</w> to make the audience think.",
                            "target_lang_translations": {
                                "ru": "Финал фильма был намеренно <w>неоднозначным</w>, чтобы заставить зрителей задуматься."
                            }
                        }
                    ],
                    "synonyms": [
                        "equivocal",
                        "unclear",
                        "vague",
                        "imprecise"
                    ],
                    "antonyms": [
                        "unambiguous",
                        "clear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Допускающий несколько толкований или имеющий двойной смысл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двусмысленный",
                                "target_lang_sense_clarification": "имеющий два возможных значения"
                            },
                            {
                                "target_lang_word": "неоднозначный",
                                "target_lang_sense_clarification": "допускающий разные интерпретации"
                            },
                            {
                                "target_lang_word": "многозначный",
                                "target_lang_sense_clarification": "имеющий много смыслов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dab17587-1a59-3011-ad43-f6751b051905",
                    "sense_definition": "Feeling hesitant or uncertain about which side to take or what to do.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>ambiguous</w> about the job offer because it required moving to a new city.",
                            "target_lang_translations": {
                                "ru": "Она испытывала <w>двойственные</w> чувства по поводу предложения о работе, так как оно требовало переезда в другой город."
                            }
                        },
                        {
                            "text": "The committee remained <w>ambiguous</w> on the issue, refusing to cast a final vote.",
                            "target_lang_translations": {
                                "ru": "Комитет сохранял <w>неопределённую</w> позицию по этому вопросу, отказываясь проводить финальное голосование."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncertain",
                        "indefinite",
                        "undefinable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий нерешительность или неуверенность в выборе стороны или действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопределённый",
                                "target_lang_sense_clarification": "не имеющий четкой позиции"
                            },
                            {
                                "target_lang_word": "двойственный",
                                "target_lang_sense_clarification": "противоречивый в чувствах или решениях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
