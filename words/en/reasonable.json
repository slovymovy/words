                                "target_lang_sense_clarification": "обоснованный (о требовании)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozsądny",
                                "target_lang_sense_clarification": "oparty na zdrowym rozsądku"
                            },
                            {
                                "target_lang_word": "uzasadniony",
                                "target_lang_sense_clarification": "mający podstawy, słuszny"
                            },
                            {
                                "target_lang_word": "sensowny",
                                "target_lang_sense_clarification": "mający sens, logiczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "026822e5-72e5-3b5b-a92f-65ba514d3c4e",
                    "sense_definition": "Not too expensive; sold at a fair price.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant serves delicious food at very <w>reasonable</w> prices.",
