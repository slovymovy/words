                                        "entry_id": "231c1df8-ac5e-3575-8cc3-eebd7eafe4b9",
                                        "glosses": [
                                            "An athlete who competes in the decathlon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f092ff75-d494-420d-8c1a-264dac2ad339",
                                                "sense_id": "b7def59c-ce3c-33cb-b102-cccf62ce971a",
                                                "text": "Simply to see what would happen, Paul Terek, a United States decathlete, wore a baseball cap bearing his name in Japanese when he landed at the Osaka airport a few weeks ago. Some children there took the bait."
                                            },
                                            {
                                                "example_id": "af765784-a51e-4e24-ab8a-4273f03b53f9",
                                                "sense_id": "b7def59c-ce3c-33cb-b102-cccf62ce971a",
                                                "text": "“Heptathlon is very geared and favorable to those who are quick,” said Gray’s coach, Andy Eggerth, who trains both heptathletes and decathletes. “A lot of world-class heptathletes are relatively bad at javelin and shot-put.”"
                                            }
                                        ]
                                    }
                                ]
