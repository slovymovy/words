                        "glosses": [
                            "Any of various devices that make sound visible by displaying vibrations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6aefb7e-5118-413d-887e-d3b315b160f2",
                                "sense_id": "0901ff2e-35ed-3ac9-8a29-a5603c438aba",
                                "text": "When the tonoscope was used with patients suffering from speech difficulties, the difference between a pure sound and a skewed sound was clearly evident."
                            },
                            {
                                "example_id": "547817dc-36de-47ca-9312-3ef135d6e400",
                                "sense_id": "0901ff2e-35ed-3ac9-8a29-a5603c438aba",
                                "text": "Seashore saw the emotions of music as buried in the subsensory rise and fall of the sound wave; only tools such as the tonoscope could capture music's true beauty."
                            },
                            {
                                "example_id": "35d14af9-9543-4ea2-a8bd-444c6f88c2c7",
                                "sense_id": "0901ff2e-35ed-3ac9-8a29-a5603c438aba",
                                "text": "Although a deaf child might not be able to hear the difference between a properly pronounced “oh” and a guttural, poorly articulated “uhh,” using the tonoscope they could see the difference!"
                            }
                        ]
                    }
                ],
