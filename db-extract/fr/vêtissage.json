                                                "example_id": "ca996578-da51-43e0-97b5-0070ae68c403",
                                                "sense_id": "538baaf7-06ef-333a-99c2-f913f15468c0",
                                                "text": "His resentful comments on this conviction were greeted only by great tears falling in silence, and almost convulsive grippings of his hand."
                                            }
