                            },
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "божественное лицо в теологии"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "person",
                                "target_lang_sense_clarification": "any of the three hypostases of the Holy Trinity"
                            }
                        ]
                    }
