        "de-extract.jsonl": [
            {
                "entry_id": "31e6b104-23b6-3a58-b671-193a1cd56d20",
                "word": "licence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d0ee11b-6b5f-38b6-847d-a1f526e46d08",
                        "entry_id": "31e6b104-23b6-3a58-b671-193a1cd56d20",
                        "glosses": [
                            "ein offizielles Dokument einer Erlaubnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262e2783-83c7-4e26-a439-6a1648e92a49",
                                "sense_id": "7d0ee11b-6b5f-38b6-847d-a1f526e46d08",
                                "text": "They were stopped and asked for their licences.",
                                "translation": "Sie wurden angehalten und nach ihren Genehmigungen gefragt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "51c5b66b-10e5-37c5-a72b-3c4086c20a60",
                        "entry_id": "31e6b104-23b6-3a58-b671-193a1cd56d20",
                        "glosses": [
                            "die Erlaubnis oder Freiheit, nach eigenem Ermessen zu handeln"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "57c5c9e8-12a4-4dfe-a470-3c73c3026316",
                                "sense_id": "51c5b66b-10e5-37c5-a72b-3c4086c20a60",
                                "text": "They allow their children little licence.",
                                "translation": "Sie lassen ihren Kindern wenig Freiheit."
                            },
                            {
                                "example_id": "5d81ee57-6423-481b-867c-98ca7151bb0b",
                                "sense_id": "51c5b66b-10e5-37c5-a72b-3c4086c20a60",
                                "text": "Others give theirs much licence.",
                                "translation": "Andere lassen ihren viel Freiheit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10f58b9f-2cb0-4b4f-8fc0-fe750d87f4fc",
                        "source_entry_id": "31e6b104-23b6-3a58-b671-193a1cd56d20",
                        "source_sense_id": "7d0ee11b-6b5f-38b6-847d-a1f526e46d08",
                        "source_sense_description": "ein offizielles Dokument einer Erlaubnis",
                        "target_lang_word": "Genehmigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genehmigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c113d6ae-c476-3cb9-860a-b681110dd8cd",
                                        "entry_id": "668857c5-df49-355e-b9f5-b5adfc51cb7c",
                                        "glosses": [
                                            "Erteilung oder Vorliegen einer Erlaubnis, etwas zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5faf6515-647d-44b0-82b8-0773cd92db3f",
                                                "sense_id": "c113d6ae-c476-3cb9-860a-b681110dd8cd",
                                                "text": "Wenn man ein Haus bauen möchte, benötigt man eine Genehmigung der zuständigen Kommune dafür."
                                            },
                                            {
                                                "example_id": "6387cacf-0b0b-465c-a072-c75e0c43b4ff",
                                                "sense_id": "c113d6ae-c476-3cb9-860a-b681110dd8cd",
                                                "text": "„Ungefähr fünf Stunden, nachdem wir an der Grenze angekommen waren, bekamen wir endlich die Genehmigung zur Weiterfahrt.“"
                                            },
                                            {
                                                "example_id": "096c5638-9043-4e4f-8bb7-41af47abba95",
                                                "sense_id": "c113d6ae-c476-3cb9-860a-b681110dd8cd",
                                                "text": "„Denn das Gesetz ist immer noch gütlig, daß man Genehmigung braucht, um seinen Aufenthaltsort zu wechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ae44410-57a3-362e-b803-319b586814b2",
                                        "entry_id": "668857c5-df49-355e-b9f5-b5adfc51cb7c",
                                        "glosses": [
                                            "nachträgliche Zustimmung"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec367ec-beeb-4a4b-9496-b3681182a896",
                                                "sense_id": "8ae44410-57a3-362e-b803-319b586814b2",
                                                "text": "Die Legaldefinition der Genehmigung steht in § 184 I BGB."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c951a45-5ac0-4951-97b6-5eba7734d496",
                        "source_entry_id": "31e6b104-23b6-3a58-b671-193a1cd56d20",
                        "source_sense_id": "7d0ee11b-6b5f-38b6-847d-a1f526e46d08",
                        "source_sense_description": "ein offizielles Dokument einer Erlaubnis",
                        "target_lang_word": "Lizenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lizenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d06f854-4b13-3585-8e48-b7e8e5406fa1",
                                        "entry_id": "020d1930-f259-37ff-bb64-6d234b832dfe",
                                        "glosses": [
                                            "offizielle schriftliche Erlaubnis für etwas, das ohne diese verboten wäre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05219963-44b4-4c71-85ee-cb8669418a33",
                                                "sense_id": "5d06f854-4b13-3585-8e48-b7e8e5406fa1",
                                                "text": "007 hat die Lizenz zum Töten."
                                            },
                                            {
                                                "example_id": "0dfa774b-3455-4d6f-adbd-9ea62159baae",
                                                "sense_id": "5d06f854-4b13-3585-8e48-b7e8e5406fa1",
                                                "text": "Wer hier ein Kasino eröffnen darf, der hat die Lizenz zum Gelddrucken bekommen."
                                            },
                                            {
                                                "example_id": "993e5c57-1a47-41b3-8e73-3fbca4dc571c",
                                                "sense_id": "5d06f854-4b13-3585-8e48-b7e8e5406fa1",
                                                "text": "Um etwas in Lizenz herstellen zu dürfen, muss man meistens an den Lizenzinhaber zahlen."
                                            },
                                            {
                                                "example_id": "5bc0dbf7-ef31-4668-beae-01ed123195f2",
                                                "sense_id": "5d06f854-4b13-3585-8e48-b7e8e5406fa1",
                                                "text": "„Seine Fliegerlaufbahn begann er mit 14 Jahren in einem Segelflugzeug, mit 18 hatte er die Lizenz als Motorflieger.“"
                                            },
                                            {
                                                "example_id": "b0e0e4c9-ee5f-4efc-90e9-5241527932f7",
                                                "sense_id": "5d06f854-4b13-3585-8e48-b7e8e5406fa1",
                                                "text": "„Die Lizenz fürs Brauen, mit der der Betrieb monatelang hingehalten worden war, habe er innerhalb eines Tages besorgt.“"
                                            },
                                            {
                                                "example_id": "7a5d8ff1-8a4f-4c7b-8620-656a92b88564",
                                                "sense_id": "5d06f854-4b13-3585-8e48-b7e8e5406fa1",
                                                "text": "„Manchen Anwälten entziehen die Behörden die Lizenz, wenn man glaubt, dass es mit den Veränderungen reicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd30286e-6581-4692-8eab-66bc2b1c9930",
                        "source_entry_id": "31e6b104-23b6-3a58-b671-193a1cd56d20",
                        "source_sense_id": "51c5b66b-10e5-37c5-a72b-3c4086c20a60",
                        "source_sense_description": "nur Singular: die Erlaubnis oder Freiheit, nach eigenem Ermessen zu handeln",
                        "target_lang_word": "Freiheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freiheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44276837-20b3-3294-9b6d-0e10eb87fe09",
                                        "entry_id": "d5cd5720-1ae0-3dc2-ade2-f4ece16b7971",
                                        "glosses": [
                                            "Zustand, bei dem jemand von allen Zwängen und Pflichten frei ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f214feb4-bc24-4bc9-8855-0529083d3911",
                                                "sense_id": "44276837-20b3-3294-9b6d-0e10eb87fe09",
                                                "text": "„Freiheit nur für die Anhänger der Regierung, nur für Mitglieder einer Partei – mögen sie noch so zahlreich sein – ist keine Freiheit. Freiheit ist immer Freiheit der Andersdenkenden.“"
                                            },
                                            {
                                                "example_id": "16f9c90b-6fc4-4d17-9710-a8cb79e6e300",
                                                "sense_id": "44276837-20b3-3294-9b6d-0e10eb87fe09",
                                                "text": "„Wenn einem die Freiheit gewaltsam genommen wird, ist man natürlich nicht lächerlich, es sei denn für den, der sie einem gewaltsam genommen hat.“"
                                            },
                                            {
                                                "example_id": "d84999c8-b180-4872-bcd8-185c80ede825",
                                                "sense_id": "44276837-20b3-3294-9b6d-0e10eb87fe09",
                                                "text": "„Und diese Freiheit wurde zur Glückseligkeit, wenn sie aufging in jener Bindung, die alles Irdische übersteigt.“"
                                            },
                                            {
                                                "example_id": "1e5b1da5-8894-44c5-806a-c02efa7e26f6",
                                                "sense_id": "44276837-20b3-3294-9b6d-0e10eb87fe09",
                                                "text": "„Das Lebensgefühl der westlichen Welt oder, genauer gesagt, des nicht mehr ganz so Wilden Westens drückt sich in der Suche nach Freiheit und Selbstverwirklichung aus.“"
                                            },
                                            {
                                                "example_id": "a318343d-e2fb-4df7-8d9d-b96be0ac3fc1",
                                                "sense_id": "44276837-20b3-3294-9b6d-0e10eb87fe09",
                                                "text": "„Die Freiheit des Einzelnen bedeutete für den britischen Philosophen John Stuart Mill auch ein Recht auf Selbstbestimmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f91b22e4-7bc8-3253-b4de-bc7c60b0f858",
                                        "entry_id": "d5cd5720-1ae0-3dc2-ade2-f4ece16b7971",
                                        "glosses": [
                                            "in der freien Natur; nicht eingesperrt"
                                        ],
                                        "tags": [
                                            "in Freiheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb4b0ad-be68-4fba-9c88-99285f82e21f",
                                                "sense_id": "f91b22e4-7bc8-3253-b4de-bc7c60b0f858",
                                                "text": "Nach dreijähriger Haft ist er wieder in Freiheit."
                                            },
                                            {
                                                "example_id": "db4477f0-ecfc-4924-9bfe-834fc1eb47cf",
                                                "sense_id": "f91b22e4-7bc8-3253-b4de-bc7c60b0f858",
                                                "text": "Tiere haben auch ein Recht auf Freiheit und sollten nicht in Käfigen gehalten werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ee6dd9a6-2657-31f0-b5da-9d787fbe2bbf",
                                        "entry_id": "d5cd5720-1ae0-3dc2-ade2-f4ece16b7971",
                                        "glosses": [
                                            "Recht, das jemandem zusteht"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2479682-6c09-419a-8a72-02eb8efdccf6",
                                                "sense_id": "ee6dd9a6-2657-31f0-b5da-9d787fbe2bbf",
                                                "text": "Sie haben bei uns mehr Freiheiten als anderswo."
                                            },
                                            {
                                                "example_id": "89e470b1-dfd1-420a-b5aa-2a20538626c7",
                                                "sense_id": "ee6dd9a6-2657-31f0-b5da-9d787fbe2bbf",
                                                "text": "„Das Rasen bleibt erlaubt, weil sich einige Autofahrer nicht in ihrer Freiheit einschränken lassen wollen, so schnell zu fahren, wie es ihr Auto erlaubt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
