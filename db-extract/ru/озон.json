                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6c6a79e-5c15-3f14-81fb-ec51a45d02f5",
                        "entry_id": "5356d46f-f47d-388c-810b-82572a56dce1",
                        "glosses": [
                            "хим. соединение трёх атомов кислорода; газ со специфическим запахом, обладающий сильным окислительным и обеззараживающим свойством"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4eb707c-c14f-4f09-aef7-f1d0d21e4293",
                        "source_entry_id": "5356d46f-f47d-388c-810b-82572a56dce1",
                        "source_sense_id": "c6c6a79e-5c15-3f14-81fb-ec51a45d02f5",
                        "target_lang_word": "ozone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ozone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2215439a-3f46-3779-a165-e02057ff4e1a",
                                        "entry_id": "a0a2a1c0-da3a-3b53-a188-b20866706914",
                                        "glosses": [
                                            "An allotrope of oxygen (symbol O₃) having three atoms in the molecule instead of the usual two; it is a toxic gas, generated from oxygen by electrical discharge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a5f299-2d3a-4aa3-9766-f910fe7c5f94",
                                                "sense_id": "2215439a-3f46-3779-a165-e02057ff4e1a",
                                                "text": "Lightning flashed again, the thunder came a second later. It rained harder. The smell of ozone was strong. You could feel the charge in the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                        "entry_id": "a0a2a1c0-da3a-3b53-a188-b20866706914",
                                        "glosses": [
                                            "Fresh air, especially that breathed at the seaside and smelling of seaweed."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "920cfe3b-94fa-4026-8f6a-1390e545b362",
                                                "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                                "text": "A patent obtained in England, and specified far from clearly, for obtaining ozone by boiling seaweed,†† may be mentioned as a curiosity, and also the credulity with which ozone-baths, prepared in this manner, find a ready sale, in spite of, or perhaps rather on account of, their high price."
                                            },
                                            {
                                                "example_id": "3622afa1-061d-49a7-8dde-dad898207cf9",
                                                "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                                "text": "To Ramsgate baths she sped, in quest / Of seaweed and ozone ; / For seaweed and ozone were best, / They said, to give her tone."
                                            },
                                            {
                                                "example_id": "56a4eac3-6d6f-4fd7-b39f-8f6a96623336",
                                                "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                                "text": "It's got the lot: fresh sea air, ozone, seaweed. You could cut the air with a knife."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ozone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                        "entry_id": "344bf4c2-c09b-3808-8757-7dc980f240a1",
                                        "glosses": [
                                            "To treat with ozone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9461f6-a0db-4ae1-ad97-e4c3885a3f52",
                                                "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                                "text": "Whenever it exists, as it usually does, even where the tide water freshens at the ebb, it seems to have a purifying tendency, probably by ozoning the superincumbent atmosphere."
                                            },
                                            {
                                                "example_id": "a169e060-f40c-4232-a1c8-59e1913071e8",
                                                "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                                "text": "I worked nonstop to make the house safe. Periodically I ozoned the first-floor bathroom, but it still made us sick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "381e57c5-ccaa-4876-912d-51a7de49fdc3",
                        "source_entry_id": "5356d46f-f47d-388c-810b-82572a56dce1",
                        "source_sense_id": "c6c6a79e-5c15-3f14-81fb-ec51a45d02f5",
                        "target_lang_word": "ozono",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ozono",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "24975eaf-a6cc-3324-a246-18dd688820ea",
                                        "entry_id": "f787a6b3-1b85-3c92-b665-14006bc22bb8",
                                        "glosses": [
                                            "Sustancia cuya molécula está compuesta por tres átomos de oxígeno. A temperatura y presión ambientales el ozono es un gas de olor acre y generalmente incoloro, pero en grandes concentraciones puede volverse ligeramente azulado. Si se respira en grandes cantidades, es tóxico y puede provocar la muerte. El ozono se encuentra de forma natural en la estratosfera, formando la denominada capa de ozono, que no deja pasar la perjudicial radiación ultravioleta hasta la superficie de la Tierra."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
