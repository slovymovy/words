                                        "sense_id": "f71bfb09-ae78-3c07-843f-3e1597265272",
                                        "entry_id": "c292b1d4-af86-3b63-92a2-fa51c0a66c07",
                                        "glosses": [
                                            "Spiel um den gesamten Einsatz, hochriskantes Unternehmen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa72bee1-46e2-40e3-94ce-8ec11d21d623",
                                                "sense_id": "f71bfb09-ae78-3c07-843f-3e1597265272",
                                                "text": "In der Tat sind Investitionen in Deutschland schon deshalb ein Vabanquespiel, weil das Steuerrecht extrem kompliziert ist."
                                            },
                                            {
                                                "example_id": "a97274a9-b22b-419f-b954-a9283f34ff73",
                                                "sense_id": "f71bfb09-ae78-3c07-843f-3e1597265272",
                                                "text": "Ihre gestiegenen Ansprüche an Partnerschaft und Familien-Engagement machten die Entscheidung für Kinder zu einem ständigen \"Vabanquespiel zwischen Karrierezwängen und Organisations-Notwendigkeiten.\""
                                            },
                                            {
                                                "example_id": "5357347b-848d-4ae3-96a9-9c4b90449997",
                                                "sense_id": "f71bfb09-ae78-3c07-843f-3e1597265272",
                                                "text": "„Das Vabanquespiel ging auf, weil die vorrückenden Feinde erschöpft waren:…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "525b2b1c-9601-4731-ac13-c76397b02675",
