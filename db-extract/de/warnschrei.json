                        "examples": [
                            {
                                "example_id": "1d3c98de-33d8-47d8-b69e-dc3c451d5b43",
                                "sense_id": "9f781c20-9918-326e-8536-7bf9d6f1df02",
                                "text": "„Mein Warnschrei ging im Donner einer vollen Breitseite unter.“"
                            },
                            {
                                "example_id": "694e9cbe-39e2-44e2-a222-ffaf77a25325",
                                "sense_id": "9f781c20-9918-326e-8536-7bf9d6f1df02",
                                "text": "„Nicht lange, nachdem sie den Berg verlassen hatten, schrillte der Warnschrei der Frauen wieder los, und diesmal war es ernst.“"
                            }
                        ],
