        "fr-extract.jsonl": [
            {
                "entry_id": "83021be3-4806-3d14-8680-dfb553c4d89a",
                "word": "gloutonnerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "55809f5e-f356-44cf-b91e-e3d2afcaba73",
                        "entry_id": "83021be3-4806-3d14-8680-dfb553c4d89a",
                        "tags": [
                            "plural"
                        ],
                        "form": "gloutonneries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                        "entry_id": "83021be3-4806-3d14-8680-dfb553c4d89a",
                        "glosses": [
                            "Défaut de celui qui est glouton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7a1527-bff6-46be-9f36-9164d8504fe1",
                                "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                                "text": "En se livrant aux plaisirs de la table, ils recherchaient la délicatesse et évitaient les excès, et avaient l’habitude de reprocher l’ivrognerie et la gloutonnerie aux Saxons vaincus, comme des vices inhérents à leur basse condition."
                            },
                            {
                                "example_id": "3bf33594-d5c8-4c00-a9bc-c3f2d5432acf",
                                "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                                "text": "L'œsophage est court et large, grâce à quoi le crapaud restitue aisément ce qui lui disconvient, disposition pour lui précieuse, eu égard à sa gloutonnerie."
                            },
                            {
                                "example_id": "4736663f-2250-4721-bc46-01108d92b802",
                                "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                                "text": "Le couple, qui avait nagé et qui s’était embrassé, avait perdu ses lunettes de soleil. Elle les vit se plaindre auprès d’Agustin, comme s’il était responsable de la force et de la gloutonnerie de la mer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1be59918-db52-4f9a-8c32-ee1c2e6de8c5",
                        "source_entry_id": "83021be3-4806-3d14-8680-dfb553c4d89a",
                        "source_sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                        "target_lang_word": "Völlerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Völlerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8617bf2-ac96-3655-b298-8b49f88eaff5",
                                        "entry_id": "55990e57-4d0c-3dbd-a4bd-3b015441e376",
                                        "glosses": [
                                            "Essen und Trinken im Übermaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1e78ab-202e-462a-be74-bca733a8fe31",
                                                "sense_id": "f8617bf2-ac96-3655-b298-8b49f88eaff5",
                                                "text": "„Nach der weihnachtlichen Völlerei sehnen sich viele nach leichten Speisen.“"
                                            },
                                            {
                                                "example_id": "9b479b91-9a73-4678-b68a-b32dbab2fed8",
                                                "sense_id": "f8617bf2-ac96-3655-b298-8b49f88eaff5",
                                                "text": "„Wo das Lebensmittel zur Lebensmitte wird, da beginnt die Völlerei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90e894d6-2f85-4efd-a9d2-9e917d47520a",
                        "source_entry_id": "83021be3-4806-3d14-8680-dfb553c4d89a",
                        "source_sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                        "target_lang_word": "Gefräßigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefräßigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cba151c-f768-3f74-ade7-c28b3c563c44",
                                        "entry_id": "a9e16d60-6d1c-3538-82cd-f82ac1805333",
                                        "glosses": [
                                            "Drang/Handlung, Nahrung in (zu) großen Mengen zu sich zu nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7efd4da-57a6-408a-ae27-10f73717db4d",
                                                "sense_id": "7cba151c-f768-3f74-ade7-c28b3c563c44",
                                                "text": "„Der sinnenfreudige, denkende Mensch verachtet die Gefräßigkeit, die Hurerei und die brutale Rache in einer ersten Zornesaufwallung.“"
                                            },
                                            {
                                                "example_id": "cff387f7-9eba-4b4c-bef7-56a57a92e770",
                                                "sense_id": "7cba151c-f768-3f74-ade7-c28b3c563c44",
                                                "text": "„Ich weiß nicht, weshalb Begräbnisse appetitanregend sind, aber zwei innerhalb von so kurzer Zeit, das von Carlota und das von Luis, haben bei Pepa eine beleidigende Gefräßigkeit ausgelöst.“"
                                            },
                                            {
                                                "example_id": "02a15d95-7596-476c-a4fe-7e1f13f59184",
                                                "sense_id": "7cba151c-f768-3f74-ade7-c28b3c563c44",
                                                "text": "„Der Hase, dessen Gefräßigkeit bekannt war, ist zudem eine Anspielung auf Osiris, den Gott der fruchtbaren und wieder auflebenden Vegetation, der fruchtbaren Erde und des Korns, aus dem der Weizen wächst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "028461ad-8e27-4765-979b-9f8cc6eb8abd",
                        "source_entry_id": "83021be3-4806-3d14-8680-dfb553c4d89a",
