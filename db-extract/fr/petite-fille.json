                "senses": [
                    {
                        "sense_id": "153f9de9-38f9-3c24-b949-960c165646f1",
                        "entry_id": "7604086f-eab8-3398-8759-65c64d7f7d6c",
                        "glosses": [
                            "Fille de l’enfant d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667ea6bf-cf7b-41ec-948e-9d293f8c121f",
                                "sense_id": "153f9de9-38f9-3c24-b949-960c165646f1",
                                "text": "J'arrive à l'Espérance les Hauts, chez Marie-Ange, dite madame Gaston, qui marie aujourd'hui son arrière-petite-fille. […]. Depuis janvier, Yolaine, la petite-fille de Marie-Ange, préparait le mariage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05cca081-adc4-4d04-bcbb-163a9bd61d2a",
                        "source_entry_id": "7604086f-eab8-3398-8759-65c64d7f7d6c",
                        "source_sense_id": "153f9de9-38f9-3c24-b949-960c165646f1",
                        "target_lang_word": "Enkelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enkelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59c025d3-705d-36cd-8fec-cae19e99e8bb",
                                        "entry_id": "5ec0532a-dd7b-355f-89bf-de206d8701b8",
                                        "glosses": [
                                            "weibliches Kind von Sohn oder Tochter (Kindes-Kind) oder weibliche Nachfahrin der zweiten Generation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13392bcd-7f93-475b-bb8b-02ace6984b93",
                                                "sense_id": "59c025d3-705d-36cd-8fec-cae19e99e8bb",
                                                "text": "Meine Enkelin ist sieben Jahre alt."
                                            },
                                            {
                                                "example_id": "4386220d-310c-4fb3-9a4d-4cbe9d21f131",
                                                "sense_id": "59c025d3-705d-36cd-8fec-cae19e99e8bb",
                                                "text": "„Als ich ihn fragte, warum er nicht ein Machtwort sprach, um seine Enkelin vor der Beschneidung zu retten, spielte er den Ahnungslosen.“"
                                            },
                                            {
                                                "example_id": "cb1069c0-f9dd-4195-8d00-6aac044b9cb7",
                                                "sense_id": "59c025d3-705d-36cd-8fec-cae19e99e8bb",
                                                "text": "„Als das Gift zu wirken begann und der Mann verzweifelt um Hilfe schrie, drohte sie ihm, wiederzukommen und ihn zu entmannen, wenn er es noch einmal wagen sollte, ihrer Enkelin zu nahe zu kommen.“"
                                            },
                                            {
                                                "example_id": "61b3c373-30e5-4a7a-a859-04827ad7e6c9",
                                                "sense_id": "59c025d3-705d-36cd-8fec-cae19e99e8bb",
                                                "text": "„Enkelin Lena hat sich viel mit ihren beiden Großmüttern über den Krieg unterhalten.“"
                                            },
                                            {
                                                "example_id": "42acf3b6-7343-4e87-b8e1-7d1a90c2c336",
                                                "sense_id": "59c025d3-705d-36cd-8fec-cae19e99e8bb",
                                                "text": "„Im Laufe der Analysen kristallisierte sich allerdings heraus, dass auch unbearbeitete Themen aus der Familienvergangenheit bei den Enkelinnen und Urenkelinnen ihren Niederschlag fanden.“"
                                            },
                                            {
                                                "example_id": "7d2a022f-a2d1-4891-a826-5fb9ece92331",
                                                "sense_id": "59c025d3-705d-36cd-8fec-cae19e99e8bb",
                                                "text": "„Sie zeigt uns die kleine Bauernkate, die sie mit der Enkelin bewohnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53dbe08a-2f08-4c0e-9948-ef1bb2231893",
