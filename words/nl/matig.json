            "senses": [
                {
                    "sense_id": "6cfc4e46-4d87-3101-bade-75701a1fbd4d",
                    "sense_definition": "niet overdreven of buitensporig; beheerst in gedrag of consumptie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beheersing",
                    "name_type": "no",
