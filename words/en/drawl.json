{
    "word_family": [
        "drawler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edcbfba8-f02e-3e6e-a6f8-47482a7b9d0b",
                    "sense_definition": "To speak with a slow, lazy, or spiritless tone, often by lengthening vowel sounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speaking_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would <w>drawl</w> his words, making it clear he was not interested in the conversation."
                        },
                        {
                            "text": "The actor began to <w>drawl</w> in a bored voice to portray the lazy character."
                        }
                    ],
                    "synonyms": [
                        "drone"
                    ],
                    "common_phrases": [
                        "drawl out words"
                    ]
                },
                {
                    "sense_id": "5629b5a9-64fb-3fe5-8368-cb0e8359d8f8",
                    "sense_definition": "To utter or pronounce words in a dull, spiritless tone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speaking_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She continued to <w>drawl</w> her complaints without any real emotion."
                        },
                        {
                            "text": "The tired student started to <w>drawl</w> his response to the teacher's question."
                        }
                    ],
                    "synonyms": [
                        "drone"
                    ]
                },
                {
                    "sense_id": "4ed7f841-6216-371e-ba1e-bc13e2182781",
                    "sense_definition": "To move in a slow, heavy, or lazy manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man would <w>drawl</w> along the path, taking his time with every step."
                        },
                        {
                            "text": "After the long hike, the group began to <w>drawl</w> toward the campsite."
                        }
                    ],
                    "synonyms": [
                        "dawdle",
                        "amble"
                    ],
                    "antonyms": [
                        "hasten",
                        "rush"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ]
                },
                {
                    "sense_id": "6358b901-8497-31e8-a756-0e6e27a2ad54",
                    "sense_definition": "To waste time or spend time in an idle, slow manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would <w>drawl</w> away the afternoon sitting on the porch."
                        },
                        {
                            "text": "There is no time to <w>drawl</w> when the deadline is approaching so quickly."
                        }
                    ],
                    "synonyms": [
                        "dawdle",
                        "loiter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac341cba-422b-3622-82e5-8a27a797801c",
                    "sense_definition": "A slow way of speaking that involves lengthening vowel sounds and running words together.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speaking_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with a thick Southern <w>drawl</w> that made him sound very relaxed."
                        },
                        {
                            "text": "The actor adopted a slow <w>drawl</w> to play the role of a cowboy."
                        }
                    ],
                    "common_phrases": [
