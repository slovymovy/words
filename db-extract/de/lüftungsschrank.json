                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "beb58e3a-4890-394a-8225-cf905759ff54",
                        "entry_id": "84c1f4aa-41f7-309e-87cc-4087d4451c3e",
                        "glosses": [
                            "geschlossenes Möbelstück, meistens mit Türen",
                            "Möbelstück mit integrierter Lüftungstechnik zur Raumluftaufbereitung um [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a564359-a37d-41aa-933d-1b8e59adcac5",
                                "sense_id": "beb58e3a-4890-394a-8225-cf905759ff54",
                                "text": "„Der maßgebliche Vorteil: Alle Komponenten für wirksame Lüftung befinden sich in einem einzigen Lüftungsschrank.“"
                            },
                            {
                                "example_id": "f8226ee0-99a0-4f72-bb9f-17b5933e0874",
                                "sense_id": "beb58e3a-4890-394a-8225-cf905759ff54",
                                "text": "„Entzündet hatte sich der Konflikt an einem Ortstermin im Klassenzimmer, bei dem die Funktion eines Lüftungsschrankes demonstriert werden sollte.“"
                            },
                            {
                                "example_id": "f4c1f29d-0774-4cfa-b326-72dbc8c56221",
                                "sense_id": "beb58e3a-4890-394a-8225-cf905759ff54",
                                "text": "„Beide Lüftungsschränke wurden in Einzelteilen zerlegt.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "2ae2c2d8-c4ff-34aa-944f-e742ee3665cb",
                        "entry_id": "84c1f4aa-41f7-309e-87cc-4087d4451c3e",
                        "glosses": [
                            "geschlossenes Möbelstück, meistens mit Türen",
                            "Möbelstück mit integrierter Lüftungstechnik zur Raumluftaufbereitung in [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d0c610-f2a0-48c4-a67f-09c2142546c7",
                                "sense_id": "2ae2c2d8-c4ff-34aa-944f-e742ee3665cb",
                                "text": "Moderne Lüftungsschränke in Niedrigenergiehäusern sind an die zentrale Wohnungslüftung angeschlossen und ersetzen der klassischen Wäschetrockner, um die Wärmeenergie besser auszunutzen."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "368e36f1-7648-3648-b6fe-3e1d0ea2b36f",
                        "entry_id": "84c1f4aa-41f7-309e-87cc-4087d4451c3e",
                        "glosses": [
                            "elektrischer Schaltschrank zur Steuerung der Lüftungstechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5c4eec-ecdd-4752-a449-9db9932df61b",
                                "sense_id": "368e36f1-7648-3648-b6fe-3e1d0ea2b36f",
                                "text": "„Das dunkle Grün wird im eingefärbten Lüftungsschrank sowie den Startblöcken nochmals aufgegriffen, das helle Pendant soll die Badbesucher an der ihnen gegenüberliegenden Wand im Eingangsbereich begrüßen.“"
                            },
                            {
                                "example_id": "108eff81-5123-4716-8d84-b720bb308b36",
                                "sense_id": "368e36f1-7648-3648-b6fe-3e1d0ea2b36f",
                                "text": "„Serienschaltung aller eingebundenen Notschalter einer Lüftungszentrale zur Verwendung in der Brandschutzsteuerung des Lüftungsschrankes (Steuerung Notschalter Brand), Weitermeldung der Schalterstellung an eine Störmeldeanzeige und die Steuerung für die händische Brandfall-Auslösung, einschließlich Relais.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
