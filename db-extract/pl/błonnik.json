                        "source_entry_id": "79ba5615-014f-316f-844e-657dcfeb57cb",
                        "source_sense_id": "a5bc2f50-6394-3f91-9a0d-1589af2ac6ff",
                        "target_lang_word": "celulosa",
                        "target_lang_code": "es",
