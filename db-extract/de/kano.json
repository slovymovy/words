                ],
                "senses": [
                    {
                        "sense_id": "8439a82f-1ba6-3f8f-bfe4-db12aae78d8f",
                        "entry_id": "1d7e8799-99e1-3835-abc2-d51e3aa60e61",
                        "glosses": [
                            "Großstadt in Nordnigeria"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0e2863-551c-4e9e-9260-2dbe13dd4b56",
                                "sense_id": "8439a82f-1ba6-3f8f-bfe4-db12aae78d8f",
                                "text": "„Er hatte es auf den Gesichtern gesehen, die in Lagos und Abuja und Kano und Ibadan aus den Bussen gestiegen waren: ein benommener bloß-den-Tag-überstehen-Blick.“"
                            },
                            {
                                "example_id": "bdf1653d-5740-4d4e-961e-cb0dc0b89f55",
                                "sense_id": "8439a82f-1ba6-3f8f-bfe4-db12aae78d8f",
                                "text": "„Es gibt die Möglichkeit, dass er mit dem Auto über Kano nach Maradi fährt, wo er bei einem meiner ehemaligen Schüler untertauchen kann.“"
                            },
                            {
                                "example_id": "cbfd0e8e-c4ec-495e-9faa-80b151a6f5ca",
                                "sense_id": "8439a82f-1ba6-3f8f-bfe4-db12aae78d8f",
                                "text": "„›Das muss eine ziemliche Umstellung gewesen sein, aus so einer großen Stadt wie Kano nach Okriki zu kommen‹, bemerke ich und versuche hinter sein ausdrucksloses Lächeln zu blicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0d45493d-fe09-38f0-9118-1401a3eb6156",
                        "entry_id": "1d7e8799-99e1-3835-abc2-d51e3aa60e61",
                        "glosses": [
                            "nigerianischer Bundesstaat mit [1] als Hauptstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0cbe3a0-a203-4e0c-9ac0-0042884c4e82",
                                "sense_id": "0d45493d-fe09-38f0-9118-1401a3eb6156",
                                "text": "„›Anscheinend will Miriams Vater sich zum Gouverneur des Bundesstaats Kano wählen lassen.‹“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
