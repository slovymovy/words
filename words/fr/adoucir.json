                {
                    "sense_id": "b883e488-a48b-30ed-8f7d-9598a97a3f52",
                    "sense_definition": "Rendre une souffrance, une peine ou une situation difficile plus facile à supporter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attenuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette tisane chaude aide à <w>adoucir</w> la douleur de gorge.",
                            "target_lang_translations": {
                                "en": "This hot herbal tea helps to <w>ease</w> a sore throat.",
                                "ru": "Этот горячий травяной чай помогает <w>облегчить</w> боль в горле.",
                                "de": "Dieser heiße Kräutertee hilft, die Halsschmerzen zu <w>lindern</w>.",
                                "es": "Esta infusión caliente ayuda a <w>aliviar</w> el dolor de garganta.",
                                "zh": "这杯热草药茶有助于<w>缓解</w>喉咙痛。"
                            }
                        },
                        {
                            "text": "Ses paroles réconfortantes ont permis d'<w>adoucir</w> le chagrin de son ami.",
                            "target_lang_translations": {
                                "en": "Comforting words helped to <w>ease</w> a friend's grief.",
                                "ru": "Утешительные слова помогли <w>облегчить</w> горе друга.",
                                "de": "Seine tröstenden Worte halfen, den Kummer seines Freundes zu <w>lindern</w>.",
                                "es": "Sus palabras reconfortantes permitieron <w>aliviar</w> la pena de su amigo.",
                                "zh": "他那些安慰的话，帮朋友<w>减轻</w>了悲伤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adoucir la douleur",
                        "adoucir les peines"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a suffering, grief, or difficult situation easier to bear.",
                        "ru": "Делать страдание, горе или трудную ситуацию легче для перенесения.",
                        "de": "Schmerzen, Kummer oder eine schwierige Lage leichter erträglich machen.",
                        "es": "Hacer más llevadero un dolor, una pena o una situación difícil.",
                        "zh": "减轻痛苦、悲伤或困难处境，使其更易于忍受。"
                    },
                    "translations": {
