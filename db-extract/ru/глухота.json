                        "examples": [
                            {
                                "example_id": "a416f17f-1056-413f-b759-cf090d4bc4b6",
                                "sense_id": "5afaf585-555e-3d75-9db8-60cf02119a4f",
                                "text": "Глухота наступила вследствие употребления антибиотиков."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb1467f8-1c52-3ff6-8444-26cb054f540c",
                        "entry_id": "241b8679-21e7-30ff-8a22-a1f2167e781f",
                        "glosses": [
                            "перен. отсутствие отзывчивости, чуткости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7869db6e-3f47-427a-b578-b7068a0a1d4f",
                                "sense_id": "fb1467f8-1c52-3ff6-8444-26cb054f540c",
                                "text": "Если стяжание становится для человека или народа смыслом жизни, сочетается с жестокостью, несправедливостью, гордыней, глухотой к страданиям ближних, то оно, несомненно, является греховным."
                            }
                        ]
                    }
