                                        "entry_id": "b2a27e90-e5e2-3f54-92a8-0222853fb93d",
                                        "glosses": [
                                            "A male given name from the Germanic languages, the usual U.S. spelling of Geoffrey. Popular in the latter half of the 20th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47fd52d5-1439-483e-ad44-cb77ef05ac41",
                                                "sense_id": "4705accb-9572-3257-8865-c51cd9366db6",
                                                "text": "- - - you should also be able to sue your association's attorney when they step over the line as Attorney Jeffrey Ewalt did. Oh, my gosh! Even as I say his name Jeffrey, Jeffrey. Jeffrey is a name assigned to little boys with small toys. A cute innocent little boy that would do no harm to anyone. I recommend a name change for Jeffrey Ewalt from Jeffrey to Lucifer."
                                            },
                                            {
                                                "example_id": "ca7d03bc-9dab-4f4b-b7a7-abf8db046854",
                                                "sense_id": "4705accb-9572-3257-8865-c51cd9366db6",
                                                "text": "A woman who testified Tuesday in the sex trafficking trial of Ghislaine Maxwell said she met the close confidante of Jeffrey Epstein and the billionaire businessman when she was 14 and eating ice cream with friends at a camp where he was a benefactor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92da5a8-03b7-3e8d-a411-57aeaed711f6",
                                        "entry_id": "b2a27e90-e5e2-3f54-92a8-0222853fb93d",
                                        "glosses": [
                                            "A surname originating as a patronymic derived from Geoffrey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1aa1a9b-439d-48fc-8798-378f942610cf",
                                                "sense_id": "c92da5a8-03b7-3e8d-a411-57aeaed711f6",
                                                "text": "Health to great [Francis] Jeffrey! Heaven preserve his life\nTo flourish on the fertile shores of Fife\nAnd guard it sacred in the future wars\nSince authors sometimes seek the field of Mars!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
