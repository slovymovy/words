                "senses": [
                    {
                        "sense_id": "10d95664-2f2b-372f-af2b-360d9fd4060d",
                        "entry_id": "97ef7cc6-0c4c-3b31-8730-449ee20f4a54",
                        "glosses": [
                            "A short piece of music or act in the interval of the main spectacle; a theatrical interlude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab036d0a-5002-4ad9-b847-2d1f25f1a41f",
                                "sense_id": "10d95664-2f2b-372f-af2b-360d9fd4060d",
                                "text": "She had ample time, too, to change for the next scene, which started with a longish intermezzo staged by a ballet company whose services Scotty had engaged [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d0d1a26-7889-3b44-a971-563d3d6d0e79",
                        "entry_id": "97ef7cc6-0c4c-3b31-8730-449ee20f4a54",
                        "glosses": [
                            "A palate cleanser; a small snack with a bright light neutral taste; a fruit; a fresh sparkling wine; or a fruity or milky cocktail; that is served between courses in a meal."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "493437ae-a271-3413-a775-10aa403904e7",
                        "entry_id": "97ef7cc6-0c4c-3b31-8730-449ee20f4a54",
                        "glosses": [
                            "A tactical move which interrupts the execution of the current plan."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53f6890e-d751-4931-a501-ff7466bda601",
                        "source_entry_id": "97ef7cc6-0c4c-3b31-8730-449ee20f4a54",
