                "senses": [
                    {
                        "sense_id": "b3df5aab-4783-3036-83e9-233420c3030b",
                        "entry_id": "b3c19b1c-24de-3db7-bd89-d8e636d68e45",
                        "glosses": [
                            "способный очень много съесть, жадный к еде; ненасытный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3c6829-1cc2-4376-a568-46662d1dcd5f",
                                "sense_id": "b3df5aab-4783-3036-83e9-233420c3030b",
                                "text": "Когда девушка замахнулась на прожорливого петуха, у ней половина косы, от этого движения, упала на шею и спину, но она, не обращая внимания, продолжала бросать зёрна."
                            }
                        ]
                    }
                ],
