                                        "sense_id": "4dde8114-477b-31c7-b48f-b310ec2377c1",
                                        "entry_id": "9f9474c7-fb50-35fa-8303-235a2732fed7",
                                        "glosses": [
                                            "zdarzenie, którego nie można przewidzieć lub w żaden sposób mu zapobiec"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce914a8-626f-496b-91c7-2247ff0f00a8",
                                                "sense_id": "4dde8114-477b-31c7-b48f-b310ec2377c1",
                                                "text": "Sąd stwierdził, że huragan był działaniem siły wyższej i zwolnił dostawcę od odszkodowania za nieterminową dostawę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "346597ca-3ee0-3ad9-97b1-db47dc3cffc1",
                                        "entry_id": "9f9474c7-fb50-35fa-8303-235a2732fed7",
                                        "glosses": [
                                            "to, co uosabia bóstwo lub coś o podobnym charakterze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b2dcfd-d4ff-4c49-92d7-82acefac3d66",
                                                "sense_id": "346597ca-3ee0-3ad9-97b1-db47dc3cffc1",
                                                "text": "Ateista nie wierzył w Boga, Allaha, Zeusa, Matkę Naturę ani w żadną inną siłę wyższą."
                                            }
