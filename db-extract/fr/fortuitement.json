                        ]
                    },
                    {
                        "translation_id": "d757259e-ae31-48ac-810b-597ffd461f8d",
                        "source_entry_id": "73a56eca-be44-31b3-9705-a63cef895423",
                        "source_sense_id": "615f8686-4ef2-3429-8f1a-00c03e8f0a9a",
                        "source_sense_description": "zufällig, zufälligerweise",
                        "target_lang_word": "zufälligerweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zufälligerweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                        "entry_id": "afd817d8-1340-3c26-bc68-10eb5050a8cb",
                                        "glosses": [
                                            "durch Zufall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430a9631-82f8-498d-b678-29eaad846e3e",
                                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                                "text": "\"Ich habe eine Schulfreundin zufälligerweise im Supermarkt wiedergetroffen.\""
                                            },
                                            {
                                                "example_id": "61c29e23-8145-43ce-a30a-a0a4484b5b84",
                                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                                "text": "\"Ich bestelle zufälligerweise dieselben Bücher wie ein Terrorist und, zack, bin ich im Fadenkreuz der Geheimdienste. So landen harmlose Bürger auf der Liste von Terrorverdächtigen.\""
                                            },
                                            {
                                                "example_id": "08f3db82-2fd2-45af-af82-c0ecb8d3d768",
                                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                                "text": "Alle zwei Wochen ist er [der 26-jährige Maximilian Feldhake] in Dresden, um seine Gastfamilie zu besuchen – dann laufe er oft bei der Gegendemonstration mit, \"also wenn ich zufälligerweise sowieso gerade in Dresden bin.\""
                                            },
                                            {
                                                "example_id": "8d3dd451-eacc-4db3-9d2a-e6c3f4f6eee8",
                                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                                "text": "In der EU gibt es ausreichend Geld, um Grenzzäune zu errichten, aber nicht genug, um den Ländern zu helfen, die zufälligerweise auf der Flüchtlingsroute liegen und diese Hilfe dringend brauchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
