                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wijk</w> niet van mijn standpunt, wat er ook gebeurt.",
                            "target_lang_translations": {
                                "en": "I do not <w>deviate</w> from my position, no matter what happens.",
                                "ru": "Я не <w>отступаю</w> от своей точки зрения, что бы ни случилось.",
                                "pl": "Nie <w>ustępuję</w> ze swojego stanowiska, bez względu na to, co się stanie.",
                                "de": "Ich <w>weiche</w> nicht von meinem Standpunkt <w>ab</w>, egal was passiert.",
                                "fr": "Je ne <w>dévie</w> pas de ma position, quoi qu'il arrive.",
                                "it": "Non <w>devio</w> dalla mia posizione, qualunque cosa accada.",
                                "cs": "Ne<w>odstupuji</w> od svého stanoviska, ať se děje, co se děje.",
                                "tr": "Ne olursa olsun görüşümden <w>sapmıyorum</w>.",
                                "es": "No <w>me desvío</w> de mi postura, pase lo que pase.",
                                "zh": "无论发生什么，我都不会<w>偏离</w>我的立场。"
                            }
                        },
                        {
                            "text": "Als er een ambulance aankomt, <w>wijk</w> ik direct uit naar de kant.",
                            "target_lang_translations": {
                                "en": "When an ambulance arrives, I immediately <w>give way</w> to the side.",
                                "ru": "Когда приближается скорая помощь, я сразу <w>сворачиваю</w> в сторону.",
                                "pl": "Gdy nadjeżdża karetka, natychmiast <w>zjeżdżam</w> na bok.",
                                "de": "Wenn ein Krankenwagen kommt, <w>weiche</w> ich sofort an den Rand <w>aus</w>.",
                                "fr": "Quand une ambulance arrive, je <w>m'écarte</w> immédiatement sur le côté.",
                                "it": "Quando arriva un'ambulanza, mi <w>scosto</w> immediatamente di lato.",
                                "cs": "Když přijíždí sanitka, okamžitě <w>uhýbám</w> ke straně.",
                                "tr": "Ambulans geldiğinde hemen kenara <w>çekiliyorum</w>.",
                                "es": "Cuando llega una ambulancia, <w>me aparto</w> inmediatamente hacia un lado.",
