                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d0a9fa5-f814-36c5-8b3c-29a992caaa9a",
                                        "entry_id": "0d650a90-4bb6-36dc-9ef1-af3fc7f2425f",
                                        "glosses": [
                                            "An igneous rock composed of feldspar and hornblende."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0f21599-f3c9-4543-b9d6-b73de488de8d",
                                                "sense_id": "3d0a9fa5-f814-36c5-8b3c-29a992caaa9a",
                                                "text": "The temple, of which some massive hewn blocks and a fine column of Syenite granite still mark the site, occupied a terrace facing the source of the river and commanding a magnificent prospect."
                                            },
                                            {
                                                "example_id": "081d9b66-8498-400f-8910-dac8e815af43",
                                                "sense_id": "3d0a9fa5-f814-36c5-8b3c-29a992caaa9a",
                                                "text": "Much of the southern half of the southeastern body is a mafic syenite, slightly more felsic than the shonkinite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
