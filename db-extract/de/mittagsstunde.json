                "senses": [
                    {
                        "sense_id": "c4df7a36-e9ef-38be-ab68-f2ff4e51f50d",
                        "entry_id": "556fbad5-715b-38db-80e3-c50862ad89ca",
                        "glosses": [
                            "etwa eine Stunde um Mittag herum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f940077-9d4d-4791-afdc-128fedc5639d",
                                "sense_id": "c4df7a36-e9ef-38be-ab68-f2ff4e51f50d",
                                "text": "In der Mittagsstunde erreicht die Sonne den höchsten Punkt am Firmament."
                            },
                            {
                                "example_id": "89ce4790-c304-4999-ae5b-244641af2318",
                                "sense_id": "c4df7a36-e9ef-38be-ab68-f2ff4e51f50d",
                                "text": "Doch immer mehr Gemeinden gehen dazu über, die Ruhezeiten rund um die Mittagsstunde aus ihren öffentlichen Verordnungen zu streichen."
                            },
                            {
                                "example_id": "1a56552d-0675-4165-85de-8f8ff1c8801a",
                                "sense_id": "c4df7a36-e9ef-38be-ab68-f2ff4e51f50d",
                                "text": "Um die Mittagsstunde sportlich zu nutzen, bietet sich Yoga an."
                            },
                            {
                                "example_id": "e0f17f6f-af9d-4336-843c-d6f35513cd26",
                                "sense_id": "c4df7a36-e9ef-38be-ab68-f2ff4e51f50d",
                                "text": "„Es ist sehr heiß um die Mittagsstunde, aber vielerorten sind die Straßen überdacht und gut beschattet.“"
                            },
                            {
                                "example_id": "941b55d7-91a4-4786-aead-2d90c2526efa",
                                "sense_id": "c4df7a36-e9ef-38be-ab68-f2ff4e51f50d",
                                "text": "„Um die Mittagsstunde des 22. Oktober marschierte Pierre auf der schmutzigen, glitschigen Strasse und sah dabei auf seine Füsse und die Unebenheiten des Weges.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
