                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>E</w> said that eir car was parked outside the building.",
                            "target_lang_translations": {
                                "ru": "<w>Э</w> сказал(а), что его/её машина припаркована у здания.",
