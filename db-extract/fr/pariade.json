                        ],
                        "examples": [
                            {
                                "example_id": "4ddb0c57-98ca-4ca0-968c-22396c9862b6",
                                "sense_id": "ffc3c649-9218-3d08-9d6d-eff57ca78a40",
                                "text": "La chasse est défendue pendant la pariade."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f573a5b-b7ac-3dbf-a912-a623e79482f9",
                        "entry_id": "77348077-edb3-3fe9-b0ca-247e23366bde",
