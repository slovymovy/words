                                        "entry_id": "3c4d9541-90b1-38e7-9381-3fb0a2730b1d",
                                        "glosses": [
                                            "The removal of harmful substances from the blood; renal clearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89df0b61-b3cf-3272-a934-1eb460b42d57",
                                        "entry_id": "3c4d9541-90b1-38e7-9381-3fb0a2730b1d",
                                        "glosses": [
