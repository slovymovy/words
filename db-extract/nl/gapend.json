        "nl-extract.jsonl": [
            {
                "entry_id": "0b4d9a25-ae63-37af-8408-d3c2a40dff11",
                "word": "gapend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "abfe7764-e1c7-3299-a773-8719fe727419",
                        "entry_id": "0b4d9a25-ae63-37af-8408-d3c2a40dff11",
                        "glosses": [
                            "slaapverwekkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "297122c8-eb5e-4902-87e8-bfd6d530e24f",
                                "sense_id": "abfe7764-e1c7-3299-a773-8719fe727419",
                                "text": "Het bijzondere aan de verkiezingen van morgen is dat die niet gapend voorspelbaar zijn. Sinds bijna honderd jaar zetten de Zweedse socialisten de toon in het land van Abba en IKEA en is de Sociaal Democratische Arbeiderspartij de grootste fractie in het parlement."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c5df3e0-39b2-34f7-9d2d-ff547618dae3",
                        "entry_id": "0b4d9a25-ae63-37af-8408-d3c2a40dff11",
                        "glosses": [
                            "wijd openstaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "594934fe-ee53-4789-89f4-bf8fdd069c44",
                                "sense_id": "8c5df3e0-39b2-34f7-9d2d-ff547618dae3",
                                "text": "Hij heeft een gapende wond in zijn been."
                            },
                            {
                                "example_id": "1af79b4b-aef6-4259-8cfe-ae839332d1fd",
                                "sense_id": "8c5df3e0-39b2-34f7-9d2d-ff547618dae3",
                                "text": "In de omgeving van het chique villadorp Bloemendaal is sprake van een heuse inbraakgolf. Sinds 31 augustus zijn er al negen BMW’s opengebroken en gestript van airbags en navigatiesysteem. Maar de schade voor de autobezitters is nog groter: de dieven laten een gapend gat achter in het dak van de auto."
                            },
                            {
                                "example_id": "c8fb8549-92f8-4568-8ee9-3ab0c98f724a",
                                "sense_id": "8c5df3e0-39b2-34f7-9d2d-ff547618dae3",
                                "text": "Voor het eerst kan de mensheid recht de gapende muil van één van de meest indrukwekkende monsters uit de kosmos inkijken: het zwarte gat in het centrum van sterrenstelsel Messier 87, een beest met de overweldigende massa van 6,5 miljard zonnen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c109962-b580-4e3e-aaf3-93d8ea58f48f",
                        "source_entry_id": "0b4d9a25-ae63-37af-8408-d3c2a40dff11",
                        "source_sense_id": "8c5df3e0-39b2-34f7-9d2d-ff547618dae3",
                        "source_sense_description": "wijd openstaand",
                        "target_lang_word": "gaping",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30fea9f9-d8ad-3fb3-b17c-81aab252e040",
                                        "entry_id": "3b9d4b9c-2b08-379a-9bca-f7197d673bfa",
                                        "glosses": [
                                            "present participle and gerund of gape"
                                        ],
